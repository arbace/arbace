                                    (Arrays/asList ProtocolVersion/PROTOCOLS_OF_13))]
                (for-each [^CertificateEntry certEnt (.-certEntries cm)]
                  (set! (.-currentCertEntry shc) certEnt)
                  (.produce (.-extensions certEnt) shc enabledCTExts))
                (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
                  (SSLLogger/fine "Produced server Certificate message" cm))
                (.write cm (.-handshakeOutput shc))
                (.flush (.-handshakeOutput shc))
                nil)))
          (throw (.fatal (.-conContext shc)
                         Alert/HANDSHAKE_FAILURE
                         "No X.509 certificate for server authentication")))))

    (method ^:private ^:static choosePossession ^SSLPossession [^HandshakeContext hc
                                                                ^ClientHello$ClientHelloMessage clientHello]
      (if (or (nil? (.-peerRequestedCertSignSchemes hc))
              (.isEmpty (.-peerRequestedCertSignSchemes hc)))
          (do
            (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
              (SSLLogger/warning "No signature_algorithms(_cert) in ClientHello"))
            nil)
          (let [supportedKeyTypes (cast
                                    String/1
                                    (.toArray
                                      (.filter
                                        (.filter
                                          (.distinct
                                            (.map
                                              (.stream (.-peerRequestedCertSignSchemes hc))
                                              (lambda Function ^String [^SignatureScheme ss]
                                                (.-keyAlgorithm ss))))
                                          (lambda Predicate ^boolean [^String ka]
                                            (or
                                              (some?
                                                (SignatureScheme/getPreferableAlgorithm
                                                  (.-algorithmConstraints hc)
                                                  (.-peerRequestedSignatureSchemes hc)
                                                  ka
                                                  (.-negotiatedProtocol hc)))
                                              (SSLLogger/logWarning
                                                "ssl,handshake"
                                                (java-str
                                                  "Unable to produce CertificateVerify for key algorithm: "
                                                  ka)))))
                                        (lambda Predicate ^boolean [^String ka]
                                          (or (some? (X509Authentication/valueOfKeyAlgorithm ka))
                                              (SSLLogger/logWarning
                                                "ssl,handshake"
                                                (java-str "Unsupported key algorithm: " ka)))))
                                      (lambda IntFunction ^String/1 ^:method-ref [^int n-1]
                                        (new String/1 n-1))))
                pos (X509Authentication/createPossession hc supportedKeyTypes)]
            (when (nil? pos)
              (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
                (SSLLogger/warning "No available authentication scheme")))
            pos)))

    (method ^:private onProduceCertificate :throws [IOException] ^byte/1 [this
                                                                          ^ClientHandshakeContext chc
                                                                          ^SSLHandshake$HandshakeMessage message]
      (let [clientHello (cast ClientHello$ClientHelloMessage message)
            pos (T13CertificateProducer/choosePossession chc clientHello)
            ^:mutable ^X509Certificate/1 localCerts nil]
        (if (nil? pos)
            (do
              (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
                (SSLLogger/fine "No available client authentication scheme"))
              (set! localCerts (new X509Certificate/1 0)))
            (do
              (.add (.-handshakePossessions chc) pos)
              (if-instance [^X509Authentication$X509Possession x509Possession pos]
                (do
                  (set! localCerts (.-popCerts x509Possession))
                  (.setLocalPrivateKey (.-handshakeSession chc) (.-popPrivateKey x509Possession)))
                (do
                  (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
                    (SSLLogger/fine "No X.509 certificate for client authentication"))
                  (set! localCerts (new X509Certificate/1 0))))))
        (if (and (some? localCerts) (not (== (alength localCerts) 0)))
            (.setLocalCertificates (.-handshakeSession chc) localCerts)
            (.setLocalCertificates (.-handshakeSession chc) nil))
        (let [^:mutable ^T13CertificateMessage cm nil]
          (try
            (set! cm (T13CertificateMessage. chc (.-certRequestContext chc) localCerts))
            (catch [SSLException CertificateException] ce
              (throw (.fatal (.-conContext chc)
                             Alert/HANDSHAKE_FAILURE
                             "Failed to produce client Certificate message"
                             ce))))
          (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
            (SSLLogger/fine "Produced client Certificate message" cm))
          (.write cm (.-handshakeOutput chc))
          (.flush (.-handshakeOutput chc))
          nil))))

  (defclass ^:private ^:static ^:final T13CertificateConsumer
    :implements [SSLConsumer]

    (constructor ^:private [this])

    (method ^:public consume :throws [IOException] ^void [this ^ConnectionContext context
                                                          ^ByteBuffer message]
      (let [hc (cast HandshakeContext context)]
        (.remove (.-handshakeConsumers hc) (.-id SSLHandshake/CERTIFICATE))
        (when (.containsKey (.-handshakeConsumers hc) (.-id SSLHandshake/ENCRYPTED_EXTENSIONS))
          (throw (.fatal (.-conContext hc)
                         Alert/UNEXPECTED_MESSAGE
                         "Unexpected Certificate handshake message")))
        (let [cm (T13CertificateMessage. hc message)]
          (if (.-isClientMode (.-sslConfig hc))
              (do
                (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
                  (SSLLogger/fine "Consuming server Certificate handshake message" cm))
                (.onConsumeCertificate this (cast ClientHandshakeContext context) cm))
              (do
                (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
                  (SSLLogger/fine "Consuming client Certificate handshake message" cm))
                (.onConsumeCertificate this (cast ServerHandshakeContext context) cm))))))

    (method ^:private onConsumeCertificate :throws [IOException] ^void [this
                                                                        ^ServerHandshakeContext shc
                                                                        ^T13CertificateMessage certificateMessage]
      (when (or (nil? (.-certEntries certificateMessage))
                (.isEmpty (.-certEntries certificateMessage)))
        (.remove (.-handshakeConsumers shc) (.-id SSLHandshake/CERTIFICATE_VERIFY))
        (if (identical? (.-clientAuthType (.-sslConfig shc)) ClientAuthType/CLIENT_AUTH_REQUIRED)
            (throw (.fatal (.-conContext shc)
                           Alert/CERTIFICATE_REQUIRED
                           "Empty client certificate chain"))
            (return)))
      (let [cliCerts (T13CertificateConsumer/checkClientCerts
                       shc
                       (.-certEntries certificateMessage))]
        (.add (.-handshakeCredentials shc)
              (X509Authentication$X509Credentials. (.getPublicKey (aget cliCerts 0)) cliCerts))
        (.setPeerCertificates (.-handshakeSession shc) cliCerts)))

    (method ^:private onConsumeCertificate :throws [IOException] ^void [this
                                                                        ^ClientHandshakeContext chc
                                                                        ^T13CertificateMessage certificateMessage]
      (when (or (nil? (.-certEntries certificateMessage))
                (.isEmpty (.-certEntries certificateMessage)))
        (throw (.fatal (.-conContext chc) Alert/DECODE_ERROR "Empty server certificate chain")))
      (let [enabledExtensions (.getEnabledExtensions (.-sslConfig chc) SSLHandshake/CERTIFICATE)]
        (for-each [^CertificateEntry certEnt (.-certEntries certificateMessage)]
          (.consumeOnLoad (.-extensions certEnt) chc enabledExtensions))
        (let [srvCerts (T13CertificateConsumer/checkServerCerts
                         chc
                         (.-certEntries certificateMessage))]
          (.add (.-handshakeCredentials chc)
                (X509Authentication$X509Credentials. (.getPublicKey (aget srvCerts 0)) srvCerts))
          (.setPeerCertificates (.-handshakeSession chc) srvCerts))))

    (method ^:private ^:static checkClientCerts :throws [IOException] ^X509Certificate/1 [^ServerHandshakeContext shc
                                                                                          ^{:tag (List CertificateEntry)} certEntries]
      (let [certs (new X509Certificate/1 (.size certEntries))]
        (try
          (let [cf (CertificateFactory/getInstance "X.509")
                ^:mutable ^int i 0]
            (for-each [^CertificateEntry entry certEntries]
              (aset certs
                    i
                    (cast X509Certificate
                          (.generateCertificate cf (ByteArrayInputStream. (.-encoded entry)))))
              (set! i (unchecked-inc-int i))))
          (catch CertificateException ce
            (throw (.fatal (.-conContext shc)
                           Alert/BAD_CERTIFICATE
                           "Failed to parse client certificates"
                           ce))))
        (let [keyAlgorithm (.getAlgorithm (.getPublicKey (aget certs 0)))
              ^:mutable ^String authType nil]
          (switch keyAlgorithm
            ("RSA" "DSA" "EC" "RSASSA-PSS") (set! authType keyAlgorithm)
            (set! authType "UNKNOWN"))
          (try
            (let [tm (.getX509TrustManager (.-sslContext shc))]
              (if (instance? X509ExtendedTrustManager tm)
                  (if-instance [^SSLEngine engine (.-transport (.-conContext shc))]
                    (.checkClientTrusted (cast X509ExtendedTrustManager tm)
                                         ^X509Certificate/1 (.clone certs)
                                         authType
                                         engine)
                    (if-instance [^SSLSocket socket (.-transport (.-conContext shc))]
                      (.checkClientTrusted (cast X509ExtendedTrustManager tm)
                                           ^X509Certificate/1 (.clone certs)
                                           authType
                                           socket)
                      (when-instance [^QuicTLSEngineImpl qtlse (.-transport (.-conContext shc))]
                        (if-instance [^X509TrustManagerImpl tmImpl tm]
                          (.checkClientTrusted tmImpl
                                               ^X509Certificate/1 (.clone certs)
                                               authType
                                               qtlse)
                          (throw
                            (CertificateException. "QUIC only supports SunJSSE trust managers"))))))
                  (throw (CertificateException. "Improper X509TrustManager implementation")))
              (.setPeerCertificates (.-handshakeSession shc) certs))
            (catch CertificateException ce
              (throw (.fatal (.-conContext shc) Alert/CERTIFICATE_UNKNOWN ce))))
          certs)))

    (method ^:private ^:static checkServerCerts :throws [IOException] ^X509Certificate/1 [^ClientHandshakeContext chc
                                                                                          ^{:tag (List CertificateEntry)} certEntries]
      (let [certs (new X509Certificate/1 (.size certEntries))]
        (try
          (let [cf (CertificateFactory/getInstance "X.509")
                ^:mutable ^int i 0]
            (for-each [^CertificateEntry entry certEntries]
              (aset certs
                    i
                    (cast X509Certificate
                          (.generateCertificate cf (ByteArrayInputStream. (.-encoded entry)))))
              (set! i (unchecked-inc-int i))))
          (catch CertificateException ce
            (throw (.fatal (.-conContext chc)
                           Alert/BAD_CERTIFICATE
                           "Failed to parse server certificates"
                           ce))))
        (let [authType "UNKNOWN"]
          (try
            (let [tm (.getX509TrustManager (.-sslContext chc))]
              (if-instance [^X509ExtendedTrustManager x509ExtTm tm]
                (if-instance [^SSLEngine engine (.-transport (.-conContext chc))]
                  (.checkServerTrusted x509ExtTm ^X509Certificate/1 (.clone certs) authType engine)
                  (if-instance [^SSLSocket socket (.-transport (.-conContext chc))]
                    (.checkServerTrusted x509ExtTm
                                         ^X509Certificate/1 (.clone certs)
                                         authType
                                         socket)
                    (if-instance [^QuicTLSEngineImpl qtlse (.-transport (.-conContext chc))]
                      (if-instance [^X509TrustManagerImpl tmImpl x509ExtTm]
                        (.checkServerTrusted tmImpl
                                             ^X509Certificate/1 (.clone certs)
                                             authType
                                             qtlse)
                        (throw (CertificateException. "QUIC only supports SunJSSE trust managers")))
                      (throw (AssertionError. "Unexpected transport type")))))
                (throw (CertificateException. "Improper X509TrustManager implementation")))
              (.setPeerCertificates (.-handshakeSession chc) certs))
            (catch CertificateException ce
              (throw (.fatal (.-conContext chc) (CertificateMessage/getCertificateAlert chc ce) ce))))
          certs))))

  (method ^:private ^:static getCertificateAlert ^Alert [^ClientHandshakeContext chc
                                                         ^CertificateException cexc]
    (let [^:mutable alert Alert/CERTIFICATE_UNKNOWN
          baseCause (.getCause cexc)]
      (when-instance [^CertPathValidatorException cpve baseCause]
        (let [reason (.getReason cpve)]
          (cond
            (identical? reason CertPathValidatorException$BasicReason/REVOKED)
              (set! alert
                    (if (.-staplingActive chc)
                        Alert/BAD_CERT_STATUS_RESPONSE
                        Alert/CERTIFICATE_REVOKED))
            (identical? reason
                        CertPathValidatorException$BasicReason/UNDETERMINED_REVOCATION_STATUS)
              (set! alert
                    (if (.-staplingActive chc)
                        Alert/BAD_CERT_STATUS_RESPONSE
                        Alert/CERTIFICATE_UNKNOWN))
            (identical? reason CertPathValidatorException$BasicReason/EXPIRED)
              (set! alert Alert/CERTIFICATE_EXPIRED)
            (or (identical? reason CertPathValidatorException$BasicReason/INVALID_SIGNATURE)
                (identical? reason CertPathValidatorException$BasicReason/NOT_YET_VALID))
              (set! alert Alert/BAD_CERTIFICATE)
            :else
              (when (identical? reason CertPathValidatorException$BasicReason/ALGORITHM_CONSTRAINED)
                (set! alert Alert/UNSUPPORTED_CERTIFICATE)
                (when (and (some? (.-negotiatedProtocol chc))
                           (.useTLS13PlusSpec (.-negotiatedProtocol chc)))
                  (let [exMsg (.toUpperCase (.getMessage cexc))]
                    (when (or (.contains exMsg "MD5WITH") (.contains exMsg "SHA1WITH"))
                      (set! alert Alert/BAD_CERTIFICATE))))))))
      alert)))

                      (not (.isInboundClosed conContext)))
                 (not (.isOutboundClosed conContext)))
        (.ensureNegotiated SSLSocketImpl/this true))
      (when (or (or (not (.-isNegotiated conContext)) (.-isBroken conContext))
                (.isOutboundClosed conContext))
        (throw (SocketException. "Connection or outbound has closed")))
      (try
        (.deliver (.-outputRecord conContext) b off len)
        (catch SSLHandshakeException she (throw (.fatal conContext Alert/HANDSHAKE_FAILURE she)))
        (catch SSLException ssle (throw (.fatal conContext Alert/UNEXPECTED_MESSAGE ssle))))
      (when (or (.seqNumIsHuge (.-outputRecord conContext))
                (.atKeyLimit (.-writeCipher (.-outputRecord conContext))))
        (.tryKeyUpdate SSLSocketImpl/this))
      (when (.-updateNST (.-conSession conContext)) (.tryNewSessionTicket SSLSocketImpl/this)))

    (method ^:public close :throws [IOException] ^void [this]
      (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl"))
        (SSLLogger/finest "Closing output stream"))
      (try
        (.close SSLSocketImpl/this)
        (catch IOException ioe
          (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl"))
            (SSLLogger/warning "output stream close failed. Debug info only. Exception details:"
                               ioe))))))

  (method ^:public getSSLParameters ^SSLParameters [this]
    (.lock socketLock)
    (try (.getSSLParameters (.-sslConfig conContext)) (finally (.unlock socketLock))))

  (method ^:public setSSLParameters ^void [this ^SSLParameters params]
    (.lock socketLock)
    (try
      (.setSSLParameters (.-sslConfig conContext) params)
      (when-not (== (.-maximumPacketSize (.-sslConfig conContext)) 0)
        (.changePacketSize (.-outputRecord conContext)
                           (.-maximumPacketSize (.-sslConfig conContext))))
      (finally (.unlock socketLock))))

  (method ^:public getApplicationProtocol ^String [this]
    (.lock socketLock)
    (try (.-applicationProtocol conContext) (finally (.unlock socketLock))))

  (method ^:public getHandshakeApplicationProtocol ^String [this]
    (.lock socketLock)
    (try
      (when (some? (.-handshakeContext conContext))
        (return (.-applicationProtocol (.-handshakeContext conContext))))
      (finally (.unlock socketLock)))
    nil)

  (method ^:public setHandshakeApplicationProtocolSelector ^void [this
                                                                  ^{:tag (BiFunction SSLSocket (List String) String)} selector]
    (.lock socketLock)
    (try
      (set! (.-socketAPSelector (.-sslConfig conContext)) selector)
      (finally (.unlock socketLock))))

  (method ^:public getHandshakeApplicationProtocolSelector ^{:tag (BiFunction SSLSocket (List String) String)} [this]
    (.lock socketLock)
    (try (.-socketAPSelector (.-sslConfig conContext)) (finally (.unlock socketLock))))

  (method ^:private readHandshakeRecord :throws [IOException] ^int [this]
    (while (not (.isInboundClosed conContext))
      (try
        (let [plainText (.decode this nil)]
          (when (and (== (.-contentType plainText) (.-id ContentType/HANDSHAKE))
                     (.-isNegotiated conContext))
            (return 0)))
        (catch [SSLException InterruptedIOException SocketException] se (throw se))
        (catch IOException ioe (throw (SSLException. "readHandshakeRecord" ioe)))))
    -1)

  (method ^:private readApplicationRecord :throws [IOException] ^ByteBuffer [this
                                                                             ^:mutable ^ByteBuffer buffer]
    (while (not (.isInboundClosed conContext))
      (.clear buffer)
      (let [inLen (.bytesInCompletePacket (.-inputRecord conContext))]
        (when (< inLen 0) (.handleEOF this nil) (return nil))
        (when (> inLen SSLRecord/maxLargeRecordSize)
          (throw (SSLProtocolException. (java-str "Illegal packet size: " inLen))))
        (when (> inLen (.remaining buffer)) (set! buffer (ByteBuffer/allocate inLen)))
        (try
          (let [plainText (.decode this buffer)]
            (when (and (== (.-contentType plainText) (.-id ContentType/APPLICATION_DATA))
                       (> (.position buffer) 0))
              (return buffer)))
          (catch [SSLException InterruptedIOException SocketException] se (throw se))
          (catch IOException ioe (throw (SSLException. "readApplicationRecord" ioe))))))
    nil)

  (method ^:private decode :throws [IOException] ^Plaintext [this ^ByteBuffer destination]
    (let [^:mutable ^Plaintext plainText nil]
      (try
        (if (nil? destination)
            (set! plainText (SSLTransport/decode conContext nil 0 0 nil 0 0))
            (set! plainText
                  (SSLTransport/decode conContext nil 0 0 (new ByteBuffer/1 [destination]) 0 1)))
        (catch EOFException eofe (set! plainText (.handleEOF this eofe))))
      (when (and (not (identical? plainText Plaintext/PLAINTEXT_NULL))
                 (or (.seqNumIsHuge (.-inputRecord conContext))
                     (.atKeyLimit (.-readCipher (.-inputRecord conContext)))))
        (.tryKeyUpdate this))
      plainText))

  (method ^:private tryKeyUpdate :throws [IOException] ^void [this]
    (when (and (and (nil? (.-handshakeContext conContext)) (not (.isOutboundClosed conContext)))
               (not (.-isBroken conContext)))
      (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl")) (SSLLogger/finest "trigger key update"))
      (.startHandshake this)))

  (method ^:private tryNewSessionTicket :throws [IOException] ^void [this]
    (when (and (and (and (and (and (and (> SSLConfiguration/serverNewSessionTicketCount 0)
                                        (not (.-isClientMode (.-sslConfig conContext))))
                                   (.useTLS13PlusSpec (.-protocolVersion conContext)))
                              (nil? (.-handshakeContext conContext)))
                         (not (.isOutboundClosed conContext)))
                    (not (.isInboundClosed conContext)))
               (not (.-isBroken conContext)))
      (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl"))
        (SSLLogger/finest "trigger new session ticket"))
      (set! (.-updateNST (.-conSession conContext)) false)
      (.produce NewSessionTicket/t13PosthandshakeProducer (PostHandshakeContext. conContext))))

  (method doneConnect :throws [IOException] ^void [this]
    (.lock socketLock)
    (try
      (if (or (nil? peerHost) (.isEmpty peerHost))
          (let [useNameService (and trustNameService (.-isClientMode (.-sslConfig conContext)))]
            (.useImplicitHost this useNameService))
          (set!
            (.-serverNames (.-sslConfig conContext))
            (Utilities/addToSNIServerNameList (.-serverNames (.-sslConfig conContext)) peerHost)))
      (let [sockInput (.getInputStream super)]
        (.setReceiverStream (.-inputRecord conContext) sockInput)
        (let [sockOutput (.getOutputStream super)]
          (.setDeliverStream (.-inputRecord conContext) sockOutput)
          (.setDeliverStream (.-outputRecord conContext) sockOutput)
          (set! (.-isConnected this) true)))
      (finally (.unlock socketLock))))

  (method ^:private useImplicitHost ^void [this ^boolean useNameService]
    (let [inetAddress (.getInetAddress this)]
      (when (some? inetAddress)
        (let [jna (SharedSecrets/getJavaNetInetAddressAccess)
              originalHostname (.getOriginalHostName jna inetAddress)]
          (cond
            (and (some? originalHostname) (not (.isEmpty originalHostname)))
              (do
                (set! (.-peerHost this) originalHostname)
                (when (and (.isEmpty (.-serverNames (.-sslConfig conContext)))
                           (not (.-noSniExtension (.-sslConfig conContext))))
                  (set! (.-serverNames (.-sslConfig conContext))
                        (Utilities/addToSNIServerNameList
                          (.-serverNames (.-sslConfig conContext))
                          peerHost))))
            (not useNameService) (set! (.-peerHost this) (.getHostAddress inetAddress))
            :else (set! (.-peerHost this) (.getHostName (.getInetAddress this))))))))

  (method ^:public setHost ^void [this ^String host]
    (.lock socketLock)
    (try
      (set! (.-peerHost this) host)
      (set! (.-serverNames (.-sslConfig (.-conContext this)))
            (Utilities/addToSNIServerNameList (.-serverNames (.-sslConfig conContext)) host))
      (finally (.unlock socketLock))))

  (method ^:private handleException :throws [IOException] ^void [this ^Exception cause]
    (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl"))
      (SSLLogger/warning "handling exception" cause))
    (when (instance? InterruptedIOException cause) (throw (cast IOException cause)))
    (let [isSSLException (instance? SSLException cause)
          ^:mutable ^Alert alert nil]
      (cond
        isSSLException
          (if (instance? SSLHandshakeException cause)
              (set! alert Alert/HANDSHAKE_FAILURE)
              (set! alert Alert/UNEXPECTED_MESSAGE))
        (instance? IOException cause) (set! alert Alert/UNEXPECTED_MESSAGE)
        :else (set! alert Alert/INTERNAL_ERROR))
      (when (instance? SocketException cause)
        (try (throw (.fatal conContext alert cause)) (catch Exception e))
        (throw (cast SocketException cause)))
      (throw (.fatal conContext alert cause))))

  (method ^:private handleEOF :throws [IOException] ^Plaintext [this ^EOFException eofe]
    (if (or SSLSocketImpl/requireCloseNotify (some? (.-handshakeContext conContext)))
        (if (some? (.-handshakeContext conContext))
            (throw (SSLHandshakeException. "Remote host terminated the handshake" eofe))
            (throw (SSLProtocolException. "Remote host terminated the connection" eofe)))
        (do
          (set! (.-isInputCloseNotified conContext) true)
          (.shutdownInput this)
          Plaintext/PLAINTEXT_NULL)))

  (method ^:public getPeerHost ^String [this] peerHost)

  (method ^:public getPeerPort ^int [this] (.getPort this))

  (method ^:public useDelegatedTask ^boolean [this] false)

  (method ^:public shutdown :throws [IOException] ^void [this]
    (when-not (.isClosed this)
      (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl"))
        (SSLLogger/fine "close the underlying socket"))
      (try
        (.closeSocket this
                      (and (.-isNegotiated conContext) (not (.-isInputCloseNotified conContext))))
        (finally (set! tlsIsClosed true)))))

  (method ^:public toString ^String [this]
    (java-str "SSLSocket[hostname="
              (.getPeerHost this)
              ", port="
              (.getPeerPort this)
              ", "
              (.-conSession conContext)
              "]"))

  (method ^:private closeSocket :throws [IOException] ^void [this ^boolean selfInitiated]
    (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl"))
      (SSLLogger/fine
        (java-str "close the SSL connection " (if selfInitiated "(initiative)" "(passive)"))))
    (cond
      (or autoClose (not (.isLayered this)))
        (do
          (when-instance [^SSLSocketInputRecord inputRecord (.-inputRecord conContext)]
            (when isConnected
              (when (.tryLock (.-readLock appInput))
                (try
                  (let [soTimeout (.getSoTimeout this)]
                    (try
                      (when (== soTimeout 0) (.setSoTimeout this DEFAULT_SKIP_TIMEOUT))
                      (.deplete inputRecord false)
                      (catch SocketTimeoutException stEx)
                      (finally (when (== soTimeout 0) (.setSoTimeout this soTimeout)))))
                  (finally (.unlock (.-readLock appInput)))))))
          (.close super))
      selfInitiated
        (when (and (not (.isInboundClosed conContext)) (not (.isInputShutdown this)))
          (.waitForClose this))))

  (method ^:private waitForClose :throws [IOException] ^void [this]
    (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl"))
      (SSLLogger/fine "wait for close_notify or alert"))
    (.lock (.-readLock appInput))
    (try
      (while (not (.isInboundClosed conContext))
        (try
          (let [plainText (.decode this nil)]
            (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl"))
              (SSLLogger/finest "discard plaintext while waiting for close" plainText)))
          (catch Exception e (.handleException this e))))
      (finally (.unlock (.-readLock appInput))))))

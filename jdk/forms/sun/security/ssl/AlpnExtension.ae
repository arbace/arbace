                      (set! (.-applicationProtocol shc) "")
                      (set! (.-applicationProtocol (.-conContext shc)) "")
                      (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
                        (SSLLogger/fine
                          (java-str "Ignore server unenabled extension: "

                  pskBinderHash (.copy (.-handshakeHash shc))
                  lastMessage (.removeLastReceived pskBinderHash)
                  messageBuf (ByteBuffer/wrap lastMessage)]
              (.position messageBuf 4)
              (ClientHello$ClientHelloMessage/readPartial (.-conContext shc) messageBuf)
              (let [length (.position messageBuf)]
                (.position messageBuf 0)
                (.receive pskBinderHash messageBuf length)
                (PreSharedKeyExtension/checkBinder shc (.-resumingSession shc) pskBinderHash binder))))))))


            zeros (new byte/1 (.-hashLength hashAlg))
            label (.getBytes "tls13 res binder")
            md (MessageDigest/getInstance (.-name hashAlg))
            hkdfInfo (SSLSecretDerivation/createHkdfInfo
                       label
                       (.digest md (new byte/1 0))
                       (.-hashLength hashAlg))
            hkdf (KDF/getInstance (.-hkdfAlgorithm hashAlg))
            ^HKDFParameterSpec spec (.thenExpand
                                      (.addIKM (.addSalt (HKDFParameterSpec/ofExtract) zeros) psk)
                                      hkdfInfo
                                      (.-hashLength hashAlg))]
        (.deriveKey hkdf "TlsBinderKey" spec))
      (catch GeneralSecurityException ex
        (throw (.fatal (.-conContext context) Alert/INTERNAL_ERROR ex)))))

  (defclass ^:private ^:static ^:final CHPreSharedKeyOnLoadAbsence
    :implements [HandshakeAbsence]

    (method ^:public absent :throws [IOException] ^void [this ^ConnectionContext context
                                                         ^SSLHandshake$HandshakeMessage message]
      (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
        (SSLLogger/fine "Handling pre_shared_key absence."))
      (let [shc (cast ServerHandshakeContext context)]
        (set! (.-resumingSession shc) nil)
        (set! (.-isResumption shc) false))))

  (defclass ^:private ^:static ^:final CHPreSharedKeyOnTradeAbsence
    :implements [HandshakeAbsence]

    (method ^:public absent :throws [IOException] ^void [this ^ConnectionContext context
                                                         ^SSLHandshake$HandshakeMessage message]
      (let [shc (cast ServerHandshakeContext context)]
        (when (and (.useTLS13PlusSpec (.-negotiatedProtocol shc))
                   (or (not (.containsKey (.-handshakeExtensions shc)
                                          SSLExtension/CH_SIGNATURE_ALGORITHMS))
                       (not (.containsKey (.-handshakeExtensions shc)
                                          SSLExtension/CH_SUPPORTED_GROUPS))))
          (throw
            (.fatal
              (.-conContext shc)
              Alert/MISSING_EXTENSION
              "No supported_groups or signature_algorithms extension when pre_shared_key extension is not present"))))))

  (defclass ^:private ^:static ^:final SHPreSharedKeyConsumer
    :implements [SSLExtension$ExtensionConsumer]

    (constructor ^:private [this])

    (method ^:public consume :throws [IOException] ^void [this ^ConnectionContext context
                                                          ^SSLHandshake$HandshakeMessage message
                                                          ^ByteBuffer buffer]
      (let [chc (cast ClientHandshakeContext context)]
        (when-not (.containsKey (.-handshakeExtensions chc) SSLExtension/CH_PRE_SHARED_KEY)
          (throw (.fatal (.-conContext chc)
                         Alert/UNEXPECTED_MESSAGE
                         "Server sent unexpected pre_shared_key extension")))
        (let [shPsk (SHPreSharedKeySpec. chc buffer)]
          (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
            (SSLLogger/fine "Received pre_shared_key extension: " shPsk))
          (when-not (== (.-selectedIdentity shPsk) 0)
            (throw (.fatal (.-conContext chc)
                           Alert/ILLEGAL_PARAMETER
                           "Selected identity index is not in correct range.")))
          (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
            (SSLLogger/fine "Resuming session: " (.-resumingSession chc)))))))

  (defclass ^:private ^:static ^:final SHPreSharedKeyAbsence
    :implements [HandshakeAbsence]

    (method ^:public absent :throws [IOException] ^void [this ^ConnectionContext context
                                                         ^SSLHandshake$HandshakeMessage message]
      (let [chc (cast ClientHandshakeContext context)]
        (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
          (SSLLogger/fine "Handling pre_shared_key absence."))
        (set! (.-resumingSession chc) nil)
        (set! (.-isResumption chc) false))))

  (defclass ^:private ^:static ^:final SHPreSharedKeyProducer
    :implements [HandshakeProducer]

    (constructor ^:private [this])

    (method ^:public produce :throws [IOException] ^byte/1 [this ^ConnectionContext context
                                                            ^SSLHandshake$HandshakeMessage message]
      (let [shc (cast ServerHandshakeContext context)
            psk (cast SHPreSharedKeySpec
                      (.get (.-handshakeExtensions shc) SSLExtension/SH_PRE_SHARED_KEY))]
        (when (some? psk) (.getEncoded psk))))))

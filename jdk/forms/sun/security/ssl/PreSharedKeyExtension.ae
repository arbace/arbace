            (let [^{:tag (Collection SignatureScheme)} sessionSigAlgs
                    (.getLocalSupportedSignatureSchemes (.-resumingSession chc))]
              (if (not (.containsAll (.-localSupportedCertSignAlgs chc) sessionSigAlgs))
                  (do
                    (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
                      (SSLLogger/fine "Existing session uses different signature algorithms"))
                    nil)
                  (let [psk (.getPreSharedKey (.-resumingSession chc))]
                    (if (nil? psk)
                        (do
                          (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
                            (SSLLogger/fine "Existing session has no PSK."))
                          nil)
                        (do
                          (when (nil? (.-pskIdentity chc))
                            (set! (.-pskIdentity chc) (.consumePskIdentity (.-resumingSession chc))))
                          (if (nil? (.-pskIdentity chc))
                              (do
                                (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
                                  (SSLLogger/fine
                                    "PSK has no identity, or identity was already used"))
                                nil)
                              (let [sessionCache (cast
                                                   SSLSessionContextImpl
                                                   (.engineGetClientSessionContext
                                                     (.-sslContext chc)))]
                                (.remove sessionCache (.getSessionId (.-resumingSession chc)) true)
                                (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
                                  (SSLLogger/fine "Found resumable session. Preparing PSK message.")
                                  (SSLLogger/fine
                                    (java-str "MultiNST PSK (Client): "
                                              (Utilities/toHexString
                                                (Arrays/copyOf (.-pskIdentity chc) 16)))))
                                (let [^{:tag (List PskIdentity)} identities (ArrayList.)
                                      ageMillis (unchecked-int
                                                  (unchecked-subtract
                                                    (System/currentTimeMillis)
                                                    (.getTicketCreationTime (.-resumingSession chc))))
                                      obfuscatedAge (unchecked-add-int
                                                      ageMillis
                                                      (.getTicketAgeAdd (.-resumingSession chc)))]
                                  (.add identities (PskIdentity. (.-pskIdentity chc) obfuscatedAge))
                                  (let [binderKey (PreSharedKeyExtension/deriveBinderKey
                                                    chc
                                                    psk
                                                    (.-resumingSession chc))]
                                    (try
                                      (let [clientHello (cast
                                                          ClientHello$ClientHelloMessage
                                                          message)
                                            pskPrototype (.createPskPrototype
                                                           this
                                                           (.-hashLength
                                                             (.-hashAlg
                                                               (.getSuite (.-resumingSession chc))))
                                                           identities)
                                            pskBinderHash (.copy (.-handshakeHash chc))
                                            binder (PreSharedKeyExtension/computeBinder
                                                     chc
                                                     binderKey
                                                     pskBinderHash
                                                     (.-resumingSession chc)
                                                     chc

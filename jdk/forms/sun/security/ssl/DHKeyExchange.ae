  (defclass ^:private ^:static ^:final DHEPossessionGenerator
    :implements [SSLPossessionGenerator]

    (field ^:private ^:static ^:final ^boolean useSmartEphemeralDHKeys)

    (field ^:private ^:static ^:final ^boolean useLegacyEphemeralDHKeys)

    (field ^:private ^:static ^:final ^int customizedDHKeySize)

    (field ^:private ^:final ^boolean exportable)


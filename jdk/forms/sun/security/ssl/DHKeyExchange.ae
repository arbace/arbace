              (set! useLegacyEphemeralDHKeys false)
              (set! useSmartEphemeralDHKeys false)
              (try
                (set! customizedDHKeySize (Integer/parseUnsignedInt property))
                (when (or (or (< customizedDHKeySize 1024) (> customizedDHKeySize 8192))

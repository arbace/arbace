              (set! useLegacyEphemeralDHKeys false)
              (set! useSmartEphemeralDHKeys true)
              (set! customizedDHKeySize -1))
          (.equals "legacy" property)
            (do
              (set! useLegacyEphemeralDHKeys true)
              (set! useSmartEphemeralDHKeys false)
              (set! customizedDHKeySize -1))
          :else

  (defclass ^:static ^:final SupportedGroups
    (field ^:static ^:final ^String/1 namedGroups)

    (static-initializer
      (let [^:mutable property (System/getProperty "jdk.tls.namedGroups")]
        (when (and (some? property) (not (.isEmpty property)))
          (when (and (and (> (.length property) 1) (== (.charAt property 0) \"))
                     (== (.charAt property (unchecked-subtract-int (.length property) 1)) \"))
            (set! property (.substring property 1 (unchecked-subtract-int (.length property) 1)))))
        (let [^:mutable ^{:tag (ArrayList String)} groupList nil]
          (if (and (some? property) (not (.isEmpty property)))
              (let [groups (.split property ",")]
                (set! groupList (ArrayList. (alength groups)))
                (for-each [^:mutable ^String group groups]
                  (set! group (.trim group))
                  (when-not (.isEmpty group)
                    (let [namedGroup (NamedGroup/nameOf group)]
                      (when (some? namedGroup)
                        (when (.-isAvailable namedGroup) (.add groupList (.-name namedGroup)))))))
                (when (.isEmpty groupList)
                  (throw (IllegalArgumentException.
                           (java-str "System property jdk.tls.namedGroups("
                                     property
                                     ") contains no supported named groups")))))
              (let [groups (new NamedGroup/1
                                [X25519 SECP256_R1 SECP384_R1 SECP521_R1 X448 FFDHE_2048 FFDHE_3072
                                 FFDHE_4096 FFDHE_6144 FFDHE_8192])]
                (set! groupList (ArrayList. (alength groups)))
                (for-each [^NamedGroup group groups]
                  (when (.-isAvailable group) (.add groupList (.-name group))))
                (when (and (and (.isEmpty groupList) (SSLLogger/isOn)) (SSLLogger/isOn "ssl"))

  (field ^:final ^int id)

  (field ^:final ^SSLHandshake handshakeType)

  (field ^:final ^String name)

  (field ^:final ^ProtocolVersion/1 supportedProtocols)

  (field ^:final ^HandshakeProducer networkProducer)

  (field ^:final ^ExtensionConsumer onLoadConsumer)

  (field ^:final ^HandshakeAbsence onLoadAbsence)

  (field ^:final ^HandshakeConsumer onTradeConsumer)

  (field ^:final ^HandshakeAbsence onTradeAbsence)

  (field ^:final ^SSLStringizer stringizer)

  (constructor [this ^int id ^String name]
    (set! (.-id this) id)
    (set! (.-handshakeType this) SSLHandshake/NOT_APPLICABLE)
    (set! (.-name this) name)
    (set! (.-supportedProtocols this) (new ProtocolVersion/1 0))
    (set! (.-networkProducer this) nil)
    (set! (.-onLoadConsumer this) nil)
    (set! (.-onLoadAbsence this) nil)
    (set! (.-onTradeConsumer this) nil)
    (set! (.-onTradeAbsence this) nil)
    (set! (.-stringizer this) nil))

  (constructor [this ^int id ^String name ^SSLHandshake handshakeType
                ^ProtocolVersion/1 supportedProtocols ^HandshakeProducer producer
                ^ExtensionConsumer onLoadConsumer ^HandshakeAbsence onLoadAbsence
                ^HandshakeConsumer onTradeConsumer ^HandshakeAbsence onTradeAbsence
                ^SSLStringizer stringize]
    (set! (.-id this) id)
    (set! (.-handshakeType this) handshakeType)
    (set! (.-name this) name)
    (set! (.-supportedProtocols this) supportedProtocols)
    (set! (.-networkProducer this) producer)
    (set! (.-onLoadConsumer this) onLoadConsumer)
    (set! (.-onLoadAbsence this) onLoadAbsence)
    (set! (.-onTradeConsumer this) onTradeConsumer)
    (set! (.-onTradeAbsence this) onTradeAbsence)
    (set! (.-stringizer this) stringize))

  (method ^:static valueOf ^SSLExtension [^SSLHandshake handshakeType ^int extensionType]
    (for-each [^SSLExtension ext (SSLExtension/values)]
      (when (and (== (.-id ext) extensionType) (identical? (.-handshakeType ext) handshakeType))
        (return ext)))
    nil)

  (method ^:static nameOf ^String [^int extensionType]
    (for-each [^SSLExtension ext (SSLExtension/values)]
      (when (== (.-id ext) extensionType) (return (.-name ext))))
    "unknown extension")

  (method ^:static isConsumable ^boolean [^int extensionType]
    (for-each [^SSLExtension ext (SSLExtension/values)]
      (when (and (== (.-id ext) extensionType) (some? (.-onLoadConsumer ext))) (return true)))
    false)

  (method ^:public produce :throws [IOException] ^byte/1 [this ^ConnectionContext context
                                                          ^SSLHandshake$HandshakeMessage message]
    (if (some? networkProducer)
        (.produce networkProducer context message)
        (throw (UnsupportedOperationException. "Not yet supported extension producing."))))

  (method ^:public consumeOnLoad :throws [IOException] ^void [this ^ConnectionContext context
                                                              ^SSLHandshake$HandshakeMessage message
                                                              ^ByteBuffer buffer]
    (if (some? onLoadConsumer)
        (.consume onLoadConsumer context message buffer)
        (throw (UnsupportedOperationException. "Not yet supported extension loading."))))

  (method ^:public consumeOnTrade :throws [IOException] ^void [this ^ConnectionContext context
                                                               ^SSLHandshake$HandshakeMessage message]
    (if (some? onTradeConsumer)
        (.consume onTradeConsumer context message)
        (throw (UnsupportedOperationException. "Not yet supported extension processing."))))

  (method absentOnLoad :throws [IOException] ^void [this ^ConnectionContext context
                                                    ^SSLHandshake$HandshakeMessage message]
    (if (some? onLoadAbsence)
        (.absent onLoadAbsence context message)
        (throw (UnsupportedOperationException. "Not yet supported extension absence processing."))))

  (method absentOnTrade :throws [IOException] ^void [this ^ConnectionContext context
                                                     ^SSLHandshake$HandshakeMessage message]
    (if (some? onTradeAbsence)
        (.absent onTradeAbsence context message)
        (throw (UnsupportedOperationException. "Not yet supported extension absence processing."))))

  (method ^:public isAvailable ^boolean [this ^ProtocolVersion protocolVersion]
    (for-each [^ProtocolVersion supportedProtocol supportedProtocols]
      (when (identical? supportedProtocol protocolVersion) (return true)))
    false)

  (method ^:public toString ^String [this] name)

  (method ^:public toString ^String [this ^HandshakeContext handshakeContext ^ByteBuffer byteBuffer]
    (let [messageFormat (MessageFormat. "\"{0} ({1})\": '{'\n{2}\n'}'" Locale/ENGLISH)
          ^:mutable ^String extData nil]
      (if (nil? stringizer)
          (let [hexEncoder (HexDumpEncoder.)]
            (set! extData (.encode hexEncoder (.duplicate byteBuffer))))
          (set! extData (.toString stringizer handshakeContext byteBuffer)))
      (let [messageFields (new Object/1 [(.-name this) (.-id this) (Utilities/indent extData)])]
        (.format messageFormat messageFields))))

  (defclass ^:interface ExtensionConsumer
    (method consume :throws [IOException] ^void [this ^ConnectionContext context
                                                 ^SSLHandshake$HandshakeMessage message
                                                 ^ByteBuffer buffer]))

  (defclass ^:interface SSLExtensionSpec)

  (defclass ^:static ^:final ClientExtensions
    (field ^:static ^:final ^{:tag (Collection SSLExtension)} defaults)

    (static-initializer
      (let [^{:tag (Collection String)} clientDisabledExtensions (SSLExtension/getDisabledExtensions
                                                                   "jdk.tls.client.disableExtensions")
            ^{:tag (Collection SSLExtension)} extensions (LinkedList.)]
        (for-each [^SSLExtension extension (SSLExtension/values)]
          (when (and (not (identical? (.-handshakeType extension) SSLHandshake/NOT_APPLICABLE))
                     (not (.contains clientDisabledExtensions (.-name extension))))
            (.add extensions extension)))
        (when (.contains extensions CH_SERVER_NAME)
          (let [enableExtension (Utilities/getBooleanProperty "jsse.enableSNIExtension" true)]
            (when-not enableExtension (.remove extensions CH_SERVER_NAME))))
        (when (.contains extensions CH_MAX_FRAGMENT_LENGTH)
          (let [enableExtension (or (Utilities/getBooleanProperty "jsse.enableMFLNExtension" false)
                                    (Utilities/getBooleanProperty "jsse.enableMFLExtension" false))]
            (when-not enableExtension (.remove extensions CH_MAX_FRAGMENT_LENGTH))))
        (when (.contains extensions CH_CERTIFICATE_AUTHORITIES)
          (let [enableExtension (Utilities/getBooleanProperty
                                  "jdk.tls.client.enableCAExtension"
                                  false)]
            (when-not enableExtension (.remove extensions CH_CERTIFICATE_AUTHORITIES))))
        (set! defaults (Collections/unmodifiableCollection extensions)))))

  (defclass ^:static ^:final ServerExtensions
    (field ^:static ^:final ^{:tag (Collection SSLExtension)} defaults)

    (static-initializer
      (let [^{:tag (Collection String)} serverDisabledExtensions (SSLExtension/getDisabledExtensions
                                                                   "jdk.tls.server.disableExtensions")
            ^{:tag (Collection SSLExtension)} extensions (LinkedList.)]
        (for-each [^SSLExtension extension (SSLExtension/values)]
          (when (and (not (identical? (.-handshakeType extension) SSLHandshake/NOT_APPLICABLE))
                     (not (.contains serverDisabledExtensions (.-name extension))))
            (.add extensions extension)))
        (set! defaults (Collections/unmodifiableCollection extensions)))))

  (method ^:private ^:static getDisabledExtensions ^{:tag (Collection String)} [^String propertyName]
    (let [^:mutable property (System/getProperty propertyName)]
      (when (and (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,sslctx"))
                 (not (.isVirtual (Thread/currentThread))))
        (SSLLogger/fine (java-str "System property " propertyName " is set to '" property "'")))
      (when (and (some? property) (not (.isEmpty property)))
        (when (and (and (> (.length property) 1) (== (.charAt property 0) \"))
                   (== (.charAt property (unchecked-subtract-int (.length property) 1)) \"))
          (set! property (.substring property 1 (unchecked-subtract-int (.length property) 1)))))
      (if (and (some? property) (not (.isEmpty property)))
          (let [extensionNames (.split property ",")
                ^{:tag (Collection String)} extensions (ArrayList. (alength extensionNames))]
            (for-each [^:mutable ^String extension extensionNames]
              (set! extension (.trim extension))
              (when-not (.isEmpty extension) (.add extensions extension)))
            extensions)
          (Collections/emptyList)))))

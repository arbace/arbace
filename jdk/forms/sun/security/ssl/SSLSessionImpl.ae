      (when (.useTLS13PlusSpec protocolVersion) (set! updateNST true))))

  (method ^:public getValueNames ^String/1 [this]
    (cast String/1 (.toArray (.keySet boundValues) (new String/1 0))))

  (field ^:private ^boolean acceptLargeFragments
    (Utilities/getBooleanProperty "jsse.SSLEngine.acceptLargeFragments" false))

  (method expandBufferSizes ^void [this]
    (.lock sessionLock)
    (try (set! acceptLargeFragments true) (finally (.unlock sessionLock))))

  (method ^:public getPacketBufferSize ^int [this]
    (.lock sessionLock)
    (try
      (let [^:mutable ^int packetSize 0]
        (when (> negotiatedMaxFragLen 0)
          (set! packetSize
                (.calculatePacketSize cipherSuite
                                      negotiatedMaxFragLen
                                      protocolVersion
                                      (.-isDTLS protocolVersion))))
        (cond
          (> maximumPacketSize 0) (Math/max maximumPacketSize packetSize)
          (not (== packetSize 0)) packetSize
          (.-isDTLS protocolVersion) DTLSRecord/maxRecordSize
          acceptLargeFragments SSLRecord/maxLargeRecordSize
          :else SSLRecord/maxRecordSize))
      (finally (.unlock sessionLock))))

  (method ^:public getApplicationBufferSize ^int [this]
    (.lock sessionLock)
    (try
      (let [^:mutable ^int fragmentSize 0]
        (when (> maximumPacketSize 0)
          (set! fragmentSize
                (.calculateFragSize cipherSuite
                                    maximumPacketSize
                                    protocolVersion
                                    (.-isDTLS protocolVersion))))
        (cond
          (> negotiatedMaxFragLen 0) (Math/max negotiatedMaxFragLen fragmentSize)
          (not (== fragmentSize 0)) fragmentSize
          (.-isDTLS protocolVersion) Record/maxDataSize
          :else
            (let [^int maxPacketSize (if acceptLargeFragments
                                         SSLRecord/maxLargeRecordSize
                                         SSLRecord/maxRecordSize)]
              (unchecked-subtract-int maxPacketSize SSLRecord/headerSize))))
      (finally (.unlock sessionLock))))

  (method setNegotiatedMaxFragSize ^void [this ^int negotiatedMaxFragLen]
    (.lock sessionLock)
    (try (set! (.-negotiatedMaxFragLen this) negotiatedMaxFragLen) (finally (.unlock sessionLock))))

  (method getNegotiatedMaxFragSize ^int [this]
    (.lock sessionLock)
    (try negotiatedMaxFragLen (finally (.unlock sessionLock))))

  (method setMaximumPacketSize ^void [this ^int maximumPacketSize]
    (.lock sessionLock)
    (try (set! (.-maximumPacketSize this) maximumPacketSize) (finally (.unlock sessionLock))))

  (method getMaximumPacketSize ^int [this]
    (.lock sessionLock)
    (try maximumPacketSize (finally (.unlock sessionLock))))

  (method ^:public getLocalSupportedSignatureAlgorithms ^String/1 [this]
    (SignatureScheme/getAlgorithmNames localSupportedSignAlgs))

  (method getLocalSupportedSignatureSchemes ^{:tag (Collection SignatureScheme)} [this]
    localSupportedSignAlgs)

  (method ^:public getPeerSupportedSignatureAlgorithms ^String/1 [this]
    (SignatureScheme/getAlgorithmNames peerSupportedSignAlgs))

  (method getPeerSupportedSignatureSchemes ^{:tag (Collection SignatureScheme)} [this]
    peerSupportedSignAlgs)

  (method ^:public getRequestedServerNames ^{:tag (List SNIServerName)} [this]
    requestedServerNames)

  (method ^:public exportKeyingMaterial :throws [SSLKeyException] [this ^String keyAlg ^String label
                                                                   ^:mutable ^byte/1 context
                                                                   ^int length]
    (Objects/requireNonNull label "label can not be null")
    (when (< length 1) (throw (IllegalArgumentException. "length must be positive")))
    (cond
      (.useTLS13PlusSpec protocolVersion)
        (do
          (when (nil? exporterMasterSecret)
            (throw (IllegalStateException. "Exporter master secret not captured")))
          (when (> length (unchecked-multiply-int 255 (.-hashLength (.-hashAlg cipherSuite))))
            (throw (IllegalArgumentException. "length is too large")))
          (let [hkdfInfoLabel (.getBytes (java-str "tls13 " label) StandardCharsets/UTF_8)]
            (when (or (< (alength hkdfInfoLabel) 7) (> (alength hkdfInfoLabel) 255))
              (throw (IllegalArgumentException. "label length outside range")))
            (set! context (if (some? context) context (new byte/1 0)))
            (when (> (alength context) 255)
              (throw (IllegalArgumentException. "context length outside range")))
            (try
              (let [hashAlg (.-hashAlg cipherSuite)
                    hkdf (KDF/getInstance (.-hkdfAlgorithm hashAlg))
                    ^:mutable ^MessageDigest md nil
                    ^:mutable ^byte/1 emptyHash nil]
                (try
                  (set! md (MessageDigest/getInstance (.toString hashAlg)))
                  (set! emptyHash (.digest md))
                  (catch NoSuchAlgorithmException nsae
                    (throw (ProviderException.
                             (java-str "Hash algorithm "
                                       (.-name (.-hashAlg cipherSuite))
                                       " is not available")
                             nsae))))
                (let [^:mutable hkdfInfo (SSLSecretDerivation/createHkdfInfo
                                           hkdfInfoLabel
                                           emptyHash
                                           (.-hashLength hashAlg))
                      derivedSecret (.deriveKey hkdf
                                                "TlsKey"
                                                (HKDFParameterSpec/expandOnly
                                                  exporterMasterSecret
                                                  hkdfInfo
                                                  (.-hashLength hashAlg)))]
                  (try
                    (let [^byte/1 hash (if (> (alength context) 0) (.digest md context) emptyHash)]
                      (set! hkdfInfo
                            (SSLSecretDerivation/createHkdfInfo
                              (.getBytes "tls13 exporter" StandardCharsets/UTF_8)
                              hash
                              length))
                      (if (some? keyAlg)
                          ^Object (.deriveKey hkdf
                                              keyAlg
                                              (HKDFParameterSpec/expandOnly
                                                derivedSecret
                                                hkdfInfo
                                                length))
                          ^Object (.deriveData hkdf
                                               (HKDFParameterSpec/expandOnly
                                                 derivedSecret
                                                 hkdfInfo
                                                 length))))
                    (finally (KeyUtil/destroySecretKeys derivedSecret)))))
              (catch Exception e (throw (SSLKeyException. "Couldn't generate Exporter/HKDF" e))))))
      (.useTLS10PlusSpec protocolVersion)
        (do
          (when (or (nil? clientRandom) (nil? serverRandom))
            (throw (IllegalStateException. "Random nonces not captured")))
          (when-not useExtendedMasterSecret
            (throw (SSLKeyException. "Exporters require extended master secrets")))
          (when (.isEmpty label) (throw (IllegalArgumentException. "label length outside range")))
          (when (and (some? context) (> (alength context) 0xFFFF))
            (throw (IllegalArgumentException. "Only 16-bit context lengths supported")))
          (let [^:mutable ^String prfAlg nil
                ^:mutable ^CipherSuite$HashAlg hashAlg nil]
            (if (identical? protocolVersion ProtocolVersion/TLS12)
                (do (set! prfAlg "SunTls12Prf") (set! hashAlg (.-hashAlg cipherSuite)))
                (do (set! prfAlg "SunTlsPrf") (set! hashAlg CipherSuite$HashAlg/H_NONE)))
            (let [clientRandomBytes (.-randomBytes clientRandom)
                  serverRandomBytes (.-randomBytes serverRandom)
                  seed (new byte/1
                            (unchecked-add-int
                              (unchecked-add-int
                                (alength clientRandomBytes)
                                (alength serverRandomBytes))
                              (if (some? context) (unchecked-add-int 2 (alength context)) 0)))
                  ^:mutable ^int pos 0]
              (System/arraycopy clientRandomBytes 0 seed pos (alength clientRandomBytes))
              (set! pos (unchecked-add-int pos (alength clientRandomBytes)))
              (System/arraycopy serverRandomBytes 0 seed pos (alength serverRandomBytes))
              (set! pos (unchecked-add-int pos (alength serverRandomBytes)))
              (when (some? context)
                (aset seed
                      pos
                      (unchecked-byte (bit-and-int (bit-shift-right-int (alength context) 8) 0xFF)))
                (set! pos (unchecked-inc-int pos))
                (aset seed pos (unchecked-byte (bit-and-int (alength context) 0xFF)))
                (set! pos (unchecked-inc-int pos))
                (System/arraycopy context 0 seed pos (alength context)))
              (try
                (let [spec (TlsPrfParameterSpec.
                             masterSecret
                             ^String (if (nil? keyAlg) "TlsKey" keyAlg)
                             label
                             seed
                             length
                             (.-name hashAlg)
                             (.-hashLength hashAlg)
                             (.-blockSize hashAlg))
                      kg (KeyGenerator/getInstance prfAlg)]
                  (.init kg spec)
                  (let [key (.generateKey kg)]
                    (if (some? keyAlg)
                        key
                        (let [b (.getEncoded key)]
                          (when (nil? b)
                            (throw (UnsupportedOperationException.
                                     "Could not extract encoding from SecretKey")))
                          b))))
                (catch [NoSuchAlgorithmException InvalidAlgorithmParameterException] e
                  (throw (SSLKeyException. "Could not generate Exporter/PRF" e)))))))
      :else (throw (SSLKeyException. (java-str "Exporters not supported in " protocolVersion)))))

  (method ^:public exportKeyingMaterialKey :throws [SSLKeyException] ^SecretKey [this ^String keyAlg
                                                                                 ^String label
                                                                                 ^byte/1 context
                                                                                 ^int length]
    (Objects/requireNonNull keyAlg "keyAlg can not be null")
    (when (.isEmpty keyAlg) (throw (IllegalArgumentException. "keyAlg is empty")))
    (cast SecretKey (.exportKeyingMaterial this keyAlg label context length)))

  (method ^:public exportKeyingMaterialData :throws [SSLKeyException] ^byte/1 [this ^String label
                                                                               ^byte/1 context
                                                                               ^int length]
    (cast byte/1 (.exportKeyingMaterial this nil label context length)))

  (method ^:public toString ^String [this]
    (java-str "Session(" creationTime "|" (.getCipherSuite this) ")")))

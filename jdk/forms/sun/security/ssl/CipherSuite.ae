  (field ^:final ^int id)

  (field ^:final ^boolean isDefaultEnabled)

  (field ^:final ^String name)

  (field ^:final ^{:tag (List String)} aliases)

  (field ^:final ^{:tag (List ProtocolVersion)} supportedProtocols)

  (field ^:final ^KeyExchange keyExchange)

  (field ^:final ^SSLCipher bulkCipher)

  (field ^:final ^MacAlg macAlg)

  (field ^:final ^HashAlg hashAlg)

  (field ^:final ^boolean exportable)

  (field ^:private ^:static ^:final ^{:tag (Map Integer CipherSuite)} cipherSuiteIds)

  (field ^:private ^:static ^:final ^{:tag (Map String CipherSuite)} cipherSuiteNames)

  (field ^:private ^:static ^:final ^{:tag (List CipherSuite)} allowedCipherSuites)

  (field ^:private ^:static ^:final ^{:tag (List CipherSuite)} defaultCipherSuites)

  (static-initializer
    (let [^{:tag (Map Integer CipherSuite)} ids (HashMap.)
          ^{:tag (Map String CipherSuite)} names (HashMap.)
          ^{:tag (List CipherSuite)} allowedCS (ArrayList.)
          ^{:tag (List CipherSuite)} defaultCS (ArrayList.)]
      (for-each [^CipherSuite cs (CipherSuite/values)]
        (.put ids (.-id cs) cs)
        (.put names (.-name cs) cs)
        (for-each [^String alias (.-aliases cs)] (.put names alias cs))
        (when-not (.isEmpty (.-supportedProtocols cs)) (.add allowedCS cs))
        (when (.-isDefaultEnabled cs) (.add defaultCS cs)))
      (set! cipherSuiteIds (Map/copyOf ids))
      (set! cipherSuiteNames (Map/copyOf names))
      (set! allowedCipherSuites (List/copyOf allowedCS))
      (set! defaultCipherSuites (List/copyOf defaultCS))))

  (constructor [this ^String name ^int id]
    (this. id false name "" ProtocolVersion/PROTOCOLS_EMPTY nil nil nil nil))

  (constructor [this ^int id ^boolean isDefaultEnabled ^String name
                ^ProtocolVersion/1 supportedProtocols ^SSLCipher bulkCipher ^HashAlg hashAlg]
    (this. id isDefaultEnabled name "" supportedProtocols nil bulkCipher MacAlg/M_NULL hashAlg))

  (constructor [this ^int id ^boolean isDefaultEnabled ^String name ^String aliases
                ^ProtocolVersion/1 supportedProtocols ^KeyExchange keyExchange ^SSLCipher cipher
                ^MacAlg macAlg ^HashAlg hashAlg]
    (set! (.-id this) id)
    (set! (.-isDefaultEnabled this) isDefaultEnabled)
    (set! (.-name this) name)
    (if (not (.isEmpty aliases))
        (set! (.-aliases this) (Arrays/asList (.split aliases ",")))
        (set! (.-aliases this) (Collections/emptyList)))
    (set! (.-supportedProtocols this) (Arrays/asList supportedProtocols))
    (set! (.-keyExchange this) keyExchange)
    (set! (.-bulkCipher this) cipher)
    (set! (.-macAlg this) macAlg)
    (set! (.-hashAlg this) hashAlg)
    (set! (.-exportable this) (and (some? cipher) (.-exportable cipher))))

  (method ^:static nameOf ^CipherSuite [^String ciperSuiteName]
    (cast CipherSuite (.get cipherSuiteNames ciperSuiteName)))

  (method ^:static valueOf ^CipherSuite [^int id]
    (cast CipherSuite (.get cipherSuiteIds id)))

  (method ^:static nameOf ^String [^int id]
    (let [cs (cast CipherSuite (.get cipherSuiteIds id))]
      (if (some? cs)
          (.-name cs)
          (java-str "UNKNOWN-CIPHER-SUITE(" (Utilities/byte16HexString id) ")"))))

  (method ^:static allowedCipherSuites ^{:tag (Collection CipherSuite)} []
    allowedCipherSuites)

  (method ^:static defaultCipherSuites ^{:tag (Collection CipherSuite)} []
    defaultCipherSuites)

  (method ^:static validValuesOf ^{:tag (List CipherSuite)} [^String/1 names]
    (when (nil? names) (throw (IllegalArgumentException. "CipherSuites cannot be null")))
    (let [^{:tag (List CipherSuite)} cipherSuites (ArrayList. (alength names))]
      (for-each [^String name names]
        (when (or (nil? name) (.isEmpty name))
          (throw
            (IllegalArgumentException.
              "The specified CipherSuites array contains invalid null or empty string elements")))
        (let [^:mutable found false
              ^:mutable ^CipherSuite cs nil]
          (when (and (some? (set! cs (cast CipherSuite (.get cipherSuiteNames name))))
                     (not (.isEmpty (.-supportedProtocols cs))))
            (.add cipherSuites cs)
            (set! found true))
          (when-not found
            (throw (IllegalArgumentException. (java-str "Unsupported CipherSuite: " name))))))
      (Collections/unmodifiableList cipherSuites)))

  (method ^:static namesOf ^String/1 [^{:tag (List CipherSuite)} cipherSuites]
    (let [names (new String/1 (.size cipherSuites))
          ^:mutable ^int i 0]
      (for-each [^CipherSuite cipherSuite cipherSuites]
        (aset names i (.-name cipherSuite))
        (set! i (unchecked-inc-int i)))
      names))

  (method isAvailable ^boolean [this]
    (and (and (and (not (.isEmpty supportedProtocols))
                   (or (nil? keyExchange) (.isAvailable keyExchange)))
              (some? bulkCipher))
         (.isAvailable bulkCipher)))

  (method ^:public supports ^boolean [this ^ProtocolVersion protocolVersion]
    (.contains supportedProtocols protocolVersion))

  (method isNegotiable ^boolean [this]
    (and (not (identical? this TLS_EMPTY_RENEGOTIATION_INFO_SCSV)) (.isAvailable this)))

  (method isAnonymous ^boolean [this]
    (and (some? keyExchange) (.-isAnonymous keyExchange)))

  (method calculatePacketSize ^int [this ^int fragmentSize ^ProtocolVersion protocolVersion
                                    ^boolean isDTLS]
    (let [^:mutable packetSize fragmentSize]
      (when (and (some? bulkCipher) (not (identical? bulkCipher SSLCipher/B_NULL)))
        (let [blockSize (.-ivSize bulkCipher)]
          (switch (.-cipherType bulkCipher)
            BLOCK_CIPHER
              (do
                (set! packetSize (unchecked-add-int packetSize (.-size macAlg)))
                (set! packetSize (unchecked-add-int packetSize 1))
                (set! packetSize
                      (unchecked-add-int packetSize
                                         (unchecked-remainder-int
                                           (unchecked-subtract-int
                                             blockSize
                                             (unchecked-remainder-int packetSize blockSize))
                                           blockSize)))
                (when (.useTLS11PlusSpec protocolVersion)
                  (set! packetSize (unchecked-add-int packetSize blockSize))))
            AEAD_CIPHER
              (do
                (when (or (identical? protocolVersion ProtocolVersion/TLS12)
                          (identical? protocolVersion ProtocolVersion/DTLS12))
                  (set! packetSize
                        (unchecked-add-int packetSize
                                           (unchecked-subtract-int
                                             (.-ivSize bulkCipher)
                                             (.-fixedIvSize bulkCipher)))))
                (set! packetSize (unchecked-add-int packetSize (.-tagSize bulkCipher))))
            (set! packetSize (unchecked-add-int packetSize (.-size macAlg))))))
      (unchecked-add-int packetSize (if isDTLS DTLSRecord/headerSize SSLRecord/headerSize))))

  (method calculateFragSize ^int [this ^int packetLimit ^ProtocolVersion protocolVersion
                                  ^boolean isDTLS]
    (let [^:mutable fragSize (unchecked-subtract-int
                               packetLimit
                               (if isDTLS DTLSRecord/headerSize SSLRecord/headerSize))]
      (when (and (some? bulkCipher) (not (identical? bulkCipher SSLCipher/B_NULL)))
        (let [blockSize (.-ivSize bulkCipher)]
          (switch (.-cipherType bulkCipher)
            BLOCK_CIPHER
              (do
                (when (.useTLS11PlusSpec protocolVersion)
                  (set! fragSize (unchecked-subtract-int fragSize blockSize)))
                (set!
                  fragSize
                  (unchecked-subtract-int fragSize (unchecked-remainder-int fragSize blockSize)))
                (set! fragSize (unchecked-subtract-int fragSize 1))
                (set! fragSize (unchecked-subtract-int fragSize (.-size macAlg))))
            AEAD_CIPHER
              (do
                (set! fragSize (unchecked-subtract-int fragSize (.-tagSize bulkCipher)))
                (set! fragSize
                      (unchecked-subtract-int fragSize
                                              (unchecked-subtract-int
                                                (.-ivSize bulkCipher)
                                                (.-fixedIvSize bulkCipher)))))
            (set! fragSize (unchecked-subtract-int fragSize (.-size macAlg))))))
      fragSize))

  (defclass ^:enum KeyExchange
    (constants
      (K_NULL ["NULL" false true NamedGroup$NamedGroupSpec/NAMED_GROUP_NONE])
      (K_RSA ["RSA" true false NamedGroup$NamedGroupSpec/NAMED_GROUP_NONE])
      (K_RSA_EXPORT ["RSA_EXPORT" true false NamedGroup$NamedGroupSpec/NAMED_GROUP_NONE])
      (K_DH_RSA ["DH_RSA" false false NamedGroup$NamedGroupSpec/NAMED_GROUP_NONE])
      (K_DH_DSS ["DH_DSS" false false NamedGroup$NamedGroupSpec/NAMED_GROUP_NONE])
      (K_DHE_DSS ["DHE_DSS" true false NamedGroup$NamedGroupSpec/NAMED_GROUP_FFDHE])
      (K_DHE_DSS_EXPORT ["DHE_DSS_EXPORT" true false NamedGroup$NamedGroupSpec/NAMED_GROUP_NONE])
      (K_DHE_RSA ["DHE_RSA" true false NamedGroup$NamedGroupSpec/NAMED_GROUP_FFDHE])
      (K_DHE_RSA_EXPORT ["DHE_RSA_EXPORT" true false NamedGroup$NamedGroupSpec/NAMED_GROUP_NONE])
      (K_DH_ANON ["DH_anon" true true NamedGroup$NamedGroupSpec/NAMED_GROUP_FFDHE])
      (K_DH_ANON_EXPORT ["DH_anon_EXPORT" true true NamedGroup$NamedGroupSpec/NAMED_GROUP_NONE])
      (K_ECDH_ECDSA ["ECDH_ECDSA"
                     JsseJce/ALLOW_ECC
                     false
                     NamedGroup$NamedGroupSpec/NAMED_GROUP_ECDHE
                     NamedGroup$NamedGroupSpec/NAMED_GROUP_XDH])
      (K_ECDH_RSA ["ECDH_RSA"
                   JsseJce/ALLOW_ECC
                   false
                   NamedGroup$NamedGroupSpec/NAMED_GROUP_ECDHE
                   NamedGroup$NamedGroupSpec/NAMED_GROUP_XDH])
      (K_ECDHE_ECDSA
        ["ECDHE_ECDSA"
         JsseJce/ALLOW_ECC
         false
         NamedGroup$NamedGroupSpec/NAMED_GROUP_ECDHE
         NamedGroup$NamedGroupSpec/NAMED_GROUP_XDH])
      (K_ECDHE_RSA ["ECDHE_RSA"
                    JsseJce/ALLOW_ECC
                    false
                    NamedGroup$NamedGroupSpec/NAMED_GROUP_ECDHE
                    NamedGroup$NamedGroupSpec/NAMED_GROUP_XDH])
      (K_ECDH_ANON ["ECDH_anon"
                    JsseJce/ALLOW_ECC
                    true
                    NamedGroup$NamedGroupSpec/NAMED_GROUP_ECDHE
                    NamedGroup$NamedGroupSpec/NAMED_GROUP_XDH])
      (K_SCSV ["SCSV" true true NamedGroup$NamedGroupSpec/NAMED_GROUP_NONE]))

    (field ^:final ^String name)

    (field ^:final ^boolean allowed)

    (field ^:final ^NamedGroup$NamedGroupSpec/1 groupTypes)

    (field ^:private ^:final ^boolean alwaysAvailable)

    (field ^:private ^:final ^boolean isAnonymous)

    (constructor [this ^String name ^boolean allowed ^boolean isAnonymous &
                  ^NamedGroup$NamedGroupSpec/1 groupTypes]
      (set! (.-name this) name)
      (set! (.-groupTypes this) groupTypes)
      (set! (.-allowed this) allowed)
      (set! (.-alwaysAvailable this) (and allowed (not (.startsWith name "EC"))))
      (set! (.-isAnonymous this) isAnonymous))

    (method isAvailable ^boolean [this]
      (cond
        alwaysAvailable true
        (NamedGroup$NamedGroupSpec/arrayContains
          groupTypes
          NamedGroup$NamedGroupSpec/NAMED_GROUP_ECDHE)
          (and allowed (JsseJce/isEcAvailable))
        :else allowed))

    (method ^:public toString ^String [this] name))

  (defclass ^:enum MacAlg
    (constants
      (M_NULL ["NULL" 0 0 0])
      (M_MD5 ["MD5" 16 64 9])
      (M_SHA ["SHA" 20 64 9])
      (M_SHA256 ["SHA256" 32 64 9])
      (M_SHA384 ["SHA384" 48 128 17]))

    (field ^:final ^String name)

    (field ^:final ^int size)

    (field ^:final ^int hashBlockSize)

    (field ^:final ^int minimalPaddingSize)

    (constructor [this ^String name ^int size ^int hashBlockSize ^int minimalPaddingSize]
      (set! (.-name this) name)
      (set! (.-size this) size)
      (set! (.-hashBlockSize this) hashBlockSize)
      (set! (.-minimalPaddingSize this) minimalPaddingSize))

    (method ^:public toString ^String [this] name))

  (defclass ^:enum HashAlg
    (constants (H_NONE ["NONE" 0 0]) (H_SHA256 ["SHA-256" 32 64]) (H_SHA384 ["SHA-384" 48 128]))

    (field ^:final ^String name)

    (field ^:final ^int hashLength)

    (field ^:final ^int blockSize)

    (field ^:final ^String hkdfAlgorithm)

    (constructor [this ^String hashAlg ^int hashLength ^int blockSize]
      (set! (.-name this) hashAlg)
      (set! (.-hashLength this) hashLength)
      (set! (.-blockSize this) blockSize)
      (set! (.-hkdfAlgorithm this) (java-str "HKDF-" (.replace hashAlg "-" ""))))

    (method ^:public toString ^String [this] name)))

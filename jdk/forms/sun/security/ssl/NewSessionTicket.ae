                  nstm))
            :else
              (let [sessionCache (cast SSLSessionContextImpl
                                       (.engineGetClientSessionContext (.-sslContext hc)))]
                (if (> (.getSessionTimeout sessionCache) MAX_TICKET_LIFETIME)
                    (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
                      (SSLLogger/fine "Session cache lifetime is too long. Discarding ticket."))

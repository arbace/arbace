                      (SSLLogger/fine "Session has no resumption master secret. Ignoring ticket."))
                    (let [psk (NewSessionTicket/derivePreSharedKey
                                (.-hashAlg (.getSuite sessionToSave))
                                resumptionMasterSecret
                                (.getTicketNonce nstm))
                          newId (SessionId. true (.getSecureRandom (.-sslContext hc)))
                          sessionCopy (SSLSessionImpl. sessionToSave newId)]

                      (.setPreSharedKey sessionCopy psk)
                      (.setTicketAgeAdd sessionCopy (.getTicketAgeAdd nstm))
                      (.setPskIdentity sessionCopy (.-ticket nstm))
                      (.put sessionCache sessionCopy (.isPSK sessionCopy))

            (or (<= (.-ticketLifetime nstm) 0) (> (.-ticketLifetime nstm) MAX_TICKET_LIFETIME))
              (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
                (SSLLogger/fine
                  (java-str "Discarding NewSessionTicket with lifetime " (.-ticketLifetime nstm))
                  nstm))
            (> (.getSessionTimeout sessionCache) MAX_TICKET_LIFETIME)
              (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
                (SSLLogger/fine "Session cache lifetime is too long. Discarding ticket."))
            :else
              (let [sessionToSave (.-conSession (.-conContext hc))
                    resumptionMasterSecret (.getResumptionMasterSecret sessionToSave)]
                (if (nil? resumptionMasterSecret)

      (let [messageFormat (MessageFormat.
                            "\"CertificateRequest\": '{'\n  \"certificate_request_context\": \"{0}\",\n  \"extensions\": [\n{1}\n  ]\n'}'"
                            Locale/ENGLISH)
            messageFields (new Object/1
                               [(Utilities/toHexString requestContext)
                                (Utilities/indent (Utilities/indent (.toString extensions)))])]
        (.format messageFormat messageFields))))

  (defclass ^:private ^:static ^:final T13CertificateRequestProducer
    :implements [HandshakeProducer]

    (constructor ^:private [this])

    (method ^:public produce :throws [IOException] ^byte/1 [this ^ConnectionContext context
                                                            ^SSLHandshake$HandshakeMessage message]
      (let [shc (cast ServerHandshakeContext context)
            crm (T13CertificateRequestMessage. shc)
            extTypes (.getEnabledExtensions (.-sslConfig shc)
                                            SSLHandshake/CERTIFICATE_REQUEST
                                            (.-negotiatedProtocol shc))]
        (.produce (.-extensions crm) shc extTypes)
        (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
          (SSLLogger/fine "Produced CertificateRequest message" crm))
        (.write crm (.-handshakeOutput shc))
        (.flush (.-handshakeOutput shc))
        (set! (.-certRequestContext shc) (.clone (.-requestContext crm)))
        (.put (.-handshakeConsumers shc) (.-id SSLHandshake/CERTIFICATE) SSLHandshake/CERTIFICATE)
        (.put (.-handshakeConsumers shc)
              (.-id SSLHandshake/CERTIFICATE_VERIFY)
              SSLHandshake/CERTIFICATE_VERIFY)
        nil)))

  (defclass ^:private ^:static ^:final T13CertificateRequestConsumer
    :implements [SSLConsumer]

    (constructor ^:private [this])

    (method ^:public consume :throws [IOException] ^void [this ^ConnectionContext context
                                                          ^ByteBuffer message]
      (let [chc (cast ClientHandshakeContext context)]
        (.remove (.-handshakeConsumers chc) (.-id SSLHandshake/CERTIFICATE_REQUEST))
        (set! (.-receivedCertReq chc) true)
        (when (.containsKey (.-handshakeConsumers chc) (.-id SSLHandshake/ENCRYPTED_EXTENSIONS))
          (throw (.fatal (.-conContext chc)
                         Alert/UNEXPECTED_MESSAGE
                         "Unexpected CertificateRequest handshake message")))
        (let [crm (T13CertificateRequestMessage. chc message)]
          (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
            (SSLLogger/fine "Consuming CertificateRequest handshake message" crm))
          (let [extTypes (.getEnabledExtensions (.-sslConfig chc) SSLHandshake/CERTIFICATE_REQUEST)]
            (.consumeOnLoad (.-extensions crm) chc extTypes)
            (.consumeOnTrade (.-extensions crm) chc extTypes)
            (set! (.-certRequestContext chc) (.clone (.-requestContext crm)))
            (.put (.-handshakeProducers chc)
                  (.-id SSLHandshake/CERTIFICATE)
                  SSLHandshake/CERTIFICATE)
            (.put (.-handshakeProducers chc)
                  (.-id SSLHandshake/CERTIFICATE_VERIFY)
                  SSLHandshake/CERTIFICATE_VERIFY)))))))

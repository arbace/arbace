  (defclass ^:private ^:static ^:final ClientHelloProducer
    :implements [HandshakeProducer]

    (constructor ^:private [this])

    (method ^:public produce :throws [IOException] ^byte/1 [this ^ConnectionContext context
                                                            ^SSLHandshake$HandshakeMessage message]
      (let [chc (cast ClientHandshakeContext context)
            ht (.handshakeType message)]
        (when (nil? ht) (throw (UnsupportedOperationException. "Not supported yet.")))
        (switch ht
          HELLO_REQUEST
            (do
              (try
                (.kickstart chc)
                (catch IOException ioe
                  (throw (.fatal (.-conContext chc) Alert/HANDSHAKE_FAILURE ioe))))
              nil)
          HELLO_VERIFY_REQUEST
            (do
              (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
                (SSLLogger/fine "Produced ClientHello(cookie) handshake message"
                                (.-initialClientHelloMsg chc)))
              (.write (.-initialClientHelloMsg chc) (.-handshakeOutput chc))
              (.flush (.-handshakeOutput chc))
              (.put (.-handshakeConsumers chc)
                    (.-id SSLHandshake/SERVER_HELLO)
                    SSLHandshake/SERVER_HELLO)
              (let [^:mutable minimumVersion ProtocolVersion/NONE]
                (for-each [^ProtocolVersion pv (.-activeProtocols chc)]
                  (when (or (identical? minimumVersion ProtocolVersion/NONE)
                            (< (.compare pv minimumVersion) 0))
                    (set! minimumVersion pv)))
                (when (and (.isDTLS (.-sslContext chc)) (not (.useTLS13PlusSpec minimumVersion)))
                  (.put (.-handshakeConsumers chc)
                        (.-id SSLHandshake/HELLO_VERIFY_REQUEST)
                        SSLHandshake/HELLO_VERIFY_REQUEST))
                nil))
          HELLO_RETRY_REQUEST
            (do
              (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
                (SSLLogger/fine "Produced ClientHello(HRR) handshake message"
                                (.-initialClientHelloMsg chc)))
              (.write (.-initialClientHelloMsg chc) (.-handshakeOutput chc))
              (.flush (.-handshakeOutput chc))
              (.putIfAbsent (.-consumers (.-conContext chc))
                            (.-id ContentType/CHANGE_CIPHER_SPEC)
                            ChangeCipherSpec/t13Consumer)
              (.put (.-handshakeConsumers chc)
                    (.-id SSLHandshake/SERVER_HELLO)
                    SSLHandshake/SERVER_HELLO)
              nil)
          (throw (UnsupportedOperationException. "Not supported yet."))))))

  (defclass ^:private ^:static ^:final ClientHelloConsumer
    :implements [SSLConsumer]

    (constructor ^:private [this])

    (method ^:public consume :throws [IOException] ^void [this ^ConnectionContext context
                                                          ^ByteBuffer message]
      (let [shc (cast ServerHandshakeContext context)]
        (.remove (.-handshakeConsumers shc) (.-id SSLHandshake/CLIENT_HELLO))
        (when-not (.isEmpty (.-handshakeConsumers shc))
          (throw (.fatal (.-conContext shc)
                         Alert/UNEXPECTED_MESSAGE
                         "No more handshake message allowed in a ClientHello flight")))
        (let [enabledExtensions (.getEnabledExtensions (.-sslConfig shc) SSLHandshake/CLIENT_HELLO)
              chm (ClientHelloMessage. shc message enabledExtensions)]
          (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
            (SSLLogger/fine "Consuming ClientHello handshake message" chm))
          (set! (.-clientHelloVersion shc) (.-clientVersion chm))
          (.onClientHello this shc chm))))

    (method ^:private onClientHello :throws [IOException] ^void [this
                                                                 ^ServerHandshakeContext context
                                                                 ^ClientHelloMessage clientHello]
      (let [extTypes (new SSLExtension/1 [SSLExtension/CH_SUPPORTED_VERSIONS])]
        (.consumeOnLoad (.-extensions clientHello) context extTypes)
        (let [^:mutable ^ProtocolVersion negotiatedProtocol nil
              svs (cast SupportedVersionsExtension$CHSupportedVersionsSpec
                        (.get (.-handshakeExtensions context) SSLExtension/CH_SUPPORTED_VERSIONS))]
          (if (some? svs)
              (set! negotiatedProtocol (.negotiateProtocol this context (.-requestedProtocols svs)))
              (set! negotiatedProtocol
                    (.negotiateProtocol this context (.-clientVersion clientHello))))
          (set! (.-negotiatedProtocol context) negotiatedProtocol)
          (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake"))
            (SSLLogger/fine (java-str "Negotiated protocol version: " (.-name negotiatedProtocol))))
          (SignatureScheme/updateHandshakeLocalSupportedAlgs context)
          (cond
            (.-isDTLS negotiatedProtocol)
              (if (.useTLS13PlusSpec negotiatedProtocol)
                  (.consume d13HandshakeConsumer context clientHello)
                  (.consume d12HandshakeConsumer context clientHello))
            (.useTLS13PlusSpec negotiatedProtocol)
              (.consume t13HandshakeConsumer context clientHello)
            :else (.consume t12HandshakeConsumer context clientHello)))))

    (method ^:private negotiateProtocol :throws [SSLException] ^ProtocolVersion [this
                                                                                 ^ServerHandshakeContext context
                                                                                 ^int clientHelloVersion]
      (let [^:mutable chv clientHelloVersion]
        (cond
          (.isDTLS (.-sslContext context))
            (when (< chv (.-id ProtocolVersion/DTLS12)) (set! chv (.-id ProtocolVersion/DTLS12)))
          (> chv (.-id ProtocolVersion/TLS12)) (set! chv (.-id ProtocolVersion/TLS12)))
        (let [pv (ProtocolVersion/selectedFrom (.-activeProtocols context) chv)]
          (when (or (or (nil? pv) (identical? pv ProtocolVersion/NONE))
                    (identical? pv ProtocolVersion/SSL20Hello))
            (throw (.fatal (.-conContext context)
                           Alert/PROTOCOL_VERSION
                           (java-str "Client requested protocol "
                                     (ProtocolVersion/nameOf clientHelloVersion)
                                     " is not enabled or supported in server context"))))
          pv)))

    (method ^:private negotiateProtocol :throws [SSLException] ^ProtocolVersion [this
                                                                                 ^ServerHandshakeContext context
                                                                                 ^int/1 clientSupportedVersions]
      (for-each [^ProtocolVersion spv (.-activeProtocols context)]
        (when-not (identical? spv ProtocolVersion/SSL20Hello)
          (for-each [^int cpv clientSupportedVersions]
            (when-not (== cpv (.-id ProtocolVersion/SSL20Hello))
              (when (== (.-id spv) cpv) (return spv))))))
      (throw (.fatal (.-conContext context)
                     Alert/PROTOCOL_VERSION
                     (java-str "The client supported protocol versions "
                               (Arrays/toString
                                 (ProtocolVersion/toStringArray clientSupportedVersions))
                               " are not accepted by server preferences "
                               (Arrays/toString
                                 (ProtocolVersion/toStringArray (.-activeProtocols context))))))))


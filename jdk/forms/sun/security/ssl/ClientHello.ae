            clientHello (cast ClientHelloMessage message)]
        (when (.-isNegotiated (.-conContext shc))
          (when (and (not (.-secureRenegotiation (.-conContext shc)))
                     (not HandshakeContext/allowUnsafeRenegotiation))
            (throw (.fatal (.-conContext shc)
                           Alert/HANDSHAKE_FAILURE
                           "Unsafe renegotiation is not allowed")))
          (when (and ServerHandshakeContext/rejectClientInitiatedRenego
                     (not (.-kickstartMessageDelivered shc)))
            (throw (.fatal (.-conContext shc)
                           Alert/HANDSHAKE_FAILURE
                           "Client initiated renegotiation is not allowed"))))
        (let [ext (new SSLExtension/1 [SSLExtension/CH_SESSION_TICKET])]
          (.consumeOnLoad (.-extensions clientHello) shc ext)
          (when (or (not (== (.length (.-sessionId clientHello)) 0)) (.-statelessResumption shc))
            (let [cache (cast SSLSessionContextImpl
                              (.engineGetServerSessionContext (.-sslContext shc)))
                  ^SSLSessionImpl previous (if (.-statelessResumption shc)
                                               (.-resumingSession shc)
                                               (.get cache (.getId (.-sessionId clientHello))))]
              (let [^:mutable resumingSession (and (some? previous) (.isRejoinable previous))]
                (when-not resumingSession
                  (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake,verbose"))
                    (SSLLogger/finest "Can't resume, the existing session is not rejoinable")))
                (when resumingSession
                  (let [sessionProtocol (.getProtocolVersion previous)]
                    (when-not (identical? sessionProtocol (.-negotiatedProtocol shc))
                      (set! resumingSession false)
                      (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake,verbose"))
                        (SSLLogger/finest "Can't resume, not the same protocol version")))))
                (when (and resumingSession
                           (identical? (.-clientAuthType (.-sslConfig shc))
                                       ClientAuthType/CLIENT_AUTH_REQUIRED))
                  (try
                    (.getPeerPrincipal previous)
                    (catch SSLPeerUnverifiedException e
                      (set! resumingSession false)
                      (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake,verbose"))
                        (SSLLogger/finest "Can't resume, client authentication is required")))))
                (when resumingSession
                  (let [suite (.getSuite previous)]
                    (when (or (not (.isNegotiable shc suite))
                              (not (.contains (.-cipherSuites clientHello) suite)))
                      (set! resumingSession false)
                      (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake,verbose"))
                        (SSLLogger/finest "Can't resume, the session cipher suite is absent")))))
                (let [identityAlg (.-identificationProtocol (.-sslConfig shc))]
                  (when (and resumingSession (some? identityAlg))
                    (let [sessionIdentityAlg (.getIdentificationProtocol previous)]
                      (when-not (.equalsIgnoreCase identityAlg sessionIdentityAlg)
                        (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake,verbose"))
                          (SSLLogger/finest
                            (java-str
                              "Can't resume, endpoint id algorithm does not match, requested: "
                              identityAlg
                              ", cached: "
                              sessionIdentityAlg)))
                        (set! resumingSession false))))
                  (set! (.-isResumption shc) resumingSession)
                  (set! (.-resumingSession shc) (when resumingSession previous))
                  (when (and (and (not resumingSession) (SSLLogger/isOn))
                             (SSLLogger/isOn "ssl,handshake"))
                    (SSLLogger/fine "Session not resumed."))))))
          (set! (.-clientHelloRandom shc) (.-clientRandom clientHello))
          (let [extTypes (.getExclusiveExtensions
                           (.-sslConfig shc)
                           SSLHandshake/CLIENT_HELLO
                           (List/of SSLExtension/CH_SESSION_TICKET))]
            (.consumeOnLoad (.-extensions clientHello) shc extTypes)
            (when-not (.-isNegotiated (.-conContext shc))
              (set! (.-protocolVersion (.-conContext shc)) (.-negotiatedProtocol shc))
              (.setVersion (.-outputRecord (.-conContext shc)) (.-negotiatedProtocol shc)))
            (.put (.-handshakeProducers shc)
                  (.-id SSLHandshake/SERVER_HELLO)
                  SSLHandshake/SERVER_HELLO)
            (let [probableHandshakeMessages (new
                                              SSLHandshake/1
                                              [SSLHandshake/SERVER_HELLO
                                               SSLHandshake/CERTIFICATE
                                               SSLHandshake/CERTIFICATE_STATUS
                                               SSLHandshake/SERVER_KEY_EXCHANGE
                                               SSLHandshake/CERTIFICATE_REQUEST
                                               SSLHandshake/SERVER_HELLO_DONE
                                               SSLHandshake/FINISHED])]
              (for-each [^SSLHandshake hs probableHandshakeMessages]
                (let [handshakeProducer (cast HandshakeProducer
                                              (.remove (.-handshakeProducers shc) (.-id hs)))]
                  (when (some? handshakeProducer) (.produce handshakeProducer context clientHello))))))))))

  (defclass ^:private ^:static ^:final T13ClientHelloConsumer
    :implements [HandshakeConsumer]

    (constructor ^:private [this])

    (method ^:public consume :throws [IOException] ^void [this ^ConnectionContext context
                                                          ^SSLHandshake$HandshakeMessage message]
      (let [shc (cast ServerHandshakeContext context)
            clientHello (cast ClientHelloMessage message)]
        (when (.-isNegotiated (.-conContext shc))
          (throw (.fatal (.-conContext shc)
                         Alert/UNEXPECTED_MESSAGE
                         "Received unexpected renegotiation handshake message")))
        (when-not (== (.-clientVersion clientHello) (.-id ProtocolVersion/TLS12))
          (throw (.fatal (.-conContext shc)
                         Alert/PROTOCOL_VERSION
                         "The ClientHello.legacy_version field is not TLS 1.2")))
        (.putIfAbsent (.-consumers (.-conContext shc))
                      (.-id ContentType/CHANGE_CIPHER_SPEC)
                      ChangeCipherSpec/t13Consumer)
        (set! (.-isResumption shc) true)
        (let [^:mutable extTypes (new SSLExtension/1
                                      [SSLExtension/PSK_KEY_EXCHANGE_MODES
                                       SSLExtension/CH_PRE_SHARED_KEY])]
          (.consumeOnLoad (.-extensions clientHello) shc extTypes)
          (set! extTypes
                (.getExclusiveExtensions (.-sslConfig shc)
                                         SSLHandshake/CLIENT_HELLO
                                         (Arrays/asList
                                           (new SSLExtension/1
                                                [SSLExtension/PSK_KEY_EXCHANGE_MODES
                                                 SSLExtension/CH_PRE_SHARED_KEY
                                                 SSLExtension/CH_SUPPORTED_VERSIONS]))))
          (.consumeOnLoad (.-extensions clientHello) shc extTypes)
          (if (not (.isEmpty (.-handshakeProducers shc)))
              (.goHelloRetryRequest this shc clientHello)
              (.goServerHello this shc clientHello)))))

    (method ^:private goHelloRetryRequest :throws [IOException] ^void [this
                                                                       ^ServerHandshakeContext shc
                                                                       ^ClientHelloMessage clientHello]
      (let [handshakeProducer (cast HandshakeProducer
                                    (.remove (.-handshakeProducers shc)
                                             (.-id SSLHandshake/HELLO_RETRY_REQUEST)))]
        (if (some? handshakeProducer)
            (.produce handshakeProducer shc clientHello)
            (throw (.fatal (.-conContext shc)
                           Alert/HANDSHAKE_FAILURE
                           (java-str "No HelloRetryRequest producer: " (.-handshakeProducers shc)))))
        (when-not (.isEmpty (.-handshakeProducers shc))
          (throw (.fatal (.-conContext shc)
                         Alert/HANDSHAKE_FAILURE
                         (java-str "unknown handshake producers: " (.-handshakeProducers shc)))))))

    (method ^:private goServerHello :throws [IOException] ^void [this ^ServerHandshakeContext shc
                                                                 ^ClientHelloMessage clientHello]
      (set! (.-clientHelloRandom shc) (.-clientRandom clientHello))
      (when-not (.-isNegotiated (.-conContext shc))
        (set! (.-protocolVersion (.-conContext shc)) (.-negotiatedProtocol shc))
        (.setVersion (.-outputRecord (.-conContext shc)) (.-negotiatedProtocol shc)))
      (.put (.-handshakeProducers shc) (.-id SSLHandshake/SERVER_HELLO) SSLHandshake/SERVER_HELLO)
      (let [probableHandshakeMessages (new SSLHandshake/1
                                           [SSLHandshake/SERVER_HELLO
                                            SSLHandshake/ENCRYPTED_EXTENSIONS
                                            SSLHandshake/CERTIFICATE_REQUEST
                                            SSLHandshake/CERTIFICATE
                                            SSLHandshake/CERTIFICATE_VERIFY
                                            SSLHandshake/FINISHED])]
        (for-each [^SSLHandshake hs probableHandshakeMessages]
          (let [handshakeProducer (cast HandshakeProducer
                                        (.remove (.-handshakeProducers shc) (.-id hs)))]
            (when (some? handshakeProducer) (.produce handshakeProducer shc clientHello)))))))

  (defclass ^:private ^:static ^:final D12ClientHelloConsumer
    :implements [HandshakeConsumer]

    (constructor ^:private [this])

    (method ^:public consume :throws [IOException] ^void [this ^ConnectionContext context
                                                          ^SSLHandshake$HandshakeMessage message]
      (let [shc (cast ServerHandshakeContext context)
            clientHello (cast ClientHelloMessage message)]
        (when (.-isNegotiated (.-conContext shc))
          (when (and (not (.-secureRenegotiation (.-conContext shc)))
                     (not HandshakeContext/allowUnsafeRenegotiation))
            (throw (.fatal (.-conContext shc)
                           Alert/HANDSHAKE_FAILURE
                           "Unsafe renegotiation is not allowed")))
          (when (and ServerHandshakeContext/rejectClientInitiatedRenego
                     (not (.-kickstartMessageDelivered shc)))
            (throw (.fatal (.-conContext shc)
                           Alert/HANDSHAKE_FAILURE
                           "Client initiated renegotiation is not allowed"))))
        (when-not (== (.length (.-sessionId clientHello)) 0)
          (let [cache (cast SSLSessionContextImpl
                            (.engineGetServerSessionContext (.-sslContext shc)))
                ext (new SSLExtension/1 [SSLExtension/CH_SESSION_TICKET])]
            (.consumeOnLoad (.-extensions clientHello) shc ext)
            (let [^SSLSessionImpl previous (if (.-statelessResumption shc)
                                               (.-resumingSession shc)
                                               (.get cache (.getId (.-sessionId clientHello))))]
              (let [^:mutable resumingSession (and (some? previous) (.isRejoinable previous))]
                (when-not resumingSession
                  (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake,verbose"))
                    (SSLLogger/finest "Can't resume, the existing session is not rejoinable")))
                (when resumingSession
                  (let [sessionProtocol (.getProtocolVersion previous)]
                    (when-not (identical? sessionProtocol (.-negotiatedProtocol shc))
                      (set! resumingSession false)
                      (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake,verbose"))
                        (SSLLogger/finest "Can't resume, not the same protocol version")))))
                (when (and resumingSession
                           (identical? (.-clientAuthType (.-sslConfig shc))
                                       ClientAuthType/CLIENT_AUTH_REQUIRED))
                  (try
                    (.getPeerPrincipal previous)
                    (catch SSLPeerUnverifiedException e
                      (set! resumingSession false)
                      (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake,verbose"))
                        (SSLLogger/finest "Can't resume, client authentication is required")))))
                (when resumingSession
                  (let [suite (.getSuite previous)]
                    (when (or (not (.isNegotiable shc suite))
                              (not (.contains (.-cipherSuites clientHello) suite)))
                      (set! resumingSession false)
                      (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,handshake,verbose"))
                        (SSLLogger/finest "Can't resume, the session cipher suite is absent")))))
                (set! (.-isResumption shc) resumingSession)
                (set! (.-resumingSession shc) (when resumingSession previous))))))
        (when (or (not (.-isResumption shc)) SSLConfiguration/enableDtlsResumeCookie)
          (let [hcm (.getHelloCookieManager (.-sslContext shc) ProtocolVersion/DTLS10)]
            (when-not (.isCookieValid hcm shc clientHello (.-cookie clientHello))
              (.put (.-handshakeProducers shc)
                    (.-id SSLHandshake/HELLO_VERIFY_REQUEST)
                    SSLHandshake/HELLO_VERIFY_REQUEST)
              (.produce SSLHandshake/HELLO_VERIFY_REQUEST context clientHello)
              (return))))
        (set! (.-clientHelloRandom shc) (.-clientRandom clientHello))
        (let [extTypes (.getEnabledExtensions (.-sslConfig shc) SSLHandshake/CLIENT_HELLO)]
          (.consumeOnLoad (.-extensions clientHello) shc extTypes)
          (when-not (.-isNegotiated (.-conContext shc))
            (set! (.-protocolVersion (.-conContext shc)) (.-negotiatedProtocol shc))
            (.setVersion (.-outputRecord (.-conContext shc)) (.-negotiatedProtocol shc)))
          (.put (.-handshakeProducers shc)
                (.-id SSLHandshake/SERVER_HELLO)
                SSLHandshake/SERVER_HELLO)
          (set! (.-acceptCliHelloFragments shc) false)
          (let [probableHandshakeMessages (new SSLHandshake/1
                                               [SSLHandshake/SERVER_HELLO
                                                SSLHandshake/CERTIFICATE
                                                SSLHandshake/CERTIFICATE_STATUS
                                                SSLHandshake/SERVER_KEY_EXCHANGE
                                                SSLHandshake/CERTIFICATE_REQUEST
                                                SSLHandshake/SERVER_HELLO_DONE
                                                SSLHandshake/FINISHED])]
            (for-each [^SSLHandshake hs probableHandshakeMessages]
              (let [handshakeProducer (cast HandshakeProducer
                                            (.remove (.-handshakeProducers shc) (.-id hs)))]
                (when (some? handshakeProducer) (.produce handshakeProducer context clientHello)))))))))

  (defclass ^:private ^:static ^:final D13ClientHelloConsumer
    :implements [HandshakeConsumer]

    (constructor ^:private [this])

    (method ^:public consume :throws [IOException] ^void [this ^ConnectionContext context
                                                          ^SSLHandshake$HandshakeMessage message]
      (throw (UnsupportedOperationException. "Not supported yet.")))))

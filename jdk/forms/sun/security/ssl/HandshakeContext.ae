                (SSLLogger/fine (java-str "No active named group(s), ignore " suite)))
              retval))
        (do
          (when (and (SSLLogger/isOn) (SSLLogger/isOn "verbose"))
            (SSLLogger/fine (java-str "Ignore disabled cipher suite: " suite)))
          false)))


  (method ^:private ^:static isActivatable ^boolean [^SSLConfiguration sslConfig ^CipherSuite suite
                                                     ^AlgorithmConstraints algorithmConstraints
                                                     ^{:tag (Map NamedGroup$NamedGroupSpec Boolean)} cachedStatus]
    (if (.permits algorithmConstraints
                  (EnumSet/of CryptoPrimitive/KEY_AGREEMENT)
                  (.-name suite)
                  nil)

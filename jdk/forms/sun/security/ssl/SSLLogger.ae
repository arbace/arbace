              (let [formatted (SSLSimpleFormatter/formatParameters params)]
                (.log logger level (cast ResourceBundle nil) msg (new Object/1 [formatted])))
              (catch Exception exp)))
      (some? julLogger)
        (try
          (let [jl (aget julLevels (.ordinal level))]
            (when-not (not (.booleanValue (cast Boolean (.invoke julIsLoggable julLogger jl))))

    (set! (.-useCompactFormat this) (not (.contains options "expand"))))

  (method ^:public ^:static isOn ^boolean [^String checkPoints]
    (cond
      (nil? property) false
      (.isEmpty property) true
      :else
        (let [options (.split checkPoints ",")]
          (for-each [^:mutable ^String option options]
            (set! option (.trim option))
            (when-not (SSLLogger/hasOption option) (return false)))
          true)))

  (method ^:public ^:static ^{ForceInline true} isOn ^boolean [] isOn)

  (method ^:private ^:static hasOption ^boolean [^:mutable ^String option]
    (set! option (.toLowerCase option Locale/ENGLISH))
    (if (.contains property "all")
        true
        (do
          (let [modified (.replaceFirst property "sslctx" "")]
            (when (.contains modified "ssl")
              (when-not (or (or (.equals option "data") (.equals option "packet"))
                            (.equals option "plaintext"))
                (return true))))
          (.contains property option))))


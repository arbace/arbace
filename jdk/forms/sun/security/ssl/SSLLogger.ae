  (method ^:private ^:static log0 ^void [^Level level ^String msg & ^Object/1 params]
    (cond
      (and (some? logger) (.isLoggable logger level))
        (if (or (nil? params) (== (alength params) 0))
            (.log logger level (cast ResourceBundle nil) msg (cast Object/1 nil))

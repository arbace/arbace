                  (.invoke julLog julLogger jl msg)
                  (let [formatted (SSLSimpleFormatter/formatParameters params)]
                    (.invoke julLog julLogger jl (java-str msg ":" Utilities/LINE_SEP formatted))))))
          (catch Exception exp))))

  (method ^:private ^:static help ^void []
    (.println System/err)
    (.println System/err "help           print the help messages")
    (.println System/err "expand         expand debugging information")
    (.println System/err)
    (.println System/err "all            turn on all debugging")
    (.println System/err "ssl            turn on ssl debugging")
    (.println System/err)
    (.println System/err "The following can be used with ssl:")
    (.println System/err "\trecord       enable per-record tracing")
    (.println System/err "\thandshake    print each handshake message")
    (.println System/err "\tkeygen       print key generation data")
    (.println System/err "\tsession      print session activity")
    (.println System/err "\tdefaultctx   print default SSL initialization")
    (.println System/err "\tsslctx       print SSLContext tracing")
    (.println System/err "\tsessioncache print session cache tracing")
    (.println System/err "\tkeymanager   print key manager tracing")
    (.println System/err "\ttrustmanager print trust manager tracing")
    (.println System/err "\tpluggability print pluggability tracing")
    (.println System/err)
    (.println System/err "\thandshake debugging can be widened with:")
    (.println System/err "\tdata         hex dump of each handshake message")
    (.println System/err "\tverbose      verbose handshake message printing")
    (.println System/err)
    (.println System/err "\trecord debugging can be widened with:")
    (.println System/err "\tplaintext    hex dump of record plaintext")
    (.println System/err "\tpacket       print raw SSL/TLS packets")
    (.println System/err)
    (System/exit 0))

  (method ^:static toString ^String [& ^Object/1 params]
    (try
      (SSLSimpleFormatter/formatParameters params)
      (catch Exception exp (java-str "unexpected exception thrown: " (.getMessage exp)))))

  (method ^:public ^:static logWarning ^boolean [^String option ^String s]
    (when (and (SSLLogger/isOn) (SSLLogger/isOn option)) (SSLLogger/warning s))
    false)

  (method ^:public getName ^String [this] loggerName)

  (method ^:public isLoggable ^boolean [this ^Level level]
    (not (identical? level Level/OFF)))

  (method ^:public log ^void [this ^Level level ^ResourceBundle rb ^String message ^Throwable thrwbl]
    (when (.isLoggable this level)
      (try
        (let [formatted (SSLSimpleFormatter/format this level message thrwbl)]
          (.write System/err (.getBytes formatted StandardCharsets/UTF_8)))
        (catch Exception exp))))

  (method ^:public log ^void [this ^Level level ^ResourceBundle rb ^String message &
                              ^Object/1 params]
    (when (.isLoggable this level)
      (try
        (let [formatted (SSLSimpleFormatter/format this level message params)]
          (.write System/err (.getBytes formatted StandardCharsets/UTF_8)))
        (catch Exception exp))))

  (defclass ^:private ^:static SSLSimpleFormatter
    (field ^:private ^:static ^:final ^String PATTERN "yyyy-MM-dd kk:mm:ss.SSS z")

    (field ^:private ^:static ^:final ^DateTimeFormatter dateTimeFormat
      (.withZone (DateTimeFormatter/ofPattern PATTERN Locale/ENGLISH) (ZoneId/systemDefault)))

    (field ^:private ^:static ^:final ^MessageFormat basicCertFormat
      (MessageFormat.
        "\"version\"            : \"v{0}\",\n\"serial number\"      : \"{1}\",\n\"signature algorithm\": \"{2}\",\n\"issuer\"             : \"{3}\",\n\"not before\"         : \"{4}\",\n\"not  after\"         : \"{5}\",\n\"subject\"            : \"{6}\",\n\"subject public key\" : \"{7}\"\n"
        Locale/ENGLISH))

    (field ^:private ^:static ^:final ^MessageFormat extendedCertFormat
      (MessageFormat.
        "\"version\"            : \"v{0}\",\n\"serial number\"      : \"{1}\",\n\"signature algorithm\": \"{2}\",\n\"issuer\"             : \"{3}\",\n\"not before\"         : \"{4}\",\n\"not  after\"         : \"{5}\",\n\"subject\"            : \"{6}\",\n\"subject public key\" : \"{7}\",\n\"extensions\"         : [\n{8}\n]\n"
        Locale/ENGLISH))

    (field ^:private ^:static ^:final ^MessageFormat messageFormatNoParas
      (MessageFormat.
        "'{'\n  \"logger\"      : \"{0}\",\n  \"level\"       : \"{1}\",\n  \"thread id\"   : \"{2}\",\n  \"thread name\" : \"{3}\",\n  \"time\"        : \"{4}\",\n  \"caller\"      : \"{5}\",\n  \"message\"     : \"{6}\"\n'}'\n"
        Locale/ENGLISH))

    (field ^:private ^:static ^:final ^MessageFormat messageCompactFormatNoParas
      (MessageFormat. (java-str "{0}|{1}|{2}|{3}|{4}|{5}|{6}" Utilities/LINE_SEP) Locale/ENGLISH))

    (field ^:private ^:static ^:final ^MessageFormat messageFormatWithParas
      (MessageFormat.
        "'{'\n  \"logger\"      : \"{0}\",\n  \"level\"       : \"{1}\",\n  \"thread id\"   : \"{2}\",\n  \"thread name\" : \"{3}\",\n  \"time\"        : \"{4}\",\n  \"caller\"      : \"{5}\",\n  \"message\"     : \"{6}\",\n  \"specifics\"   : [\n{7}\n  ]\n'}'\n"
        Locale/ENGLISH))

    (field ^:private ^:static ^:final ^MessageFormat messageCompactFormatWithParas
      (MessageFormat. "{0}|{1}|{2}|{3}|{4}|{5}|{6} (\n{7}\n)\n" Locale/ENGLISH))

    (field ^:private ^:static ^:final ^MessageFormat keyObjectFormat
      (MessageFormat. "\"{0}\" : '{'\n{1}'}'\n" Locale/ENGLISH))

    (method ^:private ^:static format ^String [^SSLLogger logger ^Level level ^String message &
                                               ^Object/1 parameters]
      (if (or (nil? parameters) (== (alength parameters) 0))
          (let [messageFields (new Object/1
                                   [(.-loggerName logger)
                                    (.getName level)
                                    (Utilities/toHexString (.threadId (Thread/currentThread)))
                                    (.getName (Thread/currentThread))
                                    (.format dateTimeFormat (Instant/now))
                                    (SSLSimpleFormatter/formatCaller)
                                    message])]
            (if (.-useCompactFormat logger)
                (.format messageCompactFormatNoParas messageFields)
                (.format messageFormatNoParas messageFields)))
          (let [messageFields (new
                                Object/1
                                [(.-loggerName logger)
                                 (.getName level)
                                 (Utilities/toHexString (.threadId (Thread/currentThread)))
                                 (.getName (Thread/currentThread))
                                 (.format dateTimeFormat (Instant/now))
                                 (SSLSimpleFormatter/formatCaller)
                                 message
                                 (if (.-useCompactFormat logger)
                                     ^Object (SSLSimpleFormatter/formatParameters parameters)
                                     ^Object (Utilities/indent
                                               (SSLSimpleFormatter/formatParameters parameters)))])]
            (if (.-useCompactFormat logger)
                (.format messageCompactFormatWithParas messageFields)
                (.format messageFormatWithParas messageFields)))))

    (method ^:private ^:static formatCaller ^String []
      (for-each [^StackTraceElement f (.getStackTrace (Throwable.))]
        (when-not (or (.startsWith (.getClassName f) "sun.security.ssl.SSLLogger")
                      (.startsWith (.getClassName f) "java.lang.System"))
          (return (java-str (.getFileName f) ":" (.getLineNumber f)))))
      "unknown caller")

    (method ^:private ^:static formatParameters ^String [& ^Object/1 parameters]
      (let [builder (StringBuilder. 512)
            ^:mutable isFirst true]
        (for-each [parameter parameters]
          (if isFirst (set! isFirst false) (.append builder (java-str "," Utilities/LINE_SEP)))
          (cond
            (instance? Throwable parameter)
              (.append builder (SSLSimpleFormatter/formatThrowable (cast Throwable parameter)))
            (instance? Certificate parameter)
              (.append builder (SSLSimpleFormatter/formatCertificate (cast Certificate parameter)))
            (instance? ByteArrayInputStream parameter)
              (.append builder
                       (SSLSimpleFormatter/formatByteArrayInputStream
                         (cast ByteArrayInputStream parameter)))
            (instance? ByteBuffer parameter)
              (.append builder (SSLSimpleFormatter/formatByteBuffer (cast ByteBuffer parameter)))
            (instance? byte/1 parameter)
              (.append builder
                       (SSLSimpleFormatter/formatByteArrayInputStream
                         (ByteArrayInputStream. (cast byte/1 parameter))))
            (instance? Map$Entry parameter)
              (let [^{:tag (Map$Entry String ?)} mapParameter (cast Map$Entry parameter)]
                (.append builder (SSLSimpleFormatter/formatMapEntry mapParameter)))
            :else (.append builder (SSLSimpleFormatter/formatObject parameter))))
        (.toString builder)))

    (method ^:private ^:static formatThrowable ^String [^Throwable throwable]
      (let [builder (StringBuilder. 512)
            bytesOut (ByteArrayOutputStream.)]
        (with-resources [out (PrintStream. bytesOut)]
          (.printStackTrace throwable out)
          (.append builder (Utilities/indent (.toString bytesOut))))
        (let [fields (new Object/1 ["throwable" (.toString builder)])]
          (.format keyObjectFormat fields))))

    (method ^:private ^:static formatCertificate ^String [^Certificate certificate]
      (if (not (instance? X509Certificate certificate))
          (Utilities/indent (.toString certificate))
          (let [builder (StringBuilder. 512)]
            (try
              (let [x509 (X509CertImpl/toImpl (cast X509Certificate certificate))
                    certInfo (.getInfo x509)
                    certExts (.getExtensions certInfo)]
                (if (nil? certExts)
                    (let [certFields (new Object/1
                                          [(.getVersion x509)
                                           (Debug/toString (.getSerialNumber x509))
                                           (.getSigAlgName x509)
                                           (.toString (.getIssuerX500Principal x509))
                                           (.format
                                             dateTimeFormat
                                             (.toInstant (.getNotBefore x509)))
                                           (.format dateTimeFormat (.toInstant (.getNotAfter x509)))
                                           (.toString (.getSubjectX500Principal x509))
                                           (.getAlgorithm (.getPublicKey x509))])]
                      (.append builder (Utilities/indent (.format basicCertFormat certFields))))
                    (let [extBuilder (StringBuilder. 512)
                          ^:mutable isFirst true]
                      (for-each [^Extension certExt (.getAllExtensions certExts)]
                        (if isFirst
                            (set! isFirst false)
                            (.append extBuilder (java-str "," Utilities/LINE_SEP)))
                        (.append extBuilder
                                 (java-str "{"
                                           Utilities/LINE_SEP
                                           (Utilities/indent (.toString certExt))
                                           Utilities/LINE_SEP
                                           "}")))
                      (let [certFields (new Object/1
                                            [(.getVersion x509)
                                             (Debug/toString (.getSerialNumber x509))
                                             (.getSigAlgName x509)
                                             (.toString (.getIssuerX500Principal x509))
                                             (.format
                                               dateTimeFormat
                                               (.toInstant (.getNotBefore x509)))
                                             (.format
                                               dateTimeFormat
                                               (.toInstant (.getNotAfter x509)))
                                             (.toString (.getSubjectX500Principal x509))
                                             (.getAlgorithm (.getPublicKey x509))
                                             (Utilities/indent (.toString extBuilder))])]
                        (.append builder (Utilities/indent (.format extendedCertFormat certFields)))))))
              (catch Exception ce))
            (let [fields (new Object/1 ["certificate" (.toString builder)])]
              (Utilities/indent (.format keyObjectFormat fields))))))

    (method ^:private ^:static formatByteArrayInputStream ^String [^ByteArrayInputStream bytes]
      (let [builder (StringBuilder. 512)]
        (try
          (with-resources [bytesOut (ByteArrayOutputStream.)]
            (let [hexEncoder (HexDumpEncoder.)]
              (.encodeBuffer hexEncoder bytes bytesOut)
              (.append builder (Utilities/indent (.toString bytesOut)))))
          (catch IOException ioe))
        (.toString builder)))

    (method ^:private ^:static formatByteBuffer ^String [^ByteBuffer byteBuffer]
      (let [builder (StringBuilder. 512)]
        (try
          (with-resources [bytesOut (ByteArrayOutputStream.)]
            (let [hexEncoder (HexDumpEncoder.)]
              (.encodeBuffer hexEncoder (.duplicate byteBuffer) bytesOut)
              (.append builder (Utilities/indent (.toString bytesOut)))))
          (catch IOException ioe))
        (.toString builder)))

    (method ^:private ^:static formatMapEntry ^String [^{:tag (Map$Entry String ?)} entry]
      (let [key (cast String (.getKey entry))
            value (.getValue entry)
            ^:mutable ^String formatted nil]
        (if (instance? String value)
            (set! formatted (java-str "\"" key "\": \"" value "\""))
            (if-instance [^String/1 strings value]
              (let [builder (StringBuilder. 512)]
                (.append builder (java-str "\"" key "\": [" Utilities/LINE_SEP))
                (let [len (alength strings)]
                  (loop [^int i 0]
                    (when (< i len)
                      (let [string (aget strings i)]
                        (.append builder (java-str "      \"" string "\""))
                        (when-not (== i (unchecked-subtract-int len 1)) (.append builder ","))
                        (.append builder Utilities/LINE_SEP)
                        (recur (unchecked-inc-int i)))))
                  (.append builder "      ]")
                  (set! formatted (.toString builder))))
              (cond
                (instance? byte/1 value)
                  (set! formatted
                        (java-str "\""
                                  key
                                  "\": \""
                                  (Utilities/toHexString (cast byte/1 value))
                                  "\""))
                (instance? Byte value)
                  (set! formatted
                        (java-str "\""
                                  key
                                  "\": \""
                                  (.toHexDigits (HexFormat/of) (.byteValue (cast Byte value)))
                                  "\""))
                :else (set! formatted (java-str "\"" key "\": \"" (.toString value) "\"")))))
        (Utilities/indent formatted)))

    (method ^:private ^:static formatObject ^String [obj] (.toString obj))))

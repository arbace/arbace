        (Collections/emptyList)))

  (method ^:static checkIdentity :throws [CertificateException] ^void [^SSLSession session
                                                                       ^X509Certificate/1 trustedChain
                                                                       ^String algorithm
                                                                       ^boolean checkClientTrusted]
    (let [chainsToPublicCA (AnchorCertificates/contains
                             (aget trustedChain (unchecked-subtract-int (alength trustedChain) 1)))
          ^:mutable identifiable false
          ^:mutable peerHost (.getPeerHost session)]
      (when (and (some? peerHost) (.endsWith peerHost "."))
        (set! peerHost (.substring peerHost 0 (unchecked-subtract-int (.length peerHost) 1))))
      (when-not checkClientTrusted
        (let [^{:tag (List SNIServerName)} sniNames (X509TrustManagerImpl/getRequestedServerNames
                                                      session)
              sniHostName (X509TrustManagerImpl/getHostNameInSNI sniNames)]
          (when (some? sniHostName)
            (try
              (X509TrustManagerImpl/checkIdentity
                sniHostName
                (aget trustedChain 0)
                algorithm
                chainsToPublicCA)
              (set! identifiable true)
              (catch CertificateException ce
                (when (.equalsIgnoreCase sniHostName peerHost) (throw ce)))))))
      (when-not identifiable
        (try
          (X509TrustManagerImpl/checkIdentity peerHost
                                              (aget trustedChain 0)
                                              algorithm
                                              chainsToPublicCA)
          (catch CertificateException ce
            (if (and checkClientTrusted (.equalsIgnoreCase "HTTPS" algorithm))
                (throw
                  (CertificateException.
                    "Endpoint Identification Algorithm HTTPS is not supported on the server side"))
                (throw ce)))))))

  (method ^:static checkIdentity :throws [CertificateException] ^void [^String hostname
                                                                       ^X509Certificate cert
                                                                       ^String algorithm]
    (X509TrustManagerImpl/checkIdentity hostname cert algorithm false))

  (method ^:private ^:static checkIdentity :throws [CertificateException] ^void [^:mutable ^String hostname
                                                                                 ^X509Certificate cert
                                                                                 ^String algorithm
                                                                                 ^boolean chainsToPublicCA]
    (when (and (some? algorithm) (not (.isEmpty algorithm)))
      (when (and (and (some? hostname) (.startsWith hostname "[")) (.endsWith hostname "]"))
        (set! hostname (.substring hostname 1 (unchecked-subtract-int (.length hostname) 1))))
      (cond
        (.equalsIgnoreCase algorithm "HTTPS")
          (.match (HostnameChecker/getInstance HostnameChecker/TYPE_TLS)
                  hostname
                  cert
                  chainsToPublicCA)
        (or (.equalsIgnoreCase algorithm "LDAP") (.equalsIgnoreCase algorithm "LDAPS"))
          (.match (HostnameChecker/getInstance HostnameChecker/TYPE_LDAP)
                  hostname
                  cert
                  chainsToPublicCA)
        :else
          (throw (CertificateException. (java-str "Unknown identification algorithm: " algorithm)))))))

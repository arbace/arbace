  (method ^:private getValidator ^Validator [this ^String variant]
    (let [^Validator v (if (nil? pkixParams)
                           (Validator/getInstance validatorType variant trustedCerts)
                           (Validator/getInstance validatorType variant pkixParams))]
      v))

  (method ^:private ^:static getHostNameInSNI ^String [^{:tag (List SNIServerName)} sniNames]
    (let [^:mutable ^SNIHostName hostname nil]
      (for-each [^SNIServerName sniName sniNames]
        (when-not (not (== (.getType sniName) StandardConstants/SNI_HOST_NAME))
          (if (instance? SNIHostName sniName)
              (set! hostname (cast SNIHostName sniName))
              (try
                (set! hostname (SNIHostName. (.getEncoded sniName)))
                (catch IllegalArgumentException iae
                  (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,trustmanager"))
                    (SSLLogger/fine (java-str "Illegal server name: " sniName))))))
          (break)))
      (when (some? hostname) (.getAsciiName hostname))))

  (method ^:static getRequestedServerNames ^{:tag (List SNIServerName)} [^Socket socket]
    (if (and (and (some? socket) (.isConnected socket)) (instance? SSLSocket socket))
        (X509TrustManagerImpl/getRequestedServerNames
          (.getHandshakeSession (cast SSLSocket socket)))
        (Collections/emptyList)))

  (method ^:static getRequestedServerNames ^{:tag (List SNIServerName)} [^SSLEngine engine]

          ^:mutable ^X509Certificate/1 trustedChain nil]
      (if-instance [^SSLSocket sslSocket socket]
        (if (.isConnected sslSocket)
            (let [session (.getHandshakeSession sslSocket)]
              (when (nil? session) (throw (CertificateException. "No handshake session")))
              (let [^AlgorithmConstraints constraints (SSLAlgorithmConstraints/forSocket
                                                        sslSocket
                                                        SSLAlgorithmConstraints$SIGNATURE_CONSTRAINTS_MODE/LOCAL
                                                        false)
                    ^:mutable ^{:tag (List byte/1)} responseList (Collections/emptyList)]
                (when (and (not checkClientTrusted) (instance? ExtendedSSLSession session))
                  (set! responseList (.getStatusResponses (cast ExtendedSSLSession session))))
                (set! trustedChain
                      (.validate v
                                 chain
                                 nil
                                 responseList
                                 constraints
                                 (when-not checkClientTrusted ^Object authType)))
                (let [identityAlg (.getEndpointIdentificationAlgorithm
                                    (.getSSLParameters sslSocket))]
                  (when (and (some? identityAlg) (not (.isEmpty identityAlg)))
                    (X509TrustManagerImpl/checkIdentity
                      session
                      trustedChain
                      identityAlg
                      checkClientTrusted)))))
            (set! trustedChain
                  (.validate v
                             chain
                             nil
                             (Collections/emptyList)
                             nil
                             (when-not checkClientTrusted ^Object authType))))
        (set! trustedChain
              (.validate v
                         chain
                         nil
                         (Collections/emptyList)
                         nil
                         (when-not checkClientTrusted ^Object authType))))
      (when (and (SSLLogger/isOn) (SSLLogger/isOn "ssl,trustmanager"))
        (SSLLogger/fine "Found trusted certificate"
                        (aget trustedChain (unchecked-subtract-int (alength trustedChain) 1))))))


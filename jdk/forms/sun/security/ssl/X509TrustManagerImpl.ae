  (method ^:private checkTrustedInit ^Validator [this ^X509Certificate/1 chain ^String authType
                                                 ^boolean checkClientTrusted]
    (when (or (nil? chain) (== (alength chain) 0))
      (throw (IllegalArgumentException. "null or zero-length certificate chain")))
    (when (or (nil? authType) (.isEmpty authType))
      (throw (IllegalArgumentException. "null or zero-length authentication type")))
    (let [^:mutable ^Validator v nil]
      (if checkClientTrusted
          (do
            (set! v clientValidator)
            (when (nil? v)
              (.lock validatorLock)
              (try
                (set! v clientValidator)
                (when (nil? v)
                  (set! v (.getValidator this Validator/VAR_TLS_CLIENT))
                  (set! clientValidator v))
                (finally (.unlock validatorLock)))))
          (do
            (set! v serverValidator)
            (when (nil? v)
              (.lock validatorLock)
              (try
                (set! v serverValidator)
                (when (nil? v)
                  (set! v (.getValidator this Validator/VAR_TLS_SERVER))
                  (set! serverValidator v))
                (finally (.unlock validatorLock))))))
      v))

  (method ^:private checkTrusted :throws [CertificateException] ^void [this ^X509Certificate/1 chain
                                                                       ^String authType
                                                                       ^Socket socket
                                                                       ^boolean checkClientTrusted]

                                ^HandshakeContext (ServerHandshakeContext. sslContext this)))
                      (.initHandshaker outputRecord))))
              (.dispatch handshakeContext type plaintext))
          ALERT (.consume Alert/alertConsumer this (.-fragment plaintext))
          (let [consumer (cast SSLConsumer (.get consumers (.-contentType plaintext)))]
            (if (some? consumer)
                (.consume consumer this (.-fragment plaintext))
                (throw (.fatal this
                               Alert/UNEXPECTED_MESSAGE
                               (java-str "Unexpected content: " (.-contentType plaintext))))))))))


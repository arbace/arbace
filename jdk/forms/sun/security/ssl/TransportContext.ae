  (method getHandshakeStatus ^SSLEngineResult$HandshakeStatus [this]
    (cond
      (not (.isEmpty outputRecord)) SSLEngineResult$HandshakeStatus/NEED_WRAP
      (and (.isOutboundClosed this) (.isInboundClosed this))

  (method ^:protected checkAlias ^EntryStatus [this ^int keyStoreIndex ^String alias
                                               ^Certificate/1 chain ^Date verificationDate
                                               ^{:tag (List KeyType)} keyTypes
                                               ^{:tag (Set X500Principal)} issuerSet
                                               ^CheckType checkType
                                               ^AlgorithmConstraints constraints
                                               ^{:tag (List SNIServerName)} requestedServerNames
                                               ^String idAlgorithm]
    (when-not (or (nil? chain) (== (alength chain) 0))

  (method ^:private certificateCheck ^CheckResult [this ^CheckType checkType ^X509Certificate cert
                                                   ^Date date
                                                   ^{:tag (List SNIServerName)} serverNames
                                                   ^String idAlgorithm]
    (if checksDisabled CheckResult/OK (.check checkType cert date serverNames idAlgorithm)))

  (defclass ^:enum CheckResult
    (constants OK INSENSITIVE EXPIRED EXTENSION_MISMATCH))

  (defclass ^:enum CheckType
    (constants
      (NONE [(Collections/emptySet)])
      (CLIENT [(HashSet. (List/of (.value KnownOIDs/anyExtendedKeyUsage)
                                  (.value KnownOIDs/clientAuth)))])
      (SERVER [(HashSet. (List/of (.value KnownOIDs/anyExtendedKeyUsage)
                                  (.value KnownOIDs/serverAuth)
                                  (.value KnownOIDs/NETSCAPE_ExportApproved)
                                  (.value KnownOIDs/MICROSOFT_ExportApproved)))]))

    (field ^:final ^{:tag (Set String)} validEku)

    (constructor [this ^{:tag (Set String)} validEku]
      (set! (.-validEku this) validEku))

    (method ^:private ^:static getBit ^boolean [^boolean/1 keyUsage ^int bit]
      (and (< bit (alength keyUsage)) (aget keyUsage bit)))

    (method check ^CheckResult [this ^X509Certificate cert ^Date date
                                ^{:tag (List SNIServerName)} serverNames ^String idAlgorithm]
      (if (identical? this NONE)
          CheckResult/OK
          (do
            (try
              (let [^{:tag (List String)} certEku (.getExtendedKeyUsage cert)]
                (when (and (some? certEku) (Collections/disjoint validEku certEku))
                  (return CheckResult/EXTENSION_MISMATCH))
                (let [ku (.getKeyUsage cert)]
                  (when (some? ku)
                    (let [algorithm (.getAlgorithm (.getPublicKey cert))
                          supportsDigitalSignature (CheckType/getBit ku 0)]
                      (switch algorithm
                        "RSA"
                          (when-not supportsDigitalSignature
                            (when (or (identical? this CLIENT) (not (CheckType/getBit ku 2)))
                              (return CheckResult/EXTENSION_MISMATCH)))
                        "RSASSA-PSS"
                          (when (and (not supportsDigitalSignature) (identical? this SERVER))
                            (return CheckResult/EXTENSION_MISMATCH))
                        "DSA"
                          (when-not supportsDigitalSignature
                            (return CheckResult/EXTENSION_MISMATCH))
                        "DH"
                          (when-not (CheckType/getBit ku 4) (return CheckResult/EXTENSION_MISMATCH))
                        "EC"
                          (do
                            (when-not supportsDigitalSignature
                              (return CheckResult/EXTENSION_MISMATCH))
                            (when (and (identical? this SERVER) (not (CheckType/getBit ku 4)))
                              (return CheckResult/EXTENSION_MISMATCH))))))))
              (catch CertificateException e (return CheckResult/EXTENSION_MISMATCH)))
            (try
              (.checkValidity cert date)
              (catch CertificateException e (return CheckResult/EXPIRED)))
            (when (and (some? serverNames) (not (.isEmpty serverNames)))
              (for-each [^:mutable ^SNIServerName serverName serverNames]
                (when (== (.getType serverName) StandardConstants/SNI_HOST_NAME)
                  (when-not (instance? SNIHostName serverName)
                    (try
                      (set! serverName (SNIHostName. (.getEncoded serverName)))
                      (catch IllegalArgumentException iae
                        (when (and (SSLLogger/isOn) (SSLLogger/isOn "keymanager"))
                          (SSLLogger/fine (java-str "Illegal server name: " serverName)))
                        (return CheckResult/INSENSITIVE))))
                  (let [hostname (.getAsciiName (cast SNIHostName serverName))]
                    (try
                      (X509TrustManagerImpl/checkIdentity hostname cert idAlgorithm)
                      (catch CertificateException e
                        (when (and (SSLLogger/isOn) (SSLLogger/isOn "keymanager"))
                          (SSLLogger/fine
                            (java-str
                              "Certificate identity does not match Server Name Indication (SNI): "
                              hostname)))
                        (return CheckResult/INSENSITIVE)))
                    (break)))))
            CheckResult/OK)))

    (method getValidator ^String [this]
      (cond
        (identical? this CLIENT) Validator/VAR_TLS_CLIENT
        (identical? this SERVER) Validator/VAR_TLS_SERVER
        :else Validator/VAR_GENERIC)))

  (defclass ^:protected ^:static EntryStatus
    :implements [(Comparable EntryStatus)]

    (field ^:final ^int keyStoreIndex)

    (field ^:final ^int keyIndex)

    (field ^:final ^String alias)

    (field ^:final ^CheckResult checkResult)

    (constructor [this ^int keyStoreIndex ^int keyIndex ^String alias ^Certificate/1 chain
                  ^CheckResult checkResult]

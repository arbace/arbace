        (if (== k -1)
            (do (set! keyAlgorithm algorithm) (set! sigKeyAlgorithm nil))
            (do
              (set! keyAlgorithm (.substring algorithm 0 k))
              (set! sigKeyAlgorithm (.substring algorithm (unchecked-add-int k 1)))))))

    (method matches ^boolean [this ^Certificate/1 chain]
      (cond
        (not (.equals (.getAlgorithm (.getPublicKey (aget chain 0))) keyAlgorithm)) false
        (nil? sigKeyAlgorithm) true
        (> (alength chain) 1)
          (.equals sigKeyAlgorithm (.getAlgorithm (.getPublicKey (aget chain 1))))
        :else
          (let [issuer (cast X509Certificate (aget chain 0))
                sigAlgName (.toUpperCase (.getSigAlgName issuer) Locale/ENGLISH)
                pattern (java-str "WITH" (.toUpperCase sigKeyAlgorithm Locale/ENGLISH))]
            (.endsWith sigAlgName pattern)))))

  (method ^:protected ^:static getKeyTypes ^{:tag (List KeyType)} [& ^String/1 keyTypes]
    (when-not (or (or (nil? keyTypes) (== (alength keyTypes) 0)) (nil? (aget keyTypes 0)))
      (let [^{:tag (List KeyType)} list (ArrayList. (alength keyTypes))]
        (for-each [^String keyType keyTypes] (.add list (KeyType. keyType)))
        list)))

  (method ^:protected ^:static getIssuerSet ^{:tag (Set X500Principal)} [^Principal/1 issuers]
    (when (and (some? issuers) (not (== (alength issuers) 0)))
      (let [^{:tag (Set X500Principal)} ret (HashSet. (alength issuers))]
        (for-each [^Principal p issuers]
          (if (instance? X500Principal p)
              (.add ret (cast X500Principal p))
              (try (.add ret (X500Principal. (.getName p))) (catch Exception e))))
        (when-not (.isEmpty ret) ret)))))

  (method ^:private conformsToAlgorithmConstraints ^boolean [this ^AlgorithmConstraints constraints
                                                             ^Certificate/1 chain ^String variant]
    (if checksDisabled
        true
        (let [checker (AlgorithmChecker. constraints variant)]
          (try
            (.init checker false)
            (catch CertPathValidatorException cpve
              (when (and (SSLLogger/isOn) (SSLLogger/isOn "keymanager"))
                (SSLLogger/fine "Cannot initialize algorithm constraints checker" cpve))
              (return false)))

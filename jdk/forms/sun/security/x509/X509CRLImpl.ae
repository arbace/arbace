            nextByte (unchecked-byte (.peekByte tbsIn))]
        (when (== nextByte DerValue/tag_Integer) (set! tmp (.getDerValue tbsIn)))
        (set! tmp (.getDerValue tbsIn))
        (set! tmp (.getDerValue tbsIn))
        (let [principalBytes (.toByteArray tmp)] (X500Principal. principalBytes)))
      (catch Exception e (throw (RuntimeException. "Could not parse issuer" e)))))


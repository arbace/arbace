  (method ^:public toStringWithAlgName ^String [this ^String name]
    (let [sb (StringBuilder.)]
      (.append (.append (.append sb "X.509 CRL v") (unchecked-add-int (.-version info) 1)) \newline)
      (when (some? sigAlgId)
        (.append (.append (.append (.append (.append sb "Signature Algorithm: ") name) ", OID=")
                          (.getOID sigAlgId))
                 \newline))
      (when (some? (.-issuer info))
        (.append (.append (.append sb "Issuer: ") (.-issuer info)) \newline))
      (when (some? (.-thisUpdate info))
        (.append (.append (.append sb "\nThis Update: ") (.-thisUpdate info)) \newline))
      (when (some? (.-nextUpdate info))
        (.append (.append (.append sb "Next Update: ") (.-nextUpdate info)) \newline))
      (if (.isEmpty (.-revokedList info))
          (.append sb "\nNO certificates have been revoked\n")
          (do
            (.append (.append sb "\nRevoked Certificates: ") (.size (.-revokedList info)))
            (let [^:mutable ^int i 1]
              (for-each [^X509CRLEntry entry (.-revokedList info)]
                (.append (.append (.append (.append sb "\n[") i) "] ") entry)
                (set! i (unchecked-inc-int i))))))
      (when (some? (.-extensions info))
        (let [^{:tag (Collection Extension)} allExts (.getAllExtensions (.-extensions info))
              objs (.toArray allExts)]
          (.append (.append sb "\nCRL Extensions: ") (alength objs))
          (loop [^int i 0]
            (when (< i (alength objs))
              (.append (.append (.append sb "\n[") (unchecked-add-int i 1)) "]: ")
              (let [ext (cast Extension (aget objs i))]
                (try
                  (if (nil? (OIDMap/getClass (.getExtensionId ext)))
                      (do
                        (.append sb ext)
                        (let [^:mutable extValue (.getExtensionValue ext)]
                          (when (some? extValue)
                            (let [out (DerOutputStream.)]
                              (.putOctetString out extValue)
                              (set! extValue (.toByteArray out))
                              (let [enc (HexDumpEncoder.)]
                                (.append (.append
                                           (.append
                                             (.append sb "Extension unknown: ")
                                             "DER encoded OCTET string =\n")
                                           (.encodeBuffer enc extValue))
                                         \newline))))))
                      (.append sb ext))
                  (catch Exception e (.append sb ", Error parsing this extension")))
                (recur (unchecked-inc-int i)))))))
      (if (some? signature)
          (let [encoder (HexDumpEncoder.)]
            (.append (.append (.append sb "\nSignature:\n") (.encodeBuffer encoder signature))
                     \newline))
          (.append sb "NOT signed yet\n"))
      (.toString sb)))


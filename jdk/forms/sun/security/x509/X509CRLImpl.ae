  (method ^:private parse :throws [CRLException IOException] ^void [this ^DerValue val]
    (when (or (nil? (.getData val)) (not (== (.-tag val) DerValue/tag_Sequence)))
      (throw (CRLException. "Invalid DER-encoded CRL data")))
    (set! signedCRL (.toByteArray val))
    (let [seq (new DerValue/1 3)]
      (aset seq 0 (.getDerValue (.-data val)))
      (aset seq 1 (.getDerValue (.-data val)))
      (aset seq 2 (.getDerValue (.-data val)))
      (when-not (== (.available (.-data val)) 0)
        (throw (CRLException. (java-str "signed overrun, bytes = " (.available (.-data val))))))
      (set! info (TBSCertList. (aget seq 0)))
      (set! sigAlgId (AlgorithmId/parse (aget seq 1)))
      (when-not (.equals sigAlgId (.-infoSigAlgId info))
        (throw (CRLException. "Signature algorithm mismatch")))
      (set! signature (.getBitString (aget seq 2)))
      (when-not (== (.available (.-data (aget seq 1))) 0)
        (throw (CRLException. "AlgorithmId field overrun")))
      (when-not (== (.available (.-data (aget seq 2))) 0)
        (throw (CRLException. "Signature field overrun")))
      (set! tbsCertList (.toByteArray (aget seq 0)))))

  (method ^:public ^:static getIssuerX500Principal ^X500Principal [^X509CRL crl]
    (try
      (let [encoded (.getEncoded crl)
            derIn (DerInputStream. encoded)
            tbsCert (aget (.getSequence derIn 3) 0)
            tbsIn (.-data tbsCert)

  (method ^:private parse :throws [CertificateException IOException] ^void [this ^DerValue val]
    (when (or (nil? (.-data val)) (not (== (.-tag val) DerValue/tag_Sequence)))
      (throw (CertificateParsingException. "invalid DER-encoded certificate data")))

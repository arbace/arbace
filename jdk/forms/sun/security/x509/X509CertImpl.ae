        (throw (CertificateParsingException. "signed fields invalid")))
      (set! algId (AlgorithmId/parse (aget seq 1)))
      (set! signature (.getBitString (aget seq 2)))
      (when-not (== (.available (.-data (aget seq 1))) 0)
        (throw (CertificateParsingException. "algid field overrun")))
      (when-not (== (.available (.-data (aget seq 2))) 0)
        (throw (CertificateParsingException. "signed fields overrun")))
      (set! info (X509CertInfo. (aget seq 0)))
      (let [infoSigAlg (.getAlgId (.getAlgorithmId info))]
        (when-not (.equals algId infoSigAlg)
          (throw (CertificateException. "Signature algorithm mismatch"))))))


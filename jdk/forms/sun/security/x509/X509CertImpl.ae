  (method ^:public ^:static getIssuerX500Principal ^X500Principal [^X509Certificate cert]
    (try
      (X509CertImpl/getX500Principal cert true)
      (catch Exception e (throw (RuntimeException. "Could not parse issuer" e)))))

  (method ^:public ^:static getEncodedInternal :throws [CertificateEncodingException] ^byte/1 [^Certificate cert]
    (if (instance? X509CertImpl cert)
        (.getEncodedInternal (cast X509CertImpl cert))
        (.getEncoded cert)))

  (method ^:public ^:static toImpl :throws [CertificateException] ^X509CertImpl [^X509Certificate cert]
    (if (instance? X509CertImpl cert) (cast X509CertImpl cert) (X509Factory/intern cert)))

  (method ^:public ^:static isSelfIssued ^boolean [^X509Certificate cert]
    (let [subject (.getSubjectX500Principal cert)
          issuer (.getIssuerX500Principal cert)]
      (.equals subject issuer)))

  (method ^:public ^:static isSelfSigned ^boolean [^X509Certificate cert ^String sigProvider]
    (when (X509CertImpl/isSelfIssued cert)
      (try
        (if (nil? sigProvider)
            (.verify cert (.getPublicKey cert))
            (.verify cert (.getPublicKey cert) sigProvider))
        (return true)
        (catch Exception e)))
    false)

  (field ^:private ^:final ^{:tag (ConcurrentHashMap String String)} fingerprints
    (ConcurrentHashMap. 2))

  (method ^:private getFingerprint ^String [this ^String algorithm ^Debug debug]
    (cast String
          (.computeIfAbsent fingerprints
                            algorithm
                            (lambda Function ^String [^String x]
                              (try
                                (X509CertImpl/getFingerprintInternal
                                  x
                                  (.getEncodedInternal this)
                                  debug)
                                (catch CertificateEncodingException e
                                  (when (some? debug)
                                    (.println debug (java-str "Cannot encode certificate: " e)))
                                  nil))))))

  (method ^:private ^:static getFingerprintInternal ^String [^String algorithm ^byte/1 encodedCert
                                                             ^Debug debug]
    (try
      (let [md (MessageDigest/getInstance algorithm)
            digest (.digest md encodedCert)]
        (.formatHex (.withUpperCase (HexFormat/of)) digest))
      (catch NoSuchAlgorithmException e
        (when (some? debug)
          (.println debug (java-str "Cannot create " algorithm " MessageDigest: " e)))
        nil)))

  (method ^:public ^:static getFingerprint ^String [^String algorithm ^X509Certificate cert
                                                    ^Debug debug]
    (if (instance? X509CertImpl cert)
        (.getFingerprint (cast X509CertImpl cert) algorithm debug)
        (try
          (X509CertImpl/getFingerprintInternal algorithm (.getEncoded cert) debug)
          (catch CertificateEncodingException e
            (when (some? debug) (.println debug (java-str "Cannot encode certificate: " e)))
            nil))))

  (method ^:private readObject :throws [IOException ClassNotFoundException] ^void [this
                                                                                   ^ObjectInputStream stream]
    (throw (InvalidObjectException. "X509CertImpls are not directly deserializable"))))

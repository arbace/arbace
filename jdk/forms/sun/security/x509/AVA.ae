              (let [^:mutable c (.charAt keywordString 0)]
                (when (or (or (< c 65) (> c 122)) (and (> c 90) (< c 97)))
                  (throw (IllegalArgumentException. "keyword does not start with letter")))
                (loop [^int i 1]
                  (when (< i (.length keywordString))
                    (set! c (.charAt keywordString i))
                    (if (and (and (or (or (< c 65) (> c 122)) (and (> c 90) (< c 97)))
                                  (or (< c 48) (> c 57)))
                             (not (== c \_)))
                        (throw (IllegalArgumentException.
                                 "keyword character is not a letter, digit, or underscore"))
                        (recur (unchecked-inc-int i)))))
                keywordString)))))

    (method ^:static hasKeyword ^boolean [^ObjectIdentifier oid ^int standard]
      (let [ak (cast AVAKeyword (.get oidMap oid))] (if (nil? ak) false (.isCompliant ak standard))))

    (static-initializer
      (set! oidMap (HashMap.))
      (set! keywordMap (HashMap.))
      (AVAKeyword. "CN" X500Name/commonName_oid true true)
      (AVAKeyword. "C" X500Name/countryName_oid true true)
      (AVAKeyword. "L" X500Name/localityName_oid true true)
      (AVAKeyword. "S" X500Name/stateName_oid false false)
      (AVAKeyword. "ST" X500Name/stateName_oid true true)
      (AVAKeyword. "O" X500Name/orgName_oid true true)
      (AVAKeyword. "OU" X500Name/orgUnitName_oid true true)
      (AVAKeyword. "T" X500Name/title_oid false false)
      (AVAKeyword. "IP" X500Name/ipAddress_oid false false)
      (AVAKeyword. "STREET" X500Name/streetAddress_oid true true)
      (AVAKeyword. "DC" X500Name/DOMAIN_COMPONENT_OID false true)
      (AVAKeyword. "DNQUALIFIER" X500Name/DNQUALIFIER_OID false false)
      (AVAKeyword. "DNQ" X500Name/DNQUALIFIER_OID false false)
      (AVAKeyword. "SURNAME" X500Name/SURNAME_OID false false)
      (AVAKeyword. "GIVENNAME" X500Name/GIVENNAME_OID false false)
      (AVAKeyword. "INITIALS" X500Name/INITIALS_OID false false)
      (AVAKeyword. "GENERATION" X500Name/GENERATIONQUALIFIER_OID false false)
      (AVAKeyword. "EMAIL" PKCS9Attribute/EMAIL_ADDRESS_OID false false)
      (AVAKeyword. "EMAILADDRESS" PKCS9Attribute/EMAIL_ADDRESS_OID false false)
      (AVAKeyword. "UID" X500Name/userid_oid false true)
      (AVAKeyword. "SERIALNUMBER" X500Name/SERIALNUMBER_OID false false))))

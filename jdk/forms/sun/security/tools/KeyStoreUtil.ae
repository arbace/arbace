(defclass ^:public KeyStoreUtil
  (constructor ^:private [this])

  (method ^:public ^:static isSelfSigned ^boolean [^X509Certificate cert]
    (KeyStoreUtil/signedBy cert cert))

  (method ^:public ^:static signedBy ^boolean [^X509Certificate end ^X509Certificate ca]
    (if (not (.equals (.getSubjectX500Principal ca) (.getIssuerX500Principal end)))
        false
        (try (.verify end (.getPublicKey ca)) true (catch Exception e false))))

  (method ^:public ^:static isWindowsKeyStore ^boolean [^String storetype]
    (and (some? storetype)
         (or (or (or (or (or (.equalsIgnoreCase storetype "Windows-MY")
                             (.equalsIgnoreCase storetype "Windows-ROOT"))
                         (.equalsIgnoreCase storetype "Windows-MY-CURRENTUSER"))
                     (.equalsIgnoreCase storetype "Windows-ROOT-CURRENTUSER"))
                 (.equalsIgnoreCase storetype "Windows-MY-LOCALMACHINE"))
             (.equalsIgnoreCase storetype "Windows-ROOT-LOCALMACHINE"))))

  (method ^:public ^:static niceStoreTypeName ^String [^String storetype]
    (cond
      (.equalsIgnoreCase storetype "Windows-MY") "Windows-MY"
      (.equalsIgnoreCase storetype "Windows-ROOT") "Windows-ROOT"
      (.equalsIgnoreCase storetype "Windows-MY-CURRENTUSER") "Windows-MY-CURRENTUSER"
      (.equalsIgnoreCase storetype "Windows-ROOT-CURRENTUSER") "Windows-ROOT-CURRENTUSER"
      (.equalsIgnoreCase storetype "Windows-MY-LOCALMACHINE") "Windows-MY-LOCALMACHINE"
      (.equalsIgnoreCase storetype "Windows-ROOT-LOCALMACHINE") "Windows-ROOT-LOCALMACHINE"
      :else (.toUpperCase storetype Locale/ENGLISH)))

  (method ^:public ^:static getCacerts ^String [] (FilePaths/cacerts))

  (method ^:public ^:static getCacertsKeyStore :throws [Exception] ^KeyStore []
    (let [file (File. (KeyStoreUtil/getCacerts))]
      (when-not (not (.exists file)) (KeyStore/getInstance file (cast char/1 nil)))))

  (method ^:public ^:static getPassWithModifier ^char/1 [^String modifier ^String arg
                                                         ^ResourceBundle rb ^Collator collator]
    (cond
      (nil? modifier) (.toCharArray arg)
      (== (.compare collator modifier "env") 0)
        (let [value (System/getenv arg)]
          (if (nil? value)
              (do
                (.println System/err
                          (java-str (.getString rb "Cannot.find.environment.variable.") arg))
                nil)
              (.toCharArray value)))
      (== (.compare collator modifier "file") 0)
        (try
          (let [^:mutable ^URL url nil]
            (try
              (let [_unused (set! url (URL. arg))] nil)
              (catch MalformedURLException mue
                (let [f (File. arg)]
                  (if (.exists f)
                      (set! url (.toURL (.toURI f)))
                      (do
                        (.println System/err (java-str (.getString rb "Cannot.find.file.") arg))
                        (return nil))))))
            (with-resources [br (BufferedReader. (InputStreamReader. (.openStream url)))]
              (let [value (.readLine br)] (if (nil? value) (new char/1 0) (.toCharArray value)))))
          (catch IOException ioe (.println System/err ioe) nil))
      :else
        (do (.println System/err (java-str (.getString rb "Unknown.password.type.") modifier)) nil)))

  (method ^:private ^:static parseArgsLine :throws [IOException PropertyExpander$ExpandException] ^void [^{:tag (List String)} list
                                                                                                         ^String s]
    (let [st (StreamTokenizer. (StringReader. s))]
      (.resetSyntax st)
      (.whitespaceChars st 0x00 0x20)
      (.wordChars st 0x21 0xFF)
      (.quoteChar st \")
      (.quoteChar st \')
      (while (not (== (.nextToken st) StreamTokenizer/TT_EOF))
        (.add list (PropertyExpander/expand (.-sval st))))))

  (method ^:public ^:static expandArgs :throws [IOException PropertyExpander$ExpandException] ^String/1 [^String tool
                                                                                                         ^String file
                                                                                                         ^String c1
                                                                                                         ^String c2
                                                                                                         ^String/1 args]
    (let [^{:tag (List String)} result (ArrayList.)
          p (Properties.)]
      (with-resources [is (FileInputStream. file)] (.load p is))
      (let [s (.getProperty p (java-str tool ".all"))]
        (when (some? s) (KeyStoreUtil/parseArgsLine result s))
        (let [^:mutable s1 (.getProperty p (java-str tool "." (.substring c1 1)))
              ^:mutable ^String s2 nil]
          (when (some? c2) (set! s2 (.getProperty p (java-str tool "." (.substring c2 1)))))
          (when (and (some? s1) (some? s2))
            (throw (IOException. (java-str "Cannot have both "
                                           c1
                                           " and "
                                           c2
                                           " as pre-configured options"))))
          (when (nil? s1) (set! s1 s2))
          (when (some? s1) (KeyStoreUtil/parseArgsLine result s1))
          (if (.isEmpty result)
              args
              (do
                (.addAll result (Arrays/asList args))
                (cast String/1 (.toArray result (new String/1 0)))))))))

  (method ^:public ^:static loadProviderByName ^void [^String provName ^String arg]
    (let [^:mutable loaded (Security/getProvider provName)]
      (if (some? loaded)
          (when (some? arg) (set! loaded (.configure loaded arg)) (Security/addProvider loaded))
          (do
            (for-each [^:mutable ^Provider p (ServiceLoader/load
                                               Provider
                                               (ClassLoader/getSystemClassLoader))]
              (when (.equals (.getName p) provName)
                (when (some? arg) (set! p (.configure p arg)))
                (Security/addProvider p)
                (return)))
            (throw (IllegalArgumentException. "No provider found"))))))

  (method ^:public ^:static loadProviderByClass ^void [^String provClass ^String arg ^ClassLoader cl]
    (cond
      (.equals provClass "sun.security.pkcs11.SunPKCS11")
        (KeyStoreUtil/loadProviderByName "SunPKCS11" arg)
      (.equals provClass "sun.security.mscapi.SunMSCAPI")
        (KeyStoreUtil/loadProviderByName "SunMSCAPI" arg)
      :else
        (let [^:mutable ^Provider prov nil]
          (try
            (let [^{:tag (Class ?)} clazz (Class/forName provClass false cl)]
              (set! prov (cast Provider (.newInstance (.getConstructor clazz)))))
            (catch ReflectiveOperationException e (throw (IllegalArgumentException. e))))
          (when (some? arg) (set! prov (.configure prov arg)))
          (Security/addProvider prov)))))

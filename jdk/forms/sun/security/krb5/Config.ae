  (method ^:private getJavaFileName ^String [this]
    (let [^:mutable name (System/getProperty "java.security.krb5.conf")]
      (when (nil? name)
        (set! name
              (java-str (System/getProperty "java.home")
                        File/separator
                        "conf"
                        File/separator
                        "security"
                        File/separator
                        "krb5.conf"))
        (when-not (.fileExists this name) (set! name nil)))
      (when (some? Krb5/DEBUG) (.println Krb5/DEBUG (java-str "Java config name: " name)))
      name))

  (method ^:private getNativeFileName ^String [this]
    (let [^:mutable ^String name nil]
      (cond
        (OperatingSystem/isWindows)
          (do
            (try (Credentials/ensureLoaded) (catch Exception e))
            (when Credentials/alreadyLoaded
              (let [^:mutable path (Config/getWindowsDirectory false)]
                (when (some? path)
                  (if (.endsWith path "\\")
                      (set! path (java-str path "krb5.ini"))
                      (set! path (java-str path "\\krb5.ini")))
                  (when (.fileExists this path) (set! name path)))
                (when (nil? name)
                  (set! path (Config/getWindowsDirectory true))
                  (when (some? path)
                    (if (.endsWith path "\\")
                        (set! path (java-str path "krb5.ini"))
                        (set! path (java-str path "\\krb5.ini")))
                    (set! name path)))))
            (when (nil? name) (set! name "c:\\winnt\\krb5.ini")))
        (OperatingSystem/isMacOS) (set! name (.findMacosConfigFile this))
        :else (set! name "/etc/krb5.conf"))
      (when (some? Krb5/DEBUG) (.println Krb5/DEBUG (java-str "Native config name: " name)))
      name))

  (method ^:private findMacosConfigFile ^String [this]
    (let [userHome (System/getProperty "user.home")
          ^:const PREF_FILE "/Library/Preferences/edu.mit.Kerberos"
          userPrefs (java-str userHome PREF_FILE)]
      (cond
        (.fileExists this userPrefs) userPrefs
        (.fileExists this PREF_FILE) PREF_FILE
        :else "/etc/krb5.conf")))

  (method ^:private ^:static unquote ^String [^:mutable ^String s]

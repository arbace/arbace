                                 " default etypes no supported etypes found for configuration "
                                 configName)))
                      (do
                        (set! etype (new int/1 (.size ls)))
                        (loop [^int i 0]
                          (when (< i (alength etype))
                            (aset etype i (.intValue (cast Integer (.get ls i))))
                            (recur (unchecked-inc-int i))))))))))
        (when (some? Krb5/DEBUG)
          (let [^:mutable s (java-str "default etypes for " configName ":")]
            (loop [^int i 0]
              (when (< i (alength etype))
                (set! s (java-str s (java-str " " (aget etype i))))
                (recur (unchecked-inc-int i))))
            (set! s (java-str s "."))
            (.println Krb5/DEBUG s)))
        etype)))

  (method ^:public ^:static getType ^int [^String input]
    (let [^:mutable ^int result -1]
      (if (nil? input)
          result
          (do
            (cond
              (or (.startsWith input "d") (.startsWith input "D"))
                (cond
                  (.equalsIgnoreCase input "des-cbc-crc")
                    (set! result EncryptedData/ETYPE_DES_CBC_CRC)
                  (.equalsIgnoreCase input "des-cbc-md5")
                    (set! result EncryptedData/ETYPE_DES_CBC_MD5)
                  (.equalsIgnoreCase input "des-mac") (set! result Checksum/CKSUMTYPE_DES_MAC)
                  (.equalsIgnoreCase input "des-mac-k") (set! result Checksum/CKSUMTYPE_DES_MAC_K)
                  (.equalsIgnoreCase input "des-cbc-md4")
                    (set! result EncryptedData/ETYPE_DES_CBC_MD4)
                  (or (or (or (.equalsIgnoreCase input "des3-cbc-sha1")
                              (.equalsIgnoreCase input "des3-hmac-sha1"))
                          (.equalsIgnoreCase input "des3-cbc-sha1-kd"))
                      (.equalsIgnoreCase input "des3-cbc-hmac-sha1-kd"))
                    (set! result EncryptedData/ETYPE_DES3_CBC_HMAC_SHA1_KD))
              (or (.startsWith input "a") (.startsWith input "A"))
                (cond
                  (or (or (.equalsIgnoreCase input "aes128-cts")
                          (.equalsIgnoreCase input "aes128-sha1"))
                      (.equalsIgnoreCase input "aes128-cts-hmac-sha1-96"))
                    (set! result EncryptedData/ETYPE_AES128_CTS_HMAC_SHA1_96)
                  (or (or (.equalsIgnoreCase input "aes256-cts")
                          (.equalsIgnoreCase input "aes256-sha1"))
                      (.equalsIgnoreCase input "aes256-cts-hmac-sha1-96"))
                    (set! result EncryptedData/ETYPE_AES256_CTS_HMAC_SHA1_96)
                  (or (.equalsIgnoreCase input "aes128-sha2")
                      (.equalsIgnoreCase input "aes128-cts-hmac-sha256-128"))
                    (set! result EncryptedData/ETYPE_AES128_CTS_HMAC_SHA256_128)
                  (or (.equalsIgnoreCase input "aes256-sha2")
                      (.equalsIgnoreCase input "aes256-cts-hmac-sha384-192"))
                    (set! result EncryptedData/ETYPE_AES256_CTS_HMAC_SHA384_192)
                  (or (.equalsIgnoreCase input "arcfour-hmac")
                      (.equalsIgnoreCase input "arcfour-hmac-md5"))
                    (set! result EncryptedData/ETYPE_ARCFOUR_HMAC))
              (.equalsIgnoreCase input "rc4-hmac") (set! result EncryptedData/ETYPE_ARCFOUR_HMAC)
              (.equalsIgnoreCase input "CRC32") (set! result Checksum/CKSUMTYPE_CRC32)
              (or (.startsWith input "r") (.startsWith input "R"))
                (cond
                  (.equalsIgnoreCase input "rsa-md5") (set! result Checksum/CKSUMTYPE_RSA_MD5)
                  (.equalsIgnoreCase input "rsa-md5-des")
                    (set! result Checksum/CKSUMTYPE_RSA_MD5_DES))
              (.equalsIgnoreCase input "hmac-sha1-des3-kd")
                (set! result Checksum/CKSUMTYPE_HMAC_SHA1_DES3_KD)
              (.equalsIgnoreCase input "hmac-sha1-96-aes128")
                (set! result Checksum/CKSUMTYPE_HMAC_SHA1_96_AES128)
              (.equalsIgnoreCase input "hmac-sha1-96-aes256")
                (set! result Checksum/CKSUMTYPE_HMAC_SHA1_96_AES256)
              (.equalsIgnoreCase input "hmac-sha256-128-aes128")
                (set! result Checksum/CKSUMTYPE_HMAC_SHA256_128_AES128)
              (.equalsIgnoreCase input "hmac-sha384-192-aes256")
                (set! result Checksum/CKSUMTYPE_HMAC_SHA384_192_AES256)
              (or (or (.equalsIgnoreCase input "hmac-md5-rc4")
                      (.equalsIgnoreCase input "hmac-md5-arcfour"))
                  (.equalsIgnoreCase input "hmac-md5-enc"))
                (set! result Checksum/CKSUMTYPE_HMAC_MD5_ARCFOUR)
              (.equalsIgnoreCase input "NULL") (set! result EncryptedData/ETYPE_NULL))
            result))))

  (method ^:public resetDefaultRealm ^void [this ^String realm]
    (when (some? Krb5/DEBUG)
      (.println Krb5/DEBUG (java-str ">>> Config try resetting default kdc " realm))))

  (method ^:public useAddresses ^boolean [this]
    (or (identical? (.getBooleanObject this "libdefaults" "no_addresses") Boolean/FALSE)
        (identical? (.getBooleanObject this "libdefaults" "noaddresses") Boolean/FALSE)))

  (method ^:private useDNS ^boolean [this ^String name ^boolean defaultValue]
    (let [^:mutable value (.getBooleanObject this "libdefaults" name)]
      (if (some? value)
          (.booleanValue value)
          (do
            (set! value (.getBooleanObject this "libdefaults" "dns_fallback"))
            (if (some? value) (.booleanValue value) defaultValue)))))

  (method ^:private useDNS_KDC ^boolean [this]
    (.useDNS this "dns_lookup_kdc" true))

  (method ^:private useDNS_Realm ^boolean [this]
    (.useDNS this "dns_lookup_realm" false))

  (method ^:public getDefaultRealm :throws [KrbException] ^String [this]
    (if (some? defaultRealm)
        defaultRealm
        (let [^:mutable ^Exception cause nil
              ^:mutable realm (.get this "libdefaults" "default_realm")]
          (when (and (nil? realm) (.useDNS_Realm this))
            (try (set! realm (.getRealmFromDNS this)) (catch KrbException ke (set! cause ke))))
          (when (nil? realm)
            (when (OperatingSystem/isWindows) (set! realm (System/getenv "USERDNSDOMAIN"))))
          (when (nil? realm)
            (let [ke (KrbException. "Cannot locate default realm")]
              (when (some? cause) (.initCause ke cause))
              (throw ke)))
          realm)))

  (method ^:public getKDCList :throws [KrbException] ^String [this ^:mutable ^String realm]
    (when (nil? realm) (set! realm (.getDefaultRealm this)))
    (if (.equalsIgnoreCase realm defaultRealm)
        defaultKDC
        (let [^:mutable ^Exception cause nil
              ^:mutable kdcs (.getAll this "realms" realm "kdc")]
          (when (and (nil? kdcs) (.useDNS_KDC this))
            (try (set! kdcs (.getKDCFromDNS this realm)) (catch KrbException ke (set! cause ke))))
          (when (nil? kdcs)
            (when (OperatingSystem/isWindows)
              (let [^:mutable logonServer (System/getenv "LOGONSERVER")]
                (when (and (some? logonServer) (.startsWith logonServer "\\\\"))
                  (set! logonServer (.substring logonServer 2)))
                (set! kdcs logonServer))))
          (when (nil? kdcs)
            (when (some? defaultKDC) (return defaultKDC))
            (let [ke (KrbException. (java-str "Cannot locate KDC for " realm))]
              (when (some? cause) (.initCause ke cause))
              (throw ke)))
          kdcs)))

  (method ^:private getRealmFromDNS :throws [KrbException] ^String [this]
    (let [^:mutable ^String realm nil
          ^:mutable ^String hostName nil]
      (try
        (set! hostName (.getCanonicalHostName (InetAddress/getLocalHost)))
        (catch UnknownHostException e
          (let [ke (KrbException. Krb5/KRB_ERR_GENERIC
                                  (java-str "Unable to locate Kerberos realm: " (.getMessage e)))]
            (.initCause ke e)
            (throw ke))))
      (let [mapRealm (PrincipalName/mapHostToRealm hostName)]
        (if (nil? mapRealm)
            (let [^{:tag (List String)} srchlist (.searchlist (ResolverConfiguration/open))]
              (for-each [^String domain srchlist]
                (set! realm (Config/checkRealm domain))
                (when (some? realm) (break))))
            (set! realm (Config/checkRealm mapRealm)))
        (when (nil? realm)
          (throw (KrbException. Krb5/KRB_ERR_GENERIC "Unable to locate Kerberos realm")))
        realm)))

  (method ^:private ^:static checkRealm ^String [^String mapRealm]
    (when (some? Krb5/DEBUG) (.println Krb5/DEBUG (java-str "getRealmFromDNS: trying " mapRealm)))
    (let [^:mutable ^String/1 records nil
          ^:mutable newRealm mapRealm]
      (while (and (nil? records) (some? newRealm))
        (set! records (KrbServiceLocator/getKerberosService newRealm))
        (set! newRealm (Realm/parseRealmComponent newRealm)))
      (when (some? records)
        (loop [^int i 0]
          (if (< i (alength records))
              (if (.equalsIgnoreCase (aget records i) mapRealm)
                  (return (aget records i))
                  (recur (unchecked-inc-int i)))
              nil)))
      nil))

  (method ^:private getKDCFromDNS :throws [KrbException] ^String [this ^String realm]
    (let [^:mutable kdcs ""
          ^:mutable ^String/1 srvs nil]
      (when (some? Krb5/DEBUG) (.println Krb5/DEBUG "getKDCFromDNS using UDP"))
      (set! srvs (KrbServiceLocator/getKerberosService realm "_udp"))
      (when (nil? srvs)
        (when (some? Krb5/DEBUG) (.println Krb5/DEBUG "getKDCFromDNS using TCP"))
        (set! srvs (KrbServiceLocator/getKerberosService realm "_tcp")))
      (when (nil? srvs)
        (throw (KrbException. Krb5/KRB_ERR_GENERIC
                              (java-str "Unable to locate KDC for realm " realm))))
      (when-not (== (alength srvs) 0)
        (loop [^int i 0]
          (when (< i (alength srvs))
            (set! kdcs (java-str kdcs (java-str (.trim (aget srvs i)) " ")))
            (recur (unchecked-inc-int i))))
        (set! kdcs (.trim kdcs))
        (when-not (.equals kdcs "") kdcs))))

  (method ^:private fileExists ^boolean [this ^String name]
    (.exists (File. name)))

  (method ^:public toString ^String [this]
    (let [sb (StringBuffer.)] (Config/toStringInternal "" stanzaTable sb) (.toString sb)))

  (method ^:private ^:static toStringInternal ^void [^String prefix obj ^StringBuffer sb]
    (cond
      (instance? String obj) (.append (.append sb obj) \newline)
      (instance? Hashtable obj)
        (let [^{:tag (Hashtable ? ?)} tab (cast Hashtable obj)]
          (.append sb "{\n")
          (for-each [o (.keySet tab)]
            (.append (.append (.append (.append sb prefix) "    ") o) " = ")
            (Config/toStringInternal (java-str prefix "    ") (.get tab o) sb))
          (.append (.append sb prefix) "}\n"))
      (instance? Vector obj)
        (let [^{:tag (Vector ?)} v (cast Vector obj)]
          (.append sb "[")
          (let [^:mutable first true]
            (for-each [o (.toArray v)]
              (when-not first (.append sb ","))
              (.append sb o)
              (set! first false))
            (.append sb "]\n"))))))

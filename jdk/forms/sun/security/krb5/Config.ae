    (when-not (.isAbsolute file) (throw (KrbException. "Profile path not absolute")))
    (when (> (.size allConfs) MAX_INCLUDE_FILE) (throw (KrbException. "Too many include files")))
    (when-not (.add dups file) (throw (KrbException. "Recursive include")))
    (try
      (when-not (.containsKey allConfs file)
        (let [^{:tag (List String)} lines (Files/readAllLines file)
              ^{:tag (List String)} content (ArrayList.)]
          (.put allConfs file content)
          (let [^:mutable inSections false]
            (for-each [^:mutable ^String line lines]
              (set! line (.trim line))
              (when-not (or (or (.isEmpty line) (.startsWith line "#")) (.startsWith line ";"))
                (cond
                  (.startsWith line "includedir ")
                    (let [dir (Paths/get (.trim (.substring line (.length "includedir ")))
                                         (new String/1 []))]
                      (with-resources [^{:tag (Stream Path)} files (Files/list dir)]
                        (for-each [^Path p (.toList (.sorted files))]
                          (when-not (Files/isDirectory p)
                            (let [name (.toString (.getFileName p))]
                              (when (or (.matches name "[a-zA-Z0-9_-]+")
                                        (and (not (.startsWith name ".")) (.endsWith name ".conf")))
                                (.readConfigFileLines this p dups)
                                (.add content (java-str "#include " p))))))))
                  (.startsWith line "include ")
                    (let [p (Paths/get (.trim (.substring line (.length "include ")))
                                       (new String/1 []))]
                      (.add content (java-str "#include " p))
                      (.readConfigFileLines this p dups))
                  (not inSections)
                    (cond
                      (== (.charAt line 0) \[) (do (set! inSections true) (.add content line))
                      (some? Krb5/DEBUG)
                        (.println Krb5/DEBUG (java-str "Line not in any section: " line)))
                  :else (.add content line)))))))
      (finally (.remove dups file))))


          keys (.getKrb5EncryptionKeys cred (.-sname (.-ticket apReqMessg)))
          dkey (EncryptionKey/findKey encPartKeyType kvno keys)]
      (when (nil? dkey)
        (throw (KrbException. Krb5/API_INVALID_ARG

          (set! cusec (.-cusec authenticator))
          (set! (.-ctime authenticator)
                (.withMicroSeconds (.-ctime authenticator) (.-cusec authenticator)))
          (when-not (.equals (.-cname authenticator) (.-cname enc_ticketPart))
            (throw (KrbApErrException. Krb5/KRB_AP_ERR_BADMATCH)))
          (when-not (.inClockSkew (.-ctime authenticator))
            (throw (KrbApErrException. Krb5/KRB_AP_ERR_SKEW)))

  (method ^:public ^:static acquireTGTFromCache :throws [KrbException IOException] ^Credentials [^PrincipalName princ
                                                                                                 ^String ticketCache]
    (when (nil? ticketCache)
      (when (or (OperatingSystem/isWindows) (OperatingSystem/isMacOS))
        (let [creds (Credentials/acquireDefaultCreds)]
          (when (nil? creds)
            (when (some? Krb5/DEBUG) (.println Krb5/DEBUG ">>> Found no TGT's in native ccache"))
            (return nil))
          (if (some? princ)
              (if (.equals (.getClient creds) princ)
                  (do
                    (when (some? Krb5/DEBUG)
                      (.println Krb5/DEBUG (java-str ">>> Obtained TGT from native ccache: " creds)))
                    (return creds))
                  (do
                    (when (some? Krb5/DEBUG)
                      (.println Krb5/DEBUG
                                (java-str ">>> native ccache contains TGT for "
                                          (.getClient creds)
                                          " not "
                                          princ)))
                    (return nil)))
              (do
                (when (some? Krb5/DEBUG)
                  (.println Krb5/DEBUG (java-str ">>> Obtained TGT from native ccache: " creds)))
                (return creds))))))
    (let [ccache (CredentialsCache/getInstance princ ticketCache)]
      (when (some? ccache)
        (let [tgtCred (.getInitialCreds ccache)]
          (when (some? tgtCred)
            (if (EType/isSupported (.getEType (.-key tgtCred)))
                tgtCred
                (do
                  (when (some? Krb5/DEBUG)
                    (.println Krb5/DEBUG
                              (java-str ">>> unsupported key type found the default TGT: "
                                        (.getEType (.-key tgtCred)))))
                  nil)))))))

  (method ^:public ^:static ^:synchronized acquireDefaultCreds ^Credentials []
    (let [^:mutable ^Credentials result nil
          cache (CredentialsCache/getInstance)]
      (when (some? cache)
        (let [temp (.getInitialCreds cache)]
          (when (some? temp)
            (when (some? Krb5/DEBUG)
              (.println
                Krb5/DEBUG
                ">>> KrbCreds found the default ticket granting ticket in credential cache."))
            (cond
              (EType/isSupported (.getEType (.-key temp))) (set! result temp)
              (some? Krb5/DEBUG)
                (.println Krb5/DEBUG
                          (java-str ">>> unsupported key type found the default TGT: "
                                    (.getEType (.-key temp))))))))
      (when (nil? result)
        (when-not alreadyTried
          (try
            (Credentials/ensureLoaded)
            (catch Exception e
              (when (some? Krb5/DEBUG)
                (.println Krb5/DEBUG "Can not load native ccache library")
                (.printStackTrace e))
              (set! alreadyTried true))))
        (when alreadyLoaded
          (when (some? Krb5/DEBUG) (.println Krb5/DEBUG ">> Acquire default native Credentials"))
          (try
            (set!
              result
              (Credentials/acquireDefaultNativeCreds (EType/getDefaults "default_tkt_enctypes")))
            (catch KrbException ke))))
      result))


                    (set! temp (KdcComm/parseNonNegativeIntString value))))
              (catch Exception exc))
            (cond mustBePositive (when (> temp 0) (set! v temp)) (>= temp 0) (set! v temp))
            v))))

  (method ^:private ^:static parseNonNegativeIntString ^int [^String intString]

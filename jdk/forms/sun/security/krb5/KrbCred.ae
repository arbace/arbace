            encPart (EncKrbCredPart. credInfos timeStamp nil nil nil nil)
            encEncPart (EncryptedData. key (.asn1Encode encPart) KeyUsage/KU_ENC_KRB_CRED_PART)
            tickets (new Ticket/1 [(.-ticket delegatedCreds)])]

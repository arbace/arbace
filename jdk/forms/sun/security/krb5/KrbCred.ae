    (let [temp (.decrypt (.-encPart credMessg) key KeyUsage/KU_ENC_KRB_CRED_PART)
          plainText (.reset (.-encPart credMessg) temp)
          encoding (DerValue. plainText)
          encPart (EncKrbCredPart. encoding)]
      (set! timeStamp (.-timeStamp encPart))
      (let [credInfo (aget (.-ticketInfo encPart) 0)

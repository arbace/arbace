          princ (.getClient delegatedCreds)
          tgService (.getServer delegatedCreds)
          credInfo (KrbCredInfo. sessionKey
                                 princ
                                 (.-flags delegatedCreds)
                                 (.-authTime delegatedCreds)
                                 (.-startTime delegatedCreds)
                                 (.-endTime delegatedCreds)
                                 (.-renewTill delegatedCreds)
                                 tgService

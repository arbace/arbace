                      (when (and (and (== (alength serverNameStrings) 2)
                                      (.equals (aget serverNameStrings 0)
                                               PrincipalName/TGS_DEFAULT_SRV_NAME))
                                 (not (.equals (.getRealmAsString refSname)
                                               (aget serverNameStrings 1))))

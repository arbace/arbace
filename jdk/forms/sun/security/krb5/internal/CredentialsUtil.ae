                                                user
                                                nil
                                                (new
                                                  PAData/1
                                                  [(PAData.
                                                     Krb5/PA_FOR_USER
                                                     (.asn1Encode
                                                       (PAForUserEnc.
                                                         user
                                                         (.getSessionKey middleTGT))))
                                                   (PAData.
                                                     Krb5/PA_PAC_OPTIONS
                                                     (.asn1Encode
                                                       (.setClaims
                                                         (.setResourceBasedConstrainedDelegation
                                                           (PaPacOptions.)

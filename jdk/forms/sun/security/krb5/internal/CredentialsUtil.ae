                                                                                                    ^PrincipalName cname
                                                                                                    ^PrincipalName sname
                                                                                                    ^S4U2Type s4u2Type
                                                                                                    ^PrincipalName user
                                                                                                    ^:mutable ^Credentials additionalCreds

  (method ^:private ^:static handleS4U2SelfReferral :throws [Asn1Exception KrbException IOException] ^void [^PAData/1 pas
                                                                                                            ^PrincipalName user
                                                                                                            ^Credentials newCreds]
    (when (some? Krb5/DEBUG) (.println Krb5/DEBUG ">>> Handling S4U2Self referral"))
    (loop [^int i 0]
      (when (< i (alength pas))
        (let [pa (aget pas i)]
          (if (== (.getType pa) Krb5/PA_FOR_USER)
              (aset pas
                    i
                    (PAData. Krb5/PA_FOR_USER
                             (.asn1Encode (PAForUserEnc. user (.getSessionKey newCreds)))))
              (recur (unchecked-inc-int i)))))))

  (method ^:private ^:static handleS4U2ProxyReferral :throws [KrbException IOException] ^String [^Credentials asCreds
                                                                                                 ^Credentials/1 credsInOut
                                                                                                 ^PrincipalName sname]
    (when (some? Krb5/DEBUG) (.println Krb5/DEBUG ">>> Handling S4U2Proxy referral"))
    (let [^:mutable ^Credentials refTGT nil
          middleSvcCredsInBackendRealm (CredentialsUtil/serviceCreds sname asCreds)
          backendRealm (.getRealmString (.getServer middleSvcCredsInBackendRealm))
          toRealm (aget (.getNameStrings (.getServer (aget credsInOut 0))) 1)]

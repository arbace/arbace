            ^:mutable ^byte/1 outputByte nil
            ^int inputSize 0
            tmpBuf (new byte/1 3)
            ^:mutable mark (.position src)]
        (try
          (while (.hasRemaining src)
            (set! outputByte tmpBuf)
            (let [c (.get src)]
              (when (Character/isSurrogate c)
                (when (< (.parse sgp c src) 0) (return (.error sgp)))
                (return (.unmappableResult sgp)))
              (set! outputSize (.encodeSingle this c outputByte))
              (when (== outputSize 0)
                (let [ncode (.encodeDouble this c)]
                  (if (not (== ncode CharsetMapping/UNMAPPABLE_ENCODING))
                      (if (== (bit-and-int ncode 0xFF0000) 0)
                          (do
                            (aset outputByte
                                  0
                                  (unchecked-byte
                                    (bit-shift-right-int (bit-and-int ncode 0xff00) 8)))
                            (aset outputByte 1 (unchecked-byte (bit-and-int ncode 0xff)))
                            (set! outputSize 2))
                          (do
                            (aset outputByte 0 (unchecked-byte 0x8f))
                            (aset outputByte
                                  1
                                  (unchecked-byte
                                    (bit-shift-right-int (bit-and-int ncode 0xff00) 8)))
                            (aset outputByte 2 (unchecked-byte (bit-and-int ncode 0xff)))
                            (set! outputSize 3)))
                      (return (CoderResult/unmappableForLength 1)))))
              (when (< (.remaining dst) outputSize) (return CoderResult/OVERFLOW))
              (loop [^int i 0]
                (when (< i outputSize) (.put dst (aget outputByte i)) (recur (unchecked-inc-int i))))
              (set! mark (unchecked-inc-int mark))))
          CoderResult/UNDERFLOW
          (finally (.position src mark)))))

    (method ^:protected encodeLoop ^CoderResult [this ^CharBuffer src ^ByteBuffer dst]
      (if (and (.hasArray src) (.hasArray dst))
          (.encodeArrayLoop this src dst)
          (.encodeBufferLoop this src dst)))))

                      (.put dst (unchecked-byte 0x28))
                      (.put dst (unchecked-byte 0x4a))
                      (set! currentMode JISX0201_1976))
                    (when (< (.remaining dst) 1) (return CoderResult/OVERFLOW))
                    (.put dst (if (== c \¥) (unchecked-byte 0x5C) (unchecked-byte 0x7e))))
                :else
                  (let [^:mutable index (.encodeChar enc0208 c)]
                    (cond
                      (not (== index CharsetMapping/UNMAPPABLE_ENCODING))
                        (do
                          (when-not (== currentMode JISX0208_1983)
                            (when (< (.remaining dst) 3) (return CoderResult/OVERFLOW))
                            (.put dst (unchecked-byte 0x1b))
                            (.put dst (unchecked-byte 0x24))
                            (.put dst (unchecked-byte 0x42))
                            (set! currentMode JISX0208_1983))
                          (when (< (.remaining dst) 2) (return CoderResult/OVERFLOW))
                          (.put dst (unchecked-byte (bit-shift-right-int index 8)))
                          (.put dst (unchecked-byte (bit-and-int index 0xff))))
                      (and (some? enc0212)
                           (not (== (set! index (.encodeChar enc0212 c))
                                    CharsetMapping/UNMAPPABLE_ENCODING)))
                        (do
                          (when-not (== currentMode JISX0212_1990)
                            (when (< (.remaining dst) 4) (return CoderResult/OVERFLOW))
                            (.put dst (unchecked-byte 0x1b))
                            (.put dst (unchecked-byte 0x24))
                            (.put dst (unchecked-byte 0x28))
                            (.put dst (unchecked-byte 0x44))
                            (set! currentMode JISX0212_1990))
                          (when (< (.remaining dst) 2) (return CoderResult/OVERFLOW))
                          (.put dst (unchecked-byte (bit-shift-right-int index 8)))
                          (.put dst (unchecked-byte (bit-and-int index 0xff))))
                      :else
                        (do
                          (when (and (Character/isSurrogate c) (< (.parse sgp c src) 0))
                            (return (.error sgp)))
                          (when (and (identical?
                                       (.unmappableCharacterAction this)
                                       CodingErrorAction/REPLACE)
                                     (not (== currentMode replaceMode)))
                            (when (< (.remaining dst) 3) (return CoderResult/OVERFLOW))
                            (if (== replaceMode ASCII)
                                (do
                                  (.put dst (unchecked-byte 0x1b))
                                  (.put dst (unchecked-byte 0x28))
                                  (.put dst (unchecked-byte 0x42)))
                                (do
                                  (.put dst (unchecked-byte 0x1b))
                                  (.put dst (unchecked-byte 0x24))
                                  (.put dst (unchecked-byte 0x42))))
                            (set! currentMode replaceMode))
                          (when (Character/isSurrogate c) (return (.unmappableResult sgp)))
                          (return (CoderResult/unmappableForLength 1))))))
              (set! mark (unchecked-inc-int mark))))
          CoderResult/UNDERFLOW
          (finally (.position src mark)))))

    (method ^:protected encodeLoop ^CoderResult [this ^CharBuffer src ^ByteBuffer dst]
      (if (and (.hasArray src) (.hasArray dst))
          (.encodeArrayLoop this src dst)
          (.encodeBufferLoop this src dst)))))

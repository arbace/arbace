                                          (aget encoderMappingTable (unchecked-add-int index 1))))))
                            (set! sp (unchecked-inc-int sp))))))))
            CoderResult/UNDERFLOW)
          (finally
            (.position src (unchecked-subtract-int sp (.arrayOffset src)))
            (.position dst (unchecked-subtract-int dp (.arrayOffset dst)))))))

    (method ^:private encodeBufferLoop ^CoderResult [this ^CharBuffer src ^ByteBuffer dst]
      (let [^:mutable mark (.position src)]
        (try
          (let [^:mutable ^char inputChar (unchecked-char 0)]
            (while (.hasRemaining src)
              (let [^:mutable index Integer/MIN_VALUE]
                (set! inputChar (.get src))
                (if (and (>= inputChar 0x0000) (<= inputChar 0x007f))
                    (do
                      (when (< (.remaining dst) 1) (return CoderResult/OVERFLOW))
                      (.put dst (unchecked-byte inputChar))
                      (set! mark (unchecked-inc-int mark)))
                    (do
                      (cond
                        (== inputChar 0x200c) (set! inputChar HALANT_CHAR)
                        (== inputChar 0x200d) (set! inputChar NUKTA_CHAR))
                      (when (and (>= inputChar 0x0900) (<= inputChar 0x097f))
                        (set! index
                              (unchecked-multiply-int
                                (unchecked-subtract-int (int inputChar) 0x0900)
                                2)))
                      (when (Character/isSurrogate inputChar)
                        (when (< (.parse sgp inputChar src) 0) (return (.error sgp)))
                        (return (.unmappableResult sgp)))
                      (cond
                        (or (== index Integer/MIN_VALUE)
                            (== (aget encoderMappingTable index) NO_CHAR))
                          (return (CoderResult/unmappableForLength 1))
                        (== (aget encoderMappingTable (unchecked-add-int index 1)) NO_CHAR)
                          (do
                            (when (< (.remaining dst) 1) (return CoderResult/OVERFLOW))
                            (.put dst (aget encoderMappingTable index)))
                        :else
                          (do
                            (when (< (.remaining dst) 2) (return CoderResult/OVERFLOW))
                            (.put dst (aget encoderMappingTable index))
                            (.put dst (aget encoderMappingTable (unchecked-add-int index 1)))))
                      (set! mark (unchecked-inc-int mark))))))
            CoderResult/UNDERFLOW)
          (finally (.position src mark)))))

    (method ^:protected encodeLoop ^CoderResult [this ^CharBuffer src ^ByteBuffer dst]
      (if (and (.hasArray src) (.hasArray dst))
          (.encodeArrayLoop this src dst)
          (.encodeBufferLoop this src dst)))))

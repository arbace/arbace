                  (set! dp (unchecked-inc-int dp))
                  (when (> (alength repl) 1)
                    (aset dst dp (aget repl 1))
                    (set! dp (unchecked-inc-int dp))))
              (> bb MAX_SINGLEBYTE)
                (do
                  (aset dst dp (unchecked-byte (bit-shift-right-int bb 8)))
                  (set! dp (unchecked-inc-int dp))
                  (aset dst dp (unchecked-byte bb))
                  (set! dp (unchecked-inc-int dp)))
              :else (do (aset dst dp (unchecked-byte bb)) (set! dp (unchecked-inc-int dp))))))
        dp))

    (method ^:public isASCIICompatible ^boolean [this] isASCIICompatible)

    (method ^:public encodeChar ^int [this ^char ch]
      (aget c2b
            (unchecked-add-int (aget c2bIndex (bit-shift-right-int ch 8)) (bit-and-int ch 0xff))))

    (method ^:public ^:static initC2B ^void [^String/1 b2c ^String b2cSB ^String b2cNR ^String c2bNR
                                             ^int b2Min ^int b2Max ^char/1 c2b ^char/1 c2bIndex]
      (Arrays/fill c2b (unchecked-char CharsetMapping/UNMAPPABLE_ENCODING))
      (let [^:mutable ^int off 0x100
            b2c_ca (new char/2 (alength b2c))
            ^:mutable ^char/1 b2cSB_ca nil]
        (when (some? b2cSB) (set! b2cSB_ca (.toCharArray b2cSB)))
        (loop [^int i 0]
          (if (< i (alength b2c))
              (if (nil? (aget b2c i))
                  (recur (unchecked-inc-int i))
                  (do (aset b2c_ca i (.toCharArray (aget b2c i))) (recur (unchecked-inc-int i))))
              nil))
        (when (some? b2cNR)
          (let [^:mutable ^int j 0]
            (while (< j (.length b2cNR))
              (let [b (.charAt b2cNR (let [old-9 j] (set! j (unchecked-inc-int j)) old-9))
                    c (.charAt b2cNR (let [old-10 j] (set! j (unchecked-inc-int j)) old-10))]
                (cond
                  (and (< b 0x100) (some? b2cSB_ca))
                    (when (== (aget b2cSB_ca b) c)
                      (aset b2cSB_ca b CharsetMapping/UNMAPPABLE_DECODING))
                  (== (aget b2c_ca
                            (bit-shift-right-int b 8)
                            (unchecked-subtract-int (bit-and-int b 0xff) b2Min))
                      c)
                    (aset (aget b2c_ca (bit-shift-right-int b 8))
                          (unchecked-subtract-int (bit-and-int b 0xff) b2Min)
                          CharsetMapping/UNMAPPABLE_DECODING))))))
        (when (some? b2cSB_ca)
          (loop [^int b 0]
            (when (< b (alength b2cSB_ca))
              (let [c (aget b2cSB_ca b)]
                (if (== c CharsetMapping/UNMAPPABLE_DECODING)
                    (recur (unchecked-inc-int b))
                    (let [^:mutable ^int index (aget c2bIndex (bit-shift-right-int c 8))]
                      (when (== index 0)
                        (set! index off)
                        (set! off (unchecked-add-int off 0x100))
                        (aset c2bIndex (bit-shift-right-int c 8) (unchecked-char index)))
                      (aset c2b (unchecked-add-int index (bit-and-int c 0xff)) (unchecked-char b))
                      (recur (unchecked-inc-int b))))))))
        (loop [^int b1 0]
          (when (< b1 (alength b2c))
            (let [db (aget b2c_ca b1)]
              (if (nil? db)
                  (recur (unchecked-inc-int b1))
                  (do
                    (loop [^int b2 b2Min]
                      (when (<= b2 b2Max)
                        (let [c (aget db (unchecked-subtract-int b2 b2Min))]
                          (if (== c CharsetMapping/UNMAPPABLE_DECODING)
                              (recur (unchecked-inc-int b2))
                              (let [^:mutable ^int index (aget c2bIndex (bit-shift-right-int c 8))]
                                (when (== index 0)
                                  (set! index off)
                                  (set! off (unchecked-add-int off 0x100))
                                  (aset c2bIndex (bit-shift-right-int c 8) (unchecked-char index)))
                                (aset c2b
                                      (unchecked-add-int index (bit-and-int c 0xff))
                                      (unchecked-char (bit-or-int (bit-shift-left-int b1 8) b2)))
                                (recur (unchecked-inc-int b2)))))))
                    (recur (unchecked-inc-int b1)))))))
        (when (some? c2bNR)
          (loop [^int i 0]
            (when (< i (.length c2bNR))
              (let [b (.charAt c2bNR i)
                    c (.charAt c2bNR (unchecked-add-int i 1))
                    ^:mutable index (bit-shift-right-int c 8)]
                (when (== (aget c2bIndex index) 0)
                  (aset c2bIndex index (unchecked-char off))
                  (set! off (unchecked-add-int off 0x100)))
                (set! index (unchecked-add-int (aget c2bIndex index) (bit-and-int c 0xff)))
                (aset c2b index b)
                (recur (unchecked-add-int i 2)))))))))

  (defclass ^:public ^:static Encoder_DBCSONLY
    :extends Encoder

    (constructor ^:public [this ^Charset cs ^byte/1 repl ^char/1 c2b ^char/1 c2bIndex
                           ^boolean isASCIICompatible]
      (super. cs (float 2.0) (float 2.0) repl c2b c2bIndex isASCIICompatible))

    (method ^:public encodeChar ^int [this ^char ch]
      (let [bb (.encodeChar super ch)]
        (if (<= bb Encoder_DBCSONLY/MAX_SINGLEBYTE) CharsetMapping/UNMAPPABLE_ENCODING bb))))

  (defclass ^:public ^:static Encoder_EBCDIC
    :extends Encoder

    (field ^:static ^:final ^int SBCS 0)

    (field ^:static ^:final ^int DBCS 1)

    (field ^:static ^:final ^byte SO 0x0e)

    (field ^:static ^:final ^byte SI 0x0f)

    (field ^:protected ^int currentState SBCS)

    (constructor ^:public [this ^Charset cs ^char/1 c2b ^char/1 c2bIndex ^boolean isASCIICompatible]
      (super. cs
              (float 4.0)
              (float 5.0)
              (new byte/1 [(unchecked-byte 0x6f)])
              c2b
              c2bIndex
              isASCIICompatible))

    (method ^:protected implReset ^void [this] (set! currentState SBCS))

    (method ^:protected implFlush ^CoderResult [this ^ByteBuffer out]
      (when (== currentState DBCS)
        (when (< (.remaining out) 1) (return CoderResult/OVERFLOW))
        (.put out SI))
      (.implReset this)
      CoderResult/UNDERFLOW)

    (method ^:protected encodeArrayLoop ^CoderResult [this ^CharBuffer src ^ByteBuffer dst]
      (let [sa (.array src)
            ^:mutable sp (unchecked-add-int (.arrayOffset src) (.position src))
            sl (unchecked-add-int (.arrayOffset src) (.limit src))
            da (.array dst)
            ^:mutable dp (unchecked-add-int (.arrayOffset dst) (.position dst))
            dl (unchecked-add-int (.arrayOffset dst) (.limit dst))]
        (try
          (while (< sp sl)
            (let [c (aget sa sp)
                  bb (.encodeChar this c)]
              (when (== bb CharsetMapping/UNMAPPABLE_ENCODING)
                (when (Character/isSurrogate c)
                  (when (< (.parse (.sgp this) c sa sp sl) 0) (return (.error (.-sgp this))))
                  (return (.unmappableResult (.-sgp this))))
                (return (CoderResult/unmappableForLength 1)))
              (if (> bb Encoder_EBCDIC/MAX_SINGLEBYTE)
                  (do
                    (when (== currentState SBCS)
                      (when (< (unchecked-subtract-int dl dp) 1) (return CoderResult/OVERFLOW))
                      (set! currentState DBCS)
                      (aset da dp SO)
                      (set! dp (unchecked-inc-int dp)))
                    (when (< (unchecked-subtract-int dl dp) 2) (return CoderResult/OVERFLOW))
                    (aset da dp (unchecked-byte (bit-shift-right-int bb 8)))
                    (set! dp (unchecked-inc-int dp))
                    (aset da dp (unchecked-byte bb))
                    (set! dp (unchecked-inc-int dp)))
                  (do
                    (when (== currentState DBCS)
                      (when (< (unchecked-subtract-int dl dp) 1) (return CoderResult/OVERFLOW))
                      (set! currentState SBCS)
                      (aset da dp SI)
                      (set! dp (unchecked-inc-int dp)))
                    (when (< (unchecked-subtract-int dl dp) 1) (return CoderResult/OVERFLOW))
                    (aset da dp (unchecked-byte bb))
                    (set! dp (unchecked-inc-int dp))))
              (set! sp (unchecked-inc-int sp))))
          CoderResult/UNDERFLOW
          (finally
            (.position src (unchecked-subtract-int sp (.arrayOffset src)))
            (.position dst (unchecked-subtract-int dp (.arrayOffset dst)))))))

    (method ^:protected encodeBufferLoop ^CoderResult [this ^CharBuffer src ^ByteBuffer dst]
      (let [^:mutable mark (.position src)]
        (try
          (while (.hasRemaining src)
            (let [c (.get src)
                  bb (.encodeChar this c)]
              (when (== bb CharsetMapping/UNMAPPABLE_ENCODING)
                (when (Character/isSurrogate c)
                  (when (< (.parse (.sgp this) c src) 0) (return (.error (.-sgp this))))
                  (return (.unmappableResult (.-sgp this))))
                (return (CoderResult/unmappableForLength 1)))
              (if (> bb Encoder_EBCDIC/MAX_SINGLEBYTE)
                  (do
                    (when (== currentState SBCS)
                      (when (< (.remaining dst) 1) (return CoderResult/OVERFLOW))
                      (set! currentState DBCS)
                      (.put dst SO))
                    (when (< (.remaining dst) 2) (return CoderResult/OVERFLOW))
                    (.put dst (unchecked-byte (bit-shift-right-int bb 8)))
                    (.put dst (unchecked-byte bb)))
                  (do
                    (when (== currentState DBCS)
                      (when (< (.remaining dst) 1) (return CoderResult/OVERFLOW))
                      (set! currentState SBCS)
                      (.put dst SI))
                    (when (< (.remaining dst) 1) (return CoderResult/OVERFLOW))
                    (.put dst (unchecked-byte bb))))
              (set! mark (unchecked-inc-int mark))))
          CoderResult/UNDERFLOW
          (finally (.position src mark)))))

    (method ^:public encodeFromLatin1 ^int [this ^byte/1 src ^:mutable ^int sp ^int len ^byte/1 dst
                                            ^:mutable ^int dp]
      (let [sl (unchecked-add-int sp len)]
        (while (< sp sl)
          (let [c (unchecked-char
                    (bit-and-int (aget src
                                       (let [old-11 sp] (set! sp (unchecked-inc-int sp)) old-11))
                                 0xff))
                bb (.encodeChar this c)]
            (cond
              (== bb CharsetMapping/UNMAPPABLE_ENCODING)
                (do
                  (aset dst dp (aget (.-repl this) 0))
                  (set! dp (unchecked-inc-int dp))
                  (when (> (alength (.-repl this)) 1)
                    (aset dst dp (aget (.-repl this) 1))
                    (set! dp (unchecked-inc-int dp))))
              (> bb Encoder_EBCDIC/MAX_SINGLEBYTE)
                (do
                  (when (== currentState SBCS)
                    (set! currentState DBCS)
                    (aset dst dp SO)
                    (set! dp (unchecked-inc-int dp)))
                  (aset dst dp (unchecked-byte (bit-shift-right-int bb 8)))
                  (set! dp (unchecked-inc-int dp))
                  (aset dst dp (unchecked-byte bb))
                  (set! dp (unchecked-inc-int dp)))
              :else
                (do
                  (when (== currentState DBCS)
                    (set! currentState SBCS)
                    (aset dst dp SI)
                    (set! dp (unchecked-inc-int dp)))
                  (aset dst dp (unchecked-byte bb))
                  (set! dp (unchecked-inc-int dp))))))
        (when (== currentState DBCS)
          (set! currentState SBCS)
          (aset dst dp SI)
          (set! dp (unchecked-inc-int dp)))
        dp))

    (method ^:public encodeFromUTF16 ^int [this ^byte/1 src ^:mutable ^int sp ^int len ^byte/1 dst
                                           ^:mutable ^int dp]
      (let [sl (unchecked-add-int sp len)]
        (while (< sp sl)
          (let [c (StringUTF16/getChar src
                                       (let [old-12 sp] (set! sp (unchecked-inc-int sp)) old-12))
                bb (.encodeChar this c)]
            (cond
              (== bb CharsetMapping/UNMAPPABLE_ENCODING)
                (do
                  (when (and (and (Character/isHighSurrogate c) (< sp sl))
                             (Character/isLowSurrogate (StringUTF16/getChar src sp)))
                    (set! sp (unchecked-inc-int sp)))
                  (aset dst dp (aget (.-repl this) 0))
                  (set! dp (unchecked-inc-int dp))
                  (when (> (alength (.-repl this)) 1)
                    (aset dst dp (aget (.-repl this) 1))
                    (set! dp (unchecked-inc-int dp))))
              (> bb Encoder_EBCDIC/MAX_SINGLEBYTE)
                (do
                  (when (== currentState SBCS)
                    (set! currentState DBCS)
                    (aset dst dp SO)
                    (set! dp (unchecked-inc-int dp)))
                  (aset dst dp (unchecked-byte (bit-shift-right-int bb 8)))
                  (set! dp (unchecked-inc-int dp))
                  (aset dst dp (unchecked-byte bb))
                  (set! dp (unchecked-inc-int dp)))
              :else
                (do
                  (when (== currentState DBCS)
                    (set! currentState SBCS)
                    (aset dst dp SI)
                    (set! dp (unchecked-inc-int dp)))
                  (aset dst dp (unchecked-byte bb))
                  (set! dp (unchecked-inc-int dp))))))
        (when (== currentState DBCS)
          (set! currentState SBCS)
          (aset dst dp SI)
          (set! dp (unchecked-inc-int dp)))
        dp)))

  (defclass ^:public ^:static Encoder_EUC_SIM
    :extends Encoder

    (constructor ^:public [this ^Charset cs ^char/1 c2b ^char/1 c2bIndex ^boolean isASCIICompatible]

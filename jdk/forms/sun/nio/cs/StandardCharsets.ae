        (.put map "iso-8859-1" ISO_8859_1/INSTANCE)
        (.put map "us-ascii" US_ASCII/INSTANCE)
        (.put map "utf-16" java.nio.charset.StandardCharsets/UTF_16)
        (.put map "utf-16be" java.nio.charset.StandardCharsets/UTF_16BE)
        (.put map "utf-16le" java.nio.charset.StandardCharsets/UTF_16LE)
        (.put map "utf-32" java.nio.charset.StandardCharsets/UTF_32)
        (.put map "utf-32be" java.nio.charset.StandardCharsets/UTF_32BE)
        (.put map "utf-32le" java.nio.charset.StandardCharsets/UTF_32LE)
        (set! cache map))
      map))

  (method ^:private ^:static toLower ^String [^String s]
    (let [n (.length s)
          ^:mutable allLower true]
      (loop [^int i 0]
        (when (< i n)
          (let [^int c (.charAt s i)]
            (if (>= (bit-or-int (unchecked-subtract-int c \A) (unchecked-subtract-int \Z c)) 0)
                (set! allLower false)
                (recur (unchecked-inc-int i))))))
      (if allLower
          s
          (let [sb (StringBuilder. n)]
            (loop [^int i 0]
              (when (< i n)
                (let [^int c (.charAt s i)]
                  (if (>= (bit-or-int (unchecked-subtract-int c \A) (unchecked-subtract-int \Z c))
                          0)
                      (do
                        (.append sb (unchecked-char (unchecked-add-int c 0x20)))
                        (recur (unchecked-inc-int i)))
                      (do (.append sb (unchecked-char c)) (recur (unchecked-inc-int i)))))))
            (.toString sb)))))

  (method ^:private lookup ^Charset [this ^String charsetName]
    (let [^:mutable ^String csn nil]
      (cond
        (.equals charsetName "UTF-8") UTF_8/INSTANCE
        (.equals charsetName "US-ASCII") US_ASCII/INSTANCE
        (.equals charsetName "ISO-8859-1") ISO_8859_1/INSTANCE
        :else
          (do
            (set! csn (.canonicalize this (StandardCharsets/toLower charsetName)))
            (let [cs (cast Charset (.get (.cache this) csn))]
              (if (some? cs)
                  cs
                  (let [cln (cast String (.get (.classMap this) csn))]
                    (when (some? cln)
                      (try
                        (let [o (.newInstance (Class/forName
                                                (java-str packagePrefix cln)
                                                true
                                                (.getClassLoader (.getClass this))))]
                          (.cache this csn (cast Charset o)))
                        (catch [ClassNotFoundException
                                IllegalAccessException
                                InstantiationException] x
                          nil))))))))))

  (method ^:private cache ^Charset [this ^String csn ^Charset cs]
    (.put (.cache this) csn cs)
    cs)

  (method ^:public ^:final charsetForName ^Charset [this ^String charsetName]
    (locking this (.lookup this charsetName)))

  (method ^:public ^:final charsets ^{:tag (Iterator Charset)} [this]
    (let [^:mutable ^{:tag (Set String)} charsetNames nil]
      (locking this (set! charsetNames (.keySet (.classMap this))) (.aliasMap this) (.cache this))
      (let [charsetNames charsetNames]
        (anon (Iterator Charset) []
          (field ^{:tag (Iterator String)} i (.iterator charsetNames))

          (method ^:public hasNext ^boolean [this] (.hasNext i))

          (method ^:public next ^Charset [this]
            (let [csn (cast String (.next i))] (.lookup StandardCharsets/this csn)))

          (method ^:public remove ^void [this]
            (throw (UnsupportedOperationException.))))))))

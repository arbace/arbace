(in-ns 'sun.nio.ch)

(import '(java.io IOException)
        '(java.util.concurrent ConcurrentHashMap)
        '(java.util.concurrent.atomic AtomicLong)
        '(jdk.internal.jrt HostChannels))

(defclass EPoll
  (constructor ^:private [this])

  (field ^:private ^:static ^:final ^int INDEX_BITS 20)

  (field ^:private ^:static ^:final ^long INDEX_MASK
    (unchecked-subtract (bit-shift-left 1 INDEX_BITS) 1))

  (field ^:private ^:static ^:final ^{:tag (ConcurrentHashMap Long int/2)} ARRAYS
    (ConcurrentHashMap.))

  (field ^:private ^:static ^:final ^AtomicLong NEXT (AtomicLong.))

  (field ^:static ^:final ^int EPOLL_CTL_ADD 1)

  (field ^:static ^:final ^int EPOLL_CTL_DEL 2)

  (field ^:static ^:final ^int EPOLL_CTL_MOD 3)

  (field ^:static ^:final ^int EPOLLIN 0x1)

  (field ^:static ^:final ^int EPOLLOUT 0x4)

  (field ^:static ^:final ^int EPOLLONESHOT (bit-shift-left-int 1 30))

  (method ^:static allocatePollArray ^long [^int count]
    (when (> count INDEX_MASK) (throw (IllegalArgumentException. "count")))
    (let [token (.incrementAndGet NEXT)]
      (.put ARRAYS token (new int/2 [(new int/1 count) (new int/1 count)]))
      (bit-shift-left token INDEX_BITS)))

  (method ^:static freePollArray ^void [^long address]
    (.remove ARRAYS (unsigned-bit-shift-right address INDEX_BITS)))

  (method ^:static getEvent ^long [^long address ^int i]
    (unchecked-add address i))

  (method ^:static getDescriptor ^int [^long eventAddress]
    (aget (cast int/2 (.get ARRAYS (unsigned-bit-shift-right eventAddress INDEX_BITS)))
          0
          (unchecked-int (bit-and eventAddress INDEX_MASK))))

  (method ^:static getEvents ^int [^long eventAddress]
    (aget (cast int/2 (.get ARRAYS (unsigned-bit-shift-right eventAddress INDEX_BITS)))
          1
          (unchecked-int (bit-and eventAddress INDEX_MASK))))

  (method ^:static create :throws [IOException] ^int []
    (let [err (new int/1 1)
          epfd (HostChannels/epollCreate0 err)]
      (when (== epfd HostChannels/THROWN)
        (throw (HostChannels/ioException (aget err 0) "epoll_create1 failed")))
      epfd))

  (method ^:static ctl ^int [^int epfd ^int opcode ^int fd ^int events]
    (HostChannels/epollCtl0 epfd opcode fd events))

  (method ^:static wait :throws [IOException] ^int [^int epfd ^long pollAddress ^int numfds
                                                    ^int timeout]
    (let [a (cast int/2 (.get ARRAYS (unsigned-bit-shift-right pollAddress INDEX_BITS)))
          err (new int/1 1)
          n (HostChannels/epollWait0 epfd (aget a 0) (aget a 1) numfds timeout err)]
      (when (== n HostChannels/THROWN)
        (throw (HostChannels/ioException (aget err 0) "epoll_wait failed")))
      n)))

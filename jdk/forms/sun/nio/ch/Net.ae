  (field ^:public ^:static ^:final ^short POLLHUP)

  (field ^:public ^:static ^:final ^short POLLNVAL)

  (field ^:public ^:static ^:final ^short POLLCONN)

  (method ^:static pollinValue ^short [] 0x0001)

  (method ^:static polloutValue ^short [] 0x0004)

  (method ^:static pollerrValue ^short [] 0x0008)

  (method ^:static pollhupValue ^short [] 0x0010)

  (method ^:static pollnvalValue ^short [] 0x0020)

  (method ^:static pollconnValue ^short [] 0x0004)

  (static-initializer
    (IOUtil/load)
    (Net/initIDs)
    (set! POLLIN (Net/pollinValue))
    (set! POLLOUT (Net/polloutValue))
    (set! POLLERR (Net/pollerrValue))
    (set! POLLHUP (Net/pollhupValue))
    (set! POLLNVAL (Net/pollnvalValue))
    (set! POLLCONN (Net/pollconnValue)))

  (static-initializer
    (let [availLevel (Net/isExclusiveBindAvailable)]
      (if (>= availLevel 0)
          (let [exclBindProp (System/getProperty "sun.net.useExclusiveBind")]
            (if (some? exclBindProp)
                (set! EXCLUSIVE_BIND
                      (or (.isEmpty exclBindProp) (Boolean/parseBoolean exclBindProp)))
                (set! EXCLUSIVE_BIND (== availLevel 1))))
          (set! EXCLUSIVE_BIND false))
      (set! FAST_LOOPBACK (Net/isFastTcpLoopbackRequested))
      (set! IPV6_AVAILABLE (Net/isIPv6Available0))
      (set! SO_REUSEPORT_AVAILABLE (Net/isReusePortAvailable0))))

  (method ^:private ^:static scope ^int [^InetAddress addr]
    (if-instance [^Inet6Address a6 addr] (.getScopeId a6) 0))

  (method ^:static inetAddress :throws [IOException] ^InetAddress [^byte/1 addr ^int scope]
    (if (and (== (alength addr) 16) (not (== scope 0)))
        (Inet6Address/getByAddress nil addr scope)
        (InetAddress/getByAddress addr)))

  (method ^:private ^:static sockAddress :throws [IOException] ^InetAddress [^FileDescriptor fd
                                                                             ^boolean local]
    (let [err (new int/1 1)
          addr (new byte/2 1)
          port (new int/1 2)]
      (when (== (HostChannels/address0 (IOUtil/fdVal fd) local addr port err) HostChannels/THROWN)
        (throw (HostChannels/socketException (aget err 0) nil)))
      (Net/inetAddress (aget addr 0) (aget port 1))))

  (method ^:private ^:static sockPort :throws [IOException] ^int [^FileDescriptor fd ^boolean local]
    (let [err (new int/1 1)
          addr (new byte/2 1)
          port (new int/1 2)]
      (when (== (HostChannels/address0 (IOUtil/fdVal fd) local addr port err) HostChannels/THROWN)
        (throw (HostChannels/socketException (aget err 0) nil)))
      (aget port 0)))

  (method ^:private ^:static multicast ^IOException []
    (SocketException. "Multicast on channels is not in the Go build (F10b)"))

  (method ^:private ^:static shouldNotReachHere ^AssertionError []
    (AssertionError. "Should not reach here")))

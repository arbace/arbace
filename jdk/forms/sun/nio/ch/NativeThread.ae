(in-ns 'sun.nio.ch)

(defclass ^:public NativeThread
  (field ^:private ^:static ^:final ^long VIRTUAL_THREAD_ID -1)

  (method ^:public ^:static current ^long []
    (let [id (.threadId (Thread/currentThread))] (if (> id 0) id 1)))

  (method ^:public ^:static signal ^void [^long tid]
    (when-not (NativeThread/isNativeThread tid) (throw (IllegalArgumentException.))))

  (method ^:static isNativeThread ^boolean [^long tid]
    (and (not (== tid 0)) (not (== tid VIRTUAL_THREAD_ID))))

  (method ^:static isVirtualThread ^boolean [^long tid]

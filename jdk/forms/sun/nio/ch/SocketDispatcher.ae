(in-ns 'sun.nio.ch)

(import '(java.io FileDescriptor IOException)
        '(jdk.internal.jrt HostChannels)
        '(sun.net ConnectionResetException))

(defclass SocketDispatcher
  :extends UnixDispatcher

  (constructor [this])

  (method read :throws [IOException] ^int [this ^FileDescriptor fd ^byte/1 b ^int off ^int len]
    (let [err (new int/1 1)
          n (HostChannels/read0 (IOUtil/fdVal fd) b off len true err)]
      (when (== n HostChannels/THROWN)
        (when (or (== (aget err 0) HostChannels/ECONNRESET) (== (aget err 0) HostChannels/EPIPE))
          (throw (ConnectionResetException. "Connection reset")))
        (throw (HostChannels/readWriteException (aget err 0) true)))
      n))

  (method write :throws [IOException] ^int [this ^FileDescriptor fd ^byte/1 b ^int off ^int len]
    (let [err (new int/1 1)
          n (HostChannels/write0 (IOUtil/fdVal fd) b off len err)]
      (when (== n HostChannels/THROWN) (throw (HostChannels/readWriteException (aget err 0) false)))
      n)))

      (when-not (.isConnected this) (throw (NotYetConnectedException.)))
      (when-not isInputClosed
        (Net/shutdown fd Net/SHUT_RD)
        (let [reader readerThread]
          (cond
            (NativeThread/isVirtualThread reader) (Poller/stopPoll fdVal Net/POLLIN)
            (NativeThread/isNativeThread reader) (NativeThread/signal reader))
          (set! isInputClosed true)))
      this))

  (method ^:public shutdownOutput :throws [IOException] ^SocketChannel [this]
    (locking stateLock
      (.ensureOpen this)
      (when-not (.isConnected this) (throw (NotYetConnectedException.)))
      (when-not isOutputClosed
        (Net/shutdown fd Net/SHUT_WR)
        (let [writer writerThread]
          (cond
            (NativeThread/isVirtualThread writer) (Poller/stopPoll fdVal Net/POLLOUT)
            (NativeThread/isNativeThread writer) (NativeThread/signal writer))
          (set! isOutputClosed true)))
      this))

  (method isInputOpen ^boolean [this] (not isInputClosed))

  (method isOutputOpen ^boolean [this] (not isOutputClosed))

  (method ^:private finishTimedConnect :throws [IOException] ^boolean [this ^long nanos]
    (let [startNanos (System/nanoTime)
          ^:mutable polled (Net/pollConnectNow fd)]
      (while (and (not polled) (.isOpen this))
        (let [remainingNanos (unchecked-subtract
                               nanos
                               (unchecked-subtract (System/nanoTime) startNanos))]
          (when (<= remainingNanos 0) (throw (SocketTimeoutException. "Connect timed out")))
          (.park this Net/POLLOUT remainingNanos)
          (set! polled (Net/pollConnectNow fd))))
      (and polled (.isOpen this))))

  (method blockingConnect :throws [IOException] ^void [this ^SocketAddress remote ^long nanos]
    (let [sa (.checkRemote this remote)]
      (try
        (.lock readLock)
        (try
          (.lock writeLock)
          (try
            (when-not (.isBlocking this) (throw (IllegalBlockingModeException.)))
            (let [^:mutable connected false]
              (try
                (.beginConnect this true sa)
                (.lockedConfigureBlocking this false)
                (try
                  (let [^int n (if (.isUnixSocket this)
                                   (UnixDomainSockets/connect fd sa)
                                   (Net/connect family fd sa))]
                    (set! connected (if (> n 0) true (.finishTimedConnect this nanos))))
                  (finally (.tryLockedConfigureBlocking this true)))
                (finally (.endConnect this true connected))))
            (finally (.unlock writeLock)))
          (finally (.unlock readLock)))
        (catch IOException ioe (.close this) (throw (Exceptions/ioException ioe sa))))))

  (method ^:private tryRead :throws [IOException] ^int [this ^byte/1 b ^int off ^int len]
    (let [dst (Util/getTemporaryDirectBuffer len)]
      (java-assert (== (.position dst) 0))
      (try
        (let [n (.read nd fd (.address (cast DirectBuffer dst)) len)]
          (when (> n 0) (.get dst b off n))
          n)
        (finally (Util/offerFirstTemporaryDirectBuffer dst)))))

  (method ^:private timedRead :throws [IOException] ^int [this ^byte/1 b ^int off ^int len
                                                          ^long nanos]
    (let [startNanos (System/nanoTime)
          ^:mutable n (.tryRead this b off len)]
      (while (and (== n IOStatus/UNAVAILABLE) (.isOpen this))
        (let [remainingNanos (unchecked-subtract
                               nanos
                               (unchecked-subtract (System/nanoTime) startNanos))]
          (when (<= remainingNanos 0) (throw (SocketTimeoutException. "Read timed out")))
          (.park this Net/POLLIN remainingNanos)
          (set! n (.tryRead this b off len))))
      n))

  (method blockingRead :throws [IOException] ^int [this ^byte/1 b ^int off ^int len ^long nanos]
    (Objects/checkFromIndexSize off len (alength b))
    (if (== len 0)
        0
        (do
          (.lock readLock)
          (try
            (.ensureOpenAndConnected this)
            (when-not (.isBlocking this) (throw (IllegalBlockingModeException.)))
            (let [^:mutable ^int n 0]
              (try
                (.beginRead this true)
                (when connectionReset (.throwConnectionReset this))
                (when isInputClosed (return IOStatus/EOF))
                (if (> nanos 0)
                    (do
                      (.lockedConfigureBlocking this false)
                      (try
                        (set! n (.timedRead this b off len nanos))
                        (finally (.tryLockedConfigureBlocking this true))))
                    (do
                      (.configureSocketNonBlockingIfVirtualThread this)
                      (set! n (.tryRead this b off len))
                      (while (and (IOStatus/okayToRetry n) (.isOpen this))
                        (.park this Net/POLLIN)
                        (set! n (.tryRead this b off len)))))
                (catch ConnectionResetException e
                  (set! connectionReset true)
                  (.throwConnectionReset this))
                (finally
                  (.endRead this true (> n 0))
                  (when (and (<= n 0) isInputClosed) (return IOStatus/EOF))))
              (java-assert (or (> n 0) (== n -1)))
              n)
            (finally (.unlock readLock))))))

  (method ^:private tryWrite :throws [IOException] ^int [this ^byte/1 b ^int off ^int len]
    (let [src (Util/getTemporaryDirectBuffer len)]
      (java-assert (== (.position src) 0))
      (try
        (.put src b off len)
        (.write nd fd (.address (cast DirectBuffer src)) len)
        (finally (Util/offerFirstTemporaryDirectBuffer src)))))

  (method blockingWriteFully :throws [IOException] ^void [this ^byte/1 b ^int off ^int len]
    (Objects/checkFromIndexSize off len (alength b))
    (when-not (== len 0)
      (.lock writeLock)
      (try
        (.ensureOpenAndConnected this)
        (when-not (.isBlocking this) (throw (IllegalBlockingModeException.)))
        (let [^:mutable pos off
              end (unchecked-add-int off len)]
          (try
            (.beginWrite this true)
            (.configureSocketNonBlockingIfVirtualThread this)
            (while (and (< pos end) (.isOpen this))
              (let [size (unchecked-subtract-int end pos)
                    ^:mutable n (.tryWrite this b pos size)]
                (while (and (IOStatus/okayToRetry n) (.isOpen this))
                  (.park this Net/POLLOUT)
                  (set! n (.tryWrite this b pos size)))
                (when (> n 0) (set! pos (unchecked-add-int pos n)))))
            (finally (.endWrite this true (>= pos end)))))
        (finally (.unlock writeLock)))))

  (method available :throws [IOException] ^int [this]
    (locking stateLock (.ensureOpenAndConnected this) (if isInputClosed 0 (Net/available fd))))

  (method ^:public translateReadyOps ^boolean [this ^int ops ^int initialOps ^SelectionKeyImpl ski]
    (let [intOps (.nioInterestOps ski)
          oldOps (.nioReadyOps ski)
          ^:mutable newOps initialOps]
      (cond
        (not (== (bit-and-int ops Net/POLLNVAL) 0)) false
        (not (== (bit-and-int ops (bit-or-int Net/POLLERR Net/POLLHUP)) 0))
          (do
            (set! newOps intOps)
            (.nioReadyOps ski newOps)
            (not (== (bit-and-int newOps (bit-not-int oldOps)) 0)))
        :else
          (let [connected (.isConnected this)]
            (when (and (and (not (== (bit-and-int ops Net/POLLIN) 0))
                            (not (== (bit-and-int intOps SelectionKey/OP_READ) 0)))
                       connected)
              (set! newOps (bit-or-int newOps SelectionKey/OP_READ)))
            (when (and (and (not (== (bit-and-int ops Net/POLLCONN) 0))
                            (not (== (bit-and-int intOps SelectionKey/OP_CONNECT) 0)))
                       (.isConnectionPending this))
              (set! newOps (bit-or-int newOps SelectionKey/OP_CONNECT)))
            (when (and (and (not (== (bit-and-int ops Net/POLLOUT) 0))
                            (not (== (bit-and-int intOps SelectionKey/OP_WRITE) 0)))
                       connected)
              (set! newOps (bit-or-int newOps SelectionKey/OP_WRITE)))
            (.nioReadyOps ski newOps)
            (not (== (bit-and-int newOps (bit-not-int oldOps)) 0))))))

  (method ^:public translateAndUpdateReadyOps ^boolean [this ^int ops ^SelectionKeyImpl ski]
    (.translateReadyOps this ops (.nioReadyOps ski) ski))

  (method ^:public translateAndSetReadyOps ^boolean [this ^int ops ^SelectionKeyImpl ski]
    (.translateReadyOps this ops 0 ski))

  (method ^:public translateInterestOps ^int [this ^int ops]
    (let [^:mutable ^int newOps 0]
      (when-not (== (bit-and-int ops SelectionKey/OP_READ) 0)
        (set! newOps (bit-or-int newOps Net/POLLIN)))
      (when-not (== (bit-and-int ops SelectionKey/OP_WRITE) 0)
        (set! newOps (bit-or-int newOps Net/POLLOUT)))
      (when-not (== (bit-and-int ops SelectionKey/OP_CONNECT) 0)
        (set! newOps (bit-or-int newOps Net/POLLCONN)))
      newOps))

  (method ^:public getFD ^FileDescriptor [this] fd)

  (method ^:public getFDVal ^int [this] fdVal)

  (method ^:public toString ^String [this]
    (let [sb (StringBuilder.)]
      (.append sb (.getName (.getSuperclass (.getClass this))))
      (.append sb \[)
      (if (not (.isOpen this))
          (.append sb "closed")
          (locking stateLock
            (switch state
              ST_UNCONNECTED (.append sb "unconnected")
              ST_CONNECTIONPENDING (.append sb "connection-pending")
              ST_CONNECTED
                (do
                  (.append sb "connected")
                  (when isInputClosed (.append sb " ishut"))
                  (when isOutputClosed (.append sb " oshut"))))
            (let [addr (.localAddress this)]
              (when (some? addr) (.append sb " local=") (.append sb addr))
              (when (some? (.remoteAddress this))
                (.append sb " remote=")
                (.append sb (.remoteAddress this))))))
      (.append sb \])
      (.toString sb))))

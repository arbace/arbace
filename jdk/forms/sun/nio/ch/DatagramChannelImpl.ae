    (when (.isVirtual (Thread/currentThread)) (.configureSocketNonBlocking this)))

  (method localAddress ^InetSocketAddress [this]
    (locking stateLock localAddress))

  (method remoteAddress ^InetSocketAddress [this]
    (locking stateLock remoteAddress))

  (method ^:public bind :throws [IOException] ^DatagramChannel [this ^SocketAddress local]
    (.lock readLock)
    (try
      (.lock writeLock)
      (try
        (locking stateLock
          (.ensureOpen this)
          (when (some? localAddress) (throw (AlreadyBoundException.)))
          (.bindInternal this local))
        (finally (.unlock writeLock)))
      (finally (.unlock readLock)))
    this)

  (method ^:private bindInternal :throws [IOException] ^void [this ^SocketAddress local]
    (java-assert (and (Thread/holdsLock stateLock) (nil? localAddress)))
    (let [^:mutable ^InetSocketAddress isa nil]
      (if (nil? local)
          (if (identical? family StandardProtocolFamily/INET)
              (set! isa (InetSocketAddress. (InetAddress/getByName "0.0.0.0") 0))
              (set! isa (InetSocketAddress. 0)))
          (set! isa (Net/checkAddress local family)))
      (Net/bind family fd (.getAddress isa) (.getPort isa))
      (set! localAddress (Net/localAddress fd))))

  (method ^:public isConnected ^boolean [this]
    (locking stateLock (== state ST_CONNECTED)))

  (method ^:public connect :throws [IOException] ^DatagramChannel [this ^SocketAddress sa]
    (.connect this sa true))

  (method connect :throws [IOException] ^DatagramChannel [this ^SocketAddress sa ^boolean check]
    (let [isa (Net/checkAddress sa family)]
      (.lock readLock)
      (try
        (.lock writeLock)
        (try
          (locking stateLock
            (.ensureOpen this)
            (when (and check (== state ST_CONNECTED)) (throw (AlreadyConnectedException.)))
            (when (== (.getPort isa) 0) (throw (SocketException. "Can't connect to port 0")))
            (when (nil? localAddress) (.bindInternal this nil))
            (set! initialLocalAddress localAddress)
            (let [n (Net/connect family fd (.getAddress isa) (.getPort isa))]
              (when (<= n 0) (throw (Error.)))
              (set! remoteAddress isa)
              (set! state ST_CONNECTED)
              (set! localAddress (Net/localAddress fd))
              (let [blocking (.isBlocking this)]
                (when blocking (.lockedConfigureBlocking this false))
                (try
                  (let [buf (ByteBuffer/allocate 100)]
                    (while (>= (.receive this buf false) 0) (.clear buf)))
                  (finally (when blocking (.tryLockedConfigureBlocking this true)))))))
          (finally (.unlock writeLock)))
        (finally (.unlock readLock)))
      this))

  (method ^:public disconnect :throws [IOException] ^DatagramChannel [this]
    (.lock readLock)
    (try
      (.lock writeLock)
      (try
        (locking stateLock
          (when (or (not (.isOpen this)) (not (== state ST_CONNECTED))) (return this))
          (let [isIPv6 (identical? family StandardProtocolFamily/INET6)]
            (DatagramChannelImpl/disconnect0 fd isIPv6)
            (set! remoteAddress nil)
            (set! state ST_UNCONNECTED)
            (set! localAddress (Net/localAddress fd))
            (try
              (when-not (.equals localAddress initialLocalAddress)
                (.repairSocket this initialLocalAddress)
                (java-assert (and (and (some? localAddress)
                                       (.equals localAddress (Net/localAddress fd)))
                                  (.equals localAddress initialLocalAddress))))
              (finally (set! initialLocalAddress nil)))))
        (finally (.unlock writeLock)))
      (finally (.unlock readLock)))
    this)

  (method ^:private repairSocket :throws [IOException] ^void [this ^InetSocketAddress target]
    (java-assert (Thread/holdsLock stateLock))
    (if (== (.getPort localAddress) 0)
        (do
          (java-assert (.equals (.getAddress localAddress) (.getAddress target)))
          (Net/bind family fd (.getAddress target) (.getPort target))
          (set! localAddress (Net/localAddress fd)))
        (let [^{:tag (Map (SocketOption ?) Object)} map (HashMap.)]
          (for-each [^{:tag (SocketOption ?)} option (.supportedOptions this)]
            (let [value (.getOption this option)] (when (some? value) (.put map option value))))
          (let [newfd (Net/socket family false)]
            (try
              (for-each [^{:tag (Map$Entry (SocketOption ?) Object)} e (.entrySet map)]
                (let [^{:tag (SocketOption ?)} option (cast SocketOption (.getKey e))]
                  (when (some? (SocketOptionRegistry/findOption option Net/UNSPEC))
                    (let [value (.getValue e)]
                      (try
                        (Net/setSocketOption newfd Net/UNSPEC option value)
                        (catch IOException ignore))))))
              (when (or (not (.isBlocking this)) forcedNonBlocking)
                (IOUtil/configureBlocking newfd false))
              (.dup nd newfd fd)
              (finally (.close nd newfd)))
            (try
              (Net/bind family fd (.getAddress target) (.getPort target))
              (catch IOException ioe (set! localAddress nil) (throw ioe)))
            (set! localAddress (Net/localAddress fd))
            (for-each [^{:tag (Map$Entry (SocketOption ?) Object)} e (.entrySet map)]
              (let [^{:tag (SocketOption Object)} option (cast SocketOption (.getKey e))
                    value (.getValue e)]
                (try (.setOption this option value) (catch IOException ignore))))
            (let [registry (.-registry this)]
              (when (some? registry)
                (.forEach registry
                          (lambda MembershipRegistry$ThrowingConsumer ^void [^MembershipKeyImpl k]
                            (if (instance? MembershipKeyImpl$Type6 k)
                                (let [key6 (cast MembershipKeyImpl$Type6 k)]
                                  (Net/join6 fd (.groupAddress key6) (.index key6) (.source key6)))
                                (let [key4 (cast MembershipKeyImpl$Type4 k)]
                                  (Net/join4 fd
                                             (.groupAddress key4)
                                             (.interfaceAddress key4)
                                             (.source key4)))))))
              (AbstractSelectableChannels/forEach
                this
                (method-ref Consumer [SelectionKeyImpl] SelectionKeyImpl/.reset)))))))

  (defclass ^:private ^:static AbstractSelectableChannels
    (field ^:private ^:static ^:final ^Method FOREACH)

    (static-initializer
      (try
        (let [m (.getDeclaredMethod AbstractSelectableChannel "forEach" Consumer)]
          (.setAccessible m true)
          (set! FOREACH m))
        (catch Exception e (throw (InternalError. e)))))

    (method ^:static forEach ^void [^AbstractSelectableChannel ch
                                    ^{:tag (Consumer SelectionKeyImpl)} action]
      (try (.invoke FOREACH ch action) (catch Exception e (throw (InternalError. e))))))

  (method ^:private innerJoin :throws [IOException] ^MembershipKey [this ^InetAddress group
                                                                    ^NetworkInterface interf
                                                                    ^InetAddress source]
    (when-not (.isMulticastAddress group)
      (throw (IllegalArgumentException. "Group not a multicast address")))
    (cond
      (instance? Inet4Address group)
        (when (and (identical? family StandardProtocolFamily/INET6)
                   (not (Net/canIPv6SocketJoinIPv4Group)))
          (throw (IllegalArgumentException. "IPv6 socket cannot join IPv4 multicast group")))
      (instance? Inet6Address group)
        (when-not (identical? family StandardProtocolFamily/INET6)
          (throw (IllegalArgumentException. "Only IPv6 sockets can join IPv6 multicast group")))
      :else (throw (IllegalArgumentException. "Address type not supported")))
    (when (some? source)
      (when (.isAnyLocalAddress source)
        (throw (IllegalArgumentException. "Source address is a wildcard address")))
      (when (.isMulticastAddress source)
        (throw (IllegalArgumentException. "Source address is multicast address")))
      (when-not (identical? (.getClass source) (.getClass group))
        (throw (IllegalArgumentException. "Source address is different type to group"))))
    (locking stateLock
      (.ensureOpen this)
      (if (nil? registry)
          (set! registry (MembershipRegistry.))
          (let [key (.checkMembership registry group interf source)]
            (when (some? key) (return key))))
      (let [^:mutable ^MembershipKeyImpl key nil]
        (if (and (identical? family StandardProtocolFamily/INET6)
                 (or (instance? Inet6Address group) (Net/canJoin6WithIPv4Group)))
            (let [index (.getIndex interf)]
              (when (== index -1) (throw (IOException. "Network interface cannot be identified")))
              (let [groupAddress (Net/inet6AsByteArray group)
                    ^byte/1 sourceAddress (when (some? source) (Net/inet6AsByteArray source))
                    n (Net/join6 fd groupAddress index sourceAddress)]
                (when (== n IOStatus/UNAVAILABLE) (throw (UnsupportedOperationException.)))
                (set! key
                      (MembershipKeyImpl$Type6. this
                                                group
                                                interf
                                                source
                                                groupAddress
                                                index
                                                sourceAddress))))
            (let [target (Net/anyInet4Address interf)]
              (when (nil? target)
                (throw (IOException. "Network interface not configured for IPv4")))
              (let [groupAddress (Net/inet4AsInt group)
                    targetAddress (Net/inet4AsInt target)
                    ^int sourceAddress (if (nil? source) 0 (Net/inet4AsInt source))
                    n (Net/join4 fd groupAddress targetAddress sourceAddress)]
                (when (== n IOStatus/UNAVAILABLE) (throw (UnsupportedOperationException.)))
                (set! key
                      (MembershipKeyImpl$Type4. this
                                                group
                                                interf
                                                source
                                                groupAddress
                                                targetAddress
                                                sourceAddress)))))
        (.add registry key)
        key)))

  (method ^:public join :throws [IOException] ^MembershipKey [this ^InetAddress group
                                                              ^NetworkInterface interf]
    (.innerJoin this group interf nil))

  (method ^:public join :throws [IOException] ^MembershipKey [this ^InetAddress group
                                                              ^NetworkInterface interf
                                                              ^InetAddress source]
    (Objects/requireNonNull source)
    (.innerJoin this group interf source))

  (method drop ^void [this ^MembershipKeyImpl key]
    (java-assert (identical? (.channel key) this))
    (locking stateLock
      (when-not (not (.isValid key))
        (try
          (if (instance? MembershipKeyImpl$Type6 key)
              (let [key6 (cast MembershipKeyImpl$Type6 key)]
                (Net/drop6 fd (.groupAddress key6) (.index key6) (.source key6)))
              (let [key4 (cast MembershipKeyImpl$Type4 key)]
                (Net/drop4 fd (.groupAddress key4) (.interfaceAddress key4) (.source key4))))
          (catch IOException ioe (throw (AssertionError. ioe))))
        (.invalidate key)
        (.remove registry key))))

  (method findMembership ^MembershipKey [this ^InetAddress group ^NetworkInterface interf]
    (locking stateLock (when (some? registry) (.checkMembership registry group interf nil))))

  (method block :throws [IOException] ^void [this ^MembershipKeyImpl key ^InetAddress source]
    (java-assert (identical? (.channel key) this))
    (java-assert (nil? (.sourceAddress key)))
    (locking stateLock
      (when-not (.isValid key) (throw (IllegalStateException. "key is no longer valid")))
      (when (.isAnyLocalAddress source)
        (throw (IllegalArgumentException. "Source address is a wildcard address")))
      (when (.isMulticastAddress source)
        (throw (IllegalArgumentException. "Source address is multicast address")))
      (when-not (identical? (.getClass source) (.getClass (.group key)))
        (throw (IllegalArgumentException. "Source address is different type to group")))
      (let [^:mutable ^int n 0]
        (if (instance? MembershipKeyImpl$Type6 key)
            (let [key6 (cast MembershipKeyImpl$Type6 key)]
              (set!
                n
                (Net/block6 fd (.groupAddress key6) (.index key6) (Net/inet6AsByteArray source))))
            (let [key4 (cast MembershipKeyImpl$Type4 key)]
              (set! n
                    (Net/block4 fd
                                (.groupAddress key4)
                                (.interfaceAddress key4)
                                (Net/inet4AsInt source)))))
        (when (== n IOStatus/UNAVAILABLE) (throw (UnsupportedOperationException.))))))

  (method unblock ^void [this ^MembershipKeyImpl key ^InetAddress source]
    (java-assert (identical? (.channel key) this))
    (java-assert (nil? (.sourceAddress key)))
    (locking stateLock
      (when-not (.isValid key) (throw (IllegalStateException. "key is no longer valid")))
      (try
        (if (instance? MembershipKeyImpl$Type6 key)
            (let [key6 (cast MembershipKeyImpl$Type6 key)]
              (Net/unblock6 fd (.groupAddress key6) (.index key6) (Net/inet6AsByteArray source)))
            (let [key4 (cast MembershipKeyImpl$Type4 key)]
              (Net/unblock4 fd
                            (.groupAddress key4)
                            (.interfaceAddress key4)
                            (Net/inet4AsInt source))))
        (catch IOException ioe (throw (AssertionError. ioe))))))

  (method ^:private tryClose :throws [IOException] ^boolean [this]
    (java-assert (and (Thread/holdsLock stateLock) (== state ST_CLOSING)))
    (if (and (and (== readerThread 0) (== writerThread 0)) (not (.isRegistered this)))
        (do
          (set! state ST_CLOSED)
          (try (.clean cleaner) (catch UncheckedIOException ioe (throw (.getCause ioe))))
          true)
        false))

  (method ^:private tryFinishClose ^void [this]
    (try (.tryClose this) (catch IOException ignore)))

  (method ^:private implCloseBlockingMode :throws [IOException] ^void [this]
    (locking stateLock
      (java-assert (< state ST_CLOSING))
      (set! state ST_CLOSING)
      (when (some? registry) (.invalidateAll registry))
      (when-not (.tryClose this) (.preClose nd fd readerThread writerThread))))

  (method ^:private implCloseNonBlockingMode :throws [IOException] ^void [this]
    (locking stateLock
      (java-assert (< state ST_CLOSING))
      (set! state ST_CLOSING)
      (when (some? registry) (.invalidateAll registry)))
    (.lock readLock)
    (.unlock readLock)
    (.lock writeLock)
    (.unlock writeLock)
    (locking stateLock (when (== state ST_CLOSING) (.tryClose this))))


    (java-assert (not (.isOpen this)))
    (if (.isBlocking this) (.implCloseBlockingMode this) (.implCloseNonBlockingMode this)))

  (method ^:public kill ^void [this]
    (.lock readLock)
    (.unlock readLock)
    (.lock writeLock)
    (.unlock writeLock)

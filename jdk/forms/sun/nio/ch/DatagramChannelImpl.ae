          (.configureSocketNonBlockingIfVirtualThread this)
          (set! n (IOUtil/write fd srcs offset length nd))
          (when blocking
            (while (and (IOStatus/okayToRetry n) (.isOpen this))
              (.park this Net/POLLOUT)
              (set! n (IOUtil/write fd srcs offset length nd))))
          (finally (.endWrite this blocking (> n 0)) (java-assert (IOStatus/check n))))
        (IOStatus/normalize n))
      (finally (.unlock writeLock))))

  (method ^:protected implConfigureBlocking :throws [IOException] ^void [this ^boolean block]
    (.lock readLock)

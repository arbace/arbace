  (method ^:private tryLockedConfigureBlocking :throws [IOException] ^boolean [this ^boolean block]
    (java-assert (or (.isHeldByCurrentThread readLock) (.isHeldByCurrentThread writeLock)))
    (locking stateLock
      (if (and (not forcedNonBlocking) (.isOpen this))
          (do (IOUtil/configureBlocking fd block) true)
          false)))

  (method ^:private configureSocketNonBlocking :throws [IOException] ^void [this]
    (java-assert (or (.isHeldByCurrentThread readLock) (.isHeldByCurrentThread writeLock)))
    (when-not forcedNonBlocking

                          (set! parentIsDotDot true))
                        (set! parentIsDotDot false))
                    (set! result (.resolve result element))
                    (recur (unchecked-inc-int i)))))))
        (try
          (UnixFileAttributes/get result false)
          (catch UnixException x (.rethrowAsIOException x result)))
        (if (not (.isCaseInsensitiveAndPreserving fs))
            result
            (let [^:mutable path (.rootDirectory fs)]
              (loop [^int i 0]
                (when (< i (.getNameCount result))
                  (let [element (.getName result i)]
                    (if (.equals (.toString element) "..")
                        (do (set! path (.resolve path element)) (recur (unchecked-inc-int i)))
                        (let [elementPath (.resolve path element)
                              ^:mutable ^UnixFileAttributes attrs nil]
                          (try
                            (set! attrs (UnixFileAttributes/get elementPath false))
                            (catch UnixException x (.rethrowAsIOException x result)))
                          (let [^:final elementKey (.fileKey attrs)
                                ^:mutable dp -1]
                            (try
                              (set! dp (UnixNativeDispatcher/opendir path))
                              (catch UnixException x (.rethrowAsIOException x path)))
                            (let [^:mutable found false
                                  ^{:tag (DirectoryStream$Filter Path)} filter
                                    (lambda DirectoryStream$Filter ^boolean [^Path p] true)]
                              (with-resources [^:final ^{:tag (DirectoryStream Path)} entries
                                                 (UnixDirectoryStream. path dp filter)]
                                (for-each [^Path entry entries]
                                  (let [name (.getFileName entry)]
                                    (when (== (.compareTo name element) 0)
                                      (set! found true)
                                      (set! path (.resolve path entry))
                                      (break)))))
                              (if (not found)
                                  (do
                                    (try
                                      (set! dp (UnixNativeDispatcher/opendir path))
                                      (catch UnixException x (.rethrowAsIOException x path)))
                                    (with-resources [^:final ^{:tag (DirectoryStream Path)} entries
                                                       (UnixDirectoryStream. path dp filter)]
                                      (for-each [^Path entry entries]
                                        (let [name (.getFileName entry)
                                              p (.resolve path name)
                                              ^:mutable ^UnixFileAttributes attributes nil]
                                          (try
                                            (set! attributes (UnixFileAttributes/get p false))
                                            (let [key (.fileKey attributes)]
                                              (when (.equals key elementKey)
                                                (set! found true)
                                                (set! path (.resolve path entry))
                                                (break)))
                                            (catch UnixException ignore)))))
                                    (if (not found)
                                        (do
                                          (set! path (.resolve path element))
                                          (recur (unchecked-inc-int i)))
                                        (recur (unchecked-inc-int i))))
                                  (recur (unchecked-inc-int i))))))))))
              path)))))

  (method ^:public toUri ^URI [this] (UnixUriUtils/toUri this))

  (method ^:public register :throws [IOException] ^WatchKey [this ^WatchService watcher
                                                             ^{:tag (array (WatchEvent$Kind ?))} events
                                                             & ^WatchEvent$Modifier/1 modifiers]
    (when (nil? watcher) (throw (NullPointerException.)))
    (when-not (instance? AbstractWatchService watcher) (throw (ProviderMismatchException.)))
    (.register (cast AbstractWatchService watcher) this events modifiers)))

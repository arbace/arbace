        (.readAttributes super file type options)))

  (method getFileTypeDetector ^FileTypeDetector [this]
    (let [userHome (StaticProperty/userHome)
          userMimeTypes (Path/of userHome (new String/1 [".mime.types"]))
          etcMimeTypes (Path/of "/etc/mime.types" (new String/1 []))]
      (.chain this
              (MimeTypesFileTypeDetector. userMimeTypes)
              (MimeTypesFileTypeDetector. etcMimeTypes)))))

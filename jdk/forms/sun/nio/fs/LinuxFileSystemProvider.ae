                                  DosFileAttributes
                                  FileAttributeView
                                  UserDefinedFileAttributeView)
        '(java.nio.file.spi FileTypeDetector)
        '(jdk.internal.util StaticProperty))

(defclass LinuxFileSystemProvider
  :extends UnixFileSystemProvider

  (constructor ^:public [this] (super.))

  (method newFileSystem ^LinuxFileSystem [this ^String dir]
    (LinuxFileSystem. this dir))

  (method getFileStore :throws [IOException] ^LinuxFileStore [this ^UnixPath path]
    (LinuxFileStore. path))

  (method ^:public getFileAttributeView :type-params [(V extends FileAttributeView)] ^V [this
                                                                                         ^Path obj
                                                                                         ^{:tag (Class V)} type
                                                                                         &
                                                                                         ^LinkOption/1 options]
    (cond
      (identical? type DosFileAttributeView)
        ^FileAttributeView (LinuxDosFileAttributeView.
                             (UnixPath/toUnixPath obj)
                             (Util/followLinks options))
      (identical? type UserDefinedFileAttributeView)
        ^FileAttributeView (LinuxUserDefinedFileAttributeView.
                             (UnixPath/toUnixPath obj)
                             (Util/followLinks options))
      :else (.getFileAttributeView super obj type options)))

  (method ^:public getFileAttributeView ^DynamicFileAttributeView [this ^Path obj ^String name &
                                                                   ^LinkOption/1 options]
    (cond
      (.equals name "dos")
        (LinuxDosFileAttributeView. (UnixPath/toUnixPath obj) (Util/followLinks options))
      (.equals name "user")
        (LinuxUserDefinedFileAttributeView. (UnixPath/toUnixPath obj) (Util/followLinks options))
      :else (.getFileAttributeView super obj name options)))

  (method ^:public readAttributes :type-params [(A extends BasicFileAttributes)] :throws [IOException] ^A [this
                                                                                                           ^Path file
                                                                                                           ^{:tag (Class A)} type
                                                                                                           &
                                                                                                           ^LinkOption/1 options]

(in-ns 'sun.invoke.util)

(import '(java.lang.invoke MethodHandles$Lookup MethodType)
        '(java.lang.reflect Modifier))

(defclass ^:public VerifyAccess
  (constructor ^:private [this])

  (field ^:private ^:static ^:final ^int UNCONDITIONAL_ALLOWED MethodHandles$Lookup/UNCONDITIONAL)

  (field ^:private ^:static ^:final ^int ORIGINAL_ALLOWED MethodHandles$Lookup/ORIGINAL)

  (field ^:private ^:static ^:final ^int MODULE_ALLOWED MethodHandles$Lookup/MODULE)

  (field ^:private ^:static ^:final ^int PACKAGE_ONLY 0)

  (field ^:private ^:static ^:final ^int PACKAGE_ALLOWED MethodHandles$Lookup/PACKAGE)

  (field ^:private ^:static ^:final ^int PROTECTED_OR_PACKAGE_ALLOWED
    (bit-or-int PACKAGE_ALLOWED Modifier/PROTECTED))

  (field ^:private ^:static ^:final ^int ALL_ACCESS_MODES
    (bit-or-int (bit-or-int (bit-or-int Modifier/PUBLIC Modifier/PRIVATE) Modifier/PROTECTED)
                PACKAGE_ONLY))

  (method ^:public ^:static isMemberAccessible ^boolean [^{:tag (Class ?)} refc
                                                         ^{:tag (Class ?)} defc ^int mods
                                                         ^{:tag (Class ?)} lookupClass
                                                         ^{:tag (Class ?)} prevLookupClass
                                                         ^int allowedModes]
    (if (== allowedModes 0)
        false
        (do
          (java-assert (== (bit-and-int allowedModes
                                        (bit-not-int
                                          (bit-or-int
                                            (bit-or-int
                                              (bit-or-int
                                                (bit-or-int ALL_ACCESS_MODES PACKAGE_ALLOWED)
                                                MODULE_ALLOWED)
                                              UNCONDITIONAL_ALLOWED)
                                            ORIGINAL_ALLOWED)))
                           0))
          (cond
            (not (VerifyAccess/isClassAccessible refc lookupClass prevLookupClass allowedModes))
              false
            (and (identical? defc lookupClass)
                 (not (== (bit-and-int allowedModes Modifier/PRIVATE) 0)))
              true
            :else
              (switch (bit-and-int mods ALL_ACCESS_MODES)
                Modifier/PUBLIC
                  (do
                    (java-assert (or (not (== (bit-and-int allowedModes Modifier/PUBLIC) 0))
                                     (not (== (bit-and-int allowedModes UNCONDITIONAL_ALLOWED) 0))))
                    true)
                Modifier/PROTECTED
                  (do
                    (java-assert (not (.isInterface defc)))
                    (cond
                      (and (not (== (bit-and-int allowedModes PROTECTED_OR_PACKAGE_ALLOWED) 0))
                           (VerifyAccess/isSamePackage defc lookupClass))
                        true
                      (== (bit-and-int allowedModes Modifier/PROTECTED) 0) false
                      (and (not (== (bit-and-int mods Modifier/STATIC) 0))
                           (not (VerifyAccess/isRelatedClass refc lookupClass)))
                        false
                      (and (not (== (bit-and-int allowedModes Modifier/PROTECTED) 0))
                           (VerifyAccess/isSubClass lookupClass defc))
                        true
                      :else false))
                PACKAGE_ONLY
                  (do
                    (java-assert (not (.isInterface defc)))
                    (and (not (== (bit-and-int allowedModes PACKAGE_ALLOWED) 0))
                         (VerifyAccess/isSamePackage defc lookupClass)))
                Modifier/PRIVATE
                  (let [canAccess (and (not (== (bit-and-int allowedModes Modifier/PRIVATE) 0))
                                       (identical? (.getNestHost defc) (.getNestHost lookupClass)))]
                    (java-assert (or (and canAccess (identical? refc defc)) (not canAccess)))
                    canAccess)
                (throw (IllegalArgumentException.
                         (java-str "bad modifiers: " (Modifier/toString mods)))))))))

  (method ^:static isRelatedClass ^boolean [^{:tag (Class ?)} refc ^{:tag (Class ?)} lookupClass]
    (or (or (identical? refc lookupClass) (VerifyAccess/isSubClass refc lookupClass))
        (VerifyAccess/isSubClass lookupClass refc)))

  (method ^:static isSubClass ^boolean [^{:tag (Class ?)} lookupClass ^{:tag (Class ?)} defc]
    (and (.isAssignableFrom defc lookupClass) (not (.isInterface lookupClass))))

  (method ^:static getClassModifiers ^int [^{:tag (Class ?)} c]
    (if (or (.isArray c) (.isPrimitive c))
        (.getModifiers c)
        (let [mods (.getModifiers c)]
          (if (not (== (bit-and-int mods (bit-or-int Modifier/PUBLIC Modifier/PROTECTED)) 0))
              (bit-or-int (bit-and-int mods
                                       (bit-not-int
                                         (bit-or-int
                                           (bit-or-int Modifier/PROTECTED Modifier/PRIVATE)
                                           Modifier/STATIC)))
                          Modifier/PUBLIC)
              (bit-and-int mods (bit-not-int (bit-or-int Modifier/PRIVATE Modifier/STATIC)))))))

  (method ^:public ^:static isClassAccessible ^boolean [^{:tag (Class ?)} refc
                                                        ^{:tag (Class ?)} lookupClass
                                                        ^{:tag (Class ?)} prevLookupClass
                                                        ^int allowedModes]
    (if (== allowedModes 0)
        false
        (do
          (java-assert (== (bit-and-int allowedModes
                                        (bit-not-int
                                          (bit-or-int
                                            (bit-or-int
                                              (bit-or-int
                                                (bit-or-int ALL_ACCESS_MODES PACKAGE_ALLOWED)
                                                MODULE_ALLOWED)
                                              UNCONDITIONAL_ALLOWED)
                                            ORIGINAL_ALLOWED)))
                           0))
          (if (and (not (== (bit-and-int allowedModes PACKAGE_ALLOWED) 0))
                   (VerifyAccess/isSamePackage lookupClass refc))
              true
              (let [mods (VerifyAccess/getClassModifiers refc)]
                (if (Modifier/isPublic mods) true false))))))

  (method ^:public ^:static isModuleAccessible ^boolean [^{:tag (Class ?)} refc ^Module m1
                                                         ^Module m2]
    (Modifier/isPublic (VerifyAccess/getClassModifiers refc)))

  (method ^:public ^:static ensureTypeVisible ^boolean [^:mutable ^{:tag (Class ?)} type
                                                        ^{:tag (Class ?)} refc]
    (if (identical? type refc)
        true
        (do
          (while (.isArray type) (set! type (.getComponentType type)))
          (if (or (.isPrimitive type) (identical? type Object))
              true
              (let [typeLoader (.getClassLoader type)
                    refcLoader (.getClassLoader refc)]
                (cond
                  (identical? typeLoader refcLoader) true
                  (and (nil? refcLoader) (some? typeLoader)) false
                  :else
                    (let [name (.getName type)
                          ^:mutable ^{:tag (Class ?)} res nil]
                      (try
                        (set! res (Class/forName name false refcLoader))
                        (catch [ClassNotFoundException LinkageError] e))
                      (identical? type res))))))))

  (method ^:public ^:static ensureTypeVisible ^boolean [^MethodType type ^{:tag (Class ?)} refc]
    (if (not (VerifyAccess/ensureTypeVisible (.returnType type) refc))
        false
        (do
          (loop [^int n 0
                 ^int max (.parameterCount type)]
            (if (< n max)
                (if (not (VerifyAccess/ensureTypeVisible (.parameterType type n) refc))
                    (return false)
                    (recur (unchecked-inc-int n) max))
                nil))
          true)))

  (method ^:public ^:static isSameModule ^boolean [^{:tag (Class ?)} class1 ^{:tag (Class ?)} class2]
    (identical? (.getModule class1) (.getModule class2)))

  (method ^:public ^:static isSamePackage ^boolean [^{:tag (Class ?)} class1
                                                    ^{:tag (Class ?)} class2]
    (cond
      (identical? class1 class2) true
      (not (identical? (.getClassLoader class1) (.getClassLoader class2))) false
      :else (.equals (.getPackageName class1) (.getPackageName class2))))

  (method ^:public ^:static isSamePackageMember ^boolean [^{:tag (Class ?)} class1
                                                          ^{:tag (Class ?)} class2]
    (cond
      (identical? class1 class2) true
      (not (VerifyAccess/isSamePackage class1 class2)) false
      (not (identical? (VerifyAccess/getOutermostEnclosingClass class1)
                       (VerifyAccess/getOutermostEnclosingClass class2)))
        false
      :else true))

  (method ^:private ^:static getOutermostEnclosingClass ^{:tag (Class ?)} [^{:tag (Class ?)} c]
    (let [^:mutable ^{:tag (Class ?)} pkgmem c]
      (let [^:mutable ^{:tag (Class ?)} enc c]
        (while (some? (set! enc (.getEnclosingClass enc))) (set! pkgmem enc)))
      pkgmem))

  (method ^:private ^:static loadersAreRelated ^boolean [^ClassLoader loader1 ^ClassLoader loader2
                                                         ^boolean loader1MustBeParent]
    (if (or (or (identical? loader1 loader2) (nil? loader1))
            (and (nil? loader2) (not loader1MustBeParent)))
        true
        (do
          (loop [scan2 loader2]
            (if (some? scan2)
                (if (identical? scan2 loader1) (return true) (recur (.getParent scan2)))
                nil))
          (if loader1MustBeParent
              false
              (do
                (loop [scan1 loader1]
                  (if (some? scan1)
                      (if (identical? scan1 loader2) (return true) (recur (.getParent scan1)))
                      nil))
                false)))))

  (method ^:public ^:static classLoaderIsAncestor ^boolean [^{:tag (Class ?)} parentClass
                                                            ^{:tag (Class ?)} childClass]
    (VerifyAccess/loadersAreRelated (.getClassLoader parentClass) (.getClassLoader childClass) true)))

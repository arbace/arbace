        \D (return (Double/valueOf (.doubleValue xn)))
        \S (return (Short/valueOf (unchecked-short (.intValue xn))))
        \B (return (Byte/valueOf (unchecked-byte (.intValue xn))))
        \C (return (Character/valueOf (unchecked-char (.intValue xn))))

          (identical? type Boolean/TYPE) "Z"
          (identical? type Byte/TYPE) "B"
          (identical? type Character/TYPE) "C"
          (identical? type Short/TYPE) "S"
          (identical? type Long/TYPE) "J"
          (identical? type Float/TYPE) "F"

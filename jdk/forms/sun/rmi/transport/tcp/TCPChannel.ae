    (method ^:public run ^void [this]
      (let [^:mutable ^Connection conn nil]
        (locking queue
          (while (== (.size queue) 0) (try (.wait queue) (catch InterruptedException e)))
          (.startNewAcceptor this)
          (set! conn (cast Connection (^[int] List/.remove queue 0))))
        (.handleMessages transport conn true)))))

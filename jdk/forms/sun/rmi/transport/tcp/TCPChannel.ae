  (defclass ConnectionAcceptor
    :implements [Runnable]

    (field ^:private ^TCPTransport transport)

    (field ^:private ^{:tag (List Connection)} queue (ArrayList.))

    (field ^:private ^:static ^int threadNum 0)

    (constructor ^:public [this ^TCPTransport transport]

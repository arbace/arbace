  (method ^:public serviceCall ^boolean [this ^:final ^RemoteCall call]
    (try
      (let [^:mutable ^Remote impl nil
            ^:mutable ^ObjID id nil]
        (try
          (set! id (ObjID/read (.getInputStream call)))
          (catch IOException e (throw (MarshalException. "unable to read objID" e))))
        (let [^Transport transport (when-not (.equals id dgcID) this)
              target (ObjectTable/getTarget (ObjectEndpoint. id transport))]
          (when (or (nil? target) (nil? (set! impl (.getImpl target))))
            (throw (NoSuchObjectException. "no such object in table")))
          (let [^:final disp (.getDispatcher target)]
            (.incrementCallCount target)
            (try
              (.log transportLog Log/VERBOSE "call dispatcher")

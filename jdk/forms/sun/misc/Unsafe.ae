  (field ^:private ^:static ^{Stable true} ^boolean memoryAccessWarned)

  (method ^:private ^:static isMemoryAccessWarned ^boolean []
    (locking Unsafe memoryAccessWarned))

  (method ^:private ^:static trySetMemoryAccessWarned ^boolean []
    (locking Unsafe (if memoryAccessWarned false (do (set! memoryAccessWarned true) true))))

  (field ^:private ^:static ^:final ^MemoryAccessOption MEMORY_ACCESS_OPTION
    (MemoryAccessOption/value))

  (method ^:private ^:static ^{ForceInline true} beforeMemoryAccess ^void []
    (when-not (identical? MEMORY_ACCESS_OPTION MemoryAccessOption/ALLOW)
      (when-not (and (identical? MEMORY_ACCESS_OPTION MemoryAccessOption/WARN)
                     (Unsafe/isMemoryAccessWarned))
        (Unsafe/beforeMemoryAccessSlow))))

  (method ^:private ^:static beforeMemoryAccessSlow ^void []
    (java-assert (not (identical? MEMORY_ACCESS_OPTION MemoryAccessOption/ALLOW)))
    (let [^{:tag (List StackWalker$StackFrame)} stack (cast
                                                        List
                                                        (.walk
                                                          StackWalkerHolder/INSTANCE
                                                          (lambda Function ^List [^Stream s]
                                                            (.toList
                                                              (.limit
                                                                (.dropWhile
                                                                  s
                                                                  (lambda Predicate ^boolean [^StackWalker$StackFrame f]
                                                                    (and
                                                                      (identical?
                                                                        (.getDeclaringClass f)
                                                                        Unsafe)
                                                                      (.startsWith
                                                                        (.getMethodName f)
                                                                        "beforeMemoryAccess"))))
                                                                32)))))
          methodName (.getMethodName (cast StackWalker$StackFrame (.get stack 0)))
          ^{:tag (Class ?)} callerClass (.getDeclaringClass
                                          (cast StackWalker$StackFrame (.get stack 1)))]
      (switch MEMORY_ACCESS_OPTION
        WARN
          (when (Unsafe/trySetMemoryAccessWarned)
            (Unsafe/log (Unsafe/multiLineWarning callerClass methodName)))
        DEBUG
          (let [warning (Unsafe/singleLineWarning callerClass methodName)
                sb (StringBuilder. warning)]
            (.forEach (.skip (.stream stack) 1)
                      (lambda Consumer ^void [^StackWalker$StackFrame f]
                        (.append (.append sb (System/lineSeparator)) (java-str "\tat " f))))
            (Unsafe/log (.toString sb)))
        DENY (throw (UnsupportedOperationException. methodName)))))

  (defclass ^:private ^:enum MemoryAccessOption
    (constants ALLOW WARN DEBUG DENY)

    (method ^:private ^:static defaultValue ^MemoryAccessOption [] WARN)

    (method ^:static value ^MemoryAccessOption []
      (let [value (VM/getSavedProperty "sun.misc.unsafe.memory.access")]
        (if (some? value)
            (switch value
              "allow" MemoryAccessOption/ALLOW
              "warn" MemoryAccessOption/WARN
              "debug" MemoryAccessOption/DEBUG
              "deny" MemoryAccessOption/DENY
              (do
                (Unsafe/log (java-str "sun.misc.unsafe.memory.access ignored, value '"
                                      value
                                      "' is not a recognized value"))
                (MemoryAccessOption/defaultValue)))
            (MemoryAccessOption/defaultValue)))))

  (defclass ^:private ^:static StackWalkerHolder
    (field ^:static ^:final ^StackWalker INSTANCE
      (StackWalker/getInstance StackWalker$Option/RETAIN_CLASS_REFERENCE)))

  (method ^:private ^:static multiLineWarning ^String [^{:tag (Class ?)} callerClass
                                                       ^String methodName]
    (String/format
      "WARNING: A terminally deprecated method in sun.misc.Unsafe has been called\nWARNING: sun.misc.Unsafe::%s has been called by %s\nWARNING: Please consider reporting this to the maintainers of %s\nWARNING: sun.misc.Unsafe::%s will be removed in a future release"
      (new Object/1 [methodName (Unsafe/callerAndLocation callerClass) callerClass methodName])))

  (method ^:private ^:static singleLineWarning ^String [^{:tag (Class ?)} callerClass
                                                        ^String methodName]
    (String/format "WARNING: sun.misc.Unsafe::%s called by %s"
                   (new Object/1 [methodName (Unsafe/callerAndLocation callerClass)])))

  (method ^:private ^:static callerAndLocation ^String [^{:tag (Class ?)} callerClass]
    (.getName callerClass))

  (method ^:private ^:static log ^void [^String message]
    (.println System/err message)))

  (method ^:public ^{Deprecated {:since "22" :forRemoval true}} ^{ForceInline true} loadFence ^void [this]
    (.loadFence theInternalUnsafe))

  (method ^:public ^{Deprecated {:since "22" :forRemoval true}} ^{ForceInline true} storeFence ^void [this]

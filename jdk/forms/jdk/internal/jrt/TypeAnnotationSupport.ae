                            Modifier
                            Type
                            TypeVariable)
        '(sun.reflect.annotation TypeAnnotation$TypeAnnotationTarget TypeAnnotationParser)
        '(sun.reflect.generics.reflectiveObjects ParameterizedTypeImpl))

(defclass ^:public ^:final TypeAnnotationSupport
  (constructor ^:private [this])

  (method ^:public ^:static annotatedSuperclass ^AnnotatedType [^{:tag (Class ?)} c]
    (when-not (or (or (or (or (identical? c Object) (.isInterface c)) (.isArray c))
                      (.isPrimitive c))
                  (identical? c Void/TYPE))
      (TypeAnnotationParser/buildAnnotatedSuperclass
        (TypeAnnotationData/rawClassTypeAnnotations c)
        (TypeAnnotationData/constantPool c)
        c)))

  (method ^:public ^:static annotatedInterfaces ^AnnotatedType/1 [^{:tag (Class ?)} c]
    (TypeAnnotationParser/buildAnnotatedInterfaces
      (TypeAnnotationData/rawClassTypeAnnotations c)
      (TypeAnnotationData/constantPool c)
      c))

  (method ^:public ^:static annotatedReturnType ^AnnotatedType [^Executable e]
    (let [^Type returnType (if-instance [^Method m e]
                             (.getGenericReturnType m)
                             ^Type (.getDeclaringClass e))]
      (TypeAnnotationParser/buildAnnotatedType (TypeAnnotationData/rawExecutableTypeAnnotations e)
                                               (TypeAnnotationData/constantPool
                                                 (.getDeclaringClass e))
                                               e
                                               (.getDeclaringClass e)
                                               returnType
                                               TypeAnnotation$TypeAnnotationTarget/METHOD_RETURN)))

  (method ^:public ^:static annotatedReceiverType ^AnnotatedType [^Executable e]
    (if (instance? Constructor e)
        (let [^{:tag (Class ?)} thisDeclClass (.getDeclaringClass e)
              ^{:tag (Class ?)} enclosingClass (.getEnclosingClass thisDeclClass)]
          (when (some? enclosingClass)
            (let [^{:tag (Class ?)} outerDeclaringClass (.getDeclaringClass thisDeclClass)]
              (when (some? outerDeclaringClass)
                (when-not (Modifier/isStatic (.getModifiers thisDeclClass))
                  (TypeAnnotationParser/buildAnnotatedType
                    (TypeAnnotationData/rawExecutableTypeAnnotations e)
                    (TypeAnnotationData/constantPool thisDeclClass)
                    e
                    thisDeclClass
                    (TypeAnnotationSupport/parameterize enclosingClass)
                    TypeAnnotation$TypeAnnotationTarget/METHOD_RECEIVER))))))
        (when-not (Modifier/isStatic (.getModifiers e))
          (TypeAnnotationParser/buildAnnotatedType
            (TypeAnnotationData/rawExecutableTypeAnnotations e)
            (TypeAnnotationData/constantPool (.getDeclaringClass e))
            e
            (.getDeclaringClass e)
            (TypeAnnotationSupport/parameterize (.getDeclaringClass e))
            TypeAnnotation$TypeAnnotationTarget/METHOD_RECEIVER))))

  (method ^:static parameterize ^Type [^{:tag (Class ?)} c]
    (let [^{:tag (Class ?)} ownerClass (.getDeclaringClass c)
          ^{:tag (array (TypeVariable ?))} typeVars (.getTypeParameters c)]
      (if (or (nil? ownerClass) (Modifier/isStatic (.getModifiers c)))
          (if (== (alength typeVars) 0) c (ParameterizedTypeImpl/make c typeVars nil))
          (let [ownerType (TypeAnnotationSupport/parameterize ownerClass)]
            (if (and (instance? Class ownerType) (== (alength typeVars) 0))
                c
                (ParameterizedTypeImpl/make c typeVars ownerType))))))

  (method ^:public ^:static annotatedParameterTypes ^AnnotatedType/1 [^Executable e]
    (TypeAnnotationParser/buildAnnotatedTypes
      (TypeAnnotationData/rawExecutableTypeAnnotations e)
      (TypeAnnotationData/constantPool (.getDeclaringClass e))
      e
      (.getDeclaringClass e)
      (TypeAnnotationSupport/allGenericParameterTypes e)
      TypeAnnotation$TypeAnnotationTarget/METHOD_FORMAL_PARAMETER))

  (method ^:static allGenericParameterTypes ^Type/1 [^Executable e]
    (let [genericParamTypes (.getGenericParameterTypes e)
          ^{:tag (array (Class ?))} nonGenericParamTypes (.getParameterTypes e)]
      (if (== (alength genericParamTypes) (alength nonGenericParamTypes))
          genericParamTypes
          ^Type/1 nonGenericParamTypes)))

  (method ^:public ^:static annotatedExceptionTypes ^AnnotatedType/1 [^Executable e]
    (TypeAnnotationParser/buildAnnotatedTypes (TypeAnnotationData/rawExecutableTypeAnnotations e)
                                              (TypeAnnotationData/constantPool
                                                (.getDeclaringClass e))
                                              e
                                              (.getDeclaringClass e)
                                              (.getGenericExceptionTypes e)
                                              TypeAnnotation$TypeAnnotationTarget/THROWS))

  (method ^:public ^:static annotatedType ^AnnotatedType [^Field f]
    (TypeAnnotationParser/buildAnnotatedType (TypeAnnotationData/rawFieldTypeAnnotations f)
                                             (TypeAnnotationData/constantPool
                                               (.getDeclaringClass f))
                                             f
                                             (.getDeclaringClass f)
                                             (.getGenericType f)
                                             TypeAnnotation$TypeAnnotationTarget/FIELD)))

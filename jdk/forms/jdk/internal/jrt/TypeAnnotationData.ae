  (method ^:public ^:static constantPool ^ConstantPool [^{:tag (Class ?)} c]
    (ConstantPool. (TypeAnnotationData/pool0 c)))

  (method ^:private ^:static descriptor ^String [^{:tag (Class ?)} c]
    (cond
      (.isArray c) (.getName c)
      (.isPrimitive c)
        (cond
          (identical? c Integer/TYPE) "I"
          (identical? c Long/TYPE) "J"
          (identical? c Boolean/TYPE) "Z"
          (identical? c Byte/TYPE) "B"
          (identical? c Character/TYPE) "C"
          (identical? c Short/TYPE) "S"
          (identical? c Float/TYPE) "F"
          (identical? c Double/TYPE) "D"
          :else "V")
      :else (java-str "L" (.getName c) ";"))))

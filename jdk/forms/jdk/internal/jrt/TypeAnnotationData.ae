(defclass ^:public ^:final TypeAnnotationData
  (constructor ^:private [this])

  (method ^:private ^:static ^:native bytes0 ^byte/1 [^{:tag (Class ?)} c ^String key])

  (method ^:private ^:static ^:native pool0 ^Object/1 [^{:tag (Class ?)} c])

  (method ^:public ^:static rawClassTypeAnnotations ^byte/1 [^{:tag (Class ?)} c]

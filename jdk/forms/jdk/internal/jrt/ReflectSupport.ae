;; Converted from overlay/jdk/java.base/jdk/internal/jrt/ReflectSupport.java by arbace.repr.java. Regenerate rather than edit.

(in-ns 'jdk.internal.jrt)

(import '(java.lang.reflect Constructor Field Method Modifier Type TypeVariable)
        '(java.util Arrays StringJoiner)
        '(java.util.function Function)
        '(java.util.stream Collectors)
        '(sun.reflect.generics.factory CoreReflectionFactory GenericsFactory)
        '(sun.reflect.generics.repository ClassRepository
                                          ConstructorRepository
                                          FieldRepository
                                          GenericDeclRepository
                                          MethodRepository)
        '(sun.reflect.generics.scope ClassScope ConstructorScope MethodScope))

(defclass ^:public ^:final ReflectSupport
  (field ^:private ^:static ^:final ^int ACCESS_MODIFIERS
    (bit-or-int (bit-or-int Modifier/PUBLIC Modifier/PROTECTED) Modifier/PRIVATE))

  (constructor ^:private [this])

  (method ^:public ^:static classRepository [^{:tag (Class ?)} c ^String sig]
    (ClassRepository/make sig (CoreReflectionFactory/make c (ClassScope/make c))))

  (method ^:public ^:static methodRepository [^Method m ^String sig]
    (let [^GenericsFactory f (CoreReflectionFactory/make m (MethodScope/make m))]
      (MethodRepository/make sig f)))

  (method ^:public ^:static constructorRepository [^{:tag (Constructor ?)} k ^String sig]
    (let [^GenericsFactory f (CoreReflectionFactory/make k (ConstructorScope/make k))]
      (ConstructorRepository/make sig f)))

  (method ^:public ^:static fieldRepository [^Field f ^String sig]
    (let [^{:tag (Class ?)} c (.getDeclaringClass f)]
      (FieldRepository/make sig (CoreReflectionFactory/make c (ClassScope/make c)))))

  (method ^:public ^:static typeParameters [repo]
    (.getTypeParameters (cast GenericDeclRepository repo)))

  (method ^:public ^:static genericSuperclass [^{:tag (Class ?)} c repo]
    (when-not (.isInterface c) (.getSuperclass (cast ClassRepository repo))))

  (method ^:public ^:static genericInterfaces [repo]
    (.getSuperInterfaces (cast ClassRepository repo)))

  (method ^:public ^:static genericReturnType [repo]
    (.getReturnType (cast MethodRepository repo)))

  (method ^:public ^:static genericParameterTypes [repo]
    (.getParameterTypes (cast ConstructorRepository repo)))

  (method ^:public ^:static genericExceptionTypes [repo]
    (.getExceptionTypes (cast ConstructorRepository repo)))

  (method ^:public ^:static genericType [repo]
    (.getGenericType (cast FieldRepository repo)))

  (method ^:static typeVarBounds ^String [^{:tag (TypeVariable ?)} typeVar]
    (let [bounds (.getBounds typeVar)]
      (if (and (== (alength bounds) 1) (.equals (aget bounds 0) Object))
          (.getName typeVar)
          (java-str (.getName typeVar)
                    " extends "
                    (cast String
                          (.collect (.map (Arrays/stream bounds)
                                          (method-ref Function ^String [Type] Type/.getTypeName))
                                    (Collectors/joining " & ")))))))

  (method ^:public ^:static classToGenericString ^String [^{:tag (Class ?)} c]
    (if (.isPrimitive c)
        (.toString c)
        (let [sb (StringBuilder.)
              ^:mutable ^{:tag (Class ?)} component c
              ^:mutable ^int arrayDepth 0]
          (if (.isArray c)
              (do
                (loop []
                  (set! arrayDepth (unchecked-inc-int arrayDepth))
                  (set! component (.getComponentType component))
                  (when (.isArray component) (recur)))
                (.append sb (.getName component)))
              (let [modifiers (bit-and-int (.getModifiers c) (Modifier/classModifiers))]
                (when-not (== modifiers 0)
                  (.append sb (Modifier/toString modifiers))
                  (.append sb \space))
                (ReflectSupport/addSealingInfo c modifiers sb)
                (when (.isAnnotation c) (.append sb \@))
                (cond
                  (.isInterface c) (.append sb "interface")
                  (.isEnum c) (.append sb "enum")
                  (.isRecord c) (.append sb "record")
                  :else (.append sb "class"))
                (.append sb \space)
                (.append sb (.getName c))))
          (let [^{:tag (array (TypeVariable ?))} typeparms (.getTypeParameters component)]
            (when (> (alength typeparms) 0)
              (.append sb
                       (cast String
                             (.collect (.map (Arrays/stream typeparms)
                                             (method-ref
                                               Function
                                               ^String [TypeVariable]
                                               ReflectSupport/typeVarBounds))
                                       (Collectors/joining "," "<" ">")))))
            (when (> arrayDepth 0) (.append sb (.repeat "[]" arrayDepth)))
            (.toString sb)))))

  (method ^:private ^:static addSealingInfo ^void [^{:tag (Class ?)} c ^int modifiers
                                                   ^StringBuilder sb]
    (when-not (Modifier/isFinal modifiers)
      (cond
        (.isSealed c) (.append sb "sealed ")
        (ReflectSupport/hasSealedAncestor c) (.append sb "non-sealed "))))

  (method ^:private ^:static hasSealedAncestor ^boolean [^{:tag (Class ?)} clazz]
    (let [^{:tag (Class ?)} superclass (.getSuperclass clazz)]
      (if (and (some? superclass) (.isSealed superclass))
          true
          (do
            (for-each [^Class superinterface (.getInterfaces clazz)]
              (when (.isSealed superinterface) (return true)))
            false))))

  (method ^:private ^:static printModifiersIfNonzero ^void [^int modifiers ^StringBuilder sb
                                                            ^int mask ^boolean isDefault]
    (let [^:mutable mod (bit-and-int modifiers mask)]
      (if (and (not (== mod 0)) (not isDefault))
          (.append (.append sb (Modifier/toString mod)) \space)
          (let [access_mod (bit-and-int mod ACCESS_MODIFIERS)]
            (when-not (== access_mod 0)
              (.append (.append sb (Modifier/toString access_mod)) \space))
            (when isDefault (.append sb "default "))
            (set! mod (bit-and-int mod (bit-not-int ACCESS_MODIFIERS)))
            (when-not (== mod 0) (.append (.append sb (Modifier/toString mod)) \space))))))

  (method ^:private ^:static sharedToGenericString ^String [^int modifiers ^int modifierMask
                                                            ^boolean isDefault
                                                            ^{:tag (array (TypeVariable ?))} typeparms
                                                            ^String header ^Type/1 params
                                                            ^boolean isVarArgs
                                                            ^Type/1 exceptionTypes]
    (try
      (let [sb (StringBuilder.)]
        (ReflectSupport/printModifiersIfNonzero modifiers sb modifierMask isDefault)
        (when (> (alength typeparms) 0)
          (.append sb
                   (cast String
                         (.collect (.map (Arrays/stream typeparms)
                                         (method-ref
                                           Function
                                           ^String [TypeVariable]
                                           ReflectSupport/typeVarBounds))
                                   (Collectors/joining "," "<" "> ")))))
        (.append sb header)
        (.append sb \()
        (let [sj (StringJoiner. ",")]
          (loop [^int j 0]
            (when (< j (alength params))
              (let [^:mutable param (.getTypeName (aget params j))]
                (when (and isVarArgs (== j (unchecked-subtract-int (alength params) 1)))
                  (set! param (.replaceFirst param "\\[\\]$" "...")))
                (.add sj param)
                (recur (unchecked-inc-int j)))))
          (.append sb (.toString sj))
          (.append sb \))
          (when (> (alength exceptionTypes) 0)
            (.append sb
                     (cast String
                           (.collect (.map (Arrays/stream exceptionTypes)
                                           (method-ref Function ^String [Type] Type/.getTypeName))
                                     (Collectors/joining "," " throws " "")))))
          (.toString sb)))
      (catch Exception e (java-str "<" e ">"))))

  (method ^:public ^:static methodToGenericString ^String [^Method m]
    (let [^:mutable ^String header nil]
      (try
        (let [genRetType (.getGenericReturnType m)]
          (set! header
                (java-str (.getTypeName genRetType)
                          " "
                          (.getTypeName (.getDeclaringClass m))
                          "."
                          (.getName m))))
        (catch Exception e (return (java-str "<" e ">"))))
      (ReflectSupport/sharedToGenericString (.getModifiers m)
                                            (Modifier/methodModifiers)
                                            (.isDefault m)
                                            (.getTypeParameters m)
                                            header
                                            (.getGenericParameterTypes m)
                                            (.isVarArgs m)
                                            (.getGenericExceptionTypes m))))

  (method ^:public ^:static constructorToGenericString ^String [^{:tag (Constructor ?)} k]
    (let [header (.getTypeName (.getDeclaringClass k))]
      (ReflectSupport/sharedToGenericString (.getModifiers k)
                                            (Modifier/constructorModifiers)
                                            false
                                            (.getTypeParameters k)
                                            header
                                            (.getGenericParameterTypes k)
                                            (.isVarArgs k)
                                            (.getGenericExceptionTypes k))))

  (method ^:public ^:static fieldToGenericString ^String [^Field f]
    (let [mod (.getModifiers f)
          fieldType (.getGenericType f)]
      (java-str (if (== mod 0) "" (java-str (Modifier/toString mod) " "))
                (.getTypeName fieldType)
                " "
                (.getTypeName (.getDeclaringClass f))
                "."
                (.getName f)))))

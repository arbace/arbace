  (method ^:private ^:static insertOrdered ^int [^char/1 source ^int start ^:mutable ^int current
                                                 ^int p ^char c1 ^char c2 ^int cc]
    (let [^:mutable ^int back 0
          ^:mutable ^int preBack 0
          ^:mutable ^int r 0
          ^:mutable ^int prevCC 0
          ^:mutable trailCC cc]
      (when (and (< start current) (not (== cc 0)))
        (set! preBack (set! back current))
        (let [prevArgs (PrevArgs.)]
          (set! (.-current prevArgs) current)
          (set! (.-start prevArgs) start)
          (set! (.-src prevArgs) source)
          (set! (.-c1 prevArgs) c1)
          (set! (.-c2 prevArgs) c2)
          (set! prevCC (NormalizerImpl/getPrevCC prevArgs))
          (set! preBack (.-current prevArgs))
          (when (< cc prevCC)
            (set! trailCC prevCC)
            (set! back preBack)
            (while (< start preBack)
              (set! prevCC (NormalizerImpl/getPrevCC prevArgs))
              (set! preBack (.-current prevArgs))
              (when (>= cc prevCC) (break))
              (set! back preBack))
            (set! r p)
            (loop []
              (aset source
                    (set! r (unchecked-dec-int r))
                    (aget source (set! current (unchecked-dec-int current))))
              (when-not (== back current) (recur))))))
      (aset source current c1)
      (when-not (== c2 0) (aset source (unchecked-add-int current 1) c2))
      trailCC))

  (method ^:private ^:static mergeOrdered ^int [^char/1 source ^int start ^:mutable ^int current
                                                ^char/1 data ^int next ^int limit]
    (let [^:mutable ^int r 0
          ^:mutable ^int cc 0
          ^:mutable ^int trailCC 0
          ^:mutable ^boolean adjacent false]
      (set! adjacent (== current next))
      (let [ncArgs (NextCCArgs.)]
        (set! (.-source ncArgs) data)
        (set! (.-next ncArgs) next)
        (set! (.-limit ncArgs) limit)
        (when-not (== start current)
          (while (< (.-next ncArgs) (.-limit ncArgs))
            (set! cc (NormalizerImpl/getNextCC ncArgs))
            (if (== cc 0)
                (do

                        (when-not (== (.-c2 ncArgs) 0)
                          (aset data current (.-c2 ncArgs))
                          (set! current (unchecked-inc-int current)))))
                  (break))
                (do
                  (set! r (unchecked-add-int current (if (== (.-c2 ncArgs) 0) 1 2)))
                  (set! trailCC
                        (NormalizerImpl/insertOrdered
                          source
                          start
                          current
                          r
                          (.-c1 ncArgs)
                          (.-c2 ncArgs)
                          cc))
                  (set! current r)))))
        (if (== (.-next ncArgs) (.-limit ncArgs))

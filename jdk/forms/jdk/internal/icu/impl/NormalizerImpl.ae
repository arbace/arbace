  (method ^:private hasCompBoundaryBefore ^boolean [this ^int c ^int norm16]
    (or (< c minCompNoMaybeCP) (.norm16HasCompBoundaryBefore this norm16)))

  (method ^:private norm16HasCompBoundaryBefore ^boolean [this ^int norm16]
    (or (< norm16 minNoNoCompNoMaybeCC) (.isAlgorithmicNoNo this norm16)))

  (method ^:private hasCompBoundaryBefore ^boolean [this ^CharSequence s ^int src ^int limit]
    (or (== src limit) (.hasCompBoundaryBefore this (Character/codePointAt s src))))

  (method ^:private norm16HasCompBoundaryAfter ^boolean [this ^int norm16 ^boolean onlyContiguous]
    (and (not (== (bit-and-int norm16 HAS_COMP_BOUNDARY_AFTER) 0))
         (or (not onlyContiguous) (.isTrailCC01ForCompBoundaryAfter this norm16))))

  (method ^:private hasCompBoundaryAfter ^boolean [this ^CharSequence s ^int start ^int p
                                                   ^boolean onlyContiguous]
    (or (== start p) (.hasCompBoundaryAfter this (Character/codePointBefore s p) onlyContiguous)))

  (method ^:private isTrailCC01ForCompBoundaryAfter ^boolean [this ^int norm16]
    (or (NormalizerImpl/isInert norm16)
        (if (.isDecompNoAlgorithmic this norm16)
            (<= (bit-and-int norm16 DELTA_TCCC_MASK) DELTA_TCCC_1)
            (<= (.charAt extraData (.getDataForYesOrNo this norm16)) 0x1ff))))

  (method ^:private findPreviousCompBoundary ^int [this ^CharSequence s ^:mutable ^int p
                                                   ^boolean onlyContiguous]
    (while (> p 0)
      (let [c (Character/codePointBefore s p)
            norm16 (.getNorm16 this c)]
        (when (.norm16HasCompBoundaryAfter this norm16 onlyContiguous) (break))
        (set! p (unchecked-subtract-int p (Character/charCount c)))
        (when (.hasCompBoundaryBefore this c norm16) (break))))
    p)

  (method ^:private findNextCompBoundary ^int [this ^CharSequence s ^:mutable ^int p ^int limit
                                               ^boolean onlyContiguous]
    (while (< p limit)
      (let [c (Character/codePointAt s p)
            norm16 (.get normTrie c)]
        (when (.hasCompBoundaryBefore this c norm16) (break))
        (set! p (unchecked-add-int p (Character/charCount c)))
        (when (.norm16HasCompBoundaryAfter this norm16 onlyContiguous) (break))))
    p)

  (method ^:private findNextFCDBoundary ^int [this ^CharSequence s ^:mutable ^int p ^int limit]
    (while (< p limit)
      (let [c (Character/codePointAt s p)
            ^:mutable ^int norm16 0]
        (when (or (< c minLcccCP)
                  (.norm16HasDecompBoundaryBefore this (set! norm16 (.getNorm16 this c))))
          (break))
        (set! p (unchecked-add-int p (Character/charCount c)))
        (when (.norm16HasDecompBoundaryAfter this norm16) (break))))
    p)

  (method ^:public ^:static getDecompose ^int [^int/1 chars ^String/1 decomps]
    (let [impl (Normalizer2/getNFDInstance)
          ^int length 0
          ^int norm16 0
          ^:mutable ^int ch -1
          ^:mutable ^int i 0]
      (while (< (set! ch (unchecked-inc-int ch)) 0x2fa1e)
        (cond
          (== ch 0x30ff) (set! ch 0xf900)
          (== ch 0x115bc) (set! ch 0x1d15e)
          (== ch 0x1d1c1) (set! ch 0x2f800))
        (let [s (.getDecomposition impl ch)]
          (when (and (some? s) (< i (alength chars)))
            (aset chars i ch)
            (aset decomps i s)
            (set! i (unchecked-inc-int i)))))
      i))

  (method ^:private ^:static needSingleQuotation ^boolean [^char c]
    (or (or (or (or (and (>= c 0x0009) (<= c 0x000D)) (and (>= c 0x0020) (<= c 0x002F)))
                (and (>= c 0x003A) (<= c 0x0040)))
            (and (>= c 0x005B) (<= c 0x0060)))
        (and (>= c 0x007B) (<= c 0x007E))))

  (method ^:public ^:static canonicalDecomposeWithSingleQuotation ^String [^String string]
    (let [impl (Normalizer2/getNFDInstance)

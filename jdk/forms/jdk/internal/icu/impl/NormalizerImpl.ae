          ^:mutable ^int reorderStartIndex 0
          ^:mutable ^int length 0
          ^:mutable ^char c1 (unchecked-char 0)
          ^:mutable ^char c2 (unchecked-char 0)
          ^:mutable ^int cp 0
          ^int minNoMaybe 0x00c0

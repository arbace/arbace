              (.append buffer s 0 src false firstCC prevCC)
              (.append buffer s src limit))))))

  (method ^:public compose ^boolean [this ^CharSequence s ^:mutable ^int src ^int limit
                                     ^boolean onlyContiguous ^boolean doCompose
                                     ^ReorderingBuffer buffer]
    (let [^:mutable prevBoundary src
          minNoMaybeCP minCompNoMaybeCP]
      (while true
        (let [^:mutable ^int prevSrc 0
              ^:mutable ^int c 0
              ^:mutable ^int norm16 0]
          (while true
            (when (== src limit)
              (when (and (not (== prevBoundary limit)) doCompose)
                (.append buffer s prevBoundary limit))
              (return true))
            (if (or (< (set! c (.charAt s src)) minNoMaybeCP)
                    (.isCompYesAndZeroCC this (set! norm16 (.bmpGet normTrie c))))
                (set! src (unchecked-inc-int src))
                (do
                  (set! prevSrc src)
                  (set! src (unchecked-inc-int src))
                  (if (not (UTF16Plus/isLeadSurrogate c))
                      (break)
                      (let [^:mutable ^char c2 (unchecked-char 0)]
                        (when (and (not (== src limit))
                                   (Character/isLowSurrogate (set! c2 (.charAt s src))))
                          (set! src (unchecked-inc-int src))
                          (set! c (Character/toCodePoint (unchecked-char c) c2))
                          (set! norm16 (.suppGet normTrie c))
                          (when-not (.isCompYesAndZeroCC this norm16) (break))))))))
          (cond
            (< norm16 minMaybeNo)
              (do
                (when-not doCompose (return false))
                (cond
                  (.isDecompNoAlgorithmic this norm16)
                    (when (or (.norm16HasCompBoundaryAfter this norm16 onlyContiguous)
                              (.hasCompBoundaryBefore this s src limit))
                      (when-not (== prevBoundary prevSrc) (.append buffer s prevBoundary prevSrc))
                      (.append buffer (.mapAlgorithmic this c norm16) 0)
                      (set! prevBoundary src)
                      (continue))
                  (< norm16 minNoNoCompBoundaryBefore)
                    (when (or (.norm16HasCompBoundaryAfter this norm16 onlyContiguous)
                              (.hasCompBoundaryBefore this s src limit))
                      (when-not (== prevBoundary prevSrc) (.append buffer s prevBoundary prevSrc))
                      (let [^:mutable mapping (.getDataForYesOrNo this norm16)
                            length (bit-and-int (.charAt
                                                  extraData
                                                  (let [old-4 mapping]
                                                    (set! mapping (unchecked-inc-int mapping))
                                                    old-4))
                                                MAPPING_LENGTH_MASK)]
                        (.append buffer extraData mapping (unchecked-add-int mapping length))
                        (set! prevBoundary src)
                        (continue)))
                  (>= norm16 minNoNoEmpty)
                    (when (or (.hasCompBoundaryBefore this s src limit)
                              (.hasCompBoundaryAfter this s prevBoundary prevSrc onlyContiguous))
                      (when-not (== prevBoundary prevSrc) (.append buffer s prevBoundary prevSrc))
                      (set! prevBoundary src)
                      (continue))))
            (and (NormalizerImpl/isJamoVT norm16) (not (== prevBoundary prevSrc)))
              (let [prev (.charAt s (unchecked-subtract-int prevSrc 1))]
                (if (< c Hangul/JAMO_T_BASE)
                    (let [l (unchecked-char (unchecked-subtract-int prev Hangul/JAMO_L_BASE))]
                      (when (< l Hangul/JAMO_L_COUNT)
                        (when-not doCompose (return false))
                        (let [^:mutable ^int t 0]
                          (cond
                            (and (and (not (== src limit))
                                      (< 0
                                         (set! t
                                               (unchecked-subtract-int
                                                 (.charAt s src)
                                                 Hangul/JAMO_T_BASE))))
                                 (< t Hangul/JAMO_T_COUNT))
                              (set! src (unchecked-inc-int src))
                            (.hasCompBoundaryBefore this s src limit) (set! t 0)
                            :else (set! t -1))
                          (when (>= t 0)
                            (let [syllable (unchecked-add-int
                                             (unchecked-add-int
                                               Hangul/HANGUL_BASE
                                               (unchecked-multiply-int
                                                 (unchecked-add-int
                                                   (unchecked-multiply-int l Hangul/JAMO_V_COUNT)
                                                   (unchecked-subtract-int c Hangul/JAMO_V_BASE))
                                                 Hangul/JAMO_T_COUNT))
                                             t)]
                              (set! prevSrc (unchecked-dec-int prevSrc))
                              (when-not (== prevBoundary prevSrc)
                                (.append buffer s prevBoundary prevSrc))
                              (.append buffer (unchecked-char syllable))
                              (set! prevBoundary src)
                              (continue))))))
                    (when (Hangul/isHangulLV prev)
                      (when-not doCompose (return false))
                      (let [syllable (unchecked-subtract-int
                                       (unchecked-add-int prev c)
                                       Hangul/JAMO_T_BASE)]
                        (set! prevSrc (unchecked-dec-int prevSrc))
                        (when-not (== prevBoundary prevSrc) (.append buffer s prevBoundary prevSrc))
                        (.append buffer (unchecked-char syllable))
                        (set! prevBoundary src)
                        (continue)))))
            (> norm16 JAMO_VT)
              (let [^:mutable cc (NormalizerImpl/getCCFromNormalYesOrMaybe norm16)]
                (if (and onlyContiguous (> (.getPreviousTrailCC this s prevBoundary prevSrc) cc))
                    (when-not doCompose (return false))
                    (let [^:mutable ^int n16 0]
                      (while true
                        (when (== src limit)
                          (when doCompose (.append buffer s prevBoundary limit))
                          (return true))
                        (let [prevCC cc]
                          (set! c (Character/codePointAt s src))
                          (set! n16 (.get normTrie c))
                          (if (>= n16 MIN_YES_YES_WITH_CC)
                              (do
                                (set! cc (NormalizerImpl/getCCFromNormalYesOrMaybe n16))
                                (when (> prevCC cc) (when-not doCompose (return false)) (break)))
                              (break))
                          (set! src (unchecked-add-int src (Character/charCount c)))))
                      (when (.norm16HasCompBoundaryBefore this n16)
                        (when (.isCompYesAndZeroCC this n16)
                          (set! src (unchecked-add-int src (Character/charCount c))))
                        (continue))))))
          (when (and (not (== prevBoundary prevSrc))
                     (not (.norm16HasCompBoundaryBefore this norm16)))
            (set! c (Character/codePointBefore s prevSrc))
            (set! norm16 (.get normTrie c))
            (when-not (.norm16HasCompBoundaryAfter this norm16 onlyContiguous)
              (set! prevSrc (unchecked-subtract-int prevSrc (Character/charCount c)))))
          (when (and doCompose (not (== prevBoundary prevSrc)))
            (.append buffer s prevBoundary prevSrc))
          (let [recomposeStartIndex (.length buffer)]
            (.decomposeShort this s prevSrc src false onlyContiguous buffer)
            (set! src (.decomposeShort this s src limit true onlyContiguous buffer))
            (.recompose this buffer recomposeStartIndex onlyContiguous)
            (when-not doCompose
              (when-not (.equals buffer s prevSrc src) (return false))
              (.remove buffer))
            (set! prevBoundary src))))))

  (method ^:public composeQuickCheck ^int [this ^CharSequence s ^:mutable ^int src ^int limit
                                           ^boolean onlyContiguous ^boolean doSpan]
    (let [^:mutable ^int qcResult 0
          ^:mutable prevBoundary src
          minNoMaybeCP minCompNoMaybeCP]
      (while true
        (let [^:mutable ^int prevSrc 0
              ^:mutable ^int c 0
              ^:mutable ^int norm16 0]
          (while true
            (when (== src limit) (return (bit-or-int (bit-shift-left-int src 1) qcResult)))
            (if (or (< (set! c (.charAt s src)) minNoMaybeCP)
                    (.isCompYesAndZeroCC this (set! norm16 (.bmpGet normTrie c))))
                (set! src (unchecked-inc-int src))
                (do
                  (set! prevSrc src)
                  (set! src (unchecked-inc-int src))
                  (if (not (UTF16Plus/isLeadSurrogate c))
                      (break)
                      (let [^:mutable ^char c2 (unchecked-char 0)]
                        (when (and (not (== src limit))
                                   (Character/isLowSurrogate (set! c2 (.charAt s src))))
                          (set! src (unchecked-inc-int src))
                          (set! c (Character/toCodePoint (unchecked-char c) c2))
                          (set! norm16 (.suppGet normTrie c))
                          (when-not (.isCompYesAndZeroCC this norm16) (break))))))))
          (let [^:mutable prevNorm16 INERT]
            (when-not (== prevBoundary prevSrc)
              (set! prevBoundary prevSrc)
              (when-not (.norm16HasCompBoundaryBefore this norm16)
                (set! c (Character/codePointBefore s prevSrc))
                (let [n16 (.getNorm16 this c)]
                  (when-not (.norm16HasCompBoundaryAfter this n16 onlyContiguous)
                    (set! prevBoundary
                          (unchecked-subtract-int prevBoundary (Character/charCount c)))
                    (set! prevNorm16 n16)))))
            (when (>= norm16 minMaybeNo)
              (let [^:mutable fcd16 (.getFCD16FromMaybeOrNonZeroCC this norm16)
                    ^:mutable cc (bit-and-int (bit-shift-right-int fcd16 8) 0xff)]
                (when-not (and (and onlyContiguous (not (== cc 0)))
                               (> (.getTrailCCFromCompYesAndZeroCC this prevNorm16) cc))
                  (while true
                    (when (< norm16 MIN_YES_YES_WITH_CC)
                      (if (not doSpan)
                          (set! qcResult 1)
                          (return (bit-shift-left-int prevBoundary 1))))
                    (when (== src limit) (return (bit-or-int (bit-shift-left-int src 1) qcResult)))
                    (let [prevCC (bit-and-int fcd16 0xff)]
                      (set! c (Character/codePointAt s src))
                      (set! norm16 (.getNorm16 this c))
                      (if (>= norm16 minMaybeNo)
                          (do
                            (set! fcd16 (.getFCD16FromMaybeOrNonZeroCC this norm16))
                            (set! cc (bit-and-int (bit-shift-right-int fcd16 8) 0xff))
                            (when-not (or (<= prevCC cc) (== cc 0)) (break)))
                          (break))
                      (set! src (unchecked-add-int src (Character/charCount c)))))
                  (when (.isCompYesAndZeroCC this norm16)
                    (set! prevBoundary src)
                    (set! src (unchecked-add-int src (Character/charCount c)))
                    (continue)))))
            (return (bit-shift-left-int prevBoundary 1)))))))

  (method ^:public composeAndAppend ^void [this ^CharSequence s ^boolean doCompose
                                           ^boolean onlyContiguous ^ReorderingBuffer buffer]
    (let [^:mutable ^int src 0
          limit (.length s)]
      (when-not (.isEmpty buffer)
        (let [firstStarterInSrc (.findNextCompBoundary this s 0 limit onlyContiguous)]
          (when-not (== 0 firstStarterInSrc)
            (let [lastStarterInDest (.findPreviousCompBoundary
                                      this
                                      (.getStringBuilder buffer)
                                      (.length buffer)
                                      onlyContiguous)
                  middle (StringBuilder.
                           (unchecked-add-int
                             (unchecked-add-int
                               (unchecked-subtract-int (.length buffer) lastStarterInDest)
                               firstStarterInSrc)
                             16))]
              (.append middle (.getStringBuilder buffer) lastStarterInDest (.length buffer))
              (.removeSuffix buffer (unchecked-subtract-int (.length buffer) lastStarterInDest))
              (.append middle s 0 firstStarterInSrc)
              (.compose this middle 0 (.length middle) onlyContiguous true buffer)
              (set! src firstStarterInSrc)))))
      (if doCompose
          (.compose this s src limit onlyContiguous true buffer)
          (.append buffer s src limit))))

  (method ^:public makeFCD ^int [this ^CharSequence s ^:mutable ^int src ^int limit
                                 ^ReorderingBuffer buffer]
    (let [^:mutable prevBoundary src
          ^:mutable ^int prevSrc 0
          ^:mutable ^int c 0
          ^:mutable ^int prevFCD16 0
          ^:mutable ^int fcd16 0]
      (while true
        (set! prevSrc src)
        (while (not (== src limit))
          (cond
            (< (set! c (.charAt s src)) minLcccCP)
              (do (set! prevFCD16 (bit-not-int c)) (set! src (unchecked-inc-int src)))
            (not (.singleLeadMightHaveNonZeroFCD16 this c))
              (do (set! prevFCD16 0) (set! src (unchecked-inc-int src)))
            :else
              (do
                (when (UTF16Plus/isLeadSurrogate c)
                  (let [^:mutable ^char c2 (unchecked-char 0)]
                    (when (and (not (== (unchecked-add-int src 1) limit))
                               (Character/isLowSurrogate
                                 (set! c2 (.charAt s (unchecked-add-int src 1)))))
                      (set! c (Character/toCodePoint (unchecked-char c) c2)))))
                (if (<= (set! fcd16 (.getFCD16FromNormData this c)) 0xff)
                    (do
                      (set! prevFCD16 fcd16)
                      (set! src (unchecked-add-int src (Character/charCount c))))
                    (break)))))
        (cond
          (not (== src prevSrc))
            (do
              (when (== src limit)
                (when (some? buffer) (.flushAndAppendZeroCC buffer s prevSrc src))
                (break))
              (set! prevBoundary src)
              (if (< prevFCD16 0)
                  (let [prev (bit-not-int prevFCD16)]
                    (if (< prev minDecompNoCP)
                        (set! prevFCD16 0)
                        (do
                          (set! prevFCD16 (.getFCD16FromNormData this prev))
                          (when (> prevFCD16 1)
                            (set! prevBoundary (unchecked-dec-int prevBoundary))))))
                  (let [^:mutable p (unchecked-subtract-int src 1)]
                    (when (and (and (Character/isLowSurrogate (.charAt s p)) (< prevSrc p))
                               (Character/isHighSurrogate (.charAt s (unchecked-subtract-int p 1))))
                      (set! p (unchecked-dec-int p))
                      (set! prevFCD16
                            (.getFCD16FromNormData
                              this
                              (Character/toCodePoint
                                (.charAt s p)
                                (.charAt s (unchecked-add-int p 1))))))
                    (when (> prevFCD16 1) (set! prevBoundary p))))
              (when (some? buffer)
                (.flushAndAppendZeroCC buffer s prevSrc prevBoundary)
                (.append buffer s prevBoundary src))
              (set! prevSrc src))
          (== src limit) (break))
        (set! src (unchecked-add-int src (Character/charCount c)))
        (cond
          (<= (bit-and-int prevFCD16 0xff) (bit-shift-right-int fcd16 8))
            (do
              (when (<= (bit-and-int fcd16 0xff) 1) (set! prevBoundary src))
              (when (some? buffer) (.appendZeroCC buffer c))
              (set! prevFCD16 fcd16))
          (nil? buffer) (return prevBoundary)
          :else
            (do
              (.removeSuffix buffer (unchecked-subtract-int prevSrc prevBoundary))
              (set! src (.findNextFCDBoundary this s src limit))
              (.decomposeShort this s prevBoundary src false false buffer)
              (set! prevBoundary src)
              (set! prevFCD16 0))))
      src))

  (method ^:public hasDecompBoundaryBefore ^boolean [this ^int c]
    (or (or (< c minLcccCP) (and (<= c 0xffff) (not (.singleLeadMightHaveNonZeroFCD16 this c))))
        (.norm16HasDecompBoundaryBefore this (.getNorm16 this c))))

  (method ^:public norm16HasDecompBoundaryBefore ^boolean [this ^int norm16]
    (cond
      (< norm16 minNoNoCompNoMaybeCC) true
      (>= norm16 limitNoNo) (or (<= norm16 MIN_NORMAL_MAYBE_YES) (== norm16 JAMO_VT))
      :else
        (let [mapping (.getDataForYesOrNo this norm16)
              ^int firstUnit (.charAt extraData mapping)]
          (or (== (bit-and-int firstUnit MAPPING_HAS_CCC_LCCC_WORD) 0)
              (== (bit-and-int (.charAt extraData (unchecked-subtract-int mapping 1)) 0xff00) 0)))))

  (method ^:public hasDecompBoundaryAfter ^boolean [this ^int c]
    (cond
      (< c minDecompNoCP) true
      (and (<= c 0xffff) (not (.singleLeadMightHaveNonZeroFCD16 this c))) true
      :else (.norm16HasDecompBoundaryAfter this (.getNorm16 this c))))

  (method ^:public norm16HasDecompBoundaryAfter ^boolean [this ^int norm16]
    (if (or (<= norm16 minYesNo) (.isHangulLVT this norm16))
        true
        (do
          (when (>= norm16 limitNoNo)
            (cond
              (.isMaybeYesOrNonZeroCC this norm16)
                (return (or (<= norm16 MIN_NORMAL_MAYBE_YES) (== norm16 JAMO_VT)))
              (< norm16 minMaybeNo) (return (<= (bit-and-int norm16 DELTA_TCCC_MASK) DELTA_TCCC_1))))
          (let [mapping (.getData this norm16)
                ^int firstUnit (.charAt extraData mapping)]
            (cond
              (> firstUnit 0x1ff) false
              (<= firstUnit 0xff) true
              :else
                (or (== (bit-and-int firstUnit MAPPING_HAS_CCC_LCCC_WORD) 0)
                    (== (bit-and-int (.charAt extraData (unchecked-subtract-int mapping 1)) 0xff00)
                        0)))))))

  (method ^:public isDecompInert ^boolean [this ^int c]
    (.isDecompYesAndZeroCC this (.getNorm16 this c)))

  (method ^:public hasCompBoundaryBefore ^boolean [this ^int c]
    (or (< c minCompNoMaybeCP) (.norm16HasCompBoundaryBefore this (.getNorm16 this c))))

  (method ^:public hasCompBoundaryAfter ^boolean [this ^int c ^boolean onlyContiguous]
    (.norm16HasCompBoundaryAfter this (.getNorm16 this c) onlyContiguous))

  (method ^:private isMaybe ^boolean [this ^int norm16]
    (and (<= minMaybeNo norm16) (<= norm16 JAMO_VT)))

  (method ^:private isMaybeYesOrNonZeroCC ^boolean [this ^int norm16]
    (>= norm16 minMaybeYes))

  (method ^:private ^:static isInert ^boolean [^int norm16]
    (== norm16 INERT))

  (method ^:private ^:static isJamoVT ^boolean [^int norm16]
    (== norm16 JAMO_VT))

  (method ^:private hangulLVT ^int [this]
    (bit-or-int minYesNoMappingsOnly HAS_COMP_BOUNDARY_AFTER))

  (method ^:private isHangulLV ^boolean [this ^int norm16]
    (== norm16 minYesNo))

  (method ^:private isHangulLVT ^boolean [this ^int norm16]
    (== norm16 (.hangulLVT this)))

  (method ^:private isCompYesAndZeroCC ^boolean [this ^int norm16]
    (< norm16 minNoNo))

  (method ^:private isDecompYesAndZeroCC ^boolean [this ^int norm16]
    (or (or (< norm16 minYesNo) (== norm16 JAMO_VT))
        (and (<= minMaybeYes norm16) (<= norm16 MIN_NORMAL_MAYBE_YES))))

  (method ^:private isMostDecompYesAndZeroCC ^boolean [this ^int norm16]
    (or (or (< norm16 minYesNo) (== norm16 MIN_NORMAL_MAYBE_YES)) (== norm16 JAMO_VT)))

  (method ^:private isDecompNoAlgorithmic ^boolean [this ^int norm16]
    (and (<= limitNoNo norm16) (< norm16 minMaybeNo)))

  (method ^:private getCCFromNoNo ^int [this ^int norm16]
    (let [mapping (.getDataForYesOrNo this norm16)]
      (if (not (== (bit-and-int (.charAt extraData mapping) MAPPING_HAS_CCC_LCCC_WORD) 0))
          (bit-and-int (.charAt extraData (unchecked-subtract-int mapping 1)) 0xff)
          0)))

  (method getTrailCCFromCompYesAndZeroCC ^int [this ^int norm16]
    (if (<= norm16 minYesNo)
        0
        (bit-shift-right-int (.charAt extraData (.getDataForYesOrNo this norm16)) 8)))

  (method ^:private mapAlgorithmic ^int [this ^int c ^int norm16]
    (unchecked-subtract-int (unchecked-add-int c (bit-shift-right-int norm16 DELTA_SHIFT))
                            centerNoNoDelta))

  (method ^:private getDataForYesOrNo ^int [this ^int norm16]
    (bit-shift-right-int norm16 OFFSET_SHIFT))

  (method ^:private getDataForMaybe ^int [this ^int norm16]
    (bit-shift-right-int (unchecked-add-int (unchecked-subtract-int norm16 minMaybeNo) limitNoNo)
                         OFFSET_SHIFT))

  (method ^:private getData ^int [this ^:mutable ^int norm16]
    (when (>= norm16 minMaybeNo)
      (set! norm16 (unchecked-add-int (unchecked-subtract-int norm16 minMaybeNo) limitNoNo)))
    (bit-shift-right-int norm16 OFFSET_SHIFT))

  (method ^:private getCompositionsListForDecompYes ^int [this ^int norm16]
    (if (or (< norm16 JAMO_L) (<= MIN_NORMAL_MAYBE_YES norm16)) -1 (.getData this norm16)))

  (method ^:private getCompositionsListForComposite ^int [this ^int norm16]
    (let [list (.getData this norm16)
          ^int firstUnit (.charAt extraData list)]
      (unchecked-add-int (unchecked-add-int list 1) (bit-and-int firstUnit MAPPING_LENGTH_MASK))))

  (method ^:private decomposeShort ^int [this ^CharSequence s ^:mutable ^int src ^int limit
                                         ^boolean stopAtCompBoundary ^boolean onlyContiguous
                                         ^ReorderingBuffer buffer]
    (while (< src limit)
      (let [c (Character/codePointAt s src)]
        (when (and stopAtCompBoundary (< c minCompNoMaybeCP)) (return src))
        (let [norm16 (.getNorm16 this c)]
          (when (and stopAtCompBoundary (.norm16HasCompBoundaryBefore this norm16)) (return src))
          (set! src (unchecked-add-int src (Character/charCount c)))
          (.decompose this c norm16 buffer)
          (when (and stopAtCompBoundary (.norm16HasCompBoundaryAfter this norm16 onlyContiguous))
            (return src)))))
    src)

  (method ^:private decompose ^void [this ^:mutable ^int c ^:mutable ^int norm16
                                     ^ReorderingBuffer buffer]
    (when (>= norm16 limitNoNo)
      (if (.isMaybeYesOrNonZeroCC this norm16)
          (do (.append buffer c (NormalizerImpl/getCCFromYesOrMaybeYes norm16)) (return))
          (when (< norm16 minMaybeNo)
            (set! c (.mapAlgorithmic this c norm16))
            (set! norm16 (.getRawNorm16 this c)))))
    (cond
      (< norm16 minYesNo) (.append buffer c 0)
      (or (.isHangulLV this norm16) (.isHangulLVT this norm16)) (Hangul/decompose c buffer)
      :else
        (let [^:mutable mapping (.getData this norm16)
              ^int firstUnit (.charAt extraData mapping)
              length (bit-and-int firstUnit MAPPING_LENGTH_MASK)
              ^:mutable ^int leadCC 0
              ^:mutable ^int trailCC 0]
          (set! trailCC (bit-shift-right-int firstUnit 8))
          (if (not (== (bit-and-int firstUnit MAPPING_HAS_CCC_LCCC_WORD) 0))
              (set! leadCC
                    (bit-shift-right-int (.charAt extraData (unchecked-subtract-int mapping 1)) 8))
              (set! leadCC 0))
          (set! mapping (unchecked-inc-int mapping))
          (.append buffer extraData mapping (unchecked-add-int mapping length) true leadCC trailCC))))

  (method ^:private combine ^int [this ^:mutable ^int list ^int trail]
    (let [^:mutable ^int key1 0
          ^:mutable ^int firstUnit 0]
      (if (< trail COMP_1_TRAIL_LIMIT)
          (do
            (set! key1 (bit-shift-left-int trail 1))
            (while (> key1 (set! firstUnit (.charAt extraData list)))
              (set! list
                    (unchecked-add-int list
                                       (unchecked-add-int 2 (bit-and-int firstUnit COMP_1_TRIPLE)))))
            (when (== key1 (bit-and-int firstUnit COMP_1_TRAIL_MASK))
              (if (not (== (bit-and-int firstUnit COMP_1_TRIPLE) 0))
                  (return (bit-or-int (bit-shift-left-int
                                        (.charAt extraData (unchecked-add-int list 1))
                                        16)
                                      (.charAt extraData (unchecked-add-int list 2))))
                  (return (.charAt extraData (unchecked-add-int list 1))))))
          (do
            (set! key1
                  (unchecked-add-int COMP_1_TRAIL_LIMIT
                                     (bit-and-int
                                       (bit-shift-right-int trail COMP_1_TRAIL_SHIFT)
                                       (bit-not-int COMP_1_TRIPLE))))
            (let [key2 (bit-and-int (bit-shift-left-int trail COMP_2_TRAIL_SHIFT) 0xffff)
                  ^:mutable ^int secondUnit 0]
              (while true
                (cond
                  (> key1 (set! firstUnit (.charAt extraData list)))
                    (set! list
                          (unchecked-add-int list
                                             (unchecked-add-int
                                               2
                                               (bit-and-int firstUnit COMP_1_TRIPLE))))
                  (== key1 (bit-and-int firstUnit COMP_1_TRAIL_MASK))
                    (cond
                      (> key2 (set! secondUnit (.charAt extraData (unchecked-add-int list 1))))
                        (if (not (== (bit-and-int firstUnit COMP_1_LAST_TUPLE) 0))
                            (break)
                            (set! list (unchecked-add-int list 3)))
                      (== key2 (bit-and-int secondUnit COMP_2_TRAIL_MASK))
                        (return (bit-or-int (bit-shift-left-int
                                              (bit-and-int
                                                secondUnit
                                                (bit-not-int COMP_2_TRAIL_MASK))
                                              16)
                                            (.charAt extraData (unchecked-add-int list 2))))
                      :else (break))
                  :else (break))))))
      -1))

  (method ^:private recompose ^void [this ^ReorderingBuffer buffer ^int recomposeStartIndex
                                     ^boolean onlyContiguous]
    (let [sb (.getStringBuilder buffer)
          ^:mutable p recomposeStartIndex]
      (when-not (== p (.length sb))
        (let [^:mutable ^int starter 0
              ^:mutable ^int pRemove 0
              ^:mutable ^int compositionsList 0
              ^:mutable ^int c 0
              ^:mutable ^int compositeAndFwd 0
              ^:mutable ^int norm16 0
              ^:mutable ^int cc 0
              ^:mutable ^int prevCC 0
              ^:mutable ^boolean starterIsSupplementary false]
          (set! compositionsList -1)
          (set! starter -1)
          (set! starterIsSupplementary false)

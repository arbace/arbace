                                (set! (.-next ncArgs) (unchecked-inc-int (.-next ncArgs)))
                                old-5)))
                  (set! current (unchecked-inc-int current))
                  (when-not (== (.-next ncArgs) (.-limit ncArgs)) (recur)))

        (set! i 0)
        (let [^:mutable ^int count 0]
          (while (== (set! count (aget list i)) 0) (set! i (unchecked-inc-int i)))
          (aset list i 0)
          (set! length (unchecked-dec-int length))
          (set! start i)
          (when (some? outCount) (set! (.-value outCount) count))
          (unchecked-add-int result i))))))

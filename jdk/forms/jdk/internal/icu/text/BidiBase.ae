  (method ^:private addPoint ^void [this ^int pos ^int flag]
    (let [point (Point.)
          ^:mutable len (alength (.-points insertPoints))]
      (when (== len 0)
        (set! (.-points insertPoints) (new Point/1 FIRSTALLOC))
        (set! len FIRSTALLOC))
      (when (>= (.-size insertPoints) len)
        (let [savePoints (.-points insertPoints)]
          (set! (.-points insertPoints) (new Point/1 (unchecked-multiply-int len 2)))
          (System/arraycopy savePoints 0 (.-points insertPoints) 0 len)))
      (set! (.-pos point) pos)
      (set! (.-flag point) flag)
      (aset (.-points insertPoints) (.-size insertPoints) point)
      (set! (.-size insertPoints) (unchecked-inc-int (.-size insertPoints)))))

  (method ^:private setLevelsOutsideIsolates ^void [this ^int start ^int limit ^byte level]
    (let [^:mutable ^byte dirProp 0
          ^:mutable ^int isolateCount 0
          ^:mutable ^int k 0]
      (set! k start)
      (while (< k limit)
        (set! dirProp (aget dirProps k))
        (when (== dirProp PDI) (set! isolateCount (unchecked-dec-int isolateCount)))
        (when (== isolateCount 0) (aset levels k level))
        (when (or (== dirProp LRI) (== dirProp RLI))
          (set! isolateCount (unchecked-inc-int isolateCount)))
        (set! k (unchecked-inc-int k)))))

  (method ^:private processPropertySeq ^void [this ^LevState levState ^short _prop
                                              ^:mutable ^int start ^int limit]
    (let [^:mutable ^byte cell 0
          impTab (.-impTab levState)
          impAct (.-impAct levState)
          ^:mutable ^short oldStateSeq 0
          ^:mutable ^short actionSeq 0
          ^:mutable ^byte level 0
          ^:mutable ^byte addLevel 0
          ^:mutable ^int start0 0
          ^:mutable ^int k 0]
      (set! start0 start)
      (set! oldStateSeq (.-state levState))
      (set! cell (aget impTab oldStateSeq _prop))
      (set! (.-state levState) (BidiBase/GetState cell))
      (set! actionSeq (aget impAct (BidiBase/GetAction cell)))
      (set! addLevel (aget impTab (.-state levState) IMPTABLEVELS_RES))
      (when-not (== actionSeq 0)
        (switch actionSeq
          1 (set! (.-startON levState) start0)
          2 (set! start (.-startON levState))
          3
            (do
              (set! level (unchecked-byte (unchecked-add-int (.-runLevel levState) 1)))
              (.setLevelsOutsideIsolates this (.-startON levState) start0 level))
          4
            (do
              (set! level (unchecked-byte (unchecked-add-int (.-runLevel levState) 2)))
              (.setLevelsOutsideIsolates this (.-startON levState) start0 level))
          5
            (do
              (when (>= (.-startL2EN levState) 0)
                (.addPoint this (.-startL2EN levState) LRM_BEFORE))
              (set! (.-startL2EN levState) -1)
              (if (or (== (alength (.-points insertPoints)) 0)
                      (<= (.-size insertPoints) (.-confirmed insertPoints)))
                  (do
                    (set! (.-lastStrongRTL levState) -1)
                    (set! level (aget impTab oldStateSeq IMPTABLEVELS_RES))
                    (when (and (not (== (bit-and-int level 1) 0)) (> (.-startON levState) 0))
                      (set! start (.-startON levState)))
                    (when (== _prop _S)
                      (.addPoint this start0 LRM_BEFORE)
                      (set! (.-confirmed insertPoints) (.-size insertPoints))))
                  (do
                    (set! k (unchecked-add-int (.-lastStrongRTL levState) 1))
                    (while (< k start0)
                      (aset levels
                            k
                            (unchecked-byte
                              (bit-and-int (unchecked-subtract-int (aget levels k) 2)
                                           (bit-not-int 1))))
                      (set! k (unchecked-inc-int k)))
                    (set! (.-confirmed insertPoints) (.-size insertPoints))
                    (set! (.-lastStrongRTL levState) -1)
                    (when (== _prop _S)
                      (.addPoint this start0 LRM_BEFORE)
                      (set! (.-confirmed insertPoints) (.-size insertPoints))))))
          6
            (do
              (when (> (alength (.-points insertPoints)) 0)
                (set! (.-size insertPoints) (.-confirmed insertPoints)))
              (set! (.-startON levState) -1)
              (set! (.-startL2EN levState) -1)
              (set! (.-lastStrongRTL levState) (unchecked-subtract-int limit 1)))
          7
            (cond
              (and (and (== _prop _AN) (== (aget dirProps start0) AN))
                   (not (== reorderingMode REORDER_INVERSE_FOR_NUMBERS_SPECIAL)))
                (if (== (.-startL2EN levState) -1)
                    (set! (.-lastStrongRTL levState) (unchecked-subtract-int limit 1))
                    (do
                      (when (>= (.-startL2EN levState) 0)
                        (.addPoint this (.-startL2EN levState) LRM_BEFORE)
                        (set! (.-startL2EN levState) -2))
                      (.addPoint this start0 LRM_BEFORE)))
              (== (.-startL2EN levState) -1) (set! (.-startL2EN levState) start0))
          8
            (do
              (set! (.-lastStrongRTL levState) (unchecked-subtract-int limit 1))
              (set! (.-startON levState) -1))
          9
            (do
              (set! k (unchecked-subtract-int start0 1))
              (while (and (>= k 0) (== (bit-and-int (aget levels k) 1) 0))
                (set! k (unchecked-dec-int k)))
              (when (>= k 0)
                (.addPoint this k RLM_BEFORE)
                (set! (.-confirmed insertPoints) (.-size insertPoints)))
              (set! (.-startON levState) start0))
          10 (do (.addPoint this start0 LRM_BEFORE) (.addPoint this start0 LRM_AFTER))
          11
            (do
              (set! (.-size insertPoints) (.-confirmed insertPoints))
              (when (== _prop _S)
                (.addPoint this start0 RLM_BEFORE)
                (set! (.-confirmed insertPoints) (.-size insertPoints))))
          12
            (do
              (set! level (unchecked-byte (unchecked-add-int (.-runLevel levState) addLevel)))
              (set! k (.-startON levState))
              (while (< k start0)
                (when (< (aget levels k) level) (aset levels k level))
                (set! k (unchecked-inc-int k)))
              (set! (.-confirmed insertPoints) (.-size insertPoints))
              (set! (.-startON levState) start0))
          13
            (do
              (set! level (.-runLevel levState))
              (set! k (unchecked-subtract-int start0 1))
              (while (>= k (.-startON levState))
                (when (== (aget levels k) (unchecked-add-int level 3))
                  (while (== (aget levels k) (unchecked-add-int level 3))
                    (aset levels k (unchecked-byte (unchecked-subtract-int (aget levels k) 2)))
                    (set! k (unchecked-dec-int k)))
                  (while (== (aget levels k) level) (set! k (unchecked-dec-int k))))
                (if (== (aget levels k) (unchecked-add-int level 2))
                    (aset levels k level)
                    (aset levels k (unchecked-byte (unchecked-add-int level 1))))
                (set! k (unchecked-dec-int k))))
          14
            (do
              (set! level (unchecked-byte (unchecked-add-int (.-runLevel levState) 1)))
              (set! k (unchecked-subtract-int start0 1))
              (while (>= k (.-startON levState))
                (when (> (aget levels k) level)
                  (aset levels k (unchecked-byte (unchecked-subtract-int (aget levels k) 2))))
                (set! k (unchecked-dec-int k))))
          (throw (IllegalStateException. "Internal ICU error in processPropertySeq"))))
      (when (or (not (== addLevel 0)) (< start start0))
        (set! level (unchecked-byte (unchecked-add-int (.-runLevel levState) addLevel)))
        (if (>= start (.-runStart levState))
            (do
              (set! k start)
              (while (< k limit) (aset levels k level) (set! k (unchecked-inc-int k))))
            (.setLevelsOutsideIsolates this start limit level)))))

  (method ^:private resolveImplicitLevels ^void [this ^int start ^int limit ^short sor ^short eor]
    (let [^:mutable ^byte dirProp 0
          levState (LevState.)
          ^:mutable ^int i 0
          ^:mutable ^int start1 0
          ^:mutable ^int start2 0
          ^:mutable ^short oldStateImp 0
          ^:mutable ^short stateImp 0
          ^:mutable ^short actionImp 0
          ^:mutable ^short gprop 0
          ^:mutable ^short resProp 0
          ^:mutable ^short cell 0
          ^:mutable ^boolean inverseRTL false
          ^:mutable ^short nextStrongProp R
          ^:mutable ^int nextStrongPos -1]
      (set! inverseRTL
            (and (and (< start lastArabicPos) (> (bit-and-int (.GetParaLevelAt this start) 1) 0))
                 (or (== reorderingMode REORDER_INVERSE_LIKE_DIRECT)
                     (== reorderingMode REORDER_INVERSE_FOR_NUMBERS_SPECIAL))))
      (set! (.-startL2EN levState) -1)
      (set! (.-lastStrongRTL levState) -1)
      (set! (.-runStart levState) start)
      (set! (.-runLevel levState) (aget levels start))
      (set! (.-impTab levState) (aget (.-imptab impTabPair) (bit-and-int (.-runLevel levState) 1)))
      (set! (.-impAct levState) (aget (.-impact impTabPair) (bit-and-int (.-runLevel levState) 1)))
      (if (== (aget dirProps start) PDI)
          (do
            (set! (.-startON levState) (.-startON (aget isolates isolateCount)))
            (set! start1 (.-start1 (aget isolates isolateCount)))
            (set! stateImp (.-stateImp (aget isolates isolateCount)))
            (set! (.-state levState) (.-state (aget isolates isolateCount)))
            (set! isolateCount (unchecked-dec-int isolateCount)))
          (do
            (set! (.-startON levState) -1)
            (set! start1 start)
            (if (== (aget dirProps start) NSM)
                (set! stateImp (unchecked-short (unchecked-add-int 1 sor)))
                (set! stateImp 0))
            (set! (.-state levState) 0)
            (.processPropertySeq this levState sor start start)))
      (set! start2 start)
      (set! i start)
      (while (<= i limit)
        (if (>= i limit)
            (let [^:mutable ^int k 0]
              (set! k (unchecked-subtract-int limit 1))
              (while (and (> k start)
                          (not (== (bit-and-int (BidiBase/DirPropFlag (aget dirProps k))
                                                MASK_BN_EXPLICIT)
                                   0)))
                (set! k (unchecked-dec-int k)))
              (set! dirProp (aget dirProps k))
              (when (or (== dirProp LRI) (== dirProp RLI)) (break))
              (set! gprop eor))
            (let [^:mutable ^byte prop 0
                  ^:mutable ^byte prop1 0]
              (set! prop (aget dirProps i))
              (when (== prop B) (set! isolateCount -1))
              (when inverseRTL
                (if (== prop AL)
                    (set! prop R)
                    (when (== prop EN)
                      (when (<= nextStrongPos i)
                        (let [^:mutable ^int j 0]
                          (set! nextStrongProp R)
                          (set! nextStrongPos limit)
                          (set! j (unchecked-add-int i 1))
                          (while (< j limit)
                            (set! prop1 (aget dirProps j))
                            (when (or (or (== prop1 L) (== prop1 R)) (== prop1 AL))
                              (set! nextStrongProp prop1)
                              (set! nextStrongPos j)
                              (break))
                            (set! j (unchecked-inc-int j)))))
                      (when (== nextStrongProp AL) (set! prop AN)))))
              (set! gprop (aget groupProp prop))))
        (set! oldStateImp stateImp)
        (set! cell (aget impTabProps oldStateImp gprop))
        (set! stateImp (BidiBase/GetStateProps cell))
        (set! actionImp (BidiBase/GetActionProps cell))
        (when (and (== i limit) (== actionImp 0)) (set! actionImp 1))
        (when-not (== actionImp 0)
          (set! resProp (aget impTabProps oldStateImp IMPTABPROPS_RES))
          (switch actionImp
            1 (do (.processPropertySeq this levState resProp start1 i) (set! start1 i))
            2 (set! start2 i)
            3
              (do
                (.processPropertySeq this levState resProp start1 start2)
                (.processPropertySeq this levState _ON start2 i)
                (set! start1 i))
            4
              (do
                (.processPropertySeq this levState resProp start1 start2)
                (set! start1 start2)
                (set! start2 i))
            (throw (IllegalStateException. "Internal ICU error in resolveImplicitLevels"))))
        (set! i (unchecked-inc-int i)))
      (set! i (unchecked-subtract-int limit 1))
      (while (and (> i start)
                  (not (== (bit-and-int (BidiBase/DirPropFlag (aget dirProps i)) MASK_BN_EXPLICIT)
                           0)))
        (set! i (unchecked-dec-int i)))
      (set! dirProp (aget dirProps i))
      (if (and (or (== dirProp LRI) (== dirProp RLI)) (< limit length))
          (do
            (set! isolateCount (unchecked-inc-int isolateCount))
            (when (nil? (aget isolates isolateCount)) (aset isolates isolateCount (Isolate.)))
            (set! (.-stateImp (aget isolates isolateCount)) stateImp)
            (set! (.-state (aget isolates isolateCount)) (.-state levState))
            (set! (.-start1 (aget isolates isolateCount)) start1)
            (set! (.-startON (aget isolates isolateCount)) (.-startON levState)))
          (.processPropertySeq this levState eor limit limit))))

  (method ^:private adjustWSLevels ^void [this]
    (let [^:mutable ^int i 0]
      (when-not (== (bit-and-int flags MASK_WS) 0)
        (let [^:mutable ^int flag 0]
          (set! i trailingWSStart)
          (while (> i 0)
            (while (and (> i 0)
                        (not (== (bit-and-int (set!
                                                flag
                                                (BidiBase/DirPropFlag
                                                  (aget dirProps (set! i (unchecked-dec-int i)))))
                                              MASK_WS)
                                 0)))
              (if (and orderParagraphsLTR (not (== (bit-and-int flag (BidiBase/DirPropFlag B)) 0)))
                  (aset levels i 0)
                  (aset levels i (.GetParaLevelAt this i))))
            (while (> i 0)
              (set! flag (BidiBase/DirPropFlag (aget dirProps (set! i (unchecked-dec-int i)))))
              (cond
                (not (== (bit-and-int flag MASK_BN_EXPLICIT) 0))
                  (aset levels i (aget levels (unchecked-add-int i 1)))
                (and orderParagraphsLTR (not (== (bit-and-int flag (BidiBase/DirPropFlag B)) 0)))
                  (do (aset levels i 0) (break))
                :else
                  (when-not (== (bit-and-int flag MASK_B_S) 0)
                    (aset levels i (.GetParaLevelAt this i))
                    (break)))))))))

  (method ^:private setParaSuccess ^void [this] (set! paraBidi this))

  (method ^:private Bidi_Min ^int [this ^int x ^int y] (if (< x y) x y))

  (method ^:private Bidi_Abs ^int [this ^int x]
    (if (>= x 0) x (unchecked-negate-int x)))

  (method setParaRunsOnly ^void [this ^char/1 parmText ^:mutable ^byte parmParaLevel]
    (let [^:mutable ^int/1 visualMap nil
          ^:mutable ^String visualText nil
          ^:mutable ^int saveLength 0
          ^:mutable ^int saveTrailingWSStart 0
          ^:mutable ^byte/1 saveLevels nil
          ^:mutable ^byte saveDirection 0
          ^:mutable ^int i 0
          ^:mutable ^int j 0
          ^:mutable ^int visualStart 0
          ^:mutable ^int logicalStart 0
          ^:mutable ^int oldRunCount 0
          ^:mutable ^int runLength 0
          ^:mutable ^int addedRuns 0
          ^:mutable ^int insertRemove 0
          ^:mutable ^int start 0
          ^:mutable ^int limit 0
          ^:mutable ^int step 0
          ^:mutable ^int indexOddBit 0
          ^:mutable ^int logicalPos 0
          ^:mutable ^int index 0
          ^:mutable ^int index1 0
          ^:mutable ^int saveOptions 0]
      (set! reorderingMode REORDER_DEFAULT)
      (let [parmLength (alength parmText)]
        (if (== parmLength 0)
            (do (.setPara this parmText parmParaLevel nil) (set! reorderingMode REORDER_RUNS_ONLY))
            (do
              (set! saveOptions reorderingOptions)
              (when (> (bit-and-int saveOptions OPTION_INSERT_MARKS) 0)
                (set! reorderingOptions
                      (bit-and-int reorderingOptions (bit-not-int OPTION_INSERT_MARKS)))
                (set! reorderingOptions (bit-or-int reorderingOptions OPTION_REMOVE_CONTROLS)))
              (set! parmParaLevel (unchecked-byte (bit-and-int parmParaLevel 1)))
              (.setPara this parmText parmParaLevel nil)
              (set! saveLevels (new byte/1 (.-length this)))
              (System/arraycopy (.getLevels this) 0 saveLevels 0 (.-length this))
              (set! saveTrailingWSStart trailingWSStart)
              (set! visualText (.writeReordered this DO_MIRRORING))
              (set! visualMap (.getVisualMap this))
              (set! (.-reorderingOptions this) saveOptions)
              (set! saveLength (.-length this))
              (set! saveDirection (.-direction this))
              (set! (.-reorderingMode this) REORDER_INVERSE_LIKE_DIRECT)
              (set! parmParaLevel (unchecked-byte (bit-xor-int parmParaLevel 1)))
              (.setPara this visualText parmParaLevel nil)
              (BidiLine/getRuns this)
              (set! addedRuns 0)
              (set! oldRunCount (.-runCount this))
              (set! visualStart 0)
              (set! i 0)
              (while (< i oldRunCount)
                (set! runLength (unchecked-subtract-int (.-limit (aget runs i)) visualStart))
                (when-not (< runLength 2)
                  (set! logicalStart (.-start (aget runs i)))
                  (set! j (unchecked-add-int logicalStart 1))
                  (while (< j (unchecked-add-int logicalStart runLength))
                    (set! index (aget visualMap j))
                    (set! index1 (aget visualMap (unchecked-subtract-int j 1)))
                    (when (or (not (== (.Bidi_Abs this (unchecked-subtract-int index index1)) 1))
                              (not (== (aget saveLevels index) (aget saveLevels index1))))
                      (set! addedRuns (unchecked-inc-int addedRuns)))
                    (set! j (unchecked-inc-int j))))
                (set! i (unchecked-inc-int i))
                (set! visualStart (unchecked-add-int visualStart runLength)))
              (when (> addedRuns 0)
                (.getRunsMemory this (unchecked-add-int oldRunCount addedRuns))
                (if (== runCount 1)
                    (aset runsMemory 0 (aget runs 0))
                    (System/arraycopy runs 0 runsMemory 0 runCount))
                (set! runs runsMemory)
                (set! runCount (unchecked-add-int runCount addedRuns))
                (set! i oldRunCount)
                (while (< i runCount)
                  (when (nil? (aget runs i)) (aset runs i (BidiRun. 0 0 (unchecked-byte 0))))
                  (set! i (unchecked-inc-int i))))
              (let [^:mutable ^int newI 0]
                (set! i (unchecked-subtract-int oldRunCount 1))
                (while (>= i 0)
                  (set! newI (unchecked-add-int i addedRuns))
                  (set! runLength
                        (if (== i 0)
                            (.-limit (aget runs 0))
                            (unchecked-subtract-int
                              (.-limit (aget runs i))
                              (.-limit (aget runs (unchecked-subtract-int i 1))))))
                  (set! logicalStart (.-start (aget runs i)))
                  (set! indexOddBit (bit-and-int (.-level (aget runs i)) 1))
                  (if (< runLength 2)
                      (do
                        (when (> addedRuns 0) (.copyFrom (aget runs newI) (aget runs i)))
                        (set! logicalPos (aget visualMap logicalStart))
                        (set! (.-start (aget runs newI)) logicalPos)
                        (set! (.-level (aget runs newI))
                              (unchecked-byte
                                (bit-xor-int (aget saveLevels logicalPos) indexOddBit))))
                      (do
                        (if (> indexOddBit 0)
                            (do
                              (set! start logicalStart)
                              (set! limit
                                    (unchecked-subtract-int
                                      (unchecked-add-int logicalStart runLength)
                                      1))
                              (set! step 1))
                            (do
                              (set! start
                                    (unchecked-subtract-int
                                      (unchecked-add-int logicalStart runLength)
                                      1))
                              (set! limit logicalStart)
                              (set! step -1)))
                        (set! j start)
                        (while (not (== j limit))
                          (set! index (aget visualMap j))
                          (set! index1 (aget visualMap (unchecked-add-int j step)))
                          (when (or (not (== (.Bidi_Abs this (unchecked-subtract-int index index1))
                                             1))
                                    (not (== (aget saveLevels index) (aget saveLevels index1))))
                            (set! logicalPos (.Bidi_Min this (aget visualMap start) index))
                            (set! (.-start (aget runs newI)) logicalPos)
                            (set! (.-level (aget runs newI))
                                  (unchecked-byte
                                    (bit-xor-int (aget saveLevels logicalPos) indexOddBit)))
                            (set! (.-limit (aget runs newI)) (.-limit (aget runs i)))
                            (let [o-4 (aget runs i)]
                              (set! (.-limit o-4)
                                    (unchecked-subtract-int
                                      (.-limit o-4)
                                      (unchecked-add-int
                                        (.Bidi_Abs this (unchecked-subtract-int j start))
                                        1))))
                            (set! insertRemove
                                  (bit-and-int (.-insertRemove (aget runs i))
                                               (bit-or-int LRM_AFTER RLM_AFTER)))
                            (set! (.-insertRemove (aget runs newI)) insertRemove)
                            (let [o-5 (aget runs i)]
                              (set! (.-insertRemove o-5)
                                    (bit-and-int (.-insertRemove o-5) (bit-not-int insertRemove))))
                            (set! start (unchecked-add-int j step))
                            (set! addedRuns (unchecked-dec-int addedRuns))
                            (set! newI (unchecked-dec-int newI)))
                          (set! j (unchecked-add-int j step)))
                        (when (> addedRuns 0) (.copyFrom (aget runs newI) (aget runs i)))
                        (set! logicalPos
                              (.Bidi_Min this (aget visualMap start) (aget visualMap limit)))
                        (set! (.-start (aget runs newI)) logicalPos)
                        (set! (.-level (aget runs newI))
                              (unchecked-byte
                                (bit-xor-int (aget saveLevels logicalPos) indexOddBit)))))
                  (set! i (unchecked-dec-int i)))
                (set! (.-paraLevel this) (unchecked-byte (bit-xor-int (.-paraLevel this) 1)))
                (set! (.-text this) parmText)
                (set! (.-length this) saveLength)
                (set! (.-originalLength this) parmLength)
                (set! (.-direction this) saveDirection)
                (set! (.-levels this) saveLevels)
                (set! (.-trailingWSStart this) saveTrailingWSStart)
                (when (> runCount 1) (set! (.-direction this) MIXED))
                (set! (.-reorderingMode this) REORDER_RUNS_ONLY)))))))

  (method setPara ^void [this ^String text ^byte paraLevel ^byte/1 embeddingLevels]
    (if (nil? text)
        (.setPara this (new char/1 0) paraLevel embeddingLevels)
        (.setPara this (.toCharArray text) paraLevel embeddingLevels)))

  (method setPara ^void [this ^:mutable ^char/1 chars ^byte paraLevel ^byte/1 embeddingLevels]
    (when (< paraLevel LEVEL_DEFAULT_LTR)
      (.verifyRange this paraLevel 0 (unchecked-add-int MAX_EXPLICIT_LEVEL 1)))
    (when (nil? chars) (set! chars (new char/1 0)))
    (if (== reorderingMode REORDER_RUNS_ONLY)
        (.setParaRunsOnly this chars paraLevel)
        (do
          (set! (.-paraBidi this) nil)
          (set! (.-text this) chars)
          (set! (.-length this)
                (set! (.-originalLength this) (set! (.-resultLength this) (alength text))))
          (set! (.-paraLevel this) paraLevel)
          (set! (.-direction this) (unchecked-byte (bit-and-int paraLevel 1)))
          (set! (.-paraCount this) 1)
          (set! dirProps (new byte/1 0))
          (set! levels (new byte/1 0))
          (set! runs (new BidiRun/1 0))
          (set! isGoodLogicalToVisualRunsMap false)
          (set! (.-size insertPoints) 0)
          (set! (.-confirmed insertPoints) 0)
          (set! defaultParaLevel (if (BidiBase/IsDefaultLevel paraLevel) paraLevel 0))
          (if (== length 0)
              (do
                (when (BidiBase/IsDefaultLevel paraLevel)
                  (set! (.-paraLevel this) (unchecked-byte (bit-and-int (.-paraLevel this) 1)))
                  (set! defaultParaLevel 0))
                (set! flags (BidiBase/DirPropFlagLR paraLevel))
                (set! runCount 0)
                (set! paraCount 0)
                (.setParaSuccess this))
              (do
                (set! runCount -1)
                (.getDirPropsMemory this length)
                (set! dirProps dirPropsMemory)
                (.getDirProps this)
                (set! trailingWSStart length)
                (if (nil? embeddingLevels)
                    (do
                      (.getLevelsMemory this length)
                      (set! levels levelsMemory)
                      (set! direction (.resolveExplicitLevels this)))
                    (do (set! levels embeddingLevels) (set! direction (.checkExplicitLevels this))))
                (when (> isolateCount 0)
                  (when (or (nil? isolates) (< (alength isolates) isolateCount))
                    (set! isolates (new Isolate/1 (unchecked-add-int isolateCount 3)))))
                (set! isolateCount -1)
                (switch direction
                  LTR (set! trailingWSStart 0)
                  RTL (set! trailingWSStart 0)
                  (do
                    (switch reorderingMode
                      REORDER_DEFAULT (set! (.-impTabPair this) impTab_DEFAULT)
                      REORDER_NUMBERS_SPECIAL (set! (.-impTabPair this) impTab_NUMBERS_SPECIAL)
                      REORDER_GROUP_NUMBERS_WITH_R
                        (set! (.-impTabPair this) impTab_GROUP_NUMBERS_WITH_R)
                      REORDER_RUNS_ONLY (throw (InternalError. "Internal ICU error in setPara"))
                      REORDER_INVERSE_NUMBERS_AS_L
                        (set! (.-impTabPair this) impTab_INVERSE_NUMBERS_AS_L)
                      REORDER_INVERSE_LIKE_DIRECT
                        (if (not (== (bit-and-int reorderingOptions OPTION_INSERT_MARKS) 0))
                            (set! (.-impTabPair this) impTab_INVERSE_LIKE_DIRECT_WITH_MARKS)
                            (set! (.-impTabPair this) impTab_INVERSE_LIKE_DIRECT))
                      REORDER_INVERSE_FOR_NUMBERS_SPECIAL
                        (if (not (== (bit-and-int reorderingOptions OPTION_INSERT_MARKS) 0))
                            (set! (.-impTabPair this) impTab_INVERSE_FOR_NUMBERS_SPECIAL_WITH_MARKS)
                            (set! (.-impTabPair this) impTab_INVERSE_FOR_NUMBERS_SPECIAL)))
                    (if (and (and (nil? embeddingLevels) (<= paraCount 1))
                             (== (bit-and-int flags DirPropFlagMultiRuns) 0))
                        (.resolveImplicitLevels this
                                                0
                                                length
                                                (BidiBase/GetLRFromLevel (.GetParaLevelAt this 0))
                                                (BidiBase/GetLRFromLevel
                                                  (.GetParaLevelAt
                                                    this
                                                    (unchecked-subtract-int length 1))))
                        (let [^:mutable ^int start 0
                              ^:mutable ^int limit 0
                              ^:mutable ^byte level 0
                              ^:mutable ^byte nextLevel 0
                              ^:mutable ^short sor 0
                              ^:mutable ^short eor 0]
                          (set! level (.GetParaLevelAt this 0))
                          (set! nextLevel (aget levels 0))
                          (if (< level nextLevel)
                              (set! eor (BidiBase/GetLRFromLevel nextLevel))
                              (set! eor (BidiBase/GetLRFromLevel level)))
                          (loop []
                            (set! start limit)
                            (set! level nextLevel)
                            (if (and (> start 0)
                                     (== (aget dirProps (unchecked-subtract-int start 1)) B))
                                (set! sor (BidiBase/GetLRFromLevel (.GetParaLevelAt this start)))
                                (set! sor eor))
                            (while (and (< (set! limit (unchecked-inc-int limit)) length)
                                        (or (== (aget levels limit) level)
                                            (not
                                              (==
                                                (bit-and-int
                                                  (BidiBase/DirPropFlag (aget dirProps limit))
                                                  MASK_BN_EXPLICIT)
                                                0)))))
                            (if (< limit length)
                                (set! nextLevel (aget levels limit))
                                (set! nextLevel
                                      (.GetParaLevelAt this (unchecked-subtract-int length 1))))
                            (if (< (BidiBase/NoOverride level) (BidiBase/NoOverride nextLevel))
                                (set! eor (BidiBase/GetLRFromLevel nextLevel))
                                (set! eor (BidiBase/GetLRFromLevel level)))
                            (if (== (bit-and-int level LEVEL_OVERRIDE) 0)
                                (.resolveImplicitLevels this start limit sor eor)
                                (loop []
                                  (aset levels
                                        start
                                        (unchecked-byte
                                          (bit-and-int
                                            (aget levels start)
                                            (bit-not-int LEVEL_OVERRIDE))))
                                  (set! start (unchecked-inc-int start))
                                  (when (< start limit) (recur))))
                            (when (< limit length) (recur)))))
                    (.adjustWSLevels this)))
                (when (and (and (> defaultParaLevel 0)
                                (not (== (bit-and-int reorderingOptions OPTION_INSERT_MARKS) 0)))
                           (or (== reorderingMode REORDER_INVERSE_LIKE_DIRECT)
                               (== reorderingMode REORDER_INVERSE_FOR_NUMBERS_SPECIAL)))
                  (let [^:mutable ^int start 0
                        ^:mutable ^int last 0
                        ^:mutable ^byte level 0
                        ^:mutable ^byte dirProp 0]
                    (loop [^int i 0]
                      (when (< i paraCount)
                        (set! last (unchecked-subtract-int (aget paras_limit i) 1))
                        (set! level (aget paras_level i))
                        (if (== level 0)
                            (recur (unchecked-inc-int i))
                            (do
                              (set! start
                                    (if (== i 0) 0 (aget paras_limit (unchecked-subtract-int i 1))))
                              (loop [^int j last]
                                (when (>= j start)
                                  (set! dirProp (aget dirProps j))
                                  (if (== dirProp L)
                                      (do
                                        (when (< j last)
                                          (while (== (aget dirProps last) B)
                                            (set! last (unchecked-dec-int last))))
                                        (.addPoint this last RLM_BEFORE))
                                      (when-not (not
                                                  (==
                                                    (bit-and-int
                                                      (BidiBase/DirPropFlag dirProp)
                                                      MASK_R_AL)
                                                    0))
                                        (recur (unchecked-dec-int j))))))
                              (recur (unchecked-inc-int i))))))))
                (if (not (== (bit-and-int reorderingOptions OPTION_REMOVE_CONTROLS) 0))
                    (set! resultLength (unchecked-subtract-int resultLength controlCount))
                    (set! resultLength (unchecked-add-int resultLength (.-size insertPoints))))
                (.setParaSuccess this))))))

  (method ^:public setPara ^void [this ^AttributedCharacterIterator paragraph]
    (let [^:mutable ^byte paraLvl 0
          ^:mutable ch (.first paragraph)
          runDirection (cast Boolean (.getAttribute paragraph TextAttributeConstants/RUN_DIRECTION))
          shaper (.getAttribute paragraph TextAttributeConstants/NUMERIC_SHAPING)]
      (if (nil? runDirection)
          (set! paraLvl LEVEL_DEFAULT_LTR)
          (set! paraLvl
                (if (.equals runDirection TextAttributeConstants/RUN_DIRECTION_LTR) LTR RTL)))
      (let [^:mutable ^byte/1 lvls nil
            len (unchecked-subtract-int (.getEndIndex paragraph) (.getBeginIndex paragraph))
            embeddingLevels (new byte/1 len)
            txt (new char/1 len)
            ^:mutable ^int i 0]
        (while (not (== ch AttributedCharacterIterator/DONE))
          (aset txt i ch)
          (let [embedding (cast Integer
                                (.getAttribute paragraph TextAttributeConstants/BIDI_EMBEDDING))]
            (when (some? embedding)
              (let [level (.byteValue embedding)]
                (when-not (== level 0)
                  (if (< level 0)
                      (do
                        (set! lvls embeddingLevels)
                        (aset embeddingLevels
                              i
                              (unchecked-byte
                                (bit-or-int (unchecked-subtract-int 0 level) LEVEL_OVERRIDE))))
                      (do (set! lvls embeddingLevels) (aset embeddingLevels i level))))))
            (set! ch (.next paragraph))
            (set! i (unchecked-inc-int i))))
        (when (some? shaper) (NumericShapings/shape shaper txt 0 len))
        (.setPara this txt paraLvl lvls))))

  (method ^:public orderParagraphsLTR ^void [this ^boolean ordarParaLTR]
    (set! orderParagraphsLTR ordarParaLTR))

  (method ^:public getDirection ^byte [this]
    (.verifyValidParaOrLine this)
    direction)

  (method ^:public getLength ^int [this]
    (.verifyValidParaOrLine this)
    originalLength)

  (method ^:public getParaLevel ^byte [this]
    (.verifyValidParaOrLine this)
    paraLevel)

  (method ^:public getCustomizedClass ^int [this ^int c]
    (let [^:mutable ^int dir 0]
      (set! dir (.getClass bdp c))
      (when (>= dir CHAR_DIRECTION_COUNT) (set! dir ON))
      dir))

  (method ^:public setLine ^Bidi [this ^Bidi bidi ^BidiBase bidiBase ^Bidi newBidi
                                  ^BidiBase newBidiBase ^int start ^int limit]
    (.verifyValidPara this)
    (.verifyRange this start 0 limit)
    (.verifyRange this limit 0 (unchecked-add-int length 1))
    (BidiLine/setLine this newBidi newBidiBase start limit))

  (method ^:public getLevelAt ^byte [this ^int charIndex]
    (if (or (< charIndex 0) (>= charIndex length))
        (unchecked-byte (.getBaseLevel this))
        (do
          (.verifyValidParaOrLine this)
          (.verifyRange this charIndex 0 length)
          (BidiLine/getLevelAt this charIndex))))

  (method getLevels ^byte/1 [this]
    (.verifyValidParaOrLine this)
    (if (<= length 0) (new byte/1 0) (BidiLine/getLevels this)))

  (method ^:public countRuns ^int [this]
    (.verifyValidParaOrLine this)
    (BidiLine/getRuns this)
    runCount)

  (method getVisualRun ^BidiRun [this ^int runIndex]
    (.verifyValidParaOrLine this)
    (BidiLine/getRuns this)
    (.verifyRange this runIndex 0 runCount)
    (BidiLine/getVisualRun this runIndex))

  (method ^:private getVisualMap ^int/1 [this]
    (.countRuns this)
    (if (<= resultLength 0) (new int/1 0) (BidiLine/getVisualMap this)))

  (method ^:private ^:static reorderVisual ^int/1 [^byte/1 levels]
    (BidiLine/reorderVisual levels))

  (field ^:public ^:static ^:final ^int DIRECTION_DEFAULT_RIGHT_TO_LEFT LEVEL_DEFAULT_RTL)

  (constructor ^:public [this ^char/1 text ^int textStart ^byte/1 embeddings ^int embStart
                         ^int paragraphLength ^int flags]
    (this. 0 0)
    (let [^:mutable ^byte paraLvl 0]
      (switch flags
        Bidi/DIRECTION_RIGHT_TO_LEFT (set! paraLvl RTL)
        Bidi/DIRECTION_DEFAULT_LEFT_TO_RIGHT (set! paraLvl LEVEL_DEFAULT_LTR)
        Bidi/DIRECTION_DEFAULT_RIGHT_TO_LEFT (set! paraLvl LEVEL_DEFAULT_RTL)
        (set! paraLvl LTR))
      (let [^:mutable ^byte/1 paraEmbeddings nil]
        (if (nil? embeddings)
            (set! paraEmbeddings nil)
            (do
              (set! paraEmbeddings (new byte/1 paragraphLength))
              (let [^:mutable ^byte lev 0]
                (loop [^int i 0]
                  (when (< i paragraphLength)
                    (set! lev (aget embeddings (unchecked-add-int i embStart)))
                    (if (< lev 0)
                        (set! lev
                              (unchecked-byte
                                (bit-or-int (unchecked-negate-int lev) LEVEL_OVERRIDE)))
                        (when (== lev 0)
                          (set! lev paraLvl)
                          (when (> paraLvl MAX_EXPLICIT_LEVEL)
                            (set! lev (unchecked-byte (bit-and-int lev 1))))))
                    (aset paraEmbeddings i lev)
                    (recur (unchecked-inc-int i)))))))
        (let [paraText (new char/1 paragraphLength)]
          (System/arraycopy text textStart paraText 0 paragraphLength)
          (.setPara this paraText paraLvl paraEmbeddings)))))

  (method ^:public isMixed ^boolean [this]
    (and (not (.isLeftToRight this)) (not (.isRightToLeft this))))

  (method ^:public isLeftToRight ^boolean [this]
    (and (== (.getDirection this) LTR) (== (bit-and-int paraLevel 1) 0)))

  (method ^:public isRightToLeft ^boolean [this]
    (and (== (.getDirection this) RTL) (== (bit-and-int paraLevel 1) 1)))

  (method ^:public baseIsLeftToRight ^boolean [this]
    (== (.getParaLevel this) LTR))

  (method ^:public getBaseLevel ^int [this] (.getParaLevel this))

  (method getLogicalToVisualRunsMap ^void [this]
    (when-not isGoodLogicalToVisualRunsMap
      (let [count (.countRuns this)]
        (when (or (nil? logicalToVisualRunsMap) (< (alength logicalToVisualRunsMap) count))
          (set! logicalToVisualRunsMap (new int/1 count)))
        (let [^:mutable ^int i 0
              keys (new long/1 count)]
          (set! i 0)
          (while (< i count)
            (aset keys i (unchecked-add (bit-shift-left (long (.-start (aget runs i))) 32) i))
            (set! i (unchecked-inc-int i)))
          (Arrays/sort keys)
          (set! i 0)
          (while (< i count)
            (aset logicalToVisualRunsMap
                  i
                  (unchecked-int (bit-and (aget keys i) (unchecked-int 0x00000000FFFFFFFF))))
            (set! i (unchecked-inc-int i)))
          (set! isGoodLogicalToVisualRunsMap true)))))

  (method ^:public getRunLevel ^int [this ^int run]
    (.verifyValidParaOrLine this)
    (BidiLine/getRuns this)
    (if (or (< run 0) (>= run runCount))
        (.getParaLevel this)
        (do
          (.getLogicalToVisualRunsMap this)
          (.-level (aget runs (aget logicalToVisualRunsMap run))))))

  (method ^:public getRunStart ^int [this ^int run]
    (.verifyValidParaOrLine this)
    (BidiLine/getRuns this)
    (cond
      (== runCount 1) 0
      (== run runCount) length
      :else
        (do
          (.getLogicalToVisualRunsMap this)
          (.-start (aget runs (aget logicalToVisualRunsMap run))))))

  (method ^:public getRunLimit ^int [this ^int run]
    (.verifyValidParaOrLine this)
    (BidiLine/getRuns this)
    (if (== runCount 1)
        length
        (do
          (.getLogicalToVisualRunsMap this)
          (let [idx (aget logicalToVisualRunsMap run)
                ^int len (if (== idx 0)
                             (.-limit (aget runs idx))
                             (unchecked-subtract-int
                               (.-limit (aget runs idx))
                               (.-limit (aget runs (unchecked-subtract-int idx 1)))))]
            (unchecked-add-int (.-start (aget runs idx)) len)))))

  (method ^:public ^:static requiresBidi ^boolean [^char/1 text ^int start ^int limit]
    (let [^:const RTLMask (bit-or-int (bit-or-int
                                        (bit-or-int
                                          (bit-or-int
                                            (bit-shift-left-int 1 R)
                                            (bit-shift-left-int 1 AL))
                                          (bit-shift-left-int 1 RLE))
                                        (bit-shift-left-int 1 RLO))
                                      (bit-shift-left-int 1 AN))]
      (when (or (or (> 0 start) (> start limit)) (> limit (alength text)))
        (throw (IllegalArgumentException.
                 (java-str "Value start "
                           start
                           " is out of range 0 to "
                           limit
                           ", or limit "
                           limit
                           " is beyond the text length "
                           (alength text)))))
      (loop [^int i start]
        (when (< i limit)
          (cond
            (and (and (Character/isHighSurrogate (aget text i))
                      (< i (unchecked-subtract-int limit 1)))
                 (Character/isLowSurrogate (aget text (unchecked-add-int i 1))))
              (if (not (== (bit-and-int (bit-shift-left-int
                                          1
                                          (UCharacter/getDirection (Character/codePointAt text i)))
                                        RTLMask)
                           0))
                  (return true)
                  (recur (unchecked-inc-int i)))
            (not (== (bit-and-int (bit-shift-left-int 1 (UCharacter/getDirection (aget text i)))
                                  RTLMask)
                     0))
              (return true)
            :else (recur (unchecked-inc-int i)))))
      false))

  (method ^:public ^:static reorderVisually ^void [^byte/1 levels ^int levelStart ^Object/1 objects
                                                   ^int objectStart ^int count]
    (when (or (> 0 levelStart) (<= (alength levels) levelStart))
      (throw (IllegalArgumentException.
               (java-str "Value levelStart "
                         levelStart
                         " is out of range 0 to "
                         (unchecked-subtract-int (alength levels) 1)))))
    (when (or (> 0 objectStart) (<= (alength objects) objectStart))
      (throw (IllegalArgumentException.
               (java-str "Value objectStart "
                         objectStart
                         " is out of range 0 to "
                         (unchecked-subtract-int (alength objects) 1)))))
    (when (or (> 0 count) (< (unchecked-subtract-int (alength objects) count) objectStart))
      (throw (IllegalArgumentException.
               (java-str "Value count "
                         count
                         " is less than zero, or objectStart + count is beyond objects length "
                         (alength objects)))))
    (let [reorderLevels (new byte/1 count)]
      (System/arraycopy levels levelStart reorderLevels 0 count)
      (let [indexMap (BidiBase/reorderVisual reorderLevels)
            temp (new Object/1 count)]
        (System/arraycopy objects objectStart temp 0 count)
        (loop [^int i 0]
          (when (< i count)
            (aset objects (unchecked-add-int objectStart i) (aget temp (aget indexMap i)))
            (recur (unchecked-inc-int i)))))))

  (method ^:public writeReordered ^String [this ^int options]
    (.verifyValidParaOrLine this)
    (if (== length 0) "" (BidiWriter/writeReordered this options)))

  (method ^:public toString ^String [this]
    (let [buf (StringBuilder. (.getName (.getClass this)))]
      (.append buf "[dir: ")
      (.append buf direction)
      (.append buf " baselevel: ")
      (.append buf paraLevel)
      (.append buf " length: ")
      (.append buf length)
      (.append buf " runs: ")
      (if (nil? levels)
          (.append buf "none")
          (do
            (.append buf \[)
            (.append buf (aget levels 0))
            (loop [^int i 1]
              (when (< i (alength levels))
                (.append buf \space)
                (.append buf (aget levels i))
                (recur (unchecked-inc-int i))))
            (.append buf \])))
      (.append buf " text: [0x")
      (.append buf (Integer/toHexString (aget text 0)))
      (loop [^int i 1]
        (when (< i (alength text))
          (.append buf " 0x")
          (.append buf (Integer/toHexString (aget text i)))
          (recur (unchecked-inc-int i))))
      (.append buf "]]")
      (.toString buf)))

  (defclass ^:private ^:static TextAttributeConstants
    (static-initializer
      (try (Class/forName "java.awt.font.TextAttribute" true nil) (catch ClassNotFoundException e)))

    (field ^:static ^:final ^JavaAWTFontAccess jafa (SharedSecrets/getJavaAWTFontAccess))

    (field ^:static ^:final ^AttributedCharacterIterator$Attribute RUN_DIRECTION
      (TextAttributeConstants/getTextAttribute "RUN_DIRECTION"))

    (field ^:static ^:final ^AttributedCharacterIterator$Attribute NUMERIC_SHAPING
      (TextAttributeConstants/getTextAttribute "NUMERIC_SHAPING"))

    (field ^:static ^:final ^AttributedCharacterIterator$Attribute BIDI_EMBEDDING
      (TextAttributeConstants/getTextAttribute "BIDI_EMBEDDING"))

    (field ^:static ^:final ^Boolean RUN_DIRECTION_LTR
      (if (nil? jafa)
          Boolean/FALSE
          (cast Boolean (.getTextAttributeConstant jafa "RUN_DIRECTION_LTR"))))

    (method ^:private ^:static getTextAttribute ^AttributedCharacterIterator$Attribute [^String name]
      (if (nil? jafa)
          (anon AttributedCharacterIterator$Attribute [name])
          (cast AttributedCharacterIterator$Attribute (.getTextAttributeConstant jafa name)))))

  (defclass ^:private ^:static NumericShapings
    (static-initializer
      (try (Class/forName "java.awt.font.NumericShaper" true nil) (catch ClassNotFoundException e)))

    (field ^:static ^:final ^JavaAWTFontAccess jafa (SharedSecrets/getJavaAWTFontAccess))

    (method ^:static shape ^void [shaper ^char/1 text ^int start ^int count]
      (when (some? jafa) (.shape jafa shaper text start count)))))

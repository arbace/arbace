    (set! (.-limit (aget (.-isoRuns bd) 0)) 0)
    (set! (.-level (aget (.-isoRuns bd) 0)) level)
    (set! (.-lastStrong (aget (.-isoRuns bd) 0))
          (set!
            (.-lastBase (aget (.-isoRuns bd) 0))
            (set! (.-contextDir (aget (.-isoRuns bd) 0)) (unchecked-byte (bit-and-int level 1)))))
    (set! (.-contextPos (aget (.-isoRuns bd) 0)) 0))

  (method ^:private bracketProcessBoundary ^void [this ^BracketData bd ^int lastCcPos
                                                  ^:mutable ^byte contextLevel ^byte embeddingLevel]
    (let [pLastIsoRun (aget (.-isoRuns bd) (.-isoRunLast bd))]
      (when-not (not (== (bit-and-int (BidiBase/DirPropFlag (aget dirProps lastCcPos)) MASK_ISO) 0))
        (when (> (BidiBase/NoOverride embeddingLevel) (BidiBase/NoOverride contextLevel))
          (set! contextLevel embeddingLevel))
        (set! (.-limit pLastIsoRun) (.-start pLastIsoRun))
        (set! (.-level pLastIsoRun) embeddingLevel)
        (set!
          (.-lastStrong pLastIsoRun)
          (set! (.-lastBase pLastIsoRun)
                (set! (.-contextDir pLastIsoRun) (unchecked-byte (bit-and-int contextLevel 1)))))
        (set! (.-contextPos pLastIsoRun) lastCcPos))))

  (method ^:private bracketProcessLRI_RLI ^void [this ^BracketData bd ^byte level]
    (let [^:mutable pLastIsoRun (aget (.-isoRuns bd) (.-isoRunLast bd))
          ^:mutable ^short lastLimit 0]
      (set! (.-lastBase pLastIsoRun) ON)
      (set! lastLimit (.-limit pLastIsoRun))
      (set! (.-isoRunLast bd) (unchecked-inc-int (.-isoRunLast bd)))
      (set! pLastIsoRun (aget (.-isoRuns bd) (.-isoRunLast bd)))
      (when (nil? pLastIsoRun) (set! pLastIsoRun (aset (.-isoRuns bd) (.-isoRunLast bd) (IsoRun.))))
      (set! (.-start pLastIsoRun) (set! (.-limit pLastIsoRun) lastLimit))
      (set! (.-level pLastIsoRun) level)
      (set! (.-lastStrong pLastIsoRun)
            (set! (.-lastBase pLastIsoRun)
                  (set! (.-contextDir pLastIsoRun) (unchecked-byte (bit-and-int level 1)))))
      (set! (.-contextPos pLastIsoRun) 0)))

  (method ^:private bracketProcessPDI ^void [this ^BracketData bd]
    (let [^:mutable ^IsoRun pLastIsoRun nil]
      (set! (.-isoRunLast bd) (unchecked-dec-int (.-isoRunLast bd)))
      (set! pLastIsoRun (aget (.-isoRuns bd) (.-isoRunLast bd)))
      (set! (.-lastBase pLastIsoRun) ON)))

  (method ^:private bracketAddOpening ^void [this ^BracketData bd ^char match ^int position]
    (let [pLastIsoRun (aget (.-isoRuns bd) (.-isoRunLast bd))
          ^:mutable ^Opening pOpening nil]
      (when (>= (.-limit pLastIsoRun) (alength (.-openings bd)))
        (let [saveOpenings (.-openings bd)
              ^:mutable ^int count 0]
          (try
            (set! count (alength (.-openings bd)))
            (set! (.-openings bd) (new Opening/1 (unchecked-multiply-int count 2)))
            (catch Exception e (throw (OutOfMemoryError. "Failed to allocate memory for openings"))))
          (System/arraycopy saveOpenings 0 (.-openings bd) 0 count)))
      (set! pOpening (aget (.-openings bd) (.-limit pLastIsoRun)))
      (when (nil? pOpening) (set! pOpening (aset (.-openings bd) (.-limit pLastIsoRun) (Opening.))))
      (set! (.-position pOpening) position)
      (set! (.-match pOpening) match)
      (set! (.-contextDir pOpening) (.-contextDir pLastIsoRun))
      (set! (.-contextPos pOpening) (.-contextPos pLastIsoRun))
      (set! (.-flags pOpening) 0)
      (set! (.-limit pLastIsoRun) (unchecked-short (unchecked-inc-int (.-limit pLastIsoRun))))))

  (method ^:private fixN0c ^void [this ^BracketData bd ^int openingIndex ^int newPropPosition
                                  ^byte newProp]
    (let [pLastIsoRun (aget (.-isoRuns bd) (.-isoRunLast bd))
          ^:mutable ^Opening qOpening nil
          ^:mutable ^int k 0
          ^:mutable ^int openingPosition 0
          ^:mutable ^int closingPosition 0]
      (set! k (unchecked-add-int openingIndex 1))
      (while (< k (.-limit pLastIsoRun))
        (set! qOpening (aget (.-openings bd) k))
        (when-not (>= (.-match qOpening) 0)
          (when (< newPropPosition (.-contextPos qOpening)) (break))
          (when-not (>= newPropPosition (.-position qOpening))
            (when (== newProp (.-contextDir qOpening)) (break))
            (set! openingPosition (.-position qOpening))
            (aset dirProps openingPosition newProp)
            (set! closingPosition (unchecked-negate-int (.-match qOpening)))
            (aset dirProps closingPosition newProp)
            (set! (.-match qOpening) 0)
            (.fixN0c this bd k openingPosition newProp)
            (.fixN0c this bd k closingPosition newProp)))
        (set! k (unchecked-inc-int k)))))

  (method ^:private bracketProcessClosing ^byte [this ^BracketData bd ^int openIdx ^int position]
    (let [pLastIsoRun (aget (.-isoRuns bd) (.-isoRunLast bd))
          ^:mutable ^Opening pOpening nil
          ^:mutable ^Opening qOpening nil
          ^:mutable ^byte direction 0
          ^:mutable ^boolean stable false
          ^:mutable ^byte newProp 0]
      (set! pOpening (aget (.-openings bd) openIdx))
      (set! direction (unchecked-byte (bit-and-int (.-level pLastIsoRun) 1)))
      (set! stable true)
      (cond
        (or (and (== direction 0) (> (bit-and-int (.-flags pOpening) FOUND_L) 0))
            (and (== direction 1) (> (bit-and-int (.-flags pOpening) FOUND_R) 0)))
          (set! newProp direction)
        (not (== (bit-and-int (.-flags pOpening) (bit-or-int FOUND_L FOUND_R)) 0))
          (do
            (set! stable (== openIdx (.-start pLastIsoRun)))
            (if (not (== direction (.-contextDir pOpening)))
                (set! newProp (.-contextDir pOpening))
                (set! newProp direction)))
        :else (do (set! (.-limit pLastIsoRun) (unchecked-short openIdx)) (return ON)))
      (aset dirProps (.-position pOpening) newProp)
      (aset dirProps position newProp)
      (.fixN0c this bd openIdx (.-position pOpening) newProp)
      (if stable
          (do
            (set! (.-limit pLastIsoRun) (unchecked-short openIdx))
            (while (and (> (.-limit pLastIsoRun) (.-start pLastIsoRun))
                        (== (.-position (aget (.-openings bd)
                                              (unchecked-subtract-int (.-limit pLastIsoRun) 1)))
                            (.-position pOpening)))
              (set! (.-limit pLastIsoRun)
                    (unchecked-short (unchecked-dec-int (.-limit pLastIsoRun))))))
          (let [^:mutable ^int k 0]
            (set! (.-match pOpening) (unchecked-negate-int position))
            (set! k (unchecked-subtract-int openIdx 1))
            (while (and (>= k (.-start pLastIsoRun))
                        (== (.-position (aget (.-openings bd) k)) (.-position pOpening)))
              (set! (.-match (aget (.-openings bd) k)) 0)
              (set! k (unchecked-dec-int k)))
            (set! k (unchecked-add-int openIdx 1))
            (while (< k (.-limit pLastIsoRun))
              (set! qOpening (aget (.-openings bd) k))
              (when (>= (.-position qOpening) position) (break))
              (when (> (.-match qOpening) 0) (set! (.-match qOpening) 0))
              (set! k (unchecked-inc-int k)))))
      newProp))

  (method ^:private bracketProcessChar ^void [this ^BracketData bd ^int position]
    (let [pLastIsoRun (aget (.-isoRuns bd) (.-isoRunLast bd))
          ^:mutable ^byte dirProp 0
          ^:mutable ^byte newProp 0
          ^:mutable ^byte level 0]
      (set! dirProp (aget dirProps position))
      (when (== dirProp ON)
        (let [^:mutable ^char c (unchecked-char 0)
              ^:mutable ^char match (unchecked-char 0)
              ^:mutable ^int idx 0]
          (set! c (aget text position))
          (set! idx (unchecked-subtract-int (.-limit pLastIsoRun) 1))
          (while (>= idx (.-start pLastIsoRun))
            (when-not (not (== (.-match (aget (.-openings bd) idx)) c))
              (set! newProp (.bracketProcessClosing this bd idx position))
              (when (== newProp ON) (set! c 0) (break))
              (set! (.-lastBase pLastIsoRun) ON)
              (set! (.-contextDir pLastIsoRun) newProp)
              (set! (.-contextPos pLastIsoRun) position)
              (set! level (aget levels position))
              (when-not (== (bit-and-int level LEVEL_OVERRIDE) 0)
                (let [^:mutable ^short flag 0
                      ^:mutable ^int i 0]
                  (set! newProp (unchecked-byte (bit-and-int level 1)))
                  (set! (.-lastStrong pLastIsoRun) newProp)
                  (set! flag (unchecked-short (BidiBase/DirPropFlag newProp)))
                  (set! i (.-start pLastIsoRun))
                  (while (< i idx)
                    (let [o-1 (aget (.-openings bd) i)]
                      (set! (.-flags o-1) (unchecked-short (bit-or-int (.-flags o-1) flag))))
                    (set! i (unchecked-inc-int i)))
                  (aset levels
                        position
                        (unchecked-byte
                          (bit-and-int (aget levels position) (bit-not-int LEVEL_OVERRIDE))))))
              (let [i-2 (.-position (aget (.-openings bd) idx))]
                (aset levels
                      i-2
                      (unchecked-byte (bit-and-int (aget levels i-2) (bit-not-int LEVEL_OVERRIDE)))))
              (return))
            (set! idx (unchecked-dec-int idx)))
          (if (not (== c 0))
              (set! match (unchecked-char (UCharacter/getBidiPairedBracket c)))
              (set! match 0))
          (when (and (not (== match c))
                     (== (UCharacter/getIntPropertyValue c BIDI_PAIRED_BRACKET_TYPE)
                         BidiPairedBracketType/OPEN))
            (cond
              (== match 0x232A) (.bracketAddOpening this bd (unchecked-char 0x3009) position)
              (== match 0x3009) (.bracketAddOpening this bd (unchecked-char 0x232A) position))
            (.bracketAddOpening this bd match position))))
      (set! level (aget levels position))
      (cond
        (not (== (bit-and-int level LEVEL_OVERRIDE) 0))
          (do
            (set! newProp (unchecked-byte (bit-and-int level 1)))
            (when (and (and (not (== dirProp S)) (not (== dirProp WS))) (not (== dirProp ON)))
              (aset dirProps position newProp))
            (set! (.-lastBase pLastIsoRun) newProp)
            (set! (.-lastStrong pLastIsoRun) newProp)
            (set! (.-contextDir pLastIsoRun) newProp)
            (set! (.-contextPos pLastIsoRun) position))
        (or (<= dirProp R) (== dirProp AL))
          (do
            (set! newProp (BidiBase/DirFromStrong dirProp))
            (set! (.-lastBase pLastIsoRun) dirProp)
            (set! (.-lastStrong pLastIsoRun) dirProp)
            (set! (.-contextDir pLastIsoRun) newProp)
            (set! (.-contextPos pLastIsoRun) position))
        (== dirProp EN)
          (do
            (set! (.-lastBase pLastIsoRun) EN)
            (if (== (.-lastStrong pLastIsoRun) L)
                (do
                  (set! newProp L)
                  (when-not (.-isNumbersSpecial bd) (aset dirProps position ENL))
                  (set! (.-contextDir pLastIsoRun) L)
                  (set! (.-contextPos pLastIsoRun) position))
                (do
                  (set! newProp R)
                  (if (== (.-lastStrong pLastIsoRun) AL)
                      (aset dirProps position AN)
                      (aset dirProps position ENR))
                  (set! (.-contextDir pLastIsoRun) R)
                  (set! (.-contextPos pLastIsoRun) position))))
        (== dirProp AN)
          (do
            (set! newProp R)
            (set! (.-lastBase pLastIsoRun) AN)
            (set! (.-contextDir pLastIsoRun) R)
            (set! (.-contextPos pLastIsoRun) position))
        (== dirProp NSM)
          (do
            (set! newProp (.-lastBase pLastIsoRun))
            (when (== newProp ON) (aset dirProps position newProp)))
        :else (do (set! newProp dirProp) (set! (.-lastBase pLastIsoRun) dirProp)))
      (when (or (<= newProp R) (== newProp AL))
        (let [^:mutable ^int i 0
              flag (unchecked-short (BidiBase/DirPropFlag (BidiBase/DirFromStrong newProp)))]
          (set! i (.-start pLastIsoRun))
          (while (< i (.-limit pLastIsoRun))
            (when (> position (.-position (aget (.-openings bd) i)))
              (let [o-3 (aget (.-openings bd) i)]
                (set! (.-flags o-3) (unchecked-short (bit-or-int (.-flags o-3) flag)))))
            (set! i (unchecked-inc-int i)))))))

  (method ^:private directionFromFlags ^byte [this]
    (cond
      (not (or (not (== (bit-and-int flags MASK_RTL) 0))
               (and (not (== (bit-and-int flags (BidiBase/DirPropFlag AN)) 0))
                    (not (== (bit-and-int flags MASK_POSSIBLE_N) 0)))))
        LTR
      (== (bit-and-int flags MASK_LTR) 0) RTL
      :else MIXED))

  (method ^:private resolveExplicitLevels ^byte [this]
    (let [^:mutable ^int i 0
          ^:mutable ^byte dirProp 0
          ^:mutable level (.GetParaLevelAt this 0)
          ^:mutable ^byte dirct 0]
      (set! isolateCount 0)
      (set! dirct (.directionFromFlags this))
      (cond
        (not (== dirct MIXED)) dirct
        (> reorderingMode REORDER_LAST_LOGICAL_TO_VISUAL)
          (let [^:mutable ^int paraIndex 0
                ^:mutable ^int start 0
                ^:mutable ^int limit 0]
            (set! paraIndex 0)
            (while (< paraIndex paraCount)
              (if (== paraIndex 0)
                  (set! start 0)
                  (set! start (aget paras_limit (unchecked-subtract-int paraIndex 1))))
              (set! limit (aget paras_limit paraIndex))
              (set! level (aget paras_level paraIndex))
              (set! i start)
              (while (< i limit) (aset levels i level) (set! i (unchecked-inc-int i)))
              (set! paraIndex (unchecked-inc-int paraIndex)))
            dirct)
        (== (bit-and-int flags (bit-or-int MASK_EXPLICIT MASK_ISO)) 0)
          (let [^:mutable ^int paraIndex 0
                ^:mutable ^int start 0
                ^:mutable ^int limit 0
                bracketData (BracketData.)]
            (.bracketInit this bracketData)
            (set! paraIndex 0)
            (while (< paraIndex paraCount)
              (if (== paraIndex 0)
                  (set! start 0)
                  (set! start (aget paras_limit (unchecked-subtract-int paraIndex 1))))
              (set! limit (aget paras_limit paraIndex))
              (set! level (aget paras_level paraIndex))
              (set! i start)
              (while (< i limit)
                (aset levels i level)
                (set! dirProp (aget dirProps i))
                (when-not (== dirProp BN)
                  (if (== dirProp B)
                      (when (< (unchecked-add-int i 1) length)
                        (when (and (== (aget text i) CR)
                                   (== (aget text (unchecked-add-int i 1)) LF))
                          (set! i (unchecked-inc-int i))
                          (continue))
                        (.bracketProcessB this bracketData level))
                      (.bracketProcessChar this bracketData i)))
                (set! i (unchecked-inc-int i)))
              (set! paraIndex (unchecked-inc-int paraIndex)))
            dirct)
        :else
          (let [^:mutable embeddingLevel level
                ^:mutable ^byte newLevel 0
                ^:mutable previousLevel level
                ^:mutable ^int lastCcPos 0
                stack (new short/1 (unchecked-add-int MAX_EXPLICIT_LEVEL 2))
                ^:mutable ^int stackLast 0
                ^:mutable ^int overflowIsolateCount 0
                ^:mutable ^int overflowEmbeddingCount 0
                ^:mutable ^int validIsolateCount 0
                bracketData (BracketData.)]
            (.bracketInit this bracketData)
            (aset stack 0 level)
            (set! flags 0)
            (set! i 0)
            (while (< i length)
              (set! dirProp (aget dirProps i))
              (label :switch
                (switch dirProp
                  (LRE RLE LRO RLO)
                    (do
                      (set! flags (bit-or-int flags (BidiBase/DirPropFlag BN)))
                      (aset levels i previousLevel)
                      (if (or (== dirProp LRE) (== dirProp LRO))
                          (set! newLevel
                                (unchecked-byte
                                  (bit-and-int (unchecked-add-int embeddingLevel 2)
                                               (bit-not-int (bit-or-int LEVEL_OVERRIDE 1)))))
                          (set! newLevel
                                (unchecked-byte
                                  (bit-or-int (unchecked-add-int
                                                (BidiBase/NoOverride embeddingLevel)
                                                1)
                                              1))))
                      (cond
                        (and (and (<= newLevel MAX_EXPLICIT_LEVEL) (== overflowIsolateCount 0))
                             (== overflowEmbeddingCount 0))
                          (do
                            (set! lastCcPos i)
                            (set! embeddingLevel newLevel)
                            (when (or (== dirProp LRO) (== dirProp RLO))
                              (set! embeddingLevel
                                    (unchecked-byte (bit-or-int embeddingLevel LEVEL_OVERRIDE))))
                            (set! stackLast (unchecked-inc-int stackLast))
                            (aset stack stackLast embeddingLevel))
                        (== overflowIsolateCount 0)
                          (set! overflowEmbeddingCount (unchecked-inc-int overflowEmbeddingCount))))
                  PDF
                    (do
                      (set! flags (bit-or-int flags (BidiBase/DirPropFlag BN)))
                      (aset levels i previousLevel)
                      (when-not (> overflowIsolateCount 0)
                        (if (> overflowEmbeddingCount 0)
                            (set! overflowEmbeddingCount (unchecked-dec-int overflowEmbeddingCount))
                            (when (and (> stackLast 0) (< (aget stack stackLast) ISOLATE))
                              (set! lastCcPos i)
                              (set! stackLast (unchecked-dec-int stackLast))
                              (set! embeddingLevel (unchecked-byte (aget stack stackLast)))))))
                  (LRI RLI)
                    (do
                      (set! flags
                            (bit-or-int flags
                                        (bit-or-int
                                          (BidiBase/DirPropFlag ON)
                                          (BidiBase/DirPropFlagLR embeddingLevel))))
                      (aset levels i (BidiBase/NoOverride embeddingLevel))
                      (when-not (== (BidiBase/NoOverride embeddingLevel)
                                    (BidiBase/NoOverride previousLevel))
                        (.bracketProcessBoundary
                          this
                          bracketData
                          lastCcPos
                          previousLevel
                          embeddingLevel)
                        (set! flags (bit-or-int flags DirPropFlagMultiRuns)))
                      (set! previousLevel embeddingLevel)
                      (if (== dirProp LRI)
                          (set! newLevel
                                (unchecked-byte
                                  (bit-and-int (unchecked-add-int embeddingLevel 2)
                                               (bit-not-int (bit-or-int LEVEL_OVERRIDE 1)))))
                          (set! newLevel
                                (unchecked-byte
                                  (bit-or-int (unchecked-add-int
                                                (BidiBase/NoOverride embeddingLevel)
                                                1)
                                              1))))
                      (if (and (and (<= newLevel MAX_EXPLICIT_LEVEL) (== overflowIsolateCount 0))
                               (== overflowEmbeddingCount 0))
                          (do
                            (set! flags (bit-or-int flags (BidiBase/DirPropFlag dirProp)))
                            (set! lastCcPos i)
                            (set! validIsolateCount (unchecked-inc-int validIsolateCount))
                            (when (> validIsolateCount isolateCount)
                              (set! isolateCount validIsolateCount))
                            (set! embeddingLevel newLevel)
                            (set! stackLast (unchecked-inc-int stackLast))
                            (aset stack
                                  stackLast
                                  (unchecked-short (unchecked-add-int embeddingLevel ISOLATE)))
                            (.bracketProcessLRI_RLI this bracketData embeddingLevel))
                          (do
                            (aset dirProps i WS)
                            (set! overflowIsolateCount (unchecked-inc-int overflowIsolateCount)))))
                  PDI
                    (do
                      (when-not (== (BidiBase/NoOverride embeddingLevel)
                                    (BidiBase/NoOverride previousLevel))
                        (.bracketProcessBoundary
                          this
                          bracketData
                          lastCcPos
                          previousLevel
                          embeddingLevel)
                        (set! flags (bit-or-int flags DirPropFlagMultiRuns)))
                      (cond
                        (> overflowIsolateCount 0)
                          (do
                            (set! overflowIsolateCount (unchecked-dec-int overflowIsolateCount))
                            (aset dirProps i WS))
                        (> validIsolateCount 0)
                          (do
                            (set! flags (bit-or-int flags (BidiBase/DirPropFlag PDI)))
                            (set! lastCcPos i)
                            (set! overflowEmbeddingCount 0)
                            (while (< (aget stack stackLast) ISOLATE)
                              (set! stackLast (unchecked-dec-int stackLast)))
                            (set! stackLast (unchecked-dec-int stackLast))
                            (set! validIsolateCount (unchecked-dec-int validIsolateCount))
                            (.bracketProcessPDI this bracketData))
                        :else (aset dirProps i WS))
                      (set! embeddingLevel
                            (unchecked-byte
                              (bit-and-int (aget stack stackLast) (bit-not-int ISOLATE))))
                      (set! flags
                            (bit-or-int flags
                                        (bit-or-int
                                          (BidiBase/DirPropFlag ON)
                                          (BidiBase/DirPropFlagLR embeddingLevel))))
                      (set! previousLevel embeddingLevel)
                      (aset levels i (BidiBase/NoOverride embeddingLevel)))
                  B
                    (do
                      (set! flags (bit-or-int flags (BidiBase/DirPropFlag B)))
                      (aset levels i (.GetParaLevelAt this i))
                      (when (< (unchecked-add-int i 1) length)
                        (when (and (== (aget text i) CR)
                                   (== (aget text (unchecked-add-int i 1)) LF))
                          (break :switch))
                        (set! overflowEmbeddingCount (set! overflowIsolateCount 0))
                        (set! validIsolateCount 0)
                        (set! stackLast 0)
                        (set! previousLevel
                              (set! embeddingLevel (.GetParaLevelAt this (unchecked-add-int i 1))))
                        (aset stack 0 embeddingLevel)
                        (.bracketProcessB this bracketData embeddingLevel)))
                  BN
                    (do
                      (aset levels i previousLevel)
                      (set! flags (bit-or-int flags (BidiBase/DirPropFlag BN))))
                  (do
                    (when-not (== (BidiBase/NoOverride embeddingLevel)
                                  (BidiBase/NoOverride previousLevel))
                      (.bracketProcessBoundary this
                                               bracketData
                                               lastCcPos
                                               previousLevel
                                               embeddingLevel)
                      (set! flags (bit-or-int flags DirPropFlagMultiRuns))
                      (if (not (== (bit-and-int embeddingLevel LEVEL_OVERRIDE) 0))
                          (set! flags (bit-or-int flags (BidiBase/DirPropFlagO embeddingLevel)))
                          (set! flags (bit-or-int flags (BidiBase/DirPropFlagE embeddingLevel)))))
                    (set! previousLevel embeddingLevel)
                    (aset levels i embeddingLevel)
                    (.bracketProcessChar this bracketData i)
                    (set! flags (bit-or-int flags (BidiBase/DirPropFlag (aget dirProps i)))))))
              (set! i (unchecked-inc-int i)))
            (when-not (== (bit-and-int flags MASK_EMBEDDING) 0)
              (set! flags (bit-or-int flags (BidiBase/DirPropFlagLR paraLevel))))
            (when (and orderParagraphsLTR (not (== (bit-and-int flags (BidiBase/DirPropFlag B)) 0)))
              (set! flags (bit-or-int flags (BidiBase/DirPropFlag L))))
            (set! dirct (.directionFromFlags this))
            dirct))))

  (method ^:private checkExplicitLevels ^byte [this]
    (let [^:mutable ^byte dirProp 0
          ^:mutable ^int i 0
          ^:mutable ^int isolateCount 0]
      (set! (.-flags this) 0)
      (let [^:mutable ^byte level 0]
        (set! (.-isolateCount this) 0)
        (set! i 0)
        (while (< i length)
          (when (== (aget levels i) 0) (aset levels i paraLevel))
          (when (< MAX_EXPLICIT_LEVEL (bit-and-int (aget levels i) 0x7f))
            (if (not (== (bit-and-int (aget levels i) LEVEL_OVERRIDE) 0))
                (aset levels i (unchecked-byte (bit-or-int paraLevel LEVEL_OVERRIDE)))
                (aset levels i paraLevel)))
          (set! level (aget levels i))
          (set! dirProp (aget dirProps i))
          (cond
            (or (== dirProp LRI) (== dirProp RLI))
              (do
                (set! isolateCount (unchecked-inc-int isolateCount))
                (when (> isolateCount (.-isolateCount this))
                  (set! (.-isolateCount this) isolateCount)))
            (== dirProp PDI) (set! isolateCount (unchecked-dec-int isolateCount))
            (== dirProp B) (set! isolateCount 0))
          (if (not (== (bit-and-int level LEVEL_OVERRIDE) 0))
              (do
                (set! level (unchecked-byte (bit-and-int level (bit-not-int LEVEL_OVERRIDE))))
                (set! flags (bit-or-int flags (BidiBase/DirPropFlagO level))))
              (set! flags
                    (bit-or-int flags

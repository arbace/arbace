        0
        (do
          (when (> fromIndex (.length s)) (set! fromIndex (.length s)))
          (cond
            (some? bmpSet) (.spanBack bmpSet s fromIndex spanCondition)
            (some? stringSpan) (.spanBack stringSpan s fromIndex spanCondition)
            :else
              (do
                (when-not (.isEmpty strings)
                  (let [^int which (if (identical? spanCondition SpanCondition/NOT_CONTAINED)
                                       UnicodeSetStringSpan/BACK_UTF16_NOT_CONTAINED
                                       UnicodeSetStringSpan/BACK_UTF16_CONTAINED)
                        strSpan (UnicodeSetStringSpan. this (ArrayList. strings) which)]
                    (when (.needsStringSpanUTF16 strSpan)
                      (return (.spanBack strSpan s fromIndex spanCondition)))))
                (let [spanContained (not (identical? spanCondition SpanCondition/NOT_CONTAINED))
                      ^:mutable ^int c 0
                      ^:mutable prev fromIndex]
                  (loop []
                    (set! c (Character/codePointBefore s prev))
                    (when-not (= spanContained (.contains this c)) (break))
                    (set! prev (unchecked-subtract-int prev (Character/charCount c)))
                    (when (> prev 0) (recur)))
                  prev))))))

  (method ^:public cloneAsThawed ^UnicodeSet [this]
    (let [result (UnicodeSet. this)] (java-assert (not (.isFrozen result))) result))

  (method ^:private checkFrozen ^void [this]
    (when (.isFrozen this)
      (throw (UnsupportedOperationException. "Attempt to modify frozen object"))))

  (defclass ^:public ^:enum SpanCondition
    (constants NOT_CONTAINED CONTAINED SIMPLE)))

  (defclass ^:private ^:static UnregisteredClassLoader
    :extends ClassLoader

    (static-initializer (UnregisteredClassLoader/registerAsParallelCapable))

    (defclass ^:static ^:interface Source
      (method ^:public readClassFile :throws [IOException] ^byte/1 [this ^String className]))

    (defclass ^:static JarSource
      :implements [Source]

      (field ^:private ^:final ^JarFile jar)

      (constructor :throws [IOException] [this ^File file]
        (set! jar (JarFile. file)))

      (method ^:public readClassFile :throws [IOException] ^byte/1 [this ^String className]
        (let [entryName (.concat (.replace className \. \/) ".class")
              entry (.getEntry jar entryName)]
          (when (nil? entry)
            (throw (IOException. (java-str "No such entry: " entryName " in " (.getName jar)))))
          (with-resources [in (.getInputStream jar entry)] (.readAllBytes in)))))

    (defclass ^:static DirSource
      :implements [Source]

      (field ^:private ^:final ^String basePath)

      (constructor [this ^File dir]
        (java-assert (.isDirectory dir))
        (set! basePath (.toString dir)))

      (method ^:public readClassFile :throws [IOException] ^byte/1 [this ^String className]
        (let [subPath (.concat (.replace className \. File/separatorChar) ".class")
              fullPath (Path/of basePath (new String/1 [subPath]))]
          (Files/readAllBytes fullPath))))

    (field ^:private ^:final ^{:tag (HashMap String Source)} sources (HashMap.))

    (method ^:private resolveSource :throws [IOException] ^Source [this ^String path]
      (let [^:mutable source (cast Source (.get sources path))]
        (if (some? source)
            source
            (let [file (File. path)]
              (when-not (.exists file) (throw (IOException. (java-str "No such file: " path))))
              (cond
                (.isFile file) (set! source (JarSource. file))
                (.isDirectory file) (set! source (DirSource. file))
                :else (throw (IOException. (java-str "Not a normal file: " path))))
              (.put sources path source)
              source))))

    (method ^:private load :throws [IOException] ^{:tag (Class ?)} [this ^String name ^String source]
      (let [resolvedSource (.resolveSource this source)
            bytes (.readClassFile resolvedSource name)]
        (java-assert (identical? (.getParent this) (UnregisteredClassLoader/getSystemClassLoader)))
        (.defineClass this name bytes 0 (alength bytes)))))

  (defclass ^:private ^:static ProcessLauncher
    (method ^:static execWithJavaToolOptions :throws [IOException InterruptedException] ^int [^String javaLauncher
                                                                                              ^String/1 args]
      (let [pb (.command (.inheritIO (ProcessBuilder. (new String/1 [])))
                         (new String/1 [javaLauncher]))
            sb (StringBuilder.)
            ^:mutable prefix ""]
        (for-each [^String arg args]
          (.append sb prefix)
          (loop [^int i 0]
            (when (< i (.length arg))
              (let [c (.charAt arg i)]
                (cond
                  (or (== c \") (Character/isWhitespace c))
                    (do
                      (.append sb \')
                      (.append sb c)
                      (.append sb \')
                      (recur (unchecked-inc-int i)))
                  (== c \')
                    (do
                      (.append sb \")
                      (.append sb c)
                      (.append sb \")
                      (recur (unchecked-inc-int i)))
                  :else (do (.append sb c) (recur (unchecked-inc-int i)))))))
          (set! prefix " "))
        (let [^{:tag (Map String String)} env (.environment pb)]
          (.put env "JAVA_TOOL_OPTIONS" (.toString sb))
          (.remove env "_JAVA_OPTIONS")
          (.remove env "CLASSPATH")
          (let [process (.start pb)] (.waitFor process)))))))

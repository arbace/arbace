  (method ^:private ^:static isValidHolderName ^boolean [^String name]
    (or (or (or (.equals name DIRECT_HOLDER_CLASS_NAME) (.equals name DELEGATING_HOLDER_CLASS_NAME))
            (.equals name BASIC_FORMS_HOLDER_CLASS_NAME))
        (.equals name INVOKERS_HOLDER_CLASS_NAME)))

  (method ^:private ^:static isBasicTypeChar ^boolean [^char c]
    (>= (.indexOf "LIJFDV" c) 0))

  (method ^:private ^:static isValidMethodType ^boolean [^String type]
    (let [typeParts (.split type "_")]
      (cond
        (or (or (not (== (alength typeParts) 2)) (not (== (.length (aget typeParts 1)) 1)))
            (not (CDS/isBasicTypeChar (.charAt (aget typeParts 1) 0))))
          false
        (not (CDS/isBasicTypeChar (.charAt (aget typeParts 0) 0))) false
        :else
          (do
            (loop [^int i 1]
              (when (< i (.length (aget typeParts 0)))
                (let [c (.charAt (aget typeParts 0) i)]
                  (if (not (CDS/isBasicTypeChar c))
                      (if (not (and (>= c \0) (<= c \9)))
                          (return false)
                          (recur (unchecked-inc-int i)))
                      (recur (unchecked-inc-int i))))))
            true))))

  (method ^:private ^:static validateInputLines ^void [^String/1 lines]
    (for-each [^String s lines]
      (when (and (not (.startsWith s "[LF_RESOLVE]")) (not (.startsWith s "[SPECIES_RESOLVE]")))
        (throw (IllegalArgumentException. (java-str "Wrong prefix: " s))))
      (let [parts (.split s " ")
            isLF (.startsWith s "[LF_RESOLVE]")]
        (if isLF
            (do
              (when-not (== (alength parts) 4)
                (throw (IllegalArgumentException.
                         (java-str "Incorrect number of items in the line: " (alength parts)))))
              (when-not (CDS/isValidHolderName (aget parts 1))
                (throw (IllegalArgumentException.
                         (java-str "Invalid holder class name: " (aget parts 1)))))
              (when-not (CDS/isValidMethodType (aget parts 3))
                (throw
                  (IllegalArgumentException. (java-str "Invalid method type: " (aget parts 3))))))
            (when-not (== (alength parts) 2)
              (throw (IllegalArgumentException.
                       (java-str "Incorrect number of items in the line: " (alength parts)))))))))

  (method ^:private ^:static generateLambdaFormHolderClasses ^Object/1 [^String/1 lines]
    (Objects/requireNonNull lines)
    (CDS/validateInputLines lines)
    (let [^{:tag (Stream String)} lineStream (Arrays/stream lines)
          ^{:tag (Map String byte/1)} result (.generateHolderClasses
                                               (SharedSecrets/getJavaLangInvokeAccess)
                                               lineStream)
          size (.size result)
          retArray (new Object/1 (unchecked-multiply-int size 2))
          ^:mutable ^int index 0]
      (for-each [^{:tag (Map$Entry String byte/1)} entry (.entrySet result)]
        (aset retArray index (.getKey entry))
        (set! index (unchecked-inc-int index))
        (aset retArray index (.getValue entry))
        (set! index (unchecked-inc-int index)))
      retArray))

  (method ^:private ^:static ^:native dumpClassList ^void [^String listFileName])


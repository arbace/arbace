  (method ^:private ^:static drainOutput ^String [^InputStream stream ^long pid ^String tail
                                                  ^{:tag (List String)} cmds]
    (let [fileName (java-str "java_pid" pid "_" tail)]
      (.start (Thread. (lambda Runnable ^void []
                         (try
                           (with-resources [isr (InputStreamReader. stream)
                                            rdr (BufferedReader. isr)
                                            prt (PrintStream. fileName)]
                             (.println prt "Command:")
                             (for-each [^String s cmds] (.print prt (java-str s " ")))
                             (.println prt "")
                             (let [^:mutable ^String line nil]
                               (while (some? (set! line (.readLine rdr))) (.println prt line))))
                           (catch IOException e
                             (throw (RuntimeException.
                                      (java-str "IOException happens during drain stream to file "
                                                fileName
                                                ": "
                                                (.getMessage e)))))))))
      fileName))

  (field ^:private ^:static ^String/1 excludeFlags
    (new String/1
         ["-XX:DumpLoadedClassList=" "-XX:+RecordDynamicDumpInfo" "-Xshare:"
          "-XX:SharedClassListFile=" "-XX:SharedArchiveFile=" "-XX:ArchiveClassesAtExit="]))

  (method ^:private ^:static containsExcludedFlags ^boolean [^String testStr]
    (for-each [^String e excludeFlags] (when (.contains testStr e) (return true)))
    false)

  (method ^:private ^:static dumpSharedArchive :throws [Exception] ^String [^boolean isStatic
                                                                            ^String fileName]
    (let [cwd (.getAbsolutePath (File. ""))
          currentPid (String/valueOf (.pid (ProcessHandle/current)))
          ^String archiveFileName (if (some? fileName)
                                      fileName
                                      (java-str "java_pid"
                                                currentPid
                                                (if isStatic "_static.jsa" "_dynamic.jsa")))
          tempArchiveFileName (java-str archiveFileName ".temp")
          tempArchiveFile (File. tempArchiveFileName)]
      (when-not (.exists tempArchiveFile) (.createNewFile tempArchiveFile))
      (.delete tempArchiveFile)
      (if isStatic
          (let [listFileName (java-str archiveFileName ".classlist")
                listFile (File. listFileName)]
            (when (.exists listFile) (.delete listFile))
            (CDS/dumpClassList listFileName)
            (let [jdkHome (StaticProperty/javaHome)
                  classPath (System/getProperty "java.class.path")
                  ^{:tag (List String)} cmds (ArrayList.)]
              (.add cmds (java-str jdkHome File/separator "bin" File/separator "java"))
              (.add cmds "-cp")
              (.add cmds classPath)
              (.add cmds "-Xlog:cds")
              (.add cmds "-Xshare:dump")
              (.add cmds (java-str "-XX:SharedClassListFile=" listFileName))
              (.add cmds (java-str "-XX:SharedArchiveFile=" tempArchiveFileName))
              (let [vmArgs (VM/getRuntimeArguments)]
                (when (some? vmArgs)
                  (for-each [^String arg vmArgs]
                    (when (and (some? arg) (not (CDS/containsExcludedFlags arg))) (.add cmds arg))))
                (let [proc (.exec (Runtime/getRuntime)
                                  (cast String/1 (.toArray cmds (new String/1 0))))
                      stdOutFileName (CDS/drainOutput
                                       (.getInputStream proc)
                                       (.pid proc)
                                       "stdout"
                                       cmds)
                      stdErrFileName (CDS/drainOutput
                                       (.getErrorStream proc)
                                       (.pid proc)
                                       "stderr"
                                       cmds)]
                  (.waitFor proc)
                  (.delete listFile)
                  (when-not (.exists tempArchiveFile)
                    (throw (RuntimeException.
                             (java-str "Archive file "
                                       tempArchiveFileName
                                       " is not created, please check stdout file "
                                       cwd
                                       File/separator
                                       stdOutFileName
                                       " or stderr file "
                                       cwd
                                       File/separator
                                       stdErrFileName
                                       " for more detail"))))))))
          (do
            (CDS/dumpDynamicArchive tempArchiveFileName)
            (when-not (.exists tempArchiveFile)
              (throw (RuntimeException.
                       (java-str "Archive file "
                                 tempArchiveFileName
                                 " is not created, please check current working directory "
                                 cwd
                                 " for process "
                                 currentPid
                                 " output for more detail"))))))
      (let [archiveFile (File. archiveFileName)]
        (when (.exists archiveFile) (.delete archiveFile))
        (when-not (.renameTo tempArchiveFile archiveFile)
          (throw (RuntimeException.
                   (java-str "Cannot rename temp file "
                             tempArchiveFileName
                             " to archive file"
                             archiveFileName))))
        (let [archiveFilePath (.getAbsolutePath (File. archiveFileName))]
          (.println System/out
                    (java-str "The process was attached by jcmd and dumped a "
                              (if isStatic "static" "dynamic")
                              " archive "
                              archiveFilePath))
          archiveFilePath))))

  (method ^:public ^:static needsClassInitBarrier ^boolean [^{:tag (Class ?)} c]
    (when (nil? c) (throw (NullPointerException.)))
    (if (== (bit-and-int configStatus IS_DUMPING_METHOD_HANDLES) 0)
        false
        (CDS/needsClassInitBarrier0 c)))


                        (set! str
                              (String. mBuff
                                       (unchecked-add-int idx 1)
                                       (unchecked-subtract-int mBuffIdx idx)))
                        (set! inp (cast Input (.get mEnt str)))
                        (set! mBuffIdx (unchecked-subtract-int idx 1))

  (method ^:private isdecl ^boolean [this ^Pair name ^String value]
    (cond
      (== (aget (.-chars name) 0) 0)
        (when (= (.equals "xmlns" (.-name name)) true)
          (set! mPref (.pair this mPref))
          (set! (.-list mPref) mElm)
          (set! (.-value mPref) value)
          (set! (.-name mPref) "")
          (set! (.-chars mPref) NONS)
          (set! (.-num mElm) (unchecked-inc-int (.-num mElm)))
          (return true))
      (= (.eqpref name XMLNS) true)
        (let [len (.length (.-name name))]
          (set! mPref (.pair this mPref))
          (set! (.-list mPref) mElm)
          (set! (.-value mPref) value)
          (set! (.-name mPref) (.-name name))
          (set! (.-chars mPref) (new char/1 (unchecked-add-int len 1)))
          (aset (.-chars mPref) 0 (unchecked-char (unchecked-add-int len 1)))
          (.getChars (.-name name) 0 len (.-chars mPref) 1)
          (set! (.-num mElm) (unchecked-inc-int (.-num mElm)))
          (return true)))
    false)

  (method ^:private rslv :throws [Exception] ^String [this ^char/1 qname]
    (loop [pref mPref]
      (if (some? pref)
          (if (= (.eqpref pref qname) true) (return (.-value pref)) (recur (.-next pref)))
          nil))
    (when (== (aget qname 0) 1)
      (loop [pref mPref]
        (if (some? pref)
            (if (== (aget (.-chars pref) 0) 0) (return (.-value pref)) (recur (.-next pref)))
            nil)))
    (.panic this FAULT)
    nil)


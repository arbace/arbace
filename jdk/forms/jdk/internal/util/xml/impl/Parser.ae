                            (if (nil? (.-chars inp))
                                (let [is (.resolveEnt this str (.-pubid inp) (.-sysid inp))]
                                  (if (some? is)
                                      (do
                                        (.push this (Input. BUFFSIZE_READER))
                                        (.setinp this is)
                                        (set! (.-pubid mInp) (.-pubid inp))
                                        (set! (.-sysid mInp) (.-sysid inp))

        6
          (switch (aget mBuff 1)
            \I (return (if (= (.equals "IDREFS" str) true) \R \?))
            \E (return (if (= (.equals "ENTITY" str) true) \n \?))
            nil)
        7
          (switch (aget mBuff 1)
            \I (return (if (= (.equals "IMPLIED" str) true) \I \?))
            \N (return (if (= (.equals "NMTOKEN" str) true) \t \?))
            \A (return (if (= (.equals "ATTLIST" str) true) \a \?))
            \E (return (if (= (.equals "ELEMENT" str) true) \e \?))

        8
          (switch (aget mBuff 2)
            \N (return (if (= (.equals "ENTITIES" str) true) \N \?))
            \M (return (if (= (.equals "NMTOKENS" str) true) \T \?))
            \O (return (if (= (.equals "NOTATION" str) true) \o \?))

  (method ^:private bkeyword :throws [Exception] ^char [this]
    (let [str (String. mBuff 1 mBuffIdx)]
      (switch (.length str)
        2 (return (if (= (.equals "ID" str) true) \i \?))
        5
          (switch (aget mBuff 1)
            \I (return (if (= (.equals "IDREF" str) true) \r \?))
            \C (return (if (= (.equals "CDATA" str) true) \c \?))
            \F (return (if (= (.equals "FIXED" str) true) \F \?))

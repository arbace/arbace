              (2 3)
                (switch ch
                  \' (if (and (== st 2) (identical? mInp inp)) (set! st -1) (.bappend this ch))
                  \" (if (and (== st 3) (identical? mInp inp)) (set! st -1) (.bappend this ch))
                  \& (if (not (== flag \d)) (.ent this flag) (.bappend this ch))
                  \% (if (== flag \d) (.pent this \-) (.bappend this ch))
                  \< (if (or (== flag \-) (== flag \d)) (.bappend this ch) (.panic this FAULT))
                  EOS
                    (do
                      (.panic this FAULT)
                      (when (and (not (== flag \space)) (nil? (.-next mInp)))
                        (when-not (== (.getch this) \newline) (.bkch this))
                        (set! ch \newline))
                      (.bappend this ch flag))
                  \return
                    (do
                      (when (and (not (== flag \space)) (nil? (.-next mInp)))
                        (when-not (== (.getch this) \newline) (.bkch this))
                        (set! ch \newline))
                      (.bappend this ch flag))
                  (.bappend this ch flag))
              (.panic this FAULT))))
        (when (and (== flag \i) (== (aget mBuff mBuffIdx) \space))
          (set! mBuffIdx (unchecked-subtract-int mBuffIdx 1))))))

  (method ^:protected ^:abstract bflash :throws [Exception] ^void [this])

  (method ^:protected ^:abstract bflash_ws :throws [Exception] ^void [this])

  (method ^:private bappend :throws [Exception] ^void [this ^:mutable ^char ch ^char mode]
    (switch mode
      \i
        (switch ch
          (\space \newline \return \tab)
            (do
              (when (and (> mBuffIdx 0) (not (== (aget mBuff mBuffIdx) \space)))
                (.bappend this \space))
              (return))
          nil)
      \c (switch ch (\newline \return \tab) (set! ch \space) nil)
      nil)
    (set! mBuffIdx (unchecked-inc-int mBuffIdx))
    (if (< mBuffIdx (alength mBuff))
        (aset mBuff mBuffIdx ch)
        (do (set! mBuffIdx (unchecked-dec-int mBuffIdx)) (.bappend this ch))))

  (method ^:private bappend :throws [Exception] ^void [this ^char ch]
    (.ensureCapacity this (set! mBuffIdx (unchecked-inc-int mBuffIdx)))
    (aset mBuff mBuffIdx ch))

  (method ^:private bcopy :throws [Exception] ^void [this ^int cidx ^int bidx]
    (let [length (unchecked-subtract-int mChIdx cidx)]
      (.ensureCapacity this (unchecked-add-int (unchecked-add-int bidx length) 1))
      (System/arraycopy mChars cidx mBuff bidx length)
      (set! mBuffIdx (unchecked-add-int mBuffIdx length))))

  (method ^:private eappend ^void [this ^char ch]
    (switch mESt
      0x100
        (switch ch
          \l (set! mESt 0x101)
          \g (set! mESt 0x102)
          \a (set! mESt 0x103)
          \q (set! mESt 0x107)
          (set! mESt 0x200))
      0x101 (set! mESt (if (== ch \t) \< (unchecked-char 0x200)))
      0x102 (set! mESt (if (== ch \t) \> (unchecked-char 0x200)))
      0x103 (switch ch \m (set! mESt 0x104) \p (set! mESt 0x105) (set! mESt 0x200))
      0x104 (set! mESt (if (== ch \p) \& (unchecked-char 0x200)))
      0x105 (set! mESt (if (== ch \o) (unchecked-char 0x106) (unchecked-char 0x200)))
      0x106 (set! mESt (if (== ch \s) \' (unchecked-char 0x200)))
      0x107 (set! mESt (if (== ch \u) (unchecked-char 0x108) (unchecked-char 0x200)))
      0x108 (set! mESt (if (== ch \o) (unchecked-char 0x109) (unchecked-char 0x200)))
      0x109 (set! mESt (if (== ch \t) \" (unchecked-char 0x200)))
      (\< \> \& \' \") (set! mESt 0x200)
      nil))

  (method ^:protected setinp :throws [Exception] ^void [this ^InputSource is]
    (let [^:mutable ^Reader reader nil]
      (set! mChIdx 0)
      (set! mChLen 0)
      (set! mChars (.-chars mInp))
      (set! (.-src mInp) nil)
      (when (< mPh PH_DOC_START) (set! mIsSAlone false))
      (set! mIsSAloneSet false)
      (cond
        (some? (.getCharacterStream is))
          (do (set! reader (.getCharacterStream is)) (.xml this reader))
        (some? (.getByteStream is))
          (let [^:mutable ^String expenc nil]
            (if (some? (.getEncoding is))
                (do
                  (set! expenc (.toUpperCase (.getEncoding is) Locale/ROOT))
                  (if (.equals expenc "UTF-16")
                      (set! reader (.bom this (.getByteStream is) \U))
                      (set! reader (.enc this expenc (.getByteStream is))))
                  (.xml this reader))
                (do
                  (set! reader (.bom this (.getByteStream is) \space))
                  (when (nil? reader) (set! reader (.utf16 this (.getByteStream is))))
                  (if (nil? reader)
                      (do
                        (set! reader (.enc this "UTF-8" (.getByteStream is)))
                        (set! expenc (.xml this reader))
                        (when-not (.equals expenc "UTF-8")
                          (when (.startsWith expenc "UTF-16") (.panic this FAULT))
                          (set! reader (.enc this expenc (.getByteStream is)))))
                      (.xml this reader)))))
        :else (.panic this FAULT))
      (set! (.-src mInp) reader)
      (set! (.-pubid mInp) (.getPublicId is))
      (set! (.-sysid mInp) (.getSystemId is))))

  (method ^:private bom :throws [Exception] ^Reader [this ^InputStream is ^char hint]
    (let [val (.read is)]
      (switch val
        0xef
          (do
            (when (== hint \U) (.panic this FAULT))
            (when-not (== (.read is) 0xbb) (.panic this FAULT))
            (when-not (== (.read is) 0xbf) (.panic this FAULT))
            (ReaderUTF8. is))
        0xfe (do (when-not (== (.read is) 0xff) (.panic this FAULT)) (ReaderUTF16. is \b))
        0xff (do (when-not (== (.read is) 0xfe) (.panic this FAULT)) (ReaderUTF16. is \l))
        -1
          (do
            (aset mChars (let [old-11 mChIdx] (set! mChIdx (unchecked-inc-int mChIdx)) old-11) EOS)
            (ReaderUTF8. is))
        (do
          (when (== hint \U) (.panic this FAULT))
          (switch (bit-and-int val 0xf0)
            (0xc0 0xd0)
              (aset mChars
                    (let [old-12 mChIdx] (set! mChIdx (unchecked-inc-int mChIdx)) old-12)
                    (unchecked-char
                      (bit-or-int (bit-shift-left-int (bit-and-int val 0x1f) 6)
                                  (bit-and-int (.read is) 0x3f))))
            0xe0
              (aset mChars
                    (let [old-13 mChIdx] (set! mChIdx (unchecked-inc-int mChIdx)) old-13)
                    (unchecked-char
                      (bit-or-int (bit-or-int (bit-shift-left-int (bit-and-int val 0x0f) 12)
                                              (bit-shift-left-int (bit-and-int (.read is) 0x3f) 6))
                                  (bit-and-int (.read is) 0x3f))))
            0xf0 (throw (UnsupportedEncodingException.))
            (aset mChars
                  (let [old-14 mChIdx] (set! mChIdx (unchecked-inc-int mChIdx)) old-14)
                  (unchecked-char val)))
          nil))))

  (method ^:private utf16 :throws [Exception] ^Reader [this ^InputStream is]
    (when-not (== mChIdx 0)
      (let [b0 (unchecked-byte (aget mChars 0))]
        (when (or (== b0 0x00) (== b0 0x3C))
          (let [b1 (.read is)
                b2 (.read is)
                b3 (.read is)]
            (cond
              (and (and (and (== b0 0x00) (== b1 0x3C)) (== b2 0x00)) (== b3 0x3F))
                (do
                  (aset mChars 0 (unchecked-char b1))
                  (aset mChars
                        (let [old-15 mChIdx] (set! mChIdx (unchecked-inc-int mChIdx)) old-15)
                        (unchecked-char b3))
                  (return (ReaderUTF16. is \b)))
              (and (and (and (== b0 0x3C) (== b1 0x00)) (== b2 0x3F)) (== b3 0x00))
                (do
                  (aset mChars 0 (unchecked-char b0))
                  (aset mChars
                        (let [old-16 mChIdx] (set! mChIdx (unchecked-inc-int mChIdx)) old-16)
                        (unchecked-char b2))
                  (return (ReaderUTF16. is \l)))
              :else
                (do
                  (aset mChars 0 (unchecked-char b0))
                  (aset mChars
                        (let [old-17 mChIdx] (set! mChIdx (unchecked-inc-int mChIdx)) old-17)
                        (unchecked-char b1))
                  (aset mChars
                        (let [old-18 mChIdx] (set! mChIdx (unchecked-inc-int mChIdx)) old-18)
                        (unchecked-char b2))
                  (aset mChars
                        (let [old-19 mChIdx] (set! mChIdx (unchecked-inc-int mChIdx)) old-19)
                        (unchecked-char b3))))))))
    nil)

  (method ^:private xml :throws [Exception] ^String [this ^Reader reader]
    (let [^:mutable ^String str nil
          ^:mutable enc "UTF-8"
          ^:mutable ^char ch (unchecked-char 0)
          ^:mutable ^int val 0
          ^:mutable ^short st 0
          byteRead mChIdx]
      (while (and (>= st 0) (< mChIdx (alength mChars)))
        (if (< st byteRead)
            (set! ch (aget mChars st))
            (do
              (set! ch (if (>= (set! val (.read reader)) 0) (unchecked-char val) EOS))
              (aset mChars (let [old-20 mChIdx] (set! mChIdx (unchecked-inc-int mChIdx)) old-20) ch)))
        (switch st
          0
            (switch ch
              \< (set! st 1)
              0xfeff
                (do
                  (set! ch (if (>= (set! val (.read reader)) 0) (unchecked-char val) EOS))
                  (aset mChars (unchecked-subtract-int mChIdx 1) ch)
                  (set! st (unchecked-short (if (== ch \<) 1 -1))))
              (set! st -1))
          1 (set! st (unchecked-short (if (== ch \?) 2 -1)))
          2 (set! st (unchecked-short (if (== ch \x) 3 -1)))
          3 (set! st (unchecked-short (if (== ch \m) 4 -1)))
          4 (set! st (unchecked-short (if (== ch \l) 5 -1)))
          5 (switch ch (\space \tab \return \newline) (set! st 6) (set! st -1))
          6 (switch ch \? (set! st 7) EOS (set! st -2) nil)
          7 (switch ch (\> EOS) (set! st -2) (set! st 6))
          (.panic this FAULT)))
      (set! mChLen mChIdx)
      (set! mChIdx 0)
      (if (== st -1)
          enc
          (do
            (set! mChIdx 5)
            (set! st 0)
            (while (>= st 0)
              (set! ch (.getch this))
              (switch st
                0 (when-not (== (.chtyp this ch) \space) (.bkch this) (set! st 1))
                (1 2 3)
                  (switch (.chtyp this ch)
                    (\a \A \_)
                      (do
                        (.bkch this)
                        (set! str (.toLowerCase (.name this false) Locale/ROOT))
                        (cond
                          (= (.equals "version" str) true)
                            (do
                              (when-not (== st 1) (.panic this FAULT))
                              (when-not (= (.equals "1.0" (.eqstr this \=)) true)
                                (.panic this FAULT))
                              (set! (.-xmlver mInp) 0x0100)
                              (set! st 2))
                          (= (.equals "encoding" str) true)
                            (do
                              (when-not (== st 2) (.panic this FAULT))
                              (set! (.-xmlenc mInp) (.toUpperCase (.eqstr this \=) Locale/ROOT))
                              (set! enc (.-xmlenc mInp))
                              (set! st 3))
                          (= (.equals "standalone" str) true)
                            (do
                              (when (or (== st 1) (>= mPh PH_DOC_START)) (.panic this FAULT))
                              (set! str (.toLowerCase (.eqstr this \=) Locale/ROOT))
                              (cond
                                (= (.equals str "yes") true) (set! mIsSAlone true)
                                (= (.equals str "no") true) (set! mIsSAlone false)
                                :else (.panic this FAULT))
                              (set! mIsSAloneSet true)
                              (set! st 4))
                          :else (.panic this FAULT)))
                    \space nil
                    \? (do (when (== st 1) (.panic this FAULT)) (.bkch this) (set! st 4))
                    (.panic this FAULT))
                4
                  (switch (.chtyp this ch)
                    \?
                      (do
                        (when-not (== (.getch this) \>) (.panic this FAULT))
                        (when (<= mPh PH_DOC_START) (set! mPh PH_MISC_DTD))
                        (set! st -1))
                    \space nil
                    (.panic this FAULT))
                (.panic this FAULT)))
            enc))))

  (method ^:private enc :throws [UnsupportedEncodingException] ^Reader [this ^String name
                                                                        ^InputStream is]
    (cond
      (.equals name "UTF-8") (ReaderUTF8. is)
      (.equals name "UTF-16LE") (ReaderUTF16. is \l)
      (.equals name "UTF-16BE") (ReaderUTF16. is \b)
      :else (InputStreamReader. is name)))

  (method ^:protected push ^void [this ^Input inp]
    (set! (.-chLen mInp) mChLen)
    (set! (.-chIdx mInp) mChIdx)
    (set! (.-next inp) mInp)
    (set! mInp inp)
    (set! mChars (.-chars inp))
    (set! mChLen (.-chLen inp))
    (set! mChIdx (.-chIdx inp)))

  (method ^:protected pop ^void [this]
    (when (some? (.-src mInp))
      (try (.close (.-src mInp)) (catch IOException ioe))
      (set! (.-src mInp) nil))
    (set! mInp (.-next mInp))
    (if (some? mInp)
        (do (set! mChars (.-chars mInp)) (set! mChLen (.-chLen mInp)) (set! mChIdx (.-chIdx mInp)))
        (do (set! mChars nil) (set! mChLen 0) (set! mChIdx 0))))

  (method ^:protected chtyp ^char [this ^char ch]
    (cond (< ch 0x80) (unchecked-char (aget asctyp ch)) (not (== ch EOS)) \X :else \Z))

  (method ^:protected getch :throws [IOException] ^char [this]
    (when (>= mChIdx mChLen)
      (when (nil? (.-src mInp)) (.pop this) (return (.getch this)))
      (let [Num (.read (.-src mInp) mChars 0 (alength mChars))]
        (if (< Num 0)
            (if (not (identical? mInp mDoc))
                (do (.pop this) (return (.getch this)))
                (do (aset mChars 0 EOS) (set! mChLen 1)))
            (set! mChLen Num))
        (set! mChIdx 0)))
    (let [mChIdx-21 mChIdx] (set! mChIdx (unchecked-inc-int mChIdx)) (aget mChars mChIdx-21)))

  (method ^:protected bkch :throws [Exception] ^void [this]
    (when (<= mChIdx 0) (.panic this FAULT))
    (set! mChIdx (unchecked-dec-int mChIdx)))

  (method ^:protected setch ^void [this ^char ch] (aset mChars mChIdx ch))

  (method ^:protected find ^Pair [this ^Pair chain ^char/1 qname]
    (loop [pair chain]
      (if (some? pair) (if (= (.eqname pair qname) true) (return pair) (recur (.-next pair))) nil))
    nil)

  (method ^:protected pair ^Pair [this ^Pair next]
    (let [^:mutable ^Pair pair nil]
      (if (some? mDltd) (do (set! pair mDltd) (set! mDltd (.-next pair))) (set! pair (Pair.)))
      (set! (.-next pair) next)
      pair))

  (method ^:protected del ^Pair [this ^Pair pair]
    (let [next (.-next pair)]
      (set! (.-name pair) nil)
      (set! (.-value pair) nil)
      (set! (.-chars pair) nil)
      (set! (.-list pair) nil)
      (set! (.-next pair) mDltd)
      (set! mDltd pair)
      next))

  (method ^:private ensureCapacity :throws [Exception] ^void [this ^int minCapacity]
    (cond
      (nil? mBuff)
        (let [^int newCapacity (if (> minCapacity BUFFSIZE_PARSER)
                                   (unchecked-add-int minCapacity BUFFSIZE_PARSER)
                                   BUFFSIZE_PARSER)]
          (set! mBuff (new char/1 newCapacity)))
      (<= (alength mBuff) minCapacity)
        (let [size (bit-shift-left-int (alength mBuff) 1)
              ^int newCapacity (if (> size minCapacity)
                                   size
                                   (unchecked-add-int minCapacity BUFFSIZE_PARSER))]
          (when (or (< newCapacity 0) (> newCapacity MAX_ARRAY_SIZE)) (.panic this FAULT))
          (set! mBuff (Arrays/copyOf mBuff newCapacity))))))

                      (do
                        (when-not (== flag \-) (.bappend this \space))
                        (.push this (Input. BUFFSIZE_READER))
                        (.setinp this is)
                        (set! (.-pubid mInp) (.-pubid inp))
                        (set! (.-sysid mInp) (.-sysid inp)))
                      (.skippedEnt this (java-str "%" str))))
                (do
                  (if (== flag \-)
                      (set! (.-chIdx inp) 1)

          prefLength
          (ArraysSupport/hugeLength oldLength minGrowth))))

  (method ^:private ^:static hugeLength ^int [^int oldLength ^int minGrowth]
    (let [minLength (unchecked-add-int oldLength minGrowth)]
      (cond
        (< minLength 0)
          (throw (OutOfMemoryError.
                   (java-str "Required array length " oldLength " + " minGrowth " is too large")))
        (<= minLength SOFT_MAX_ARRAY_LENGTH) SOFT_MAX_ARRAY_LENGTH
        :else minLength)))

  (method ^:public ^:static reverse :type-params [T] ^T/1 [^T/1 a]
    (let [limit (unchecked-divide-int (alength a) 2)]
      (loop [^int i 0
             ^int j (unchecked-subtract-int (alength a) 1)]
        (when (< i limit)
          (let [^T t (aget a i)]
            (aset a i (aget a j))
            (aset a j t)
            (recur (unchecked-inc-int i) (unchecked-dec-int j)))))
      a))

  (method ^:public ^:static toArrayReversed :type-params [T] ^T/1 [^{:tag (Collection ?)} coll
                                                                   ^T/1 array]
    (let [^T/1 newArray (ArraysSupport/reverse (.toArray coll (Arrays/copyOfRange array 0 0)))]
      (if (> (alength newArray) (alength array))
          newArray
          (do
            (System/arraycopy newArray 0 array 0 (alength newArray))
            (when (> (alength array) (alength newArray)) (aset array (alength newArray) nil))
            array)))))

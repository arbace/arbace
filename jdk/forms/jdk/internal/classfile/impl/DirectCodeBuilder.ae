          (do
            (when-not (== (.getBCI lab) -1)
              (throw (IllegalArgumentException. "Setting label target for already-set label")))
            (.setBCI lab bci))
          (.setLabelTarget this lab bci))))

  (method ^:private setLabelTarget ^void [this ^LabelImpl lab ^int bci]
    (let [context (.labelContext lab)]
      (if (identical? context mruParent)
          (aset mruParentTable (.getBCI lab) (unchecked-add-int bci 1))
          (if-instance [^CodeAttribute parent context]
            (do
              (when (nil? parentMap) (set! parentMap (IdentityHashMap.)))
              (let [table (cast int/1
                                (.computeIfAbsent
                                  parentMap
                                  parent
                                  (anon (Function CodeAttribute int/1) []
                                    (method ^:public apply ^int/1 [this ^CodeAttribute x]
                                      (new int/1 (unchecked-add-int (.codeLength parent) 1))))))]
                (set! mruParent parent)
                (set! mruParentTable table)
                (aset table (.getBCI lab) (unchecked-add-int bci 1))))
            (if (instance? BufferedCodeBuilder context)
                (.setBCI lab bci)
                (throw (IllegalStateException.
                         (String/format "Unexpected label context %s in =%s"
                                        (new Object/1 [context this])))))))))


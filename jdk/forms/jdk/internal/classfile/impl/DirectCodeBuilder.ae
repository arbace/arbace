    (Objects/requireNonNull defaultTarget)
    (.writeLookupSwitch this defaultTarget cases)
    this)

  (method ^:public l2d ^CodeBuilder [this]
    (.writeU1 bytecodesBufWriter RawBytecodeHelper/L2D)
    this)

  (method ^:public l2f ^CodeBuilder [this]
    (.writeU1 bytecodesBufWriter RawBytecodeHelper/L2F)
    this)

  (method ^:public l2i ^CodeBuilder [this]
    (.writeU1 bytecodesBufWriter RawBytecodeHelper/L2I)
    this)

  (method ^:public ladd ^CodeBuilder [this]
    (.writeU1 bytecodesBufWriter RawBytecodeHelper/LADD)
    this)

  (method ^:public land ^CodeBuilder [this]
    (.writeU1 bytecodesBufWriter RawBytecodeHelper/LAND)
    this)

  (method ^:public lcmp ^CodeBuilder [this]
    (.writeU1 bytecodesBufWriter RawBytecodeHelper/LCMP)
    this)

  (method ^:public lconst_0 ^CodeBuilder [this]
    (.writeU1 bytecodesBufWriter RawBytecodeHelper/LCONST_0)
    this)

  (method ^:public lconst_1 ^CodeBuilder [this]
    (.writeU1 bytecodesBufWriter RawBytecodeHelper/LCONST_1)
    this)

  (method ^:public ldc ^CodeBuilder [this ^LoadableConstantEntry entry]
    (let [direct (cast LoadableConstantEntry
                       (AbstractPoolEntry/maybeClone (.-constantPool this) entry))]
      (.writeDirectLoadConstant this (BytecodeHelpers/ldcOpcode direct) direct)
      this))

  (method ^:public ldiv ^CodeBuilder [this]
    (.writeU1 bytecodesBufWriter RawBytecodeHelper/LDIV)
    this)

  (method ^:public lload ^CodeBuilder [this ^int slot]
    (if (and (>= slot 0) (<= slot 3))
        (.writeU1 bytecodesBufWriter (unchecked-add-int RawBytecodeHelper/LLOAD_0 slot))
        (.localAccess this RawBytecodeHelper/LLOAD slot))
    this)

  (method ^:public lmul ^CodeBuilder [this]
    (.writeU1 bytecodesBufWriter RawBytecodeHelper/LMUL)
    this)

  (method ^:public lneg ^CodeBuilder [this]
    (.writeU1 bytecodesBufWriter RawBytecodeHelper/LNEG)
    this)

  (method ^:public lor ^CodeBuilder [this]
    (.writeU1 bytecodesBufWriter RawBytecodeHelper/LOR)
    this)

  (method ^:public lrem ^CodeBuilder [this]
    (.writeU1 bytecodesBufWriter RawBytecodeHelper/LREM)
    this)

  (method ^:public lreturn ^CodeBuilder [this]
    (.writeU1 bytecodesBufWriter RawBytecodeHelper/LRETURN)
    this)

  (method ^:public lshl ^CodeBuilder [this]
    (.writeU1 bytecodesBufWriter RawBytecodeHelper/LSHL)
    this)

  (method ^:public lshr ^CodeBuilder [this]
    (.writeU1 bytecodesBufWriter RawBytecodeHelper/LSHR)
    this)

  (method ^:public lstore ^CodeBuilder [this ^int slot]
    (if (and (>= slot 0) (<= slot 3))
        (.writeU1 bytecodesBufWriter (unchecked-add-int RawBytecodeHelper/LSTORE_0 slot))
        (.localAccess this RawBytecodeHelper/LSTORE slot))
    this)

  (method ^:public lsub ^CodeBuilder [this]
    (.writeU1 bytecodesBufWriter RawBytecodeHelper/LSUB)
    this)

  (method ^:public lushr ^CodeBuilder [this]
    (.writeU1 bytecodesBufWriter RawBytecodeHelper/LUSHR)
    this)

  (method ^:public lxor ^CodeBuilder [this]
    (.writeU1 bytecodesBufWriter RawBytecodeHelper/LXOR)
    this)

  (method ^:public monitorenter ^CodeBuilder [this]
    (.writeU1 bytecodesBufWriter RawBytecodeHelper/MONITORENTER)
    this)

  (method ^:public monitorexit ^CodeBuilder [this]
    (.writeU1 bytecodesBufWriter RawBytecodeHelper/MONITOREXIT)
    this)

  (method ^:public multianewarray ^CodeBuilder [this ^ClassEntry array ^int dims]
    (BytecodeHelpers/validateMultiArrayDimensions dims)
    (.writeNewMultidimensionalArray this dims array)
    this)

  (method ^:public new_ ^CodeBuilder [this ^ClassEntry clazz]
    (.writeNewObject this clazz)
    this)

  (method ^:public newarray ^CodeBuilder [this ^TypeKind typeKind]
    (let [atype (.newarrayCode typeKind)]
      (when (< atype 0)
        (throw (IllegalArgumentException.
                 (.concat "Illegal component type: " (.displayName (.upperBound typeKind))))))
      (.writeNewPrimitiveArray this atype)
      this))

  (method ^:public pop ^CodeBuilder [this]
    (.writeU1 bytecodesBufWriter RawBytecodeHelper/POP)
    this)

  (method ^:public pop2 ^CodeBuilder [this]
    (.writeU1 bytecodesBufWriter RawBytecodeHelper/POP2)
    this)

  (method ^:public sipush ^CodeBuilder [this ^int s]
    (BytecodeHelpers/validateSipush s)
    (.writeU1U2 bytecodesBufWriter RawBytecodeHelper/SIPUSH s)
    this)

  (method ^:public swap ^CodeBuilder [this]
    (.writeU1 bytecodesBufWriter RawBytecodeHelper/SWAP)
    this)

  (method ^:public tableswitch ^CodeBuilder [this ^int low ^int high ^Label defaultTarget
                                             ^{:tag (List SwitchCase)} cases]
    (Objects/requireNonNull defaultTarget)
    (.writeTableSwitch this low high defaultTarget cases)
    this))

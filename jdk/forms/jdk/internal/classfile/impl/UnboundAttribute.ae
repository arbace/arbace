  (defclass ^:public ^:static ^:final UnboundModuleAttribute
    :extends (UnboundAttribute ModuleAttribute)
    :implements [ModuleAttribute]

    (field ^:private ^:static ^:final ^Utf8Entry NAME
      (.utf8Entry TemporaryConstantPool/INSTANCE Attributes/NAME_MODULE))

    (field ^:private ^:final ^ModuleEntry moduleName)

    (field ^:private ^:final ^int moduleFlags)

    (field ^:private ^:final ^Utf8Entry moduleVersion)

    (field ^:private ^:final ^{:tag (List ModuleRequireInfo)} requires)

    (field ^:private ^:final ^{:tag (List ModuleExportInfo)} exports)

    (field ^:private ^:final ^{:tag (List ModuleOpenInfo)} opens)

    (field ^:private ^:final ^{:tag (List ClassEntry)} uses)

    (field ^:private ^:final ^{:tag (List ModuleProvideInfo)} provides)

    (constructor ^:public [this ^ModuleEntry moduleName ^int moduleFlags ^Utf8Entry moduleVersion
                           ^{:tag (Collection ModuleRequireInfo)} requires
                           ^{:tag (Collection ModuleExportInfo)} exports
                           ^{:tag (Collection ModuleOpenInfo)} opens
                           ^{:tag (Collection ClassEntry)} uses
                           ^{:tag (Collection ModuleProvideInfo)} provides]
      (super. (Attributes/module))
      (set! (.-moduleName this) (cast ModuleEntry (Objects/requireNonNull moduleName)))
      (set! (.-moduleFlags this) (Util/checkFlags moduleFlags))
      (set! (.-moduleVersion this) moduleVersion)
      (set! (.-requires this) (Util/sanitizeU2List requires))
      (set! (.-exports this) (Util/sanitizeU2List exports))
      (set! (.-opens this) (Util/sanitizeU2List opens))
      (set! (.-uses this) (Util/sanitizeU2List uses))
      (set! (.-provides this) (Util/sanitizeU2List provides)))

    (method ^:public moduleName ^ModuleEntry [this] moduleName)

    (method ^:public moduleFlagsMask ^int [this] moduleFlags)

    (method ^:public moduleVersion ^{:tag (Optional Utf8Entry)} [this]
      (Optional/ofNullable moduleVersion))

    (method ^:public requires ^{:tag (List ModuleRequireInfo)} [this]
      requires)

    (method ^:public exports ^{:tag (List ModuleExportInfo)} [this] exports)

    (method ^:public opens ^{:tag (List ModuleOpenInfo)} [this] opens)

    (method ^:public uses ^{:tag (List ClassEntry)} [this] uses)

    (method ^:public provides ^{:tag (List ModuleProvideInfo)} [this]
      provides)

    (method ^:public attributeName ^Utf8Entry [this] NAME))

  (defclass ^:public ^:abstract ^:static ^:non-sealed AdHocAttribute
    :extends (UnboundAttribute T)
    :type-params [(T extends (Attribute T))]

    (constructor ^:public [this ^{:tag (AttributeMapper T)} mapper]
      (super. mapper))

    (method ^:public ^:abstract writeBody ^void [this ^BufWriterImpl b])

    (method ^:public writeTo ^void [this ^BufWriterImpl b]
      (.writeIndex b (.utf8Entry (.constantPool b) (.name (.-mapper this))))
      (let [lengthIndex (.skip b 4)]
        (.writeBody this b)
        (let [written (unchecked-subtract-int (unchecked-subtract-int (.size b) lengthIndex) 4)]
          (.patchInt b lengthIndex written)))))

  (defclass ^:public ^:static ^:final EmptyBootstrapAttribute
    :extends (UnboundAttribute BootstrapMethodsAttribute)

    (constructor ^:public [this] (super. (Attributes/bootstrapMethods)))

    (method ^:public bootstrapMethodsSize ^int [this] 0)

    (method ^:public bootstrapMethods ^{:tag (List BootstrapMethodEntry)} [this]
      (List/of))

    (method ^:public attributeName ^Utf8Entry [this] NAME)))

      (if (nil? e)
          (cast DoubleEntry
                (.internalAdd this (AbstractPoolEntry$DoubleEntryImpl. this size value)))
          e)))

  (method ^:public stringEntry ^StringEntry [this ^Utf8Entry utf8]
    (let [ue (.maybeCloneUtf8Entry this utf8)
          e (cast AbstractPoolEntry$StringEntryImpl (.findEntry this PoolEntry/TAG_STRING ue))]
      (if (nil? e)
          (cast StringEntry (.internalAdd this (AbstractPoolEntry$StringEntryImpl. this size ue)))
          ^StringEntry e)))

  (method ^:public bsmEntry ^BootstrapMethodEntry [this ^:mutable ^MethodHandleEntry methodReference
                                                   ^:mutable ^{:tag (List LoadableConstantEntry)} arguments]
    (set! methodReference
          (cast MethodHandleEntry (AbstractPoolEntry/maybeClone this methodReference)))
    (for-each [^LoadableConstantEntry a arguments]
      (when-not (.canWriteDirect this (.constantPool a))
        (let [arr (cast LoadableConstantEntry/1
                        (.toArray arguments (new LoadableConstantEntry/1 0)))]
          (loop [^int i 0]
            (when (< i (alength arr))
              (aset arr
                    i
                    (cast LoadableConstantEntry (AbstractPoolEntry/maybeClone this (aget arr i))))
              (recur (unchecked-inc-int i))))
          (set! arguments (List/of arr))
          (break))))
    (let [mre (cast AbstractPoolEntry$MethodHandleEntryImpl methodReference)
          hash (BootstrapMethodEntryImpl/computeHashCode mre arguments)
          map (.bsmMap this)]
      (loop [^int token (.firstToken map hash)]
        (when-not (== token -1)
          (let [e (.bootstrapMethodEntry this (.getIndexByToken map token))]
            (if (and (identical? (.bootstrapMethod e) mre) (.equals (.arguments e) arguments))
                (return e)
                (recur (.nextToken map hash token))))))
      (let [ne (BootstrapMethodEntryImpl. this bsmSize hash mre arguments)]
        (.internalAdd this ne hash)))))

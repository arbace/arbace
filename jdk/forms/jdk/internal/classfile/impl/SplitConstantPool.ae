                              (AbstractPoolEntry$MethodHandleEntryImpl.
                                this
                                size
                                hash
                                refKind
                                (cast AbstractPoolEntry$AbstractMemberRefEntry reference))
                              hash)))))

  (method ^:public invokeDynamicEntry ^InvokeDynamicEntry [this
                                                           ^:mutable ^BootstrapMethodEntry bootstrapMethodEntry
                                                           ^:mutable ^NameAndTypeEntry nameAndType]
    (when-not (.canWriteDirect this (.constantPool bootstrapMethodEntry))
      (set! bootstrapMethodEntry
            (.bsmEntry this
                       (.bootstrapMethod bootstrapMethodEntry)
                       (.arguments bootstrapMethodEntry))))
    (set! nameAndType (cast NameAndTypeEntry (AbstractPoolEntry/maybeClone this nameAndType)))
    (let [hash (AbstractPoolEntry/hash2 PoolEntry/TAG_INVOKE_DYNAMIC
                                        (.bsmIndex bootstrapMethodEntry)
                                        (.index nameAndType))
          map1 (.map this)]
      (loop [^int token (.firstToken map1 hash)]
        (when-not (== token -1)
          (let [e (.entryByIndex this (.getIndexByToken map1 token))]
            (if (== (.tag e) PoolEntry/TAG_INVOKE_DYNAMIC)
                (if-instance [^AbstractPoolEntry$InvokeDynamicEntryImpl ce e]
                  (if (identical? (.bootstrap ce) bootstrapMethodEntry)
                      (if (identical? (.nameAndType ce) nameAndType)
                          (return ce)
                          (recur (.nextToken map1 hash token)))
                      (recur (.nextToken map1 hash token)))
                  (recur (.nextToken map1 hash token)))
                (recur (.nextToken map1 hash token))))))
      (if (not doneFullScan)
          (do (.fullScan this) (.invokeDynamicEntry this bootstrapMethodEntry nameAndType))
          (let [ce (AbstractPoolEntry$InvokeDynamicEntryImpl.
                     this
                     size
                     hash
                     (cast BootstrapMethodEntryImpl bootstrapMethodEntry)
                     (cast AbstractPoolEntry$NameAndTypeEntryImpl nameAndType))]
            (.internalAdd this ce hash)
            ce))))

  (method ^:public constantDynamicEntry ^ConstantDynamicEntry [this
                                                               ^:mutable ^BootstrapMethodEntry bootstrapMethodEntry
                                                               ^:mutable ^NameAndTypeEntry nameAndType]
    (when-not (.canWriteDirect this (.constantPool bootstrapMethodEntry))
      (set! bootstrapMethodEntry
            (.bsmEntry this
                       (.bootstrapMethod bootstrapMethodEntry)
                       (.arguments bootstrapMethodEntry))))
    (set! nameAndType (cast NameAndTypeEntry (AbstractPoolEntry/maybeClone this nameAndType)))
    (let [hash (AbstractPoolEntry/hash2 PoolEntry/TAG_DYNAMIC
                                        (.bsmIndex bootstrapMethodEntry)
                                        (.index nameAndType))
          map1 (.map this)]
      (loop [^int token (.firstToken map1 hash)]
        (when-not (== token -1)
          (let [e (.entryByIndex this (.getIndexByToken map1 token))]
            (if (== (.tag e) PoolEntry/TAG_DYNAMIC)
                (if-instance [^AbstractPoolEntry$ConstantDynamicEntryImpl ce e]
                  (if (identical? (.bootstrap ce) bootstrapMethodEntry)
                      (if (identical? (.nameAndType ce) nameAndType)
                          (return ce)
                          (recur (.nextToken map1 hash token)))
                      (recur (.nextToken map1 hash token)))
                  (recur (.nextToken map1 hash token)))
                (recur (.nextToken map1 hash token))))))
      (if (not doneFullScan)
          (do (.fullScan this) (.constantDynamicEntry this bootstrapMethodEntry nameAndType))
          (let [ce (AbstractPoolEntry$ConstantDynamicEntryImpl.
                     this
                     size
                     hash
                     (cast BootstrapMethodEntryImpl bootstrapMethodEntry)
                     (cast AbstractPoolEntry$NameAndTypeEntryImpl nameAndType))]
            (.internalAdd this ce hash)
            ce))))

  (method ^:public intEntry ^IntegerEntry [this ^int value]
    (let [e (.findIntEntry this value)]
      (if (nil? e)
          (cast IntegerEntry
                (.internalAdd this (AbstractPoolEntry$IntegerEntryImpl. this size value)))
          e)))

  (method ^:public floatEntry ^FloatEntry [this ^float value]
    (let [e (.findFloatEntry this value)]
      (if (nil? e)
          (cast FloatEntry (.internalAdd this (AbstractPoolEntry$FloatEntryImpl. this size value)))
          e)))

  (method ^:public longEntry ^LongEntry [this ^long value]

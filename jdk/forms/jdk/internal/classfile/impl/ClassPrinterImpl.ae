        (let [cpNode (MapNodeImpl. Style/BLOCK "constant pool")]
          (for-each [^PoolEntry e cp]
            (.with
              cpNode
              (.with
                (.with (MapNodeImpl. Style/FLOW (.index e))
                       (ClassPrinterImpl/leaf "tag"
                                              ^ConstantDesc (switch (.tag e)
                                                              PoolEntry/TAG_UTF8 "Utf8"
                                                              PoolEntry/TAG_INTEGER "Integer"
                                                              PoolEntry/TAG_FLOAT "Float"
                                                              PoolEntry/TAG_LONG "Long"
                                                              PoolEntry/TAG_DOUBLE "Double"
                                                              PoolEntry/TAG_CLASS "Class"
                                                              PoolEntry/TAG_STRING "String"
                                                              PoolEntry/TAG_FIELDREF "Fieldref"
                                                              PoolEntry/TAG_METHODREF "Methodref"
                                                              PoolEntry/TAG_INTERFACE_METHODREF
                                                                "InterfaceMethodref"
                                                              PoolEntry/TAG_NAME_AND_TYPE
                                                                "NameAndType"
                                                              PoolEntry/TAG_METHOD_HANDLE
                                                                "MethodHandle"
                                                              PoolEntry/TAG_METHOD_TYPE "MethodType"
                                                              PoolEntry/TAG_DYNAMIC "Dynamic"
                                                              PoolEntry/TAG_INVOKE_DYNAMIC
                                                                "InvokeDynamic"
                                                              PoolEntry/TAG_MODULE "Module"
                                                              PoolEntry/TAG_PACKAGE "Package"
                                                              (throw
                                                                (AssertionError.
                                                                  (java-str
                                                                    "Unknown CP tag: "
                                                                    (.tag e)))))))
                ^ClassPrinter$Node/1 (switch e
                                       [^ClassEntry ce]
                                         (ClassPrinterImpl/leafs
                                           "class name index"
                                           (.index (.name ce))
                                           "class internal name"
                                           (.asInternalName ce))
                                       [^ModuleEntry me]
                                         (ClassPrinterImpl/leafs
                                           "module name index"
                                           (.index (.name me))
                                           "module name"
                                           (.stringValue (.name me)))
                                       [^PackageEntry pe]
                                         (ClassPrinterImpl/leafs
                                           "package name index"
                                           (.index (.name pe))
                                           "package name"
                                           (.stringValue (.name pe)))
                                       [^StringEntry se]
                                         (ClassPrinterImpl/leafs
                                           "value index"
                                           (.index (.utf8 se))
                                           "value"
                                           (.stringValue se))
                                       [^MemberRefEntry mre]
                                         (ClassPrinterImpl/leafs
                                           "owner index"
                                           (.index (.owner mre))
                                           "name and type index"
                                           (.index (.nameAndType mre))
                                           "owner"
                                           (.stringValue (.name (.owner mre)))
                                           "name"
                                           (.stringValue (.name mre))
                                           "type"
                                           (.stringValue (.type mre)))
                                       [^NameAndTypeEntry nte]
                                         (ClassPrinterImpl/leafs
                                           "name index"
                                           (.index (.name nte))
                                           "type index"
                                           (.index (.type nte))
                                           "name"
                                           (.stringValue (.name nte))
                                           "type"
                                           (.stringValue (.type nte)))
                                       [^MethodHandleEntry mhe]
                                         (ClassPrinterImpl/leafs
                                           "reference kind"
                                           (.name (DirectMethodHandleDesc$Kind/valueOf (.kind mhe)))
                                           "reference index"
                                           (.index (.reference mhe))
                                           "owner"
                                           (.asInternalName (.owner (.reference mhe)))
                                           "name"
                                           (.stringValue (.name (.reference mhe)))
                                           "type"
                                           (.stringValue (.type (.reference mhe))))
                                       [^MethodTypeEntry mte]
                                         (ClassPrinterImpl/leafs
                                           "descriptor index"
                                           (.index (.descriptor mte))
                                           "descriptor"
                                           (.stringValue (.descriptor mte)))
                                       [^DynamicConstantPoolEntry dcpe]
                                         (new
                                           ClassPrinter$Node/1
                                           [(ClassPrinterImpl/leaf
                                              "bootstrap method handle index"
                                              (.index (.bootstrapMethod (.bootstrap dcpe))))
                                            (ClassPrinterImpl/list
                                              "bootstrap method arguments indexes"
                                              "index"
                                              (.map
                                                (.stream (.arguments (.bootstrap dcpe)))
                                                (lambda Function ^ConstantDesc [^LoadableConstantEntry en]
                                                  (.index en))))
                                            (ClassPrinterImpl/leaf
                                              "name and type index"
                                              (.index (.nameAndType dcpe)))
                                            (ClassPrinterImpl/leaf
                                              "name"
                                              (.stringValue (.name dcpe)))
                                            (ClassPrinterImpl/leaf
                                              "type"
                                              (.stringValue (.type dcpe)))])
                                       [^AnnotationConstantValueEntry ve]
                                         (ClassPrinterImpl/leafs
                                           "value"
                                           (String/valueOf (.constantValue ve)))
                                       (throw (MatchException. nil nil))))))
          (new ClassPrinter$Node/1 [cpNode]))
        (new ClassPrinter$Node/1 0)))

  (method ^:private ^:static frameToTree ^ClassPrinter$Node [^ConstantDesc name ^CodeAttribute lr
                                                             ^StackMapFrameInfo f]
    (.with (MapNodeImpl. Style/FLOW name)
           (ClassPrinterImpl/list "locals" "item" (ClassPrinterImpl/convertVTIs lr (.locals f)))
           (ClassPrinterImpl/list "stack" "item" (ClassPrinterImpl/convertVTIs lr (.stack f)))))

  (method ^:private ^:static fieldToTree ^ClassPrinter$MapNode [^FieldModel f
                                                                ^ClassPrinter$Verbosity verbosity]
    (.with (.with (MapNodeImpl. Style/BLOCK "field")
                  (ClassPrinterImpl/leaf "field name" (.stringValue (.fieldName f)))
                  (ClassPrinterImpl/list "flags"
                                         "flag"
                                         (.map (.stream (.flags (.flags f)))
                                               (method-ref
                                                 Function
                                                 ^ConstantDesc [AccessFlag]
                                                 AccessFlag/.name)))
                  (ClassPrinterImpl/leaf "field type" (.stringValue (.fieldType f)))
                  (ClassPrinterImpl/list "attributes"
                                         "attribute"
                                         (.map (.map
                                                 (.stream (.attributes f))
                                                 (method-ref
                                                   Function
                                                   ^Utf8Entry [Attribute]
                                                   Attribute/.attributeName))
                                               (method-ref
                                                 Function
                                                 ^ConstantDesc [Utf8Entry]
                                                 Utf8Entry/.stringValue))))
           (ClassPrinterImpl/attributesToTree (.attributes f) verbosity)))

  (method ^:public ^:static methodToTree ^ClassPrinter$MapNode [^MethodModel m
                                                                ^ClassPrinter$Verbosity verbosity]
    (.with (.with (.with (MapNodeImpl. Style/BLOCK "method")
                         (ClassPrinterImpl/leaf "method name" (.stringValue (.methodName m)))
                         (ClassPrinterImpl/list "flags"
                                                "flag"
                                                (.map
                                                  (.stream (.flags (.flags m)))
                                                  (method-ref
                                                    Function
                                                    ^ConstantDesc [AccessFlag]
                                                    AccessFlag/.name)))
                         (ClassPrinterImpl/leaf "method type" (.stringValue (.methodType m)))
                         (ClassPrinterImpl/list "attributes"
                                                "attribute"
                                                (.map
                                                  (.map
                                                    (.stream (.attributes m))
                                                    (method-ref
                                                      Function
                                                      ^Utf8Entry [Attribute]
                                                      Attribute/.attributeName))
                                                  (method-ref
                                                    Function
                                                    ^ConstantDesc [Utf8Entry]
                                                    Utf8Entry/.stringValue))))
                  (ClassPrinterImpl/attributesToTree (.attributes m) verbosity))
           (ClassPrinterImpl/codeToTree (cast CodeAttribute (.orElse (.code m) nil)) verbosity)))

  (method ^:private ^:static codeToTree ^ClassPrinter$MapNode [^CodeAttribute com
                                                               ^ClassPrinter$Verbosity verbosity]
    (when (and (not (identical? verbosity ClassPrinter$Verbosity/MEMBERS_ONLY)) (some? com))
      (let [codeNode (MapNodeImpl. Style/BLOCK "code")]
        (.with codeNode (ClassPrinterImpl/leaf "max stack" (.maxStack com)))
        (.with codeNode (ClassPrinterImpl/leaf "max locals" (.maxLocals com)))
        (.with codeNode
               (ClassPrinterImpl/list "attributes"
                                      "attribute"
                                      (.map (.map
                                              (.stream (.attributes com))
                                              (method-ref
                                                Function
                                                ^Utf8Entry [Attribute]
                                                Attribute/.attributeName))
                                            (method-ref
                                              Function
                                              ^ConstantDesc [Utf8Entry]
                                              Utf8Entry/.stringValue))))
        (let [stackMap (MapNodeImpl. Style/BLOCK "stack map frames")
              visibleTypeAnnos (LinkedHashMap.)
              invisibleTypeAnnos (LinkedHashMap.)
              ^:mutable ^{:tag (List LocalVariableInfo)} locals (List/of)]
          (for-each [^Attribute attr (.attributes com)]
            (if-instance [^StackMapTableAttribute smta attr]
              (do
                (.with codeNode stackMap)
                (for-each [^StackMapFrameInfo smf (.entries smta)]
                  (.with stackMap
                         (ClassPrinterImpl/frameToTree (.labelToBci com (.target smf)) com smf))))
              (when (and (identical? verbosity ClassPrinter$Verbosity/TRACE_ALL) (some? attr))
                (switch attr
                  [^LocalVariableTableAttribute lvta]
                    (do
                      (set! locals (.localVariables lvta))
                      (.with codeNode
                             (ListNodeImpl. Style/BLOCK
                                            "local variables"
                                            (.mapToObj
                                              (IntStream/range 0 (.size locals))
                                              (lambda IntFunction ^ClassPrinter$Node [^int i]
                                                (let [lv (cast
                                                           LocalVariableInfo
                                                           (.get (.localVariables lvta) i))]
                                                  (ClassPrinterImpl/map
                                                    (unchecked-add-int i 1)
                                                    "start"
                                                    (.startPc lv)
                                                    "end"
                                                    (unchecked-add-int (.startPc lv) (.length lv))
                                                    "slot"
                                                    (.slot lv)
                                                    "name"
                                                    (.stringValue (.name lv))
                                                    "type"
                                                    (.stringValue (.type lv)))))))))
                  [^LocalVariableTypeTableAttribute lvtta]
                    (.with codeNode
                           (ListNodeImpl. Style/BLOCK
                                          "local variable types"
                                          (.mapToObj
                                            (IntStream/range 0 (.size (.localVariableTypes lvtta)))
                                            (lambda IntFunction ^ClassPrinter$Node [^int i]
                                              (let [lvt (cast
                                                          LocalVariableTypeInfo
                                                          (.get (.localVariableTypes lvtta) i))]
                                                (ClassPrinterImpl/map
                                                  (unchecked-add-int i 1)
                                                  "start"
                                                  (.startPc lvt)
                                                  "end"
                                                  (unchecked-add-int (.startPc lvt) (.length lvt))
                                                  "slot"
                                                  (.slot lvt)
                                                  "name"
                                                  (.stringValue (.name lvt))
                                                  "signature"
                                                  (.stringValue (.signature lvt))))))))
                  [^LineNumberTableAttribute lnta]
                    (.with codeNode
                           (ListNodeImpl. Style/BLOCK
                                          "line numbers"
                                          (.mapToObj
                                            (IntStream/range 0 (.size (.lineNumbers lnta)))
                                            (lambda IntFunction ^ClassPrinter$Node [^int i]
                                              (let [ln (cast
                                                         LineNumberInfo
                                                         (.get (.lineNumbers lnta) i))]
                                                (ClassPrinterImpl/map
                                                  (unchecked-add-int i 1)
                                                  "start"
                                                  (.startPc ln)
                                                  "line number"
                                                  (.lineNumber ln)))))))
                  [^CharacterRangeTableAttribute crta]
                    (.with codeNode
                           (ListNodeImpl. Style/BLOCK
                                          "character ranges"
                                          (.mapToObj
                                            (IntStream/range 0 (.size (.characterRangeTable crta)))
                                            (lambda IntFunction ^ClassPrinter$Node [^int i]
                                              (let [cr (cast
                                                         CharacterRangeInfo
                                                         (.get (.characterRangeTable crta) i))]
                                                (ClassPrinterImpl/map
                                                  (unchecked-add-int i 1)
                                                  "start"
                                                  (.startPc cr)
                                                  "end"
                                                  (.endPc cr)
                                                  "range start"
                                                  (.characterRangeStart cr)
                                                  "range end"
                                                  (.characterRangeEnd cr)
                                                  "flags"
                                                  (.flags cr)))))))
                  [^RuntimeVisibleTypeAnnotationsAttribute rvtaa]
                    (.forEach (.annotations rvtaa)
                              (lambda Consumer ^void [^TypeAnnotation a]
                                (ClassPrinterImpl/forEachOffset
                                  a
                                  com
                                  (lambda BiConsumer ^void [^Integer off ^TypeAnnotation an]
                                    (.add (cast
                                            List
                                            (.computeIfAbsent
                                              visibleTypeAnnos
                                              off
                                              (lambda Function ^List [^Integer o] (LinkedList.))))
                                          an)))))
                  [^RuntimeInvisibleTypeAnnotationsAttribute ritaa]
                    (.forEach (.annotations ritaa)
                              (lambda Consumer ^void [^TypeAnnotation a]
                                (ClassPrinterImpl/forEachOffset
                                  a
                                  com
                                  (lambda BiConsumer ^void [^Integer off ^TypeAnnotation an]
                                    (.add (cast
                                            List
                                            (.computeIfAbsent
                                              invisibleTypeAnnos
                                              off
                                              (lambda Function ^List [^Integer o] (LinkedList.))))
                                          an)))))
                  [^Object o] nil))))
          (.with codeNode (ClassPrinterImpl/attributesToTree (.attributes com) verbosity))
          (when-not (.containsKey stackMap (Integer/valueOf 0))
            (.with codeNode
                   (.with
                     (MapNodeImpl. Style/FLOW "//stack map frame @0")
                     (ClassPrinterImpl/list "locals"
                                            "item"
                                            (ClassPrinterImpl/convertVTIs
                                              com
                                              (StackMapDecoder/initFrameLocals
                                                (cast MethodModel (.get (.parent com))))))
                     (ClassPrinterImpl/list "stack" "item" (Stream/of (new ConstantDesc/1 []))))))
          (let [excHandlers (.toList (.map (.stream (.exceptionHandlers com))
                                           (lambda Function ^ExceptionHandler [^ExceptionCatch exc]
                                             (ExceptionHandler.
                                               (.labelToBci com (.tryStart exc))
                                               (.labelToBci com (.tryEnd exc))
                                               (.labelToBci com (.handler exc))
                                               (cast
                                                 String
                                                 (.orElse
                                                   (.map
                                                     (.catchType exc)
                                                     (lambda Function ^String [^ClassEntry ct]
                                                       (.stringValue (.name ct))))
                                                   nil))))))
                ^:mutable ^int bci 0]
            (for-each [^CodeElement coe com]
              (when-instance [^Instruction ins coe]
                (let [frame (.get stackMap bci)]
                  (when (some? frame)
                    (.with codeNode
                           (.with (MapNodeImpl. Style/FLOW (java-str "//stack map frame @" bci))
                                  (cast ClassPrinter$Node/1
                                        (.toArray
                                          (.values (cast MapNodeImpl frame))
                                          (new ClassPrinter$Node/1 2))))))
                  (let [^:mutable annos (cast List (.get invisibleTypeAnnos bci))]
                    (when (some? annos)
                      (.with codeNode
                             (ClassPrinterImpl/typeAnnotationsToTree
                               Style/FLOW
                               (java-str "//invisible type annotations @" bci)
                               annos)))
                    (set! annos (cast List (.get visibleTypeAnnos bci)))
                    (when (some? annos)
                      (.with codeNode
                             (ClassPrinterImpl/typeAnnotationsToTree
                               Style/FLOW
                               (java-str "//visible type annotations @" bci)
                               annos)))
                    (loop [^int i 0]
                      (when (< i (.size excHandlers))
                        (let [exc (cast ExceptionHandler (.get excHandlers i))]
                          (when (== (.start exc) bci)
                            (.with codeNode
                                   (ClassPrinterImpl/map
                                     (java-str "//try block " (unchecked-add-int i 1) " start")
                                     "start"
                                     (.start exc)
                                     "end"
                                     (.end exc)
                                     "handler"
                                     (.handler exc)
                                     "catch type"
                                     (.catchType exc))))
                          (when (== (.end exc) bci)
                            (.with codeNode
                                   (ClassPrinterImpl/map
                                     (java-str "//try block " (unchecked-add-int i 1) " end")
                                     "start"
                                     (.start exc)
                                     "end"
                                     (.end exc)
                                     "handler"
                                     (.handler exc)
                                     "catch type"
                                     (.catchType exc))))
                          (if (== (.handler exc) bci)
                              (do
                                (.with codeNode
                                       (ClassPrinterImpl/map
                                         (java-str
                                           "//exception handler "
                                           (unchecked-add-int i 1)
                                           " start")
                                         "start"
                                         (.start exc)
                                         "end"
                                         (.end exc)
                                         "handler"
                                         (.handler exc)
                                         "catch type"
                                         (.catchType exc)))
                                (recur (unchecked-inc-int i)))
                              (recur (unchecked-inc-int i))))))
                    (let [in (.with (MapNodeImpl. Style/FLOW bci)
                                    (ClassPrinterImpl/leaf "opcode" (.name (.opcode ins))))]
                      (.with codeNode in)
                      (switch coe
                        [^IncrementInstruction inc]
                          (.with (.with in
                                        (ClassPrinterImpl/leafs
                                          "slot"
                                          (.slot inc)
                                          "const"
                                          (.constant inc)))
                                 (ClassPrinterImpl/localInfoToTree locals (.slot inc) bci))
                        [^LoadInstruction lv]
                          (.with (.with in (ClassPrinterImpl/leaf "slot" (.slot lv)))
                                 (ClassPrinterImpl/localInfoToTree locals (.slot lv) bci))
                        [^StoreInstruction lv]
                          (.with (.with in (ClassPrinterImpl/leaf "slot" (.slot lv)))
                                 (ClassPrinterImpl/localInfoToTree locals (.slot lv) bci))
                        [^FieldInstruction fa]
                          (.with in
                                 (ClassPrinterImpl/leafs
                                   "owner"
                                   (.stringValue (.name (.owner fa)))
                                   "field name"
                                   (.stringValue (.name fa))
                                   "field type"
                                   (.stringValue (.type fa))))
                        [^InvokeInstruction inv]
                          (.with in
                                 (ClassPrinterImpl/leafs
                                   "owner"
                                   (.stringValue (.name (.owner inv)))
                                   "method name"
                                   (.stringValue (.name inv))
                                   "method type"
                                   (.stringValue (.type inv))))
                        [^InvokeDynamicInstruction invd]
                          (do
                            (.with in
                                   (ClassPrinterImpl/leafs
                                     "name"
                                     (.stringValue (.name invd))
                                     "descriptor"
                                     (.stringValue (.type invd))
                                     "bootstrap method"
                                     (java-str (.name (.kind (.bootstrapMethod invd)))
                                               " "
                                               (Util/toInternalName
                                                 (.owner (.bootstrapMethod invd)))
                                               "::"
                                               (.methodName (.bootstrapMethod invd)))))
                            (.with in
                                   (ClassPrinterImpl/list
                                     "arguments"
                                     "arg"
                                     (.stream (.bootstrapArgs invd)))))
                        [^NewObjectInstruction newo]
                          (.with in
                                 (ClassPrinterImpl/leaf
                                   "type"
                                   (.stringValue (.name (.className newo)))))
                        [^NewPrimitiveArrayInstruction newa]
                          (.with in
                                 (ClassPrinterImpl/leafs
                                   "dimensions"
                                   (Integer/valueOf 1)
                                   "descriptor"
                                   (.displayName (.upperBound (.typeKind newa)))))
                        [^NewReferenceArrayInstruction newa]
                          (.with in
                                 (ClassPrinterImpl/leafs
                                   "dimensions"
                                   (Integer/valueOf 1)
                                   "descriptor"
                                   (.stringValue (.name (.componentType newa)))))
                        [^NewMultiArrayInstruction newa]
                          (.with in
                                 (ClassPrinterImpl/leafs
                                   "dimensions"
                                   (.dimensions newa)
                                   "descriptor"
                                   (.stringValue (.name (.arrayType newa)))))
                        [^TypeCheckInstruction tch]
                          (.with in
                                 (ClassPrinterImpl/leaf "type" (.stringValue (.name (.type tch)))))
                        [^ConstantInstruction cons]
                          (.with in (ClassPrinterImpl/leaf "constant value" (.constantValue cons)))
                        [^BranchInstruction br]
                          (.with in (ClassPrinterImpl/leaf "target" (.labelToBci com (.target br))))
                        [^LookupSwitchInstruction si]
                          (.with in
                                 (ClassPrinterImpl/list
                                   "targets"
                                   "target"
                                   (Stream/concat
                                     (.map (Stream/of (.defaultTarget si))
                                           (method-ref
                                             Function
                                             ^Integer [Label]
                                             com
                                             CodeAttribute/.labelToBci))
                                     (.map (.stream (.cases si))
                                           (lambda Function ^Integer [^SwitchCase sc]
                                             (.labelToBci com (.target sc)))))))
                        [^TableSwitchInstruction si]
                          (.with in
                                 (ClassPrinterImpl/list
                                   "targets"
                                   "target"
                                   (Stream/concat
                                     (.map (Stream/of (.defaultTarget si))
                                           (method-ref
                                             Function
                                             ^Integer [Label]
                                             com
                                             CodeAttribute/.labelToBci))
                                     (.map (.stream (.cases si))
                                           (lambda Function ^Integer [^SwitchCase sc]
                                             (.labelToBci com (.target sc)))))))
                        [^DiscontinuedInstruction$JsrInstruction jsr]
                          (.with in
                                 (ClassPrinterImpl/leaf "target" (.labelToBci com (.target jsr))))
                        [^DiscontinuedInstruction$RetInstruction ret]
                          (.with in (ClassPrinterImpl/leaf "slot" (.slot ret)))
                        nil)
                      (set! bci (unchecked-add-int bci (.sizeInBytes ins))))))))
            (when-not (.isEmpty excHandlers)
              (let [handlersNode (MapNodeImpl. Style/BLOCK "exception handlers")]
                (.with codeNode handlersNode)
                (loop [^int i 0]
                  (when (< i (.size excHandlers))
                    (let [exc (cast ExceptionHandler (.get excHandlers i))]
                      (.with handlersNode
                             (ClassPrinterImpl/map
                               (java-str "handler " (unchecked-add-int i 1))
                               "start"
                               (.start exc)
                               "end"
                               (.end exc)
                               "handler"
                               (.handler exc)
                               "type"
                               (.catchType exc)))
                      (recur (unchecked-inc-int i)))))))
            codeNode)))))

  (method ^:private ^:static attributesToTree ^ClassPrinter$Node/1 [^{:tag (List (Attribute ?))} attributes
                                                                    ^ClassPrinter$Verbosity verbosity]
    (let [nodes (LinkedList.)]
      (when-not (identical? verbosity ClassPrinter$Verbosity/MEMBERS_ONLY)
        (for-each [^Attribute attr attributes]
          (switch attr
            [^BootstrapMethodsAttribute bma]
              (.add nodes
                    (ListNodeImpl. Style/BLOCK
                                   "bootstrap methods"
                                   (.map
                                     (.stream (.bootstrapMethods bma))
                                     (lambda Function ^ClassPrinter$Node [^BootstrapMethodEntry bm]
                                       (let [mh (.bootstrapMethod bm)
                                             mref (.reference mh)
                                             bmNode (MapNodeImpl. Style/FLOW "bm")]
                                         (.with bmNode
                                                (ClassPrinterImpl/leafs
                                                  "index"
                                                  (.bsmIndex bm)
                                                  "kind"
                                                  (.name
                                                    (DirectMethodHandleDesc$Kind/valueOf
                                                      (.kind mh)
                                                      (instance? InterfaceMethodRefEntry mref)))
                                                  "owner"
                                                  (.asInternalName (.owner mref))
                                                  "name"
                                                  (.stringValue (.name (.nameAndType mref)))))
                                         (.with bmNode
                                                (ClassPrinterImpl/list
                                                  "args"
                                                  "arg"
                                                  (.map
                                                    (.stream (.arguments bm))
                                                    (method-ref
                                                      Function
                                                      ^ConstantDesc [LoadableConstantEntry]
                                                      LoadableConstantEntry/.constantValue))))
                                         bmNode)))))
            [^ConstantValueAttribute cva]
              (.add nodes (ClassPrinterImpl/leaf "constant value" (.constantValue (.constant cva))))
            [^NestHostAttribute nha]
              (.add nodes
                    (ClassPrinterImpl/leaf "nest host" (.stringValue (.name (.nestHost nha)))))
            [^NestMembersAttribute nma]
              (.add nodes
                    (ClassPrinterImpl/list "nest members"
                                           "member"
                                           (.map
                                             (.stream (.nestMembers nma))
                                             (lambda Function ^ConstantDesc [^ClassEntry mp]
                                               (.stringValue (.name mp))))))
            [^PermittedSubclassesAttribute psa]
              (.add nodes
                    (ClassPrinterImpl/list "permitted subclasses"
                                           "subclass"
                                           (.map
                                             (.stream (.permittedSubclasses psa))
                                             (lambda Function ^ConstantDesc [^ClassEntry e]
                                               (.stringValue (.name e))))))
            nil)
          (when (identical? verbosity ClassPrinter$Verbosity/TRACE_ALL)
            (switch attr
              [^EnclosingMethodAttribute ema]
                (.add nodes
                      (ClassPrinterImpl/map "enclosing method"
                                            "class"
                                            (.stringValue (.name (.enclosingClass ema)))
                                            "method name"
                                            (cast
                                              ConstantDesc
                                              (.orElse
                                                (.map
                                                  (.enclosingMethodName ema)
                                                  (method-ref
                                                    Function
                                                    ^ConstantDesc [Utf8Entry]
                                                    Utf8Entry/.stringValue))
                                                ConstantDescs/BSM_NULL_CONSTANT))
                                            "method type"
                                            (cast
                                              ConstantDesc
                                              (.orElse
                                                (.map
                                                  (.enclosingMethodType ema)
                                                  (method-ref
                                                    Function
                                                    ^ConstantDesc [Utf8Entry]
                                                    Utf8Entry/.stringValue))
                                                ConstantDescs/BSM_NULL_CONSTANT))))
              [^ExceptionsAttribute exa]
                (.add nodes
                      (ClassPrinterImpl/list "exceptions"
                                             "exc"
                                             (.map
                                               (.stream (.exceptions exa))
                                               (lambda Function ^ConstantDesc [^ClassEntry e]
                                                 (.stringValue (.name e))))))
              [^InnerClassesAttribute ica]
                (.add nodes
                      (ListNodeImpl. Style/BLOCK
                                     "inner classes"
                                     (.map
                                       (.stream (.classes ica))
                                       (lambda Function ^ClassPrinter$Node [^InnerClassInfo ic]
                                         (.with
                                           (MapNodeImpl. Style/FLOW "cls")
                                           (ClassPrinterImpl/leaf
                                             "inner class"
                                             (.stringValue (.name (.innerClass ic))))
                                           (ClassPrinterImpl/leaf
                                             "outer class"
                                             (cast
                                               ConstantDesc
                                               (.orElse
                                                 (.map
                                                   (.outerClass ic)
                                                   (lambda Function ^ConstantDesc [^ClassEntry cle]
                                                     ^ConstantDesc (.stringValue (.name cle))))
                                                 ConstantDescs/BSM_NULL_CONSTANT)))
                                           (ClassPrinterImpl/leaf
                                             "inner name"
                                             (cast
                                               ConstantDesc
                                               (.orElse
                                                 (.map
                                                   (.innerName ic)
                                                   (method-ref
                                                     Function
                                                     ^ConstantDesc [Utf8Entry]
                                                     Utf8Entry/.stringValue))
                                                 ConstantDescs/BSM_NULL_CONSTANT)))
                                           (ClassPrinterImpl/list
                                             "flags"
                                             "flag"
                                             (.map
                                               (.stream (.flags ic))
                                               (method-ref
                                                 Function
                                                 ^ConstantDesc [AccessFlag]
                                                 AccessFlag/.name))))))))
              [^MethodParametersAttribute mpa]
                (let [n (MapNodeImpl. Style/BLOCK "method parameters")]
                  (loop [^int i 0]
                    (when (< i (.size (.parameters mpa)))
                      (let [p (cast MethodParameterInfo (.get (.parameters mpa) i))]
                        (.with n
                               (.with (MapNodeImpl. Style/FLOW (unchecked-add-int i 1))
                                      (ClassPrinterImpl/leaf
                                        "name"
                                        (cast ConstantDesc
                                              (.orElse
                                                (.map
                                                  (.name p)
                                                  (method-ref
                                                    Function
                                                    ^ConstantDesc [Utf8Entry]
                                                    Utf8Entry/.stringValue))
                                                ConstantDescs/BSM_NULL_CONSTANT)))
                                      (ClassPrinterImpl/list
                                        "flags"
                                        "flag"
                                        (.map (.stream (.flags p))
                                              (method-ref
                                                Function
                                                ^ConstantDesc [AccessFlag]
                                                AccessFlag/.name)))))
                        (recur (unchecked-inc-int i))))))
              [^ModuleAttribute ma]
                (.add nodes
                      (.with (MapNodeImpl. Style/BLOCK "module")
                             (ClassPrinterImpl/leaf "name" (.stringValue (.name (.moduleName ma))))
                             (ClassPrinterImpl/list
                               "flags"
                               "flag"
                               (.map (.stream (.moduleFlags ma))
                                     (method-ref
                                       Function
                                       ^ConstantDesc [AccessFlag]
                                       AccessFlag/.name)))
                             (ClassPrinterImpl/leaf
                               "version"
                               (cast ConstantDesc
                                     (.orElse (.map
                                                (.moduleVersion ma)
                                                (method-ref
                                                  Function
                                                  ^ConstantDesc [Utf8Entry]
                                                  Utf8Entry/.stringValue))
                                              ConstantDescs/BSM_NULL_CONSTANT)))
                             (ClassPrinterImpl/list
                               "uses"
                               "class"
                               (.map (.stream (.uses ma))
                                     (lambda Function ^ConstantDesc [^ClassEntry ce]
                                       (.stringValue (.name ce)))))
                             (ListNodeImpl.
                               Style/BLOCK
                               "requires"
                               (.map (.stream (.requires ma))
                                     (lambda Function ^ClassPrinter$Node [^ModuleRequireInfo req]
                                       (.with (MapNodeImpl. Style/FLOW "req")
                                              (ClassPrinterImpl/leaf
                                                "name"
                                                (.stringValue (.name (.requires req))))
                                              (ClassPrinterImpl/list
                                                "flags"
                                                "flag"
                                                (.map
                                                  (.stream (.requiresFlags req))
                                                  (method-ref
                                                    Function
                                                    ^ConstantDesc [AccessFlag]
                                                    AccessFlag/.name)))
                                              (ClassPrinterImpl/leaf
                                                "version"
                                                (cast
                                                  ConstantDesc
                                                  (.orElse
                                                    (.map
                                                      (.requiresVersion req)
                                                      (method-ref
                                                        Function
                                                        ^String [Utf8Entry]
                                                        Utf8Entry/.stringValue))
                                                    nil)))))))
                             (ListNodeImpl.
                               Style/BLOCK
                               "exports"
                               (.map (.stream (.exports ma))
                                     (lambda Function ^ClassPrinter$Node [^ModuleExportInfo exp]
                                       (.with (MapNodeImpl. Style/FLOW "exp")
                                              (ClassPrinterImpl/leaf
                                                "package"
                                                (.name (.asSymbol (.exportedPackage exp))))
                                              (ClassPrinterImpl/list
                                                "flags"
                                                "flag"
                                                (.map
                                                  (.stream (.exportsFlags exp))
                                                  (method-ref
                                                    Function
                                                    ^ConstantDesc [AccessFlag]
                                                    AccessFlag/.name)))
                                              (ClassPrinterImpl/list
                                                "to"
                                                "module"
                                                (.map
                                                  (.stream (.exportsTo exp))
                                                  (lambda Function ^ConstantDesc [^ModuleEntry me]
                                                    (.stringValue (.name me)))))))))
                             (ListNodeImpl.
                               Style/BLOCK
                               "opens"
                               (.map (.stream (.opens ma))
                                     (lambda Function ^ClassPrinter$Node [^ModuleOpenInfo opn]
                                       (.with (MapNodeImpl. Style/FLOW "opn")
                                              (ClassPrinterImpl/leaf
                                                "package"
                                                (.name (.asSymbol (.openedPackage opn))))
                                              (ClassPrinterImpl/list
                                                "flags"
                                                "flag"
                                                (.map
                                                  (.stream (.opensFlags opn))
                                                  (method-ref
                                                    Function
                                                    ^ConstantDesc [AccessFlag]
                                                    AccessFlag/.name)))
                                              (ClassPrinterImpl/list
                                                "to"
                                                "module"
                                                (.map
                                                  (.stream (.opensTo opn))
                                                  (lambda Function ^ConstantDesc [^ModuleEntry me]
                                                    (.stringValue (.name me)))))))))
                             (ListNodeImpl.
                               Style/BLOCK
                               "provides"
                               (.map (.stream (.provides ma))
                                     (lambda Function ^ClassPrinter$Node [^ModuleProvideInfo prov]
                                       (.with (MapNodeImpl. Style/FLOW "prov")
                                              (ClassPrinterImpl/leaf
                                                "class"
                                                (.stringValue (.name (.provides prov))))
                                              (ClassPrinterImpl/list
                                                "with"
                                                "cls"
                                                (.map
                                                  (.stream (.providesWith prov))
                                                  (lambda Function ^ConstantDesc [^ClassEntry ce]
                                                    (.stringValue (.name ce)))))))))))
              [^ModulePackagesAttribute mopa]
                (.add nodes
                      (ClassPrinterImpl/list "module packages"
                                             "subclass"
                                             (.map
                                               (.stream (.packages mopa))
                                               (lambda Function ^ConstantDesc [^PackageEntry mp]
                                                 (.name (.asSymbol mp))))))
              [^ModuleMainClassAttribute mmca]
                (.add nodes
                      (ClassPrinterImpl/leaf "module main class"
                                             (.stringValue (.name (.mainClass mmca)))))
              [^RecordAttribute ra]
                (.add nodes
                      (ListNodeImpl. Style/BLOCK
                                     "record components"
                                     (.map
                                       (.stream (.components ra))
                                       (lambda Function ^ClassPrinter$Node [^RecordComponentInfo rc]
                                         (.with (.with
                                                  (.with
                                                    (MapNodeImpl. Style/BLOCK "component")
                                                    (ClassPrinterImpl/leafs
                                                      "name"
                                                      (.stringValue (.name rc))
                                                      "type"
                                                      (.stringValue (.descriptor rc))))
                                                  (ClassPrinterImpl/list
                                                    "attributes"
                                                    "attribute"
                                                    (.map
                                                      (.map
                                                        (.stream (.attributes rc))
                                                        (method-ref
                                                          Function
                                                          ^Utf8Entry [Attribute]
                                                          Attribute/.attributeName))
                                                      (method-ref
                                                        Function
                                                        ^ConstantDesc [Utf8Entry]
                                                        Utf8Entry/.stringValue))))
                                                (ClassPrinterImpl/attributesToTree
                                                  (.attributes rc)
                                                  verbosity))))))
              [^AnnotationDefaultAttribute ada]
                (.add nodes
                      (.with (MapNodeImpl. Style/FLOW "annotation default")
                             (ClassPrinterImpl/elementValueToTree (.defaultValue ada))))
              [^RuntimeInvisibleAnnotationsAttribute aa]
                (.add
                  nodes
                  (ClassPrinterImpl/annotationsToTree "invisible annotations" (.annotations aa)))
              [^RuntimeVisibleAnnotationsAttribute aa]
                (.add nodes
                      (ClassPrinterImpl/annotationsToTree "visible annotations" (.annotations aa)))
              [^RuntimeInvisibleParameterAnnotationsAttribute aa]
                (.add nodes
                      (ClassPrinterImpl/parameterAnnotationsToTree
                        "invisible parameter annotations"
                        (.parameterAnnotations aa)))
              [^RuntimeVisibleParameterAnnotationsAttribute aa]
                (.add nodes
                      (ClassPrinterImpl/parameterAnnotationsToTree
                        "visible parameter annotations"
                        (.parameterAnnotations aa)))
              [^RuntimeInvisibleTypeAnnotationsAttribute aa]
                (.add nodes
                      (ClassPrinterImpl/typeAnnotationsToTree
                        Style/BLOCK
                        "invisible type annotations"
                        (.annotations aa)))
              [^RuntimeVisibleTypeAnnotationsAttribute aa]
                (.add nodes
                      (ClassPrinterImpl/typeAnnotationsToTree
                        Style/BLOCK
                        "visible type annotations"
                        (.annotations aa)))
              [^SignatureAttribute sa]
                (.add nodes (ClassPrinterImpl/leaf "signature" (.stringValue (.signature sa))))
              [^SourceFileAttribute sfa]
                (.add nodes (ClassPrinterImpl/leaf "source file" (.stringValue (.sourceFile sfa))))
              nil))))
      (cast ClassPrinter$Node/1
            (.toArray nodes
                      (lambda IntFunction ^ClassPrinter$Node/1 ^:method-ref [^int n-3]
                        (new ClassPrinter$Node/1 n-3))))))

  (method ^:private ^:static annotationsToTree ^ClassPrinter$Node [^String name
                                                                   ^{:tag (List Annotation)} annos]
    (ListNodeImpl. Style/BLOCK
                   name
                   (.map (.stream annos)
                         (lambda Function ^ClassPrinter$Node [^Annotation a]
                           (.with (.with (MapNodeImpl. Style/FLOW "anno")
                                         (ClassPrinterImpl/leaf
                                           "annotation class"
                                           (.stringValue (.className a))))
                                  (ClassPrinterImpl/elementValuePairsToTree (.elements a)))))))

  (method ^:private ^:static typeAnnotationsToTree ^ClassPrinter$Node [^Style style ^String name
                                                                       ^{:tag (List TypeAnnotation)} annos]
    (ListNodeImpl. style
                   name
                   (.map (.stream annos)
                         (lambda Function ^ClassPrinter$Node [^TypeAnnotation a]
                           (.with (.with (MapNodeImpl. Style/FLOW "anno")
                                         (ClassPrinterImpl/leaf
                                           "annotation class"
                                           (.stringValue (.className (.annotation a))))
                                         (ClassPrinterImpl/leaf
                                           "target info"
                                           (.name (.targetType (.targetInfo a)))))
                                  (ClassPrinterImpl/elementValuePairsToTree
                                    (.elements (.annotation a))))))))

  (method ^:private ^:static parameterAnnotationsToTree ^MapNodeImpl [^String name
                                                                      ^{:tag (List (List Annotation))} paramAnnotations]
    (let [node (MapNodeImpl. Style/BLOCK name)]
      (loop [^int i 0]
        (when (< i (.size paramAnnotations))
          (let [annos (cast List (.get paramAnnotations i))]
            (if (not (.isEmpty annos))
                (do
                  (.with node
                         (ListNodeImpl. Style/FLOW
                                        (java-str "parameter " (unchecked-add-int i 1))
                                        (.map (.stream annos)
                                              (lambda Function ^ClassPrinter$Node [^Annotation a]
                                                (.with
                                                  (.with
                                                    (MapNodeImpl. Style/FLOW "anno")
                                                    (ClassPrinterImpl/leaf
                                                      "annotation class"
                                                      (.stringValue (.className a))))
                                                  (ClassPrinterImpl/elementValuePairsToTree
                                                    (.elements a)))))))
                  (recur (unchecked-inc-int i)))
                (recur (unchecked-inc-int i))))))
      node))

  (method ^:private ^:static localInfoToTree ^ClassPrinter$Node/1 [^{:tag (List LocalVariableInfo)} locals
                                                                   ^int slot ^int bci]
    (when (some? locals)
      (for-each [^LocalVariableInfo l locals]
        (when (and (and (== (.slot l) slot) (<= (.startPc l) bci))
                   (>= (unchecked-add-int (.length l) (.startPc l)) bci))
          (return (ClassPrinterImpl/leafs "type"
                                          (.stringValue (.type l))
                                          "variable name"
                                          (.stringValue (.name l)))))))
    (new ClassPrinter$Node/1 0))

  (method ^:private ^:static forEachOffset ^void [^TypeAnnotation ta ^CodeAttribute lr
                                                  ^{:tag (BiConsumer Integer TypeAnnotation)} consumer]
    (switch (.targetInfo ta)
      [^TypeAnnotation$OffsetTarget ot] (.accept consumer (.labelToBci lr (.target ot)) ta)
      [^TypeAnnotation$TypeArgumentTarget tat] (.accept consumer (.labelToBci lr (.target tat)) ta)
      [^TypeAnnotation$LocalVarTarget lvt]
        (.forEach (.table lvt)
                  (lambda Consumer ^void [^TypeAnnotation$LocalVarTargetInfo lvti]
                    (.accept consumer (.labelToBci lr (.startLabel lvti)) ta)))
      nil)))

  (method ^:private ^:static elementValueToTree ^ClassPrinter$Node/1 [^AnnotationValue v]
    (switch v
      [^AnnotationValue$OfString cv]
        (ClassPrinterImpl/leafs "string" (String/valueOf (.stringValue cv)))
      [^AnnotationValue$OfDouble cv]
        (ClassPrinterImpl/leafs "double" (String/valueOf (.doubleValue cv)))
      [^AnnotationValue$OfFloat cv]
        (ClassPrinterImpl/leafs "float" (String/valueOf (.floatValue cv)))
      [^AnnotationValue$OfLong cv] (ClassPrinterImpl/leafs "long" (String/valueOf (.longValue cv)))
      [^AnnotationValue$OfInt cv] (ClassPrinterImpl/leafs "int" (String/valueOf (.intValue cv)))
      [^AnnotationValue$OfShort cv]
        (ClassPrinterImpl/leafs "short" (String/valueOf (.shortValue cv)))
      [^AnnotationValue$OfChar cv] (ClassPrinterImpl/leafs "char" (String/valueOf (.charValue cv)))
      [^AnnotationValue$OfByte cv] (ClassPrinterImpl/leafs "byte" (String/valueOf (.byteValue cv)))
      [^AnnotationValue$OfBoolean cv]
        (ClassPrinterImpl/leafs "boolean" (String/valueOf (.booleanValue cv)))
      [^AnnotationValue$OfClass clv]
        (ClassPrinterImpl/leafs "class" (.stringValue (.className clv)))
      [^AnnotationValue$OfEnum ev]
        (ClassPrinterImpl/leafs "enum class"
                                (.stringValue (.className ev))
                                "constant name"
                                (.stringValue (.constantName ev)))
      [^AnnotationValue$OfAnnotation av]
        (ClassPrinterImpl/leafs "annotation class" (.stringValue (.className (.annotation av))))
      [^AnnotationValue$OfArray av]
        (new ClassPrinter$Node/1
             [(ListNodeImpl. Style/FLOW
                             "array"
                             (.map (.stream (.values av))
                                   (lambda Function ^ClassPrinter$Node [^AnnotationValue ev]
                                     (.with (MapNodeImpl. Style/FLOW "value")
                                            (ClassPrinterImpl/elementValueToTree ev)))))])
      (throw (MatchException. nil nil))))


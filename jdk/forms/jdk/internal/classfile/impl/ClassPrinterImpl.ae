  (method ^:private ^:static convertVTIs ^{:tag (Stream ConstantDesc)} [^CodeAttribute lr
                                                                        ^{:tag (List StackMapFrameInfo$VerificationTypeInfo)} vtis]
    (.mapMulti (.stream vtis)
               (lambda BiConsumer ^void [^StackMapFrameInfo$VerificationTypeInfo vti ^Consumer ret]
                 (switch vti
                   [^StackMapFrameInfo$SimpleVerificationTypeInfo s]
                     (switch s
                       DOUBLE (do (.accept ret "double") (.accept ret "double2"))
                       FLOAT (.accept ret "float")
                       INTEGER (.accept ret "int")
                       LONG (do (.accept ret "long") (.accept ret "long2"))
                       NULL (.accept ret ConstantDescs/BSM_NULL_CONSTANT)
                       TOP (.accept ret "?")
                       UNINITIALIZED_THIS (.accept ret "THIS"))
                   [^StackMapFrameInfo$ObjectVerificationTypeInfo o]
                     (.accept ret (.stringValue (.name (.className o))))
                   [^StackMapFrameInfo$UninitializedVerificationTypeInfo u]
                     (.accept ret (java-str "UNINITIALIZED @" (.labelToBci lr (.newTarget u))))
                   (throw (MatchException. nil nil))))))


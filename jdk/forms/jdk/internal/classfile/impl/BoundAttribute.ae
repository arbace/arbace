  (method ^:public ^:static standardAttribute ^{:tag (AttributeMapper ?)} [^Utf8Entry name]
    (switch (.hashCode name)
      0x46699ff2
        (when (.equalsString name Attributes/NAME_ANNOTATION_DEFAULT)
          (Attributes/annotationDefault))
      0x5208e184
        (when (.equalsString name Attributes/NAME_BOOTSTRAP_METHODS) (Attributes/bootstrapMethods))
      -882864006
        (when (.equalsString name Attributes/NAME_CHARACTER_RANGE_TABLE)
          (Attributes/characterRangeTable))
      0x4020220d (when (.equalsString name Attributes/NAME_CODE) (Attributes/code))
      -1039281666
        (when (.equalsString name Attributes/NAME_COMPILATION_ID) (Attributes/compilationId))
      -894331891
        (when (.equalsString name Attributes/NAME_CONSTANT_VALUE) (Attributes/constantValue))
      0x558641d3 (when (.equalsString name Attributes/NAME_DEPRECATED) (Attributes/deprecated))
      0x51d443cd
        (when (.equalsString name Attributes/NAME_ENCLOSING_METHOD) (Attributes/enclosingMethod))
      0x687c1624 (when (.equalsString name Attributes/NAME_EXCEPTIONS) (Attributes/exceptions))
      0x7adb2910 (when (.equalsString name Attributes/NAME_INNER_CLASSES) (Attributes/innerClasses))
      0x653f0551
        (when (.equalsString name Attributes/NAME_LINE_NUMBER_TABLE) (Attributes/lineNumberTable))
      0x64c75927
        (when (.equalsString name Attributes/NAME_LOCAL_VARIABLE_TABLE)
          (Attributes/localVariableTable))
      0x6697f98d
        (when (.equalsString name Attributes/NAME_LOCAL_VARIABLE_TYPE_TABLE)
          (Attributes/localVariableTypeTable))
      -609169973
        (when (.equalsString name Attributes/NAME_METHOD_PARAMETERS) (Attributes/methodParameters))
      -911175028 (when (.equalsString name Attributes/NAME_MODULE) (Attributes/module))
      0x41cd27e8 (when (.equalsString name Attributes/NAME_MODULE_HASHES) (Attributes/moduleHashes))
      0x7deb0a13
        (when (.equalsString name Attributes/NAME_MODULE_MAIN_CLASS) (Attributes/moduleMainClass))
      0x6706ff99
        (when (.equalsString name Attributes/NAME_MODULE_PACKAGES) (Attributes/modulePackages))
      0x60272858
        (when (.equalsString name Attributes/NAME_MODULE_RESOLUTION) (Attributes/moduleResolution))
      0x5646d73d (when (.equalsString name Attributes/NAME_MODULE_TARGET) (Attributes/moduleTarget))
      0x50336c40 (when (.equalsString name Attributes/NAME_NEST_HOST) (Attributes/nestHost))
      0x4735ab81 (when (.equalsString name Attributes/NAME_NEST_MEMBERS) (Attributes/nestMembers))
      0x7100d9fe
        (when (.equalsString name Attributes/NAME_PERMITTED_SUBCLASSES)
          (Attributes/permittedSubclasses))
      -777299855 (when (.equalsString name Attributes/NAME_RECORD) (Attributes/record))
      0x7588550f
        (when (.equalsString name Attributes/NAME_RUNTIME_INVISIBLE_ANNOTATIONS)
          (Attributes/runtimeInvisibleAnnotations))
      -864757200
        (when (.equalsString name Attributes/NAME_RUNTIME_INVISIBLE_PARAMETER_ANNOTATIONS)
          (Attributes/runtimeInvisibleParameterAnnotations))
      -160000011
        (when (.equalsString name Attributes/NAME_RUNTIME_INVISIBLE_TYPE_ANNOTATIONS)
          (Attributes/runtimeInvisibleTypeAnnotations))
      -528253654
        (when (.equalsString name Attributes/NAME_RUNTIME_VISIBLE_ANNOTATIONS)
          (Attributes/runtimeVisibleAnnotations))
      -918183819
        (when (.equalsString name Attributes/NAME_RUNTIME_VISIBLE_PARAMETER_ANNOTATIONS)
          (Attributes/runtimeVisibleParameterAnnotations))
      0x611a3a90
        (when (.equalsString name Attributes/NAME_RUNTIME_VISIBLE_TYPE_ANNOTATIONS)
          (Attributes/runtimeVisibleTypeAnnotations))
      -143673192 (when (.equalsString name Attributes/NAME_SIGNATURE) (Attributes/signature))
      0x6b41b047
        (when (.equalsString name Attributes/NAME_SOURCE_DEBUG_EXTENSION)
          (Attributes/sourceDebugExtension))
      0x748c2857 (when (.equalsString name Attributes/NAME_SOURCE_FILE) (Attributes/sourceFile))
      0x6bf13a96 (when (.equalsString name Attributes/NAME_SOURCE_ID) (Attributes/sourceId))
      -91885990
        (when (.equalsString name Attributes/NAME_STACK_MAP_TABLE) (Attributes/stackMapTable))
      -228128987 (when (.equalsString name Attributes/NAME_SYNTHETIC) (Attributes/synthetic))

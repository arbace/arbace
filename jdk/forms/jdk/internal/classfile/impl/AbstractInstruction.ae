      (set! (.-slot this) slot))

    (method ^:public slot ^int [this] slot)

    (method ^:public typeKind ^TypeKind [this]
      (BytecodeHelpers/loadType (.-op this)))

    (method ^:public writeTo ^void [this ^DirectCodeBuilder writer]
      (let [op (.-op this)]
        (if (== (.sizeIfFixed op) 1) (.writeBytecode writer op) (.writeLocalVar writer op slot))))

    (method ^:public toString ^String [this]
      (String/format FMT_Load (new Object/1 [(.opcode this) (.slot this)]))))


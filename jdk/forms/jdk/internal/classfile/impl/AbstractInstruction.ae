    (method ^:public constantValue ^ConstantDesc [this]
      (.constantValue constant))

    (method ^:public writeTo ^void [this ^DirectCodeBuilder writer]
      (let [constant (.-constant this)]
        (if (.canWriteDirect writer (.constantPool constant))
            (.writeDirectLoadConstant writer (.-op this) constant)
            (.writeAdaptLoadConstant writer (.-op this) constant))))

    (method ^:public toString ^String [this]
      (String/format FMT_LoadConstant (new Object/1 [(.opcode this) (.constantValue this)]))))


      (super. op)
      (set! (.-fieldEntry this) (cast FieldRefEntry (Objects/requireNonNull fieldEntry))))

    (method ^:public field ^FieldRefEntry [this] fieldEntry)

    (method ^:public writeTo ^void [this ^DirectCodeBuilder writer]
      (.writeFieldAccess writer (.-op this) fieldEntry))

    (method ^:public toString ^String [this]
      (String/format FMT_Field
                     (new Object/1
                          [(.opcode this)
                           (.asInternalName (.owner this))
                           (.stringValue (.name this))
                           (.stringValue (.type this))]))))

  (defclass ^:public ^:static ^:final UnboundInvokeInstruction
    :extends UnboundInstruction
    :implements [InvokeInstruction]

    (field ^:final ^MemberRefEntry methodEntry)

    (constructor ^:public [this ^Opcode op ^MemberRefEntry methodEntry]
      (super. op)
      (set! (.-methodEntry this) (cast MemberRefEntry (Objects/requireNonNull methodEntry))))

    (method ^:public method ^MemberRefEntry [this] methodEntry)

    (method ^:public isInterface ^boolean [this]
      (or (identical? (.-op this) Opcode/INVOKEINTERFACE)
          (instance? InterfaceMethodRefEntry methodEntry)))

    (method ^:public count ^int [this]
      (if (identical? (.-op this) Opcode/INVOKEINTERFACE)
          (unchecked-add-int (Util/parameterSlots (Util/methodTypeSymbol (.type methodEntry))) 1)
          0))

    (method ^:public writeTo ^void [this ^DirectCodeBuilder writer]
      (if (identical? (.-op this) Opcode/INVOKEINTERFACE)
          (.writeInvokeInterface writer
                                 (.-op this)
                                 (cast InterfaceMethodRefEntry (.method this))
                                 (.count this))
          (.writeInvokeNormal writer (.-op this) (.method this))))

    (method ^:public toString ^String [this]
      (String/format FMT_Invoke
                     (new Object/1
                          [(.opcode this)
                           (.asInternalName (.owner this))
                           (.stringValue (.name this))
                           (.stringValue (.type this))]))))


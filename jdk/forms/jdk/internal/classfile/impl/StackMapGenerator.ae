        RawBytecodeHelper/DNEG
          (.pushStack (.decStack currentFrame 2) Type/DOUBLE_TYPE Type/DOUBLE2_TYPE)
        RawBytecodeHelper/IINC (.checkLocal currentFrame (.getIndex bcs))
        RawBytecodeHelper/I2L (.pushStack (.decStack currentFrame 1) Type/LONG_TYPE Type/LONG2_TYPE)
        RawBytecodeHelper/L2I (.pushStack (.decStack currentFrame 2) Type/INTEGER_TYPE)
        RawBytecodeHelper/I2F (.pushStack (.decStack currentFrame 1) Type/FLOAT_TYPE)
        RawBytecodeHelper/I2D
          (.pushStack (.decStack currentFrame 1) Type/DOUBLE_TYPE Type/DOUBLE2_TYPE)
        RawBytecodeHelper/L2F (.pushStack (.decStack currentFrame 2) Type/FLOAT_TYPE)
        RawBytecodeHelper/L2D
          (.pushStack (.decStack currentFrame 2) Type/DOUBLE_TYPE Type/DOUBLE2_TYPE)
        RawBytecodeHelper/F2I (.pushStack (.decStack currentFrame 1) Type/INTEGER_TYPE)
        RawBytecodeHelper/F2L (.pushStack (.decStack currentFrame 1) Type/LONG_TYPE Type/LONG2_TYPE)
        RawBytecodeHelper/F2D
          (.pushStack (.decStack currentFrame 1) Type/DOUBLE_TYPE Type/DOUBLE2_TYPE)
        RawBytecodeHelper/D2L (.pushStack (.decStack currentFrame 2) Type/LONG_TYPE Type/LONG2_TYPE)
        RawBytecodeHelper/D2F (.pushStack (.decStack currentFrame 2) Type/FLOAT_TYPE)
        (RawBytecodeHelper/I2B RawBytecodeHelper/I2C RawBytecodeHelper/I2S)
          (.pushStack (.decStack currentFrame 1) Type/INTEGER_TYPE)
        (RawBytecodeHelper/LCMP RawBytecodeHelper/DCMPL RawBytecodeHelper/DCMPG)
          (.pushStack (.decStack currentFrame 4) Type/INTEGER_TYPE)
        (RawBytecodeHelper/FCMPL RawBytecodeHelper/FCMPG RawBytecodeHelper/D2I)
          (.pushStack (.decStack currentFrame 2) Type/INTEGER_TYPE)
        (RawBytecodeHelper/IF_ICMPEQ RawBytecodeHelper/IF_ICMPNE
                                     RawBytecodeHelper/IF_ICMPLT
                                     RawBytecodeHelper/IF_ICMPGE
                                     RawBytecodeHelper/IF_ICMPGT
                                     RawBytecodeHelper/IF_ICMPLE
                                     RawBytecodeHelper/IF_ACMPEQ
                                     RawBytecodeHelper/IF_ACMPNE)
          (.checkJumpTarget this (.decStack currentFrame 2) (.dest bcs))
        (RawBytecodeHelper/IFEQ RawBytecodeHelper/IFNE
                                RawBytecodeHelper/IFLT
                                RawBytecodeHelper/IFGE
                                RawBytecodeHelper/IFGT
                                RawBytecodeHelper/IFLE
                                RawBytecodeHelper/IFNULL
                                RawBytecodeHelper/IFNONNULL)
          (.checkJumpTarget this (.decStack currentFrame 1) (.dest bcs))
        RawBytecodeHelper/GOTO (do (.checkJumpTarget this currentFrame (.dest bcs)) (set! ncf true))
        RawBytecodeHelper/GOTO_W
          (do (.checkJumpTarget this currentFrame (.destW bcs)) (set! ncf true))
        (RawBytecodeHelper/TABLESWITCH RawBytecodeHelper/LOOKUPSWITCH)
          (do (.processSwitch this bcs) (set! ncf true))
        (RawBytecodeHelper/LRETURN RawBytecodeHelper/DRETURN)
          (do (.decStack currentFrame 2) (set! ncf true))
        (RawBytecodeHelper/IRETURN RawBytecodeHelper/FRETURN
                                   RawBytecodeHelper/ARETURN
                                   RawBytecodeHelper/ATHROW)
          (do (.decStack currentFrame 1) (set! ncf true))
        (RawBytecodeHelper/GETSTATIC RawBytecodeHelper/PUTSTATIC
                                     RawBytecodeHelper/GETFIELD
                                     RawBytecodeHelper/PUTFIELD)
          (.processFieldInstructions this bcs)
        (RawBytecodeHelper/INVOKEVIRTUAL RawBytecodeHelper/INVOKESPECIAL
                                         RawBytecodeHelper/INVOKESTATIC
                                         RawBytecodeHelper/INVOKEINTERFACE
                                         RawBytecodeHelper/INVOKEDYNAMIC)
          (set!
            this_uninit
            (.processInvokeInstructions this bcs (and (>= bci exMin) (< bci exMax)) this_uninit))
        RawBytecodeHelper/NEW (.pushStack currentFrame (Type/uninitializedType bci))
        RawBytecodeHelper/NEWARRAY
          (.pushStack (.decStack currentFrame 1) (.getNewarrayType this (.getIndex bcs)))
        RawBytecodeHelper/ANEWARRAY (.processAnewarray this (.getIndexU2 bcs))
        RawBytecodeHelper/CHECKCAST
          (.pushStack (.decStack currentFrame 1)
                      (StackMapGenerator/cpIndexToType (.getIndexU2 bcs) cp))
        RawBytecodeHelper/MULTIANEWARRAY
          (do
            (set! type1 (StackMapGenerator/cpIndexToType (.getIndexU2 bcs) cp))
            (let [dim (.getU1Unchecked bcs (unchecked-add-int (.bci bcs) 3))]
              (loop [^int i 0]
                (when (< i dim) (.popStack currentFrame) (recur (unchecked-inc-int i))))
              (.pushStack currentFrame type1)))
        (RawBytecodeHelper/JSR RawBytecodeHelper/JSR_W RawBytecodeHelper/RET)
          (throw
            (.generatorError
              this
              "Instructions jsr, jsr_w, or ret must not appear in the class file version >= 51.0"))
        (throw (.generatorError this
                                (String/format "Bad instruction: %02x" (new Object/1 [opcode])))))
      (when (and (and (not verified_exc_handlers) (>= bci exMin)) (< bci exMax))
        (.processExceptionHandlerTargets this bci this_uninit))
      ncf))

  (method ^:private processExceptionHandlerTargets ^void [this ^int bci ^boolean this_uninit]
    (for-each [^RawExceptionCatch ex rawHandlers]
      (when (or (== bci (.-start ex))
                (and (and (.-localsChanged currentFrame) (> bci (.-start ex))) (< bci (.-end ex))))
        (let [^:mutable flags (.-flags currentFrame)]
          (when this_uninit (set! flags (bit-or-int flags FLAG_THIS_UNINIT)))
          (let [newFrame (.frameInExceptionHandler currentFrame flags (.-catchType ex))]
            (.checkJumpTarget this newFrame (.-handler ex))))))
    (set! (.-localsChanged currentFrame) false))

  (method ^:private processLdc ^void [this ^int index]
    (switch (.tag (.entryByIndex cp index))
      PoolEntry/TAG_UTF8 (.pushStack currentFrame Type/OBJECT_TYPE)
      PoolEntry/TAG_STRING (.pushStack currentFrame Type/STRING_TYPE)
      PoolEntry/TAG_CLASS (.pushStack currentFrame Type/CLASS_TYPE)
      PoolEntry/TAG_INTEGER (.pushStack currentFrame Type/INTEGER_TYPE)
      PoolEntry/TAG_FLOAT (.pushStack currentFrame Type/FLOAT_TYPE)
      PoolEntry/TAG_DOUBLE (.pushStack currentFrame Type/DOUBLE_TYPE Type/DOUBLE2_TYPE)
      PoolEntry/TAG_LONG (.pushStack currentFrame Type/LONG_TYPE Type/LONG2_TYPE)
      PoolEntry/TAG_METHOD_HANDLE (.pushStack currentFrame Type/METHOD_HANDLE_TYPE)
      PoolEntry/TAG_METHOD_TYPE (.pushStack currentFrame Type/METHOD_TYPE)
      PoolEntry/TAG_DYNAMIC
        (.pushStack currentFrame
                    (.typeSymbol (cast ConstantDynamicEntry
                                       (.entryByIndex cp index ConstantDynamicEntry))))
      (throw (.generatorError this
                              (.formatted "CP entry #%d %s is not loadable constant"
                                          index
                                          (.tag (.entryByIndex cp index)))))))

  (method ^:private processSwitch ^void [this ^RawBytecodeHelper bcs]
    (let [bci (.bci bcs)
          alignedBci (RawBytecodeHelper/align (unchecked-add-int bci 1))
          defaultOffset (.getIntUnchecked bcs alignedBci)
          ^:mutable ^int keys 0
          ^:mutable ^int delta 0]
      (.popStack currentFrame)
      (if (== (.opcode bcs) RawBytecodeHelper/TABLESWITCH)
          (let [low (.getIntUnchecked bcs (unchecked-add-int alignedBci 4))
                high (.getIntUnchecked bcs
                                       (unchecked-add-int alignedBci (unchecked-multiply-int 2 4)))]
            (when (> low high)
              (throw (.generatorError this "low must be less than or equal to high in tableswitch")))
            (set! keys (unchecked-add-int (unchecked-subtract-int high low) 1))
            (when (< keys 0) (throw (.generatorError this "too many keys in tableswitch")))
            (set! delta 1))
          (do
            (set! keys (.getIntUnchecked bcs (unchecked-add-int alignedBci 4)))
            (when (< keys 0)
              (throw (.generatorError this "number of keys in lookupswitch less than 0")))
            (set! delta 2)
            (loop [^int i 0]
              (when (< i (unchecked-subtract-int keys 1))
                (let [this_key (.getIntUnchecked
                                 bcs
                                 (unchecked-add-int
                                   alignedBci
                                   (unchecked-multiply-int
                                     (unchecked-add-int 2 (unchecked-multiply-int 2 i))
                                     4)))
                      next_key (.getIntUnchecked
                                 bcs
                                 (unchecked-add-int
                                   alignedBci
                                   (unchecked-multiply-int
                                     (unchecked-add-int
                                       (unchecked-add-int 2 (unchecked-multiply-int 2 i))
                                       2)
                                     4)))]
                  (if (>= this_key next_key)
                      (throw (.generatorError this "Bad lookupswitch instruction"))
                      (recur (unchecked-inc-int i))))))))
      (let [^:mutable target (unchecked-add-int bci defaultOffset)]
        (.checkJumpTarget this currentFrame target)
        (loop [^int i 0]
          (when (< i keys)
            (set! target
                  (unchecked-add-int bci
                                     (.getIntUnchecked
                                       bcs
                                       (unchecked-add-int
                                         alignedBci
                                         (unchecked-multiply-int
                                           (unchecked-add-int 3 (unchecked-multiply-int i delta))
                                           4)))))
            (.checkJumpTarget this currentFrame target)
            (recur (unchecked-inc-int i)))))))

  (method ^:private processFieldInstructions ^void [this ^RawBytecodeHelper bcs]
    (let [desc (Util/fieldTypeSymbol
                 (.type (cast MemberRefEntry (.entryByIndex cp (.getIndexU2 bcs) MemberRefEntry))))
          currentFrame (.-currentFrame this)]
      (switch (.opcode bcs)
        RawBytecodeHelper/GETSTATIC (.pushStack currentFrame desc)
        RawBytecodeHelper/PUTSTATIC (.decStack currentFrame (if (Util/isDoubleSlot desc) 2 1))
        RawBytecodeHelper/GETFIELD (do (.decStack currentFrame 1) (.pushStack currentFrame desc))
        RawBytecodeHelper/PUTFIELD (.decStack currentFrame (if (Util/isDoubleSlot desc) 3 2))
        (throw (AssertionError. "Should not reach here")))))

  (method ^:private processInvokeInstructions ^boolean [this ^RawBytecodeHelper bcs
                                                        ^boolean inTryBlock
                                                        ^:mutable ^boolean thisUninit]
    (let [index (.getIndexU2 bcs)
          opcode (.opcode bcs)
          ^NameAndTypeEntry nameAndType (if (== opcode RawBytecodeHelper/INVOKEDYNAMIC)
                                            (.nameAndType
                                              (cast
                                                InvokeDynamicEntry
                                                (.entryByIndex cp index InvokeDynamicEntry)))
                                            (.nameAndType
                                              (cast
                                                MemberRefEntry
                                                (.entryByIndex cp index MemberRefEntry))))
          mDesc (Util/methodTypeSymbol (.type nameAndType))
          bci (.bci bcs)
          currentFrame (.-currentFrame this)]
      (.decStack currentFrame (Util/parameterSlots mDesc))
      (when (and (not (== opcode RawBytecodeHelper/INVOKESTATIC))
                 (not (== opcode RawBytecodeHelper/INVOKEDYNAMIC)))
        (if (.equalsString (.name nameAndType) OBJECT_INITIALIZER_NAME)
            (let [type (.popStack currentFrame)]
              (cond
                (identical? type Type/UNITIALIZED_THIS_TYPE)
                  (do
                    (when inTryBlock (.processExceptionHandlerTargets this bci true))
                    (.initializeObject currentFrame type thisType)
                    (set! thisUninit true))
                (== (.-tag type) ITEM_UNINITIALIZED)
                  (let [new_class_type (StackMapGenerator/cpIndexToType
                                         (.getU2 bcs (unchecked-add-int (.-bci type) 1))
                                         cp)]
                    (when inTryBlock (.processExceptionHandlerTargets this bci thisUninit))
                    (.initializeObject currentFrame type new_class_type))
                :else (throw (.generatorError this "Bad operand type when invoking <init>"))))
            (.decStack currentFrame 1)))
      (.pushStack currentFrame (.returnType mDesc))
      thisUninit))

  (method ^:private getNewarrayType ^Type [this ^int index]
    (when (or (< index T_BOOLEAN) (> index T_LONG))
      (throw (.generatorError this (.formatted "Illegal newarray instruction type %d" index))))
    (aget ARRAY_FROM_BASIC_TYPE index))

  (method ^:private processAnewarray ^void [this ^int index]
    (.popStack currentFrame)
    (.pushStack currentFrame (.toArray (StackMapGenerator/cpIndexToType index cp))))

  (method ^:private generatorError ^IllegalArgumentException [this ^String msg]
    (.generatorError this msg (.-offset currentFrame)))

  (method ^:private generatorError ^IllegalArgumentException [this ^String msg ^int offset]
    (let [sb (StringBuilder.
               (.formatted "%s at bytecode offset %d of method %s(%s)"
                           msg
                           offset
                           methodName
                           (.collect (.map (.stream (.parameterList methodDesc))
                                           (method-ref
                                             Function
                                             ^String [ClassDesc]
                                             ClassDesc/.displayName))
                                     (Collectors/joining ","))))]
      (Util/dumpMethod cp
                       (.sym thisType)
                       methodName
                       methodDesc
                       (if isStatic ClassFile/ACC_STATIC 0)
                       bytecode
                       (method-ref Consumer [String] sb StringBuilder/.append))
      (IllegalArgumentException. (.toString sb))))

  (method ^:private detectFrames ^void [this]
    (let [bcs (.start bytecode)
          ^:mutable no_control_flow false
          ^:mutable ^int opcode 0
          ^:mutable ^int bci 0]
      (while (.next bcs)
        (try
          (set! opcode (.opcode bcs))
          (set! bci (.bci bcs))
          (when no_control_flow (.addFrame this bci))
          (set!
            no_control_flow
            (switch opcode
              RawBytecodeHelper/GOTO (do (.addFrame this (.dest bcs)) true)
              RawBytecodeHelper/GOTO_W (do (.addFrame this (.destW bcs)) true)
              (RawBytecodeHelper/IF_ICMPEQ RawBytecodeHelper/IF_ICMPNE
                                           RawBytecodeHelper/IF_ICMPLT
                                           RawBytecodeHelper/IF_ICMPGE
                                           RawBytecodeHelper/IF_ICMPGT
                                           RawBytecodeHelper/IF_ICMPLE
                                           RawBytecodeHelper/IFEQ
                                           RawBytecodeHelper/IFNE
                                           RawBytecodeHelper/IFLT
                                           RawBytecodeHelper/IFGE
                                           RawBytecodeHelper/IFGT
                                           RawBytecodeHelper/IFLE
                                           RawBytecodeHelper/IF_ACMPEQ
                                           RawBytecodeHelper/IF_ACMPNE
                                           RawBytecodeHelper/IFNULL
                                           RawBytecodeHelper/IFNONNULL)
                (do (.addFrame this (.dest bcs)) false)
              (RawBytecodeHelper/TABLESWITCH RawBytecodeHelper/LOOKUPSWITCH)
                (let [aligned_bci (RawBytecodeHelper/align (unchecked-add-int bci 1))
                      default_ofset (.getIntUnchecked bcs aligned_bci)
                      ^:mutable ^int keys 0
                      ^:mutable ^int delta 0]
                  (if (== (.opcode bcs) RawBytecodeHelper/TABLESWITCH)
                      (let [low (.getIntUnchecked bcs (unchecked-add-int aligned_bci 4))
                            high (.getIntUnchecked
                                   bcs
                                   (unchecked-add-int aligned_bci (unchecked-multiply-int 2 4)))]
                        (set! keys (unchecked-add-int (unchecked-subtract-int high low) 1))
                        (set! delta 1))
                      (do
                        (set! keys (.getIntUnchecked bcs (unchecked-add-int aligned_bci 4)))
                        (set! delta 2)))
                  (.addFrame this (unchecked-add-int bci default_ofset))
                  (loop [^int i 0]
                    (when (< i keys)
                      (.addFrame this
                                 (unchecked-add-int
                                   bci
                                   (.getIntUnchecked
                                     bcs
                                     (unchecked-add-int
                                       aligned_bci
                                       (unchecked-multiply-int
                                         (unchecked-add-int 3 (unchecked-multiply-int i delta))
                                         4)))))
                      (recur (unchecked-inc-int i))))
                  true)
              (RawBytecodeHelper/IRETURN RawBytecodeHelper/LRETURN
                                         RawBytecodeHelper/FRETURN
                                         RawBytecodeHelper/DRETURN
                                         RawBytecodeHelper/ARETURN
                                         RawBytecodeHelper/RETURN
                                         RawBytecodeHelper/ATHROW)
                true
              false))
          (catch IllegalArgumentException iae
            (throw (.generatorError this "Detected branch target out of bytecode range" bci)))))
      (loop [^int i 0]
        (when (< i (.size rawHandlers))
          (try
            (.addFrame this (.handler (cast RawExceptionCatch (.get rawHandlers i))))
            (catch IllegalArgumentException iae
              (when-not filterDeadLabels
                (throw (.generatorError this "Detected exception handler out of bytecode range")))))
          (recur (unchecked-inc-int i))))))

  (method ^:private addFrame ^void [this ^int offset]
    (Preconditions/checkIndex offset (.length bytecode) RawBytecodeHelper/IAE_FORMATTER)
    (let [^:mutable frames (.-frames this)
          ^:mutable ^int i 0
          framesCount (.-framesCount this)]
      (while (< i framesCount)
        (let [frameOffset (.-offset (aget frames i))]
          (when (== frameOffset offset) (return))
          (when (> frameOffset offset) (break)))
        (set! i (unchecked-inc-int i)))
      (when (>= framesCount (alength frames))
        (let [newCapacity (unchecked-add-int framesCount 8)]
          (set! (.-frames this)
                (set! frames
                      (if (== framesCount 0)
                          (new Frame/1 newCapacity)
                          (cast Frame/1 (Arrays/copyOf frames newCapacity)))))))
      (when-not (== i framesCount)
        (System/arraycopy frames
                          i
                          frames
                          (unchecked-add-int i 1)
                          (unchecked-subtract-int framesCount i)))
      (aset frames i (Frame. offset classHierarchy))
      (set! (.-framesCount this) (unchecked-add-int framesCount 1))))

  (defclass ^:private ^:final Frame
    (field ^int offset)

    (field ^int localsSize)

    (field ^int stackSize)

    (field ^int flags)

    (field ^int frameMaxStack 0)

    (field ^int frameMaxLocals 0)

    (field ^boolean dirty false)

    (field ^boolean localsChanged false)

    (field ^:private ^:final ^ClassHierarchyImpl classHierarchy)

    (field ^:private ^Type/1 locals)

    (field ^:private ^Type/1 stack)

    (constructor [this ^ClassHierarchyImpl classHierarchy]
      (this. -1 0 0 0 nil nil classHierarchy))

    (constructor [this ^int offset ^ClassHierarchyImpl classHierarchy]
      (this. offset -1 0 0 nil nil classHierarchy))

    (constructor [this ^int offset ^int flags ^int locals_size ^int stack_size ^Type/1 locals
                  ^Type/1 stack ^ClassHierarchyImpl classHierarchy]
      (set! (.-offset this) offset)
      (set! (.-localsSize this) locals_size)
      (set! (.-stackSize this) stack_size)
      (set! (.-flags this) flags)
      (set! (.-locals this) locals)
      (set! (.-stack this) stack)
      (set! (.-classHierarchy this) classHierarchy))

    (method ^:public toString ^String [this]
      (java-str (if dirty "frame* @" "frame @")
                offset
                " with locals "
                (if (nil? locals) "[]" ^Object (.subList (Arrays/asList locals) 0 localsSize))
                " and stack "
                (if (nil? stack) "[]" ^Object (.subList (Arrays/asList stack) 0 stackSize))))

    (method pushStack ^Frame [this ^ClassDesc desc]
      (cond
        (identical? desc ConstantDescs/CD_long) (.pushStack this Type/LONG_TYPE Type/LONG2_TYPE)
        (identical? desc ConstantDescs/CD_double)
          (.pushStack this Type/DOUBLE_TYPE Type/DOUBLE2_TYPE)
        (identical? desc ConstantDescs/CD_void) this
        :else
          (.pushStack this
                      ^Type (if (.isPrimitive desc)
                                (if (identical? desc ConstantDescs/CD_float)
                                    Type/FLOAT_TYPE
                                    Type/INTEGER_TYPE)
                                (Type/referenceType desc)))))

    (method pushStack ^Frame [this ^Type type]
      (.checkStack this stackSize)
      (aset stack (let [old-2 stackSize] (set! stackSize (unchecked-inc-int stackSize)) old-2) type)
      this)

    (method pushStack ^Frame [this ^Type type1 ^Type type2]
      (.checkStack this (unchecked-add-int stackSize 1))
      (aset stack
            (let [old-3 stackSize] (set! stackSize (unchecked-inc-int stackSize)) old-3)
            type1)
      (aset stack
            (let [old-4 stackSize] (set! stackSize (unchecked-inc-int stackSize)) old-4)
            type2)
      this)

    (method popStack ^Type [this]
      (when (< stackSize 1)
        (throw (.generatorError StackMapGenerator/this "Operand stack underflow")))
      (aget stack (set! stackSize (unchecked-dec-int stackSize))))

    (method decStack ^Frame [this ^int size]
      (set! stackSize (unchecked-subtract-int stackSize size))
      (when (< stackSize 0)
        (throw (.generatorError StackMapGenerator/this "Operand stack underflow")))
      this)

    (method frameInExceptionHandler ^Frame [this ^int flags ^Type excType]
      (Frame. offset flags localsSize 1 locals (new Type/1 [excType]) classHierarchy))

    (method initializeObject ^void [this ^Type old_object ^Type new_object]
      (let [^:mutable ^int i 0]
        (set! i 0)
        (while (< i localsSize)
          (when (.equals (aget locals i) old_object)
            (aset locals i new_object)
            (set! localsChanged true))
          (set! i (unchecked-inc-int i)))
        (set! i 0)
        (while (< i stackSize)
          (when (.equals (aget stack i) old_object) (aset stack i new_object))
          (set! i (unchecked-inc-int i)))
        (when (identical? old_object Type/UNITIALIZED_THIS_TYPE) (set! flags 0))))

    (method checkLocal ^Frame [this ^int index]
      (when (>= index frameMaxLocals) (set! frameMaxLocals (unchecked-add-int index 1)))
      (cond
        (nil? locals)
          (do
            (set! locals (new Type/1 (unchecked-add-int index FRAME_DEFAULT_CAPACITY)))
            (Arrays/fill locals Type/TOP_TYPE))
        (>= index (alength locals))
          (let [current (alength locals)]
            (set! locals
                  (cast Type/1
                        (Arrays/copyOf locals (unchecked-add-int index FRAME_DEFAULT_CAPACITY))))
            (Arrays/fill locals current (alength locals) Type/TOP_TYPE)))
      this)

    (method ^:private checkStack ^void [this ^int index]
      (when (>= index frameMaxStack) (set! frameMaxStack (unchecked-add-int index 1)))
      (cond
        (nil? stack)
          (do
            (set! stack (new Type/1 (unchecked-add-int index FRAME_DEFAULT_CAPACITY)))
            (Arrays/fill stack Type/TOP_TYPE))
        (>= index (alength stack))
          (let [current (alength stack)]
            (set! stack
                  (cast Type/1
                        (Arrays/copyOf stack (unchecked-add-int index FRAME_DEFAULT_CAPACITY))))
            (Arrays/fill stack current (alength stack) Type/TOP_TYPE))))

    (method ^:private setLocalRawInternal ^void [this ^int index ^Type type]
      (.checkLocal this index)
      (set! localsChanged
            (let [a-5 localsChanged b-6 (not (.equals type (aget locals index)))] (or a-5 b-6)))
      (aset locals index type))

    (method setLocalsFromArg ^void [this ^String name ^MethodTypeDesc methodDesc ^boolean isStatic
                                    ^Type thisKlass]
      (let [^:mutable ^int localsSize 0]
        (.checkLocal this (unchecked-add-int (Util/parameterSlots methodDesc) (if isStatic -1 0)))
        (let [^:mutable ^Type type nil
              locals (.-locals this)]
          (when-not isStatic
            (if (and (.equals OBJECT_INITIALIZER_NAME name)
                     (not (.equals ConstantDescs/CD_Object (.-sym thisKlass))))
                (do
                  (set! type Type/UNITIALIZED_THIS_TYPE)
                  (set! flags (bit-or-int flags FLAG_THIS_UNINIT)))
                (set! type thisKlass))
            (aset locals localsSize type)
            (set! localsSize (unchecked-inc-int localsSize)))
          (loop [^int i 0]
            (when (< i (.parameterCount methodDesc))
              (let [desc (.parameterType methodDesc i)]
                (cond
                  (identical? desc ConstantDescs/CD_long)
                    (do
                      (aset locals localsSize Type/LONG_TYPE)
                      (aset locals (unchecked-add-int localsSize 1) Type/LONG2_TYPE)
                      (set! localsSize (unchecked-add-int localsSize 2))
                      (recur (unchecked-inc-int i)))
                  (identical? desc ConstantDescs/CD_double)
                    (do
                      (aset locals localsSize Type/DOUBLE_TYPE)
                      (aset locals (unchecked-add-int localsSize 1) Type/DOUBLE2_TYPE)
                      (set! localsSize (unchecked-add-int localsSize 2))
                      (recur (unchecked-inc-int i)))
                  :else
                    (do
                      (cond
                        (not (.isPrimitive desc)) (set! type (Type/referenceType desc))
                        (identical? desc ConstantDescs/CD_float) (set! type Type/FLOAT_TYPE)
                        :else (set! type Type/INTEGER_TYPE))
                      (aset locals localsSize type)
                      (set! localsSize (unchecked-inc-int localsSize))
                      (recur (unchecked-inc-int i)))))))
          (set! (.-localsSize this) localsSize))))

    (method copyFrom ^void [this ^Frame src]
      (when (and (some? locals) (< (.-localsSize src) (alength locals)))
        (Arrays/fill locals (.-localsSize src) (alength locals) Type/TOP_TYPE))
      (set! localsSize (.-localsSize src))
      (.checkLocal this (unchecked-subtract-int (.-localsSize src) 1))
      (when (> (.-localsSize src) 0)
        (System/arraycopy (.-locals src) 0 locals 0 (.-localsSize src)))
      (when (and (some? stack) (< (.-stackSize src) (alength stack)))
        (Arrays/fill stack (.-stackSize src) (alength stack) Type/TOP_TYPE))
      (set! stackSize (.-stackSize src))
      (.checkStack this (unchecked-subtract-int (.-stackSize src) 1))
      (when (> (.-stackSize src) 0) (System/arraycopy (.-stack src) 0 stack 0 (.-stackSize src)))
      (set! flags (.-flags src))
      (set! localsChanged true))

    (method checkAssignableTo ^void [this ^Frame target]
      (let [localsSize (.-localsSize this)
            stackSize (.-stackSize this)]
        (if (== (.-flags target) -1)
            (do
              (set! (.-locals target) (when (some? locals) (.clone locals)))
              (set! (.-localsSize target) localsSize)
              (when (> stackSize 0)
                (set! (.-stack target) (.clone stack))
                (set! (.-stackSize target) stackSize))
              (set! (.-flags target) flags)
              (set! (.-dirty target) true))
            (do
              (when (> (.-localsSize target) localsSize)
                (set! (.-localsSize target) localsSize)
                (set! (.-dirty target) true))
              (loop [^int i 0]
                (when (< i (.-localsSize target))
                  (.merge this (aget locals i) (.-locals target) i target)
                  (recur (unchecked-inc-int i))))
              (when-not (== stackSize (.-stackSize target))
                (throw (.generatorError StackMapGenerator/this "Stack size mismatch")))
              (loop [^int i 0]
                (if (< i (.-stackSize target))
                    (if (identical? (.merge this (aget stack i) (.-stack target) i target)
                                    Type/TOP_TYPE)
                        (throw (.generatorError StackMapGenerator/this "Stack content mismatch"))
                        (recur (unchecked-inc-int i)))
                    nil))))))

    (method ^:private getLocalRawInternal ^Type [this ^int index]
      (.checkLocal this index)
      (aget locals index))

    (method getLocal ^Type [this ^int index]
      (let [ret (.getLocalRawInternal this index)]
        (when (>= index localsSize) (set! localsSize (unchecked-add-int index 1)))
        ret))

    (method setLocal ^void [this ^int index ^Type type]
      (let [old (.getLocalRawInternal this index)]
        (when (or (identical? old Type/DOUBLE_TYPE) (identical? old Type/LONG_TYPE))
          (.setLocalRawInternal this (unchecked-add-int index 1) Type/TOP_TYPE))
        (when (or (identical? old Type/DOUBLE2_TYPE) (identical? old Type/LONG2_TYPE))
          (.setLocalRawInternal this (unchecked-subtract-int index 1) Type/TOP_TYPE))
        (.setLocalRawInternal this index type)
        (when (>= index localsSize) (set! localsSize (unchecked-add-int index 1)))))

    (method setLocal2 ^void [this ^int index ^Type type1 ^Type type2]
      (let [^:mutable old (.getLocalRawInternal this (unchecked-add-int index 1))]
        (when (or (identical? old Type/DOUBLE_TYPE) (identical? old Type/LONG_TYPE))
          (.setLocalRawInternal this (unchecked-add-int index 2) Type/TOP_TYPE))
        (set! old (.getLocalRawInternal this index))
        (when (or (identical? old Type/DOUBLE2_TYPE) (identical? old Type/LONG2_TYPE))
          (.setLocalRawInternal this (unchecked-subtract-int index 1) Type/TOP_TYPE))
        (.setLocalRawInternal this index type1)
        (.setLocalRawInternal this (unchecked-add-int index 1) type2)
        (when (>= index (unchecked-subtract-int localsSize 1))
          (set! localsSize (unchecked-add-int index 2)))))

    (method ^:private merge ^Type [this ^Type me ^Type/1 toTypes ^int i ^Frame target]
      (let [to (aget toTypes i)
            newTo (.mergeFrom to me classHierarchy)]
        (when (and (not (identical? to newTo)) (not (.equals to newTo)))
          (aset toTypes i newTo)
          (set! (.-dirty target) true))
        newTo))

    (method ^:private ^:static trimAndCompress ^int [^Type/1 types ^:mutable ^int count]
      (while (and (> count 0)
                  (identical? (aget types (unchecked-subtract-int count 1)) Type/TOP_TYPE))
        (set! count (unchecked-dec-int count)))
      (let [^:mutable ^int compressed 0]
        (loop [^int i 0]
          (if (< i count)
              (if (not (.isCategory2_2nd (aget types i)))
                  (do
                    (when-not (== compressed i) (aset types compressed (aget types i)))
                    (set! compressed (unchecked-inc-int compressed))
                    (recur (unchecked-inc-int i)))
                  (recur (unchecked-inc-int i)))
              nil))
        compressed))

    (method trimAndCompress ^void [this]
      (set! localsSize (Frame/trimAndCompress locals localsSize))
      (set! stackSize (Frame/trimAndCompress stack stackSize)))

    (method ^:private ^:static equals ^boolean [^Type/1 l1 ^Type/1 l2 ^int commonSize]
      (if (or (nil? l1) (nil? l2))
          (== commonSize 0)
          (Arrays/equals l1 0 commonSize l2 0 commonSize)))

    (method writeTo ^void [this ^BufWriterImpl out ^Frame prevFrame ^ConstantPoolBuilder cp]
      (let [localsSize (.-localsSize this)
            stackSize (.-stackSize this)
            offsetDelta (unchecked-subtract-int (unchecked-subtract-int offset (.-offset prevFrame))
                                                1)]
        (if (== stackSize 0)
            (let [^int commonLocalsSize (if (> localsSize (.-localsSize prevFrame))
                                            (.-localsSize prevFrame)
                                            localsSize)
                  diffLocalsSize (unchecked-subtract-int localsSize (.-localsSize prevFrame))]
              (when (and (and (<= -3 diffLocalsSize) (<= diffLocalsSize 3))
                         (Frame/equals locals (.-locals prevFrame) commonLocalsSize))
                (if (and (== diffLocalsSize 0) (<= offsetDelta SAME_FRAME_END))
                    (.writeU1 out offsetDelta)
                    (do
                      (.writeU1U2 out
                                  (unchecked-add-int SAME_FRAME_EXTENDED diffLocalsSize)
                                  offsetDelta)
                      (loop [^int i commonLocalsSize]
                        (when (< i localsSize)
                          (.writeTo (aget locals i) out cp)
                          (recur (unchecked-inc-int i))))))
                (return)))
            (when (and (and (== stackSize 1) (== localsSize (.-localsSize prevFrame)))
                       (Frame/equals locals (.-locals prevFrame) localsSize))
              (if (<= offsetDelta
                      (unchecked-subtract-int SAME_LOCALS_1_STACK_ITEM_FRAME_END
                                              SAME_LOCALS_1_STACK_ITEM_FRAME_START))
                  (.writeU1 out
                            (unchecked-add-int SAME_LOCALS_1_STACK_ITEM_FRAME_START offsetDelta))
                  (.writeU1U2 out SAME_LOCALS_1_STACK_ITEM_EXTENDED offsetDelta))
              (.writeTo (aget stack 0) out cp)
              (return)))
        (.writeU1U2U2 out FULL_FRAME offsetDelta localsSize)
        (loop [^int i 0]
          (when (< i localsSize) (.writeTo (aget locals i) out cp) (recur (unchecked-inc-int i))))
        (.writeU2 out stackSize)
        (loop [^int i 0]
          (when (< i stackSize) (.writeTo (aget stack i) out cp) (recur (unchecked-inc-int i)))))))

  (defclass ^:private ^:static ^:record Type [^int tag ^ClassDesc sym ^int bci]
    (field ^:static ^:final ^Type TOP_TYPE (Type/simpleType ITEM_TOP))

    (field ^:static ^:final ^Type NULL_TYPE (Type/simpleType ITEM_NULL))

    (field ^:static ^:final ^Type INTEGER_TYPE (Type/simpleType ITEM_INTEGER))

    (field ^:static ^:final ^Type FLOAT_TYPE (Type/simpleType ITEM_FLOAT))

    (field ^:static ^:final ^Type LONG_TYPE (Type/simpleType ITEM_LONG))

    (field ^:static ^:final ^Type LONG2_TYPE (Type/simpleType ITEM_LONG_2ND))

    (field ^:static ^:final ^Type DOUBLE_TYPE (Type/simpleType ITEM_DOUBLE))

    (field ^:static ^:final ^Type BOOLEAN_TYPE (Type/simpleType ITEM_BOOLEAN))

    (field ^:static ^:final ^Type BYTE_TYPE (Type/simpleType ITEM_BYTE))

    (field ^:static ^:final ^Type CHAR_TYPE (Type/simpleType ITEM_CHAR))

    (field ^:static ^:final ^Type SHORT_TYPE (Type/simpleType ITEM_SHORT))

    (field ^:static ^:final ^Type DOUBLE2_TYPE (Type/simpleType ITEM_DOUBLE_2ND))

    (field ^:static ^:final ^Type UNITIALIZED_THIS_TYPE (Type/simpleType ITEM_UNINITIALIZED_THIS))

    (field ^:static ^:final ^Type OBJECT_TYPE (Type/referenceType ConstantDescs/CD_Object))

    (field ^:static ^:final ^Type THROWABLE_TYPE (Type/referenceType ConstantDescs/CD_Throwable))

    (field ^:static ^:final ^Type INT_ARRAY_TYPE
      (Type/referenceType (.arrayType ConstantDescs/CD_int)))

    (field ^:static ^:final ^Type BOOLEAN_ARRAY_TYPE
      (Type/referenceType (.arrayType ConstantDescs/CD_boolean)))

    (field ^:static ^:final ^Type BYTE_ARRAY_TYPE
      (Type/referenceType (.arrayType ConstantDescs/CD_byte)))

    (field ^:static ^:final ^Type CHAR_ARRAY_TYPE
      (Type/referenceType (.arrayType ConstantDescs/CD_char)))

    (field ^:static ^:final ^Type SHORT_ARRAY_TYPE
      (Type/referenceType (.arrayType ConstantDescs/CD_short)))

    (field ^:static ^:final ^Type LONG_ARRAY_TYPE
      (Type/referenceType (.arrayType ConstantDescs/CD_long)))

    (field ^:static ^:final ^Type DOUBLE_ARRAY_TYPE
      (Type/referenceType (.arrayType ConstantDescs/CD_double)))

    (field ^:static ^:final ^Type FLOAT_ARRAY_TYPE
      (Type/referenceType (.arrayType ConstantDescs/CD_float)))

    (field ^:static ^:final ^Type STRING_TYPE (Type/referenceType ConstantDescs/CD_String))

    (field ^:static ^:final ^Type CLASS_TYPE (Type/referenceType ConstantDescs/CD_Class))

    (field ^:static ^:final ^Type METHOD_HANDLE_TYPE
      (Type/referenceType ConstantDescs/CD_MethodHandle))

    (field ^:static ^:final ^Type METHOD_TYPE (Type/referenceType ConstantDescs/CD_MethodType))

    (method ^:private ^:static simpleType ^Type [^int tag]
      (Type. tag nil 0))

    (method ^:static referenceType ^Type [^ClassDesc desc]
      (Type. ITEM_OBJECT desc 0))

    (method ^:static uninitializedType ^Type [^int bci]
      (Type. ITEM_UNINITIALIZED nil bci))

    (method ^:public equals ^boolean [this o]
      (if-instance [^Type t o]
        (if (== (.-tag t) tag) (if (== (.-bci t) bci) (Objects/equals sym (.-sym t)) false) false)
        false))

    (method isCategory2_2nd ^boolean [this]
      (or (identical? this DOUBLE2_TYPE) (identical? this LONG2_TYPE)))

    (method isReference ^boolean [this]
      (or (== tag ITEM_OBJECT) (identical? this NULL_TYPE)))

    (method isObject ^boolean [this]
      (and (== tag ITEM_OBJECT) (.isClassOrInterface sym)))

    (method isArray ^boolean [this]
      (and (== tag ITEM_OBJECT) (.isArray sym)))

    (method mergeFrom ^Type [this ^Type from ^ClassHierarchyImpl context]
      (if (or (or (identical? this TOP_TYPE) (identical? this from)) (.equals this from))
          this
          (switch tag
            (ITEM_BOOLEAN ITEM_BYTE ITEM_CHAR ITEM_SHORT)
              (if (identical? from INTEGER_TYPE) this TOP_TYPE)
            (if (and (.isReference this) (.isReference from))
                (.mergeReferenceFrom this from context)
                TOP_TYPE))))

    (method mergeComponentFrom ^Type [this ^Type from ^ClassHierarchyImpl context]
      (if (or (or (identical? this TOP_TYPE) (identical? this from)) (.equals this from))
          this
          (switch tag
            (ITEM_BOOLEAN ITEM_BYTE ITEM_CHAR ITEM_SHORT) TOP_TYPE
            (if (and (.isReference this) (.isReference from))
                (.mergeReferenceFrom this from context)
                TOP_TYPE))))

    (field ^:private ^:static ^:final ^ClassDesc CD_Cloneable
      (ClassOrInterfaceDescImpl/ofValidated "Ljava/lang/Cloneable;"))

    (field ^:private ^:static ^:final ^ClassDesc CD_Serializable
      (ClassOrInterfaceDescImpl/ofValidated "Ljava/io/Serializable;"))

    (method ^:private mergeReferenceFrom ^Type [this ^Type from ^ClassHierarchyImpl context]
      (cond
        (identical? from NULL_TYPE) this
        (identical? this NULL_TYPE) from
        (.equals sym (.-sym from)) this
        :else
          (do
            (cond
              (.isObject this)
                (do
                  (when (.equals ConstantDescs/CD_Object sym) (return this))
                  (cond
                    (.isInterface context sym)
                      (when (or (or (not (.isArray from)) (.equals CD_Cloneable sym))
                                (.equals CD_Serializable sym))
                        (return this))
                    (.isObject from)
                      (let [anc (.commonAncestor context sym (.-sym from))]
                        (return (if (nil? anc) this (Type/referenceType anc))))))
              (and (.isArray this) (.isArray from))
                (let [compThis (.getComponent this)
                      compFrom (.getComponent from)]
                  (when (and (not (identical? compThis TOP_TYPE))
                             (not (identical? compFrom TOP_TYPE)))
                    (return (.toArray (.mergeComponentFrom compThis compFrom context))))))
            OBJECT_TYPE)))

    (method toArray ^Type [this]
      (switch tag
        ITEM_BOOLEAN BOOLEAN_ARRAY_TYPE
        ITEM_BYTE BYTE_ARRAY_TYPE
        ITEM_CHAR CHAR_ARRAY_TYPE
        ITEM_SHORT SHORT_ARRAY_TYPE
        ITEM_INTEGER INT_ARRAY_TYPE
        ITEM_LONG LONG_ARRAY_TYPE
        ITEM_FLOAT FLOAT_ARRAY_TYPE
        ITEM_DOUBLE DOUBLE_ARRAY_TYPE
        ITEM_OBJECT (Type/referenceType (.arrayType sym))
        OBJECT_TYPE))

    (method getComponent ^Type [this]
      (if (.isArray this)
          (let [comp (.componentType sym)]
            (if (.isPrimitive comp)
                (switch (.charAt (.descriptorString comp) 0)
                  \Z Type/BOOLEAN_TYPE
                  \B Type/BYTE_TYPE
                  \C Type/CHAR_TYPE
                  \S Type/SHORT_TYPE
                  \I Type/INTEGER_TYPE
                  \J Type/LONG_TYPE
                  \F Type/FLOAT_TYPE
                  \D Type/DOUBLE_TYPE
                  Type/TOP_TYPE)
                (Type/referenceType comp)))
          Type/TOP_TYPE))

    (method writeTo ^void [this ^BufWriterImpl bw ^ConstantPoolBuilder cp]
      (switch tag
        ITEM_OBJECT (.writeU1U2 bw tag (.index (.classEntry cp sym)))
        ITEM_UNINITIALIZED (.writeU1U2 bw tag bci)
        (.writeU1 bw tag)))))

  (method ^:public ^:static validateSlot ^void [^Opcode opcode ^int slot ^boolean load]
    (let [size (.sizeIfFixed opcode)]
      (when-not (or (or (and (== size 1)
                             (== slot
                                 (if load
                                     (BytecodeHelpers/intrinsicLoadSlot opcode)
                                     (BytecodeHelpers/intrinsicStoreSlot opcode))))
                        (and (== size 2) (== (bit-and-int slot (bit-not-int 0xFF)) 0)))
                    (and (== size 4) (== (bit-and-int slot (bit-not-int 0xFFFF)) 0)))
        (throw (BytecodeHelpers/slotOutOfBounds opcode slot)))))

  (method ^:public ^:static validateSlot ^void [^int slot]
    (when-not (== (bit-and-int slot (bit-not-int 0xFFFF)) 0)
      (throw (BytecodeHelpers/slotOutOfBounds slot))))

  (method ^:public ^:static validateAndIsWideIinc ^boolean [^int slot ^int val]
    (let [^:mutable ret false]
      (when-not (== (bit-and-int slot (bit-not-int 0xFF)) 0)
        (BytecodeHelpers/validateSlot slot)
        (set! ret true))
      (when-not (== (unchecked-byte val) val)
        (when-not (== (unchecked-short val) val)
          (throw (IllegalArgumentException. (.concat "cannot encode as S2: " (String/valueOf val)))))
        (set! ret true))
      ret))

  (method ^:public ^:static validateRet ^void [^Opcode opcode ^int slot]
    (when-not (or (and (identical? opcode Opcode/RET) (== (bit-and-int slot (bit-not-int 0xFF)) 0))
                  (and (identical? opcode Opcode/RET_W)
                       (== (bit-and-int slot (bit-not-int 0xFFFF)) 0)))
      (Objects/requireNonNull opcode)
      (throw (BytecodeHelpers/slotOutOfBounds opcode slot))))

  (method ^:public ^:static validateMultiArrayDimensions ^void [^int value]
    (when (or (< value 1) (> value 0xFF))
      (throw (IllegalArgumentException.
               (.concat "Not a valid array dimension: " (String/valueOf value))))))

  (method ^:public ^:static validateSipush ^void [^int value]
    (when-not (== value (unchecked-short value))
      (throw
        (IllegalArgumentException.
          (.concat
            "SIPUSH: value must be within: Short.MIN_VALUE <= value <= Short.MAX_VALUE, found: "
            (Long/toString value))))))

  (method ^:public ^:static validateBipush ^void [^int value]
    (when-not (== value (unchecked-byte value))
      (throw (IllegalArgumentException.
               (.concat
                 "BIPUSH: value must be within: Byte.MIN_VALUE <= value <= Byte.MAX_VALUE, found: "
                 (Long/toString value))))))

  (method ^:public ^:static handleDescToHandleInfo ^MethodHandleEntry [^ConstantPoolBuilder constantPool
                                                                       ^DirectMethodHandleDesc bootstrapMethod]
    (let [bsOwner (.classEntry constantPool (.owner bootstrapMethod))
          bsNameAndType (.nameAndTypeEntry constantPool
                                           (.utf8Entry constantPool (.methodName bootstrapMethod))
                                           (.utf8Entry
                                             constantPool
                                             (.lookupDescriptor bootstrapMethod)))
          bsRefKind (.refKind bootstrapMethod)
          bsReference (BytecodeHelpers/toBootstrapMemberRef
                        constantPool
                        bsRefKind
                        bsOwner
                        bsNameAndType
                        (.isOwnerInterface bootstrapMethod))]
      (.methodHandleEntry constantPool bsRefKind bsReference)))

  (method ^:static toBootstrapMemberRef ^MemberRefEntry [^ConstantPoolBuilder constantPool
                                                         ^int bsRefKind ^ClassEntry owner
                                                         ^NameAndTypeEntry nat
                                                         ^boolean isOwnerInterface]
    (cond
      isOwnerInterface ^MemberRefEntry (.interfaceMethodRefEntry constantPool owner nat)
      (<= bsRefKind MethodHandleInfo/REF_putStatic)
        ^MemberRefEntry (.fieldRefEntry constantPool owner nat)
      :else ^MemberRefEntry (.methodRefEntry constantPool owner nat)))

  (method ^:static handleConstantDescToHandleInfo ^ConstantDynamicEntry [^ConstantPoolBuilder constantPool
                                                                         ^{:tag (DynamicConstantDesc ?)} desc]
    (let [bootstrapArgs (.bootstrapArgs desc)
          ^{:tag (List LoadableConstantEntry)} staticArgs (ArrayList. (alength bootstrapArgs))]
      (for-each [^ConstantDesc bootstrapArg bootstrapArgs]
        (.add staticArgs (.loadableConstantEntry constantPool bootstrapArg)))
      (let [methodHandleEntry (BytecodeHelpers/handleDescToHandleInfo
                                constantPool
                                (.bootstrapMethod desc))
            bme (.bsmEntry constantPool methodHandleEntry staticArgs)]
        (.constantDynamicEntry constantPool
                               bme
                               (.nameAndTypeEntry
                                 constantPool
                                 (.constantName desc)
                                 (.constantType desc))))))

  (method ^:public ^:static ldcOpcode ^Opcode [^LoadableConstantEntry entry]
    (cond
      (== (.slotSize (.typeKind entry)) 2) Opcode/LDC2_W
      (> (.index entry) 0xff) Opcode/LDC_W
      :else Opcode/LDC))


      ICONST_1 (Integer/valueOf 1)
      ICONST_2 (Integer/valueOf 2)
      ICONST_3 (Integer/valueOf 3)
      ICONST_4 (Integer/valueOf 4)
      ICONST_5 (Integer/valueOf 5)
      LCONST_0 (Long/valueOf 0)
      LCONST_1 (Long/valueOf 1)
      FCONST_0 (Float/valueOf (float 0.0))
      FCONST_1 (Float/valueOf (float 1.0))
      FCONST_2 (Float/valueOf (float 2.0))
      DCONST_0 (Double/valueOf 0.0)
      DCONST_1 (Double/valueOf 1.0)
      (throw (Util/badOpcodeKindException opcode Opcode$Kind/CONSTANT))))


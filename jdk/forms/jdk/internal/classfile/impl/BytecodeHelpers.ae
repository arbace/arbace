      (IADD ISUB IMUL IDIV IREM INEG ISHL ISHR IUSHR IAND IOR IXOR ARRAYLENGTH) TypeKind/INT
      (LADD LSUB LMUL LDIV LREM LNEG LSHL LSHR LUSHR LAND LOR LXOR LCMP) TypeKind/LONG
      (FADD FSUB FMUL FDIV FREM FNEG FCMPL FCMPG) TypeKind/FLOAT
      (DADD DSUB DMUL DDIV DREM DNEG DCMPL DCMPG) TypeKind/DOUBLE
      (throw (Util/badOpcodeKindException operationOpcode Opcode$Kind/OPERATOR)))))

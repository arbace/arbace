  (method ^:private className ^String [this]
    (.displayName (.asSymbol (.thisClass classModel))))

  (method ^:private toString ^String [this ^AttributedElement ae]
    (switch ae
      [^CodeModel m]
        (java-str "Code attribute for "
                  (.toString this (cast AttributedElement (.get (.parent m)))))
      [^FieldModel m] (.formatted "field %s.%s" (.className this) (.stringValue (.fieldName m)))
      [^MethodModel m]
        (.formatted "method %s::%s(%s)"
                    (.className this)
                    (.stringValue (.methodName m))
                    (.collect (.map
                                (.stream (.parameterList (.methodTypeSymbol m)))
                                (method-ref Function ^String [ClassDesc] ClassDesc/.displayName))
                              (Collectors/joining ",")))
      [^RecordComponentInfo i]
        (.formatted "Record component %s of class %s" (.stringValue (.name i)) (.className this))
      (java-str "class " (.className this)))))

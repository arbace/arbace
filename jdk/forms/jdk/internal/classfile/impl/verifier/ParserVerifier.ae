            (when (> ft StackMapGenerator/RESERVED_END)
              (when (== ft StackMapGenerator/SAME_LOCALS_1_STACK_ITEM_EXTENDED)
                (return (unchecked-add-int 3
                                           (ParserVerifier/verificationTypeSize
                                             (cast
                                               StackMapFrameInfo$VerificationTypeInfo
                                               (.getFirst (.stack frame)))))))
              (when (<= ft StackMapGenerator/SAME_FRAME_EXTENDED) (return 3))
              (when (<= ft StackMapGenerator/APPEND_FRAME_END)
                (let [loc (.locals frame)
                      ^:mutable ^int l 3
                      k (unchecked-add-int
                          (unchecked-subtract-int ft StackMapGenerator/APPEND_FRAME_START)
                          1)]
                  (loop [^int i (unchecked-subtract-int (.size loc) k)]
                    (when (< i (.size loc))
                      (set! l
                            (unchecked-add-int l
                                               (ParserVerifier/verificationTypeSize
                                                 (cast
                                                   StackMapFrameInfo$VerificationTypeInfo
                                                   (.get loc i)))))
                      (recur (unchecked-inc-int i))))
                  (return l)))
              (when (== ft StackMapGenerator/FULL_FRAME)
                (let [^:mutable ^int l 7]
                  (for-each [^StackMapFrameInfo$VerificationTypeInfo vt (.stack frame)]
                    (set! l (unchecked-add-int l (ParserVerifier/verificationTypeSize vt))))
                  (for-each [^StackMapFrameInfo$VerificationTypeInfo vt (.locals frame)]
                    (set! l (unchecked-add-int l (ParserVerifier/verificationTypeSize vt))))
                  (return l))))
            (throw (IllegalArgumentException. (java-str "Invalid stack map frame type " ft)))))))


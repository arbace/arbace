  (method ^:private verifyFieldName ^void [this ^String name]
    (when (or (== (.length name) 0)
              (.anyMatch (.chars name)
                         (lambda IntPredicate ^boolean [^int ch]
                           (switch ch (\. \; \[ \/) true false))))
      (throw (VerifyError. (.formatted "Illegal field name %s in %s"
                                       name
                                       (.toString this classModel))))))

  (method ^:private verifyMethodName ^void [this ^String name]
    (when (and (and (not (.equals name ConstantDescs/INIT_NAME))
                    (not (.equals name ConstantDescs/CLASS_INIT_NAME)))
               (or (== (.length name) 0)
                   (.anyMatch (.chars name)
                              (lambda IntPredicate ^boolean [^int ch]
                                (switch ch (\. \; \[ \/ \< \>) true false)))))
      (throw (VerifyError. (.formatted "Illegal method name %s in %s"
                                       name
                                       (.toString this classModel))))))


  (method ^:private stackMapFrameSize ^int [this ^StackMapFrameInfo frame]
    (let [ft (.frameType frame)]
      (cond
        (<= ft StackMapGenerator/SAME_FRAME_END) 1
        (<= ft StackMapGenerator/SAME_LOCALS_1_STACK_ITEM_FRAME_END)
          (unchecked-add-int 1
                             (ParserVerifier/verificationTypeSize
                               (cast StackMapFrameInfo$VerificationTypeInfo
                                     (.getFirst (.stack frame)))))
        :else

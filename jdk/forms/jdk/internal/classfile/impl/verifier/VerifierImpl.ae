                      (.addAll errors verifierErrors)))
                (.addAll errors (VerifierImpl/inference_verify klass))))
          (Collections/unmodifiableList errors))
        (finally
          (VerifierImpl/log_info logger "End class verification for: %s" (new Object/1 [clsName]))))))


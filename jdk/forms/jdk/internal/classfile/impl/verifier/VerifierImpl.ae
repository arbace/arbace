                          (set! no_control_flow true))
                      RawBytecodeHelper/RETURN
                        (do
                          (when-not (.is_bogus return_type)
                            (.verifyError this "Method expects a return value"))
                          (when (and (.equals object_initializer_name (.name _method))
                                     (.flag_this_uninit current_frame))
                            (.verifyError this
                                          "Constructor must call super() or this() before return"))
                          (set! no_control_flow true))
                      (RawBytecodeHelper/GETSTATIC RawBytecodeHelper/PUTSTATIC)
                        (do
                          (.verify_field_instructions this bcs current_frame cp true)
                          (set! no_control_flow false))
                      (RawBytecodeHelper/GETFIELD RawBytecodeHelper/PUTFIELD)
                        (do
                          (.verify_field_instructions this bcs current_frame cp false)
                          (set! no_control_flow false))
                      (RawBytecodeHelper/INVOKEVIRTUAL
                        RawBytecodeHelper/INVOKESPECIAL
                        RawBytecodeHelper/INVOKESTATIC)
                        (do
                          (set! this_uninit
                                (.verify_invoke_instructions
                                  this
                                  bcs
                                  code_length
                                  current_frame
                                  (and (>= bci (aget ex_minmax 0)) (< bci (aget ex_minmax 1)))
                                  this_uninit
                                  return_type
                                  cp
                                  stackmap_table))
                          (set! no_control_flow false))
                      (RawBytecodeHelper/INVOKEINTERFACE RawBytecodeHelper/INVOKEDYNAMIC)
                        (do
                          (set! this_uninit
                                (.verify_invoke_instructions
                                  this
                                  bcs
                                  code_length
                                  current_frame
                                  (and (>= bci (aget ex_minmax 0)) (< bci (aget ex_minmax 1)))
                                  this_uninit
                                  return_type
                                  cp
                                  stackmap_table))
                          (set! no_control_flow false))
                      RawBytecodeHelper/NEW
                        (do
                          (set! index (.getIndexU2 bcs))
                          (.verify_cp_class_type this bci index cp)
                          (let [new_class_type (.cp_index_to_type this index cp)]
                            (when-not (.is_object new_class_type)
                              (.verifyError this "Illegal new instruction"))
                            (set! type (VerificationType/uninitialized_type bci))
                            (.push_stack current_frame type)
                            (set! no_control_flow false)))
                      RawBytecodeHelper/NEWARRAY
                        (do
                          (set! type (.get_newarray_type this (.getIndex bcs) bci))
                          (.pop_stack current_frame VerificationType/integer_type)
                          (.push_stack current_frame type)
                          (set! no_control_flow false))
                      RawBytecodeHelper/ANEWARRAY
                        (do
                          (.verify_anewarray this bci (.getIndexU2 bcs) cp current_frame)
                          (set! no_control_flow false))
                      RawBytecodeHelper/ARRAYLENGTH
                        (do
                          (set! type (.pop_stack current_frame VerificationType/reference_check))
                          (when-not (or (.is_null type) (.is_array type))
                            (.verifyError this "Bad type"))
                          (.push_stack current_frame VerificationType/integer_type)
                          (set! no_control_flow false))
                      RawBytecodeHelper/CHECKCAST
                        (do
                          (set! index (.getIndexU2 bcs))
                          (.verify_cp_class_type this bci index cp)
                          (.pop_stack current_frame (.object_type this))
                          (let [klass_type (.cp_index_to_type this index cp)]
                            (.push_stack current_frame klass_type)
                            (set! no_control_flow false)))
                      RawBytecodeHelper/INSTANCEOF
                        (do
                          (set! index (.getIndexU2 bcs))
                          (.verify_cp_class_type this bci index cp)
                          (.pop_stack current_frame (.object_type this))
                          (.push_stack current_frame VerificationType/integer_type)
                          (set! no_control_flow false))
                      (RawBytecodeHelper/MONITORENTER RawBytecodeHelper/MONITOREXIT)
                        (do
                          (.pop_stack current_frame VerificationType/reference_check)
                          (set! no_control_flow false))
                      RawBytecodeHelper/MULTIANEWARRAY
                        (do
                          (set! index (.getIndexU2 bcs))
                          (let [dim (bit-and-int
                                      (aget (.codeArray _method) (unchecked-add-int (.bci bcs) 3))
                                      0xff)]
                            (.verify_cp_class_type this bci index cp)
                            (let [new_array_type (.cp_index_to_type this index cp)]
                              (when-not (.is_array new_array_type)
                                (.verifyError
                                  this
                                  "Illegal constant pool index in multianewarray instruction"))
                              (when (or (< dim 1) (< (.dimensions new_array_type this) dim))
                                (.verifyError
                                  this
                                  (String/format
                                    "Illegal dimension in multianewarray instruction: %d"
                                    (new Object/1 [dim]))))
                              (loop [^int i 0]
                                (when (< i dim)
                                  (.pop_stack current_frame VerificationType/integer_type)
                                  (recur (unchecked-inc-int i))))
                              (.push_stack current_frame new_array_type)
                              (set! no_control_flow false))))
                      RawBytecodeHelper/ATHROW
                        (do
                          (set! type (VerificationType/reference_type java_lang_Throwable))
                          (.pop_stack current_frame type)
                          (set! no_control_flow true))
                      (.verifyError this
                                    (String/format "Bad instruction: %02x" (new Object/1 [opcode])))))
                  (when (and verified_exc_handlers this_uninit)
                    (.verifyError
                      this
                      "Exception handler targets got verified before this_uninit got set"))
                  (when (and (and (not verified_exc_handlers) (>= bci (aget ex_minmax 0)))
                             (< bci (aget ex_minmax 1)))
                    (.verify_exception_handler_targets
                      this
                      bci
                      this_uninit
                      current_frame
                      stackmap_table))))
              (when-not no_control_flow (.verifyError this "Control flow falls through code end"))))))))

  (method ^:private generate_code_data ^byte/1 [this ^RawBytecodeHelper$CodeRange code]
    (let [code_data (new byte/1 (.length code))
          bcs (.start code)]
      (while (.next bcs)
        (if (not (== (.opcode bcs) RawBytecodeHelper/ILLEGAL))
            (let [bci (.bci bcs)]
              (if (== (.opcode bcs) RawBytecodeHelper/NEW)
                  (aset code_data bci (unchecked-byte NEW_OFFSET))
                  (aset code_data bci (unchecked-byte BYTECODE_OFFSET))))
            (.verifyError this "Bad instruction")))
      code_data))

  (method verify_exception_handler_table ^void [this ^int code_length ^byte/1 code_data
                                                ^int/1 minmax]
    (let [cp (.constantPool _method)]
      (for-each [^int/1 exhandler (.exceptionTable _method)]
        (let [start_pc (aget exhandler 0)
              end_pc (aget exhandler 1)
              handler_pc (aget exhandler 2)]
          (when (or (>= start_pc code_length) (== (aget code_data start_pc) 0))
            (.classError this
                         (String/format "Illegal exception table start_pc %d"
                                        (new Object/1 [start_pc]))))
          (when-not (== end_pc code_length)
            (when (or (> end_pc code_length) (== (aget code_data end_pc) 0))
              (.classError this
                           (String/format "Illegal exception table end_pc %d"
                                          (new Object/1 [end_pc])))))
          (when (or (>= handler_pc code_length) (== (aget code_data handler_pc) 0))
            (.classError this
                         (String/format "Illegal exception table handler_pc %d"
                                        (new Object/1 [handler_pc]))))
          (let [catch_type_index (aget exhandler 3)]
            (when-not (== catch_type_index 0)
              (let [catch_type (.cp_index_to_type this catch_type_index cp)
                    throwable (VerificationType/reference_type java_lang_Throwable)
                    is_subclass (.is_assignable_from throwable catch_type this)]
                (when-not is_subclass
                  (.verifyError
                    this
                    (String/format
                      "Catch type is not a subclass of Throwable in exception handler %d"
                      (new Object/1 [handler_pc]))))))
            (when (< start_pc (aget minmax 0)) (aset minmax 0 start_pc))
            (when (> end_pc (aget minmax 1)) (aset minmax 1 end_pc)))))))

  (method verify_local_variable_table ^void [this ^int code_length ^byte/1 code_data]
    (for-each [^LocalVariableInfo lvte (.localVariableTable _method)]
      (let [start_bci (.startPc lvte)
            length (.length lvte)]
        (when (or (>= start_bci code_length) (== (aget code_data start_bci) 0))
          (.classError this
                       (String/format "Illegal local variable table start_pc %d"
                                      (new Object/1 [start_bci]))))
        (let [end_bci (unchecked-add-int start_bci length)]
          (when-not (== end_bci code_length)
            (when (or (>= end_bci code_length) (== (aget code_data end_bci) 0))
              (.classError this
                           (String/format "Illegal local variable table length %d"
                                          (new Object/1 [length])))))))))

  (method verify_stackmap_table ^int [this ^:mutable ^int stackmap_index ^int bci
                                      ^VerificationFrame current_frame
                                      ^VerificationTable stackmap_table ^boolean no_control_flow]
    (cond
      (< stackmap_index (.get_frame_count stackmap_table))
        (let [this_offset (.get_offset stackmap_table stackmap_index)]
          (when (and no_control_flow (> this_offset bci))
            (.verifyError this "Expecting a stack map frame"))
          (cond
            (== this_offset bci)
              (let [matches (.match_stackmap stackmap_table
                                             current_frame
                                             this_offset
                                             stackmap_index
                                             (not no_control_flow)
                                             true)]
                (when-not matches (.verifyError this "Instruction type does not match stack map"))
                (set! stackmap_index (unchecked-inc-int stackmap_index)))
            (< this_offset bci)
              (.classError this
                           (String/format "Bad stack map offset %d" (new Object/1 [this_offset])))))
      no_control_flow (.verifyError this "Expecting a stack map frame"))
    stackmap_index)

  (method verify_exception_handler_targets ^void [this ^int bci ^boolean this_uninit
                                                  ^VerificationFrame current_frame
                                                  ^VerificationTable stackmap_table]
    (let [cp (.constantPool _method)]
      (for-each [^int/1 exhandler (.exceptionTable _method)]
        (let [start_pc (aget exhandler 0)
              end_pc (aget exhandler 1)
              handler_pc (aget exhandler 2)
              catch_type_index (aget exhandler 3)]
          (when (and (>= bci start_pc) (< bci end_pc))
            (let [^:mutable flags (.flags current_frame)]
              (when this_uninit (set! flags (bit-or-int flags VerificationFrame/FLAG_THIS_UNINIT)))
              (let [new_frame (.frame_in_exception_handler current_frame flags)]
                (if (not (== catch_type_index 0))
                    (let [catch_type (.cp_index_to_type this catch_type_index cp)]
                      (.push_stack new_frame catch_type))
                    (let [throwable (VerificationType/reference_type java_lang_Throwable)]
                      (.push_stack new_frame throwable)))
                (let [matches (.match_stackmap stackmap_table new_frame handler_pc true false)]
                  (when-not matches
                    (.verifyError this
                                  (String/format
                                    "Stack map does not match the one at exception handler %d"
                                    (new Object/1 [handler_pc]))))))))))))

  (method verify_cp_index ^void [this ^int bci ^VerificationWrapper$ConstantPoolWrapper cp
                                 ^int index]
    (let [nconstants (.entryCount cp)]
      (when (or (<= index 0) (>= index nconstants))
        (.verifyError this (String/format "Illegal constant pool index %d" (new Object/1 [index]))))))

  (method verify_cp_type ^void [this ^int bci ^int index ^VerificationWrapper$ConstantPoolWrapper cp
                                ^int types]
    (.verify_cp_index this bci cp index)
    (let [tag (.tagAt cp index)]
      (when (or (> tag JVM_CONSTANT_ExternalMax)
                (== (bit-and-int types (bit-shift-left-int 1 tag)) 0))
        (.verifyError this
                      (String/format "Illegal type at constant pool entry %d"
                                     (new Object/1 [index]))))))

  (method verify_cp_class_type ^void [this ^int bci ^int index
                                      ^VerificationWrapper$ConstantPoolWrapper cp]
    (.verify_cp_index this bci cp index)
    (let [tag (.tagAt cp index)]
      (when-not (== tag JVM_CONSTANT_Class)
        (.verifyError this
                      (String/format "Illegal type at constant pool entry %d"
                                     (new Object/1 [index]))))))

  (method verify_ldc ^void [this ^int opcode ^int index ^VerificationFrame current_frame
                            ^VerificationWrapper$ConstantPoolWrapper cp ^int bci]
    (.verify_cp_index this bci cp index)
    (let [tag (.tagAt cp index)
          ^:mutable ^int types 0]
      (if (or (== opcode RawBytecodeHelper/LDC) (== opcode RawBytecodeHelper/LDC_W))
          (do
            (set! types
                  (bit-or-int (bit-or-int (bit-or-int
                                            (bit-or-int
                                              (bit-or-int
                                                (bit-or-int
                                                  (bit-shift-left-int 1 JVM_CONSTANT_Integer)
                                                  (bit-shift-left-int 1 JVM_CONSTANT_Float))
                                                (bit-shift-left-int 1 JVM_CONSTANT_String))
                                              (bit-shift-left-int 1 JVM_CONSTANT_Class))
                                            (bit-shift-left-int 1 JVM_CONSTANT_MethodHandle))
                                          (bit-shift-left-int 1 JVM_CONSTANT_MethodType))
                              (bit-shift-left-int 1 JVM_CONSTANT_Dynamic)))
            (.verify_cp_type this bci index cp types))
          (do
            (when-not (== opcode RawBytecodeHelper/LDC2_W) (.verifyError this "must be ldc2_w"))
            (set! types
                  (bit-or-int (bit-or-int (bit-shift-left-int 1 JVM_CONSTANT_Double)
                                          (bit-shift-left-int 1 JVM_CONSTANT_Long))
                              (bit-shift-left-int 1 JVM_CONSTANT_Dynamic)))
            (.verify_cp_type this bci index cp types)))
      (switch tag
        JVM_CONSTANT_Utf8 (.push_stack current_frame (.object_type this))
        JVM_CONSTANT_String
          (.push_stack current_frame (VerificationType/reference_type java_lang_String))
        JVM_CONSTANT_Class
          (.push_stack current_frame (VerificationType/reference_type java_lang_Class))
        JVM_CONSTANT_Integer (.push_stack current_frame VerificationType/integer_type)
        JVM_CONSTANT_Float (.push_stack current_frame VerificationType/float_type)
        JVM_CONSTANT_Double
          (.push_stack_2 current_frame VerificationType/double_type VerificationType/double2_type)
        JVM_CONSTANT_Long
          (.push_stack_2 current_frame VerificationType/long_type VerificationType/long2_type)
        JVM_CONSTANT_MethodHandle
          (.push_stack current_frame
                       (VerificationType/reference_type java_lang_invoke_MethodHandle))
        JVM_CONSTANT_MethodType
          (.push_stack current_frame (VerificationType/reference_type java_lang_invoke_MethodType))
        JVM_CONSTANT_Dynamic
          (let [constant_type (.dynamicConstantSignatureAt cp index)]
            (when-not (VerificationSignature/isValidTypeSignature constant_type)
              (.verifyError this "Invalid type for dynamic constant"))
            (let [v_constant_type (new VerificationType/1 2)
                  sig_stream (VerificationSignature. constant_type false this)
                  n (.change_sig_to_verificationType this sig_stream v_constant_type 0)
                  ^int opcode_n (if (== opcode RawBytecodeHelper/LDC2_W) 2 1)]
              (when-not (== n opcode_n)
                (set! types
                      (bit-and-int types (bit-not-int (bit-shift-left-int 1 JVM_CONSTANT_Dynamic))))
                (.verify_cp_type this bci index cp types))
              (loop [^int i 0]
                (when (< i n)
                  (.push_stack current_frame (aget v_constant_type i))
                  (recur (unchecked-inc-int i))))))
        (.verifyError this "Invalid index in ldc"))))

  (method verify_switch ^void [this ^RawBytecodeHelper bcs ^int code_length ^byte/1 code_data
                               ^VerificationFrame current_frame ^VerificationTable stackmap_table]
    (let [bci (.bci bcs)
          ^:mutable aligned_bci (VerificationBytecodes/align (unchecked-add-int bci 1))]
      (when (< (.majorVersion _klass) NONZERO_PADDING_BYTES_IN_SWITCH_MAJOR_VERSION)
        (let [^:mutable ^int padding_offset 1]
          (while (< (unchecked-add-int bci padding_offset) aligned_bci)
            (when-not (== (aget (.codeArray _method) (unchecked-add-int bci padding_offset)) 0)
              (.verifyError this "Nonzero padding byte in lookupswitch or tableswitch"))
            (set! padding_offset (unchecked-inc-int padding_offset)))))
      (let [default_offset (.getIntUnchecked bcs aligned_bci)
            ^:mutable ^int keys 0
            ^:mutable ^int delta 0]
        (.pop_stack current_frame VerificationType/integer_type)
        (if (== (.opcode bcs) RawBytecodeHelper/TABLESWITCH)
            (let [low (.getIntUnchecked bcs (unchecked-add-int aligned_bci 4))
                  high (.getIntUnchecked bcs
                                         (unchecked-add-int
                                           aligned_bci
                                           (unchecked-multiply-int 2 4)))]
              (when (> low high)
                (.verifyError this "low must be less than or equal to high in tableswitch"))
              (let [keys64 (unchecked-add (unchecked-subtract (long high) low) 1)]
                (when (> keys64 65535) (.verifyError this "too many keys in tableswitch"))
                (set! keys (unchecked-int keys64))
                (set! delta 1)))
            (do
              (set! keys (.getIntUnchecked bcs (unchecked-add-int aligned_bci 4)))
              (when (< keys 0) (.verifyError this "number of keys in lookupswitch less than 0"))
              (set! delta 2)
              (loop [^int i 0]
                (when (< i (unchecked-subtract-int keys 1))
                  (let [this_key (.getIntUnchecked
                                   bcs
                                   (unchecked-add-int
                                     aligned_bci
                                     (unchecked-multiply-int
                                       (unchecked-add-int 2 (unchecked-multiply-int 2 i))
                                       4)))
                        next_key (.getIntUnchecked
                                   bcs
                                   (unchecked-add-int
                                     aligned_bci
                                     (unchecked-multiply-int
                                       (unchecked-add-int
                                         (unchecked-add-int 2 (unchecked-multiply-int 2 i))
                                         2)
                                       4)))]
                    (if (>= this_key next_key)
                        (do
                          (.verifyError this "Bad lookupswitch instruction")
                          (recur (unchecked-inc-int i)))
                        (recur (unchecked-inc-int i))))))))
        (let [^:mutable target (unchecked-add-int bci default_offset)]
          (.check_jump_target stackmap_table current_frame target)
          (loop [^int i 0]
            (when (< i keys)
              (set! aligned_bci (VerificationBytecodes/align (unchecked-add-int (.bci bcs) 1)))
              (set! target
                    (unchecked-add-int bci
                                       (.getIntUnchecked
                                         bcs
                                         (unchecked-add-int
                                           aligned_bci
                                           (unchecked-multiply-int
                                             (unchecked-add-int 3 (unchecked-multiply-int i delta))
                                             4)))))
              (.check_jump_target stackmap_table current_frame target)
              (recur (unchecked-inc-int i))))))))

  (method verify_field_instructions ^void [this ^RawBytecodeHelper bcs
                                           ^VerificationFrame current_frame
                                           ^VerificationWrapper$ConstantPoolWrapper cp
                                           ^boolean allow_arrays]
    (let [index (.getIndexU2 bcs)]
      (.verify_cp_type this (.bci bcs) index cp (bit-shift-left-int 1 JVM_CONSTANT_Fieldref))
      (let [field_name (.refNameAt cp index)
            field_sig (.refSignatureAt cp index)]
        (when-not (VerificationSignature/isValidTypeSignature field_sig)
          (.verifyError this "Invalid field signature"))
        (let [ref_class_type (.cp_ref_index_to_type this index cp)]
          (when (and (not (.is_object ref_class_type))
                     (or (not allow_arrays) (not (.is_array ref_class_type))))
            (.verifyError this
                          (String/format
                            "Expecting reference to class in class %s at constant pool index %d"
                            (new Object/1 [(.thisClassName _klass) index]))))
          (let [target_class_type ref_class_type
                field_type (new VerificationType/1 2)
                sig_stream (VerificationSignature. field_sig false this)
                ^:mutable ^VerificationType stack_object_type nil
                n (.change_sig_to_verificationType this sig_stream field_type 0)
                ^:mutable ^boolean is_assignable false]
            (switch (.opcode bcs)
              RawBytecodeHelper/GETSTATIC
                (loop [^int i 0]
                  (when (< i n)
                    (.push_stack current_frame (aget field_type i))
                    (recur (unchecked-inc-int i))))
              RawBytecodeHelper/PUTSTATIC
                (loop [^int i (unchecked-subtract-int n 1)]
                  (when (>= i 0)
                    (.pop_stack current_frame (aget field_type i))
                    (recur (unchecked-dec-int i))))
              RawBytecodeHelper/GETFIELD
                (do
                  (set! stack_object_type (.pop_stack current_frame target_class_type))
                  (loop [^int i 0]
                    (when (< i n)
                      (.push_stack current_frame (aget field_type i))
                      (recur (unchecked-inc-int i)))))
              RawBytecodeHelper/PUTFIELD
                (do
                  (loop [^int i (unchecked-subtract-int n 1)]
                    (when (>= i 0)
                      (.pop_stack current_frame (aget field_type i))
                      (recur (unchecked-dec-int i))))
                  (set! stack_object_type (.pop_stack current_frame))
                  (when (and (and (.is_uninitialized_this stack_object_type this)
                                  (.equals target_class_type (.current_type this)))
                             (.findField _klass field_name field_sig))
                    (set! stack_object_type (.current_type this)))
                  (set! is_assignable
                        (.is_assignable_from target_class_type stack_object_type this))
                  (when-not is_assignable
                    (.verifyError this "Bad type on operand stack in putfield")))
              (.verifyError this "Should not reach here")))))))

  (method verify_invoke_init ^boolean [this ^RawBytecodeHelper bcs ^int ref_class_index
                                       ^VerificationType ref_class_type
                                       ^VerificationFrame current_frame ^int code_length
                                       ^boolean in_try_block ^:mutable ^boolean this_uninit
                                       ^VerificationWrapper$ConstantPoolWrapper cp
                                       ^VerificationTable stackmap_table]
    (let [bci (.bci bcs)
          type (.pop_stack current_frame VerificationType/reference_check)]
      (cond
        (.is_uninitialized_this type this)
          (let [superk_name (.superclassName (.current_class this))]
            (when (and (not (.equals (.thisClassName (.current_class this)) (.name ref_class_type)))
                       (not (.equals superk_name (.name ref_class_type))))
              (.verifyError this "Bad <init> method call"))
            (when in_try_block
              (.verify_exception_handler_targets this bci true current_frame stackmap_table))
            (.initialize_object current_frame type (.current_type this))
            (set! this_uninit true))
        (.is_uninitialized type)
          (let [new_offset (.bci type this)]
            (when (or (> new_offset (unchecked-subtract-int code_length 3))
                      (not (== (bit-and-int (aget (.codeArray _method) new_offset) 0xff)
                               RawBytecodeHelper/NEW)))
              (.verifyError this "Expecting new instruction"))
            (let [new_class_index (.getU2 bcs (unchecked-add-int new_offset 1))]
              (.verify_cp_class_type this bci new_class_index cp)
              (let [new_class_type (.cp_index_to_type this new_class_index cp)]
                (when-not (.equals new_class_type ref_class_type)
                  (.verifyError this "Call to wrong <init> method"))
                (when in_try_block
                  (.verify_exception_handler_targets
                    this
                    bci
                    this_uninit
                    current_frame
                    stackmap_table))
                (.initialize_object current_frame type new_class_type))))
        :else (.verifyError this "Bad operand type when invoking <init>"))
      this_uninit))

  (method ^:static is_same_or_direct_interface ^boolean [^VerificationWrapper klass
                                                         ^VerificationType klass_type
                                                         ^VerificationType ref_class_type]
    (if (.equals ref_class_type klass_type)
        true
        (do
          (for-each [^String k_name (.interfaceNames klass)]
            (when (.equals ref_class_type (VerificationType/reference_type k_name)) (return true)))
          false)))

  (method verify_invoke_instructions ^boolean [this ^RawBytecodeHelper bcs ^int code_length
                                               ^VerificationFrame current_frame
                                               ^boolean in_try_block ^:mutable ^boolean this_uninit
                                               ^VerificationType return_type
                                               ^VerificationWrapper$ConstantPoolWrapper cp
                                               ^VerificationTable stackmap_table]
    (let [index (.getIndexU2 bcs)
          opcode (.opcode bcs)
          ^:mutable ^int types 0]
      (switch opcode
        RawBytecodeHelper/INVOKEINTERFACE
          (set! types (bit-shift-left-int 1 JVM_CONSTANT_InterfaceMethodref))
        RawBytecodeHelper/INVOKEDYNAMIC
          (set! types (bit-shift-left-int 1 JVM_CONSTANT_InvokeDynamic))
        (RawBytecodeHelper/INVOKESPECIAL RawBytecodeHelper/INVOKESTATIC)
          (set! types
                (if (< (.majorVersion _klass) STATIC_METHOD_IN_INTERFACE_MAJOR_VERSION)
                    (bit-shift-left-int 1 JVM_CONSTANT_Methodref)
                    (bit-or-int (bit-shift-left-int 1 JVM_CONSTANT_InterfaceMethodref)
                                (bit-shift-left-int 1 JVM_CONSTANT_Methodref))))
        (set! types (bit-shift-left-int 1 JVM_CONSTANT_Methodref)))
      (.verify_cp_type this (.bci bcs) index cp types)
      (let [method_name (.refNameAt cp index)
            method_sig (.refSignatureAt cp index)]
        (when-not (VerificationSignature/isValidMethodSignature method_sig)
          (.verifyError this "Invalid method signature"))
        (let [^:mutable ^VerificationType ref_class_type nil]
          (if (== opcode RawBytecodeHelper/INVOKEDYNAMIC)
              (when (< (.majorVersion _klass) INVOKEDYNAMIC_MAJOR_VERSION)
                (.classError
                  this
                  (String/format
                    "invokedynamic instructions not supported by this class file version (%d), class %s"
                    (new Object/1 [(.majorVersion _klass) (.thisClassName _klass)]))))
              (set! ref_class_type (.cp_ref_index_to_type this index cp)))
          (let [sig (.refSignatureAt cp index)
                ^:mutable ^sig_as_verification_types mth_sig_verif_types nil
                ^{:tag (ArrayList VerificationType)} verif_types (ArrayList. 10)]
            (set! mth_sig_verif_types (sig_as_verification_types. verif_types))
            (.create_method_sig_entry this mth_sig_verif_types sig)
            (let [nargs (.num_args mth_sig_verif_types)
                  bci (.bci bcs)]
              (when (== opcode RawBytecodeHelper/INVOKEINTERFACE)
                (when-not (== (bit-and-int (aget (.codeArray _method) (unchecked-add-int bci 3))
                                           0xff)
                              (unchecked-add-int nargs 1))
                  (.verifyError this "Inconsistent args count operand in invokeinterface"))
                (when-not (== (bit-and-int (aget (.codeArray _method) (unchecked-add-int bci 4))
                                           0xff)
                              0)
                  (.verifyError this "Fourth operand byte of invokeinterface must be zero")))
              (when (== opcode RawBytecodeHelper/INVOKEDYNAMIC)
                (when (or (not (== (bit-and-int (aget
                                                  (.codeArray _method)
                                                  (unchecked-add-int bci 3))
                                                0xff)
                                   0))
                          (not (== (bit-and-int (aget
                                                  (.codeArray _method)
                                                  (unchecked-add-int bci 4))
                                                0xff)
                                   0)))
                  (.verifyError this "Third and fourth operand bytes of invokedynamic must be zero")))
              (cond
                (== (.charAt method_name 0) JVM_SIGNATURE_SPECIAL)
                  (when (or (not (== opcode RawBytecodeHelper/INVOKESPECIAL))
                            (not (.equals object_initializer_name method_name)))
                    (.verifyError this "Illegal call to internal method"))
                (and (and (== opcode RawBytecodeHelper/INVOKESPECIAL)
                          (not (VerifierImpl/is_same_or_direct_interface
                                 (.current_class this)
                                 (.current_type this)
                                 ref_class_type)))
                     (not (.equals ref_class_type
                                   (VerificationType/reference_type
                                     (.superclassName (.current_class this))))))
                  (let [is_interface (new boolean/1 [false])
                        subtype (.is_reference_assignable_from
                                  ref_class_type
                                  (.current_type this)
                                  this
                                  is_interface)]
                    (cond
                      (not subtype)
                        (.verifyError
                          this
                          "Bad invokespecial instruction: current class isn't assignable to reference class.")
                      (aget is_interface 0)
                        (.verifyError
                          this
                          "Bad invokespecial instruction: interface method to invoke is not in a direct superinterface."))))
              (let [^{:tag (ArrayList VerificationType)} sig_verif_types (.sig_verif_types
                                                                           mth_sig_verif_types)]
                (when (nil? sig_verif_types)
                  (.verifyError this "Missing signature's array of verification types"))
                (loop [^int i (unchecked-subtract-int nargs 1)]
                  (when (>= i 0)
                    (.pop_stack current_frame (cast VerificationType (.get sig_verif_types i)))
                    (recur (unchecked-dec-int i))))
                (when (and (not (== opcode RawBytecodeHelper/INVOKESTATIC))
                           (not (== opcode RawBytecodeHelper/INVOKEDYNAMIC)))
                  (if (.equals object_initializer_name method_name)
                      (set! this_uninit
                            (.verify_invoke_init
                              this
                              bcs
                              index
                              ref_class_type
                              current_frame
                              code_length
                              in_try_block
                              this_uninit
                              cp
                              stackmap_table))
                      (switch opcode
                        RawBytecodeHelper/INVOKESPECIAL
                          (.pop_stack current_frame (.current_type this))
                        RawBytecodeHelper/INVOKEVIRTUAL
                          (let [stack_object_type (.pop_stack current_frame ref_class_type)]
                            (when-not (identical? (.current_type this) stack_object_type)
                              (.classNameAt cp (.refClassIndexAt cp index))))
                        (do
                          (when-not (== opcode RawBytecodeHelper/INVOKEINTERFACE)
                            (.verifyError this "Unexpected opcode encountered"))
                          (.pop_stack current_frame ref_class_type)))))
                (let [sig_verif_types_len (.size sig_verif_types)]
                  (when (> sig_verif_types_len nargs)
                    (when (.equals object_initializer_name method_name)
                      (.verifyError this "Return type must be void in <init> method"))
                    (when (> sig_verif_types_len (unchecked-add-int nargs 2))
                      (.verifyError this "Signature verification types array return type is bogus"))
                    (loop [^int i nargs]
                      (when (< i sig_verif_types_len)
                        (when-not (or
                                    (or
                                      (== i nargs)
                                      (.is_long2 (cast VerificationType (.get sig_verif_types i))))
                                    (.is_double2 (cast VerificationType (.get sig_verif_types i))))
                          (.verifyError this "Unexpected return verificationType"))
                        (.push_stack current_frame (cast VerificationType (.get sig_verif_types i)))
                        (recur (unchecked-inc-int i)))))
                  this_uninit))))))))

  (method get_newarray_type ^VerificationType [this ^int index ^int bci]
    (let [from_bt (new String/1 [nil nil nil nil "[Z" "[C" "[F" "[D" "[B" "[S" "[I" "[J"])]
      (when (or (< index (.-type VerificationSignature$BasicType/T_BOOLEAN))
                (> index (.-type VerificationSignature$BasicType/T_LONG)))
        (.verifyError this "Illegal newarray instruction"))
      (let [sig (aget from_bt index)] (VerificationType/reference_type sig))))

  (method verify_anewarray ^void [this ^int bci ^int index
                                  ^VerificationWrapper$ConstantPoolWrapper cp
                                  ^VerificationFrame current_frame]
    (.verify_cp_class_type this bci index cp)
    (.pop_stack current_frame VerificationType/integer_type)
    (let [component_type (.cp_index_to_type this index cp)
          ^:mutable ^int length 0
          ^:mutable ^String arr_sig_str nil]
      (if (.is_array component_type)
          (let [component_name (.name component_type)]
            (set! length (.length component_name))
            (when (and (> length MAX_ARRAY_DIMENSIONS)
                       (== (.charAt component_name (unchecked-subtract-int MAX_ARRAY_DIMENSIONS 1))
                           JVM_SIGNATURE_ARRAY))
              (.verifyError this
                            "Illegal anewarray instruction, array has more than 255 dimensions"))
            (set! length (unchecked-inc-int length))
            (set! arr_sig_str
                  (String/format "%c%s" (new Object/1 [JVM_SIGNATURE_ARRAY component_name])))
            (when-not (== (.length arr_sig_str) length)
              (.verifyError this "Unexpected number of characters in string")))
          (let [component_name (.name component_type)]
            (set! length (unchecked-add-int (.length component_name) 3))
            (set! arr_sig_str
                  (String/format "%c%c%s;"
                                 (new Object/1
                                      [JVM_SIGNATURE_ARRAY JVM_SIGNATURE_CLASS component_name])))
            (when-not (== (.length arr_sig_str) length)
              (.verifyError this "Unexpected number of characters in string"))))
      (let [new_array_type (VerificationType/reference_type arr_sig_str)]
        (.push_stack current_frame new_array_type))))

  (method verify_iload ^void [this ^int index ^VerificationFrame current_frame]
    (.get_local current_frame index VerificationType/integer_type)
    (.push_stack current_frame VerificationType/integer_type))

  (method verify_lload ^void [this ^int index ^VerificationFrame current_frame]
    (.get_local_2 current_frame index VerificationType/long_type VerificationType/long2_type)
    (.push_stack_2 current_frame VerificationType/long_type VerificationType/long2_type))

  (method verify_fload ^void [this ^int index ^VerificationFrame current_frame]
    (.get_local current_frame index VerificationType/float_type)
    (.push_stack current_frame VerificationType/float_type))

  (method verify_dload ^void [this ^int index ^VerificationFrame current_frame]
    (.get_local_2 current_frame index VerificationType/double_type VerificationType/double2_type)
    (.push_stack_2 current_frame VerificationType/double_type VerificationType/double2_type))

  (method verify_aload ^void [this ^int index ^VerificationFrame current_frame]
    (let [type (.get_local current_frame index VerificationType/reference_check)]
      (.push_stack current_frame type)))

  (method verify_istore ^void [this ^int index ^VerificationFrame current_frame]
    (.pop_stack current_frame VerificationType/integer_type)
    (.set_local current_frame index VerificationType/integer_type))

  (method verify_lstore ^void [this ^int index ^VerificationFrame current_frame]
    (.pop_stack_2 current_frame VerificationType/long2_type VerificationType/long_type)
    (.set_local_2 current_frame index VerificationType/long_type VerificationType/long2_type))

  (method verify_fstore ^void [this ^int index ^VerificationFrame current_frame]
    (.pop_stack current_frame VerificationType/float_type)
    (.set_local current_frame index VerificationType/float_type))

  (method verify_dstore ^void [this ^int index ^VerificationFrame current_frame]
    (.pop_stack_2 current_frame VerificationType/double2_type VerificationType/double_type)
    (.set_local_2 current_frame index VerificationType/double_type VerificationType/double2_type))

  (method verify_astore ^void [this ^int index ^VerificationFrame current_frame]
    (let [type (.pop_stack current_frame VerificationType/reference_check)]
      (.set_local current_frame index type)))

  (method verify_iinc ^void [this ^int index ^VerificationFrame current_frame]
    (let [type (.get_local current_frame index VerificationType/integer_type)]
      (.set_local current_frame index type)))

  (method verify_return_value ^void [this ^VerificationType return_type ^VerificationType type
                                     ^int bci ^VerificationFrame current_frame]
    (when (.is_bogus return_type) (.verifyError this "Method does not expect a return value"))
    (let [match (.is_assignable_from return_type type this)]
      (when-not match (.verifyError this "Bad return type"))))

  (method ^:private dumpMethod ^void [this]
    (when (some? _logger)
      (.toYaml (ClassPrinter/toTree (.-m _method) ClassPrinter$Verbosity/CRITICAL_ATTRIBUTES)
               _logger)))

  (method verifyError ^void [this ^String msg]
    (.dumpMethod this)
    (throw (VerifyError. (.trim (String/format "%s in %s::%s(%s) @%d %s"
                                               (new
                                                 Object/1
                                                 [msg
                                                  (.thisClassName _klass)
                                                  (.name _method)
                                                  (.parameters _method)
                                                  bci
                                                  errorContext]))))))

  (method verifyError ^void [this ^String msg ^VerificationFrame from ^VerificationFrame target]
    (.dumpMethod this)
    (throw (VerifyError. (String/format "%s in %s::%s(%s) @%d %s%n  while assigning %s%n  to %s"
                                        (new Object/1
                                             [msg
                                              (.thisClassName _klass)
                                              (.name _method)
                                              (.parameters _method)
                                              bci
                                              errorContext
                                              from
                                              target])))))

  (method classError ^void [this ^String msg]
    (.dumpMethod this)
    (throw (VerifyError. (String/format "%s in %s::%s(%s)"
                                        (new Object/1
                                             [msg
                                              (.thisClassName _klass)
                                              (.name _method)
                                              (.parameters _method)]))))))

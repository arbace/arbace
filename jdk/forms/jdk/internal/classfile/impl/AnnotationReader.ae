  (method ^:public ^:static writeAnnotationValue ^void [^BufWriterImpl buf ^AnnotationValue value]
    (let [tag (.tag value)]
      (.writeU1 buf tag)
      (switch tag
        (AnnotationValue/TAG_BOOLEAN AnnotationValue/TAG_BYTE
                                     AnnotationValue/TAG_CHAR
                                     AnnotationValue/TAG_DOUBLE
                                     AnnotationValue/TAG_FLOAT
                                     AnnotationValue/TAG_INT
                                     AnnotationValue/TAG_LONG
                                     AnnotationValue/TAG_SHORT
                                     AnnotationValue/TAG_STRING)
          (.writeIndex buf (.constant (cast AnnotationValue$OfConstant value)))
        AnnotationValue/TAG_CLASS
          (.writeIndex buf (.className (cast AnnotationValue$OfClass value)))
        AnnotationValue/TAG_ENUM
          (let [enumValue (cast AnnotationValue$OfEnum value)]
            (.writeIndex buf (.className enumValue))
            (.writeIndex buf (.constantName enumValue)))
        AnnotationValue/TAG_ANNOTATION
          (AnnotationReader/writeAnnotation buf
                                            (.annotation (cast AnnotationValue$OfAnnotation value)))
        AnnotationValue/TAG_ARRAY
          (let [array (.values (cast AnnotationValue$OfArray value))]
            (.writeU2 buf (.size array))
            (for-each [^AnnotationValue e array] (AnnotationReader/writeAnnotationValue buf e)))
        (throw (InternalError. (java-str "Unknown value " value)))))))

  (field ^:private ^:static ^:final ^String WSPACES " \t\r\n")

  (method ^:private ^:static ^:final isAllowedForProxy ^boolean [^String name ^String value
                                                                 ^{:tag (Set String)} disabledSchemes
                                                                 ^{:tag (Predicate String)} allowedKeys]
    (cond
      (not (.test allowedKeys name)) false
      (.isEmpty disabledSchemes) true
      :else
        (do
          (when (.equalsIgnoreCase name "proxy-authorization")
            (when (.isEmpty value) (return false))
            (for-each [^String scheme disabledSchemes]
              (let [slen (.length scheme)
                    vlen (.length value)]
                (cond
                  (== vlen slen) (when (.equalsIgnoreCase value scheme) (return false))
                  (> vlen slen)
                    (when (.equalsIgnoreCase (.substring value 0 slen) scheme)
                      (let [c (.codePointAt value slen)]
                        (when (or (or (> (.indexOf WSPACES c) -1) (Character/isSpaceChar c))
                                  (Character/isWhitespace c))
                          (return false))))))))
          true)))


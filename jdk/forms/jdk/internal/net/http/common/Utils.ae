  (method ^:private ^:static getLoggerConfig ^DebugLogger$LoggerConfig [^String loggerName
                                                                        ^DebugLogger$LoggerConfig def]
    (let [prop (System/getProperty loggerName)]
      (if (nil? prop)
          def
          (let [^:mutable config DebugLogger$LoggerConfig/OFF]
            (for-each [^:mutable ^String s (.split prop ",")]
              (set! s (.trim s))
              (when-not (.isEmpty s)
                (let [len (.length s)]
                  (switch len
                    3
                      (cond
                        (.regionMatches s true 0 "err" 0 3)
                          (set! config (.withErrLevel config SystemLoggers$Logger$Level/ALL))
                        (.regionMatches s true 0 "out" 0 3)
                          (set! config (.withOutLevel config SystemLoggers$Logger$Level/ALL))
                        (.regionMatches s true 0 "log" 0 3)
                          (set! config (.withLogLevel config SystemLoggers$Logger$Level/ALL)))
                    4
                      (when (.regionMatches s true 0 "true" 0 4)
                        (set! config
                              (.withLogLevel (.withErrLevel config SystemLoggers$Logger$Level/ALL)
                                             SystemLoggers$Logger$Level/ALL)))
                    nil))))
            config))))


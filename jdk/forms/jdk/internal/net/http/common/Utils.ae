  (method ^:private ^:static getDisallowedHeaders ^{:tag (Set String)} []
    (let [^{:tag (Set String)} headers (TreeSet. String/CASE_INSENSITIVE_ORDER)]
      (.addAll headers (Set/of "connection" "content-length" "expect" "host" "upgrade" "alt-used"))
      (let [v (Utils/getNetProperty "jdk.httpclient.allowRestrictedHeaders")]
        (if (some? v)
            (let [tokens (.split (.trim v) ",")]
              (for-each [^String token tokens] (.remove headers token))
              (Collections/unmodifiableSet headers))
            (Collections/unmodifiableSet headers)))))


  (method ^:public ^:static describeOps ^String [^int interestOps]
    (let [^:mutable ops (cast String (.get opsMap interestOps))]
      (if (some? ops)
          ops
          (let [opsb (StringBuilder.)
                mask (bit-or-int (bit-or-int (bit-or-int SelectionKey/OP_READ SelectionKey/OP_WRITE)
                                             SelectionKey/OP_CONNECT)
                                 SelectionKey/OP_ACCEPT)]
            (when (== (bit-and-int interestOps SelectionKey/OP_READ) SelectionKey/OP_READ)
              (.append opsb "R"))
            (when (== (bit-and-int interestOps SelectionKey/OP_WRITE) SelectionKey/OP_WRITE)
              (.append opsb "W"))
            (when (== (bit-and-int interestOps SelectionKey/OP_ACCEPT) SelectionKey/OP_ACCEPT)
              (.append opsb "A"))
            (when (== (bit-and-int interestOps SelectionKey/OP_CONNECT) SelectionKey/OP_CONNECT)
              (.append opsb "C"))
            (when-not (== (bit-or-int interestOps mask) mask)
              (.append opsb (java-str "(" interestOps ")")))
            (set! ops (.toString opsb))
            (.put opsMap interestOps ops)
            ops))))


                limit (.limit src)]
            (.limit src (unchecked-subtract-int limit diff))
            (.put dst src)
            (.limit src limit))
          (.put dst src))
      (unchecked-subtract-int srcLen (.remaining src))))

  (field ^:private ^:static ^:final ^int COPY_THRESHOLD 8192)

  (method ^:public ^:static accumulateBuffers ^long [^{:tag (List ByteBuffer)} currentList
                                                     ^{:tag (List ByteBuffer)} buffersToAdd]
    (let [^:mutable accumulatedBytes 0]
      (for-each [^ByteBuffer bufferToAdd buffersToAdd]
        (let [remaining (.remaining bufferToAdd)]
          (when-not (<= remaining 0)
            (let [listSize (.size currentList)]
              (if (== listSize 0)
                  (do (.add currentList bufferToAdd) (set! accumulatedBytes remaining))
                  (let [lastBuffer (cast ByteBuffer
                                         (.get currentList (unchecked-subtract-int listSize 1)))
                        freeSpace (unchecked-subtract-int
                                    (.capacity lastBuffer)
                                    (.limit lastBuffer))]
                    (if (and (<= remaining COPY_THRESHOLD) (>= freeSpace remaining))
                        (let [position (.position lastBuffer)
                              limit (.limit lastBuffer)]
                          (.position lastBuffer limit)
                          (.limit lastBuffer (unchecked-add-int limit remaining))
                          (.put lastBuffer bufferToAdd)
                          (.position lastBuffer position))
                        (.add currentList bufferToAdd))
                    (set! accumulatedBytes (unchecked-add accumulatedBytes remaining))))))))
      accumulatedBytes))


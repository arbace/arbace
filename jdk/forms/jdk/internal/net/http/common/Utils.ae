      (when-not (Utils/isValidName name) (throw (Utils/newIAE "invalid header name: \"%s\"" name)))
      (when-not (.test Utils/ALLOWED_HEADERS name nil)
        (throw (Utils/newIAE "restricted header name: \"%s\"" name)))
      (when-not (Utils/isValidValue value)
        (throw (Utils/newIAE "invalid header value for %s: \"%s\"" name value)))
      true))


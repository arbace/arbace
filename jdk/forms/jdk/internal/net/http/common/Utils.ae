  (method ^:public ^:static addSuppressed :type-params [(T extends Throwable)] ^T [^T x
                                                                                   ^Throwable suppressed]
    (when (and (not (identical? x suppressed)) (some? suppressed))
      (let [^:mutable sup (.getSuppressed x)]
        (when (and (some? sup) (> (alength sup) 0))
          (when (.contains (Arrays/asList sup) suppressed) (return x)))
        (set! sup (.getSuppressed suppressed))
        (when (and (some? sup) (> (alength sup) 0))
          (when (.contains (Arrays/asList sup) x) (return x)))
        (.addSuppressed x suppressed)))
    x)

  (method ^:public ^:static debugDeadline ^String [^Deadline now ^Deadline deadline]
    (let [isDue (<= (.compareTo deadline now) 0)]
      (try
        (cond
          isDue
            (if (.equals deadline Deadline/MIN)
                "due (Deadline.MIN)"
                (java-str "due since " (.until deadline now ChronoUnit/MILLIS) "ms"))
          (.equals deadline Deadline/MAX) "not scheduled (Deadline.MAX)"
          :else (java-str "due in " (.until now deadline ChronoUnit/MILLIS) "ms"))
        (catch ArithmeticException x (if isDue "due since too long" "due in the far future")))))


  (method ^:public ^:static copySSLParameters ^SSLParameters [^SSLParameters p]
    (let [p1 (SSLParameters.)]
      (.setAlgorithmConstraints p1 (.getAlgorithmConstraints p))
      (.setCipherSuites p1 (.getCipherSuites p))
      (.setEnableRetransmissions p1 (.getEnableRetransmissions p))
      (.setMaximumPacketSize p1 (.getMaximumPacketSize p))
      (.setEndpointIdentificationAlgorithm p1 (.getEndpointIdentificationAlgorithm p))
      (when (.getNeedClientAuth p) (.setNeedClientAuth p1 true))
      (when (.getWantClientAuth p) (.setWantClientAuth p1 true))
      (let [protocols (.getProtocols p)]
        (when (some? protocols) (.setProtocols p1 ^String/1 (.clone protocols)))
        (.setSNIMatchers p1 (.getSNIMatchers p))
        (.setServerNames p1 (.getServerNames p))
        (.setUseCipherSuitesOrder p1 (.getUseCipherSuitesOrder p))
        (.setSignatureSchemes p1 (.getSignatureSchemes p))
        (.setNamedGroups p1 (.getNamedGroups p))
        p1)))


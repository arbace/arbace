  (method ^:public ^:static read ^int [^{:tag (List ByteBuffer)} bufs ^byte/1 data ^int offset]
    (let [^:mutable pos offset]
      (for-each [^ByteBuffer buf bufs]
        (when (>= pos (alength data)) (break))
        (let [read (Math/min (.remaining buf) (unchecked-subtract-int (alength data) pos))]
          (when-not (<= read 0) (.get buf data pos read) (set! pos (unchecked-add-int pos read)))))
      (unchecked-subtract-int pos offset)))

  (method ^:public ^:static next ^ByteBuffer [^{:tag (Iterator ByteBuffer)} iterator]
    (let [^:mutable ^ByteBuffer next nil]
      (while (and (.hasNext iterator)
                  (not (.hasRemaining (set! next (cast ByteBuffer (.next iterator)))))))
      (when-not (or (nil? next) (not (.hasRemaining next))) next)))

  (method ^:public ^:static mismatch ^long [^{:tag (List ByteBuffer)} these
                                            ^{:tag (List ByteBuffer)} those]
    (cond
      (.isEmpty these) (if (.isEmpty those) -1 0)
      (.isEmpty those) 0
      :else
        (let [^{:tag (Iterator ByteBuffer)} lefti (.iterator these)
              ^{:tag (Iterator ByteBuffer)} righti (.iterator those)
              ^:mutable left (Utils/next lefti)
              ^:mutable right (Utils/next righti)
              ^:mutable parsed 0]
          (while (or (some? left) (some? right))
            (let [^int m (if (or (nil? left) (nil? right)) 0 (.mismatch left right))]
              (when (== m -1)
                (set! parsed (unchecked-add parsed (.remaining left)))
                (java-assert (== (.remaining right) (.remaining left)))
                (when (some? (set! left (Utils/next lefti)))
                  (when (some? (set! right (Utils/next righti))) (continue))
                  (return parsed))
                (return (if (some? (set! right (Utils/next righti))) parsed -1)))
              (when (== m 0) (return parsed))
              (set! parsed (unchecked-add parsed m))
              (when (< m (.remaining left))
                (when (< m (.remaining right)) (return parsed))
                (when (some? (set! right (Utils/next righti)))
                  (set! left (.slice left m (unchecked-subtract-int (.remaining left) m)))
                  (continue))
                (return parsed))
              (java-assert (< m (.remaining right)))
              (if (some? (set! left (Utils/next lefti)))
                  (set! right (.slice right m (unchecked-subtract-int (.remaining right) m)))
                  (return parsed))))
          -1)))

  (method ^:public ^:static synchronizedRemaining ^long [^{:tag (List ByteBuffer)} bufs]
    (if (nil? bufs) 0 (locking bufs (Utils/remaining bufs))))

  (method ^:public ^:static remaining ^long [^{:tag (List ByteBuffer)} bufs ^long max]
    (if (nil? bufs)
        0
        (let [^:mutable remain 0]
          (for-each [^ByteBuffer buf bufs]
            (let [size (.remaining buf)]
              (when (< (unchecked-subtract max remain) size)
                (throw (IllegalArgumentException. "too many bytes")))
              (set! remain (unchecked-add remain size))))
          remain)))

  (method ^:public ^:static remaining ^int [^{:tag (List ByteBuffer)} bufs ^int max]
    (unchecked-int (Utils/remaining bufs (long max))))

  (method ^:public ^:static remaining ^long [^ByteBuffer/1 refs ^long max]
    (if (nil? refs)
        0
        (let [^:mutable remain 0]
          (for-each [^ByteBuffer b refs]
            (let [size (.remaining b)]
              (when (< (unchecked-subtract max remain) size)
                (throw (IllegalArgumentException. "too many bytes")))
              (set! remain (unchecked-add remain size))))
          remain)))

  (method ^:public ^:static remaining ^int [^ByteBuffer/1 refs ^int max]
    (unchecked-int (Utils/remaining refs (long max))))

  (method ^:public ^:static close ^void [& ^Closeable/1 closeables]
    (for-each [^Closeable c closeables] (try (.close c) (catch IOException ignored))))

  (field ^:public ^:static ^:final ^ByteBuffer EMPTY_BYTEBUFFER (ByteBuffer/allocate 0))

  (field ^:public ^:static ^:final ^ByteBuffer/1 EMPTY_BB_ARRAY (new ByteBuffer/1 0))

  (field ^:public ^:static ^:final ^{:tag (List ByteBuffer)} EMPTY_BB_LIST (List/of))

  (method ^:public ^:static sliceWithLimitedCapacity ^ByteBuffer [^ByteBuffer buffer ^int amount]
    (let [index (unchecked-add-int (.position buffer) amount)
          limit (.limit buffer)]
      (if (not (== index limit)) (.limit buffer index) (.limit buffer (.capacity buffer)))
      (let [newb (.slice buffer)]
        (.position buffer index)
        (.limit buffer limit)
        (.limit newb amount)
        newb)))

  (method ^:public ^:static sliceOrCopy ^ByteBuffer [^ByteBuffer src ^int start ^int len]
    (Utils/sliceOrCopy src start len SLICE_THRESHOLD))

  (method ^:public ^:static sliceOrCopy ^ByteBuffer [^ByteBuffer src ^int start ^int len
                                                     ^int threshold]
    (java-assert (.hasArray src))
    (let [cap (alength (.array src))]
      (if (< (unchecked-subtract-int cap len) threshold)
          (.slice src start len)
          (let [b (new byte/1 len)] (when (> len 0) (.get src start b 0 len)) (ByteBuffer/wrap b)))))

  (method ^:public ^:static charsetFrom ^Charset [^HttpHeaders headers]
    (let [^:mutable type (cast String
                               (.orElse (.firstValue headers "Content-type")
                                        "text/html; charset=utf-8"))
          i (.indexOf type ";")]
      (when (>= i 0) (set! type (.substring type (unchecked-add-int i 1))))
      (try
        (let [parser (HeaderParser. type)
              value (.findValue parser "charset")]
          (if (nil? value) StandardCharsets/UTF_8 (Charset/forName value)))
        (catch Throwable x
          (when (Log/trace) (Log/logTrace "Can't find charset in \"{0}\" ({1})" type x))
          StandardCharsets/UTF_8))))

  (method ^:public ^:static unchecked ^UncheckedIOException [^IOException e]
    (UncheckedIOException. e))

  (method ^:public ^:static getDebugLogger ^Logger [^{:tag (Supplier String)} dbgTag]
    (DebugLogger/createHttpLogger dbgTag DEBUG_CONFIG))

  (method ^:public ^:static getDebugLogger ^Logger [^{:tag (Supplier String)} dbgTag ^boolean on]
    (let [^DebugLogger$LoggerConfig config (if on DEBUG_CONFIG DebugLogger$LoggerConfig/OFF)]
      (DebugLogger/createHttpLogger dbgTag config)))

  (method ^:public ^:static getHpackLogger ^Logger [^{:tag (Supplier String)} dbgTag
                                                    ^SystemLoggers$Logger$Level errLevel]
    (DebugLogger/createHpackLogger dbgTag (.withErrLevel DEBUG_HPACK_CONFIG errLevel)))

  (method ^:public ^:static getHpackLogger ^Logger [^{:tag (Supplier String)} dbgTag]
    (DebugLogger/createHpackLogger dbgTag DEBUG_HPACK_CONFIG))

  (method ^:public ^:static getWebSocketLogger ^Logger [^{:tag (Supplier String)} dbgTag]
    (DebugLogger/createWebSocketLogger dbgTag DEBUG_WS_CONFIG))

  (method ^:public ^:static immutableSession ^SSLSession [^SSLSession session]
    (if (instance? ExtendedSSLSession session)
        (ImmutableExtendedSSLSession. (cast ExtendedSSLSession session))
        (ImmutableSSLSession. session)))

  (method ^:public ^:static isHostnameVerificationDisabled ^boolean []
    isHostnameVerificationDisabled)

  (method ^:public ^:static resolveAddress ^InetSocketAddress [^:mutable ^InetSocketAddress address]
    (when (and (some? address) (.isUnresolved address))
      (set! address (InetSocketAddress. (.getHostString address) (.getPort address))))
    address)

  (method ^:public ^:static toConnectException ^Throwable [^:mutable ^Throwable e]
    (when (some? e)
      (set! e (Utils/getCompletionCause e))
      (cond
        (instance? ConnectException e) e
        (instance? SecurityException e) e
        (instance? SSLException e) e
        (instance? Error e) e
        (instance? HttpTimeoutException e) e
        :else (let [cause e] (set! e (ConnectException. (.getMessage e))) (.initCause e cause) e))))

  (method ^:public ^:static pow2Size ^int [^int n]
    (cond
      (< n 0) (throw (IllegalArgumentException.))
      (== n 0) 1
      (>= n (bit-shift-left-int 1 30)) (bit-shift-left-int 1 30)
      :else
        (bit-shift-left-int 1
                            (unchecked-subtract-int
                              32
                              (Integer/numberOfLeadingZeros (unchecked-subtract-int n 1))))))

  (method ^:public ^:static createPseudoHeaders ^HttpHeaders [^HttpRequest request]
    (let [hdrs (HttpHeadersBuilder.)
          method (.method request)]
      (.setHeader hdrs ":method" method)
      (let [uri (.uri request)]
        (.setHeader hdrs ":scheme" (.getScheme uri))
        (let [host (.getHost uri)
              port (.getPort uri)]
          (java-assert (some? host))
          (if (not (== port -1))
              (.setHeader hdrs ":authority" (java-str host ":" port))
              (.setHeader hdrs ":authority" host))
          (let [query (.getRawQuery uri)
                ^:mutable path (.getRawPath uri)]
            (when (or (nil? path) (.isEmpty path))
              (if (.equalsIgnoreCase method "OPTIONS") (set! path "*") (set! path "/")))
            (when (some? query) (set! path (java-str path (java-str "?" query))))
            (.setHeader hdrs ":path" (Utils/encode path))
            (.build hdrs))))))

  (method ^:public ^:static encode ^String [^String s]
    (let [n (.length s)]
      (if (== n 0)
          s
          (do
            (let [^:mutable ^int i 0]
              (while true
                (when (>= (.charAt s i) \u0080) (break))
                (when (>= (set! i (unchecked-inc-int i)) n) (return s))))
            (let [ns (Normalizer/normalize s Normalizer$Form/NFC)
                  ^:mutable ^ByteBuffer bb nil]
              (try
                (set! bb
                      (.encode (.onUnmappableCharacter
                                 (.onMalformedInput
                                   (.newEncoder StandardCharsets/UTF_8)
                                   CodingErrorAction/REPORT)
                                 CodingErrorAction/REPORT)
                               (CharBuffer/wrap ns)))
                (catch CharacterCodingException x (java-assert false x)))
              (let [format (.withUpperCase (HexFormat/of))
                    sb (StringBuilder.)]
                (while (.hasRemaining bb)
                  (let [b (bit-and-int (.get bb) 0xff)]
                    (if (>= b 0x80)
                        (do (.append sb \%) (.toHexDigits format sb (unchecked-byte b)))
                        (.append sb (unchecked-char b)))))
                (.toString sb)))))))

  (method ^:public ^:static asHexString ^String [^ByteBuffer buffer]
    (if (not (.hasRemaining buffer))
        ""
        (let [bytes (new byte/1 (.remaining buffer))]
          (.get buffer (.position buffer) bytes)
          (.formatHex (HexFormat/of) bytes))))

  (method ^:public ^:static asString ^String [^ByteBuffer buffer ^Charset charset]
    (let [decoded (.decode charset buffer)
          chars (new char/1 (.length decoded))]
      (.get decoded chars)
      (String. chars)))

  (method ^:public ^:static asString ^String [^ByteBuffer buffer]
    (Utils/asString buffer StandardCharsets/UTF_8))

  (method ^:public ^:static millis ^String [^Instant now ^Instant deadline]
    (if (.equals Instant/MAX deadline)
        "not scheduled"
        (try
          (let [delay (.until now deadline ChronoUnit/MILLIS)] (java-str delay " ms"))
          (catch ArithmeticException a "too far away"))))

  (method ^:public ^:static millis ^String [^Deadline now ^Deadline deadline]
    (Utils/millis (.asInstant now) (.asInstant deadline)))

  (method ^:public ^:static safeExecutor ^ExecutorService [^ExecutorService delegate
                                                           ^{:tag (BiConsumer Runnable Throwable)} errorHandler]
    (let [overflow (.defaultExecutor (CompletableFuture.))]
      (SafeExecutorService. delegate overflow errorHandler)))

  (defclass ^:public ^:static ^:sealed SafeExecutor
    :implements [Executor]
    :permits [SafeExecutorService]
    :type-params [(E extends Executor)]

    (field ^:final ^E delegate)

    (field ^:final ^{:tag (BiConsumer Runnable Throwable)} errorHandler)

    (field ^:final ^Executor overflow)

    (constructor ^:public [this ^E delegate ^Executor overflow
                           ^{:tag (BiConsumer Runnable Throwable)} errorHandler]
      (set! (.-delegate this) delegate)
      (set! (.-overflow this) overflow)
      (set! (.-errorHandler this) errorHandler))

    (method ^:public execute ^void [this ^Runnable command]
      (.ensureExecutedAsync this command))

    (method ^:private ensureExecutedAsync ^void [this ^Runnable command]
      (try
        (.execute delegate command)
        (catch RejectedExecutionException t
          (.accept errorHandler command t)
          (.execute overflow command)))))

  (defclass ^:public ^:static ^:final SafeExecutorService
    :extends (SafeExecutor ExecutorService)
    :implements [ExecutorService]

    (constructor ^:public [this ^ExecutorService delegate ^Executor overflow
                           ^{:tag (BiConsumer Runnable Throwable)} errorHandler]
      (super. delegate overflow errorHandler))

    (method ^:public shutdown ^void [this]
      (.shutdown (cast ExecutorService (.-delegate this))))

    (method ^:public shutdownNow ^{:tag (List Runnable)} [this]
      (.shutdownNow (cast ExecutorService (.-delegate this))))

    (method ^:public isShutdown ^boolean [this]
      (.isShutdown (cast ExecutorService (.-delegate this))))

    (method ^:public isTerminated ^boolean [this]
      (.isTerminated (cast ExecutorService (.-delegate this))))

    (method ^:public awaitTermination :throws [InterruptedException] ^boolean [this ^long timeout
                                                                               ^TimeUnit unit]
      (.awaitTermination (cast ExecutorService (.-delegate this)) timeout unit))

    (method ^:public submit :type-params [T] ^{:tag (Future T)} [this ^{:tag (Callable T)} task]
      (.submit (cast ExecutorService (.-delegate this)) task))

    (method ^:public submit :type-params [T] ^{:tag (Future T)} [this ^Runnable task ^T result]
      (.submit (cast ExecutorService (.-delegate this)) task result))

    (method ^:public submit ^{:tag (Future ?)} [this ^Runnable task]
      (.submit (cast ExecutorService (.-delegate this)) task))

    (method ^:public invokeAll :type-params [T] :throws [InterruptedException] ^{:tag (List (Future T))} [this
                                                                                                          ^{:tag (Collection (? extends (Callable T)))} tasks]
      (.invokeAll (cast ExecutorService (.-delegate this)) tasks))

    (method ^:public invokeAll :type-params [T] :throws [InterruptedException] ^{:tag (List (Future T))} [this
                                                                                                          ^{:tag (Collection (? extends (Callable T)))} tasks
                                                                                                          ^long timeout
                                                                                                          ^TimeUnit unit]
      (.invokeAll (cast ExecutorService (.-delegate this)) tasks timeout unit))

    (method ^:public invokeAny :type-params [T] :throws [InterruptedException ExecutionException] ^T [this
                                                                                                      ^{:tag (Collection (? extends (Callable T)))} tasks]
      (.invokeAny (cast ExecutorService (.-delegate this)) tasks))

    (method ^:public invokeAny :type-params [T] :throws [InterruptedException
                                                         ExecutionException
                                                         TimeoutException] ^T [this
                                                                               ^{:tag (Collection (? extends (Callable T)))} tasks
                                                                               ^long timeout
                                                                               ^TimeUnit unit]
      (.invokeAny (cast ExecutorService (.-delegate this)) tasks)))

  (method ^:public ^:static configureChannelBuffers :type-params [(T extends NetworkChannel)] ^T [^{:tag (Consumer String)} logSink
                                                                                                  ^T chan
                                                                                                  ^int receiveBufSize
                                                                                                  ^int sendBufSize]
    (when (some? logSink)
      (let [^:mutable bufsize (Utils/getSoReceiveBufferSize logSink chan)]
        (.accept logSink (.formatted "Initial receive buffer size is: %d" bufsize))
        (set! bufsize (Utils/getSoSendBufferSize logSink chan))
        (.accept logSink (.formatted "Initial send buffer size is: %d" bufsize))))
    (when (Utils/trySetReceiveBufferSize logSink chan receiveBufSize)
      (when (some? logSink)
        (let [bufsize (Utils/getSoReceiveBufferSize logSink chan)]
          (.accept logSink (.formatted "Receive buffer size configured: %d" bufsize)))))
    (when (Utils/trySetSendBufferSize logSink chan sendBufSize)
      (when (some? logSink)
        (let [bufsize (Utils/getSoSendBufferSize logSink chan)]
          (.accept logSink (.formatted "Send buffer size configured: %d" bufsize)))))
    chan)

  (method ^:public ^:static trySetReceiveBufferSize ^boolean [^{:tag (Consumer String)} logSink
                                                              ^NetworkChannel chan ^int bufsize]
    (try
      (when (> bufsize 0) (.setOption chan StandardSocketOptions/SO_RCVBUF bufsize) (return true))
      (catch IOException x
        (when (some? logSink)
          (.accept logSink
                   (.formatted "Failed to set receive buffer size to %d on %s" bufsize chan)))))
    false)

  (method ^:public ^:static trySetSendBufferSize ^boolean [^{:tag (Consumer String)} logSink
                                                           ^NetworkChannel chan ^int bufsize]
    (try
      (when (> bufsize 0) (.setOption chan StandardSocketOptions/SO_SNDBUF bufsize) (return true))
      (catch IOException x
        (when (some? logSink)
          (.accept logSink (.formatted "Failed to set send buffer size to %d on %s" bufsize chan)))))
    false)

  (method ^:public ^:static getSoReceiveBufferSize ^int [^{:tag (Consumer String)} logSink
                                                         ^NetworkChannel chan]
    (try
      (return (.intValue (cast Integer (.getOption chan StandardSocketOptions/SO_RCVBUF))))
      (catch IOException x
        (when (some? logSink)
          (.accept logSink (.formatted "Failed to get initial receive buffer size on %s" chan)))))
    0)

  (method ^:public ^:static getSoSendBufferSize ^int [^{:tag (Consumer String)} logSink
                                                      ^NetworkChannel chan]
    (try
      (return (.intValue (cast Integer (.getOption chan StandardSocketOptions/SO_SNDBUF))))
      (catch IOException x
        (when (some? logSink)
          (.accept logSink (.formatted "Failed to get initial receive buffer size on %s" chan)))))
    0)

  (method ^:public ^:static addressConflict ^String [^SocketAddress local ^SocketAddress peer]
    (when-not (or (nil? local) (nil? peer))
      (if (.equals local peer)
          "local endpoint and remote endpoint are bound to the same IP address and port"
          (when-instance [^InetSocketAddress li local]
            (when-instance [^InetSocketAddress pi peer]
              (let [laddr (.getAddress li)
                    paddr (.getAddress pi)]
                (when (and (not (.isAnyLocalAddress laddr)) (not (.isAnyLocalAddress paddr)))
                  (when-not (identical? (.getClass laddr) (.getClass paddr))
                    (if-instance [^Inet6Address laddr6 laddr]
                      (if (not (.isIPv4CompatibleAddress laddr6))
                          (return (.formatted
                                    "local endpoint IP (%s) and remote endpoint IP (%s) don't match"
                                    (.getSimpleName (.getClass laddr))
                                    (.getSimpleName (.getClass paddr))))
                          (when-instance [^Inet6Address paddr6 paddr]
                            (when-not (.isIPv4CompatibleAddress paddr6)
                              (return
                                (.formatted
                                  "local endpoint IP (%s) and remote endpoint IP (%s) don't match"
                                  (.getSimpleName (.getClass laddr))
                                  (.getSimpleName (.getClass paddr)))))))
                      (when-instance [^Inet6Address paddr6 paddr]
                        (when-not (.isIPv4CompatibleAddress paddr6)
                          (return (.formatted
                                    "local endpoint IP (%s) and remote endpoint IP (%s) don't match"
                                    (.getSimpleName (.getClass laddr))
                                    (.getSimpleName (.getClass paddr)))))))))
                (when-not (not (== (.getPort li) (.getPort pi)))
                  (cond
                    (and (.isAnyLocalAddress (.getAddress li))
                         (.isLoopbackAddress (.getAddress pi)))
                      "local endpoint (wildcard) and remote endpoint (loopback) ports conflict"
                    (and (.isAnyLocalAddress (.getAddress pi))
                         (.isLoopbackAddress (.getAddress li)))
                      "local endpoint (loopback) and remote endpoint (wildcard) ports conflict"))))))))

  (method ^:public ^:static exceptionNow ^Throwable [^{:tag (CompletableFuture ?)} cf]
    (when (.isCompletedExceptionally cf)
      (if (.isCancelled cf)
          (try
            (.join cf)
            (catch CancellationException x (return x))
            (catch CompletionException x (return (.getCause x))))
          (return (.exceptionNow cf))))
    (throw (IllegalArgumentException. "cf is not completed exceptionally"))))

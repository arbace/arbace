                (if (.isStopped scheduler) "stopped" "running")
                ", status: "
                lastWrappedStatus)))

  (method ^:private handleError ^void [this ^Throwable t]
    (when (.on debug) (.log debug "handleError" t))
    (.completeExceptionally readerCF t)
    (.completeExceptionally writerCF t)
    (.completeExceptionally alpnCF t)
    (.stop reader)
    (.stop writer))

  (field ^boolean stopped)

  (method ^:private normalStop ^void [this]
    (locking this (when stopped (return)) (set! stopped true))
    (.stop reader)
    (.stop writer)
    (when-not (.isDone alpnCF)
      (let [^Throwable alpn (SSLHandshakeException.
                              "Connection closed before successful ALPN negotiation")]
        (.completeExceptionally alpnCF alpn)))
    (when isMonitored (Monitor/remove monitor)))

  (method ^:private stopOnError ^Void [this ^Throwable error]
    (when-not (.isDone alpnCF) (.completeExceptionally alpnCF error))
    (.normalStop this)
    nil)

  (method ^:private cleanList ^void [this ^{:tag (List ByteBuffer)} l]
    (locking l
      (let [^{:tag (Iterator ByteBuffer)} iter (.iterator l)]
        (while (.hasNext iter)
          (let [b (cast ByteBuffer (.next iter))]
            (when (and (not (.hasRemaining b)) (not (identical? b SENTINEL))) (.remove iter)))))))

  (field ^:private ^:static ^:final ^int NOT_HANDSHAKING 0)

  (field ^:private ^:static ^:final ^int HANDSHAKING 1)

  (field ^:private ^:static ^:final ^int DOING_TASKS 4)

  (field ^:private ^:static ^:final ^int REQUESTING_TASKS 8)

  (field ^:private ^:static ^:final ^int TASK_BITS 12)

  (field ^:private ^:static ^:final ^int READER 1)

  (field ^:private ^:static ^:final ^int WRITER 2)

  (method ^:private ^:static states ^String [^AtomicInteger state]
    (let [s (.get state)
          sb (StringBuilder.)
          x (bit-and-int s (bit-not-int TASK_BITS))]
      (switch x
        NOT_HANDSHAKING (.append sb " NOT_HANDSHAKING ")
        HANDSHAKING (.append sb " HANDSHAKING ")
        (throw (InternalError.)))
      (when (> (bit-and-int s DOING_TASKS) 0) (.append sb "|DOING_TASKS"))
      (when (> (bit-and-int s REQUESTING_TASKS) 0) (.append sb "|REQUESTING_TASKS"))
      (.toString sb)))

  (method ^:private resumeActivity ^void [this]
    (.schedule reader)
    (.schedule writer))

  (field ^:final ^AtomicInteger handshakeState)

  (field ^:final ^{:tag (ConcurrentLinkedQueue String)} stateList
    (when (.on debug) (ConcurrentLinkedQueue.)))

  (field ^:private ^:static ^:final ^IntBinaryOperator REQUEST_OR_DO_TASKS
    (lambda IntBinaryOperator ^int [^int current ^int ignored]
      (if (== (bit-and-int current DOING_TASKS) 0)
          (bit-or-int DOING_TASKS (bit-and-int current HANDSHAKING))
          (bit-or-int (bit-or-int DOING_TASKS REQUESTING_TASKS) (bit-and-int current HANDSHAKING)))))

  (field ^:private ^:static ^:final ^IntBinaryOperator FINISH_OR_DO_TASKS
    (lambda IntBinaryOperator ^int [^int current ^int ignored]
      (if (not (== (bit-and-int current REQUESTING_TASKS) 0))
          (bit-or-int DOING_TASKS (bit-and-int current HANDSHAKING))
          (bit-and-int current HANDSHAKING))))

  (method ^:private doHandshake ^boolean [this ^SSLEngineResult$HandshakeStatus handshakeStatus
                                          ^int caller]
    (.getAndAccumulate handshakeState
                       0
                       (lambda IntBinaryOperator ^int [^int current ^int unused]
                         (bit-or-int HANDSHAKING (bit-and-int current TASK_BITS))))
    (when (and (some? stateList) (.on debug))
      (.add stateList (.toString handshakeStatus))
      (.add stateList (Integer/toString caller)))
    (switch handshakeStatus
      NEED_TASK
        (let [s (.accumulateAndGet handshakeState 0 REQUEST_OR_DO_TASKS)]
          (when (> (bit-and-int s REQUESTING_TASKS) 0) (return false))
          (when (.on debug) (.log debug "obtaining and initiating task execution"))
          (let [^{:tag (List Runnable)} tasks (.obtainTasks this)]
            (.executeTasks this tasks)
            (return false)))
      NEED_WRAP (when (== caller READER) (.triggerWrite writer) (return false))
      (NEED_UNWRAP NEED_UNWRAP_AGAIN) (when (== caller WRITER) (.schedule reader) (return false))
      (throw (InternalError. (java-str "Unexpected handshake status:" handshakeStatus))))
    true)

  (method ^:private obtainTasks ^{:tag (List Runnable)} [this]
    (let [^{:tag (List Runnable)} l (ArrayList.)
          ^:mutable ^Runnable r nil]
      (while (some? (set! r (.getDelegatedTask engine))) (.add l r))
      l))

  (method ^:private executeTasks ^void [this ^{:tag (List Runnable)} tasks]
    (.execute exec
              (lambda Runnable ^void []
                (try
                  (let [^:mutable ^{:tag (List Runnable)} nextTasks tasks]
                    (when (.on debug)
                      (.log debug (java-str "#tasks to execute: " (.size nextTasks))))
                    (loop []
                      (.forEach nextTasks (method-ref Consumer [Runnable] Runnable/.run))
                      (if (identical? (.getHandshakeStatus engine)
                                      SSLEngineResult$HandshakeStatus/NEED_TASK)
                          (set! nextTasks (.obtainTasks this))
                          (let [s (.accumulateAndGet handshakeState 0 FINISH_OR_DO_TASKS)]
                            (if (not (== (bit-and-int s DOING_TASKS) 0))
                                (do
                                  (when (.on debug) (.log debug "re-running tasks (B)"))
                                  (set! nextTasks (.obtainTasks this)))
                                (break))))
                      (when true (recur)))
                    (when (.on debug) (.log debug "finished task execution"))
                    (let [hs (.getHandshakeStatus engine)]
                      (when (or (identical? hs SSLEngineResult$HandshakeStatus/FINISHED)
                                (identical? hs SSLEngineResult$HandshakeStatus/NOT_HANDSHAKING))
                        (.trySetALPN this))
                      (.resumeActivity this)))
                  (catch Throwable t (.handleError this (.checkForHandshake this t)))))))

  (method trySetALPN ^boolean [this]
    (if (== (bit-and-int (.getAndSet handshakeState NOT_HANDSHAKING) (bit-not-int DOING_TASKS))
            HANDSHAKING)
        (do
          (set! applicationBufferSize (.getApplicationBufferSize (.getSession engine)))
          (set! packetBufferSize (.getPacketBufferSize (.getSession engine)))
          (.setALPN this)
          true)
        false))

  (method doClosure :throws [IOException] ^EngineResult [this ^EngineResult r]
    (when (.on debug)
      (.log debug
            "doClosure(%s): %s [isOutboundDone: %s, isInboundDone: %s]"
            (new Object/1
                 [(.-result r)
                  (.getHandshakeStatus engine)
                  (.isOutboundDone engine)
                  (.isInboundDone engine)])))
    (when (.on debug) (.log debug "doClosure: close_notify received"))
    (set! close_notify_received true)
    (.closeOutbound engine)
    (when (identical? (.getHandshakeStatus engine) SSLEngineResult$HandshakeStatus/NEED_WRAP)
      (when-not (.isStopped (.-scheduler writer))
        (.doHandshake this SSLEngineResult$HandshakeStatus/NEED_WRAP READER)))
    r)

  (method ^:public upstreamReader ^{:tag (Flow$Subscriber (List ByteBuffer))} [this]
    reader)

  (method ^:public upstreamWriter ^{:tag (Flow$Subscriber (List ByteBuffer))} [this]
    writer)

  (method ^:public resumeReader ^boolean [this]
    (.signalScheduling reader))

  (method ^:public resetReaderDemand ^void [this]
    (.resetDownstreamDemand reader))

  (defclass ^:static EngineResult
    (field ^:final ^SSLEngineResult result)

    (field ^:final ^ByteBuffer destBuffer)

    (constructor [this ^SSLEngineResult result] (this. result nil))

    (constructor [this ^SSLEngineResult result ^ByteBuffer destBuffer]
      (set! (.-result this) result)
      (set! (.-destBuffer this) destBuffer))

    (method handshaking ^boolean [this]
      (let [s (.getHandshakeStatus result)]
        (and (and (not (identical? s SSLEngineResult$HandshakeStatus/FINISHED))
                  (not (identical? s SSLEngineResult$HandshakeStatus/NOT_HANDSHAKING)))
             (not (identical? (.getStatus result) SSLEngineResult$Status/CLOSED)))))

    (method needUnwrap ^boolean [this]
      (let [s (.getHandshakeStatus result)]
        (identical? s SSLEngineResult$HandshakeStatus/NEED_UNWRAP)))

    (method bytesConsumed ^int [this] (.bytesConsumed result))

    (method bytesProduced ^int [this] (.bytesProduced result))

    (method handshakeStatus ^SSLEngineResult$HandshakeStatus [this]
      (.getHandshakeStatus result))

    (method status ^SSLEngineResult$Status [this] (.getStatus result)))

  (field ^:volatile ^int packetBufferSize)

  (method ^:final getNetBuffer ^ByteBuffer [this]
    (let [^:mutable netSize packetBufferSize]
      (when (<= netSize 0)
        (set! packetBufferSize (set! netSize (.getPacketBufferSize (.getSession engine)))))
      (ByteBuffer/allocate netSize)))

  (field ^:volatile ^int applicationBufferSize)

  (field ^:volatile ^int adaptiveAppBufferSize)

  (method ^:final getAppBuffer ^ByteBuffer [this]
    (let [^:mutable appSize applicationBufferSize]
      (when (<= appSize 0)
        (set! applicationBufferSize (set! appSize (.getApplicationBufferSize (.getSession engine)))))
      (let [^:mutable size adaptiveAppBufferSize]
        (cond (<= size 0) (set! size 512) (> size appSize) (set! size appSize))
        (ByteBuffer/allocate size))))

  (method ^:final dbgString ^String [this]
    (java-str "SSLFlowDelegate(" tubeName ")")))

  (method ^:public ^:static logParams ^void [^SSLParameters p]
    (when-not (not (Log/ssl))
      (if (nil? p)
          (Log/logSSL "SSLParameters: Null params" (new Object/1 []))
          (let [^:final sb (StringBuilder. "SSLParameters:")
                ^:final ^{:tag (List Object)} params (ArrayList.)]
            (when (some? (.getCipherSuites p))
              (for-each [^String cipher (.getCipherSuites p)]
                (.append (.append (.append sb "\n    cipher: {") (.size params)) "}")
                (.add params cipher)))
            (for-each [^String approto (.getApplicationProtocols p)]
              (.append (.append (.append sb "\n    application protocol: {") (.size params)) "}")
              (.add params approto))
            (when (some? (.getProtocols p))
              (for-each [^String protocol (.getProtocols p)]
                (.append (.append (.append sb "\n    protocol: {") (.size params)) "}")
                (.add params protocol)))
            (when (some? (.getEndpointIdentificationAlgorithm p))
              (.append (.append (.append sb "\n    endpointIdAlg: {") (.size params)) "}")
              (.add params (.getEndpointIdentificationAlgorithm p)))
            (when (some? (.getServerNames p))
              (for-each [^SNIServerName sname (.getServerNames p)]
                (.append (.append (.append sb "\n    server name: {") (.size params)) "}")
                (.add params (.toString sname))))
            (.append sb \newline)
            (Log/logSSL (.toString sb) (.toArray params))))))

  (method ^:public ^:static dumpHeaders ^void [^StringBuilder sb ^String prefix ^HttpHeaders headers]
    (when (some? headers)
      (let [^{:tag (Map String (List String))} h (.map headers)
            ^{:tag (Set (Map$Entry String (List String)))} entries (.entrySet h)
            ^:mutable sep ""]
        (for-each [^{:tag (Map$Entry String (List String))} entry entries]
          (let [key (cast String (.getKey entry))
                ^{:tag (List String)} values (cast List (.getValue entry))]
            (if (or (nil? values) (.isEmpty values))
                (do (.append sb sep) (.append (.append (.append sb prefix) key) \:) (set! sep "\n"))
                (for-each [^String value values]
                  (.append sb sep)
                  (.append (.append (.append sb prefix) key) \:)
                  (.append (.append sb \space) value)
                  (set! sep "\n")))))
        (.append sb \newline))))


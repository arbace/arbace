      (method ^:public cancel ^void [this]
        (when (.on debug) (.log debug (java-str "subscription cancelled for " request)))
        (when-not cancelled (set! cancelled true) (.runOrSchedule writeScheduler executor)))))

  (method ^:final client ^HttpClientImpl [this] client)

  (method dbgString ^String [this] "Http1Exchange")

  (method expectContinueFailed ^void [this ^int rcode]
    (let [response (.-response this)] (when (some? response) (.closeWhenFinished response)))))

        (super. SelectionKey/OP_READ channel)
        (set! (.-sub this) sub))

      (method ^:protected ^:final signalEvent ^void [this]
        (try
          (.eventUpdated client this)
          (.signalReadable sub)
          (catch Throwable t (.signalError sub t))))

      (method ^:protected ^:final signalError ^void [this ^Throwable error]
        (when (.on debug) (.log debug "signalError to %s (%s)" (new Object/1 [sub error])))
        (.signalError sub error))

      (method debug ^Logger [this] debug)))

  (defclass ^:public ^:interface BufferSource
    (method getBuffer ^ByteBuffer [this])

    (method append ^{:tag (List ByteBuffer)} [this ^{:tag (List ByteBuffer)} list ^ByteBuffer buffer
                                              ^int start])

    (method ^:default returnUnused ^void [this ^ByteBuffer buffer]))

  (defclass ^:private ^:static ^:final SliceBufferSource
    :implements [BufferSource]

    (field ^:private ^:final ^{:tag (Supplier ByteBuffer)} factory)

    (field ^:private ^:volatile ^ByteBuffer current)

    (constructor ^:public [this]
      (this. (method-ref Supplier ^ByteBuffer [] Utils/getBuffer)))

    (constructor ^:public [this ^{:tag (Supplier ByteBuffer)} factory]
      (set! (.-factory this) (cast Supplier (Objects/requireNonNull factory))))

    (method ^:public ^:final getBuffer ^ByteBuffer [this]
      (let [^:mutable buf current]
        (set! buf
              (if (or (nil? buf) (not (.hasRemaining buf)))
                  (set! current (cast ByteBuffer (.get factory)))
                  buf))
        (java-assert (.hasRemaining buf))
        buf))

    (method ^:public ^:final append ^{:tag (List ByteBuffer)} [this ^{:tag (List ByteBuffer)} list
                                                               ^ByteBuffer buf ^int start]
      (let [limit (.limit buf)]
        (.limit buf (.position buf))
        (.position buf start)
        (let [slice (.slice buf)]
          (.position buf (.limit buf))
          (.limit buf limit)
          (SocketTube/listOf list (.asReadOnlyBuffer slice))))))

  (defclass ^:private ^:static ^:final SSLDirectBufferSource
    :implements [BufferSource]

    (field ^:private ^:final ^BufferSupplier factory)

    (field ^:private ^:final ^HttpClientImpl client)

    (field ^:private ^ByteBuffer current)

    (constructor ^:public [this ^HttpClientImpl client]
      (set! (.-client this) (cast HttpClientImpl (Objects/requireNonNull client)))
      (set! (.-factory this)
            (cast BufferSupplier (Objects/requireNonNull (.getSSLBufferSupplier client)))))

    (method ^:public ^:final getBuffer ^ByteBuffer [this]
      (java-assert (.isSelectorThread client))
      (let [^:mutable buf current]
        (when (nil? buf) (set! buf (set! current (.get factory))))
        (java-assert (.hasRemaining buf))
        (java-assert (== (.position buf) 0))
        buf))

    (method ^:public ^:final append ^{:tag (List ByteBuffer)} [this ^{:tag (List ByteBuffer)} list
                                                               ^ByteBuffer buf ^int start]
      (java-assert (.isSelectorThread client))
      (java-assert (.isDirect buf))
      (java-assert (== start 0))
      (java-assert (identical? current buf))
      (set! current nil)
      (.limit buf (.position buf))
      (.position buf start)
      (SocketTube/listOf list buf))

    (method ^:public returnUnused ^void [this ^ByteBuffer buffer]
      (java-assert (identical? buffer current))
      (let [buf current]
        (when (some? buf)
          (java-assert (== (.position buf) 0))
          (set! current nil)
          (.limit buf (.position buf))
          (.recycle factory buf)))))

  (field ^:static ^:final ^int MAX_BUFFERS 3)

  (field ^:static ^:final ^{:tag (List ByteBuffer)} EOF (List/of))

  (field ^:static ^:final ^{:tag (List ByteBuffer)} NOTHING (List/of Utils/EMPTY_BYTEBUFFER))

  (method ^:private readAvailable :throws [IOException] ^{:tag (List ByteBuffer)} [this
                                                                                   ^BufferSource buffersSource]
    (let [^:mutable buf (.getBuffer buffersSource)]
      (java-assert (.hasRemaining buf))
      (let [^:mutable ^int read 0
            ^:mutable pos (.position buf)
            ^:mutable ^{:tag (List ByteBuffer)} list nil]
        (while (.hasRemaining buf)
          (try
            (while (> (set! read (.read channel buf)) 0) (when-not (.hasRemaining buf) (break)))
            (catch IOException x
              (if (and (== (.position buf) pos) (nil? list))
                  (do (.returnUnused buffersSource buf) (throw x))
                  (do (.compareAndSet errorRef nil x) (set! read 0)))))
          (when (== (.position buf) pos)
            (.returnUnused buffersSource buf)
            (when (nil? list) (set! list (if (== read -1) EOF NOTHING)))
            (break))
          (set! list (.append buffersSource list buf pos))
          (when (or (<= read 0) (== (.size list) MAX_BUFFERS)) (break))
          (set! buf (.getBuffer buffersSource))
          (set! pos (.position buf))
          (java-assert (.hasRemaining buf)))
        list)))

  (method ^:private ^:static listOf :type-params [T] ^{:tag (List T)} [^{:tag (List T)} list ^T item]
    (let [^int size (if (nil? list) 0 (.size list))]
      (switch size
        0 (List/of item)
        1 (List/of (.get list 0) item)
        2 (List/of (.get list 0) (.get list 1) item)
        (let [^{:tag (List T)} res (if (instance? ArrayList list) list ^List (ArrayList. list))]
          (.add res item)
          res))))

  (method ^:private writeAvailable :throws [IOException] ^long [this ^{:tag (List ByteBuffer)} bytes]
    (let [srcs (cast ByteBuffer/1 (.toArray bytes Utils/EMPTY_BB_ARRAY))
          ^:final remaining (Utils/remaining srcs)
          ^:mutable written 0]
      (while (> remaining written)
        (try
          (let [w (.write channel srcs)]
            (java-assert (>= w 0) (java-str "negative number of bytes written:" w))
            (when (== w 0) (break))
            (set! written (unchecked-add written w)))
          (catch IOException x (if (== written 0) (throw x) (break)))))
      written))

  (method ^:private resumeEvent ^void [this ^SocketFlowEvent event
                                       ^{:tag (Consumer Throwable)} errorSignaler]
    (let [^:mutable ^boolean registrationRequired false]
      (locking lock (set! registrationRequired (not (.registered event))) (.resume event))
      (try
        (if registrationRequired (.registerEvent client event) (.eventUpdated client event))
        (catch Throwable t (.accept errorSignaler t)))))

  (method ^:private pauseEvent ^void [this ^SocketFlowEvent event
                                      ^{:tag (Consumer Throwable)} errorSignaler]
    (locking lock (.pause event))
    (try (.eventUpdated client event) (catch Throwable t (.accept errorSignaler t))))

  (method ^:public connectFlows ^void [this ^FlowTube$TubePublisher writePublisher
                                       ^FlowTube$TubeSubscriber readSubscriber]
    (when (.on debug) (.log debug "connecting flows"))
    (.subscribe this readSubscriber)
    (.subscribe writePublisher this))

  (method ^:public toString ^String [this] (.dbgString this))

  (method ^:final dbgString ^String [this]
    (java-str "SocketTube(" connectionLabel ")"))

  (method ^:final channelDescr ^String [this] (String/valueOf channel)))

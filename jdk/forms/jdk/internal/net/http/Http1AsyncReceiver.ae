                      "Allocating new buffer for initial: %s"
                      (new Object/1 [(unchecked-add-int size remaining)])))
              (set! b (ByteBuffer/allocate (unchecked-add-int size remaining)))
              (Utils/copy initial b)
              (java-assert (== (.position b) remaining))
              (.flip b)
              (java-assert (== (.position b) 0))
              (java-assert (== (.limit b) remaining))
              (java-assert (== (.remaining b) remaining)))
            (let [pos (.position b)
                  limit (.limit b)]
              (java-assert (== (unchecked-subtract-int limit pos) remaining))
              (java-assert (>= (.capacity b) (unchecked-add-int remaining size))
                (java-str "capacity: " (.capacity b) ", remaining: " (.remaining b) ", size: " size))
              (.position b limit)
              (.limit b (unchecked-add-int (unchecked-add-int pos remaining) size))
              (java-assert (>= (.remaining b) size)
                (java-str "remaining: " (.remaining b) ", size: " size))
              (let [^:mutable ^int count 0]
                (loop [^int i 0]
                  (when (< i (alength qbb))
                    (let [b2 (aget qbb i)
                          r (.remaining b2)]
                      (java-assert (>= (.remaining b) r)
                        (java-str "need at least " r " only " (.remaining b) " available"))
                      (let [copied (Utils/copy b2 b)]
                        (java-assert (== copied r) (java-str "copied=" copied " available=" r))
                        (java-assert (== (.remaining b2) 0))
                        (set! count (unchecked-add-int count copied))
                        (recur (unchecked-inc-int i))))))
                (java-assert (== count size))
                (java-assert (== (.position b)
                                 (unchecked-add-int (unchecked-add-int pos remaining) size))
                  (java-str "b.position=" (.position b) " != " pos "+" remaining "+" size))
                (.limit b (unchecked-add-int limit size))
                (.position b pos)
                (.clear queue)
                (let [^:final bb b]
                  (when (.on debug)
                    (.log debug
                          (java-str "Initial buffer now has "
                                    (.remaining bb)
                                    " pos="
                                    (.position bb)
                                    " limit="
                                    (.limit bb))))
                  b)))))))


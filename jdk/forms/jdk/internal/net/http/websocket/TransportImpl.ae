    (method ^:public run ^void [this]
      (when (.on debug) (.log debug "enter send task"))
      (while (not (.isEmpty queue))
        (try
          (cond
            (.hasRemaining dst)
              (do
                (when (.on debug)
                  (.log debug
                        "%s bytes remaining in buffer %s"
                        (new Object/1 [(.remaining dst) dst])))
                (when-not (.tryCompleteWrite this) (break)))
            (not encoded)

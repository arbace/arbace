                (when firstPass
                  (set! firstPass false)
                  (.peek queue loadCallback)
                  (when (.on debug) (.log debug "load message")))
                (.clear dst)
                (set! encoded (.booleanValue (cast Boolean (.peek queue encodingCallback))))
                (.flip dst)
                (when-not (.tryCompleteWrite this) (break)))
            :else (do (.reset encoder) (.removeAndComplete this nil)))
          (catch Throwable t
            (when (.on debug) (.log debug "send task exception %s" (new Object/1 [^Object t])))
            (.position dst (.limit dst))
            (.reset encoder)
            (.removeAndComplete this t))))
      (when (.on debug) (.log debug "exit send task")))

    (method ^:private tryCompleteWrite :throws [IOException] ^boolean [this]

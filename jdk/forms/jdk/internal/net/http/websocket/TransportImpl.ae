                  (.registerEvent channel writeEvent)
                  (.compareAndSet writeState ChannelState/UNREGISTERED ChannelState/WAITING)
                  (when (.on debug) (.log debug "registered write event"))
                  (break))
              AVAILABLE
                (let [written (.write TransportImpl/this)]
                  (if written
                      (do
                        (when (.on debug) (.log debug "finished writing to the channel"))
                        (set! finished true)
                        (break))
                      (.compareAndSet writeState ChannelState/AVAILABLE ChannelState/UNREGISTERED)))
              CLOSED (throw (IOException. "Output closed"))
              (throw (InternalError. (String/valueOf ws))))))
        (when (.on debug) (.log debug "exit writing"))
        finished))

    (method ^:private removeAndComplete ^void [this ^Throwable error]

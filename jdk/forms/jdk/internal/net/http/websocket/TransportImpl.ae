          (try (.accept action attachment nil) (finally (.complete future attachment))))
      (set! encoded false)
      (set! firstPass true)
      (set! attachment nil)
      (set! action nil)
      (set! future nil)))

  (defclass ^:private ReceiveTask
    :extends SequentialScheduler$CompleteRestartableTask

    (method ^:public run ^void [this]
      (when (.on debug) (.log debug "enter receive task"))
      (while (not (.isStopped receiveScheduler))
        (let [^:mutable rs readState]
          (when (.hasRemaining data)
            (when (.on debug)
              (.log debug "remaining bytes received %s" (new Object/1 [(.remaining data)])))
            (when-not (.isFulfilled demand)
              (try
                (let [oldPos (.position data)]
                  (.readFrame reader data decoder)
                  (let [newPos (.position data)] (java-assert (not (== oldPos newPos)) data)))
                (catch Throwable e (.stop receiveScheduler) (.onError messageConsumer e)))
              (when-not (.hasRemaining data) (set! rs (set! readState ChannelState/UNREGISTERED)))
              (continue))
            (break))
          (when (.on debug) (.log debug "receive state: %s" (new Object/1 [rs])))
          (switch rs
            WAITING (break)
            UNREGISTERED
              (do
                (try
                  (set! rs (set! readState ChannelState/WAITING))
                  (.registerEvent channel readEvent)
                  (catch Throwable e (.stop receiveScheduler) (.onError messageConsumer e)))
                (break))
            AVAILABLE
              (do
                (try
                  (set! data (.read channel))
                  (catch Throwable e (.stop receiveScheduler) (.onError messageConsumer e) (break)))
                (if (nil? data)
                    (do (.stop receiveScheduler) (.onComplete messageConsumer) (break))
                    (when-not (.hasRemaining data)
                      (set! rs (set! readState ChannelState/UNREGISTERED)))))
            (throw (InternalError. (String/valueOf rs))))))
      (when (.on debug) (.log debug "exit receive task"))))


          ^:mutable success false]
      (cond
        (identical? witness expectedState)
          (do (.runOrSchedule receiveScheduler clientExecutor) (set! success true))
        (and (not (identical? witness State/ERROR)) (not (identical? witness State/CLOSE)))
          (throw (InternalError.)))
      (when (.on debug)
        (.log debug "change state from %s to %s %s" (new Object/1 [expectedState newState success])))
      success))


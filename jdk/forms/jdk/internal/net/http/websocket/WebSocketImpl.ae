  (method ^:private trySetState ^boolean [this ^State newState]
    (let [^:mutable ^State currentState nil
          ^:mutable success false]
      (while true
        (set! currentState (cast State (.get state)))
        (if (or (identical? currentState State/ERROR) (identical? currentState State/CLOSE))
            (break)
            (when (.compareAndSet state currentState newState)
              (.runOrSchedule receiveScheduler clientExecutor)
              (set! success true)
              (break))))
      (when (.on debug)
        (.log debug "set state %s (previous %s) %s" (new Object/1 [newState currentState success])))
      success))

  (method ^:private tryChangeState ^boolean [this ^State expectedState ^State newState]

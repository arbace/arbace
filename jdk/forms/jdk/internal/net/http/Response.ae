  (field ^:final ^int statusCode)

  (field ^:final ^HttpRequestImpl request)

  (field ^:final ^{:tag (Exchange ?)} exchange)

  (field ^:final ^HttpClient$Version version)

  (field ^:final ^boolean isConnectResponse)


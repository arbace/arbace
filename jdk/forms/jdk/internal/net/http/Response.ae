  (constructor [this ^HttpRequestImpl req ^{:tag (Exchange ?)} exchange ^HttpHeaders headers
                ^HttpConnection connection ^int statusCode ^HttpClient$Version version
                ^boolean isConnectResponse]
    (set! (.-headers this) headers)
    (set! (.-request this) req)
    (set! (.-version this) version)

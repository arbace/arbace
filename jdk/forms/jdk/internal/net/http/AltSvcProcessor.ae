(defclass ^:final AltSvcProcessor
  (field ^:private ^:static ^:final ^String HEADER "alt-svc")

  (field ^:private ^:static ^:final ^Logger debug
    (Utils/getDebugLogger (lambda Supplier ^String [] "AltSvc")))

  (field ^:private ^:static ^:final ^{:tag (List AltServicesRegistry$AltService)} CLEAR_ALL_ALT_SVCS
    (List/of))

  (field ^:private ^:static ^:final ^boolean allowLocalHostOrigin
    (Utils/getBooleanProperty "jdk.httpclient.altsvc.allowLocalHostOrigin" true))

  (field ^:private ^:static ^:final ^SNIHostName LOCALHOST_SNI (SNIHostName. "localhost"))

  (defclass ^:private ^:record ParsedHeaderValue [^String rawValue ^String alpnName ^String host
                                                  ^int port ^{:tag (Map String String)} parameters])

  (constructor ^:private [this]
    (throw (UnsupportedOperationException. "Instantiation not supported")))

  (method ^:static processAltSvcHeader ^void [^Response response ^HttpClientImpl client
                                              ^HttpRequestImpl request]
    (when-not (not (.secure request))
      (when-not (== (.-statusCode response) 421)
        (let [^:final altSvcHeaderVal (.firstValue (.headers response) HEADER)]
          (when-not (.isEmpty altSvcHeaderVal)
            (when (.on debug) (.log debug "Processing alt-svc header"))
            (let [^:final conn (.connection (.-exchImpl (.-exchange response)))
                  ^:final ^{:tag (List SNIServerName)} sniServerNames
                    (AltSvcProcessor/getSNIServerNames conn)]
              (if (.isEmpty sniServerNames)
                  (when (.on debug)
                    (.log
                      debug
                      "ignoring alt-svc header because connection %s didn't use SNI during connection establishment"
                      (new Object/1 [conn])))
                  (let [^:mutable ^Origin origin nil]
                    (try
                      (set! origin (Origin/from (.uri request)))
                      (catch IllegalArgumentException iae
                        (when (.on debug)
                          (.log debug (java-str "ignoring alt-svc header due to: " iae)))
                        (return)))
                    (let [altSvcValue (cast String (.get altSvcHeaderVal))]
                      (AltSvcProcessor/processValueAndUpdateRegistry client origin altSvcValue))))))))))

  (method ^:static processAltSvcFrame ^void [^:final ^int streamId ^:final ^AltSvcFrame frame
                                             ^:final ^HttpConnection conn
                                             ^:final ^HttpClientImpl client]
    (let [^:final value (.getAltSvcValue frame)]
      (when-not (or (nil? value) (.isBlank value))
        (when-not (not (.isSecure conn))
          (let [^:final ^{:tag (List SNIServerName)} sniServerNames
                  (AltSvcProcessor/getSNIServerNames conn)]
            (if (.isEmpty sniServerNames)
                (when (.on debug)
                  (.log
                    debug
                    "ignoring altSvc frame because connection %s didn't use SNI during connection establishment"
                    (new Object/1 [conn])))
                (do
                  (.log debug "processing AltSvcFrame %s" (new Object/1 [value]))
                  (let [^:mutable ^Origin origin nil]
                    (if (== streamId 0)
                        (do
                          (when (.isBlank (.getOrigin frame))
                            (.log debug
                                  (java-str "Ignoring invalid alt-svc frame on stream 0 of " conn))
                            (return))
                          (let [^:mutable ^Origin parsedOrigin nil]
                            (try
                              (set! parsedOrigin
                                    (Origin/fromASCIISerializedForm (.getOrigin frame)))
                              (catch IllegalArgumentException iae
                                (.log
                                  debug
                                  (java-str
                                    "origin couldn't be parsed, ignoring invalid alt-svc frame on stream "
                                    streamId
                                    " of "
                                    conn))
                                (return)))
                            (when-not (.equals parsedOrigin (.getOriginServer conn))
                              (.log debug
                                    (java-str "ignoring alt-svc frame on stream 0 for origin: "
                                              parsedOrigin
                                              " received on connection of origin: "
                                              (.getOriginServer conn)))
                              (return))
                            (set! origin parsedOrigin)))
                        (do
                          (when-not (.isEmpty (.getOrigin frame))
                            (.log debug
                                  (java-str "non-empty origin in alt-svc frame on stream "
                                            streamId
                                            " of "
                                            conn
                                            ", ignoring alt-svc frame"))
                            (return))
                          (set! origin (.getOriginServer conn))
                          (java-assert (some? origin)
                            (java-str "origin server is null on connection: " conn))))
                    (AltSvcProcessor/processValueAndUpdateRegistry client origin value)))))))))

  (method ^:private ^:static processValueAndUpdateRegistry ^void [^HttpClientImpl client
                                                                  ^Origin origin ^String altSvcValue]
    (let [^:final ^{:tag (List AltServicesRegistry$AltService)} altServices
            (AltSvcProcessor/processHeaderValue origin altSvcValue)]
      (if (identical? altServices CLEAR_ALL_ALT_SVCS)
          (do
            (.log debug (java-str "clearing AltServiceRegistry for " origin))
            (.clear (.registry client) origin))
          (do
            (.log debug "AltServices: %s" (new Object/1 [altServices]))
            (when-not (.isEmpty altServices) (.replace (.registry client) origin altServices))))))

  (method ^:static getSNIServerNames ^{:tag (List SNIServerName)} [^:final ^HttpConnection conn]
    (let [^:final ^{:tag (List SNIServerName)} sniServerNames (.getSNIServerNames conn)]
      (if (and (some? sniServerNames) (not (.isEmpty sniServerNames)))
          sniServerNames
          (let [^:final addr (.address conn)
                ^:final isLoopbackAddr (if (.isUnresolved addr)
                                           false
                                           (.isLoopbackAddress (.getAddress (.-address conn))))]
            (cond
              (not isLoopbackAddr) (List/of)
              (not allowLocalHostOrigin) (List/of)
              :else (List/of LOCALHOST_SNI))))))

  (method ^:private ^:static processHeaderValue ^{:tag (List AltServicesRegistry$AltService)} [^:final ^Origin origin
                                                                                               ^:final ^String headerValue]
    (let [^:final ^{:tag (List AltServicesRegistry$AltService)} altServices (ArrayList.)
          ^:final altSvcs (.split headerValue ",")]
      (for-each [^:mutable ^String altSvc altSvcs]
        (set! altSvc (.trim altSvc))
        (when (.equals altSvc "clear") (return CLEAR_ALL_ALT_SVCS))
        (let [^:final parsed (AltSvcProcessor/parseAltValue origin altSvc)]
          (if (nil? parsed)
              (.log debug "skipping %s" (new Object/1 [altSvc]))
              (let [^:final deadline (AltSvcProcessor/getValidTill
                                       (cast String (.get (.parameters parsed) "ma")))
                    ^:final persist (AltSvcProcessor/getPersist
                                      (cast String (.get (.parameters parsed) "persist")))
                    ^:final altSvcId (AltServicesRegistry$AltService$Identity.
                                       (.alpnName parsed)
                                       (.host parsed)
                                       (.port parsed))]
                (.ifPresent (AltServicesRegistry$AltService/create altSvcId origin deadline persist)
                            (lambda Consumer ^void [^AltServicesRegistry$AltService altsvc]
                              (.add altServices altsvc)
                              (cond
                                (Log/altsvc)
                                  (let [^:final s altsvc]
                                    (Log/logAltSvc "Created AltService: {0}" s))
                                (.on debug)
                                  (.log debug
                                        "Created AltService for id=%s, origin=%s%n"
                                        (new Object/1 [altSvcId origin])))))))))
      altServices))

  (method ^:private ^:static parseAltValue ^ParsedHeaderValue [^:final ^Origin origin
                                                               ^:final ^String altValue]
    (.log debug "parsing %s" (new Object/1 [altValue]))
    (let [^:final alternativeDelimIndex (.indexOf altValue "=")]
      (if (or (== alternativeDelimIndex -1)
              (== alternativeDelimIndex (unchecked-subtract-int (.length altValue) 1)))
          (do (.log debug "no \"=\" character in %s" (new Object/1 [altValue])) nil)
          (let [^:final protocolId (.substring altValue 0 alternativeDelimIndex)
                ^:final alpnName (AltSvcProcessor/decodePotentialPercentEncoded protocolId)]
            (.log debug "alpn is %s in %s" (new Object/1 [alpnName altValue]))
            (if (not (Alpns/isSecureALPNName alpnName))
                (do (.log debug "alpn %s is not secure, skipping" (new Object/1 [alpnName])) nil)
                (let [^:mutable remaining (.substring
                                            altValue
                                            (unchecked-add-int alternativeDelimIndex 1))]
                  (if (or (not (.startsWith remaining "\"")) (== (.length remaining) 1))
                      (do (.log debug "no quoted authority in %s" (new Object/1 [altValue])) nil)
                      (do
                        (set! remaining (.substring remaining 1))
                        (let [^:final nextDoubleQuoteIndex (.indexOf remaining "\"")]
                          (if (== nextDoubleQuoteIndex -1)
                              (do
                                (.log debug "missing closing quote in %s" (new Object/1 [altValue]))
                                nil)
                              (let [^:final altAuthority (.substring
                                                           remaining
                                                           0
                                                           nextDoubleQuoteIndex)
                                    ^:final hostPort (AltSvcProcessor/getHostPort
                                                       origin
                                                       altAuthority)]
                                (when (some? hostPort)
                                  (if (== nextDoubleQuoteIndex
                                          (unchecked-subtract-int (.length remaining) 1))
                                      (ParsedHeaderValue.
                                        altValue
                                        alpnName
                                        (.host hostPort)
                                        (.port hostPort)
                                        (Map/of))
                                      (do
                                        (set! remaining
                                              (.substring
                                                remaining
                                                (unchecked-add-int nextDoubleQuoteIndex 1)))
                                        (let [^:final ^{:tag (Map String String)} parameters
                                                (AltSvcProcessor/extractParameters remaining)]
                                          (ParsedHeaderValue.
                                            altValue
                                            alpnName
                                            (.host hostPort)
                                            (.port hostPort)
                                            parameters))))))))))))))))

  (method ^:private ^:static decodePotentialPercentEncoded ^String [^:final ^String val]
    (if (not (.contains val "%")) val val))

  (method ^:private ^:static extractParameters ^{:tag (Map String String)} [^:final ^String val]
    (let [^:final tokenizer (StringTokenizer. val ";")]
      (if (not (.hasMoreTokens tokenizer))
          (Map/of)
          (let [^:mutable ^{:tag (Map String String)} parameters nil]
            (while (.hasMoreTokens tokenizer)
              (let [^:final parameter (.trim (.nextToken tokenizer))]
                (when-not (.isEmpty parameter)
                  (let [^:final equalSignIndex (.indexOf parameter \=)]
                    (when-not (or
                                (== equalSignIndex -1)
                                (== equalSignIndex (unchecked-subtract-int (.length parameter) 1)))
                      (let [^:final paramKey (.substring parameter 0 equalSignIndex)
                            ^:final paramValue (.substring
                                                 parameter
                                                 (unchecked-add-int equalSignIndex 1))]
                        (when (nil? parameters) (set! parameters (HashMap.)))
                        (.put parameters paramKey paramValue)))))))
            (if (nil? parameters) (Map/of) (Collections/unmodifiableMap parameters))))))

  (defclass ^:private ^:record HostPort [^String host ^int port])

  (method ^:private ^:static getHostPort ^HostPort [^Origin origin ^String altAuthority]
    (let [^:mutable ^String host nil
          ^:mutable ^int port 0]
      (try
        (let [^:mutable uri (URI. (java-str "http://" altAuthority "/"))]
          (set! host (.getHost uri))
          (set! port (.getPort uri))
          (when (and (nil? host) (== port -1))
            (let [auth (.getRawAuthority uri)]
              (when (.isEmpty auth) (return nil))
              (when (== (.charAt auth 0) \:)
                (set! uri (URI. (java-str "http://x" altAuthority "/")))
                (when (.equals "x" (.getHost uri)) (set! port (.getPort uri))))))
          (when (== port -1)
            (.log debug (java-str "Can't parse authority: " altAuthority))
            (return nil))
          (let [^:mutable ^String hostport nil]
            (if (or (nil? host) (.isEmpty host))
                (do (set! hostport (java-str ":" port)) (set! host (.host origin)))
                (set! hostport (java-str host ":" port)))
            (when-not (.equals hostport altAuthority)
              (.log debug
                    "Authority \"%s\" doesn't match host:port \"%s\""
                    (new Object/1 [altAuthority hostport]))
              (return nil))))
        (catch URISyntaxException x
          (.log debug "Failed to parse authority: %s - %s" (new Object/1 [altAuthority x]))
          (return nil)))
      (HostPort. host port)))

  (method ^:private ^:static getValidTill ^Deadline [^:final ^String maxAge]
    (let [^:final responseGenerationInstant (TimeSource/now)
          ^:const ^long defaultMaxAgeInSecs (unchecked-multiply-int 3600 24)]
      (if (nil? maxAge)
          (.plusSeconds responseGenerationInstant defaultMaxAgeInSecs)
          (try
            (let [^:final seconds (Long/parseLong maxAge)]
              (if (< seconds 0)
                  (.plusSeconds responseGenerationInstant defaultMaxAgeInSecs)
                  (.plusSeconds responseGenerationInstant seconds)))
            (catch NumberFormatException nfe
              (.plusSeconds responseGenerationInstant defaultMaxAgeInSecs))))))

  (method ^:private ^:static getPersist ^boolean [^:final ^String persist]
    (.equals "1" persist)))

  (method ^:public response :throws [IOException] ^HttpRequestImpl [this ^Response r]
    (.lock stateLock)
    (try (.handleResponse this r) (finally (.unlock stateLock))))

  (method ^:private ^:static redirectedMethod ^String [^int statusCode ^String orig]
    (switch statusCode

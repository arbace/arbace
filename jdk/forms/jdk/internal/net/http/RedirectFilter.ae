      (> statusCode 308) false
      :else (switch statusCode (300 304 305 306) false true)))

  (method ^:private handleResponse ^HttpRequestImpl [this ^Response r]
    (let [rcode (.statusCode r)]
      (when-not (or (== rcode 200) (identical? policy HttpClient$Redirect/NEVER))
        (when-not (== rcode HTTP_NOT_MODIFIED)

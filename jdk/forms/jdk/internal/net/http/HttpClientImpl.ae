      (.get http2Count))

    (method ^:public getOutstandingHttp3Streams ^long [this]
      (.get http3Count))

    (method ^:public getOutstandingWebSocketOperations ^long [this]
      (.get websocketCount))

    (method ^:public isFacadeReferenced ^boolean [this]
      (not (.refersTo reference nil)))

    (method ^:public isImplementationReferenced ^boolean [this]
      (not (.refersTo implRef nil)))

    (method ^:public isSelectorAlive ^boolean [this]
      (or (.get isAlive) (not (.get isStarted))))

    (method ^:public getName ^String [this] name))

  (method ^:public getOperationsTracker ^OperationTrackers$Tracker [this]
    (HttpClientTracker. pendingHttpRequestCount
                        pendingHttpOperationsCount
                        pendingHttp2StreamCount
                        pendingHttp3StreamCount
                        pendingWebSocketCount
                        pendingOperationCount
                        pendingTCPConnectionCount
                        pendingSubscribersCount
                        facadeRef
                        implRef
                        isAlive
                        isStarted
                        dbgTag))

  (method finished ^boolean [this]

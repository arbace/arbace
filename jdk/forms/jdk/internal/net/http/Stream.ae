        (set! cf (.thenApplyAsync cf (lambda Function ^Response [^Response r] r) executor)))
      (Log/logTrace "Response future (stream={0}) is: {1}" streamid cf)
      (let [^{:tag (PushGroup ?)} pg (.getPushGroup (.-exchange this))]
        (when (some? pg)
          (set! cf

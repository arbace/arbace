                        (when (.on debug)
                          (.log debug "trySend: sending: %d" (new Object/1 [(.getDataLength df)])))
                        (.sendDataFrame Stream/this df)))
                    (when-not (== state 0) (break))
                    (java-assert (not (.hasRemaining item)))
                    (let [b (cast ByteBuffer (.removeFirst outgoing))]
                      (java-assert (identical? b item))))

          (.resetStream connection streamid ResetFrame/PROTOCOL_ERROR)
          (throw (IOException. (java-str (.getConnectionFlow (.connection Stream/this))
                                         " stream="
                                         streamid
                                         " ["
                                         (.getName (Thread/currentThread))
                                         "] Too few bytes returned by the publisher ("
                                         written
                                         "/"
                                         contentLength
                                         ")"))))

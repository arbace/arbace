            (when (.on debug)
              (.log debug "responseReceived: streamid=%d" (new Object/1 [streamid])))
            (.close this))
        (.on debug)
          (.log debug
                "responseReceived: streamid=%d but request not sent"
                (new Object/1 [streamid])))
      (finally (.unlock stateLock))))


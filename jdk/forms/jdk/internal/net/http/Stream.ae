        (cond
          (some? dbg) dbg
          (== streamid 0)
            (java-str (.dbgString (.-connection this)) ":WindowUpdateSender(stream: ?)")
          :else
            (do
              (set! dbg
                    (java-str (.dbgString (.-connection this))
                              ":WindowUpdateSender(stream: "
                              streamid
                              ")"))
              (set! (.-dbgString this) dbg)))))

    (method ^:protected windowSizeExceeded ^boolean [this ^long received]
      (.onProtocolError Stream/this
                        (ProtocolException.
                          (.formatted "stream %s flow control window exceeded" streamid))
                        ResetFrame/FLOW_CONTROL_ERROR)
      true))

  (method isCanceled ^boolean [this] (some? (.get errorRef)))

  (method getCancelCause ^Throwable [this]
    (cast Throwable (.get errorRef)))

  (method ^:final dbgString ^String [this]
    (let [^:final id streamid
          ^:final ^String sid (if (== id 0) "?" (String/valueOf id))]
      (java-str (.dbgString connection) "/Stream(" sid ")")))

  (method closeAsUnprocessed ^void [this]
    (try
      (java-assert (some? (.-exchange this))
        "PUSH streams aren't expected to be closed as unprocessed")
      (.markUnprocessedByPeer (.-exchange this))
      (.compareAndSet (.-errorRef this) nil (IOException. "request not processed by peer"))
      (when (.on debug)
        (.log debug (java-str "closing " (.-request this) " as unprocessed by peer")))
      (.close this)
      (.completeResponseExceptionally this (cast Throwable (.get (.-errorRef this))))
      (finally (.decrementStreamsCount connection streamid))))

  (defclass ^:private ^:final HeadersConsumer
    :extends ValidatingHeadersConsumer
    :implements [DecodingCallback]

    (constructor ^:private [this]
      (super. ValidatingHeadersConsumer$Context/RESPONSE))

    (field ^boolean maxHeaderListSizeReached)

    (method ^:public reset ^void [this]
      (.reset super)
      (.clear responseHeadersBuilder)
      (.log debug "Response builder cleared, ready to receive new headers."))

    (method ^:public onDecoded :throws [UncheckedIOException] ^void [this ^CharSequence name
                                                                     ^CharSequence value]
      (when-not maxHeaderListSizeReached
        (try
          (let [n (.toString name)
                v (.toString value)]
            (.onDecoded super n v)
            (.addHeader responseHeadersBuilder n v)
            (when (and (Log/headers) (Log/trace))
              (Log/logTrace "RECEIVED HEADER (streamid={0}): {1}: {2}" streamid n v)))
          (catch UncheckedIOException uio (.onProtocolError Stream/this (.getCause uio))))))

    (method ^:protected formatMessage ^String [this ^String message ^String header]
      (java-str "malformed response: " (.formatMessage super message header)))

    (method ^:public onMaxHeaderListSizeReached :throws [ProtocolException] ^void [this ^long size
                                                                                   ^int maxHeaderListSize]
      (when-not maxHeaderListSizeReached
        (try
          (.onMaxHeaderListSizeReached DecodingCallback/super size maxHeaderListSize)
          (catch ProtocolException cause
            (set! maxHeaderListSizeReached true)
            (when-instance [^{:tag (PushedStream ?)} ps Stream/this]
              (.onProtocolError (.-parent ps) cause))
            (.onProtocolError Stream/this cause)
            (.reset this))))))

  (defclass ^:final Http2StreamResponseSubscriber
    :extends (HttpBodySubscriberWrapper U)
    :type-params [U]

    (field ^:private ^:final ^boolean cancelTimerOnTermination)

    (constructor [this ^{:tag (HttpResponse$BodySubscriber U)} subscriber
                  ^boolean cancelTimerOnTermination]
      (super. subscriber)
      (set! (.-cancelTimerOnTermination this) cancelTimerOnTermination))

    (method ^:protected register ^void [this]
      (.registerResponseSubscriber Stream/this this))

    (method ^:protected unregister ^void [this]
      (.unregisterResponseSubscriber Stream/this this))

    (method ^:protected onTermination ^void [this]
      (when cancelTimerOnTermination (.cancelTimer (.-multi (.-exchange Stream/this))))))

  (field ^:private ^:static ^:final ^VarHandle DEREGISTERED)

  (static-initializer
    (try
      (let [lookup (MethodHandles/lookup)]
        (set! DEREGISTERED (.findVarHandle lookup Stream "deRegistered" Boolean/TYPE)))
      (catch Exception x (throw (ExceptionInInitializerError. x))))))

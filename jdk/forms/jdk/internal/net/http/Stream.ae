          (set! endStreamSent true)
          (.sendDataFrame connection (.getEmptyEndStreamDataFrame Stream/this)))
        (.complete requestBodyCF nil))))

  (method ^:public ignoreBody ^{:tag (CompletableFuture Void)} [this]
    (try
      (.resetStream connection streamid ResetFrame/STREAM_CLOSED)
      (MinimalFuture/completedFuture nil)
      (catch Throwable e
        (Log/logTrace "Error resetting stream {0}" (.toString e))
        (MinimalFuture/failedFuture e))))

  (method getDataFrame ^DataFrame [this ^ByteBuffer buffer]
    (let [requestAmount (Math/min (.getMaxSendFrameSize connection) (.remaining buffer))
          actualAmount (.tryAcquire windowController requestAmount streamid this)]
      (when-not (<= actualAmount 0)
        (let [outBuf (Utils/sliceWithLimitedCapacity buffer actualAmount)
              df (DataFrame. streamid 0 outBuf)]
          df))))

  (method ^:private getEmptyEndStreamDataFrame ^DataFrame [this]
    (DataFrame. streamid DataFrame/END_STREAM (List/of)))

  (field ^:final ^{:tag (List (CompletableFuture Response))} response_cfs (ArrayList. 5))

  (field ^:final ^Lock response_cfs_lock (ReentrantLock.))

  (method getResponseAsync ^{:tag (CompletableFuture Response)} [this ^Executor executor]
    (let [^:mutable ^{:tag (CompletableFuture Response)} cf nil]
      (.lock response_cfs_lock)
      (try
        (if (not (.isEmpty response_cfs))
            (do
              (set! cf (cast CompletableFuture (.get response_cfs 0)))
              (when (.isDone cf)
                (set! cf (cast CompletableFuture (^[int] List/.remove response_cfs 0))))
              (java-assert (or (.isDone cf)
                               (and (.-expectContinue request) (.expectTimeoutRaised this)))
                "Removing uncompleted response: could cause code to hang!"))
            (do (set! cf (MinimalFuture.)) (.add response_cfs cf)))
        (finally (.unlock response_cfs_lock)))

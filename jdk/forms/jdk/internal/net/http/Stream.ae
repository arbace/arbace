            (if (some? t)
                (.completeExceptionally responseCF t)
                (let [^{:tag (HttpResponseImpl T)} resp (HttpResponseImpl.
                                                          (.-request r)
                                                          r
                                                          nil
                                                          body
                                                          (.getExchange this))]
                  (.complete responseCF resp)))))
        (.completeAsync start (lambda Supplier ^Void [] nil) (.executor (.getExchange this)))))

    (method completeResponseExceptionally ^void [this ^Throwable t]
      (.completeExceptionally pushCF t))

    (method ^:protected handleResponse ^void [this ^HeaderFrame hf]
      (let [responseHeaders (.build (.-responseHeadersBuilder this))]
        (if (not finalPushResponseCodeReceived)
            (do
              (set! (.-responseCode this)
                    (unchecked-int (.orElse (.firstValueAsLong responseHeaders ":status") -1)))
              (if (== (.-responseCode this) -1)
                  (do
                    (.cancelImpl this
                                 (ProtocolException. "No status code")
                                 ResetFrame/PROTOCOL_ERROR)
                    (.reset (.-rspHeadersConsumer this)))
                  (do
                    (when (and (>= (.-responseCode this) 100) (< (.-responseCode this) 200))
                      (let [protocolErrorMsg (.checkInterimResponseCountExceeded this)]
                        (when (some? protocolErrorMsg)
                          (.cancelImpl this
                                       (ProtocolException. protocolErrorMsg)
                                       ResetFrame/PROTOCOL_ERROR)
                          (.reset (.-rspHeadersConsumer this))
                          (return))))
                    (set! (.-finalPushResponseCodeReceived this) true)
                    (set! (.-response this)
                          (Response. pushReq
                                     (.-exchange this)
                                     responseHeaders
                                     (.connection this)
                                     (.-responseCode this)
                                     HttpClient$Version/HTTP_2))
                    (.firstValueAsLong responseHeaders "content-length")
                    (when (Log/headers)
                      (let [sb (StringBuilder.
                                 (.formatted "RESPONSE HEADERS (streamid=%s):\n" (.-streamid this)))]
                        (.append sb
                                 (.formatted "  %s %s %s\n"
                                             (.method (.-request this))
                                             (.uri (.-request this))
                                             (.-responseCode this)))
                        (Log/dumpHeaders sb "    " responseHeaders)
                        (Log/logHeaders (.toString sb))))
                    (.reset (.-rspHeadersConsumer this))
                    (.completeResponse this (.-response this)))))
            (do
              (when (Log/headers)
                (let [sb (StringBuilder.
                           (.formatted "TRAILING HEADERS (streamid=%s):\n" (.-streamid this)))]
                  (.append sb
                           (.formatted "  %s %s %s\n"
                                       (.method (.-request this))
                                       (.uri (.-request this))
                                       (.-responseCode this)))
                  (Log/dumpHeaders sb "    " responseHeaders)
                  (Log/logHeaders (.toString sb))))
              (.reset (.-rspHeadersConsumer this)))))))

  (defclass ^:final StreamWindowUpdateSender
    :extends WindowUpdateSender

    (constructor [this ^Http2Connection connection] (super. connection))

    (method getStreamId ^int [this] streamid)

    (method dbgString ^String [this]

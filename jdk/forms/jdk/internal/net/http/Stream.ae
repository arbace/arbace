  (defclass ^:static PushedStream
    :extends (Stream T)
    :type-params [T]

    (field ^:final ^{:tag (Stream T)} parent)

    (field ^:final ^{:tag (PushGroup T)} pushGroup)

    (field ^:final ^{:tag (CompletableFuture Response)} pushCF)

    (field ^{:tag (CompletableFuture (HttpResponse T))} responseCF)

    (field ^:final ^HttpRequestImpl pushReq)

    (field ^:volatile ^{:tag (HttpResponse$BodyHandler T)} pushHandler)

    (field ^:private ^:volatile ^boolean finalPushResponseCodeReceived)

    (constructor [this ^{:tag (Stream T)} parent ^{:tag (PushGroup T)} pushGroup
                  ^Http2Connection connection ^{:tag (Exchange T)} pushReq]

          (if (some? t)
              (do
                (.stop sendScheduler)
                (when-not (.isDone requestBodyCF)
                  (.cancel subscription)
                  (.completeExceptionally requestBodyCF t)
                  (.cancelImpl Stream/this t)))
              (let [^:mutable state streamState]
                (loop []
                  (let [item (cast ByteBuffer (.peekFirst outgoing))]
                    (if (nil? item)
                        (return)
                        (when (identical? item COMPLETED)
                          (.stop sendScheduler)
                          (.complete this)
                          (return)))
                    (while (and (.hasRemaining item) (== state 0))
                      (when (.on debug)
                        (.log debug "trySend: %d" (new Object/1 [(.remaining item)])))
                      (let [df (.getDataFrame Stream/this item)]
                        (when (nil? df)
                          (when (.on debug)
                            (.log debug
                                  "trySend: can't send yet: %d"
                                  (new Object/1 [(.remaining item)])))
                          (return))
                        (if (> contentLength 0)
                            (do
                              (set! remainingContentLength
                                    (unchecked-subtract remainingContentLength (.getDataLength df)))
                              (if (< remainingContentLength 0)
                                  (let [msg (java-str
                                              (.getConnectionFlow (.connection Stream/this))
                                              " stream="
                                              streamid
                                              " ["
                                              (.getName (Thread/currentThread))
                                              "] Too many bytes in request body. Expected: "
                                              contentLength
                                              ", got: "
                                              (unchecked-subtract
                                                contentLength
                                                remainingContentLength))]
                                    (java-assert (> streamid 0))
                                    (.resetStream connection streamid ResetFrame/PROTOCOL_ERROR)
                                    (throw (IOException. msg)))

        (when-instance [^{:tag (Http2StreamResponseSubscriber ?)} sw s]
          (when (.on debug)
            (.log debug "closing response subscriber stream %s" (new Object/1 [streamid])))
          (when-not (.completed sw)
            (let [cause (cast Throwable (.get errorRef))]
              (.complete sw
                         ^Throwable (if (nil? cause)
                                        ^Throwable (IOException. "stream closed")
                                        cause)))))

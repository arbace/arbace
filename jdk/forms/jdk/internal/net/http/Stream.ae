      (set! (.-parent this) parent)
      (set! (.-pushGroup this) pushGroup)
      (set! (.-pushReq this) (.request pushReq))
      (set! (.-pushCF this) (MinimalFuture.))
      (set! (.-responseCF this) (MinimalFuture.)))

    (method responseCF ^{:tag (CompletableFuture (HttpResponse T))} [this]
      responseCF)

    (method setPushHandler ^void [this ^{:tag (HttpResponse$BodyHandler T)} pushHandler]
      (set! (.-pushHandler this) pushHandler))

    (method getPushHandler ^{:tag (HttpResponse$BodyHandler T)} [this]
      (.-pushHandler this))

    (method sendBodyAsync ^{:tag (CompletableFuture (ExchangeImpl T))} [this]
      (.whenComplete (.sendBodyAsync super)
                     (lambda BiConsumer ^void [^ExchangeImpl v ^Throwable t]
                       (.pushError pushGroup (Utils/getCompletionCause t)))))

    (method sendHeadersAsync ^{:tag (CompletableFuture (ExchangeImpl T))} [this]
      (.whenComplete (.sendHeadersAsync super)
                     (lambda BiConsumer ^void [^ExchangeImpl ex ^Throwable t]
                       (.pushError pushGroup (Utils/getCompletionCause t)))))

    (method getResponseAsync ^{:tag (CompletableFuture Response)} [this ^Executor executor]
      (let [^:mutable ^{:tag (CompletableFuture Response)} cf (.whenComplete
                                                                pushCF
                                                                (lambda BiConsumer ^void [^Response v
                                                                                          ^Throwable t]
                                                                  (.pushError
                                                                    pushGroup
                                                                    (Utils/getCompletionCause t))))]
        (when (and (some? executor) (not (.isDone cf)))
          (set! cf (.thenApplyAsync cf (lambda Function ^Response [^Response r] r) executor)))
        cf))

    (method readBodyAsync ^{:tag (CompletableFuture T)} [this
                                                         ^{:tag (HttpResponse$BodyHandler T)} handler
                                                         ^boolean returnConnectionToPool
                                                         ^Executor executor]
      (.whenComplete (.readBodyAsync super handler returnConnectionToPool executor)
                     (lambda BiConsumer ^void [v ^Throwable t] (.pushError pushGroup t))))

    (method createResponseSubscriber ^{:tag (.. (Stream T) (Http2StreamResponseSubscriber T))} [this
                                                                                                ^{:tag (HttpResponse$BodyHandler T)} handler
                                                                                                ^HttpResponse$ResponseInfo response]
      (Http2StreamResponseSubscriber. (.apply handler response) false))

    (method completeResponse ^void [this ^Response r]
      (Log/logResponse (method-ref Supplier ^String [] r Response/.toString))
      (.complete pushCF r)
      (let [^{:tag (CompletableFuture Void)} start (MinimalFuture.)]
        (.whenComplete
          (.thenCompose start
                        (lambda Function ^CompletionStage [^Void v]
                          (.readBodyAsync this
                                          (.getPushHandler this)
                                          false
                                          (.executor (.getExchange this)))))

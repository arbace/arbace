  (method ^:private headerFrame ^{:tag (OutgoingHeaders (Stream T))} [this ^long contentLength]
    (let [h (.getSystemHeadersBuilder request)]
      (when (> contentLength 0) (.setHeader h "content-length" (Long/toString contentLength)))

      (.runOrSchedule (.-sendScheduler subscriber))))

  (field ^:static ^:final ^ByteBuffer COMPLETED (ByteBuffer/allocate 0))

  (defclass RequestSubscriber
    :implements [(Flow$Subscriber ByteBuffer)]

    (field ^:private ^:final ^long contentLength)

    (field ^:private ^:volatile ^long remainingContentLength)

    (field ^:private ^:volatile ^Flow$Subscription subscription)

    (field ^:final ^{:tag (ConcurrentLinkedDeque ByteBuffer)} outgoing (ConcurrentLinkedDeque.))

    (field ^:private ^:final ^{:tag (AtomicReference Throwable)} errorRef (AtomicReference.))

    (field ^:final ^SequentialScheduler sendScheduler)

    (constructor [this ^long contentLen]

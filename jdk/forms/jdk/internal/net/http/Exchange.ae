                              (MinimalFuture/completedFuture r1))))))))))))

  (method ^:private sendRequestBody ^{:tag (CompletableFuture Response)} [this
                                                                          ^{:tag (ExchangeImpl T)} ex]
    (java-assert (not (.expectContinue request)))
    (when (.on debug) (.log debug "sendRequestBody"))
    (let [^:mutable ^{:tag (CompletableFuture Response)} cf (.startSendingBody this parentExecutor)]

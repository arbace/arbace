      (set! cf (.wrapForLog this cf))
      cf))

  (method ^:private ignore1xxResponse ^{:tag (CompletableFuture Response)} [this
                                                                            ^:final ^Response rsp]
    (let [statusCode (.statusCode rsp)]
      (if (or (and (>= statusCode 102) (<= statusCode 199))
              (and (== statusCode 100) (not (.-expectContinue request))))
          (do
            (Log/logTrace "Ignoring (1xx informational) response code {0}" (.statusCode rsp))
            (when (.on debug)
              (.log debug
                    (java-str "Ignoring (1xx informational) response code " (.statusCode rsp))))
            (java-assert (some? exchImpl) "Illegal state - current exchange isn't set")
            (let [count (.incrementAndGet nonFinalResponses)]
              (if (and (> MAX_NON_FINAL_RESPONSES 0)
                       (or (< count 0) (> count MAX_NON_FINAL_RESPONSES)))
                  (MinimalFuture/failedFuture
                    (ProtocolException.
                      (String/format "Too many interim responses received: %s > %s"
                                     (new Object/1 [count MAX_NON_FINAL_RESPONSES]))))

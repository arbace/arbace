  (method ^:private expectContinue ^{:tag (CompletableFuture Response)} [this
                                                                         ^{:tag (ExchangeImpl T)} ex]
    (java-assert (.expectContinue request))
    (let [^:mutable responseTimeoutMillis 5000]
      (when (.isPresent (.timeout request))
        (let [timeoutMillis (.toMillis (cast Duration (.get (.timeout request))))]
          (set! responseTimeoutMillis (Math/min responseTimeoutMillis timeoutMillis))))
      (.thenCompose
        (.completeOnTimeout (.getResponseAsync ex parentExecutor)

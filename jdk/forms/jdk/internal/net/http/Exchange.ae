                                                                  exchImpl
                                                                  parentExecutor)]
                    (.thenCompose cf
                                  (method-ref Function
                                              ^CompletionStage [Response]
                                              this
                                              Exchange/.ignore1xxResponse))))))
          (MinimalFuture/completedFuture rsp))))

  (method responseAsyncImpl ^{:tag (CompletableFuture Response)} [this ^HttpConnection connection]

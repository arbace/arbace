                  (set! cf (.wrapForLog this cf))
                  cf))
              (do
                (Log/logResponse (method-ref Supplier ^String [] r1 Response/.toString))
                (let [rcode (.statusCode r1)]
                  (if (== rcode 100)
                      (do
                        (.incrementAndGet nonFinalResponses)
                        (Log/logTrace "Received 100-Continue: sending body")
                        (when (.on debug)
                          (.log debug "Received 100-Continue for %s" (new Object/1 [r1])))
                        (let [^:mutable ^{:tag (CompletableFuture Response)} cf (.startSendingBody
                                                                                  this
                                                                                  parentExecutor)]
                          (set! cf (.wrapForUpgrade this cf))
                          (set! cf (.wrapForLog this cf))
                          cf))
                      (do
                        (Log/logTrace "Expectation failed: Received {0}" rcode)
                        (when (.on debug)
                          (.log debug
                                "Expect-Continue failed (%d) for: %s"
                                (new Object/1 [rcode r1])))

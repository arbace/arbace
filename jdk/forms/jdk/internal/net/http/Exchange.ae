  (method ^:private checkForUpgradeAsync ^{:tag (CompletableFuture Response)} [this ^Response resp
                                                                               ^{:tag (ExchangeImpl T)} ex]
    (let [rcode (.statusCode resp)]
      (if (and upgrading (== rcode 101))
          (let [^{:tag (Http1Exchange T)} e (cast Http1Exchange ex)]
            (when (.on debug) (.log debug "Upgrading async %s" (new Object/1 [(.connection e)])))
            (.thenCompose (.readBodyAsync e
                                          (method-ref
                                            HttpResponse$BodyHandler
                                            this
                                            Exchange/.ignoreBody)
                                          false
                                          parentExecutor)
                          (lambda Function ^CompletionStage [v]
                            (.log debug "Ignored body")
                            (.upgraded ex)
                            (set! upgraded true)
                            (.thenCompose
                              (Http2Connection/createAsync
                                (.connection e)
                                (.client2 client)
                                this
                                (method-ref Supplier
                                            ^ByteBuffer []
                                            e
                                            Http1Exchange/.drainLeftOverBytes))
                              (lambda Function ^CompletionStage [^Http2Connection c]
                                (let [connection (.disable connectionAborter)
                                      cached (.offerConnection c)]
                                  (when (and (not cached) (some? connection))
                                    (.connection connectionAborter connection))
                                  (let [^{:tag (Stream T)} s (.getInitialStream c)]
                                    (if (nil? s)
                                        (let [tc (.getTerminationCause c)
                                              ^IOException ioe (if (some? tc)
                                                                   (IOException.
                                                                     "Can't get stream 1"
                                                                     (.getCloseCause tc))
                                                                   (IOException.
                                                                     "Can't get stream 1"))]
                                          (MinimalFuture/failedFuture ioe))
                                        (do
                                          (.released exchImpl)
                                          (let [^:mutable ^Throwable t nil]
                                            (locking this
                                              (set! exchImpl s)
                                              (set! t (cast Throwable (.get failed))))
                                            (when (nil? t) (set! t (.getCancelCause e)))
                                            (if (or
                                                  (instance? HttpTimeoutException t)
                                                  (.requestCancelled multi))
                                                (do
                                                  (when (nil? t)
                                                    (set! t (IOException. "Request cancelled")))
                                                  (.cancelImpl s t)
                                                  (MinimalFuture/failedFuture t))
                                                (do
                                                  (when (.on debug)
                                                    (.log
                                                      debug
                                                      "Getting response async %s"
                                                      (new Object/1 [s])))
                                                  (.getResponseAsync s nil)))))))))))))
          (MinimalFuture/completedFuture resp))))


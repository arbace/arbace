  (method ^:private wrapForUpgrade ^{:tag (CompletableFuture Response)} [this
                                                                         ^{:tag (CompletableFuture Response)} cf]
    (cond
      upgrading
        (.thenCompose cf
                      (lambda Function ^CompletionStage [^Response r]
                        (.checkForUpgradeAsync this r exchImpl)))
      (.isWebSocket request) cf
      :else
        (.thenCompose cf
                      (lambda Function ^CompletionStage [^Response r]
                        (if (== (.-statusCode r) 101)
                            (let [protoEx (ProtocolException.
                                            "Unexpected 101 response, when not upgrading")]
                              (java-assert (some? exchImpl)
                                "Illegal state - current exchange isn't set")
                              (try (.onProtocolError exchImpl protoEx) (catch Throwable ignore))
                              (MinimalFuture/failedFuture protoEx))
                            (MinimalFuture/completedFuture r))))))


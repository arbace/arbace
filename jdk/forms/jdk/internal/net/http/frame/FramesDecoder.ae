      DataFrame/TYPE (.parseDataFrame this frameLength frameStreamid frameFlags)
      HeadersFrame/TYPE (.parseHeadersFrame this frameLength frameStreamid frameFlags)
      PriorityFrame/TYPE (.parsePriorityFrame this frameLength frameStreamid frameFlags)
      ResetFrame/TYPE (.parseResetFrame this frameLength frameStreamid frameFlags)
      SettingsFrame/TYPE (.parseSettingsFrame this frameLength frameStreamid frameFlags)
      PushPromiseFrame/TYPE (.parsePushPromiseFrame this frameLength frameStreamid frameFlags)
      PingFrame/TYPE (.parsePingFrame this frameLength frameStreamid frameFlags)

        (.skipBytes this frameLength)
        nil)))

  (method ^:private parseDataFrame ^Http2Frame [this ^:mutable ^int frameLength ^int streamid
                                                ^int flags]
    (if (== streamid 0)
        (MalformedFrame. ErrorFrame/PROTOCOL_ERROR "zero streamId for DataFrame")
        (let [^:mutable ^int padLength 0]
          (when-not (== (bit-and-int flags DataFrame/PADDED) 0)
            (set! padLength (.getByte this))
            (when (>= padLength frameLength)
              (return (MalformedFrame.
                        ErrorFrame/PROTOCOL_ERROR
                        "the length of the padding is the length of the frame payload or greater")))
            (set! frameLength (unchecked-dec-int frameLength)))
          (let [df (DataFrame. streamid
                               flags
                               (.getBuffers this
                                            true
                                            (unchecked-subtract-int frameLength padLength))
                               padLength)]
            (.skipBytes this padLength)
            df))))

  (method ^:private parseHeadersFrame ^Http2Frame [this ^:mutable ^int frameLength ^int streamid
                                                   ^int flags]
    (if (== streamid 0)
        (MalformedFrame. ErrorFrame/PROTOCOL_ERROR "zero streamId for HeadersFrame")
        (let [^:mutable ^int padLength 0]
          (when-not (== (bit-and-int flags HeadersFrame/PADDED) 0)
            (set! padLength (.getByte this))
            (set! frameLength (unchecked-dec-int frameLength)))
          (let [hasPriority (not (== (bit-and-int flags HeadersFrame/PRIORITY) 0))
                ^:mutable exclusive false
                ^:mutable ^int streamDependency 0
                ^:mutable ^int weight 0]
            (when hasPriority
              (let [x (.getInt this)]
                (set! exclusive (not (== (bit-and-int x (unchecked-int 0x80000000)) 0)))
                (set! streamDependency (bit-and-int x 0x7fffffff))
                (set! weight (.getByte this))
                (set! frameLength (unchecked-subtract-int frameLength 5))))
            (if (< frameLength padLength)
                (MalformedFrame. ErrorFrame/PROTOCOL_ERROR
                                 "Padding exceeds the size remaining for the header block")
                (let [hf (HeadersFrame. streamid
                                        flags
                                        (.getBuffers
                                          this
                                          false
                                          (unchecked-subtract-int frameLength padLength))
                                        padLength)]
                  (.skipBytes this padLength)
                  (when hasPriority (.setPriority hf streamDependency exclusive weight))
                  hf))))))

  (method ^:private parsePriorityFrame ^Http2Frame [this ^int frameLength ^int streamid ^int flags]
    (cond
      (== streamid 0) (MalformedFrame. ErrorFrame/PROTOCOL_ERROR "zero streamId for PriorityFrame")
      (not (== frameLength 5))
        (do
          (.skipBytes this frameLength)
          (MalformedFrame. ErrorFrame/FRAME_SIZE_ERROR
                           streamid
                           (java-str "PriorityFrame length is " frameLength ", expected 5")))
      :else
        (let [x (.getInt this)
              weight (.getByte this)]
          (PriorityFrame. streamid
                          (bit-and-int x 0x7fffffff)
                          (not (== (bit-and-int x (unchecked-int 0x80000000)) 0))
                          weight))))

  (method ^:private parseResetFrame ^Http2Frame [this ^int frameLength ^int streamid ^int flags]
    (cond
      (== streamid 0) (MalformedFrame. ErrorFrame/PROTOCOL_ERROR "zero streamId for ResetFrame")
      (not (== frameLength 4))
        (MalformedFrame. ErrorFrame/FRAME_SIZE_ERROR
                         (java-str "ResetFrame length is " frameLength ", expected 4"))
      :else (ResetFrame. streamid (.getInt this))))

  (method ^:private parseSettingsFrame ^Http2Frame [this ^int frameLength ^int streamid ^int flags]
    (cond
      (not (== streamid 0))
        (MalformedFrame. ErrorFrame/PROTOCOL_ERROR "non-zero streamId for SettingsFrame")
      (and (not (== (bit-and-int SettingsFrame/ACK flags) 0)) (> frameLength 0))
        (MalformedFrame. ErrorFrame/FRAME_SIZE_ERROR "ACK SettingsFrame is not empty")
      (not (== (unchecked-remainder-int frameLength 6) 0))
        (MalformedFrame. ErrorFrame/FRAME_SIZE_ERROR
                         (java-str "invalid SettingsFrame size: " frameLength))
      :else
        (let [sf (SettingsFrame. flags)
              n (unchecked-divide-int frameLength 6)]
          (loop [^int i 0]
            (when (< i n)
              (let [id (.getShort this)
                    val (.getInt this)]
                (if (and (> id 0) (<= id SettingsFrame/MAX_PARAM))
                    (do
                      (when (and (== id SettingsFrame/INITIAL_WINDOW_SIZE) (< val 0))
                        (return (MalformedFrame.
                                  ErrorFrame/FLOW_CONTROL_ERROR
                                  (java-str "SettingsFrame with INITIAL_WINDOW_SIZE > 2^31 -1: "
                                            (bit-and val 0xffffffff)))))
                      (when (and (== id SettingsFrame/MAX_FRAME_SIZE)
                                 (or (< val 16384) (> val 16777215)))
                        (return (MalformedFrame.
                                  ErrorFrame/PROTOCOL_ERROR
                                  (java-str "SettingsFrame with MAX_FRAME_SIZE out of range: "
                                            (bit-and val 0xffffffff)))))
                      (.setParameter sf id val)
                      (recur (unchecked-inc-int i)))
                    (recur (unchecked-inc-int i))))))
          sf)))

  (method ^:private parsePushPromiseFrame ^Http2Frame [this ^:mutable ^int frameLength ^int streamid
                                                       ^int flags]
    (if (== streamid 0)
        (MalformedFrame. ErrorFrame/PROTOCOL_ERROR "zero streamId for PushPromiseFrame")
        (let [^:mutable ^int padLength 0]
          (when-not (== (bit-and-int flags PushPromiseFrame/PADDED) 0)
            (set! padLength (.getByte this))
            (set! frameLength (unchecked-dec-int frameLength)))
          (let [promisedStream (bit-and-int (.getInt this) 0x7fffffff)]
            (set! frameLength (unchecked-subtract-int frameLength 4))
            (if (< frameLength padLength)
                (MalformedFrame. ErrorFrame/PROTOCOL_ERROR
                                 "Padding exceeds the size remaining for the PushPromiseFrame")
                (let [ppf (PushPromiseFrame. streamid
                                             flags
                                             promisedStream
                                             (.getBuffers
                                               this
                                               false
                                               (unchecked-subtract-int frameLength padLength))
                                             padLength)]
                  (.skipBytes this padLength)
                  ppf))))))

  (method ^:private parsePingFrame ^Http2Frame [this ^int frameLength ^int streamid ^int flags]
    (cond
      (not (== streamid 0))
        (MalformedFrame. ErrorFrame/PROTOCOL_ERROR "non-zero streamId for PingFrame")
      (not (== frameLength 8))
        (MalformedFrame. ErrorFrame/FRAME_SIZE_ERROR
                         (java-str "PingFrame length is " frameLength ", expected 8"))
      :else (PingFrame. flags (.getBytes this 8))))

  (method ^:private parseGoAwayFrame ^Http2Frame [this ^int frameLength ^int streamid ^int flags]
    (cond
      (not (== streamid 0))
        (MalformedFrame. ErrorFrame/PROTOCOL_ERROR "non-zero streamId for GoAwayFrame")
      (< frameLength 8) (MalformedFrame. ErrorFrame/FRAME_SIZE_ERROR "Invalid GoAway frame size")
      :else
        (let [lastStream (bit-and-int (.getInt this) 0x7fffffff)
              errorCode (.getInt this)
              debugData (.getBytes this (unchecked-subtract-int frameLength 8))]
          (when (> (alength debugData) 0)
            (Log/logError (java-str "GoAway debugData " (String. debugData StandardCharsets/UTF_8))
                          (new Object/1 [])))
          (GoAwayFrame. lastStream errorCode debugData))))

  (method ^:private parseWindowUpdateFrame ^Http2Frame [this ^int frameLength ^int streamid
                                                        ^int flags]
    (if (not (== frameLength 4))
        (MalformedFrame. ErrorFrame/FRAME_SIZE_ERROR
                         (java-str "WindowUpdateFrame length is " frameLength ", expected 4"))
        (let [update (.getInt this)]
          (if (< update 0)
              (MalformedFrame. ErrorFrame/FLOW_CONTROL_ERROR
                               (java-str "WindowUpdateFrame with value > 2^31 -1 "
                                         (bit-and update 0xffffffff)))
              (WindowUpdateFrame. streamid (bit-and-int update 0x7fffffff))))))

  (method ^:private parseContinuationFrame ^Http2Frame [this ^int frameLength ^int streamid
                                                        ^int flags]
    (if (== streamid 0)
        (MalformedFrame. ErrorFrame/PROTOCOL_ERROR "zero streamId for ContinuationFrame")
        (ContinuationFrame. streamid flags (.getBuffers this false frameLength))))

  (method ^:private parseAltSvcFrame ^Http2Frame [this ^int frameLength ^int frameStreamid
                                                  ^int frameFlags]
    (let [len (.getShort this)
          ^:mutable ^byte/1 origin nil
          ^:mutable ^{:tag (Optional String)} originUri (Optional/empty)]
      (when (> len 0)
        (set! origin (.getBytes this len))
        (when-not (FramesDecoder/isUSAscii origin)
          (return (MalformedFrame. ErrorFrame/PROTOCOL_ERROR
                                   frameStreamid
                                   "illegal character in AltSvcFrame")))
        (set! originUri (Optional/of (String. origin StandardCharsets/US_ASCII))))
      (let [altbytes (.getBytes this
                                (unchecked-subtract-int (unchecked-subtract-int frameLength 2) len))]
        (if (not (FramesDecoder/isUSAscii altbytes))
            (MalformedFrame. ErrorFrame/PROTOCOL_ERROR
                             frameStreamid
                             "illegal character in AltSvcFrame")
            (let [altSvc (String. altbytes StandardCharsets/US_ASCII)]
              (AltSvcFrame. frameStreamid 0 originUri altSvc))))))

  (method ^:static isUSAscii ^boolean [^byte/1 bytes]
    (loop [^int i 0]
      (if (< i (alength bytes))
          (if (< (aget bytes i) 0) (return false) (recur (unchecked-inc-int i)))
          nil))
    true))

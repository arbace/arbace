            (let [idx (unchecked-int (unsigned-bit-shift-right buffer 56))
                  node (.getChild curr idx)]
              (when (nil? node) (throw (IOException. "Unexpected byte")))
              (if (.isLeaf node)
                  (do
                    (when (> (.getLength node) bufferLen)
                      (throw (IOException. "Not a EOS prefix padding or unexpected end of data")))
                    (when (.isEOSPath node) (throw (IOException. "Encountered EOS")))
                    (.append destination (.getSymbol node))
                    (set! curr root)
                    (set! len 0))
                  (do
                    (set! curr node)
                    (set! len (unchecked-add-int len (Math/min bufferLen (.getLength node))))))
              (set! buffer (bit-shift-left buffer (.getLength node)))
              (set! bufferLen (unchecked-subtract-int bufferLen (.getLength node)))))
          (when (and done (and (.isEOSPath curr) (> len 7)))
            (throw (IOException. (java-str "Padding is too long (len="
                                           len
                                           ") or unexpected end of data")))))))

    (method ^:public reset ^void [this]
      (set! curr root)
      (set! len 0)
      (set! buffer 0)
      (set! bufferLen 0)
      (set! done false)))

  (defclass ^:public ^:static ^:final Writer
    :implements [Huffman$Writer]

    (field ^:private ^:final ^HPACK$BufferUpdateConsumer UPDATER
      (lambda HPACK$BufferUpdateConsumer ^void [^long buf ^int bufLen]
        (set! buffer buf)
        (set! bufferLen bufLen)))

    (field ^:private ^CharSequence source)

    (field ^:private ^boolean padded)

    (field ^:private ^int pos)

    (field ^:private ^int end)

    (field ^:private ^long buffer)

    (field ^:private ^int bufferLen)

    (method ^:public from ^Writer [this ^CharSequence input ^int start ^int end]
      (Objects/checkFromToIndex start end (.length input))
      (set! (.-pos this) start)
      (set! (.-end this) end)
      (set! (.-source this) input)
      this)

    (method ^:public write ^boolean [this ^ByteBuffer destination]
      (while true
        (while true
          (when (>= pos end) (break))
          (let [c (.charAt source pos)]
            (when (> c 255) (throw (IllegalArgumentException. (java-str "char=" (int c)))))
            (let [len (QuickHuffman/codeLengthOf c)]
              (if (<= (unchecked-add-int bufferLen len) 64)
                  (do
                    (set!
                      buffer
                      (bit-or buffer
                              (unsigned-bit-shift-right (QuickHuffman/codeValueOf c) bufferLen)))
                    (set! bufferLen (unchecked-add-int bufferLen len))
                    (set! pos (unchecked-inc-int pos)))
                  (break)))))
        (when (== bufferLen 0) (return true))
        (when (and (>= pos end) (not padded))
          (set! padded true)
          (when-not (== bufferLen 64)
            (set! buffer (bit-or buffer (unsigned-bit-shift-right EOS_MSB bufferLen)))
            (set! bufferLen (bit-shift-left-int (HPACK/bytesForBits bufferLen) 3))))
        (let [nBytes (HPACK/write buffer bufferLen UPDATER destination)]
          (when (== nBytes 0) (return false)))))

    (method ^:public reset ^Writer [this]
      (set! source nil)
      (set! buffer 0)
      (set! bufferLen 0)
      (set! end 0)
      (set! pos 0)
      (set! padded false)
      this)

    (method ^:public lengthOf ^int [this ^CharSequence value ^int start ^int end]
      (QuickHuffman/lengthOf value start end)))

  (method ^:public ^:static lengthOf ^int [^CharSequence value ^int start ^int end]
    (let [^:mutable ^int len 0]
      (loop [^int i start]
        (when (< i end)
          (let [c (.charAt value i)]
            (set! len (unchecked-add-int len (QuickHuffman/codeLengthOf c)))
            (recur (unchecked-inc-int i)))))
      (HPACK/bytesForBits len)))

  (method ^:public ^:static lengthOf ^int [^CharSequence value]
    (QuickHuffman/lengthOf value 0 (.length value)))

  (method ^:public ^:static isHuffmanBetterFor ^boolean [^CharSequence input]
    (< (QuickHuffman/lengthOf input) (.length input))))

    (method ^:private signed ^float [this ^float v]
      (if isNegative (unchecked-negate-float v) v))

    (field ^:private ^:static ^:final ^{Stable true} ^double/1 SMALL_10_POW
      (new double/1
           [1.0 10.0 100.0 1000.0 10000.0 100000.0 1000000.0 1.0E7 1.0E8 1.0E9 1.0E10 1.0E11 1.0E12
            1.0E13 1.0E14 1.0E15 1.0E16 1.0E17 1.0E18 1.0E19 1.0E20 1.0E21 1.0E22]))

    (field ^:private ^:static ^:final ^{Stable true} ^float/1 SINGLE_SMALL_10_POW
      (new float/1
           [(float 1.0)
            (float 10.0)
            (float 100.0)
            (float 1000.0)
            (float 10000.0)
            (float 100000.0)
            (float 1000000.0)
            (float 1.0E7)
            (float 1.0E8)
            (float 1.0E9)
            (float 1.0E10)]))

    (field ^:private ^:static ^:final ^int MAX_SMALL_TEN
      (unchecked-subtract-int (alength SMALL_10_POW) 1))

    (field ^:private ^:static ^:final ^int SINGLE_MAX_SMALL_TEN
      (unchecked-subtract-int (alength SINGLE_SMALL_10_POW) 1)))

  (method ^:public ^:static getBinaryToASCIIConverter ^BinaryToASCIIBuffer [^double d
                                                                            ^boolean compat]
    (if compat
        (FloatingDecimal/getCompatBinaryToASCIIConverter d)
        (FloatingDecimal/getBinaryToASCIIConverter d)))

  (method ^:private ^:static getBinaryToASCIIConverter ^BinaryToASCIIBuffer [^double d]
    (java-assert (Double/isFinite d))
    (let [dec (FormattedFPDecimal/split d)
          buf (FloatingDecimal/getBinaryToASCIIBuffer)]
      (set! (.-nDigits buf) (.getPrecision dec))
      (set! (.-decExponent buf) (unchecked-add-int (.getExp dec) (.-nDigits buf)))
      (set! (.-firstDigitIndex buf) 0)
      (set! (.-exactDecimalConversion buf) (.getExact dec))
      (set! (.-decimalDigitsRoundedUp buf) (.getAway dec))
      (let [^:mutable f (.getSignificand dec)
            digits (.-digits buf)]
        (loop [^int i (unchecked-subtract-int (.-nDigits buf) 1)]
          (when (>= i 0)
            (let [q (unchecked-divide f 10)]
              (aset digits
                    i
                    (unchecked-byte
                      (unchecked-add (unchecked-subtract f (unchecked-multiply 10 q)) \0)))
              (set! f q)
              (recur (unchecked-dec-int i)))))
        buf)))

  (method ^:private ^:static getCompatBinaryToASCIIConverter ^BinaryToASCIIBuffer [^double d]
    (let [dBits (Double/doubleToRawLongBits d)
          isNegative (not (== (bit-and dBits DoubleConsts/SIGN_BIT_MASK) 0))
          ^:mutable fractBits (bit-and dBits DoubleConsts/SIGNIF_BIT_MASK)
          ^:mutable binExp (unchecked-int
                             (bit-shift-right (bit-and dBits DoubleConsts/EXP_BIT_MASK) EXP_SHIFT))]
      (when (== binExp (unchecked-int (bit-shift-right DoubleConsts/EXP_BIT_MASK EXP_SHIFT)))
        (if (== fractBits 0)
            (throw (IllegalArgumentException. (java-str (if isNegative "-" "") INFINITY_REP)))
            (throw (IllegalArgumentException. NAN_REP))))
      (let [^:mutable ^int nSignificantBits 0]
        (if (== binExp 0)
            (do
              (when (== fractBits 0) (return (if isNegative B2AC_NEGATIVE_ZERO B2AC_POSITIVE_ZERO)))
              (let [leadingZeros (Long/numberOfLeadingZeros fractBits)
                    shift (unchecked-subtract-int
                            leadingZeros
                            (unchecked-subtract-int 63 EXP_SHIFT))]
                (set! fractBits (bit-shift-left fractBits shift))
                (set! binExp (unchecked-subtract-int 1 shift))
                (set! nSignificantBits (unchecked-subtract-int 64 leadingZeros))))
            (do
              (set! fractBits (bit-or fractBits FRACT_HOB))
              (set! nSignificantBits (unchecked-add-int EXP_SHIFT 1))))
        (set! binExp (unchecked-subtract-int binExp DoubleConsts/EXP_BIAS))
        (let [buf (FloatingDecimal/getBinaryToASCIIBuffer)]
          (.dtoa buf binExp fractBits nSignificantBits)
          buf))))

  (method ^:private ^:static readJavaFormatString ^double [^String in ^int ix]
    (let [len (.length in)
          ^:mutable i (FloatingDecimal/skipWhitespaces in 0)]
      (when (== i len) (throw (NumberFormatException. "empty String")))
      (let [^:mutable ^int ch 0
            ^:mutable ^int ssign \space]
        (when (or (== (set! ch (.charAt in i)) \-) (== ch \+))
          (set! ssign ch)
          (set! i (unchecked-inc-int i)))
        (let [^:mutable isDec true]
          (when (< i len)
            (set! ch (.charAt in i))
            (when (== ch \I)
              (FloatingDecimal/scanSymbolic in i INFINITY_REP)
              (return (if (not (== ssign \-)) Double/POSITIVE_INFINITY Double/NEGATIVE_INFINITY)))
            (when (== ch \N) (FloatingDecimal/scanSymbolic in i NAN_REP) (return Double/NaN))
            (when (and (and (== ch \0) (< (unchecked-add-int i 1) len))
                       (== (FloatingDecimal/toLowerCase (.charAt in (unchecked-add-int i 1))) \x))
              (set! isDec false)
              (set! i (unchecked-add-int i 2))))
          (let [^:mutable ^int pt 0
                start i]
            (while (and (< i len) (or (== (set! ch (.charAt in i)) \0) (== ch \.)))
              (set! i (unchecked-inc-int i))
              (when (== ch \.) (set! pt (FloatingDecimal/checkMultiplePoints pt i))))
            (let [lz i
                  ^:mutable ^int tnz 0]
              (while (and (< i len)
                          (or (FloatingDecimal/isDigit (set! ch (.charAt in i)) isDec) (== ch \.)))
                (set! i (unchecked-inc-int i))
                (if (== ch \.)
                    (set! pt (FloatingDecimal/checkMultiplePoints pt i))
                    (when-not (== ch \0) (set! tnz i))))
              (FloatingDecimal/check in
                                     (> (unchecked-subtract-int i start) (if (not (== pt 0)) 1 0)))
              (let [stop i
                    ^:mutable ep 0
                    ^:mutable hasExp false]
                (when (and (< i len)
                           (or (and (== (set! ch (FloatingDecimal/toLowerCase (.charAt in i))) \e)
                                    isDec)
                               (and (== ch \p) (not isDec))))
                  (set! i (unchecked-inc-int i))
                  (let [^:mutable ^int esign \space]
                    (when (and (< i len) (or (== (set! ch (.charAt in i)) \-) (== ch \+)))
                      (set! esign ch)
                      (set! i (unchecked-inc-int i)))
                    (while (and (< i len) (FloatingDecimal/isDigit (set! ch (.charAt in i)) true))
                      (set! i (unchecked-inc-int i))
                      (set! ep (FloatingDecimal/appendDecDigit ep ch)))
                    (FloatingDecimal/check in
                                           (or (>= (unchecked-subtract-int i stop) 3)
                                               (and
                                                 (== (unchecked-subtract-int i stop) 2)
                                                 (== esign \space))))
                    (when (== esign \-) (set! ep (unchecked-negate ep)))
                    (set! hasExp true)))
                (FloatingDecimal/check in (or isDec hasExp))
                (when (and (< i len)
                           (or (== (set! ch (FloatingDecimal/toLowerCase (.charAt in i))) \f)
                               (== ch \d)))
                  (set! i (unchecked-inc-int i)))
                (FloatingDecimal/check in (== (FloatingDecimal/skipWhitespaces in i) len))
                (if (== tnz 0)
                    (if (not (== ssign \-)) 0.0 (unchecked-negate 0.0))
                    (let [emult (if isDec 1 4)
                          ^:mutable n (unchecked-subtract-int tnz lz)]
                      (if (== pt 0)
                          (set! ep
                                (unchecked-add ep
                                               (unchecked-multiply
                                                 emult
                                                 (unchecked-subtract-int stop tnz))))
                          (do
                            (set! ep
                                  (unchecked-add
                                    ep
                                    (unchecked-multiply emult (unchecked-subtract-int pt tnz))))
                            (cond
                              (> pt tnz) (set! ep (unchecked-subtract ep emult))
                              (< lz pt) (set! n (unchecked-subtract-int n 1)))))
                      (if (not isDec)
                          (let [^:mutable ^int j 0]
                            (set! i lz)
                            (let [^:mutable c 0
                                  le (Math/min n (aget HEX_COUNT ix))]
                              (while (< j le)
                                (when-not (== (set!
                                                ch
                                                (.charAt
                                                  in
                                                  (let [old-1 i]
                                                    (set! i (unchecked-inc-int i))
                                                    old-1)))
                                              \.)
                                  (set! j (unchecked-inc-int j))
                                  (set! c
                                        (bit-or (bit-shift-left c 4) (FloatingDecimal/digitFor ch)))))
                              (when (> n le)
                                (set! c (bit-or c 2r1))
                                (set! ep
                                      (unchecked-add
                                        ep
                                        (unchecked-multiply 4 (unchecked-subtract-int n le)))))

  (method ^:private ^:static copyDigits ^void [^String in ^byte/1 d ^int len ^:mutable ^int i]
    (let [^:mutable ^int ch 0
          ^:mutable ^int j 0]
      (while (< j len)
        (when-not (== (set! ch (.charAt in (let [old-2 i] (set! i (unchecked-inc-int i)) old-2)))
                      \.)
          (aset d j (unchecked-byte ch))
          (set! j (unchecked-inc-int j))))))

  (method ^:private ^:static appendDecDigit ^long [^long v ^int ch]
    (if (< v (unchecked-divide 10000000000 10))
        (unchecked-add (unchecked-multiply 10 v) (unchecked-subtract-int ch \0))
        10000000000))

  (method ^:private ^:static isDigit ^boolean [^int ch ^boolean isDec]
    (let [^:mutable ^int lch 0]
      (or (and (<= \0 ch) (<= ch \9))
          (and (and (not isDec) (<= \a (set! lch (FloatingDecimal/toLowerCase ch)))) (<= lch \f)))))

  (method ^:private ^:static digitFor ^int [^int ch]
    (if (<= ch \9)
        (unchecked-subtract-int ch \0)
        (unchecked-subtract-int (FloatingDecimal/toLowerCase ch) (unchecked-subtract-int \a 10))))

  (method ^:private ^:static skipWhitespaces ^int [^String in ^:mutable ^int i]
    (let [len (.length in)]
      (while (and (< i len) (<= (.charAt in i) \space)) (set! i (unchecked-inc-int i)))
      i))

  (method ^:private ^:static scanSymbolic ^void [^String in ^int i ^String sub]
    (let [high (unchecked-add-int i (.length sub))]
      (FloatingDecimal/check in
                             (and (and (and (<= i high) (<= high (.length in)))
                                       (== (.indexOf in sub i high) i))
                                  (== (FloatingDecimal/skipWhitespaces in high) (.length in))))))

  (method ^:private ^:static checkMultiplePoints ^int [^int pt ^int i]
    (when-not (== pt 0) (throw (NumberFormatException. "multiple points")))
    i)

  (field ^:private ^:static ^:final ^int MAX_OUT 1000)

  (field ^:private ^:static ^:final ^String OMITTED " ... ")

  (field ^:private ^:static ^:final ^int L_HALF
    (unchecked-divide-int (unchecked-subtract-int MAX_OUT (.length OMITTED)) 2))

  (field ^:private ^:static ^:final ^int R_HALF
    (unchecked-subtract-int MAX_OUT (unchecked-add-int L_HALF (.length OMITTED))))

  (method ^:private ^:static check ^void [^:mutable ^String in ^boolean expected]
    (when-not expected
      (let [len (.length in)]
        (when (> len MAX_OUT)
          (set! in
                (java-str (.substring in 0 L_HALF)
                          OMITTED
                          (.substring in (unchecked-subtract-int len R_HALF)))))

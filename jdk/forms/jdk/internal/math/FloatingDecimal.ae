                                    (if (not (== ssign \-)) 0.0 (unchecked-negate 0.0))
                                  (> ep (unchecked-subtract-int (aget QP_MAX ix) bl))
                                    (if (not (== ssign \-))
                                        Double/POSITIVE_INFINITY
                                        Double/NEGATIVE_INFINITY)
                                  :else
                                    (let [^:mutable q (unchecked-int ep)
                                          ^:mutable ^int shr 0]
                                      (if (>= q (unchecked-subtract-int (aget QP_MIN ix) bl))
                                          (do
                                            (set! shr (unchecked-subtract-int bl (aget P ix)))
                                            (set! q (unchecked-add-int q shr)))
                                          (do
                                            (set! shr (unchecked-subtract-int (aget Q_MIN ix) q))
                                            (set! q (aget Q_MIN ix))))
                                      (if (> shr 0)
                                          (let [thr (bit-shift-left 1 shr)
                                                tail (bit-shift-left
                                                       (bit-and c (unchecked-subtract thr 1))
                                                       1)]
                                            (set! c (unsigned-bit-shift-right c shr))
                                            (when (or
                                                    (> tail thr)
                                                    (and (== tail thr) (not (== (bit-and c 2r1) 0))))
                                              (set! c (unchecked-add c 1))
                                              (when (>= c (bit-shift-left 1 (aget P ix)))

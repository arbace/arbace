                                   0
                                   (bit-shift-left 1 (unchecked-subtract-int Double/SIZE 1)))
                               (bit-shift-left be (unchecked-subtract-int (aget P BINARY_64_IX) 1)))
                       (bit-and c DoubleConsts/SIGNIF_BIT_MASK))]
      (Double/longBitsToDouble bits)))

  (method ^:private ^:static buildFloat ^float [^int ssign ^int q ^long c]
    (let [^int be (if (< c (bit-shift-left 1 (unchecked-subtract-int (aget P BINARY_32_IX) 1)))
                      0
                      (unchecked-add-int q
                                         (unchecked-add-int
                                           (unchecked-subtract-int FloatConsts/EXP_BIAS 1)
                                           (aget P BINARY_32_IX))))

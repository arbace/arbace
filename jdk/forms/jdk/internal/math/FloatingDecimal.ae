                                      ^:mutable sb (if (not
                                                         (== (bit-or (bit-and nl1 sbMask) nl0) 0))
                                                       1
                                                       0)
                                      ^:mutable corr (bit-and (bit-and rb (bit-or sb nl1p)) 2r1)
                                      ^float ul (unchecked-add nl1p corr)
                                      nh1p (unsigned-bit-shift-right nh1 sh)]

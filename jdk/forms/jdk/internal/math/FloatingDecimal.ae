                                 (bit-and-int bits FloatConsts/EXP_BIT_MASK)
                                 (unchecked-subtract-int FloatConsts/SIGNIFICAND_WIDTH 1))
                            qr (unchecked-subtract-int
                                 (unchecked-subtract-int
                                   be
                                   (unchecked-subtract-int
                                     (unchecked-add-int
                                       FloatConsts/EXP_BIAS
                                       FloatConsts/SIGNIFICAND_WIDTH)

                          nl1 (Math/unsignedMultiplyHigh ll g1)
                          nl0 (unchecked-multiply ll g1)
                          nh1 (Math/unsignedMultiplyHigh lh (unchecked-add g1 1))
                          nh0 (unchecked-multiply lh (unchecked-add g1 1))

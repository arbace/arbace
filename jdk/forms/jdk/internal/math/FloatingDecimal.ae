                                           e
                                           (^[int int] Math/max (unchecked-subtract-int 2 ql) 1))
                                      d (new byte/1 (Math/min n np))]
                                  (if (>= n np)
                                      (do
                                        (FloatingDecimal/copyDigits
                                          in
                                          d
                                          (unchecked-subtract-int np 1)
                                          lz)
                                        (aset d (unchecked-subtract-int np 1) (unchecked-byte \8)))
                                      (FloatingDecimal/copyDigits in d n lz))
                                  (switch ix
                                    BINARY_32_IX
                                      (double
                                        (.floatValue
                                          (ASCIIToBinaryBuffer. (== ssign \-) e d (alength d))))
                                    BINARY_64_IX
                                      (.doubleValue
                                        (ASCIIToBinaryBuffer. (== ssign \-) e d (alength d)))
                                    (throw (AssertionError. "unexpected"))))))))))))))))

  (method ^:private ^:static toLowerCase ^int [^int ch]
    (bit-or-int ch 2r100000))

  (method ^:private ^:static buildDouble ^double [^int ssign ^int q ^long c]
    (let [^long be (if (< c (bit-shift-left 1 (unchecked-subtract-int (aget P BINARY_64_IX) 1)))

                                    rb
                                    (unsigned-bit-shift-right nh1 (unchecked-subtract-int sh 1)))
                                  (set! sb (if (not (== (bit-or (bit-and nh1 sbMask) nh0) 0)) 1 0))
                                  (set! corr (bit-and (bit-and rb (bit-or sb nh1p)) 2r1))
                                  (let [^float uh (unchecked-add nh1p corr)]

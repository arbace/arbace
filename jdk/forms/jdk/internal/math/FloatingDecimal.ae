                                                (set! q (unchecked-add-int q 1)))))
                                          (set! c (bit-shift-left c (unchecked-negate-int shr))))
                                      (switch ix
                                        BINARY_32_IX (double (FloatingDecimal/buildFloat ssign q c))
                                        BINARY_64_IX (FloatingDecimal/buildDouble ssign q c)
                                        (throw (AssertionError. "unexpected"))))))))
                          (let [e (Math/clamp (unchecked-add ep n)
                                              (aget E_THR_Z ix)
                                              (aget E_THR_I ix))]
                            (cond
                              (== e (aget E_THR_Z ix))
                                (if (not (== ssign \-)) 0.0 (unchecked-negate 0.0))
                              (== e (aget E_THR_I ix))
                                (if (not (== ssign \-))
                                    Double/POSITIVE_INFINITY
                                    Double/NEGATIVE_INFINITY)
                              :else
                                (let [ql (Math/max
                                           (unchecked-subtract-int
                                             (MathUtils/flog2pow10 (unchecked-subtract-int e 1))
                                             (unchecked-subtract-int (aget P ix) 1))
                                           (aget Q_MIN ix))

              (unchecked-int p)))))

  (method ^:private multSub ^long [this ^long q ^FDBigInteger S]
    (let [^:mutable diff 0]
      (when-not (== q 0)
        (let [^:mutable deltaSize (unchecked-subtract-int (.-offset S) (.-offset this))]
          (if (>= deltaSize 0)
              (let [sd (.-data S)
                    td (.-data this)]
                (loop [^int sIndex 0
                       ^int tIndex deltaSize]
                  (when (< sIndex (.-nWords S))
                    (set! diff
                          (unchecked-add diff
                                         (unchecked-subtract
                                           (bit-and (aget td tIndex) LONG_MASK)
                                           (unchecked-multiply
                                             q
                                             (bit-and (aget sd sIndex) LONG_MASK)))))
                    (aset td tIndex (unchecked-int diff))
                    (set! diff (bit-shift-right diff 32))
                    (recur (unchecked-inc-int sIndex) (unchecked-inc-int tIndex)))))
              (do
                (set! deltaSize (unchecked-negate-int deltaSize))
                (let [rd (new int/1 (unchecked-add-int nWords deltaSize))
                      ^:mutable ^int sIndex 0
                      ^:mutable ^int rIndex 0
                      sd (.-data S)]
                  (while (and (< rIndex deltaSize) (< sIndex (.-nWords S)))
                    (set! diff
                          (unchecked-subtract diff
                                              (unchecked-multiply
                                                q
                                                (bit-and (aget sd sIndex) LONG_MASK))))
                    (aset rd rIndex (unchecked-int diff))
                    (set! diff (bit-shift-right diff 32))
                    (set! sIndex (unchecked-inc-int sIndex))
                    (set! rIndex (unchecked-inc-int rIndex)))
                  (let [^:mutable ^int tIndex 0
                        td (.-data this)]
                    (while (< sIndex (.-nWords S))
                      (set! diff
                            (unchecked-add diff
                                           (unchecked-subtract
                                             (bit-and (aget td tIndex) LONG_MASK)
                                             (unchecked-multiply
                                               q
                                               (bit-and (aget sd sIndex) LONG_MASK)))))
                      (aset rd rIndex (unchecked-int diff))
                      (set! diff (bit-shift-right diff 32))
                      (set! sIndex (unchecked-inc-int sIndex))
                      (set! tIndex (unchecked-inc-int tIndex))
                      (set! rIndex (unchecked-inc-int rIndex)))
                    (set! (.-nWords this) (unchecked-add-int (.-nWords this) deltaSize))
                    (set! (.-offset this) (unchecked-subtract-int (.-offset this) deltaSize))
                    (set! (.-data this) rd)))))))
      diff))

  (method ^:private ^:static multAndCarryBy10 ^int [^int/1 src ^int srcLen ^int/1 dst]
    (let [^:mutable carry 0]
      (loop [^int i 0]
        (when (< i srcLen)
          (let [product (unchecked-add (unchecked-multiply (bit-and (aget src i) LONG_MASK) 10)
                                       carry)]
            (aset dst i (unchecked-int product))
            (set! carry (unsigned-bit-shift-right product 32))
            (recur (unchecked-inc-int i)))))
      (unchecked-int carry)))

  (method ^:private ^:static mult ^void [^int/1 src ^int srcLen ^int value ^int/1 dst]
    (let [v (bit-and value LONG_MASK)
          ^:mutable carry 0
          ^:mutable ^int i 0]
      (while (< i srcLen)
        (let [product (unchecked-add (unchecked-multiply v (bit-and (aget src i) LONG_MASK)) carry)]
          (aset dst i (unchecked-int product))
          (set! carry (unsigned-bit-shift-right product 32)))
        (set! i (unchecked-inc-int i)))
      (aset dst i (unchecked-int carry))))

  (method ^:private ^:static mult ^void [^int/1 src ^int srcLen ^int v0 ^int v1 ^int/1 dst]
    (let [^:mutable v (bit-and v0 LONG_MASK)
          ^:mutable carry 0
          ^:mutable ^int j 0]
      (while (< j srcLen)
        (let [product (unchecked-add (unchecked-multiply v (bit-and (aget src j) LONG_MASK)) carry)]
          (aset dst j (unchecked-int product))
          (set! carry (unsigned-bit-shift-right product 32)))
        (set! j (unchecked-inc-int j)))
      (aset dst j (unchecked-int carry))
      (set! v (bit-and v1 LONG_MASK))
      (set! carry 0)
      (set! j 1)
      (while (<= j srcLen)
        (let [product (unchecked-add
                        (unchecked-add
                          (bit-and (aget dst j) LONG_MASK)
                          (unchecked-multiply v
                                              (bit-and
                                                (aget src (unchecked-subtract-int j 1))
                                                LONG_MASK)))
                        carry)]
          (aset dst j (unchecked-int product))
          (set! carry (unsigned-bit-shift-right product 32)))
        (set! j (unchecked-inc-int j)))
      (aset dst j (unchecked-int carry))))

  (field ^:private ^:static ^:final ^{Stable true} ^FDBigInteger/1 LARGE_POW_5_CACHE)

  (method ^:private ^:static pow5 ^FDBigInteger [^int e]
    (if (< e MAX_FIVE_POW)
        (aget POW_5_CACHE e)
        (do
          (when (> e (unchecked-subtract-int 2 DoubleToDecimal/Q_MIN))
            (throw (IllegalArgumentException. (java-str "exponent too large: " e))))
          (let [^:mutable p5 (aget LARGE_POW_5_CACHE (unchecked-subtract-int e MAX_FIVE_POW))]
            (when (nil? p5)
              (let [ep (unchecked-subtract-int (unchecked-subtract-int e 1)
                                               (unchecked-remainder-int
                                                 (unchecked-subtract-int e 1)
                                                 (unchecked-subtract-int MAX_FIVE_POW 1)))]
                (set! p5
                      (.mult (if (< ep MAX_FIVE_POW)
                                 (aget POW_5_CACHE ep)
                                 (aget LARGE_POW_5_CACHE (unchecked-subtract-int ep MAX_FIVE_POW)))
                             (aget POW_5_CACHE (unchecked-subtract-int e ep))))
                (aset LARGE_POW_5_CACHE (unchecked-subtract-int e MAX_FIVE_POW) (.makeImmutable p5))))
            p5))))

  (method ^:public toString ^String [this]
    (if (== nWords 0)
        "0"
        (let [sb (StringBuilder. (unchecked-multiply-int 8 (.size this)))
              ^:mutable i (unchecked-subtract-int nWords 1)]
          (.append sb (Integer/toHexString (aget data i)))
          (set! i (unchecked-dec-int i))
          (while (>= i 0)
            (let [subStr (Integer/toHexString
                           (aget data (let [old-5 i] (set! i (unchecked-dec-int i)) old-5)))]
              (.append (.repeat sb \0 (unchecked-subtract-int 8 (.length subStr))) subStr)))
          (.toString (.repeat sb \0 (unchecked-multiply-int 8 offset))))))

  (method ^:public toByteArray ^byte/1 [this]
    (let [magnitude (new byte/1 (unchecked-add-int (unchecked-multiply-int 4 (.size this)) 1))]
      (loop [^int i 0
             ^int j (unchecked-subtract-int (alength magnitude) (unchecked-multiply-int 4 offset))]
        (when (< i nWords)
          (let [w (aget data i)]
            (aset magnitude (unchecked-subtract-int j 1) (unchecked-byte w))
            (aset magnitude (unchecked-subtract-int j 2) (unchecked-byte (bit-shift-right-int w 8)))
            (aset magnitude
                  (unchecked-subtract-int j 3)
                  (unchecked-byte (bit-shift-right-int w 16)))
            (aset magnitude
                  (unchecked-subtract-int j 4)
                  (unchecked-byte (bit-shift-right-int w 24)))
            (recur (unchecked-add-int i 1) (unchecked-subtract-int j 4)))))
      magnitude)))

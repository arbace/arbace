  (method createDirectory :throws [IOException] ^void [this &
                                                       ^{:tag (array (FileAttribute ?))} attrs]
    (.createDirectory zfs (.getResolvedPath this) attrs))

  (method newInputStream :throws [IOException] ^InputStream [this & ^OpenOption/1 options]
    (for-each [^OpenOption opt options]
      (when-not (identical? opt StandardOpenOption/READ)
        (throw (UnsupportedOperationException. (java-str "'" opt "' not allowed")))))
    (.newInputStream zfs (.getResolvedPath this)))

  (method newDirectoryStream :throws [IOException] ^{:tag (DirectoryStream Path)} [this
                                                                                   ^{:tag (DirectoryStream$Filter (? super Path))} filter]
    (ZipDirectoryStream. this filter))

  (method delete :throws [IOException] ^void [this]
    (.deleteFile zfs (.getResolvedPath this) true))

  (method ^:private deleteIfExists :throws [IOException] ^void [this]
    (.deleteFile zfs (.getResolvedPath this) false))

  (method readAttributes :throws [IOException] ^ZipFileAttributes [this]
    (let [zfas (.getFileAttributes zfs (.getResolvedPath this))]
      (when (nil? zfas) (throw (NoSuchFileException. (.toString this))))
      zfas))

  (method readAttributes :type-params [(A extends BasicFileAttributes)] :throws [IOException] ^A [this
                                                                                                  ^{:tag (Class A)} type]
    (cond
      (or (identical? type BasicFileAttributes) (identical? type ZipFileAttributes))
        ^BasicFileAttributes (.readAttributes this)
      (and (identical? type PosixFileAttributes) (.-supportPosix zfs))
        ^BasicFileAttributes (.readAttributes this)
      :else
        (throw (UnsupportedOperationException.
                 (java-str "Attributes of type " (.getName type) " not supported")))))

  (method setAttribute :throws [IOException] ^void [this ^String attribute value &
                                                    ^LinkOption/1 options]
    (let [^:mutable ^String type nil
          ^:mutable ^String attr nil
          ^:mutable colonPos (.indexOf attribute \:)]
      (if (== colonPos -1)
          (do (set! type "basic") (set! attr attribute))
          (do
            (set! type (.substring attribute 0 colonPos))
            (set! colonPos (unchecked-inc-int colonPos))
            (set! attr (.substring attribute colonPos))))
      (.setAttribute (.getFileAttributeView this type) attr value)))

  (method setTimes :throws [IOException] ^void [this ^FileTime mtime ^FileTime atime ^FileTime ctime]
    (.setTimes zfs (.getResolvedPath this) mtime atime ctime))

  (method setOwner :throws [IOException] ^void [this ^UserPrincipal owner]
    (.setOwner zfs (.getResolvedPath this) owner))

  (method setPermissions :throws [IOException] ^void [this ^{:tag (Set PosixFilePermission)} perms]
    (.setPermissions zfs (.getResolvedPath this) perms))

  (method setGroup :throws [IOException] ^void [this ^GroupPrincipal group]
    (.setGroup zfs (.getResolvedPath this) group))

  (method readAttributes :throws [IOException] ^{:tag (Map String Object)} [this ^String attributes
                                                                            & ^LinkOption/1 options]
    (let [^:mutable ^String view nil
          ^:mutable ^String attrs nil
          ^:mutable colonPos (.indexOf attributes \:)]
      (if (== colonPos -1)
          (do (set! view "basic") (set! attrs attributes))
          (do
            (set! view (.substring attributes 0 colonPos))
            (set! colonPos (unchecked-inc-int colonPos))
            (set! attrs (.substring attributes colonPos))))
      (.readAttributes (.getFileAttributeView this view) attrs)))

  (method readAttributesIfExists :throws [IOException] ^ZipFileAttributes [this]
    (.getFileAttributes zfs (.getResolvedPath this)))

  (method getFileStore :throws [IOException] ^FileStore [this]
    (if (.exists this)
        (.getFileStore zfs this)
        (throw (NoSuchFileException. (.getString zfs path)))))

  (method isSameFile :throws [IOException] ^boolean [this ^Path other]
    (cond
      (.equals this other) true
      (or (nil? other) (not (identical? (.getFileSystem this) (.getFileSystem other)))) false
      :else
        (do
          (.checkAccess this)
          (.checkAccess (cast ZipPath other))
          (Arrays/equals (.getResolvedPath this) (.getResolvedPath (cast ZipPath other))))))

  (method newByteChannel :throws [IOException] ^SeekableByteChannel [this
                                                                     ^{:tag (Set (? extends OpenOption))} options
                                                                     &
                                                                     ^{:tag (array (FileAttribute ?))} attrs]
    (.newByteChannel zfs (.getResolvedPath this) options attrs))

  (method newFileChannel :throws [IOException] ^FileChannel [this
                                                             ^{:tag (Set (? extends OpenOption))} options
                                                             &
                                                             ^{:tag (array (FileAttribute ?))} attrs]
    (.newFileChannel zfs (.getResolvedPath this) options attrs))

  (method checkAccess :throws [IOException] ^void [this & ^AccessMode/1 modes]
    (let [^:mutable w false
          ^:mutable x false]
      (for-each [^AccessMode mode modes]
        (switch mode
          READ nil
          WRITE (set! w true)
          EXECUTE (set! x true)
          (throw (UnsupportedOperationException.))))
      (.checkAccess zfs (.getResolvedPath this))
      (when (or (and w (.isReadOnly zfs)) x) (throw (AccessDeniedException. (.toString this))))))

  (method exists ^boolean [this] (.exists zfs (.getResolvedPath this)))

  (method newOutputStream :throws [IOException] ^OutputStream [this & ^OpenOption/1 options]
    (if (== (alength options) 0)
        (.newOutputStream zfs
                          (.getResolvedPath this)
                          StandardOpenOption/CREATE
                          StandardOpenOption/TRUNCATE_EXISTING
                          StandardOpenOption/WRITE)
        (.newOutputStream zfs (.getResolvedPath this) options)))

  (method move :throws [IOException] ^void [this ^ZipPath target & ^CopyOption/1 options]
    (if (Files/isSameFile (.getZipFile (.-zfs this)) (.getZipFile (.-zfs target)))
        (.copyFile zfs true (.getResolvedPath this) (.getResolvedPath target) options)
        (do (.copyToTarget this target options) (.delete this))))

  (method copy :throws [IOException] ^void [this ^ZipPath target & ^CopyOption/1 options]
    (if (Files/isSameFile (.getZipFile (.-zfs this)) (.getZipFile (.-zfs target)))
        (.copyFile zfs false (.getResolvedPath this) (.getResolvedPath target) options)
        (.copyToTarget this target options)))

  (method ^:private copyToTarget :throws [IOException] ^void [this ^ZipPath target &
                                                              ^CopyOption/1 options]
    (let [^:mutable replaceExisting false
          ^:mutable copyAttrs false]
      (for-each [^CopyOption opt options]
        (cond
          (identical? opt StandardCopyOption/REPLACE_EXISTING) (set! replaceExisting true)
          (identical? opt StandardCopyOption/COPY_ATTRIBUTES) (set! copyAttrs true)))
      (let [zfas (.readAttributes this)
            ^:mutable ^boolean exists false]
        (if replaceExisting
            (try
              (.deleteIfExists target)
              (set! exists false)
              (catch DirectoryNotEmptyException x (set! exists true)))
            (set! exists (.exists target)))
        (when exists (throw (FileAlreadyExistsException. (.toString target))))
        (if (.isDirectory zfas)
            (.createDirectory target)
            (with-resources [^:final is (.newInputStream zfs (.getResolvedPath this))
                             ^:final os (.newOutputStream target)]
              (.transferTo is os)))
        (when copyAttrs
          (let [view (cast ZipFileAttributeView (.getFileAttributeView target ZipFileAttributeView))]
            (try
              (.setTimes view (.lastModifiedTime zfas) (.lastAccessTime zfas) (.creationTime zfas))
              (.setPermissions view (cast Set (.orElse (.storedPermissions zfas) nil)))
              (catch IOException x (try (.delete target) (catch IOException ignore)) (throw x))))))))

  (method ^:private ^:static decode ^int [^char c]
    (cond
      (and (>= c \0) (<= c \9)) (unchecked-subtract-int c \0)
      (and (>= c \a) (<= c \f)) (unchecked-add-int (unchecked-subtract-int c \a) 10)
      (and (>= c \A) (<= c \F)) (unchecked-add-int (unchecked-subtract-int c \A) 10)
      :else (do (java-assert false) -1)))

  (method ^:private ^:static decodeUri ^String [^String s]
    (when (some? s)
      (let [n (.length s)]
        (cond
          (== n 0) s
          (< (.indexOf s \%) 0) s
          :else
            (let [sb (StringBuilder. n)
                  bb (new byte/1 n)
                  ^:mutable betweenBrackets false]
              (let [^:mutable ^int i 0]
                (while (< i n)
                  (let [^:mutable c (.charAt s i)]
                    (cond
                      (== c \[) (set! betweenBrackets true)
                      (and betweenBrackets (== c \])) (set! betweenBrackets false))
                    (if (or (not (== c \%)) betweenBrackets)
                        (do (.append sb c) (set! i (unchecked-inc-int i)))
                        (let [^:mutable ^int nb 0]
                          (while (== c \%)
                            (java-assert (>= (unchecked-subtract-int n i) 2))
                            (aset bb
                                  nb
                                  (unchecked-byte
                                    (bit-or-int (bit-shift-left-int
                                                  (bit-and-int
                                                    (ZipPath/decode
                                                      (.charAt s (set! i (unchecked-inc-int i))))
                                                    0xf)
                                                  4)
                                                (bit-and-int
                                                  (ZipPath/decode
                                                    (.charAt s (set! i (unchecked-inc-int i))))
                                                  0xf))))
                            (set! nb (unchecked-inc-int nb))
                            (when (>= (set! i (unchecked-inc-int i)) n) (break))
                            (set! c (.charAt s i)))
                          (.append sb (String. bb 0 nb StandardCharsets/UTF_8)))))))
              (.toString sb)))))))

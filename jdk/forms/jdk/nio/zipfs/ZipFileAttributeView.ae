        (.setTimes this (cast FileTime value) nil nil))
      (when (identical? (AttrID/valueOf attribute) AttrID/lastAccessTime)
        (.setTimes this nil (cast FileTime value) nil))
      (when (identical? (AttrID/valueOf attribute) AttrID/creationTime)

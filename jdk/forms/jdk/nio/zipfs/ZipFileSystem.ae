            (set! (.-file e) (.getTempPathForEntry this nil))
            (set! os (Files/newOutputStream (.-file e) StandardOpenOption/WRITE)))
          (set! os (FileRolloverOutputStream. e)))
      (if (== (.-method e) ZipConstants/METHOD_DEFLATED)
          (DeflatingEntryOutputStream. e os)
          (EntryOutputStream. e os))))


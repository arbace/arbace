                    sz (ZipConstants/SH extra (unchecked-add-int pos 2))]
                (set! pos (unchecked-add-int pos 4))
                (when (> (unchecked-add-int pos sz) elen)
                  (throw
                    (ZipException.
                      (String/format
                        "Invalid CEN header (invalid extra data field size for tag: 0x%04x size: %d)"
                        (new Object/1 [tag sz])))))
                (label :switch
                  (switch tag
                    ZipConstants/EXTID_ZIP64
                      (do
                        (when (== size ZipConstants/ZIP64_MINVAL)
                          (when (> (unchecked-add-int pos 8) elen) (break :switch))
                          (set! size (ZipConstants/LL extra pos))
                          (when (< size 0)
                            (throw (ZipException. "Invalid zip64 extra block size value")))
                          (set! pos (unchecked-add-int pos 8)))
                        (when (== csize ZipConstants/ZIP64_MINVAL)
                          (when (> (unchecked-add-int pos 8) elen) (break :switch))
                          (set! csize (ZipConstants/LL extra pos))
                          (when (< csize 0)
                            (throw
                              (ZipException. "Invalid zip64 extra block compressed size value")))
                          (set! pos (unchecked-add-int pos 8)))
                        (when (== locoff ZipConstants/ZIP64_MINVAL)
                          (when (> (unchecked-add-int pos 8) elen) (break :switch))
                          (set! locoff (ZipConstants/LL extra pos))
                          (when (< locoff 0)
                            (throw (ZipException. "Invalid zip64 extra block LOC offset value")))))
                    ZipConstants/EXTID_NTFS
                      (when-not (< sz 32)
                        (set! pos (unchecked-add-int pos 4))
                        (when-not (not (== (ZipConstants/SH extra pos) 0x0001))
                          (when-not (not (== (ZipConstants/SH extra (unchecked-add-int pos 2)) 24))
                            (set! mtime
                                  (ZipUtils/winToJavaTime
                                    (ZipConstants/LL extra (unchecked-add-int pos 4))))
                            (set! atime
                                  (ZipUtils/winToJavaTime
                                    (ZipConstants/LL extra (unchecked-add-int pos 12))))
                            (set! ctime
                                  (ZipUtils/winToJavaTime
                                    (ZipConstants/LL extra (unchecked-add-int pos 20)))))))
                    ZipConstants/EXTID_EXTT
                      (cond
                        (.-noExtt zipfs)
                          (when (== sz 5)
                            (set! mtime
                                  (ZipUtils/unixToJavaTime
                                    (ZipConstants/LG extra (unchecked-add-int pos 1)))))
                        (not (== locoff ZipConstants/ZIP64_MINVAL)) (.readLocEXTT this zipfs)
                        :else (set! hasZip64LocOffset true))
                    (do
                      (System/arraycopy extra off extra newOff (unchecked-add-int sz 4))
                      (set! newOff (unchecked-add-int newOff (unchecked-add-int sz 4))))))
                (set! off (unchecked-add-int off (unchecked-add-int sz 4)))))
            (when hasZip64LocOffset (.readLocEXTT this zipfs))
            (if (and (not (== newOff 0)) (not (== newOff (alength extra))))
                (set! extra (Arrays/copyOf extra newOff))
                (set! extra nil))))))

    (method ^:private readLocEXTT :throws [IOException] ^void [this ^ZipFileSystem zipfs]
      (let [^:mutable buf (new byte/1 ZipConstants/LOCHDR)]
        (when-not (== (.readNBytesAt zipfs buf 0 (alength buf) locoff) (alength buf))
          (throw (ZipException. "loc: reading failed")))
        (when-not (ZipConstants/locSigAt buf 0)
          (throw (ZipException. (java-str "R" (Long/toString (ZipConstants/getSig buf 0) 16)))))
        (let [locElen (ZipConstants/LOCEXT buf)]
          (when-not (< locElen 9)
            (let [locNlen (ZipConstants/LOCNAM buf)]
              (set! buf (new byte/1 locElen))
              (when-not (== (.readNBytesAt zipfs
                                           buf
                                           0
                                           (alength buf)
                                           (unchecked-add
                                             (unchecked-add locoff ZipConstants/LOCHDR)
                                             locNlen))
                            (alength buf))
                (throw (ZipException. "loc extra: reading failed")))
              (let [^:mutable ^int locPos 0]
                (while (< (unchecked-add-int locPos 4) (alength buf))
                  (let [locTag (ZipConstants/SH buf locPos)
                        locSZ (ZipConstants/SH buf (unchecked-add-int locPos 2))]
                    (set! locPos (unchecked-add-int locPos 4))
                    (if (not (== locTag ZipConstants/EXTID_EXTT))
                        (set! locPos (unchecked-add-int locPos locSZ))
                        (let [end (unchecked-subtract-int (unchecked-add-int locPos locSZ) 4)
                              flag (ZipConstants/CH
                                     buf
                                     (let [old-2 locPos]
                                       (set! locPos (unchecked-inc-int locPos))
                                       old-2))]
                          (when (and (not (== (bit-and-int flag 0x1) 0)) (<= locPos end))
                            (set! mtime (ZipUtils/unixToJavaTime (ZipConstants/LG buf locPos)))
                            (set! locPos (unchecked-add-int locPos 4)))
                          (when (and (not (== (bit-and-int flag 0x2) 0)) (<= locPos end))
                            (set! atime (ZipUtils/unixToJavaTime (ZipConstants/LG buf locPos)))
                            (set! locPos (unchecked-add-int locPos 4)))
                          (when (and (not (== (bit-and-int flag 0x4) 0)) (<= locPos end))
                            (set! ctime (ZipUtils/unixToJavaTime (ZipConstants/LG buf locPos))))
                          (break)))))))))))

    (method ^:public toString ^String [this]
      (let [sb (StringBuilder. 1024)
            fm (Formatter. sb)]
        (.format fm "    name            : %s%n" (new Object/1 [(.nameAsString this)]))
        (.format fm "    creationTime    : %tc%n" (new Object/1 [(.toMillis (.creationTime this))]))
        (.format fm
                 "    lastAccessTime  : %tc%n"
                 (new Object/1 [(.toMillis (.lastAccessTime this))]))
        (.format fm
                 "    lastModifiedTime: %tc%n"
                 (new Object/1 [(.toMillis (.lastModifiedTime this))]))
        (.format fm "    isRegularFile   : %b%n" (new Object/1 [(.isRegularFile this)]))
        (.format fm "    isDirectory     : %b%n" (new Object/1 [(.isDirectory this)]))
        (.format fm "    isSymbolicLink  : %b%n" (new Object/1 [(.isSymbolicLink this)]))
        (.format fm "    isOther         : %b%n" (new Object/1 [(.isOther this)]))
        (.format fm "    fileKey         : %s%n" (new Object/1 [(.fileKey this)]))
        (.format fm "    size            : %d%n" (new Object/1 [(.size this)]))
        (.format fm "    compressedSize  : %d%n" (new Object/1 [(.compressedSize this)]))
        (.format fm "    crc             : %x%n" (new Object/1 [(.crc this)]))
        (.format fm "    method          : %d%n" (new Object/1 [(.method this)]))
        (let [^{:tag (Set PosixFilePermission)} permissions (cast
                                                              Set
                                                              (.orElse
                                                                (.storedPermissions this)
                                                                nil))]
          (when (some? permissions)
            (.format fm "    permissions     : %s%n" (new Object/1 [permissions])))
          (.close fm)
          (.toString sb))))

    (method ^:public creationTime ^FileTime [this]
      (FileTime/fromMillis (if (== ctime -1) mtime ctime)))

    (method ^:public isDirectory ^boolean [this] (.isDir this))

    (method ^:public isOther ^boolean [this] false)

    (method ^:public isRegularFile ^boolean [this] (not (.isDir this)))

    (method ^:public lastAccessTime ^FileTime [this]
      (FileTime/fromMillis (if (== atime -1) mtime atime)))

    (method ^:public lastModifiedTime ^FileTime [this]
      (FileTime/fromMillis mtime))

    (method ^:public size ^long [this] size)

    (method ^:public isSymbolicLink ^boolean [this] false)

    (method ^:public fileKey [this] nil)

    (method ^:public compressedSize ^long [this] csize)

    (method ^:public crc ^long [this] crc)

    (method ^:public method ^int [this] method)

    (method ^:public extra ^byte/1 [this]
      (when (some? extra) (Arrays/copyOf extra (alength extra))))

    (method ^:public comment ^byte/1 [this]
      (when (some? comment) (Arrays/copyOf comment (alength comment))))

    (method ^:public storedPermissions ^{:tag (Optional (Set PosixFilePermission))} [this]
      (let [^:mutable ^{:tag (Set PosixFilePermission)} perms nil]
        (when-not (== externalFileAttributes -1)
          (set! perms (HashSet/newHashSet (alength (PosixFilePermission/values))))
          (for-each [^PosixFilePermission perm (PosixFilePermission/values)]
            (when-not (== (bit-and-int externalFileAttributes (ZipUtils/permToFlag perm)) 0)
              (.add perms perm))))
        (Optional/ofNullable perms))))

  (defclass ^:final PosixEntry
    :extends Entry
    :implements [PosixFileAttributes]

    (field ^:private ^UserPrincipal owner defaultOwner)

    (field ^:private ^GroupPrincipal group defaultGroup)

    (constructor [this ^byte/1 name ^boolean isdir ^int method]
      (super. name isdir method))

    (constructor [this ^byte/1 name ^int type ^boolean isdir ^int method &
                  ^{:tag (array (FileAttribute ?))} attrs]
      (super. name type isdir method attrs))

    (constructor [this ^byte/1 name ^Path file ^int type & ^{:tag (array (FileAttribute ?))} attrs]
      (super. name file type attrs))

    (constructor [this ^PosixEntry e ^int type ^int compressionMethod]
      (super. e type)
      (set! (.-method this) compressionMethod))

    (constructor [this ^PosixEntry e ^int type]
      (super. e type)
      (set! (.-owner this) (.-owner e))
      (set! (.-group this) (.-group e)))

    (constructor :throws [IOException] [this ^ZipFileSystem zipfs ^IndexNode inode]
      (super. zipfs inode))

    (method ^:public owner ^UserPrincipal [this] owner)

    (method ^:public group ^GroupPrincipal [this] group)

    (method ^:public permissions ^{:tag (Set PosixFilePermission)} [this]
      (cast Set (.orElse (.storedPermissions this) defaultPermissions))))

  (defclass ^:static ParentLookup
    :extends IndexNode

    (field ^int len)

    (constructor [this])

    (method ^:final as ^ParentLookup [this ^byte/1 name ^int len]
      (.name this name len)
      this)

    (method name ^void [this ^byte/1 name ^int len]
      (set! (.-name this) name)
      (set! (.-len this) len)
      (let [^:mutable ^int result 1]
        (loop [^int i 0]
          (when (< i len)
            (set! result (unchecked-add-int (unchecked-multiply-int 31 result) (aget name i)))
            (recur (unchecked-inc-int i))))
        (set! (.-hashcode this) result)))

    (method ^:public equals ^boolean [this other]
      (if (not (instance? IndexNode other))
          false
          (let [oname (.-name (cast IndexNode other))]
            (Arrays/equals (.-name this) 0 len oname 0 (alength oname)))))))

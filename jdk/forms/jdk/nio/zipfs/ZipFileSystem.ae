                                               (new FileAttribute/1 [])))))))
        (finally (.endRead this)))))

  (method newInputStream :throws [IOException] ^InputStream [this ^byte/1 path]
    (.beginRead this)
    (try
      (.ensureOpen this)
      (let [e (.getEntry this path)]
        (when (nil? e) (throw (NoSuchFileException. (.getString this path))))
        (when (.isDir e) (throw (FileSystemException. (.getString this path) nil "is a directory")))
        (.getInputStream this e))
      (finally (.endRead this))))

  (method ^:private checkOptions ^void [this ^{:tag (Set (? extends OpenOption))} options]
    (for-each [^OpenOption option options]
      (when (nil? option) (throw (NullPointerException.)))
      (when-not (instance? StandardOpenOption option) (throw (IllegalArgumentException.))))
    (when (and (.contains options StandardOpenOption/APPEND)
               (.contains options StandardOpenOption/TRUNCATE_EXISTING))
      (throw (IllegalArgumentException. "APPEND + TRUNCATE_EXISTING not allowed"))))

  (defclass ^:private EntryOutputChannel
    :extends ByteArrayChannel

    (field ^:final ^Entry e)

    (constructor [this ^Entry e]
      (super. (if (> (.-size e) 0) (unchecked-int (.-size e)) 8192) false)
      (set! (.-e this) e)
      (when (== (.-mtime e) -1) (set! (.-mtime e) (System/currentTimeMillis)))
      (when (== (.-method e) -1) (set! (.-method e) defaultCompressionMethod))
      (set! (.-flag e) ZipConstants/FLAG_DATADESCR)
      (when (.isUTF8 zc) (set! (.-flag e) (bit-or-int (.-flag e) ZipConstants/FLAG_USE_UTF8))))

    (method ^:public close :throws [IOException] ^void [this]
      (.beginWrite super)
      (try
        (when-not (not (.isOpen this))
          (with-resources [os (.getOutputStream ZipFileSystem/this e)]
            (.write os (.toByteArray this)))
          (.close super))
        (finally (.endWrite super)))))

  (method newByteChannel :throws [IOException] ^SeekableByteChannel [this ^byte/1 path
                                                                     ^{:tag (Set (? extends OpenOption))} options
                                                                     &
                                                                     ^{:tag (array (FileAttribute ?))} attrs]
    (.checkOptions this options)
    (if (or (.contains options StandardOpenOption/WRITE)
            (.contains options StandardOpenOption/APPEND))
        (do
          (.checkWritable this)
          (.beginRead this)
          (.ensureOpen this)
          (try
            (let [e (.getEntry this path)]
              (if (some? e)
                  (do
                    (when (or (.isDir e) (.contains options StandardOpenOption/CREATE_NEW))
                      (throw (FileAlreadyExistsException. (.getString this path))))
                    (let [^SeekableByteChannel sbc (EntryOutputChannel.
                                                     ^Entry (if supportPosix
                                                                ^Entry (PosixEntry.
                                                                         (cast PosixEntry e)
                                                                         Entry/NEW)
                                                                (Entry. e Entry/NEW)))]
                      (when (.contains options StandardOpenOption/APPEND)
                        (with-resources [is (.getInputStream this e)]
                          (let [buf (new byte/1 8192)
                                bb (ByteBuffer/wrap buf)
                                ^:mutable ^int n 0]
                            (while (not (== (set! n (.read is buf)) -1))
                              (.position bb 0)
                              (.limit bb n)
                              (.write sbc bb)))))
                      sbc))
                  (do
                    (when (and (not (.contains options StandardOpenOption/CREATE))
                               (not (.contains options StandardOpenOption/CREATE_NEW)))
                      (throw (NoSuchFileException. (.getString this path))))
                    (.checkParents this path)
                    (EntryOutputChannel.
                      ^Entry (if supportPosix
                                 ^Entry (PosixEntry.
                                          path
                                          Entry/NEW
                                          false
                                          defaultCompressionMethod
                                          attrs)
                                 (Entry. path Entry/NEW false defaultCompressionMethod attrs))))))
            (finally (.endRead this))))
        (do
          (.beginRead this)
          (try
            (.ensureOpen this)
            (let [e (.getEntry this path)]
              (when (or (nil? e) (.isDir e)) (throw (NoSuchFileException. (.getString this path))))
              (with-resources [is (.getInputStream this e)]
                (ByteArrayChannel. (.readAllBytes is) true)))
            (finally (.endRead this))))))

  (method newFileChannel :throws [IOException] ^FileChannel [this ^byte/1 path
                                                             ^:mutable ^{:tag (Set (? extends OpenOption))} options
                                                             &
                                                             ^{:tag (array (FileAttribute ?))} attrs]
    (.checkOptions this options)
    (let [forWrite (or (.contains options StandardOpenOption/WRITE)
                       (.contains options StandardOpenOption/APPEND))]
      (.beginRead this)
      (try
        (.ensureOpen this)
        (let [e (.getEntry this path)]
          (cond
            forWrite
              (do
                (.checkWritable this)
                (if (nil? e)
                    (when (and (not (.contains options StandardOpenOption/CREATE))
                               (not (.contains options StandardOpenOption/CREATE_NEW)))
                      (throw (NoSuchFileException. (.getString this path))))
                    (do
                      (when (.contains options StandardOpenOption/CREATE_NEW)
                        (throw (FileAlreadyExistsException. (.getString this path))))
                      (when (.isDir e)
                        (throw (FileAlreadyExistsException.
                                 (java-str "directory <" (.getString this path) "> exists"))))))
                (set! options (HashSet. options))
                (.remove options StandardOpenOption/CREATE_NEW))
            (or (nil? e) (.isDir e)) (throw (NoSuchFileException. (.getString this path))))
          (let [isFCH (and (some? e) (== (.-type e) Entry/FILECH))
                ^Path tmpfile (if isFCH (.-file e) (.getTempPathForEntry this path))
                fch (.newFileChannel (.provider (.getFileSystem tmpfile)) tmpfile options attrs)
                ^Entry u (cond
                           isFCH e
                           supportPosix ^Entry (PosixEntry. path tmpfile Entry/FILECH attrs)
                           :else (Entry. path tmpfile Entry/FILECH attrs))]
            (when forWrite
              (set! (.-flag u) ZipConstants/FLAG_DATADESCR)
              (set! (.-method u) defaultCompressionMethod))
            (anon FileChannel []
              (method ^:public write :throws [IOException] ^int [this ^ByteBuffer src]
                (.write fch src))

              (method ^:public write :throws [IOException] ^long [this ^ByteBuffer/1 srcs
                                                                  ^int offset ^int length]
                (.write fch srcs offset length))

              (method ^:public position :throws [IOException] ^long [this]
                (.position fch))

              (method ^:public position :throws [IOException] ^FileChannel [this ^long newPosition]
                (.position fch newPosition)
                this)

              (method ^:public size :throws [IOException] ^long [this] (.size fch))

              (method ^:public truncate :throws [IOException] ^FileChannel [this ^long size]
                (.truncate fch size)
                this)

              (method ^:public force :throws [IOException] ^void [this ^boolean metaData]
                (.force fch metaData))

              (method ^:public transferTo :throws [IOException] ^long [this ^long position
                                                                       ^long count
                                                                       ^WritableByteChannel target]
                (.transferTo fch position count target))

              (method ^:public transferFrom :throws [IOException] ^long [this
                                                                         ^ReadableByteChannel src
                                                                         ^long position ^long count]
                (.transferFrom fch src position count))

              (method ^:public read :throws [IOException] ^int [this ^ByteBuffer dst]
                (.read fch dst))

              (method ^:public read :throws [IOException] ^int [this ^ByteBuffer dst ^long position]
                (.read fch dst position))

              (method ^:public read :throws [IOException] ^long [this ^ByteBuffer/1 dsts ^int offset
                                                                 ^int length]
                (.read fch dsts offset length))

              (method ^:public write :throws [IOException] ^int [this ^ByteBuffer src ^long position]
                (.write fch src position))

              (method ^:public map ^MappedByteBuffer [this ^FileChannel$MapMode mode ^long position
                                                      ^long size]
                (throw (UnsupportedOperationException.)))

              (method ^:public lock :throws [IOException] ^FileLock [this ^long position ^long size
                                                                     ^boolean shared]
                (.lock fch position size shared))

              (method ^:public tryLock :throws [IOException] ^FileLock [this ^long position
                                                                        ^long size ^boolean shared]
                (.tryLock fch position size shared))

              (method ^:protected implCloseChannel :throws [IOException] ^void [this]
                (.close fch)
                (if forWrite
                    (do
                      (set! (.-mtime u) (System/currentTimeMillis))
                      (set! (.-size u) (Files/size (.-file u)))
                      (.update ZipFileSystem/this u))
                    (when-not isFCH (.removeTempPathForEntry ZipFileSystem/this tmpfile)))))))
        (finally (.endRead this)))))

  (field ^:private ^{:tag (Set InputStream)} streams (Collections/synchronizedSet (HashSet.)))

  (field ^:private ^:final ^{:tag (Set Path)} tmppaths (Collections/synchronizedSet (HashSet.)))

  (method ^:private getTempPathForEntry :throws [IOException] ^Path [this ^byte/1 path]
    (let [tmpPath (.createTempFileInSameDirectoryAs this zfpath)]
      (when (some? path)
        (let [e (.getEntry this path)]
          (when (some? e)
            (with-resources [is (.newInputStream this path)]
              (Files/copy is tmpPath (new CopyOption/1 [StandardCopyOption/REPLACE_EXISTING]))))))
      tmpPath))

  (method ^:private removeTempPathForEntry :throws [IOException] ^void [this ^Path path]
    (Files/delete path)
    (.remove tmppaths path))

  (method ^:private checkParents :throws [IOException] ^void [this ^:mutable ^byte/1 path]
    (.beginRead this)
    (try
      (while (and (some? (set! path (ZipFileSystem/getParent path)))
                  (not (identical? path ROOTPATH)))
        (when-not (.containsKey inodes (IndexNode/keyOf path))
          (throw (NoSuchFileException. (.getString this path)))))
      (finally (.endRead this))))

  (method ^:private ^:static getParent ^byte/1 [^byte/1 path]
    (let [off (ZipFileSystem/getParentOff path)] (if (<= off 1) ROOTPATH (Arrays/copyOf path off))))

  (method ^:private ^:static getParentOff ^int [^byte/1 path]
    (let [^:mutable off (unchecked-subtract-int (alength path) 1)]
      (when (and (> off 0) (== (aget path off) \/)) (set! off (unchecked-dec-int off)))
      (while (and (> off 0) (not (== (aget path off) \/))) (set! off (unchecked-dec-int off)))
      off))

  (method ^:private beginWrite ^void [this] (.lock (.writeLock rwlock)))

  (method ^:private endWrite ^void [this] (.unlock (.writeLock rwlock)))

  (method ^:private beginRead ^void [this] (.lock (.readLock rwlock)))

  (method ^:private endRead ^void [this] (.unlock (.readLock rwlock)))

  (field ^:private ^:volatile ^boolean isOpen true)

  (field ^:private ^:final ^SeekableByteChannel ch)

  (field ^:final ^byte/1 cen)

  (field ^:private ^END end)

  (field ^:private ^long locpos)

  (field ^:private ^:final ^ReadWriteLock rwlock (ReentrantReadWriteLock.))

  (field ^:private ^{:tag (LinkedHashMap IndexNode IndexNode)} inodes)

  (method ^:final getBytes ^byte/1 [this ^String name]
    (.getBytes zc name))

  (method ^:final getString ^String [this ^byte/1 name]
    (.toString zc name))

  (method ^:protected finalize :throws [IOException] ^void [this]
    (.close this))

  (method ^:final readNBytesAt :throws [IOException] ^long [this ^byte/1 buf ^int off ^long len
                                                            ^:mutable ^long pos]
    (let [bb (ByteBuffer/wrap buf)]
      (.position bb off)
      (.limit bb (unchecked-int (unchecked-add off len)))
      (let [^:mutable totalRead 0]
        (while (< totalRead len)
          (let [n (.readAt this bb pos)]
            (when (< n 0) (break))
            (set! pos (unchecked-add pos n))
            (set! totalRead (unchecked-add totalRead n))))
        totalRead)))

  (method ^:private readAt :throws [IOException] ^int [this ^ByteBuffer bb ^long pos]
    (if-instance [^FileChannel fc ch] (.read fc bb pos) (locking ch (.read (.position ch pos) bb))))

  (method ^:private findEND :throws [IOException] ^END [this]
    (let [^:mutable buf (new byte/1 ZipConstants/READBLOCKSZ)
          ziplen (.size ch)
          minHDR (if (> (unchecked-subtract ziplen ZipConstants/END_MAXLEN) 0)
                     (unchecked-subtract ziplen ZipConstants/END_MAXLEN)
                     0)
          minPos (unchecked-subtract minHDR
                                     (unchecked-subtract-int (alength buf) ZipConstants/ENDHDR))]
      (loop [pos (unchecked-subtract ziplen (alength buf))]
        (when (>= pos minPos)
          (let [^:mutable ^int off 0]
            (when (< pos 0)
              (set! off (unchecked-int (unchecked-negate pos)))
              (Arrays/fill buf 0 off (unchecked-byte 0)))
            (let [len (unchecked-subtract-int (alength buf) off)]
              (when-not (== (.readNBytesAt this buf off len (unchecked-add pos off)) len)
                (throw (ZipException. "zip END header not found")))
              (loop [^int i (unchecked-subtract-int (alength buf) ZipConstants/ENDHDR)]
                (if (>= i 0)
                    (if (and (and (and (and (== (aget buf i) (unchecked-byte \P))
                                            (== (aget buf (unchecked-add-int i 1))
                                                (unchecked-byte \K)))
                                       (== (aget buf (unchecked-add-int i 2))
                                           (unchecked-byte \u0005)))
                                  (== (aget buf (unchecked-add-int i 3)) (unchecked-byte \u0006)))
                             (== (unchecked-add
                                   (unchecked-add (unchecked-add pos i) ZipConstants/ENDHDR)
                                   (ZipConstants/ENDCOM buf i))
                                 ziplen))
                        (do
                          (set!
                            buf
                            (Arrays/copyOfRange buf i (unchecked-add-int i ZipConstants/ENDHDR)))
                          (let [end (END.)]
                            (set! (.-centot end) (ZipConstants/ENDTOT buf))
                            (set! (.-cenlen end) (ZipConstants/ENDSIZ buf))
                            (set! (.-cenoff end) (ZipConstants/ENDOFF buf))
                            (set! (.-endpos end) (unchecked-add pos i))
                            (let [loc64 (new byte/1 ZipConstants/ZIP64_LOCHDR)]
                              (when (or (or (< (.-endpos end) ZipConstants/ZIP64_LOCHDR)
                                            (not
                                              (==
                                                (.readNBytesAt
                                                  this
                                                  loc64
                                                  0
                                                  (alength loc64)
                                                  (unchecked-subtract
                                                    (.-endpos end)
                                                    ZipConstants/ZIP64_LOCHDR))
                                                (alength loc64))))
                                        (not (ZipConstants/locator64SigAt loc64 0)))
                                (return end))
                              (let [end64pos (ZipConstants/ZIP64_LOCOFF loc64)
                                    end64buf (new byte/1 ZipConstants/ZIP64_ENDHDR)]
                                (when (or (not (==
                                                 (.readNBytesAt
                                                   this
                                                   end64buf
                                                   0
                                                   (alength end64buf)
                                                   end64pos)
                                                 (alength end64buf)))
                                          (not (ZipConstants/end64SigAt end64buf 0)))
                                  (return end))
                                (let [cenlen64 (ZipConstants/ZIP64_ENDSIZ end64buf)
                                      cenoff64 (ZipConstants/ZIP64_ENDOFF end64buf)
                                      centot64 (ZipConstants/ZIP64_ENDTOT end64buf)]
                                  (when (or
                                          (or
                                            (and
                                              (not (== cenlen64 (.-cenlen end)))
                                              (not (== (.-cenlen end) ZipConstants/ZIP64_MINVAL)))
                                            (and
                                              (not (== cenoff64 (.-cenoff end)))
                                              (not (== (.-cenoff end) ZipConstants/ZIP64_MINVAL))))
                                          (and
                                            (not (== centot64 (.-centot end)))
                                            (not (== (.-centot end) ZipConstants/ZIP64_MINVAL32))))
                                    (return end))
                                  (set! (.-cenlen end) cenlen64)
                                  (set! (.-cenoff end) cenoff64)
                                  (set! (.-centot end) (unchecked-int centot64))
                                  (set! (.-endpos end) end64pos)
                                  (return end))))))
                        (recur (unchecked-dec-int i)))
                    nil))
              (recur
                (unchecked-subtract pos (unchecked-subtract-int (alength buf) ZipConstants/ENDHDR)))))))
      (throw (ZipException. "zip END header not found"))))

  (method ^:private makeParentDirs ^void [this ^:mutable ^IndexNode node ^IndexNode root]
    (let [^:mutable ^IndexNode parent nil
          ^:mutable lookup (ParentLookup.)]
      (while true
        (let [off (ZipFileSystem/getParentOff (.-name node))]
          (when (<= off 1)
            (set! (.-sibling node) (.-child root))
            (set! (.-child root) node)
            (break))
          (set! lookup (.as lookup (.-name node) off))
          (set! parent (cast IndexNode (.get inodes lookup)))
          (when (some? parent)
            (set! (.-sibling node) (.-child parent))
            (set! (.-child parent) node)
            (break))
          (set! parent (IndexNode. (Arrays/copyOf (.-name node) off) true))
          (.put inodes parent parent)
          (set! (.-sibling node) (.-child parent))
          (set! (.-child parent) node)
          (set! node parent)))))

  (method ^:private buildNodeTree ^void [this]
    (.beginWrite this)
    (try
      (let [^:mutable root (cast IndexNode (.remove inodes (.as LOOKUPKEY ROOTPATH)))]
        (when (nil? root) (set! root (IndexNode. ROOTPATH true)))
        (let [nodes (cast IndexNode/1 (.toArray (.values inodes) (new IndexNode/1 0)))]
          (.put inodes root root)
          (for-each [^IndexNode node nodes] (.makeParentDirs this node root))))
      (finally (.endWrite this))))

  (method ^:private removeFromTree ^void [this ^IndexNode inode]
    (let [parent (cast IndexNode
                       (.get inodes (.as LOOKUPKEY (ZipFileSystem/getParent (.-name inode)))))
          ^:mutable child (.-child parent)]
      (if (.equals child inode)
          (set! (.-child parent) (.-sibling child))
          (let [^:mutable last child]
            (while (some? (set! child (.-sibling child)))
              (if (.equals child inode)
                  (do (set! (.-sibling last) (.-sibling child)) (break))
                  (set! last child)))))))

  (method ^:private determineReleaseVersion :throws [IOException] ^{:tag (Optional Integer)} [this
                                                                                              ^{:tag (Map String ?)} env]
    (let [o (if (.containsKey env PROPERTY_RELEASE_VERSION)
                (.get env PROPERTY_RELEASE_VERSION)
                (.get env PROPERTY_MULTI_RELEASE))]
      (if (or (nil? o) (not (.isMultiReleaseJar this)))
          (Optional/empty)
          (let [^int version (switch o
                               [^String s :when (.equals s "runtime")] (.feature (Runtime/version))
                               [^String s :when (.matches s "^[1-9][0-9]*$")]
                                 (.feature (Runtime$Version/parse s))
                               [^Integer i] (.feature (Runtime$Version/parse (.toString i)))
                               [^Runtime$Version v] (.feature v)
                               [^String s]
                                 (throw (IllegalArgumentException.
                                          (java-str "Invalid runtime version: " s)))
                               (throw (IllegalArgumentException.
                                        "env parameter must be String, Integer, or Version")))]
            (Optional/of (^[int int] Math/max version 0))))))

  (method ^:private isMultiReleaseJar :throws [IOException] ^boolean [this]
    (try
      (with-resources [is (.newInputStream this (.getBytes this "/META-INF/MANIFEST.MF"))]
        (let [multiRelease (.getValue (.getMainAttributes (Manifest. is))
                                      Attributes$Name/MULTI_RELEASE)]
          (.equalsIgnoreCase "true" multiRelease)))
      (catch NoSuchFileException x false)))

  (method ^:private createVersionedLinks ^{:tag (Function byte/1 byte/1)} [this ^int version]
    (let [verdir (.getInode this (.getBytes this "/META-INF/versions"))]
      (if (nil? verdir)
          (Function/identity)
          (let [^{:tag (HashMap IndexNode byte/1)} aliasMap (HashMap.)]
            (.forEach (.values (.getVersionMap this version verdir))
                      (lambda Consumer ^void [^IndexNode versionNode]
                        (.walk this
                               (.-child versionNode)
                               (lambda Consumer ^void [^IndexNode entryNode]
                                 (.put aliasMap
                                       (.getOrCreateInode
                                         this
                                         (.getRootName this entryNode versionNode)
                                         (.-isdir entryNode))
                                       (.-name entryNode))))))
            (lambda Function ^byte/1 [^byte/1 path]
              (cast byte/1 (.getOrDefault aliasMap (IndexNode/keyOf path) path)))))))

  (method lookupPath ^byte/1 [this ^byte/1 resolvedPath]
    (cast byte/1 (.apply entryLookup resolvedPath)))

  (method ^:private getVersionMap ^{:tag (TreeMap Integer IndexNode)} [this ^int version
                                                                       ^IndexNode metaInfVersions]
    (let [^{:tag (TreeMap Integer IndexNode)} map (TreeMap.)
          ^:mutable child (.-child metaInfVersions)]
      (while (some? child)
        (let [key (.getVersion this child metaInfVersions)]
          (when (and (some? key) (<= key version)) (.put map key child))
          (set! child (.-sibling child))))
      map))

  (method ^:private getVersion ^Integer [this ^IndexNode inode ^IndexNode metaInfVersions]
    (try
      (let [fullName (.-name inode)]
        (Integer/parseInt
          (.getString this
                      (Arrays/copyOfRange fullName
                                          (unchecked-add-int (alength (.-name metaInfVersions)) 1)
                                          (alength fullName)))))
      (catch NumberFormatException x nil)))

  (method ^:private walk ^void [this ^IndexNode inode ^{:tag (Consumer IndexNode)} consumer]
    (when (some? inode)
      (if (.isDir inode) (.walk this (.-child inode) consumer) (.accept consumer inode))
      (.walk this (.-sibling inode) consumer)))

  (method ^:private getRootName ^byte/1 [this ^IndexNode inode ^IndexNode prefix]
    (let [fullName (.-name inode)]
      (Arrays/copyOfRange fullName (alength (.-name prefix)) (alength fullName))))

  (method ^:private initCEN :throws [IOException] ^byte/1 [this]
    (set! end (.findEND this))
    (if (== (.-endpos end) 0)
        (do (set! inodes (LinkedHashMap. 10)) (set! locpos 0) (.buildNodeTree this) nil)
        (do
          (when (> (.-cenlen end) (.-endpos end))
            (throw (ZipException. "invalid END header (bad central directory size)")))
          (let [cenpos (unchecked-subtract (.-endpos end) (.-cenlen end))]
            (set! locpos (unchecked-subtract cenpos (.-cenoff end)))
            (when (< locpos 0)
              (throw (ZipException. "invalid END header (bad central directory offset)")))
            (let [cen (new byte/1
                           (unchecked-int (unchecked-add (.-cenlen end) ZipConstants/ENDHDR)))]
              (when-not (== (.readNBytesAt this cen 0 (alength cen) cenpos)
                            (unchecked-add (.-cenlen end) ZipConstants/ENDHDR))
                (throw (ZipException. "read CEN tables failed")))
              (set! inodes (LinkedHashMap/newLinkedHashMap (unchecked-add-int (.-centot end) 1)))
              (let [^:mutable ^int pos 0
                    limit (unchecked-subtract-int (alength cen) ZipConstants/ENDHDR)]
                (while (< pos limit)
                  (when-not (ZipConstants/cenSigAt cen pos)
                    (throw (ZipException. "invalid CEN header (bad signature)")))
                  (let [method (ZipConstants/CENHOW cen pos)
                        nlen (ZipConstants/CENNAM cen pos)
                        elen (ZipConstants/CENEXT cen pos)
                        clen (ZipConstants/CENCOM cen pos)
                        flag (ZipConstants/CENFLG cen pos)
                        csize (ZipConstants/CENSIZ cen pos)
                        size (ZipConstants/CENLEN cen pos)
                        locoff (ZipConstants/CENOFF cen pos)
                        diskNo (ZipConstants/CENDSK cen pos)]
                    (when-not (== (bit-and-int flag 1) 0)
                      (throw (ZipException. "invalid CEN header (encrypted entry)")))
                    (when (and (not (== method ZipConstants/METHOD_STORED))
                               (not (== method ZipConstants/METHOD_DEFLATED)))
                      (throw (ZipException.
                               (java-str "invalid CEN header (unsupported compression method: "
                                         method
                                         ")"))))
                    (let [headerSize (unchecked-add
                                       (unchecked-add
                                         (unchecked-add (long ZipConstants/CENHDR) nlen)
                                         clen)
                                       elen)]
                      (when (or (> headerSize 0xFFFF) (> (unchecked-add pos headerSize) limit))
                        (ZipFileSystem/zerror "invalid CEN header (bad header size)"))
                      (cond
                        (> elen 0)
                          (.checkExtraFields this
                                             cen
                                             pos
                                             size
                                             csize
                                             locoff
                                             diskNo
                                             (unchecked-add-int
                                               (unchecked-add-int pos ZipConstants/CENHDR)
                                               nlen)
                                             elen)
                        (and (== elen 0)
                             (or (or (or (== size ZipConstants/ZIP64_MINVAL)
                                         (== csize ZipConstants/ZIP64_MINVAL))
                                     (== locoff ZipConstants/ZIP64_MINVAL))
                                 (== diskNo ZipConstants/ZIP64_MINVAL32)))
                          (throw
                            (ZipException. "Invalid CEN header (invalid zip64 extra len size)")))
                      (let [inode (IndexNode. cen pos nlen)]
                        (when (.pathHasDotOrDotDot inode)
                          (throw (ZipException.
                                   (java-str
                                     "ZIP file can't be opened as a file system because entry \""
                                     (.nameAsString inode)
                                     "\" has a '.' or '..' element in its name"))))
                        (.put inodes inode inode)
                        (if (or (.isUTF8 zc)
                                (not (== (bit-and-int flag ZipConstants/FLAG_USE_UTF8) 0)))
                            (.checkUTF8 this (.-name inode))
                            (.checkEncoding this (.-name inode)))
                        (set! pos
                              (unchecked-add-int
                                pos
                                (unchecked-add-int
                                  (unchecked-add-int
                                    (unchecked-add-int ZipConstants/CENHDR nlen)
                                    elen)
                                  clen)))))))
                (when-not (== (unchecked-add-int pos ZipConstants/ENDHDR) (alength cen))
                  (throw (ZipException. "invalid CEN header (bad header size)")))
                (.buildNodeTree this)
                cen))))))

  (method ^:private checkExtraFields :throws [ZipException] ^void [this ^byte/1 cen ^int cenPos
                                                                   ^long size ^long csize
                                                                   ^long locoff ^int diskNo
                                                                   ^int startingOffset
                                                                   ^int extraFieldLen]
    (when (> extraFieldLen 0xFFFF) (ZipFileSystem/zerror "invalid extra field length"))
    (let [extraEndOffset (unchecked-add-int startingOffset extraFieldLen)]
      (when (> extraEndOffset (unchecked-subtract-int (alength cen) ZipConstants/ENDHDR))
        (ZipFileSystem/zerror "Invalid CEN header (extra data field size too long)"))
      (let [^:mutable currentOffset startingOffset]
        (while (<= (unchecked-add-int currentOffset Integer/BYTES) extraEndOffset)
          (let [tag (ZipConstants/SH cen currentOffset)]
            (set! currentOffset (unchecked-add-int currentOffset Short/BYTES))
            (let [tagBlockSize (ZipConstants/SH cen currentOffset)]
              (set! currentOffset (unchecked-add-int currentOffset Short/BYTES))
              (let [tagBlockEndingOffset (unchecked-add (long currentOffset) tagBlockSize)]
                (when (> tagBlockEndingOffset extraEndOffset)
                  (ZipFileSystem/zerror
                    (String/format
                      "Invalid CEN header (invalid extra data field size for tag: 0x%04x at %d)"
                      (new Object/1 [tag cenPos]))))
                (when (== tag ZipConstants/EXTID_ZIP64)
                  (.checkZip64ExtraFieldValues this
                                               cen
                                               currentOffset
                                               tagBlockSize
                                               csize
                                               size
                                               locoff
                                               diskNo))
                (set! currentOffset (unchecked-add-int currentOffset tagBlockSize)))))))))

  (method ^:private checkZip64ExtraFieldValues :throws [ZipException] ^void [this ^byte/1 cen
                                                                             ^:mutable ^int off
                                                                             ^:mutable ^int blockSize
                                                                             ^long csize ^long size
                                                                             ^long locoff
                                                                             ^int diskNo]
    (if (== blockSize 0)
        (when (or (or (or (== csize ZipConstants/ZIP64_MINVAL) (== size ZipConstants/ZIP64_MINVAL))
                      (== locoff ZipConstants/ZIP64_MINVAL))
                  (== diskNo ZipConstants/ZIP64_MINVAL32))
          (ZipFileSystem/zerror "Invalid CEN header (invalid zip64 extra data field size)"))
        (do
          (when-not (ZipFileSystem/isZip64ExtBlockSizeValid blockSize csize size locoff diskNo)
            (ZipFileSystem/zerror "Invalid CEN header (invalid zip64 extra data field size)"))
          (when (== size ZipConstants/ZIP64_MINVAL)
            (if (>= blockSize Long/BYTES)
                (do
                  (when (< (ZipConstants/LL cen off) 0)
                    (ZipFileSystem/zerror "Invalid zip64 extra block size value"))
                  (set! off (unchecked-add-int off Long/BYTES))
                  (set! blockSize (unchecked-subtract-int blockSize Long/BYTES)))
                (ZipFileSystem/zerror "Invalid Zip64 extra block, missing size")))
          (when (== csize ZipConstants/ZIP64_MINVAL)
            (if (>= blockSize Long/BYTES)
                (do
                  (when (< (ZipConstants/LL cen off) 0)
                    (ZipFileSystem/zerror "Invalid zip64 extra block compressed size value"))
                  (set! off (unchecked-add-int off Long/BYTES))
                  (set! blockSize (unchecked-subtract-int blockSize Long/BYTES)))
                (ZipFileSystem/zerror "Invalid Zip64 extra block, missing compressed size")))
          (when (== locoff ZipConstants/ZIP64_MINVAL)
            (if (>= blockSize Long/BYTES)
                (when (< (ZipConstants/LL cen off) 0)
                  (ZipFileSystem/zerror "Invalid zip64 extra block LOC OFFSET value"))
                (ZipFileSystem/zerror "Invalid Zip64 extra block, missing LOC offset value"))))))

  (method ^:private ^:static isZip64ExtBlockSizeValid ^boolean [^int blockSize ^long csize
                                                                ^long size ^long locoff ^int diskNo]
    (let [expectedBlockSize (unchecked-add-int
                              (unchecked-add-int
                                (unchecked-add-int
                                  (if (== csize ZipConstants/ZIP64_MINVAL) Long/BYTES 0)
                                  (if (== size ZipConstants/ZIP64_MINVAL) Long/BYTES 0))
                                (if (== locoff ZipConstants/ZIP64_MINVAL) Long/BYTES 0))
                              (if (== diskNo ZipConstants/ZIP64_MINVAL32) Integer/BYTES 0))]
      (== expectedBlockSize blockSize)))

  (method ^:private ^:final checkUTF8 :throws [ZipException] ^void [this ^byte/1 a]
    (try
      (let [end (alength a)
            ^:mutable ^int pos 0]
        (while (< pos end)
          (when (< (aget a pos) 0) (.toString zc (Arrays/copyOfRange a pos (alength a))) (break))
          (set! pos (unchecked-inc-int pos))))
      (catch Exception e (throw (ZipException. "invalid CEN header (bad entry name)")))))

  (method ^:private ^:static zerror :throws [ZipException] ^void [^String msg]
    (throw (ZipException. msg)))

  (method ^:private ^:final checkEncoding :throws [ZipException] ^void [this ^byte/1 a]
    (try
      (.toString zc a)
      (catch Exception e (throw (ZipException. "invalid CEN header (bad entry name)")))))

  (method ^:private ensureOpen ^void [this]
    (when-not isOpen (throw (ClosedFileSystemException.))))

  (method ^:private createTempFileInSameDirectoryAs :throws [IOException] ^Path [this ^Path path]
    (let [parent (.getParent (.toAbsolutePath path))
          ^Path dir (if (nil? parent) (.getPath (.getFileSystem path) ".") parent)
          tmpPath (Files/createTempFile dir "zipfstmp" nil (new FileAttribute/1 []))]
      (.add tmppaths tmpPath)
      tmpPath))

  (field ^:private ^boolean hasUpdate false)

  (field ^:private ^:final ^IndexNode LOOKUPKEY (IndexNode. nil -1))

  (method ^:private updateDelete ^void [this ^IndexNode inode]
    (.beginWrite this)
    (try
      (.removeFromTree this inode)
      (.remove inodes inode)
      (set! hasUpdate true)
      (finally (.endWrite this))))

  (method ^:private update ^void [this ^Entry e]
    (.beginWrite this)
    (try
      (let [old (cast IndexNode (.put inodes e e))]
        (when (some? old) (.removeFromTree this old))
        (when (or (or (== (.-type e) Entry/NEW) (== (.-type e) Entry/FILECH))
                  (== (.-type e) Entry/COPY))
          (let [parent (cast IndexNode
                             (.get inodes (.as LOOKUPKEY (ZipFileSystem/getParent (.-name e)))))]
            (set! (.-sibling e) (.-child parent))
            (set! (.-child parent) e)))
        (set! hasUpdate true))
      (finally (.endWrite this))))

  (method ^:private copyLOCEntry :throws [IOException] ^long [this ^Entry e ^boolean updateHeader
                                                              ^OutputStream os
                                                              ^:mutable ^long written ^byte/1 buf]
    (let [^:mutable locoff (.-locoff e)]
      (set! (.-locoff e) written)
      (let [^:mutable size 0]
        (when-not (== (bit-and-int (.-flag e) ZipConstants/FLAG_DATADESCR) 0)
          (if (or (>= (.-size e) ZipConstants/ZIP64_MINVAL)
                  (>= (.-csize e) ZipConstants/ZIP64_MINVAL))
              (set! size 24)
              (set! size 16)))
        (when-not (== (.readNBytesAt this buf 0 (unchecked-add-int ZipConstants/LOCHDR 1) locoff)
                      (unchecked-add-int ZipConstants/LOCHDR 1))
          (throw (ZipException. "loc: reading failed")))
        (if (or updateHeader
                (and (> (ZipConstants/LOCNAM buf) 0) (== (aget buf ZipConstants/LOCHDR) \/)))
            (do
              (set! locoff
                    (unchecked-add locoff
                                   (unchecked-add-int
                                     (unchecked-add-int
                                       ZipConstants/LOCHDR
                                       (ZipConstants/LOCNAM buf))
                                     (ZipConstants/LOCEXT buf))))
              (set! size (unchecked-add size (.-csize e)))
              (set! written (unchecked-add (.writeLOC e os) size)))
            (do
              (.write os buf 0 ZipConstants/LOCHDR)
              (set! locoff (unchecked-add locoff ZipConstants/LOCHDR))
              (set! size
                    (unchecked-add size
                                   (unchecked-add
                                     (unchecked-add-int
                                       (ZipConstants/LOCNAM buf)
                                       (ZipConstants/LOCEXT buf))
                                     (.-csize e))))
              (set! written (unchecked-add ZipConstants/LOCHDR size))))
        (let [^:mutable ^int n 0]
          (while (and (> size 0)
                      (not (== (set!
                                 n
                                 (unchecked-int (.readNBytesAt this buf 0 (alength buf) locoff)))
                               -1)))
            (when (< size n) (set! n (unchecked-int size)))
            (.write os buf 0 n)
            (set! size (unchecked-subtract size n))
            (set! locoff (unchecked-add locoff n)))
          written))))

  (method ^:private writeEntry :throws [IOException] ^long [this ^Entry e ^OutputStream os]
    (if (and (nil? (.-bytes e)) (nil? (.-file e)))
        0
        (let [^:mutable written 0]
          (if (and (and (not (== (.-method e) ZipConstants/METHOD_STORED)) (> (.-csize e) 0))
                   (or (not (== (.-crc e) 0)) (== (.-size e) 0)))
              (.writeTo this e os)

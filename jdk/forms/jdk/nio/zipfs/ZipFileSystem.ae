          (when-not (== (bit-and-int (.-flag e) ZipConstants/FLAG_DATADESCR) 0)
            (set! written (unchecked-add written (.writeEXT e os))))
          written)))

  (method ^:private writeTo :throws [IOException] ^void [this ^Entry e ^OutputStream os]
    (if (some? (.-bytes e))
        (.write os (.-bytes e) 0 (alength (.-bytes e)))
        (when (some? (.-file e))
          (when (or (== (.-type e) Entry/NEW) (== (.-type e) Entry/FILECH))
            (with-resources [is (Files/newInputStream (.-file e))] (.transferTo is os)))
          (Files/delete (.-file e))
          (.remove tmppaths (.-file e)))))

  (method ^:private sync :throws [IOException] ^void [this]
    (when-not (not hasUpdate)
      (let [attrs (.getPosixAttributes this zfpath)
            tmpFile (.createTempFileInSameDirectoryAs this zfpath)]
        (with-resources [^OutputStream os (BufferedOutputStream.
                                            (Files/newOutputStream tmpFile StandardOpenOption/WRITE))]
          (let [^{:tag (ArrayList Entry)} elist (ArrayList. (.size inodes))
                ^:mutable written 0
                ^:mutable ^byte/1 buf nil
                ^:mutable ^Entry e nil
                manifestInode (cast IndexNode
                                    (.get
                                      inodes
                                      (IndexNode/keyOf (.getBytes this "/META-INF/MANIFEST.MF"))))
                ^{:tag (Iterator IndexNode)} inodeIterator (.iterator (.values inodes))
                ^:mutable manifestProcessed false]
            (while (.hasNext inodeIterator)
              (let [^:mutable ^IndexNode inode nil]
                (cond
                  (nil? manifestInode) (set! inode (cast IndexNode (.next inodeIterator)))
                  manifestProcessed
                    (do
                      (set! inode (cast IndexNode (.next inodeIterator)))
                      (when (identical? inode manifestInode) (continue)))
                  :else (do (set! inode manifestInode) (set! manifestProcessed true)))
                (if (instance? Entry inode)
                    (do
                      (set! e (cast Entry inode))
                      (try
                        (if (== (.-type e) Entry/COPY)
                            (do
                              (when (nil? buf) (set! buf (new byte/1 8192)))
                              (set! written
                                    (unchecked-add
                                      written
                                      (.copyLOCEntry this e true os written buf))))
                            (do
                              (set! (.-locoff e) written)
                              (set! written (unchecked-add written (.writeLOC e os)))
                              (set! written (unchecked-add written (.writeEntry this e os)))))
                        (.add elist e)
                        (catch IOException x (.printStackTrace x))))
                    (when-not (== (.-pos inode) -1)
                      (when-not (and (== (alength (.-name inode)) 1)
                                     (== (aget (.-name inode) 0) \/))
                        (set! e
                              (if supportPosix ^Entry (PosixEntry. this inode) (Entry. this inode)))
                        (try
                          (when (nil? buf) (set! buf (new byte/1 8192)))
                          (set! written
                                (unchecked-add written (.copyLOCEntry this e false os written buf)))
                          (.add elist e)
                          (catch IOException x (.printStackTrace x))))))))
            (set! (.-cenoff end) written)
            (for-each [^Entry entry elist]
              (set! written (unchecked-add written (.writeCEN entry os))))
            (set! (.-centot end) (.size elist))
            (set! (.-cenlen end) (unchecked-subtract written (.-cenoff end)))
            (.write end os written forceEnd64)))
        (.close ch)
        (Files/delete zfpath)
        (when (some? attrs) (Files/setPosixFilePermissions tmpFile (.permissions attrs)))
        (Files/move tmpFile zfpath StandardCopyOption/REPLACE_EXISTING)
        (set! hasUpdate false))))

  (method ^:private getPosixAttributes :throws [IOException] ^PosixFileAttributes [this ^Path path]
    (try
      (let [view (cast PosixFileAttributeView
                       (Files/getFileAttributeView path PosixFileAttributeView))]
        (when (some? view) (.readAttributes view)))
      (catch UnsupportedOperationException e nil)))

  (method ^:private getInode ^IndexNode [this ^byte/1 path]
    (cast IndexNode
          (.get inodes
                (IndexNode/keyOf
                  (cast byte/1
                        (Objects/requireNonNull (cast byte/1 (.apply entryLookup path)) "path"))))))

  (method ^:private getOrCreateInode ^IndexNode [this ^byte/1 path ^boolean isdir]
    (let [^:mutable node (.getInode this path)]
      (if (some? node)
          node
          (do
            (set! node (IndexNode. path isdir))
            (.beginWrite this)
            (try
              (.makeParentDirs this
                               node
                               (cast IndexNode
                                     (Objects/requireNonNull
                                       (cast IndexNode (.get inodes (IndexNode/keyOf ROOTPATH)))
                                       "no root node found")))
              node
              (finally (.endWrite this)))))))

  (method ^:private getEntry :throws [IOException] ^Entry [this ^byte/1 path]
    (let [inode (.getInode this path)]
      (if (instance? Entry inode)
          (cast Entry inode)
          (when-not (or (nil? inode) (== (.-pos inode) -1))
            (if supportPosix ^Entry (PosixEntry. this inode) (Entry. this inode))))))

  (method ^:public deleteFile :throws [IOException] ^void [this ^byte/1 path
                                                           ^boolean failIfNotExists]
    (.checkWritable this)
    (let [inode (.getInode this path)]
      (if (nil? inode)
          (do
            (when (and (some? path) (== (alength path) 0))
              (throw (ZipException. "root directory </> cannot be deleted")))
            (when failIfNotExists (throw (NoSuchFileException. (.getString this path)))))
          (do
            (when (and (.isDir inode) (some? (.-child inode)))
              (throw (DirectoryNotEmptyException. (.getString this path))))
            (.updateDelete this inode)))))

  (method ^:private getOutputStream :throws [IOException] ^OutputStream [this ^Entry e]
    (when (== (.-mtime e) -1) (set! (.-mtime e) (System/currentTimeMillis)))
    (when (== (.-method e) -1) (set! (.-method e) defaultCompressionMethod))
    (set! (.-flag e) ZipConstants/FLAG_DATADESCR)
    (when (.isUTF8 zc) (set! (.-flag e) (bit-or-int (.-flag e) ZipConstants/FLAG_USE_UTF8)))
    (let [^:mutable ^OutputStream os nil]

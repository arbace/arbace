                                                       ListenerNotFoundException] ^void [this
                                                                                         ^ObjectName name
                                                                                         ^ObjectName listener
                                                                                         ^NotificationFilter filter
                                                                                         handback]
    (let [instance (.getListener this listener)]
      (when (.isLoggable JmxProperties/MBEANSERVER_LOGGER SystemLoggers$Logger$Level/TRACE)
        (.log JmxProperties/MBEANSERVER_LOGGER
              SystemLoggers$Logger$Level/TRACE
              (java-str "ObjectName = " name ", Listener = " listener)))
      (.removeNotificationListener server name instance filter handback)))

  (method ^:private getListener :throws [ListenerNotFoundException] ^NotificationListener [this
                                                                                           ^ObjectName listener]
    (let [^:mutable ^DynamicMBean instance nil]
      (try
        (set! instance (.getMBean this listener))
        (catch InstanceNotFoundException e
          (throw (cast ListenerNotFoundException
                       (EnvHelp/initCause (ListenerNotFoundException. (.getMessage e)) e)))))
      (let [resource (DefaultMBeanServerInterceptor/getResource instance)]
        (when-not (instance? NotificationListener resource)
          (let [^RuntimeException exc (IllegalArgumentException. (.getCanonicalName listener))
                msg (java-str "MBean "
                              (.getCanonicalName listener)
                              " does not implement "
                              (.getName NotificationListener))]
            (throw (RuntimeOperationsException. exc msg))))
        (cast NotificationListener resource))))

  (method ^:private removeNotificationListener :throws [InstanceNotFoundException
                                                        ListenerNotFoundException] ^void [this
                                                                                          ^ObjectName name
                                                                                          ^NotificationListener listener
                                                                                          ^NotificationFilter filter
                                                                                          handback
                                                                                          ^boolean removeAll]
    (when (.isLoggable JmxProperties/MBEANSERVER_LOGGER SystemLoggers$Logger$Level/TRACE)
      (.log JmxProperties/MBEANSERVER_LOGGER
            SystemLoggers$Logger$Level/TRACE
            (java-str "ObjectName = " name)))
    (let [instance (.getMBean this name)
          ^{:tag (Class (? extends NotificationBroadcaster))} reqClass (if removeAll
                                                                           NotificationBroadcaster
                                                                           NotificationEmitter)
          broadcaster (DefaultMBeanServerInterceptor/getNotificationBroadcaster
                        name
                        instance
                        reqClass)
          listenerWrapper (.getListenerWrapper this listener name instance false)]
      (when (nil? listenerWrapper) (throw (ListenerNotFoundException. "Unknown listener")))
      (if removeAll
          (.removeNotificationListener broadcaster listenerWrapper)
          (let [emitter (cast NotificationEmitter broadcaster)]
            (.removeNotificationListener emitter listenerWrapper filter handback)))))

  (method ^:private ^:static getNotificationBroadcaster :type-params [(T
                                                                        extends
                                                                        NotificationBroadcaster)] ^T [^ObjectName name
                                                                                                      ^:mutable instance
                                                                                                      ^{:tag (Class T)} reqClass]
    (if (.isInstance reqClass instance)
        (cast NotificationBroadcaster (.cast reqClass instance))
        (do
          (when (instance? DynamicMBean2 instance)
            (set! instance (.getResource (cast DynamicMBean2 instance))))
          (if (.isInstance reqClass instance)
              (cast NotificationBroadcaster (.cast reqClass instance))
              (let [^RuntimeException exc (IllegalArgumentException. (.getCanonicalName name))
                    msg (java-str "MBean "
                                  (.getCanonicalName name)
                                  " does not implement "
                                  (.getName reqClass))]
                (throw (RuntimeOperationsException. exc msg)))))))

  (method ^:public getMBeanInfo :throws [InstanceNotFoundException
                                         IntrospectionException
                                         ReflectionException] ^MBeanInfo [this ^ObjectName name]
    (let [moi (.getMBean this name)
          ^:mutable ^MBeanInfo mbi nil]
      (try
        (set! mbi (.getMBeanInfo moi))
        (catch [RuntimeMBeanException RuntimeErrorException] e (throw e))
        (catch RuntimeException e
          (throw (RuntimeMBeanException. e "getMBeanInfo threw RuntimeException")))
        (catch Error e (throw (RuntimeErrorException. e "getMBeanInfo threw Error"))))
      (when (nil? mbi) (throw (JMRuntimeException. (java-str "MBean " name "has no MBeanInfo"))))
      mbi))

  (method ^:public isInstanceOf :throws [InstanceNotFoundException] ^boolean [this ^ObjectName name
                                                                              ^String className]
    (let [instance (.getMBean this name)]
      (try
        (let [resource (DefaultMBeanServerInterceptor/getResource instance)
              ^String resourceClassName (if (instance? DynamicMBean resource)
                                            (DefaultMBeanServerInterceptor/getClassName
                                              (cast DynamicMBean resource))
                                            (.getName (.getClass resource)))]
          (if (.equals resourceClassName className)
              true
              (let [cl (.getClassLoader (.getClass resource))
                    ^{:tag (Class ?)} classNameClass (Class/forName className false cl)]
                (if (.isInstance classNameClass resource)
                    true
                    (let [^{:tag (Class ?)} resourceClass (Class/forName resourceClassName false cl)]
                      (.isAssignableFrom classNameClass resourceClass))))))
        (catch Exception x
          (when (.isLoggable JmxProperties/MBEANSERVER_LOGGER SystemLoggers$Logger$Level/DEBUG)
            (.log JmxProperties/MBEANSERVER_LOGGER
                  SystemLoggers$Logger$Level/DEBUG
                  "Exception calling isInstanceOf"
                  x))
          false))))

  (method ^:public getClassLoaderFor :throws [InstanceNotFoundException] ^ClassLoader [this
                                                                                       ^ObjectName mbeanName]
    (let [instance (.getMBean this mbeanName)]
      (.getClassLoader (.getClass (DefaultMBeanServerInterceptor/getResource instance)))))

  (method ^:public getClassLoader :throws [InstanceNotFoundException] ^ClassLoader [this
                                                                                    ^ObjectName loaderName]
    (if (nil? loaderName)
        (.getClassLoader (.getClass server))
        (let [instance (.getMBean this loaderName)
              resource (DefaultMBeanServerInterceptor/getResource instance)]
          (when-not (instance? ClassLoader resource)
            (throw (InstanceNotFoundException.
                     (java-str (.toString loaderName) " is not a classloader"))))
          (cast ClassLoader resource))))

  (method ^:private sendNotification ^void [this ^String NotifType ^ObjectName name]
    (let [notif (MBeanServerNotification. NotifType MBeanServerDelegate/DELEGATE_NAME 0 name)]
      (when (.isLoggable JmxProperties/MBEANSERVER_LOGGER SystemLoggers$Logger$Level/TRACE)
        (.log JmxProperties/MBEANSERVER_LOGGER
              SystemLoggers$Logger$Level/TRACE
              (java-str NotifType " " name)))
      (.sendNotification delegate notif)))

  (method ^:private objectNamesFromFilteredNamedObjects ^{:tag (Set ObjectName)} [this
                                                                                  ^{:tag (Set NamedObject)} list
                                                                                  ^QueryExp query]
    (let [^{:tag (Set ObjectName)} result (HashSet.)]
      (if (nil? query)
          (for-each [^NamedObject no list] (.add result (.getName no)))
          (let [oldServer (QueryEval/getMBeanServer)]
            (.setMBeanServer query server)
            (try
              (for-each [^NamedObject no list]
                (let [^:mutable ^boolean res false]
                  (try (set! res (.apply query (.getName no))) (catch Exception e (set! res false)))
                  (when res (.add result (.getName no)))))
              (finally (.setMBeanServer query oldServer)))))
      result))

  (method ^:private objectInstancesFromFilteredNamedObjects ^{:tag (Set ObjectInstance)} [this
                                                                                          ^{:tag (Set NamedObject)} list
                                                                                          ^QueryExp query]
    (let [^{:tag (Set ObjectInstance)} result (HashSet.)]
      (if (nil? query)
          (for-each [^NamedObject no list]
            (let [obj (.getObject no)
                  className (DefaultMBeanServerInterceptor/safeGetClassName obj)]
              (.add result (ObjectInstance. (.getName no) className))))
          (let [oldServer (QueryEval/getMBeanServer)]
            (.setMBeanServer query server)
            (try
              (for-each [^NamedObject no list]
                (let [obj (.getObject no)
                      ^:mutable ^boolean res false]
                  (try (set! res (.apply query (.getName no))) (catch Exception e (set! res false)))
                  (when res
                    (let [className (DefaultMBeanServerInterceptor/safeGetClassName obj)]
                      (.add result (ObjectInstance. (.getName no) className))))))
              (finally (.setMBeanServer query oldServer)))))
      result))

  (method ^:private ^:static safeGetClassName ^String [^DynamicMBean mbean]
    (try
      (DefaultMBeanServerInterceptor/getClassName mbean)
      (catch Exception e
        (when (.isLoggable JmxProperties/MBEANSERVER_LOGGER SystemLoggers$Logger$Level/DEBUG)
          (.log JmxProperties/MBEANSERVER_LOGGER
                SystemLoggers$Logger$Level/DEBUG
                "Exception getting MBean class name"
                e))
        nil)))

  (method ^:private getListenerWrapper ^NotificationListener [this ^NotificationListener l
                                                              ^ObjectName name ^DynamicMBean mbean
                                                              ^boolean create]
    (let [resource (DefaultMBeanServerInterceptor/getResource mbean)
          wrapper (ListenerWrapper. l name resource)]
      (locking listenerWrappers
        (let [^:mutable ^{:tag (WeakReference ListenerWrapper)} ref (cast
                                                                      WeakReference
                                                                      (.get
                                                                        listenerWrappers
                                                                        wrapper))]
          (when (some? ref)
            (let [existing (cast NotificationListener (.get ref))]
              (when (some? existing) (return existing))))
          (when create
            (set! ref (WeakReference. wrapper))
            (.put listenerWrappers wrapper ref)
            wrapper)))))

  (method ^:public instantiate :throws [ReflectionException MBeanException] [this ^String className]
    (throw (UnsupportedOperationException. "Not supported yet.")))

  (method ^:public instantiate :throws [ReflectionException
                                        MBeanException
                                        InstanceNotFoundException] [this ^String className
                                                                    ^ObjectName loaderName]
    (throw (UnsupportedOperationException. "Not supported yet.")))

  (method ^:public instantiate :throws [ReflectionException MBeanException] [this ^String className
                                                                             ^Object/1 params
                                                                             ^String/1 signature]
    (throw (UnsupportedOperationException. "Not supported yet.")))

  (method ^:public instantiate :throws [ReflectionException
                                        MBeanException
                                        InstanceNotFoundException] [this ^String className
                                                                    ^ObjectName loaderName
                                                                    ^Object/1 params
                                                                    ^String/1 signature]
    (throw (UnsupportedOperationException. "Not supported yet.")))

  (method ^:public getClassLoaderRepository ^ClassLoaderRepository [this]
    (throw (UnsupportedOperationException. "Not supported yet.")))

  (defclass ^:private ^:static ListenerWrapper
    :implements [NotificationListener]

    (constructor [this ^NotificationListener l ^ObjectName name mbean]
      (set! (.-listener this) l)
      (set! (.-name this) name)
      (set! (.-mbean this) mbean))

    (method ^:public handleNotification ^void [this ^Notification notification handback]
      (when (some? notification)
        (when (identical? (.getSource notification) mbean) (.setSource notification name)))
      (.handleNotification listener notification handback))

    (method ^:public equals ^boolean [this o]
      (if (not (instance? ListenerWrapper o))
          false
          (let [w (cast ListenerWrapper o)]
            (and (and (identical? (.-listener w) listener) (identical? (.-mbean w) mbean))
                 (.equals (.-name w) name)))))

    (method ^:public hashCode ^int [this]
      (bit-xor-int (System/identityHashCode listener) (System/identityHashCode mbean)))

    (field ^:private ^NotificationListener listener)

    (field ^:private ^ObjectName name)

    (field ^:private mbean))

  (method ^:private ^:static getClassName ^String [^DynamicMBean mbean]
    (if (instance? DynamicMBean2 mbean)
        (.getClassName (cast DynamicMBean2 mbean))
        (.getClassName (.getMBeanInfo mbean))))

  (defclass ^:private ^:static ^:interface ResourceContext
    :extends [Repository$RegistrationContext]

    (method ^:public done ^void [this])

    (field ^:public ^:static ^:final ^ResourceContext NONE
      (anon ResourceContext []
        (method ^:public done ^void [this])

        (method ^:public registering ^void [this])

        (method ^:public unregistered ^void [this]))))

  (method ^:private registerWithRepository :throws [InstanceAlreadyExistsException
                                                    MBeanRegistrationException] ^ResourceContext [this
                                                                                                  ^:final resource
                                                                                                  ^:final ^DynamicMBean object
                                                                                                  ^:final ^ObjectName logicalName]
    (let [context (.makeResourceContextFor this resource logicalName)]
      (.addMBean repository object logicalName context)
      (when (.isLoggable JmxProperties/MBEANSERVER_LOGGER SystemLoggers$Logger$Level/TRACE)
        (.log JmxProperties/MBEANSERVER_LOGGER
              SystemLoggers$Logger$Level/TRACE
              (java-str "Send create notification of object " (.getCanonicalName logicalName))))
      (.sendNotification this MBeanServerNotification/REGISTRATION_NOTIFICATION logicalName)
      context))

  (method ^:private unregisterFromRepository :throws [InstanceNotFoundException] ^ResourceContext [this
                                                                                                   ^:final resource
                                                                                                   ^:final ^DynamicMBean object
                                                                                                   ^:final ^ObjectName logicalName]
    (let [context (.makeResourceContextFor this resource logicalName)]
      (.remove repository logicalName context)
      (when (.isLoggable JmxProperties/MBEANSERVER_LOGGER SystemLoggers$Logger$Level/TRACE)
        (.log JmxProperties/MBEANSERVER_LOGGER
              SystemLoggers$Logger$Level/TRACE
              (java-str "Send delete notification of object " (.getCanonicalName logicalName))))
      (.sendNotification this MBeanServerNotification/UNREGISTRATION_NOTIFICATION logicalName)
      context))

  (method ^:private addClassLoader ^void [this ^ClassLoader loader ^:final ^ObjectName logicalName]
    (let [clr (.getInstantiatorCLR this)]
      (when (nil? clr)
        (let [^RuntimeException wrapped (IllegalArgumentException.
                                          "Dynamic addition of class loaders is not supported")]
          (throw (RuntimeOperationsException.
                   wrapped
                   "Exception occurred trying to register the MBean as a class loader"))))
      (.addClassLoader clr logicalName loader)))

  (method ^:private removeClassLoader ^void [this ^ClassLoader loader
                                             ^:final ^ObjectName logicalName]
    (when-not (identical? loader (.getClassLoader (.getClass server)))
      (let [clr (.getInstantiatorCLR this)] (when (some? clr) (.removeClassLoader clr logicalName)))))

  (method ^:private createClassLoaderContext ^ResourceContext [this ^:final ^ClassLoader loader
                                                               ^:final ^ObjectName logicalName]
    (anon ResourceContext []
      (method ^:public registering ^void [this]
        (.addClassLoader DefaultMBeanServerInterceptor/this loader logicalName))

      (method ^:public unregistered ^void [this]
        (.removeClassLoader DefaultMBeanServerInterceptor/this loader logicalName))

      (method ^:public done ^void [this])))

  (method ^:private makeResourceContextFor ^ResourceContext [this resource ^ObjectName logicalName]
    (if (instance? ClassLoader resource)
        (.createClassLoaderContext this (cast ClassLoader resource) logicalName)
        ResourceContext/NONE))

  (method ^:private getInstantiatorCLR ^ModifiableClassLoaderRepository [this]
    (when (some? instantiator) (.getClassLoaderRepository instantiator))))

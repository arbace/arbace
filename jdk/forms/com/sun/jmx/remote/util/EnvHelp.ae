  (method ^:public ^:static checkAttributes ^void [^{:tag (Map ? ?)} attributes]
    (for-each [key (.keySet attributes)]
      (when-not (instance? String key)
        (let [^:final msg (java-str "Attributes contain key that is not a string: " key)]
          (throw (IllegalArgumentException. msg))))))

  (method ^:public ^:static filterAttributes :type-params [V] ^{:tag (Map String V)} [^{:tag (Map String V)} attributes]
    (when (.traceOn logger) (.trace logger "filterAttributes" "starts"))
    (let [^{:tag (SortedMap String V)} map (TreeMap. attributes)]
      (EnvHelp/purgeUnserializable (.values map))
      (EnvHelp/hideAttributes map)
      map))

  (method ^:private ^:static purgeUnserializable ^void [^{:tag (Collection ?)} objects]
    (.trace logger "purgeUnserializable" "starts")
    (let [^:mutable ^ObjectOutputStream oos nil
          ^:mutable ^int i 0
          ^{:tag (Iterator ?)} it (.iterator objects)]
      (while (.hasNext it)
        (let [v (.next it)]
          (if (or (nil? v) (instance? String v))
              (when (.traceOn logger)
                (.trace logger "purgeUnserializable" (java-str "Value trivially serializable: " v)))
              (try
                (when (nil? oos) (set! oos (ObjectOutputStream. (SinkOutputStream.))))
                (.writeObject oos v)
                (when (.traceOn logger)
                  (.trace logger "purgeUnserializable" (java-str "Value serializable: " v)))
                (catch IOException e
                  (when (.traceOn logger)
                    (.trace logger
                            "purgeUnserializable"
                            (java-str "Value not serializable: " v ": " e)))
                  (.remove it)
                  (set! oos nil)))))
        (set! i (unchecked-inc-int i)))))

  (field ^:public ^:static ^:final ^String HIDDEN_ATTRIBUTES "jmx.remote.x.hidden.attributes")

  (field ^:public ^:static ^:final ^String DEFAULT_HIDDEN_ATTRIBUTES
    "java.naming.security.* jmx.remote.authenticator jmx.remote.context jmx.remote.default.class.loader jmx.remote.message.connection.server jmx.remote.object.wrapping jmx.remote.rmi.client.socket.factory jmx.remote.rmi.server.socket.factory jmx.remote.sasl.callback.handler jmx.remote.tls.socket.factory jmx.remote.x.access.file jmx.remote.x.password.file ")

  (field ^:private ^:static ^:final ^{:tag (SortedSet String)} defaultHiddenStrings (TreeSet.))

  (field ^:private ^:static ^:final ^{:tag (SortedSet String)} defaultHiddenPrefixes (TreeSet.))

  (method ^:private ^:static hideAttributes ^void [^{:tag (SortedMap String ?)} map]
    (when-not (.isEmpty map)
      (let [^:mutable ^{:tag (SortedSet String)} hiddenStrings nil
            ^:mutable ^{:tag (SortedSet String)} hiddenPrefixes nil
            ^:mutable hide (cast String (.get map HIDDEN_ATTRIBUTES))]
        (if (some? hide)
            (do
              (if (.startsWith hide "=")
                  (set! hide (.substring hide 1))
                  (set! hide (java-str hide (java-str " " DEFAULT_HIDDEN_ATTRIBUTES))))
              (set! hiddenStrings (TreeSet.))
              (set! hiddenPrefixes (TreeSet.))
              (EnvHelp/parseHiddenAttributes hide hiddenStrings hiddenPrefixes))
            (do
              (set! hide DEFAULT_HIDDEN_ATTRIBUTES)
              (locking defaultHiddenStrings
                (when (.isEmpty defaultHiddenStrings)
                  (EnvHelp/parseHiddenAttributes hide defaultHiddenStrings defaultHiddenPrefixes))
                (set! hiddenStrings defaultHiddenStrings)
                (set! hiddenPrefixes defaultHiddenPrefixes))))
        (let [sentinelKey (java-str (cast String (.lastKey map)) "X")
              ^{:tag (Iterator String)} keyIterator (.iterator (.keySet map))
              ^{:tag (Iterator String)} stringIterator (.iterator hiddenStrings)
              ^{:tag (Iterator String)} prefixIterator (.iterator hiddenPrefixes)
              ^:mutable ^String nextString (if (.hasNext stringIterator)
                                               (cast String (.next stringIterator))
                                               sentinelKey)]
          (let [^:mutable ^String nextPrefix (if (.hasNext prefixIterator)
                                                 (cast String (.next prefixIterator))
                                                 sentinelKey)]
            (label :keys
              (while (.hasNext keyIterator)
                (let [key (cast String (.next keyIterator))
                      ^:mutable ^int cmp 1]
                  (while (< (set! cmp (.compareTo nextString key)) 0)
                    (if (.hasNext stringIterator)
                        (set! nextString (cast String (.next stringIterator)))
                        (set! nextString sentinelKey)))
                  (if (== cmp 0)
                      (.remove keyIterator)
                      (while (<= (.compareTo nextPrefix key) 0)
                        (when (.startsWith key nextPrefix) (.remove keyIterator) (continue :keys))
                        (if (.hasNext prefixIterator)
                            (set! nextPrefix (cast String (.next prefixIterator)))
                            (set! nextPrefix sentinelKey))))))))))))

  (method ^:private ^:static parseHiddenAttributes ^void [^String hide
                                                          ^{:tag (SortedSet String)} hiddenStrings
                                                          ^{:tag (SortedSet String)} hiddenPrefixes]
    (let [^:final tok (StringTokenizer. hide)]
      (while (.hasMoreTokens tok)
        (let [s (.nextToken tok)]
          (if (.endsWith s "*")
              (.add hiddenPrefixes (.substring s 0 (unchecked-subtract-int (.length s) 1)))
              (.add hiddenStrings s))))))


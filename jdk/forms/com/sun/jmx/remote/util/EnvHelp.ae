  (method ^:public ^:static computeBooleanFromString ^boolean [^String stringBoolean
                                                               ^boolean defaultValue]
    (cond
      (nil? stringBoolean) defaultValue
      (.equalsIgnoreCase stringBoolean "true") true
      (.equalsIgnoreCase stringBoolean "false") false
      :else
        (throw (IllegalArgumentException.
                 (java-str "Property value must be \"true\" or \"false\" instead of \""
                           stringBoolean
                           "\"")))))

  (method ^:public ^:static mapToHashtable :type-params [K V] ^{:tag (Hashtable K V)} [^{:tag (Map K V)} map]
    (let [^{:tag (HashMap K V)} m (HashMap. map)]
      (.remove m nil)
      (loop [^{:tag (Iterator ?)} i (.iterator (.values m))]
        (if (.hasNext i) (if (nil? (.next i)) (do (.remove i) (recur i)) (recur i)) nil))
      (Hashtable. m)))


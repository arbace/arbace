  (method ^:public ^:static getIntegerAttribute ^long [^{:tag (Map String ?)} env ^String name
                                                       ^long defaultValue ^long minValue
                                                       ^long maxValue]
    (let [^:mutable ^Object o nil]
      (if (or (nil? env) (nil? (set! o (.get env name))))
          defaultValue
          (let [^:mutable ^long result 0]
            (cond
              (instance? Number o) (set! result (.longValue (cast Number o)))
              (instance? String o) (set! result (Long/parseLong (cast String o)))
              :else
                (let [^:final msg (java-str "Attribute "
                                            name
                                            " value must be Integer or String: "
                                            o)]
                  (throw (IllegalArgumentException. msg))))
            (when (< result minValue)
              (let [^:final msg (java-str "Attribute "
                                          name
                                          " value must be at least "
                                          minValue
                                          ": "
                                          result)]
                (throw (IllegalArgumentException. msg))))
            (when (> result maxValue)
              (let [^:final msg (java-str "Attribute "
                                          name
                                          " value must be at most "
                                          maxValue
                                          ": "
                                          result)]
                (throw (IllegalArgumentException. msg))))
            result))))


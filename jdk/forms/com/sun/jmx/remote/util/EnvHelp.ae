  (method ^:public ^:static resolveServerClassLoader :throws [InstanceNotFoundException] ^ClassLoader [^{:tag (Map String ?)} env
                                                                                                       ^MBeanServer mbs]
    (if (nil? env)
        (.getContextClassLoader (Thread/currentThread))
        (let [loader (.get env DEFAULT_CLASS_LOADER)
              name (.get env DEFAULT_CLASS_LOADER_NAME)]
          (when (and (some? loader) (some? name))
            (let [^:const msg (java-str (java-str
                                          (java-str
                                            (java-str "Only one of " DEFAULT_CLASS_LOADER)
                                            " or ")
                                          DEFAULT_CLASS_LOADER_NAME)
                                        " should be specified.")]
              (throw (IllegalArgumentException. msg))))
          (if (and (nil? loader) (nil? name))
              (.getContextClassLoader (Thread/currentThread))
              (do
                (when (some? loader)
                  (if (instance? ClassLoader loader)
                      (return (cast ClassLoader loader))
                      (let [^:final msg (java-str
                                          "ClassLoader object is not an instance of "
                                          (.getName ClassLoader)
                                          " : "
                                          (.getName (.getClass loader)))]
                        (throw (IllegalArgumentException. msg)))))
                (let [^:mutable ^ObjectName on nil]
                  (if (instance? ObjectName name)
                      (set! on (cast ObjectName name))
                      (let [^:final msg (java-str
                                          "ClassLoader name is not an instance of "
                                          (.getName ObjectName)
                                          " : "
                                          (.getName (.getClass name)))]
                        (throw (IllegalArgumentException. msg))))
                  (when (nil? mbs) (throw (IllegalArgumentException. "Null MBeanServer object")))
                  (.getClassLoader mbs on)))))))

  (method ^:public ^:static resolveClientClassLoader ^ClassLoader [^{:tag (Map String ?)} env]
    (if (nil? env)
        (.getContextClassLoader (Thread/currentThread))
        (let [loader (.get env DEFAULT_CLASS_LOADER)]
          (cond
            (nil? loader) (.getContextClassLoader (Thread/currentThread))
            (instance? ClassLoader loader) (cast ClassLoader loader)
            :else
              (let [^:final msg (java-str "ClassLoader object is not an instance of "
                                          (.getName ClassLoader)
                                          " : "
                                          (.getName (.getClass loader)))]
                (throw (IllegalArgumentException. msg)))))))

  (method ^:public ^:static initCause :type-params [(T extends Throwable)] ^T [^T throwable
                                                                               ^Throwable cause]

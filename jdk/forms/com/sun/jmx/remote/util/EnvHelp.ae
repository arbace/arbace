        (let [getCause (.getMethod (.getClass t) "getCause" (cast Class/1 nil))]
          (set! ret (cast Throwable (.invoke getCause t (cast Object/1 nil)))))
        (catch Exception e))
      (if (some? ret) ret t)))

  (field ^:public ^:static ^:final ^String BUFFER_SIZE_PROPERTY
    "jmx.remote.x.notification.buffer.size")

  (method ^:public ^:static getNotifBufferSize ^int [^{:tag (Map String ?)} env]
    (let [^:mutable ^int defaultQueueSize 1000]
      (try
        (let [s (System/getProperty BUFFER_SIZE_PROPERTY)]
          (when (some? s) (set! defaultQueueSize (Integer/parseInt s))))
        (catch RuntimeException e
          (.warning logger
                    "getNotifBufferSize"
                    (java-str (java-str (java-str "Can't use System property " BUFFER_SIZE_PROPERTY)
                                        ": ")
                              e))
          (.debug logger "getNotifBufferSize" e)))
      (let [^:mutable queueSize defaultQueueSize]
        (try
          (when (.containsKey env BUFFER_SIZE_PROPERTY)
            (set! queueSize
                  (unchecked-int
                    (EnvHelp/getIntegerAttribute
                      env
                      BUFFER_SIZE_PROPERTY
                      defaultQueueSize
                      0
                      Integer/MAX_VALUE))))
          (catch RuntimeException e
            (.warning logger
                      "getNotifBufferSize"
                      (java-str "Can't determine queuesize (using default): " e))
            (.debug logger "getNotifBufferSize" e)))
        queueSize)))


(defclass ^:public Introspector
  (constructor ^:private [this])

  (method ^:public ^:static ^:final isDynamic ^boolean [^:final ^{:tag (Class ?)} c]
    (.isAssignableFrom DynamicMBean c))

  (method ^:public ^:static testCreation :throws [NotCompliantMBeanException] ^void [^{:tag (Class ?)} c]
    (let [mods (.getModifiers c)]
      (when (or (Modifier/isAbstract mods) (Modifier/isInterface mods))
        (throw (NotCompliantMBeanException. "MBean class must be concrete")))
      (let [^{:tag (array (Constructor ?))} consList (.getConstructors c)]
        (when (== (alength consList) 0)
          (throw (NotCompliantMBeanException. "MBean class must have public constructor"))))))

  (method ^:public ^:static checkCompliance :throws [NotCompliantMBeanException] ^void [^{:tag (Class ?)} mbeanClass]
    (when-not (.isAssignableFrom DynamicMBean mbeanClass)
      (let [^:mutable ^Exception mbeanException nil]
        (try
          (Introspector/getStandardMBeanInterface mbeanClass)
          (return)
          (catch NotCompliantMBeanException e (set! mbeanException e)))
        (let [^:mutable ^Exception mxbeanException nil]
          (try
            (Introspector/getMXBeanInterface mbeanClass)
            (return)
            (catch NotCompliantMBeanException e (set! mxbeanException e)))
          (let [msg (java-str
                      "MBean class "
                      (.getName mbeanClass)
                      " does not implement DynamicMBean, and neither follows the Standard MBean conventions ("
                      (.toString mbeanException)
                      ") nor the MXBean conventions ("
                      (.toString mxbeanException)
                      ")")]
            (throw (NotCompliantMBeanException. msg)))))))

  (method ^:public ^:static makeDynamicMBean :type-params [T] :throws [NotCompliantMBeanException] ^DynamicMBean [^T mbean]
    (if (instance? DynamicMBean mbean)
        (cast DynamicMBean mbean)
        (let [^{:tag (Class ?)} mbeanClass (.getClass mbean)
              ^:mutable ^{:tag (Class (? super T))} c nil]
          (try
            (set! c (cast Class (Util/cast (Introspector/getStandardMBeanInterface mbeanClass))))
            (catch NotCompliantMBeanException e))
          (if (some? c)
              (StandardMBeanSupport. mbean c)
              (do
                (try
                  (set! c (cast Class (Util/cast (Introspector/getMXBeanInterface mbeanClass))))
                  (catch NotCompliantMBeanException e))
                (if (some? c)
                    (MXBeanSupport. mbean c)
                    (do
                      (Introspector/checkCompliance mbeanClass)
                      (throw (NotCompliantMBeanException. "Not compliant")))))))))

  (method ^:public ^:static testCompliance :throws [NotCompliantMBeanException] ^MBeanInfo [^{:tag (Class ?)} baseClass]
    (when-not (Introspector/isDynamic baseClass) (Introspector/testCompliance baseClass nil)))

  (method ^:public ^:static testComplianceMXBeanInterface :throws [NotCompliantMBeanException] ^void [^{:tag (Class ?)} interfaceClass]
    (.getAnalyzer (MXBeanIntrospector/getInstance) interfaceClass))

  (method ^:public ^:static testComplianceMBeanInterface :throws [NotCompliantMBeanException] ^void [^{:tag (Class ?)} interfaceClass]
    (.getAnalyzer (StandardMBeanIntrospector/getInstance) interfaceClass))

  (method ^:public ^:static ^:synchronized testCompliance :throws [NotCompliantMBeanException] ^MBeanInfo [^:final ^{:tag (Class ?)} baseClass
                                                                                                           ^:mutable ^{:tag (Class ?)} mbeanInterface]
    (when (nil? mbeanInterface)
      (set! mbeanInterface (Introspector/getStandardMBeanInterface baseClass)))
    (let [^{:tag (MBeanIntrospector ?)} introspector (StandardMBeanIntrospector/getInstance)]
      (Introspector/getClassMBeanInfo introspector baseClass mbeanInterface)))

  (method ^:private ^:static getClassMBeanInfo :type-params [M] :throws [NotCompliantMBeanException] ^MBeanInfo [^{:tag (MBeanIntrospector M)} introspector
                                                                                                                 ^{:tag (Class ?)} baseClass
                                                                                                                 ^{:tag (Class ?)} mbeanInterface]
    (let [^{:tag (PerInterface M)} perInterface (.getPerInterface introspector mbeanInterface)]
      (.getClassMBeanInfo introspector baseClass perInterface)))

  (method ^:public ^:static getMBeanInterface ^{:tag (Class ?)} [^{:tag (Class ?)} baseClass]
    (when-not (Introspector/isDynamic baseClass)
      (try
        (Introspector/getStandardMBeanInterface baseClass)
        (catch NotCompliantMBeanException e nil))))

  (method ^:public ^:static getStandardMBeanInterface :type-params [T] :throws [NotCompliantMBeanException] ^{:tag (Class (? super T))} [^{:tag (Class T)} baseClass]
    (let [^:mutable ^{:tag (Class (? super T))} current baseClass
          ^:mutable ^{:tag (Class (? super T))} mbeanInterface nil]
      (while (some? current)
        (set! mbeanInterface (Introspector/findMBeanInterface current (.getName current)))
        (when (some? mbeanInterface) (break))
        (set! current (.getSuperclass current)))
      (if (some? mbeanInterface)
          mbeanInterface
          (let [msg (java-str "Class "
                              (.getName baseClass)
                              " is not a JMX compliant Standard MBean")]
            (throw (NotCompliantMBeanException. msg))))))

  (method ^:public ^:static getMXBeanInterface :type-params [T] :throws [NotCompliantMBeanException] ^{:tag (Class (? super T))} [^{:tag (Class T)} baseClass]
    (try
      (MXBeanSupport/findMXBeanInterface baseClass)
      (catch Exception e (throw (Introspector/throwException baseClass e)))))

  (method ^:private ^:static findMBeanInterface :type-params [T] ^{:tag (Class (? super T))} [^{:tag (Class T)} aClass
                                                                                              ^String aName]
    (let [^:mutable ^{:tag (Class (? super T))} current aClass]
      (while (some? current)
        (let [^{:tag (array (Class ?))} interfaces (.getInterfaces current)
              len (alength interfaces)]
          (loop [^int i 0]
            (when (< i len)
              (let [^:mutable ^{:tag (Class (? super T))} inter (cast
                                                                  Class
                                                                  (Util/cast (aget interfaces i)))]
                (set! inter (Introspector/implementsMBean inter aName))
                (if (some? inter) (return inter) (recur (unchecked-inc-int i))))))
          (set! current (.getSuperclass current))))
      nil))

  (method ^:public ^:static descriptorForElement ^Descriptor [^:final ^AnnotatedElement elmt]
    (if (nil? elmt)
        ImmutableDescriptor/EMPTY_DESCRIPTOR
        (let [annots (.getAnnotations elmt)] (Introspector/descriptorForAnnotations annots))))

  (method ^:public ^:static descriptorForAnnotations ^Descriptor [^Annotation/1 annots]
    (if (== (alength annots) 0)
        ImmutableDescriptor/EMPTY_DESCRIPTOR
        (let [^{:tag (Map String Object)} descriptorMap (HashMap.)]
          (for-each [^Annotation a annots]
            (let [^{:tag (Class (? extends Annotation))} c (.annotationType a)
                  elements (.getMethods c)]
              (for-each [^Method element elements]
                (let [key (cast DescriptorKey (.getAnnotation element DescriptorKey))]
                  (when (some? key)
                    (let [name (.value key)
                          ^:mutable ^Object value nil]
                      (try
                        (set! value (.invoke element a nil))
                        (catch RuntimeException e (throw e))
                        (catch Exception e (throw (UndeclaredThrowableException. e))))
                      (set! value (Introspector/annotationToField value))
                      (let [oldValue (.put descriptorMap name value)]
                        (when (and (some? oldValue) (not (Introspector/equals oldValue value)))
                          (let [msg (java-str "Inconsistent values for descriptor field "
                                              name
                                              " from annotations: "
                                              value
                                              " :: "
                                              oldValue)]
                            (throw (IllegalArgumentException. msg)))))))))))
          (if (.isEmpty descriptorMap)
              ImmutableDescriptor/EMPTY_DESCRIPTOR
              (ImmutableDescriptor. descriptorMap)))))

  (method ^:static throwException :throws [NotCompliantMBeanException SecurityException] ^NotCompliantMBeanException [^{:tag (Class ?)} notCompliant
                                                                                                                      ^Throwable cause]
    (when (instance? SecurityException cause) (throw (cast SecurityException cause)))
    (when (instance? NotCompliantMBeanException cause)
      (throw (cast NotCompliantMBeanException cause)))
    (let [^String classname (if (nil? notCompliant) "null class" (.getName notCompliant))
          ^String reason (if (nil? cause) "Not compliant" (.getMessage cause))
          res (NotCompliantMBeanException. (java-str classname ": " reason))]
      (.initCause res cause)
      (throw res)))

  (method ^:private ^:static annotationToField [x]
    (when (some? x)
      (if (or (or (or (or (instance? Number x) (instance? String x)) (instance? Character x))
                  (instance? Boolean x))
              (instance? String/1 x))
          x
          (let [^:mutable ^{:tag (Class ?)} c (.getClass x)]
            (cond
              (.isArray c)
                (if (.isPrimitive (.getComponentType c))
                    x
                    (let [xx (cast Object/1 x)
                          ss (new String/1 (alength xx))]
                      (loop [^int i 0]
                        (when (< i (alength xx))
                          (aset ss i (cast String (Introspector/annotationToField (aget xx i))))
                          (recur (unchecked-inc-int i))))
                      ss))
              (instance? Class x) (.getName (cast Class x))
              (instance? Enum x) (.name (cast Enum x))
              :else
                (do
                  (when (Proxy/isProxyClass c) (set! c (aget (.getInterfaces c) 0)))
                  (throw (IllegalArgumentException.
                           (java-str "Illegal type for annotation element using @DescriptorKey: "
                                     (.getName c))))))))))

  (method ^:private ^:static equals ^boolean [x y]
    (Arrays/deepEquals (new Object/1 [x]) (new Object/1 [y])))

  (method ^:private ^:static implementsMBean :type-params [T] ^{:tag (Class (? super T))} [^{:tag (Class T)} c
                                                                                           ^String clName]
    (let [clMBeanName (java-str clName "MBean")]
      (if (.equals (.getName c) clMBeanName)
          c
          (let [^{:tag (array (Class ?))} interfaces (.getInterfaces c)]
            (loop [^int i 0]
              (if (< i (alength interfaces))
                  (if (and (.equals (.getName (aget interfaces i)) clMBeanName)
                           (Modifier/isPublic (.getModifiers (aget interfaces i))))
                      (return (cast Class (Util/cast (aget interfaces i))))
                      (recur (unchecked-inc-int i)))
                  nil))
            nil))))

  (method ^:public ^:static elementFromComplex :throws [AttributeNotFoundException] [complex
                                                                                     ^String element]
    (try
      (cond
        (and (.isArray (.getClass complex)) (.equals element "length")) (Array/getLength complex)
        (instance? CompositeData complex) (.get (cast CompositeData complex) element)
        :else
          (let [^{:tag (Class ?)} clazz (.getClass complex)
                ^Method readMethod (if (JavaBeansAccessor/isAvailable)
                                       (JavaBeansAccessor/getReadMethod clazz element)
                                       (SimpleIntrospector/getReadMethod clazz element))]
            (if (some? readMethod)
                (.invoke readMethod complex (new Class/1 0))
                (throw (AttributeNotFoundException.
                         (java-str "Could not find the getter method for the property "
                                   element
                                   " using the Java Beans introspector"))))))
      (catch InvocationTargetException e (throw (IllegalArgumentException. e)))
      (catch AttributeNotFoundException e (throw e))
      (catch Exception e
        (throw (cast AttributeNotFoundException
                     (EnvHelp/initCause (AttributeNotFoundException. (.getMessage e)) e))))))

  (defclass ^:private ^:static SimpleIntrospector
    (constructor ^:private [this])

    (field ^:private ^:static ^:final ^String GET_METHOD_PREFIX "get")

    (field ^:private ^:static ^:final ^String IS_METHOD_PREFIX "is")

    (field ^:private ^:static ^:final ^{:tag (Map (Class ?) (SoftReference (List Method)))} cache
      (Collections/synchronizedMap (WeakHashMap.)))

    (method ^:private ^:static getCachedMethods ^{:tag (List Method)} [^{:tag (Class ?)} clazz]
      (let [^{:tag (SoftReference (List Method))} ref (cast SoftReference (.get cache clazz))]
        (when (some? ref) (cast List (.get ref)))))

    (method ^:static isReadMethod ^boolean [^Method method]
      (let [modifiers (.getModifiers method)]
        (if (Modifier/isStatic modifiers)
            false
            (let [name (.getName method)
                  ^{:tag (array (Class ?))} paramTypes (.getParameterTypes method)
                  paramCount (alength paramTypes)]
              (when (and (== paramCount 0) (> (.length name) 2))
                (when (.startsWith name IS_METHOD_PREFIX)
                  (return (identical? (.getReturnType method) Boolean/TYPE)))
                (when (and (> (.length name) 3) (.startsWith name GET_METHOD_PREFIX))
                  (return (not (identical? (.getReturnType method) Void/TYPE)))))
              false))))

    (method ^:static getReadMethods ^{:tag (List Method)} [^{:tag (Class ?)} clazz]
      (let [^{:tag (List Method)} cachedResult (SimpleIntrospector/getCachedMethods clazz)]
        (if (some? cachedResult)
            cachedResult
            (let [^:mutable ^{:tag (List Method)} methods (.getMethods
                                                            (StandardMBeanIntrospector/getInstance)
                                                            clazz)]
              (set! methods (MBeanAnalyzer/eliminateCovariantMethods methods))
              (let [^{:tag (List Method)} result (ArrayList.)]
                (for-each [^Method m methods]
                  (when (SimpleIntrospector/isReadMethod m)
                    (if (.startsWith (.getName m) IS_METHOD_PREFIX)
                        (.add result 0 m)
                        (.add result m))))
                (.put cache clazz (SoftReference. result))
                result)))))

    (method ^:static getReadMethod ^Method [^{:tag (Class ?)} clazz ^:mutable ^String property]
      (when-not (Character/isUpperCase (.charAt property 0))
        (set! property
              (java-str (.toUpperCase (.substring property 0 1) Locale/ENGLISH)
                        (.substring property 1)))
        (let [getMethod (java-str GET_METHOD_PREFIX property)
              isMethod (java-str IS_METHOD_PREFIX property)]
          (for-each [^Method m (SimpleIntrospector/getReadMethods clazz)]
            (let [name (.getName m)]
              (when (or (.equals name isMethod) (.equals name getMethod)) (return m))))
          nil)))))

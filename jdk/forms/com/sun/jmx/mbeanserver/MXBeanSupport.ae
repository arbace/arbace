  (method ^:static findMXBeanInterface :type-params [T] ^{:tag (Class (? super T))} [^{:tag (Class T)} resourceClass]
    (when (nil? resourceClass) (throw (IllegalArgumentException. "Null resource class")))
    (let [^:final ^{:tag (Set (Class ?))} intfs (MXBeanSupport/transitiveInterfaces resourceClass)
          ^:final ^{:tag (Set (Class ?))} candidates (Util/newSet)]

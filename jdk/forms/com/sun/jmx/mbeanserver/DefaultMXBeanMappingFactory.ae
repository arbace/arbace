                             [(RecordCompositeBuilder. targetClass itemNames)]
                             [(CompositeBuilderViaConstructor. targetClass itemNames)]
                             [(CompositeBuilderCheckGetters. targetClass itemNames getterMappings)
                              (CompositeBuilderViaSetters. targetClass itemNames)
                              (CompositeBuilderViaProxy. targetClass itemNames)]])
              ^:mutable ^CompositeBuilder foundBuilder nil
              whyNots (StringBuilder.)
              ^:mutable ^Throwable possibleCause nil]

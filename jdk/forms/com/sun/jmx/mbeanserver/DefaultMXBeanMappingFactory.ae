            (for-each [^CompositeBuilder/1 relatedBuilders builders]
              (loop [^int i 0]
                (when (< i (alength relatedBuilders))
                  (let [builder (aget relatedBuilders i)
                        whyNot (.applicable builder getters)]
                    (when (nil? whyNot) (set! foundBuilder builder) (break :find))
                    (let [cause (.possibleCause builder)]
                      (when (some? cause) (set! possibleCause cause))
                      (if (> (.length whyNot) 0)
                          (do
                            (when (> (.length whyNots) 0) (.append whyNots "; "))
                            (.append whyNots whyNot)
                            (when-not (== i 0) (recur (unchecked-inc-int i))))
                          (recur (unchecked-inc-int i)))))))))
          (when (nil? foundBuilder)

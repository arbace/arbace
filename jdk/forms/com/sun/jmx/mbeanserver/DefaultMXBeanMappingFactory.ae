      (.makeCompositeBuilder this)
      (.fromCompositeData compositeBuilder (cast CompositeData value) itemNames getterMappings))

    (field ^:private ^:final ^String/1 itemNames)

    (field ^:private ^:final ^Method/1 getters)

    (field ^:private ^:final ^MXBeanMapping/1 getterMappings)

    (field ^:private ^CompositeBuilder compositeBuilder))

  (defclass ^:private ^:abstract ^:static CompositeBuilder
    (constructor [this ^{:tag (Class ?)} targetClass ^String/1 itemNames]
      (set! (.-targetClass this) targetClass)
      (set! (.-itemNames this) itemNames))

    (method getTargetClass ^{:tag (Class ?)} [this] targetClass)

    (method getItemNames ^String/1 [this] itemNames)

    (method ^:abstract applicable :throws [InvalidObjectException] ^String [this ^Method/1 getters])

    (method possibleCause ^Throwable [this] nil)

    (method ^:abstract fromCompositeData :throws [InvalidObjectException] [this ^CompositeData cd
                                                                           ^String/1 itemNames
                                                                           ^MXBeanMapping/1 converters])

    (field ^:private ^:final ^{:tag (Class ?)} targetClass)

    (field ^:private ^:final ^String/1 itemNames))

  (defclass ^:private ^:static ^:final CompositeBuilderViaFrom
    :extends CompositeBuilder

    (constructor [this ^{:tag (Class ?)} targetClass ^String/1 itemNames]
      (super. targetClass itemNames))

    (method applicable :throws [InvalidObjectException] ^String [this ^Method/1 getters]
      (let [^{:tag (Class ?)} targetClass (.getTargetClass this)]
        (try
          (let [fromMethod (.getMethod targetClass "from" CompositeData)]
            (when-not (Modifier/isStatic (.getModifiers fromMethod))
              (let [^:const msg "Method from(CompositeData) is not static"]
                (throw (InvalidObjectException. msg))))
            (when-not (identical? (.getReturnType fromMethod) (.getTargetClass this))
              (let [msg (java-str "Method from(CompositeData) returns "
                                  (MXBeanIntrospector/typeName (.getReturnType fromMethod))
                                  " not "
                                  (MXBeanIntrospector/typeName targetClass))]
                (throw (InvalidObjectException. msg))))
            (set! (.-fromMethod this) fromMethod)
            nil)
          (catch InvalidObjectException e (throw e))
          (catch Exception e "no method from(CompositeData)"))))

    (method ^:final fromCompositeData :throws [InvalidObjectException] [this ^CompositeData cd
                                                                        ^String/1 itemNames
                                                                        ^MXBeanMapping/1 converters]
      (try
        (.invoke fromMethod nil (new Object/1 [cd]))
        (catch Exception e
          (let [^:const msg "Failed to invoke from(CompositeData)"]
            (throw (DefaultMXBeanMappingFactory/invalidObjectException msg e))))))

    (field ^:private ^Method fromMethod))

  (defclass ^:private ^:static CompositeBuilderCheckGetters
    :extends CompositeBuilder

    (constructor [this ^{:tag (Class ?)} targetClass ^String/1 itemNames
                  ^MXBeanMapping/1 getterConverters]
      (super. targetClass itemNames)
      (set! (.-getterConverters this) getterConverters))

    (method applicable ^String [this ^Method/1 getters]
      (loop [^int i 0]
        (when (< i (alength getters))
          (try
            (.checkReconstructible (aget getterConverters i))
            (catch InvalidObjectException e
              (set! possibleCause e)
              (return (java-str "method "
                                (.getName (aget getters i))
                                " returns type that cannot be mapped back from OpenData"))))
          (recur (unchecked-inc-int i))))
      "")

    (method possibleCause ^Throwable [this] possibleCause)

    (method ^:final fromCompositeData [this ^CompositeData cd ^String/1 itemNames
                                       ^MXBeanMapping/1 converters]
      (throw (Error.)))

    (field ^:private ^:final ^MXBeanMapping/1 getterConverters)

    (field ^:private ^Throwable possibleCause))

  (defclass ^:private ^:static CompositeBuilderViaSetters
    :extends CompositeBuilder

    (constructor [this ^{:tag (Class ?)} targetClass ^String/1 itemNames]
      (super. targetClass itemNames))

    (method applicable ^String [this ^Method/1 getters]
      (try
        (let [^{:tag (Constructor ?)} c (.getConstructor (.getTargetClass this))] nil)
        (catch Exception e (return "does not have a public no-arg constructor")))
      (let [setters (new Method/1 (alength getters))]
        (loop [^int i 0]
          (when (< i (alength getters))
            (let [getter (aget getters i)
                  ^{:tag (Class ?)} returnType (.getReturnType getter)
                  name (DefaultMXBeanMappingFactory/propertyName getter)
                  setterName (java-str "set" name)
                  ^:mutable ^Method setter nil]
              (try
                (set! setter (.getMethod (.getTargetClass this) setterName returnType))
                (when-not (identical? (.getReturnType setter) Void/TYPE) (throw (Exception.)))
                (catch Exception e
                  (return (java-str "not all getters have corresponding setters (" getter ")"))))
              (aset setters i setter)
              (recur (unchecked-inc-int i)))))
        (set! (.-setters this) setters)
        nil))

    (method fromCompositeData :throws [InvalidObjectException] [this ^CompositeData cd
                                                                ^String/1 itemNames
                                                                ^MXBeanMapping/1 converters]
      (let [^:mutable ^Object o nil]
        (try
          (let [^{:tag (Class ?)} targetClass (.getTargetClass this)
                tmp (.newInstance targetClass)]
            (set! o tmp)
            (loop [^int i 0]
              (if (< i (alength itemNames))
                  (if (.containsKey cd (aget itemNames i))
                      (let [openItem (.get cd (aget itemNames i))
                            javaItem (.fromOpenValue (aget converters i) openItem)]
                        (.invoke (aget setters i) o (new Object/1 [javaItem]))
                        (recur (unchecked-inc-int i)))
                      (recur (unchecked-inc-int i)))
                  nil)))
          (catch Exception e (throw (DefaultMXBeanMappingFactory/invalidObjectException e))))
        o))

    (field ^:private ^Method/1 setters))

  (defclass ^:private ^:static CompositeBuilderViaConstructor
    :extends CompositeBuilder

    (constructor [this ^{:tag (Class ?)} targetClass ^String/1 itemNames]
      (super. targetClass itemNames))

    (method getConstPropValues ^String/1 [this ^{:tag (Constructor ?)} ctr]
      (let [ctrProps (cast ConstructorParameters (.getAnnotation ctr ConstructorParameters))]
        (if (some? ctrProps)
            (.value ctrProps)
            (let [vals (JavaBeansAccessor/getConstructorPropertiesValue ctr)] vals))))

    (method applicable :throws [InvalidObjectException] ^String [this ^Method/1 getters]
      (let [^{:tag (Class ?)} targetClass (.getTargetClass this)
            ^{:tag (array (Constructor ?))} constrs (.getConstructors targetClass)
            ^{:tag (List (Constructor ?))} annotatedConstrList (Util/newList)]
        (for-each [^{:tag (Constructor ?)} constr constrs]
          (when (and (Modifier/isPublic (.getModifiers constr))
                     (some? (.getConstPropValues this constr)))
            (.add annotatedConstrList constr)))
        (if (.isEmpty annotatedConstrList)
            (.reportNoConstructor this)
            (do
              (set! annotatedConstructors (Util/newList))
              (let [^{:tag (Map String Integer)} getterMap (Util/newMap)
                    itemNames (.getItemNames this)]
                (loop [^int i 0]
                  (when (< i (alength itemNames))
                    (.put getterMap (aget itemNames i) i)
                    (recur (unchecked-inc-int i))))
                (let [^{:tag (Set BitSet)} getterIndexSets (Util/newSet)]
                  (for-each [^{:tag (Constructor ?)} constr annotatedConstrList]
                    (let [matchingMechanism (.matchingMechanism this constr)
                          propertyNames (.getConstPropValues this constr)
                          paramTypes (.getGenericParameterTypes constr)]
                      (when-not (== (alength paramTypes) (alength propertyNames))
                        (let [msg (java-str "Number of constructor params does not match "
                                            (.referenceMechannism this matchingMechanism)
                                            ": "
                                            constr)]
                          (throw (InvalidObjectException. msg))))
                      (let [paramIndexes (new int/1 (alength getters))]
                        (loop [^int i 0]
                          (when (< i (alength getters))
                            (aset paramIndexes i -1)
                            (recur (unchecked-inc-int i))))
                        (let [present (BitSet.)]
                          (loop [^int i 0]
                            (when (< i (alength propertyNames))
                              (let [propertyName (aget propertyNames i)]
                                (when-not (.containsKey getterMap propertyName)
                                  (let [^:mutable msg (java-str
                                                        matchingMechanism
                                                        " includes name "
                                                        propertyName
                                                        " which does not correspond to a property")]
                                    (for-each [^String getterName (.keySet getterMap)]
                                      (when (.equalsIgnoreCase getterName propertyName)
                                        (set! msg
                                              (java-str
                                                msg
                                                (java-str
                                                  " (differs only in case from property "
                                                  getterName
                                                  ")")))))
                                    (set! msg (java-str msg (java-str ": " constr)))
                                    (throw (InvalidObjectException. msg))))
                                (let [getterIndex (.intValue
                                                    (cast Integer (.get getterMap propertyName)))]
                                  (aset paramIndexes getterIndex i)
                                  (when (.get present getterIndex)
                                    (let [msg (java-str
                                                matchingMechanism
                                                " contains property "
                                                propertyName
                                                " more than once: "
                                                constr)]
                                      (throw (InvalidObjectException. msg))))
                                  (.set present getterIndex)
                                  (let [getter (aget getters getterIndex)
                                        propertyType (.getGenericReturnType getter)]
                                    (if (not (.equals propertyType (aget paramTypes i)))
                                        (let [msg (java-str
                                                    matchingMechanism
                                                    " gives property "
                                                    propertyName
                                                    " of type "
                                                    propertyType
                                                    " for parameter  of type "
                                                    (aget paramTypes i)
                                                    ": "
                                                    constr)]
                                          (throw (InvalidObjectException. msg)))
                                        (recur (unchecked-inc-int i))))))))
                          (when-not (.add getterIndexSets present)
                            (let [msg (.reportMultipleConstructorsFoundFor this propertyNames)]
                              (throw (InvalidObjectException. msg))))
                          (let [c (Constr. constr paramIndexes present)]
                            (.add annotatedConstructors c))))))
                  (for-each [^BitSet a getterIndexSets]
                    (let [^:mutable seen false]
                      (for-each [^BitSet b getterIndexSets]
                        (cond
                          (identical? a b) (set! seen true)
                          seen
                            (let [u (BitSet.)]
                              (.or u a)
                              (.or u b)
                              (when-not (.contains getterIndexSets u)
                                (let [^{:tag (Set String)} names (TreeSet.)]
                                  (loop [^int i (.nextSetBit u 0)]
                                    (when (>= i 0)
                                      (.add names (aget itemNames i))
                                      (recur (.nextSetBit u (unchecked-add-int i 1)))))
                                  (let [msg (.reportConstructorsAmbiguousFor this names)]
                                    (throw (InvalidObjectException. msg))))))))))
                  nil))))))

    (method reportNoConstructor ^String [this]
      "no constructor has either @ConstructorParameters or @ConstructorProperties annotation")

    (method matchingMechanism ^String [this ^{:tag (Constructor ?)} constr]
      (if (.isAnnotationPresent constr ConstructorParameters)
          "@ConstructorParameters"
          "@ConstructorProperties"))

    (method referenceMechannism ^String [this ^String matchingMechanism]
      (java-str matchingMechanism " annotation"))

    (method reportMultipleConstructorsFoundFor ^String [this & ^String/1 propertyNames]
      (java-str
        "More than one constructor has @ConstructorParameters or @ConstructorProperties annotation with this set of names: "
        (Arrays/toString propertyNames)))

    (method reportConstructorsAmbiguousFor ^String [this ^{:tag (Set String)} names]
      (java-str
        "Constructors with @ConstructorParameters or @ConstructorProperties annotation would be ambiguous for these items: "
        names))

    (method reportNoConstructorFoundFor ^String [this ^{:tag (Set String)} names]
      (java-str
        "No constructor has either @ConstructorParameters or @ConstructorProperties annotation for this set of items: "
        names))

    (method fromCompositeData :throws [InvalidObjectException] [this ^CompositeData cd
                                                                ^String/1 itemNames
                                                                ^MXBeanMapping/1 mappings]
      (let [ct (.getCompositeType cd)
            present (BitSet.)]
        (loop [^int i 0]
          (if (< i (alength itemNames))
              (if (some? (.getType ct (aget itemNames i)))
                  (do (.set present i) (recur (unchecked-inc-int i)))
                  (recur (unchecked-inc-int i)))
              nil))
        (let [^:mutable ^Constr max nil]
          (for-each [^Constr constr annotatedConstructors]
            (when (and (CompositeBuilderViaConstructor/subset (.-presentParams constr) present)
                       (or (nil? max)
                           (CompositeBuilderViaConstructor/subset
                             (.-presentParams max)
                             (.-presentParams constr))))
              (set! max constr)))
          (when (nil? max)
            (let [msg (.reportNoConstructorFoundFor this (.keySet ct))]
              (throw (InvalidObjectException. msg))))
          (let [params (new Object/1 (.cardinality (.-presentParams max)))]
            (loop [^int i 0]
              (if (< i (alength itemNames))
                  (if (not (.get (.-presentParams max) i))
                      (recur (unchecked-inc-int i))
                      (let [openItem (.get cd (aget itemNames i))
                            javaItem (.fromOpenValue (aget mappings i) openItem)
                            index (aget (.-paramIndexes max) i)]
                        (if (>= index 0)
                            (do (aset params index javaItem) (recur (unchecked-inc-int i)))
                            (recur (unchecked-inc-int i)))))
                  nil))
            (try
              (.newInstance (.-constructor max) params)
              (catch Exception e
                (let [msg (java-str "Exception constructing " (.getName (.getTargetClass this)))]
                  (throw (DefaultMXBeanMappingFactory/invalidObjectException msg e)))))))))

    (method ^:private ^:static subset ^boolean [^BitSet sub ^BitSet sup]
      (let [subcopy (cast BitSet (.clone sub))] (.andNot subcopy sup) (.isEmpty subcopy)))

    (defclass ^:private ^:static Constr
      (field ^:final ^{:tag (Constructor ?)} constructor)

      (field ^:final ^int/1 paramIndexes)

      (field ^:final ^BitSet presentParams)

      (constructor [this ^{:tag (Constructor ?)} constructor ^int/1 paramIndexes
                    ^BitSet presentParams]
        (set! (.-constructor this) constructor)
        (set! (.-paramIndexes this) paramIndexes)
        (set! (.-presentParams this) presentParams)))

    (field ^:private ^{:tag (List Constr)} annotatedConstructors))

  (defclass ^:private ^:static ^:final RecordCompositeBuilder
    :extends CompositeBuilderViaConstructor

    (constructor [this ^{:tag (Class ?)} targetClass ^String/1 itemNames]
      (super. targetClass itemNames))

    (method getConstPropValues ^String/1 [this ^{:tag (Constructor ?)} ctor]
      (let [components (.getRecordComponents (.getTargetClass this))
            ptypes (.getGenericParameterTypes ctor)]
        (if (not (== (alength components) (alength ptypes)))
            (.getConstPropValues super ctor)
            (let [len (alength components)
                  res (new String/1 len)]
              (loop [^int i 0]
                (when (< i len)
                  (when-not (.equals (aget ptypes i) (.getGenericType (aget components i)))
                    (return (.getConstPropValues super ctor)))
                  (aset res i (.getName (aget components i)))
                  (recur (unchecked-inc-int i))))
              res))))

    (method applicable :throws [InvalidObjectException] ^String [this ^Method/1 getters]
      (let [^{:tag (Class ?)} targetClass (.getTargetClass this)]
        (if (not (.isRecord targetClass)) "class is not a record" (.applicable super getters))))

    (method fromCompositeData :throws [InvalidObjectException] [this ^CompositeData cd
                                                                ^String/1 itemNames
                                                                ^MXBeanMapping/1 mappings]
      (.fromCompositeData super cd itemNames mappings))

    (method reportNoConstructor ^String [this]
      "canonical constructor for record not found")

    (method matchingMechanism ^String [this ^{:tag (Constructor ?)} constr]
      "canonical constructor")

    (method referenceMechannism ^String [this ^String matchingMechanism]
      matchingMechanism)

    (method reportMultipleConstructorsFoundFor ^String [this & ^String/1 propertyNames]
      (java-str "More than one constructor has this set of names: " (Arrays/toString propertyNames)))

    (method reportConstructorsAmbiguousFor ^String [this ^{:tag (Set String)} names]
      (java-str "Constructors would be ambiguous for these items: " names))

    (method reportNoConstructorFoundFor ^String [this ^{:tag (Set String)} names]
      (java-str "No constructor has this set of items: " names)))

  (defclass ^:private ^:static ^:final CompositeBuilderViaProxy
    :extends CompositeBuilder

    (constructor [this ^{:tag (Class ?)} targetClass ^String/1 itemNames]
      (super. targetClass itemNames))

    (method applicable ^String [this ^Method/1 getters]
      (let [^{:tag (Class ?)} targetClass (.getTargetClass this)]
        (if (not (.isInterface targetClass))
            "not an interface"
            (let [^{:tag (Set Method)} methods (Util/newSet
                                                 (Arrays/asList (.getMethods targetClass)))]
              (.removeAll methods (Arrays/asList getters))
              (let [^:mutable ^String bad nil]
                (for-each [^Method m methods]
                  (let [mname (.getName m)
                        ^{:tag (array (Class ?))} mparams (.getParameterTypes m)]
                    (try
                      (let [om (.getMethod Object mname mparams)]
                        (when-not (Modifier/isPublic (.getModifiers om)) (set! bad mname)))
                      (catch NoSuchMethodException e (set! bad mname)))))
                (when (some? bad) (java-str "contains methods other than getters (" bad ")")))))))

    (method ^:final fromCompositeData [this ^CompositeData cd ^String/1 itemNames
                                       ^MXBeanMapping/1 converters]
      (let [^{:tag (Class ?)} targetClass (.getTargetClass this)]
        (Proxy/newProxyInstance (.getClassLoader targetClass)
                                (new Class/1 [targetClass])
                                (CompositeDataInvocationHandler. cd)))))

  (method ^:static invalidObjectException ^InvalidObjectException [^String msg ^Throwable cause]
    (cast InvalidObjectException (EnvHelp/initCause (InvalidObjectException. msg) cause)))

  (method ^:static invalidObjectException ^InvalidObjectException [^Throwable cause]
    (DefaultMXBeanMappingFactory/invalidObjectException (.getMessage cause) cause))

  (method ^:static openDataException ^OpenDataException [^String msg ^Throwable cause]
    (cast OpenDataException (EnvHelp/initCause (OpenDataException. msg) cause)))

  (method ^:static openDataException ^OpenDataException [^Throwable cause]
    (DefaultMXBeanMappingFactory/openDataException (.getMessage cause) cause))

  (method ^:static mustBeComparable :throws [OpenDataException] ^void [^{:tag (Class ?)} collection
                                                                       ^Type element]
    (when (or (not (instance? Class element))
              (not (.isAssignableFrom Comparable (cast Class element))))
      (let [msg (java-str "Parameter class "
                          element
                          " of "
                          (.getName collection)
                          " does not implement "
                          (.getName Comparable))]
        (throw (OpenDataException. msg)))))

  (method ^:public ^:static decapitalize ^String [^String name]
    (if (or (nil? name) (== (.length name) 0))
        name
        (let [offset1 (Character/offsetByCodePoints name 0 1)]
          (if (and (< offset1 (.length name)) (Character/isUpperCase (.codePointAt name offset1)))
              name
              (java-str (.toLowerCase (.substring name 0 offset1)) (.substring name offset1))))))

  (method ^:static capitalize ^String [^String name]
    (if (or (nil? name) (== (.length name) 0))
        name
        (let [offset1 (.offsetByCodePoints name 0 1)]
          (java-str (.toUpperCase (.substring name 0 offset1)) (.substring name offset1)))))

  (method ^:public ^:static propertyName ^String [^Method m]
    (let [^:mutable ^String rest nil
          name (.getName m)
          c (.getDeclaringClass m)]
      (cond
        (.isRecord c)
          (for-each [^RecordComponent rc (.getRecordComponents c)]
            (when (and (.equals name (.getName rc)) (identical? (.getReturnType m) (.getType rc)))
              (set! rest name)
              (break)))
        (.startsWith name "get") (set! rest (.substring name 3))
        (and (.startsWith name "is") (identical? (.getReturnType m) Boolean/TYPE))
          (set! rest (.substring name 2)))
      (when-not (or (or (or (or (nil? rest) (== (.length rest) 0))
                            (> (alength (.getParameterTypes m)) 0))
                        (identical? (.getReturnType m) Void/TYPE))
                    (.equals name "getClass"))
        rest)))

  (field ^:private ^:static ^:final ^{:tag (Map Type Type)} inProgress (Util/newIdentityHashMap)))

      (set! (.-itemNames this) itemNames)
      (set! (.-getters this) getters)
      (set! (.-getterMappings this) (new MXBeanMapping/1 (alength getters)))
      (loop [^int i 0]
        (when (< i (alength getters))
          (let [retType (.getGenericReturnType (aget getters i))]
            (aset getterMappings i (.mappingForType factory retType factory))
            (recur (unchecked-inc-int i))))))


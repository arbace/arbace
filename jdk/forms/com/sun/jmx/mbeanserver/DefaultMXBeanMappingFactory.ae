              (loop [^int i 0]
                (when (< i (alength getters))
                  (try
                    (let [got (.invoke (aget getters i) value (cast Object/1 nil))]
                      (aset values i (.toOpenValue (aget getterMappings i) got)))
                    (catch Exception e
                      (throw (DefaultMXBeanMappingFactory/openDataException
                               (java-str "Error calling getter for " (aget itemNames i) ": " e)
                               e))))
                  (recur (unchecked-inc-int i))))
              (CompositeDataSupport. ct itemNames values)))))

    (method ^:private ^:synchronized makeCompositeBuilder :throws [InvalidObjectException] ^void [this]

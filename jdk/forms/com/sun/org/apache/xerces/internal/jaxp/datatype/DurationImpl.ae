                (recur (unchecked-inc-int i)))))
        (DurationImpl. (>= s 0)
                       (DurationImpl/toBigInteger
                         (DurationImpl/sanitize (aget buf 0) s)
                         (and (nil? (.getField lhs DatatypeConstants/YEARS))
                              (nil? (.getField rhs DatatypeConstants/YEARS))))
                       (DurationImpl/toBigInteger
                         (DurationImpl/sanitize (aget buf 1) s)
                         (and (nil? (.getField lhs DatatypeConstants/MONTHS))
                              (nil? (.getField rhs DatatypeConstants/MONTHS))))
                       (DurationImpl/toBigInteger
                         (DurationImpl/sanitize (aget buf 2) s)
                         (and (nil? (.getField lhs DatatypeConstants/DAYS))
                              (nil? (.getField rhs DatatypeConstants/DAYS))))
                       (DurationImpl/toBigInteger
                         (DurationImpl/sanitize (aget buf 3) s)
                         (and (nil? (.getField lhs DatatypeConstants/HOURS))
                              (nil? (.getField rhs DatatypeConstants/HOURS))))
                       (DurationImpl/toBigInteger
                         (DurationImpl/sanitize (aget buf 4) s)
                         (and (nil? (.getField lhs DatatypeConstants/MINUTES))
                              (nil? (.getField rhs DatatypeConstants/MINUTES))))
                       ^BigDecimal (when-not (and
                                               (and
                                                 (== (.signum (aget buf 5)) 0)
                                                 (nil? (.getField lhs DatatypeConstants/SECONDS)))
                                               (nil? (.getField rhs DatatypeConstants/SECONDS)))
                                     (DurationImpl/sanitize (aget buf 5) s))))))

  (method ^:private ^:static alignSigns ^void [^BigDecimal/1 buf ^int start ^int end]
    (let [^:mutable ^boolean touched false]
      (loop []
        (set! touched false)
        (let [^:mutable ^int s 0]
          (loop [^int i start]
            (when (< i end)
              (when (< (unchecked-multiply-int s (.signum (aget buf i))) 0)
                (set! touched true)
                (let [^:mutable borrow (.divide (.abs (aget buf i))
                                                (aget FACTORS (unchecked-subtract-int i 1))
                                                0
                                                RoundingMode/UP)]
                  (when (> (.signum (aget buf i)) 0) (set! borrow (.negate borrow)))
                  (aset buf
                        (unchecked-subtract-int i 1)
                        (.subtract (aget buf (unchecked-subtract-int i 1)) borrow))
                  (aset buf
                        i
                        (.add (aget buf i)
                              (.multiply borrow (aget FACTORS (unchecked-subtract-int i 1)))))))
              (if (not (== (.signum (aget buf i)) 0))
                  (do (set! s (.signum (aget buf i))) (recur (unchecked-inc-int i)))
                  (recur (unchecked-inc-int i))))))
        (when touched (recur)))))

  (method ^:private ^:static sanitize ^BigDecimal [^BigInteger value ^int signum]
    (cond
      (or (== signum 0) (nil? value)) ZERO
      (> signum 0) (BigDecimal. value)
      :else (BigDecimal. (.negate value))))

  (method ^:static sanitize ^BigDecimal [^BigDecimal value ^int signum]
    (cond (or (== signum 0) (nil? value)) ZERO (> signum 0) value :else (.negate value)))

  (method ^:public subtract ^Duration [this ^:final ^Duration rhs]
    (.add this (.negate rhs)))

  (method ^:public negate ^Duration [this]
    (DurationImpl. (<= signum 0) years months days hours minutes seconds))

  (method ^:public signum ^int [this] signum)

  (method ^:public addTo ^void [this ^Calendar calendar]
    (.add calendar Calendar/YEAR (unchecked-multiply-int (.getYears this) signum))
    (.add calendar Calendar/MONTH (unchecked-multiply-int (.getMonths this) signum))
    (.add calendar Calendar/DAY_OF_MONTH (unchecked-multiply-int (.getDays this) signum))
    (.add calendar Calendar/HOUR (unchecked-multiply-int (.getHours this) signum))
    (.add calendar Calendar/MINUTE (unchecked-multiply-int (.getMinutes this) signum))
    (.add calendar Calendar/SECOND (unchecked-multiply-int (.getSeconds this) signum))

  (method ^:public addTo ^void [this ^Date date]
    (let [^Calendar cal (GregorianCalendar.)]
      (.setTime cal date)
      (.addTo this cal)
      (.setTime date (DurationImpl/getCalendarTimeInMillis cal))))

  (method ^:private ^:static getCalendarTimeInMillis ^long [^Calendar cal]
    (.getTimeInMillis cal))

  (field ^:private ^:static ^:final ^long serialVersionUID 1)

  (method ^:private writeReplace [this]
    (DurationStream. (.toString this)))

  (defclass ^:private ^:static DurationStream
    :implements [Serializable]

    (field ^:private ^:final ^String lexical)

    (constructor ^:private [this ^String _lexical]

                                (< startDay 1) (set! tempDays BigInteger/ONE)
                                :else (set! tempDays (BigInteger/valueOf startDay)))
                              (let [^:mutable endDays (.add (.add tempDays dDays) carry)
                                    ^:mutable ^int monthCarry 0
                                    ^:mutable ^int intTemp 0]
                                (while true
                                  (cond
                                    (< (.compareTo endDays BigInteger/ONE) 0)
                                      (let [^:mutable ^BigInteger mdimf nil]
                                        (if (>= month 2)
                                            (set!
                                              mdimf
                                              (BigInteger/valueOf
                                                (XMLGregorianCalendarImpl/maximumDayInMonthFor
                                                  (.getEonAndYear this)
                                                  (unchecked-subtract-int (.getMonth this) 1))))
                                            (set!
                                              mdimf
                                              (BigInteger/valueOf

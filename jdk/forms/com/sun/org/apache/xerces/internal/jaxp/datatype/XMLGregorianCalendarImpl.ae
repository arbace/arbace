  (field ^:private ^:static ^:final ^BigInteger FOUR (BigInteger/valueOf 4))

  (field ^:private ^:static ^:final ^BigInteger HUNDRED (BigInteger/valueOf 100))

  (field ^:private ^:static ^:final ^BigInteger FOUR_HUNDRED (BigInteger/valueOf 400))

  (field ^:private ^:static ^:final ^BigInteger SIXTY (BigInteger/valueOf 60))

  (field ^:private ^:static ^:final ^BigInteger TWENTY_FOUR (BigInteger/valueOf 24))

  (field ^:private ^:static ^:final ^BigInteger TWELVE (BigInteger/valueOf 12))

  (field ^:private ^:static ^:final ^BigDecimal DECIMAL_ZERO (BigDecimal/valueOf 0))

  (field ^:private ^:static ^:final ^BigDecimal DECIMAL_ONE (BigDecimal/valueOf 1))

  (field ^:private ^:static ^:final ^BigDecimal DECIMAL_TWELVE (BigDecimal/valueOf 12))

  (field ^:private ^:static ^:final ^BigDecimal DECIMAL_TWENTY_FOUR (BigDecimal/valueOf 24))

  (field ^:private ^:static ^:final ^BigDecimal DECIMAL_SIXTY (BigDecimal/valueOf 60))

  (defclass ^:private ^:static DaysInMonth
    (field ^:private ^:static ^:final ^int/1 table
      (new int/1 [0 31 28 31 30 31 30 31 31 30 31 30 31])))

  (method ^:private ^:static maximumDayInMonthFor ^int [^BigInteger year ^int month]
    (cond
      (not (== month DatatypeConstants/FEBRUARY)) (aget DaysInMonth/table month)
      (or (.equals (.mod year FOUR_HUNDRED) BigInteger/ZERO)
          (and (not (.equals (.mod year HUNDRED) BigInteger/ZERO))
               (.equals (.mod year FOUR) BigInteger/ZERO)))
        29
      :else (aget DaysInMonth/table month)))

  (method ^:private ^:static maximumDayInMonthFor ^int [^int year ^int month]
    (cond
      (not (== month DatatypeConstants/FEBRUARY)) (aget DaysInMonth/table month)
      (or (== (unchecked-remainder-int year 400) 0)
          (and (not (== (unchecked-remainder-int year 100) 0))
               (== (unchecked-remainder-int year 4) 0)))
        29
      :else (aget DaysInMonth/table DatatypeConstants/FEBRUARY)))

  (method ^:public toGregorianCalendar ^GregorianCalendar [this]
    (let [^:mutable ^GregorianCalendar result nil
          ^:const DEFAULT_TIMEZONE_OFFSET DatatypeConstants/FIELD_UNDEFINED
          tz (.getTimeZone this DEFAULT_TIMEZONE_OFFSET)
          locale (.getDefaultLocale this)]
      (set! result (GregorianCalendar. tz locale))
      (.clear result)
      (.setGregorianChange result PURE_GREGORIAN_CHANGE)
      (when-not (== year DatatypeConstants/FIELD_UNDEFINED)
        (if (nil? eon)
            (do
              (.set result Calendar/ERA (if (< year 0) GregorianCalendar/BC GregorianCalendar/AD))
              (.set result Calendar/YEAR (Math/abs year)))
            (let [eonAndYear (.getEonAndYear this)]
              (.set result
                    Calendar/ERA
                    (if (== (.signum eonAndYear) -1) GregorianCalendar/BC GregorianCalendar/AD))
              (.set result Calendar/YEAR (.intValue (.abs eonAndYear))))))
      (when-not (== month DatatypeConstants/FIELD_UNDEFINED)
        (.set result Calendar/MONTH (unchecked-subtract-int month 1)))
      (when-not (== day DatatypeConstants/FIELD_UNDEFINED) (.set result Calendar/DAY_OF_MONTH day))
      (when-not (== hour DatatypeConstants/FIELD_UNDEFINED) (.set result Calendar/HOUR_OF_DAY hour))
      (when-not (== minute DatatypeConstants/FIELD_UNDEFINED) (.set result Calendar/MINUTE minute))
      (when-not (== second DatatypeConstants/FIELD_UNDEFINED) (.set result Calendar/SECOND second))
      (when (some? fractionalSecond) (.set result Calendar/MILLISECOND (.getMillisecond this)))
      result))

  (method ^:private getDefaultLocale ^Locale [this]
    (let [lang (System/getProperty "user.language.format")
          country (System/getProperty "user.country.format")
          variant (System/getProperty "user.variant.format")
          ^:mutable ^Locale locale nil]
      (when (some? lang)
        (if (some? country)
            (if (some? variant)
                (set! locale (Locale/of lang country variant))
                (set! locale (Locale/of lang country)))
            (set! locale (Locale/of lang))))
      (when (nil? locale) (set! locale (Locale/getDefault)))
      locale))

  (method ^:public toGregorianCalendar ^GregorianCalendar [this ^TimeZone timezone
                                                           ^:mutable ^Locale aLocale
                                                           ^XMLGregorianCalendar defaults]
    (let [^:mutable ^GregorianCalendar result nil
          ^:mutable tz timezone]
      (when (nil? tz)
        (let [^:mutable defaultZoneoffset DatatypeConstants/FIELD_UNDEFINED]
          (when (some? defaults) (set! defaultZoneoffset (.getTimezone defaults)))
          (set! tz (.getTimeZone this defaultZoneoffset))))
      (when (nil? aLocale) (set! aLocale (Locale/getDefault)))
      (set! result (GregorianCalendar. tz aLocale))
      (.clear result)
      (.setGregorianChange result PURE_GREGORIAN_CHANGE)
      (cond
        (not (== year DatatypeConstants/FIELD_UNDEFINED))
          (if (nil? eon)
              (do
                (.set result Calendar/ERA (if (< year 0) GregorianCalendar/BC GregorianCalendar/AD))
                (.set result Calendar/YEAR (Math/abs year)))
              (let [eonAndYear (.getEonAndYear this)]
                (.set result
                      Calendar/ERA
                      (if (== (.signum eonAndYear) -1) GregorianCalendar/BC GregorianCalendar/AD))
                (.set result Calendar/YEAR (.intValue (.abs eonAndYear)))))
        (some? defaults)
          (let [defaultYear (.getYear defaults)]
            (when-not (== defaultYear DatatypeConstants/FIELD_UNDEFINED)
              (if (nil? (.getEon defaults))
                  (do
                    (.set result
                          Calendar/ERA
                          (if (< defaultYear 0) GregorianCalendar/BC GregorianCalendar/AD))
                    (.set result Calendar/YEAR (Math/abs defaultYear)))
                  (let [defaultEonAndYear (.getEonAndYear defaults)]
                    (.set result
                          Calendar/ERA
                          (if (== (.signum defaultEonAndYear) -1)
                              GregorianCalendar/BC
                              GregorianCalendar/AD))
                    (.set result Calendar/YEAR (.intValue (.abs defaultEonAndYear))))))))
      (if (not (== month DatatypeConstants/FIELD_UNDEFINED))
          (.set result Calendar/MONTH (unchecked-subtract-int month 1))
          (let [^int defaultMonth (if (some? defaults)
                                      (.getMonth defaults)
                                      DatatypeConstants/FIELD_UNDEFINED)]
            (when-not (== defaultMonth DatatypeConstants/FIELD_UNDEFINED)
              (.set result Calendar/MONTH (unchecked-subtract-int defaultMonth 1)))))
      (if (not (== day DatatypeConstants/FIELD_UNDEFINED))
          (.set result Calendar/DAY_OF_MONTH day)
          (let [^int defaultDay (if (some? defaults)
                                    (.getDay defaults)
                                    DatatypeConstants/FIELD_UNDEFINED)]
            (when-not (== defaultDay DatatypeConstants/FIELD_UNDEFINED)
              (.set result Calendar/DAY_OF_MONTH defaultDay))))
      (if (not (== hour DatatypeConstants/FIELD_UNDEFINED))
          (.set result Calendar/HOUR_OF_DAY hour)
          (let [^int defaultHour (if (some? defaults)
                                     (.getHour defaults)
                                     DatatypeConstants/FIELD_UNDEFINED)]
            (when-not (== defaultHour DatatypeConstants/FIELD_UNDEFINED)
              (.set result Calendar/HOUR_OF_DAY defaultHour))))
      (if (not (== minute DatatypeConstants/FIELD_UNDEFINED))
          (.set result Calendar/MINUTE minute)
          (let [^int defaultMinute (if (some? defaults)
                                       (.getMinute defaults)
                                       DatatypeConstants/FIELD_UNDEFINED)]
            (when-not (== defaultMinute DatatypeConstants/FIELD_UNDEFINED)
              (.set result Calendar/MINUTE defaultMinute))))
      (if (not (== second DatatypeConstants/FIELD_UNDEFINED))
          (.set result Calendar/SECOND second)
          (let [^int defaultSecond (if (some? defaults)
                                       (.getSecond defaults)
                                       DatatypeConstants/FIELD_UNDEFINED)]
            (when-not (== defaultSecond DatatypeConstants/FIELD_UNDEFINED)
              (.set result Calendar/SECOND defaultSecond))))
      (if (some? fractionalSecond)
          (.set result Calendar/MILLISECOND (.getMillisecond this))
          (let [^BigDecimal defaultFractionalSecond (when (some? defaults)
                                                      (.getFractionalSecond defaults))]
            (when (some? defaultFractionalSecond)
              (.set result Calendar/MILLISECOND (.getMillisecond defaults)))))
      result))

  (method ^:public getTimeZone ^TimeZone [this ^int defaultZoneoffset]
    (let [^:mutable ^TimeZone result nil
          ^:mutable zoneoffset (.getTimezone this)]
      (when (== zoneoffset DatatypeConstants/FIELD_UNDEFINED) (set! zoneoffset defaultZoneoffset))
      (if (== zoneoffset DatatypeConstants/FIELD_UNDEFINED)
          (set! result (TimeZone/getDefault))
          (let [^char sign (if (< zoneoffset 0) \- \+)]
            (when (== sign \-) (set! zoneoffset (unchecked-negate-int zoneoffset)))
            (let [hour (unchecked-divide-int zoneoffset 60)
                  minutes (unchecked-subtract-int zoneoffset (unchecked-multiply-int hour 60))
                  customTimezoneId (StringBuffer. 8)]
              (.append customTimezoneId "GMT")
              (.append customTimezoneId sign)
              (.append customTimezoneId hour)
              (when-not (== minutes 0)
                (when (< minutes 10) (.append customTimezoneId \0))
                (.append customTimezoneId minutes))
              (set! result (TimeZone/getTimeZone (.toString customTimezoneId))))))
      result))

  (method ^:public clone [this]
    (XMLGregorianCalendarImpl. (.getEonAndYear this)
                               (.-month this)
                               (.-day this)
                               (.-hour this)
                               (.-minute this)
                               (.-second this)
                               (.-fractionalSecond this)
                               (.-timezone this)))

  (method ^:public clear ^void [this]
    (set! eon nil)
    (set! year DatatypeConstants/FIELD_UNDEFINED)
    (set! month DatatypeConstants/FIELD_UNDEFINED)
    (set! day DatatypeConstants/FIELD_UNDEFINED)
    (set! timezone DatatypeConstants/FIELD_UNDEFINED)
    (set! hour DatatypeConstants/FIELD_UNDEFINED)
    (set! minute DatatypeConstants/FIELD_UNDEFINED)
    (set! second DatatypeConstants/FIELD_UNDEFINED)
    (set! fractionalSecond nil))

  (method ^:public setMillisecond ^void [this ^int millisecond]
    (if (== millisecond DatatypeConstants/FIELD_UNDEFINED)
        (set! fractionalSecond nil)
        (do
          (when (or (< millisecond 0) (< 999 millisecond))
            (when-not (== millisecond DatatypeConstants/FIELD_UNDEFINED)
              (.invalidFieldValue this MILLISECOND millisecond)))
          (set! fractionalSecond (BigDecimal/valueOf millisecond 3)))))

  (method ^:public ^:final setFractionalSecond ^void [this ^BigDecimal fractional]
    (when (some? fractional)
      (when (or (< (.compareTo fractional DECIMAL_ZERO) 0)
                (> (.compareTo fractional DECIMAL_ONE) 0))
        (throw (IllegalArgumentException.
                 (DatatypeMessageFormatter/formatMessage
                   nil
                   "InvalidFractional"
                   (new Object/1 [(.toString fractional)]))))))
    (set! (.-fractionalSecond this) fractional))

  (defclass ^:private ^:final Parser
    (field ^:private ^:final ^String format)

    (field ^:private ^:final ^String value)

    (field ^:private ^:final ^int flen)

    (field ^:private ^:final ^int vlen)

    (field ^:private ^int fidx)

    (field ^:private ^int vidx)

    (constructor ^:private [this ^String format ^String value]
      (set! (.-format this) format)
      (set! (.-value this) value)
      (set! (.-flen this) (.length format))
      (set! (.-vlen this) (.length value)))

    (method ^:public parse :throws [IllegalArgumentException] ^void [this]
      (while (< fidx flen)
        (let [fch (.charAt format (let [old-1 fidx] (set! fidx (unchecked-inc-int fidx)) old-1))]
          (if (not (== fch \%))
              (.skip this fch)
              (switch (.charAt format (let [old-2 fidx] (set! fidx (unchecked-inc-int fidx)) old-2))
                \Y (.parseYear this)
                \M (.setMonth XMLGregorianCalendarImpl/this (.parseInt this 2 2))
                \D (.setDay XMLGregorianCalendarImpl/this (.parseInt this 2 2))
                \h (.setHour XMLGregorianCalendarImpl/this (.parseInt this 2 2) false)
                \m (.setMinute XMLGregorianCalendarImpl/this (.parseInt this 2 2))
                \s
                  (do
                    (.setSecond XMLGregorianCalendarImpl/this (.parseInt this 2 2))
                    (when (== (.peek this) \.)
                      (.setFractionalSecond XMLGregorianCalendarImpl/this (.parseBigDecimal this))))
                \z
                  (let [vch (.peek this)]
                    (if (== vch \Z)
                        (do
                          (set! vidx (unchecked-inc-int vidx))
                          (.setTimezone XMLGregorianCalendarImpl/this 0))
                        (when (or (== vch \+) (== vch \-))
                          (set! vidx (unchecked-inc-int vidx))
                          (let [h (.parseInt this 2 2)]
                            (.skip this \:)

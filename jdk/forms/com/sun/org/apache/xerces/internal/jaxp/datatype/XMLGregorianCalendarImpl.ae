                                  (set! intTemp (unchecked-add-int (.getMonth this) monthCarry))
                                  (let [^:mutable endMonth (unchecked-remainder-int
                                                             (unchecked-subtract-int intTemp 1)
                                                             (unchecked-subtract-int 13 1))

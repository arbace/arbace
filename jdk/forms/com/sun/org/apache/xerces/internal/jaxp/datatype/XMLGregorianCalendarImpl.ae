                                                  (.subtract (.getEonAndYear this) BigInteger/ONE)
                                                  12))))
                                        (set! endDays (.add endDays mdimf))
                                        (set! monthCarry -1))
                                    (> (.compareTo
                                         endDays
                                         (BigInteger/valueOf
                                           (XMLGregorianCalendarImpl/maximumDayInMonthFor
                                             (.getEonAndYear this)
                                             (.getMonth this))))
                                       0)
                                      (do
                                        (set! endDays
                                              (.add
                                                endDays
                                                (BigInteger/valueOf
                                                  (unchecked-negate-int
                                                    (XMLGregorianCalendarImpl/maximumDayInMonthFor
                                                      (.getEonAndYear this)
                                                      (.getMonth this))))))

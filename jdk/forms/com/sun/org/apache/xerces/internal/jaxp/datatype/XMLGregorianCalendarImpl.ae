            ^:mutable ^int sign 0]
        (when (== (.peek this) \-) (set! vidx (unchecked-inc-int vidx)) (set! sign 1))
        (while (XMLGregorianCalendarImpl/isDigit (.peek this)) (set! vidx (unchecked-inc-int vidx)))

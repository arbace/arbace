                (.setYear XMLGregorianCalendarImpl/this (Integer/parseInt yearString))
                (.setYear XMLGregorianCalendarImpl/this (BigInteger. yearString)))))))

    (method ^:private parseBigDecimal :throws [IllegalArgumentException] ^BigDecimal [this]

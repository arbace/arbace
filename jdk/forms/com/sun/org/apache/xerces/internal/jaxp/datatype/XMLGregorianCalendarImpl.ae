          (set! n (unchecked-subtract-int (unchecked-add-int (unchecked-multiply-int n 10) ch) \0)))
        (when (< (unchecked-subtract-int vidx vstart) minDigits)
          (throw (IllegalArgumentException. value)))
        n))

    (method ^:private parseYear :throws [IllegalArgumentException] ^void [this]

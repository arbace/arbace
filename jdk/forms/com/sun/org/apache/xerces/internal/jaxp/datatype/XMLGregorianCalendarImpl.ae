  (method ^:private ^:static isDigit ^boolean [^char ch]
    (and (<= \0 ch) (<= ch \9)))

  (method ^:private format ^String [this ^String format]
    (let [buf (StringBuilder.)
          ^:mutable ^int fidx 0
          flen (.length format)]
      (while (< fidx flen)
        (let [fch (.charAt format (let [old-4 fidx] (set! fidx (unchecked-inc-int fidx)) old-4))]
          (if (not (== fch \%))
              (.append buf fch)
              (switch (.charAt format (let [old-5 fidx] (set! fidx (unchecked-inc-int fidx)) old-5))
                \Y
                  (if (nil? eon)
                      (let [^:mutable absYear year]
                        (when (< absYear 0)
                          (.append buf \-)
                          (set! absYear (unchecked-negate-int year)))
                        (.printNumber this buf absYear 4))
                      (.printNumber this buf (.getEonAndYear this) 4))
                \M (.printNumber this buf (.getMonth this) 2)
                \D (.printNumber this buf (.getDay this) 2)
                \h (.printNumber this buf (.getHour this) 2)
                \m (.printNumber this buf (.getMinute this) 2)
                \s
                  (do
                    (.printNumber this buf (.getSecond this) 2)
                    (when (some? (.getFractionalSecond this))
                      (let [frac (.toPlainString (.getFractionalSecond this))]
                        (.append buf (.substring frac 1 (.length frac))))))
                \z
                  (let [^:mutable offset (.getTimezone this)]
                    (if (== offset 0)
                        (.append buf \Z)
                        (when-not (== offset DatatypeConstants/FIELD_UNDEFINED)
                          (if (< offset 0)
                              (do (.append buf \-) (set! offset (unchecked-multiply-int offset -1)))
                              (.append buf \+))
                          (.printNumber this buf (unchecked-divide-int offset 60) 2)
                          (.append buf \:)
                          (.printNumber this buf (unchecked-remainder-int offset 60) 2))))
                (throw (InternalError.))))))
      (.toString buf)))

  (method ^:private printNumber ^void [this ^StringBuilder out ^int number ^int nDigits]
    (let [s (String/valueOf number)]
      (loop [^int i (.length s)]
        (when (< i nDigits) (.append out \0) (recur (unchecked-inc-int i))))
      (.append out s)))

  (method ^:private printNumber ^void [this ^StringBuilder out ^BigInteger number ^int nDigits]
    (let [s (.toString number)]
      (loop [^int i (.length s)]
        (when (< i nDigits) (.append out \0) (recur (unchecked-inc-int i))))
      (.append out s)))

  (method ^:static sanitize ^BigInteger [^Number value ^int signum]
    (cond
      (or (== signum 0) (nil? value)) BigInteger/ZERO
      (< signum 0) (.negate (cast BigInteger value))
      :else (cast BigInteger value)))


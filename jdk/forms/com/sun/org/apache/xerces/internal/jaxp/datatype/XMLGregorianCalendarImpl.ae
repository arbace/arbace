                              (.setTimezone XMLGregorianCalendarImpl/this
                                            (unchecked-multiply-int
                                              (unchecked-add-int (unchecked-multiply-int h 60) m)
                                              (if (== vch \+) 1 -1))))))))
                (throw (InternalError.))))))
      (when-not (== vidx vlen) (throw (IllegalArgumentException. value)))
      (.testHour XMLGregorianCalendarImpl/this))

    (method ^:private peek :throws [IllegalArgumentException] ^char [this]
      (if (== vidx vlen) (unchecked-char -1) (.charAt value vidx)))

    (method ^:private read :throws [IllegalArgumentException] ^char [this]
      (when (== vidx vlen) (throw (IllegalArgumentException. value)))
      (.charAt value (let [old-3 vidx] (set! vidx (unchecked-inc-int vidx)) old-3)))

    (method ^:private skip :throws [IllegalArgumentException] ^void [this ^char ch]
      (when-not (== (.read this) ch) (throw (IllegalArgumentException. value))))

    (method ^:private parseInt :throws [IllegalArgumentException] ^int [this ^int minDigits
                                                                        ^int maxDigits]
      (let [^:mutable ^int n 0
            ^:mutable ^char ch (unchecked-char 0)
            vstart vidx]
        (while (and (XMLGregorianCalendarImpl/isDigit (set! ch (.peek this)))
                    (< (unchecked-subtract-int vidx vstart) maxDigits))

              wrapped))))

    (method ^:public unwrap :throws [SaslException] ^byte/1 [this ^byte/1 incoming ^int start
                                                             ^int len]
      (if (== len 0)
          EMPTY_BYTE_ARRAY
          (let [mac (new byte/1 10)
                msg (new byte/1 (unchecked-subtract-int len 16))
                msgType (new byte/1 2)
                seqNum (new byte/1 4)]
            (System/arraycopy incoming start msg 0 (alength msg))
            (System/arraycopy incoming (unchecked-add-int start (alength msg)) mac 0 10)
            (System/arraycopy incoming
                              (unchecked-add-int (unchecked-add-int start (alength msg)) 10)
                              msgType
                              0
                              2)
            (System/arraycopy incoming
                              (unchecked-add-int (unchecked-add-int start (alength msg)) 12)
                              seqNum
                              0
                              4)
            (let [expectedMac (.getHMAC this peerKi seqNum msg 0 (alength msg))]
              (when (.isLoggable AbstractSaslImpl/logger Level/FINEST)
                (AbstractSaslImpl/traceOutput DI_CLASS_NAME "unwrap" "DIGEST18:incoming: " msg)
                (AbstractSaslImpl/traceOutput DI_CLASS_NAME "unwrap" "DIGEST19:MAC: " mac)
                (AbstractSaslImpl/traceOutput DI_CLASS_NAME
                                              "unwrap"
                                              "DIGEST20:messageType: "
                                              msgType)
                (AbstractSaslImpl/traceOutput DI_CLASS_NAME
                                              "unwrap"
                                              "DIGEST21:sequenceNum: "
                                              seqNum)
                (AbstractSaslImpl/traceOutput DI_CLASS_NAME
                                              "unwrap"
                                              "DIGEST22:expectedMAC: "
                                              expectedMac))
              (if (not (Arrays/equals mac expectedMac))
                  (do
                    (.log AbstractSaslImpl/logger Level/INFO "DIGEST23:Unmatched MACs")
                    EMPTY_BYTE_ARRAY)
                  (do
                    (when-not (== peerSeqNum (AbstractSaslImpl/networkByteOrderToInt seqNum 0 4))
                      (throw
                        (SaslException.
                          (java-str
                            "DIGEST-MD5: Out of order sequencing of messages from server. Got: "
                            (AbstractSaslImpl/networkByteOrderToInt seqNum 0 4)
                            " Expected: "
                            peerSeqNum))))
                    (when-not (Arrays/equals messageType msgType)
                      (throw (SaslException.
                               (java-str "DIGEST-MD5: invalid message type: "
                                         (AbstractSaslImpl/networkByteOrderToInt msgType 0 2)))))
                    (set! peerSeqNum (unchecked-inc-int peerSeqNum))
                    msg))))))

    (method ^:protected getHMAC :throws [SaslException] ^byte/1 [this ^byte/1 Ki ^byte/1 seqnum
                                                                 ^byte/1 msg ^int start ^int len]
      (let [seqAndMsg (new byte/1 (unchecked-add-int 4 len))]
        (System/arraycopy seqnum 0 seqAndMsg 0 4)
        (System/arraycopy msg start seqAndMsg 4 len)
        (try
          (let [^SecretKey keyKi (SecretKeySpec. Ki "HmacMD5")
                m (Mac/getInstance "HmacMD5")]
            (.init m keyKi)
            (.update m seqAndMsg)
            (let [hMAC_MD5 (.doFinal m)
                  macBuffer (new byte/1 10)]
              (System/arraycopy hMAC_MD5 0 macBuffer 0 10)
              macBuffer))
          (catch InvalidKeyException e
            (throw (SaslException. "DIGEST-MD5: Invalid bytes used for key of HMAC-MD5 hash." e)))
          (catch NoSuchAlgorithmException e
            (throw (SaslException. "DIGEST-MD5: Error creating instance of MD5 digest algorithm" e))))))

    (method ^:protected incrementSeqNum ^void [this]
      (AbstractSaslImpl/intToNetworkByteOrder
        (let [old-1 mySeqNum] (set! mySeqNum (unchecked-inc-int mySeqNum)) old-1)
        sequenceNum
        0
        4)))

  (defclass ^:final DigestPrivacy
    :extends DigestIntegrity
    :implements [SecurityCtx]

    (field ^:private ^:static ^:final ^String CLIENT_CONF_MAGIC
      "Digest H(A1) to client-to-server sealing key magic constant")

    (field ^:private ^:static ^:final ^String SVR_CONF_MAGIC
      "Digest H(A1) to server-to-client sealing key magic constant")

    (field ^:private ^Cipher encCipher)

    (field ^:private ^Cipher decCipher)

    (constructor :throws [SaslException] [this ^boolean clientMode]
      (super. clientMode)
      (try
        (.generatePrivacyKeyPair this clientMode)
        (catch SaslException e (throw e))
        (catch IOException e
          (throw (SaslException.
                   "DIGEST-MD5: Error accessing buffers required to generate cipher keys"
                   e)))
        (catch NoSuchAlgorithmException e
          (throw (SaslException. "DIGEST-MD5: Error creating instance of required cipher or digest"
                                 e)))))

    (method ^:private generatePrivacyKeyPair :throws [IOException
                                                      NoSuchAlgorithmException
                                                      SaslException] ^void [this ^boolean clientMode]
      (let [ccmagic (.getBytes CLIENT_CONF_MAGIC encoding)
            scmagic (.getBytes SVR_CONF_MAGIC encoding)
            md5 (MessageDigest/getInstance "MD5")
            ^int n (cond
                     (.equals negotiatedCipher (aget CIPHER_TOKENS RC4_40)) 5
                     (.equals negotiatedCipher (aget CIPHER_TOKENS RC4_56)) 7
                     :else 16)]
        (let [keyBuffer (new byte/1 (unchecked-add-int n (alength ccmagic)))]
          (System/arraycopy H_A1 0 keyBuffer 0 n)
          (System/arraycopy ccmagic 0 keyBuffer n (alength ccmagic))
          (.update md5 keyBuffer)
          (let [Kcc (.digest md5)]
            (System/arraycopy scmagic 0 keyBuffer n (alength scmagic))
            (.update md5 keyBuffer)
            (let [Kcs (.digest md5)]
              (when (.isLoggable AbstractSaslImpl/logger Level/FINER)
                (AbstractSaslImpl/traceOutput DP_CLASS_NAME
                                              "generatePrivacyKeyPair"
                                              "DIGEST24:Kcc: "
                                              Kcc)
                (AbstractSaslImpl/traceOutput DP_CLASS_NAME
                                              "generatePrivacyKeyPair"
                                              "DIGEST25:Kcs: "
                                              Kcs))
              (let [^:mutable ^byte/1 myKc nil
                    ^:mutable ^byte/1 peerKc nil]
                (if clientMode
                    (do (set! myKc Kcc) (set! peerKc Kcs))
                    (do (set! myKc Kcs) (set! peerKc Kcc)))
                (try
                  (let [^:mutable ^SecretKey encKey nil
                        ^:mutable ^SecretKey decKey nil]
                    (cond
                      (> (.indexOf negotiatedCipher (aget CIPHER_TOKENS RC4)) -1)
                        (do
                          (set! encCipher (Cipher/getInstance "RC4"))
                          (set! decCipher (Cipher/getInstance "RC4"))
                          (set! encKey (SecretKeySpec. myKc "RC4"))
                          (set! decKey (SecretKeySpec. peerKc "RC4"))
                          (.init encCipher Cipher/ENCRYPT_MODE encKey)
                          (.init decCipher Cipher/DECRYPT_MODE decKey))
                      (or (.equals negotiatedCipher (aget CIPHER_TOKENS DES))
                          (.equals negotiatedCipher (aget CIPHER_TOKENS DES3)))
                        (let [^:mutable ^String cipherFullname nil
                              ^:mutable ^String cipherShortname nil]
                          (if (.equals negotiatedCipher (aget CIPHER_TOKENS DES))
                              (do
                                (set! cipherFullname "DES/CBC/NoPadding")
                                (set! cipherShortname "des"))
                              (do
                                (set! cipherFullname "DESede/CBC/NoPadding")
                                (set! cipherShortname "desede")))
                          (set! encCipher (Cipher/getInstance cipherFullname))
                          (set! decCipher (Cipher/getInstance cipherFullname))
                          (set! encKey (DigestMD5Base/makeDesKeys myKc cipherShortname))
                          (set! decKey (DigestMD5Base/makeDesKeys peerKc cipherShortname))
                          (let [encIv (IvParameterSpec. myKc 8 8)
                                decIv (IvParameterSpec. peerKc 8 8)]
                            (.init encCipher Cipher/ENCRYPT_MODE encKey encIv)
                            (.init decCipher Cipher/DECRYPT_MODE decKey decIv)
                            (when (.isLoggable AbstractSaslImpl/logger Level/FINER)
                              (AbstractSaslImpl/traceOutput
                                DP_CLASS_NAME
                                "generatePrivacyKeyPair"
                                (java-str "DIGEST26:" negotiatedCipher " IVcc: ")
                                (.getIV encIv))
                              (AbstractSaslImpl/traceOutput
                                DP_CLASS_NAME
                                "generatePrivacyKeyPair"
                                (java-str "DIGEST27:" negotiatedCipher " IVcs: ")
                                (.getIV decIv))
                              (AbstractSaslImpl/traceOutput
                                DP_CLASS_NAME
                                "generatePrivacyKeyPair"
                                (java-str "DIGEST28:" negotiatedCipher " encryption key: ")
                                (.getEncoded encKey))
                              (AbstractSaslImpl/traceOutput
                                DP_CLASS_NAME
                                "generatePrivacyKeyPair"
                                (java-str "DIGEST29:" negotiatedCipher " decryption key: ")
                                (.getEncoded decKey)))))))
                  (catch InvalidKeySpecException e
                    (throw (SaslException. "DIGEST-MD5: Unsupported key specification used." e)))
                  (catch InvalidAlgorithmParameterException e
                    (throw
                      (SaslException.
                        "DIGEST-MD5: Invalid cipher algorithm parameter used to create cipher instance"
                        e)))
                  (catch NoSuchPaddingException e
                    (throw (SaslException. "DIGEST-MD5: Unsupported padding used for chosen cipher"
                                           e)))
                  (catch InvalidKeyException e
                    (throw (SaslException. "DIGEST-MD5: Invalid data used to initialize keys" e))))))))))

    (method ^:public wrap :throws [SaslException] ^byte/1 [this ^byte/1 outgoing ^int start ^int len]
      (if (== len 0)
          EMPTY_BYTE_ARRAY
          (do
            (.incrementSeqNum this)
            (let [mac (.getHMAC this (.-myKi this) (.-sequenceNum this) outgoing start len)]
              (when (.isLoggable AbstractSaslImpl/logger Level/FINEST)
                (AbstractSaslImpl/traceOutput DP_CLASS_NAME
                                              "wrap"
                                              "DIGEST30:Outgoing: "
                                              outgoing
                                              start
                                              len)
                (AbstractSaslImpl/traceOutput DP_CLASS_NAME "wrap" "seqNum: " (.-sequenceNum this))
                (AbstractSaslImpl/traceOutput DP_CLASS_NAME "wrap" "MAC: " mac))
              (let [bs (.getBlockSize encCipher)
                    ^:mutable ^byte/1 padding nil]
                (if (> bs 1)
                    (let [pad (unchecked-subtract-int
                                bs
                                (unchecked-remainder-int (unchecked-add-int len 10) bs))]
                      (set! padding (new byte/1 pad))
                      (loop [^int i 0]
                        (when (< i pad)
                          (aset padding i (unchecked-byte pad))
                          (recur (unchecked-inc-int i)))))
                    (set! padding EMPTY_BYTE_ARRAY))
                (let [toBeEncrypted (new byte/1
                                         (unchecked-add-int
                                           (unchecked-add-int len (alength padding))
                                           10))]
                  (System/arraycopy outgoing start toBeEncrypted 0 len)
                  (System/arraycopy padding 0 toBeEncrypted len (alength padding))
                  (System/arraycopy mac
                                    0
                                    toBeEncrypted
                                    (unchecked-add-int len (alength padding))
                                    10)
                  (when (.isLoggable AbstractSaslImpl/logger Level/FINEST)
                    (AbstractSaslImpl/traceOutput
                      DP_CLASS_NAME
                      "wrap"
                      "DIGEST31:{msg, pad, KicMAC}: "
                      toBeEncrypted))
                  (let [^:mutable ^byte/1 cipherBlock nil]
                    (try
                      (set! cipherBlock (.update encCipher toBeEncrypted))
                      (when (nil? cipherBlock)
                        (throw (IllegalBlockSizeException. (java-str "" (alength toBeEncrypted)))))
                      (catch IllegalBlockSizeException e
                        (throw (SaslException. "DIGEST-MD5: Invalid block size for cipher" e))))
                    (let [wrapped (new byte/1
                                       (unchecked-add-int
                                         (unchecked-add-int (alength cipherBlock) 2)
                                         4))]
                      (System/arraycopy cipherBlock 0 wrapped 0 (alength cipherBlock))
                      (System/arraycopy (.-messageType this) 0 wrapped (alength cipherBlock) 2)
                      (System/arraycopy (.-sequenceNum this)
                                        0
                                        wrapped
                                        (unchecked-add-int (alength cipherBlock) 2)
                                        4)
                      (when (.isLoggable AbstractSaslImpl/logger Level/FINEST)
                        (AbstractSaslImpl/traceOutput
                          DP_CLASS_NAME
                          "wrap"
                          "DIGEST32:Wrapped: "
                          wrapped))
                      wrapped))))))))

    (method ^:public unwrap :throws [SaslException] ^byte/1 [this ^byte/1 incoming ^int start
                                                             ^int len]
      (if (== len 0)
          EMPTY_BYTE_ARRAY
          (let [encryptedMsg (new byte/1 (unchecked-subtract-int len 6))
                msgType (new byte/1 2)
                seqNum (new byte/1 4)]
            (System/arraycopy incoming start encryptedMsg 0 (alength encryptedMsg))
            (System/arraycopy incoming (unchecked-add-int start (alength encryptedMsg)) msgType 0 2)
            (System/arraycopy incoming
                              (unchecked-add-int (unchecked-add-int start (alength encryptedMsg)) 2)
                              seqNum
                              0
                              4)
            (when (.isLoggable AbstractSaslImpl/logger Level/FINEST)
              (.log AbstractSaslImpl/logger
                    Level/FINEST
                    "DIGEST33:Expecting sequence num: {0}"
                    (.-peerSeqNum this))
              (AbstractSaslImpl/traceOutput DP_CLASS_NAME
                                            "unwrap"
                                            "DIGEST34:incoming: "
                                            encryptedMsg))
            (let [^:mutable ^byte/1 decryptedMsg nil]
              (try
                (set! decryptedMsg (.update decCipher encryptedMsg))
                (when (nil? decryptedMsg)
                  (throw (IllegalBlockSizeException. (java-str "" (alength encryptedMsg)))))
                (catch IllegalBlockSizeException e
                  (throw (SaslException. "DIGEST-MD5: Illegal block sizes used with chosen cipher"
                                         e))))
              (let [msgWithPadding (new byte/1 (unchecked-subtract-int (alength decryptedMsg) 10))
                    mac (new byte/1 10)]
                (System/arraycopy decryptedMsg 0 msgWithPadding 0 (alength msgWithPadding))
                (System/arraycopy decryptedMsg (alength msgWithPadding) mac 0 10)
                (when (.isLoggable AbstractSaslImpl/logger Level/FINEST)
                  (AbstractSaslImpl/traceOutput DP_CLASS_NAME
                                                "unwrap"
                                                "DIGEST35:Unwrapped (w/padding): "
                                                msgWithPadding)
                  (AbstractSaslImpl/traceOutput DP_CLASS_NAME "unwrap" "DIGEST36:MAC: " mac)
                  (AbstractSaslImpl/traceOutput DP_CLASS_NAME
                                                "unwrap"
                                                "DIGEST37:messageType: "
                                                msgType)
                  (AbstractSaslImpl/traceOutput DP_CLASS_NAME
                                                "unwrap"
                                                "DIGEST38:sequenceNum: "
                                                seqNum))
                (let [^:mutable msgLength (alength msgWithPadding)
                      blockSize (.getBlockSize decCipher)]
                  (when (> blockSize 1)
                    (set! msgLength
                          (unchecked-subtract-int
                            msgLength
                            (int (aget msgWithPadding
                                       (unchecked-subtract-int (alength msgWithPadding) 1)))))
                    (when (< msgLength 0)
                      (when (.isLoggable AbstractSaslImpl/logger Level/INFO)
                        (.log AbstractSaslImpl/logger
                              Level/INFO
                              "DIGEST39:Incorrect padding: {0}"
                              (aget msgWithPadding
                                    (unchecked-subtract-int (alength msgWithPadding) 1))))
                      (return EMPTY_BYTE_ARRAY)))
                  (let [expectedMac (.getHMAC this
                                              (.-peerKi this)
                                              seqNum
                                              msgWithPadding
                                              0
                                              msgLength)]
                    (when (.isLoggable AbstractSaslImpl/logger Level/FINEST)
                      (AbstractSaslImpl/traceOutput
                        DP_CLASS_NAME
                        "unwrap"
                        "DIGEST40:KisMAC: "
                        expectedMac))
                    (if (not (Arrays/equals mac expectedMac))
                        (do
                          (.log AbstractSaslImpl/logger Level/INFO "DIGEST41:Unmatched MACs")
                          EMPTY_BYTE_ARRAY)
                        (do
                          (when-not (== (.-peerSeqNum this)
                                        (AbstractSaslImpl/networkByteOrderToInt seqNum 0 4))
                            (throw
                              (SaslException.
                                (java-str
                                  "DIGEST-MD5: Out of order sequencing of messages from server. Got: "
                                  (AbstractSaslImpl/networkByteOrderToInt seqNum 0 4)
                                  " Expected: "
                                  (.-peerSeqNum this)))))
                          (when-not (Arrays/equals (.-messageType this) msgType)
                            (throw
                              (SaslException.
                                (java-str "DIGEST-MD5: invalid message type: "
                                          (AbstractSaslImpl/networkByteOrderToInt msgType 0 2)))))
                          (set! (.-peerSeqNum this) (unchecked-inc-int (.-peerSeqNum this)))
                          (if (== msgLength (alength msgWithPadding))
                              msgWithPadding
                              (let [clearMsg (new byte/1 msgLength)]
                                (System/arraycopy msgWithPadding 0 clearMsg 0 msgLength)
                                clearMsg))))))))))))

  (field ^:private ^:static ^:final ^BigInteger MASK (BigInteger. "7f" 16))

  (method ^:private ^:static setParityBit ^void [^byte/1 key]
    (loop [^int i 0]
      (when (< i (alength key))
        (let [^:mutable b (bit-and-int (aget key i) 0xfe)]
          (set! b (bit-or-int b (bit-xor-int (bit-and-int (Integer/bitCount b) 1) 1)))
          (aset key i (unchecked-byte b))
          (recur (unchecked-inc-int i))))))

  (method ^:private ^:static addDesParity ^byte/1 [^byte/1 input ^int offset ^int len]
    (when-not (== len 7)
      (throw (IllegalArgumentException. (java-str "Invalid length of DES Key Value:" len))))
    (let [raw (new byte/1 7)]
      (System/arraycopy input offset raw 0 len)
      (let [result (new byte/1 8)
            ^:mutable in (BigInteger. raw)]
        (loop [^int i (unchecked-subtract-int (alength result) 1)]
          (when (>= i 0)
            (aset result i (aget (.toByteArray (.and in MASK)) 0))
            (aset result i (unchecked-byte (bit-shift-left-int (aget result i) 1)))
            (set! in (.shiftRight in 7))
            (recur (unchecked-dec-int i))))
        (DigestMD5Base/setParityBit result)
        result)))

  (method ^:private ^:static makeDesKeys :throws [NoSuchAlgorithmException
                                                  InvalidKeyException
                                                  InvalidKeySpecException] ^SecretKey [^byte/1 input
                                                                                       ^String desStrength]
    (let [subkey1 (DigestMD5Base/addDesParity input 0 7)
          ^:mutable ^KeySpec spec nil
          desFactory (SecretKeyFactory/getInstance desStrength)]
      (switch desStrength
        "des"
          (do
            (set! spec (DESKeySpec. subkey1 0))
            (when (.isLoggable DigestMD5Base/logger Level/FINEST)
              (DigestMD5Base/traceOutput DP_CLASS_NAME
                                         "makeDesKeys"
                                         "DIGEST42:DES key input: "
                                         input)
              (DigestMD5Base/traceOutput DP_CLASS_NAME
                                         "makeDesKeys"
                                         "DIGEST43:DES key parity-adjusted: "
                                         subkey1)
              (DigestMD5Base/traceOutput DP_CLASS_NAME
                                         "makeDesKeys"
                                         "DIGEST44:DES key material: "
                                         (.getKey (cast DESKeySpec spec)))
              (.log DigestMD5Base/logger
                    Level/FINEST
                    "DIGEST45: is parity-adjusted? {0}"
                    (Boolean/valueOf (DESKeySpec/isParityAdjusted subkey1 0)))))
        "desede"
          (let [subkey2 (DigestMD5Base/addDesParity input 7 7)
                ede (new byte/1
                         (unchecked-add-int (unchecked-multiply-int (alength subkey1) 2)
                                            (alength subkey2)))]
            (System/arraycopy subkey1 0 ede 0 (alength subkey1))
            (System/arraycopy subkey2 0 ede (alength subkey1) (alength subkey2))
            (System/arraycopy subkey1
                              0
                              ede
                              (unchecked-add-int (alength subkey1) (alength subkey2))
                              (alength subkey1))
            (set! spec (DESedeKeySpec. ede 0))
            (when (.isLoggable DigestMD5Base/logger Level/FINEST)
              (DigestMD5Base/traceOutput DP_CLASS_NAME
                                         "makeDesKeys"
                                         "DIGEST46:3DES key input: "
                                         input)
              (DigestMD5Base/traceOutput DP_CLASS_NAME "makeDesKeys" "DIGEST47:3DES key ede: " ede)
              (DigestMD5Base/traceOutput DP_CLASS_NAME
                                         "makeDesKeys"
                                         "DIGEST48:3DES key material: "
                                         (.getKey (cast DESedeKeySpec spec)))
              (.log DigestMD5Base/logger
                    Level/FINEST
                    "DIGEST49: is parity-adjusted? "
                    (Boolean/valueOf (DESedeKeySpec/isParityAdjusted ede 0)))))
        (throw (IllegalArgumentException. (java-str "Invalid DES strength:" desStrength))))
      (.generateSecret desFactory spec))))

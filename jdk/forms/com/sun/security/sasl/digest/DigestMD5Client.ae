      (throw
        (SaslException.
          "DIGEST-MD5: Authentication failed. Expecting 'rspauth' authentication success message")))
    (try
      (let [expected (.generateResponseValue this
                                             ""
                                             (.-digestUri this)
                                             (.-negotiatedQop this)
                                             username
                                             (.-negotiatedRealm this)
                                             passwd
                                             (.-nonce this)
                                             cnonce
                                             nonceCount
                                             authzidBytes)]
        (when-not (Arrays/equals expected fromServer)
          (throw (SaslException. "Server's rspauth value does not match what client expects"))))
      (catch [NoSuchAlgorithmException IOException] e
        (throw (SaslException. "Problem generating response value for verification" e)))))


  (method ^:private generateClientResponse :throws [IOException] ^byte/1 [this ^byte/1 charset]
    (let [digestResp (ByteArrayOutputStream.)]
      (when (.-useUTF8 this)
        (.write digestResp (.getBytes "charset=" (.-encoding this)))
        (.write digestResp charset)
        (.write digestResp \,))
      (.write digestResp
              (.getBytes (java-str "username=\"" (DigestMD5Client/quotedStringValue username) "\",")

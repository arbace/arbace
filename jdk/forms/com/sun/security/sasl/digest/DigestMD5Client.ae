      (when (> (.length (.-negotiatedRealm this)) 0)
        (.write digestResp
                (.getBytes (java-str "realm=\""
                                     (DigestMD5Client/quotedStringValue (.-negotiatedRealm this))
                                     "\",")
                           (.-encoding this))))
      (.write digestResp (.getBytes "nonce=\"" (.-encoding this)))
      (DigestMD5Client/writeQuotedStringValue digestResp (.-nonce this))
      (.write digestResp \")
      (.write digestResp \,)
      (set! nonceCount (DigestMD5Client/getNonceCount (.-nonce this)))
      (.write digestResp
              (.getBytes (java-str "nc=" (DigestMD5Client/nonceCountToHex nonceCount) ",")
                         (.-encoding this)))
      (set! cnonce (DigestMD5Client/generateNonce))
      (.write digestResp (.getBytes "cnonce=\"" (.-encoding this)))
      (DigestMD5Client/writeQuotedStringValue digestResp cnonce)
      (.write digestResp (.getBytes "\"," (.-encoding this)))
      (.write digestResp
              (.getBytes (java-str "digest-uri=\"" (.-digestUri this) "\",") (.-encoding this)))
      (.write digestResp (.getBytes "maxbuf=" (.-encoding this)))
      (.write digestResp (.getBytes (String/valueOf (.-recvMaxBufSize this)) (.-encoding this)))
      (.write digestResp \,)
      (try
        (.write digestResp (.getBytes "response=" (.-encoding this)))
        (.write digestResp
                (.generateResponseValue this
                                        "AUTHENTICATE"
                                        (.-digestUri this)
                                        (.-negotiatedQop this)
                                        username
                                        (.-negotiatedRealm this)
                                        passwd
                                        (.-nonce this)
                                        cnonce
                                        nonceCount
                                        authzidBytes))
        (.write digestResp \,)
        (catch Exception e (throw (SaslException. "DIGEST-MD5: Error generating response value" e))))
      (.write digestResp (.getBytes (java-str "qop=" (.-negotiatedQop this)) (.-encoding this)))
      (when (some? (.-negotiatedCipher this))
        (.write
          digestResp
          (.getBytes (java-str ",cipher=\"" (.-negotiatedCipher this) "\"") (.-encoding this))))
      (when (some? authzidBytes)
        (.write digestResp (.getBytes ",authzid=\"" (.-encoding this)))

  (method ^:private ^:static uriMatches ^boolean [^String thisUri ^String incomingUri]
    (cond
      (.equalsIgnoreCase thisUri incomingUri) true
      (.endsWith thisUri "/*")
        (let [protoAndSlash (unchecked-subtract-int (.length thisUri) 1)
              thisProtoAndSlash (.substring thisUri 0 protoAndSlash)
              incomingProtoAndSlash (.substring incomingUri 0 protoAndSlash)]
          (.equalsIgnoreCase thisProtoAndSlash incomingProtoAndSlash))
      :else false))


          (do
            (try
              (set! ctx (InitialLdapContext. ldapEnvironment nil))
              (catch NamingException e
                (throw
                  (cast LoginException
                        (.initCause (FailedLoginException. "Cannot connect to LDAP server") e)))))
            (set! dn (.findUserDN this ctx))
            (try
              (.addToEnvironment ctx Context/SECURITY_AUTHENTICATION "simple")
              (.addToEnvironment ctx Context/SECURITY_PRINCIPAL dn)

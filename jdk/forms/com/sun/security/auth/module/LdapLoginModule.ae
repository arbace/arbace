        (let [canonicalUserFilter (.replaceUsernameToken
                                    this
                                    filterMatcher
                                    userFilter
                                    (.escapeUsernameChars this))
              ^{:tag (NamingEnumeration SearchResult)} results (.search
                                                                 ctx
                                                                 ""
                                                                 canonicalUserFilter
                                                                 constraints)]
          (cond
            (.hasMore results)
              (let [entry (cast SearchResult (.next results))]
                (set! userDN (.getNameInNamespace entry))
                (when debug
                  (.println System/out (java-str "\t\t[LdapLoginModule] found entry: " userDN)))
                (when (some? authzIdentityAttr)
                  (let [attr (.get (.getAttributes entry) authzIdentityAttr)]
                    (when (some? attr)
                      (let [val (.get attr)]

          (throw ^LoginException (FailedLoginException. "Cannot find user's LDAP entry"))
          userDN)))

  (method ^:private escapeUsernameChars ^String [this]
    (let [len (.length username)
          escapedUsername (StringBuilder. (unchecked-add-int len 16))]
      (loop [^int i 0]
        (when (< i len)
          (let [c (.charAt username i)]
            (switch c
              \* (do (.append escapedUsername "\\\\2A") (recur (unchecked-inc-int i)))
              \( (do (.append escapedUsername "\\\\28") (recur (unchecked-inc-int i)))
              \) (do (.append escapedUsername "\\\\29") (recur (unchecked-inc-int i)))
              \\ (do (.append escapedUsername "\\\\5C") (recur (unchecked-inc-int i)))
              \u0000 (do (.append escapedUsername "\\\\00") (recur (unchecked-inc-int i)))
              (do (.append escapedUsername c) (recur (unchecked-inc-int i)))))))
      (.toString escapedUsername)))

  (method ^:private replaceUsernameToken ^String [this ^Matcher matcher ^String string
                                                  ^String username]
    (if (some? matcher) (.replaceAll matcher username) string))

  (method ^:private getUsernamePassword :throws [LoginException] ^void [this
                                                                        ^boolean getPasswdFromSharedState]
    (if getPasswdFromSharedState
        (do
          (set! username (cast String (.get sharedState USERNAME_KEY)))
          (set! password (cast char/1 (.get sharedState PASSWORD_KEY))))
        (do
          (when (nil? callbackHandler)
            (throw
              (LoginException.
                "No CallbackHandler available to acquire authentication information from the user")))
          (let [callbacks (new Callback/1 2)]
            (aset callbacks 0 (NameCallback. (ResourcesMgr/getAuthResourceString "username.")))
            (aset callbacks
                  1
                  (PasswordCallback. (ResourcesMgr/getAuthResourceString "password.") false))
            (try
              (.handle callbackHandler callbacks)
              (set! username (.getName (cast NameCallback (aget callbacks 0))))
              (let [tmpPassword (.getPassword (cast PasswordCallback (aget callbacks 1)))]
                (set! password (new char/1 (alength tmpPassword)))
                (System/arraycopy tmpPassword 0 password 0 (alength tmpPassword))
                (.clearPassword (cast PasswordCallback (aget callbacks 1))))
              (catch IOException ioe (throw (LoginException. (.toString ioe))))
              (catch UnsupportedCallbackException uce
                (throw (LoginException.
                         (java-str
                           "Error: "
                           (.toString (.getCallback uce))
                           " not available to acquire authentication information from the user")))))))))

  (method ^:private cleanState ^void [this]
    (set! username nil)
    (when (some? password) (Arrays/fill password \space) (set! password nil))
    (try (when (some? ctx) (.close ctx)) (catch NamingException e))
    (set! ctx nil)
    (when clearPass (.remove sharedState USERNAME_KEY) (.remove sharedState PASSWORD_KEY))))

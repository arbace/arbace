    (if (.equalsIgnoreCase "false" (cast String (.get options "useSSL")))
        (do (set! useSSL false) (.remove ldapEnvironment Context/SECURITY_PROTOCOL))
        (.put ldapEnvironment Context/SECURITY_PROTOCOL "ssl"))
    (set! tryFirstPass (.equalsIgnoreCase "true" (cast String (.get options "tryFirstPass"))))
    (set! useFirstPass (.equalsIgnoreCase "true" (cast String (.get options "useFirstPass"))))
    (set! storePass (.equalsIgnoreCase "true" (cast String (.get options "storePass"))))
    (set! clearPass (.equalsIgnoreCase "true" (cast String (.get options "clearPass"))))
    (set! debug (.equalsIgnoreCase "true" (cast String (.get options "debug"))))

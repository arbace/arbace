    (set! (.-callbackHandler this) callbackHandler)
    (set! (.-sharedState this) sharedState)
    (set! (.-options this) options)
    (set! ldapEnvironment (Hashtable. 9))
    (.put ldapEnvironment Context/INITIAL_CONTEXT_FACTORY "com.sun.jndi.ldap.LdapCtxFactory")
    (for-each [^String key (.keySet options)]
      (when (> (.indexOf key \.) -1) (.put ldapEnvironment key (.get options key))))
    (set! userProvider (cast String (.get options USER_PROVIDER)))
    (when (some? userProvider) (.put ldapEnvironment Context/PROVIDER_URL userProvider))
    (set! authcIdentity (cast String (.get options AUTHC_IDENTITY)))

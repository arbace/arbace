  (method ^:private findUserDN :throws [LoginException] ^String [this ^LdapContext ctx]
    (let [^:mutable userDN ""]
      (if (some? userFilter)
          (when debug
            (.println System/out
                      (java-str "\t\t[LdapLoginModule] searching for entry belonging to user: "
                                username)))
          (do
            (when debug
              (.println System/out
                        (java-str
                          "\t\t[LdapLoginModule] cannot search for entry belonging to user: "
                          username)))
            (throw ^LoginException (FailedLoginException. "Cannot find user's LDAP entry"))))

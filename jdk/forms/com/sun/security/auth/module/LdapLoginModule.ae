                              (if useSSL "SSL enabled" "SSL disabled"))))))

  (method ^:public login :throws [LoginException] ^boolean [this]
    (when (nil? userProvider)
      (throw (LoginException. "Unable to locate the LDAP directory service")))
    (when debug
      (.println System/out (java-str "\t\t[LdapLoginModule] user provider: " userProvider)))
    (cond
      tryFirstPass
        (try
          (.attemptAuthentication this true)
          (set! succeeded true)
          (when debug (.println System/out "\t\t[LdapLoginModule] tryFirstPass succeeded"))
          (return true)
          (catch LoginException le
            (.cleanState this)
            (when debug
              (.println System/out
                        (java-str "\t\t[LdapLoginModule] tryFirstPass failed: " (.toString le))))))
      useFirstPass
        (try
          (.attemptAuthentication this true)
          (set! succeeded true)
          (when debug (.println System/out "\t\t[LdapLoginModule] useFirstPass succeeded"))
          (return true)
          (catch LoginException le
            (.cleanState this)
            (when debug (.println System/out "\t\t[LdapLoginModule] useFirstPass failed"))
            (throw le))))
    (try
      (.attemptAuthentication this false)
      (set! succeeded true)
      (when debug (.println System/out "\t\t[LdapLoginModule] authentication succeeded"))
      true
      (catch LoginException le
        (.cleanState this)
        (when debug (.println System/out "\t\t[LdapLoginModule] authentication failed"))
        (throw le))))

  (method ^:public commit :throws [LoginException] ^boolean [this]
    (if (= succeeded false)
        false
        (do
          (when (.isReadOnly subject)
            (.cleanState this)
            (throw (LoginException. "Subject is read-only")))
          (let [^{:tag (Set Principal)} principals (.getPrincipals subject)]
            (when-not (.contains principals ldapPrincipal) (.add principals ldapPrincipal))

          (.println System/out
                    (java-str "\t\t[LdapLoginModule] authentication-first mode; "
                              (if useSSL "SSL enabled" "SSL disabled")))
        authOnly
          (.println System/out
                    (java-str "\t\t[LdapLoginModule] authentication-only mode; "
                              (if useSSL "SSL enabled" "SSL disabled")))

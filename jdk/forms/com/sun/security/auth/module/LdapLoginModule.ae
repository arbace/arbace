                        (java-str "\t\t[LdapLoginModule] added UserPrincipal \""
                                  userPrincipal
                                  "\" to Subject")))
            (when (and (some? authzPrincipal) (not (.contains principals authzPrincipal)))
              (.add principals authzPrincipal)
              (when debug
                (.println System/out
                          (java-str "\t\t[LdapLoginModule] added UserPrincipal \""
                                    authzPrincipal
                                    "\" to Subject")))))
          (.cleanState this)
          (set! commitSucceeded true)
          true)))


      (when (some? authzIdentity) (.remove principals authzPrincipal))
      (.cleanState this)
      (set! succeeded false)
      (set! commitSucceeded false)
      (set! ldapPrincipal nil)
      (set! userPrincipal nil)
      (set! authzPrincipal nil)

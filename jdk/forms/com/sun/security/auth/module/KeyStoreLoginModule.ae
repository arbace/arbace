                      (PasswordCallback. (ResourcesMgr/getAuthResourceString "Keystore.password.")
                                         false)))
            (.prompt this aliasCallback storePassCallback keyPassCallback))))
    (when debug (.debugPrint this (java-str "alias=" keyStoreAlias))))

  (method ^:private checkAlias :throws [LoginException] ^void [this]
    (when (nil? keyStoreAlias)
      (throw (LoginException.
               "Need to specify an alias option to use KeyStoreLoginModule non-interactively."))))

  (method ^:private checkStorePass :throws [LoginException] ^void [this]
    (when (nil? keyStorePasswordURL)
      (throw
        (LoginException.
          "Need to specify keyStorePasswordURL option to use KeyStoreLoginModule non-interactively.")))

                                         " then keyStoreURL must be ")
                               NONE))))
          (when (and token (some? privateKeyPasswordURL))
            (throw (LoginException.
                     (java-str (java-str "if keyStoreType is " P11KEYSTORE)
                               " then privateKeyPasswordURL must not be specified"))))
          (when (and protectedPath (or (some? keyStorePasswordURL) (some? privateKeyPasswordURL)))
            (throw
              (LoginException.
                "if protected is true then keyStorePasswordURL and privateKeyPasswordURL must not be specified")))
          (cond
            protectedPath (.getAliasAndPasswords this PROTECTED_PATH)
            token (.getAliasAndPasswords this TOKEN)
            :else (.getAliasAndPasswords this NORMAL))

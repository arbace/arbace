  (method ^:private processOptions ^void [this]
    (set! keyStoreURL (cast String (.get options "keyStoreURL")))
    (cond
      (nil? keyStoreURL)
        (set! keyStoreURL
              (java-str "file:"
                        (.replace (System/getProperty "user.home") File/separatorChar \/)
                        \/
                        ".keystore"))
      (.equals NONE keyStoreURL) (set! nullStream true))
    (set! keyStoreType (cast String (.get options "keyStoreType")))
    (when (nil? keyStoreType) (set! keyStoreType (KeyStore/getDefaultType)))
    (when (.equalsIgnoreCase P11KEYSTORE keyStoreType) (set! token true))
    (set! keyStoreProvider (cast String (.get options "keyStoreProvider")))
    (set! keyStoreAlias (cast String (.get options "keyStoreAlias")))
    (set! keyStorePasswordURL (cast String (.get options "keyStorePasswordURL")))
    (set! privateKeyPasswordURL (cast String (.get options "privateKeyPasswordURL")))
    (set! protectedPath (.equalsIgnoreCase "true" (cast String (.get options "protected"))))
    (set! debug (.equalsIgnoreCase "true" (cast String (.get options "debug"))))

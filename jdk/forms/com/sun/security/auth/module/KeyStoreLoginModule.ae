                                                (nil? keyStoreAlias)
                                                (== (.length keyStoreAlias) 0))
                                              (NameCallback.
                                                (ResourcesMgr/getAuthResourceString
                                                  "Keystore.alias."))
                                              (NameCallback.
                                                (ResourcesMgr/getAuthResourceString
                                                  "Keystore.alias.")
                                                keyStoreAlias))]
          (let [^:mutable ^PasswordCallback storePassCallback nil
                ^:mutable ^PasswordCallback keyPassCallback nil]
            (switch env
              PROTECTED_PATH nil
              NORMAL
                (do
                  (set! keyPassCallback
                        (PasswordCallback.
                          (ResourcesMgr/getAuthResourceString "Private.key.password.optional.")
                          false))
                  (set! storePassCallback
                        (PasswordCallback. (ResourcesMgr/getAuthResourceString "Keystore.password.")
                                           false)))
              TOKEN

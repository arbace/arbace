      (throw (LoginException. "The login module is not initialized"))))

  (method ^:private getAliasAndPasswords :throws [LoginException] ^void [this ^int env]
    (if (nil? callbackHandler)
        (switch env
          PROTECTED_PATH (.checkAlias this)
          TOKEN (do (.checkAlias this) (.checkStorePass this))
          NORMAL (do (.checkAlias this) (.checkStorePass this) (.checkKeyPass this)))

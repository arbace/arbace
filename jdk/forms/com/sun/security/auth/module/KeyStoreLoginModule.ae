            (.handle callbackHandler
                     (new Callback/1 [bannerCallback aliasCallback confirmationCallback]))
            (catch IOException e
              (let [le (LoginException. "Problem retrieving keystore alias")]
                (.initCause le e)
                (throw le)))
            (catch UnsupportedCallbackException e
              (throw
                (LoginException.
                  (java-str
                    "Error: "
                    (.toString (.getCallback e))
                    " is not available to retrieve authentication  information from the user")))))
          (let [confirmationResult (.getSelectedIndex confirmationCallback)]
            (when (== confirmationResult ConfirmationCallback/CANCEL)
              (throw (LoginException. "Login cancelled")))
            (.saveAlias this aliasCallback)))
      (nil? keyPassCallback)
        (do
          (try
            (.handle callbackHandler
                     (new Callback/1
                          [bannerCallback aliasCallback storePassCallback confirmationCallback]))
            (catch IOException e
              (let [le (LoginException. "Problem retrieving keystore alias and password")]
                (.initCause le e)
                (throw le)))
            (catch UnsupportedCallbackException e
              (throw
                (LoginException.
                  (java-str
                    "Error: "
                    (.toString (.getCallback e))
                    " is not available to retrieve authentication  information from the user")))))
          (let [confirmationResult (.getSelectedIndex confirmationCallback)]
            (when (== confirmationResult ConfirmationCallback/CANCEL)
              (throw (LoginException. "Login cancelled")))
            (.saveAlias this aliasCallback)
            (.saveStorePass this storePassCallback)))
      :else
        (do
          (try
            (.handle callbackHandler
                     (new Callback/1
                          [bannerCallback aliasCallback storePassCallback keyPassCallback
                           confirmationCallback]))
            (catch IOException e
              (let [le (LoginException. "Problem retrieving keystore alias and passwords")]
                (.initCause le e)
                (throw le)))
            (catch UnsupportedCallbackException e
              (throw
                (LoginException.
                  (java-str
                    "Error: "
                    (.toString (.getCallback e))
                    " is not available to retrieve authentication  information from the user")))))
          (let [confirmationResult (.getSelectedIndex confirmationCallback)]
            (when (== confirmationResult ConfirmationCallback/CANCEL)
              (throw (LoginException. "Login cancelled")))
            (.saveAlias this aliasCallback)
            (.saveStorePass this storePassCallback)
            (.saveKeyPass this keyPassCallback)))))

  (method ^:private saveAlias ^void [this ^NameCallback cb]
    (set! keyStoreAlias (.getName cb)))

  (method ^:private saveStorePass ^void [this ^PasswordCallback c]
    (set! keyStorePassword (.getPassword c))
    (when (nil? keyStorePassword) (set! keyStorePassword (new char/1 0)))
    (.clearPassword c))

  (method ^:private saveKeyPass ^void [this ^PasswordCallback c]
    (set! privateKeyPassword (.getPassword c))
    (when (or (nil? privateKeyPassword) (== (alength privateKeyPassword) 0))
      (set! privateKeyPassword keyStorePassword))
    (.clearPassword c))

  (method ^:private getKeyStoreInfo :throws [LoginException] ^void [this]
    (try
      (if (nil? keyStoreProvider)
          (set! keyStore (KeyStore/getInstance keyStoreType))
          (set! keyStore (KeyStore/getInstance keyStoreType keyStoreProvider)))
      (catch KeyStoreException e
        (let [le (LoginException. "The specified keystore type was not available")]
          (.initCause le e)
          (throw le)))
      (catch NoSuchProviderException e
        (let [le (LoginException. "The specified keystore provider was not available")]
          (.initCause le e)
          (throw le))))
    (let [^:mutable ^InputStream in nil]
      (try
        (if nullStream
            (.load keyStore nil keyStorePassword)
            (do
              (set! in (.openStream (KeyStoreLoginModule/newURL keyStoreURL)))
              (.load keyStore in keyStorePassword)))
        (catch MalformedURLException e
          (let [le (LoginException. "Incorrect keyStoreURL option")] (.initCause le e) (throw le)))
        (catch [GeneralSecurityException IOException] e
          (let [le (LoginException. "Error initializing keystore")] (.initCause le e) (throw le)))
        (finally
          (when (some? in)
            (try
              (.close in)
              (catch IOException ioe
                (let [le (LoginException. "Error initializing keystore")]
                  (.initCause le ioe)
                  (throw le)))))))
      (try
        (set! fromKeyStore (.getCertificateChain keyStore keyStoreAlias))
        (if (or (or (nil? fromKeyStore) (== (alength fromKeyStore) 0))
                (not (instance? X509Certificate (aget fromKeyStore 0))))
            (throw (FailedLoginException. "Unable to find X.509 certificate chain in keystore"))
            (let [^{:tag (LinkedList Certificate)} certList (LinkedList.)]
              (loop [^int i 0]
                (when (< i (alength fromKeyStore))
                  (.add certList (aget fromKeyStore i))
                  (recur (unchecked-inc-int i))))
              (let [certF (CertificateFactory/getInstance "X.509")]
                (set! certP (.generateCertPath certF certList)))))
        (catch KeyStoreException e
          (let [le (LoginException. "Error using keystore")] (.initCause le e) (throw le)))
        (catch CertificateException ce
          (let [le (LoginException. "Error: X.509 Certificate type unavailable")]
            (.initCause le ce)
            (throw le))))
      (try
        (let [certificate (cast X509Certificate (aget fromKeyStore 0))]
          (set! principal (.getSubjectX500Principal certificate))
          (let [key (.getKey keyStore keyStoreAlias privateKeyPassword)]
            (if-instance [^PrivateKey privateKey key]
              (set! privateCredential (X500PrivateCredential. certificate privateKey keyStoreAlias))
              (throw (FailedLoginException. "Unable to recover key from keystore")))))
        (catch [KeyStoreException NoSuchAlgorithmException] e
          (let [le (LoginException. "Error using keystore")] (.initCause le e) (throw le)))
        (catch UnrecoverableKeyException e
          (let [fle (FailedLoginException. "Unable to recover key from keystore")]
            (.initCause fle e)
            (throw fle))))
      (when debug
        (.debugPrint this
                     (java-str "principal="
                               principal
                               "\n certificate="
                               (.getCertificate privateCredential)
                               "\n alias ="
                               (.getAlias privateCredential))))))

  (method ^:public commit :throws [LoginException] ^boolean [this]
    (switch status
      INITIALIZED (do (.logoutInternal this) (throw (LoginException. "Authentication failed")))
      AUTHENTICATED
        (if (.commitInternal this)
            true
            (do (.logoutInternal this) (throw (LoginException. "Unable to retrieve certificates"))))
      LOGGED_IN true
      (throw (LoginException. "The login module is not initialized"))))

  (method ^:private commitInternal :throws [LoginException] ^boolean [this]
    (if (.isReadOnly subject)
        (throw (LoginException. "Subject is set readonly"))
        (do
          (.add (.getPrincipals subject) principal)
          (.add (.getPublicCredentials subject) certP)
          (.add (.getPrivateCredentials subject) privateCredential)
          (set! status LOGGED_IN)
          true)))

  (method ^:public abort :throws [LoginException] ^boolean [this]
    (switch status
      INITIALIZED false
      AUTHENTICATED (do (.logoutInternal this) true)
      LOGGED_IN (do (.logoutInternal this) true)
      false))

  (method ^:public logout :throws [LoginException] ^boolean [this]
    (when debug (.debugPrint this (java-str "Entering logout " status)))
    (switch status
      UNINITIALIZED (throw (LoginException. "The login module is not initialized"))
      LOGGED_IN (do (.logoutInternal this) true)
      false))

  (method ^:private logoutInternal :throws [LoginException] ^void [this]
    (when debug (.debugPrint this "Entering logoutInternal"))
    (let [^:mutable ^LoginException logoutException nil
          provider (.getProvider keyStore)]
      (when (instance? AuthProvider provider)
        (let [ap (cast AuthProvider provider)]
          (try
            (.logout ap)
            (when debug (.debugPrint this "logged out of KeyStore AuthProvider"))
            (catch LoginException le (set! logoutException le)))))
      (when (.isReadOnly subject)
        (set! principal nil)
        (set! certP nil)
        (set! status INITIALIZED)
        (when (some? privateCredential)
          (let [^{:tag (Iterator Object)} it (.iterator (.getPrivateCredentials subject))]
            (while (.hasNext it)
              (let [obj (.next it)]
                (when (.equals privateCredential obj)
                  (set! privateCredential nil)
                  (try
                    (.destroy (cast Destroyable obj))
                    (when debug
                      (.debugPrint this
                                   (java-str "Destroyed private credential, "
                                             (.getName (.getClass obj)))))
                    (break)
                    (catch DestroyFailedException dfe
                      (let [le (LoginException.
                                 (java-str "Unable to destroy private credential, "
                                           (.getName (.getClass obj))))]
                        (.initCause le dfe)
                        (throw le)))))))))
        (throw
          (LoginException.
            "Unable to remove Principal (X500Principal ) and public credential (certificatepath) from read-only Subject")))
      (when (some? principal) (.remove (.getPrincipals subject) principal) (set! principal nil))
      (when (some? certP) (.remove (.getPublicCredentials subject) certP) (set! certP nil))
      (when (some? privateCredential)
        (.remove (.getPrivateCredentials subject) privateCredential)
        (set! privateCredential nil))
      (when (some? logoutException) (throw logoutException))
      (set! status INITIALIZED)))

  (method ^:private debugPrint ^void [this ^String message]
    (if (nil? message)
        (.println System/err)
        (.println System/err (java-str "Debug KeyStoreLoginModule: " message))))

  (method ^:private ^:static newURL :throws [MalformedURLException] ^URL [^String spec]
    (URL. spec)))

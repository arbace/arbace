      (.debugPrint this (java-str "keyStoreURL=" keyStoreURL))
      (.debugPrint this (java-str "keyStoreType=" keyStoreType))
      (.debugPrint this (java-str "keyStoreProvider=" keyStoreProvider))
      (.debugPrint this (java-str "keyStoreAlias=" keyStoreAlias))
      (.debugPrint this (java-str "keyStorePasswordURL=" keyStorePasswordURL))
      (.debugPrint this (java-str "privateKeyPasswordURL=" privateKeyPasswordURL))
      (.debugPrint this (java-str "protectedPath=" protectedPath))
      (.debugPrint this nil)))

  (method ^:public login :throws [LoginException] ^boolean [this]

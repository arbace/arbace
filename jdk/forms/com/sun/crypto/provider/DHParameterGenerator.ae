  (field ^:private ^SecureRandom random nil)

  (method ^:private ^:static checkSupport :throws [InvalidParameterException] ^void [^int keysize
                                                                                     ^int exponentSize]
    (let [supported (or (or (== keysize 2048) (== keysize 3072))
                        (and (and (>= keysize 512) (<= keysize 1024))
                             (== (bit-and-int keysize 0x3F) 0)))]

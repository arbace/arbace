                                                 (DHParameterSpec.
                                                   (.getP dsaParamSpec)
                                                   (.getG dsaParamSpec)
                                                   (.-exponentSize this))
                                                 (DHParameterSpec.
                                                   (.getP dsaParamSpec)
                                                   (.getG dsaParamSpec)))]

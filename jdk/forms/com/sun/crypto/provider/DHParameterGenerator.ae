    (set! (.-primeSize this) keysize)
    (set! (.-random this) random))

  (method ^:protected engineInit :throws [InvalidAlgorithmParameterException] ^void [this
                                                                                     ^AlgorithmParameterSpec genParamSpec
                                                                                     ^SecureRandom random]

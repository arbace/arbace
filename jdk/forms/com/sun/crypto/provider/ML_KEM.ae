        (when (< m ML_KEM_N) (aset coeffs m (aget poly m)) (recur (unchecked-inc-int m))))
      (ML_KEM/seilerNTT coeffs)
      (loop [^int m 0]
        (when (< m ML_KEM_N)
          (aset poly m (unchecked-short (aget coeffs m)))
          (recur (unchecked-inc-int m))))))

  (method ^:private mlKemNTT ^void [this ^short/1 poly]
    (java-assert (== (alength poly) ML_KEM_N))

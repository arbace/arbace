      (when (< i mlKem_k) (ML_KEM/mlKemBarrettReduce (aget vector i)) (recur (unchecked-inc-int i))))
    vector)

  (method ^:private mlKemVectorInverseNTT ^short/2 [this ^short/2 vector]
    (loop [^int i 0]
      (when (< i mlKem_k)
        (aset vector i (.mlKemInverseNTT this (aget vector i)))
        (recur (unchecked-inc-int i))))
    vector)

  (method ^:static ^{IntrinsicCandidate true} implKyberNtt ^int [^short/1 poly ^short/1 ntt_zetas]

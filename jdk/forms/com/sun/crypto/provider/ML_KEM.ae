      (let [kHatAndRandomCoins (.digest mlKemG)
            randomCoins (Arrays/copyOfRange kHatAndRandomCoins 32 64)
            cipherText (.kPkeEncrypt this
                                     (K_PKE_EncryptionKey. (.-keyBytes encapsulationKey))
                                     randomMessage
                                     randomCoins)]
        (Arrays/fill randomCoins (unchecked-byte 0))
        (let [sharedSecret (Arrays/copyOfRange kHatAndRandomCoins 0 32)]
          (Arrays/fill kHatAndRandomCoins (unchecked-byte 0))
          (ML_KEM_EncapsulateResult. cipherText sharedSecret)))))

  (method ^:protected decapsulate :throws [DecapsulateException] ^byte/1 [this
                                                                          ^ML_KEM_DecapsulationKey decapsulationKey
                                                                          ^K_PKE_CipherText cipherText]
    (when-not (.isValidCipherText this cipherText)
      (throw (DecapsulateException. "Invalid ciphertext")))
    (let [encode12PolyLen (unchecked-divide-int (unchecked-multiply-int 12 ML_KEM_N) 8)
          decapsKeyBytes (.-keyBytes decapsulationKey)
          ^:mutable ^MessageDigest mlKemG nil
          ^:mutable ^SHA3$SHAKE256 mlKemJ nil]
      (try
        (set! mlKemG (MessageDigest/getInstance HASH_G_NAME))
        (set! mlKemJ (SHA3$SHAKE256. 32))
        (catch NoSuchAlgorithmException e (throw (RuntimeException. e))))
      (let [kPkePrivateKeyBytes (new byte/1 (unchecked-multiply-int mlKem_k encode12PolyLen))]
        (System/arraycopy decapsKeyBytes 0 kPkePrivateKeyBytes 0 (alength kPkePrivateKeyBytes))
        (let [encapsKeyBytes (new byte/1
                                  (unchecked-add-int
                                    (unchecked-multiply-int mlKem_k encode12PolyLen)
                                    32))]
          (System/arraycopy decapsKeyBytes
                            (unchecked-multiply-int mlKem_k encode12PolyLen)
                            encapsKeyBytes
                            0
                            (alength encapsKeyBytes))
          (let [mCandidate (.kPkeDecrypt this (K_PKE_DecryptionKey. kPkePrivateKeyBytes) cipherText)]
            (.update mlKemG mCandidate)
            (.update mlKemG decapsKeyBytes (unchecked-subtract-int (alength decapsKeyBytes) 64) 32)
            (let [kAndCoins (.digest mlKemG)
                  realResult (Arrays/copyOfRange kAndCoins 0 32)
                  coins (Arrays/copyOfRange kAndCoins 32 64)]
              (Arrays/fill kPkePrivateKeyBytes (unchecked-byte 0))
              (Arrays/fill kAndCoins (unchecked-byte 0))
              (.update mlKemJ
                       decapsKeyBytes
                       (unchecked-subtract-int (alength decapsKeyBytes) 32)
                       32)
              (.update mlKemJ (.-encryptedBytes cipherText))
              (let [fakeResult (.digest mlKemJ)
                    computedCipherText (.kPkeEncrypt
                                         this
                                         (K_PKE_EncryptionKey. encapsKeyBytes)
                                         mCandidate
                                         coins)
                    ^:mutable ^int mask 0
                    origCiphertestBytes (.-encryptedBytes cipherText)
                    compCipherTextBytes (.-encryptedBytes computedCipherText)]
                (loop [^int i 0]
                  (when (< i (alength (.-encryptedBytes cipherText)))
                    (set! mask
                          (bit-or-int mask
                                      (bit-xor-int
                                        (aget origCiphertestBytes i)
                                        (aget compCipherTextBytes i))))
                    (recur (unchecked-inc-int i))))
                (set! mask (unchecked-negate-int (bit-and-int mask 0xff)))
                (set! mask (bit-shift-right-int mask 31))
                (let [notMask (bit-not-int mask)
                      result realResult]
                  (loop [^int i 0]
                    (when (< i (alength realResult))
                      (aset result
                            i
                            (unchecked-byte
                              (bit-or-int (bit-and-int notMask (aget realResult i))
                                          (bit-and-int mask (aget fakeResult i)))))
                      (recur (unchecked-inc-int i))))
                  result))))))))

  (method ^:private generateK_PkeKeyPair ^K_PKE_KeyPair [this ^byte/1 seed]
    (let [^:mutable ^MessageDigest mlKemG nil
          ^:mutable ^SHA3$SHAKE256 mlKemJ nil]
      (try
        (set! mlKemG (MessageDigest/getInstance HASH_G_NAME))
        (set! mlKemJ (SHA3$SHAKE256. (unchecked-multiply-int 64 mlKem_eta1)))
        (catch NoSuchAlgorithmException e (throw (RuntimeException. e))))
      (.update mlKemG seed 0 32)
      (.update mlKemG (unchecked-byte mlKem_k))
      (let [rhoSigma (.digest mlKemG)]
        (.reset mlKemG)
        (let [rho (Arrays/copyOfRange rhoSigma 0 32)
              sigma (Arrays/copyOfRange rhoSigma 32 64)]
          (Arrays/fill rhoSigma (unchecked-byte 0))
          (let [keyGenA (.generateA this rho false)
                ^:mutable ^int keyGenN 0
                prfSeed (new byte/1 (unchecked-add-int (alength sigma) 1))]
            (System/arraycopy sigma 0 prfSeed 0 (alength sigma))
            (let [^:mutable ^byte/1 cbdInput nil
                  keyGenS (new short/2 mlKem_k)
                  keyGenE (new short/2 mlKem_k)]
              (loop [^int i 0]
                (when (< i mlKem_k)
                  (aset prfSeed (alength sigma) (unchecked-byte keyGenN))
                  (set! keyGenN (unchecked-inc-int keyGenN))
                  (.update mlKemJ prfSeed)
                  (set! cbdInput (.digest mlKemJ))
                  (aset keyGenS i (.centeredBinomialDistribution this mlKem_eta1 cbdInput))
                  (recur (unchecked-inc-int i))))
              (loop [^int i 0]
                (when (< i mlKem_k)
                  (aset prfSeed (alength sigma) (unchecked-byte keyGenN))
                  (set! keyGenN (unchecked-inc-int keyGenN))
                  (.update mlKemJ prfSeed)
                  (set! cbdInput (.digest mlKemJ))
                  (aset keyGenE i (.centeredBinomialDistribution this mlKem_eta1 cbdInput))
                  (recur (unchecked-inc-int i))))
              (Arrays/fill sigma (unchecked-byte 0))
              (let [keyGenSHat (.mlKemVectorNTT this keyGenS)]
                (.mlKemVectorReduce this keyGenSHat)
                (let [keyGenEHat (.mlKemVectorNTT this keyGenE)
                      keyGenTHat (.mlKemMatrixVectorMuladd this keyGenA keyGenSHat keyGenEHat)
                      pkEncoded (new byte/1
                                     (unchecked-add-int
                                       (unchecked-divide-int
                                         (unchecked-multiply-int
                                           (unchecked-multiply-int mlKem_k ML_KEM_N)
                                           12)
                                         8)
                                       (alength rho)))
                      skEncoded (new byte/1
                                     (unchecked-divide-int
                                       (unchecked-multiply-int
                                         (unchecked-multiply-int mlKem_k ML_KEM_N)
                                         12)
                                       8))]
                  (loop [^int i 0]
                    (when (< i mlKem_k)
                      (ML_KEM/encodePoly12 (aget keyGenTHat i)
                                           pkEncoded
                                           (unchecked-multiply-int
                                             i
                                             (unchecked-divide-int
                                               (unchecked-multiply-int ML_KEM_N 12)
                                               8)))
                      (ML_KEM/encodePoly12 (aget keyGenSHat i)
                                           skEncoded
                                           (unchecked-multiply-int
                                             i
                                             (unchecked-divide-int
                                               (unchecked-multiply-int ML_KEM_N 12)
                                               8)))
                      (Arrays/fill (aget keyGenEHat i) (unchecked-short 0))
                      (Arrays/fill (aget keyGenSHat i) (unchecked-short 0))
                      (recur (unchecked-inc-int i))))
                  (System/arraycopy rho
                                    0
                                    pkEncoded
                                    (unchecked-divide-int
                                      (unchecked-multiply-int
                                        (unchecked-multiply-int mlKem_k ML_KEM_N)
                                        12)
                                      8)
                                    (alength rho))
                  (K_PKE_KeyPair. (K_PKE_EncryptionKey. pkEncoded) (K_PKE_DecryptionKey. skEncoded))))))))))

  (method ^:private kPkeEncrypt ^K_PKE_CipherText [this ^K_PKE_EncryptionKey publicKey
                                                   ^byte/1 message ^byte/1 sigma]
    (let [zeroes (ML_KEM/shortMatrixAlloc mlKem_k ML_KEM_N)
          pkBytes (.-keyBytes publicKey)
          rho (Arrays/copyOfRange pkBytes
                                  (unchecked-subtract-int (alength pkBytes) 32)
                                  (alength pkBytes))
          tHatBytes (Arrays/copyOfRange pkBytes 0 (unchecked-subtract-int (alength pkBytes) 32))
          encryptTHat (.decodeVector this 12 tHatBytes)
          encryptA (.generateA this rho true)
          encryptR (new short/2 mlKem_k)
          encryptE1 (new short/2 mlKem_k)
          ^:mutable ^int encryptN 0
          prfSeed (new byte/1 (unchecked-add-int (alength sigma) 1))]
      (System/arraycopy sigma 0 prfSeed 0 (alength sigma))
      (let [kPkePRFeta1 (SHA3$SHAKE256. (unchecked-multiply-int 64 mlKem_eta1))
            kPkePRFeta2 (SHA3$SHAKE256. (unchecked-multiply-int 64 mlKem_eta2))]
        (loop [^int i 0]
          (when (< i mlKem_k)
            (aset prfSeed (alength sigma) (unchecked-byte encryptN))
            (set! encryptN (unchecked-inc-int encryptN))
            (.update kPkePRFeta1 prfSeed)
            (let [cbdInput (.digest kPkePRFeta1)]
              (aset encryptR i (.centeredBinomialDistribution this mlKem_eta1 cbdInput))
              (recur (unchecked-inc-int i)))))
        (loop [^int i 0]
          (when (< i mlKem_k)
            (aset prfSeed (alength sigma) (unchecked-byte encryptN))
            (set! encryptN (unchecked-inc-int encryptN))
            (.update kPkePRFeta2 prfSeed)
            (let [cbdInput (.digest kPkePRFeta2)]
              (aset encryptE1 i (.centeredBinomialDistribution this mlKem_eta2 cbdInput))
              (recur (unchecked-inc-int i)))))
        (aset prfSeed (alength sigma) (unchecked-byte encryptN))
        (.reset kPkePRFeta2)
        (.update kPkePRFeta2 prfSeed)
        (let [cbdInput (.digest kPkePRFeta2)
              encryptE2 (.centeredBinomialDistribution this mlKem_eta2 cbdInput)
              encryptRHat (.mlKemVectorNTT this encryptR)
              encryptUHat (.mlKemMatrixVectorMuladd this encryptA encryptRHat zeroes)
              ^:mutable encryptU (.mlKemVectorInverseNTT this encryptUHat)]
          (set! encryptU (.mlKemAddVec this encryptU encryptE1))
          (let [encryptVHat (.mlKemVectorScalarMult this encryptTHat encryptRHat)
                ^:mutable encryptV (.mlKemInverseNTT this encryptVHat)]
            (set! encryptV
                  (.mlKemAddPoly this encryptV encryptE2 (ML_KEM/decompressDecode message)))
            (let [encryptC1 (.encodeVector this
                                           mlKem_du
                                           (.compressVector10_11 this encryptU mlKem_du))
                  encryptC2 (ML_KEM/encodePoly mlKem_dv (ML_KEM/compressPoly4_5 encryptV mlKem_dv))
                  result (new byte/1 (unchecked-add-int (alength encryptC1) (alength encryptC2)))]
              (System/arraycopy encryptC1 0 result 0 (alength encryptC1))
              (System/arraycopy encryptC2 0 result (alength encryptC1) (alength encryptC2))
              (K_PKE_CipherText. result)))))))

  (method ^:private kPkeDecrypt ^byte/1 [this ^K_PKE_DecryptionKey privateKey
                                         ^K_PKE_CipherText cipherText]
    (let [uBytesLen (unchecked-divide-int
                      (unchecked-multiply-int (unchecked-multiply-int mlKem_k mlKem_du) ML_KEM_N)
                      8)
          uBytes (Arrays/copyOfRange (.-encryptedBytes cipherText) 0 uBytesLen)
          vBytes (Arrays/copyOfRange (.-encryptedBytes cipherText)
                                     uBytesLen
                                     (alength (.-encryptedBytes cipherText)))
          decryptU (.decompressVector this (.decodeVector this mlKem_du uBytes) mlKem_du)
          ^:mutable decryptV (ML_KEM/decompressPoly (.decodePoly this mlKem_dv vBytes 0) mlKem_dv)
          decryptSHat (.decodeVector this 12 (.-keyBytes privateKey))
          decryptSU (.mlKemInverseNTT this
                                      (.mlKemVectorScalarMult
                                        this
                                        decryptSHat
                                        (.mlKemVectorNTT this decryptU)))]
      (loop [^int i 0]
        (when (< i mlKem_k)
          (Arrays/fill (aget decryptSHat i) (unchecked-short 0))
          (recur (unchecked-inc-int i))))
      (set! decryptV (.mlKemSubtractPoly this decryptV decryptSU))
      (Arrays/fill decryptSU (unchecked-short 0))
      (ML_KEM/encodeCompress decryptV)))

  (method ^:private generateA ^short/3 [this ^byte/1 rho ^Boolean transposed]
    (let [a (new short/3 mlKem_k mlKem_k)
          ^int nrPar 2
          rhoLen (alength rho)
          seedBuf (new byte/1 XOF_BLOCK_LEN)]
      (System/arraycopy rho 0 seedBuf 0 (alength rho))
      (aset seedBuf (unchecked-add-int rhoLen 2) 0x1F)
      (aset seedBuf (unchecked-subtract-int XOF_BLOCK_LEN 1) (unchecked-byte 0x80))
      (let [xofBufArr (ML_KEM/byteMatrixAlloc nrPar (unchecked-add-int XOF_BLOCK_LEN XOF_PAD))
            iIndex (new int/1 nrPar)
            jIndex (new int/1 nrPar)
            parsedBuf (new short/1
                           (unchecked-multiply-int
                             (unchecked-divide-int (alength (aget xofBufArr 0)) 3)
                             2))
            ^:mutable ^int parInd 0
            ^:mutable ^boolean allDone false
            ofs (new int/1 nrPar)]
        (Arrays/fill ofs 0)
        (let [aij (new short/2 nrPar)]
          (try
            (let [parXof (SHA3Parallel$Shake128Parallel. xofBufArr)]
              (loop [^int i 0]
                (when (< i mlKem_k)
                  (loop [^int j 0]
                    (when (< j mlKem_k)
                      (System/arraycopy seedBuf 0 (aget xofBufArr parInd) 0 (alength seedBuf))
                      (if (.booleanValue transposed)
                          (do
                            (aset (aget xofBufArr parInd) rhoLen (unchecked-byte i))
                            (aset (aget xofBufArr parInd)
                                  (unchecked-add-int rhoLen 1)
                                  (unchecked-byte j)))
                          (do
                            (aset (aget xofBufArr parInd) rhoLen (unchecked-byte j))
                            (aset (aget xofBufArr parInd)
                                  (unchecked-add-int rhoLen 1)
                                  (unchecked-byte i))))
                      (aset iIndex parInd i)
                      (aset jIndex parInd j)
                      (aset ofs parInd 0)
                      (aset aij parInd (new short/1 ML_KEM_N))
                      (set! parInd (unchecked-inc-int parInd))
                      (if (or (== parInd nrPar)
                              (and (== i (unchecked-subtract-int mlKem_k 1))
                                   (== j (unchecked-subtract-int mlKem_k 1))))
                          (do
                            (.reset parXof xofBufArr)
                            (set! allDone false)
                            (while (not allDone)
                              (set! allDone true)
                              (.squeezeBlock parXof)
                              (loop [^int k 0]
                                (when (< k parInd)
                                  (let [^:mutable ^int parsedOfs 0
                                        ^:mutable ^int tmp 0]
                                    (when (< (aget ofs k) ML_KEM_N)
                                      (.twelve2Sixteen
                                        this
                                        (aget xofBufArr k)
                                        0
                                        parsedBuf
                                        (unchecked-multiply-int
                                          (unchecked-divide-int XOF_BLOCK_LEN 3)
                                          2)))
                                    (while (and (< (aget ofs k) ML_KEM_N)
                                                (<
                                                  parsedOfs
                                                  (unchecked-multiply-int
                                                    (unchecked-divide-int XOF_BLOCK_LEN 3)
                                                    2)))
                                      (set! tmp (bit-and-int (aget parsedBuf parsedOfs) 0xFFFF))
                                      (set! parsedOfs (unchecked-inc-int parsedOfs))
                                      (when (< tmp ML_KEM_Q)
                                        (aset (aget aij k) (aget ofs k) (unchecked-short tmp))
                                        (aset ofs k (unchecked-inc-int (aget ofs k))))
                                      (set! tmp (bit-and-int (aget parsedBuf parsedOfs) 0xFFFF))
                                      (set! parsedOfs (unchecked-inc-int parsedOfs))
                                      (when (and (< (aget ofs k) ML_KEM_N) (< tmp ML_KEM_Q))
                                        (aset (aget aij k) (aget ofs k) (unchecked-short tmp))
                                        (aset ofs k (unchecked-inc-int (aget ofs k)))))
                                    (if (< (aget ofs k) ML_KEM_N)
                                        (do (set! allDone false) (recur (unchecked-inc-int k)))
                                        (recur (unchecked-inc-int k)))))))
                            (loop [^int k 0]
                              (when (< k parInd)
                                (aset (aget a (aget iIndex k)) (aget jIndex k) (aget aij k))
                                (recur (unchecked-inc-int k))))
                            (set! parInd 0)
                            (recur (unchecked-inc-int j)))
                          (recur (unchecked-inc-int j)))))
                  (recur (unchecked-inc-int i)))))
            (catch InvalidAlgorithmParameterException e
              (throw (RuntimeException. "Internal error."))))
          a))))

  (method ^:private centeredBinomialDistribution ^short/1 [this ^int eta ^byte/1 input]
    (cond
      (== eta 2) (.centeredBinomialDistribution2 this input)
      (== eta 3) (.centeredBinomialDistribution3 this input)
      :else
        (let [result (new short/1 ML_KEM_N)
              ^:mutable ^int index 0
              ^:mutable ^int shift 8
              ^:mutable ^int currentByte (aget input 0)]
          (loop [^int m 0]
            (when (< m ML_KEM_N)
              (let [^:mutable ^int a 0
                    ^:mutable ^int b 0]
                (loop [^int j 0]
                  (when (< j eta)
                    (when (== shift 8)
                      (set! currentByte (aget input index))
                      (set! index (unchecked-inc-int index))
                      (set! shift 0))
                    (set! a
                          (unchecked-add-int
                            a
                            (bit-and-int (bit-shift-right-int currentByte shift) 1)))
                    (set! shift (unchecked-inc-int shift))
                    (recur (unchecked-inc-int j))))
                (loop [^int j 0]
                  (when (< j eta)
                    (when (== shift 8)
                      (set! currentByte (aget input index))
                      (set! index (unchecked-inc-int index))
                      (set! shift 0))
                    (set! b
                          (unchecked-add-int
                            b
                            (bit-and-int (bit-shift-right-int currentByte shift) 1)))
                    (set! shift (unchecked-inc-int shift))
                    (recur (unchecked-inc-int j))))
                (aset result m (unchecked-short (unchecked-subtract-int a b)))
                (recur (unchecked-inc-int m)))))
          result)))

  (method ^:private centeredBinomialDistribution2 ^short/1 [this ^byte/1 input]
    (let [result (new short/1 ML_KEM_N)
          bits 0x0112f001f001eff0
          ^:mutable ^int j 0]
      (loop [^int i 0]
        (when (< i (alength input))
          (let [^int a (aget input i)
                shift1 (bit-and-int (bit-shift-left-int a 2) 0x3c)
                shift2 (bit-and-int (bit-shift-right-int a 2) 0x3c)]
            (aset result j (unchecked-short (bit-shift-right (bit-shift-left bits shift1) 60)))
            (set! j (unchecked-inc-int j))
            (aset result j (unchecked-short (bit-shift-right (bit-shift-left bits shift2) 60)))
            (set! j (unchecked-inc-int j))
            (recur (unchecked-inc-int i)))))
      result))

  (method ^:private centeredBinomialDistribution3 ^short/1 [this ^byte/1 input]
    (let [result (new short/1 ML_KEM_N)
          ^int bits 0x01121223
          ^:mutable ^int j 0]
      (loop [^int i 0]
        (when (< i (alength input))
          (let [^int a1 (aget input i)
                ^int a2 (aget input (unchecked-add-int i 1))
                ^int a3 (aget input (unchecked-add-int i 2))
                shift1 (bit-and-int (bit-shift-left-int a1 2) 0x1c)
                shift2 (bit-and-int (bit-shift-right-int a1 1) 0x1c)
                shift3 (bit-or-int (bit-and-int (bit-shift-right-int a1 4) 0x0c)
                                   (bit-and-int (bit-shift-left-int a2 4) 0x10))
                shift4 (bit-and-int (bit-shift-left-int a2 1) 0x1c)
                shift5 (bit-and-int (bit-shift-right-int a2 2) 0x1c)
                shift6 (bit-or-int (bit-and-int (bit-shift-right-int a2 5) 0x04)
                                   (bit-and-int (bit-shift-left-int a3 3) 0x18))
                shift7 (bit-and-int a3 0x1c)
                shift8 (bit-and-int (bit-shift-right-int a3 3) 0x1c)]
            (aset result
                  j
                  (unchecked-short
                    (unchecked-subtract-int
                      (bit-shift-right-int (bit-shift-left-int bits shift1) 28)
                      (bit-shift-right-int (bit-shift-left-int bits shift2) 28))))
            (set! j (unchecked-inc-int j))
            (aset result
                  j
                  (unchecked-short
                    (unchecked-subtract-int
                      (bit-shift-right-int (bit-shift-left-int bits shift3) 28)
                      (bit-shift-right-int (bit-shift-left-int bits shift4) 28))))
            (set! j (unchecked-inc-int j))
            (aset result
                  j
                  (unchecked-short
                    (unchecked-subtract-int
                      (bit-shift-right-int (bit-shift-left-int bits shift5) 28)
                      (bit-shift-right-int (bit-shift-left-int bits shift6) 28))))
            (set! j (unchecked-inc-int j))
            (aset result
                  j
                  (unchecked-short
                    (unchecked-subtract-int
                      (bit-shift-right-int (bit-shift-left-int bits shift7) 28)
                      (bit-shift-right-int (bit-shift-left-int bits shift8) 28))))
            (set! j (unchecked-inc-int j))
            (recur (unchecked-add-int i 3)))))
      result))

  (method ^:private mlKemVectorNTT ^short/2 [this ^short/2 vector]
    (loop [^int i 0]
      (when (< i mlKem_k) (.mlKemNTT this (aget vector i)) (recur (unchecked-inc-int i))))
    vector)

  (method ^:private mlKemVectorReduce ^short/2 [this ^short/2 vector]

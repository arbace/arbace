            (aset
              result
              (unchecked-multiply-int i 8)
              (unchecked-short
                (bit-and-int (bit-shift-right-int (bit-shift-left-int currentByte 31) 31) 1665)))
            (aset
              result
              (unchecked-add-int (unchecked-multiply-int i 8) 1)
              (unchecked-short
                (bit-and-int (bit-shift-right-int (bit-shift-left-int currentByte 30) 31) 1665)))
            (aset
              result
              (unchecked-add-int (unchecked-multiply-int i 8) 2)
              (unchecked-short
                (bit-and-int (bit-shift-right-int (bit-shift-left-int currentByte 29) 31) 1665)))
            (aset
              result
              (unchecked-add-int (unchecked-multiply-int i 8) 3)
              (unchecked-short
                (bit-and-int (bit-shift-right-int (bit-shift-left-int currentByte 28) 31) 1665)))
            (aset
              result
              (unchecked-add-int (unchecked-multiply-int i 8) 4)
              (unchecked-short
                (bit-and-int (bit-shift-right-int (bit-shift-left-int currentByte 27) 31) 1665)))
            (aset
              result
              (unchecked-add-int (unchecked-multiply-int i 8) 5)
              (unchecked-short
                (bit-and-int (bit-shift-right-int (bit-shift-left-int currentByte 26) 31) 1665)))
            (aset
              result
              (unchecked-add-int (unchecked-multiply-int i 8) 6)
              (unchecked-short
                (bit-and-int (bit-shift-right-int (bit-shift-left-int currentByte 25) 31) 1665)))
            (aset
              result
              (unchecked-add-int (unchecked-multiply-int i 8) 7)
              (unchecked-short
                (bit-and-int (bit-shift-right-int (bit-shift-left-int currentByte 24) 31) 1665)))
            (recur (unchecked-inc-int i)))))
      result))

  (method ^:static ^{IntrinsicCandidate true} implKyberBarrettReduce ^int [^short/1 coeffs]
    (ML_KEM/implKyberBarrettReduceJava coeffs)
    1)

  (method ^:static implKyberBarrettReduceJava ^void [^short/1 poly]
    (loop [^int m 0]
      (when (< m ML_KEM_N)
        (let [tmp (bit-shift-right-int
                    (unchecked-multiply-int (int (aget poly m)) BARRETT_MULTIPLIER)
                    BARRETT_SHIFT)]
          (aset poly
                m
                (unchecked-short
                  (unchecked-subtract-int (aget poly m) (unchecked-multiply-int tmp ML_KEM_Q))))
          (recur (unchecked-inc-int m))))))

  (method ^:private ^:static mlKemBarrettReduce ^void [^short/1 poly]
    (java-assert (== (alength poly) ML_KEM_N))
    (ML_KEM/implKyberBarrettReduce poly))

  (method ^:private ^:static montMul ^int [^int b ^int c]
    (let [a (unchecked-multiply-int b c)
          aHigh (bit-shift-right-int a MONT_R_BITS)
          aLow (bit-and-int a (unchecked-subtract-int (bit-shift-left-int 1 MONT_R_BITS) 1))
          m (bit-shift-right-int
              (bit-shift-left-int (unchecked-multiply-int MONT_Q_INV_MOD_R aLow)
                                  (unchecked-subtract-int 32 MONT_R_BITS))
              (unchecked-subtract-int 32 MONT_R_BITS))]
      (unchecked-subtract-int aHigh
                              (bit-shift-right-int (unchecked-multiply-int m MONT_Q) MONT_R_BITS))))

  (method ^:static shortMatrixAlloc ^short/2 [^int first ^int second]
    (let [res (new short/2 first)]
      (loop [^int i 0]
        (when (< i first) (aset res i (new short/1 second)) (recur (unchecked-inc-int i))))
      res))

  (method ^:static byteMatrixAlloc ^byte/2 [^int first ^int second]
    (let [res (new byte/2 first)]
      (loop [^int i 0]
        (when (< i first) (aset res i (new byte/1 second)) (recur (unchecked-inc-int i))))
      res)))

  (method ^:private mlKemInverseNTT ^short/1 [this ^short/1 poly]
    (java-assert (== (alength poly) ML_KEM_N))
    (ML_KEM/implKyberInverseNtt poly montZetasForVectorInverseNttArr)
    poly)

  (method ^:private ^:static seilerNTT ^void [^int/1 coeffs]
    (let [dimension ML_KEM_N
          ^:mutable ^int zetaIndex 0]
      (loop [^int l (unchecked-divide-int dimension 2)]

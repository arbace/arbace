    (ML_KEM/mlKemBarrettReduce poly))

  (method ^:static ^{IntrinsicCandidate true} implKyberInverseNtt ^int [^short/1 poly ^short/1 zetas]
    (ML_KEM/implKyberInverseNttJava poly)
    1)

  (method ^:static implKyberInverseNttJava ^void [^short/1 poly]

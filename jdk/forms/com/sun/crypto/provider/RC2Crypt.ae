                                 (bit-and-int R0 R3))
                               (bit-and-int (bit-not-int R0) R2))
                             0xffff))
          (set! R0
                (bit-and-int (bit-or-int (bit-shift-left-int R0 15)
                                         (unsigned-bit-shift-right-int R0 1))
                             0xffff))
          (set! R0
                (bit-and-int (unchecked-subtract-int
                               (unchecked-subtract-int
                                 (unchecked-subtract-int
                                   R0
                                   (aget expandedKey (unchecked-subtract-int i 4)))
                                 (bit-and-int R3 R2))
                               (bit-and-int (bit-not-int R3) R1))
                             0xffff))
          (recur (unchecked-subtract-int i 4))))
      (aset out outOfs (unchecked-byte R0))
      (aset out (unchecked-add-int outOfs 1) (unchecked-byte (bit-shift-right-int R0 8)))
      (aset out (unchecked-add-int outOfs 2) (unchecked-byte R1))
      (aset out (unchecked-add-int outOfs 3) (unchecked-byte (bit-shift-right-int R1 8)))
      (aset out (unchecked-add-int outOfs 4) (unchecked-byte R2))
      (aset out (unchecked-add-int outOfs 5) (unchecked-byte (bit-shift-right-int R2 8)))
      (aset out (unchecked-add-int outOfs 6) (unchecked-byte R3))
      (aset out (unchecked-add-int outOfs 7) (unchecked-byte (bit-shift-right-int R3 8))))))

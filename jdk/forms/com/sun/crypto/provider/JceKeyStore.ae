                  (return ObjectInputFilter$Status/REJECTED))
              2
                (when (and (and (some? clazz) (not (identical? clazz SealedObject)))
                           (not (identical? clazz byte/1)))
                  (return ObjectInputFilter$Status/REJECTED))
              (when (and (some? clazz) (not (identical? clazz Object)))
                (return ObjectInputFilter$Status/REJECTED)))
            (let [defaultFilter (ObjectInputFilter$Config/getSerialFilter)]
              (if (some? defaultFilter)
                  (.checkInput defaultFilter info)
                  ObjectInputFilter$Status/UNDECIDED))))))

  (method ^:private emitWeakKeyStoreWarning ^void [this]
    (.println
      debug
      "WARNING: JCEKS uses outdated cryptographic algorithms and will be removed in a future release. Migrate to PKCS12 using:")
    (.println
      debug
      "keytool -importkeystore -srckeystore <keystore> -destkeystore <keystore> -deststoretype pkcs12")))

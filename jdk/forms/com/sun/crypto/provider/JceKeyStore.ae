            (set! (.-chain entry) (.clone chain))
            (set! (.-chain entry) nil))
        (.put entries (.toLowerCase alias Locale/ENGLISH) entry))))

  (method ^:public engineSetCertificateEntry :throws [KeyStoreException] ^void [this ^String alias
                                                                                ^Certificate cert]

  (defclass ^:private ^:static DeserializationChecker
    :implements [ObjectInputFilter]

    (field ^:private ^:final ^int fullLength)

    (constructor ^:public [this ^int fullLength]
      (set! (.-fullLength this) fullLength))

    (method ^:public checkInput ^ObjectInputFilter$Status [this ^ObjectInputFilter$FilterInfo info]

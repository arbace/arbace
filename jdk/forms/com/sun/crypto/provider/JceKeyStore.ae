  (method ^:private getPreKeyedHash :throws [NoSuchAlgorithmException] ^MessageDigest [this
                                                                                       ^char/1 password]
    (let [^:mutable ^int i 0
          ^:mutable ^int j 0
          md (MessageDigest/getInstance "SHA")
          passwdBytes (new byte/1 (unchecked-multiply-int (alength password) 2))]
      (set! i 0)
      (set! j 0)
      (while (< i (alength password))
        (aset passwdBytes j (unchecked-byte (bit-shift-right-int (aget password i) 8)))
        (set! j (unchecked-inc-int j))
        (aset passwdBytes j (unchecked-byte (aget password i)))
        (set! j (unchecked-inc-int j))
        (set! i (unchecked-inc-int i)))
      (.update md passwdBytes)
      (set! i 0)
      (while (< i (alength passwdBytes)) (aset passwdBytes i 0) (set! i (unchecked-inc-int i)))
      (.update md (.getBytes "Mighty Aphrodite" StandardCharsets/UTF_8))
      md))


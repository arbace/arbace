      (.update ghash in inOfs inLen)
      (.update gctr in inOfs inLen out outOfs))

    (method ^:public update ^int [this ^byte/1 in ^int inOfs ^int inLen ^ByteBuffer dst]
      (.update ghash in inOfs inLen)
      (.update gctr in inOfs inLen dst))

    (method ^:public update ^int [this ^ByteBuffer src ^ByteBuffer dst]
      (.mark src)
      (.update ghash src (.remaining src))
      (.reset src)
      (.update gctr src dst))

    (method ^:public doFinal ^int [this ^byte/1 in ^int inOfs ^int inLen ^byte/1 out ^int outOfs]
      (let [^:mutable ^int len 0]
        (when (>= inLen PARALLEL_LEN)
          (set! len
                (unchecked-add-int len
                                   (GaloisCounterMode/implGCMCrypt
                                     in
                                     inOfs
                                     inLen
                                     ^byte/1 (when-not (identical? in out) in)
                                     inOfs
                                     out
                                     outOfs
                                     gctr
                                     ghash))))
        (.doFinal ghash in (unchecked-add-int inOfs len) (unchecked-subtract-int inLen len))
        (unchecked-add-int len
                           (.doFinal gctr
                                     in
                                     (unchecked-add-int inOfs len)
                                     (unchecked-subtract-int inLen len)
                                     out
                                     (unchecked-add-int outOfs len)))))

    (method ^:public doFinal ^int [this ^ByteBuffer src ^ByteBuffer dst]
      (.mark src)
      (.doFinal ghash src (.remaining src))
      (.reset src)
      (.doFinal gctr src dst)))

  (defclass ^:public ^:interface GCMOperation
    (method update ^int [this ^byte/1 in ^int inOfs ^int inLen ^byte/1 out ^int outOfs])

    (method update ^int [this ^byte/1 in ^int inOfs ^int inLen ^ByteBuffer dst])

    (method update ^int [this ^ByteBuffer src ^ByteBuffer dst])

    (method doFinal ^int [this ^byte/1 in ^int inOfs ^int inLen ^byte/1 out ^int outOfs])

    (method doFinal ^int [this ^ByteBuffer src ^ByteBuffer dst])))

  (method ^:private ^:static blockMult ^void [^long/1 st ^long/1 subH]
    (let [^:mutable Z0 0
          ^:mutable Z1 0
          ^:mutable V0 (aget subH 0)
          ^:mutable V1 (aget subH 1)

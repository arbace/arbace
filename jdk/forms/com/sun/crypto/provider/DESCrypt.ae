  (method expandKey ^void [this ^byte/1 key]
    (let [^:mutable ^int octet 0
          ek (new byte/1 128)]
      (set! octet (aget key 0))
      (when-not (== (bit-and-int octet 0x80) 0)
        (aset ek 3 (unchecked-byte (bit-or-int (aget ek 3) 2)))
        (aset ek 9 (unchecked-byte (bit-or-int (aget ek 9) 8)))
        (aset ek 18 (unchecked-byte (bit-or-int (aget ek 18) 8)))
        (aset ek 27 (unchecked-byte (bit-or-int (aget ek 27) 32)))
        (aset ek 33 (unchecked-byte (bit-or-int (aget ek 33) 2)))
        (aset ek 42 (unchecked-byte (bit-or-int (aget ek 42) 16)))
        (aset ek 48 (unchecked-byte (bit-or-int (aget ek 48) 8)))
        (aset ek 65 (unchecked-byte (bit-or-int (aget ek 65) 16)))

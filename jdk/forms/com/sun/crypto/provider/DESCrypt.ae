  (field ^byte/1 expandedKey nil)

  (field ^boolean decrypting false)

  (method getBlockSize ^int [this] DESCrypt/DES_BLOCK_SIZE)

  (method init :throws [InvalidKeyException] ^void [this ^boolean decrypting ^String algorithm
                                                    ^byte/1 rawKey]
    (set! (.-decrypting this) decrypting)
    (when-not (.equalsIgnoreCase algorithm "DES")
      (throw (InvalidKeyException. "Wrong algorithm: DES required")))
    (when-not (== (alength rawKey) DESCrypt/DES_BLOCK_SIZE)
      (throw (InvalidKeyException. "Wrong key size")))
    (.expandKey this rawKey))

  (method encryptBlock ^void [this ^byte/1 plain ^int plainOffset ^byte/1 cipher ^int cipherOffset]
    (.cipherBlock this plain plainOffset cipher cipherOffset))

  (method decryptBlock ^void [this ^byte/1 cipher ^int cipherOffset ^byte/1 plain ^int plainOffset]
    (.cipherBlock this cipher cipherOffset plain plainOffset))

  (method cipherBlock ^void [this ^byte/1 in ^int inOffset ^byte/1 out ^int outOffset]
    (let [^:mutable ^byte/1 key nil
          ^:mutable ^int temp 0
          ^:mutable ^int i 0
          ^:mutable ^int j 0
          ^:mutable ^int offset 0
          ^:mutable ^int left 0
          ^:mutable ^int right 0]
      (set! left (DESCrypt/initialPermutationLeft in inOffset))
      (set! right (DESCrypt/initialPermutationRight in inOffset))
      (set! key expandedKey)
      (if decrypting
          (do
            (set! offset (unchecked-subtract-int 16 DESCrypt/DES_BLOCK_SIZE))
            (set! j (unchecked-subtract-int 128 DESCrypt/DES_BLOCK_SIZE)))
          (do (set! offset (unchecked-subtract-int 0 DESCrypt/DES_BLOCK_SIZE)) (set! j 0)))
      (set! i 0)
      (while (< i 16)
        (set! temp
              (bit-or-int (bit-shift-left-int right 1)
                          (bit-and-int (bit-shift-right-int right 31) 1)))
        (set! left
              (bit-xor-int left
                           (bit-xor-int (bit-xor-int
                                          (bit-xor-int
                                            (bit-xor-int
                                              (bit-xor-int
                                                (bit-xor-int
                                                  (aget
                                                    s0p
                                                    (bit-xor-int
                                                      (bit-and-int temp 0x3f)
                                                      (aget key (unchecked-add-int j 0))))
                                                  (aget
                                                    s1p
                                                    (bit-xor-int
                                                      (bit-and-int
                                                        (bit-shift-right-int temp 4)
                                                        0x3f)
                                                      (aget key (unchecked-add-int j 1)))))
                                                (aget
                                                  s2p
                                                  (bit-xor-int
                                                    (bit-and-int (bit-shift-right-int temp 8) 0x3f)
                                                    (aget key (unchecked-add-int j 2)))))
                                              (aget
                                                s3p
                                                (bit-xor-int
                                                  (bit-and-int (bit-shift-right-int temp 12) 0x3f)
                                                  (aget key (unchecked-add-int j 3)))))
                                            (aget
                                              s4p
                                              (bit-xor-int
                                                (bit-and-int (bit-shift-right-int temp 16) 0x3f)
                                                (aget key (unchecked-add-int j 4)))))
                                          (aget s5p
                                                (bit-xor-int
                                                  (bit-and-int (bit-shift-right-int temp 20) 0x3f)
                                                  (aget key (unchecked-add-int j 5)))))
                                        (aget s6p
                                              (bit-xor-int
                                                (bit-and-int (bit-shift-right-int temp 24) 0x3f)
                                                (aget key (unchecked-add-int j 6)))))))
        (set! temp
              (bit-or-int (bit-shift-left-int (bit-and-int right 1) 5)
                          (bit-and-int (bit-shift-right-int right 27) 0x1f)))
        (set! left
              (bit-xor-int left (aget s7p (bit-xor-int temp (aget key (unchecked-add-int j 7))))))
        (set! temp left)
        (set! left right)
        (set! right temp)
        (set! j (unchecked-subtract-int j offset))
        (set! i (unchecked-inc-int i)))
      (set! temp left)
      (set! left right)
      (set! right temp)
      (DESCrypt/perm left right out outOffset)))

  (method ^:private ^:static perm ^void [^int left ^int right ^byte/1 out ^int offset]
    (let [^:mutable ^int low 0
          ^:mutable ^int high 0
          ^:mutable ^int temp 0]
      (set! temp left)
      (set! high (aget permRight0 (bit-and-int temp 0x0000000f)))
      (set! temp (bit-shift-right-int temp 4))
      (set! low (aget permLeft1 (bit-and-int temp 0x0000000f)))
      (set! temp (bit-shift-right-int temp 4))
      (set! high (bit-or-int high (aget permRight2 (bit-and-int temp 0x0000000f))))
      (set! temp (bit-shift-right-int temp 4))
      (set! low (bit-or-int low (aget permLeft3 (bit-and-int temp 0x0000000f))))
      (set! temp (bit-shift-right-int temp 4))
      (set! high (bit-or-int high (aget permRight4 (bit-and-int temp 0x0000000f))))
      (set! temp (bit-shift-right-int temp 4))
      (set! low (bit-or-int low (aget permLeft5 (bit-and-int temp 0x0000000f))))
      (set! temp (bit-shift-right-int temp 4))
      (set! high (bit-or-int high (aget permRight6 (bit-and-int temp 0x0000000f))))
      (set! temp (bit-shift-right-int temp 4))
      (set! low (bit-or-int low (aget permLeft7 (bit-and-int temp 0x0000000f))))
      (set! temp right)
      (set! high (bit-or-int high (aget permRight8 (bit-and-int temp 0x0000000f))))
      (set! temp (bit-shift-right-int temp 4))
      (set! low (bit-or-int low (aget permLeft9 (bit-and-int temp 0x0000000f))))
      (set! temp (bit-shift-right-int temp 4))
      (set! high (bit-or-int high (aget permRightA (bit-and-int temp 0x0000000f))))
      (set! temp (bit-shift-right-int temp 4))
      (set! low (bit-or-int low (aget permLeftB (bit-and-int temp 0x0000000f))))
      (set! temp (bit-shift-right-int temp 4))
      (set! high (bit-or-int high (aget permRightC (bit-and-int temp 0x0000000f))))
      (set! temp (bit-shift-right-int temp 4))
      (set! low (bit-or-int low (aget permLeftD (bit-and-int temp 0x0000000f))))
      (set! temp (bit-shift-right-int temp 4))
      (set! high (bit-or-int high (aget permRightE (bit-and-int temp 0x0000000f))))
      (set! temp (bit-shift-right-int temp 4))
      (set! low (bit-or-int low (aget permLeftF (bit-and-int temp 0x0000000f))))
      (aset out (unchecked-add-int offset 0) (unchecked-byte low))
      (aset out (unchecked-add-int offset 1) (unchecked-byte (bit-shift-right-int low 8)))
      (aset out (unchecked-add-int offset 2) (unchecked-byte (bit-shift-right-int low 16)))
      (aset out (unchecked-add-int offset 3) (unchecked-byte (bit-shift-right-int low 24)))
      (aset out (unchecked-add-int offset 4) (unchecked-byte high))
      (aset out (unchecked-add-int offset 5) (unchecked-byte (bit-shift-right-int high 8)))
      (aset out (unchecked-add-int offset 6) (unchecked-byte (bit-shift-right-int high 16)))
      (aset out (unchecked-add-int offset 7) (unchecked-byte (bit-shift-right-int high 24)))))


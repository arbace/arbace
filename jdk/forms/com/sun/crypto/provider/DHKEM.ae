        (cond
          (ECUtil/equals ecp CurveDB/P_256) (return Params/P256)
          (ECUtil/equals ecp CurveDB/P_384) (return Params/P384)
          (ECUtil/equals ecp CurveDB/P_521) (return Params/P521))
        (when-instance [^NamedParameterSpec ns p]

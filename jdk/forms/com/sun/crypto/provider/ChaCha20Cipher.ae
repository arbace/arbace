                                              (unchecked-add-int ws07 (aget initState 7)))
      ^void (^[byte/1 int int] VarHandle/.set asIntLittleEndian
                                              result
                                              32
                                              (unchecked-add-int ws08 (aget initState 8)))
      ^void (^[byte/1 int int] VarHandle/.set asIntLittleEndian
                                              result
                                              36
                                              (unchecked-add-int ws09 (aget initState 9)))
      ^void (^[byte/1 int int] VarHandle/.set asIntLittleEndian
                                              result
                                              40
                                              (unchecked-add-int ws10 (aget initState 10)))
      ^void (^[byte/1 int int] VarHandle/.set asIntLittleEndian
                                              result
                                              44
                                              (unchecked-add-int ws11 (aget initState 11)))
      ^void (^[byte/1 int int] VarHandle/.set asIntLittleEndian
                                              result
                                              48
                                              (unchecked-add-int ws12 (aget initState 12)))
      ^void (^[byte/1 int int] VarHandle/.set asIntLittleEndian
                                              result
                                              52
                                              (unchecked-add-int ws13 (aget initState 13)))
      ^void (^[byte/1 int int] VarHandle/.set asIntLittleEndian
                                              result
                                              56
                                              (unchecked-add-int ws14 (aget initState 14)))
      ^void (^[byte/1 int int] VarHandle/.set asIntLittleEndian
                                              result
                                              60
                                              (unchecked-add-int ws15 (aget initState 15)))
      KS_BLK_SIZE))

  (method ^:private chaCha20Transform :throws [KeyException] ^void [this ^byte/1 in
                                                                    ^:mutable ^int inOff ^int inLen
                                                                    ^byte/1 out
                                                                    ^:mutable ^int outOff]
    (let [^:mutable remainingData inLen]
      (while (> remainingData 0)
        (let [^:mutable ksRemain (unchecked-subtract-int keyStrLimit keyStrOffset)]
          (when (<= ksRemain 0)
            (if (<= counter finalCounterValue)
                (do
                  (set! keyStrLimit (ChaCha20Cipher/chaCha20Block startState counter keyStream))
                  (set! counter
                        (unchecked-add counter (unchecked-divide-int keyStrLimit KS_BLK_SIZE)))
                  (when (> counter finalCounterValue)
                    (set! keyStrLimit
                          (unchecked-subtract-int
                            keyStrLimit
                            (unchecked-multiply-int
                              (unchecked-int (unchecked-subtract counter finalCounterValue))
                              64))))
                  (set! keyStrOffset 0)
                  (set! ksRemain keyStrLimit))
                (throw (KeyException. "Counter exhausted.  Reinitialize with new key and/or nonce"))))
          (let [xformLen (Math/min remainingData ksRemain)]
            (ChaCha20Cipher/xor keyStream keyStrOffset in inOff out outOff xformLen)
            (set! outOff (unchecked-add-int outOff xformLen))
            (set! inOff (unchecked-add-int inOff xformLen))
            (set! keyStrOffset (unchecked-add-int keyStrOffset xformLen))
            (set! remainingData (unchecked-subtract-int remainingData xformLen)))))))

  (method ^:private ^:static xor ^void [^byte/1 in1 ^:mutable ^int off1 ^byte/1 in2
                                        ^:mutable ^int off2 ^byte/1 out ^:mutable ^int outOff
                                        ^:mutable ^int len]
    (while (>= len 8)
      (let [v1 ^long (^[byte/1 int] VarHandle/.get asLongView in1 off1)
            v2 ^long (^[byte/1 int] VarHandle/.get asLongView in2 off2)]
        ^void (^[byte/1 int long] VarHandle/.set asLongView out outOff (bit-xor v1 v2))
        (set! off1 (unchecked-add-int off1 8))
        (set! off2 (unchecked-add-int off2 8))
        (set! outOff (unchecked-add-int outOff 8))
        (set! len (unchecked-subtract-int len 8))))
    (while (> len 0)
      (aset out outOff (unchecked-byte (bit-xor-int (aget in1 off1) (aget in2 off2))))
      (set! off1 (unchecked-inc-int off1))
      (set! off2 (unchecked-inc-int off2))
      (set! outOff (unchecked-inc-int outOff))
      (set! len (unchecked-dec-int len))))

  (method ^:private initAuthenticator :throws [InvalidKeyException] ^void [this]
    (set! authenticator (Poly1305.))
    (let [serializedKey (new byte/1 KS_MAX_LEN)]
      (ChaCha20Cipher/chaCha20Block startState 0 serializedKey)
      (.engineInit authenticator (SecretKeySpec. serializedKey 0 32 authAlgName) nil)
      (set! aadLen 0)
      (set! dataLen 0)))

  (method ^:private authUpdate ^int [this ^byte/1 data ^int offset ^int length]
    (Objects/checkFromIndexSize offset length (alength data))
    (.engineUpdate authenticator data offset length)
    length)

  (method ^:private authFinalizeData ^void [this ^byte/1 data ^int dataOff ^int length ^byte/1 out
                                            ^int outOff]
    (when (some? data)
      (set! dataLen (unchecked-add dataLen (.authUpdate this data dataOff length))))
    (.authPad16 this dataLen)
    (.authWriteLengths this aadLen dataLen lenBuf)
    (.engineUpdate authenticator lenBuf 0 (alength lenBuf))
    (let [tag (.engineDoFinal authenticator)]
      (Objects/checkFromIndexSize outOff (alength tag) (alength out))
      (System/arraycopy tag 0 out outOff (alength tag))
      (set! aadLen 0)
      (set! dataLen 0)))

  (method ^:private authPad16 ^void [this ^long dataLen]
    (.engineUpdate authenticator
                   padBuf
                   0
                   (bit-and-int (unchecked-subtract-int
                                  TAG_LENGTH
                                  (bit-and-int (unchecked-int dataLen) 15))
                                15)))

  (method ^:private authWriteLengths ^void [this ^long aLen ^long dLen ^byte/1 buf]
    ^void (^[byte/1 int long] VarHandle/.set asLongLittleEndian buf 0 aLen)
    ^void (^[byte/1 int long] VarHandle/.set asLongLittleEndian buf Long/BYTES dLen))

  (method ^:private resetStartState ^void [this]
    (set! keyStrLimit 0)
    (set! keyStrOffset 0)
    (set! counter initCounterValue)
    (set! aadDone false)
    (set! initialized (== direction Cipher/DECRYPT_MODE)))

  (defclass ^:interface ChaChaEngine
    (method getOutputSize ^int [this ^int inLength ^boolean isFinal])

    (method doUpdate :throws [ShortBufferException KeyException] ^int [this ^byte/1 in ^int inOff
                                                                       ^int inLen ^byte/1 out
                                                                       ^int outOff])

    (method doFinal :throws [ShortBufferException AEADBadTagException KeyException] ^int [this
                                                                                          ^byte/1 in
                                                                                          ^int inOff
                                                                                          ^int inLen
                                                                                          ^byte/1 out
                                                                                          ^int outOff])

    (method doUpdate :throws [ShortBufferException KeyException] ^int [this ^ByteBuffer input
                                                                       ^ByteBuffer output])

    (method doFinal :throws [ShortBufferException KeyException AEADBadTagException] ^int [this
                                                                                          ^ByteBuffer input
                                                                                          ^ByteBuffer output]))

  (defclass ^:private ^:final EngineStreamOnly
    :implements [ChaChaEngine]

    (constructor ^:private [this])

    (method ^:public getOutputSize ^int [this ^int inLength ^boolean isFinal]
      inLength)

    (method ^:public doUpdate :throws [ShortBufferException KeyException] ^int [this ^byte/1 in
                                                                                ^int inOff
                                                                                ^int inLen
                                                                                ^byte/1 out
                                                                                ^int outOff]
      (if initialized
          (do
            (try
              (if (some? out)
                  (Objects/checkFromIndexSize outOff inLen (alength out))
                  (throw (ShortBufferException. "Output buffer too small")))
              (catch IndexOutOfBoundsException iobe
                (throw (ShortBufferException. "Output buffer too small"))))
            (when (some? in)
              (Objects/checkFromIndexSize inOff inLen (alength in))
              (.chaCha20Transform ChaCha20Cipher/this in inOff inLen out outOff))
            inLen)
          (throw (IllegalStateException. "Must use either a different key or iv."))))

    (method ^:public doFinal :throws [ShortBufferException KeyException] ^int [this ^byte/1 in
                                                                               ^int inOff ^int inLen
                                                                               ^byte/1 out
                                                                               ^int outOff]
      (.doUpdate this in inOff inLen out outOff))

    (method ^:public doUpdate :throws [ShortBufferException KeyException] ^int [this
                                                                                ^ByteBuffer input
                                                                                ^ByteBuffer output]
      (let [data (new byte/1 (.remaining input))]
        (.get input data)
        (.doUpdate this data 0 (alength data) data 0)
        (.put output data)
        (alength data)))

    (method ^:public doFinal :throws [ShortBufferException KeyException] ^int [this
                                                                               ^ByteBuffer input
                                                                               ^ByteBuffer output]
      (.doUpdate this input output)))

  (defclass ^:private ^:final EngineAEADEnc
    :implements [ChaChaEngine]

    (method ^:public getOutputSize ^int [this ^int inLength ^boolean isFinal]
      (if isFinal (Math/addExact inLength TAG_LENGTH) inLength))

    (constructor :throws [InvalidKeyException] ^:private [this]
      (.initAuthenticator ChaCha20Cipher/this)
      (set! initCounterValue 1)
      (set! counter initCounterValue))

    (method ^:public doUpdate :throws [ShortBufferException KeyException] ^int [this ^byte/1 in
                                                                                ^int inOff
                                                                                ^int inLen
                                                                                ^byte/1 out
                                                                                ^int outOff]
      (if initialized
          (do
            (when-not aadDone (.authPad16 ChaCha20Cipher/this aadLen) (set! aadDone true))
            (try
              (if (some? out)
                  (Objects/checkFromIndexSize outOff inLen (alength out))
                  (throw (ShortBufferException. "Output buffer too small")))
              (catch IndexOutOfBoundsException iobe
                (throw (ShortBufferException. "Output buffer too small"))))
            (when (some? in)
              (Objects/checkFromIndexSize inOff inLen (alength in))
              (.chaCha20Transform ChaCha20Cipher/this in inOff inLen out outOff)
              (set! dataLen
                    (unchecked-add dataLen (.authUpdate ChaCha20Cipher/this out outOff inLen))))
            inLen)
          (throw (IllegalStateException. "Must use either a different key or iv."))))

    (method ^:public doFinal :throws [ShortBufferException KeyException] ^int [this ^byte/1 in
                                                                               ^int inOff ^int inLen
                                                                               ^byte/1 out
                                                                               ^int outOff]
      (when (> (unchecked-add-int inLen TAG_LENGTH) (unchecked-subtract-int (alength out) outOff))
        (throw (ShortBufferException. "Output buffer too small")))
      (.doUpdate this in inOff inLen out outOff)
      (.authFinalizeData ChaCha20Cipher/this nil 0 0 out (unchecked-add-int outOff inLen))
      (set! aadDone false)
      (unchecked-add-int inLen TAG_LENGTH))

    (method ^:public doUpdate :throws [ShortBufferException KeyException] ^int [this
                                                                                ^ByteBuffer input
                                                                                ^ByteBuffer output]
      (let [data (new byte/1 (.remaining input))]
        (.get input data)
        (.doUpdate this data 0 (alength data) data 0)
        (.put output data)
        (alength data)))

    (method ^:public doFinal :throws [ShortBufferException KeyException] ^int [this
                                                                               ^ByteBuffer input
                                                                               ^ByteBuffer output]
      (let [len (.remaining input)
            data (new byte/1 (unchecked-add-int len TAG_LENGTH))]
        (.get input data 0 len)
        (.doFinal this data 0 len data 0)
        (.put output data)
        (alength data))))

  (defclass ^:private ^:final EngineAEADDec
    :implements [ChaChaEngine]

    (field ^:private ^AEADBufferedStream cipherBuf nil)

    (field ^:private ^:final ^byte/1 tag)

    (method ^:public getOutputSize ^int [this ^int inLen ^boolean isFinal]
      (if isFinal
          (Integer/max (Math/addExact (unchecked-subtract-int inLen TAG_LENGTH)
                                      (.getBufferedLength this))
                       0)
          0))

    (method ^:private initBuffer ^void [this ^int len]
      (when (nil? cipherBuf) (set! cipherBuf (AEADBufferedStream. len))))

    (method ^:private getBufferedLength ^int [this]
      (if (some? cipherBuf) (.size cipherBuf) 0))

    (constructor :throws [InvalidKeyException] ^:private [this]
      (.initAuthenticator ChaCha20Cipher/this)
      (set! initCounterValue 1)
      (set! counter initCounterValue)
      (set! tag (new byte/1 TAG_LENGTH)))

    (method ^:public doUpdate ^int [this ^byte/1 in ^int inOff ^int inLen ^byte/1 out ^int outOff]
      (if initialized
          (do
            (when-not aadDone (.authPad16 ChaCha20Cipher/this aadLen) (set! aadDone true))
            (when (some? in)
              (Objects/checkFromIndexSize inOff inLen (alength in))
              (.initBuffer this inLen)
              (.write cipherBuf in inOff inLen)))
          (throw (IllegalStateException. "Must use either a different key or iv.")))
      0)

    (method ^:public doUpdate ^int [this ^ByteBuffer input ^ByteBuffer output]
      (.initBuffer this (.remaining input))
      (.write cipherBuf input)
      0)

    (method ^:public doFinal :throws [ShortBufferException AEADBadTagException KeyException] ^int [this
                                                                                                   ^byte/1 in
                                                                                                   ^:mutable ^int inOff
                                                                                                   ^int inLen
                                                                                                   ^byte/1 out
                                                                                                   ^int outOff]
      (let [^:mutable ^byte/1 ctPlusTag nil
            ^:mutable ^int ctPlusTagLen 0]
        (if (== (.getBufferedLength this) 0)
            (do
              (.doUpdate this nil inOff inLen out outOff)
              (set! ctPlusTag in)
              (set! ctPlusTagLen inLen))
            (do
              (.doUpdate this in inOff inLen out outOff)
              (set! ctPlusTag (.getBuffer cipherBuf))
              (set! inOff 0)
              (set! ctPlusTagLen (.size cipherBuf))
              (.reset cipherBuf)))
        (when (< ctPlusTagLen TAG_LENGTH)
          (throw (AEADBadTagException. "Input too short - need tag")))
        (let [ctLen (unchecked-subtract-int ctPlusTagLen TAG_LENGTH)]
          (try
            (Objects/checkFromIndexSize outOff ctLen (alength out))
            (catch IndexOutOfBoundsException ioobe
              (throw (ShortBufferException. "Output buffer too small"))))
          (.authFinalizeData ChaCha20Cipher/this ctPlusTag inOff ctLen tag 0)
          (let [tagCompare (bit-or (bit-xor ^long (^[byte/1 int] VarHandle/.get
                                                    asLongView
                                                    ctPlusTag
                                                    (unchecked-add-int ctLen inOff))
                                            ^long (^[byte/1 int] VarHandle/.get asLongView tag 0))
                                   (bit-xor ^long (^[byte/1 int] VarHandle/.get
                                                    asLongView
                                                    ctPlusTag
                                                    (unchecked-add-int
                                                      (unchecked-add-int ctLen inOff)
                                                      Long/BYTES))
                                            ^long (^[byte/1 int] VarHandle/.get
                                                    asLongView
                                                    tag
                                                    Long/BYTES)))]
            (when-not (== tagCompare 0) (throw (AEADBadTagException. "Tag mismatch")))
            (.chaCha20Transform ChaCha20Cipher/this ctPlusTag inOff ctLen out outOff)
            (set! aadDone false)
            ctLen))))

    (method ^:public doFinal :throws [ShortBufferException AEADBadTagException KeyException] ^int [this
                                                                                                   ^ByteBuffer input
                                                                                                   ^ByteBuffer output]
      (let [^:mutable ^int len 0
            inLen (.remaining input)
            ^:mutable ^byte/1 ct nil
            ^:mutable ^byte/1 buf nil
            ^:mutable ^int bufLen 0
            ctLen (unchecked-add-int (.getBufferedLength this) inLen)]
        (when (< ctLen TAG_LENGTH) (throw (AEADBadTagException. "Input too short - need tag")))
        (if (< inLen TAG_LENGTH)
            (do
              (when (> inLen 0) (.doUpdate this input output))
              (when (some? cipherBuf) (set! ct (.getBuffer cipherBuf)))
              (set! len ctLen))
            (do
              (when (some? cipherBuf)
                (set! buf (.getBuffer cipherBuf))
                (set! bufLen (.size cipherBuf)))
              (set! ct (new byte/1 inLen))
              (.get input ct 0 inLen)
              (set! len inLen)))
        (.doUpdate this nil 0 0 nil 0)
        (when (some? buf) (set! dataLen (.authUpdate ChaCha20Cipher/this buf 0 bufLen)))
        (set! len (unchecked-subtract-int len TAG_LENGTH))
        (.authFinalizeData ChaCha20Cipher/this ct 0 len tag 0)
        (when-not (== (bit-or (bit-xor ^long (^[byte/1 int] VarHandle/.get asLongView ct len)
                                       ^long (^[byte/1 int] VarHandle/.get asLongView tag 0))
                              (bit-xor ^long (^[byte/1 int] VarHandle/.get
                                               asLongView
                                               ct
                                               (unchecked-add-int len Long/BYTES))
                                       ^long (^[byte/1 int] VarHandle/.get
                                               asLongView
                                               tag
                                               Long/BYTES)))
                      0)
          (throw (AEADBadTagException. "Tag mismatch")))
        (when (some? buf)
          (.chaCha20Transform ChaCha20Cipher/this buf 0 bufLen buf 0)
          (.put output buf 0 bufLen))
        (.chaCha20Transform ChaCha20Cipher/this ct 0 len ct 0)
        (.put output ct 0 len)
        (set! aadDone false)
        (unchecked-subtract-int ctLen TAG_LENGTH))))

  (defclass ^:public ^:static ^:final ChaCha20Only
    :extends ChaCha20Cipher

    (constructor ^:public [this] (set! (.-mode this) MODE_NONE)))

  (defclass ^:public ^:static ^:final ChaCha20Poly1305
    :extends ChaCha20Cipher

    (constructor ^:public [this]
      (set! (.-mode this) MODE_AEAD)
      (set! (.-authAlgName this) "Poly1305"))))

        (throw (StreamCorruptedException. (java-str "Illegal mappings count: " size))))
      (let [cap (IdentityHashMap/capacity size)]
        (.checkArray (SharedSecrets/getJavaObjectInputStreamAccess)
                     s
                     Object/1
                     (unchecked-multiply-int cap 2))
        (set! (.-size this) size)
        (.init this cap)
        (loop [^int i 0]
          (when (< i size)
            (let [^K key (.readObject s)
                  ^V value (.readObject s)]
              (.putForCreate this key value)
              (recur (unchecked-inc-int i))))))))

  (method ^:private putForCreate :throws [StreamCorruptedException] ^void [this ^K key ^V value]
    (let [k (IdentityHashMap/maskNull key)
          tab table
          len (alength tab)
          ^:mutable i (IdentityHashMap/hash k len)
          ^:mutable ^Object item nil]
      (while (some? (set! item (aget tab i)))
        (when (identical? item k) (throw (StreamCorruptedException.)))
        (set! i (IdentityHashMap/nextKeyIndex i len)))
      (aset tab i k)
      (aset tab (unchecked-add-int i 1) value)))

  (method ^:public forEach ^void [this ^{:tag (BiConsumer (? super K) (? super V))} action]
    (Objects/requireNonNull action)
    (let [expectedModCount modCount
          t table]
      (loop [^int index 0]
        (when (< index (alength t))
          (let [k (aget t index)]
            (when (some? k)
              (.accept action (IdentityHashMap/unmaskNull k) (aget t (unchecked-add-int index 1))))
            (if (not (== modCount expectedModCount))
                (throw (ConcurrentModificationException.))
                (recur (unchecked-add-int index 2))))))))

  (method ^:public replaceAll ^void [this
                                     ^{:tag (BiFunction (? super K) (? super V) (? extends V))} function]
    (Objects/requireNonNull function)
    (let [expectedModCount modCount
          t table]
      (loop [^int index 0]
        (when (< index (alength t))
          (let [k (aget t index)]
            (when (some? k)
              (aset t
                    (unchecked-add-int index 1)
                    (.apply function
                            (IdentityHashMap/unmaskNull k)
                            (aget t (unchecked-add-int index 1)))))
            (if (not (== modCount expectedModCount))
                (throw (ConcurrentModificationException.))
                (recur (unchecked-add-int index 2))))))))

  (method ^:public remove ^boolean [this key value]
    (.removeMapping this key value))

  (method ^:public replace ^boolean [this ^K key ^V oldValue ^V newValue]
    (let [k (IdentityHashMap/maskNull key)
          tab table
          len (alength tab)
          ^:mutable i (IdentityHashMap/hash k len)]
      (while true
        (let [item (aget tab i)]
          (when (identical? item k)
            (when-not (identical? (aget tab (unchecked-add-int i 1)) oldValue) (return false))
            (aset tab (unchecked-add-int i 1) newValue)
            (return true))
          (when (nil? item) (return false))
          (set! i (IdentityHashMap/nextKeyIndex i len))))))

  (defclass ^:static IdentityHashMapSpliterator
    :type-params [K V]

    (field ^:final ^{:tag (IdentityHashMap K V)} map)

    (field ^int index)

    (field ^int fence)

    (field ^int est)

    (field ^int expectedModCount)

    (constructor [this ^{:tag (IdentityHashMap K V)} map ^int origin ^int fence ^int est
                  ^int expectedModCount]
      (set! (.-map this) map)
      (set! (.-index this) origin)
      (set! (.-fence this) fence)
      (set! (.-est this) est)
      (set! (.-expectedModCount this) expectedModCount))

    (method ^:final getFence ^int [this]
      (let [^:mutable ^int hi 0]
        (when (< (set! hi fence) 0)
          (set! est (.-size map))
          (set! expectedModCount (.-modCount map))
          (set! hi (set! fence (alength (.-table map)))))
        hi))

    (method ^:public ^:final estimateSize ^long [this]
      (.getFence this)
      (long est)))

  (defclass ^:static ^:final KeySpliterator
    :extends (IdentityHashMapSpliterator K V)
    :implements [(Spliterator K)]
    :type-params [K V]

    (constructor [this ^{:tag (IdentityHashMap K V)} map ^int origin ^int fence ^int est
                  ^int expectedModCount]
      (super. map origin fence est expectedModCount))

    (method ^:public trySplit ^{:tag (KeySpliterator K V)} [this]
      (let [hi (.getFence this)
            lo (.-index this)
            mid (bit-and-int (unsigned-bit-shift-right-int (unchecked-add-int lo hi) 1)
                             (bit-not-int 1))]
        (when-not (>= lo mid)
          (KeySpliterator. (.-map this)
                           lo
                           (set! (.-index this) mid)
                           (set! (.-est this) (unsigned-bit-shift-right-int (.-est this) 1))
                           (.-expectedModCount this)))))

    (method ^:public forEachRemaining ^void [this ^{:tag (Consumer (? super K))} action]
      (when (nil? action) (throw (NullPointerException.)))
      (let [^:mutable ^int i 0
            ^:mutable ^int hi 0
            ^:mutable ^int mc 0
            ^:mutable ^Object key nil
            ^:mutable ^{:tag (IdentityHashMap K V)} m nil
            ^:mutable ^Object/1 a nil]
        (when (and (and (and (some? (set! m (.-map this))) (some? (set! a (.-table m))))
                        (>= (set! i (.-index this)) 0))
                   (<= (set! (.-index this) (set! hi (.getFence this))) (alength a)))
          (while (< i hi)
            (when (some? (set! key (aget a i))) (.accept action (IdentityHashMap/unmaskNull key)))
            (set! i (unchecked-add-int i 2)))
          (when (== (.-modCount m) (.-expectedModCount this)) (return)))
        (throw (ConcurrentModificationException.))))

    (method ^:public tryAdvance ^boolean [this ^{:tag (Consumer (? super K))} action]
      (when (nil? action) (throw (NullPointerException.)))
      (let [a (.-table (.-map this))
            hi (.getFence this)]
        (while (< (.-index this) hi)
          (let [key (aget a (.-index this))]
            (set! (.-index this) (unchecked-add-int (.-index this) 2))
            (when (some? key)
              (.accept action (IdentityHashMap/unmaskNull key))
              (when-not (== (.-modCount (.-map this)) (.-expectedModCount this))
                (throw (ConcurrentModificationException.)))
              (return true))))
        false))

    (method ^:public characteristics ^int [this]
      (bit-or-int (if (or (< (.-fence this) 0) (== (.-est this) (.-size (.-map this))))
                      KeySpliterator/SIZED
                      0)
                  Spliterator/DISTINCT)))


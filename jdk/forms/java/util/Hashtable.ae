      (set! lf (Math/clamp lf (float 0.25) (float 4.0)))
      (let [^:mutable origlength (.readInt s)
            ^:mutable elements (.readInt s)]
        (when (< elements 0)
          (throw (StreamCorruptedException. (java-str "Illegal # of Elements: " elements))))
        (set! origlength
              (Math/max origlength
                        (unchecked-add-int (unchecked-int (unchecked-divide-float elements lf)) 1)))
        (let [^:mutable length (unchecked-add-int
                                 (unchecked-int
                                   (unchecked-divide-float
                                     (unchecked-multiply-float elements (float 1.05))
                                     lf))
                                 3)]
          (when (and (> length elements) (== (bit-and-int length 1) 0))
            (set! length (unchecked-dec-int length)))
          (set! length (Math/min length origlength))
          (when (< length 0) (set! length origlength))
          (.checkArray (SharedSecrets/getJavaObjectInputStreamAccess) s Map$Entry/1 length)
          (UnsafeHolder/putLoadFactor this lf)
          (set! table (new Entry/1 length))
          (set! threshold
                (unchecked-int
                  (Math/min (unchecked-multiply-float length lf)
                            (unchecked-add-int MAX_ARRAY_SIZE 1))))
          (set! count 0)
          (while (> elements 0)
            (let [^K key (.readObject s)
                  ^V value (.readObject s)]
              (.reconstitutionPut this table key value))
            (set! elements (unchecked-dec-int elements)))))))

  (defclass ^:private ^:static ^:final UnsafeHolder
    (constructor ^:private [this] (throw (InternalError.)))

    (field ^:private ^:static ^:final ^Unsafe unsafe (Unsafe/getUnsafe))

    (field ^:private ^:static ^:final ^long LF_OFFSET
      (.objectFieldOffset unsafe Hashtable "loadFactor"))

    (method ^:static putLoadFactor ^void [^{:tag (Hashtable ? ?)} table ^float lf]
      (.putFloat unsafe table LF_OFFSET lf)))

  (method ^:private reconstitutionPut :throws [StreamCorruptedException] ^void [this
                                                                                ^{:tag (array (Entry ? ?))} tab
                                                                                ^K key ^V value]
    (when (nil? value) (throw (StreamCorruptedException.)))
    (let [hash (.hashCode key)
          index (unchecked-remainder-int (bit-and-int hash 0x7FFFFFFF) (alength tab))]
      (loop [^{:tag (Entry ? ?)} e (aget tab index)]
        (if (some? e)
            (if (and (== (.-hash e) hash) (.equals (.-key e) key))
                (throw (StreamCorruptedException.))
                (recur (.-next e)))
            nil))
      (let [^{:tag (Entry K V)} e (aget tab index)]
        (aset tab index (Entry. hash key value e))
        (set! count (unchecked-inc-int count)))))

  (defclass ^:private ^:static Entry
    :implements [(Map$Entry K V)]
    :type-params [K V]

    (field ^:final ^int hash)

    (field ^:final ^K key)

    (field ^V value)

    (field ^{:tag (Entry K V)} next)

    (constructor ^:protected [this ^int hash ^K key ^V value ^{:tag (Entry K V)} next]
      (set! (.-hash this) hash)
      (set! (.-key this) key)
      (set! (.-value this) value)
      (set! (.-next this) next))

    (method ^:protected clone [this]
      (Entry. hash key value ^Entry (when (some? next) (cast Entry (.clone next)))))

    (method ^:public getKey ^K [this] key)

    (method ^:public getValue ^V [this] value)

    (method ^:public setValue ^V [this ^V value]
      (when (nil? value) (throw (NullPointerException.)))
      (let [^V oldValue (.-value this)] (set! (.-value this) value) oldValue))

    (method ^:public equals ^boolean [this o]
      (if-instance [^{:tag (Map$Entry ? ?)} e o]
        (and (if (nil? key) (nil? (.getKey e)) (.equals key (.getKey e)))
             (if (nil? value) (nil? (.getValue e)) (.equals value (.getValue e))))
        false))

    (method ^:public hashCode ^int [this]
      (bit-xor-int hash (Objects/hashCode value)))

    (method ^:public toString ^String [this]
      (java-str (.toString key) "=" (.toString value))))

  (field ^:private ^:static ^:final ^int KEYS 0)

  (field ^:private ^:static ^:final ^int VALUES 1)

  (field ^:private ^:static ^:final ^int ENTRIES 2)

  (defclass ^:private Enumerator
    :implements [(Enumeration T) (Iterator T)]
    :type-params [T]

    (field ^:final ^{:tag (array (Entry ? ?))} table (.-table Hashtable/this))

    (field ^int index (alength table))

    (field ^{:tag (Entry ? ?)} entry)

    (field ^{:tag (Entry ? ?)} lastReturned)

    (field ^:final ^int type)

    (field ^:final ^boolean iterator)

    (field ^:protected ^int expectedModCount (.-modCount Hashtable/this))

    (constructor [this ^int type ^boolean iterator]
      (set! (.-type this) type)
      (set! (.-iterator this) iterator))

    (method ^:public hasMoreElements ^boolean [this]
      (let [^:mutable ^{:tag (Entry ? ?)} e entry
            ^:mutable i index
            ^{:tag (array (Entry ? ?))} t table]
        (while (and (nil? e) (> i 0)) (set! e (aget t (set! i (unchecked-dec-int i)))))
        (set! entry e)
        (set! index i)
        (some? e)))

    (method ^:public nextElement ^T [this]
      (let [^:mutable ^{:tag (Entry ? ?)} et entry
            ^:mutable i index
            ^{:tag (array (Entry ? ?))} t table]
        (while (and (nil? et) (> i 0)) (set! et (aget t (set! i (unchecked-dec-int i)))))
        (set! entry et)
        (set! index i)
        (if (some? et)
            (let [^{:tag (Entry ? ?)} e (set! lastReturned entry)]
              (set! entry (.-next e))
              (cond (== type KEYS) (.-key e) (== type VALUES) (.-value e) :else ^Object e))
            (throw (NoSuchElementException. "Hashtable Enumerator")))))

    (method ^:public hasNext ^boolean [this] (.hasMoreElements this))

    (method ^:public next ^T [this]
      (when-not (== (.-modCount Hashtable/this) expectedModCount)
        (throw (ConcurrentModificationException.)))
      (.nextElement this))

    (method ^:public remove ^void [this]
      (when-not iterator (throw (UnsupportedOperationException.)))
      (when (nil? lastReturned) (throw (IllegalStateException. "Hashtable Enumerator")))
      (when-not (== modCount expectedModCount) (throw (ConcurrentModificationException.)))
      (locking Hashtable/this
        (let [^{:tag (array (Entry ? ?))} tab (.-table Hashtable/this)
              index (unchecked-remainder-int (bit-and-int (.-hash lastReturned) 0x7FFFFFFF)
                                             (alength tab))
              ^:mutable ^{:tag (Entry K V)} e (aget tab index)]
          (let [^:mutable ^{:tag (Entry K V)} prev nil]
            (while (some? e)
              (when (identical? e lastReturned)
                (if (nil? prev) (aset tab index (.-next e)) (set! (.-next prev) (.-next e)))
                (set! expectedModCount (unchecked-inc-int expectedModCount))
                (set! lastReturned nil)
                (set! (.-modCount Hashtable/this) (unchecked-inc-int (.-modCount Hashtable/this)))
                (set! (.-count Hashtable/this) (unchecked-dec-int (.-count Hashtable/this)))
                (return))
              (set! prev e)
              (set! e (.-next e))))
          (throw (ConcurrentModificationException.)))))))

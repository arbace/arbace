              (.write (.-out this) (aget base64 (bit-and-int (bit-shift-left-int b1 2) 0x3f)))
              (when doPadding (.write (.-out this) \=))))
        (set! leftover 0)
        (.close (.-out this)))))

  (defclass ^:private ^:static DecInputStream
    :extends InputStream

    (field ^:private ^:final ^InputStream is)

    (field ^:private ^:final ^boolean isMIME)

    (field ^:private ^:final ^int/1 base64)

    (field ^:private ^int bits 0)

    (field ^:private ^int wpos 0)

    (field ^:private ^int rpos 0)

    (field ^:private ^boolean eof false)

    (field ^:private ^boolean closed false)

    (constructor [this ^InputStream is ^int/1 base64 ^boolean isMIME]
      (set! (.-is this) is)
      (set! (.-base64 this) base64)
      (set! (.-isMIME this) isMIME))

    (field ^:private ^byte/1 sbBuf (new byte/1 1))

    (method ^:public read :throws [IOException] ^int [this]

                                     (java-str "Illegal base64 character 0x"
                                               (Integer/toHexString i)))))
                          (return (.padding this b off pos limit)))
                        (set! wpos (unchecked-subtract-int wpos 6))
                        (set! bits (bit-or-int bits (bit-shift-left-int v wpos)))
                        (when-not (not (== wpos 0))
                          (if (>= (unchecked-subtract-int limit pos) 3)
                              (do
                                (aset b pos (unchecked-byte (bit-shift-right-int bits 16)))
                                (set! pos (unchecked-inc-int pos))
                                (aset b pos (unchecked-byte (bit-shift-right-int bits 8)))
                                (set! pos (unchecked-inc-int pos))
                                (aset b pos (unchecked-byte bits))
                                (set! pos (unchecked-inc-int pos))
                                (set! bits 0)
                                (set! wpos 24)
                                (when (== pos limit) (return len)))
                              (do
                                (aset b pos (unchecked-byte (bit-shift-right-int bits 16)))
                                (set! pos (unchecked-inc-int pos))
                                (when (== pos limit) (set! rpos 16) (return len))
                                (aset b pos (unchecked-byte (bit-shift-right-int bits 8)))
                                (set! pos (unchecked-inc-int pos))
                                (set! rpos 8)
                                (return len))))))))))))

    (method ^:public available :throws [IOException] ^int [this]
      (when closed (throw (IOException. "Stream is closed")))
      (.available is))

    (method ^:public close :throws [IOException] ^void [this]
      (when-not closed (set! closed true) (.close is)))))

    (method ^:public close :throws [IOException] ^void [this]
      (when-not closed
        (set! closed true)
        (if (== leftover 1)
            (do
              (.checkNewline this)
              (.write (.-out this) (aget base64 (bit-shift-right-int b0 2)))

              (.write (.-out this) buf 0 dp)
              (set! off sl)
              (set! linepos (unchecked-add-int linepos dp))
              (set! nBits24 (unchecked-subtract-int nBits24 (unchecked-divide-int dp 4)))))
          (if (== leftover 1)

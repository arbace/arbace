                      (while true
                        (when-not (== (bit-and-int (set! b (.getPendingCount t)) FINISHED) 0)
                          (break :outer))
                        (set! state
                              (cond
                                (not (== (bit-and-int b CUMULATE) 0)) FINISHED
                                (> l org) SUMMED
                                :else (bit-or-int SUMMED FINISHED)))
                        (when (.compareAndSetPendingCount t b (bit-or-int b state)) (break))))

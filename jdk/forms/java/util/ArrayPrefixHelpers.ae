                                      (set! (.-out par)
                                            (if (== (.-hi rt) fnc)
                                                lout
                                                (.applyAsInt fn lout (.-out rt))))))
                                  (let [^int refork (if (and
                                                          (== (bit-and-int b CUMULATE) 0)
                                                          (== (.-lo par) org))
                                                        CUMULATE

                        (while true
                          (when (nil? (set! par (cast IntCumulateTask (.getCompleter t))))
                            (when-not (== (bit-and-int state FINISHED) 0) (.quietlyComplete t))
                            (break :outer))
                          (let [b (.getPendingCount par)]
                            (cond
                              (not (== (bit-and-int (bit-and-int b state) FINISHED) 0)) (set! t par)
                              (not (== (bit-and-int (bit-and-int b state) SUMMED) 0))
                                (let [^:mutable ^int nextState 0
                                      ^:mutable ^IntCumulateTask lt nil
                                      ^:mutable ^IntCumulateTask rt nil]
                                  (when (and (some? (set! lt (.-left par)))
                                             (some? (set! rt (.-right par))))

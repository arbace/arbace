          ^:mutable newStamp MINIMUM_USER_STAMP]
      (while true
        (let [^:mutable min Integer/MAX_VALUE]
          (for-each [^int v stamp]
            (when (and (>= v newStamp) (> min v)) (set! min v))
            (when (< max v) (set! max v)))
          (when (and (not (== max min)) (== min Integer/MAX_VALUE)) (break))

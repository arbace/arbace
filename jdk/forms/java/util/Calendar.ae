  (method ^:public clone [this]
    (try
      (let [other (cast Calendar (.clone super))]
        (set! (.-fields other) (new int/1 FIELD_COUNT))
        (set! (.-isSet other) (new boolean/1 FIELD_COUNT))
        (set! (.-stamp other) (new int/1 FIELD_COUNT))
        (loop [^int i 0]
          (when (< i FIELD_COUNT)
            (aset (.-fields other) i (aget fields i))
            (aset (.-stamp other) i (aget stamp i))
            (aset (.-isSet other) i (aget isSet i))
            (recur (unchecked-inc-int i))))
        (set! (.-zone other) (cast TimeZone (.clone zone)))
        other)
      (catch CloneNotSupportedException e (throw (InternalError. e)))))

  (method ^:public toString ^String [this]
    (let [buffer (StringBuilder. 800)]
      (.append (.append buffer (.getName (.getClass this))) \[)
      (Calendar/appendValue buffer "time" isTimeSet time)
      (.append (.append buffer ",areFieldsSet=") areFieldsSet)
      (.append (.append buffer ",areAllFieldsSet=") areAllFieldsSet)
      (.append (.append buffer ",lenient=") lenient)
      (.append (.append buffer ",zone=") zone)
      (Calendar/appendValue buffer ",firstDayOfWeek" true (long firstDayOfWeek))
      (Calendar/appendValue buffer ",minimalDaysInFirstWeek" true (long minimalDaysInFirstWeek))
      (loop [^int i 0]
        (when (< i FIELD_COUNT)
          (.append buffer \,)
          (Calendar/appendValue buffer
                                (Calendar/getFieldName i)
                                (.isSet this i)
                                (long (aget fields i)))
          (recur (unchecked-inc-int i))))
      (.append buffer \])
      (.toString buffer)))

  (method ^:private ^:static appendValue ^void [^StringBuilder sb ^String item ^boolean valid
                                                ^long value]
    (.append (.append sb item) \=)
    (if valid (.append sb value) (.append sb \?))))

            (cond
              (== (bit-and-int fieldMask 1) 1) (do (aset stamp i COMPUTED) (aset isSet i true))
              (and areAllFieldsSet (not (aget isSet i))) (set! areAllFieldsSet false))
            (set! fieldMask (unsigned-bit-shift-right-int fieldMask 1))
            (recur (unchecked-inc-int i))))))

  (method ^:final setFieldsNormalized ^void [this ^:mutable ^int fieldMask]
    (when-not (== fieldMask ALL_FIELDS)
      (loop [^int i 0]
        (when (< i (alength fields))
          (when (== (bit-and-int fieldMask 1) 0)
            (aset stamp i (aset fields i 0))
            (aset isSet i false))
          (set! fieldMask (bit-shift-right-int fieldMask 1))
          (recur (unchecked-inc-int i)))))
    (set! areFieldsSet true)
    (set! areAllFieldsSet false))

  (method ^:final isPartiallyNormalized ^boolean [this]
    (and areFieldsSet (not areAllFieldsSet)))

  (method ^:final selectFields ^int [this]
    (let [^:mutable fieldMask (bit-shift-left-int 1 YEAR)]
      (when-not (== (aget stamp ERA) UNSET)
        (set! fieldMask (bit-or-int fieldMask (bit-shift-left-int 1 ERA))))
      (let [dowStamp (aget stamp DAY_OF_WEEK)
            monthStamp (aget stamp MONTH)
            ^:mutable domStamp (aget stamp DAY_OF_MONTH)
            ^:mutable womStamp (Calendar/aggregateStamp (aget stamp WEEK_OF_MONTH) dowStamp)
            ^:mutable dowimStamp (Calendar/aggregateStamp
                                   (aget stamp DAY_OF_WEEK_IN_MONTH)
                                   dowStamp)
            doyStamp (aget stamp DAY_OF_YEAR)
            ^:mutable woyStamp (Calendar/aggregateStamp (aget stamp WEEK_OF_YEAR) dowStamp)
            ^:mutable bestStamp domStamp]
        (when (> womStamp bestStamp) (set! bestStamp womStamp))
        (when (> dowimStamp bestStamp) (set! bestStamp dowimStamp))
        (when (> doyStamp bestStamp) (set! bestStamp doyStamp))
        (when (> woyStamp bestStamp) (set! bestStamp woyStamp))
        (when (== bestStamp UNSET)
          (set! womStamp (aget stamp WEEK_OF_MONTH))
          (set! dowimStamp (Math/max (aget stamp DAY_OF_WEEK_IN_MONTH) dowStamp))
          (set! woyStamp (aget stamp WEEK_OF_YEAR))
          (set! bestStamp (Math/max (Math/max womStamp dowimStamp) woyStamp))
          (when (== bestStamp UNSET) (set! bestStamp (set! domStamp monthStamp))))
        (cond
          (or (or (== bestStamp domStamp)
                  (and (== bestStamp womStamp)
                       (>= (aget stamp WEEK_OF_MONTH) (aget stamp WEEK_OF_YEAR))))
              (and (== bestStamp dowimStamp)
                   (>= (aget stamp DAY_OF_WEEK_IN_MONTH) (aget stamp WEEK_OF_YEAR))))
            (do
              (set! fieldMask (bit-or-int fieldMask (bit-shift-left-int 1 MONTH)))
              (if (== bestStamp domStamp)
                  (set! fieldMask (bit-or-int fieldMask (bit-shift-left-int 1 DAY_OF_MONTH)))
                  (do
                    (when-not (== dowStamp UNSET)
                      (set! fieldMask (bit-or-int fieldMask (bit-shift-left-int 1 DAY_OF_WEEK))))
                    (cond
                      (== womStamp dowimStamp)
                        (if (>= (aget stamp WEEK_OF_MONTH) (aget stamp DAY_OF_WEEK_IN_MONTH))
                            (set! fieldMask
                                  (bit-or-int fieldMask (bit-shift-left-int 1 WEEK_OF_MONTH)))
                            (set!
                              fieldMask
                              (bit-or-int fieldMask (bit-shift-left-int 1 DAY_OF_WEEK_IN_MONTH))))
                      (== bestStamp womStamp)
                        (set! fieldMask (bit-or-int fieldMask (bit-shift-left-int 1 WEEK_OF_MONTH)))
                      :else
                        (when-not (== (aget stamp DAY_OF_WEEK_IN_MONTH) UNSET)
                          (set! fieldMask
                                (bit-or-int fieldMask (bit-shift-left-int 1 DAY_OF_WEEK_IN_MONTH))))))))
          (== bestStamp doyStamp)
            (set! fieldMask (bit-or-int fieldMask (bit-shift-left-int 1 DAY_OF_YEAR)))
          :else
            (do
              (when-not (== dowStamp UNSET)
                (set! fieldMask (bit-or-int fieldMask (bit-shift-left-int 1 DAY_OF_WEEK))))
              (set! fieldMask (bit-or-int fieldMask (bit-shift-left-int 1 WEEK_OF_YEAR)))))
        (let [hourOfDayStamp (aget stamp HOUR_OF_DAY)
              hourStamp (Calendar/aggregateStamp (aget stamp HOUR) (aget stamp AM_PM))]
          (set! bestStamp (if (> hourStamp hourOfDayStamp) hourStamp hourOfDayStamp))
          (when (== bestStamp UNSET)
            (set! bestStamp (Math/max (aget stamp HOUR) (aget stamp AM_PM))))
          (when-not (== bestStamp UNSET)
            (if (== bestStamp hourOfDayStamp)
                (set! fieldMask (bit-or-int fieldMask (bit-shift-left-int 1 HOUR_OF_DAY)))
                (do
                  (set! fieldMask (bit-or-int fieldMask (bit-shift-left-int 1 HOUR)))
                  (when-not (== (aget stamp AM_PM) UNSET)
                    (set! fieldMask (bit-or-int fieldMask (bit-shift-left-int 1 AM_PM)))))))
          (when-not (== (aget stamp MINUTE) UNSET)
            (set! fieldMask (bit-or-int fieldMask (bit-shift-left-int 1 MINUTE))))
          (when-not (== (aget stamp SECOND) UNSET)
            (set! fieldMask (bit-or-int fieldMask (bit-shift-left-int 1 SECOND))))
          (when-not (== (aget stamp MILLISECOND) UNSET)
            (set! fieldMask (bit-or-int fieldMask (bit-shift-left-int 1 MILLISECOND))))
          (when (>= (aget stamp ZONE_OFFSET) MINIMUM_USER_STAMP)
            (set! fieldMask (bit-or-int fieldMask (bit-shift-left-int 1 ZONE_OFFSET))))
          (when (>= (aget stamp DST_OFFSET) MINIMUM_USER_STAMP)
            (set! fieldMask (bit-or-int fieldMask (bit-shift-left-int 1 DST_OFFSET))))
          fieldMask))))

  (method ^:private ^:static aggregateStamp ^int [^int stampA ^int stampB]
    (if (or (== stampA UNSET) (== stampB UNSET)) UNSET (Math/max stampA stampB)))

  (method ^:static isFieldSet ^boolean [^int fieldMask ^int field]
    (not (== (bit-and-int fieldMask (bit-shift-left-int 1 field)) 0)))

  (method ^:final isExternallySet ^boolean [this ^int field]
    (>= (aget stamp field) MINIMUM_USER_STAMP))

  (method ^:static getFieldName ^String [^int field]
    (aget FIELD_NAME field))

  (method ^:private updateTime ^void [this]
    (.computeTime this)
    (set! isTimeSet true))

  (method ^:private adjustStamp ^void [this]
    (let [^:mutable max MINIMUM_USER_STAMP
          ^:mutable newStamp MINIMUM_USER_STAMP]
      (while true
        (let [^:mutable min Integer/MAX_VALUE]
          (for-each [^int v stamp]
            (when (and (>= v newStamp) (> min v)) (set! min v))
            (when (< max v) (set! max v)))
          (when (and (not (== max min)) (== min Integer/MAX_VALUE)) (break))
          (loop [^int i 0]
            (if (< i (alength stamp))
                (if (== (aget stamp i) min)
                    (do (aset stamp i newStamp) (recur (unchecked-inc-int i)))
                    (recur (unchecked-inc-int i)))
                nil))
          (set! newStamp (unchecked-inc-int newStamp))
          (when (== min max) (break))))
      (set! nextStamp newStamp)))

  (method ^:public getCalendarType ^String [this] "gregory")

  (method ^:public equals ^boolean [this obj]
    (if (identical? this obj)
        true
        (try
          (let [that (cast Calendar obj)]
            (and (and (and (and (== (.compareTo this (Calendar/getMillisOf that)) 0)
                                (= lenient (.-lenient that)))
                           (== firstDayOfWeek (.-firstDayOfWeek that)))
                      (== minimalDaysInFirstWeek (.-minimalDaysInFirstWeek that)))
                 (.equals zone (.-zone that))))
          (catch Exception e false))))

  (method ^:public hashCode ^int [this]
    (let [otheritems (bit-or-int (bit-or-int (bit-or-int
                                               (if lenient 1 0)
                                               (bit-shift-left-int firstDayOfWeek 1))
                                             (bit-shift-left-int minimalDaysInFirstWeek 4))
                                 (bit-shift-left-int (.hashCode zone) 7))
          t (Calendar/getMillisOf this)]
      (bit-xor-int (bit-xor-int (unchecked-int t) (unchecked-int (bit-shift-right t 32)))
                   otheritems)))

  (method ^:public before ^boolean [this when]
    (and (instance? Calendar when) (< (.compareTo this (cast Calendar when)) 0)))

  (method ^:public after ^boolean [this when]
    (and (instance? Calendar when) (> (.compareTo this (cast Calendar when)) 0)))

  (method ^:public compareTo ^int [this ^Calendar anotherCalendar]
    (.compareTo this (Calendar/getMillisOf anotherCalendar)))

  (method ^:private compareTo ^int [this ^long t]
    (let [thisTime (Calendar/getMillisOf this)] (cond (> thisTime t) 1 (== thisTime t) 0 :else -1)))

  (method ^:private ^:static getMillisOf ^long [^Calendar calendar]
    (if (.-isTimeSet calendar)
        (.-time calendar)
        (let [cal (cast Calendar (.clone calendar))] (.setLenient cal true) (.getTimeInMillis cal))))

  (method ^:public ^:abstract add ^void [this ^int field ^int amount])

  (method ^:public ^:abstract roll ^void [this ^int field ^boolean up])

  (method ^:public roll ^void [this ^int field ^:mutable ^int amount]
    (while (> amount 0) (.roll this field true) (set! amount (unchecked-dec-int amount)))
    (while (< amount 0) (.roll this field false) (set! amount (unchecked-inc-int amount))))

  (method ^:public setTimeZone ^void [this ^TimeZone value]
    (set! zone value)
    (set! areAllFieldsSet (set! areFieldsSet false)))

  (method ^:public getTimeZone ^TimeZone [this] zone)

  (method ^:public setLenient ^void [this ^boolean lenient]
    (set! (.-lenient this) lenient))

  (method ^:public isLenient ^boolean [this] lenient)

  (method ^:public setFirstDayOfWeek ^void [this ^int value]
    (when-not (== firstDayOfWeek value)
      (set! firstDayOfWeek value)
      (set! areAllFieldsSet (set! areFieldsSet false))))

  (method ^:public getFirstDayOfWeek ^int [this] firstDayOfWeek)

  (method ^:public setMinimalDaysInFirstWeek ^void [this ^int value]
    (when-not (== minimalDaysInFirstWeek value)
      (set! minimalDaysInFirstWeek value)
      (set! areAllFieldsSet (set! areFieldsSet false))))

  (method ^:public getMinimalDaysInFirstWeek ^int [this]
    minimalDaysInFirstWeek)

  (method ^:public isWeekDateSupported ^boolean [this] false)

  (method ^:public getWeekYear ^int [this]
    (throw (UnsupportedOperationException.)))

  (method ^:public setWeekDate ^void [this ^int weekYear ^int weekOfYear ^int dayOfWeek]
    (throw (UnsupportedOperationException.)))

  (method ^:public getWeeksInWeekYear ^int [this]
    (throw (UnsupportedOperationException.)))

  (method ^:public ^:abstract getMinimum ^int [this ^int field])

  (method ^:public ^:abstract getMaximum ^int [this ^int field])

  (method ^:public ^:abstract getGreatestMinimum ^int [this ^int field])

  (method ^:public ^:abstract getLeastMaximum ^int [this ^int field])

  (method ^:public getActualMinimum ^int [this ^int field]
    (.getMinimum this field))

  (method ^:public getActualMaximum ^int [this ^int field]
    (.getMaximum this field))

  (method ^:private ^:synchronized writeObject :throws [IOException] ^void [this
                                                                            ^ObjectOutputStream stream]
    (when-not isTimeSet (try (.updateTime this) (catch IllegalArgumentException e)))
    (.defaultWriteObject stream)
    (.writeObject stream nil))

  (method ^:private readObject :throws [IOException ClassNotFoundException] ^void [this
                                                                                   ^ObjectInputStream stream]
    (.defaultReadObject stream)
    (set! stamp (new int/1 FIELD_COUNT))
    (cond
      (>= serialVersionOnStream 2)
        (do
          (set! isTimeSet true)
          (when (nil? fields) (set! fields (new int/1 FIELD_COUNT)))
          (when (nil? isSet) (set! isSet (new boolean/1 FIELD_COUNT))))
      (>= serialVersionOnStream 0)
        (loop [^int i 0]
          (when (< i FIELD_COUNT)
            (aset stamp i (if (aget isSet i) COMPUTED UNSET))
            (recur (unchecked-inc-int i)))))
    (set! serialVersionOnStream currentSerialVersion)
    (let [^:mutable ^Object zi nil]
      (try
        (set! zi (.readObject stream))
        (catch Exception e
          (when-not (instance? OptionalDataException e)
            (cond
              (instance? RuntimeException e) (throw (cast RuntimeException e))
              (instance? IOException e) (throw (cast IOException e))
              (instance? ClassNotFoundException e) (throw (cast ClassNotFoundException e)))
            (throw (RuntimeException. e)))))
      (when (instance? TimeZone zi) (set! zone (cast TimeZone zi)))
      (when (instance? SimpleTimeZone zone)
        (let [id (.getID zone)
              tz (TimeZone/getTimeZone id)]
          (when (and (and (some? tz) (.hasSameRules tz zone)) (.equals (.getID tz) id))
            (set! zone tz))))))

  (method ^:public clone [this]
    (try
      (let [other (cast Calendar (.clone super))]
        (set! (.-fields other) (new int/1 FIELD_COUNT))
        (set! (.-isSet other) (new boolean/1 FIELD_COUNT))
        (set! (.-stamp other) (new int/1 FIELD_COUNT))
        (loop [^int i 0]
          (when (< i FIELD_COUNT)
            (aset (.-fields other) i (aget fields i))
            (aset (.-stamp other) i (aget stamp i))
            (aset (.-isSet other) i (aget isSet i))
            (recur (unchecked-inc-int i))))
        (set! (.-zone other) (cast TimeZone (.clone zone)))
        other)
      (catch CloneNotSupportedException e (throw (InternalError. e)))))

  (method ^:public toString ^String [this]
    (let [buffer (StringBuilder. 800)]
      (.append (.append buffer (.getName (.getClass this))) \[)
      (Calendar/appendValue buffer "time" isTimeSet time)
      (.append (.append buffer ",areFieldsSet=") areFieldsSet)
      (.append (.append buffer ",areAllFieldsSet=") areAllFieldsSet)
      (.append (.append buffer ",lenient=") lenient)
      (.append (.append buffer ",zone=") zone)
      (Calendar/appendValue buffer ",firstDayOfWeek" true (long firstDayOfWeek))
      (Calendar/appendValue buffer ",minimalDaysInFirstWeek" true (long minimalDaysInFirstWeek))
      (loop [^int i 0]
        (when (< i FIELD_COUNT)
          (.append buffer \,)
          (Calendar/appendValue buffer
                                (Calendar/getFieldName i)
                                (.isSet this i)
                                (long (aget fields i)))
          (recur (unchecked-inc-int i))))
      (.append buffer \])
      (.toString buffer)))

  (method ^:private ^:static appendValue ^void [^StringBuilder sb ^String item ^boolean valid
                                                ^long value]
    (.append (.append sb item) \=)
    (if valid (.append sb value) (.append sb \?))))

            ^:mutable womStamp (Calendar/aggregateStamp (aget stamp WEEK_OF_MONTH) dowStamp)
            ^:mutable dowimStamp (Calendar/aggregateStamp
                                   (aget stamp DAY_OF_WEEK_IN_MONTH)
                                   dowStamp)
            doyStamp (aget stamp DAY_OF_YEAR)
            ^:mutable woyStamp (Calendar/aggregateStamp (aget stamp WEEK_OF_YEAR) dowStamp)
            ^:mutable bestStamp domStamp]
        (when (> womStamp bestStamp) (set! bestStamp womStamp))
        (when (> dowimStamp bestStamp) (set! bestStamp dowimStamp))
        (when (> doyStamp bestStamp) (set! bestStamp doyStamp))
        (when (> woyStamp bestStamp) (set! bestStamp woyStamp))

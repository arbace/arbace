          (set! womStamp (aget stamp WEEK_OF_MONTH))
          (set! dowimStamp (Math/max (aget stamp DAY_OF_WEEK_IN_MONTH) dowStamp))
          (set! woyStamp (aget stamp WEEK_OF_YEAR))
          (set! bestStamp (Math/max (Math/max womStamp dowimStamp) woyStamp))
          (when (== bestStamp UNSET) (set! bestStamp (set! domStamp monthStamp))))
        (cond

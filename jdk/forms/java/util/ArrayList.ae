        (when (and (== (.-modCount this) expectedModCount) (< i size))
          (.accept action (ArrayList/elementAt es i))
          (recur (unchecked-inc-int i))))
      (when-not (== (.-modCount this) expectedModCount) (throw (ConcurrentModificationException.)))))

  (method ^:public spliterator ^{:tag (Spliterator E)} [this]
    (ArrayListSpliterator. 0 -1 0))

  (defclass ^:final ArrayListSpliterator
    :implements [(Spliterator E)]

    (field ^:private ^int index)

    (field ^:private ^int fence)

    (field ^:private ^int expectedModCount)

    (constructor [this ^int origin ^int fence ^int expectedModCount]
      (set! (.-index this) origin)
      (set! (.-fence this) fence)
      (set! (.-expectedModCount this) expectedModCount))

    (method ^:private getFence ^int [this]
      (let [^:mutable ^int hi 0]
        (when (< (set! hi fence) 0)
          (set! expectedModCount (.-modCount ArrayList/this))
          (set! hi (set! fence size)))
        hi))

    (method ^:public trySplit ^ArrayListSpliterator [this]
      (let [hi (.getFence this)
            lo index
            mid (unsigned-bit-shift-right-int (unchecked-add-int lo hi) 1)]
        (when-not (>= lo mid) (ArrayListSpliterator. lo (set! index mid) expectedModCount))))

    (method ^:public tryAdvance ^boolean [this ^{:tag (Consumer (? super E))} action]
      (when (nil? action) (throw (NullPointerException.)))
      (let [hi (.getFence this)
            i index]
        (if (< i hi)
            (do
              (set! index (unchecked-add-int i 1))
              (let [^E e (aget elementData i)]
                (.accept action e)
                (when-not (== (.-modCount ArrayList/this) expectedModCount)
                  (throw (ConcurrentModificationException.)))
                true))
            false)))

    (method ^:public forEachRemaining ^void [this ^{:tag (Consumer (? super E))} action]
      (let [^:mutable ^int i 0
            ^:mutable ^int hi 0
            ^:mutable ^int mc 0
            ^:mutable ^Object/1 a nil]
        (when (nil? action) (throw (NullPointerException.)))
        (when (some? (set! a elementData))
          (if (< (set! hi fence) 0)
              (do (set! mc (.-modCount ArrayList/this)) (set! hi size))
              (set! mc expectedModCount))
          (when (and (>= (set! i index) 0) (<= (set! index hi) (alength a)))
            (while (< i hi)
              (let [^E e (aget a i)] (.accept action e))
              (set! i (unchecked-inc-int i)))

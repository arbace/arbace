              (let [es (.-elementData root)]
                (when (>= (unchecked-add-int offset i) (alength es))
                  (throw (ConcurrentModificationException.)))
                (while (and (< i size) (== (.-modCount root) expectedModCount))
                  (.accept action (ArrayList/elementAt es (unchecked-add-int offset i)))
                  (set! i (unchecked-inc-int i)))
                (set! cursor i)
                (set! lastRet (unchecked-subtract-int i 1))
                (.checkForComodification this)))))


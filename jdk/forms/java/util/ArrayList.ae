                    true))
                false)))

        (method ^:public forEachRemaining ^void [this ^{:tag (Consumer (? super E))} action]
          (Objects/requireNonNull action)
          (let [^:mutable ^int i 0
                ^:mutable ^int hi 0
                ^:mutable ^int mc 0
                ^{:tag (ArrayList E)} lst root
                ^:mutable ^Object/1 a nil]
            (when (some? (set! a (.-elementData lst)))
              (if (< (set! hi fence) 0)
                  (do (set! mc (.-modCount SubList/this)) (set! hi (unchecked-add-int offset size)))
                  (set! mc expectedModCount))

    (method ^:private rangeCheckForAdd ^void [this ^int index]
      (when (or (< index 0) (> index (.-size this)))
        (throw (IndexOutOfBoundsException. (.outOfBoundsMsg this index)))))

    (method ^:private outOfBoundsMsg ^String [this ^int index]
      (java-str "Index: " index ", Size: " (.-size this)))

    (method ^:private checkForComodification ^void [this]
      (when-not (== (.-modCount root) (.-modCount this)) (throw (ConcurrentModificationException.))))

    (method ^:private updateSizeAndModCount ^void [this ^int sizeChange]
      (let [^:mutable ^{:tag (SubList E)} slist this]
        (loop []
          (set! (.-size slist) (unchecked-add-int (.-size slist) sizeChange))
          (set! (.-modCount slist) (.-modCount root))
          (set! slist (.-parent slist))
          (when (some? slist) (recur)))))

    (method ^:public spliterator ^{:tag (Spliterator E)} [this]
      (.checkForComodification this)
      (anon (Spliterator E) []
        (field ^:private ^int index offset)

        (field ^:private ^int fence -1)

        (field ^:private ^int expectedModCount)

        (method ^:private getFence ^int [this]
          (let [^:mutable ^int hi 0]
            (when (< (set! hi fence) 0)

    (method ^:public characteristics ^int [this]
      (bit-or-int (bit-or-int Spliterator/ORDERED Spliterator/SIZED) Spliterator/SUBSIZED)))

  (method ^:private ^:static nBits ^long/1 [^int n]
    (new long/1 (unchecked-add-int (bit-shift-right-int (unchecked-subtract-int n 1) 6) 1)))

  (method ^:private ^:static setBit ^void [^long/1 bits ^int i]
    (let [i-2 (bit-shift-right-int i 6)]
      (aset bits i-2 (bit-or (aget bits i-2) (bit-shift-left 1 i)))))

  (method ^:private ^:static isClear ^boolean [^long/1 bits ^int i]
    (== (bit-and (aget bits (bit-shift-right-int i 6)) (bit-shift-left 1 i)) 0))

  (method ^:public removeIf ^boolean [this ^{:tag (Predicate (? super E))} filter]
    (.removeIf this filter 0 size))

  (method removeIf ^boolean [this ^{:tag (Predicate (? super E))} filter ^:mutable ^int i
                             ^:final ^int end]
    (Objects/requireNonNull filter)
    (let [expectedModCount (.-modCount this)
          es elementData]
      (while (and (< i end) (not (.test filter (ArrayList/elementAt es i))))
        (set! i (unchecked-inc-int i)))
      (if (< i end)
          (let [beg i
                deathRow (ArrayList/nBits (unchecked-subtract-int end beg))]
            (aset deathRow 0 1)
            (set! i (unchecked-add-int beg 1))
            (while (< i end)
              (when (.test filter (ArrayList/elementAt es i))
                (ArrayList/setBit deathRow (unchecked-subtract-int i beg)))
              (set! i (unchecked-inc-int i)))
            (when-not (== (.-modCount this) expectedModCount)
              (throw (ConcurrentModificationException.)))
            (set! (.-modCount this) (unchecked-inc-int (.-modCount this)))
            (let [^:mutable w beg]
              (set! i beg)
              (while (< i end)
                (when (ArrayList/isClear deathRow (unchecked-subtract-int i beg))
                  (aset es w (aget es i))
                  (set! w (unchecked-inc-int w)))
                (set! i (unchecked-inc-int i)))
              (.shiftTailOverGap this es w end)
              true))
          (do
            (when-not (== (.-modCount this) expectedModCount)
              (throw (ConcurrentModificationException.)))
            false))))

  (method ^:public replaceAll ^void [this ^{:tag (UnaryOperator E)} operator]

            (CollectorImpl. supplier accumulator merger finisher CH_NOID)))))

  (method ^:public ^:static toMap :type-params [T K U] ^{:tag (Collector T ? (Map K U))} [^{:tag (Function (? super T) (? extends K))} keyMapper

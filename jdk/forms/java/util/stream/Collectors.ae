  (method ^:public ^:static teeing :type-params [T R1 R2 R] ^{:tag (Collector T ? R)} [^{:tag (Collector (? super T) ? R1)} downstream1
                                                                                       ^{:tag (Collector (? super T) ? R2)} downstream2
                                                                                       ^{:tag (BiFunction (? super R1) (? super R2) R)} merger]
    (Collectors/teeing0 downstream1 downstream2 merger))

  (method ^:private ^:static teeing0 :type-params [T A1 A2 R1 R2 R] ^{:tag (Collector T ? R)} [^{:tag (Collector (? super T) A1 R1)} downstream1
                                                                                               ^{:tag (Collector (? super T) A2 R2)} downstream2
                                                                                               ^{:tag (BiFunction (? super R1) (? super R2) R)} merger]
    (Objects/requireNonNull downstream1 "downstream1")
    (Objects/requireNonNull downstream2 "downstream2")
    (Objects/requireNonNull merger "merger")
    (let [^{:tag (Supplier A1)} c1Supplier (cast
                                             Supplier
                                             (Objects/requireNonNull
                                               (.supplier downstream1)
                                               "downstream1 supplier"))
          ^{:tag (Supplier A2)} c2Supplier (cast
                                             Supplier
                                             (Objects/requireNonNull
                                               (.supplier downstream2)
                                               "downstream2 supplier"))
          ^{:tag (BiConsumer A1 (? super T))} c1Accumulator (cast
                                                              BiConsumer
                                                              (Objects/requireNonNull
                                                                (.accumulator downstream1)
                                                                "downstream1 accumulator"))
          ^{:tag (BiConsumer A2 (? super T))} c2Accumulator (cast
                                                              BiConsumer
                                                              (Objects/requireNonNull
                                                                (.accumulator downstream2)
                                                                "downstream2 accumulator"))
          ^{:tag (BinaryOperator A1)} c1Combiner (cast
                                                   BinaryOperator
                                                   (Objects/requireNonNull
                                                     (.combiner downstream1)
                                                     "downstream1 combiner"))
          ^{:tag (BinaryOperator A2)} c2Combiner (cast
                                                   BinaryOperator
                                                   (Objects/requireNonNull
                                                     (.combiner downstream2)
                                                     "downstream2 combiner"))
          ^{:tag (Function A1 R1)} c1Finisher (cast
                                                Function
                                                (Objects/requireNonNull
                                                  (.finisher downstream1)
                                                  "downstream1 finisher"))
          ^{:tag (Function A2 R2)} c2Finisher (cast
                                                Function
                                                (Objects/requireNonNull
                                                  (.finisher downstream2)
                                                  "downstream2 finisher"))
          ^:mutable ^{:tag (Set Collector$Characteristics)} characteristics nil
          ^{:tag (Set Collector$Characteristics)} c1Characteristics (.characteristics downstream1)
          ^{:tag (Set Collector$Characteristics)} c2Characteristics (.characteristics downstream2)]
      (if (or (.containsAll CH_ID c1Characteristics) (.containsAll CH_ID c2Characteristics))
          (set! characteristics CH_NOID)
          (let [^{:tag (EnumSet Collector$Characteristics)} c (EnumSet/noneOf
                                                                Collector$Characteristics)]
            (.addAll c c1Characteristics)
            (.retainAll c c2Characteristics)
            (.remove c Collector$Characteristics/IDENTITY_FINISH)
            (set! characteristics (Collections/unmodifiableSet c))))
      (letclass [(PairBox
                   (field ^A1 left (.get c1Supplier))

                   (field ^A2 right (.get c2Supplier))

                   (method add ^void [this ^T t]
                     (.accept c1Accumulator left t)
                     (.accept c2Accumulator right t))

                   (method combine ^PairBox [this ^PairBox other]
                     (set! left (.apply c1Combiner left (.-left other)))
                     (set! right (.apply c2Combiner right (.-right other)))
                     this)

                   (method get ^R [this]
                     (let [^R1 r1 (.apply c1Finisher left)
                           ^R2 r2 (.apply c2Finisher right)]
                       (.apply merger r1 r2))))]
        (CollectorImpl. (method-ref Supplier ^PairBox [] PairBox/new)
                        (method-ref BiConsumer [PairBox Object] PairBox/.add)
                        (method-ref BinaryOperator ^PairBox [PairBox PairBox] PairBox/.combine)
                        (method-ref Function [PairBox] PairBox/.get)
                        characteristics))))

  (defclass ^:private ^:static ^:final Partition
    :extends (AbstractMap Boolean T)
    :implements [(Map Boolean T)]
    :type-params [T]

    (field ^:final ^T forTrue)

    (field ^:final ^T forFalse)

    (constructor [this ^T forTrue ^T forFalse]
      (set! (.-forTrue this) forTrue)
      (set! (.-forFalse this) forFalse))

    (method ^:public size ^int [this] 2)

    (method ^:public isEmpty ^boolean [this] false)

    (method ^:public get ^T [this key]
      (when-instance [^Boolean b key] (if (.booleanValue b) forTrue forFalse)))

    (method ^:public containsKey ^boolean [this key]
      (instance? Boolean key))

    (method ^:public containsValue ^boolean [this value]
      (or (Objects/equals value forTrue) (Objects/equals value forFalse)))

    (method ^:public entrySet ^{:tag (Set (Map$Entry Boolean T))} [this]
      (anon (AbstractSet (Map$Entry Boolean T)) []
        (method ^:public iterator ^{:tag (Iterator (Map$Entry Boolean T))} [this]
          (let [^{:tag (Map$Entry Boolean T)} falseEntry (AbstractMap$SimpleImmutableEntry.
                                                           false
                                                           forFalse)
                ^{:tag (Map$Entry Boolean T)} trueEntry (AbstractMap$SimpleImmutableEntry.
                                                          true
                                                          forTrue)]
            (.iterator (List/of falseEntry trueEntry))))

        (method ^:public size ^int [this] 2)))))

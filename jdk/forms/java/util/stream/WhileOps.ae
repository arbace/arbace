  (defclass ^:private ^:static ^:final TakeWhileTask
    :extends (AbstractShortCircuitTask P_IN P_OUT (Node P_OUT) (TakeWhileTask P_IN P_OUT))
    :type-params [P_IN P_OUT]

    (field ^:private ^:final ^{:tag (AbstractPipeline P_OUT P_OUT ?)} op)

    (field ^:private ^:final ^{:tag (IntFunction P_OUT/1)} generator)

    (field ^:private ^:final ^boolean isOrdered)

    (field ^:private ^long thisNodeSize)

    (field ^:private ^boolean shortCircuited)


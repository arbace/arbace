      (set! (.-op this) op)
      (set! (.-generator this) generator)
      (set! (.-isOrdered this) (.isKnown StreamOpFlag/ORDERED (.getStreamAndOpFlags helper))))

    (constructor [this ^{:tag (TakeWhileTask P_IN P_OUT)} parent
                  ^{:tag (Spliterator P_IN)} spliterator]
      (super. parent spliterator)
      (set! (.-op this) (.-op parent))
      (set! (.-generator this) (.-generator parent))
      (set! (.-isOrdered this) (.-isOrdered parent)))


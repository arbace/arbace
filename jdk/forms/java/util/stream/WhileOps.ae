      (let [^{:tag (Node$Builder P_OUT)} builder (.makeNodeBuilder (.-helper this) -1 generator)
            ^{:tag (Sink P_OUT)} s (.opWrapSink op (.getStreamAndOpFlags (.-helper this)) builder)]
        (when (set! shortCircuited
                    (.copyIntoWithCancel (.-helper this)
                                         (.wrapSink (.-helper this) s)
                                         (.-spliterator this)))
          (.cancelLaterNodes this))
        (let [^{:tag (Node P_OUT)} node (.build builder)] (set! thisNodeSize (.count node)) node)))

    (method ^:public ^:final onCompletion ^void [this ^{:tag (CountedCompleter ?)} caller]
      (when-not (.isLeaf this)
        (let [^:mutable ^{:tag (Node P_OUT)} result nil]
          (set! shortCircuited
                (let [a-7 (.-shortCircuited (cast TakeWhileTask (.-leftChild this)))
                      b-8 (.-shortCircuited (cast TakeWhileTask (.-rightChild this)))]
                  (or a-7 b-8)))
          (cond
            (and isOrdered (.-canceled this))
              (do (set! thisNodeSize 0) (set! result (.getEmptyResult this)))
            (and isOrdered (.-shortCircuited (cast TakeWhileTask (.-leftChild this))))
              (do
                (set! thisNodeSize (.-thisNodeSize (cast TakeWhileTask (.-leftChild this))))
                (set! result (cast Node (.getLocalResult (cast TakeWhileTask (.-leftChild this))))))
            :else
              (do
                (set! thisNodeSize
                      (unchecked-add (.-thisNodeSize (cast TakeWhileTask (.-leftChild this)))
                                     (.-thisNodeSize (cast TakeWhileTask (.-rightChild this)))))
                (set! result (.merge this))))
          (.setLocalResult this result)))

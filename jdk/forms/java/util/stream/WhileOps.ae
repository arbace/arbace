        (== (.-thisNodeSize (cast TakeWhileTask (.-leftChild this))) 0)
          (cast Node (.getLocalResult (cast TakeWhileTask (.-rightChild this))))
        (== (.-thisNodeSize (cast TakeWhileTask (.-rightChild this))) 0)
          (cast Node (.getLocalResult (cast TakeWhileTask (.-leftChild this))))
        :else
          (Nodes/conc (.getOutputShape op)
                      (cast Node (.getLocalResult (cast TakeWhileTask (.-leftChild this))))
                      (cast Node (.getLocalResult (cast TakeWhileTask (.-rightChild this)))))))


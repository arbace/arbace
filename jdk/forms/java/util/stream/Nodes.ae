  (defclass ^:private ^:abstract ^:static ToArrayTask
    :extends (CountedCompleter Void)
    :type-params [T (T_NODE extends (Node T)) (K extends (ToArrayTask T T_NODE K))]

    (field ^:protected ^:final ^T_NODE node)

    (field ^:protected ^:final ^int offset)

    (constructor [this ^T_NODE node ^int offset]
      (set! (.-node this) node)
      (set! (.-offset this) offset))

    (constructor [this ^K parent ^T_NODE node ^int offset]
      (super. parent)
      (set! (.-node this) node)
      (set! (.-offset this) offset))

    (method ^:abstract copyNodeToArray ^void [this])

    (method ^:abstract makeChild ^K [this ^int childIndex ^int offset])

    (method ^:public compute ^void [this]
      (let [^:mutable ^{:tag (ToArrayTask T T_NODE K)} task this]
        (while true
          (if (== (.getChildCount (.-node task)) 0)
              (do (.copyNodeToArray task) (.propagateCompletion task) (return))
              (do
                (.setPendingCount task (unchecked-subtract-int (.getChildCount (.-node task)) 1))
                (let [^:mutable size 0
                      ^:mutable ^int i 0]
                  (while (< i (unchecked-subtract-int (.getChildCount (.-node task)) 1))
                    (let [^K leftTask (.makeChild
                                        task
                                        i
                                        (unchecked-int (unchecked-add (.-offset task) size)))]
                      (set! size (unchecked-add size (.count (.-node leftTask))))
                      (.fork leftTask))
                    (set! i (unchecked-inc-int i)))
                  (set! task
                        (.makeChild task i (unchecked-int (unchecked-add (.-offset task) size))))))))))


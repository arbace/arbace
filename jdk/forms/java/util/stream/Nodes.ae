    :extends (AbstractTask P_IN P_OUT T_NODE (CollectorTask P_IN P_OUT T_NODE T_BUILDER))
    :type-params [P_IN P_OUT (T_NODE extends (Node P_OUT)) (T_BUILDER extends (Node$Builder P_OUT))]


                                                      id
                                                      TimeZone/LONG
                                                      inLocale)))
                                                type)
                                            type)]))))
      ret))

  (method ^:private ^:static formatList ^String [^String/1 stringList ^String pattern]
    (if (nil? pattern)
        (String/join "," stringList)
        (switch (alength stringList)
          0 ""
          1 (aget stringList 0)
          (cast String
                (.reduce (Arrays/stream stringList)
                         ""
                         (lambda BinaryOperator ^String [^String s1 ^String s2]
                           (cond
                             (.isEmpty s1) s2
                             (.isEmpty s2) s1
                             :else (MessageFormat/format pattern (new Object/1 [s1 s2])))))))))

  (method ^:private ^:static isUnicodeExtensionKey ^boolean [^String s]
    (and (== (.length s) 2) (LocaleUtils/isAlphaNumericString s)))

  (field ^:private ^:static ^:final ^ObjectStreamField/1 serialPersistentFields
    (new ObjectStreamField/1
         [(ObjectStreamField. "language" String)
          (ObjectStreamField. "country" String)
          (ObjectStreamField. "variant" String)
          (ObjectStreamField. "hashcode" Integer/TYPE)
          (ObjectStreamField. "script" String)
          (ObjectStreamField. "extensions" String)]))

  (method ^:private writeObject :throws [IOException] ^void [this ^ObjectOutputStream out]
    (let [fields (.putFields out)]
      (.put fields "language" (.getLanguage baseLocale))
      (.put fields "script" (.getScript baseLocale))
      (.put fields "country" (.getRegion baseLocale))
      (.put fields "variant" (.getVariant baseLocale))
      (.put fields "extensions" (if (nil? localeExtensions) "" ^Object (.getID localeExtensions)))
      (^[String int] ObjectOutputStream$PutField/.put fields "hashcode" -1)
      (.writeFields out)))

  (method ^:private readObject :throws [IOException ClassNotFoundException] ^void [this
                                                                                   ^ObjectInputStream in]
    (let [fields (.readFields in)
          language (cast String (.get fields "language" ""))
          script (cast String (.get fields "script" ""))
          country (cast String (.get fields "country" ""))
          variant (cast String (.get fields "variant" ""))
          extStr (cast String (.get fields "extensions" ""))]
      (set! baseLocale
            (BaseLocale/getInstance (Locale/convertOldISOCodes language) script country variant))
      (if (not (.isEmpty extStr))
          (try
            (let [bldr (InternalLocaleBuilder.)]
              (.setExtensions bldr extStr)
              (set! localeExtensions (.getLocaleExtensions bldr)))
            (catch LocaleSyntaxException e (throw (IllformedLocaleException. (.getMessage e)))))
          (set! localeExtensions nil))))

  (method ^:private readResolve :throws [ObjectStreamException] [this]
    (Locale/getInstance (.getLanguage baseLocale)
                        (.getScript baseLocale)
                        (.getRegion baseLocale)
                        (.getVariant baseLocale)
                        localeExtensions))

  (method ^:private ^:static convertOldISOCodes ^String [^String language]
    (BaseLocale/convertOldISOCodes (.intern (LocaleUtils/toLowerString language))))

  (method ^:private ^:static getCompatibilityExtensions ^LocaleExtensions [^String language
                                                                           ^String script
                                                                           ^String country
                                                                           ^String variant]
    (let [^:mutable ^LocaleExtensions extensions nil]
      (cond
        (and (and (and (LocaleUtils/caseIgnoreMatch language "ja") (.isEmpty script))
                  (LocaleUtils/caseIgnoreMatch country "jp"))
             (.equals "JP" variant))
          (set! extensions LocaleExtensions/CALENDAR_JAPANESE)
        (and (and (and (LocaleUtils/caseIgnoreMatch language "th") (.isEmpty script))
                  (LocaleUtils/caseIgnoreMatch country "th"))
             (.equals "TH" variant))
          (set! extensions LocaleExtensions/NUMBER_THAI))
      extensions))

  (defclass ^:private ^:static LocaleNameGetter
    :implements [(LocaleServiceProviderPool$LocalizedObjectGetter LocaleNameProvider String)]

    (field ^:private ^:static ^:final ^LocaleNameGetter INSTANCE (LocaleNameGetter.))

    (method ^:public getObject ^String [this ^LocaleNameProvider localeNameProvider ^Locale locale
                                        ^String key & ^Object/1 params]
      (java-assert (== (alength params) 3))
      (let [^int type (cast Integer (aget params 0))
            code (cast String (aget params 1))
            cat (cast String (aget params 2))]
        (switch type
          DISPLAY_LANGUAGE (return (.getDisplayLanguage localeNameProvider code locale))
          DISPLAY_COUNTRY (return (.getDisplayCountry localeNameProvider code locale))
          DISPLAY_VARIANT (return (.getDisplayVariant localeNameProvider code locale))
          DISPLAY_SCRIPT (return (.getDisplayScript localeNameProvider code locale))
          DISPLAY_UEXT_KEY (return (.getDisplayUnicodeExtensionKey localeNameProvider code locale))
          DISPLAY_UEXT_TYPE
            (return (.getDisplayUnicodeExtensionType localeNameProvider code cat locale))
          (java-assert false))
        nil)))

  (defclass ^:public ^:enum Category
    (constants
      (DISPLAY ["user.language.display" "user.script.display" "user.country.display"
                "user.variant.display" "user.extensions.display"])
      (FORMAT ["user.language.format" "user.script.format" "user.country.format"
               "user.variant.format" "user.extensions.format"]))

    (constructor [this ^String languageKey ^String scriptKey ^String countryKey ^String variantKey
                  ^String extensionsKey]
      (set! (.-languageKey this) languageKey)
      (set! (.-scriptKey this) scriptKey)
      (set! (.-countryKey this) countryKey)
      (set! (.-variantKey this) variantKey)
      (set! (.-extensionsKey this) extensionsKey))

    (field ^:final ^String languageKey)

    (field ^:final ^String scriptKey)

    (field ^:final ^String countryKey)

    (field ^:final ^String variantKey)

    (field ^:final ^String extensionsKey))

  (defclass ^:public ^:static ^:final Builder
    (field ^:private ^:final ^InternalLocaleBuilder localeBuilder)

    (constructor ^:public [this]
      (set! localeBuilder (InternalLocaleBuilder.)))

    (method ^:public setLocale ^Builder [this ^Locale locale]
      (try
        (.setLocale localeBuilder (.-baseLocale locale) (.-localeExtensions locale))
        (catch LocaleSyntaxException e
          (throw (IllformedLocaleException. (.getMessage e) (.getErrorIndex e)))))
      this)

    (method ^:public setLanguageTag ^Builder [this ^String languageTag]
      (if (LocaleUtils/isEmpty languageTag)
          (.clear localeBuilder)
          (let [tag (LanguageTag/parse languageTag (ParsePosition. 0) false)]
            (.setLanguageTag localeBuilder tag)))
      this)

    (method ^:public setLanguage ^Builder [this ^String language]
      (try
        (.setLanguage localeBuilder language)
        (catch LocaleSyntaxException e
          (throw (IllformedLocaleException. (.getMessage e) (.getErrorIndex e)))))
      this)

    (method ^:public setScript ^Builder [this ^String script]
      (try
        (.setScript localeBuilder script)
        (catch LocaleSyntaxException e
          (throw (IllformedLocaleException. (.getMessage e) (.getErrorIndex e)))))
      this)

    (method ^:public setRegion ^Builder [this ^String region]
      (try
        (.setRegion localeBuilder region)
        (catch LocaleSyntaxException e
          (throw (IllformedLocaleException. (.getMessage e) (.getErrorIndex e)))))
      this)

    (method ^:public setVariant ^Builder [this ^String variant]
      (try
        (.setVariant localeBuilder variant)
        (catch LocaleSyntaxException e
          (throw (IllformedLocaleException. (.getMessage e) (.getErrorIndex e)))))
      this)

    (method ^:public setExtension ^Builder [this ^char key ^String value]
      (try
        (.setExtension localeBuilder key value)
        (catch LocaleSyntaxException e
          (throw (IllformedLocaleException. (.getMessage e) (.getErrorIndex e)))))
      this)

    (method ^:public setUnicodeLocaleKeyword ^Builder [this ^String key ^String type]
      (try
        (.setUnicodeLocaleKeyword localeBuilder key type)
        (catch LocaleSyntaxException e
          (throw (IllformedLocaleException. (.getMessage e) (.getErrorIndex e)))))
      this)

    (method ^:public addUnicodeLocaleAttribute ^Builder [this ^String attribute]
      (try
        (.addUnicodeLocaleAttribute localeBuilder attribute)
        (catch LocaleSyntaxException e
          (throw (IllformedLocaleException. (.getMessage e) (.getErrorIndex e)))))
      this)

    (method ^:public removeUnicodeLocaleAttribute ^Builder [this ^String attribute]
      (Objects/requireNonNull attribute)
      (try
        (.removeUnicodeLocaleAttribute localeBuilder attribute)
        (catch LocaleSyntaxException e
          (throw (IllformedLocaleException. (.getMessage e) (.getErrorIndex e)))))
      this)

    (method ^:public clear ^Builder [this] (.clear localeBuilder) this)

    (method ^:public clearExtensions ^Builder [this]
      (.clearExtensions localeBuilder)
      this)

    (method ^:public build ^Locale [this]
      (let [baseloc (.getBaseLocale localeBuilder)
            ^:mutable extensions (.getLocaleExtensions localeBuilder)]
        (when (and (nil? extensions) (not (.isEmpty (.getVariant baseloc))))
          (set! extensions
                (Locale/getCompatibilityExtensions
                  (.getLanguage baseloc)
                  (.getScript baseloc)
                  (.getRegion baseloc)
                  (.getVariant baseloc))))
        (Locale/getInstance baseloc extensions))))

  (defclass ^:public ^:static ^:enum FilteringMode
    (constants
      AUTOSELECT_FILTERING
      EXTENDED_FILTERING
      IGNORE_EXTENDED_RANGES
      MAP_EXTENDED_RANGES
      REJECT_EXTENDED_RANGES))

  (defclass ^:public ^:static ^:final LanguageRange
    (field ^:public ^:static ^:final ^double MAX_WEIGHT 1.0)

    (field ^:public ^:static ^:final ^double MIN_WEIGHT 0.0)

    (field ^:private ^:final ^String range)

    (field ^:private ^:final ^double weight)

    (field ^:private ^{Stable true} ^int hash)

    (constructor ^:public [this ^String range] (this. range MAX_WEIGHT))

    (constructor ^:public [this ^:mutable ^String range ^double weight]
      (Objects/requireNonNull range)
      (when (or (< weight MIN_WEIGHT) (> weight MAX_WEIGHT))
        (throw (IllegalArgumentException. (java-str "weight=" weight))))
      (set! range (.toLowerCase range Locale/ROOT))
      (let [^:mutable isIllFormed false
            subtags (.split range "-")]
        (if (or (.endsWith range "-") (LanguageRange/isSubtagIllFormed (aget subtags 0) true))
            (set! isIllFormed true)
            (loop [^int i 1]
              (if (< i (alength subtags))
                  (if (LanguageRange/isSubtagIllFormed (aget subtags i) false)
                      (set! isIllFormed true)
                      (recur (unchecked-inc-int i)))
                  nil)))
        (when isIllFormed (throw (IllegalArgumentException. (java-str "range=" range))))
        (set! (.-range this) range)
        (set! (.-weight this) weight)))

    (method ^:private ^:static isSubtagIllFormed ^boolean [^String subtag ^boolean isFirstSubtag]
      (cond
        (or (.isEmpty subtag) (> (.length subtag) 8)) true
        (.equals subtag "*") false
        :else
          (let [charArray (.toCharArray subtag)]
            (if isFirstSubtag
                (for-each [^char c charArray] (when (or (< c \a) (> c \z)) (return true)))
                (for-each [^char c charArray]
                  (when (or (or (< c \0) (and (> c \9) (< c \a))) (> c \z)) (return true))))
            false)))

    (method ^:public getRange ^String [this] range)

    (method ^:public getWeight ^double [this] weight)

    (method ^:public ^:static parse ^{:tag (List LanguageRange)} [^String ranges]
      (LocaleMatcher/parse ranges))

    (method ^:public ^:static parse ^{:tag (List LanguageRange)} [^String ranges
                                                                  ^{:tag (Map String (List String))} map]
      (LanguageRange/mapEquivalents (LanguageRange/parse ranges) map))

    (method ^:public ^:static mapEquivalents ^{:tag (List LanguageRange)} [^{:tag (List LanguageRange)} priorityList
                                                                           ^{:tag (Map String (List String))} map]
      (LocaleMatcher/mapEquivalents priorityList map))

    (method ^:public hashCode ^int [this]
      (let [^:mutable h hash]
        (when (== h 0)
          (set! h 17)
          (set! h (unchecked-add-int (unchecked-multiply-int 37 h) (.hashCode range)))
          (set! h (unchecked-add-int (unchecked-multiply-int 37 h) (Double/hashCode weight)))
          (when-not (== h 0) (set! hash h)))
        h))

    (method ^:public equals ^boolean [this obj]
      (if (identical? this obj)
          true
          (if-instance [^LanguageRange other obj]
            (if (.equals range (.-range other)) (== weight (.-weight other)) false)
            false)))

    (method ^:public toString ^String [this]
      (if (== weight MAX_WEIGHT) range (java-str range ";q=" weight))))

  (method ^:public ^:static filter ^{:tag (List Locale)} [^{:tag (List LanguageRange)} priorityList
                                                          ^{:tag (Collection Locale)} locales
                                                          ^FilteringMode mode]
    (LocaleMatcher/filter priorityList locales mode))

  (method ^:public ^:static filter ^{:tag (List Locale)} [^{:tag (List LanguageRange)} priorityList
                                                          ^{:tag (Collection Locale)} locales]
    (Locale/filter priorityList locales FilteringMode/AUTOSELECT_FILTERING))

  (method ^:public ^:static filterTags ^{:tag (List String)} [^{:tag (List LanguageRange)} priorityList
                                                              ^{:tag (Collection String)} tags
                                                              ^FilteringMode mode]
    (LocaleMatcher/filterTags priorityList tags mode))

  (method ^:public ^:static filterTags ^{:tag (List String)} [^{:tag (List LanguageRange)} priorityList
                                                              ^{:tag (Collection String)} tags]
    (Locale/filterTags priorityList tags FilteringMode/AUTOSELECT_FILTERING))

  (method ^:public ^:static lookup ^Locale [^{:tag (List LanguageRange)} priorityList
                                            ^{:tag (Collection Locale)} locales]
    (LocaleMatcher/lookup priorityList locales))

  (method ^:public ^:static lookupTag ^String [^{:tag (List LanguageRange)} priorityList
                                               ^{:tag (Collection String)} tags]
    (LocaleMatcher/lookupTag priorityList tags)))

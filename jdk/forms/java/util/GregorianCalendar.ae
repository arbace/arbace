                  (set! timeOfDay
                        (unchecked-add timeOfDay (.internalGet this GregorianCalendar/MINUTE)))
                  (set! timeOfDay (unchecked-multiply timeOfDay 60))
                  (set! timeOfDay
                        (unchecked-add timeOfDay (.internalGet this GregorianCalendar/SECOND)))
                  (set! timeOfDay (unchecked-multiply timeOfDay 1000))
                  (set! timeOfDay
                        (unchecked-add timeOfDay (.internalGet this GregorianCalendar/MILLISECOND)))

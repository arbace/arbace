  (method ^:private isInvalidWeek1 ^boolean [this]
    (let [jan1 (GregorianCalendar/gregorianDays (.internalGet this GregorianCalendar/YEAR) 1 1)
          jan1Dow (GregorianCalendar/dayOfWeekOf jan1)
          ^int daysInFirstWeek (if (<= (.getFirstDayOfWeek this) jan1Dow)
                                   (unchecked-add-int
                                     (unchecked-subtract-int 7 jan1Dow)
                                     (.getFirstDayOfWeek this))
                                   (unchecked-subtract-int (.getFirstDayOfWeek this) jan1Dow))]
      (let [^int endDow (if (== (unchecked-subtract-int (.getFirstDayOfWeek this) 1) 0)
                            7
                            (unchecked-subtract-int (.getFirstDayOfWeek this) 1))]
        (and (>= daysInFirstWeek (.getMinimalDaysInFirstWeek this))
             (not (GregorianCalendar/dayInMinWeek
                    (.internalGet this GregorianCalendar/DAY_OF_WEEK)
                    jan1Dow
                    endDow))))))

  (method ^:private ^:static dayInMinWeek ^boolean [^int day ^int startDay ^int endDay]
    (if (>= endDay startDay)
        (and (>= day startDay) (<= day endDay))
        (or (>= day startDay) (<= day endDay))))

  (method ^:public isWeekDateSupported ^boolean [this] true)

  (method ^:public getWeekYear ^int [this]
    (let [^:mutable year (.get this GregorianCalendar/YEAR)]
      (when (== (.era this) BCE) (set! year (unchecked-subtract-int 1 year)))
      (if (> year (unchecked-add-int gregorianCutoverYear 1))
          (let [weekOfYear (.internalGet this GregorianCalendar/WEEK_OF_YEAR)]
            (cond
              (== (.internalGet this GregorianCalendar/MONTH) GregorianCalendar/JANUARY)
                (when (>= weekOfYear 52) (set! year (unchecked-dec-int year)))
              (== weekOfYear 1) (set! year (unchecked-inc-int year)))
            year)
          (let [dayOfYear (.internalGet this GregorianCalendar/DAY_OF_YEAR)
                maxDayOfYear (.getActualMaximum this GregorianCalendar/DAY_OF_YEAR)
                minimalDays (.getMinimalDaysInFirstWeek this)]
            (if (and (> dayOfYear minimalDays)
                     (< dayOfYear (unchecked-subtract-int maxDayOfYear 6)))
                year
                (let [cal (cast GregorianCalendar (.clone this))]
                  (.setLenient cal true)
                  (.setTimeZone cal (TimeZone/getTimeZone "GMT"))
                  (.set cal GregorianCalendar/DAY_OF_YEAR 1)
                  (.complete cal)
                  (let [^:mutable delta (unchecked-subtract-int
                                          (.getFirstDayOfWeek this)
                                          (.get cal GregorianCalendar/DAY_OF_WEEK))]
                    (when-not (== delta 0)
                      (when (< delta 0) (set! delta (unchecked-add-int delta 7)))
                      (.add cal GregorianCalendar/DAY_OF_YEAR delta))
                    (let [^:mutable minDayOfYear (.get cal GregorianCalendar/DAY_OF_YEAR)]
                      (if (< dayOfYear minDayOfYear)
                          (when (<= minDayOfYear minimalDays) (set! year (unchecked-dec-int year)))
                          (do
                            (.set cal GregorianCalendar/YEAR (unchecked-add-int year 1))
                            (.set cal GregorianCalendar/DAY_OF_YEAR 1)
                            (.complete cal)

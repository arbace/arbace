  (method ^:public getMinimum ^int [this ^int field]
    (aget MIN_VALUES field))

  (method ^:public getMaximum ^int [this ^int field]
    (aget MAX_VALUES field))

  (method ^:public getGreatestMinimum ^int [this ^int field]
    (aget MIN_VALUES field))

  (method ^:public getLeastMaximum ^int [this ^int field]
    (aget LEAST_MAX_VALUES field))

  (method ^:public getActualMinimum ^int [this ^int field]
    (.getMinimum this field))

  (method ^:public getActualMaximum ^int [this ^int field]
    (.complete this)
    (let [^long y (if (== (.internalGet this GregorianCalendar/ERA) BCE)
                      (unchecked-subtract-int 1 (.internalGet this GregorianCalendar/YEAR))
                      (.internalGet this GregorianCalendar/YEAR))]
      (switch field
        GregorianCalendar/DAY_OF_MONTH
          (.monthLength this (.internalGet this GregorianCalendar/MONTH) (unchecked-int y))
        GregorianCalendar/DAY_OF_YEAR
          (unchecked-int (unchecked-subtract (.jan1 this (unchecked-add y 1)) (.jan1 this y)))
        GregorianCalendar/WEEK_OF_MONTH
          (if (.isCutoverYear this y)
              (let [gc (cast GregorianCalendar (.clone this))
                    yy (.internalGet gc GregorianCalendar/YEAR)
                    mm (.internalGet gc GregorianCalendar/MONTH)
                    ^:mutable ^int value 0]
                (loop []
                  (set! value (.get gc GregorianCalendar/WEEK_OF_MONTH))
                  (.add gc GregorianCalendar/WEEK_OF_MONTH 1)
                  (when (and (== (.get gc GregorianCalendar/YEAR) yy)
                             (== (.get gc GregorianCalendar/MONTH) mm))
                    (recur)))
                value)
              (let [month (.internalGet this GregorianCalendar/MONTH)
                    ^:mutable ^long first 0
                    ^:mutable ^int monthLength 0]
                (if (== (.internalGet this GregorianCalendar/ERA) BCE)
                    (do
                      (set! first
                            (GregorianCalendar/julianFirst
                              (.internalGet this GregorianCalendar/YEAR)
                              month))
                      (set! monthLength
                            (unchecked-int
                              (unchecked-subtract
                                (GregorianCalendar/julianFirst
                                  (.internalGet this GregorianCalendar/YEAR)
                                  (unchecked-add-int month 1))
                                first))))
                    (do
                      (set! first (.fixedDate this y month 1))
                      (set! monthLength
                            (unchecked-int
                              (unchecked-subtract
                                (.fixedDate this y (unchecked-add-int month 1) 1)
                                first)))))
                (let [^:mutable dayOfWeek (unchecked-subtract-int
                                            (GregorianCalendar/dayOfWeekOf first)
                                            (.getFirstDayOfWeek this))]
                  (when (< dayOfWeek 0) (set! dayOfWeek (unchecked-add-int dayOfWeek 7)))
                  (let [nDaysFirstWeek (unchecked-subtract-int 7 dayOfWeek)
                        ^:mutable ^int value 3]
                    (when (>= nDaysFirstWeek (.getMinimalDaysInFirstWeek this))
                      (set! value (unchecked-inc-int value)))
                    (set! monthLength
                          (unchecked-subtract-int
                            monthLength
                            (unchecked-add-int nDaysFirstWeek (unchecked-multiply-int 7 3))))
                    (when (> monthLength 0)
                      (set! value (unchecked-inc-int value))
                      (when (> monthLength 7) (set! value (unchecked-inc-int value))))
                    value))))
        GregorianCalendar/WEEK_OF_YEAR
          (if (.isCutoverYear this y)
              (let [gc (cast GregorianCalendar (.clone this))
                    maxDayOfYear (.getActualMaximum this GregorianCalendar/DAY_OF_YEAR)]
                (.set gc GregorianCalendar/DAY_OF_YEAR maxDayOfYear)
                (let [^:mutable value (.get gc GregorianCalendar/WEEK_OF_YEAR)]
                  (when (and (== (.get gc GregorianCalendar/MONTH) GregorianCalendar/DECEMBER)
                             (== value 1))
                    (.set gc GregorianCalendar/DAY_OF_YEAR (unchecked-subtract-int maxDayOfYear 7))
                    (set! value (.get gc GregorianCalendar/WEEK_OF_YEAR)))
                  value))
              (let [jan1 (if (== (.internalGet this GregorianCalendar/ERA) BCE)
                             (GregorianCalendar/julianFirst
                               (.internalGet this GregorianCalendar/YEAR)
                               GregorianCalendar/JANUARY)
                             (.jan1 this y))
                    ^:mutable dayOfWeek (unchecked-subtract-int
                                          (GregorianCalendar/dayOfWeekOf jan1)
                                          (.getFirstDayOfWeek this))]
                (when (< dayOfWeek 0) (set! dayOfWeek (unchecked-add-int dayOfWeek 7)))
                (let [^:mutable ^int value 52
                      magic (unchecked-subtract-int
                              (unchecked-add-int dayOfWeek (.getMinimalDaysInFirstWeek this))
                              1)]
                  (when (or (== magic 6)
                            (and (.isLeapYear this (unchecked-int y))
                                 (or (== magic 5) (== magic 12))))
                    (set! value (unchecked-inc-int value)))
                  value)))
        GregorianCalendar/DAY_OF_WEEK_IN_MONTH
          (let [first (.fixedDate this y (.internalGet this GregorianCalendar/MONTH) 1)
                ^:mutable ndays (unchecked-int
                                  (unchecked-subtract
                                    (.fixedDate this
                                                y
                                                (unchecked-add-int
                                                  (.internalGet this GregorianCalendar/MONTH)
                                                  1)
                                                1)
                                    first))
                ^:mutable x (unchecked-subtract-int
                              (.internalGet this GregorianCalendar/DAY_OF_WEEK)
                              (GregorianCalendar/dayOfWeekOf first))]
            (when (< x 0) (set! x (unchecked-add-int x 7)))
            (set! ndays (unchecked-subtract-int ndays x))
            (unchecked-divide-int (unchecked-add-int ndays 6) 7))
        GregorianCalendar/YEAR
          (if (== (.internalGet this GregorianCalendar/ERA) BCE) 292269055 292278994)
        (.getMaximum this field))))

  (method ^:public getCalendarType ^String [this] "gregory")

  (method ^:public equals ^boolean [this obj]
    (and (and (instance? GregorianCalendar obj) (.equals super obj))
         (== gregorianCutover (.-gregorianCutover (cast GregorianCalendar obj)))))

  (method ^:public hashCode ^int [this]
    (bit-xor-int (.hashCode super) (unchecked-int (unchecked-add gregorianCutoverDay 719163))))

  (method ^:public clone [this] (.clone super))

  (method ^:public getTimeZone ^TimeZone [this] (.getTimeZone super))

  (method ^:public setTimeZone ^void [this ^TimeZone zone]
    (.setTimeZone super zone))

  (method ^:public ^:final toZonedDateTime ^ZonedDateTime [this]
    (ZonedDateTime/ofInstant (Instant/ofEpochMilli (.getTimeInMillis this))
                             (.toZoneId (.getTimeZone this))))

  (method ^:public ^:static from ^GregorianCalendar [^ZonedDateTime zdt]
    (let [cal (GregorianCalendar. (TimeZone/getTimeZone (.getZone zdt)))]
      (.setGregorianChange cal (Date. Long/MIN_VALUE))
      (.setFirstDayOfWeek cal GregorianCalendar/MONDAY)
      (.setMinimalDaysInFirstWeek cal 4)
      (try
        (.setTimeInMillis cal
                          (Math/addExact (^[long int] Math/multiplyExact (.toEpochSecond zdt) 1000)
                                         (.get zdt ChronoField/MILLI_OF_SECOND)))
        (catch ArithmeticException ex (throw (IllegalArgumentException. ex))))
      cal)))

          (set! monthLen (.monthLength this (.internalGet this GregorianCalendar/MONTH)))
          (let [gc (cast GregorianCalendar (.clone this))]
            (.setLenient gc true)
            (set! monthLen (.getActualMaximum gc GregorianCalendar/DAY_OF_MONTH))))
      (let [dom (.internalGet this GregorianCalendar/DAY_OF_MONTH)]
        (when (> dom monthLen) (.set this GregorianCalendar/DAY_OF_MONTH monthLen)))))

  (method ^:public add ^void [this ^int field ^int amount]
    (when-not (== amount 0)
      (when (or (< field 0) (>= field GregorianCalendar/ZONE_OFFSET))
        (throw (IllegalArgumentException.)))
      (.complete this)
      (cond
        (== field GregorianCalendar/YEAR)
          (let [year (.internalGet this GregorianCalendar/YEAR)]
            (if (== (.era this) CE)
                (.setYearOfEra this (unchecked-add-int year amount) true)
                (.setYearOfEra this (unchecked-subtract-int year amount) false))
            (.pinDayOfMonth this))

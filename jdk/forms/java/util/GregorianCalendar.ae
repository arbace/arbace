  (method ^:private era ^int [this]
    (if (.isSet this GregorianCalendar/ERA) (.internalGet this GregorianCalendar/ERA) CE))

  (method ^:private monthLength ^int [this ^int month]
    (let [^:mutable year (.internalGet this GregorianCalendar/YEAR)]
      (when (== (.era this) BCE) (set! year (unchecked-subtract-int 1 year)))
      (.monthLength this month year)))

  (method ^:private setYearOfEra ^void [this ^int year ^boolean ce]

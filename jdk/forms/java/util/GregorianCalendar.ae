                              (.getMinimalDaysInFirstWeek this))
                      (set! firstDayOfWeek (unchecked-subtract firstDayOfWeek 7)))
                    (when (GregorianCalendar/isFieldSet fieldMask GregorianCalendar/DAY_OF_WEEK)
                      (let [dayOfWeek (.internalGet this GregorianCalendar/DAY_OF_WEEK)]
                        (when-not (== dayOfWeek (.getFirstDayOfWeek this))

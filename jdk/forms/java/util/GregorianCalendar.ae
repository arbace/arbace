                            (GregorianCalendar/getRolledValue woy amount min max)
                            1))
                    (let [d (.ymd this (unchecked-add day1 (unchecked-multiply value 7)))]
                      (.set this
                            GregorianCalendar/MONTH
                            (unchecked-subtract-int (unchecked-int (aget d 1)) 1))
                      (.set this GregorianCalendar/DAY_OF_MONTH (unchecked-int (aget d 2)))
                      (return)))))
            GregorianCalendar/WEEK_OF_MONTH
              (let [cutover (.isCutoverYear this ny)
                    ^:mutable dow (unchecked-subtract-int
                                    (.internalGet this GregorianCalendar/DAY_OF_WEEK)
                                    (.getFirstDayOfWeek this))]

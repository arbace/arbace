                  (set! month (unchecked-remainder-int month 12))
                  (when (< month 0) (set! month (unchecked-add-int month 12)))
                  (.set this
                        GregorianCalendar/MONTH
                        (unchecked-add-int GregorianCalendar/JANUARY month))))

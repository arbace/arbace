  (method ^:private currentDay ^long [this]
    (Math/floorDiv
      (unchecked-add (unchecked-add (.-time this) (.internalGet this GregorianCalendar/ZONE_OFFSET))
                     (.internalGet this GregorianCalendar/DST_OFFSET))
      ONE_DAY))

  (method ^:private ^:static getRolledValue ^int [^int value ^:mutable ^int amount ^int min ^int max]
    (java-assert (and (>= value min) (<= value max)))
    (let [range (unchecked-add-int (unchecked-subtract-int max min) 1)]
      (set! amount (unchecked-remainder-int amount range))

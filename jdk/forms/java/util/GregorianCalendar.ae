          (switch field
            (GregorianCalendar/AM_PM GregorianCalendar/ERA
                                     GregorianCalendar/YEAR
                                     GregorianCalendar/MINUTE
                                     GregorianCalendar/SECOND
                                     GregorianCalendar/MILLISECOND)

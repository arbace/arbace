                                (unchecked-subtract (unchecked-add fixedDate lastDate) 1)
                                dayOfWeek))))))
            (do
              (when (and (and (and (== year gregorianCutoverYear) gregorian)
                              (< fixedDate gregorianCutoverDay))
                         (not (== gregorianCutoverYear gregorianCutoverYearJulian)))
                (set! fixedDate gregorianCutoverDay))
              (if (GregorianCalendar/isFieldSet fieldMask GregorianCalendar/DAY_OF_YEAR)
                  (do
                    (set! fixedDate
                          (unchecked-add fixedDate
                                         (.internalGet this GregorianCalendar/DAY_OF_YEAR)))
                    (set! fixedDate (unchecked-dec fixedDate)))
                  (let [^:mutable firstDayOfWeek (GregorianCalendar/dayOfWeekOnOrBefore
                                                   (unchecked-add fixedDate 6)
                                                   (.getFirstDayOfWeek this))]

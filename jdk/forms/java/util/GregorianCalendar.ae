                                                  (.getFirstDayOfWeek this)
                                                  (.get cal GregorianCalendar/DAY_OF_WEEK))]
                              (when-not (== del 0)
                                (when (< del 0) (set! del (unchecked-add-int del 7)))
                                (.add cal GregorianCalendar/DAY_OF_YEAR del))
                              (set! minDayOfYear
                                    (unchecked-subtract-int
                                      (.get cal GregorianCalendar/DAY_OF_YEAR)
                                      1))
                              (when (== minDayOfYear 0) (set! minDayOfYear 7))

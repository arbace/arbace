                      (let [monthLen (.monthLength this mon)]
                        (when (> (.internalGet this GregorianCalendar/DAY_OF_MONTH) monthLen)
                          (.set this GregorianCalendar/DAY_OF_MONTH monthLen))))
                    (let [^int yearLength 12
                          ^:mutable mon (unchecked-remainder-int
                                          (unchecked-add-int
                                            (.internalGet this GregorianCalendar/MONTH)
                                            amount)
                                          yearLength)]

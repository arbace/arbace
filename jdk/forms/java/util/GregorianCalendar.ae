                      month1 (.month1 this fd)
                      monthLength (.actualMonthLength this month1)
                      ^:mutable monthDay1st (GregorianCalendar/dayOfWeekOnOrBefore
                                              (unchecked-add month1 6)
                                              (.getFirstDayOfWeek this))]
                  (when (>= (unchecked-int (unchecked-subtract monthDay1st month1))
                            (.getMinimalDaysInFirstWeek this))
                    (set! monthDay1st (unchecked-subtract monthDay1st 7)))
                  (set! max (.getActualMaximum this field))
                  (let [value (unchecked-subtract-int
                                (GregorianCalendar/getRolledValue
                                  (.internalGet this field)
                                  amount
                                  1
                                  max)
                                1)
                        ^:mutable nfd (unchecked-add
                                        (unchecked-add monthDay1st (unchecked-multiply value 7))
                                        dow)]
                    (cond
                      (< nfd month1) (set! nfd month1)
                      (>= nfd (unchecked-add month1 monthLength))
                        (set! nfd (unchecked-subtract (unchecked-add month1 monthLength) 1)))
                    (let [^int dayOfMonth (if cutover
                                              (unchecked-int (aget (.ymd this nfd) 2))
                                              (unchecked-add-int
                                                (unchecked-int (unchecked-subtract nfd month1))
                                                1))]
                      (.set this GregorianCalendar/DAY_OF_MONTH dayOfMonth)
                      (return)))))
            GregorianCalendar/DAY_OF_MONTH
              (if (not (.isCutoverYear this ny))
                  (set! max (.monthLength this (.internalGet this GregorianCalendar/MONTH)))
                  (let [fd (.currentDay this)
                        month1 (.month1 this fd)
                        value (GregorianCalendar/getRolledValue
                                (unchecked-int (unchecked-subtract fd month1))
                                amount
                                0
                                (unchecked-subtract-int (.actualMonthLength this month1) 1))]
                    (.set this
                          GregorianCalendar/DAY_OF_MONTH
                          (unchecked-int (aget (.ymd this (unchecked-add month1 value)) 2)))
                    (return)))
            GregorianCalendar/DAY_OF_YEAR
              (do
                (set! max (.getActualMaximum this field))
                (when-not (not (.isCutoverYear this ny))
                  (let [fd (.currentDay this)
                        jan1 (unchecked-add
                               (unchecked-subtract
                                 fd
                                 (.internalGet this GregorianCalendar/DAY_OF_YEAR))
                               1)
                        value (GregorianCalendar/getRolledValue
                                (unchecked-add-int (unchecked-int (unchecked-subtract fd jan1)) 1)
                                amount
                                min
                                max)
                        d (.ymd this (unchecked-subtract (unchecked-add jan1 value) 1))]
                    (.set this
                          GregorianCalendar/MONTH
                          (unchecked-subtract-int (unchecked-int (aget d 1)) 1))
                    (.set this GregorianCalendar/DAY_OF_MONTH (unchecked-int (aget d 2)))
                    (return))))
            GregorianCalendar/DAY_OF_WEEK
              (do
                (when-not (.isCutoverYear this ny)

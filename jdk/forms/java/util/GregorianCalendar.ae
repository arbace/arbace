          (> n max) (set! n (unchecked-subtract-int n range))
          (< n min) (set! n (unchecked-add-int n range)))
        (java-assert (and (>= n min) (<= n max)))
        n)))

  (method ^:private month1 ^long [this ^long fd]
    (let [dom (.internalGet this GregorianCalendar/DAY_OF_MONTH)
          ^long y (if (== (.era this) BCE)
                      (unchecked-subtract-int 1 (.internalGet this GregorianCalendar/YEAR))
                      (.internalGet this GregorianCalendar/YEAR))]
      (if (.isCutoverYear this y)
          (.fixedDate this y (.internalGet this GregorianCalendar/MONTH) 1)
          (unchecked-add (unchecked-subtract fd dom) 1))))

  (method ^:private actualMonthLength ^int [this ^long month1]
    (let [^long y (if (== (.era this) BCE)
                      (unchecked-subtract-int 1 (.internalGet this GregorianCalendar/YEAR))
                      (.internalGet this GregorianCalendar/YEAR))]
      (unchecked-int
        (unchecked-subtract
          (.fixedDate this y (unchecked-add-int (.internalGet this GregorianCalendar/MONTH) 1) 1)
          month1))))

  (method ^:public roll ^void [this ^int field ^boolean up]
    (.roll this field (if up 1 -1)))

  (method ^:public roll ^void [this ^int field ^:mutable ^int amount]
    (when-not (== amount 0)
      (when (or (< field 0) (>= field GregorianCalendar/ZONE_OFFSET))
        (throw (IllegalArgumentException.)))
      (.complete this)
      (let [^:mutable min (.getMinimum this field)
            ^:mutable max (.getMaximum this field)
            ^long ny (if (== (.era this) BCE)
                         (unchecked-subtract-int 1 (.internalGet this GregorianCalendar/YEAR))
                         (.internalGet this GregorianCalendar/YEAR))]

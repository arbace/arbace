    (method ^:public forEach ^void [this ^{:tag (BiConsumer (? super K) (? super V))} action]
      (when (nil? action) (throw (NullPointerException.)))
      (let [mc (.-modCount base)]
        (loop [^{:tag (Entry K V)} e (.-tail base)]
          (when (some? e) (.accept action (.-key e) (.-value e)) (recur (.-before e))))
        (when-not (== (.-modCount base) mc) (throw (ConcurrentModificationException.)))))

    (method ^:public replaceAll ^void [this
                                       ^{:tag (BiFunction (? super K) (? super V) (? extends V))} function]
      (when (nil? function) (throw (NullPointerException.)))
      (let [mc (.-modCount base)]
        (loop [^{:tag (Entry K V)} e (.-tail base)]
          (when (some? e)
            (set! (.-value e) (.apply function (.-key e) (.-value e)))
            (recur (.-before e))))
        (when-not (== (.-modCount base) mc) (throw (ConcurrentModificationException.)))))

    (method ^:public putIfAbsent ^V [this ^K key ^V value]
      (.putIfAbsent base key value))

    (method ^:public remove ^boolean [this key value]
      (.remove base key value))

    (method ^:public replace ^boolean [this ^K key ^V oldValue ^V newValue]
      (.replace base key oldValue newValue))

    (method ^:public replace ^V [this ^K key ^V value]
      (.replace base key value))

    (method ^:public computeIfAbsent ^V [this ^K key
                                         ^{:tag (Function (? super K) (? extends V))} mappingFunction]
      (.computeIfAbsent base key mappingFunction))

    (method ^:public computeIfPresent ^V [this ^K key
                                          ^{:tag (BiFunction (? super K) (? super V) (? extends V))} remappingFunction]
      (.computeIfPresent base key remappingFunction))

    (method ^:public compute ^V [this ^K key
                                 ^{:tag (BiFunction (? super K) (? super V) (? extends V))} remappingFunction]
      (.compute base key remappingFunction))

    (method ^:public merge ^V [this ^K key ^V value
                               ^{:tag (BiFunction (? super V) (? super V) (? extends V))} remappingFunction]
      (.merge base key value remappingFunction))

    (method ^:public reversed ^{:tag (SequencedMap K V)} [this] base)

    (method ^:public firstEntry ^{:tag (Map$Entry K V)} [this]
      (.lastEntry base))

    (method ^:public lastEntry ^{:tag (Map$Entry K V)} [this]
      (.firstEntry base))

    (method ^:public pollFirstEntry ^{:tag (Map$Entry K V)} [this]
      (.pollLastEntry base))

    (method ^:public pollLastEntry ^{:tag (Map$Entry K V)} [this]
      (.pollFirstEntry base))

    (method ^:public putFirst ^V [this ^K k ^V v] (.putLast base k v))

    (method ^:public putLast ^V [this ^K k ^V v] (.putFirst base k v))))

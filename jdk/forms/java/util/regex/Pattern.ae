    (let [i cursor ch (aget temp (unchecked-add-int i 1))] (set! cursor (unchecked-add-int i 2)) ch))

  (method ^:private unread ^void [this]
    (set! cursor (unchecked-dec-int cursor)))

  (method ^:private error ^PatternSyntaxException [this ^String s]
    (PatternSyntaxException. s normalizedPattern (unchecked-subtract-int cursor 1)))

  (method ^:private findSupplementary ^boolean [this ^int start ^int end]
    (loop [^int i start]
      (if (< i end)
          (if (Pattern/isSupplementary (aget temp i)) (return true) (recur (unchecked-inc-int i)))
          nil))
    false)

  (method ^:private ^:static ^:final isSupplementary ^boolean [^int ch]
    (or (>= ch Character/MIN_SUPPLEMENTARY_CODE_POINT) (Character/isSurrogate (unchecked-char ch))))

  (method ^:private expr ^Node [this ^Node end]
    (let [^:mutable ^Node prev nil
          ^:mutable ^Node firstTail nil
          ^:mutable ^Branch branch nil
          ^:mutable ^Node branchConn nil]
      (while true
        (let [^:mutable node (.sequence this end)
              nodeTail root]
          (if (nil? prev)
              (do (set! prev node) (set! firstTail nodeTail))
              (do
                (when (nil? branchConn)
                  (set! branchConn (BranchConn.))
                  (set! (.-next branchConn) end))
                (if (identical? node end) (set! node nil) (set! (.-next nodeTail) branchConn))
                (if (identical? prev branch)
                    (.add branch node)
                    (do
                      (if (identical? prev end)
                          (set! prev nil)
                          (set! (.-next firstTail) branchConn))
                      (set! prev (set! branch (Branch. prev node branchConn)))))))
          (when-not (== (.peek this) \|) (return prev))
          (.next this)))))

  (method ^:private sequence ^Node [this ^Node end]
    (let [^:mutable ^Node head nil
          ^:mutable ^Node tail nil
          ^:mutable ^Node node nil]

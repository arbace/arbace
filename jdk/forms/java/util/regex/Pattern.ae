                          (if (nil? right)
                              (throw (.error this "Bad class syntax"))
                              (set! prev right))
                          (do
                            (when (nil? curr) (throw (.error this "Bad intersection syntax")))
                            (set! prev (.and prev curr)))))
                    (continue))
                  (.unread this)))
          0 (when (>= cursor patternLength) (throw (.error this "Unclosed character class")))
          \]
            (when (or (some? prev) hasBits)
              (when consume (.next this))
              (arbace.core/cond (nil? prev) (set! prev bits) hasBits (set! prev (.union prev bits)))
              (when isNeg (return (.negate prev)))
              (return prev))
          nil)
        (set! curr (.range this bits))
        (arbace.core/cond (nil? curr)
                          (set! hasBits true)
                          (nil? prev)
                          (set! prev curr)
                          :else
                          (when-not (identical? prev curr) (set! prev (.union prev curr))))
        (set! ch (.peek this)))))

  (method ^:private bitsOrSingle ^CharPredicate [this ^BitClass bits ^int ch]
    (if (and (< ch 256)
             (not (and (and (.has this CASE_INSENSITIVE) (.has this UNICODE_CASE))
                       (or (or (or (or (or (or (or
                                                 (or
                                                   (or (or (== ch 0xff) (== ch 0xb5)) (== ch 0x49))
                                                   (== ch 0x69))
                                                 (== ch 0x53))
                                               (== ch 0x73))
                                           (== ch 0x4b))
                                       (== ch 0x6b))
                                   (== ch 0xc5))
                               (== ch 0xe5))
                           (== ch 0xdf)))))
        (do (.add bits ch flags0) nil)
        (.single this ch)))

  (method ^:private single ^CharPredicate [this ^:final ^int ch]
    (when (.has this CASE_INSENSITIVE)
      (let [^:mutable ^int lower 0
            ^:mutable ^int upper 0]
        (if (.has this UNICODE_CASE)
            (do
              (set! upper (Character/toUpperCase ch))
              (set! lower (Character/toLowerCase upper))
              (when (or (not (== upper lower)) (== ch 0xDF)) (return (Pattern/SingleU lower))))
            (when (ASCII/isAscii ch)
              (set! lower (ASCII/toLower ch))
              (set! upper (ASCII/toUpper ch))
              (when-not (== lower upper) (return (Pattern/SingleI lower upper)))))))
    (if (Pattern/isSupplementary ch) (Pattern/SingleS ch) (Pattern/Single ch)))

  (method ^:private range ^CharPredicate [this ^BitClass bits]
    (let [^:mutable ch (.peek this)]
      (if (== ch \\)
          (do
            (set! ch (.nextEscaped this))
            (if (or (== ch \p) (== ch \P))
                (let [comp (== ch \P)
                      ^:mutable oneLetter true]
                  (set! ch (.next this))
                  (if (not (== ch \{)) (.unread this) (set! oneLetter false))
                  (return (.family this oneLetter comp)))
                (let [isrange (== (aget temp (unchecked-add-int cursor 1)) \-)]
                  (.unread this)
                  (set! ch (.escape this true true isrange))
                  (when (== ch -1) (return predicate)))))
          (.next this))
      (if (>= ch 0)
          (do
            (when (== (.peek this) \-)
              (let [endRange (aget temp (unchecked-add-int cursor 1))]
                (when (== endRange \[) (return (.bitsOrSingle this bits ch)))
                (when-not (== endRange \])
                  (.next this)
                  (let [^:mutable m (.peek this)]
                    (if (== m \\) (set! m (.escape this true false true)) (.next this))
                    (when (< m ch) (throw (.error this "Illegal character range")))
                    (if (.has this CASE_INSENSITIVE)
                        (do
                          (when (.has this UNICODE_CASE) (return (Pattern/CIRangeU ch m)))
                          (return (Pattern/CIRange ch m)))
                        (return (Pattern/Range ch m)))))))
            (.bitsOrSingle this bits ch))
          (throw (.error this (java-str "Unexpected character '" (unchecked-char ch) "'"))))))

  (method ^:private family ^CharPredicate [this ^boolean singleLetter ^boolean isComplement]
    (.next this)
    (let [^:mutable ^String name nil
          ^:mutable ^CharPredicate p nil]
      (if singleLetter
          (let [c (aget temp cursor)]
            (if (not (Character/isSupplementaryCodePoint c))
                (set! name (String/valueOf (unchecked-char c)))
                (set! name (String. temp cursor 1)))
            (.read this))
          (let [i cursor]
            (.mark this \})
            (while (not (== (.read this) \})))
            (.mark this \u0000)
            (let [j cursor]
              (when (> j patternLength) (throw (.error this "Unclosed character family")))
              (when (>= (unchecked-add-int i 1) j) (throw (.error this "Empty character family")))
              (set! name (String. temp i (unchecked-subtract-int (unchecked-subtract-int j i) 1))))))
      (let [i (.indexOf name \=)]
        (if (not (== i -1))
            (let [value (.substring name (unchecked-add-int i 1))]
              (set! name (.toLowerCase (.substring name 0 i) Locale/ENGLISH))
              (switch name
                ("sc" "script") (set! p (CharPredicates/forUnicodeScript value))
                ("blk" "block") (set! p (CharPredicates/forUnicodeBlock value))
                ("gc" "general_category")
                  (set! p (CharPredicates/forProperty value (.has this CASE_INSENSITIVE)))
                nil)
              (when (nil? p)
                (throw (.error this
                               (java-str "Unknown Unicode property {name=<"
                                         name
                                         ">, value=<"
                                         value
                                         ">}")))))
            (do
              (arbace.core/cond (.startsWith name "In")
                                (set! p (CharPredicates/forUnicodeBlock (.substring name 2)))
                                (.startsWith name "Is")
                                (let [shortName (.substring name 2)]
                                  (set! p
                                        (CharPredicates/forUnicodeProperty
                                          shortName
                                          (.has this CASE_INSENSITIVE)))
                                  (when (nil? p)
                                    (set! p
                                          (CharPredicates/forProperty
                                            shortName
                                            (.has this CASE_INSENSITIVE))))
                                  (when (nil? p)
                                    (set! p (CharPredicates/forUnicodeScript shortName))))
                                :else
                                (do
                                  (when (.has this UNICODE_CHARACTER_CLASS)
                                    (set! p
                                          (CharPredicates/forPOSIXName
                                            name
                                            (.has this CASE_INSENSITIVE))))
                                  (when (nil? p)
                                    (set! p
                                          (CharPredicates/forProperty
                                            name
                                            (.has this CASE_INSENSITIVE))))))
              (when (nil? p)
                (throw (.error this (java-str "Unknown character property name {" name "}"))))))
        (when isComplement (set! hasSupplementary true) (set! p (.negate p)))
        p)))

  (method ^:private newCharProperty ^CharProperty [this ^CharPredicate p]
    (when (some? p)
      (if (instance? BmpCharPredicate p)
          (BmpCharProperty. (cast BmpCharPredicate p))
          (do (set! hasSupplementary true) (CharProperty. p)))))

  (method ^:private groupname ^String [this ^:mutable ^int ch]
    (let [sb (StringBuilder.)]
      (when-not (ASCII/isAlpha ch)
        (throw (.error this "capturing group name does not start with a Latin letter")))
      (loop []
        (.append sb (unchecked-char ch))
        (when (ASCII/isAlnum (set! ch (.read this))) (recur)))
      (when-not (== ch \>) (throw (.error this "named capturing group is missing trailing '>'")))
      (.toString sb)))

  (method ^:private group0 ^Node [this]
    (let [^:mutable capturingGroup false
          ^:mutable ^Node head nil
          ^:mutable ^Node tail nil
          save flags0
          saveTCNCount (.size topClosureNodes)]
      (set! root nil)
      (let [^:mutable ch (.next this)]
        (if (== ch \?)
            (do
              (set! ch (.skip this))
              (switch ch
                \:
                  (do
                    (set! head (.createGroup this true))
                    (set! tail root)
                    (set! (.-next head) (.expr this tail)))
                (\= \!)
                  (do
                    (set! head (.createGroup this true))
                    (set! tail root)
                    (set! (.-next head) (.expr this tail))
                    (if (== ch \=)
                        (set! head (set! tail (Pos. head)))
                        (set! head (set! tail (Neg. head)))))
                \>
                  (do
                    (set! head (.createGroup this true))
                    (set! tail root)
                    (set! (.-next head) (.expr this tail))
                    (set! head (set! tail (Ques. head Qtype/INDEPENDENT))))
                \<
                  (do
                    (set! ch (.read this))
                    (if (and (not (== ch \=)) (not (== ch \!)))
                        (let [name (.groupname this ch)]
                          (when (.containsKey (.namedGroupsMap this) name)
                            (throw (.error this
                                           (java-str
                                             "Named capturing group <"
                                             name
                                             "> is already defined"))))
                          (set! capturingGroup true)
                          (set! head (.createGroup this false))
                          (set! tail root)
                          (.put (.namedGroupsMap this)
                                name
                                (unchecked-subtract-int capturingGroupCount 1))
                          (set! (.-next head) (.expr this tail)))
                        (let [start cursor]
                          (set! head (.createGroup this true))
                          (set! tail root)
                          (set! (.-next head) (.expr this tail))
                          (set! (.-next tail) LookBehindEndNode/INSTANCE)
                          (let [info (TreeInfo.)]
                            (.study head info)
                            (when (= (.-maxValid info) false)
                              (throw (.error
                                       this
                                       "Look-behind group does not have an obvious maximum length")))
                            (let [hasSupplementary (.findSupplementary this start patternLength)]
                              (if (== ch \=)
                                  (set! head
                                        (set! tail
                                              (if hasSupplementary
                                                  ^Node (BehindS.
                                                          head
                                                          (.-maxLength info)
                                                          (.-minLength info))
                                                  ^Node (Behind.
                                                          head
                                                          (.-maxLength info)
                                                          (.-minLength info)))))
                                  (set! head
                                        (set! tail
                                              (if hasSupplementary
                                                  ^Node (NotBehindS.
                                                          head
                                                          (.-maxLength info)
                                                          (.-minLength info))
                                                  ^Node (NotBehind.
                                                          head
                                                          (.-maxLength info)
                                                          (.-minLength info))))))

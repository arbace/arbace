                                        (aget (.-optoSft this) x))]
                        (set! i (unchecked-add-int i (Pattern/countChars seq i n)))
                        (continue :NEXT))
                      (recur (unchecked-subtract-int j (Character/charCount ch))
                             (unchecked-dec-int x)))))
              (set! (.-first matcher) i)
              (let [ret (.match (.-next this) matcher (unchecked-add-int i lengthInChars) seq)]
                (when ret
                  (set! (.-first matcher) i)
                  (aset (.-groups matcher) 0 (.-first matcher))
                  (aset (.-groups matcher) 1 (.-last matcher))
                  (return true))
                (set! i (unchecked-add-int i (Pattern/countChars seq i 1)))))))
        (set! (.-hitEnd matcher) true)
        false)))

  (method ^:private ^:static and ^CharPredicate [^CharPredicate p1 ^CharPredicate p2
                                                 ^boolean bmpChar]
    (if bmpChar
        (lambda BmpCharPredicate ^boolean [^int ch] (and (.is p1 ch) (.is p2 ch)))
        (lambda CharPredicate ^boolean [^int ch] (and (.is p1 ch) (.is p2 ch)))))

  (method ^:private ^:static union ^CharPredicate [^CharPredicate p1 ^CharPredicate p2
                                                   ^boolean bmpChar]
    (if bmpChar
        (lambda BmpCharPredicate ^boolean [^int ch] (or (.is p1 ch) (.is p2 ch)))
        (lambda CharPredicate ^boolean [^int ch] (or (.is p1 ch) (.is p2 ch)))))

  (method ^:private ^:static union ^CharPredicate [^CharPredicate p1 ^CharPredicate p2
                                                   ^CharPredicate p3 ^boolean bmpChar]
    (if bmpChar
        (lambda BmpCharPredicate ^boolean [^int ch] (or (or (.is p1 ch) (.is p2 ch)) (.is p3 ch)))
        (lambda CharPredicate ^boolean [^int ch] (or (or (.is p1 ch) (.is p2 ch)) (.is p3 ch)))))

  (method ^:private ^:static negate ^CharPredicate [^CharPredicate p1]
    (lambda CharPredicate ^boolean [^int ch] (not (.is p1 ch))))

  (defclass ^:static ^{FunctionalInterface true} ^:interface CharPredicate
    (method is ^boolean [this ^int ch])

    (method ^:default and ^CharPredicate [this ^CharPredicate p]
      (Pattern/and this p false))

    (method ^:default union ^CharPredicate [this ^CharPredicate p]
      (Pattern/union this p false))

    (method ^:default union ^CharPredicate [this ^CharPredicate p1 ^CharPredicate p2]
      (Pattern/union this p1 p2 false))

    (method ^:default negate ^CharPredicate [this] (Pattern/negate this)))

  (defclass ^:static ^:interface BmpCharPredicate
    :extends [CharPredicate]

    (method ^:default and ^CharPredicate [this ^CharPredicate p]
      (Pattern/and this p (instance? BmpCharPredicate p)))

    (method ^:default union ^CharPredicate [this ^CharPredicate p]
      (Pattern/union this p (instance? BmpCharPredicate p)))

    (method ^:default union ^CharPredicate [this ^CharPredicate p1 ^CharPredicate p2]
      (Pattern/union this
                     p1
                     p2
                     (and (instance? BmpCharPredicate p1) (instance? BmpCharPredicate p2)))))

  (method ^:static VertWS ^BmpCharPredicate []
    (lambda BmpCharPredicate ^boolean [^int cp]
      (or (or (or (and (>= cp 0x0A) (<= cp 0x0D)) (== cp 0x85)) (== cp 0x2028)) (== cp 0x2029))))

  (method ^:static HorizWS ^BmpCharPredicate []
    (lambda BmpCharPredicate ^boolean [^int cp]
      (or (or (or (or (or (or (or (or (== cp 0x09) (== cp 0x20)) (== cp 0xa0)) (== cp 0x1680))
                          (== cp 0x180e))
                      (and (>= cp 0x2000) (<= cp 0x200a)))
                  (== cp 0x202f))
              (== cp 0x205f))
          (== cp 0x3000))))

  (method ^:static ALL ^CharPredicate []
    (lambda CharPredicate ^boolean [^int ch] true))

  (method ^:static DOT ^CharPredicate []
    (lambda CharPredicate ^boolean [^int ch]
      (and (and (and (not (== ch \newline)) (not (== ch \return)))
                (not (== (bit-or-int ch 1) \u2029)))
           (not (== ch \u0085)))))

  (method ^:static UNIXDOT ^CharPredicate []
    (lambda CharPredicate ^boolean [^int ch] (not (== ch \newline))))

  (method ^:static SingleS ^CharPredicate [^int c]
    (lambda CharPredicate ^boolean [^int ch] (== ch c)))

  (method ^:static Single ^BmpCharPredicate [^int c]
    (lambda BmpCharPredicate ^boolean [^int ch] (== ch c)))

  (method ^:static SingleI ^BmpCharPredicate [^int lower ^int upper]
    (lambda BmpCharPredicate ^boolean [^int ch] (or (== ch lower) (== ch upper))))

  (method ^:static SingleU ^CharPredicate [^int lower]
    (lambda CharPredicate ^boolean [^int ch]
      (or (== lower ch) (== lower (Character/toLowerCase (Character/toUpperCase ch))))))

  (method ^:private ^:static inRange ^boolean [^int lower ^int ch ^int upper]
    (and (<= lower ch) (<= ch upper)))

  (method ^:static Range ^CharPredicate [^int lower ^int upper]
    (if (or (< upper Character/MIN_HIGH_SURROGATE)
            (and (> lower Character/MAX_LOW_SURROGATE)
                 (< upper Character/MIN_SUPPLEMENTARY_CODE_POINT)))
        (lambda BmpCharPredicate ^boolean [^int ch] (Pattern/inRange lower ch upper))
        (lambda CharPredicate ^boolean [^int ch] (Pattern/inRange lower ch upper))))

  (method ^:static CIRange ^CharPredicate [^int lower ^int upper]
    (lambda CharPredicate ^boolean [^int ch]
      (or (Pattern/inRange lower ch upper)
          (and (ASCII/isAscii ch)
               (or (Pattern/inRange lower (ASCII/toUpper ch) upper)
                   (Pattern/inRange lower (ASCII/toLower ch) upper))))))

  (method ^:static CIRangeU ^CharPredicate [^int lower ^int upper]
    (let [closingCharacters (CaseFolding/getClassRangeClosingCharacters lower upper)]
      (if (== (alength closingCharacters) 0)
          (lambda CharPredicate ^boolean [^int ch]
            (if (Pattern/inRange lower ch upper)
                true
                (let [up (Character/toUpperCase ch)]
                  (or (Pattern/inRange lower up upper)
                      (Pattern/inRange lower (Character/toLowerCase up) upper)))))
          (lambda CharPredicate ^boolean [^int ch]
            (if (Pattern/inRange lower ch upper)
                true
                (let [up (Character/toUpperCase ch)
                      lo (Character/toLowerCase up)]
                  (if (or (Pattern/inRange lower up upper) (Pattern/inRange lower lo upper))
                      true
                      (do
                        (for-each [^int cp closingCharacters]
                          (when (or (== up cp) (== lo cp)) (return true)))
                        false))))))))

  (field ^:static ^:final ^Node accept (Node.))

  (field ^:static ^:final ^Node lastAccept (LastNode.))

  (method ^:public asPredicate ^{:tag (Predicate String)} [this]
    (lambda Predicate ^boolean [^String s] (.find (.matcher this s))))

  (method ^:public asMatchPredicate ^{:tag (Predicate String)} [this]
    (lambda Predicate ^boolean [^String s] (.matches (.matcher this s))))

  (method ^:public splitAsStream ^{:tag (Stream String)} [this ^:final ^CharSequence input]
    (letclass [(MatcherIterator
                 :implements [(Iterator String)]

                 (field ^:private ^Matcher matcher)

                 (field ^:private ^int current)

                 (field ^:private ^String nextElement)

                 (field ^:private ^int emptyElementCount)

                 (method ^:public next ^String [this]
                   (when-not (.hasNext this) (throw (NoSuchElementException.)))
                   (if (== emptyElementCount 0)
                       (let [n nextElement] (set! nextElement nil) n)
                       (do (set! emptyElementCount (unchecked-dec-int emptyElementCount)) "")))

                 (method ^:public hasNext ^boolean [this]
                   (when (nil? matcher)
                     (set! matcher (.matcher Pattern/this input))
                     (set! emptyElementCount (if (== (.length input) 0) 1 0)))
                   (arbace.core/cond (or (some? nextElement) (> emptyElementCount 0))
                                     true
                                     (== current (.length input))
                                     false
                                     :else
                                     (do
                                       (while (.find matcher)
                                         (set! nextElement
                                               (.toString
                                                 (.subSequence input current (.start matcher))))
                                         (set! current (.end matcher))
                                         (arbace.core/cond
                                           (not (.isEmpty nextElement))
                                           (return true)
                                           (> current 0)
                                           (set!
                                             emptyElementCount
                                             (unchecked-inc-int emptyElementCount))))
                                       (set! nextElement
                                             (.toString
                                               (.subSequence input current (.length input))))
                                       (set! current (.length input))
                                       (if (not (.isEmpty nextElement))
                                           true
                                           (do
                                             (set! emptyElementCount 0)
                                             (set! nextElement nil)
                                             false))))))]
      (StreamSupport/stream
        (Spliterators/spliteratorUnknownSize (MatcherIterator.)
                                             (bit-or-int Spliterator/ORDERED Spliterator/NONNULL))
        false))))

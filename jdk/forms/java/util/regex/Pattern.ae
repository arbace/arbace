                (set! predicate
                      (if (.has this UNICODE_CHARACTER_CLASS)
                          (CharPredicates/DIGIT)
                          ^CharPredicate (CharPredicates/ASCII_DIGIT)))
                (when-not inclass (set! root (.newCharProperty this predicate))))
              (return -1))
          \e (return \u001b)
          \f (return \formfeed)
          \g nil
          \h
            (do
              (when create
                (set! predicate (Pattern/HorizWS))
                (when-not inclass (set! root (.newCharProperty this predicate))))
              (return -1))
          (\i \j) nil
          \k
            (when-not inclass
              (when-not (== (.read this) \<)

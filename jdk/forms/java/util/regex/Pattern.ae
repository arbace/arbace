                (set! ch (.nextEscaped this))
                (when (or (== ch \p) (== ch \P))
                  (if (> first 0)
                      (do (.unread this) (break :switch))
                      (let [comp (== ch \P)
                            ^:mutable oneLetter true]
                        (set! ch (.next this))
                        (if (not (== ch \{)) (.unread this) (set! oneLetter false))
                        (if (and (.has this CANON_EQ) (not (.has this LITERAL)))
                            (return (NFCCharProperty. (.family this oneLetter comp)))
                            (return (.newCharProperty this (.family this oneLetter comp)))))))

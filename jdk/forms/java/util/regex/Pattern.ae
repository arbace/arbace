              (when create
                (set! predicate (.negate (Pattern/HorizWS)))
                (when-not inclass (set! root (.newCharProperty this predicate))))
              (return -1))
          (\I \J \K \L \M) nil
          \N (return (.N this))
          (\O \P \Q) nil
          \R (when-not inclass (when create (set! root (LineEnding.))) (return -1))
          \S

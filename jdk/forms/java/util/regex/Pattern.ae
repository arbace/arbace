    (method ^:static optimize ^Node [^Node node]
      (if (not (instance? Slice node))
          node
          (let [src (.-buffer (cast Slice node))
                patternLength (alength src)]
            (if (< patternLength 4)
                node
                (let [^:mutable ^int i 0
                      ^:mutable ^int j 0
                      lastOcc (new int/1 128)
                      optoSft (new int/1 patternLength)]

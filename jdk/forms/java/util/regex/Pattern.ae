              (when create
                (set! predicate
                      (if (.has this UNICODE_CHARACTER_CLASS)
                          (CharPredicates/WORD)
                          ^CharPredicate (CharPredicates/ASCII_WORD)))
                (set! predicate (.negate predicate))
                (when-not inclass (set! root (.newCharProperty this predicate))))
              (return -1))
          \X (when-not inclass (when create (set! root (XGrapheme.))) (return -1))
          \Y nil
          \Z

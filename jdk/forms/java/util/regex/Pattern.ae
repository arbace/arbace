          \y nil
          \z (when-not inclass (when create (set! root (End.))) (return -1))
          (return ch)))
      (throw (.error this "Illegal/unsupported escape sequence"))))

  (method ^:private clazz ^CharPredicate [this ^boolean consume]
    (let [^:mutable ^CharPredicate prev nil
          ^:mutable ^CharPredicate curr nil
          bits (BitClass.)
          ^:mutable isNeg false
          ^:mutable hasBits false
          ^:mutable ch (.next this)]
      (when (and (== ch \^) (== (aget temp (unchecked-subtract-int cursor 1)) \[))
        (set! ch (.next this))
        (set! isNeg true))
      (while true
        (switch ch
          \[
            (do
              (set! curr (.clazz this true))
              (if (nil? prev) (set! prev curr) (set! prev (.union prev curr)))
              (set! ch (.peek this))
              (continue))
          \&
            (do
              (set! ch (.next this))
              (if (== ch \&)
                  (do
                    (set! ch (.next this))
                    (let [^:mutable ^CharPredicate right nil]
                      (while (and (not (== ch \])) (not (== ch \&)))
                        (if (== ch \[)
                            (if (nil? right)
                                (set! right (.clazz this true))
                                (set! right (.union right (.clazz this true))))
                            (do
                              (.unread this)
                              (if (nil? right)
                                  (set! right (.clazz this false))
                                  (set! right (.union right (.clazz this false))))))

              (when create
                (set! predicate
                      (if (.has this UNICODE_CHARACTER_CLASS)
                          (CharPredicates/WHITE_SPACE)
                          ^CharPredicate (CharPredicates/ASCII_SPACE)))
                (set! predicate (.negate predicate))
                (when-not inclass (set! root (.newCharProperty this predicate))))
              (return -1))
          (\T \U) nil
          \V
            (do
              (when create
                (set! predicate (.negate (Pattern/VertWS)))
                (when-not inclass (set! root (.newCharProperty this predicate))))
              (return -1))
          \W

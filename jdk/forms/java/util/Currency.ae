            (let [scEntry (cast SpecialCaseEntry (.get specialCasesList index))]
              (cond
                (and (.equals (.-oldCurrency scEntry) code)
                     (or (== (.-cutOverTime scEntry) Long/MAX_VALUE)
                         (< (System/currentTimeMillis) (.-cutOverTime scEntry))))
                  (do
                    (set! fractionAndNumericCode (new int/1 2))
                    (aset fractionAndNumericCode 0 (.-oldCurrencyFraction scEntry))
                    (aset fractionAndNumericCode 1 (.-oldCurrencyNumericCode scEntry)))
                (and (.equals (.-newCurrency scEntry) code)
                     (>= (System/currentTimeMillis) (.-cutOverTime scEntry)))
                  (do
                    (set! fractionAndNumericCode (new int/1 2))
                    (aset fractionAndNumericCode 0 (.-newCurrencyFraction scEntry))
                    (aset fractionAndNumericCode 1 (.-newCurrencyNumericCode scEntry)))
                :else (recur (unchecked-inc-int index))))))
        fractionAndNumericCode))

    (method ^:private ^:static currencyCodeIndex ^int [^String code]
      (let [size (.size specialCasesList)]
        (loop [^int index 0]
          (when (< index size)
            (let [scEntry (cast SpecialCaseEntry (.get specialCasesList index))]
              (cond
                (and (.equals (.-oldCurrency scEntry) code)
                     (or (== (.-cutOverTime scEntry) Long/MAX_VALUE)
                         (< (System/currentTimeMillis) (.-cutOverTime scEntry))))
                  (return index)
                (and (.equals (.-newCurrency scEntry) code)
                     (>= (System/currentTimeMillis) (.-cutOverTime scEntry)))
                  (return index)
                :else (recur (unchecked-inc-int index))))))
        -1))

    (method ^:private ^:static toIndex ^int [^int tableEntry]
      (unchecked-subtract-int (bit-and-int tableEntry SPECIAL_CASE_COUNTRY_INDEX_MASK)
                              SPECIAL_CASE_COUNTRY_INDEX_DELTA)))

  (defclass ^:private ^:static OtherCurrencyEntry
    (field ^:private ^:final ^String currencyCode)

    (field ^:private ^:final ^int fraction)

    (field ^:private ^:final ^int numericCode)

    (constructor ^:private [this ^String currencyCode ^int fraction ^int numericCode]
      (set! (.-currencyCode this) currencyCode)
      (set! (.-fraction this) fraction)
      (set! (.-numericCode this) numericCode))

    (method ^:private ^:static findEntry ^OtherCurrencyEntry [^String code]
      (let [size (.size otherCurrenciesList)]
        (loop [^int index 0]
          (when (< index size)
            (let [ocEntry (cast OtherCurrencyEntry (.get otherCurrenciesList index))]
              (if (.equalsIgnoreCase (.-currencyCode ocEntry) code)
                  (return ocEntry)
                  (recur (unchecked-inc-int index))))))
        nil)))

  (defclass ^:private ^:static CurrencyProperty
    (field ^:private ^:final ^String country)

    (field ^:private ^:final ^String currencyCode)

    (field ^:private ^:final ^int fraction)

    (field ^:private ^:final ^int numericCode)

    (field ^:private ^:final ^String date)

    (constructor ^:private [this ^String country ^String currencyCode ^int fraction ^int numericCode
                            ^String date]
      (set! (.-country this) country)
      (set! (.-currencyCode this) currencyCode)
      (set! (.-fraction this) fraction)
      (set! (.-numericCode this) numericCode)
      (set! (.-date this) date))

    (method ^:private ^:static getValidEntry ^{:tag (Optional CurrencyProperty)} [^String ctry
                                                                                  ^String curData
                                                                                  ^Pattern pattern]
      (let [^:mutable ^CurrencyProperty prop nil]
        (when-not (not (== (.length ctry) 2))
          (set! prop (CurrencyProperty/parseProperty ctry curData pattern))
          (cond
            (or (nil? prop)
                (and (nil? (.-date prop))
                     (>= (.sum (.map (.chars curData)
                                     (lambda IntUnaryOperator ^int [^int c] (if (== c \,) 1 0))))
                         3)))
              (set! prop nil)
            (> (.-fraction prop) SIMPLE_CASE_COUNTRY_MAX_DEFAULT_DIGITS) (set! prop nil)
            :else
              (try
                (when (and (some? (.-date prop))
                           (not (CurrencyProperty/isPastCutoverDate (.-date prop))))
                  (set! prop nil))
                (catch DateTimeParseException ex (set! prop nil)))))
        (when (nil? prop)
          (CurrencyProperty/info (java-str "The property entry for " ctry " is invalid. Ignored.")
                                 nil))
        (Optional/ofNullable prop)))

    (method ^:private ^:static parseProperty ^CurrencyProperty [^String ctry ^String curData
                                                                ^Pattern pattern]
      (let [m (.matcher pattern curData)]
        (when-not (not (.find m))
          (CurrencyProperty. ctry
                             (.group m 1)
                             (Integer/parseInt (.group m 3))
                             (Integer/parseInt (.group m 2))
                             (.group m 4)))))

    (method ^:private ^:static containsInconsistentInstances ^boolean [^{:tag (List CurrencyProperty)} list]
      (let [numCode (.-numericCode (cast CurrencyProperty (.get list 0)))
            fractionDigit (.-fraction (cast CurrencyProperty (.get list 0)))]
        (.anyMatch (.stream list)
                   (lambda Predicate ^boolean [^CurrencyProperty prop]
                     (or (not (== (.-numericCode prop) numCode))
                         (not (== (.-fraction prop) fractionDigit)))))))

    (method ^:private ^:static isPastCutoverDate ^boolean [^String cutOver]
      (> (System/currentTimeMillis)
         (.toEpochMilli
           (.toInstant (LocalDateTime/parse cutOver DateTimeFormatter/ISO_LOCAL_DATE_TIME)
                       ZoneOffset/UTC))))

    (method ^:private ^:static info ^void [^String message ^Throwable t]
      (let [logger (PlatformLogger/getLogger "java.util.Currency")]
        (when (.isLoggable logger PlatformLogger$Level/INFO)
          (if (some? t) (.info logger message t) (.info logger message)))))))

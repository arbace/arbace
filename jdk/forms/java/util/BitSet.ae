                             (set! fence
                                   (if (>= wordsInUse (BitSet/wordIndex Integer/MAX_VALUE))
                                       Integer/MAX_VALUE
                                       (bit-shift-left-int wordsInUse ADDRESS_BITS_PER_WORD))))
                       (set! est (.cardinality BitSet/this))
                       (set! index (.nextSetBit BitSet/this 0)))
                     hi))

                 (method ^:public tryAdvance ^boolean [this ^IntConsumer action]
                   (Objects/requireNonNull action)
                   (let [hi (.getFence this)
                         i index]
                     (if (or (< i 0) (>= i hi))
                         (if (and (== i Integer/MAX_VALUE) (== hi Integer/MAX_VALUE))
                             (do (set! index -1) (.accept action Integer/MAX_VALUE) true)
                             false)
                         (do
                           (set! index
                                 (.nextSetBit BitSet/this
                                              (unchecked-add-int i 1)
                                              (BitSet/wordIndex (unchecked-subtract-int hi 1))))
                           (.accept action i)
                           true))))

                 (method ^:public forEachRemaining ^void [this ^IntConsumer action]
                   (Objects/requireNonNull action)
                   (let [hi (.getFence this)
                         ^:mutable i index]
                     (set! index -1)
                     (when (and (>= i 0) (< i hi))
                       (.accept action i)
                       (set! i (unchecked-inc-int i))
                       (let [^:mutable u (BitSet/wordIndex i)
                             v (BitSet/wordIndex (unchecked-subtract-int hi 1))]
                         (label :words_loop
                           (while (and (<= u v) (<= i hi))
                             (let [^:mutable word (bit-and
                                                    (aget words u)
                                                    (bit-shift-left WORD_MASK i))]
                               (while (not (== word 0))
                                 (set! i
                                       (unchecked-add-int
                                         (bit-shift-left-int u ADDRESS_BITS_PER_WORD)
                                         (Long/numberOfTrailingZeros word)))
                                 (when (>= i hi) (break :words_loop))
                                 (set! word (bit-and word (bit-not (bit-shift-left 1 i))))
                                 (.accept action i)))
                             (set! u (unchecked-inc-int u))
                             (set! i (bit-shift-left-int u ADDRESS_BITS_PER_WORD))))))
                     (when (and (== i Integer/MAX_VALUE) (== hi Integer/MAX_VALUE))
                       (.accept action Integer/MAX_VALUE))))

                 (method ^:public trySplit ^Spliterator$OfInt [this]
                   (let [^:mutable hi (.getFence this)
                         lo index]
                     (when-not (< lo 0)
                       (set! hi
                             (set! fence
                                   (if (or (< hi Integer/MAX_VALUE)
                                           (not (.get BitSet/this Integer/MAX_VALUE)))
                                       (unchecked-add-int
                                         (.previousSetBit BitSet/this (unchecked-subtract-int hi 1))
                                         1)
                                       Integer/MAX_VALUE)))
                       (let [mid (unsigned-bit-shift-right-int (unchecked-add-int lo hi) 1)]
                         (when-not (>= lo mid)
                           (set! index
                                 (.nextSetBit BitSet/this
                                              mid
                                              (BitSet/wordIndex (unchecked-subtract-int hi 1))))
                           (set! root false)
                           (BitSetSpliterator. lo
                                               mid
                                               (set! est (unsigned-bit-shift-right-int est 1))
                                               false))))))

                 (method ^:public estimateSize ^long [this] (.getFence this) est)

                 (method ^:public characteristics ^int [this]
                   (bit-or-int (bit-or-int (bit-or-int
                                             (if root Spliterator/SIZED 0)
                                             Spliterator/ORDERED)
                                           Spliterator/DISTINCT)
                               Spliterator/SORTED))

                 (method ^:public getComparator ^{:tag (Comparator (? super Integer))} [this]
                   nil))]
      (StreamSupport/intStream (BitSetSpliterator. 0 -1 0 true) false)))

  (method ^:private nextSetBit ^int [this ^int fromIndex ^int toWordIndex]
    (let [^:mutable u (BitSet/wordIndex fromIndex)]
      (if (> u toWordIndex)
          -1
          (let [^:mutable word (bit-and (aget words u) (bit-shift-left WORD_MASK fromIndex))]
            (while true
              (when-not (== word 0)
                (return (unchecked-add-int (unchecked-multiply-int u BITS_PER_WORD)
                                           (Long/numberOfTrailingZeros word))))
              (when (> (set! u (unchecked-inc-int u)) toWordIndex) (return -1))
              (set! word (aget words u))))))))

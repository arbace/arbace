      (when-not (== precision -1) (throw (IllegalFormatPrecisionException. precision)))
      (cond
        (== c Conversion/DECIMAL_INTEGER) (.checkBadFlags this Flags/ALTERNATE)
        (== c Conversion/OCTAL_INTEGER) (.checkBadFlags this Flags/GROUP)
        :else (.checkBadFlags this Flags/GROUP)))

    (method ^:private checkBadFlags ^void [this ^int badFlags]
      (when-not (== (bit-and-int flags badFlags) 0)
        (.failMismatch this (bit-and-int flags badFlags) c)))

    (method ^:private checkFloat ^void [this]
      (.checkNumeric this)
      (when-not (== c Conversion/DECIMAL_FLOAT)
        (cond
          (== c Conversion/HEXADECIMAL_FLOAT)
            (.checkBadFlags this (bit-or-int Flags/PARENTHESES Flags/GROUP))
          (== c Conversion/SCIENTIFIC) (.checkBadFlags this Flags/GROUP)
          (== c Conversion/GENERAL) (.checkBadFlags this Flags/ALTERNATE))))

    (method ^:private checkNumeric ^void [this]
      (when (and (not (== width -1)) (< width 0)) (throw (IllegalFormatWidthException. width)))
      (when (and (not (== precision -1)) (< precision 0))
        (throw (IllegalFormatPrecisionException. precision)))
      (when (and (== width -1)
                 (Flags/containsAny flags (bit-or-int Flags/LEFT_JUSTIFY Flags/ZERO_PAD)))
        (throw (MissingFormatWidthException. (.toString this))))
      (when (or (Flags/contains flags (bit-or-int Flags/PLUS Flags/LEADING_SPACE))
                (Flags/contains flags (bit-or-int Flags/LEFT_JUSTIFY Flags/ZERO_PAD)))
        (throw (IllegalFormatFlagsException. (Flags/toString flags)))))

    (method ^:private checkText ^void [this]
      (when-not (== precision -1) (throw (IllegalFormatPrecisionException. precision)))
      (switch c
        Conversion/PERCENT_SIGN
          (do
            (when (and (not (== flags Flags/LEFT_JUSTIFY)) (not (== flags Flags/NONE)))
              (throw (IllegalFormatFlagsException. (Flags/toString flags))))
            (when (and (== width -1) (Flags/contains flags Flags/LEFT_JUSTIFY))
              (throw (MissingFormatWidthException. (.toString this)))))
        Conversion/LINE_SEPARATOR
          (do
            (when-not (== width -1) (throw (IllegalFormatWidthException. width)))
            (when-not (== flags Flags/NONE)
              (throw (IllegalFormatFlagsException. (Flags/toString flags)))))
        (java-assert false)))

    (method ^:private print :throws [IOException] ^void [this ^Formatter fmt ^byte value ^Locale l]
      (let [^:mutable ^long v value]
        (when (and (< value 0)
                   (or (== c Conversion/OCTAL_INTEGER) (== c Conversion/HEXADECIMAL_INTEGER)))
          (set! v (unchecked-add v (bit-shift-left 1 8))))
        (.print this fmt v l)))

    (method ^:private print :throws [IOException] ^void [this ^Formatter fmt ^short value ^Locale l]
      (let [^:mutable ^long v value]
        (when (and (< value 0)
                   (or (== c Conversion/OCTAL_INTEGER) (== c Conversion/HEXADECIMAL_INTEGER)))
          (set! v (unchecked-add v (bit-shift-left 1 16)))
          (java-assert (>= v 0) v))
        (.print this fmt v l)))

    (method ^:private print :throws [IOException] ^void [this ^Formatter fmt ^int value ^Locale l]
      (let [^:mutable ^long v value]
        (when (and (< value 0)
                   (or (== c Conversion/OCTAL_INTEGER) (== c Conversion/HEXADECIMAL_INTEGER)))
          (set! v (unchecked-add v (bit-shift-left 1 32)))
          (java-assert (>= v 0) v))
        (.print this fmt v l)))

    (method ^:private print :throws [IOException] ^void [this ^Formatter fmt ^long value ^Locale l]
      (let [sb (StringBuilder.)]
        (cond
          (== c Conversion/DECIMAL_INTEGER)
            (let [neg (< value 0)
                  valueStr (Long/toString value 10)]
              (.leadingSign this sb neg)
              (.localizedMagnitude this
                                   fmt
                                   sb
                                   valueStr
                                   (if neg 1 0)
                                   flags
                                   (.adjustWidth this width flags neg)
                                   l)
              (.trailingSign this sb neg))
          (== c Conversion/OCTAL_INTEGER)
            (do
              (.checkBadFlags this
                              (bit-or-int (bit-or-int Flags/PARENTHESES Flags/LEADING_SPACE)
                                          Flags/PLUS))
              (let [s (Long/toOctalString value)
                    ^int len (if (Flags/contains flags Flags/ALTERNATE)
                                 (unchecked-add-int (.length s) 1)
                                 (.length s))]
                (when (Flags/contains flags Flags/ALTERNATE) (.append sb \0))
                (when (Flags/contains flags Flags/ZERO_PAD)
                  (.trailingZeros this sb (unchecked-subtract-int width len)))
                (.append sb s)))
          :else
            (when (== c Conversion/HEXADECIMAL_INTEGER)
              (.checkBadFlags this
                              (bit-or-int (bit-or-int Flags/PARENTHESES Flags/LEADING_SPACE)
                                          Flags/PLUS))
              (let [^:mutable s (Long/toHexString value)
                    ^int len (if (Flags/contains flags Flags/ALTERNATE)
                                 (unchecked-add-int (.length s) 2)
                                 (.length s))]
                (when (Flags/contains flags Flags/ALTERNATE)
                  (.append sb ^String (if (Flags/contains flags Flags/UPPERCASE) "0X" "0x")))
                (when (Flags/contains flags Flags/ZERO_PAD)
                  (.trailingZeros this sb (unchecked-subtract-int width len)))
                (when (Flags/contains flags Flags/UPPERCASE)
                  (set! s (.toUpperCaseWithLocale this s l)))
                (.append sb s))))
        (.appendJustified this (.-a fmt) sb)))

    (method ^:private leadingSign ^StringBuilder [this ^StringBuilder sb ^boolean neg]
      (cond
        (not neg)
          (cond
            (Flags/contains flags Flags/PLUS) (.append sb \+)
            (Flags/contains flags Flags/LEADING_SPACE) (.append sb \space))
        (Flags/contains flags Flags/PARENTHESES) (.append sb \()
        :else (.append sb \-))
      sb)

    (method ^:private trailingSign ^StringBuilder [this ^StringBuilder sb ^boolean neg]
      (when (and neg (Flags/contains flags Flags/PARENTHESES)) (.append sb \)))
      sb)

    (method ^:private print :throws [IOException] ^void [this ^Formatter fmt ^BigInteger value
                                                         ^Locale l]
      (let [sb (StringBuilder.)
            neg (== (.signum value) -1)
            v (.abs value)]
        (.leadingSign this sb neg)
        (cond
          (== c Conversion/DECIMAL_INTEGER)
            (.localizedMagnitude this
                                 fmt
                                 sb
                                 (.toString v)
                                 0
                                 flags
                                 (.adjustWidth this width flags neg)
                                 l)
          (== c Conversion/OCTAL_INTEGER)
            (let [s (.toString v 8)
                  ^:mutable len (unchecked-add-int (.length s) (.length sb))]
              (when (and neg (Flags/contains flags Flags/PARENTHESES))
                (set! len (unchecked-inc-int len)))
              (when (Flags/contains flags Flags/ALTERNATE)
                (set! len (unchecked-inc-int len))
                (.append sb \0))
              (when (Flags/contains flags Flags/ZERO_PAD)
                (.trailingZeros this sb (unchecked-subtract-int width len)))
              (.append sb s))
          (== c Conversion/HEXADECIMAL_INTEGER)
            (let [^:mutable s (.toString v 16)
                  ^:mutable len (unchecked-add-int (.length s) (.length sb))]
              (when (and neg (Flags/contains flags Flags/PARENTHESES))
                (set! len (unchecked-inc-int len)))
              (when (Flags/contains flags Flags/ALTERNATE)
                (set! len (unchecked-add-int len 2))
                (.append sb ^String (if (Flags/contains flags Flags/UPPERCASE) "0X" "0x")))
              (when (Flags/contains flags Flags/ZERO_PAD)
                (.trailingZeros this sb (unchecked-subtract-int width len)))
              (when (Flags/contains flags Flags/UPPERCASE)
                (set! s (.toUpperCaseWithLocale this s l)))
              (.append sb s)))
        (.trailingSign this sb (== (.signum value) -1))
        (.appendJustified this (.-a fmt) sb)))

    (method ^:private print :throws [IOException] ^void [this ^Formatter fmt ^float value ^Locale l]
      (.print this fmt (double value) l))

    (method ^:private print :throws [IOException] ^void [this ^Formatter fmt ^double value ^Locale l]
      (let [sb (StringBuilder.)
            neg (== (Double/compare value 0.0) -1)]
        (if (not (Double/isNaN value))
            (let [v (Math/abs value)]
              (.leadingSign this sb neg)
              (if (not (Double/isInfinite v))
                  (.print this fmt sb v l flags c precision neg)
                  (.append
                    sb
                    ^String (if (Flags/contains flags Flags/UPPERCASE) "INFINITY" "Infinity")))
              (.trailingSign this sb neg))
            (.append sb ^String (if (Flags/contains flags Flags/UPPERCASE) "NAN" "NaN")))
        (.appendJustified this (.-a fmt) sb)))

    (method ^:private print ^void [this ^Formatter fmt ^StringBuilder sb ^double value ^Locale l
                                   ^int flags ^char c ^int precision ^boolean neg]
      (cond
        (== c Conversion/SCIENTIFIC)
          (let [^int prec (if (== precision -1) 6 precision)
                fd (FormattedFPDecimal/valueOf value prec FormattedFPDecimal/SCIENTIFIC)
                mant (.append (StringBuilder.) (.getMantissa fd))]
            (.addZeros this mant prec)
            (when (and (Flags/contains flags Flags/ALTERNATE) (== prec 0)) (.append mant \.))
            (let [^char/1 exp (if (== value 0.0) (new char/1 [\+ \0 \0]) (.getExponent fd))
                  ^:mutable newW width]
              (when-not (== width -1)
                (set! newW
                      (.adjustWidth this
                                    (unchecked-subtract-int
                                      (unchecked-subtract-int width (alength exp))
                                      1)
                                    flags
                                    neg)))
              (.localizedMagnitude this fmt sb mant 0 flags newW l)
              (.append sb (if (Flags/contains flags Flags/UPPERCASE) \E \e))
              (let [sign (aget exp 0)]
                (java-assert (or (== sign \+) (== sign \-)))
                (.append sb sign)
                (.localizedMagnitudeExp this fmt sb exp 1 l))))
        (== c Conversion/DECIMAL_FLOAT)
          (let [^int prec (if (== precision -1) 6 precision)
                fd (FormattedFPDecimal/valueOf value prec FormattedFPDecimal/PLAIN)
                mant (.append (StringBuilder.) (.getMantissa fd))]
            (.addZeros this mant prec)
            (when (and (Flags/contains flags Flags/ALTERNATE) (== prec 0)) (.append mant \.))
            (let [^:mutable newW width]
              (when-not (== width -1) (set! newW (.adjustWidth this width flags neg)))
              (.localizedMagnitude this fmt sb mant 0 flags newW l)))
        (== c Conversion/GENERAL)
          (let [^:mutable prec precision]
            (cond (== precision -1) (set! prec 6) (== precision 0) (set! prec 1))
            (let [^:mutable ^char/1 exp nil
                  mant (StringBuilder.)
                  ^:mutable ^int expRounded 0]
              (if (== value 0.0)
                  (do (set! exp nil) (.append mant \0) (set! expRounded 0))
                  (let [fd (FormattedFPDecimal/valueOf value prec FormattedFPDecimal/GENERAL)]
                    (set! exp (.getExponent fd))
                    (.append mant (.getMantissa fd))
                    (set! expRounded (.getExponentRounded fd))))
              (if (some? exp)
                  (set! prec (unchecked-subtract-int prec 1))
                  (set! prec (unchecked-subtract-int prec (unchecked-add-int expRounded 1))))
              (.addZeros this mant prec)
              (when (and (Flags/contains flags Flags/ALTERNATE) (== prec 0)) (.append mant \.))
              (let [^:mutable newW width]
                (when-not (== width -1)
                  (if (some? exp)
                      (set! newW
                            (.adjustWidth this
                                          (unchecked-subtract-int
                                            (unchecked-subtract-int width (alength exp))
                                            1)
                                          flags
                                          neg))
                      (set! newW (.adjustWidth this width flags neg))))
                (.localizedMagnitude this fmt sb mant 0 flags newW l)
                (when (some? exp)
                  (.append sb (if (Flags/contains flags Flags/UPPERCASE) \E \e))
                  (let [sign (aget exp 0)]
                    (java-assert (or (== sign \+) (== sign \-)))
                    (.append sb sign)
                    (.localizedMagnitudeExp this fmt sb exp 1 l))))))
        (== c Conversion/HEXADECIMAL_FLOAT)
          (let [^:mutable prec precision]
            (cond (== precision -1) (set! prec 0) (== precision 0) (set! prec 1))
            (let [s (.hexDouble this value prec)
                  va (StringBuilder.)
                  upper (Flags/contains flags Flags/UPPERCASE)]
              (.append sb ^String (if upper "0X" "0x"))
              (when (Flags/contains flags Flags/ZERO_PAD)
                (let [^:mutable ^int leadingCharacters 2]
                  (when (or (or (Flags/contains flags Flags/LEADING_SPACE)
                                (Flags/contains flags Flags/PLUS))
                            neg)
                    (set! leadingCharacters 3))
                  (.trailingZeros this
                                  sb
                                  (unchecked-subtract-int
                                    (unchecked-subtract-int width (.length s))
                                    leadingCharacters))))
              (let [idx (.indexOf s \p)]
                (if upper
                    (let [^:mutable tmp (.substring s 0 idx)]
                      (set! tmp (.toUpperCase tmp Locale/ROOT))
                      (.append va tmp))
                    (.append va s 0 idx))
                (when-not (== prec 0) (.addZeros this va prec))
                (.append sb va)
                (.append sb (if upper \P \p))
                (.append sb s (unchecked-add-int idx 1) (.length s)))))))

    (method ^:private addZeros ^void [this ^StringBuilder sb ^int prec]
      (let [len (.length sb)
            ^:mutable ^int i 0]
        (set! i 0)
        (while (< i len) (when (== (.charAt sb i) \.) (break)) (set! i (unchecked-inc-int i)))
        (let [^:mutable needDot false]
          (when (== i len) (set! needDot true))
          (let [outPrec (unchecked-subtract-int (unchecked-subtract-int len i) (if needDot 0 1))]
            (java-assert (<= outPrec prec))
            (when-not (== outPrec prec)
              (when needDot (.append sb \.))
              (.trailingZeros this sb (unchecked-subtract-int prec outPrec)))))))

    (method ^:private hexDouble ^String [this ^:mutable ^double d ^int prec]
      (if (or (or (or (not (Double/isFinite d)) (== d 0.0)) (== prec 0)) (>= prec 13))
          (.substring (Double/toHexString d) 2)
          (do
            (java-assert (and (>= prec 1) (<= prec 12)))
            (let [^:mutable exponent (Math/getExponent d)
                  subnormal (== exponent (unchecked-subtract-int Double/MIN_EXPONENT 1))]
              (when subnormal
                (set! d (unchecked-multiply d SCALEUP))
                (set! exponent (Math/getExponent d))
                (java-assert (and (>= exponent Double/MIN_EXPONENT)
                                  (<= exponent Double/MAX_EXPONENT))
                  exponent))
              (let [precision (unchecked-add-int 1 (unchecked-multiply-int prec 4))
                    shiftDistance (unchecked-subtract-int DoubleConsts/SIGNIFICAND_WIDTH precision)]
                (java-assert (and (>= shiftDistance 1)
                                  (< shiftDistance DoubleConsts/SIGNIFICAND_WIDTH)))
                (let [doppel (Double/doubleToLongBits d)
                      ^:mutable newSignif (bit-shift-right
                                            (bit-and
                                              doppel
                                              (bit-or
                                                DoubleConsts/EXP_BIT_MASK
                                                DoubleConsts/SIGNIF_BIT_MASK))
                                            shiftDistance)
                      roundingBits (bit-and doppel
                                            (bit-not (bit-shift-left (bit-not 0) shiftDistance)))
                      leastZero (== (bit-and newSignif 0x1) 0)
                      round (not (== (bit-and (bit-shift-left
                                                1
                                                (unchecked-subtract-int shiftDistance 1))
                                              roundingBits)
                                     0))
                      sticky (and (> shiftDistance 1)
                                  (not (== (bit-and
                                             (bit-not
                                               (bit-shift-left
                                                 1
                                                 (unchecked-subtract-int shiftDistance 1)))
                                             roundingBits)
                                           0)))]
                  (when (or (and (and leastZero round) sticky) (and (not leastZero) round))
                    (set! newSignif (unchecked-inc newSignif)))
                  (let [signBit (bit-and doppel DoubleConsts/SIGN_BIT_MASK)]
                    (set! newSignif (bit-or signBit (bit-shift-left newSignif shiftDistance)))
                    (let [result (Double/longBitsToDouble newSignif)]
                      (if (Double/isInfinite result)
                          "1.0p1024"
                          (let [res (.substring (Double/toHexString result) 2)]
                            (if (not subnormal)
                                res
                                (let [idx (.indexOf res \p)]
                                  (if (== idx -1)
                                      (do (java-assert false) nil)
                                      (let [exp (.substring res (unchecked-add-int idx 1))
                                            iexp (unchecked-subtract-int (Integer/parseInt exp) 54)]
                                        (java-str
                                          (.substring res 0 idx)
                                          "p"
                                          (Integer/toString iexp))))))))))))))))

    (method ^:private print :throws [IOException] ^void [this ^Formatter fmt ^BigDecimal value
                                                         ^Locale l]
      (when (== c Conversion/HEXADECIMAL_FLOAT) (.failConversion this c value))
      (let [sb (StringBuilder.)
            neg (== (.signum value) -1)
            v (.abs value)]
        (.leadingSign this sb neg)
        (.print this fmt sb v l flags c precision neg)
        (.trailingSign this sb neg)
        (.appendJustified this (.-a fmt) sb)))

    (method ^:private print :throws [IOException] ^void [this ^Formatter fmt ^StringBuilder sb
                                                         ^:mutable ^BigDecimal value ^Locale l
                                                         ^int flags ^char c ^int precision
                                                         ^boolean neg]
      (cond
        (== c Conversion/SCIENTIFIC)
          (let [^int prec (if (== precision -1) 6 precision)
                scale (.scale value)
                origPrec (.precision value)
                ^:mutable ^int nzeros 0
                ^:mutable ^int compPrec 0]
            (if (> prec (unchecked-subtract-int origPrec 1))
                (do
                  (set! compPrec origPrec)
                  (set! nzeros (unchecked-subtract-int prec (unchecked-subtract-int origPrec 1))))
                (set! compPrec (unchecked-add-int prec 1)))
            (let [mc (MathContext. compPrec)
                  v (BigDecimal. (.unscaledValue value) scale mc)
                  bdl (BigDecimalLayout. (.unscaledValue v)
                                         (.scale v)
                                         BigDecimalLayoutForm/SCIENTIFIC)
                  mant (.mantissa bdl)]
              (when (and (or (== origPrec 1) (not (.hasDot bdl)))
                         (or (> nzeros 0) (Flags/contains flags Flags/ALTERNATE)))
                (.append mant \.))
              (.trailingZeros this mant nzeros)
              (let [exp (.exponent bdl)
                    ^:mutable newW width]
                (when-not (== width -1)
                  (set! newW
                        (.adjustWidth this
                                      (unchecked-subtract-int
                                        (unchecked-subtract-int width (.length exp))
                                        1)
                                      flags
                                      neg)))
                (.localizedMagnitude this fmt sb mant 0 flags newW l)
                (.append sb (if (Flags/contains flags Flags/UPPERCASE) \E \e))
                (let [adaptedFlags (Flags/remove flags Flags/GROUP)
                      sign (.charAt exp 0)]
                  (java-assert (or (== sign \+) (== sign \-)))
                  (.append sb sign)
                  (.append sb (.localizedMagnitude this fmt nil exp 1 adaptedFlags -1 l))))))
        (== c Conversion/DECIMAL_FLOAT)
          (let [^int prec (if (== precision -1) 6 precision)
                scale (.scale value)]
            (when (> scale prec)
              (let [^:mutable compPrec (.precision value)]
                (if (<= compPrec scale)
                    (set! value (.setScale value prec RoundingMode/HALF_UP))
                    (do
                      (set! compPrec
                            (unchecked-subtract-int compPrec (unchecked-subtract-int scale prec)))
                      (set! value
                            (BigDecimal. (.unscaledValue value) scale (MathContext. compPrec)))))))
            (let [bdl (BigDecimalLayout. (.unscaledValue value)
                                         (.scale value)
                                         BigDecimalLayoutForm/DECIMAL_FLOAT)
                  mant (.mantissa bdl)
                  ^int nzeros (if (< (.scale bdl) prec)
                                  (unchecked-subtract-int prec (.scale bdl))
                                  0)]
              (when (and (== (.scale bdl) 0)
                         (or (Flags/contains flags Flags/ALTERNATE) (> nzeros 0)))
                (.append mant \.))
              (.trailingZeros this mant nzeros)
              (.localizedMagnitude this fmt sb mant 0 flags (.adjustWidth this width flags neg) l)))
        (== c Conversion/GENERAL)
          (let [^:mutable prec precision]
            (cond (== precision -1) (set! prec 6) (== precision 0) (set! prec 1))
            (set! value (.round value (MathContext. prec)))
            (if (or (.equals value BigDecimal/ZERO)
                    (and (not (== (.compareTo value (BigDecimal/valueOf 1 4)) -1))
                         (== (.compareTo value (BigDecimal/valueOf 1 (unchecked-negate-int prec)))
                             -1)))
                (let [e (unchecked-add-int (unchecked-negate-int (.scale value))
                                           (unchecked-subtract-int
                                             (.length (.toString (.unscaledValue value)))
                                             1))]
                  (set! prec (unchecked-subtract-int (unchecked-subtract-int prec e) 1))
                  (.print this fmt sb value l flags Conversion/DECIMAL_FLOAT prec neg))
                (.print this
                        fmt
                        sb
                        value
                        l
                        flags
                        Conversion/SCIENTIFIC
                        (unchecked-subtract-int prec 1)
                        neg)))
        (== c Conversion/HEXADECIMAL_FLOAT) (java-assert false)))

    (defclass ^:private BigDecimalLayout
      (field ^:private ^StringBuilder mant)

      (field ^:private ^StringBuilder exp)

      (field ^:private ^boolean dot false)

      (field ^:private ^int scale)

      (constructor ^:public [this ^BigInteger intVal ^int scale ^BigDecimalLayoutForm form]
        (.layout this intVal scale form))

      (method ^:public hasDot ^boolean [this] dot)

      (method ^:public scale ^int [this] scale)

      (method ^:public mantissa ^StringBuilder [this] mant)

      (method ^:public exponent ^StringBuilder [this] exp)

      (method ^:private layout ^void [this ^BigInteger intVal ^int scale ^BigDecimalLayoutForm form]
        (let [coeff (.toString intVal)]
          (set! (.-scale this) scale)
          (let [len (.length coeff)]
            (set! mant (StringBuilder. (unchecked-add-int len 14)))
            (cond
              (== scale 0)
                (if (> len 1)
                    (do
                      (.append mant (.charAt coeff 0))
                      (if (identical? form BigDecimalLayoutForm/SCIENTIFIC)
                          (do
                            (.append mant \.)
                            (set! dot true)
                            (.append mant coeff 1 len)
                            (set! exp (StringBuilder. "+"))
                            (if (< len 10)
                                (.append (.append exp \0) (unchecked-subtract-int len 1))
                                (.append exp (unchecked-subtract-int len 1))))
                          (.append mant coeff 1 len)))
                    (do
                      (.append mant coeff)
                      (when (identical? form BigDecimalLayoutForm/SCIENTIFIC)
                        (set! exp (StringBuilder. "+00")))))
              (identical? form BigDecimalLayoutForm/DECIMAL_FLOAT)
                (cond
                  (>= scale len)
                    (do
                      (.append mant "0.")
                      (set! dot true)
                      (.trailingZeros FormatSpecifier/this mant (unchecked-subtract-int scale len))
                      (.append mant coeff))
                  (> scale 0)
                    (let [pad (unchecked-subtract-int len scale)]
                      (.append mant coeff 0 pad)
                      (.append mant \.)
                      (set! dot true)
                      (.append mant coeff pad len))
                  :else
                    (do
                      (.append mant coeff 0 len)
                      (when-not (== (.signum intVal) 0)
                        (.trailingZeros FormatSpecifier/this mant (unchecked-negate-int scale)))
                      (set! (.-scale this) 0)))
              :else
                (do
                  (.append mant (.charAt coeff 0))
                  (when (> len 1) (.append mant \.) (set! dot true) (.append mant coeff 1 len))
                  (set! exp (StringBuilder.))
                  (let [adjusted (unchecked-add (unchecked-negate (long scale))
                                                (unchecked-subtract-int len 1))]
                    (if (not (== adjusted 0))
                        (let [abs (Math/abs adjusted)]
                          (.append exp (if (< adjusted 0) \- \+))
                          (when (< abs 10) (.append exp \0))
                          (.append exp abs))
                        (.append exp "+00")))))))))

    (method ^:private adjustWidth ^int [this ^int width ^int flags ^boolean neg]
      (let [^:mutable newW width]
        (when (and (and (not (== newW -1)) neg) (Flags/contains flags Flags/PARENTHESES))
          (set! newW (unchecked-dec-int newW)))
        newW))

    (method ^:private trailingZeros ^void [this ^StringBuilder sb ^int nzeros]
      (when (> nzeros 0) (.repeat sb \0 nzeros)))

    (method ^:private print :throws [IOException] ^void [this ^Formatter fmt ^Calendar t ^char c
                                                         ^Locale l]
      (let [sb (StringBuilder.)]
        (.print this fmt sb t c l)
        (if (Flags/contains flags Flags/UPPERCASE)
            (.appendJustified this (.-a fmt) (.toUpperCaseWithLocale this (.toString sb) l))
            (.appendJustified this (.-a fmt) sb))))

    (method ^:private print :throws [IOException] ^Appendable [this ^Formatter fmt
                                                               ^:mutable ^StringBuilder sb
                                                               ^Calendar t ^char c ^Locale l]
      (when (nil? sb) (set! sb (StringBuilder.)))
      (switch c
        (DateTime/HOUR_OF_DAY_0 DateTime/HOUR_0 DateTime/HOUR_OF_DAY DateTime/HOUR)
          (let [^:mutable i (.get t Calendar/HOUR_OF_DAY)]
            (when (or (== c DateTime/HOUR_0) (== c DateTime/HOUR))
              (set! i (if (or (== i 0) (== i 12)) 12 (unchecked-remainder-int i 12))))
            (let [^int flags (if (or (== c DateTime/HOUR_OF_DAY_0) (== c DateTime/HOUR_0))
                                 Flags/ZERO_PAD
                                 Flags/NONE)]
              (.append sb (.localizedMagnitude this fmt nil i flags 2 l))))
        DateTime/MINUTE
          (let [i (.get t Calendar/MINUTE)]
            (.append sb (.localizedMagnitude this fmt nil i Flags/ZERO_PAD 2 l)))
        DateTime/NANOSECOND
          (let [i (unchecked-multiply-int (.get t Calendar/MILLISECOND) 1000000)]
            (.append sb (.localizedMagnitude this fmt nil i Flags/ZERO_PAD 9 l)))
        DateTime/MILLISECOND
          (let [i (.get t Calendar/MILLISECOND)]
            (.append sb (.localizedMagnitude this fmt nil i Flags/ZERO_PAD 3 l)))
        DateTime/MILLISECOND_SINCE_EPOCH
          (let [i (.getTimeInMillis t)]
            (.append sb (.localizedMagnitude this fmt nil i Flags/NONE width l)))
        DateTime/AM_PM
          (let [^:mutable ampm (new String/1 ["AM" "PM"])]
            (when (and (some? l) (not (identical? l Locale/US)))
              (let [dfs (DateFormatSymbols/getInstance l)] (set! ampm (.getAmPmStrings dfs))))
            (let [s (aget ampm (.get t Calendar/AM_PM))]
              (.append sb
                       (.toLowerCase s
                                     (cast Locale
                                           (Objects/requireNonNullElse
                                             l
                                             (Locale/getDefault Locale$Category/FORMAT)))))))
        DateTime/SECONDS_SINCE_EPOCH
          (let [i (unchecked-divide (.getTimeInMillis t) 1000)]
            (.append sb (.localizedMagnitude this fmt nil i Flags/NONE width l)))
        DateTime/SECOND
          (let [i (.get t Calendar/SECOND)]
            (.append sb (.localizedMagnitude this fmt nil i Flags/ZERO_PAD 2 l)))
        DateTime/ZONE_NUMERIC
          (let [^:mutable i (unchecked-add-int (.get t Calendar/ZONE_OFFSET)
                                               (.get t Calendar/DST_OFFSET))
                neg (< i 0)]
            (.append sb (if neg \- \+))
            (when neg (set! i (unchecked-negate-int i)))
            (let [min (unchecked-divide-int i 60000)
                  offset (unchecked-add-int
                           (unchecked-multiply-int (unchecked-divide-int min 60) 100)
                           (unchecked-remainder-int min 60))]
              (.append sb (.localizedMagnitude this fmt nil offset Flags/ZERO_PAD 4 l))))
        DateTime/ZONE
          (let [tz (.getTimeZone t)]
            (.append sb
                     (.getDisplayName tz
                                      (not (== (.get t Calendar/DST_OFFSET) 0))
                                      TimeZone/SHORT
                                      (cast Locale (Objects/requireNonNullElse l Locale/US)))))
        (DateTime/NAME_OF_DAY_ABBREV DateTime/NAME_OF_DAY)
          (let [i (.get t Calendar/DAY_OF_WEEK)
                lt (cast Locale (Objects/requireNonNullElse l Locale/US))
                dfs (DateFormatSymbols/getInstance lt)]
            (if (== c DateTime/NAME_OF_DAY)
                (.append sb (aget (.getWeekdays dfs) i))
                (.append sb (aget (.getShortWeekdays dfs) i))))
        (DateTime/NAME_OF_MONTH_ABBREV DateTime/NAME_OF_MONTH_ABBREV_X DateTime/NAME_OF_MONTH)
          (let [i (.get t Calendar/MONTH)
                lt (cast Locale (Objects/requireNonNullElse l Locale/US))
                dfs (DateFormatSymbols/getInstance lt)]
            (if (== c DateTime/NAME_OF_MONTH)
                (.append sb (aget (.getMonths dfs) i))
                (.append sb (aget (.getShortMonths dfs) i))))
        (DateTime/CENTURY DateTime/YEAR_2 DateTime/YEAR_4)
          (let [^:mutable i (.get t Calendar/YEAR)
                ^:mutable ^int size 2]
            (switch c
              DateTime/CENTURY (set! i (unchecked-divide-int i 100))
              DateTime/YEAR_2 (set! i (unchecked-remainder-int i 100))
              DateTime/YEAR_4 (set! size 4))
            (.append sb (.localizedMagnitude this fmt nil i Flags/ZERO_PAD size l)))
        (DateTime/DAY_OF_MONTH_0 DateTime/DAY_OF_MONTH)
          (let [i (.get t Calendar/DATE)
                ^int flags (if (== c DateTime/DAY_OF_MONTH_0) Flags/ZERO_PAD Flags/NONE)]
            (.append sb (.localizedMagnitude this fmt nil i flags 2 l)))
        DateTime/DAY_OF_YEAR
          (let [i (.get t Calendar/DAY_OF_YEAR)]
            (.append sb (.localizedMagnitude this fmt nil i Flags/ZERO_PAD 3 l)))
        DateTime/MONTH
          (let [i (unchecked-add-int (.get t Calendar/MONTH) 1)]
            (.append sb (.localizedMagnitude this fmt nil i Flags/ZERO_PAD 2 l)))
        (DateTime/TIME DateTime/TIME_24_HOUR)
          (let [sep \:]
            (.append (.print this fmt sb t DateTime/HOUR_OF_DAY_0 l) sep)
            (.print this fmt sb t DateTime/MINUTE l)
            (when (== c DateTime/TIME) (.append sb sep) (.print this fmt sb t DateTime/SECOND l)))
        DateTime/TIME_12_HOUR
          (let [sep \:]
            (.append (.print this fmt sb t DateTime/HOUR_0 l) sep)
            (.append (.print this fmt sb t DateTime/MINUTE l) sep)
            (.append (.print this fmt sb t DateTime/SECOND l) \space)
            (let [tsb (StringBuilder.)]
              (.print this fmt tsb t DateTime/AM_PM l)
              (.append sb (.toUpperCaseWithLocale this (.toString tsb) l))))
        DateTime/DATE_TIME
          (let [sep \space]
            (.append (.print this fmt sb t DateTime/NAME_OF_DAY_ABBREV l) sep)
            (.append (.print this fmt sb t DateTime/NAME_OF_MONTH_ABBREV l) sep)
            (.append (.print this fmt sb t DateTime/DAY_OF_MONTH_0 l) sep)
            (.append (.print this fmt sb t DateTime/TIME l) sep)
            (.append (.print this fmt sb t DateTime/ZONE l) sep)
            (.print this fmt sb t DateTime/YEAR_4 l))
        DateTime/DATE
          (let [sep \/]
            (.append (.print this fmt sb t DateTime/MONTH l) sep)
            (.append (.print this fmt sb t DateTime/DAY_OF_MONTH_0 l) sep)
            (.print this fmt sb t DateTime/YEAR_2 l))
        DateTime/ISO_STANDARD_DATE
          (let [sep \-]
            (.append (.print this fmt sb t DateTime/YEAR_4 l) sep)
            (.append (.print this fmt sb t DateTime/MONTH l) sep)
            (.print this fmt sb t DateTime/DAY_OF_MONTH_0 l))
        (java-assert false))
      sb)

    (method ^:private print :throws [IOException] ^void [this ^Formatter fmt ^TemporalAccessor t
                                                         ^char c ^Locale l]
      (let [sb (StringBuilder.)]
        (.print this fmt sb t c l)
        (if (Flags/contains flags Flags/UPPERCASE)
            (.appendJustified this (.-a fmt) (.toUpperCaseWithLocale this (.toString sb) l))
            (.appendJustified this (.-a fmt) sb))))

    (method ^:private print :throws [IOException] ^Appendable [this ^Formatter fmt
                                                               ^:mutable ^StringBuilder sb
                                                               ^TemporalAccessor t ^char c ^Locale l]
      (when (nil? sb) (set! sb (StringBuilder.)))
      (try
        (switch c
          DateTime/HOUR_OF_DAY_0
            (let [i (.get t ChronoField/HOUR_OF_DAY)]
              (.append sb (.localizedMagnitude this fmt nil i Flags/ZERO_PAD 2 l)))
          DateTime/HOUR_OF_DAY
            (let [i (.get t ChronoField/HOUR_OF_DAY)]
              (.append sb (.localizedMagnitude this fmt nil i Flags/NONE 2 l)))
          DateTime/HOUR_0
            (let [i (.get t ChronoField/CLOCK_HOUR_OF_AMPM)]
              (.append sb (.localizedMagnitude this fmt nil i Flags/ZERO_PAD 2 l)))
          DateTime/HOUR
            (let [i (.get t ChronoField/CLOCK_HOUR_OF_AMPM)]
              (.append sb (.localizedMagnitude this fmt nil i Flags/NONE 2 l)))
          DateTime/MINUTE
            (let [i (.get t ChronoField/MINUTE_OF_HOUR)]
              (.append sb (.localizedMagnitude this fmt nil i Flags/ZERO_PAD 2 l)))
          DateTime/NANOSECOND
            (let [^:mutable ^int i 0]
              (try
                (set! i (.get t ChronoField/NANO_OF_SECOND))
                (catch UnsupportedTemporalTypeException u
                  (set! i (unchecked-multiply-int (.get t ChronoField/MILLI_OF_SECOND) 1000000))))
              (.append sb (.localizedMagnitude this fmt nil i Flags/ZERO_PAD 9 l)))
          DateTime/MILLISECOND
            (let [i (.get t ChronoField/MILLI_OF_SECOND)]
              (.append sb (.localizedMagnitude this fmt nil i Flags/ZERO_PAD 3 l)))
          DateTime/MILLISECOND_SINCE_EPOCH
            (let [i (unchecked-add
                      (unchecked-multiply (.getLong t ChronoField/INSTANT_SECONDS) 1000)
                      (.getLong t ChronoField/MILLI_OF_SECOND))]
              (.append sb (.localizedMagnitude this fmt nil i Flags/NONE width l)))
          DateTime/AM_PM
            (let [^:mutable ampm (new String/1 ["AM" "PM"])]
              (when (and (some? l) (not (identical? l Locale/US)))
                (let [dfs (DateFormatSymbols/getInstance l)] (set! ampm (.getAmPmStrings dfs))))
              (let [s (aget ampm (.get t ChronoField/AMPM_OF_DAY))]
                (.append sb
                         (.toLowerCase s
                                       (cast Locale
                                             (Objects/requireNonNullElse
                                               l
                                               (Locale/getDefault Locale$Category/FORMAT)))))))
          DateTime/SECONDS_SINCE_EPOCH
            (let [i (.getLong t ChronoField/INSTANT_SECONDS)]
              (.append sb (.localizedMagnitude this fmt nil i Flags/NONE width l)))
          DateTime/SECOND
            (let [i (.get t ChronoField/SECOND_OF_MINUTE)]
              (.append sb (.localizedMagnitude this fmt nil i Flags/ZERO_PAD 2 l)))
          DateTime/ZONE_NUMERIC
            (let [^:mutable i (.get t ChronoField/OFFSET_SECONDS)
                  neg (< i 0)]
              (.append sb (if neg \- \+))
              (when neg (set! i (unchecked-negate-int i)))
              (let [min (unchecked-divide-int i 60)
                    offset (unchecked-add-int
                             (unchecked-multiply-int (unchecked-divide-int min 60) 100)
                             (unchecked-remainder-int min 60))]
                (.append sb (.localizedMagnitude this fmt nil offset Flags/ZERO_PAD 4 l))))
          DateTime/ZONE
            (let [zid (cast ZoneId (.query t (TemporalQueries/zone)))]
              (when (nil? zid) (throw (IllegalFormatConversionException. c (.getClass t))))
              (if (and (not (instance? ZoneOffset zid))
                       (.isSupported t ChronoField/INSTANT_SECONDS))
                  (let [instant (Instant/from t)]
                    (.append sb
                             (.getDisplayName
                               (TimeZone/getTimeZone (.getId zid))
                               (.isDaylightSavings (.getRules zid) instant)
                               TimeZone/SHORT
                               (cast Locale (Objects/requireNonNullElse l Locale/US)))))
                  (.append sb (.getId zid))))
          (DateTime/NAME_OF_DAY_ABBREV DateTime/NAME_OF_DAY)
            (let [i (unchecked-add-int (unchecked-remainder-int (.get t ChronoField/DAY_OF_WEEK) 7)
                                       1)
                  lt (cast Locale (Objects/requireNonNullElse l Locale/US))
                  dfs (DateFormatSymbols/getInstance lt)]
              (if (== c DateTime/NAME_OF_DAY)
                  (.append sb (aget (.getWeekdays dfs) i))
                  (.append sb (aget (.getShortWeekdays dfs) i))))
          (DateTime/NAME_OF_MONTH_ABBREV DateTime/NAME_OF_MONTH_ABBREV_X DateTime/NAME_OF_MONTH)
            (let [i (unchecked-subtract-int (.get t ChronoField/MONTH_OF_YEAR) 1)
                  lt (cast Locale (Objects/requireNonNullElse l Locale/US))
                  dfs (DateFormatSymbols/getInstance lt)]
              (if (== c DateTime/NAME_OF_MONTH)
                  (.append sb (aget (.getMonths dfs) i))
                  (.append sb (aget (.getShortMonths dfs) i))))
          (DateTime/CENTURY DateTime/YEAR_2 DateTime/YEAR_4)
            (let [^:mutable i (.get t ChronoField/YEAR_OF_ERA)
                  ^:mutable ^int size 2]
              (switch c
                DateTime/CENTURY (set! i (unchecked-divide-int i 100))
                DateTime/YEAR_2 (set! i (unchecked-remainder-int i 100))
                DateTime/YEAR_4 (set! size 4))
              (.append sb (.localizedMagnitude this fmt nil i Flags/ZERO_PAD size l)))
          (DateTime/DAY_OF_MONTH_0 DateTime/DAY_OF_MONTH)
            (let [i (.get t ChronoField/DAY_OF_MONTH)
                  ^int flags (if (== c DateTime/DAY_OF_MONTH_0) Flags/ZERO_PAD Flags/NONE)]
              (.append sb (.localizedMagnitude this fmt nil i flags 2 l)))
          DateTime/DAY_OF_YEAR
            (let [i (.get t ChronoField/DAY_OF_YEAR)]
              (.append sb (.localizedMagnitude this fmt nil i Flags/ZERO_PAD 3 l)))
          DateTime/MONTH
            (let [i (.get t ChronoField/MONTH_OF_YEAR)]
              (.append sb (.localizedMagnitude this fmt nil i Flags/ZERO_PAD 2 l)))
          (DateTime/TIME DateTime/TIME_24_HOUR)
            (let [sep \:]
              (.append (.print this fmt sb t DateTime/HOUR_OF_DAY_0 l) sep)
              (.print this fmt sb t DateTime/MINUTE l)
              (when (== c DateTime/TIME) (.append sb sep) (.print this fmt sb t DateTime/SECOND l)))
          DateTime/TIME_12_HOUR
            (let [sep \:]
              (.append (.print this fmt sb t DateTime/HOUR_0 l) sep)
              (.append (.print this fmt sb t DateTime/MINUTE l) sep)
              (.append (.print this fmt sb t DateTime/SECOND l) \space)
              (let [tsb (StringBuilder.)]
                (.print this fmt tsb t DateTime/AM_PM l)
                (.append sb (.toUpperCaseWithLocale this (.toString tsb) l))))
          DateTime/DATE_TIME
            (let [sep \space]
              (.append (.print this fmt sb t DateTime/NAME_OF_DAY_ABBREV l) sep)
              (.append (.print this fmt sb t DateTime/NAME_OF_MONTH_ABBREV l) sep)
              (.append (.print this fmt sb t DateTime/DAY_OF_MONTH_0 l) sep)
              (.append (.print this fmt sb t DateTime/TIME l) sep)
              (.append (.print this fmt sb t DateTime/ZONE l) sep)
              (.print this fmt sb t DateTime/YEAR_4 l))
          DateTime/DATE
            (let [sep \/]
              (.append (.print this fmt sb t DateTime/MONTH l) sep)
              (.append (.print this fmt sb t DateTime/DAY_OF_MONTH_0 l) sep)
              (.print this fmt sb t DateTime/YEAR_2 l))
          DateTime/ISO_STANDARD_DATE
            (let [sep \-
                  ^ChronoField yearField (if (instance?
                                               IsoChronology
                                               (.query t (TemporalQueries/chronology)))
                                             ChronoField/YEAR
                                             ChronoField/YEAR_OF_ERA)]
              (let [^:mutable year (.get t yearField)]
                (cond
                  (< year 0)
                    (do
                      (.append sb (Formatter/getMinusSign l))
                      (set! year (unchecked-negate-int year)))
                  (> year 9999) (.append sb \+))
                (.append (.append sb (.localizedMagnitude this fmt nil year Flags/ZERO_PAD 4 l))
                         sep)
                (.append (.print this fmt sb t DateTime/MONTH l) sep)
                (.print this fmt sb t DateTime/DAY_OF_MONTH_0 l)))
          (java-assert false))
        (catch DateTimeException x (throw (IllegalFormatConversionException. c (.getClass t)))))
      sb)

    (method ^:private failMismatch ^void [this ^int f ^char c]
      (let [fs (Flags/toString f)] (throw (FormatFlagsConversionMismatchException. fs c))))

    (method ^:private failConversion ^void [this ^char c arg]
      (throw (IllegalFormatConversionException. c (.getClass arg))))

    (method ^:private localizedMagnitude ^StringBuilder [this ^Formatter fmt ^StringBuilder sb
                                                         ^long value ^int flags ^int width ^Locale l]
      (.localizedMagnitude this fmt sb (Long/toString value 10) 0 flags width l))

    (method ^:private localizedMagnitude ^StringBuilder [this ^Formatter fmt
                                                         ^:mutable ^StringBuilder sb
                                                         ^CharSequence value ^:final ^int offset
                                                         ^int f ^int width ^Locale l]
      (when (nil? sb) (set! sb (StringBuilder.)))
      (let [begin (.length sb)
            zero (Formatter/getZero l)
            ^:mutable grpSep \u0000
            ^:mutable ^int grpSize -1
            ^:mutable decSep \u0000
            len (.length value)
            ^:mutable dot len]
        (loop [^int j offset]
          (if (< j len)
              (if (== (.charAt value j) \.) (set! dot j) (recur (unchecked-inc-int j)))
              nil))
        (when (< dot len) (set! decSep (Formatter/getDecimalSeparator l)))
        (when (Flags/contains f Flags/GROUP)
          (set! grpSep (Formatter/getGroupingSeparator l))
          (if (or (nil? l) (.equals l Locale/US))
              (set! grpSize 3)
              (let [^:mutable ^DecimalFormat df nil
                    nf (NumberFormat/getNumberInstance l)]
                (if (instance? DecimalFormat nf)
                    (set! df (cast DecimalFormat nf))
                    (let [^:mutable adapter (LocaleProviderAdapter/getAdapter
                                              NumberFormatProvider
                                              l)]
                      (when-not (instance? ResourceBundleBasedAdapter adapter)
                        (set! adapter (LocaleProviderAdapter/getResourceBundleBased)))
                      (let [all (.getNumberPatterns (.getLocaleResources adapter l))]
                        (set! df
                              (DecimalFormat. (aget all 0) (Formatter/getDecimalFormatSymbols l))))))
                (set! grpSize (.getGroupingSize df))
                (when (or (not (.isGroupingUsed df)) (== grpSize 0)) (set! grpSep \u0000)))))
        (loop [^int j offset]
          (if (< j len)
              (if (== j dot)
                  (do (.append sb decSep) (set! grpSep \u0000) (recur (unchecked-inc-int j)))
                  (let [c (.charAt value j)]
                    (.append
                      sb
                      (unchecked-char (unchecked-add-int (unchecked-subtract-int c \0) zero)))
                    (if (and
                          (and (not (== grpSep \u0000)) (not (== j (unchecked-subtract-int dot 1))))
                          (== (unchecked-remainder-int (unchecked-subtract-int dot j) grpSize) 1))
                        (do (.append sb grpSep) (recur (unchecked-inc-int j)))
                        (recur (unchecked-inc-int j)))))
              nil))
        (when (and (> width (.length sb)) (Flags/contains f Flags/ZERO_PAD))
          (let [zeros (.repeat (String/valueOf zero) (unchecked-subtract-int width (.length sb)))]
            (.insert sb begin zeros)))
        sb))

    (method ^:private localizedMagnitudeExp ^void [this ^Formatter fmt ^StringBuilder sb
                                                   ^char/1 value ^:final ^int offset ^Locale l]
      (let [zero (Formatter/getZero l)
            len (alength value)]
        (loop [^int j offset]
          (when (< j len)
            (let [c (aget value j)]
              (.append sb (unchecked-char (unchecked-add-int (unchecked-subtract-int c \0) zero)))
              (recur (unchecked-inc-int j))))))))

  (defclass ^:static Flags
    (field ^:static ^:final ^int NONE 0)

    (field ^:static ^:final ^int LEFT_JUSTIFY (bit-shift-left-int 1 0))

    (field ^:static ^:final ^int UPPERCASE (bit-shift-left-int 1 1))

    (field ^:static ^:final ^int ALTERNATE (bit-shift-left-int 1 2))

    (field ^:static ^:final ^int PLUS (bit-shift-left-int 1 3))

    (field ^:static ^:final ^int LEADING_SPACE (bit-shift-left-int 1 4))

    (field ^:static ^:final ^int ZERO_PAD (bit-shift-left-int 1 5))

    (field ^:static ^:final ^int GROUP (bit-shift-left-int 1 6))

    (field ^:static ^:final ^int PARENTHESES (bit-shift-left-int 1 7))

    (field ^:static ^:final ^int PREVIOUS (bit-shift-left-int 1 8))

    (method ^:public ^:static contains ^boolean [^int flags ^int f]
      (== (bit-and-int flags f) f))

    (method ^:public ^:static containsAny ^boolean [^int flags ^int f]
      (not (== (bit-and-int flags f) 0)))

    (method ^:private ^:static add ^int [^int flags ^int f]
      (bit-or-int flags f))

    (method ^:public ^:static remove ^int [^int flags ^int f]
      (bit-and-int flags (bit-not-int f)))

    (method ^:public ^:static parse ^int [^String s ^int start ^int end]
      (let [^:mutable ^int f 0]
        (loop [^int i start]
          (when (< i end)
            (let [c (.charAt s i)
                  v (Flags/parse c)]
              (when (Flags/contains f v)
                (throw (DuplicateFormatFlagsException. (Flags/toString v))))
              (set! f (Flags/add f v))
              (recur (unchecked-inc-int i)))))
        f))

    (method ^:private ^:static parse ^int [^char c]
      (switch c
        \- LEFT_JUSTIFY
        \# ALTERNATE
        \+ PLUS
        \space LEADING_SPACE
        \0 ZERO_PAD
        \, GROUP
        \( PARENTHESES
        \< PREVIOUS
        (throw (UnknownFormatFlagsException. (String/valueOf c)))))

    (method ^:private ^:static isFlag ^boolean [^char c]
      (switch c (\- \# \+ \space \0 \, \( \<) true false))

    (method ^:public ^:static toString ^String [^int f]
      (let [sb (StringBuilder.)]
        (when (Flags/contains f LEFT_JUSTIFY) (.append sb \-))
        (when (Flags/contains f UPPERCASE) (.append sb \^))
        (when (Flags/contains f ALTERNATE) (.append sb \#))
        (when (Flags/contains f PLUS) (.append sb \+))
        (when (Flags/contains f LEADING_SPACE) (.append sb \space))
        (when (Flags/contains f ZERO_PAD) (.append sb \0))
        (when (Flags/contains f GROUP) (.append sb \,))
        (when (Flags/contains f PARENTHESES) (.append sb \())
        (when (Flags/contains f PREVIOUS) (.append sb \<))
        (.toString sb))))

  (defclass ^:static Conversion
    (field ^:static ^:final ^char DECIMAL_INTEGER \d)

    (field ^:static ^:final ^char OCTAL_INTEGER \o)

    (field ^:static ^:final ^char HEXADECIMAL_INTEGER \x)

    (field ^:static ^:final ^char HEXADECIMAL_INTEGER_UPPER \X)

    (field ^:static ^:final ^char SCIENTIFIC \e)

    (field ^:static ^:final ^char SCIENTIFIC_UPPER \E)

    (field ^:static ^:final ^char GENERAL \g)

    (field ^:static ^:final ^char GENERAL_UPPER \G)

    (field ^:static ^:final ^char DECIMAL_FLOAT \f)

    (field ^:static ^:final ^char HEXADECIMAL_FLOAT \a)

    (field ^:static ^:final ^char HEXADECIMAL_FLOAT_UPPER \A)

    (field ^:static ^:final ^char CHARACTER \c)

    (field ^:static ^:final ^char CHARACTER_UPPER \C)

    (field ^:static ^:final ^char DATE_TIME \t)

    (field ^:static ^:final ^char DATE_TIME_UPPER \T)

    (field ^:static ^:final ^char BOOLEAN \b)

    (field ^:static ^:final ^char BOOLEAN_UPPER \B)

    (field ^:static ^:final ^char STRING \s)

    (field ^:static ^:final ^char STRING_UPPER \S)

    (field ^:static ^:final ^char HASHCODE \h)

    (field ^:static ^:final ^char HASHCODE_UPPER \H)

    (field ^:static ^:final ^char LINE_SEPARATOR \n)

    (field ^:static ^:final ^char PERCENT_SIGN \%)

    (method ^:static isValid ^boolean [^char c]
      (switch c
        (BOOLEAN BOOLEAN_UPPER
                 STRING
                 STRING_UPPER
                 HASHCODE
                 HASHCODE_UPPER
                 CHARACTER
                 CHARACTER_UPPER
                 DECIMAL_INTEGER
                 OCTAL_INTEGER
                 HEXADECIMAL_INTEGER
                 HEXADECIMAL_INTEGER_UPPER
                 SCIENTIFIC
                 SCIENTIFIC_UPPER
                 GENERAL
                 GENERAL_UPPER
                 DECIMAL_FLOAT
                 HEXADECIMAL_FLOAT
                 HEXADECIMAL_FLOAT_UPPER
                 LINE_SEPARATOR)
          true
        (== c PERCENT_SIGN)))

    (method ^:static isGeneral ^boolean [^char c]
      (switch c (BOOLEAN BOOLEAN_UPPER STRING STRING_UPPER HASHCODE HASHCODE_UPPER) true false))

    (method ^:static isCharacter ^boolean [^char c]
      (switch c (CHARACTER CHARACTER_UPPER) true false))

    (method ^:static isInteger ^boolean [^char c]
      (switch c
        (DECIMAL_INTEGER OCTAL_INTEGER HEXADECIMAL_INTEGER HEXADECIMAL_INTEGER_UPPER) true
        false))

    (method ^:static isFloat ^boolean [^char c]
      (switch c
        (SCIENTIFIC SCIENTIFIC_UPPER
                    GENERAL
                    GENERAL_UPPER
                    DECIMAL_FLOAT
                    HEXADECIMAL_FLOAT
                    HEXADECIMAL_FLOAT_UPPER)
          true
        false))

    (method ^:static isText ^boolean [^char c]
      (switch c (LINE_SEPARATOR PERCENT_SIGN) true false)))

  (defclass ^:static DateTime
    (field ^:static ^:final ^char HOUR_OF_DAY_0 \H)

    (field ^:static ^:final ^char HOUR_0 \I)

    (field ^:static ^:final ^char HOUR_OF_DAY \k)

    (field ^:static ^:final ^char HOUR \l)

    (field ^:static ^:final ^char MINUTE \M)

    (field ^:static ^:final ^char NANOSECOND \N)

    (field ^:static ^:final ^char MILLISECOND \L)

    (field ^:static ^:final ^char MILLISECOND_SINCE_EPOCH \Q)


        (.writeInt s length)
        (.writeInt s count)
        (loop [^int i (unchecked-subtract-int (.size entryStack) 1)]
          (when (>= i 0) (.writeObject s (.get entryStack i)) (recur (unchecked-dec-int i)))))))

  (method readHashtable :throws [IOException ClassNotFoundException] ^void [this
                                                                            ^ObjectInputStream s]
    (.defaultReadObject s)
    (let [origlength (.readInt s)
          ^:mutable elements (.readInt s)]
      (when (< elements 0)
        (throw (StreamCorruptedException. (java-str "Illegal # of Elements: " elements))))
      (.checkArray (SharedSecrets/getJavaObjectInputStreamAccess)
                   s
                   Map$Entry/1
                   (HashMap/tableSizeFor (unchecked-int (unchecked-divide elements 0.75))))
      (let [map (ConcurrentHashMap. elements)]
        (while (> elements 0)
          (let [key (.readObject s) value (.readObject s)] (.put map key value))
          (set! elements (unchecked-dec-int elements)))
        (set! (.-map this) map)))))

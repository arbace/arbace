                      LENGTH (do (set! mode DONE) (set! ret Z_STREAM_END) (break))
                      DONE (do (set! ret Z_STREAM_END) (break))
                      BAD (do (set! ret Z_DATA_ERROR) (break))
                      MEM (return Z_MEM_ERROR)
                      (return Z_STREAM_ERROR)))))
              (set! nextOutIndex put)
              (set! availOut left)
              (set! nextInIndex next)
              (set! availIn have)
              (set! (.-hold this) hold)
              (set! (.-bits this) bits)

                                    (unchecked-add
                                      hold
                                      (bit-shift-left
                                        (long (bit-and-int (aget input next) 0xff))
                                        bits)))
                              (set! next (unchecked-inc-int next))
                              (set! bits (unchecked-add-int bits 8)))
                            (set! offset
                                  (unchecked-add-int
                                    offset
                                    (bit-and-int
                                      (unchecked-int hold)
                                      (unchecked-subtract-int (bit-shift-left-int 1 extra) 1))))

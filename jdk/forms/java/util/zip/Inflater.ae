    (method inflateSetDictionary ^int [this ^byte/1 dictionary ^int off ^int dictLength]
      (if (and (not (== wrap 0)) (not (== mode DICT)))
          Z_STREAM_ERROR
          (do
            (when (== mode DICT)
              (let [dictid (IState/adler32 1 dictionary off dictLength)]
                (when-not (== dictid check) (return Z_DATA_ERROR))))
            (.updatewindow this dictionary (unchecked-add-int off dictLength) dictLength)
            (set! havedict true)
            Z_OK)))

    (method ^:static inflate_table ^int [^int type ^short/1 lens ^int off ^int codes ^int/1 table
                                         ^int/1 nextp ^int/1 bitsp ^short/1 work]
      (let [^:mutable ^int len 0
            ^:mutable ^int sym 0
            ^:mutable ^int min 0
            ^:mutable ^int max 0
            ^:mutable ^int root 0
            ^:mutable ^int curr 0
            ^:mutable ^int drop 0
            ^:mutable ^int left 0
            ^:mutable ^int used 0
            ^:mutable ^int huff 0
            ^:mutable ^int incr 0
            ^:mutable ^int fill 0
            ^:mutable ^int low 0
            ^:mutable ^int mask 0
            ^:mutable ^int hereOp 0
            ^:mutable ^int hereBits 0
            ^:mutable ^int hereVal 0
            ^:mutable ^int next 0
            ^:mutable ^short/1 base nil
            ^:mutable ^short/1 extra nil
            ^:mutable ^int match 0
            count (new short/1 (unchecked-add-int MAXBITS 1))
            offs (new short/1 (unchecked-add-int MAXBITS 1))
            tableStart (aget nextp 0)]
        (set! len 0)
        (while (<= len MAXBITS) (aset count len 0) (set! len (unchecked-inc-int len)))
        (set! sym 0)
        (while (< sym codes)
          (let [i-15 (aget lens (unchecked-add-int off sym))]

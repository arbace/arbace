                              (set! here
                                    (aget distcode
                                          (unchecked-add-int
                                            (unchecked-add-int distIndex (IState/val last))
                                            (unsigned-bit-shift-right-int
                                              (bit-and-int
                                                (unchecked-int hold)
                                                (unchecked-subtract-int
                                                  (bit-shift-left-int
                                                    1
                                                    (unchecked-add-int
                                                      (IState/bits last)
                                                      (IState/op last)))
                                                  1))
                                              (IState/bits last)))))

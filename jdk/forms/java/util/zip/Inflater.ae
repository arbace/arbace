                                                len
                                                (unchecked-short
                                                  (unchecked-dec-int (aget count len))))
                                          0)
                                  (when (== len max) (break))
                                  (set! len
                                        (aget lens
                                              (unchecked-add-int
                                                off
                                                (bit-and-int (aget work sym) 0xffff)))))

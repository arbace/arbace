                      DIST
                        (do
                          (while true
                            (set! here
                                  (aget distcode
                                        (unchecked-add-int
                                          distIndex
                                          (bit-and-int
                                            (unchecked-int hold)
                                            (unchecked-subtract-int
                                              (bit-shift-left-int 1 distbits)
                                              1)))))
                            (when (<= (IState/bits here) bits) (break))

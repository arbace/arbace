                                (>= w match)
                                  (do
                                    (set! hereOp
                                          (bit-and-int
                                            (aget extra (unchecked-subtract-int w match))
                                            0xff))
                                    (set! hereVal
                                          (bit-and-int
                                            (aget base (unchecked-subtract-int w match))
                                            0xffff)))
                                :else (do (set! hereOp (unchecked-add-int 32 64)) (set! hereVal 0)))
                              (let [here (IState/code hereOp hereBits hereVal)]
                                (set! incr (bit-shift-left-int 1 (unchecked-subtract-int len drop)))
                                (set! fill (bit-shift-left-int 1 curr))
                                (set! min fill)
                                (loop []
                                  (set! fill (unchecked-subtract-int fill incr))
                                  (aset table
                                        (unchecked-add-int
                                          (unchecked-add-int
                                            next
                                            (unsigned-bit-shift-right-int huff drop))
                                          fill)
                                        here)

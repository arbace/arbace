                      CODES (set! match 20)
                      LENS (do (set! base lbase) (set! extra lext) (set! match 257))
                      (do (set! base dbase) (set! extra dext)))
                    (set! huff 0)
                    (set! sym 0)
                    (set! len min)
                    (set! next tableStart)
                    (set! curr root)
                    (set! drop 0)
                    (set! low -1)
                    (set! used (bit-shift-left-int 1 root))
                    (set! mask (unchecked-subtract-int used 1))

                                    (when (<= left 0) (break))
                                    (set! curr (unchecked-inc-int curr))
                                    (set! left (bit-shift-left-int left 1)))
                                  (set! used (unchecked-add-int used (bit-shift-left-int 1 curr)))
                                  (when (or (and (== type LENS) (> used ENOUGH_LENS))
                                            (and (== type DISTS) (> used ENOUGH_DISTS)))
                                    (return 1))
                                  (set! low (bit-and-int huff mask))
                                  (aset table
                                        (unchecked-add-int tableStart low)
                                        (IState/code
                                          curr
                                          root
                                          (unchecked-subtract-int next tableStart)))))))
                          (when-not (== huff 0)
                            (aset table
                                  (unchecked-add-int next huff)
                                  (IState/code 64 (unchecked-subtract-int len drop) 0)))

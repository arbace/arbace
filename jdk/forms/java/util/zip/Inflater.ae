                              (set! have (unchecked-dec-int have))
                              (set! hold
                                    (unchecked-add
                                      hold
                                      (bit-shift-left
                                        (long (bit-and-int (aget input next) 0xff))
                                        bits)))
                              (set! next (unchecked-inc-int next))
                              (set! bits (unchecked-add-int bits 8)))
                            (set! hold (unsigned-bit-shift-right hold (IState/bits last)))
                            (set! bits (unchecked-subtract-int bits (IState/bits last)))

          (set! sym (unchecked-inc-int sym)))
        (set! root (aget bitsp 0))
        (set! max MAXBITS)
        (while (>= max 1)
          (when-not (== (aget count max) 0) (break))
          (set! max (unchecked-dec-int max)))
        (when (> root max) (set! root max))
        (if (== max 0)
            (let [c (IState/code 64 1 0)]
              (aset table
                    (let [old-16 (aget nextp 0)]
                      (aset nextp 0 (unchecked-inc-int (aget nextp 0)))
                      old-16)
                    c)
              (aset table
                    (let [old-17 (aget nextp 0)]
                      (aset nextp 0 (unchecked-inc-int (aget nextp 0)))
                      old-17)
                    c)
              (aset bitsp 0 1)
              0)

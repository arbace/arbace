                          (when (== left 0) (break))
                          (set! copy (unchecked-subtract-int out left))
                          (if (> offset copy)
                              (do
                                (set! copy (unchecked-subtract-int offset copy))
                                (when (> copy whave)
                                  (when sane
                                    (set! msg "invalid distance too far back")
                                    (set! mode BAD)
                                    (break :switch)))
                                (if (> copy wnext)
                                    (do
                                      (set! copy (unchecked-subtract-int copy wnext))
                                      (set! from window)
                                      (set! fromIndex (unchecked-subtract-int wsize copy)))
                                    (do
                                      (set! from window)
                                      (set! fromIndex (unchecked-subtract-int wnext copy))))
                                (when (> copy length) (set! copy length)))
                              (do
                                (set! from output)
                                (set! fromIndex (unchecked-subtract-int put offset))
                                (set! copy length)))
                          (when (> copy left) (set! copy left))
                          (set! left (unchecked-subtract-int left copy))
                          (set! length (unchecked-subtract-int length copy))
                          (loop []
                            (aset output put (aget from fromIndex))
                            (set! put (unchecked-inc-int put))
                            (set! fromIndex (unchecked-inc-int fromIndex))

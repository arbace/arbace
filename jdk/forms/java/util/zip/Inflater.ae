                                (while (not (== (bit-and-int huff incr) 0))
                                  (set! incr (unsigned-bit-shift-right-int incr 1)))
                                (if (not (== incr 0))
                                    (do
                                      (set! huff (bit-and-int huff (unchecked-subtract-int incr 1)))
                                      (set! huff (unchecked-add-int huff incr)))
                                    (set! huff 0))

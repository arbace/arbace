        max_blindex))

    (method send_all_trees ^void [this ^int lcodes ^int dcodes ^int blcodes]
      (let [^:mutable ^int rank 0]
        (.send_bits this (unchecked-subtract-int lcodes 257) 5)
        (.send_bits this (unchecked-subtract-int dcodes 1) 5)
        (.send_bits this (unchecked-subtract-int blcodes 4) 4)
        (set! rank 0)
        (while (< rank blcodes)
          (.send_bits this (bit-and-int (aget bl_tree_dl (aget bl_order rank)) 0xffff) 3)
          (set! rank (unchecked-inc-int rank)))
        (.send_tree this dyn_ltree_dl (unchecked-subtract-int lcodes 1))
        (.send_tree this dyn_dtree_dl (unchecked-subtract-int dcodes 1))))

    (method _tr_stored_block ^void [this ^byte/1 buf ^int off ^int stored_len ^boolean last]
      (.send_bits this (unchecked-add-int (bit-shift-left-int STORED_BLOCK 1) (if last 1 0)) 3)
      (.bi_windup this)
      (.put_short this stored_len)
      (.put_short this (bit-not-int stored_len))
      (when-not (== stored_len 0) (System/arraycopy buf off pending_buf pending stored_len))
      (set! pending (unchecked-add-int pending stored_len)))

    (method _tr_flush_bits ^void [this] (.bi_flush this))

    (method _tr_align ^void [this]
      (.send_bits this (bit-shift-left-int STATIC_TREES 1) 3)
      (.send_code this END_BLOCK static_ltree_code static_ltree_len)
      (.bi_flush this))

    (method compress_block ^void [this ^short/1 lcode ^short/1 llen ^short/1 dcode ^short/1 dlen]
      (let [^:mutable ^int dist 0
            ^:mutable ^int lc 0
            ^:mutable ^int sx 0
            ^:mutable ^int code 0
            ^:mutable ^int extra 0]
        (when-not (== sym_next 0)
          (loop []
            (set! dist (bit-and-int (aget sym_buf sx) 0xff))
            (set! sx (unchecked-inc-int sx))
            (set! dist
                  (unchecked-add-int dist
                                     (bit-shift-left-int (bit-and-int (aget sym_buf sx) 0xff) 8)))
            (set! sx (unchecked-inc-int sx))
            (set! lc (bit-and-int (aget sym_buf sx) 0xff))
            (set! sx (unchecked-inc-int sx))
            (if (== dist 0)
                (.send_code this lc lcode llen)
                (do
                  (set! code (bit-and-int (aget _length_code lc) 0xff))
                  (.send_code this
                              (unchecked-add-int (unchecked-add-int code LITERALS) 1)
                              lcode
                              llen)
                  (set! extra (aget extra_lbits code))
                  (when-not (== extra 0)
                    (set! lc (unchecked-subtract-int lc (aget base_length code)))
                    (.send_bits this lc extra))
                  (set! dist (unchecked-dec-int dist))
                  (set! code (ZState/d_code dist))
                  (.send_code this code dcode dlen)
                  (set! extra (aget extra_dbits code))
                  (when-not (== extra 0)
                    (set! dist (unchecked-subtract-int dist (aget base_dist code)))
                    (.send_bits this dist extra))))
            (when (< sx sym_next) (recur))))
        (.send_code this END_BLOCK lcode llen)))

    (method _tr_flush_block ^void [this ^byte/1 buf ^int off ^int stored_len ^boolean last]
      (let [^:mutable ^long opt_lenb 0
            ^:mutable ^long static_lenb 0
            ^:mutable ^int max_blindex 0]
        (if (> level 0)
            (do
              (.build_tree this l_desc)
              (.build_tree this d_desc)
              (set! max_blindex (.build_bl_tree this))
              (set! opt_lenb
                    (unsigned-bit-shift-right (unchecked-add (unchecked-add opt_len 3) 7) 3))
              (set! static_lenb
                    (unsigned-bit-shift-right (unchecked-add (unchecked-add static_len 3) 7) 3))
              (when (<= static_lenb opt_lenb) (set! opt_lenb static_lenb)))
            (set! opt_lenb (set! static_lenb (unchecked-add-int stored_len 5))))
        (cond
          (and (<= (unchecked-add-int stored_len 4) opt_lenb) (some? buf))
            (._tr_stored_block this buf off stored_len last)
          (== static_lenb opt_lenb)
            (do
              (.send_bits this
                          (unchecked-add-int (bit-shift-left-int STATIC_TREES 1) (if last 1 0))
                          3)
              (.compress_block this
                               static_ltree_code
                               static_ltree_len
                               static_dtree_code
                               static_dtree_len))
          :else
            (do
              (.send_bits this (unchecked-add-int (bit-shift-left-int DYN_TREES 1) (if last 1 0)) 3)
              (.send_all_trees this
                               (unchecked-add-int (.-max_code l_desc) 1)
                               (unchecked-add-int (.-max_code d_desc) 1)
                               (unchecked-add-int max_blindex 1))
              (.compress_block this dyn_ltree_fc dyn_ltree_dl dyn_dtree_fc dyn_dtree_dl)))
        (.init_block this)
        (when last (.bi_windup this))))))

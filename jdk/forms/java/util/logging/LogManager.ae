    (let [fname (.getConfigurationFileName this)]
      (with-resources [^InputStream in (FileInputStream. fname)]
        (.updateConfiguration this in mapper))))

  (method ^:public updateConfiguration :throws [IOException] ^void [this ^InputStream ins
                                                                    ^{:tag (Function String (BiFunction String String String))} mapper]
    (.ensureLogManagerInitialized this)
    (.drainLoggerRefQueueBounded this)
    (let [^:mutable ^Properties previous nil
          ^:mutable ^{:tag (Set String)} updatePropertyNames nil
          ^:mutable ^{:tag (List LoggerContext)} cxs (Collections/emptyList)
          visited (VisitedLoggers.)
          next (Properties.)]
      (try
        (.load next ins)
        (catch IllegalArgumentException x (throw (IOException. (.getMessage x) x))))
      (when-not (== globalHandlersState STATE_SHUTDOWN)
        (.lock configurationLock)
        (try
          (when (== globalHandlersState STATE_SHUTDOWN) (return))
          (set! previous props)
          (set! updatePropertyNames
                (cast Set
                      (.collect (Stream/concat (.stream (.stringPropertyNames previous))
                                               (.stream (.stringPropertyNames next)))
                                (Collectors/toCollection
                                  (method-ref Supplier ^TreeSet [] TreeSet/new)))))
          (when (some? mapper)
            (.forEachOrdered (.stream updatePropertyNames)
                             (let [previous previous]
                               (lambda Consumer ^void [^String k]
                                 (ConfigProperty/merge
                                   k
                                   previous
                                   next
                                   (cast BiFunction
                                         (Objects/requireNonNull
                                           (cast BiFunction (.apply mapper k)))))))))
          (set! props next)
          (let [^{:tag (Stream String)} allKeys (.filter
                                                  (.filter
                                                    (.stream updatePropertyNames)
                                                    (method-ref
                                                      Predicate
                                                      [String]
                                                      ConfigProperty/matches))
                                                  (let [previous previous]
                                                    (lambda Predicate ^boolean [^String k]
                                                      (ConfigProperty/needsUpdating k previous next))))
                ^{:tag (Map String (TreeSet String))} loggerConfigs (cast
                                                                      Map
                                                                      (.collect
                                                                        allKeys
                                                                        (Collectors/groupingBy
                                                                          (method-ref
                                                                            Function
                                                                            ^String [String]
                                                                            ConfigProperty/getLoggerName)
                                                                          (method-ref
                                                                            Supplier
                                                                            ^TreeMap []
                                                                            TreeMap/new)
                                                                          (Collectors/toCollection
                                                                            (method-ref
                                                                              Supplier
                                                                              ^TreeSet []
                                                                              TreeSet/new)))))]
            (when-not (.isEmpty loggerConfigs) (set! cxs (.contexts this)))
            (let [^{:tag (List Logger)} loggers (if (.isEmpty cxs)
                                                    (Collections/emptyList)
                                                    ^List (ArrayList. (.size cxs)))]
              (for-each [^{:tag (Map$Entry String (TreeSet String))} e (.entrySet loggerConfigs)]
                (let [name (cast String (.getKey e))
                      ^{:tag (Set String)} properties (cast Set (.getValue e))]
                  (.clear loggers)
                  (for-each [^LoggerContext cx cxs]
                    (let [l (.findLogger cx name)]
                      (when (and (some? l) (not (.test visited l))) (.add loggers l))))
                  (when-not (.isEmpty loggers)
                    (for-each [^String pk properties]
                      (let [cp (cast ConfigProperty (.get (ConfigProperty/find pk)))
                            p (.getProperty previous pk nil)
                            n (.getProperty next pk nil)
                            mod (ModType/of p n)]
                        (when-not (identical? mod ModType/SAME)
                          (switch cp
                            LEVEL
                              (when-not (identical? mod ModType/REMOVED)
                                (let [level (Level/findLevel (LogManager/trim n))]
                                  (when (some? level)
                                    (when (.isEmpty name) (.setLevel rootLogger level))
                                    (for-each [^Logger l loggers]
                                      (when (or (not (.isEmpty name))
                                                (not (identical? l rootLogger)))
                                        (.setLevel l level))))))
                            USEPARENT
                              (when-not (.isEmpty name)
                                (let [useParent (.getBooleanProperty this pk true)]
                                  (when (or (some? n) (some? p))
                                    (for-each [^Logger l loggers]
                                      (.setUseParentHandlers l useParent)))))
                            HANDLERS
                              (let [^:mutable ^{:tag (List Handler)} hdls nil]
                                (when (.isEmpty name)
                                  (set! globalHandlersState STATE_READING_CONFIG)
                                  (try
                                    (.closeHandlers this rootLogger)
                                    (set! globalHandlersState STATE_UNINITIALIZED)
                                    (catch Throwable t
                                      (set! globalHandlersState STATE_INITIALIZED)
                                      (throw t))))
                                (for-each [^Logger l loggers]
                                  (when-not (identical? l rootLogger)
                                    (.closeHandlers this l)
                                    (if (identical? mod ModType/REMOVED)
                                        (.removeIf
                                          closeOnResetLoggers
                                          (lambda Predicate ^boolean [^CloseOnReset c]
                                            (identical? (.-logger c) l)))
                                        (do
                                          (when (nil? hdls)
                                            (set!
                                              hdls
                                              (if (.isEmpty name)
                                                  (Arrays/asList (.getHandlers rootLogger))
                                                  (.createLoggerHandlers this name pk))))
                                          (.setLoggerHandlers this l name pk hdls))))))
                            nil)))))))))
          (finally (.unlock configurationLock) (.clear visited)))
        (.drainLoggerRefQueueBounded this)
        (for-each [^LoggerContext cx cxs]
          (loop [^{:tag (Enumeration String)} names (.getLoggerNames cx)]
            (when (.hasMoreElements names)
              (let [name (cast String (.nextElement names))]
                (if (.isEmpty name)
                    (recur names)
                    (let [l (.findLogger cx name)]
                      (if (and (some? l) (not (.test visited l)))
                          (do (.processParentHandlers cx l name visited) (recur names))
                          (recur names))))))))
        (.invokeConfigurationListeners this))))

  (method ^:public getProperty ^String [this ^String name]
    (.getProperty props name))

  (method getStringProperty ^String [this ^String name ^String defaultValue]
    (let [val (.getProperty this name)] (if (nil? val) defaultValue (.trim val))))

  (method getIntProperty ^int [this ^String name ^int defaultValue]
    (let [val (.getProperty this name)]
      (if (nil? val)
          defaultValue
          (try (Integer/parseInt (.trim val)) (catch Exception ex defaultValue)))))

  (method getLongProperty ^long [this ^String name ^long defaultValue]
    (let [val (.getProperty this name)]
      (if (nil? val)
          defaultValue
          (try (Long/parseLong (.trim val)) (catch Exception ex defaultValue)))))

  (method getBooleanProperty ^boolean [this ^String name ^boolean defaultValue]
    (let [^:mutable val (.getProperty this name)]
      (if (nil? val)
          defaultValue
          (do
            (set! val (.toLowerCase val))
            (cond
              (or (.equals val "true") (.equals val "1")) true
              (or (.equals val "false") (.equals val "0")) false
              :else defaultValue)))))

  (method getLevelProperty ^Level [this ^String name ^Level defaultValue]
    (let [val (.getProperty this name)]
      (if (nil? val)
          defaultValue
          (let [l (Level/findLevel (.trim val))] (if (some? l) l defaultValue)))))

  (method getFilterProperty ^Filter [this ^String name ^Filter defaultValue]
    (let [val (.getProperty this name)]
      (try
        (when (some? val)
          (let [o (.newInstance (.loadClass (ClassLoader/getSystemClassLoader) val))]
            (return (cast Filter o))))
        (catch Exception ex))
      defaultValue))

  (method getFormatterProperty ^Formatter [this ^String name ^Formatter defaultValue]
    (let [val (.getProperty this name)]
      (try
        (when (some? val)
          (let [o (.newInstance (.loadClass (ClassLoader/getSystemClassLoader) val))]
            (return (cast Formatter o))))
        (catch Exception ex))
      defaultValue))

  (method ^:private initializeGlobalHandlers ^void [this]
    (let [state globalHandlersState]
      (when-not (or (== state STATE_INITIALIZED) (== state STATE_SHUTDOWN))
        (.lock configurationLock)
        (try
          (when-not (not (== globalHandlersState STATE_UNINITIALIZED))
            (set! globalHandlersState STATE_INITIALIZING)
            (try
              (.loadLoggerHandlers this rootLogger nil "handlers")
              (finally (set! globalHandlersState STATE_INITIALIZED))))
          (finally (.unlock configurationLock))))))

  (method ^:public ^{Deprecated {:since "17" :forRemoval true}} checkAccess ^void [this])

  (defclass ^:private ^:static LogNode
    (field ^{:tag (HashMap String LogNode)} children)

    (field ^LoggerWeakRef loggerRef)

    (field ^LogNode parent)

    (field ^:final ^LoggerContext context)

    (constructor [this ^LogNode parent ^LoggerContext context]
      (set! (.-parent this) parent)
      (set! (.-context this) context))

    (method walkAndSetParent ^void [this ^Logger parent]
      (when (some? children)
        (for-each [^LogNode node (.values children)]
          (let [ref (.-loggerRef node)
                ^Logger logger (when (some? ref) (cast Logger (.get ref)))]
            (if (nil? logger) (.walkAndSetParent node parent) (.setParent logger parent)))))))

  (defclass ^:private ^:final RootLogger
    :extends Logger

    (constructor ^:private [this] (super. "" nil nil LogManager/this true))

    (method ^:public log ^void [this ^LogRecord record]
      (.initializeGlobalHandlers LogManager/this)
      (.log super record))

    (method ^:public addHandler ^void [this ^Handler h]
      (.initializeGlobalHandlers LogManager/this)
      (.addHandler super h))

    (method ^:public removeHandler ^void [this ^Handler h]
      (.initializeGlobalHandlers LogManager/this)
      (.removeHandler super h))

    (method accessCheckedHandlers ^Handler/1 [this]
      (.initializeGlobalHandlers LogManager/this)
      (.accessCheckedHandlers super)))

  (method ^:private setLevelsOnExistingLoggers ^void [this]
    (let [^{:tag (Enumeration ?)} enum_ (.propertyNames props)]
      (while (.hasMoreElements enum_)
        (let [key (cast String (.nextElement enum_))]
          (when-not (not (.endsWith key ".level"))
            (let [ix (unchecked-subtract-int (.length key) 6)
                  name (.substring key 0 ix)
                  level (.getLevelProperty this key nil)]
              (if (nil? level)
                  (.println System/err (java-str "Bad level value for property: " key))
                  (for-each [^LoggerContext cx (.contexts this)]
                    (let [l (.findLogger cx name)] (when (some? l) (.setLevel l level)))))))))))

  (field ^:public ^:static ^:final ^String LOGGING_MXBEAN_NAME "java.util.logging:type=Logging")

  (method ^:public ^:static ^:synchronized ^{Deprecated {:since "9"}} getLoggingMXBean ^LoggingMXBean []
    (Logging/getInstance))

  (method ^:public addConfigurationListener ^LogManager [this ^Runnable listener]
    (let [r (cast Runnable (Objects/requireNonNull listener))] (.putIfAbsent listeners r r) this))

  (method ^:public removeConfigurationListener ^void [this ^Runnable listener]
    (let [key (cast Runnable (Objects/requireNonNull listener))] (.remove listeners key)))

  (method ^:private invokeConfigurationListeners ^void [this]
    (let [^:mutable ^Throwable t nil]
      (for-each [^Runnable c (cast Runnable/1 (.toArray (.values listeners) (new Runnable/1 0)))]
        (try
          (.run c)
          (catch [Error RuntimeException] x (if (nil? t) (set! t x) (.addSuppressed t x)))))
      (when (instance? Error t) (throw (cast Error t)))
      (when (instance? RuntimeException t) (throw (cast RuntimeException t)))))

  (defclass ^:private ^:static ^:final LoggingProviderAccess
    :implements [LoggingProviderImpl$LogManagerAccess]

    (constructor ^:private [this])

    (method ^:public demandLoggerFor ^Logger [this ^LogManager manager ^String name ^Module module]
      (when-not (identical? manager (LogManager/getLogManager))
        (throw (IllegalArgumentException. "manager")))
      (Objects/requireNonNull name)
      (Objects/requireNonNull module)
      (if (DefaultLoggerFinder/isSystem module)
          (.demandSystemLogger manager name Logger/SYSTEM_LOGGER_RB_NAME module)
          (.demandLogger manager name nil module)))

    (method ^:private init ^void [this]
      (LoggingProviderImpl/setLogManagerAccess INSTANCE))

    (field ^:static ^:final ^LoggingProviderAccess INSTANCE (LoggingProviderAccess.)))

  (static-initializer (.init LoggingProviderAccess/INSTANCE)))

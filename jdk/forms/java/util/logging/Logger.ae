  (method ^:private ^:synchronized findResourceBundle ^ResourceBundle [this ^String name
                                                                       ^boolean useCallersModule]
    (when (some? name)
      (let [currentLocale (Locale/getDefault)
            lb loggerBundle
            ^:mutable catalog (.catalog this)]
        (cond
          (and (some? (.-userBundle lb)) (.equals name (.-resourceBundleName lb))) (.-userBundle lb)
          (and (and (some? catalog) (.equals currentLocale catalogLocale))
               (.equals name catalogName))
            catalog
          :else
            (let [^:mutable cl (.getContextClassLoader (Thread/currentThread))]
              (when (nil? cl) (set! cl (ClassLoader/getSystemClassLoader)))
              (let [callerModule (.getCallerModule this)]
                (if (or (or (not useCallersModule) (nil? callerModule))
                        (not (.isNamed callerModule)))
                    (try
                      (let [mod (.getUnnamedModule cl)]
                        (set! catalog (.getBundle RbAccess/RB_ACCESS name currentLocale mod))
                        (set! catalogRef (WeakReference. catalog))
                        (set! catalogName name)
                        (set! catalogLocale currentLocale)
                        catalog)
                      (catch MissingResourceException ex
                        (when (and useCallersModule (some? callerModule))
                          (try
                            (let [moduleCL (.getClassLoader callerModule)]
                              (when-not (or (identical? moduleCL cl) (nil? moduleCL))
                                (set! catalog
                                      (ResourceBundle/getBundle name currentLocale moduleCL))
                                (set! catalogRef (WeakReference. catalog))
                                (set! catalogName name)
                                (set! catalogLocale currentLocale)
                                catalog))
                            (catch MissingResourceException x nil)))))
                    (try
                      (set! catalog (.getBundle RbAccess/RB_ACCESS name currentLocale callerModule))
                      (set! catalogRef (WeakReference. catalog))
                      (set! catalogName name)
                      (set! catalogLocale currentLocale)
                      catalog
                      (catch MissingResourceException ex nil)))))))))


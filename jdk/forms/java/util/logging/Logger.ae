      (when (some? (.-resourceBundleName lb))
        (when (.equals (.-resourceBundleName lb) name) (return))
        (throw (IllegalArgumentException. (java-str (.-resourceBundleName lb) " != " name))))
      (when (some? name)
        (.setCallerModuleRef this callerModule)
        (when (and isSystemLogger
                   (and (some? callerModule) (not (DefaultLoggerFinder/isSystem callerModule))))
          (.ensureManagerInitialized this))
        (if (.equals name SYSTEM_LOGGER_RB_NAME)

  (method ^:public setParent ^void [this ^Logger parent]
    (when (nil? parent) (throw (NullPointerException.)))
    (.ensureManagerInitialized this)
    (.doSetParent this parent))

  (method ^:private doSetParent ^void [this ^Logger newParent]
    (locking treeLock
      (let [^:mutable ^LogManager$LoggerWeakRef ref nil]
        (when (some? parent)
          (loop [^{:tag (Iterator LogManager$LoggerWeakRef)} iter (.iterator (.-kids parent))]
            (when (.hasNext iter)
              (set! ref (cast LogManager$LoggerWeakRef (.next iter)))
              (if (.refersTo ref this) (.remove iter) (do (set! ref nil) (recur iter))))))
        (set! parent newParent)
        (when (nil? (.-kids parent)) (set! (.-kids parent) (ArrayList. 2)))
        (when (nil? ref) (set! ref (.new manager LogManager$LoggerWeakRef this)))
        (.setParentRef ref (WeakReference. parent))
        (.add (.-kids parent) ref)
        (.updateEffectiveLevel this))))

  (method ^:final removeChildLogger ^void [this ^LogManager$LoggerWeakRef child]
    (locking treeLock
      (loop [^{:tag (Iterator LogManager$LoggerWeakRef)} iter (.iterator kids)]
        (when (.hasNext iter)
          (let [ref (cast LogManager$LoggerWeakRef (.next iter))]
            (if (identical? ref child) (do (.remove iter) (return)) (recur iter)))))))

  (method ^:private updateEffectiveLevel ^void [this]
    (let [^:mutable ^int newLevelValue 0
          cfg config
          levelObject (.-levelObject cfg)]
      (cond
        (some? levelObject) (set! newLevelValue (.intValue levelObject))
        (some? parent) (set! newLevelValue (.-levelValue (.-config parent)))
        :else (set! newLevelValue (.intValue Level/INFO)))
      (when-not (== (.-levelValue cfg) newLevelValue)
        (.setLevelValue cfg newLevelValue)
        (when (some? kids)
          (for-each [^LogManager$LoggerWeakRef ref kids]
            (let [kid (cast Logger (.get ref))] (when (some? kid) (.updateEffectiveLevel kid))))))))

  (method ^:private getEffectiveLoggerBundle ^LoggerBundle [this]
    (let [lb loggerBundle]
      (if (.isSystemBundle lb)
          SYSTEM_BUNDLE
          (let [b (.getResourceBundle this)]
            (cond
              (and (some? b) (identical? b (.-userBundle lb))) lb
              (some? b) (let [rbName (.getResourceBundleName this)] (LoggerBundle/get rbName b))
              :else
                (let [^:mutable target (.-parent this)]
                  (while (some? target)
                    (let [trb (.-loggerBundle target)]
                      (when (.isSystemBundle trb) (return SYSTEM_BUNDLE))
                      (when (some? (.-userBundle trb)) (return trb))
                      (let [^String rbName (if isSystemLogger
                                               (when (.-isSystemLogger target)
                                                 (.-resourceBundleName trb))
                                               (.getResourceBundleName target))]
                        (when (some? rbName)
                          (return (LoggerBundle/get rbName (.findResourceBundle this rbName true))))
                        (set! target (if isSystemLogger (.-parent target) (.getParent target))))))
                  NO_RESOURCE_BUNDLE)))))))

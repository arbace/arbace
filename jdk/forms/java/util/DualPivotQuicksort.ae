                  ^int k (if (identical? a1 a)
                             (unchecked-subtract-int (aget run lo) offset)
                             (aget run lo))
                  ^int lo1 (if (identical? a1 b)
                               (unchecked-subtract-int (aget run lo) offset)
                               (aget run lo))
                  ^int hi1 (if (identical? a1 b)
                               (unchecked-subtract-int (aget run mi) offset)
                               (aget run mi))
                  ^int lo2 (if (identical? a2 b)
                               (unchecked-subtract-int (aget run mi) offset)
                               (aget run mi))
                  ^int hi2 (if (identical? a2 b)
                               (unchecked-subtract-int (aget run hi) offset)

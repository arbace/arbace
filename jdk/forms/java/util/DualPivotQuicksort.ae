                (let [^:mutable i (unchecked-subtract-int last 1)
                      ^:mutable j k]
                  (while (and (< (set! i (unchecked-inc-int i)) (set! j (unchecked-dec-int j)))
                              (> (aget a i) (aget a j)))
                    (let [ai (aget a i)] (aset a i (aget a j)) (aset a j ai)))))
            :else
              (do
                (loop [ak (aget a k)]
                  (when (and (< (set! k (unchecked-inc-int k)) high) (== ak (aget a k))) (recur ak)))
                (when (< k high) (continue))))
          (if (nil? run)
              (do
                (when (== k high) (return true))
                (when (< (unchecked-subtract-int k low) MIN_FIRST_RUN_SIZE) (return false))
                (set! run
                      (new int/1
                           (bit-and-int (bit-or-int (bit-shift-right-int size 10) 0x7F) 0x3FF)))
                (aset run 0 low))
              (when (> (aget a (unchecked-subtract-int last 1)) (aget a last))
                (when (> count
                         (bit-shift-right-int (unchecked-subtract-int k low) MIN_FIRST_RUNS_FACTOR))
                  (return false))
                (when (== (set! count (unchecked-inc-int count)) MAX_RUN_CAPACITY) (return false))
                (when (== count (alength run))
                  (set! run (Arrays/copyOf run (bit-shift-left-int count 1))))))
          (aset run count (set! last k))))
      (when (> count 1)
        (let [^:mutable ^double/1 b nil
              ^:mutable offset low]
          (if (or (nil? sorter) (nil? (set! b (cast double/1 (.-b sorter)))))
              (set! b (new double/1 size))
              (set! offset (.-offset sorter)))
          (DualPivotQuicksort/mergeRuns a b offset 1 (some? sorter) run 0 count)))
      true))

  (method ^:private ^:static mergeRuns ^double/1 [^double/1 a ^double/1 b ^int offset ^int aim
                                                  ^boolean parallel ^int/1 run ^int lo ^int hi]
    (if (== (unchecked-subtract-int hi lo) 1)
        (if (>= aim 0)
            a
            (do
              (let [^:mutable i (aget run hi)
                    ^:mutable j (unchecked-subtract-int i offset)
                    low (aget run lo)]
                (while (> i low)
                  (aset b (set! j (unchecked-dec-int j)) (aget a (set! i (unchecked-dec-int i))))))
              b))
        (let [^:mutable mi lo
              rmi (unsigned-bit-shift-right-int (unchecked-add-int (aget run lo) (aget run hi)) 1)]
          (while (<= (aget run (unchecked-add-int (set! mi (unchecked-inc-int mi)) 1)) rmi))
          (let [^:mutable ^double/1 a1 nil
                ^:mutable ^double/1 a2 nil]
            (if (and parallel (> (unchecked-subtract-int hi lo) MIN_RUN_COUNT))
                (let [merger (.forkMe (RunMerger. a b offset 0 run mi hi))]
                  (set! a1
                        (DualPivotQuicksort/mergeRuns
                          a
                          b
                          offset
                          (unchecked-negate-int aim)
                          true
                          run
                          lo
                          mi))
                  (set! a2 (cast double/1 (.getDestination merger))))
                (do
                  (set! a1
                        (DualPivotQuicksort/mergeRuns
                          a
                          b
                          offset
                          (unchecked-negate-int aim)
                          false
                          run
                          lo
                          mi))
                  (set! a2 (DualPivotQuicksort/mergeRuns a b offset 0 false run mi hi))))
            (let [^double/1 dst (if (identical? a1 a) b a)
                  ^int k (if (identical? a1 a)
                             (unchecked-subtract-int (aget run lo) offset)
                             (aget run lo))
                  ^int lo1 (if (identical? a1 b)
                               (unchecked-subtract-int (aget run lo) offset)
                               (aget run lo))
                  ^int hi1 (if (identical? a1 b)
                               (unchecked-subtract-int (aget run mi) offset)
                               (aget run mi))
                  ^int lo2 (if (identical? a2 b)
                               (unchecked-subtract-int (aget run mi) offset)
                               (aget run mi))
                  ^int hi2 (if (identical? a2 b)
                               (unchecked-subtract-int (aget run hi) offset)
                               (aget run hi))]
              (if parallel
                  (.invoke (Merger. nil dst k a1 lo1 hi1 a2 lo2 hi2))
                  (DualPivotQuicksort/mergeParts nil dst k a1 lo1 hi1 a2 lo2 hi2))
              dst)))))

  (method ^:private ^:static mergeParts ^void [^Merger merger ^double/1 dst ^:mutable ^int k
                                               ^double/1 a1 ^:mutable ^int lo1 ^:mutable ^int hi1
                                               ^double/1 a2 ^:mutable ^int lo2 ^:mutable ^int hi2]
    (when (and (some? merger) (identical? a1 a2))
      (while true
        (when (< (unchecked-subtract-int hi1 lo1) (unchecked-subtract-int hi2 lo2))
          (let [lo lo1] (set! lo1 lo2) (set! lo2 lo) (let [hi hi1] (set! hi1 hi2) (set! hi2 hi))))
        (when (< (unchecked-subtract-int hi1 lo1) MIN_PARALLEL_MERGE_PARTS_SIZE) (break))
        (let [mi1 (unsigned-bit-shift-right-int (unchecked-add-int lo1 hi1) 1)
              key (aget a1 mi1)
              ^:mutable mi2 hi2]
          (let [^:mutable loo lo2]
            (while (< loo mi2)
              (let [t (unsigned-bit-shift-right-int (unchecked-add-int loo mi2) 1)]
                (if (> key (aget a2 t)) (set! loo (unchecked-add-int t 1)) (set! mi2 t)))))
          (let [d (unchecked-subtract-int (unchecked-add-int (unchecked-subtract-int mi2 lo2) mi1)
                                          lo1)]
            (.forkMerger merger dst (unchecked-add-int k d) a1 mi1 hi1 a2 mi2 hi2)
            (set! hi1 mi1)
            (set! hi2 mi2)))))
    (while (and (< lo1 hi1) (< lo2 hi2))
      (aset dst
            k
            (if (< (aget a1 lo1) (aget a2 lo2))
                (aget a1 (let [old-10 lo1] (set! lo1 (unchecked-inc-int lo1)) old-10))
                (aget a2 (let [old-11 lo2] (set! lo2 (unchecked-inc-int lo2)) old-11))))
      (set! k (unchecked-inc-int k)))
    (when (or (not (identical? dst a1)) (< k lo1))
      (while (< lo1 hi1)
        (aset dst k (aget a1 lo1))
        (set! k (unchecked-inc-int k))
        (set! lo1 (unchecked-inc-int lo1))))
    (when (or (not (identical? dst a2)) (< k lo2))
      (while (< lo2 hi2)
        (aset dst k (aget a2 lo2))
        (set! k (unchecked-inc-int k))
        (set! lo2 (unchecked-inc-int lo2)))))

  (defclass ^:private ^:static ^:final Sorter
    :extends (CountedCompleter Void)

    (field ^:private ^:static ^:final ^long serialVersionUID 20180818)

    (field ^:private ^:final a)

    (field ^:private ^:final b)

    (field ^:private ^:final ^int low)

    (field ^:private ^:final ^int size)

    (field ^:private ^:final ^int offset)

    (field ^:private ^:final ^int depth)

    (constructor ^:private [this ^{:tag (CountedCompleter ?)} parent a b ^int low ^int size
                            ^int offset ^int depth]
      (super. parent)
      (set! (.-a this) a)
      (set! (.-b this) b)
      (set! (.-low this) low)
      (set! (.-size this) size)
      (set! (.-offset this) offset)
      (set! (.-depth this) depth))

    (method ^:public ^:final compute ^void [this]
      (cond
        (< depth 0)
          (do
            (.setPendingCount this 2)
            (let [half (bit-shift-right-int size 1)]
              (.fork (Sorter. this b a low half offset (unchecked-add-int depth 1)))
              (.compute (Sorter. this
                                 b
                                 a
                                 (unchecked-add-int low half)
                                 (unchecked-subtract-int size half)
                                 offset
                                 (unchecked-add-int depth 1)))))
        (instance? int/1 a)
          (DualPivotQuicksort/sort this (cast int/1 a) depth low (unchecked-add-int low size))
        (instance? long/1 a)
          (DualPivotQuicksort/sort this (cast long/1 a) depth low (unchecked-add-int low size))
        (instance? float/1 a)
          (DualPivotQuicksort/sort this (cast float/1 a) depth low (unchecked-add-int low size))
        (instance? double/1 a)
          (DualPivotQuicksort/sort this (cast double/1 a) depth low (unchecked-add-int low size))
        :else
          (throw (IllegalArgumentException.
                   (java-str "Unknown type of array: " (.getName (.getClass a))))))
      (.tryComplete this))

    (method ^:public ^:final onCompletion ^void [this ^{:tag (CountedCompleter ?)} caller]
      (when (< depth 0)
        (let [mi (unchecked-add-int low (bit-shift-right-int size 1))
              src (== (bit-and-int depth 1) 0)]
          (.invoke (Merger. nil
                            a
                            (if src low (unchecked-subtract-int low offset))
                            b
                            (if src (unchecked-subtract-int low offset) low)
                            (if src (unchecked-subtract-int mi offset) mi)
                            b
                            (if src (unchecked-subtract-int mi offset) mi)
                            (if src
                                (unchecked-subtract-int (unchecked-add-int low size) offset)
                                (unchecked-add-int low size)))))))

    (method ^:private forkSorter ^void [this ^int depth ^int low ^int high]
      (.addToPendingCount this 1)
      (let [a (.-a this)]
        (.fork (Sorter. this a b low (unchecked-subtract-int high low) offset depth)))))

  (defclass ^:private ^:static ^:final Merger
    :extends (CountedCompleter Void)

    (field ^:private ^:static ^:final ^long serialVersionUID 20180818)

    (field ^:private ^:final dst)

    (field ^:private ^:final a1)

    (field ^:private ^:final a2)

    (field ^:private ^:final ^int k)

    (field ^:private ^:final ^int lo1)

    (field ^:private ^:final ^int hi1)

    (field ^:private ^:final ^int lo2)

    (field ^:private ^:final ^int hi2)

    (constructor ^:private [this ^{:tag (CountedCompleter ?)} parent dst ^int k a1 ^int lo1 ^int hi1
                            a2 ^int lo2 ^int hi2]
      (super. parent)
      (set! (.-dst this) dst)
      (set! (.-k this) k)
      (set! (.-a1 this) a1)
      (set! (.-lo1 this) lo1)
      (set! (.-hi1 this) hi1)
      (set! (.-a2 this) a2)
      (set! (.-lo2 this) lo2)
      (set! (.-hi2 this) hi2))

    (method ^:public ^:final compute ^void [this]
      (cond
        (instance? int/1 dst)
          (DualPivotQuicksort/mergeParts this
                                         (cast int/1 dst)
                                         k
                                         (cast int/1 a1)
                                         lo1
                                         hi1
                                         (cast int/1 a2)
                                         lo2
                                         hi2)
        (instance? long/1 dst)
          (DualPivotQuicksort/mergeParts this
                                         (cast long/1 dst)
                                         k
                                         (cast long/1 a1)
                                         lo1
                                         hi1
                                         (cast long/1 a2)
                                         lo2
                                         hi2)
        (instance? float/1 dst)
          (DualPivotQuicksort/mergeParts this
                                         (cast float/1 dst)
                                         k
                                         (cast float/1 a1)
                                         lo1
                                         hi1
                                         (cast float/1 a2)
                                         lo2
                                         hi2)
        (instance? double/1 dst)
          (DualPivotQuicksort/mergeParts this
                                         (cast double/1 dst)
                                         k
                                         (cast double/1 a1)
                                         lo1
                                         hi1
                                         (cast double/1 a2)
                                         lo2
                                         hi2)
        :else
          (throw (IllegalArgumentException.
                   (java-str "Unknown type of array: " (.getName (.getClass dst))))))
      (.propagateCompletion this))

    (method ^:private forkMerger ^void [this dst ^int k a1 ^int lo1 ^int hi1 a2 ^int lo2 ^int hi2]
      (.addToPendingCount this 1)
      (.fork (Merger. this dst k a1 lo1 hi1 a2 lo2 hi2))))

  (defclass ^:private ^:static ^:final RunMerger
    :extends (RecursiveTask Object)

    (field ^:private ^:static ^:final ^long serialVersionUID 20180818)

    (field ^:private ^:final a)

    (field ^:private ^:final b)

    (field ^:private ^:final ^int/1 run)

    (field ^:private ^:final ^int offset)

    (field ^:private ^:final ^int aim)

    (field ^:private ^:final ^int lo)

    (field ^:private ^:final ^int hi)

    (constructor ^:private [this a b ^int offset ^int aim ^int/1 run ^int lo ^int hi]
      (set! (.-a this) a)
      (set! (.-b this) b)
      (set! (.-offset this) offset)
      (set! (.-aim this) aim)
      (set! (.-run this) run)
      (set! (.-lo this) lo)
      (set! (.-hi this) hi))

    (method ^:protected ^:final compute [this]
      (cond
        (instance? int/1 a)
          (DualPivotQuicksort/mergeRuns (cast int/1 a) (cast int/1 b) offset aim true run lo hi)
        (instance? long/1 a)
          (DualPivotQuicksort/mergeRuns (cast long/1 a) (cast long/1 b) offset aim true run lo hi)
        (instance? float/1 a)
          (DualPivotQuicksort/mergeRuns (cast float/1 a) (cast float/1 b) offset aim true run lo hi)
        (instance? double/1 a)
          (DualPivotQuicksort/mergeRuns (cast double/1 a)
                                        (cast double/1 b)
                                        offset
                                        aim
                                        true
                                        run
                                        lo
                                        hi)
        :else
          (throw (IllegalArgumentException.
                   (java-str "Unknown type of array: " (.getName (.getClass a)))))))

    (method ^:private forkMe ^RunMerger [this] (.fork this) this)

    (method ^:private getDestination [this]
      (.join this)
      (.getRawResult this))))

  (method ^:private ^:static insertionSort ^void [^long/1 a ^int low ^int high]
    (let [^:mutable ^int i 0
          ^:mutable k low]
      (while (< (set! k (unchecked-inc-int k)) high)
        (let [ai (aget a (set! i k))]
          (when (< ai (aget a (unchecked-subtract-int i 1)))
            (while (and (>= (set! i (unchecked-dec-int i)) low) (< ai (aget a i)))
              (aset a (unchecked-add-int i 1) (aget a i)))
            (aset a (unchecked-add-int i 1) ai))))))

  (method ^:private ^:static heapSort ^void [^long/1 a ^int low ^:mutable ^int high]
    (let [^:mutable k (unsigned-bit-shift-right-int (unchecked-add-int low high) 1)]
      (while (> k low)
        (DualPivotQuicksort/pushDown a (set! k (unchecked-dec-int k)) (aget a k) low high)))
    (while (> (set! high (unchecked-dec-int high)) low)
      (let [max (aget a low)]
        (DualPivotQuicksort/pushDown a low (aget a high) low high)
        (aset a high max))))

  (method ^:private ^:static pushDown ^void [^long/1 a ^:mutable ^int p ^long value ^int low
                                             ^int high]
    (let [^:mutable ^int k 0]
      (while true
        (set! k (unchecked-add-int (unchecked-subtract-int (bit-shift-left-int p 1) low) 2))
        (when (> k high) (break))
        (when (or (== k high) (< (aget a k) (aget a (unchecked-subtract-int k 1))))
          (set! k (unchecked-dec-int k)))

  (field ^:private ^:static ^:final ^int MAX_BYTE_INDEX
    (unchecked-add-int (unchecked-add-int Byte/MAX_VALUE NUM_BYTE_VALUES) 1))

  (method ^:private ^:static countingSort ^void [^byte/1 a ^:mutable ^int low ^:mutable ^int high]

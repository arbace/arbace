                  (when (> (set! c (unchecked-dec-int c)) 0) (recur)))))))))

  (method ^:static sort ^void [^char/1 a ^int low ^int high]
    (if (> (unchecked-subtract-int high low) MIN_SHORT_OR_CHAR_COUNTING_SORT_SIZE)
        (DualPivotQuicksort/countingSort a low high)
        (DualPivotQuicksort/sort a 0 low high)))

  (method ^:static sort ^void [^char/1 a ^:mutable ^int bits ^int low ^:mutable ^int high]
    (while true
      (let [end (unchecked-subtract-int high 1)
            size (unchecked-subtract-int high low)]
        (when (< size MAX_INSERTION_SORT_SIZE)
          (DualPivotQuicksort/insertionSort a low high)
          (return))
        (when (> (set! bits (unchecked-add-int bits DELTA)) MAX_RECURSION_DEPTH)
          (DualPivotQuicksort/countingSort a low high)
          (return))

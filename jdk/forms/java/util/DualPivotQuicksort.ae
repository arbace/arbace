              e1 (unchecked-add-int low step)
              e5 (unchecked-subtract-int end step)
              e3 (unsigned-bit-shift-right-int (unchecked-add-int e1 e5) 1)
              e2 (unsigned-bit-shift-right-int (unchecked-add-int e1 e3) 1)
              e4 (unsigned-bit-shift-right-int (unchecked-add-int e3 e5) 1)
              a3 (aget a e3)]
          (when (< (aget a e5) (aget a e2))
            (let [t (aget a e5)] (aset a e5 (aget a e2)) (aset a e2 t)))
          (when (< (aget a e4) (aget a e1))
            (let [t (aget a e4)] (aset a e4 (aget a e1)) (aset a e1 t)))
          (when (< (aget a e5) (aget a e4))
            (let [t (aget a e5)] (aset a e5 (aget a e4)) (aset a e4 t)))
          (when (< (aget a e2) (aget a e1))
            (let [t (aget a e2)] (aset a e2 (aget a e1)) (aset a e1 t)))
          (when (< (aget a e4) (aget a e2))
            (let [t (aget a e4)] (aset a e4 (aget a e2)) (aset a e2 t)))
          (cond
            (< a3 (aget a e2))
              (if (< a3 (aget a e1))
                  (do (aset a e3 (aget a e2)) (aset a e2 (aget a e1)) (aset a e1 a3))
                  (do (aset a e3 (aget a e2)) (aset a e2 a3)))
            (> a3 (aget a e4))
              (if (> a3 (aget a e5))
                  (do (aset a e3 (aget a e4)) (aset a e4 (aget a e5)) (aset a e5 a3))
                  (do (aset a e3 (aget a e4)) (aset a e4 a3))))

                          (<= (aget a (unchecked-subtract-int k 1)) (aget a k))))
            (> (aget a (unchecked-subtract-int k 1)) (aget a k))
              (do
                (while (and (< (set! k (unchecked-inc-int k)) high)
                            (>= (aget a (unchecked-subtract-int k 1)) (aget a k))))

          (DualPivotQuicksort/sort Long/TYPE
                                   a
                                   Unsafe/ARRAY_LONG_BASE_OFFSET
                                   low
                                   high
                                   (method-ref SortOperation
                                               [long/1 int int]
                                               DualPivotQuicksort/mixedInsertionSort))
          (return))
        (when (< size MAX_INSERTION_SORT_SIZE)
          (DualPivotQuicksort/sort Long/TYPE
                                   a
                                   Unsafe/ARRAY_LONG_BASE_OFFSET
                                   low
                                   high
                                   (method-ref SortOperation
                                               [long/1 int int]
                                               DualPivotQuicksort/insertionSort))
          (return))
        (when (and (or (== bits 0) (and (> size MIN_TRY_MERGE_SIZE) (> (bit-and-int bits 1) 0)))
                   (DualPivotQuicksort/tryMergeRuns sorter a low size))
          (return))
        (when (> (set! bits (unchecked-add-int bits DELTA)) MAX_RECURSION_DEPTH)

                                     Long/TYPE
                                     a
                                     Unsafe/ARRAY_LONG_BASE_OFFSET
                                     low
                                     high
                                     e1
                                     e5
                                     (method-ref
                                       PartitionOperation
                                       [long/1 int int int int]
                                       DualPivotQuicksort/partitionDualPivot))]
                  (set! lower (aget pivotIndices 0))
                  (set! upper (aget pivotIndices 1))

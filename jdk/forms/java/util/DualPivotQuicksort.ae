  (method ^:private ^:static tryMergeRuns ^boolean [^Sorter sorter ^long/1 a ^int low ^int size]
    (let [^:mutable ^int/1 run nil
          high (unchecked-add-int low size)
          ^:mutable ^int count 1
          ^:mutable last low]

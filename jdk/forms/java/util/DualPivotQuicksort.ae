              (while (< low high)
                (let [a1 (aget a (set! i low))
                      a2 (aget a (set! low (unchecked-inc-int low)))]
                  (if (> a1 a2)
                      (do
                        (while (< a1 (aget a (set! i (unchecked-dec-int i))))
                          (aset a (unchecked-add-int i 2) (aget a i)))
                        (aset a (unchecked-add-int (set! i (unchecked-inc-int i)) 1) a1)
                        (while (< a2 (aget a (set! i (unchecked-dec-int i))))
                          (aset a (unchecked-add-int i 1) (aget a i)))
                        (aset a (unchecked-add-int i 1) a2))

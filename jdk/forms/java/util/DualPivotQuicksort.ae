        (set! lo2 (unchecked-inc-int lo2)))))

  (method ^:static sort ^void [^byte/1 a ^int low ^int high]
    (if (> (unchecked-subtract-int high low) MIN_BYTE_COUNTING_SORT_SIZE)
        (DualPivotQuicksort/countingSort a low high)
        (DualPivotQuicksort/insertionSort a low high)))

  (method ^:private ^:static insertionSort ^void [^byte/1 a ^int low ^int high]
    (let [^:mutable ^int i 0
          ^:mutable k low]
      (while (< (set! k (unchecked-inc-int k)) high)
        (let [ai (aget a (set! i k))]
          (when (< ai (aget a (unchecked-subtract-int i 1)))
            (while (and (>= (set! i (unchecked-dec-int i)) low) (< ai (aget a i)))
              (aset a (unchecked-add-int i 1) (aget a i)))
            (aset a (unchecked-add-int i 1) ai))))))


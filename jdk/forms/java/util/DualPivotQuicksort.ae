                        (DualPivotQuicksort/sort
                          sorter
                          a
                          (bit-or-int bits 1)
                          (unchecked-add-int lower 1)
                          upper)
                        (DualPivotQuicksort/sort
                          sorter
                          a
                          (bit-or-int bits 1)
                          (unchecked-add-int upper 1)
                          high))))
                (let [pivotIndices (DualPivotQuicksort/partition
                                     Long/TYPE
                                     a
                                     Unsafe/ARRAY_LONG_BASE_OFFSET
                                     low
                                     high
                                     e3
                                     e3
                                     (method-ref
                                       PartitionOperation
                                       [long/1 int int int int]
                                       DualPivotQuicksort/partitionSinglePivot))]
                  (set! lower (aget pivotIndices 0))
                  (set! upper (aget pivotIndices 1))
                  (if (and (> size MIN_PARALLEL_SORT_SIZE) (some? sorter))
                      (.forkSorter sorter (bit-or-int bits 1) upper high)
                      (DualPivotQuicksort/sort sorter a (bit-or-int bits 1) upper high))))
            (set! high lower))))))

  (method ^:private ^:static ^{ForceInline true} partitionDualPivot ^int/1 [^long/1 a ^int low
                                                                            ^int high
                                                                            ^int pivotIndex1
                                                                            ^int pivotIndex2]
    (let [end (unchecked-subtract-int high 1)
          ^:mutable lower low
          ^:mutable upper end
          e1 pivotIndex1
          e5 pivotIndex2
          pivot1 (aget a e1)
          pivot2 (aget a e5)]
      (aset a e1 (aget a lower))
      (aset a e5 (aget a upper))
      (while (< (aget a (set! lower (unchecked-inc-int lower))) pivot1))
      (while (> (aget a (set! upper (unchecked-dec-int upper))) pivot2))
      (let [unused (set! lower (unchecked-dec-int lower))
            ^:mutable k (set! upper (unchecked-inc-int upper))]
        (while (> (set! k (unchecked-dec-int k)) lower)
          (let [ak (aget a k)]
            (if (< ak pivot1)
                (while (< lower k)
                  (when (>= (aget a (set! lower (unchecked-inc-int lower))) pivot1)
                    (if (> (aget a lower) pivot2)
                        (do
                          (aset a k (aget a (set! upper (unchecked-dec-int upper))))
                          (aset a upper (aget a lower)))
                        (aset a k (aget a lower)))
                    (aset a lower ak)
                    (break)))
                (when (> ak pivot2)
                  (aset a k (aget a (set! upper (unchecked-dec-int upper))))
                  (aset a upper ak))))))
      (aset a low (aget a lower))
      (aset a lower pivot1)
      (aset a end (aget a upper))
      (aset a upper pivot2)
      (new int/1 [lower upper])))

  (method ^:private ^:static ^{ForceInline true} partitionSinglePivot ^int/1 [^long/1 a ^int low
                                                                              ^int high
                                                                              ^int pivotIndex1
                                                                              ^int pivotIndex2]
    (let [end (unchecked-subtract-int high 1)
          ^:mutable lower low
          ^:mutable upper end
          e3 pivotIndex1
          pivot (aget a e3)]
      (aset a e3 (aget a lower))
      (let [^:mutable k (set! upper (unchecked-inc-int upper))]
        (while (> (set! k (unchecked-dec-int k)) lower)
          (let [ak (aget a k)]
            (when-not (== ak pivot)
              (aset a k pivot)
              (if (< ak pivot)
                  (do
                    (while (< (aget a (set! lower (unchecked-inc-int lower))) pivot))
                    (when (> (aget a lower) pivot)
                      (aset a (set! upper (unchecked-dec-int upper)) (aget a lower)))
                    (aset a lower ak))
                  (aset a (set! upper (unchecked-dec-int upper)) ak))))))
      (aset a low (aget a lower))
      (aset a lower pivot)
      (new int/1 [lower upper])))

  (method ^:private ^:static mixedInsertionSort ^void [^long/1 a ^:mutable ^int low ^int high]
    (let [size (unchecked-subtract-int high low)
          end (unchecked-subtract-int high
                                      (unchecked-multiply-int
                                        3
                                        (bit-shift-left-int (bit-shift-right-int size 5) 3)))]

  (method ^:public getTimeZone ^TimeZone [this]
    (let [zone (.getTimeZone super)] (.setZone jdate zone) zone))

  (method ^:public setTimeZone ^void [this ^TimeZone zone]
    (.setTimeZone super zone)
    (.setZone jdate zone))

  (field ^:private ^:transient ^long cachedFixedDate Long/MIN_VALUE)

  (method ^:protected computeFields ^void [this]

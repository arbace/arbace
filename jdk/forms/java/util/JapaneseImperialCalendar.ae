              (set! zoneOffset (.getOffset tz (.-time this)))
              (aset zoneOffsets 0 (.getRawOffset tz))
              (aset zoneOffsets 1 (unchecked-subtract-int zoneOffset (aget zoneOffsets 0))))))
      (when-not (== tzMask 0)

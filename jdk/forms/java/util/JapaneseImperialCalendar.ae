  (method ^:private ^:static getCalendarDate ^LocalGregorianCalendar$Date [^long fd]
    (let [d (.newCalendarDate jcal TimeZone/NO_TIMEZONE)]
      (.getCalendarDateFromFixedDate jcal d fd)
      d))

  (method ^:private monthLength ^int [this ^int month ^int gregorianYear]
    (if (CalendarUtils/isGregorianLeapYear gregorianYear)
        (aget GregorianCalendar/LEAP_MONTH_LENGTH month)
        (aget GregorianCalendar/MONTH_LENGTH month)))

  (method ^:private monthLength ^int [this ^int month]
    (java-assert (.isNormalized jdate))

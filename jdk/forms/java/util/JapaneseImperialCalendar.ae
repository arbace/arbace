      (.setDate d (.getNormalizedYear date) Gregorian/JANUARY 1)
      (.getFixedDate gcal d)))

  (method ^:private getFixedDateMonth1 ^long [this ^LocalGregorianCalendar$Date date ^long fixedDate]
    (let [eraIndex (JapaneseImperialCalendar/getTransitionEraIndex date)]

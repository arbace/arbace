  (method ^:public getDisplayName ^String [this ^int field ^int style ^Locale locale]
    (when-not (not (.checkDisplayNameParams this
                                            field
                                            style
                                            JapaneseImperialCalendar/SHORT
                                            JapaneseImperialCalendar/NARROW_FORMAT
                                            locale
                                            (bit-or-int
                                              (bit-or-int
                                                (bit-or-int
                                                  (bit-or-int
                                                    JapaneseImperialCalendar/ERA_MASK
                                                    JapaneseImperialCalendar/YEAR_MASK)
                                                  JapaneseImperialCalendar/MONTH_MASK)
                                                JapaneseImperialCalendar/DAY_OF_WEEK_MASK)
                                              JapaneseImperialCalendar/AM_PM_MASK)))
      (let [fieldValue (.get this field)]
        (when-not (and (== field JapaneseImperialCalendar/YEAR)
                       (or (or (not (== (.getBaseStyle this style) JapaneseImperialCalendar/LONG))
                               (not (== fieldValue 1)))
                           (== (.get this JapaneseImperialCalendar/ERA) 0)))
          (let [^:mutable name (CalendarDataUtility/retrieveFieldValueName
                                 (.getCalendarType this)
                                 field
                                 fieldValue
                                 style
                                 locale)]
            (when (and (and (or (nil? name) (.isEmpty name))
                            (== field JapaneseImperialCalendar/ERA))
                       (< fieldValue (alength eras)))
              (let [era (aget eras fieldValue)]
                (set! name
                      (if (== style JapaneseImperialCalendar/SHORT)
                          (.getAbbreviation era)
                          (.getName era)))))
            name)))))

  (method ^:public getDisplayNames ^{:tag (Map String Integer)} [this ^int field ^int style
                                                                 ^Locale locale]
    (when-not (not (.checkDisplayNameParams this
                                            field
                                            style
                                            JapaneseImperialCalendar/ALL_STYLES
                                            JapaneseImperialCalendar/NARROW_FORMAT
                                            locale
                                            (bit-or-int
                                              (bit-or-int
                                                (bit-or-int
                                                  (bit-or-int
                                                    JapaneseImperialCalendar/ERA_MASK
                                                    JapaneseImperialCalendar/YEAR_MASK)
                                                  JapaneseImperialCalendar/MONTH_MASK)
                                                JapaneseImperialCalendar/DAY_OF_WEEK_MASK)
                                              JapaneseImperialCalendar/AM_PM_MASK)))
      (let [^:mutable ^{:tag (Map String Integer)} names nil]
        (set! names
              (CalendarDataUtility/retrieveFieldValueNames
                (.getCalendarType this)
                field
                style
                locale))
        (when (some? names)
          (when (== field JapaneseImperialCalendar/ERA)
            (let [^:mutable size (.size names)]
              (when (== style JapaneseImperialCalendar/ALL_STYLES)
                (let [^{:tag (Set Integer)} values (HashSet.)]
                  (for-each [^String key (.keySet names)]
                    (.add values (cast Integer (.get names key))))
                  (set! size (.size values))))
              (when (< size (alength eras))
                (let [baseStyle (.getBaseStyle this style)]
                  (loop [^int i 0]
                    (if (< i (alength eras))
                        (if (not (.contains (.values names) i))
                            (let [era (aget eras i)]
                              (when (or (or (== baseStyle JapaneseImperialCalendar/ALL_STYLES)
                                            (== baseStyle JapaneseImperialCalendar/SHORT))
                                        (== baseStyle JapaneseImperialCalendar/NARROW_FORMAT))
                                (.put names (.getAbbreviation era) i))
                              (if (or (== baseStyle JapaneseImperialCalendar/ALL_STYLES)
                                      (== baseStyle JapaneseImperialCalendar/LONG))
                                  (do (.put names (.getName era) i) (recur (unchecked-inc-int i)))
                                  (recur (unchecked-inc-int i))))
                            (recur (unchecked-inc-int i)))
                        nil)))))))
        names)))

  (method ^:public getMinimum ^int [this ^int field]
    (aget MIN_VALUES field))

  (method ^:public getMaximum ^int [this ^int field]
    (switch field
      JapaneseImperialCalendar/YEAR
        (let [d (.getCalendarDate jcal Long/MAX_VALUE (.getZone this))]
          (Math/max (aget LEAST_MAX_VALUES JapaneseImperialCalendar/YEAR) (.getYear d)))
      (aget MAX_VALUES field)))

  (method ^:public getGreatestMinimum ^int [this ^int field]
    (if (== field JapaneseImperialCalendar/YEAR) 1 (aget MIN_VALUES field)))

  (method ^:public getLeastMaximum ^int [this ^int field]
    (switch field
      JapaneseImperialCalendar/YEAR
        (Math/min (aget LEAST_MAX_VALUES JapaneseImperialCalendar/YEAR)
                  (.getMaximum this JapaneseImperialCalendar/YEAR))
      (aget LEAST_MAX_VALUES field)))

  (method ^:public getActualMinimum ^int [this ^int field]
    (if (not (JapaneseImperialCalendar/isFieldSet
               (bit-or-int (bit-or-int JapaneseImperialCalendar/YEAR_MASK
                                       JapaneseImperialCalendar/MONTH_MASK)
                           JapaneseImperialCalendar/WEEK_OF_YEAR_MASK)
               field))
        (.getMinimum this field)
        (let [^:mutable ^int value 0
              jc (.getNormalizedCalendar this)
              jd (.getCalendarDate jcal (.getTimeInMillis jc) (.getZone this))
              eraIndex (JapaneseImperialCalendar/getEraIndex jd)]
          (switch field
            JapaneseImperialCalendar/YEAR
              (if (> eraIndex BEFORE_MEIJI)
                  (do
                    (set! value 1)
                    (let [since (.getSince (aget eras eraIndex) (.getZone this))
                          ^CalendarDate d (.getCalendarDate jcal since (.getZone this))]
                      (.setYear jd (.getYear d))
                      (.normalize jcal jd)

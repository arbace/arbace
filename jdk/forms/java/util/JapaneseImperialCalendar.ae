  (method ^:private computeFields ^int [this ^int fieldMask ^int tzMask]
    (let [^:mutable ^int zoneOffset 0
          tz (.getZone this)]
      (when (nil? zoneOffsets) (set! zoneOffsets (new int/1 2)))

                                      (bit-or-int
                                        (bit-or-int
                                          (bit-or-int
                                            (bit-or-int
                                              (bit-or-int
                                                (bit-or-int
                                                  (bit-or-int
                                                    (bit-or-int
                                                      JapaneseImperialCalendar/ERA_MASK

  (method ^:private ^:static getEraIndex ^int [^LocalGregorianCalendar$Date date]
    (let [era (.getEra date)]
      (loop [^int i (unchecked-subtract-int (alength eras) 1)]
        (if (> i 0)
            (if (identical? (aget eras i) era) (return i) (recur (unchecked-dec-int i)))
            nil))
      0))

  (method ^:private getNormalizedCalendar ^JapaneseImperialCalendar [this]
    (let [^:mutable ^JapaneseImperialCalendar jc nil]
      (if (.isFullyNormalized this)
          (set! jc this)
          (do
            (set! jc (cast JapaneseImperialCalendar (.clone this)))
            (.setLenient jc true)
            (.complete jc)))
      jc))

  (method ^:private pinDayOfMonth ^void [this ^LocalGregorianCalendar$Date date]
    (let [year (.getYear date)
          dom (.getDayOfMonth date)]
      (if (not (== year (.getMinimum this JapaneseImperialCalendar/YEAR)))
          (do
            (.setDayOfMonth date 1)
            (.normalize jcal date)
            (let [monthLength (.getMonthLength jcal date)]
              (if (> dom monthLength) (.setDayOfMonth date monthLength) (.setDayOfMonth date dom))
              (.normalize jcal date)))
          (let [d (.getCalendarDate jcal Long/MIN_VALUE (.getZone this))
                realDate (.getCalendarDate jcal (.-time this) (.getZone this))
                tod (.getTimeOfDay realDate)]
            (.addYear realDate 400)
            (.setMonth realDate (.getMonth date))
            (.setDayOfMonth realDate 1)
            (.normalize jcal realDate)
            (let [monthLength (.getMonthLength jcal realDate)]
              (cond
                (> dom monthLength) (.setDayOfMonth realDate monthLength)
                (< dom (.getDayOfMonth d)) (.setDayOfMonth realDate (.getDayOfMonth d))
                :else (.setDayOfMonth realDate dom))
              (when (and (== (.getDayOfMonth realDate) (.getDayOfMonth d))
                         (< tod (.getTimeOfDay d)))
                (.setDayOfMonth realDate (Math/min (unchecked-add-int dom 1) monthLength)))
              (.setDate date year (.getMonth realDate) (.getDayOfMonth realDate)))))))

  (method ^:private ^:static getRolledValue ^int [^int value ^:mutable ^int amount ^int min ^int max]
    (java-assert (and (>= value min) (<= value max)))
    (let [range (unchecked-add-int (unchecked-subtract-int max min) 1)]
      (set! amount (unchecked-remainder-int amount range))
      (let [^:mutable n (unchecked-add-int value amount)]
        (cond
          (> n max) (set! n (unchecked-subtract-int n range))
          (< n min) (set! n (unchecked-add-int n range)))
        (java-assert (and (>= n min) (<= n max)))
        n)))

  (method ^:private internalGetEra ^int [this]
    (if (.isSet this JapaneseImperialCalendar/ERA)
        (.internalGet this JapaneseImperialCalendar/ERA)
        currentEra))

  (method ^:private readObject :throws [IOException ClassNotFoundException] ^void [this
                                                                                   ^ObjectInputStream stream]
    (.defaultReadObject stream)
    (when (nil? jdate)
      (set! jdate (.newCalendarDate jcal (.getZone this)))
      (set! cachedFixedDate Long/MIN_VALUE))))

  (method newTreeNode ^{:tag (TreeNode K V)} [this ^int hash ^K key ^V value ^{:tag (Node K V)} next]
    (TreeNode. hash key value next))

  (method replacementTreeNode ^{:tag (TreeNode K V)} [this ^{:tag (Node K V)} p
                                                      ^{:tag (Node K V)} next]
    (TreeNode. (.-hash p) (.-key p) (.-value p) next))

  (method reinitialize ^void [this]
    (set! table nil)
    (set! entrySet nil)
    (set! (.-keySet this) nil)
    (set! (.-values this) nil)
    (set! modCount 0)
    (set! threshold 0)
    (set! size 0))

  (method afterNodeAccess ^void [this ^{:tag (Node K V)} p])

  (method afterNodeInsertion ^void [this ^boolean evict])

  (method afterNodeRemoval ^void [this ^{:tag (Node K V)} p])

  (method internalWriteEntries :throws [IOException] ^void [this ^ObjectOutputStream s]
    (let [^:mutable ^{:tag (array (Node K V))} tab nil]
      (when (and (> size 0) (some? (set! tab table)))
        (for-each [^:mutable ^{:tag (Node K V)} e tab]
          (while (some? e)
            (.writeObject s (.-key e))
            (.writeObject s (.-value e))
            (set! e (.-next e)))))))

  (defclass ^:static ^:final TreeNode
    :extends (LinkedHashMap$Entry K V)
    :type-params [K V]

    (field ^{:tag (TreeNode K V)} parent)

    (field ^{:tag (TreeNode K V)} left)

    (field ^{:tag (TreeNode K V)} right)

    (field ^{:tag (TreeNode K V)} prev)

    (field ^boolean red)

    (constructor [this ^int hash ^K key ^V val ^{:tag (Node K V)} next]
      (super. hash key val next))

    (method ^:final root ^{:tag (TreeNode K V)} [this]
      (let [^:mutable ^{:tag (TreeNode K V)} r this
            ^:mutable ^{:tag (TreeNode K V)} p nil]
        (while true (when (nil? (set! p (.-parent r))) (return r)) (set! r p))))

    (method ^:static moveRootToFront :type-params [K V] ^void [^{:tag (array (Node K V))} tab
                                                               ^{:tag (TreeNode K V)} root]
      (let [^:mutable ^int n 0]
        (when (and (and (some? root) (some? tab)) (> (set! n (alength tab)) 0))
          (let [index (bit-and-int (unchecked-subtract-int n 1) (.-hash root))
                ^{:tag (TreeNode K V)} first (cast TreeNode (aget tab index))]
            (when-not (identical? root first)
              (let [^:mutable ^{:tag (Node K V)} rn nil]
                (aset tab index root)
                (let [^{:tag (TreeNode K V)} rp (.-prev root)]
                  (when (some? (set! rn (.-next root))) (set! (.-prev (cast TreeNode rn)) rp))
                  (when (some? rp) (set! (.-next rp) rn))
                  (when (some? first) (set! (.-prev first) root))
                  (set! (.-next root) first)
                  (set! (.-prev root) nil))))
            (java-assert (TreeNode/checkInvariants root))))))

    (method ^:final find ^{:tag (TreeNode K V)} [this ^int h k ^:mutable ^{:tag (Class ?)} kc]
      (let [^:mutable ^{:tag (TreeNode K V)} p this]
        (loop []
          (let [^:mutable ^int ph 0
                ^:mutable ^int dir 0
                ^:mutable ^K pk nil
                ^{:tag (TreeNode K V)} pl (.-left p)
                ^{:tag (TreeNode K V)} pr (.-right p)
                ^:mutable ^{:tag (TreeNode K V)} q nil]
            (cond
              (> (set! ph (.-hash p)) h) (set! p pl)
              (< ph h) (set! p pr)
              (or (identical? (set! pk (.-key p)) k) (and (some? k) (.equals k pk))) (return p)
              (nil? pl) (set! p pr)
              (nil? pr) (set! p pl)
              (and (or (some? kc) (some? (set! kc (HashMap/comparableClassFor k))))
                   (not (== (set! dir (HashMap/compareComparables kc k pk)) 0)))
                (set! p (if (< dir 0) pl pr))
              (some? (set! q (.find pr h k kc))) (return q)
              :else (set! p pl)))
          (when (some? p) (recur)))
        nil))

    (method ^:final getTreeNode ^{:tag (TreeNode K V)} [this ^int h k]
      (.find (if (some? parent) (.root this) this) h k nil))

    (method ^:static tieBreakOrder ^int [a b]
      (let [^:mutable ^int d 0]
        (when (or (or (nil? a) (nil? b))
                  (== (set! d (.compareTo (.getName (.getClass a)) (.getName (.getClass b)))) 0))
          (set! d (if (<= (System/identityHashCode a) (System/identityHashCode b)) -1 1)))
        d))

    (method ^:final treeify ^void [this ^{:tag (array (Node K V))} tab]
      (let [^:mutable ^{:tag (TreeNode K V)} root nil]
        (let [^:mutable ^{:tag (TreeNode K V)} x this
              ^:mutable ^{:tag (TreeNode K V)} next nil]
          (while (some? x)
            (set! next (cast TreeNode (.-next x)))
            (set! (.-left x) (set! (.-right x) nil))
            (if (nil? root)
                (do (set! (.-parent x) nil) (set! (.-red x) false) (set! root x))
                (let [^K k (.-key x)
                      h (.-hash x)
                      ^:mutable ^{:tag (Class ?)} kc nil
                      ^:mutable ^{:tag (TreeNode K V)} p root]
                  (while true
                    (let [^:mutable ^int dir 0
                          ^:mutable ^int ph 0
                          ^K pk (.-key p)]
                      (cond
                        (> (set! ph (.-hash p)) h) (set! dir -1)
                        (< ph h) (set! dir 1)
                        (or (and (nil? kc) (nil? (set! kc (HashMap/comparableClassFor k))))
                            (== (set! dir (HashMap/compareComparables kc k pk)) 0))
                          (set! dir (TreeNode/tieBreakOrder k pk)))
                      (let [^{:tag (TreeNode K V)} xp p]
                        (when (nil? (set! p (if (<= dir 0) (.-left p) (.-right p))))
                          (set! (.-parent x) xp)
                          (if (<= dir 0) (set! (.-left xp) x) (set! (.-right xp) x))
                          (set! root (TreeNode/balanceInsertion root x))
                          (break)))))))
            (set! x next)))
        (TreeNode/moveRootToFront tab root)))

    (method ^:final untreeify ^{:tag (Node K V)} [this ^{:tag (HashMap K V)} map]
      (let [^:mutable ^{:tag (Node K V)} hd nil
            ^:mutable ^{:tag (Node K V)} tl nil]
        (loop [^{:tag (Node K V)} q this]
          (when (some? q)
            (let [^{:tag (Node K V)} p (.replacementNode map q nil)]
              (if (nil? tl) (set! hd p) (set! (.-next tl) p))
              (set! tl p)
              (recur (.-next q)))))
        hd))

    (method ^:final putTreeVal ^{:tag (TreeNode K V)} [this ^{:tag (HashMap K V)} map
                                                       ^{:tag (array (Node K V))} tab ^int h ^K k
                                                       ^V v]
      (let [^:mutable ^{:tag (Class ?)} kc nil
            ^:mutable searched false
            ^{:tag (TreeNode K V)} root (if (some? parent) (.root this) this)
            ^:mutable ^{:tag (TreeNode K V)} p root]
        (while true
          (let [^:mutable ^int dir 0
                ^:mutable ^int ph 0
                ^:mutable ^K pk nil]
            (cond
              (> (set! ph (.-hash p)) h) (set! dir -1)
              (< ph h) (set! dir 1)
              (or (identical? (set! pk (.-key p)) k) (and (some? k) (.equals k pk))) (return p)
              :else
                (when (or (and (nil? kc) (nil? (set! kc (HashMap/comparableClassFor k))))
                          (== (set! dir (HashMap/compareComparables kc k pk)) 0))
                  (when-not searched
                    (let [^:mutable ^{:tag (TreeNode K V)} q nil
                          ^:mutable ^{:tag (TreeNode K V)} ch nil]
                      (set! searched true)
                      (when (or (and (some? (set! ch (.-left p)))
                                     (some? (set! q (.find ch h k kc))))
                                (and (some? (set! ch (.-right p)))
                                     (some? (set! q (.find ch h k kc)))))
                        (return q))))
                  (set! dir (TreeNode/tieBreakOrder k pk))))
            (let [^{:tag (TreeNode K V)} xp p]
              (when (nil? (set! p (if (<= dir 0) (.-left p) (.-right p))))
                (let [^{:tag (Node K V)} xpn (.-next xp)
                      ^{:tag (TreeNode K V)} x (.newTreeNode map h k v xpn)]
                  (if (<= dir 0) (set! (.-left xp) x) (set! (.-right xp) x))
                  (set! (.-next xp) x)
                  (set! (.-parent x) (set! (.-prev x) xp))
                  (when (some? xpn) (set! (.-prev (cast TreeNode xpn)) x))
                  (TreeNode/moveRootToFront tab (TreeNode/balanceInsertion root x))
                  (return nil))))))))

    (method ^:final removeTreeNode ^void [this ^{:tag (HashMap K V)} map
                                          ^{:tag (array (Node K V))} tab ^boolean movable]
      (let [^:mutable ^int n 0]
        (when-not (or (nil? tab) (== (set! n (alength tab)) 0))
          (let [index (bit-and-int (unchecked-subtract-int n 1) (.-hash this))
                ^:mutable ^{:tag (TreeNode K V)} first (cast TreeNode (aget tab index))
                ^:mutable ^{:tag (TreeNode K V)} root first
                ^:mutable ^{:tag (TreeNode K V)} rl nil
                ^{:tag (TreeNode K V)} succ (cast TreeNode (.-next this))
                ^{:tag (TreeNode K V)} pred prev]
            (if (nil? pred) (aset tab index (set! first succ)) (set! (.-next pred) succ))
            (when (some? succ) (set! (.-prev succ) pred))
            (when (some? first)
              (when (some? (.-parent root)) (set! root (.root root)))
              (if (or (nil? root)
                      (and movable
                           (or (or (nil? (.-right root)) (nil? (set! rl (.-left root))))
                               (nil? (.-left rl)))))
                  (aset tab index (.untreeify first map))
                  (let [^{:tag (TreeNode K V)} p this
                        ^{:tag (TreeNode K V)} pl left
                        ^{:tag (TreeNode K V)} pr right
                        ^:mutable ^{:tag (TreeNode K V)} replacement nil]
                    (cond
                      (and (some? pl) (some? pr))
                        (let [^:mutable ^{:tag (TreeNode K V)} s pr
                              ^:mutable ^{:tag (TreeNode K V)} sl nil]
                          (while (some? (set! sl (.-left s))) (set! s sl))
                          (let [c (.-red s)]
                            (set! (.-red s) (.-red p))
                            (set! (.-red p) c)
                            (let [^{:tag (TreeNode K V)} sr (.-right s)
                                  ^{:tag (TreeNode K V)} pp (.-parent p)]
                              (if (identical? s pr)
                                  (do (set! (.-parent p) s) (set! (.-right s) p))
                                  (let [^{:tag (TreeNode K V)} sp (.-parent s)]
                                    (when (some? (set! (.-parent p) sp))
                                      (if (identical? s (.-left sp))
                                          (set! (.-left sp) p)
                                          (set! (.-right sp) p)))
                                    (when (some? (set! (.-right s) pr)) (set! (.-parent pr) s))))
                              (set! (.-left p) nil)
                              (when (some? (set! (.-right p) sr)) (set! (.-parent sr) p))
                              (when (some? (set! (.-left s) pl)) (set! (.-parent pl) s))
                              (cond
                                (nil? (set! (.-parent s) pp)) (set! root s)
                                (identical? p (.-left pp)) (set! (.-left pp) s)
                                :else (set! (.-right pp) s))
                              (if (some? sr) (set! replacement sr) (set! replacement p)))))
                      (some? pl) (set! replacement pl)
                      (some? pr) (set! replacement pr)
                      :else (set! replacement p))
                    (when-not (identical? replacement p)
                      (let [^{:tag (TreeNode K V)} pp (set! (.-parent replacement) (.-parent p))]
                        (cond
                          (nil? pp) (set! (.-red (set! root replacement)) false)
                          (identical? p (.-left pp)) (set! (.-left pp) replacement)
                          :else (set! (.-right pp) replacement))
                        (set! (.-left p) (set! (.-right p) (set! (.-parent p) nil)))))
                    (let [^{:tag (TreeNode K V)} r (if (.-red p)
                                                       root
                                                       (TreeNode/balanceDeletion root replacement))]
                      (when (identical? replacement p)
                        (let [^{:tag (TreeNode K V)} pp (.-parent p)]
                          (set! (.-parent p) nil)
                          (when (some? pp)
                            (cond
                              (identical? p (.-left pp)) (set! (.-left pp) nil)
                              (identical? p (.-right pp)) (set! (.-right pp) nil)))))
                      (when movable (TreeNode/moveRootToFront tab r))))))))))

    (method ^:final split ^void [this ^{:tag (HashMap K V)} map ^{:tag (array (Node K V))} tab
                                 ^int index ^int bit]
      (let [^{:tag (TreeNode K V)} b this
            ^:mutable ^{:tag (TreeNode K V)} loHead nil
            ^:mutable ^{:tag (TreeNode K V)} loTail nil
            ^:mutable ^{:tag (TreeNode K V)} hiHead nil
            ^:mutable ^{:tag (TreeNode K V)} hiTail nil
            ^:mutable ^int lc 0
            ^:mutable ^int hc 0]
        (let [^:mutable ^{:tag (TreeNode K V)} e b
              ^:mutable ^{:tag (TreeNode K V)} next nil]
          (while (some? e)
            (set! next (cast TreeNode (.-next e)))
            (set! (.-next e) nil)
            (if (== (bit-and-int (.-hash e) bit) 0)
                (do
                  (if (nil? (set! (.-prev e) loTail)) (set! loHead e) (set! (.-next loTail) e))
                  (set! loTail e)
                  (set! lc (unchecked-inc-int lc)))
                (do
                  (if (nil? (set! (.-prev e) hiTail)) (set! hiHead e) (set! (.-next hiTail) e))
                  (set! hiTail e)
                  (set! hc (unchecked-inc-int hc))))
            (set! e next)))
        (when (some? loHead)
          (if (<= lc UNTREEIFY_THRESHOLD)
              (aset tab index (.untreeify loHead map))
              (do (aset tab index loHead) (when (some? hiHead) (.treeify loHead tab)))))
        (when (some? hiHead)
          (if (<= hc UNTREEIFY_THRESHOLD)
              (aset tab (unchecked-add-int index bit) (.untreeify hiHead map))
              (do
                (aset tab (unchecked-add-int index bit) hiHead)
                (when (some? loHead) (.treeify hiHead tab)))))))

    (method ^:static rotateLeft :type-params [K V] ^{:tag (TreeNode K V)} [^:mutable ^{:tag (TreeNode K V)} root
                                                                           ^{:tag (TreeNode K V)} p]
      (let [^:mutable ^{:tag (TreeNode K V)} r nil
            ^:mutable ^{:tag (TreeNode K V)} pp nil
            ^:mutable ^{:tag (TreeNode K V)} rl nil]
        (when (and (some? p) (some? (set! r (.-right p))))
          (when (some? (set! rl (set! (.-right p) (.-left r)))) (set! (.-parent rl) p))
          (cond
            (nil? (set! pp (set! (.-parent r) (.-parent p)))) (set! (.-red (set! root r)) false)
            (identical? (.-left pp) p) (set! (.-left pp) r)
            :else (set! (.-right pp) r))
          (set! (.-left r) p)
          (set! (.-parent p) r))
        root))

    (method ^:static rotateRight :type-params [K V] ^{:tag (TreeNode K V)} [^:mutable ^{:tag (TreeNode K V)} root
                                                                            ^{:tag (TreeNode K V)} p]
      (let [^:mutable ^{:tag (TreeNode K V)} l nil
            ^:mutable ^{:tag (TreeNode K V)} pp nil
            ^:mutable ^{:tag (TreeNode K V)} lr nil]
        (when (and (some? p) (some? (set! l (.-left p))))
          (when (some? (set! lr (set! (.-left p) (.-right l)))) (set! (.-parent lr) p))
          (cond
            (nil? (set! pp (set! (.-parent l) (.-parent p)))) (set! (.-red (set! root l)) false)
            (identical? (.-right pp) p) (set! (.-right pp) l)
            :else (set! (.-left pp) l))
          (set! (.-right l) p)
          (set! (.-parent p) l))
        root))

    (method ^:static balanceInsertion :type-params [K V] ^{:tag (TreeNode K V)} [^:mutable ^{:tag (TreeNode K V)} root
                                                                                 ^:mutable ^{:tag (TreeNode K V)} x]
      (set! (.-red x) true)
      (let [^:mutable ^{:tag (TreeNode K V)} xp nil
            ^:mutable ^{:tag (TreeNode K V)} xpp nil
            ^:mutable ^{:tag (TreeNode K V)} xppl nil
            ^:mutable ^{:tag (TreeNode K V)} xppr nil]
        (while true
          (cond
            (nil? (set! xp (.-parent x))) (do (set! (.-red x) false) (return x))
            (or (not (.-red xp)) (nil? (set! xpp (.-parent xp)))) (return root))
          (cond
            (identical? xp (set! xppl (.-left xpp)))
              (if (and (some? (set! xppr (.-right xpp))) (.-red xppr))
                  (do
                    (set! (.-red xppr) false)
                    (set! (.-red xp) false)
                    (set! (.-red xpp) true)
                    (set! x xpp))
                  (do
                    (when (identical? x (.-right xp))
                      (set! root (TreeNode/rotateLeft root (set! x xp)))
                      (set! xpp (when (some? (set! xp (.-parent x))) (.-parent xp))))
                    (when (some? xp)
                      (set! (.-red xp) false)
                      (when (some? xpp)
                        (set! (.-red xpp) true)
                        (set! root (TreeNode/rotateRight root xpp))))))
            (and (some? xppl) (.-red xppl))
              (do
                (set! (.-red xppl) false)
                (set! (.-red xp) false)
                (set! (.-red xpp) true)
                (set! x xpp))
            :else
              (do
                (when (identical? x (.-left xp))
                  (set! root (TreeNode/rotateRight root (set! x xp)))
                  (set! xpp (when (some? (set! xp (.-parent x))) (.-parent xp))))
                (when (some? xp)
                  (set! (.-red xp) false)
                  (when (some? xpp)
                    (set! (.-red xpp) true)
                    (set! root (TreeNode/rotateLeft root xpp)))))))))

    (method ^:static balanceDeletion :type-params [K V] ^{:tag (TreeNode K V)} [^:mutable ^{:tag (TreeNode K V)} root
                                                                                ^:mutable ^{:tag (TreeNode K V)} x]
      (let [^:mutable ^{:tag (TreeNode K V)} xp nil
            ^:mutable ^{:tag (TreeNode K V)} xpl nil
            ^:mutable ^{:tag (TreeNode K V)} xpr nil]
        (while true
          (cond
            (or (nil? x) (identical? x root)) (return root)
            (nil? (set! xp (.-parent x))) (do (set! (.-red x) false) (return x))
            (.-red x) (do (set! (.-red x) false) (return root))
            (identical? (set! xpl (.-left xp)) x)
              (do
                (when (and (some? (set! xpr (.-right xp))) (.-red xpr))
                  (set! (.-red xpr) false)
                  (set! (.-red xp) true)
                  (set! root (TreeNode/rotateLeft root xp))
                  (set! xpr (when (some? (set! xp (.-parent x))) (.-right xp))))
                (if (nil? xpr)
                    (set! x xp)
                    (let [^{:tag (TreeNode K V)} sl (.-left xpr)
                          ^:mutable ^{:tag (TreeNode K V)} sr (.-right xpr)]
                      (if (and (or (nil? sr) (not (.-red sr))) (or (nil? sl) (not (.-red sl))))
                          (do (set! (.-red xpr) true) (set! x xp))
                          (do
                            (when (or (nil? sr) (not (.-red sr)))
                              (when (some? sl) (set! (.-red sl) false))
                              (set! (.-red xpr) true)
                              (set! root (TreeNode/rotateRight root xpr))
                              (set! xpr (when (some? (set! xp (.-parent x))) (.-right xp))))
                            (when (some? xpr)
                              (set! (.-red xpr) (if (nil? xp) false (.-red xp)))
                              (when (some? (set! sr (.-right xpr))) (set! (.-red sr) false)))
                            (when (some? xp)
                              (set! (.-red xp) false)
                              (set! root (TreeNode/rotateLeft root xp)))
                            (set! x root))))))
            :else
              (do
                (when (and (some? xpl) (.-red xpl))
                  (set! (.-red xpl) false)
                  (set! (.-red xp) true)
                  (set! root (TreeNode/rotateRight root xp))
                  (set! xpl (when (some? (set! xp (.-parent x))) (.-left xp))))
                (if (nil? xpl)
                    (set! x xp)
                    (let [^:mutable ^{:tag (TreeNode K V)} sl (.-left xpl)
                          ^{:tag (TreeNode K V)} sr (.-right xpl)]
                      (if (and (or (nil? sl) (not (.-red sl))) (or (nil? sr) (not (.-red sr))))
                          (do (set! (.-red xpl) true) (set! x xp))
                          (do
                            (when (or (nil? sl) (not (.-red sl)))
                              (when (some? sr) (set! (.-red sr) false))
                              (set! (.-red xpl) true)
                              (set! root (TreeNode/rotateLeft root xpl))
                              (set! xpl (when (some? (set! xp (.-parent x))) (.-left xp))))
                            (when (some? xpl)
                              (set! (.-red xpl) (if (nil? xp) false (.-red xp)))
                              (when (some? (set! sl (.-left xpl))) (set! (.-red sl) false)))
                            (when (some? xp)
                              (set! (.-red xp) false)
                              (set! root (TreeNode/rotateRight root xp)))
                            (set! x root))))))))))

    (method ^:static checkInvariants :type-params [K V] ^boolean [^{:tag (TreeNode K V)} t]
      (let [^{:tag (TreeNode K V)} tp (.-parent t)
            ^{:tag (TreeNode K V)} tl (.-left t)
            ^{:tag (TreeNode K V)} tr (.-right t)
            ^{:tag (TreeNode K V)} tb (.-prev t)
            ^{:tag (TreeNode K V)} tn (cast TreeNode (.-next t))]
        (cond
          (and (some? tb) (not (identical? (.-next tb) t))) false
          (and (some? tn) (not (identical? (.-prev tn) t))) false
          (and (and (some? tp) (not (identical? t (.-left tp)))) (not (identical? t (.-right tp))))
            false
          (and (some? tl) (or (not (identical? (.-parent tl) t)) (> (.-hash tl) (.-hash t)))) false
          (and (some? tr) (or (not (identical? (.-parent tr) t)) (< (.-hash tr) (.-hash t)))) false
          (and (and (and (and (.-red t) (some? tl)) (.-red tl)) (some? tr)) (.-red tr)) false
          (and (some? tl) (not (TreeNode/checkInvariants tl))) false
          (and (some? tr) (not (TreeNode/checkInvariants tr))) false
          :else true))))

  (method ^:static calculateHashMapCapacity ^int [^int numMappings]
    (unchecked-int (Math/ceil (unchecked-divide numMappings (double DEFAULT_LOAD_FACTOR)))))

  (method ^:public ^:static newHashMap :type-params [K V] ^{:tag (HashMap K V)} [^int numMappings]
    (when (< numMappings 0)
      (throw (IllegalArgumentException. (java-str "Negative number of mappings: " numMappings))))
    (HashMap. (HashMap/calculateHashMapCapacity numMappings))))

                        (do (.closeOnComplete this s) (break))
                      (or empty (== d 0))
                        (let [^int bit (if (not (== (bit-and-int c ACTIVE) 0)) ACTIVE RUN)]
                          (when (and (.weakCasCtl this c (bit-and-int c (bit-not-int bit)))
                                     (== bit RUN))
                            (break)))))))))))

    (method ^:final takeItems ^int [this ^{:tag (Flow$Subscriber (? super T))} s ^long d
                                    ^:mutable ^int h]
      (let [^:mutable ^Object/1 a nil
            ^:mutable ^int k 0
            ^:mutable ^int cap 0]
        (when (and (some? (set! a array)) (> (set! cap (alength a)) 0))
          (let [m (unchecked-subtract-int cap 1)
                b (unchecked-add-int (unsigned-bit-shift-right-int m 3) 1)
                ^int n (if (< d (long b)) (unchecked-int d) b)]
            (while (< k n)
              (let [x (^[Object/1 int Void] VarHandle/.getAndSet QA a (bit-and-int h m) nil)]
                (when-not (== waiting 0) (.signalWaiter this))
                (if (nil? x) (break) (when-not (.consumeNext this s x) (break))))
              (set! h (unchecked-inc-int h))
              (set! k (unchecked-inc-int k)))))
        k))

    (method ^:final consumeNext ^boolean [this ^{:tag (Flow$Subscriber (? super T))} s x]
      (try
        (let [^T y x] (when (some? s) (.onNext s y)) true)
        (catch Throwable ex (.handleOnNext this s ex) false)))

    (method ^:final handleOnNext ^void [this ^{:tag (Flow$Subscriber (? super T))} s ^Throwable ex]
      (let [^:mutable ^{:tag (BiConsumer (? super (Flow$Subscriber (? super T))) (? super Throwable))} h
              nil]
        (try (when (some? (set! h onNextHandler)) (.accept h s ex)) (catch Throwable ignore))
        (.closeOnError this s ex)))

    (method ^:final subscribeOnOpen ^void [this ^{:tag (Flow$Subscriber (? super T))} s]
      (when (and (== (bit-and-int ctl OPEN) 0)
                 (== (bit-and-int (.getAndBitwiseOrCtl this OPEN) OPEN) 0))
        (.consumeSubscribe this s)))

    (method ^:final consumeSubscribe ^void [this ^{:tag (Flow$Subscriber (? super T))} s]
      (try (when (some? s) (.onSubscribe s this)) (catch Throwable ex (.closeOnError this s ex))))

    (method ^:final closeOnComplete ^void [this ^{:tag (Flow$Subscriber (? super T))} s]
      (when (== (bit-and-int (.getAndBitwiseOrCtl this CLOSED) CLOSED) 0) (.consumeComplete this s)))

    (method ^:final consumeComplete ^void [this ^{:tag (Flow$Subscriber (? super T))} s]
      (try (when (some? s) (.onComplete s)) (catch Throwable ignore)))

    (method ^:final closeOnError ^void [this ^{:tag (Flow$Subscriber (? super T))} s
                                        ^:mutable ^Throwable ex]
      (when (== (bit-and-int (.getAndBitwiseOrCtl this (bit-or-int ERROR CLOSED)) CLOSED) 0)
        (when (nil? ex) (set! ex pendingError))
        (set! pendingError nil)
        (set! executor nil)
        (.signalWaiter this)
        (.consumeError this s ex)))

    (method ^:final consumeError ^void [this ^{:tag (Flow$Subscriber (? super T))} s ^Throwable ex]
      (try (when (and (some? ex) (some? s)) (.onError s ex)) (catch Throwable ignore)))

    (method ^:final signalWaiter ^void [this]
      (let [^:mutable ^Thread w nil]
        (set! waiting 0)
        (when (some? (set! w waiter)) (LockSupport/unpark w))))

    (method ^:public ^:final isReleasable ^boolean [this]
      (let [^:mutable ^Object/1 a nil
            ^:mutable ^int cap 0]
        (or (not (== (bit-and-int ctl CLOSED) 0))
            (and (and (some? (set! a array)) (> (set! cap (alength a)) 0))
                 (nil? (^[Object/1 int] VarHandle/.getAcquire
                         QA
                         a
                         (bit-and-int (unchecked-subtract-int cap 1) tail)))))))

    (method ^:final awaitSpace ^void [this ^long nanos]
      (when-not (.isReleasable this)
        (ForkJoinPool/helpAsyncBlocker executor this)
        (when-not (.isReleasable this)
          (set! timeout nanos)
          (try
            (ForkJoinPool/managedBlock this)
            (catch InterruptedException ie (set! timeout INTERRUPTED)))
          (when (== timeout INTERRUPTED) (.interrupt (Thread/currentThread))))))

    (method ^:public ^:final block ^boolean [this]
      (let [^:mutable nanos timeout
            timed (< nanos Long/MAX_VALUE)
            deadline (if timed (unchecked-add (System/nanoTime) nanos) 0)]
        (while (not (.isReleasable this))
          (cond
            (Thread/interrupted) (do (set! timeout INTERRUPTED) (when timed (break)))
            (and timed (<= (set! nanos (unchecked-subtract deadline (System/nanoTime))) 0)) (break)
            (nil? waiter) (set! waiter (Thread/currentThread))
            (== waiting 0) (set! waiting 1)
            timed (LockSupport/parkNanos this nanos)
            :else (LockSupport/park this)))
        (set! waiter nil)
        (set! waiting 0)
        true))

    (field ^:static ^:final ^VarHandle CTL)

    (field ^:static ^:final ^VarHandle DEMAND)

    (field ^:static ^:final ^VarHandle QA)

    (static-initializer
      (let [l (MethodHandles/lookup)]
        (set! CTL (MhUtil/findVarHandle l "ctl" Integer/TYPE))
        (set! DEMAND (MhUtil/findVarHandle l "demand" Long/TYPE))
        (set! QA (MethodHandles/arrayElementVarHandle Object/1))
        (let [^{:tag (Class ?)} ensureLoaded LockSupport] nil)))))

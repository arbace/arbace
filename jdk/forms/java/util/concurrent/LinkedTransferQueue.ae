                        (when (and (.equals o item) (.tryMatchData this p item))
                          (.skipDeadNodes this pred p p q)
                          (return true))
                        (set! pred p)
                        (set! p q)
                        (continue))
                      (when-not isData (break)))
                  (let [c p]
                    (while true
                      (when (or (nil? q) (not (.matched q)))
                        (set! pred (.skipDeadNodes this pred c p q))
                        (set! p q)
                        (break))
                      (when (identical? p (set! p q)) (continue :restartFromHead))
                      (set! q (.-next p)))))))
            (return false)))))

  (method ^:public contains ^boolean [this o]
    (if (nil? o)
        false
        (label :restartFromHead
          (while true
            (let [^:mutable p head
                  ^:mutable ^DualNode pred nil]
              (while (some? p)
                (let [isData (.-isData p)
                      item (.-item p)
                      ^:mutable q (.-next p)]
                  (if (some? item)
                      (when isData
                        (when (.equals o item) (return true))
                        (set! pred p)
                        (set! p q)
                        (continue))
                      (when-not isData (break)))
                  (let [c p]
                    (while true
                      (when (or (nil? q) (not (.matched q)))
                        (set! pred (.skipDeadNodes this pred c p q))
                        (set! p q)
                        (break))
                      (when (identical? p (set! p q)) (continue :restartFromHead))
                      (set! q (.-next p)))))))
            (return false)))))

  (method ^:public remainingCapacity ^int [this] Integer/MAX_VALUE)

  (method ^:private writeObject :throws [IOException] ^void [this ^ObjectOutputStream s]
    (.defaultWriteObject s)
    (for-each [e this] (.writeObject s e))
    (.writeObject s nil))

  (method ^:private readObject :throws [IOException ClassNotFoundException] ^void [this
                                                                                   ^ObjectInputStream s]
    (let [^:mutable ^DualNode h nil
          ^:mutable ^DualNode t nil]
      (let [^:mutable ^Object item nil]
        (while (some? (set! item (.readObject s)))
          (let [newNode (DualNode. item true)]
            (if (nil? t) (set! h newNode) (set! (.-next t) newNode))
            (set! t newNode))))
      (set! head h)
      (set! tail t)))

  (method ^:public removeIf ^boolean [this ^{:tag (Predicate (? super E))} filter]
    (Objects/requireNonNull filter)
    (.bulkRemove this filter))

  (method ^:public removeAll ^boolean [this ^{:tag (Collection ?)} c]
    (Objects/requireNonNull c)
    (.bulkRemove this (lambda Predicate ^boolean [e] (.contains c e))))

  (method ^:public retainAll ^boolean [this ^{:tag (Collection ?)} c]
    (Objects/requireNonNull c)
    (.bulkRemove this (lambda Predicate ^boolean [e] (not (.contains c e)))))

  (method ^:public clear ^void [this]
    (.bulkRemove this (lambda Predicate ^boolean [e] true)))

  (field ^:private ^:static ^:final ^int MAX_HOPS 8)

  (method ^:private bulkRemove ^boolean [this ^{:tag (Predicate (? super E))} filter]
    (let [^:mutable removed false]
      (label :restartFromHead
        (while true
          (let [^:mutable hops MAX_HOPS]
            (let [^:mutable p head
                  ^:mutable c p
                  ^:mutable ^DualNode pred nil
                  ^:mutable ^DualNode q nil]
              (while (some? p)
                (let [isData (.-isData p)
                      ^:mutable ^boolean pAlive false
                      item (.-item p)]
                  (set! q (.-next p))
                  (cond
                    (set! pAlive (and (some? item) isData))
                      (when (.test filter item)
                        (when (.tryMatchData this p item) (set! removed true))
                        (set! pAlive false))
                    (and (not isData) (nil? item)) (break))
                  (cond
                    (or (or pAlive (nil? q)) (== (set! hops (unchecked-dec-int hops)) 0))
                      (when (or (and (not (identical? c p))
                                     (not (.tryCasSuccessor this pred c (set! c p))))
                                pAlive)
                        (set! hops MAX_HOPS)
                        (set! pred p)
                        (set! c q))
                    (identical? p q) (continue :restartFromHead)))
                (set! p q)))
            (return removed))))))

  (method forEachFrom ^void [this ^{:tag (Consumer (? super E))} action ^:mutable ^DualNode p]
    (let [^:mutable ^DualNode pred nil]
      (while (some? p)
        (let [isData (.-isData p)
              item (.-item p)
              ^:mutable q (.-next p)]
          (if (some? item)
              (when isData (.accept action item) (set! pred p) (set! p q) (continue))
              (when-not isData (break)))
          (let [c p]
            (while true
              (when (or (nil? q) (not (.matched q)))
                (set! pred (.skipDeadNodes this pred c p q))
                (set! p q)
                (break))
              (when (identical? p (set! p q)) (set! pred nil) (set! p head) (break))
              (set! q (.-next p))))))))

  (method ^:public forEach ^void [this ^{:tag (Consumer (? super E))} action]
    (Objects/requireNonNull action)
    (.forEachFrom this action head))

  (field ^:static ^:final ^VarHandle HEAD)

  (field ^:static ^:final ^VarHandle TAIL)

  (field ^:static ^:final ^VarHandle SWEEPVOTES)

  (static-initializer
    (try
      (let [^{:tag (Class ?)} ltq LinkedTransferQueue
            ^{:tag (Class ?)} tn DualNode
            l (MethodHandles/lookup)]
        (set! HEAD (.findVarHandle l ltq "head" tn))
        (set! TAIL (.findVarHandle l ltq "tail" tn))
        (set! SWEEPVOTES (.findVarHandle l ltq "sweepVotes" Integer/TYPE)))
      (catch ReflectiveOperationException e (throw (ExceptionInInitializerError. e))))))

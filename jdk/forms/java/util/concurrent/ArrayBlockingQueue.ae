                  ^:mutable ^int to (if (< i end) end (alength items))]
              (while true
                (while (< i to)
                  (when (.test filter (ArrayBlockingQueue/itemAt items i))
                    (return (.bulkRemoveModified this filter i)))
                  (set! i (unchecked-inc-int i)))
                (when (== to end) (break))
                (set! i 0)
                (set! to end))))
          (return false))
        (finally (.unlock lock)))
      (.removeIf super filter)))

  (method ^:private ^:static nBits ^long/1 [^int n]
    (new long/1 (unchecked-add-int (bit-shift-right-int (unchecked-subtract-int n 1) 6) 1)))

  (method ^:private ^:static setBit ^void [^long/1 bits ^int i]
    (let [i-1 (bit-shift-right-int i 6)]
      (aset bits i-1 (bit-or (aget bits i-1) (bit-shift-left 1 i)))))

  (method ^:private ^:static isClear ^boolean [^long/1 bits ^int i]
    (== (bit-and (aget bits (bit-shift-right-int i 6)) (bit-shift-left 1 i)) 0))

  (method ^:private distanceNonEmpty ^int [this ^int i ^:mutable ^int j]
    (when (<= (set! j (unchecked-subtract-int j i)) 0)
      (set! j (unchecked-add-int j (alength items))))
    j)

  (method ^:private bulkRemoveModified ^boolean [this ^{:tag (Predicate (? super E))} filter
                                                 ^:final ^int beg]
    (let [es items
          capacity (alength items)
          end putIndex
          deathRow (ArrayBlockingQueue/nBits (.distanceNonEmpty this beg putIndex))]
      (aset deathRow 0 1)
      (let [^:mutable i (unchecked-add-int beg 1)
            ^:mutable ^int to (if (<= i end) end (alength es))
            ^:mutable k beg]
        (while true
          (while (< i to)
            (when (.test filter (ArrayBlockingQueue/itemAt es i))
              (ArrayBlockingQueue/setBit deathRow (unchecked-subtract-int i k)))
            (set! i (unchecked-inc-int i)))
          (when (== to end) (break))
          (set! i 0)
          (set! to end)
          (set! k (unchecked-subtract-int k capacity))))
      (let [^:mutable w beg]
        (let [^:mutable i (unchecked-add-int beg 1)
              ^:mutable ^int to (if (<= i end) end (alength es))
              ^:mutable k beg]
          (while true
            (while (< i to)
              (when (ArrayBlockingQueue/isClear deathRow (unchecked-subtract-int i k))
                (aset es w (aget es i))
                (set! w (unchecked-inc-int w)))
              (set! i (unchecked-inc-int i)))
            (when (== to end) (break))
            (set! i 0)
            (set! to end)
            (set! k (unchecked-subtract-int k capacity))
            (while (and (< i to) (< w capacity))
              (when (ArrayBlockingQueue/isClear deathRow (unchecked-subtract-int i k))
                (aset es w (aget es i))
                (set! w (unchecked-inc-int w)))
              (set! i (unchecked-inc-int i)))
            (when (>= i to) (when (== w capacity) (set! w 0)) (break))
            (set! w 0)))
        (set! count (unchecked-subtract-int count (.distanceNonEmpty this w end)))
        (ArrayBlockingQueue/circularClear es (set! putIndex w) end)
        true)))

  (method checkInvariants ^void [this]
    (when-not (.invariantsSatisfied this)
      (let [detail (String/format "takeIndex=%d putIndex=%d count=%d capacity=%d items=%s"
                                  (new Object/1
                                       [takeIndex
                                        putIndex
                                        count
                                        (alength items)
                                        (Arrays/toString items)]))]
        (.println System/err detail)
        (throw (AssertionError. detail)))))

  (method ^:private invariantsSatisfied ^boolean [this]
    (let [capacity (alength items)]
      (and (and (and (and (and (and (and (and (and
                                                (> capacity 0)
                                                (identical? (.getClass items) Object/1))
                                              (>=
                                                (bit-or-int (bit-or-int takeIndex putIndex) count)
                                                0))
                                         (< takeIndex capacity))
                                    (< putIndex capacity))
                               (<= count capacity))
                          (== (unchecked-remainder-int
                                (unchecked-subtract-int
                                  (unchecked-subtract-int putIndex takeIndex)
                                  count)
                                capacity)
                              0))
                     (or (== count 0) (some? (aget items takeIndex))))
                (or (== count capacity) (nil? (aget items putIndex))))
           (or (== count 0) (some? (aget items (ArrayBlockingQueue/dec putIndex capacity)))))))

  (method ^:private writeObject :throws [IOException] ^void [this ^ObjectOutputStream s]
    (let [lock (.-lock this)] (.lock lock) (try (.defaultWriteObject s) (finally (.unlock lock)))))

  (method ^:private readObject :throws [IOException ClassNotFoundException] ^void [this
                                                                                   ^ObjectInputStream s]
    (.defaultReadObject s)
    (when-not (.invariantsSatisfied this) (throw (InvalidObjectException. "invariants violated")))))

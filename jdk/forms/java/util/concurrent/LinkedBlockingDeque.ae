            (loop [^{:tag (Node E)} q p]
              (when (some? q)
                (when-not (and (some? (.-item q)) (== (set! len (unchecked-inc-int len)) 64))
                  (recur (.succ this q)))))
            (set! nodes (new Node/1 len)))
          (set! n 0)
          (while (and (some? p) (< n len))
            (aset nodes n p)
            (set! n (unchecked-inc-int n))
            (set! p (.succ this p)))
          (finally (.unlock lock)))
        (let [^:mutable deathRow 0]
          (loop [^int i 0]
            (when (< i n)
              (let [^:mutable ^E e nil]
                (if (and (some? (set! e (.-item (aget nodes i)))) (.test filter e))
                    (do
                      (set! deathRow (bit-or deathRow (bit-shift-left 1 i)))
                      (recur (unchecked-inc-int i)))
                    (recur (unchecked-inc-int i))))))
          (when-not (== deathRow 0)
            (.lock lock)
            (try
              (loop [^int i 0]
                (when (< i n)
                  (let [^:mutable ^{:tag (Node E)} q nil]
                    (when (and (not (== (bit-and deathRow (bit-shift-left 1 i)) 0))
                               (some? (.-item (set! q (aget nodes i)))))
                      (.unlink this q)
                      (set! removed true))
                    (aset nodes i nil)
                    (recur (unchecked-inc-int i)))))
              (finally (.unlock lock)))))
        (when (and (> n 0) (some? p)) (recur)))
      removed))

  (method ^:private writeObject :throws [IOException] ^void [this ^ObjectOutputStream s]
    (let [lock (.-lock this)]
      (.lock lock)
      (try
        (.defaultWriteObject s)
        (loop [^{:tag (Node E)} p first]
          (when (some? p) (.writeObject s (.-item p)) (recur (.-next p))))
        (.writeObject s nil)
        (finally (.unlock lock)))))

  (method ^:private readObject :throws [IOException ClassNotFoundException] ^void [this
                                                                                   ^ObjectInputStream s]
    (.defaultReadObject s)
    (set! count 0)
    (set! first nil)
    (set! last nil)
    (while true (let [^E item (.readObject s)] (when (nil? item) (break)) (.add this item))))

  (method checkInvariants ^void [this]
    (loop [^{:tag (Node E)} p first] (when (some? p) (recur (.-next p))))))

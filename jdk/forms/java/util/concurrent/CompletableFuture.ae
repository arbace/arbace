  (method ^:public minimalCompletionStage ^{:tag (CompletionStage T)} [this]
    (.uniAsMinimalStage this))

  (method ^:public completeAsync ^{:tag (CompletableFuture T)} [this
                                                                ^{:tag (Supplier (? extends T))} supplier
                                                                ^Executor executor]
    (.execute executor (AsyncSupply. this (cast Supplier (Objects/requireNonNull supplier))))
    this)

  (method ^:public completeAsync ^{:tag (CompletableFuture T)} [this
                                                                ^{:tag (Supplier (? extends T))} supplier]
    (.completeAsync this supplier (.defaultExecutor this)))

  (method ^:public orTimeout ^{:tag (CompletableFuture T)} [this ^long timeout ^TimeUnit unit]
    (.arrangeTimeout this (.toNanos unit timeout) (Timeout. this nil true))
    this)

  (method ^:public completeOnTimeout ^{:tag (CompletableFuture T)} [this ^T value ^long timeout
                                                                    ^TimeUnit unit]
    (.arrangeTimeout this (.toNanos unit timeout) (Timeout. this value false))
    this)

  (defclass ^:static ^:final Timeout
    :implements [Runnable]
    :type-params [U]

    (field ^:final ^{:tag (CompletableFuture U)} f)

    (field ^:final ^U value)

    (field ^:final ^boolean exceptional)

    (constructor [this ^{:tag (CompletableFuture U)} f ^U value ^boolean exceptional]
      (set! (.-f this) f)
      (set! (.-value this) value)
      (set! (.-exceptional this) exceptional))

    (method ^:public run ^void [this]
      (when (and (some? f) (not (.isDone f)))
        (if exceptional (.completeExceptionally f (TimeoutException.)) (.complete f value)))))

  (defclass ^:static ^:final Canceller
    :implements [(BiConsumer Object Throwable)]

    (field ^:final ^{:tag (Future ?)} f)

    (constructor [this ^{:tag (Future ?)} f] (set! (.-f this) f))

    (method ^:public accept ^void [this ignore ^Throwable ex]
      (when (some? f) (.cancel f false))))

  (method ^:private arrangeTimeout :type-params [U] ^void [this ^long nanoDelay
                                                           ^{:tag (Timeout U)} onTimeout]
    (let [e ASYNC_POOL]
      (when (nil? result)
        (let [^{:tag (DelayScheduler$ScheduledForkJoinTask Void)} t
                (DelayScheduler$ScheduledForkJoinTask. nanoDelay 0 true onTimeout nil e)]
          (.whenComplete this (Canceller. t))
          (.scheduleDelayedTask e t)))))

  (method ^:public ^:static delayedExecutor ^Executor [^long delay ^TimeUnit unit ^Executor executor]
    (DelayedExecutor. (.toNanos unit delay) (cast Executor (Objects/requireNonNull executor))))

  (method ^:public ^:static delayedExecutor ^Executor [^long delay ^TimeUnit unit]
    (DelayedExecutor. (.toNanos unit delay) ASYNC_POOL))

  (method ^:public ^:static completedStage :type-params [U] ^{:tag (CompletionStage U)} [^U value]
    (MinimalStage. (if (nil? value) ^Object NIL value)))

  (method ^:public ^:static failedFuture :type-params [U] ^{:tag (CompletableFuture U)} [^Throwable ex]
    (CompletableFuture. (AltResult. (cast Throwable (Objects/requireNonNull ex)))))

  (method ^:public ^:static failedStage :type-params [U] ^{:tag (CompletionStage U)} [^Throwable ex]
    (MinimalStage. (AltResult. (cast Throwable (Objects/requireNonNull ex)))))

  (defclass ^:static ^:final DelayedExecutor
    :implements [Executor]

    (field ^:final ^long nanoDelay)

    (field ^:final ^Executor executor)

    (constructor [this ^long nanoDelay ^Executor executor]
      (set! (.-nanoDelay this) nanoDelay)
      (set! (.-executor this) executor))

    (method ^:public execute ^void [this ^Runnable r]
      (let [e ASYNC_POOL]
        (.scheduleDelayedTask e
                              (DelayScheduler$ScheduledForkJoinTask.
                                nanoDelay
                                0
                                true
                                (TaskSubmitter. executor r)
                                nil
                                e)))))

  (defclass ^:static ^:final TaskSubmitter
    :implements [Runnable]

    (field ^:final ^Executor executor)

    (field ^:final ^Runnable action)

    (constructor [this ^Executor executor ^Runnable action]
      (set! (.-executor this) executor)
      (set! (.-action this) action))

    (method ^:public run ^void [this] (.execute executor action)))


    (.uniComposeExceptionallyStage this nil fn))

  (method ^:public exceptionallyComposeAsync ^{:tag (CompletableFuture T)} [this
                                                                            ^{:tag (Function Throwable (? extends (CompletionStage T)))} fn]
    (.uniComposeExceptionallyStage this (.defaultExecutor this) fn))

  (method ^:public exceptionallyComposeAsync ^{:tag (CompletableFuture T)} [this
                                                                            ^{:tag (Function Throwable (? extends (CompletionStage T)))} fn
                                                                            ^Executor executor]
    (.uniComposeExceptionallyStage this (cast Executor (Objects/requireNonNull executor)) fn))

  (method ^:public ^:static allOf ^{:tag (CompletableFuture Void)} [&
                                                                    ^{:tag (array (CompletableFuture ?))} cfs]
    (CompletableFuture/andTree cfs 0 (unchecked-subtract-int (alength cfs) 1)))

  (method ^:public ^:static anyOf ^{:tag (CompletableFuture Object)} [&
                                                                      ^:mutable ^{:tag (array (CompletableFuture ?))} cfs]
    (let [^:mutable ^int n 0
          ^:mutable ^Object r nil]
      (if (<= (set! n (alength cfs)) 1)
          (if (== n 0) (CompletableFuture.) (CompletableFuture/uniCopyStage (aget cfs 0)))
          (do
            (for-each [^{:tag (CompletableFuture ?)} cf cfs]
              (when (some? (set! r (.-result cf)))
                (return (CompletableFuture. (CompletableFuture/encodeRelay r)))))
            (set! cfs (.clone cfs))
            (let [^{:tag (CompletableFuture Object)} d (CompletableFuture.)]
              (for-each [^{:tag (CompletableFuture ?)} cf cfs] (.unipush cf (AnyOf. d cf cfs)))
              (when (some? (.-result d))
                (let [^:mutable ^int i 0
                      len (alength cfs)]
                  (while (< i len)
                    (when (some? (.-result (aget cfs i)))
                      (set! i (unchecked-inc-int i))
                      (while (< i len)
                        (when (nil? (.-result (aget cfs i))) (.cleanStack (aget cfs i)))
                        (set! i (unchecked-inc-int i))))
                    (set! i (unchecked-inc-int i)))))
              d)))))

  (method ^:public cancel ^boolean [this ^boolean mayInterruptIfRunning]
    (let [cancelled (and (nil? result)
                         (.internalComplete this (AltResult. (CancellationException.))))]
      (.postComplete this)
      (or cancelled (.isCancelled this))))

  (method ^:public isCancelled ^boolean [this]
    (let [^:mutable ^Object r nil]
      (and (instance? AltResult (set! r result))
           (instance? CancellationException (.-ex (cast AltResult r))))))

  (method ^:public isCompletedExceptionally ^boolean [this]
    (let [^:mutable ^Object r nil]
      (and (instance? AltResult (set! r result)) (not (identical? r NIL)))))

  (method ^:public state ^Future$State [this]
    (let [r result]
      (if (nil? r)
          Future$State/RUNNING
          (do
            (when-not (identical? r NIL)
              (when-instance [^AltResult alt r]
                (if (instance? CancellationException (.-ex alt))
                    (return Future$State/CANCELLED)
                    (return Future$State/FAILED))))
            Future$State/SUCCESS))))

  (method ^:public obtrudeValue ^void [this ^T value]
    (set! result (if (nil? value) ^Object NIL value))
    (.postComplete this))

  (method ^:public obtrudeException ^void [this ^Throwable ex]
    (set! result (AltResult. (cast Throwable (Objects/requireNonNull ex))))
    (.postComplete this))

  (method ^:public getNumberOfDependents ^int [this]
    (let [^:mutable ^int count 0]
      (loop [p stack] (when (some? p) (set! count (unchecked-inc-int count)) (recur (.-next p))))
      count))

  (method ^:public toString ^String [this]
    (let [r result
          ^:mutable ^int count 0]
      (loop [p stack] (when (some? p) (set! count (unchecked-inc-int count)) (recur (.-next p))))
      (java-str (.toString super)
                (cond
                  (nil? r)
                    (if (== count 0)
                        "[Not completed]"
                        (java-str "[Not completed, " count " dependents]"))
                  (and (instance? AltResult r) (some? (.-ex (cast AltResult r))))
                    (java-str "[Completed exceptionally: "
                              (.getName (.getClass (.-ex (cast AltResult r))))
                              "]")
                  :else "[Completed normally]"))))


  (method ^:final helpTransfer ^{:tag (array (Node K V))} [this ^{:tag (array (Node K V))} tab
                                                           ^{:tag (Node K V)} f]
    (let [^:mutable ^{:tag (array (Node K V))} nextTab nil
          ^:mutable ^int sc 0]
      (if (and (and (some? tab) (instance? ForwardingNode f))
               (some? (set! nextTab (.-nextTable (cast ForwardingNode f)))))
          (let [rs (bit-shift-left-int (ConcurrentHashMap/resizeStamp (alength tab))
                                       RESIZE_STAMP_SHIFT)]

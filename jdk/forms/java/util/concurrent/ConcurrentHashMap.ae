          ^:mutable ^int stride 0]
      (when (< (set! stride
                     (if (> NCPU 1)
                         (unchecked-divide-int (unsigned-bit-shift-right-int n 3) NCPU)
                         n))
               MIN_TRANSFER_STRIDE)
        (set! stride MIN_TRANSFER_STRIDE))
      (when (nil? nextTab)
        (try
          (let [^{:tag (array (Node K V))} nt (new Node/1 (bit-shift-left-int n 1))]
            (set! nextTab nt))
          (catch Throwable ex (set! sizeCtl Integer/MAX_VALUE) (return)))
        (set! nextTable nextTab)
        (set! transferIndex n))
      (let [nextn (alength nextTab)
            ^{:tag (ForwardingNode K V)} fwd (ForwardingNode. nextTab)
            ^:mutable advance true
            ^:mutable finishing false
            ^:mutable ^int i 0
            ^:mutable ^int bound 0]
        (while true
          (let [^:mutable ^{:tag (Node K V)} f nil
                ^:mutable ^int fh 0]

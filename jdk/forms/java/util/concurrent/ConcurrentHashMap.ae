          ^:mutable ^V val nil
          ^:mutable ^int binCount 0]
      (let [^:mutable ^{:tag (array (Node K V))} tab table]
        (while true
          (let [^:mutable ^{:tag (Node K V)} f nil
                ^:mutable ^int n 0
                ^:mutable ^int i 0
                ^:mutable ^int fh 0
                ^:mutable ^K fk nil
                ^:mutable ^V fv nil]
            (cond
              (or (nil? tab) (== (set! n (alength tab)) 0)) (set! tab (.initTable this))

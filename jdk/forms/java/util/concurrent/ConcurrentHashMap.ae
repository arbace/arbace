  (method ^:private ^:final treeifyBin ^void [this ^{:tag (array (Node K V))} tab ^int index]
    (let [^:mutable ^{:tag (Node K V)} b nil
          ^:mutable ^int n 0]
      (when (some? tab)
        (cond
          (< (set! n (alength tab)) MIN_TREEIFY_CAPACITY)
            (.tryPresize this (bit-shift-left-int n 1))
          (and (some? (set! b (ConcurrentHashMap/tabAt tab index))) (>= (.-hash b) 0))
            (locking b
              (when (identical? (ConcurrentHashMap/tabAt tab index) b)
                (let [^:mutable ^{:tag (TreeNode K V)} hd nil
                      ^:mutable ^{:tag (TreeNode K V)} tl nil]
                  (loop [^{:tag (Node K V)} e b]
                    (when (some? e)
                      (let [^{:tag (TreeNode K V)} p (TreeNode.
                                                       (.-hash e)
                                                       (.-key e)
                                                       (.-val e)
                                                       nil
                                                       nil)]
                        (if (nil? (set! (.-prev p) tl)) (set! hd p) (set! (.-next tl) p))
                        (set! tl p)
                        (recur (.-next e)))))
                  (ConcurrentHashMap/setTabAt tab index (TreeBin. hd)))))))))

  (method ^:static untreeify :type-params [K V] ^{:tag (Node K V)} [^{:tag (Node K V)} b]
    (let [^:mutable ^{:tag (Node K V)} hd nil
          ^:mutable ^{:tag (Node K V)} tl nil]
      (loop [^{:tag (Node K V)} q b]
        (when (some? q)
          (let [^{:tag (Node K V)} p (Node. (.-hash q) (.-key q) (.-val q))]
            (if (nil? tl) (set! hd p) (set! (.-next tl) p))
            (set! tl p)
            (recur (.-next q)))))
      hd))

  (defclass ^:static ^:final TreeNode
    :extends (Node K V)
    :type-params [K V]

    (field ^{:tag (TreeNode K V)} parent)

    (field ^{:tag (TreeNode K V)} left)

    (field ^{:tag (TreeNode K V)} right)

    (field ^{:tag (TreeNode K V)} prev)

    (field ^boolean red)

    (constructor [this ^int hash ^K key ^V val ^{:tag (Node K V)} next ^{:tag (TreeNode K V)} parent]
      (super. hash key val next)
      (set! (.-parent this) parent))

    (method find ^{:tag (Node K V)} [this ^int h k]
      (.findTreeNode this h k nil))

    (method ^:final findTreeNode ^{:tag (TreeNode K V)} [this ^int h k
                                                         ^:mutable ^{:tag (Class ?)} kc]
      (when (some? k)
        (let [^:mutable ^{:tag (TreeNode K V)} p this]
          (loop []
            (let [^:mutable ^int ph 0
                  ^:mutable ^int dir 0
                  ^:mutable ^K pk nil
                  ^:mutable ^{:tag (TreeNode K V)} q nil
                  ^{:tag (TreeNode K V)} pl (.-left p)
                  ^{:tag (TreeNode K V)} pr (.-right p)]
              (cond
                (> (set! ph (.-hash p)) h) (set! p pl)
                (< ph h) (set! p pr)
                (or (identical? (set! pk (.-key p)) k) (and (some? pk) (.equals k pk))) (return p)
                (nil? pl) (set! p pr)
                (nil? pr) (set! p pl)
                (and (or (some? kc) (some? (set! kc (ConcurrentHashMap/comparableClassFor k))))
                     (not (== (set! dir (ConcurrentHashMap/compareComparables kc k pk)) 0)))
                  (set! p (if (< dir 0) pl pr))
                (some? (set! q (.findTreeNode pr h k kc))) (return q)
                :else (set! p pl)))
            (when (some? p) (recur)))))
      nil))

  (defclass ^:static ^:final TreeBin
    :extends (Node K V)
    :type-params [K V]

    (field ^{:tag (TreeNode K V)} root)

    (field ^:volatile ^{:tag (TreeNode K V)} first)

    (field ^:volatile ^Thread waiter)

    (field ^:volatile ^int lockState)

    (field ^:static ^:final ^int WRITER 1)

    (field ^:static ^:final ^int WAITER 2)

    (field ^:static ^:final ^int READER 4)

    (method ^:static tieBreakOrder ^int [a b]
      (let [^:mutable ^int d 0]
        (when (or (or (nil? a) (nil? b))
                  (== (set! d (.compareTo (.getName (.getClass a)) (.getName (.getClass b)))) 0))
          (set! d (if (<= (System/identityHashCode a) (System/identityHashCode b)) -1 1)))
        d))

    (constructor [this ^{:tag (TreeNode K V)} b]
      (super. TREEBIN nil nil)
      (set! (.-first this) b)
      (let [^:mutable ^{:tag (TreeNode K V)} r nil]
        (let [^:mutable ^{:tag (TreeNode K V)} x b
              ^:mutable ^{:tag (TreeNode K V)} next nil]
          (while (some? x)
            (set! next (cast TreeNode (.-next x)))
            (set! (.-left x) (set! (.-right x) nil))
            (if (nil? r)
                (do (set! (.-parent x) nil) (set! (.-red x) false) (set! r x))
                (let [^K k (.-key x)
                      h (.-hash x)
                      ^:mutable ^{:tag (Class ?)} kc nil
                      ^:mutable ^{:tag (TreeNode K V)} p r]
                  (while true
                    (let [^:mutable ^int dir 0
                          ^:mutable ^int ph 0
                          ^K pk (.-key p)]
                      (cond
                        (> (set! ph (.-hash p)) h) (set! dir -1)
                        (< ph h) (set! dir 1)
                        (or (and (nil? kc)
                                 (nil? (set! kc (ConcurrentHashMap/comparableClassFor k))))
                            (== (set! dir (ConcurrentHashMap/compareComparables kc k pk)) 0))
                          (set! dir (TreeBin/tieBreakOrder k pk)))
                      (let [^{:tag (TreeNode K V)} xp p]
                        (when (nil? (set! p (if (<= dir 0) (.-left p) (.-right p))))
                          (set! (.-parent x) xp)
                          (if (<= dir 0) (set! (.-left xp) x) (set! (.-right xp) x))
                          (set! r (TreeBin/balanceInsertion r x))
                          (break)))))))
            (set! x next)))
        (set! (.-root this) r)
        (java-assert (TreeBin/checkInvariants root))))

    (method ^:private ^:final lockRoot ^void [this]
      (when-not (.compareAndSetInt U this LOCKSTATE 0 WRITER) (.contendedLock this)))

    (method ^:private ^:final unlockRoot ^void [this] (set! lockState 0))

    (method ^:private ^:final contendedLock ^void [this]
      (let [current (Thread/currentThread)
            ^:mutable ^Thread w nil
            ^:mutable ^int s 0]
        (while true
          (cond
            (== (bit-and-int (set! s lockState) (bit-not-int WAITER)) 0)
              (when (.compareAndSetInt U this LOCKSTATE s WRITER)
                (when (identical? waiter current)
                  (.compareAndSetReference U this WAITERTHREAD current nil))
                (return))
            (== (bit-and-int s WAITER) 0)
              (.compareAndSetInt U this LOCKSTATE s (bit-or-int s WAITER))
            (nil? (set! w waiter)) (.compareAndSetReference U this WAITERTHREAD nil current)
            (identical? w current) (LockSupport/park this)))))

    (method ^:final find ^{:tag (Node K V)} [this ^int h k]
      (when (some? k)
        (let [^:mutable ^{:tag (Node K V)} e first]
          (while (some? e)
            (let [^:mutable ^int s 0
                  ^:mutable ^K ek nil]
              (cond
                (not (== (bit-and-int (set! s lockState) (bit-or-int WAITER WRITER)) 0))
                  (do
                    (when (and (== (.-hash e) h)
                               (or (identical? (set! ek (.-key e)) k)
                                   (and (some? ek) (.equals k ek))))
                      (return e))
                    (set! e (.-next e)))
                (.compareAndSetInt U this LOCKSTATE s (unchecked-add-int s READER))

                                  ^:mutable ^K qk nil]
                              (set! q first)
                              (while (some? q)
                                (when (and (== (.-hash q) h)
                                           (or (identical? (set! qk (.-key q)) k)
                                               (and (some? qk) (.equals k qk))))
                                  (set! insertAtFront false)
                                  (break))

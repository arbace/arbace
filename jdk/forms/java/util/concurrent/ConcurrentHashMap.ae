              ^:mutable ^int m 0
              ^:mutable uncontended true]
          (when (or (or (or (nil? cs) (< (set! m (unchecked-subtract-int (alength cs) 1)) 0))
                        (nil? (set! c (aget cs (bit-and-int (ThreadLocalRandom/getProbe) m)))))

  (method ^:private ^:final initTable ^{:tag (array (Node K V))} [this]
    (let [^:mutable ^{:tag (array (Node K V))} tab nil
          ^:mutable ^int sc 0]
      (while (or (nil? (set! tab table)) (== (alength tab) 0))
        (if (< (set! sc sizeCtl) 0)
            (Thread/yield)
            (when (.compareAndSetInt U this SIZECTL sc -1)
              (try
                (when (or (nil? (set! tab table)) (== (alength tab) 0))
                  (let [^int n (if (> sc 0) sc DEFAULT_CAPACITY)
                        ^{:tag (array (Node K V))} nt (new Node/1 n)]
                    (set! table (set! tab nt))
                    (set! sc (unchecked-subtract-int n (unsigned-bit-shift-right-int n 2)))))
                (finally (set! sizeCtl sc)))
              (break))))
      tab))

  (method ^:private ^:final addCount ^void [this ^long x ^int check]
    (let [^:mutable ^CounterCell/1 cs nil
          ^:mutable ^long b 0
          ^:mutable ^long s 0]
      (when (or (some? (set! cs counterCells))
                (not (.compareAndSetLong U
                                         this

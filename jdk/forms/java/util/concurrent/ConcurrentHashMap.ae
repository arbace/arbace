                                  (while (some? q)
                                    (let [^{:tag (TreeNode K V)} t (TreeNode.
                                                                     (.-hash q)
                                                                     (.-key q)
                                                                     (.-val q)
                                                                     nil
                                                                     nil)]
                                      (if (nil? (set! (.-prev t) tl))
                                          (set! hd t)
                                          (set! (.-next tl) t))
                                      (set! tl t))

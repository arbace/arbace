                      (set! p (when (some? (set! r root)) (.findTreeNode r h k nil)))
                      (finally
                        (let [^:mutable ^Thread w nil]
                          (when (and (== (.getAndAddInt
                                           U
                                           this
                                           LOCKSTATE
                                           (unchecked-negate-int READER))
                                         (bit-or-int READER WAITER))
                                     (some? (set! w waiter)))
                            (LockSupport/unpark w)))))
                    (return p)))))))
      nil)

    (method ^:final putTreeVal ^{:tag (TreeNode K V)} [this ^int h ^K k ^V v]
      (let [^:mutable ^{:tag (Class ?)} kc nil
            ^:mutable searched false]
        (let [^:mutable ^{:tag (TreeNode K V)} p root]
          (while true
            (let [^:mutable ^int dir 0
                  ^:mutable ^int ph 0
                  ^:mutable ^K pk nil]
              (cond
                (nil? p) (do (set! first (set! root (TreeNode. h k v nil nil))) (break))
                (> (set! ph (.-hash p)) h) (set! dir -1)
                (< ph h) (set! dir 1)
                (or (identical? (set! pk (.-key p)) k) (and (some? pk) (.equals k pk))) (return p)
                :else
                  (when (or (and (nil? kc)
                                 (nil? (set! kc (ConcurrentHashMap/comparableClassFor k))))
                            (== (set! dir (ConcurrentHashMap/compareComparables kc k pk)) 0))
                    (when-not searched
                      (let [^:mutable ^{:tag (TreeNode K V)} q nil
                            ^:mutable ^{:tag (TreeNode K V)} ch nil]
                        (set! searched true)
                        (when (or (and (some? (set! ch (.-left p)))
                                       (some? (set! q (.findTreeNode ch h k kc))))
                                  (and (some? (set! ch (.-right p)))
                                       (some? (set! q (.findTreeNode ch h k kc)))))
                          (return q))))
                    (set! dir (TreeBin/tieBreakOrder k pk))))
              (let [^{:tag (TreeNode K V)} xp p]
                (when (nil? (set! p (if (<= dir 0) (.-left p) (.-right p))))
                  (let [^:mutable ^{:tag (TreeNode K V)} x nil
                        ^{:tag (TreeNode K V)} f first]
                    (set! first (set! x (TreeNode. h k v f xp)))
                    (when (some? f) (set! (.-prev f) x))
                    (if (<= dir 0) (set! (.-left xp) x) (set! (.-right xp) x))
                    (if (not (.-red xp))
                        (set! (.-red x) true)

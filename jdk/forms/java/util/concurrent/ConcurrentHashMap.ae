                    (set! insertAtFront true)
                    (let [^K k (.-key p)]
                      (if (< (.-hash first) 0)
                          (let [^{:tag (TreeBin K V)} t (cast TreeBin first)]
                            (when (nil? (.putTreeVal t h k (.-val p)))

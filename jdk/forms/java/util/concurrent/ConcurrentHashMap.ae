  (defclass ^:static ^:final ForwardingNode
    :extends (Node K V)
    :type-params [K V]

    (field ^:final ^{:tag (array (Node K V))} nextTable)

    (constructor [this ^{:tag (array (Node K V))} tab]
      (super. MOVED nil nil)
      (set! (.-nextTable this) tab))

    (method find ^{:tag (Node K V)} [this ^int h k]
      (let [^:mutable ^{:tag (array (Node K V))} tab nextTable]
        (label :outer
          (while true
            (let [^:mutable ^{:tag (Node K V)} e nil
                  ^:mutable ^int n 0]
              (when (or (or (or (nil? k) (nil? tab)) (== (set! n (alength tab)) 0))
                        (nil? (set! e
                                    (ConcurrentHashMap/tabAt
                                      tab
                                      (bit-and-int (unchecked-subtract-int n 1) h)))))
                (return nil))
              (while true
                (let [^:mutable ^int eh 0
                      ^:mutable ^K ek nil]
                  (when (and
                          (== (set! eh (.-hash e)) h)
                          (or (identical? (set! ek (.-key e)) k) (and (some? ek) (.equals k ek))))
                    (return e))
                  (when (< eh 0)
                    (if (instance? ForwardingNode e)
                        (do (set! tab (.-nextTable (cast ForwardingNode e))) (continue :outer))
                        (return (.find e h k))))
                  (when (nil? (set! e (.-next e))) (return nil))))))))))


        nil))

    (method ^:final removeTreeNode ^boolean [this ^{:tag (TreeNode K V)} p]
      (let [^{:tag (TreeNode K V)} next (cast TreeNode (.-next p))
            ^{:tag (TreeNode K V)} pred (.-prev p)
            ^:mutable ^{:tag (TreeNode K V)} r nil
            ^:mutable ^{:tag (TreeNode K V)} rl nil]
        (if (nil? pred) (set! first next) (set! (.-next pred) next))
        (when (some? next) (set! (.-prev next) pred))
        (cond
          (nil? first) (do (set! root nil) true)
          (or (or (or (nil? (set! r root)) (nil? (.-right r))) (nil? (set! rl (.-left r))))
              (nil? (.-left rl)))
            true
          :else
            (do
              (.lockRoot this)
              (try
                (let [^:mutable ^{:tag (TreeNode K V)} replacement nil
                      ^{:tag (TreeNode K V)} pl (.-left p)
                      ^{:tag (TreeNode K V)} pr (.-right p)]
                  (cond
                    (and (some? pl) (some? pr))
                      (let [^:mutable ^{:tag (TreeNode K V)} s pr
                            ^:mutable ^{:tag (TreeNode K V)} sl nil]
                        (while (some? (set! sl (.-left s))) (set! s sl))
                        (let [c (.-red s)]
                          (set! (.-red s) (.-red p))
                          (set! (.-red p) c)
                          (let [^{:tag (TreeNode K V)} sr (.-right s)
                                ^{:tag (TreeNode K V)} pp (.-parent p)]
                            (if (identical? s pr)
                                (do (set! (.-parent p) s) (set! (.-right s) p))
                                (let [^{:tag (TreeNode K V)} sp (.-parent s)]
                                  (when (some? (set! (.-parent p) sp))
                                    (if (identical? s (.-left sp))
                                        (set! (.-left sp) p)
                                        (set! (.-right sp) p)))
                                  (when (some? (set! (.-right s) pr)) (set! (.-parent pr) s))))
                            (set! (.-left p) nil)
                            (when (some? (set! (.-right p) sr)) (set! (.-parent sr) p))
                            (when (some? (set! (.-left s) pl)) (set! (.-parent pl) s))
                            (cond
                              (nil? (set! (.-parent s) pp)) (set! r s)
                              (identical? p (.-left pp)) (set! (.-left pp) s)
                              :else (set! (.-right pp) s))
                            (if (some? sr) (set! replacement sr) (set! replacement p)))))
                    (some? pl) (set! replacement pl)
                    (some? pr) (set! replacement pr)
                    :else (set! replacement p))
                  (when-not (identical? replacement p)
                    (let [^{:tag (TreeNode K V)} pp (set! (.-parent replacement) (.-parent p))]
                      (cond
                        (nil? pp) (set! r replacement)
                        (identical? p (.-left pp)) (set! (.-left pp) replacement)
                        :else (set! (.-right pp) replacement))
                      (set! (.-left p) (set! (.-right p) (set! (.-parent p) nil)))))
                  (set! root (if (.-red p) r (TreeBin/balanceDeletion r replacement)))
                  (when (identical? p replacement)
                    (let [^:mutable ^{:tag (TreeNode K V)} pp nil]
                      (when (some? (set! pp (.-parent p)))
                        (cond
                          (identical? p (.-left pp)) (set! (.-left pp) nil)
                          (identical? p (.-right pp)) (set! (.-right pp) nil))
                        (set! (.-parent p) nil)))))
                (finally (.unlockRoot this)))
              (java-assert (TreeBin/checkInvariants root))
              false))))

    (method ^:static rotateLeft :type-params [K V] ^{:tag (TreeNode K V)} [^:mutable ^{:tag (TreeNode K V)} root
                                                                           ^{:tag (TreeNode K V)} p]
      (let [^:mutable ^{:tag (TreeNode K V)} r nil
            ^:mutable ^{:tag (TreeNode K V)} pp nil
            ^:mutable ^{:tag (TreeNode K V)} rl nil]
        (when (and (some? p) (some? (set! r (.-right p))))
          (when (some? (set! rl (set! (.-right p) (.-left r)))) (set! (.-parent rl) p))
          (cond
            (nil? (set! pp (set! (.-parent r) (.-parent p)))) (set! (.-red (set! root r)) false)
            (identical? (.-left pp) p) (set! (.-left pp) r)
            :else (set! (.-right pp) r))
          (set! (.-left r) p)
          (set! (.-parent p) r))
        root))

    (method ^:static rotateRight :type-params [K V] ^{:tag (TreeNode K V)} [^:mutable ^{:tag (TreeNode K V)} root
                                                                            ^{:tag (TreeNode K V)} p]
      (let [^:mutable ^{:tag (TreeNode K V)} l nil
            ^:mutable ^{:tag (TreeNode K V)} pp nil
            ^:mutable ^{:tag (TreeNode K V)} lr nil]
        (when (and (some? p) (some? (set! l (.-left p))))
          (when (some? (set! lr (set! (.-left p) (.-right l)))) (set! (.-parent lr) p))
          (cond
            (nil? (set! pp (set! (.-parent l) (.-parent p)))) (set! (.-red (set! root l)) false)
            (identical? (.-right pp) p) (set! (.-right pp) l)
            :else (set! (.-left pp) l))
          (set! (.-right l) p)
          (set! (.-parent p) l))
        root))

    (method ^:static balanceInsertion :type-params [K V] ^{:tag (TreeNode K V)} [^:mutable ^{:tag (TreeNode K V)} root
                                                                                 ^:mutable ^{:tag (TreeNode K V)} x]
      (set! (.-red x) true)
      (let [^:mutable ^{:tag (TreeNode K V)} xp nil
            ^:mutable ^{:tag (TreeNode K V)} xpp nil
            ^:mutable ^{:tag (TreeNode K V)} xppl nil
            ^:mutable ^{:tag (TreeNode K V)} xppr nil]
        (while true
          (cond
            (nil? (set! xp (.-parent x))) (do (set! (.-red x) false) (return x))
            (or (not (.-red xp)) (nil? (set! xpp (.-parent xp)))) (return root))
          (cond
            (identical? xp (set! xppl (.-left xpp)))
              (if (and (some? (set! xppr (.-right xpp))) (.-red xppr))
                  (do
                    (set! (.-red xppr) false)
                    (set! (.-red xp) false)
                    (set! (.-red xpp) true)
                    (set! x xpp))
                  (do
                    (when (identical? x (.-right xp))
                      (set! root (TreeBin/rotateLeft root (set! x xp)))
                      (set! xpp (when (some? (set! xp (.-parent x))) (.-parent xp))))
                    (when (some? xp)
                      (set! (.-red xp) false)
                      (when (some? xpp)
                        (set! (.-red xpp) true)
                        (set! root (TreeBin/rotateRight root xpp))))))
            (and (some? xppl) (.-red xppl))
              (do
                (set! (.-red xppl) false)
                (set! (.-red xp) false)
                (set! (.-red xpp) true)
                (set! x xpp))
            :else
              (do
                (when (identical? x (.-left xp))
                  (set! root (TreeBin/rotateRight root (set! x xp)))
                  (set! xpp (when (some? (set! xp (.-parent x))) (.-parent xp))))
                (when (some? xp)
                  (set! (.-red xp) false)
                  (when (some? xpp)
                    (set! (.-red xpp) true)
                    (set! root (TreeBin/rotateLeft root xpp)))))))))

    (method ^:static balanceDeletion :type-params [K V] ^{:tag (TreeNode K V)} [^:mutable ^{:tag (TreeNode K V)} root
                                                                                ^:mutable ^{:tag (TreeNode K V)} x]
      (let [^:mutable ^{:tag (TreeNode K V)} xp nil
            ^:mutable ^{:tag (TreeNode K V)} xpl nil
            ^:mutable ^{:tag (TreeNode K V)} xpr nil]
        (while true
          (cond
            (or (nil? x) (identical? x root)) (return root)
            (nil? (set! xp (.-parent x))) (do (set! (.-red x) false) (return x))
            (.-red x) (do (set! (.-red x) false) (return root))
            (identical? (set! xpl (.-left xp)) x)
              (do
                (when (and (some? (set! xpr (.-right xp))) (.-red xpr))
                  (set! (.-red xpr) false)
                  (set! (.-red xp) true)
                  (set! root (TreeBin/rotateLeft root xp))
                  (set! xpr (when (some? (set! xp (.-parent x))) (.-right xp))))
                (if (nil? xpr)
                    (set! x xp)
                    (let [^{:tag (TreeNode K V)} sl (.-left xpr)
                          ^:mutable ^{:tag (TreeNode K V)} sr (.-right xpr)]
                      (if (and (or (nil? sr) (not (.-red sr))) (or (nil? sl) (not (.-red sl))))
                          (do (set! (.-red xpr) true) (set! x xp))
                          (do
                            (when (or (nil? sr) (not (.-red sr)))
                              (when (some? sl) (set! (.-red sl) false))
                              (set! (.-red xpr) true)
                              (set! root (TreeBin/rotateRight root xpr))
                              (set! xpr (when (some? (set! xp (.-parent x))) (.-right xp))))
                            (when (some? xpr)
                              (set! (.-red xpr) (if (nil? xp) false (.-red xp)))
                              (when (some? (set! sr (.-right xpr))) (set! (.-red sr) false)))
                            (when (some? xp)
                              (set! (.-red xp) false)
                              (set! root (TreeBin/rotateLeft root xp)))
                            (set! x root))))))
            :else
              (do
                (when (and (some? xpl) (.-red xpl))
                  (set! (.-red xpl) false)
                  (set! (.-red xp) true)
                  (set! root (TreeBin/rotateRight root xp))
                  (set! xpl (when (some? (set! xp (.-parent x))) (.-left xp))))
                (if (nil? xpl)
                    (set! x xp)
                    (let [^:mutable ^{:tag (TreeNode K V)} sl (.-left xpl)
                          ^{:tag (TreeNode K V)} sr (.-right xpl)]
                      (if (and (or (nil? sl) (not (.-red sl))) (or (nil? sr) (not (.-red sr))))
                          (do (set! (.-red xpl) true) (set! x xp))
                          (do
                            (when (or (nil? sl) (not (.-red sl)))
                              (when (some? sr) (set! (.-red sr) false))
                              (set! (.-red xpl) true)
                              (set! root (TreeBin/rotateLeft root xpl))
                              (set! xpl (when (some? (set! xp (.-parent x))) (.-left xp))))
                            (when (some? xpl)
                              (set! (.-red xpl) (if (nil? xp) false (.-red xp)))
                              (when (some? (set! sl (.-left xpl))) (set! (.-red sl) false)))
                            (when (some? xp)
                              (set! (.-red xp) false)
                              (set! root (TreeBin/rotateRight root xp)))
                            (set! x root))))))))))

    (method ^:static checkInvariants :type-params [K V] ^boolean [^{:tag (TreeNode K V)} t]
      (let [^{:tag (TreeNode K V)} tp (.-parent t)
            ^{:tag (TreeNode K V)} tl (.-left t)
            ^{:tag (TreeNode K V)} tr (.-right t)
            ^{:tag (TreeNode K V)} tb (.-prev t)
            ^{:tag (TreeNode K V)} tn (cast TreeNode (.-next t))]
        (cond
          (and (some? tb) (not (identical? (.-next tb) t))) false
          (and (some? tn) (not (identical? (.-prev tn) t))) false
          (and (and (some? tp) (not (identical? t (.-left tp)))) (not (identical? t (.-right tp))))
            false
          (and (some? tl) (or (not (identical? (.-parent tl) t)) (> (.-hash tl) (.-hash t)))) false
          (and (some? tr) (or (not (identical? (.-parent tr) t)) (< (.-hash tr) (.-hash t)))) false
          (and (and (and (and (.-red t) (some? tl)) (.-red tl)) (some? tr)) (.-red tr)) false
          (and (some? tl) (not (TreeBin/checkInvariants tl))) false
          (and (some? tr) (not (TreeBin/checkInvariants tr))) false
          :else true)))

    (field ^:private ^:static ^:final ^long LOCKSTATE (.objectFieldOffset U TreeBin "lockState"))

    (field ^:private ^:static ^:final ^long WAITERTHREAD (.objectFieldOffset U TreeBin "waiter")))

  (defclass ^:static ^:final TableStack
    :type-params [K V]

    (field ^int length)

    (field ^int index)

    (field ^{:tag (array (Node K V))} tab)

    (field ^{:tag (TableStack K V)} next))

  (defclass ^:static Traverser
    :type-params [K V]

    (field ^{:tag (array (Node K V))} tab)

    (field ^{:tag (Node K V)} next)

    (field ^{:tag (TableStack K V)} stack)

    (field ^{:tag (TableStack K V)} spare)

    (field ^int index)

    (field ^int baseIndex)

    (field ^int baseLimit)

    (field ^:final ^int baseSize)

    (constructor [this ^{:tag (array (Node K V))} tab ^int size ^int index ^int limit]
      (set! (.-tab this) tab)
      (set! (.-baseSize this) size)
      (set! (.-baseIndex this) (set! (.-index this) index))
      (set! (.-baseLimit this) limit)
      (set! (.-next this) nil))

    (method ^:final advance ^{:tag (Node K V)} [this]
      (let [^:mutable ^{:tag (Node K V)} e nil]
        (when (some? (set! e next)) (set! e (.-next e)))
        (while true
          (let [^:mutable ^{:tag (array (Node K V))} t nil
                ^:mutable ^int i 0
                ^:mutable ^int n 0]
            (when (some? e) (return (set! next e)))
            (when (or (or (or (>= baseIndex baseLimit) (nil? (set! t tab)))
                          (<= (set! n (alength t)) (set! i index)))
                      (< i 0))
              (return (set! next nil)))
            (when (and (some? (set! e (ConcurrentHashMap/tabAt t i))) (< (.-hash e) 0))
              (cond
                (instance? ForwardingNode e)
                  (do
                    (set! tab (.-nextTable (cast ForwardingNode e)))
                    (set! e nil)
                    (.pushState this t i n)
                    (continue))
                (instance? TreeBin e) (set! e (.-first (cast TreeBin e)))
                :else (set! e nil)))
            (cond
              (some? stack) (.recoverState this n)
              (>= (set! index (unchecked-add-int i baseSize)) n)
                (set! index (set! baseIndex (unchecked-inc-int baseIndex))))))))

    (method ^:private pushState ^void [this ^{:tag (array (Node K V))} t ^int i ^int n]
      (let [^:mutable ^{:tag (TableStack K V)} s spare]
        (if (some? s) (set! spare (.-next s)) (set! s (TableStack.)))
        (set! (.-tab s) t)
        (set! (.-length s) n)
        (set! (.-index s) i)
        (set! (.-next s) stack)
        (set! stack s)))

    (method ^:private recoverState ^void [this ^:mutable ^int n]
      (let [^:mutable ^{:tag (TableStack K V)} s nil
            ^:mutable ^int len 0]
        (while (and (some? (set! s stack))
                    (>= (set! index (unchecked-add-int index (set! len (.-length s)))) n))
          (set! n len)
          (set! index (.-index s))
          (set! tab (.-tab s))
          (set! (.-tab s) nil)
          (let [^{:tag (TableStack K V)} next (.-next s)]
            (set! (.-next s) spare)
            (set! stack next)
            (set! spare s)))
        (when (and (nil? s) (>= (set! index (unchecked-add-int index baseSize)) n))
          (set! index (set! baseIndex (unchecked-inc-int baseIndex)))))))

  (defclass ^:static BaseIterator
    :extends (Traverser K V)

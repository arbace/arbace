                                           this
                                           SIZECTL
                                           (set! sc sizeCtl)
                                           (unchecked-subtract-int sc 1))
                    (when-not (== (unchecked-subtract-int sc 2)
                                  (bit-shift-left-int
                                    (ConcurrentHashMap/resizeStamp n)

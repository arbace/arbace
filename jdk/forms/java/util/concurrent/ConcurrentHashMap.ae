  (defclass ^:static ^:final ^{Contended true} CounterCell
    (field ^:volatile ^long value)

    (constructor [this ^long x] (set! value x)))

  (method ^:final sumCount ^long [this]
    (let [cs counterCells
          ^:mutable sum baseCount]
      (when (some? cs)
        (for-each [^CounterCell c cs] (when (some? c) (set! sum (unchecked-add sum (.-value c))))))
      sum))

  (method ^:private ^:final fullAddCount ^void [this ^long x ^:mutable ^boolean wasUncontended]
    (let [^:mutable ^int h 0]
      (when (== (set! h (ThreadLocalRandom/getProbe)) 0)
        (ThreadLocalRandom/localInit)
        (set! h (ThreadLocalRandom/getProbe))
        (set! wasUncontended true))
      (let [^:mutable collide false]
        (while true
          (let [^:mutable ^CounterCell/1 cs nil
                ^:mutable ^CounterCell c nil
                ^:mutable ^int n 0
                ^:mutable ^long v 0]
            (cond
              (and (some? (set! cs counterCells)) (> (set! n (alength cs)) 0))
                (do
                  (cond
                    (nil? (set! c (aget cs (bit-and-int (unchecked-subtract-int n 1) h))))
                      (do
                        (when (== cellsBusy 0)
                          (let [r (CounterCell. x)]
                            (when (and (== cellsBusy 0) (.compareAndSetInt U this CELLSBUSY 0 1))
                              (let [^:mutable created false]
                                (try
                                  (let [^:mutable ^CounterCell/1 rs nil
                                        ^:mutable ^int m 0
                                        ^:mutable ^int j 0]
                                    (when (and
                                            (and
                                              (some? (set! rs counterCells))
                                              (> (set! m (alength rs)) 0))
                                            (nil?
                                              (aget
                                                rs
                                                (set!
                                                  j
                                                  (bit-and-int (unchecked-subtract-int m 1) h)))))
                                      (aset rs j r)
                                      (set! created true)))
                                  (finally (set! cellsBusy 0)))
                                (when created (break))
                                (continue)))))
                        (set! collide false))
                    (not wasUncontended) (set! wasUncontended true)
                    (.compareAndSetLong U c CELLVALUE (set! v (.-value c)) (unchecked-add v x))
                      (break)
                    (or (not (identical? counterCells cs)) (>= n NCPU)) (set! collide false)
                    (not collide) (set! collide true)
                    :else
                      (when (and (== cellsBusy 0) (.compareAndSetInt U this CELLSBUSY 0 1))
                        (try
                          (when (identical? counterCells cs)
                            (set! counterCells
                                  (cast CounterCell/1 (Arrays/copyOf cs (bit-shift-left-int n 1)))))
                          (finally (set! cellsBusy 0)))
                        (set! collide false)
                        (continue)))
                  (set! h (ThreadLocalRandom/advanceProbe h)))
              (and (and (== cellsBusy 0) (identical? counterCells cs))
                   (.compareAndSetInt U this CELLSBUSY 0 1))

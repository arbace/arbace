            (return))
          (when (<= check 1) (return))
          (set! s (.sumCount this))))
      (when (>= check 0)
        (let [^:mutable ^{:tag (array (Node K V))} tab nil
              ^:mutable ^{:tag (array (Node K V))} nt nil
              ^:mutable ^int n 0
              ^:mutable ^int sc 0]
          (while (and (and (>= s (long (set! sc sizeCtl))) (some? (set! tab table)))
                      (< (set! n (alength tab)) MAXIMUM_CAPACITY))
            (let [rs (bit-shift-left-int (ConcurrentHashMap/resizeStamp n) RESIZE_STAMP_SHIFT)]

                      (return))
                    (set! finishing (set! advance true))
                    (set! i n)))
              (nil? (set! f (ConcurrentHashMap/tabAt tab i)))
                (set! advance (ConcurrentHashMap/casTabAt tab i nil fwd))
              (== (set! fh (.-hash f)) MOVED) (set! advance true)
              :else
                (locking f
                  (when (identical? (ConcurrentHashMap/tabAt tab i) f)
                    (let [^:mutable ^{:tag (Node K V)} ln nil
                          ^:mutable ^{:tag (Node K V)} hn nil]
                      (cond
                        (>= fh 0)
                          (let [^:mutable runBit (bit-and-int fh n)
                                ^:mutable ^{:tag (Node K V)} lastRun f]
                            (loop [^{:tag (Node K V)} p (.-next f)]
                              (when (some? p)
                                (let [b (bit-and-int (.-hash p) n)]
                                  (if (not (== b runBit))
                                      (do (set! runBit b) (set! lastRun p) (recur (.-next p)))
                                      (recur (.-next p))))))
                            (if (== runBit 0)
                                (do (set! ln lastRun) (set! hn nil))
                                (do (set! hn lastRun) (set! ln nil)))
                            (loop [^{:tag (Node K V)} p f]
                              (when-not (identical? p lastRun)
                                (let [ph (.-hash p)
                                      ^K pk (.-key p)
                                      ^V pv (.-val p)]
                                  (if (== (bit-and-int ph n) 0)
                                      (do (set! ln (Node. ph pk pv ln)) (recur (.-next p)))
                                      (do (set! hn (Node. ph pk pv hn)) (recur (.-next p)))))))
                            (ConcurrentHashMap/setTabAt nextTab i ln)
                            (ConcurrentHashMap/setTabAt nextTab (unchecked-add-int i n) hn)
                            (ConcurrentHashMap/setTabAt tab i fwd)
                            (set! advance true))
                        (instance? TreeBin f)
                          (let [^{:tag (TreeBin K V)} t (cast TreeBin f)
                                ^:mutable ^{:tag (TreeNode K V)} lo nil
                                ^:mutable ^{:tag (TreeNode K V)} loTail nil
                                ^:mutable ^{:tag (TreeNode K V)} hi nil
                                ^:mutable ^{:tag (TreeNode K V)} hiTail nil
                                ^:mutable ^int lc 0
                                ^:mutable ^int hc 0]
                            (loop [^{:tag (Node K V)} e (.-first t)]
                              (when (some? e)
                                (let [h (.-hash e)
                                      ^{:tag (TreeNode K V)} p (TreeNode.
                                                                 h
                                                                 (.-key e)
                                                                 (.-val e)
                                                                 nil
                                                                 nil)]
                                  (if (== (bit-and-int h n) 0)
                                      (do
                                        (if (nil? (set! (.-prev p) loTail))

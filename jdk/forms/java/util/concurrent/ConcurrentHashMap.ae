                                         this
                                         SIZECTL
                                         sc
                                         (unchecked-add-int
                                           (bit-shift-left-int rs RESIZE_STAMP_SHIFT)
                                           2))
                  (.transfer this tab nil))))))))

  (method ^:private ^:final transfer ^void [this ^{:tag (array (Node K V))} tab
                                            ^:mutable ^{:tag (array (Node K V))} nextTab]

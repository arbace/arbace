          (set! p (.nextNode this p)))))

    (method ^:public hasNext ^boolean [this] (some? nextItem))

    (method ^:public next ^E [this]
      (let [^E item nextItem]
        (when (nil? item) (throw (NoSuchElementException.)))
        (.advance this)
        item))

    (method ^:public remove ^void [this]
      (let [^{:tag (Node E)} l lastRet]
        (when (nil? l) (throw (IllegalStateException.)))
        (set! (.-item l) nil)
        (.unlink ConcurrentLinkedDeque/this l)
        (set! lastRet nil))))

  (defclass ^:private Itr
    :extends AbstractItr

    (constructor [this])

    (method startNode ^{:tag (Node E)} [this]
      (.first ConcurrentLinkedDeque/this))

    (method nextNode ^{:tag (Node E)} [this ^{:tag (Node E)} p]
      (.succ ConcurrentLinkedDeque/this p)))

  (defclass ^:private DescendingItr
    :extends AbstractItr

    (constructor [this])

    (method startNode ^{:tag (Node E)} [this]
      (.last ConcurrentLinkedDeque/this))

    (method nextNode ^{:tag (Node E)} [this ^{:tag (Node E)} p]
      (.pred ConcurrentLinkedDeque/this p)))

  (defclass ^:final CLDSpliterator
    :implements [(Spliterator E)]

    (field ^:static ^:final ^int MAX_BATCH (bit-shift-left-int 1 25))

    (field ^{:tag (Node E)} current)

    (field ^int batch)

    (field ^boolean exhausted)

    (method ^:public trySplit ^{:tag (Spliterator E)} [this]
      (let [^:mutable ^{:tag (Node E)} p nil
            ^:mutable ^{:tag (Node E)} q nil]
        (when-not (or (nil? (set! p (.current this))) (nil? (set! q (.-next p))))
          (let [^:mutable ^int i 0
                n (set! batch (Math/min (unchecked-add-int batch 1) MAX_BATCH))
                ^:mutable ^Object/1 a nil]
            (loop []
              (let [^:mutable ^E e nil]
                (when (some? (set! e (.-item p)))
                  (when (nil? a) (set! a (new Object/1 n)))
                  (aset a i e)
                  (set! i (unchecked-inc-int i)))
                (when (identical? p (set! p q)) (set! p (.first ConcurrentLinkedDeque/this))))
              (when (and (and (some? p) (some? (set! q (.-next p)))) (< i n)) (recur)))
            (.setCurrent this p)
            (when-not (== i 0)
              (Spliterators/spliterator a
                                        0
                                        i
                                        (bit-or-int
                                          (bit-or-int Spliterator/ORDERED Spliterator/NONNULL)
                                          Spliterator/CONCURRENT)))))))

    (method ^:public forEachRemaining ^void [this ^{:tag (Consumer (? super E))} action]
      (Objects/requireNonNull action)
      (let [^:mutable ^{:tag (Node E)} p nil]
        (when (some? (set! p (.current this)))
          (set! current nil)
          (set! exhausted true)
          (loop []
            (let [^:mutable ^E e nil]
              (when (some? (set! e (.-item p))) (.accept action e))
              (when (identical? p (set! p (.-next p))) (set! p (.first ConcurrentLinkedDeque/this))))
            (when (some? p) (recur))))))

    (method ^:public tryAdvance ^boolean [this ^{:tag (Consumer (? super E))} action]
      (Objects/requireNonNull action)
      (let [^:mutable ^{:tag (Node E)} p nil]
        (when (some? (set! p (.current this)))
          (let [^:mutable ^E e nil]
            (loop []
              (set! e (.-item p))
              (when (identical? p (set! p (.-next p))) (set! p (.first ConcurrentLinkedDeque/this)))
              (when (and (nil? e) (some? p)) (recur)))
            (.setCurrent this p)
            (when (some? e) (.accept action e) (return true))))
        false))

    (method ^:private setCurrent ^void [this ^{:tag (Node E)} p]
      (when (nil? (set! current p)) (set! exhausted true)))

    (method ^:private current ^{:tag (Node E)} [this]
      (let [^:mutable ^{:tag (Node E)} p nil]
        (when (and (nil? (set! p current)) (not exhausted))
          (.setCurrent this (set! p (.first ConcurrentLinkedDeque/this))))
        p))

    (method ^:public estimateSize ^long [this] Long/MAX_VALUE)

    (method ^:public characteristics ^int [this]
      (bit-or-int (bit-or-int Spliterator/ORDERED Spliterator/NONNULL) Spliterator/CONCURRENT)))

  (method ^:public spliterator ^{:tag (Spliterator E)} [this]
    (CLDSpliterator.))

  (method ^:private writeObject :throws [IOException] ^void [this ^ObjectOutputStream s]
    (.defaultWriteObject s)
    (loop [^{:tag (Node E)} p (.first this)]
      (when (some? p)
        (let [^:mutable ^E item nil]
          (if (some? (set! item (.-item p)))
              (do (.writeObject s item) (recur (.succ this p)))
              (recur (.succ this p))))))
    (.writeObject s nil))

  (method ^:private readObject :throws [IOException ClassNotFoundException] ^void [this
                                                                                   ^ObjectInputStream s]
    (.defaultReadObject s)
    (let [^:mutable ^{:tag (Node E)} h nil
          ^:mutable ^{:tag (Node E)} t nil]
      (let [^:mutable ^Object item nil]
        (while (some? (set! item (.readObject s)))
          (let [^{:tag (Node E)} newNode (ConcurrentLinkedDeque/newNode item)]
            (if (nil? h)
                (set! h (set! t newNode))
                (do
                  ^void (^[Node Node] VarHandle/.set NEXT t newNode)
                  ^void (^[Node Node] VarHandle/.set PREV newNode t)
                  (set! t newNode))))))
      (.initHeadTail this h t)))

  (method ^:public removeIf ^boolean [this ^{:tag (Predicate (? super E))} filter]
    (Objects/requireNonNull filter)
    (.bulkRemove this filter))

  (method ^:public removeAll ^boolean [this ^{:tag (Collection ?)} c]
    (Objects/requireNonNull c)
    (.bulkRemove this (lambda Predicate ^boolean [e] (.contains c e))))

  (method ^:public retainAll ^boolean [this ^{:tag (Collection ?)} c]
    (Objects/requireNonNull c)
    (.bulkRemove this (lambda Predicate ^boolean [e] (not (.contains c e)))))

  (method ^:private bulkRemove ^boolean [this ^{:tag (Predicate (? super E))} filter]
    (let [^:mutable removed false]
      (let [^:mutable ^{:tag (Node E)} p (.first this)
            ^:mutable ^{:tag (Node E)} succ nil]
        (while (some? p)
          (set! succ (.succ this p))
          (let [^:mutable ^E item nil]
            (when (and (and (some? (set! item (.-item p))) (.test filter item))
                       ^boolean (^[Node Object Void] VarHandle/.compareAndSet ITEM p item nil))
              (.unlink this p)
              (set! removed true)))
          (set! p succ)))
      removed))

  (method ^:public forEach ^void [this ^{:tag (Consumer (? super E))} action]
    (Objects/requireNonNull action)
    (let [^:mutable ^E item nil]
      (loop [^{:tag (Node E)} p (.first this)]
        (if (some? p)
            (if (some? (set! item (.-item p)))
                (do (.accept action item) (recur (.succ this p)))
                (recur (.succ this p)))
            nil))))

  (field ^:private ^:static ^:final ^VarHandle HEAD)

  (field ^:private ^:static ^:final ^VarHandle TAIL)

  (field ^:private ^:static ^:final ^VarHandle PREV)

  (field ^:private ^:static ^:final ^VarHandle NEXT)

  (field ^:private ^:static ^:final ^VarHandle ITEM)

  (static-initializer
    (set! PREV_TERMINATOR (Node.))
    (set! (.-next PREV_TERMINATOR) PREV_TERMINATOR)
    (set! NEXT_TERMINATOR (Node.))
    (set! (.-prev NEXT_TERMINATOR) NEXT_TERMINATOR)
    (try
      (let [l (MethodHandles/lookup)]
        (set! HEAD (.findVarHandle l ConcurrentLinkedDeque "head" Node))
        (set! TAIL (.findVarHandle l ConcurrentLinkedDeque "tail" Node))
        (set! PREV (.findVarHandle l Node "prev" Node))
        (set! NEXT (.findVarHandle l Node "next" Node))
        (set! ITEM (.findVarHandle l Node "item" Object)))
      (catch ReflectiveOperationException e (throw (ExceptionInInitializerError. e))))))

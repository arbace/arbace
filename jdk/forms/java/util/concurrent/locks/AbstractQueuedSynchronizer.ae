                      (LockSupport/parkUntil this abstime)))
                (.clearStatus node)
                (.reacquire AbstractQueuedSynchronizer/this node savedState)
                (cond
                  cancelled
                    (do
                      (.unlinkCancelledWaiters this node)
                      (when interrupted (throw (InterruptedException.))))
                  interrupted (.interrupt (Thread/currentThread)))
                (not cancelled))))))

    (method ^:public ^:final await :throws [InterruptedException] ^boolean [this ^long time
                                                                            ^TimeUnit unit]
      (let [nanosTimeout (.toNanos unit time)]
        (when (Thread/interrupted) (throw (InterruptedException.)))
        (let [node (.newConditionNode this)]
          (if (nil? node)
              false
              (let [savedState (.enableWait this node)
                    ^:mutable nanos (if (< nanosTimeout 0) 0 nanosTimeout)
                    deadline (unchecked-add (System/nanoTime) nanos)
                    ^:mutable cancelled false
                    ^:mutable interrupted false]
                (while (not (.canReacquire this node))
                  (if (or (set! interrupted
                                (let [a-9 interrupted b-10 (Thread/interrupted)] (or a-9 b-10)))
                          (<= (set! nanos (unchecked-subtract deadline (System/nanoTime))) 0))
                      (when (set! cancelled
                                  (not (== (bit-and-int (.getAndUnsetStatus node COND) COND) 0)))
                        (break))
                      (LockSupport/parkNanos this nanos)))
                (.clearStatus node)
                (.reacquire AbstractQueuedSynchronizer/this node savedState)
                (cond
                  cancelled
                    (do
                      (.unlinkCancelledWaiters this node)
                      (when interrupted (throw (InterruptedException.))))
                  interrupted (.interrupt (Thread/currentThread)))
                (not cancelled))))))

    (method ^:final isOwnedBy ^boolean [this ^AbstractQueuedSynchronizer sync]
      (identical? sync AbstractQueuedSynchronizer/this))

    (method ^:protected ^:final hasWaiters ^boolean [this]
      (when-not (.isHeldExclusively AbstractQueuedSynchronizer/this)
        (throw (IllegalMonitorStateException.)))
      (loop [w firstWaiter]
        (if (some? w)
            (if (not (== (bit-and-int (.-status w) COND) 0)) (return true) (recur (.-nextWaiter w)))
            nil))
      false)

    (method ^:protected ^:final getWaitQueueLength ^int [this]
      (when-not (.isHeldExclusively AbstractQueuedSynchronizer/this)
        (throw (IllegalMonitorStateException.)))
      (let [^:mutable ^int n 0]
        (loop [w firstWaiter]
          (if (some? w)
              (if (not (== (bit-and-int (.-status w) COND) 0))
                  (do (set! n (unchecked-inc-int n)) (recur (.-nextWaiter w)))
                  (recur (.-nextWaiter w)))
              nil))
        n))

    (method ^:protected ^:final getWaitingThreads ^{:tag (Collection Thread)} [this]
      (when-not (.isHeldExclusively AbstractQueuedSynchronizer/this)
        (throw (IllegalMonitorStateException.)))
      (let [^{:tag (ArrayList Thread)} list (ArrayList.)]
        (loop [w firstWaiter]
          (if (some? w)
              (if (not (== (bit-and-int (.-status w) COND) 0))
                  (let [t (.-waiter w)]
                    (if (some? t)
                        (do (.add list t) (recur (.-nextWaiter w)))
                        (recur (.-nextWaiter w))))
                  (recur (.-nextWaiter w)))
              nil))
        list)))


                  (when interrupted (.interrupt (Thread/currentThread)))
                  (return nextState))
              (and first (not (== spins 0)))
                (do (set! spins (unchecked-byte (unchecked-dec-int spins))) (Thread/onSpinWait))
              (== (.-status node) 0)
                (do
                  (when (nil? (.-waiter node)) (set! (.-waiter node) (Thread/currentThread)))
                  (set! (.-status node) WAITING))
              (or (not timed) (> (set! nanos (unchecked-subtract time (System/nanoTime))) 0))
                (do
                  (try
                    (if (not timed) (LockSupport/park this) (LockSupport/parkNanos this nanos))
                    (catch [Error RuntimeException] ex (.cancelAcquire this node) (throw ex)))
                  (.clearStatus node)
                  (when (and (set! interrupted
                                   (let [a-5 interrupted b-6 (Thread/interrupted)] (or a-5 b-6)))
                             interruptible)
                    (break))
                  (set! spins
                        (set! postSpins
                              (unchecked-byte (bit-or-int (bit-shift-left-int postSpins 1) 1)))))
              :else (break))))
        (.cancelAcquire this node)
        (if (or interrupted (Thread/interrupted)) INTERRUPTED 0))))

  (method ^:private cleanQueue ^void [this]
    (while true
      (let [^:mutable q tail
            ^:mutable ^Node s nil
            ^:mutable ^Node p nil
            ^:mutable ^Node n nil]
        (while true
          (when (or (nil? q) (nil? (set! p (.-prev q)))) (return))
          (when (if (nil? s)
                    (not (identical? tail q))
                    (or (not (identical? (.-prev s) q)) (< (.-status s) 0)))
            (break))
          (when (< (.-status q) 0)
            (when (and (if (nil? s) (.casTail this q p) (.casPrev s q p)) (identical? (.-prev q) p))
              (.casNext p q s)
              (when (nil? (.-prev p)) (StampedLock/signalNext p)))
            (break))
          (when-not (identical? (set! n (.-next p)) q)
            (when (and (and (some? n) (identical? (.-prev q) p)) (>= (.-status q) 0))
              (.casNext p n q)
              (when (nil? (.-prev p)) (StampedLock/signalNext p)))
            (break))
          (set! s q)
          (set! q (.-prev q))))))

  (method ^:private unlinkCowaiter ^void [this ^ReaderNode node ^ReaderNode leader]
    (when (some? leader)
      (while (and (some? (.-prev leader)) (>= (.-status leader) 0))
        (let [^:mutable p leader
              ^:mutable ^ReaderNode q nil]
          (while true
            (when (nil? (set! q (.-cowaiters p))) (return))
            (when (identical? q node) (.casCowaiters p q (.-cowaiters q)) (break))
            (set! p q))))))

  (method ^:private cancelAcquire ^void [this ^Node node]
    (when (some? node)
      (set! (.-waiter node) nil)
      (set! (.-status node) CANCELLED)
      (.cleanQueue this)
      (when (instance? ReaderNode node) (StampedLock/signalCowaiters (cast ReaderNode node)))))

  (method ^:private cancelCowaiter ^void [this ^ReaderNode node ^ReaderNode leader]
    (when (some? node)
      (set! (.-waiter node) nil)
      (set! (.-status node) CANCELLED)
      (.unlinkCowaiter this node leader)))

  (method ^:private spinLockOnOOME ^long [this ^boolean write ^boolean interruptible ^boolean timed
                                          ^long time]
    (let [startTime (if timed (System/nanoTime) 0)
          ^:mutable ^int spins 0]
      (while true
        (let [s (if write (.tryAcquireWrite this) (.tryAcquireRead this))]
          (when-not (== s 0) (return s))
          (Thread/onSpinWait)
          (when (== (bit-and-int (set! spins (unchecked-inc-int spins)) (bit-shift-left-int 1 8)) 0)
            (when (and interruptible (Thread/interrupted)) (return INTERRUPTED))
            (when (and timed (> (unchecked-subtract (System/nanoTime) startTime) time)) (return 0)))))))

  (field ^:private ^:static ^:final ^Unsafe U (Unsafe/getUnsafe))

  (field ^:private ^:static ^:final ^long STATE (.objectFieldOffset U StampedLock "state"))

  (field ^:private ^:static ^:final ^long HEAD (.objectFieldOffset U StampedLock "head"))

  (field ^:private ^:static ^:final ^long TAIL (.objectFieldOffset U StampedLock "tail"))

  (static-initializer (let [^{:tag (Class ?)} ensureLoaded LockSupport] nil)))

  (field ^:private ^:static ^:final ^long HOUR_SCALE (unchecked-multiply 60 MINUTE_SCALE))

  (field ^:private ^:static ^:final ^long DAY_SCALE (unchecked-multiply 24 HOUR_SCALE))

  (field ^:private ^:final ^long scale)

  (field ^:private ^:final ^long maxNanos)

  (field ^:private ^:final ^long maxMicros)

  (field ^:private ^:final ^long maxMillis)

  (field ^:private ^:final ^long maxSecs)

  (field ^:private ^:final ^long microRatio)

  (field ^:private ^:final ^int milliRatio)

  (field ^:private ^:final ^int secRatio)

  (constructor ^:private [this ^long s]

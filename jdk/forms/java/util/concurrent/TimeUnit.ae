  (field ^:private ^:static ^:final ^long NANO_SCALE 1)

  (field ^:private ^:static ^:final ^long MICRO_SCALE (unchecked-multiply 1000 NANO_SCALE))

  (field ^:private ^:static ^:final ^long MILLI_SCALE (unchecked-multiply 1000 MICRO_SCALE))

  (field ^:private ^:static ^:final ^long SECOND_SCALE (unchecked-multiply 1000 MILLI_SCALE))


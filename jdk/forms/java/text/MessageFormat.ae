          (throw (MatchException. nil nil))))))

  (method ^:private formatFromSubformatPattern ^Format [this ^FormatType fType ^String pattern]
    (let [type (java-str (.charAt (.name fType) 0)
                         (.toLowerCase (.substring (.name fType) 1) Locale/ROOT))]
      (try
        (switch fType
          NUMBER (DecimalFormat. pattern (DecimalFormatSymbols/getInstance locale))
          (DATE TIME) (SimpleDateFormat. pattern locale)
          (DTF_DATE DTF_TIME DTF_DATETIME) (.toFormat (DateTimeFormatter/ofPattern pattern))
          CHOICE (ChoiceFormat. pattern)
          (throw (IllegalArgumentException.
                   (String/format "Unexpected modifier for %s: %s" (new Object/1 [type pattern])))))
        (catch Exception e
          (if (or (identical? (.getClass e) IllegalArgumentException)
                  (identical? (.getClass e) NullPointerException))
              (throw e)
              (throw (IllegalArgumentException.
                       (String/format "%s pattern incorrect: %s" (new Object/1 [type pattern]))
                       e)))))))

  (method ^:private ^:static copyAndFixQuotes ^void [^String source ^int start ^int end
                                                     ^StringBuilder target]
    (let [^:mutable quoted false]
      (loop [^int i start]
        (when (< i end)
          (let [ch (.charAt source i)]
            (cond
              (== ch \{)
                (do
                  (when-not quoted (.append target \') (set! quoted true))
                  (.append target ch)
                  (recur (unchecked-inc-int i)))
              (== ch \') (do (.append target "''") (recur (unchecked-inc-int i)))
              :else
                (do
                  (when quoted (.append target \') (set! quoted false))
                  (.append target ch)
                  (recur (unchecked-inc-int i)))))))
      (when quoted (.append target \'))))

  (method ^:private ^:static copyAndQuoteBraces ^String [^String source]
    (letclass [(^:record Qchar [^char ch ^boolean quoted])]
      (let [^{:tag (ArrayList Qchar)} qchars (ArrayList.)
            ^:mutable quoted false
            ^:mutable anyChangeNeeded false
            quotedSource (StringBuilder.)]
        (let [^:mutable ^int i 0]
          (while (< i (.length source))
            (let [ch (.charAt source i)]
              (if (== ch \')
                  (if (and (< (unchecked-add-int i 1) (.length source))
                           (== (.charAt source (unchecked-add-int i 1)) \'))
                      (do (.add qchars (Qchar. \' quoted)) (set! i (unchecked-inc-int i)))
                      (set! quoted (not quoted)))
                  (let [quotable (or (== ch \{) (== ch \}))]
                    (set! anyChangeNeeded
                          (let [a-1 anyChangeNeeded b-2 (and quotable (not quoted))] (or a-1 b-2)))
                    (.add qchars (Qchar. ch (or quoted quotable))))))
            (set! i (unchecked-inc-int i))))
        (if (not anyChangeNeeded)
            source
            (do
              (set! quoted false)
              (for-each [^Qchar qchar qchars]
                (let [ch (.-ch qchar)]
                  (if (== ch \')
                      (.append quotedSource ch)
                      (when-not (= (.quoted qchar) quoted)
                        (.append quotedSource \')
                        (set! quoted (.quoted qchar))))
                  (.append quotedSource ch)))
              (when quoted (.append quotedSource \'))
              (.toString quotedSource))))))

  (defclass ^:private ^:enum FormatType
    (constants
      NUMBER
      DATE
      TIME
      DTF_DATE
      DTF_TIME
      DTF_DATETIME
      CHOICE
      LIST
      BASIC_ISO_DATE
      ISO_LOCAL_DATE
      ISO_OFFSET_DATE
      ISO_DATE
      ISO_LOCAL_TIME
      ISO_OFFSET_TIME
      ISO_TIME
      ISO_LOCAL_DATE_TIME
      ISO_OFFSET_DATE_TIME
      ISO_ZONED_DATE_TIME
      ISO_DATE_TIME
      ISO_ORDINAL_DATE
      ISO_WEEK_DATE
      ISO_INSTANT
      RFC_1123_DATE_TIME))

  (defclass ^:private ^:enum FormatStyle
    (constants
      (DEFAULT [""])
      (SHORT ["short"])
      (MEDIUM ["medium"])
      (LONG ["long"])
      (FULL ["full"])
      (INTEGER ["integer"])
      (CURRENCY ["currency"])
      (PERCENT ["percent"])
      (COMPACT_SHORT ["compact_short"])
      (COMPACT_LONG ["compact_long"])
      (OR ["or"])
      (UNIT ["unit"])
      (SUBFORMATPATTERN [nil]))

    (field ^:private ^:final ^String text)

    (constructor [this ^String text] (set! (.-text this) text))

    (method ^:private ^:static fromString ^FormatStyle [^String text]
      (for-each [^FormatStyle style (FormatStyle/values)]
        (when (and (not (identical? style FormatStyle/SUBFORMATPATTERN))
                   (== (.compareToIgnoreCase (.trim text) (.-text style)) 0))
          (return style)))
      (throw (IllegalArgumentException.))))

  (method ^:private readObject :throws [IOException ClassNotFoundException] ^void [this
                                                                                   ^ObjectInputStream in]
    (let [fields (.readFields in)]
      (when (or (or (or (or (or (.defaulted fields "argumentNumbers") (.defaulted fields "offsets"))
                            (.defaulted fields "formats"))
                        (.defaulted fields "locale"))
                    (.defaulted fields "pattern"))
                (.defaulted fields "maxOffset"))
        (throw (InvalidObjectException. "Stream has missing data")))
      (set! locale (cast Locale (.get fields "locale" nil)))
      (let [patt (cast String (.get fields "pattern" nil))
            maxOff (^[String int] ObjectInputStream$GetField/.get fields "maxOffset" -2)
            argNums (.clone (cast int/1 (.get fields "argumentNumbers" nil)))
            offs (.clone (cast int/1 (.get fields "offsets" nil)))
            fmts (.clone (cast Format/1 (.get fields "formats" nil)))
            ^:mutable isValid (and (and (and (>= maxOff -1) (> (alength argNums) maxOff))
                                        (> (alength offs) maxOff))
                                   (> (alength fmts) maxOff))]
        (when isValid
          (let [^:mutable lastOffset (.length patt)]
            (loop [^int i maxOff]
              (if (>= i 0)
                  (if (or (or (or (< (aget argNums i) 0) (>= (aget argNums i) MAX_ARGUMENT_INDEX))
                              (< (aget offs i) 0))
                          (> (aget offs i) lastOffset))
                      (set! isValid false)
                      (do (set! lastOffset (aget offs i)) (recur (unchecked-dec-int i))))
                  nil))))
        (when-not isValid (throw (InvalidObjectException. "Stream has invalid data")))
        (set! maxOffset maxOff)
        (set! pattern patt)
        (set! offsets offs)
        (set! formats fmts)
        (set! argumentNumbers argNums))))

  (method ^:private readObjectNoData :throws [ObjectStreamException] ^void [this]
    (throw (InvalidObjectException. "Deserialized MessageFormat objects need data"))))

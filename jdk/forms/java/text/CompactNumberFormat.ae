  (field ^:private ^:static ^:final ^Pattern PLURALRULES_PATTERN
    (Pattern/compile
      (java-str (java-str (java-str (java-str "(zero|one|two|few|many):\\s*" CONDITION)
                                    "(\\s*(and|or)\\s*")
                          CONDITION)
                ")*")))

  (method ^:private validateRule ^String [this ^:mutable ^String rule]
    (set! rule (.trim rule))
    (when (and (not (.isEmpty rule)) (not (.equals rule "other:")))
      (let [validator (.matcher PLURALRULES_PATTERN rule)]
        (when-not (.matches validator)
          (throw (IllegalArgumentException. (java-str "Invalid plural rules syntax: " rule))))))
    rule)

  (method ^:private applyPattern ^void [this ^String count ^String pattern ^int index]
    (when (nil? pattern)
      (throw (IllegalArgumentException.
               (java-str "A null compact pattern encountered at index: " index))))
    (let [^:mutable ^int start 0
          ^:mutable gotNegative false
          ^:mutable positivePrefix ""
          ^:mutable positiveSuffix ""
          ^:mutable negativePrefix ""
          ^:mutable negativeSuffix ""
          ^:mutable zeros ""]
      (loop [^int j 1]
        (when (and (>= j 0) (< start (.length pattern)))
          (let [prefix (StringBuilder.)
                suffix (StringBuilder.)
                ^:mutable inQuote false
                ^:mutable ^int phase 0
                ^:mutable affix prefix]
            (let [^:mutable pos start]
              (while (< pos (.length pattern))
                (let [ch (.charAt pattern pos)]
                  (switch phase
                    (0 2)
                      (do
                        (if inQuote
                            (when (== ch QUOTE)
                              (if (and (< (unchecked-add-int pos 1) (.length pattern))
                                       (== (.charAt pattern (unchecked-add-int pos 1)) QUOTE))
                                  (do (set! pos (unchecked-inc-int pos)) (.append affix "''"))
                                  (set! inQuote false))
                              (set! pos (unchecked-inc-int pos))
                              (continue))
                            (switch ch
                              ZERO_DIGIT
                                (do
                                  (set! phase 1)
                                  (set! pos (unchecked-dec-int pos))
                                  (set! pos (unchecked-inc-int pos))
                                  (continue))
                              QUOTE
                                (do
                                  (if (and (< (unchecked-add-int pos 1) (.length pattern))
                                           (== (.charAt pattern (unchecked-add-int pos 1)) QUOTE))
                                      (do (set! pos (unchecked-inc-int pos)) (.append affix "''"))
                                      (set! inQuote true))
                                  (set! pos (unchecked-inc-int pos))
                                  (continue))
                              SEPARATOR
                                (do
                                  (when (or (== phase 0) (== j 0))
                                    (throw (IllegalArgumentException.
                                             (java-str
                                               "Unquoted special character '"
                                               ch
                                               "' in pattern \""
                                               pattern
                                               "\""))))
                                  (set! start (unchecked-add-int pos 1))
                                  (set! pos (.length pattern))
                                  (set! pos (unchecked-inc-int pos))
                                  (continue))
                              MINUS_SIGN
                                (do
                                  (.append affix "'-")
                                  (set! pos (unchecked-inc-int pos))
                                  (continue))
                              (DECIMAL_SEPARATOR
                                GROUPING_SEPARATOR
                                DIGIT
                                PERCENT
                                PER_MILLE
                                CURRENCY_SIGN)
                                (throw (IllegalArgumentException.
                                         (java-str
                                           "Unquoted special character '"
                                           ch
                                           "' in pattern \""
                                           pattern
                                           "\"")))
                              nil))
                        (.append affix ch))
                    1
                      (cond
                        (== j 0)
                          (while (< pos (.length pattern))
                            (let [negPatternChar (.charAt pattern pos)]
                              (if (== negPatternChar ZERO_DIGIT)
                                  (set! pos (unchecked-inc-int pos))
                                  (do
                                    (set! pos (unchecked-dec-int pos))
                                    (set! phase 2)
                                    (set! affix suffix)
                                    (break)))))
                        (== ch ZERO_DIGIT) (set! zeros (java-str zeros "0"))
                        :else
                          (do (set! phase 2) (set! affix suffix) (set! pos (unchecked-dec-int pos))))))
                (set! pos (unchecked-inc-int pos))))
            (when inQuote
              (throw (IllegalArgumentException.
                       (java-str "Invalid single quote in pattern \"" pattern "\""))))
            (if (== j 1)
                (do
                  (set! positivePrefix (.toString prefix))
                  (set! positiveSuffix (.toString suffix))
                  (set! negativePrefix positivePrefix)
                  (set! negativeSuffix positiveSuffix))
                (do
                  (set! negativePrefix (.toString prefix))
                  (set! negativeSuffix (.toString suffix))
                  (set! gotNegative true)))
            (if (or (not gotNegative)
                    (and (.equals negativePrefix positivePrefix)
                         (.equals negativeSuffix positiveSuffix)))
                (do
                  (set! negativeSuffix positiveSuffix)
                  (set! negativePrefix (java-str "'-" positivePrefix))
                  (recur (unchecked-dec-int j)))
                (recur (unchecked-dec-int j))))))
      (if (or (not (.isEmpty positivePrefix)) (not (.isEmpty positiveSuffix)))
          (do
            (.put (cast Patterns (.get positivePrefixPatterns index)) count positivePrefix)
            (.put (cast Patterns (.get negativePrefixPatterns index)) count negativePrefix)
            (.put (cast Patterns (.get positiveSuffixPatterns index)) count positiveSuffix)
            (.put (cast Patterns (.get negativeSuffixPatterns index)) count negativeSuffix)
            (.put (cast Patterns (.get placeHolderPatterns index)) count zeros)
            (when (<= (.size divisors) index) (.add divisors (.computeDivisor this zeros index))))
          (do
            (.put (cast Patterns (.get positivePrefixPatterns index)) count "")
            (.put (cast Patterns (.get negativePrefixPatterns index)) count "")
            (.put (cast Patterns (.get positiveSuffixPatterns index)) count "")
            (.put (cast Patterns (.get negativeSuffixPatterns index)) count "")
            (.put (cast Patterns (.get placeHolderPatterns index)) count "")
            (when (<= (.size divisors) index) (.add divisors 1))))))

  (field ^:private ^:transient ^DigitList digitList (DigitList.))

  (field ^:private ^:static ^:final ^int STATUS_INFINITE 0)

  (field ^:private ^:static ^:final ^int STATUS_POSITIVE 1)

  (field ^:private ^:static ^:final ^int STATUS_LENGTH 2)

  (field ^:private ^:static ^:final ^char ZERO_DIGIT \0)

  (field ^:private ^:static ^:final ^char DIGIT \#)

  (field ^:private ^:static ^:final ^char DECIMAL_SEPARATOR \.)

  (field ^:private ^:static ^:final ^char GROUPING_SEPARATOR \,)

  (field ^:private ^:static ^:final ^char MINUS_SIGN \-)

  (field ^:private ^:static ^:final ^char PERCENT \%)

  (field ^:private ^:static ^:final ^char PER_MILLE \‰)

  (field ^:private ^:static ^:final ^char SEPARATOR \;)

  (field ^:private ^:static ^:final ^char CURRENCY_SIGN \¤)

  (field ^:private ^:static ^:final ^char QUOTE \')

  (field ^:private ^:transient ^{:tag (List Patterns)} positivePrefixes)

  (field ^:private ^:transient ^{:tag (List Patterns)} negativePrefixes)

  (field ^:private ^:transient ^{:tag (List Patterns)} positiveSuffixes)

  (field ^:private ^:transient ^{:tag (List Patterns)} negativeSuffixes)

  (method ^:private expandAffixPatterns ^void [this]
    (set! positivePrefixes (ArrayList. (alength compactPatterns)))
    (set! negativePrefixes (ArrayList. (alength compactPatterns)))
    (set! positiveSuffixes (ArrayList. (alength compactPatterns)))
    (set! negativeSuffixes (ArrayList. (alength compactPatterns)))
    (loop [^int index 0]
      (when (< index (alength compactPatterns))
        (.add positivePrefixes (.expandAffix (cast Patterns (.get positivePrefixPatterns index))))
        (.add negativePrefixes (.expandAffix (cast Patterns (.get negativePrefixPatterns index))))
        (.add positiveSuffixes (.expandAffix (cast Patterns (.get positiveSuffixPatterns index))))
        (.add negativeSuffixes (.expandAffix (cast Patterns (.get negativeSuffixPatterns index))))
        (recur (unchecked-inc-int index)))))

  (method ^:public parse ^Number [this ^String text ^ParsePosition pos]
    (Objects/requireNonNull text)
    (Objects/requireNonNull pos)
    (when (nil? positivePrefixes) (.expandAffixPatterns this))
    (let [^:mutable ^Number cnfMultiplier 1]
      (if (.regionMatches text (.-index pos) (.getNaN symbols) 0 (.length (.getNaN symbols)))
          (do
            (set! (.-index pos) (unchecked-add-int (.-index pos) (.length (.getNaN symbols))))
            Double/NaN)
          (let [^:mutable position (.-index pos)
                oldStart (.-index pos)
                ^:mutable gotPositive false
                ^:mutable gotNegative false
                ^:mutable ^int matchedPosIndex -1
                ^:mutable ^int matchedNegIndex -1
                ^:mutable matchedPosPrefix ""
                ^:mutable matchedNegPrefix ""
                defaultPosPrefix (.getPositivePrefix defaultDecimalFormat)
                defaultNegPrefix (.getNegativePrefix defaultDecimalFormat)
                num (.parseNumberPart this text position)]
            (loop [^int compactIndex 0]
              (when (< compactIndex (alength compactPatterns))
                (let [positivePrefix (.getAffix this true true false compactIndex num)
                      negativePrefix (.getAffix this true true true compactIndex num)
                      ^:mutable match (.matchAffix
                                        this
                                        text
                                        position
                                        positivePrefix
                                        defaultPosPrefix
                                        matchedPosPrefix)]
                  (when match
                    (set! matchedPosIndex compactIndex)
                    (set! matchedPosPrefix positivePrefix)
                    (set! gotPositive true))
                  (set! match
                        (.matchAffix this
                                     text
                                     position
                                     negativePrefix
                                     defaultNegPrefix
                                     matchedNegPrefix))
                  (if match
                      (do
                        (set! matchedNegIndex compactIndex)
                        (set! matchedNegPrefix negativePrefix)
                        (set! gotNegative true)
                        (recur (unchecked-inc-int compactIndex)))
                      (recur (unchecked-inc-int compactIndex))))))
            (when (and (not gotPositive) (not gotNegative))
              (when (.matchAffix decimalFormat text position defaultPosPrefix)
                (set! matchedPosPrefix defaultPosPrefix)
                (set! gotPositive true))
              (when (.matchAffix decimalFormat text position defaultNegPrefix)
                (set! matchedNegPrefix defaultNegPrefix)
                (set! gotNegative true)))
            (when (and gotPositive gotNegative)
              (cond
                (> (.length matchedPosPrefix) (.length matchedNegPrefix)) (set! gotNegative false)
                (< (.length matchedPosPrefix) (.length matchedNegPrefix)) (set! gotPositive false)))
            (if (or gotPositive gotNegative)
                (do
                  (set! position
                        (unchecked-add-int position
                                           (if gotPositive
                                               (.length matchedPosPrefix)
                                               (.length matchedNegPrefix))))
                  (let [^int matchedIndex (if gotPositive matchedPosIndex matchedNegIndex)]
                    (when-not (== matchedIndex -1)
                      (set! cnfMultiplier (cast Number (.get divisors matchedIndex)))
                      (when (.isEmpty (.get (cast Patterns (.get placeHolderPatterns matchedIndex))
                                            num))
                        (set! (.-index pos) position)
                        (return cnfMultiplier))))
                  (.setRoundingMode digitList (.getRoundingMode this))
                  (let [status (new boolean/1 STATUS_LENGTH)]
                    (set! position
                          (.fullPos (.subparseNumber
                                      decimalFormat
                                      text
                                      position
                                      digitList
                                      false
                                      false
                                      status)))
                    (if (== position -1)
                        (do (set! (.-index pos) oldStart) (set! (.-errorIndex pos) oldStart) nil)
                        (do
                          (set! (.-index pos) position)
                          (let [multiplier (.computeParseMultiplier
                                             this
                                             text
                                             pos
                                             ^String (if gotPositive
                                                         matchedPosPrefix
                                                         matchedNegPrefix)
                                             status
                                             gotPositive
                                             gotNegative
                                             num)]
                            (if (== (.longValue multiplier) -1)
                                (do (when parseStrict (set! (.-index pos) oldStart)) nil)
                                (do
                                  (when-not (== (.longValue multiplier) 1)
                                    (set! cnfMultiplier multiplier))
                                  (cond
                                    (aget status STATUS_INFINITE)
                                      (if (aget status STATUS_POSITIVE)
                                          Double/POSITIVE_INFINITY
                                          Double/NEGATIVE_INFINITY)
                                    (.isParseBigDecimal this)
                                      (let [^:mutable bigDecimalResult (.getBigDecimal digitList)]
                                        (when-not (== (.longValue cnfMultiplier) 1)
                                          (set! bigDecimalResult
                                                (.multiply
                                                  bigDecimalResult
                                                  (BigDecimal. (.toString cnfMultiplier)))))
                                        (when-not (aget status STATUS_POSITIVE)
                                          (set! bigDecimalResult (.negate bigDecimalResult)))
                                        bigDecimalResult)
                                    :else
                                      (let [^:mutable ^Number cnfResult nil]
                                        (if (.fitsIntoLong
                                              digitList
                                              (aget status STATUS_POSITIVE)
                                              (.isParseIntegerOnly this))
                                            (let [longResult (.getLong digitList)]
                                              (set!
                                                cnfResult
                                                (.generateParseResult
                                                  this
                                                  longResult
                                                  false
                                                  (< longResult 0)
                                                  status
                                                  cnfMultiplier)))
                                            (set!
                                              cnfResult
                                              (.generateParseResult
                                                this
                                                (.getDouble digitList)
                                                true
                                                false
                                                status
                                                cnfMultiplier)))
                                        cnfResult)))))))))
                (do (set! (.-errorIndex pos) position) nil))))))

  (method ^:private parseNumberPart ^double [this ^String text ^int position]
    (when (nil? numberPattern)
      (set! numberPattern
            (Pattern/compile (java-str "[\\Q" (.getDecimalSeparator symbols) "\\E\\p{Nd}]+"))))
    (if (.startsWith text (.getInfinity symbols) position)
        Double/POSITIVE_INFINITY
        (do
          (when-not (.startsWith text (.getNaN symbols) position)
            (let [m (.matcher numberPattern text)]
              (if (.find m position)
                  (let [digits (.group m)]
                    (when (Character/isDigit (.codePointAt digits 0))
                      (return (Double/parseDouble
                                (cast String
                                      (.collect
                                        (.mapToObj
                                          (.map (.filter
                                                  (.codePoints digits)
                                                  (lambda IntPredicate ^boolean [^int cp]
                                                    (not (== cp (.getDecimalSeparator symbols)))))
                                                (method-ref
                                                  IntUnaryOperator
                                                  Character/getNumericValue))
                                          (method-ref IntFunction ^String [int] Integer/toString))
                                        (Collectors/joining)))))))
                  (return 1.0))))
          Double/NaN)))

  (method ^:private generateParseResult ^Number [this ^Number number ^:mutable ^boolean gotDouble
                                                 ^boolean gotLongMin ^boolean/1 status
                                                 ^Number cnfMultiplier]
    (if gotDouble
        (when-not (== (.longValue cnfMultiplier) 1)
          (let [^:mutable doubleResult (unchecked-multiply
                                         (.doubleValue number)
                                         (.doubleValue cnfMultiplier))]
            (set! doubleResult
                  (.doubleValue (cast Double
                                      (.convertIfNegative this doubleResult status gotLongMin))))
            (let [longResult (unchecked-long doubleResult)]
              (set! gotDouble
                    (or (not (== doubleResult (double longResult)))
                        (and (== doubleResult 0.0) (< (unchecked-divide 1.0 doubleResult) 0.0))))
              (return (if gotDouble
                          ^Number (Double/valueOf doubleResult)
                          ^Number (Long/valueOf longResult))))))
        (when-not (== (.longValue cnfMultiplier) 1)
          (let [^:mutable ^Number result nil]
            (if (and (instance? Long cnfMultiplier) (not gotLongMin))
                (let [longMultiplier (.longValue (cast Long cnfMultiplier))]
                  (try
                    (set! result (Math/multiplyExact (.longValue number) longMultiplier))
                    (catch ArithmeticException ex
                      (set! result
                            (unchecked-multiply (.doubleValue number) (.doubleValue cnfMultiplier))))))
                (set! result
                      (unchecked-multiply (.doubleValue number) (.doubleValue cnfMultiplier))))
            (return (.convertIfNegative this result status gotLongMin)))))
    (.convertIfNegative this number status gotLongMin))

  (method ^:private convertIfNegative ^Number [this ^Number number ^boolean/1 status
                                               ^boolean gotLongMin]
    (if (and (not (aget status STATUS_POSITIVE)) (not gotLongMin))
        (if (instance? Long number)
            (unchecked-negate (.longValue (cast Long number)))
            (unchecked-negate (.doubleValue (cast Double number))))
        number))

  (method ^:private matchAffix ^boolean [this ^String text ^int position ^String affix
                                         ^String defaultAffix ^String matchedAffix]
    (when (and (not (.isEmpty affix)) (not (.equals affix defaultAffix)))
      (when (< (.length matchedAffix) (.length affix))
        (return (.matchAffix decimalFormat text position affix))))
    false)

  (method ^:private matchPrefixAndSuffix ^boolean [this ^String text ^int position ^String prefix
                                                   ^String matchedPrefix ^String defaultPrefix
                                                   ^String suffix ^String matchedSuffix
                                                   ^String defaultSuffix]
    (if (or (.equals prefix matchedPrefix) (.equals matchedPrefix defaultPrefix))
        (if parseStrict
            (and (.matchAffix this text position suffix defaultSuffix matchedSuffix)
                 (== (.length text) (unchecked-add-int position (.length suffix))))
            (.matchAffix this text position suffix defaultSuffix matchedSuffix))
        false))

  (method ^:private computeParseMultiplier ^Number [this ^String text ^ParsePosition parsePosition
                                                    ^String matchedPrefix ^boolean/1 status
                                                    ^boolean gotPositive ^boolean gotNegative
                                                    ^double num]
    (let [position (.-index parsePosition)
          ^:mutable gotPos false
          ^:mutable gotNeg false
          ^:mutable ^int matchedPosIndex -1
          ^:mutable ^int matchedNegIndex -1
          ^:mutable matchedPosSuffix ""
          ^:mutable matchedNegSuffix ""]
      (loop [^int compactIndex 0]
        (when (< compactIndex (alength compactPatterns))
          (let [positivePrefix (.getAffix this true true false compactIndex num)
                negativePrefix (.getAffix this true true true compactIndex num)
                positiveSuffix (.getAffix this true false false compactIndex num)
                negativeSuffix (.getAffix this true false true compactIndex num)
                ^:mutable match (.matchPrefixAndSuffix
                                  this
                                  text
                                  position
                                  positivePrefix
                                  matchedPrefix
                                  (.getPositivePrefix defaultDecimalFormat)
                                  positiveSuffix
                                  matchedPosSuffix
                                  (.getPositiveSuffix defaultDecimalFormat))]
            (when match
              (set! matchedPosIndex compactIndex)
              (set! matchedPosSuffix positiveSuffix)
              (set! gotPos true)
              (when parseStrict (break)))
            (set! match
                  (.matchPrefixAndSuffix this
                                         text
                                         position
                                         negativePrefix
                                         matchedPrefix
                                         (.getNegativePrefix defaultDecimalFormat)
                                         negativeSuffix
                                         matchedNegSuffix
                                         (.getNegativeSuffix defaultDecimalFormat)))
            (if match
                (do
                  (set! matchedNegIndex compactIndex)
                  (set! matchedNegSuffix negativeSuffix)
                  (set! gotNeg true)
                  (when-not parseStrict (recur (unchecked-inc-int compactIndex))))
                (recur (unchecked-inc-int compactIndex))))))
      (when (and (not gotPos) (not gotNeg))
        (let [positiveSuffix (.getPositiveSuffix defaultDecimalFormat)
              negativeSuffix (.getNegativeSuffix defaultDecimalFormat)
              containsPosSuffix (.matchAffix decimalFormat text position positiveSuffix)
              endsWithPosSuffix (and containsPosSuffix
                                     (== (.length text)
                                         (unchecked-add-int position (.length positiveSuffix))))]
          (when (if parseStrict endsWithPosSuffix containsPosSuffix)
            (set! matchedPosSuffix positiveSuffix)
            (set! gotPos true))
          (let [containsNegSuffix (.matchAffix decimalFormat text position negativeSuffix)
                endsWithNegSuffix (and containsNegSuffix
                                       (== (.length text)
                                           (unchecked-add-int position (.length negativeSuffix))))]
            (when (if parseStrict endsWithNegSuffix containsNegSuffix)
              (set! matchedNegSuffix negativeSuffix)
              (set! gotNeg true)))))
      (when (and gotPos gotNeg)
        (cond
          (> (.length matchedPosSuffix) (.length matchedNegSuffix)) (set! gotNeg false)
          (< (.length matchedPosSuffix) (.length matchedNegSuffix)) (set! gotPos false)
          :else (do (set! gotPos gotPositive) (set! gotNeg gotNegative))))
      (if (= gotPos gotNeg)
          (do (set! (.-errorIndex parsePosition) position) -1)
          (let [^:mutable ^Number cnfMultiplier nil]
            (if gotPos
                (do
                  (set! (.-index parsePosition)
                        (unchecked-add-int position (.length matchedPosSuffix)))
                  (set! cnfMultiplier
                        (if (not (== matchedPosIndex -1))
                            (cast Number (.get divisors matchedPosIndex))
                            (Long/valueOf 1))))
                (do
                  (set! (.-index parsePosition)
                        (unchecked-add-int position (.length matchedNegSuffix)))
                  (set! cnfMultiplier
                        (if (not (== matchedNegIndex -1))
                            (cast Number (.get divisors matchedNegIndex))
                            (Long/valueOf 1)))))
            (aset status STATUS_POSITIVE gotPos)
            cnfMultiplier))))

  (method ^:private readObject :throws [IOException ClassNotFoundException] ^void [this
                                                                                   ^ObjectInputStream inStream]
    (.defaultReadObject inStream)
    (when (or (or (or (nil? decimalPattern) (nil? compactPatterns)) (nil? symbols))
              (nil? roundingMode))
      (throw
        (InvalidObjectException.
          "One of the 'decimalPattern', 'compactPatterns', 'symbols' or 'roundingMode' is null")))
    (when (or (> (.getMaximumIntegerDigits this) DecimalFormat/DOUBLE_INTEGER_DIGITS)
              (> (.getMaximumFractionDigits this) DecimalFormat/DOUBLE_FRACTION_DIGITS))
      (throw (InvalidObjectException. "Digit count out of range")))
    (when (< groupingSize 0) (throw (InvalidObjectException. "Grouping size is negative")))
    (when (nil? pluralRules) (set! pluralRules ""))
    (try
      (.processCompactPatterns this)
      (catch IllegalArgumentException ex (throw (InvalidObjectException. (.getMessage ex)))))
    (set! decimalFormat (DecimalFormat. SPECIAL_PATTERN symbols))
    (.setMaximumFractionDigits decimalFormat (.getMaximumFractionDigits this))
    (.setMinimumFractionDigits decimalFormat (.getMinimumFractionDigits this))
    (.setMaximumIntegerDigits decimalFormat (.getMaximumIntegerDigits this))
    (.setMinimumIntegerDigits decimalFormat (.getMinimumIntegerDigits this))
    (.setRoundingMode decimalFormat (.getRoundingMode this))
    (.setGroupingSize decimalFormat (.getGroupingSize this))
    (.setGroupingUsed decimalFormat (.isGroupingUsed this))
    (.setParseIntegerOnly decimalFormat (.isParseIntegerOnly this))
    (.setStrict decimalFormat parseStrict)
    (try
      (set! defaultDecimalFormat (DecimalFormat. decimalPattern symbols))
      (.setMaximumFractionDigits defaultDecimalFormat 0)
      (catch IllegalArgumentException ex (throw (InvalidObjectException. (.getMessage ex))))))

  (method ^:public setMaximumIntegerDigits ^void [this ^int newValue]
    (.setMaximumIntegerDigits decimalFormat (Math/min newValue DecimalFormat/DOUBLE_INTEGER_DIGITS))
    (.setMaximumIntegerDigits super (.getMaximumIntegerDigits decimalFormat))
    (when (> (.getMinimumIntegerDigits decimalFormat) (.getMaximumIntegerDigits decimalFormat))
      (.setMinimumIntegerDigits decimalFormat (.getMaximumIntegerDigits decimalFormat))
      (.setMinimumIntegerDigits super (.getMinimumIntegerDigits decimalFormat))))

  (method ^:public setMinimumIntegerDigits ^void [this ^int newValue]
    (.setMinimumIntegerDigits decimalFormat (Math/min newValue DecimalFormat/DOUBLE_INTEGER_DIGITS))
    (.setMinimumIntegerDigits super (.getMinimumIntegerDigits decimalFormat))
    (when (> (.getMinimumIntegerDigits decimalFormat) (.getMaximumIntegerDigits decimalFormat))
      (.setMaximumIntegerDigits decimalFormat (.getMinimumIntegerDigits decimalFormat))
      (.setMaximumIntegerDigits super (.getMaximumIntegerDigits decimalFormat))))

  (method ^:public setMinimumFractionDigits ^void [this ^int newValue]
    (.setMinimumFractionDigits decimalFormat
                               (Math/min newValue DecimalFormat/DOUBLE_FRACTION_DIGITS))
    (.setMinimumFractionDigits super (.getMinimumFractionDigits decimalFormat))
    (when (> (.getMinimumFractionDigits decimalFormat) (.getMaximumFractionDigits decimalFormat))
      (.setMaximumFractionDigits decimalFormat (.getMinimumFractionDigits decimalFormat))
      (.setMaximumFractionDigits super (.getMaximumFractionDigits decimalFormat))))

  (method ^:public setMaximumFractionDigits ^void [this ^int newValue]
    (.setMaximumFractionDigits decimalFormat
                               (Math/min newValue DecimalFormat/DOUBLE_FRACTION_DIGITS))
    (.setMaximumFractionDigits super (.getMaximumFractionDigits decimalFormat))
    (when (> (.getMinimumFractionDigits decimalFormat) (.getMaximumFractionDigits decimalFormat))
      (.setMinimumFractionDigits decimalFormat (.getMaximumFractionDigits decimalFormat))
      (.setMinimumFractionDigits super (.getMinimumFractionDigits decimalFormat))))

  (method ^:public getRoundingMode ^RoundingMode [this] roundingMode)

  (method ^:public setRoundingMode ^void [this ^RoundingMode roundingMode]
    (.setRoundingMode decimalFormat roundingMode)
    (set! (.-roundingMode this) roundingMode))

  (method ^:public getGroupingSize ^int [this] groupingSize)

  (method ^:public setGroupingSize ^void [this ^int newValue]
    (when (or (< newValue 0) (> newValue 127))
      (throw (IllegalArgumentException. "The value passed is negative or larger than 127")))
    (set! groupingSize (unchecked-byte newValue))
    (.setGroupingSize decimalFormat groupingSize))

  (method ^:public isGroupingUsed ^boolean [this] (.isGroupingUsed super))

  (method ^:public setGroupingUsed ^void [this ^boolean newValue]
    (.setGroupingUsed decimalFormat newValue)
    (.setGroupingUsed super newValue))

  (method ^:public isParseIntegerOnly ^boolean [this]
    (.isParseIntegerOnly super))

  (method ^:public setParseIntegerOnly ^void [this ^boolean value]
    (.setParseIntegerOnly decimalFormat value)
    (.setParseIntegerOnly super value))

  (method ^:public isStrict ^boolean [this] parseStrict)

  (method ^:public setStrict ^void [this ^boolean strict]
    (.setStrict decimalFormat strict)
    (set! parseStrict strict))

  (method ^:public isParseBigDecimal ^boolean [this] parseBigDecimal)

  (method ^:public setParseBigDecimal ^void [this ^boolean newValue]
    (set! parseBigDecimal newValue))

  (method ^:public equals ^boolean [this obj]
    (cond
      (identical? this obj) true
      (not (.equals super obj)) false
      :else
        (let [other (cast CompactNumberFormat obj)]
          (and (and (and (and (and (and (and (.equals decimalPattern (.-decimalPattern other))
                                             (.equals symbols (.-symbols other)))
                                        (Arrays/equals compactPatterns (.-compactPatterns other)))
                                   (.equals roundingMode (.-roundingMode other)))
                              (.equals pluralRules (.-pluralRules other)))
                         (== groupingSize (.-groupingSize other)))
                    (= parseBigDecimal (.-parseBigDecimal other)))
               (= parseStrict (.-parseStrict other))))))

  (method ^:public hashCode ^int [this]
    (unchecked-add-int
      (unchecked-add-int
        (unchecked-add-int
          (unchecked-add-int (unchecked-multiply-int 31 (.hashCode super))
                             (Objects/hash decimalPattern symbols roundingMode pluralRules))
          (Arrays/hashCode compactPatterns))
        groupingSize)
      (Boolean/hashCode parseBigDecimal)))

  (method ^:public toString ^String [this]
    (.formatted
      "CompactNumberFormat [locale: \"%s\", decimal pattern: \"%s\", compact patterns: \"%s\"]\n"
      (.getDisplayName (.getLocale symbols))
      decimalPattern
      (Arrays/toString compactPatterns)))

  (method ^:public clone ^CompactNumberFormat [this]
    (let [other (cast CompactNumberFormat (.clone super))]
      (set! (.-compactPatterns other) (.clone compactPatterns))
      (set! (.-symbols other) (cast DecimalFormatSymbols (.clone symbols)))
      (set! (.-decimalFormat other) (cast DecimalFormat (.clone decimalFormat)))
      (set! (.-defaultDecimalFormat other) (cast DecimalFormat (.clone defaultDecimalFormat)))
      (set! (.-digitList other) (cast DigitList (.clone digitList)))
      other))

  (defclass ^:private ^:final Patterns
    (field ^:private ^:final ^{:tag (Map String String)} patternsMap (HashMap.))

    (method put ^void [this ^String count ^String pattern]
      (.put patternsMap count pattern))

    (method get ^String [this ^double num]
      (cast String
            (.getOrDefault patternsMap
                           (.getPluralCategory CompactNumberFormat/this num)
                           (cast String (.getOrDefault patternsMap "other" "")))))

    (method expandAffix ^Patterns [this]
      (let [ret (Patterns.)]
        (.forEach patternsMap
                  (lambda BiConsumer ^void [^String key ^String value]
                    (.put ret key (.expandAffix CompactNumberFormat/this value))))
        ret)))

  (method ^:private getNumberValue ^double [this ^double number ^double divisor]
    (let [num (.divide (BigDecimal/valueOf number) (BigDecimal/valueOf divisor) roundingMode)]
      (if (> (.getMaximumFractionDigits this) 0) (.doubleValue num) (double (.intValue num)))))

  (method ^:private checkIncrement ^boolean [this ^double val ^int index ^double divisor]
    (when (and (< index (unchecked-subtract-int (alength compactPatterns) 1))
               (not (.equals "" (aget compactPatterns index))))
      (let [nextDiv (.doubleValue (cast Number (.get divisors (unchecked-add-int index 1))))]
        (when-not (== divisor nextDiv)
          (return (== (Math/log10 val)
                      (unchecked-subtract (Math/log10 nextDiv) (Math/log10 divisor)))))))
    false)

  (method ^:private getPluralCategory ^String [this ^double input]
    (if (some? rulesMap)
        (cast String
              (.orElse (.findFirst (.map
                                     (.filter (.stream (.entrySet rulesMap))
                                              (lambda Predicate ^boolean [^Map$Entry e]
                                                (CompactNumberFormat/matchPluralRule
                                                  (cast String (.getValue e))
                                                  input)))
                                     (method-ref Function ^String [Map$Entry] Map$Entry/.getKey)))
                       "other"))
        "other"))

  (method ^:private ^:static matchPluralRule ^boolean [^String condition ^double input]
    (.anyMatch (Arrays/stream (.split condition "or"))
               (lambda Predicate ^boolean [^String and_condition]
                 (.allMatch (Arrays/stream (.split and_condition "and"))
                            (lambda Predicate ^boolean [^String r]
                              (CompactNumberFormat/relationCheck r input))))))

  (field ^:private ^:static ^:final ^String NAMED_EXPR
    "(?<op>[niftvwe])\\s*((?<div>[/%])\\s*(?<val>\\d+))*")

  (field ^:private ^:static ^:final ^String NAMED_RELATION "(?<rel>!?=)")

  (field ^:private ^:static ^:final ^String NAMED_VALUE_RANGE
    "(?<start>\\d+)\\.\\.(?<end>\\d+)|(?<value>\\d+)")

  (field ^:private ^:static ^:final ^Pattern EXPR_PATTERN (Pattern/compile NAMED_EXPR))

  (field ^:private ^:static ^:final ^Pattern RELATION_PATTERN (Pattern/compile NAMED_RELATION))

  (field ^:private ^:static ^:final ^Pattern VALUE_RANGE_PATTERN
    (Pattern/compile NAMED_VALUE_RANGE))

  (method ^:private ^:static valOrRangeMatches ^boolean [^String valueOrRange ^double input]
    (let [m (.matcher VALUE_RANGE_PATTERN valueOrRange)]
      (if (.find m)
          (let [value (.group m "value")]
            (if (some? value)
                (== input (Double/parseDouble value))
                (and (>= input (Double/parseDouble (.group m "start")))
                     (<= input (Double/parseDouble (.group m "end"))))))
          false)))

  (method ^:private ^:static relationCheck ^boolean [^String relation ^double input]
    (let [expr (.matcher EXPR_PATTERN relation)]
      (when (.find expr)
        (let [lop (CompactNumberFormat/evalLOperand expr input)
              rel (.matcher RELATION_PATTERN relation)]
          (when (.find rel (.end expr))
            (let [conditions (Arrays/stream (.split (.substring relation (.end rel)) ","))]
              (if (Objects/equals (.group rel "rel") "!=")
                  (return (.noneMatch conditions
                                      (lambda Predicate ^boolean [^String c]
                                        (CompactNumberFormat/valOrRangeMatches c lop))))
                  (return (.anyMatch conditions
                                     (lambda Predicate ^boolean [^String c]
                                       (CompactNumberFormat/valOrRangeMatches c lop)))))))))
      false))

  (method ^:private ^:static evalLOperand ^double [^Matcher expr ^double input]
    (let [^:mutable ret 0.0]
      (if (== input Double/POSITIVE_INFINITY)
          (set! ret input)
          (let [op (.group expr "op")]
            (when (or (Objects/equals op "n") (Objects/equals op "i")) (set! ret input))
            (let [divop (.group expr "div")]
              (when (some? divop)
                (let [divisor (.group expr "val")]
                  (switch divop
                    "%" (set! ret (unchecked-remainder ret (Double/parseDouble divisor)))
                    "/" (set! ret (unchecked-divide ret (Double/parseDouble divisor)))))))))
      ret)))

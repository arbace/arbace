  (method ^:public parse ^Date [this ^String text ^ParsePosition pos]
    (.checkNegativeNumberExpression this)
    (let [^:mutable start (.-index pos)
          oldStart start
          textLength (.length text)
          ambiguousYear (new boolean/1 [false])
          calb (CalendarBuilder.)]
      (let [^:mutable ^int i 0]
        (while (< i (alength compiledPattern))
          (let [tag (unsigned-bit-shift-right-int (aget compiledPattern i) 8)
                ^:mutable count (bit-and-int (aget
                                               compiledPattern
                                               (let [old-2 i] (set! i (unchecked-inc-int i)) old-2))
                                             0xff)]
            (when (== count 255)
              (set! count (bit-shift-left-int (aget compiledPattern i) 16))
              (set! i (unchecked-inc-int i))
              (set! count (bit-or-int count (aget compiledPattern i)))
              (set! i (unchecked-inc-int i)))
            (switch tag
              TAG_QUOTE_ASCII_CHAR
                (do
                  (when (or (>= start textLength)
                            (not (.charEquals this (.charAt text start) (unchecked-char count))))
                    (set! (.-index pos) oldStart)
                    (set! (.-errorIndex pos) start)
                    (return nil))
                  (set! start (unchecked-inc-int start)))
              TAG_QUOTE_CHARS
                (while (> (let [old-3 count] (set! count (unchecked-dec-int count)) old-3) 0)
                  (when (or (>= start textLength)
                            (not (.charEquals
                                   this
                                   (.charAt text start)
                                   (aget compiledPattern
                                         (let [old-4 i] (set! i (unchecked-inc-int i)) old-4)))))
                    (set! (.-index pos) oldStart)
                    (set! (.-errorIndex pos) start)
                    (return nil))
                  (set! start (unchecked-inc-int start)))
              (let [^:mutable obeyCount false
                    ^:mutable useFollowingMinusSignAsDelimiter false]
                (when (< i (alength compiledPattern))
                  (let [nextTag (unsigned-bit-shift-right-int (aget compiledPattern i) 8)
                        ^:mutable nextCount (bit-and-int (aget compiledPattern i) 0xff)]
                    (set! obeyCount (.shouldObeyCount this nextTag nextCount))
                    (when (and hasFollowingMinusSign
                               (or (== nextTag TAG_QUOTE_ASCII_CHAR) (== nextTag TAG_QUOTE_CHARS)))
                      (when-not (== nextTag TAG_QUOTE_ASCII_CHAR)
                        (set! nextCount (aget compiledPattern (unchecked-add-int i 1))))
                      (when (== nextCount minusSign) (set! useFollowingMinusSignAsDelimiter true)))))
                (set! start
                      (.subParse this
                                 text
                                 start
                                 tag
                                 count
                                 obeyCount
                                 ambiguousYear
                                 pos
                                 useFollowingMinusSignAsDelimiter
                                 calb))
                (when (< start 0) (set! (.-index pos) oldStart) (return nil)))))))
      (set! (.-index pos) start)
      (let [^:mutable ^Date parsedDate nil]
        (try
          (set! parsedDate (.getTime (.establish calb (.-calendar this))))
          (when (aget ambiguousYear 0)
            (when (.before parsedDate defaultCenturyStart)
              (set! parsedDate (.getTime (.establish (.addYear calb 100) (.-calendar this))))))
          (catch IllegalArgumentException e
            (set! (.-errorIndex pos) start)
            (set! (.-index pos) oldStart)
            (return nil)))
        parsedDate)))

  (method ^:private charEquals ^boolean [this ^char ch1 ^char ch2]
    (or (== ch1 ch2)
        (and (and (.isLenient this) (== (Character/getType ch1) Character/SPACE_SEPARATOR))
             (== (Character/getType ch2) Character/SPACE_SEPARATOR))))

  (method ^:private shouldObeyCount ^boolean [this ^int tag ^int count]
    (switch tag
      (DateFormatSymbols/PATTERN_MONTH DateFormatSymbols/PATTERN_MONTH_STANDALONE) (<= count 2)
      (DateFormatSymbols/PATTERN_YEAR DateFormatSymbols/PATTERN_DAY_OF_MONTH
                                      DateFormatSymbols/PATTERN_HOUR_OF_DAY1
                                      DateFormatSymbols/PATTERN_HOUR_OF_DAY0
                                      DateFormatSymbols/PATTERN_MINUTE
                                      DateFormatSymbols/PATTERN_SECOND
                                      DateFormatSymbols/PATTERN_MILLISECOND
                                      DateFormatSymbols/PATTERN_DAY_OF_YEAR
                                      DateFormatSymbols/PATTERN_DAY_OF_WEEK_IN_MONTH
                                      DateFormatSymbols/PATTERN_WEEK_OF_YEAR
                                      DateFormatSymbols/PATTERN_WEEK_OF_MONTH
                                      DateFormatSymbols/PATTERN_HOUR1
                                      DateFormatSymbols/PATTERN_HOUR0
                                      DateFormatSymbols/PATTERN_WEEK_YEAR
                                      DateFormatSymbols/PATTERN_ISO_DAY_OF_WEEK)
        true
      false))

  (method ^:private matchString ^int [this ^String text ^int start ^int field ^String/1 data
                                      ^CalendarBuilder calb]
    (let [^:mutable ^int i 0
          count (alength data)]
      (when (== field Calendar/DAY_OF_WEEK) (set! i 1))
      (let [^:mutable ^int bestMatchLength 0
            ^:mutable ^int bestMatch -1]
        (while (< i count)
          (let [length (.length (aget data i))]
            (when (and (> length bestMatchLength)
                       (.regionMatches text true start (aget data i) 0 length))
              (set! bestMatch i)
              (set! bestMatchLength length)))
          (set! i (unchecked-inc-int i)))
        (if (>= bestMatch 0)
            (do (.set calb field bestMatch) (unchecked-add-int start bestMatchLength))
            (unchecked-negate-int start)))))

  (method ^:private matchString ^int [this ^String text ^int start ^int field
                                      ^{:tag (Map String Integer)} data ^CalendarBuilder calb]
    (when (some? data)
      (when (instance? SortedMap data)
        (for-each [^String name (.keySet data)]
          (when (.regionMatches text true start name 0 (.length name))
            (.set calb field (.intValue (cast Integer (.get data name))))
            (return (unchecked-add-int start (.length name)))))
        (return (unchecked-negate-int start)))
      (let [^:mutable ^String bestMatch nil]
        (for-each [^String name (.keySet data)]
          (let [length (.length name)]
            (when (or (nil? bestMatch) (> length (.length bestMatch)))
              (when (.regionMatches text true start name 0 length) (set! bestMatch name)))))
        (when (some? bestMatch)
          (.set calb field (.intValue (cast Integer (.get data bestMatch))))
          (return (unchecked-add-int start (.length bestMatch))))))
    (unchecked-negate-int start))

  (method ^:private matchZoneString ^int [this ^String text ^int start ^String/1 zoneNames]
    (loop [^int i 1]
      (when (<= i 4)
        (let [^:mutable zoneName (aget zoneNames i)]
          (when (.isEmpty zoneName)
            (set! zoneName
                  (TimeZoneNameUtility/retrieveDisplayName
                    (aget zoneNames 0)
                    (>= i 3)
                    (unchecked-remainder-int i 2)
                    locale))
            (aset zoneNames i zoneName))
          (if (.regionMatches text true start zoneName 0 (.length zoneName))
              (return i)
              (recur (unchecked-inc-int i))))))
    -1)

  (method ^:private matchDSTString ^boolean [this ^String text ^int start ^int zoneIndex
                                             ^int standardIndex ^String/2 zoneStrings]
    (let [index (unchecked-add-int standardIndex 2)
          zoneName (aget zoneStrings zoneIndex index)]
      (if (.regionMatches text true start zoneName 0 (.length zoneName)) true false)))

  (method ^:private subParseZoneString ^int [this ^String text ^int start ^CalendarBuilder calb]
    (let [^:mutable useSameName false
          currentTimeZone (.getTimeZone this)
          ^:mutable zoneIndex (.getZoneIndex formatData (.getID currentTimeZone))
          ^:mutable ^TimeZone tz nil
          zoneStrings (.getZoneStringsWrapper formatData)
          ^:mutable ^String/1 zoneNames nil
          ^:mutable ^int nameIndex 0]
      (when-not (== zoneIndex -1)
        (set! zoneNames (aget zoneStrings zoneIndex))
        (when (> (set! nameIndex (.matchZoneString this text start zoneNames)) 0)
          (when (<= nameIndex 2)
            (set! useSameName
                  (.equalsIgnoreCase (aget zoneNames nameIndex)
                                     (aget zoneNames (unchecked-add-int nameIndex 2)))))
          (set! tz (TimeZone/getTimeZone (aget zoneNames 0)))))
      (when (nil? tz)
        (set! zoneIndex (.getZoneIndex formatData (.getID (TimeZone/getDefault))))
        (when-not (== zoneIndex -1)
          (set! zoneNames (aget zoneStrings zoneIndex))
          (when (> (set! nameIndex (.matchZoneString this text start zoneNames)) 0)
            (when (<= nameIndex 2)
              (set! useSameName
                    (.equalsIgnoreCase (aget zoneNames nameIndex)
                                       (aget zoneNames (unchecked-add-int nameIndex 2)))))
            (set! tz (TimeZone/getTimeZone (aget zoneNames 0))))))
      (when (nil? tz)
        (let [len (alength zoneStrings)]
          (loop [^int i 0]
            (when (< i len)
              (set! zoneNames (aget zoneStrings i))
              (if (> (set! nameIndex (.matchZoneString this text start zoneNames)) 0)
                  (do
                    (when (<= nameIndex 2)
                      (set! useSameName
                            (.equalsIgnoreCase (aget zoneNames nameIndex)
                                               (aget zoneNames (unchecked-add-int nameIndex 2)))))
                    (set! tz (TimeZone/getTimeZone (aget zoneNames 0))))
                  (recur (unchecked-inc-int i)))))))
      (if (some? tz)
          (do
            (when-not (.equals tz currentTimeZone) (.setTimeZone this tz))
            (let [^int dstAmount (if (>= nameIndex 3) (.getDSTSavings tz) 0)]
              (when-not (or useSameName (and (>= nameIndex 3) (== dstAmount 0)))
                (.set (.clear calb Calendar/ZONE_OFFSET) Calendar/DST_OFFSET dstAmount))
              (unchecked-add-int start (.length (aget zoneNames nameIndex)))))
          (unchecked-negate-int start))))

  (method ^:private subParseNumericZone ^int [this ^String text ^int start ^int sign ^int count
                                              ^boolean colon ^CalendarBuilder calb]
    (let [^:mutable index start]
      (label :parse
        (try
          (let [^:mutable c (.charAt text
                                     (let [old-5 index]
                                       (set! index (unchecked-inc-int index))
                                       old-5))
                ^:mutable ^int hours 0]
            (when-not (not (.isDigit this c))
              (set! hours (unchecked-subtract-int c \0))
              (set! c (.charAt text index))
              (set! index (unchecked-inc-int index))
              (if (.isDigit this c)
                  (set! hours
                        (unchecked-add-int (unchecked-multiply-int hours 10)
                                           (unchecked-subtract-int c \0)))
                  (do
                    (when (or (> count 0) (not colon)) (break :parse))
                    (set! index (unchecked-dec-int index))))
              (when-not (> hours 23)
                (let [^:mutable ^int minutes 0]
                  (when-not (== count 1)
                    (set! c (.charAt text index))
                    (set! index (unchecked-inc-int index))
                    (when colon
                      (when-not (== c \:) (break :parse))
                      (set! c (.charAt text index))
                      (set! index (unchecked-inc-int index)))
                    (when-not (.isDigit this c) (break :parse))
                    (set! minutes (unchecked-subtract-int c \0))
                    (set! c (.charAt text index))
                    (set! index (unchecked-inc-int index))
                    (when-not (.isDigit this c) (break :parse))
                    (set! minutes
                          (unchecked-add-int (unchecked-multiply-int minutes 10)
                                             (unchecked-subtract-int c \0)))
                    (when (> minutes 59) (break :parse)))
                  (set! minutes (unchecked-add-int minutes (unchecked-multiply-int hours 60)))
                  (.set (.set calb
                              Calendar/ZONE_OFFSET
                              (unchecked-multiply-int
                                (unchecked-multiply-int minutes MILLIS_PER_MINUTE)
                                sign))
                        Calendar/DST_OFFSET
                        0)
                  (return index)))))
          (catch IndexOutOfBoundsException e)))
      (unchecked-subtract-int 1 index)))

  (method ^:private isDigit ^boolean [this ^char c]
    (and (>= c \0) (<= c \9)))

  (method ^:private subParse ^int [this ^String text ^int start ^:mutable ^int patternCharIndex
                                   ^int count ^boolean obeyCount ^boolean/1 ambiguousYear
                                   ^ParsePosition origPos ^boolean useFollowingMinusSignAsDelimiter
                                   ^CalendarBuilder calb]
    (let [^:mutable ^Number number nil
          ^:mutable ^int value 0
          pos (ParsePosition. 0)]
      (set! (.-index pos) start)
      (when (and (== patternCharIndex DateFormatSymbols/PATTERN_WEEK_YEAR)
                 (not (.isWeekDateSupported (.-calendar this))))
        (set! patternCharIndex DateFormatSymbols/PATTERN_YEAR))
      (let [field (aget PATTERN_INDEX_TO_CALENDAR_FIELD patternCharIndex)]
        (while true
          (when (>= (.-index pos) (.length text)) (set! (.-errorIndex origPos) start) (return -1))
          (let [c (.charAt text (.-index pos))]
            (when (and (not (== c \space)) (not (== c \tab))) (break))
            (set! (.-index pos) (unchecked-inc-int (.-index pos)))))
        (let [actualStart (.-index pos)]
          (label :parsing
            (when (or (or (or (or (or (== patternCharIndex DateFormatSymbols/PATTERN_HOUR_OF_DAY1)
                                      (== patternCharIndex DateFormatSymbols/PATTERN_HOUR1))
                                  (and (== patternCharIndex DateFormatSymbols/PATTERN_MONTH)
                                       (<= count 2)))
                              (and (== patternCharIndex DateFormatSymbols/PATTERN_MONTH_STANDALONE)
                                   (<= count 2)))
                          (== patternCharIndex DateFormatSymbols/PATTERN_YEAR))
                      (== patternCharIndex DateFormatSymbols/PATTERN_WEEK_YEAR))
              (if obeyCount
                  (do
                    (when (> (unchecked-add-int start count) (.length text)) (break :parsing))
                    (set! number
                          (.parse (.-numberFormat this)
                                  (.substring text 0 (unchecked-add-int start count))
                                  pos)))
                  (set! number (.parse (.-numberFormat this) text pos)))
              (if (nil? number)
                  (when (or (not (== patternCharIndex DateFormatSymbols/PATTERN_YEAR))
                            (instance? GregorianCalendar (.-calendar this)))
                    (break :parsing))
                  (do
                    (set! value (.intValue number))
                    (when (and (and useFollowingMinusSignAsDelimiter (< value 0))
                               (or (and (< (.-index pos) (.length text))
                                        (not (== (.charAt text (.-index pos)) minusSign)))
                                   (and (== (.-index pos) (.length text))
                                        (== (.charAt text (unchecked-subtract-int (.-index pos) 1))
                                            minusSign))))
                      (set! value (unchecked-negate-int value))
                      (set! (.-index pos) (unchecked-dec-int (.-index pos)))))))
            (let [useDateFormatSymbols (.useDateFormatSymbols this)
                  ^:mutable ^int index 0]
              (switch patternCharIndex
                DateFormatSymbols/PATTERN_ERA
                  (if useDateFormatSymbols
                      (when (> (set! index
                                     (.matchString
                                       this
                                       text
                                       start
                                       Calendar/ERA
                                       (.getEras formatData)
                                       calb))
                               0)
                        (return index))
                      (let [^{:tag (Map String Integer)} map (.getDisplayNamesMap this field locale)]
                        (when (> (set! index (.matchString this text start field map calb)) 0)
                          (return index))))
                (DateFormatSymbols/PATTERN_WEEK_YEAR DateFormatSymbols/PATTERN_YEAR)
                  (do
                    (when-not (instance? GregorianCalendar (.-calendar this))
                      (let [^int style (if (>= count 4) Calendar/LONG Calendar/SHORT)
                            ^{:tag (Map String Integer)} map (.getDisplayNames
                                                               (.-calendar this)
                                                               field
                                                               style
                                                               locale)]
                        (when (some? map)
                          (when (> (set! index (.matchString this text start field map calb)) 0)
                            (return index)))
                        (.set calb field value)
                        (return (.-index pos))))
                    (when (and (and (and (<= count 2)
                                         (== (unchecked-subtract-int (.-index pos) actualStart) 2))
                                    (Character/isDigit (.charAt text actualStart)))
                               (Character/isDigit (.charAt text (unchecked-add-int actualStart 1))))
                      (let [ambiguousTwoDigitYear (unchecked-remainder-int
                                                    defaultCenturyStartYear
                                                    100)]
                        (aset ambiguousYear 0 (== value ambiguousTwoDigitYear))
                        (set! value
                              (unchecked-add-int
                                value
                                (unchecked-add-int
                                  (unchecked-multiply-int
                                    (unchecked-divide-int defaultCenturyStartYear 100)
                                    100)
                                  (if (< value ambiguousTwoDigitYear) 100 0))))))
                    (.set calb field value)
                    (return (.-index pos)))
                DateFormatSymbols/PATTERN_MONTH
                  (do
                    (when (<= count 2)
                      (.set calb Calendar/MONTH (unchecked-subtract-int value 1))
                      (return (.-index pos)))
                    (if useDateFormatSymbols
                        (let [^:mutable ^int newStart 0]
                          (when (> (set! newStart
                                         (.matchString
                                           this
                                           text
                                           start
                                           Calendar/MONTH
                                           (.getMonths formatData)
                                           calb))
                                   0)
                            (return newStart))
                          (when (> (set! index
                                         (.matchString
                                           this
                                           text
                                           start
                                           Calendar/MONTH
                                           (.getShortMonths formatData)
                                           calb))
                                   0)
                            (return index)))
                        (let [^{:tag (Map String Integer)} map (.getDisplayContextNamesMap
                                                                 this
                                                                 field
                                                                 locale)]
                          (when (> (set! index (.matchString this text start field map calb)) 0)
                            (return index)))))
                DateFormatSymbols/PATTERN_MONTH_STANDALONE
                  (do
                    (when (<= count 2)
                      (.set calb Calendar/MONTH (unchecked-subtract-int value 1))
                      (return (.-index pos)))
                    (let [^{:tag (Map String Integer)} maps (.getDisplayNamesMap this field locale)]
                      (when (> (set! index (.matchString this text start field maps calb)) 0)
                        (return index))))
                DateFormatSymbols/PATTERN_HOUR_OF_DAY1
                  (do
                    (when-not (.isLenient this)
                      (when (or (< value 1) (> value 24)) (break :parsing)))
                    (when (== value
                              (unchecked-add-int
                                (.getMaximum (.-calendar this) Calendar/HOUR_OF_DAY)
                                1))
                      (set! value 0))
                    (.set calb Calendar/HOUR_OF_DAY value)
                    (return (.-index pos)))
                DateFormatSymbols/PATTERN_DAY_OF_WEEK
                  (if useDateFormatSymbols
                      (let [^:mutable ^int newStart 0]
                        (when (> (set! newStart
                                       (.matchString
                                         this
                                         text
                                         start
                                         Calendar/DAY_OF_WEEK
                                         (.getWeekdays formatData)
                                         calb))
                                 0)
                          (return newStart))
                        (when (> (set! index
                                       (.matchString
                                         this
                                         text
                                         start
                                         Calendar/DAY_OF_WEEK
                                         (.getShortWeekdays formatData)
                                         calb))
                                 0)
                          (return index)))
                      (let [styles (new int/1 [Calendar/LONG Calendar/SHORT])]
                        (for-each [^int style styles]
                          (let [^{:tag (Map String Integer)} map (.getDisplayNames
                                                                   (.-calendar this)
                                                                   field
                                                                   style
                                                                   locale)]
                            (when (> (set! index (.matchString this text start field map calb)) 0)
                              (return index))))))
                DateFormatSymbols/PATTERN_AM_PM
                  (if useDateFormatSymbols
                      (when (> (set! index
                                     (.matchString
                                       this
                                       text
                                       start
                                       Calendar/AM_PM
                                       (.getAmPmStrings formatData)
                                       calb))
                               0)
                        (return index))
                      (let [^{:tag (Map String Integer)} map (.getDisplayNamesMap this field locale)]
                        (when (> (set! index (.matchString this text start field map calb)) 0)
                          (return index))))
                DateFormatSymbols/PATTERN_HOUR1
                  (do
                    (when-not (.isLenient this)
                      (when (or (< value 1) (> value 12)) (break :parsing)))
                    (when (== value
                              (unchecked-add-int
                                (.getLeastMaximum (.-calendar this) Calendar/HOUR)
                                1))
                      (set! value 0))
                    (.set calb Calendar/HOUR value)
                    (return (.-index pos)))
                (DateFormatSymbols/PATTERN_ZONE_NAME DateFormatSymbols/PATTERN_ZONE_VALUE)
                  (let [^:mutable ^int sign 0]
                    (try
                      (let [^:mutable c (.charAt text (.-index pos))]
                        (cond (== c \+) (set! sign 1) (== c \-) (set! sign -1))
                        (if (== sign 0)
                            (if (and (and (or (== c \G) (== c \g))
                                          (>= (unchecked-subtract-int (.length text) start)
                                              (.length GMT)))
                                     (.regionMatches text true start GMT 0 (.length GMT)))
                                (do
                                  (set! (.-index pos) (unchecked-add-int start (.length GMT)))
                                  (when (> (unchecked-subtract-int (.length text) (.-index pos)) 0)
                                    (set! c (.charAt text (.-index pos)))
                                    (cond (== c \+) (set! sign 1) (== c \-) (set! sign -1)))
                                  (when (== sign 0)
                                    (.set (.set calb Calendar/ZONE_OFFSET 0) Calendar/DST_OFFSET 0)
                                    (return (.-index pos)))
                                  (let [i (.subParseNumericZone
                                            this
                                            text
                                            (set! (.-index pos) (unchecked-inc-int (.-index pos)))
                                            sign
                                            0
                                            true
                                            calb)]
                                    (when (> i 0) (return i))
                                    (set! (.-index pos) (unchecked-negate-int i))))
                                (let [i (.subParseZoneString this text (.-index pos) calb)]
                                  (when (> i 0) (return i))
                                  (set! (.-index pos) (unchecked-negate-int i))))
                            (let [i (.subParseNumericZone
                                      this
                                      text
                                      (set! (.-index pos) (unchecked-inc-int (.-index pos)))
                                      sign
                                      0
                                      false
                                      calb)]
                              (when (> i 0) (return i))
                              (set! (.-index pos) (unchecked-negate-int i)))))
                      (catch IndexOutOfBoundsException e)))
                DateFormatSymbols/PATTERN_ISO_ZONE
                  (do
                    (when (<= (unchecked-subtract-int (.length text) (.-index pos)) 0)
                      (break :parsing))
                    (let [^:mutable ^int sign 0
                          c (.charAt text (.-index pos))]
                      (when (== c \Z)
                        (.set (.set calb Calendar/ZONE_OFFSET 0) Calendar/DST_OFFSET 0)
                        (return (set! (.-index pos) (unchecked-inc-int (.-index pos)))))
                      (cond
                        (== c \+) (set! sign 1)
                        (== c \-) (set! sign -1)
                        :else
                          (do
                            (set! (.-index pos) (unchecked-inc-int (.-index pos)))
                            (break :parsing)))
                      (let [i (.subParseNumericZone
                                this
                                text
                                (set! (.-index pos) (unchecked-inc-int (.-index pos)))
                                sign
                                count
                                (== count 3)
                                calb)]
                        (when (> i 0) (return i))
                        (set! (.-index pos) (unchecked-negate-int i)))))
                (do
                  (if obeyCount
                      (do
                        (when (> (unchecked-add-int start count) (.length text)) (break :parsing))
                        (set! number
                              (.parse (.-numberFormat this)
                                      (.substring text 0 (unchecked-add-int start count))
                                      pos)))
                      (set! number (.parse (.-numberFormat this) text pos)))
                  (when (some? number)
                    (set! value (.intValue number))
                    (when (and (and useFollowingMinusSignAsDelimiter (< value 0))
                               (or (and (< (.-index pos) (.length text))
                                        (not (== (.charAt text (.-index pos)) minusSign)))
                                   (and (== (.-index pos) (.length text))
                                        (== (.charAt text (unchecked-subtract-int (.-index pos) 1))
                                            minusSign))))
                      (set! value (unchecked-negate-int value))
                      (set! (.-index pos) (unchecked-dec-int (.-index pos))))
                    (.set calb field value)
                    (return (.-index pos)))))))
          (set! (.-errorIndex origPos) (.-index pos))
          -1))))

  (method ^:private useDateFormatSymbols ^boolean [this]
    (or useDateFormatSymbols (nil? locale)))

  (method ^:private translatePattern ^String [this ^String pattern ^String from ^String to]
    (let [result (StringBuilder.)
          ^:mutable inQuote false]
      (loop [^int i 0]
        (when (< i (.length pattern))
          (let [^:mutable c (.charAt pattern i)]
            (cond
              inQuote (when (== c \') (set! inQuote false))
              (== c \') (set! inQuote true)
              (or (and (>= c \a) (<= c \z)) (and (>= c \A) (<= c \Z)))
                (let [ci (.indexOf from c)]
                  (if (>= ci 0)
                      (when (< ci (.length to)) (set! c (.charAt to ci)))
                      (throw (IllegalArgumentException.
                               (java-str "Illegal pattern  character '" c "'"))))))
            (.append result c)
            (recur (unchecked-inc-int i)))))
      (when inQuote (throw (IllegalArgumentException. "Unfinished quote in pattern")))
      (.toString result)))

  (method ^:public toPattern ^String [this] pattern)

  (method ^:public toLocalizedPattern ^String [this]
    (.translatePattern this
                       pattern
                       DateFormatSymbols/patternChars
                       (.getLocalPatternChars formatData)))

  (method ^:public applyPattern ^void [this ^String pattern]
    (.applyPatternImpl this pattern))

  (method ^:private applyPatternImpl ^void [this ^String pattern]
    (set! compiledPattern (.compile this pattern))
    (set! (.-pattern this) pattern))

  (method ^:public applyLocalizedPattern ^void [this ^String pattern]
    (let [p (.translatePattern this
                               pattern
                               (.getLocalPatternChars formatData)
                               DateFormatSymbols/patternChars)]
      (set! compiledPattern (.compile this p))
      (set! (.-pattern this) p)))

  (method ^:public getDateFormatSymbols ^DateFormatSymbols [this]
    (cast DateFormatSymbols (.clone formatData)))

  (method ^:public setDateFormatSymbols ^void [this ^DateFormatSymbols newFormatSymbols]
    (set! (.-formatData this) (cast DateFormatSymbols (.clone newFormatSymbols)))
    (set! useDateFormatSymbols true))

  (method ^:public clone [this]
    (let [other (cast SimpleDateFormat (.clone super))]
      (set! (.-formatData other) (cast DateFormatSymbols (.clone formatData)))
      other))

  (method ^:public hashCode ^int [this] (.hashCode pattern))

  (method ^:public toString ^String [this]
    (.formatted "SimpleDateFormat [locale: %s, pattern: \"%s\"]\n"
                (when (some? locale) ^Object (java-str \" (.getDisplayName locale) \"))
                (.toPattern this)))

  (method ^:public equals ^boolean [this obj]
    (if (not (.equals super obj))
        false
        (let [that (cast SimpleDateFormat obj)]
          (and (.equals pattern (.-pattern that)) (.equals formatData (.-formatData that))))))

  (field ^:private ^:static ^:final ^int/1 REST_OF_STYLES
    (new int/1 [Calendar/SHORT_STANDALONE Calendar/LONG_FORMAT Calendar/LONG_STANDALONE]))

  (method ^:private getDisplayNamesMap ^{:tag (Map String Integer)} [this ^int field ^Locale locale]
    (let [^{:tag (Map String Integer)} map (.getDisplayNames
                                             (.-calendar this)
                                             field
                                             Calendar/SHORT_FORMAT
                                             locale)]
      (for-each [^int style REST_OF_STYLES]
        (let [^{:tag (Map String Integer)} m (.getDisplayNames (.-calendar this) field style locale)]
          (when (some? m) (.putAll map m))))
      map))

  (method ^:private getDisplayContextNamesMap ^{:tag (Map String Integer)} [this ^int field
                                                                            ^Locale locale]
    (let [^{:tag (Map String Integer)} map (.getDisplayNames
                                             (.-calendar this)
                                             field
                                             (if forceStandaloneForm
                                                 Calendar/SHORT_STANDALONE
                                                 Calendar/SHORT_FORMAT)
                                             locale)
          ^{:tag (Map String Integer)} m (.getDisplayNames
                                           (.-calendar this)
                                           field
                                           (if forceStandaloneForm
                                               Calendar/LONG_STANDALONE
                                               Calendar/LONG_FORMAT)
                                           locale)]
      (when (some? m) (.putAll map m))
      map))

  (method ^:private readObject :throws [IOException ClassNotFoundException] ^void [this
                                                                                   ^ObjectInputStream stream]
    (.defaultReadObject stream)
    (try
      (set! compiledPattern (.compile this pattern))
      (catch Exception e (throw (InvalidObjectException. "invalid pattern"))))
    (if (< serialVersionOnStream 1)
        (.initializeDefaultCentury this)
        (.parseAmbiguousDatesAsAfter this defaultCenturyStart))
    (set! serialVersionOnStream currentSerialVersion)
    (let [tz (.getTimeZone this)]
      (when (instance? SimpleTimeZone tz)
        (let [id (.getID tz)
              zi (TimeZone/getTimeZone id)]
          (when (and (and (some? zi) (.hasSameRules zi tz)) (.equals (.getID zi) id))
            (.setTimeZone this zi))))))

  (method ^:private checkNegativeNumberExpression ^void [this]
    (when (and (instance? DecimalFormat (.-numberFormat this))
               (not (.equals (.-numberFormat this) originalNumberFormat)))
      (let [numberPattern (.toPattern (cast DecimalFormat (.-numberFormat this)))]
        (when-not (.equals numberPattern originalNumberPattern)
          (set! hasFollowingMinusSign false)
          (let [separatorIndex (.indexOf numberPattern \;)]
            (when (> separatorIndex -1)
              (let [minusIndex (.indexOf numberPattern \- separatorIndex)]
                (when (and (> minusIndex (.lastIndexOf numberPattern \0))
                           (> minusIndex (.lastIndexOf numberPattern \#)))
                  (set! hasFollowingMinusSign true)
                  (set! minusSign
                        (.getMinusSign
                          (.getDecimalFormatSymbols (cast DecimalFormat (.-numberFormat this))))))))
            (set! originalNumberPattern numberPattern)))
        (set! originalNumberFormat (.-numberFormat this))))))

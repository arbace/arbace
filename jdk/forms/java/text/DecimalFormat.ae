                      (set! string (.getPercentText symbols))
                      (set! fieldID NumberFormat$Field/PERCENT))
                  PATTERN_PER_MILLE
                    (do
                      (set! string (.getPerMillText symbols))
                      (set! fieldID NumberFormat$Field/PERMILLE))

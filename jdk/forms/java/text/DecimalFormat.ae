                         container
                         (.-charsPositivePrefix fastPathData)
                         (.-charsPositiveSuffix fastPathData))))))

  (method fastFormat ^String [this ^:mutable ^double d]
    (let [^:mutable isDataSet false]
      (when fastPathCheckNeeded (set! isDataSet (.checkAndSetFastPathStatus this)))
      (when-not (not isFastPath)
        (when-not (not (Double/isFinite d))
          (let [^:mutable negative false]
            (if (< d 0.0)
                (do (set! negative true) (set! d (unchecked-negate d)))
                (when (== d 0.0)
                  (set! negative (== (Math/copySign 1.0 d) (unchecked-negate 1.0)))
                  (set! d 0.0)))
            (when-not (> d MAX_INT_AS_DOUBLE)
              (when-not isDataSet (.resetFastPathData this isFastPath))
              (.fastDoubleFormat this d negative)
              (String. (.-fastPathContainer fastPathData)
                       (.-firstUsedIndex fastPathData)
                       (unchecked-subtract-int (.-lastFreeIndex fastPathData)
                                               (.-firstUsedIndex fastPathData)))))))))

  (method setDigitList ^void [this ^Number number ^boolean isNegative ^int maxDigits]
    (switch number
      [^Double d] (.set digitList isNegative d maxDigits true)
      [^BigDecimal bd] (.set digitList isNegative bd maxDigits true)
      [^Long l] (.set digitList isNegative l maxDigits)
      [^BigInteger bi] (.set digitList isNegative bi maxDigits)
      (throw (AssertionError.
               (String/format "DigitList does not support %s"
                              (new Object/1 [(.getName (.getClass number))]))))))

  (method getDigitList ^DigitList [this] digitList)

  (method ^:private subformat ^Format$StringBuf [this ^Format$StringBuf result
                                                 ^Format$FieldDelegate delegate ^boolean isNegative
                                                 ^boolean isInteger ^int maxIntDigits
                                                 ^int minIntDigits ^int maxFraDigits
                                                 ^int minFraDigits]
    (if isNegative
        (.append this
                 result
                 negativePrefix
                 delegate
                 (.getNegativePrefixFieldPositions this)
                 NumberFormat$Field/SIGN)
        (.append this
                 result
                 positivePrefix
                 delegate
                 (.getPositivePrefixFieldPositions this)
                 NumberFormat$Field/SIGN))
    (.subformatNumber this
                      result
                      delegate
                      isNegative
                      isInteger
                      maxIntDigits
                      minIntDigits
                      maxFraDigits
                      minFraDigits)
    (if isNegative
        (.append this
                 result
                 negativeSuffix
                 delegate
                 (.getNegativeSuffixFieldPositions this)
                 NumberFormat$Field/SIGN)
        (.append this
                 result
                 positiveSuffix
                 delegate
                 (.getPositiveSuffixFieldPositions this)
                 NumberFormat$Field/SIGN))
    result)

  (method subformatNumber ^void [this ^Format$StringBuf result ^Format$FieldDelegate delegate
                                 ^boolean isNegative ^boolean isInteger ^int maxIntDigits
                                 ^int minIntDigits ^int maxFraDigits ^int minFraDigits]
    (let [^char grouping (if isCurrencyFormat
                             (.getMonetaryGroupingSeparator symbols)
                             (.getGroupingSeparator symbols))
          zero (.getZeroDigit symbols)
          zeroDelta (unchecked-subtract-int zero \0)
          ^char decimal (if isCurrencyFormat
                            (.getMonetaryDecimalSeparator symbols)
                            (.getDecimalSeparator symbols))]
      (when (.isZero digitList) (set! (.-decimalAt digitList) 0))
      (if useExponentialNotation
          (let [iFieldStart (.length result)
                ^:mutable ^int iFieldEnd -1
                ^:mutable ^int fFieldStart -1
                ^:mutable exponent (.-decimalAt digitList)
                repeat maxIntDigits
                ^:mutable minimumIntegerDigits minIntDigits]
            (if (and (> repeat 1) (> repeat minIntDigits))
                (do
                  (if (>= exponent 1)
                      (set! exponent
                            (unchecked-multiply-int
                              (unchecked-divide-int (unchecked-subtract-int exponent 1) repeat)
                              repeat))
                      (set! exponent
                            (unchecked-multiply-int
                              (unchecked-divide-int (unchecked-subtract-int exponent repeat) repeat)
                              repeat)))
                  (set! minimumIntegerDigits 1))
                (set! exponent (unchecked-subtract-int exponent minimumIntegerDigits)))
            (let [^:mutable minimumDigits (unchecked-add-int minIntDigits minFraDigits)]
              (when (< minimumDigits 0) (set! minimumDigits Integer/MAX_VALUE))
              (let [^int integerDigits (if (.isZero digitList)
                                           minimumIntegerDigits
                                           (unchecked-subtract-int (.-decimalAt digitList) exponent))]
                (when (< minimumDigits integerDigits) (set! minimumDigits integerDigits))
                (let [^:mutable totalDigits (.-count digitList)]
                  (when (> minimumDigits totalDigits) (set! totalDigits minimumDigits))
                  (let [^:mutable addedDecimalSeparator false]
                    (loop [^int i 0]
                      (when (< i totalDigits)
                        (when (== i integerDigits)
                          (set! iFieldEnd (.length result))
                          (.append result decimal)
                          (set! addedDecimalSeparator true)
                          (set! fFieldStart (.length result)))
                        (.append result
                                 (if (< i (.-count digitList))
                                     (unchecked-char
                                       (unchecked-add-int (aget (.-digits digitList) i) zeroDelta))
                                     zero))
                        (recur (unchecked-inc-int i))))
                    (when (and decimalSeparatorAlwaysShown (== totalDigits integerDigits))
                      (set! iFieldEnd (.length result))
                      (.append result decimal)
                      (set! addedDecimalSeparator true)
                      (set! fFieldStart (.length result)))
                    (when (== iFieldEnd -1) (set! iFieldEnd (.length result)))
                    (.formatted delegate
                                DecimalFormat/INTEGER_FIELD
                                NumberFormat$Field/INTEGER
                                NumberFormat$Field/INTEGER
                                iFieldStart
                                iFieldEnd
                                result)
                    (when addedDecimalSeparator
                      (.formatted delegate
                                  NumberFormat$Field/DECIMAL_SEPARATOR
                                  NumberFormat$Field/DECIMAL_SEPARATOR
                                  iFieldEnd
                                  fFieldStart
                                  result))
                    (when (== fFieldStart -1) (set! fFieldStart (.length result)))
                    (.formatted delegate
                                DecimalFormat/FRACTION_FIELD
                                NumberFormat$Field/FRACTION
                                NumberFormat$Field/FRACTION
                                fFieldStart
                                (.length result)
                                result)
                    (let [^:mutable fieldStart (.length result)]
                      (.append result (.getExponentSeparator symbols))
                      (.formatted delegate
                                  NumberFormat$Field/EXPONENT_SYMBOL
                                  NumberFormat$Field/EXPONENT_SYMBOL
                                  fieldStart
                                  (.length result)
                                  result)
                      (when (.isZero digitList) (set! exponent 0))
                      (let [negativeExponent (< exponent 0)]
                        (when negativeExponent
                          (set! exponent (unchecked-negate-int exponent))
                          (set! fieldStart (.length result))
                          (.append result (.getMinusSignText symbols))
                          (.formatted delegate
                                      NumberFormat$Field/EXPONENT_SIGN
                                      NumberFormat$Field/EXPONENT_SIGN
                                      fieldStart
                                      (.length result)
                                      result))
                        (.set digitList negativeExponent exponent)
                        (let [eFieldStart (.length result)]
                          (loop [^int i (.-decimalAt digitList)]
                            (when (< i minExponentDigits)
                              (.append result zero)
                              (recur (unchecked-inc-int i))))
                          (loop [^int i 0]
                            (when (< i (.-decimalAt digitList))
                              (.append result
                                       (if (< i (.-count digitList))
                                           (unchecked-char
                                             (unchecked-add-int
                                               (aget (.-digits digitList) i)
                                               zeroDelta))
                                           zero))
                              (recur (unchecked-inc-int i))))
                          (.formatted delegate
                                      NumberFormat$Field/EXPONENT
                                      NumberFormat$Field/EXPONENT
                                      eFieldStart
                                      (.length result)
                                      result)))))))))
          (let [iFieldStart (.length result)
                ^:mutable count minIntDigits
                ^:mutable ^int digitIndex 0]
            (when (and (> (.-decimalAt digitList) 0) (< count (.-decimalAt digitList)))
              (set! count (.-decimalAt digitList)))
            (when (> count maxIntDigits)
              (set! count maxIntDigits)
              (set! digitIndex (unchecked-subtract-int (.-decimalAt digitList) count)))
            (let [sizeBeforeIntegerPart (.length result)]
              (loop [^int i (unchecked-subtract-int count 1)]
                (when (>= i 0)
                  (if (and (< i (.-decimalAt digitList)) (< digitIndex (.-count digitList)))
                      (do
                        (.append result
                                 (unchecked-char
                                   (unchecked-add-int
                                     (aget (.-digits digitList) digitIndex)
                                     zeroDelta)))
                        (set! digitIndex (unchecked-inc-int digitIndex)))
                      (.append result zero))
                  (if (and (and (and (.isGroupingUsed this) (> i 0)) (not (== groupingSize 0)))
                           (== (unchecked-remainder-int i groupingSize) 0))
                      (let [gStart (.length result)]
                        (.append result grouping)
                        (.formatted delegate
                                    NumberFormat$Field/GROUPING_SEPARATOR
                                    NumberFormat$Field/GROUPING_SEPARATOR
                                    gStart
                                    (.length result)
                                    result)
                        (recur (unchecked-dec-int i)))
                      (recur (unchecked-dec-int i)))))
              (let [fractionPresent (or (> minFraDigits 0)
                                        (and (not isInteger) (< digitIndex (.-count digitList))))]
                (when (and (not fractionPresent) (== (.length result) sizeBeforeIntegerPart))
                  (.append result zero))
                (.formatted delegate
                            DecimalFormat/INTEGER_FIELD
                            NumberFormat$Field/INTEGER
                            NumberFormat$Field/INTEGER
                            iFieldStart
                            (.length result)
                            result)
                (let [sStart (.length result)]
                  (when (or decimalSeparatorAlwaysShown fractionPresent) (.append result decimal))
                  (when-not (== sStart (.length result))
                    (.formatted delegate
                                NumberFormat$Field/DECIMAL_SEPARATOR
                                NumberFormat$Field/DECIMAL_SEPARATOR
                                sStart
                                (.length result)
                                result))
                  (let [fFieldStart (.length result)]
                    (loop [^int i 0]
                      (when (< i maxFraDigits)
                        (when-not (and (>= i minFraDigits)
                                       (or isInteger (>= digitIndex (.-count digitList))))
                          (cond
                            (> (unchecked-subtract-int -1 i)
                               (unchecked-subtract-int (.-decimalAt digitList) 1))
                              (do (.append result zero) (recur (unchecked-inc-int i)))
                            (and (not isInteger) (< digitIndex (.-count digitList)))
                              (do
                                (.append result
                                         (unchecked-char
                                           (unchecked-add-int
                                             (aget (.-digits digitList) digitIndex)
                                             zeroDelta)))
                                (set! digitIndex (unchecked-inc-int digitIndex))
                                (recur (unchecked-inc-int i)))
                            :else (do (.append result zero) (recur (unchecked-inc-int i)))))))
                    (.formatted delegate
                                DecimalFormat/FRACTION_FIELD
                                NumberFormat$Field/FRACTION
                                NumberFormat$Field/FRACTION
                                fFieldStart
                                (.length result)
                                result)))))))))

  (method ^:private append ^void [this ^Format$StringBuf result ^String string
                                  ^Format$FieldDelegate delegate ^FieldPosition/1 positions
                                  ^Format$Field signAttribute]
    (let [start (.length result)]
      (when-not (.isEmpty string)
        (.append result string)
        (loop [^int counter 0
               ^int max (alength positions)]
          (when (< counter max)
            (let [fp (aget positions counter)
                  ^:mutable attribute (.getFieldAttribute fp)]
              (when (identical? attribute NumberFormat$Field/SIGN) (set! attribute signAttribute))
              (.formatted delegate
                          attribute
                          attribute
                          (unchecked-add-int start (.getBeginIndex fp))
                          (unchecked-add-int start (.getEndIndex fp))
                          result)
              (recur (unchecked-inc-int counter) max)))))))

  (method ^:public parse ^Number [this ^String text ^ParsePosition pos]
    (if (.regionMatches text (.-index pos) (.getNaN symbols) 0 (.length (.getNaN symbols)))
        (do
          (set! (.-index pos) (unchecked-add-int (.-index pos) (.length (.getNaN symbols))))
          (Double/valueOf Double/NaN))
        (let [status (new boolean/1 STATUS_LENGTH)]
          (when-not (not (.subparse this
                                    text
                                    pos
                                    positivePrefix
                                    negativePrefix
                                    digitList
                                    false
                                    status))
            (cond
              (aget status STATUS_INFINITE)
                (if (= (aget status STATUS_POSITIVE) (>= multiplier 0))
                    (Double/valueOf Double/POSITIVE_INFINITY)
                    (Double/valueOf Double/NEGATIVE_INFINITY))
              (== multiplier 0)
                (cond
                  (.isZero digitList) (Double/valueOf Double/NaN)
                  (aget status STATUS_POSITIVE) (Double/valueOf Double/POSITIVE_INFINITY)
                  :else (Double/valueOf Double/NEGATIVE_INFINITY))
              (.isParseBigDecimal this)
                (let [^:mutable bigDecimalResult (.getBigDecimal digitList)]
                  (when-not (== multiplier 1)
                    (try
                      (set! bigDecimalResult
                            (.divide bigDecimalResult (.getBigDecimalMultiplier this)))
                      (catch ArithmeticException e
                        (set! bigDecimalResult
                              (.divide bigDecimalResult
                                       (.getBigDecimalMultiplier this)
                                       roundingMode)))))
                  (when-not (aget status STATUS_POSITIVE)
                    (set! bigDecimalResult (.negate bigDecimalResult)))
                  bigDecimalResult)
              :else
                (let [^:mutable gotDouble true
                      ^:mutable gotLongMinimum false
                      ^:mutable doubleResult 0.0
                      ^:mutable longResult 0]
                  (if (.fitsIntoLong digitList
                                     (aget status STATUS_POSITIVE)
                                     (.isParseIntegerOnly this))
                      (do
                        (set! gotDouble false)
                        (set! longResult (.getLong digitList))
                        (when (< longResult 0) (set! gotLongMinimum true)))
                      (set! doubleResult (.getDouble digitList)))
                  (when-not (== multiplier 1)
                    (cond
                      gotDouble (set! doubleResult (unchecked-divide doubleResult multiplier))
                      (== (unchecked-remainder longResult multiplier) 0)
                        (set! longResult (unchecked-divide longResult multiplier))
                      :else
                        (do
                          (set! doubleResult (unchecked-divide (double longResult) multiplier))
                          (set! gotDouble true))))
                  (when (and (not (aget status STATUS_POSITIVE)) (not gotLongMinimum))
                    (set! doubleResult (unchecked-negate doubleResult))
                    (set! longResult (unchecked-negate longResult)))
                  (when (and (not (== multiplier 1)) gotDouble)
                    (set! longResult (unchecked-long doubleResult))
                    (set! gotDouble
                          (and (or (or (or (>= doubleResult Long/MAX_VALUE)
                                           (<= doubleResult Long/MIN_VALUE))
                                       (not (== doubleResult (double longResult))))
                                   (and (== doubleResult 0.0)
                                        (< (unchecked-divide 1.0 doubleResult) 0.0)))
                               (not (.isParseIntegerOnly this)))))
                  (if gotDouble
                      ^Number (Double/valueOf doubleResult)
                      ^Number (Long/valueOf longResult))))))))

  (method ^:private getBigIntegerMultiplier ^BigInteger [this]
    (when (nil? bigIntegerMultiplier) (set! bigIntegerMultiplier (BigInteger/valueOf multiplier)))
    bigIntegerMultiplier)

  (field ^:private ^:transient ^BigInteger bigIntegerMultiplier)

  (method ^:private getBigDecimalMultiplier ^BigDecimal [this]
    (when (nil? bigDecimalMultiplier) (set! bigDecimalMultiplier (BigDecimal. multiplier)))
    bigDecimalMultiplier)

  (field ^:private ^:transient ^BigDecimal bigDecimalMultiplier)

  (field ^:private ^:static ^:final ^int STATUS_INFINITE 0)

  (field ^:private ^:static ^:final ^int STATUS_POSITIVE 1)

  (field ^:private ^:static ^:final ^int STATUS_LENGTH 2)

  (method ^:private ^:final subparse ^boolean [this ^String text ^ParsePosition parsePosition
                                               ^String positivePrefix ^String negativePrefix
                                               ^DigitList digits ^boolean isExponent
                                               ^boolean/1 status]
    (let [^:mutable position (.-index parsePosition)
          oldStart (.-index parsePosition)
          ^:mutable ^boolean gotPositive false
          ^:mutable ^boolean gotNegative false]
      (set! gotPositive (.matchAffix this text position positivePrefix))
      (set! gotNegative (.matchAffix this text position negativePrefix))
      (when (and gotPositive gotNegative)
        (cond
          (> (.length positivePrefix) (.length negativePrefix)) (set! gotNegative false)
          (< (.length positivePrefix) (.length negativePrefix)) (set! gotPositive false)))
      (cond
        gotPositive (set! position (unchecked-add-int position (.length positivePrefix)))
        gotNegative (set! position (unchecked-add-int position (.length negativePrefix)))
        :else (do (set! (.-errorIndex parsePosition) position) (return false)))
      (let [pos (.subparseNumber this text position digits true isExponent status)]
        (set! position (.-fullPos pos))
        (if (== position -1)
            (do
              (set! (.-index parsePosition) oldStart)
              (set! (.-errorIndex parsePosition) oldStart)
              false)
            (do
              (if (not isExponent)
                  (do
                    (when gotPositive
                      (let [containsPosSuffix (.matchAffix this text position positiveSuffix)
                            endsWithPosSuffix (and
                                                containsPosSuffix
                                                (==
                                                  (.length text)
                                                  (unchecked-add-int
                                                    position
                                                    (.length positiveSuffix))))]
                        (set! gotPositive (if parseStrict endsWithPosSuffix containsPosSuffix))))
                    (when gotNegative
                      (let [containsNegSuffix (.matchAffix this text position negativeSuffix)
                            endsWithNegSuffix (and
                                                containsNegSuffix
                                                (==
                                                  (.length text)
                                                  (unchecked-add-int
                                                    position
                                                    (.length negativeSuffix))))]
                        (set! gotNegative (if parseStrict endsWithNegSuffix containsNegSuffix))))
                    (when (and gotPositive gotNegative)
                      (cond
                        (> (.length positiveSuffix) (.length negativeSuffix))
                          (set! gotNegative false)
                        (< (.length positiveSuffix) (.length negativeSuffix))
                          (set! gotPositive false)))
                    (when (= gotPositive gotNegative)
                      (set! (.-errorIndex parsePosition) position)
                      (return false))
                    (if (and (.isParseIntegerOnly this) (not (== (.-intPos pos) -1)))
                        (set! (.-index parsePosition) (.-intPos pos))
                        (set! (.-index parsePosition)
                              (unchecked-add-int
                                position
                                (if gotPositive (.length positiveSuffix) (.length negativeSuffix))))))
                  (set! (.-index parsePosition) position))
              (aset status STATUS_POSITIVE gotPositive)
              (if (== (.-index parsePosition) oldStart)
                  (do (set! (.-errorIndex parsePosition) position) false)
                  true))))))

  (defclass ^:record NumericPosition [^int fullPos ^int intPos])

  (method subparseNumber ^NumericPosition [this ^String text ^:mutable ^int position
                                           ^DigitList digits ^boolean checkExponent
                                           ^boolean isExponent ^boolean/1 status]
    (aset status STATUS_INFINITE false)
    (let [^:mutable ^int intIndex -1]
      (if (and (not isExponent)
               (.regionMatches text
                               position
                               (.getInfinity symbols)
                               0
                               (.length (.getInfinity symbols))))
          (do
            (set! position (unchecked-add-int position (.length (.getInfinity symbols))))
            (aset status STATUS_INFINITE true))
          (do
            (set! (.-decimalAt digits) (set! (.-count digits) 0))
            (let [zero (.getZeroDigit symbols)
                  ^char decimal (if isCurrencyFormat
                                    (.getMonetaryDecimalSeparator symbols)
                                    (.getDecimalSeparator symbols))
                  ^char grouping (if isCurrencyFormat
                                     (.getMonetaryGroupingSeparator symbols)
                                     (.getGroupingSeparator symbols))
                  exponentString (.getExponentSeparator symbols)
                  ^:mutable sawDecimal false
                  ^:mutable sawDigit false
                  ^:mutable exponent 0
                  expStat (new boolean/1 STATUS_LENGTH)
                  ^:mutable ^int digitCount 0
                  ^:mutable prevSeparatorIndex (unchecked-negate-int groupingSize)
                  startPos position
                  ^:mutable ^int backup -1]
              (while (< position (.length text))
                (let [ch (.charAt text position)
                      ^:mutable digit (unchecked-subtract-int ch zero)]
                  (when (or (< digit 0) (> digit 9)) (set! digit (Character/digit ch 10)))
                  (when (and (and (and (and (and
                                              (and parseStrict (.isGroupingUsed this))
                                              (==
                                                position
                                                (unchecked-add-int startPos groupingSize)))
                                            (== prevSeparatorIndex
                                                (unchecked-negate-int groupingSize)))
                                       (not sawDecimal))
                                  (>= digit 0))
                             (<= digit 9))
                    (return (NumericPosition. position intIndex)))
                  (cond
                    (== digit 0)
                      (do
                        (set! backup -1)
                        (set! sawDigit true)
                        (if (== (.-count digits) 0)
                            (when-not (not sawDecimal)
                              (set! (.-decimalAt digits) (unchecked-dec-int (.-decimalAt digits))))
                            (do
                              (set! digitCount (unchecked-inc-int digitCount))
                              (when (or (not sawDecimal) (not (.isParseIntegerOnly this)))
                                (.append digits (unchecked-char (unchecked-add-int digit \0)))))))
                    (and (> digit 0) (<= digit 9))
                      (do
                        (set! sawDigit true)
                        (set! digitCount (unchecked-inc-int digitCount))
                        (when (or (not sawDecimal) (not (.isParseIntegerOnly this)))
                          (.append digits (unchecked-char (unchecked-add-int digit \0))))
                        (set! backup -1))
                    (and (not isExponent) (== ch decimal))
                      (do
                        (when (and (.isParseIntegerOnly this) (== startPos position))
                          (return (NumericPosition. -1 intIndex)))
                        (when (and parseStrict
                                   (.isGroupingViolation this position prevSeparatorIndex))
                          (return (NumericPosition.
                                    (.groupingViolationIndex this position prevSeparatorIndex)
                                    intIndex)))
                        (when sawDecimal (break))
                        (set! intIndex position)
                        (set! (.-decimalAt digits) digitCount)
                        (set! sawDecimal true))
                    (and (and (not isExponent) (== ch grouping)) (.isGroupingUsed this))
                      (do
                        (cond
                          parseStrict
                            (do
                              (when (== position startPos)
                                (return (NumericPosition. startPos intIndex)))
                              (when (or sawDecimal
                                        (.isGroupingViolation this position prevSeparatorIndex))
                                (return (NumericPosition.
                                          (.groupingViolationIndex this position prevSeparatorIndex)
                                          intIndex)))
                              (set! prevSeparatorIndex position))
                          sawDecimal (break))
                        (set! backup position))
                    (and (and checkExponent (not isExponent))
                         (.regionMatches text position exponentString 0 (.length exponentString)))
                      (let [pos (ParsePosition.
                                  (unchecked-add-int position (.length exponentString)))
                            exponentDigits (DigitList.)]
                        (when (.subparse this
                                         text
                                         pos
                                         ""
                                         (.getMinusSignText symbols)
                                         exponentDigits
                                         true
                                         expStat)
                          (if (.fitsIntoLong exponentDigits (aget expStat STATUS_POSITIVE) true)
                              (do
                                (set! exponent (.getLong exponentDigits))
                                (when-not (aget expStat STATUS_POSITIVE)
                                  (set! exponent (unchecked-negate exponent))))
                              (set! exponent
                                    (if (aget expStat STATUS_POSITIVE)
                                        Long/MAX_VALUE
                                        Long/MIN_VALUE)))
                          (set! position (.-index pos)))
                        (break))
                    :else (break)))
                (set! position (unchecked-inc-int position)))
              (when parseStrict
                (when (and (not sawDecimal) (.isGroupingViolation this position prevSeparatorIndex))
                  (return (NumericPosition.
                            (.groupingViolationIndex
                              this
                              (unchecked-subtract-int position 1)
                              prevSeparatorIndex)
                            intIndex))))
              (when-not (== backup -1) (set! position backup))
              (when-not sawDecimal (set! (.-decimalAt digits) digitCount))
              (when (or (not sawDecimal) (not (.isParseIntegerOnly this)))
                (set! (.-decimalAt digits) (.shiftDecimalAt this (.-decimalAt digits) exponent)))
              (when (and (not sawDigit) (== digitCount 0)) (return (NumericPosition. -1 intIndex))))))
      (NumericPosition. position intIndex)))

  (method ^:private shiftDecimalAt ^int [this ^:mutable ^int decimalAt ^:mutable ^long exponent]
    (try
      (set! exponent (Math/addExact decimalAt exponent))
      (catch ArithmeticException ex
        (if (and (> exponent 0) (> decimalAt 0))
            (return Integer/MAX_VALUE)
            (return Integer/MIN_VALUE))))
    (try
      (set! decimalAt (Math/toIntExact exponent))
      (catch ArithmeticException ex
        (set! decimalAt (if (> exponent 0) Integer/MAX_VALUE Integer/MIN_VALUE))))
    decimalAt)

  (method ^:private isGroupingViolation ^boolean [this ^int pos ^int prevGroupingPos]
    (java-assert parseStrict "Grouping violations should only occur when strict")
    (and (and (.isGroupingUsed this) (not (== prevGroupingPos (unchecked-negate-int groupingSize))))
         (not (== (unchecked-subtract-int pos 1) (unchecked-add-int prevGroupingPos groupingSize)))))

  (method ^:private groupingViolationIndex ^int [this ^int pos ^int prevGroupingPos]
    (Math/min pos (unchecked-add-int (unchecked-add-int prevGroupingPos groupingSize) 1)))

  (method ^:public getDecimalFormatSymbols ^DecimalFormatSymbols [this]
    (try (cast DecimalFormatSymbols (.clone symbols)) (catch Exception foo nil)))

  (method ^:public setDecimalFormatSymbols ^void [this ^DecimalFormatSymbols newSymbols]
    (try
      (set! symbols (cast DecimalFormatSymbols (.clone newSymbols)))
      (.expandAffixes this)
      (set! fastPathCheckNeeded true)
      (catch Exception foo)))

  (method ^:public getPositivePrefix ^String [this] positivePrefix)

  (method ^:public setPositivePrefix ^void [this ^String newValue]
    (Objects/requireNonNull newValue "prefix must not be null")
    (set! positivePrefix newValue)
    (set! posPrefixPattern nil)
    (set! positivePrefixFieldPositions nil)
    (set! fastPathCheckNeeded true))

  (method ^:private getPositivePrefixFieldPositions ^FieldPosition/1 [this]
    (when (nil? positivePrefixFieldPositions)
      (if (some? posPrefixPattern)
          (set! positivePrefixFieldPositions (.expandAffix this posPrefixPattern))
          (set! positivePrefixFieldPositions EmptyFieldPositionArray)))
    positivePrefixFieldPositions)


                        (.append buffer (.getInternationalCurrencySymbol symbols)))
                      (.append buffer (.getCurrencySymbol symbols)))
                  (continue))
              PATTERN_PERCENT (do (.append buffer (.getPercentText symbols)) (continue))
              PATTERN_PER_MILLE (do (.append buffer (.getPerMillText symbols)) (continue))
              PATTERN_MINUS (do (.append buffer (.getMinusSignText symbols)) (continue))))

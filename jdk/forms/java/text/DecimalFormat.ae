        (set! positivePrefixFieldPositions nil))
      (when (some? posSuffixPattern)
        (set! positiveSuffix (.expandAffix this posSuffixPattern buffer))
        (set! positiveSuffixFieldPositions nil))
      (when (some? negPrefixPattern)
        (set! negativePrefix (.expandAffix this negPrefixPattern buffer))
        (set! negativePrefixFieldPositions nil))
      (when (some? negSuffixPattern)
        (set! negativeSuffix (.expandAffix this negSuffixPattern buffer))
        (set! negativeSuffixFieldPositions nil))))

  (method ^:private expandAffix ^String [this ^String pattern ^StringBuilder buffer]

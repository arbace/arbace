                                   (if isCurrencyFormat
                                       (.getMonetaryGroupingSeparator symbols)
                                       (.getGroupingSeparator symbols))
                                   PATTERN_GROUPING_SEPARATOR)
          ^char decimalSymbol (if localized
                                  (if isCurrencyFormat
                                      (.getMonetaryDecimalSeparator symbols)
                                      (.getDecimalSeparator symbols))
                                  PATTERN_DECIMAL_SEPARATOR)
          ^String exponentSymbol (if localized (.getExponentSeparator symbols) PATTERN_EXPONENT)

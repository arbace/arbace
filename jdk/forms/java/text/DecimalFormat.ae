                                                       0))
                                                   (>= (.indexOf affix PATTERN_PERCENT) 0))
                                                 (>= (.indexOf affix PATTERN_PER_MILLE) 0))
                                               (>= (.indexOf affix PATTERN_DIGIT) 0))
                                             (>= (.indexOf affix PATTERN_SEPARATOR) 0))

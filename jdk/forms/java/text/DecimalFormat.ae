                                                 (>= (.indexOf affix (.getPercentText symbols)) 0))
                                               (>= (.indexOf affix (.getPerMillText symbols)) 0))
                                             (>= (.indexOf affix (.getDigit symbols)) 0))
                                           (>= (.indexOf affix (.getPatternSeparator symbols)) 0))
                                         (>= (.indexOf affix (.getMinusSignText symbols)) 0))

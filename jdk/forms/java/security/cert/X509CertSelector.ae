      (when (some? issuer) (.append sb (java-str "  Issuer: " (.getIssuerAsString this) "\n")))
      (when (some? subject) (.append sb (java-str "  Subject: " (.getSubjectAsString this) "\n")))
      (.append sb (java-str "  matchAllSubjectAltNames flag: " matchAllSubjectAltNames "\n"))
      (when (some? subjectAlternativeNames)
        (.append sb "  SubjectAlternativeNames:\n")
        (for-each [^{:tag (List ?)} list subjectAlternativeNames]
          (.append sb (java-str "    type " (.get list 0) ", name " (.get list 1) "\n"))))
      (when (some? subjectKeyID)
        (let [enc (HexDumpEncoder.)]
          (.append sb (java-str "  Subject Key Identifier: " (.encodeBuffer enc subjectKeyID) "\n"))))
      (when (some? authorityKeyID)
        (let [enc (HexDumpEncoder.)]
          (.append
            sb
            (java-str "  Authority Key Identifier: " (.encodeBuffer enc authorityKeyID) "\n"))))
      (when (some? certificateValid)
        (.append sb (java-str "  Certificate Valid: " certificateValid "\n")))
      (when (some? privateKeyValid)
        (.append sb (java-str "  Private Key Valid: " privateKeyValid "\n")))
      (when (some? subjectPublicKeyAlgID)
        (.append sb (java-str "  Subject Public Key AlgID: " subjectPublicKeyAlgID "\n")))
      (when (some? subjectPublicKey)
        (.append sb (java-str "  Subject Public Key: " subjectPublicKey "\n")))
      (when (some? keyUsage)
        (.append sb (java-str "  Key Usage: " (X509CertSelector/keyUsageToString keyUsage) "\n")))
      (when (some? keyPurposeSet)
        (.append sb (java-str "  Extended Key Usage: " keyPurposeSet "\n")))
      (when (some? policy) (.append sb (java-str "  Policy: " policy "\n")))
      (when (some? pathToGeneralNames)
        (.append sb "  Path to names:\n")

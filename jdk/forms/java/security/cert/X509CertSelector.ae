      (try
        (when (aget k 0) (set! s (java-str s "  DigitalSignature\n")))
        (when (aget k 1) (set! s (java-str s "  Non_repudiation\n")))
        (when (aget k 2) (set! s (java-str s "  Key_Encipherment\n")))
        (when (aget k 3) (set! s (java-str s "  Data_Encipherment\n")))
        (when (aget k 4) (set! s (java-str s "  Key_Agreement\n")))
        (when (aget k 5) (set! s (java-str s "  Key_CertSign\n")))
        (when (aget k 6) (set! s (java-str s "  Crl_Sign\n")))
        (when (aget k 7) (set! s (java-str s "  Encipher_Only\n")))
        (when (aget k 8) (set! s (java-str s "  Decipher_Only\n")))
        (catch ArrayIndexOutOfBoundsException ex))
      (set! s (java-str s "]\n"))
      s))

  (method ^:private ^:static getExtensionObject :throws [IOException] ^Extension [^X509Certificate cert
                                                                                  ^KnownOIDs extId]
    (if-instance [^X509CertImpl impl cert]
      (switch extId
        PrivateKeyUsage (.getPrivateKeyUsageExtension impl)
        SubjectAlternativeName (.getSubjectAlternativeNameExtension impl)
        NameConstraints (.getNameConstraintsExtension impl)
        CertificatePolicies (.getCertificatePoliciesExtension impl)
        extendedKeyUsage (.getExtendedKeyUsageExtension impl)
        nil)
      (let [rawExtVal (.getExtensionValue cert (.value extId))]
        (when (some? rawExtVal)
          (let [in (DerInputStream. rawExtVal)
                encoded (.getOctetString in)]
            (switch extId
              PrivateKeyUsage
                (try
                  (PrivateKeyUsageExtension. FALSE encoded)
                  (catch CertificateException ex (throw (IOException. (.getMessage ex)))))
              SubjectAlternativeName (SubjectAlternativeNameExtension. FALSE encoded)
              NameConstraints (NameConstraintsExtension. FALSE encoded)
              CertificatePolicies (CertificatePoliciesExtension. FALSE encoded)
              extendedKeyUsage (ExtendedKeyUsageExtension. FALSE encoded)
              nil))))))

  (method ^:public match ^boolean [this ^Certificate cert]
    (if-instance [^X509Certificate xcert cert]
      (do
        (when (some? debug)
          (.println debug
                    (java-str "X509CertSelector.match(Serial number: "
                              (Debug/toString (.getSerialNumber xcert))
                              "\n  Issuer: "
                              (.getIssuerX500Principal xcert)
                              "\n  Subject: "
                              (.getSubjectX500Principal xcert)
                              ")")))
        (when (some? x509Cert)
          (when-not (.equals x509Cert xcert)
            (when (some? debug) (.println debug "X509CertSelector.match: certs don't match"))
            (return false)))
        (when (some? serialNumber)
          (when-not (.equals serialNumber (.getSerialNumber xcert))
            (when (some? debug)
              (.println debug "X509CertSelector.match: serial numbers don't match"))
            (return false)))
        (when (some? issuer)
          (when-not (.equals issuer (.getIssuerX500Principal xcert))
            (when (some? debug) (.println debug "X509CertSelector.match: issuer DNs don't match"))
            (return false)))
        (when (some? subject)
          (when-not (.equals subject (.getSubjectX500Principal xcert))
            (when (some? debug) (.println debug "X509CertSelector.match: subject DNs don't match"))
            (return false)))
        (when (some? certificateValid)
          (try
            (.checkValidity xcert certificateValid)
            (catch CertificateException e
              (when (some? debug)
                (.println debug "X509CertSelector.match: certificate not within validity period"))
              (return false))))
        (when (some? subjectPublicKeyBytes)
          (let [certKey (.getEncoded (.getPublicKey xcert))]
            (when-not (Arrays/equals subjectPublicKeyBytes certKey)
              (when (some? debug)
                (.println debug "X509CertSelector.match: subject public keys don't match"))
              (return false))))
        (let [result (and (and (and (and (and (and
                                                (and
                                                  (and
                                                    (and
                                                      (and
                                                        (.matchBasicConstraints this xcert)
                                                        (.matchKeyUsage this xcert))
                                                      (.matchExtendedKeyUsage this xcert))
                                                    (.matchSubjectKeyID this xcert))
                                                  (.matchAuthorityKeyID this xcert))
                                                (.matchPrivateKeyValid this xcert))
                                              (.matchSubjectPublicKeyAlgID this xcert))
                                         (.matchPolicy this xcert))
                                    (.matchSubjectAlternativeNames this xcert))
                               (.matchPathToNames this xcert))
                          (.matchNameConstraints this xcert))]
          (when (and result (some? debug))
            (.println debug "X509CertSelector.match returning: true"))
          result))
      false))

  (method ^:private matchSubjectKeyID ^boolean [this ^X509Certificate xcert]
    (if (nil? subjectKeyID)
        true
        (do
          (try
            (let [extVal (.getExtensionValue xcert "2.5.29.14")]
              (when (nil? extVal)
                (when (some? debug)
                  (.println debug "X509CertSelector.match: no subject key ID extension"))
                (return false))
              (let [in (DerInputStream. extVal)
                    certSubjectKeyID (.getOctetString in)]
                (when (or (nil? certSubjectKeyID)
                          (not (Arrays/equals subjectKeyID certSubjectKeyID)))
                  (when (some? debug)
                    (.println
                      debug
                      (java-str
                        "X509CertSelector.match: subject key IDs don't match\nX509CertSelector.match: subjectKeyID: "
                        (Arrays/toString subjectKeyID)
                        "\nX509CertSelector.match: certSubjectKeyID: "
                        (Arrays/toString certSubjectKeyID))))
                  (return false))))
            (catch IOException ex
              (when (some? debug)
                (.println debug "X509CertSelector.match: exception in subject key ID check"))
              (return false)))
          true)))

  (method ^:private matchAuthorityKeyID ^boolean [this ^X509Certificate xcert]
    (if (nil? authorityKeyID)
        true
        (do
          (try
            (let [extVal (.getExtensionValue xcert "2.5.29.35")]
              (when (nil? extVal)
                (when (some? debug)
                  (.println debug "X509CertSelector.match: no authority key ID extension"))
                (return false))
              (let [in (DerInputStream. extVal)
                    certAuthKeyID (.getOctetString in)]
                (when (or (nil? certAuthKeyID) (not (Arrays/equals authorityKeyID certAuthKeyID)))
                  (when (some? debug)
                    (.println debug "X509CertSelector.match: authority key IDs don't match"))
                  (return false))))
            (catch IOException ex
              (when (some? debug)
                (.println debug "X509CertSelector.match: exception in authority key ID check"))
              (return false)))
          true)))

  (method ^:private matchPrivateKeyValid ^boolean [this ^X509Certificate xcert]
    (if (nil? privateKeyValid)
        true
        (let [^:mutable ^PrivateKeyUsageExtension ext nil]
          (try
            (set! ext
                  (cast PrivateKeyUsageExtension
                        (X509CertSelector/getExtensionObject xcert KnownOIDs/PrivateKeyUsage)))
            (when (some? ext) (.valid ext privateKeyValid))
            (catch CertificateExpiredException e1
              (when (some? debug)
                (let [^:mutable time "n/a"
                      notAfter (.getNotAfter ext)]
                  (set! time (.toString notAfter))
                  (.println
                    debug
                    (java-str
                      "X509CertSelector.match: private key usage not within validity date; ext.NOT_After: "
                      time
                      "; X509CertSelector: "
                      (.toString this)))
                  (.printStackTrace e1)))
              (return false))
            (catch CertificateNotYetValidException e2
              (when (some? debug)
                (let [^:mutable time "n/a"
                      notBefore (.getNotBefore ext)]
                  (set! time (.toString notBefore))
                  (.println
                    debug
                    (java-str
                      "X509CertSelector.match: private key usage not within validity date; ext.NOT_BEFORE: "
                      time
                      "; X509CertSelector: "
                      this))
                  (.printStackTrace e2)))
              (return false))
            (catch IOException e4
              (when (some? debug)
                (.println
                  debug
                  (java-str
                    "X509CertSelector.match: IOException in private key usage check; X509CertSelector: "
                    this))
                (.printStackTrace e4))
              (return false)))
          true)))

  (method ^:private matchSubjectPublicKeyAlgID ^boolean [this ^X509Certificate xcert]
    (if (nil? subjectPublicKeyAlgID)
        true
        (do
          (try
            (let [encodedKey (.getEncoded (.getPublicKey xcert))
                  val (DerValue. encodedKey)]
              (when-not (== (.-tag val) DerValue/tag_Sequence)
                (throw (IOException. "invalid key format")))
              (let [algID (AlgorithmId/parse (.getDerValue (.-data val)))]
                (when (some? debug)
                  (.println debug
                            (java-str "X509CertSelector.match: subjectPublicKeyAlgID = "
                                      subjectPublicKeyAlgID
                                      ", xcert subjectPublicKeyAlgID = "
                                      (.getOID algID))))
                (when-not (.equals subjectPublicKeyAlgID (.getOID algID))
                  (when (some? debug)
                    (.println debug
                              "X509CertSelector.match: subject public key alg IDs don't match"))
                  (return false))))
            (catch IOException e5
              (when (some? debug)
                (.println
                  debug
                  "X509CertSelector.match: IOException in subject public key algorithm OID check"))
              (return false)))
          true)))

  (method ^:private matchKeyUsage ^boolean [this ^X509Certificate xcert]
    (if (nil? keyUsage)
        true
        (let [certKeyUsage (.getKeyUsage xcert)]
          (when (some? certKeyUsage)
            (loop [^int keyBit 0]
              (if (< keyBit (alength keyUsage))
                  (if (and (aget keyUsage keyBit)
                           (or (>= keyBit (alength certKeyUsage)) (not (aget certKeyUsage keyBit))))
                      (do
                        (when (some? debug)
                          (.println debug "X509CertSelector.match: key usage bits don't match"))
                        (return false))
                      (recur (unchecked-inc-int keyBit)))
                  nil)))
          true)))

  (method ^:private matchExtendedKeyUsage ^boolean [this ^X509Certificate xcert]
    (if (or (nil? keyPurposeSet) (.isEmpty keyPurposeSet))
        true
        (do
          (try
            (let [ext (cast ExtendedKeyUsageExtension
                            (X509CertSelector/getExtensionObject xcert KnownOIDs/extendedKeyUsage))]
              (when (some? ext)
                (let [^{:tag (Vector ObjectIdentifier)} certKeyPurposeVector (.getUsages ext)]
                  (when (and (not (.contains certKeyPurposeVector ANY_EXTENDED_KEY_USAGE))
                             (not (.containsAll certKeyPurposeVector keyPurposeOIDSet)))
                    (when (some? debug)
                      (.println debug
                                "X509CertSelector.match: cert failed extendedKeyUsage criterion"))
                    (return false)))))
            (catch IOException ex
              (when (some? debug)
                (.println debug "X509CertSelector.match: IOException in extended key usage check"))
              (return false)))
          true)))

  (method ^:private matchSubjectAlternativeNames ^boolean [this ^X509Certificate xcert]
    (if (or (nil? subjectAlternativeNames) (.isEmpty subjectAlternativeNames))
        true
        (do
          (try
            (let [sanExt (cast SubjectAlternativeNameExtension
                               (X509CertSelector/getExtensionObject
                                 xcert
                                 KnownOIDs/SubjectAlternativeName))]
              (when (nil? sanExt)
                (when (some? debug)
                  (.println debug "X509CertSelector.match: no subject alternative name extension"))
                (return false))
              (let [certNames (.getNames sanExt)
                    ^{:tag (Iterator GeneralNameInterface)} i (.iterator
                                                                subjectAlternativeGeneralNames)]
                (while (.hasNext i)
                  (let [matchName (cast GeneralNameInterface (.next i))
                        ^:mutable found false]
                    (loop [^{:tag (Iterator GeneralName)} t (.iterator certNames)]
                      (when (and (.hasNext t) (not found))
                        (let [certName (.getName (cast GeneralName (.next t)))]
                          (set! found (.equals certName matchName))
                          (recur t))))
                    (cond
                      (and (not found) (or matchAllSubjectAltNames (not (.hasNext i))))
                        (do
                          (when (some? debug)
                            (.println debug
                                      (java-str "X509CertSelector.match: subject alternative name "
                                                matchName
                                                " not found")))
                          (return false))
                      (and found (not matchAllSubjectAltNames)) (break))))))
            (catch IOException ex
              (when (some? debug)
                (.println debug
                          "X509CertSelector.match: IOException in subject alternative name check"))
              (return false)))
          true)))

  (method ^:private matchNameConstraints ^boolean [this ^X509Certificate xcert]
    (if (nil? nc)
        true
        (do
          (try
            (when-not (.verify nc xcert)
              (when (some? debug)
                (.println debug "X509CertSelector.match: name constraints not satisfied"))
              (return false))
            (catch IOException e
              (when (some? debug)
                (.println debug "X509CertSelector.match: IOException in name constraints check"))
              (return false)))
          true)))

  (method ^:private matchPolicy ^boolean [this ^X509Certificate xcert]
    (if (nil? policy)
        true
        (do
          (try
            (let [ext (cast CertificatePoliciesExtension
                            (X509CertSelector/getExtensionObject
                              xcert
                              KnownOIDs/CertificatePolicies))]
              (when (nil? ext)
                (when (some? debug)
                  (.println debug "X509CertSelector.match: no certificate policy extension"))
                (return false))
              (let [^{:tag (List PolicyInformation)} policies (.getCertPolicies ext)
                    ^{:tag (List CertificatePolicyId)} policyIDs (ArrayList. (.size policies))]
                (for-each [^PolicyInformation info policies]
                  (.add policyIDs (.getPolicyIdentifier info)))
                (when (some? policy)
                  (let [^:mutable foundOne false]
                    (if (.isEmpty (.getCertPolicyIds policy))
                        (when (.isEmpty policyIDs)
                          (when (some? debug)
                            (.println debug
                                      "X509CertSelector.match: cert failed policyAny criterion"))
                          (return false))
                        (do
                          (for-each [^CertificatePolicyId id (.getCertPolicyIds policy)]
                            (when (.contains policyIDs id) (set! foundOne true) (break)))
                          (when-not foundOne
                            (when (some? debug)
                              (.println debug
                                        "X509CertSelector.match: cert failed policyAny criterion"))
                            (return false))))))))
            (catch IOException ex
              (when (some? debug)
                (.println debug
                          "X509CertSelector.match: IOException in certificate policy ID check"))
              (return false)))
          true)))

  (method ^:private matchPathToNames ^boolean [this ^X509Certificate xcert]
    (if (nil? pathToGeneralNames)
        true
        (do
          (try
            (let [ext (cast NameConstraintsExtension
                            (X509CertSelector/getExtensionObject xcert KnownOIDs/NameConstraints))]
              (when (nil? ext) (return true))
              (when (and (some? debug) (Debug/isOn "certpath"))
                (.println debug "X509CertSelector.match pathToNames:\n")
                (for-each [^GeneralNameInterface pathToGeneralName pathToGeneralNames]
                  (.println debug (java-str "    " pathToGeneralName "\n"))))
              (let [permitted (.getPermittedSubtrees ext)
                    excluded (.getExcludedSubtrees ext)]
                (when (some? excluded) (when-not (.matchExcluded this excluded) (return false)))
                (when (some? permitted) (when-not (.matchPermitted this permitted) (return false)))))
            (catch IOException ex
              (when (some? debug)
                (.println debug "X509CertSelector.match: IOException in name constraints check"))
              (return false)))
          true)))

  (method ^:private matchExcluded ^boolean [this ^GeneralSubtrees excluded]
    (loop [^{:tag (Iterator GeneralSubtree)} t (.iterator excluded)]
      (when (.hasNext t)
        (let [tree (cast GeneralSubtree (.next t))
              excludedName (.getName (.getName tree))]
          (for-each [^GeneralNameInterface pathToName pathToGeneralNames]
            (when (== (.getType excludedName) (.getType pathToName))
              (switch (.constrains pathToName excludedName)
                (GeneralNameInterface/NAME_WIDENS GeneralNameInterface/NAME_MATCH)
                  (do
                    (when (some? debug)
                      (.println
                        debug
                        "X509CertSelector.match: name constraints inhibit path to specified name")
                      (.println debug
                                (java-str "X509CertSelector.match: excluded name: " pathToName)))
                    (return false))
                nil)))
          (recur t))))
    true)

  (method ^:private matchPermitted ^boolean [this ^GeneralSubtrees permitted]
    (for-each [^GeneralNameInterface pathToName pathToGeneralNames]
      (let [^{:tag (Iterator GeneralSubtree)} t (.iterator permitted)
            ^:mutable permittedNameFound false
            ^:mutable nameTypeFound false
            ^:mutable names ""]
        (while (and (.hasNext t) (not permittedNameFound))
          (let [tree (cast GeneralSubtree (.next t))
                permittedName (.getName (.getName tree))]
            (when (== (.getType permittedName) (.getType pathToName))
              (set! nameTypeFound true)
              (set! names (java-str names "  " permittedName))
              (switch (.constrains pathToName permittedName)
                (GeneralNameInterface/NAME_WIDENS GeneralNameInterface/NAME_MATCH)
                  (set! permittedNameFound true)
                nil))))
        (when (and (not permittedNameFound) nameTypeFound)
          (when (some? debug)
            (.println
              debug
              (java-str
                "X509CertSelector.match: name constraints inhibit path to specified name; permitted names of type "
                (.getType pathToName)
                ": "
                names)))
          (return false))))
    true)

  (method ^:private matchBasicConstraints ^boolean [this ^X509Certificate xcert]
    (if (== basicConstraints -1)
        true
        (let [maxPathLen (.getBasicConstraints xcert)]
          (if (== basicConstraints -2)
              (when-not (== maxPathLen -1)
                (when (some? debug) (.println debug "X509CertSelector.match: not an EE cert"))
                (return false))
              (when (< maxPathLen basicConstraints)
                (when (some? debug)
                  (.println
                    debug
                    (java-str
                      "X509CertSelector.match: cert's maxPathLen is less than the min maxPathLen set by basicConstraints. ("
                      maxPathLen
                      " < "
                      basicConstraints
                      ")")))
                (return false)))
          true)))

  (method ^:private ^:static cloneSet :type-params [T] ^{:tag (Set T)} [^{:tag (Set T)} set]
    (if (instance? HashSet set)
        (let [clone (.clone (cast HashSet set))] (cast Set clone))
        (HashSet. set)))

  (method ^:public clone [this]
    (try
      (let [copy (cast X509CertSelector (.clone super))]
        (when (some? subjectAlternativeNames)
          (set! (.-subjectAlternativeNames copy)
                (X509CertSelector/cloneSet subjectAlternativeNames))
          (set! (.-subjectAlternativeGeneralNames copy)
                (X509CertSelector/cloneSet subjectAlternativeGeneralNames)))
        (when (some? pathToGeneralNames)
          (set! (.-pathToNames copy) (X509CertSelector/cloneSet pathToNames))
          (set! (.-pathToGeneralNames copy) (X509CertSelector/cloneSet pathToGeneralNames)))
        copy)
      (catch CloneNotSupportedException e (throw (InternalError. (.toString e) e))))))

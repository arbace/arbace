                                                                  visitor
                                                                  (.file ev)
                                                                  (.ioeException ev))]
                                              (when (identical? res FileVisitResult/SKIP_SIBLINGS)
                                                (set! res FileVisitResult/CONTINUE))
                                              res)
                                          (throw (AssertionError. "Should not get here")))]
            (when-not (identical? (Objects/requireNonNull result) FileVisitResult/CONTINUE)
              (cond
                (identical? result FileVisitResult/TERMINATE) (break)
                (identical? result FileVisitResult/SKIP_SIBLINGS) (.skipRemainingSiblings walker)))
            (set! ev (.next walker)))
          (when (some? ev) (recur)))))
    start)


      (let [^:mutable ev (.walk walker start)]
        (loop []
          (let [^FileVisitResult result (switch (.type ev)
                                          ENTRY
                                            (let [ioe (.ioeException ev)]
                                              (if (nil? ioe)
                                                  (do
                                                    (java-assert (some? (.attributes ev)))
                                                    (.visitFile visitor (.file ev) (.attributes ev)))
                                                  (.visitFileFailed visitor (.file ev) ioe)))
                                          START_DIRECTORY
                                            (let [res (.preVisitDirectory
                                                        visitor
                                                        (.file ev)
                                                        (.attributes ev))]
                                              (when (or
                                                      (identical? res FileVisitResult/SKIP_SUBTREE)
                                                      (identical? res FileVisitResult/SKIP_SIBLINGS))
                                                (.pop walker))
                                              res)
                                          END_DIRECTORY

  (method ^:public ^:static walkFileTree :throws [IOException] ^Path [^Path start
                                                                      ^{:tag (Set FileVisitOption)} options
                                                                      ^int maxDepth
                                                                      ^{:tag (FileVisitor (? super Path))} visitor]

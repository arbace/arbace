  (method ^:private ^:static read :throws [IOException] ^byte/1 [^InputStream source
                                                                 ^int initialSize]
    (let [^:mutable capacity initialSize
          ^:mutable buf (new byte/1 capacity)
          ^:mutable ^int nread 0
          ^:mutable ^int n 0]
      (while true
        (while (> (set! n (.read source buf nread (unchecked-subtract-int capacity nread))) 0)
          (set! nread (unchecked-add-int nread n)))
        (when (or (< n 0) (< (set! n (.read source)) 0)) (break))
        (set! capacity (Math/max (ArraysSupport/newLength capacity 1 capacity) BUFFER_SIZE))
        (set! buf (Arrays/copyOf buf capacity))
        (aset buf nread (unchecked-byte n))
        (set! nread (unchecked-inc-int nread)))
      (if (== capacity nread) buf (Arrays/copyOf buf nread))))


          (.map (cast Stream
                      (.onClose (StreamSupport/stream spliterator false)
                                (method-ref Runnable iterator FileTreeIterator/.close)))
                (lambda Function ^Path [^FileTreeWalker$Event entry] (.file entry))))
        (catch [Error RuntimeException] e (.close iterator) (throw e)))))

  (method ^:public ^:static walk :throws [IOException] ^{:tag (Stream Path)} [^Path start &
                                                                              ^FileVisitOption/1 options]
    (Files/walk start Integer/MAX_VALUE options))

  (method ^:public ^:static find :throws [IOException] ^{:tag (Stream Path)} [^Path start
                                                                              ^int maxDepth
                                                                              ^{:tag (BiPredicate Path BasicFileAttributes)} matcher
                                                                              &
                                                                              ^FileVisitOption/1 options]
    (let [iterator (FileTreeIterator. start maxDepth options)]
      (try
        (let [^{:tag (Spliterator FileTreeWalker$Event)} spliterator
                (Spliterators/spliteratorUnknownSize iterator Spliterator/DISTINCT)]
          (.map (.filter (cast Stream
                               (.onClose (StreamSupport/stream spliterator false)
                                         (method-ref Runnable iterator FileTreeIterator/.close)))
                         (lambda Predicate ^boolean [^FileTreeWalker$Event entry]
                           (.test matcher (.file entry) (.attributes entry))))
                (lambda Function ^Path [^FileTreeWalker$Event entry] (.file entry))))
        (catch [Error RuntimeException] e (.close iterator) (throw e)))))

  (method ^:public ^:static lines :throws [IOException] ^{:tag (Stream String)} [^Path path
                                                                                 ^Charset cs]
    (when (and (identical? (.getFileSystem path) (FileSystems/getDefault))
               (.contains FileChannelLinesSpliterator/SUPPORTED_CHARSETS cs))
      (let [fc (FileChannel/open path (new OpenOption/1 [StandardOpenOption/READ]))
            ^{:tag (Stream String)} fcls (Files/createFileChannelLinesStream fc cs)]
        (when (some? fcls) (return fcls))
        (.close fc)))
    (Files/createBufferedReaderLinesStream (Files/newBufferedReader path cs)))

  (method ^:private ^:static createFileChannelLinesStream :throws [IOException] ^{:tag (Stream String)} [^FileChannel fc
                                                                                                         ^Charset cs]
    (try
      (let [length (.size fc)]
        (when (and (> length 0) (<= length Integer/MAX_VALUE))
          (let [fcls (FileChannelLinesSpliterator. fc cs 0 (unchecked-int length))]
            (return (cast Stream
                          (.onClose (cast Stream
                                          (.onClose
                                            (StreamSupport/stream fcls false)
                                            (Files/asUncheckedRunnable fc)))
                                    (lambda Runnable ^void [] (.close fcls))))))))
      (catch [Error RuntimeException IOException] e
        (try
          (.close fc)
          (catch IOException ex (try (.addSuppressed e ex) (catch Throwable ignore))))
        (throw e)))
    nil)

  (method ^:private ^:static createBufferedReaderLinesStream ^{:tag (Stream String)} [^BufferedReader br]
    (try
      (cast Stream (.onClose (.lines br) (Files/asUncheckedRunnable br)))
      (catch [Error RuntimeException] e
        (try
          (.close br)
          (catch IOException ex (try (.addSuppressed e ex) (catch Throwable ignore))))
        (throw e))))

  (method ^:public ^:static lines :throws [IOException] ^{:tag (Stream String)} [^Path path]
    (Files/lines path UTF_8/INSTANCE)))

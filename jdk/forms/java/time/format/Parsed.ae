  (method ^:private resolveTime ^void [this ^long hod ^long moh ^long som ^long nos]
    (if (identical? resolverStyle ResolverStyle/LENIENT)
        (let [^:mutable totalNanos (Math/multiplyExact hod 3600000000000)]
          (set! totalNanos (Math/addExact totalNanos (Math/multiplyExact moh 60000000000)))
          (set! totalNanos (Math/addExact totalNanos (Math/multiplyExact som 1000000000)))
          (set! totalNanos (Math/addExact totalNanos nos))
          (let [excessDays (unchecked-int (Math/floorDiv totalNanos 86400000000000))
                nod (Math/floorMod totalNanos 86400000000000)]
            (.updateCheckConflict this (LocalTime/ofNanoOfDay nod) (Period/ofDays excessDays))))

        (.containsKey fieldValues ChronoField/MILLI_OF_SECOND)
          (let [los (.longValue (cast Long (.remove fieldValues ChronoField/MILLI_OF_SECOND)))]
            (if (.containsKey fieldValues ChronoField/MICRO_OF_SECOND)

                        (== zoneNameType DateTimeFormatterBuilder$ZoneTextPrinterParser/GENERIC))
                (set! czdt (.withLaterOffsetAtOverlap czdt)))
              (.put fieldValues ChronoField/INSTANT_SECONDS (.toEpochSecond czdt)))))))

  (method ^:private updateCheckConflict ^void [this ^LocalTime timeToSet ^Period periodToSet]
    (if (some? time)
        (do
          (when (= (.equals time timeToSet) false)
            (throw (DateTimeException.
                     (java-str "Conflict found: Fields resolved to different times: "
                               time
                               " "
                               timeToSet))))
          (if (and (and (= (.isZero excessDays) false) (= (.isZero periodToSet) false))
                   (= (.equals excessDays periodToSet) false))
              (throw (DateTimeException.
                       (java-str "Conflict found: Fields resolved to different excess periods: "
                                 excessDays
                                 " "
                                 periodToSet)))
              (set! excessDays periodToSet)))

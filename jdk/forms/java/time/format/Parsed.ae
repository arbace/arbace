      (when (.hasNext it)
        (let [^{:tag (Map$Entry TemporalField Long)} entry (cast Map$Entry (.next it))
              field (cast TemporalField (.getKey entry))]
          (if (.isSupported target field)
              (let [^:mutable ^long val1 0]
                (try (set! val1 (.getLong target field)) (catch RuntimeException ex (continue it)))
                (let [val2 (.longValue (cast Long (.getValue entry)))]
                  (when-not (== val1 val2)
                    (throw (DateTimeException.
                             (java-str "Conflict found: Field "
                                       field
                                       " "
                                       val1
                                       " differs from "
                                       field
                                       " "
                                       val2
                                       " derived from "
                                       target))))
                  (.remove it)
                  (recur it)))
              (recur it))))))

  (method ^:public toString ^String [this]
    (let [buf (StringBuilder. 64)]
      (.append (.append (.append buf fieldValues) \,) chrono)
      (when (some? zone) (.append (.append buf \,) zone) (.append (.append buf \,) zoneNameType))
      (when (or (some? date) (some? time))
        (.append buf " resolved to ")
        (if (some? date)
            (do (.append buf date) (when (some? time) (.append (.append buf \T) time)))
            (.append buf time)))
      (.toString buf))))

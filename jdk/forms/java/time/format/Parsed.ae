              nosVal (.checkValidIntValue ChronoField/NANO_OF_SECOND nos)]
          (if (and (and (and (and (identical? resolverStyle ResolverStyle/SMART) (== hod 24))
                             (== mohVal 0))
                        (== som 0))
                   (== nosVal 0))
              (.updateCheckConflict this LocalTime/MIDNIGHT (Period/ofDays 1))
              (let [hodVal (.checkValidIntValue ChronoField/HOUR_OF_DAY hod)
                    somVal (.checkValidIntValue ChronoField/SECOND_OF_MINUTE som)]
                (.updateCheckConflict this (LocalTime/of hodVal mohVal somVal nosVal) Period/ZERO))))))

  (method ^:private resolvePeriod ^void [this]
    (when (and (and (some? date) (some? time)) (= (.isZero excessDays) false))
      (set! date (.plus date excessDays))
      (set! excessDays Period/ZERO)))

  (method ^:private resolveFractional ^void [this]
    (when (and (nil? time)
               (or (or (.containsKey fieldValues ChronoField/INSTANT_SECONDS)
                       (.containsKey fieldValues ChronoField/SECOND_OF_DAY))
                   (.containsKey fieldValues ChronoField/SECOND_OF_MINUTE)))
      (if (.containsKey fieldValues ChronoField/NANO_OF_SECOND)
          (let [nos (.longValue (cast Long (.get fieldValues ChronoField/NANO_OF_SECOND)))]
            (.put fieldValues ChronoField/MICRO_OF_SECOND (unchecked-divide nos 1000))
            (.put fieldValues ChronoField/MILLI_OF_SECOND (unchecked-divide nos 1000000)))
          (do
            (.put fieldValues ChronoField/NANO_OF_SECOND 0)
            (.put fieldValues ChronoField/MICRO_OF_SECOND 0)
            (.put fieldValues ChronoField/MILLI_OF_SECOND 0)))))

  (method ^:private resolveInstant ^void [this]
    (when (and (and (not (.containsKey fieldValues ChronoField/INSTANT_SECONDS)) (some? date))
               (some? time))
      (let [offsetSecs (cast Long (.get fieldValues ChronoField/OFFSET_SECONDS))]
        (cond
          (some? offsetSecs)

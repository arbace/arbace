          ^:mutable ^ChronoLocalDate effectiveDate nil]
      (if (some? overrideChrono)
          (if (.isSupported temporal ChronoField/EPOCH_DAY)
              (set! effectiveDate (.date effectiveChrono temporal))
              (do
                (when-not (and (identical? overrideChrono IsoChronology/INSTANCE)
                               (nil? temporalChrono))

                                             overrideZone
                                             temporalZone
                                             overrideChrono
                                             effectiveChrono
                                             temporalChrono)))))

  (method ^:private ^:static adjustSlow ^TemporalAccessor [^TemporalAccessor temporal
                                                           ^ZoneId overrideZone ^ZoneId temporalZone
                                                           ^Chronology overrideChrono
                                                           ^Chronology effectiveChrono
                                                           ^Chronology temporalChrono]
    (when (some? overrideZone)
      (when (and (and (instance? ZoneOffset (.normalized overrideZone))
                      (.isSupported temporal ChronoField/OFFSET_SECONDS))
                 (not (== (.get temporal ChronoField/OFFSET_SECONDS)

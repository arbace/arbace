          overrideZone (.getZone formatter)]
      (if (and (nil? overrideChrono) (nil? overrideZone))
          temporal
          (DateTimePrintContext/adjustWithOverride temporal overrideChrono overrideZone))))

  (method ^:private ^:static adjustWithOverride ^TemporalAccessor [^TemporalAccessor temporal
                                                                   ^:mutable ^Chronology overrideChrono
                                                                   ^:mutable ^ZoneId overrideZone]
    (let [temporalChrono (cast Chronology (.query temporal (TemporalQueries/chronology)))
          temporalZone (cast ZoneId (.query temporal (TemporalQueries/zoneId)))]
      (when (Objects/equals overrideChrono temporalChrono) (set! overrideChrono nil))
      (when (Objects/equals overrideZone temporalZone) (set! overrideZone nil))
      (if (and (nil? overrideChrono) (nil? overrideZone))
          temporal
          (let [^Chronology effectiveChrono (if (some? overrideChrono)
                                                overrideChrono
                                                temporalChrono)]
            (when (some? overrideZone)
              (when (.isSupported temporal ChronoField/INSTANT_SECONDS)
                (let [chrono (cast Chronology
                                   (Objects/requireNonNullElse
                                     effectiveChrono
                                     IsoChronology/INSTANCE))]
                  (return (.zonedDateTime chrono (Instant/from temporal) overrideZone)))))

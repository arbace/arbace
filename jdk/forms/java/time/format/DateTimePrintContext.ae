                (.getLong effectiveDate field)
                (.getLong temporal field)))

          (method ^:public query :type-params [R] ^R [this ^{:tag (TemporalQuery R)} query]
            (cond
              (identical? query (TemporalQueries/chronology)) ^Object effectiveChrono
              (identical? query (TemporalQueries/zoneId)) ^Object effectiveZone

                                    (aget names i)
                                    zid
                                    (unchecked-divide-int (unchecked-subtract-int i 1) 2))
                              (set! i (unchecked-add-int i 2))))))))
                  (.put cached
                        locale
                        (AbstractMap$SimpleImmutableEntry. regionIdsSize (SoftReference. tree))))))
            tree))))


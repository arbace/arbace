  (defclass ^:static ^:final ZoneTextPrinterParser
    :extends ZoneIdPrinterParser

    (field ^:private ^:final ^TextStyle textStyle)

    (field ^:private ^{:tag (Set String)} preferredZones)

    (field ^:private ^:final ^boolean isGeneric)

    (constructor ^:private [this ^TextStyle textStyle ^{:tag (Set ZoneId)} preferredZones
                            ^boolean isGeneric]
      (super. (TemporalQueries/zone) (java-str "ZoneText(" textStyle ")"))
      (set! (.-textStyle this) (cast TextStyle (Objects/requireNonNull textStyle "textStyle")))
      (set! (.-isGeneric this) isGeneric)
      (when (and (some? preferredZones) (not (== (.size preferredZones) 0)))
        (set! (.-preferredZones this) (HashSet.))
        (for-each [^ZoneId id preferredZones] (.add (.-preferredZones this) (.getId id)))))

    (field ^:static ^:final ^int UNDEFINED -1)

    (field ^:static ^:final ^int STD 0)

    (field ^:static ^:final ^int DST 1)

    (field ^:static ^:final ^int GENERIC 2)

    (field ^:private ^:static ^:final ^{:tag (Map String (SoftReference (Map Locale String/1)))} cache
      (ConcurrentHashMap.))

    (method ^:private getDisplayName ^String [this ^String id ^int type ^Locale locale]
      (when-not (identical? textStyle TextStyle/NARROW)
        (let [^:mutable ^String/1 names nil
              ^{:tag (SoftReference (Map Locale String/1))} ref (cast SoftReference (.get cache id))
              ^:mutable ^{:tag (Map Locale String/1)} perLocale nil]
          (when (or (or (nil? ref) (nil? (set! perLocale (cast Map (.get ref)))))
                    (nil? (set! names (cast String/1 (.get perLocale locale)))))
            (set! names (TimeZoneNameUtility/retrieveDisplayNames id locale))
            (when (nil? names) (return nil))
            (set! names (cast String/1 (Arrays/copyOfRange names 0 7)))
            (aset names 5 (TimeZoneNameUtility/retrieveGenericDisplayName id TimeZone/LONG locale))
            (when (nil? (aget names 5)) (aset names 5 (aget names 0)))
            (aset names 6 (TimeZoneNameUtility/retrieveGenericDisplayName id TimeZone/SHORT locale))
            (when (nil? (aget names 6)) (aset names 6 (aget names 0)))
            (when (nil? perLocale) (set! perLocale (ConcurrentHashMap.)))
            (.put perLocale locale names)
            (.put cache id (SoftReference. perLocale)))
          (switch type
            STD (aget names (unchecked-add-int (.zoneNameStyleIndex textStyle) 1))
            DST (aget names (unchecked-add-int (.zoneNameStyleIndex textStyle) 3))
            (aget names (unchecked-add-int (.zoneNameStyleIndex textStyle) 5))))))

    (method ^:public format ^boolean [this ^DateTimePrintContext context ^StringBuilder buf
                                      ^boolean optional]
      (let [zone (cast ZoneId (.getValue context (TemporalQueries/zoneId) optional))]
        (if (nil? zone)
            false
            (let [^:mutable zname (.getId zone)]
              (when-not (instance? ZoneOffset zone)
                (let [dt (.getTemporal context)
                      ^:mutable type GENERIC]
                  (when-not isGeneric
                    (cond
                      (.isSupported dt ChronoField/INSTANT_SECONDS)
                        (set! type
                              (if (.isDaylightSavings (.getRules zone) (Instant/from dt)) DST STD))
                      (and (.isSupported dt ChronoField/EPOCH_DAY)
                           (.isSupported dt ChronoField/NANO_OF_DAY))
                        (let [date (LocalDate/ofEpochDay (.getLong dt ChronoField/EPOCH_DAY))
                              time (LocalTime/ofNanoOfDay (.getLong dt ChronoField/NANO_OF_DAY))
                              ldt (.atTime date time)]
                          (when (nil? (.getTransition (.getRules zone) ldt))
                            (set! type
                                  (if (.isDaylightSavings
                                        (.getRules zone)
                                        (.toInstant (.atZone ldt zone)))
                                      DST
                                      STD))))))
                  (let [name (.getDisplayName this zname type (.getLocale context))]
                    (when (some? name) (set! zname name)))))
              (.append buf zname)
              true))))


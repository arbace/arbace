                isCaseSensitive (.isCaseSensitive context)
                ^{:tag (Set String)} availableZoneIds (ZoneRulesProvider/getAvailableZoneIds)
                regionIdsSize (.size availableZoneIds)
                ^{:tag (Map Locale (Map$Entry Integer (SoftReference PrefixTree)))} cached
                  (if isCaseSensitive cachedTree cachedTreeCI)
                ^:mutable ^{:tag (Map$Entry Integer (SoftReference PrefixTree))} entry nil
                ^:mutable ^PrefixTree tree nil
                ^:mutable ^String/2 zoneStrings nil]
            (when (or (nil? (set! entry (cast Map$Entry (.get cached locale))))
                      (or (not (== (.intValue (cast Integer (.getKey entry))) regionIdsSize))
                          (nil? (set! tree
                                      (cast PrefixTree
                                            (.get (cast SoftReference (.getValue entry))))))))
              (set! tree (PrefixTree/newTree context))
              (set! zoneStrings (TimeZoneNameUtility/getZoneStrings locale))
              (let [^{:tag (Set String)} nonRegionIds (HashSet/newHashSet 64)
                    ^{:tag (Set String)} regionIds (HashSet. availableZoneIds)]

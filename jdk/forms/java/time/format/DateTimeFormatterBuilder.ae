    (field ^:private ^:final ^{:tag (Map Locale (Map$Entry Integer (SoftReference PrefixTree)))} cachedTreeCI
      (HashMap/newHashMap 1))

    (method ^:protected getTree ^PrefixTree [this ^DateTimeParseContext context]

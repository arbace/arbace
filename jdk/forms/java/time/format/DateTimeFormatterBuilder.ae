            (and (and (== from (.-from dayPeriod)) (== to (.-to dayPeriod)))
                 (== index (.-index dayPeriod))))))

    (method ^:public hashCode ^int [this] (Objects/hash from to index))

    (method ^:public toString ^String [this]
      (java-str
        (.formatted "DayPeriod(%02d:%02d" (unchecked-divide from 60) (unchecked-remainder from 60))
        (if (== from to)
            ")"
            (.formatted "-%02d:%02d)" (unchecked-divide to 60) (unchecked-remainder to 60)))))))

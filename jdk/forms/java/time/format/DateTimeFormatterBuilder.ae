                      (let [zid (aget names 0)]
                        (when-not (or (not (.contains preferredZones zid))
                                      (.contains nonRegionIds zid))
                          (let [^:mutable ^int i (if (identical? textStyle TextStyle/FULL) 1 2)]
                            (while (< i (alength names))

                                            (not (.startsWith zid "GMT")))))
                            (lambda Consumer ^void [^String cid]
                              (let [cidNames (TimeZoneNameUtility/retrieveDisplayNames cid locale)
                                    ^:mutable ^int i (if (identical? textStyle TextStyle/FULL) 1 2)]
                                (while (< i (alength cidNames))
                                  (when (and (some? (aget cidNames i))
                                             (not (.isEmpty (aget cidNames i))))
                                    (.add t
                                          (aget cidNames i)

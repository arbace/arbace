                                         (.getProlepticMonth this)
                                         (.getProlepticMonth MIN)))]
                  (when (or (> (unchecked-multiply addMonths sign) maxAddMonths)
                            (>= (unchecked-multiply
                                  (unchecked-add (.toEpochDay (.plusMonths this addMonths)) addDays)
                                  sign)
                                (unchecked-multiply end sign)))
                    (set! steps (unchecked-dec steps))
                    (set! addMonths (unchecked-subtract addMonths months))
                    (set! addDays (unchecked-subtract addDays days))
                    (when (or (> (unchecked-multiply addMonths sign) maxAddMonths)
                              (>= (unchecked-multiply
                                    (unchecked-add
                                      (.toEpochDay (.plusMonths this addMonths))
                                      addDays)
                                    sign)
                                  (unchecked-multiply end sign)))
                      (set! steps (unchecked-dec steps))))
                  (.mapToObj (LongStream/rangeClosed 0 steps)
                             (lambda LongFunction ^LocalDate [^long n]
                               (.plusDays (.plusMonths this (unchecked-multiply months n))
                                          (unchecked-multiply days n))))))))))

  (method ^:public format ^String [this ^DateTimeFormatter formatter]
    (Objects/requireNonNull formatter "formatter")
    (.format formatter this))

  (method ^:public atTime ^LocalDateTime [this ^LocalTime time]
    (LocalDateTime/of this time))

  (method ^:public atTime ^LocalDateTime [this ^int hour ^int minute]
    (.atTime this (LocalTime/of hour minute)))

  (method ^:public atTime ^LocalDateTime [this ^int hour ^int minute ^int second]
    (.atTime this (LocalTime/of hour minute second)))

  (method ^:public atTime ^LocalDateTime [this ^int hour ^int minute ^int second ^int nanoOfSecond]
    (.atTime this (LocalTime/of hour minute second nanoOfSecond)))

  (method ^:public atTime ^OffsetDateTime [this ^OffsetTime time]
    (OffsetDateTime/of (LocalDateTime/of this (.toLocalTime time)) (.getOffset time)))

  (method ^:public atStartOfDay ^LocalDateTime [this]
    (LocalDateTime/of this LocalTime/MIDNIGHT))

  (method ^:public atStartOfDay ^ZonedDateTime [this ^ZoneId zone]
    (Objects/requireNonNull zone "zone")
    (let [^:mutable ldt (.atTime this LocalTime/MIDNIGHT)]
      (when-not (instance? ZoneOffset zone)
        (let [rules (.getRules zone)
              trans (.getTransition rules ldt)]
          (when (and (some? trans) (.isGap trans)) (set! ldt (.getDateTimeAfter trans)))))
      (ZonedDateTime/of ldt zone)))

  (method ^:public toEpochDay ^long [this]
    (let [^long y year
          ^long m month
          ^:mutable total 0]
      (set! total (unchecked-add total (unchecked-multiply 365 y)))
      (if (>= y 0)
          (set! total
                (unchecked-add total
                               (unchecked-add
                                 (unchecked-subtract
                                   (unchecked-divide (unchecked-add y 3) 4)
                                   (unchecked-divide (unchecked-add y 99) 100))
                                 (unchecked-divide (unchecked-add y 399) 400))))
          (set! total
                (unchecked-subtract total
                                    (unchecked-add
                                      (unchecked-subtract
                                        (unchecked-divide y -4)
                                        (unchecked-divide y -100))
                                      (unchecked-divide y -400)))))
      (set! total
            (unchecked-add
              total
              (unchecked-divide (unchecked-subtract (unchecked-multiply 367 m) 362) 12)))
      (set! total (unchecked-add total (unchecked-subtract-int day 1)))
      (when (> m 2)
        (set! total (unchecked-dec total))
        (when (= (.isLeapYear this) false) (set! total (unchecked-dec total))))
      (unchecked-subtract total DAYS_0000_TO_1970)))

  (method ^:public toEpochSecond ^long [this ^LocalTime time ^ZoneOffset offset]
    (Objects/requireNonNull time "time")
    (Objects/requireNonNull offset "offset")
    (let [^:mutable secs (unchecked-add
                           (unchecked-multiply (.toEpochDay this) LocalTime/SECONDS_PER_DAY)
                           (.toSecondOfDay time))]
      (set! secs (unchecked-subtract secs (.getTotalSeconds offset)))
      secs))

  (method ^:public compareTo ^int [this ^ChronoLocalDate other]
    (if (instance? LocalDate other)
        (.compareTo0 this (cast LocalDate other))
        (.compareTo ChronoLocalDate/super other)))

  (method compareTo0 ^int [this ^LocalDate otherDate]
    (let [^:mutable cmp (unchecked-subtract-int year (.-year otherDate))]
      (when (== cmp 0)
        (set! cmp (unchecked-subtract-int month (.-month otherDate)))
        (when (== cmp 0) (set! cmp (unchecked-subtract-int day (.-day otherDate)))))
      cmp))

  (method ^:public isAfter ^boolean [this ^ChronoLocalDate other]
    (if (instance? LocalDate other)
        (> (.compareTo0 this (cast LocalDate other)) 0)
        (.isAfter ChronoLocalDate/super other)))

  (method ^:public isBefore ^boolean [this ^ChronoLocalDate other]
    (if (instance? LocalDate other)
        (< (.compareTo0 this (cast LocalDate other)) 0)
        (.isBefore ChronoLocalDate/super other)))

  (method ^:public isEqual ^boolean [this ^ChronoLocalDate other]
    (if (instance? LocalDate other)
        (== (.compareTo0 this (cast LocalDate other)) 0)
        (.isEqual ChronoLocalDate/super other)))

  (method ^:public equals ^boolean [this obj]
    (cond
      (identical? this obj) true
      (instance? LocalDate obj) (== (.compareTo0 this (cast LocalDate obj)) 0)
      :else false))

  (method ^:public hashCode ^int [this]
    (bit-xor-int (bit-and-int year (unchecked-int 0xFFFFF800))
                 (unchecked-add-int
                   (unchecked-add-int (bit-shift-left-int year 11) (bit-shift-left-int month 6))
                   day)))

  (method ^:public toString ^String [this]
    (let [buf (StringBuilder. 10)] (DateTimeHelper/formatTo buf this) (.toString buf)))

  (method ^:private writeReplace [this] (Ser. Ser/LOCAL_DATE_TYPE this))

  (method ^:private readObject :throws [InvalidObjectException] ^void [this ^ObjectInputStream s]
    (throw (InvalidObjectException. "Deserialization via serialization delegate")))

  (method writeExternal :throws [IOException] ^void [this ^DataOutput out]
    (.writeInt out year)
    (.writeByte out month)
    (.writeByte out day))

  (method ^:static readExternal :throws [IOException] ^LocalDate [^DataInput in]
    (let [year (.readInt in)
          ^int month (.readByte in)
          ^int dayOfMonth (.readByte in)]
      (LocalDate/of year month dayOfMonth))))

                                          (.remove fieldValues ChronoField/ALIGNED_WEEK_OF_YEAR)))
                        1)
                dow (Math/subtractExact
                      (.longValue (cast Long (.remove fieldValues ChronoField/DAY_OF_WEEK)))
                      1)]

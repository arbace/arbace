  (method resolveAligned ^ChronoLocalDate [this ^ChronoLocalDate base ^long months ^long weeks
                                           ^:mutable ^long dow]
    (let [^:mutable date (.plus (.plus base months ChronoUnit/MONTHS) weeks ChronoUnit/WEEKS)]
      (if (> dow 7)
          (do
            (set! date
                  (.plus date (unchecked-divide (unchecked-subtract dow 1) 7) ChronoUnit/WEEKS))
            (set! dow (unchecked-add (unchecked-remainder (unchecked-subtract dow 1) 7) 1)))
          (when (< dow 1)
            (set! date
                  (.plus date (unchecked-divide (Math/subtractExact dow 7) 7) ChronoUnit/WEEKS))
            (set! dow (unchecked-add (unchecked-remainder (unchecked-add dow 6) 7) 1))))
      (.with date (TemporalAdjusters/nextOrSame (DayOfWeek/of (unchecked-int dow))))))

  (method addFieldValue ^void [this ^{:tag (Map TemporalField Long)} fieldValues ^ChronoField field
                               ^long value]

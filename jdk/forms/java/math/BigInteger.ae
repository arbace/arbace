          k (unchecked-divide-int (unchecked-add-int len 2) 3)
          r (unchecked-subtract-int len (unchecked-multiply-int 2 k))
          ^:mutable ^BigInteger a0 nil
          ^:mutable ^BigInteger a1 nil
          ^:mutable ^BigInteger a2 nil]

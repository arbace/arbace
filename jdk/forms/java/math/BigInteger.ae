  (method ^:private exactDivideBy3 ^BigInteger [this]
    (let [len (alength mag)
          ^:mutable result (new int/1 len)
          ^:mutable ^long x 0
          ^:mutable ^long w 0
          ^:mutable ^long q 0
          ^:mutable ^long borrow 0]
      (set! borrow 0)
      (loop [^int i (unchecked-subtract-int len 1)]
        (when (>= i 0)
          (set! x (bit-and (aget mag i) LONG_MASK))
          (set! w (unchecked-subtract x borrow))
          (if (> borrow x) (set! borrow 1) (set! borrow 0))
          (set! q (bit-and (unchecked-multiply w 0xAAAAAAAB) LONG_MASK))
          (aset result i (unchecked-int q))
          (if (>= q 0x55555556)

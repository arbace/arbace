                    (.multiply (.subtract (.shiftLeft (.add da1 a2) 1) a0)
                               (.subtract (.shiftLeft (.add db1 b2) 1) b0)
                               true
                               parallel
                               depth))
              (set! vinf (.multiply a2 b2 true parallel depth))
              (set! v0 (cast BigInteger (.join v0_task)))
              (set! vm1 (cast BigInteger (.join vm1_task)))
              (set! v1 (cast BigInteger (.join v1_task)))
              (set! t2 (.exactDivideBy3 (.subtract v2 vm1)))
              (set! tm1 (.shiftRight (.subtract v1 vm1) 1))
              (set! t1 (.subtract v1 v0))
              (set! t2 (.shiftRight (.subtract t2 t1) 1))
              (set! t1 (.subtract (.subtract t1 tm1) vinf))
              (set! t2 (.subtract t2 (.shiftLeft vinf 1)))

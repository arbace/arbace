  (method ^:private getToomSlice ^BigInteger [this ^int lowerSize ^int upperSize ^int slice
                                              ^int fullsize]
    (let [^:mutable ^int start 0
          ^:mutable ^int end 0
          ^:mutable ^int sliceSize 0
          ^:mutable ^int len 0
          ^:mutable ^int offset 0]
      (set! len (alength mag))
      (set! offset (unchecked-subtract-int fullsize len))
      (if (== slice 0)
          (do
            (set! start (unchecked-subtract-int 0 offset))
            (set! end (unchecked-subtract-int (unchecked-subtract-int upperSize 1) offset)))
          (do
            (set! start
                  (unchecked-subtract-int
                    (unchecked-add-int upperSize
                                       (unchecked-multiply-int
                                         (unchecked-subtract-int slice 1)
                                         lowerSize))
                    offset))
            (set! end (unchecked-subtract-int (unchecked-add-int start lowerSize) 1))))
      (when (< start 0) (set! start 0))
      (if (< end 0)
          ZERO
          (do
            (set! sliceSize (unchecked-add-int (unchecked-subtract-int end start) 1))
            (cond
              (<= sliceSize 0) ZERO
              (and (== start 0) (>= sliceSize len)) (.abs this)
              :else

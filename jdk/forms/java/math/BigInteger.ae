                (when-not isRecursion
                  (when (> (.magBitLength this)
                           (unchecked-multiply-int
                             (unchecked-divide-int Integer/SIZE 2)
                             MAX_MAG_LENGTH))
                    (BigInteger/reportOverflow)))
                (.squareToomCook3 this parallel depth))))))

  (method ^:private ^:static ^:final squareToLen ^int/1 [^int/1 x ^int len ^:mutable ^int/1 z]
    (let [zlen (bit-shift-left-int len 1)]
      (when (or (nil? z) (< (alength z) zlen)) (set! z (new int/1 zlen)))
      (BigInteger/implSquareToLenChecks x len z zlen)
      (BigInteger/implSquareToLen x len z zlen)))

  (method ^:private ^:static implSquareToLenChecks :throws [RuntimeException] ^void [^int/1 x
                                                                                     ^int len
                                                                                     ^int/1 z
                                                                                     ^int zlen]
    (when (< len 1) (throw (IllegalArgumentException. (java-str "invalid input length: " len))))
    (when (> len (alength x))
      (throw (IllegalArgumentException.
               (java-str "input length out of bound: " len " > " (alength x)))))
    (when (> (unchecked-multiply-int len 2) (alength z))
      (throw (IllegalArgumentException.
               (java-str "input length out of bound: "
                         (unchecked-multiply-int len 2)
                         " > "
                         (alength z)))))
    (when (< zlen 1) (throw (IllegalArgumentException. (java-str "invalid input length: " zlen))))
    (when (> zlen (alength z))
      (throw (IllegalArgumentException.
               (java-str "input length out of bound: " len " > " (alength z))))))

  (method ^:private ^:static ^:final ^{IntrinsicCandidate true} implSquareToLen ^int/1 [^int/1 x
                                                                                        ^int len
                                                                                        ^int/1 z
                                                                                        ^int zlen]
    (let [^:mutable ^int lastProductLowWord 0]
      (let [^:mutable ^int j 0
            ^:mutable ^int i 0]
        (while (< j len)
          (let [piece (bit-and (aget x j) LONG_MASK)
                product (unchecked-multiply piece piece)]
            (aset z
                  i
                  (bit-or-int (bit-shift-left-int lastProductLowWord 31)
                              (unchecked-int (unsigned-bit-shift-right product 33))))
            (set! i (unchecked-inc-int i))
            (aset z i (unchecked-int (unsigned-bit-shift-right product 1)))
            (set! i (unchecked-inc-int i))
            (set! lastProductLowWord (unchecked-int product)))
          (set! j (unchecked-inc-int j))))
      (loop [^int i len
             ^int offset 1]
        (when (> i 0)
          (let [^:mutable t (aget x (unchecked-subtract-int i 1))]
            (set! t (BigInteger/mulAdd z x offset (unchecked-subtract-int i 1) t))
            (BigInteger/addOne z (unchecked-subtract-int offset 1) i t)
            (recur (unchecked-dec-int i) (unchecked-add-int offset 2)))))
      (BigInteger/primitiveLeftShift z zlen 1)

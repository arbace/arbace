  (method ^:private ^:static multiplyToomCook3 ^BigInteger [^BigInteger a ^BigInteger b
                                                            ^boolean parallel ^:mutable ^int depth]
    (let [alen (alength (.-mag a))
          blen (alength (.-mag b))
          largest (Math/max alen blen)
          k (unchecked-divide-int (unchecked-add-int largest 2) 3)
          r (unchecked-subtract-int largest (unchecked-multiply-int 2 k))
          ^:mutable ^BigInteger a0 nil
          ^:mutable ^BigInteger a1 nil
          ^:mutable ^BigInteger a2 nil
          ^:mutable ^BigInteger b0 nil
          ^:mutable ^BigInteger b1 nil
          ^:mutable ^BigInteger b2 nil]
      (set! a2 (.getToomSlice a k r 0 largest))
      (set! a1 (.getToomSlice a k r 1 largest))
      (set! a0 (.getToomSlice a k r 2 largest))
      (set! b2 (.getToomSlice b k r 0 largest))
      (set! b1 (.getToomSlice b k r 1 largest))
      (set! b0 (.getToomSlice b k r 2 largest))
      (let [^:mutable ^BigInteger v0 nil
            ^:mutable ^BigInteger v1 nil
            ^:mutable ^BigInteger v2 nil
            ^:mutable ^BigInteger vm1 nil
            ^:mutable ^BigInteger vinf nil
            ^:mutable ^BigInteger t1 nil
            ^:mutable ^BigInteger t2 nil
            ^:mutable ^BigInteger tm1 nil
            ^:mutable ^BigInteger da1 nil
            ^:mutable ^BigInteger db1 nil]

  (method ^:private getUpper ^BigInteger [this ^int n]
    (let [len (alength mag)]
      (if (<= len n)
          ZERO
          (let [upperLen (unchecked-subtract-int len n)
                upperInts (new int/1 upperLen)]
            (System/arraycopy mag 0 upperInts 0 upperLen)
            (BigInteger. (BigInteger/trustedStripLeadingZeroInts upperInts) 1)))))

  (method ^:private square ^BigInteger [this]
    (.square this false false 0))

  (method ^:private square ^BigInteger [this ^boolean isRecursion ^boolean parallel ^int depth]

  (method ^:private ^:static divideSmallFastPath ^BigDecimal [^:final ^long xs ^int xscale
                                                              ^:final ^long ys ^:mutable ^int yscale
                                                              ^long preferredScale ^MathContext mc]
    (let [mcp (.-precision mc)
          roundingMode (.-oldMode (.-roundingMode mc))]
      (java-assert (and (and (<= xscale yscale) (< yscale 18)) (< mcp 18)))

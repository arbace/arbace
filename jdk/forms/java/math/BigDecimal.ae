                          (cond
                            (not (== r 0))
                              (let [increment (BigDecimal/needIncrement
                                                (unsigned-bit-shift-right divisor shift)
                                                roundingMode
                                                sign
                                                q
                                                r)]
                                (BigDecimal/valueOf (if increment (unchecked-add q sign) q) scale))
                            (not (== preferredScale scale))
                              (BigDecimal/createAndStripZerosToMatchScale q scale preferredScale)
                            :else (BigDecimal/valueOf q scale))))))))))))


                          (set! quotient
                                (BigDecimal/divideAndRound
                                  rb
                                  ys
                                  scl
                                  roundingMode
                                  (BigDecimal/checkScaleNonZero preferredScale))))
                        (set! quotient
                              (BigDecimal/divideAndRound

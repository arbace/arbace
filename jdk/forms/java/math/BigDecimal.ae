  (method ^:private ^:static unsignedLongCompare ^boolean [^long one ^long two]
    (> (unchecked-add one Long/MIN_VALUE) (unchecked-add two Long/MIN_VALUE)))

  (method ^:private ^:static unsignedLongCompareEq ^boolean [^long one ^long two]
    (>= (unchecked-add one Long/MIN_VALUE) (unchecked-add two Long/MIN_VALUE)))

  (method ^:private ^:static compareMagnitudeNormalized ^int [^:mutable ^long xs ^int xscale
                                                              ^:mutable ^long ys ^int yscale]
    (let [sdiff (unchecked-subtract-int xscale yscale)]
      (when-not (== sdiff 0)
        (if (< sdiff 0)
            (set! xs (BigDecimal/longMultiplyPowerTen xs (unchecked-negate-int sdiff)))
            (set! ys (BigDecimal/longMultiplyPowerTen ys sdiff))))
      (if (not (== xs INFLATED))
          (if (not (== ys INFLATED)) (BigDecimal/longCompareMagnitude xs ys) -1)
          1)))

  (method ^:private ^:static compareMagnitudeNormalized ^int [^long xs ^int xscale ^BigInteger ys
                                                              ^int yscale]
    (if (== xs 0)
        -1
        (let [sdiff (unchecked-subtract-int xscale yscale)]
          (when (< sdiff 0)
            (when (== (BigDecimal/longMultiplyPowerTen xs (unchecked-negate-int sdiff)) INFLATED)
              (return (.compareMagnitude
                        (BigDecimal/bigMultiplyPowerTen xs (unchecked-negate-int sdiff))
                        ys))))
          -1)))

  (method ^:private ^:static compareMagnitudeNormalized ^int [^BigInteger xs ^int xscale
                                                              ^BigInteger ys ^int yscale]
    (let [sdiff (unchecked-subtract-int xscale yscale)]
      (if (< sdiff 0)
          (.compareMagnitude (BigDecimal/bigMultiplyPowerTen xs (unchecked-negate-int sdiff)) ys)
          (.compareMagnitude xs (BigDecimal/bigMultiplyPowerTen ys sdiff)))))

  (method ^:private ^:static multiply ^long [^long x ^long y]
    (let [product (unchecked-multiply x y)
          ax (Math/abs x)
          ay (Math/abs y)]
      (if (or (or (== (unsigned-bit-shift-right (bit-or ax ay) 31) 0) (== y 0))
              (== (unchecked-divide product y) x))
          product
          INFLATED)))

  (method ^:private ^:static multiply ^BigDecimal [^long x ^long y ^int scale]
    (let [product (BigDecimal/multiply x y)]
      (if (not (== product INFLATED))
          (BigDecimal/valueOf product scale)
          (BigDecimal. (.multiply (BigInteger/valueOf x) y) INFLATED scale 0))))

  (method ^:private ^:static multiply ^BigDecimal [^long x ^BigInteger y ^int scale]
    (if (== x 0) (BigDecimal/zeroValueOf scale) (BigDecimal. (.multiply y x) INFLATED scale 0)))

  (method ^:private ^:static multiply ^BigDecimal [^BigInteger x ^BigInteger y ^int scale]
    (BigDecimal. (.multiply x y) INFLATED scale 0))

  (method ^:private ^:static multiplyAndRound ^BigDecimal [^:mutable ^long x ^:mutable ^long y
                                                           ^int scale ^MathContext mc]
    (let [^:mutable product (BigDecimal/multiply x y)]
      (if (not (== product INFLATED))
          (BigDecimal/doRound product scale mc)
          (let [^:mutable ^int rsign 1]
            (when (< x 0) (set! x (unchecked-negate x)) (set! rsign -1))
            (when (< y 0)
              (set! y (unchecked-negate y))
              (set! rsign (unchecked-multiply-int rsign -1)))
            (let [m0_hi (unsigned-bit-shift-right x 32)
                  m0_lo (bit-and x BigInteger/LONG_MASK)
                  m1_hi (unsigned-bit-shift-right y 32)
                  m1_lo (bit-and y BigInteger/LONG_MASK)]
              (set! product (unchecked-multiply m0_lo m1_lo))
              (let [m0 (bit-and product BigInteger/LONG_MASK)
                    ^:mutable m1 (unsigned-bit-shift-right product 32)]
                (set! product (unchecked-add (unchecked-multiply m0_hi m1_lo) m1))
                (set! m1 (bit-and product BigInteger/LONG_MASK))
                (let [^:mutable m2 (unsigned-bit-shift-right product 32)]
                  (set! product (unchecked-add (unchecked-multiply m0_lo m1_hi) m1))
                  (set! m1 (bit-and product BigInteger/LONG_MASK))
                  (set! m2 (unchecked-add m2 (unsigned-bit-shift-right product 32)))
                  (let [^:mutable m3 (unsigned-bit-shift-right m2 32)]
                    (set! m2 (bit-and m2 BigInteger/LONG_MASK))
                    (set! product (unchecked-add (unchecked-multiply m0_hi m1_hi) m2))
                    (set! m2 (bit-and product BigInteger/LONG_MASK))
                    (set! m3
                          (bit-and (unchecked-add (unsigned-bit-shift-right product 32) m3)
                                   BigInteger/LONG_MASK))
                    (let [mHi (BigDecimal/make64 m3 m2)
                          mLo (BigDecimal/make64 m1 m0)
                          ^:mutable res (BigDecimal/doRound128 mHi mLo rsign scale mc)]
                      (if (some? res)
                          res
                          (do
                            (set! res
                                  (BigDecimal. (.multiply
                                                 (BigInteger/valueOf x)
                                                 (unchecked-multiply y rsign))
                                               INFLATED
                                               scale
                                               0))
                            (BigDecimal/doRound res mc))))))))))))

  (method ^:private ^:static multiplyAndRound ^BigDecimal [^long x ^BigInteger y ^int scale
                                                           ^MathContext mc]
    (if (== x 0) (BigDecimal/zeroValueOf scale) (BigDecimal/doRound (.multiply y x) scale mc)))

  (method ^:private ^:static multiplyAndRound ^BigDecimal [^BigInteger x ^BigInteger y ^int scale
                                                           ^MathContext mc]
    (BigDecimal/doRound (.multiply x y) scale mc))

  (method ^:private ^:static doRound128 ^BigDecimal [^long hi ^long lo ^int sign
                                                     ^:mutable ^int scale ^MathContext mc]
    (let [mcp (.-precision mc)
          ^:mutable ^int drop 0
          ^:mutable ^BigDecimal res nil]
      (when (and (> (set! drop (unchecked-subtract-int (BigDecimal/precision hi lo) mcp)) 0)
                 (< drop (alength LONG_TEN_POWERS_TABLE)))
        (set! scale (BigDecimal/checkScaleNonZero (unchecked-subtract (long scale) drop)))
        (set! res
              (BigDecimal/divideAndRound128 hi
                                            lo
                                            (aget LONG_TEN_POWERS_TABLE drop)
                                            sign
                                            scale
                                            (.-oldMode (.-roundingMode mc))
                                            scale)))
      (when (some? res) (BigDecimal/doRound res mc))))

  (field ^:private ^:static ^:final ^{Stable true} ^long/2 LONGLONG_TEN_POWERS_TABLE
    (new long/2
         [[0 (unchecked-long 0x8AC7230489E80000)]
          [0x5 0x6bc75e2d63100000]
          [0x36 0x35c9adc5dea00000]
          [0x21e 0x19e0c9bab2400000]
          [0x152d 0x02c7e14af6800000]
          [0xd3c2 0x1bcecceda1000000]
          [0x84595 0x161401484a000000]
          [0x52b7d2 (unchecked-long 0xdcc80cd2e4000000)]
          [0x33b2e3c (unchecked-long 0x9fd0803ce8000000)]
          [0x204fce5e 0x3e25026110000000]
          [0x1431e0fae 0x6d7217caa0000000]
          [0xc9f2c9cd0 0x4674edea40000000]
          [0x7e37be2022 (unchecked-long 0xc0914b2680000000)]
          [0x4ee2d6d415b (unchecked-long 0x85acef8100000000)]
          [0x314dc6448d93 0x38c15b0a00000000]
          [0x1ed09bead87c0 0x378d8e6400000000]
          [0x13426172c74d82 0x2b878fe800000000]
          [0xc097ce7bc90715 (unchecked-long 0xb34b9f1000000000)]
          [0x785ee10d5da46d9 0x00f436a000000000]
          [0x4b3b4ca85a86c47a 0x098a224000000000]]))

  (method ^:private ^:static precision ^int [^long hi ^long lo]
    (if (== hi 0)
        (cond
          (>= lo 0) (BigDecimal/longDigitLength lo)
          (BigDecimal/unsignedLongCompareEq lo (aget LONGLONG_TEN_POWERS_TABLE 0 1)) 20
          :else 19)
        (let [r (unsigned-bit-shift-right-int
                  (unchecked-multiply-int
                    (unchecked-add-int (unchecked-subtract-int 128 (Long/numberOfLeadingZeros hi))
                                       1)
                    1233)
                  12)
              idx (unchecked-subtract-int r 19)]
          (if (or (>= idx (alength LONGLONG_TEN_POWERS_TABLE))
                  (BigDecimal/longLongCompareMagnitude
                    hi
                    lo
                    (aget LONGLONG_TEN_POWERS_TABLE idx 0)
                    (aget LONGLONG_TEN_POWERS_TABLE idx 1)))
              r
              (unchecked-add-int r 1)))))

  (method ^:private ^:static longLongCompareMagnitude ^boolean [^long hi0 ^long lo0 ^long hi1
                                                                ^long lo1]
    (if (not (== hi0 hi1))
        (< hi0 hi1)
        (< (unchecked-add lo0 Long/MIN_VALUE) (unchecked-add lo1 Long/MIN_VALUE))))

  (method ^:private ^:static divide ^BigDecimal [^long dividend ^int dividendScale ^long divisor
                                                 ^int divisorScale ^int scale ^int roundingMode]
    (if (> (BigDecimal/checkScale dividend (unchecked-add (long scale) divisorScale)) dividendScale)
        (let [newScale (unchecked-add-int scale divisorScale)
              raise (unchecked-subtract-int newScale dividendScale)]
          (when (< raise (alength LONG_TEN_POWERS_TABLE))
            (let [^:mutable xs dividend]
              (when-not (== (set! xs (BigDecimal/longMultiplyPowerTen xs raise)) INFLATED)
                (return (BigDecimal/divideAndRound xs divisor scale roundingMode scale)))
              (let [q (BigDecimal/multiplyDivideAndRound
                        (aget LONG_TEN_POWERS_TABLE raise)
                        dividend
                        divisor
                        scale
                        roundingMode
                        scale)]
                (when (some? q) (return q)))))
          (let [scaledDividend (BigDecimal/bigMultiplyPowerTen dividend raise)]
            (BigDecimal/divideAndRound scaledDividend divisor scale roundingMode scale)))
        (let [newScale (BigDecimal/checkScale divisor
                                              (unchecked-subtract (long dividendScale) scale))
              raise (unchecked-subtract-int newScale divisorScale)]
          (when (< raise (alength LONG_TEN_POWERS_TABLE))
            (let [^:mutable ys divisor]
              (when-not (== (set! ys (BigDecimal/longMultiplyPowerTen ys raise)) INFLATED)
                (return (BigDecimal/divideAndRound dividend ys scale roundingMode scale)))))
          (let [scaledDivisor (BigDecimal/bigMultiplyPowerTen divisor raise)]
            (BigDecimal/divideAndRound (BigInteger/valueOf dividend)
                                       scaledDivisor
                                       scale
                                       roundingMode
                                       scale)))))

  (method ^:private ^:static divide ^BigDecimal [^BigInteger dividend ^int dividendScale
                                                 ^long divisor ^int divisorScale ^int scale
                                                 ^int roundingMode]
    (if (> (BigDecimal/checkScale dividend (unchecked-add (long scale) divisorScale)) dividendScale)
        (let [newScale (unchecked-add-int scale divisorScale)
              raise (unchecked-subtract-int newScale dividendScale)
              scaledDividend (BigDecimal/bigMultiplyPowerTen dividend raise)]
          (BigDecimal/divideAndRound scaledDividend divisor scale roundingMode scale))
        (let [newScale (BigDecimal/checkScale divisor
                                              (unchecked-subtract (long dividendScale) scale))
              raise (unchecked-subtract-int newScale divisorScale)]
          (when (< raise (alength LONG_TEN_POWERS_TABLE))
            (let [^:mutable ys divisor]
              (when-not (== (set! ys (BigDecimal/longMultiplyPowerTen ys raise)) INFLATED)
                (return (BigDecimal/divideAndRound dividend ys scale roundingMode scale)))))
          (let [scaledDivisor (BigDecimal/bigMultiplyPowerTen divisor raise)]
            (BigDecimal/divideAndRound dividend scaledDivisor scale roundingMode scale)))))


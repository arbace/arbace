                                            scale
                                            roundingMode
                                            preferredScale)))))))

  (field ^:private ^:static ^:final ^long DIV_NUM_BASE (bit-shift-left 1 32))

  (method ^:private ^:static divideAndRound128 ^BigDecimal [^:final ^long dividendHi
                                                            ^:final ^long dividendLo
                                                            ^:mutable ^long divisor ^int sign
                                                            ^int scale ^int roundingMode
                                                            ^int preferredScale]
    (when-not (>= dividendHi divisor)
      (let [shift (Long/numberOfLeadingZeros divisor)]
        (set! divisor (bit-shift-left divisor shift))
        (let [v1 (unsigned-bit-shift-right divisor 32)
              v0 (bit-and divisor BigInteger/LONG_MASK)
              ^:mutable tmp (bit-shift-left dividendLo shift)
              ^:mutable u1 (unsigned-bit-shift-right tmp 32)
              u0 (bit-and tmp BigInteger/LONG_MASK)]
          (set! tmp
                (bit-or (bit-shift-left dividendHi shift)
                        (unsigned-bit-shift-right dividendLo (unchecked-subtract-int 64 shift))))
          (let [u2 (bit-and tmp BigInteger/LONG_MASK)
                ^:mutable q1 (Long/divideUnsigned tmp v1)
                ^:mutable r_tmp (Long/remainderUnsigned tmp v1)]
            (while (or (>= q1 DIV_NUM_BASE)
                       (BigDecimal/unsignedLongCompare
                         (unchecked-multiply q1 v0)
                         (BigDecimal/make64 r_tmp u1)))
              (set! q1 (unchecked-dec q1))
              (set! r_tmp (unchecked-add r_tmp v1))
              (when (>= r_tmp DIV_NUM_BASE) (break)))
            (set! tmp (BigDecimal/mulsub u2 u1 v1 v0 q1))
            (set! u1 (bit-and tmp BigInteger/LONG_MASK))
            (let [^:mutable q0 (Long/divideUnsigned tmp v1)]
              (set! r_tmp (Long/remainderUnsigned tmp v1))
              (while (or (>= q0 DIV_NUM_BASE)
                         (BigDecimal/unsignedLongCompare
                           (unchecked-multiply q0 v0)
                           (BigDecimal/make64 r_tmp u0)))
                (set! q0 (unchecked-dec q0))
                (set! r_tmp (unchecked-add r_tmp v1))
                (when (>= r_tmp DIV_NUM_BASE) (break)))
              (if (< (unchecked-int q1) 0)
                  (let [mq (MutableBigInteger. (new int/1 [(unchecked-int q1) (unchecked-int q0)]))]
                    (if (and (== roundingMode ROUND_DOWN) (== scale preferredScale))
                        (.toBigDecimal mq sign scale)
                        (let [r (unsigned-bit-shift-right (BigDecimal/mulsub u1 u0 v1 v0 q0) shift)]
                          (cond
                            (not (== r 0))
                              (do
                                (when (BigDecimal/needIncrement
                                        (unsigned-bit-shift-right divisor shift)
                                        roundingMode
                                        sign
                                        mq
                                        r)
                                  (.add mq MutableBigInteger/ONE))
                                (.toBigDecimal mq sign scale))
                            (not (== preferredScale scale))
                              (let [intVal (.toBigInteger mq sign)]
                                (BigDecimal/createAndStripZerosToMatchScale
                                  intVal
                                  scale
                                  preferredScale))
                            :else (.toBigDecimal mq sign scale)))))
                  (let [^:mutable q (BigDecimal/make64 q1 q0)]
                    (set! q (unchecked-multiply q sign))
                    (if (and (== roundingMode ROUND_DOWN) (== scale preferredScale))
                        (BigDecimal/valueOf q scale)

  (method ^:private ^:static multiplyDivideAndRound ^BigDecimal [^:mutable ^long dividend0
                                                                 ^:mutable ^long dividend1
                                                                 ^:mutable ^long divisor ^int scale
                                                                 ^int roundingMode
                                                                 ^int preferredScale]

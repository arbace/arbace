        (let [diff (unchecked-subtract-int scale preferredScale)]
          (if (< diff raise)
              (BigDecimal/scaledTenPow (unchecked-subtract-int raise diff) qsign preferredScale)
              (BigDecimal/valueOf qsign (unchecked-subtract-int scale raise))))
        (BigDecimal/scaledTenPow raise qsign scale)))

  (method ^:static scaledTenPow ^BigDecimal [^int n ^int sign ^int scale]
    (if (< n (alength LONG_TEN_POWERS_TABLE))
        (BigDecimal/valueOf (unchecked-multiply sign (aget LONG_TEN_POWERS_TABLE n)) scale)
        (let [^:mutable unscaledVal (BigDecimal/bigTenToThe n)]
          (when (== sign -1) (set! unscaledVal (.negate unscaledVal)))
          (BigDecimal. unscaledVal INFLATED scale (unchecked-add-int n 1)))))

  (method ^:private ^:static make64 ^long [^long hi ^long lo]
    (bit-or (bit-shift-left hi 32) lo))

  (method ^:private ^:static mulsub ^long [^long u1 ^long u0 ^:final ^long v1 ^:final ^long v0

                                         scaledX
                                         (unchecked-subtract-int mcp 1))]
                                (set! quotient
                                      (BigDecimal/divideAndRound
                                        rb
                                        ys
                                        scl
                                        roundingMode
                                        (BigDecimal/checkScaleNonZero preferredScale))))))
                          (set! quotient
                                (BigDecimal/divideAndRound
                                  scaledXs
                                  ys
                                  scl
                                  roundingMode
                                  (BigDecimal/checkScaleNonZero preferredScale)))))

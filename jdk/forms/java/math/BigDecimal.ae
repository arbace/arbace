      (set! dividend1 (Math/abs dividend1))
      (set! divisor (Math/abs divisor))
      (let [d0_hi (unsigned-bit-shift-right dividend0 32)
            d0_lo (bit-and dividend0 BigInteger/LONG_MASK)
            d1_hi (unsigned-bit-shift-right dividend1 32)
            d1_lo (bit-and dividend1 BigInteger/LONG_MASK)
            ^:mutable product (unchecked-multiply d0_lo d1_lo)
            d0 (bit-and product BigInteger/LONG_MASK)
            ^:mutable d1 (unsigned-bit-shift-right product 32)]

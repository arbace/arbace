      (not (== (.-intCompact this) INFLATED))
        (if (not (== (.-intCompact augend) INFLATED))
            (BigDecimal/add (.-intCompact this)
                            (.-scale this)
                            (.-intCompact augend)
                            (.-scale augend))
            (BigDecimal/add (.-intCompact this) (.-scale this) (.-intVal augend) (.-scale augend)))
      (not (== (.-intCompact augend) INFLATED))
        (BigDecimal/add (.-intCompact augend) (.-scale augend) (.-intVal this) (.-scale this))
      :else (BigDecimal/add (.-intVal this) (.-scale this) (.-intVal augend) (.-scale augend))))

  (method ^:public add ^BigDecimal [this ^:mutable ^BigDecimal augend ^MathContext mc]
    (if (== (.-precision mc) 0)
        (.add this augend)
        (let [^:mutable lhs this]
          (let [lhsIsZero (== (.signum lhs) 0)
                augendIsZero (== (.signum augend) 0)]
            (when (or lhsIsZero augendIsZero)
              (let [preferredScale (Math/max (.scale lhs) (.scale augend))
                    ^:mutable ^BigDecimal result nil]
                (when (and lhsIsZero augendIsZero) (return (BigDecimal/zeroValueOf preferredScale)))
                (set! result
                      (if lhsIsZero (BigDecimal/doRound augend mc) (BigDecimal/doRound lhs mc)))
                (cond
                  (== (.scale result) preferredScale) (return result)
                  (> (.scale result) preferredScale)
                    (return (BigDecimal/stripZerosToMatchScale
                              (.-intVal result)
                              (.-intCompact result)
                              (.-scale result)
                              preferredScale))
                  :else
                    (let [precisionDiff (unchecked-subtract-int
                                          (.-precision mc)
                                          (.precision result))
                          scaleDiff (unchecked-subtract-int preferredScale (.scale result))]
                      (if (>= precisionDiff scaleDiff)
                          (return (.setScale result preferredScale))
                          (return (.setScale result
                                             (unchecked-add-int (.scale result) precisionDiff)))))))))
          (let [padding (unchecked-subtract (long (.-scale lhs)) (.-scale augend))]
            (when-not (== padding 0)
              (let [arg (.preAlign this lhs augend padding mc)]
                (BigDecimal/matchScale arg)
                (set! lhs (aget arg 0))
                (set! augend (aget arg 1))))
            (BigDecimal/doRound (.add (.inflated lhs) (.inflated augend)) (.-scale lhs) mc)))))

  (method ^:private preAlign ^BigDecimal/1 [this ^BigDecimal lhs ^BigDecimal augend ^long padding
                                            ^MathContext mc]
    (java-assert (not (== padding 0)))
    (let [^:mutable ^BigDecimal big nil
          ^:mutable ^BigDecimal small nil]
      (if (< padding 0)
          (do (set! big lhs) (set! small augend))
          (do (set! big augend) (set! small lhs)))
      (let [estResultUlpScale (unchecked-add
                                (unchecked-subtract (long (.-scale big)) (.precision big))
                                (.-precision mc))
            smallHighDigitPos (unchecked-add
                                (unchecked-subtract (long (.-scale small)) (.precision small))
                                1)]
        (when (and (> smallHighDigitPos (unchecked-add-int (.-scale big) 2))
                   (> smallHighDigitPos (unchecked-add estResultUlpScale 2)))
          (set!
            small
            (BigDecimal/valueOf (.signum small)
                                (.checkScale this
                                             (unchecked-add
                                               (Math/max (.-scale big) estResultUlpScale)
                                               3)))))
        (let [result (new BigDecimal/1 [big small])] result))))

  (method ^:public subtract ^BigDecimal [this ^BigDecimal subtrahend]
    (cond
      (not (== (.-intCompact this) INFLATED))
        (if (not (== (.-intCompact subtrahend) INFLATED))
            (BigDecimal/add (.-intCompact this)
                            (.-scale this)
                            (unchecked-negate (.-intCompact subtrahend))
                            (.-scale subtrahend))
            (BigDecimal/add (.-intCompact this)
                            (.-scale this)
                            (.negate (.-intVal subtrahend))
                            (.-scale subtrahend)))
      (not (== (.-intCompact subtrahend) INFLATED))
        (BigDecimal/add (unchecked-negate (.-intCompact subtrahend))
                        (.-scale subtrahend)
                        (.-intVal this)
                        (.-scale this))
      :else
        (BigDecimal/add (.-intVal this)
                        (.-scale this)
                        (.negate (.-intVal subtrahend))
                        (.-scale subtrahend))))

  (method ^:public subtract ^BigDecimal [this ^BigDecimal subtrahend ^MathContext mc]
    (if (== (.-precision mc) 0) (.subtract this subtrahend) (.add this (.negate subtrahend) mc)))

  (method ^:public multiply ^BigDecimal [this ^BigDecimal multiplicand]
    (let [productScale (.checkScale this (unchecked-add (long scale) (.-scale multiplicand)))]
      (cond
        (not (== (.-intCompact this) INFLATED))
          (if (not (== (.-intCompact multiplicand) INFLATED))
              (BigDecimal/multiply (.-intCompact this) (.-intCompact multiplicand) productScale)
              (BigDecimal/multiply (.-intCompact this) (.-intVal multiplicand) productScale))
        (not (== (.-intCompact multiplicand) INFLATED))
          (BigDecimal/multiply (.-intCompact multiplicand) (.-intVal this) productScale)
        :else (BigDecimal/multiply (.-intVal this) (.-intVal multiplicand) productScale))))

  (method ^:public multiply ^BigDecimal [this ^BigDecimal multiplicand ^MathContext mc]
    (if (== (.-precision mc) 0)
        (.multiply this multiplicand)
        (let [productScale (.checkScale this (unchecked-add (long scale) (.-scale multiplicand)))]
          (cond
            (not (== (.-intCompact this) INFLATED))
              (if (not (== (.-intCompact multiplicand) INFLATED))
                  (BigDecimal/multiplyAndRound (.-intCompact this)
                                               (.-intCompact multiplicand)
                                               productScale
                                               mc)
                  (BigDecimal/multiplyAndRound (.-intCompact this)
                                               (.-intVal multiplicand)
                                               productScale
                                               mc))
            (not (== (.-intCompact multiplicand) INFLATED))
              (BigDecimal/multiplyAndRound (.-intCompact multiplicand)
                                           (.-intVal this)
                                           productScale
                                           mc)
            :else
              (BigDecimal/multiplyAndRound (.-intVal this) (.-intVal multiplicand) productScale mc)))))

  (method ^:public ^{Deprecated {:since "9"}} divide ^BigDecimal [this ^BigDecimal divisor
                                                                  ^int scale ^int roundingMode]
    (when (or (< roundingMode ROUND_UP) (> roundingMode ROUND_UNNECESSARY))
      (throw (IllegalArgumentException. "Invalid rounding mode")))
    (cond
      (not (== (.-intCompact this) INFLATED))
        (if (not (== (.-intCompact divisor) INFLATED))
            (BigDecimal/divide (.-intCompact this)
                               (.-scale this)
                               (.-intCompact divisor)
                               (.-scale divisor)
                               scale
                               roundingMode)
            (BigDecimal/divide (.-intCompact this)
                               (.-scale this)
                               (.-intVal divisor)
                               (.-scale divisor)
                               scale
                               roundingMode))
      (not (== (.-intCompact divisor) INFLATED))
        (BigDecimal/divide (.-intVal this)
                           (.-scale this)
                           (.-intCompact divisor)
                           (.-scale divisor)
                           scale
                           roundingMode)
      :else
        (BigDecimal/divide (.-intVal this)
                           (.-scale this)
                           (.-intVal divisor)
                           (.-scale divisor)
                           scale
                           roundingMode)))

  (method ^:public divide ^BigDecimal [this ^BigDecimal divisor ^int scale
                                       ^RoundingMode roundingMode]
    (.divide this divisor scale (.-oldMode roundingMode)))

  (method ^:public ^{Deprecated {:since "9"}} divide ^BigDecimal [this ^BigDecimal divisor
                                                                  ^int roundingMode]
    (.divide this divisor scale roundingMode))

  (method ^:public divide ^BigDecimal [this ^BigDecimal divisor ^RoundingMode roundingMode]
    (.divide this divisor scale (.-oldMode roundingMode)))

  (method ^:public divide ^BigDecimal [this ^BigDecimal divisor]
    (when (== (.signum divisor) 0)
      (when (== (.signum this) 0) (throw (ArithmeticException. "Division undefined")))
      (throw (ArithmeticException. "Division by zero")))
    (let [preferredScale (BigDecimal/saturateLong
                           (unchecked-subtract (long (.-scale this)) (.-scale divisor)))]
      (if (== (.signum this) 0)
          (BigDecimal/zeroValueOf preferredScale)
          (let [mc (MathContext. (unchecked-int
                                   (Math/min (unchecked-add
                                               (.precision this)
                                               (unchecked-long
                                                 (Math/ceil
                                                   (unchecked-divide
                                                     (unchecked-multiply 10.0 (.precision divisor))
                                                     3.0))))
                                             Integer/MAX_VALUE))
                                 RoundingMode/UNNECESSARY)
                ^:mutable ^BigDecimal quotient nil]
            (try
              (set! quotient (.divide this divisor mc))
              (catch ArithmeticException e
                (throw
                  (ArithmeticException.
                    "Non-terminating decimal expansion; no exact representable decimal result."))))
            (let [quotientScale (.scale quotient)]
              (if (> preferredScale quotientScale)
                  (.setScale quotient preferredScale ROUND_UNNECESSARY)
                  quotient))))))

  (method ^:public divide ^BigDecimal [this ^BigDecimal divisor ^MathContext mc]
    (let [mcp (.-precision mc)]
      (if (== mcp 0)
          (.divide this divisor)
          (let [dividend this
                preferredScale (unchecked-subtract (long (.-scale dividend)) (.-scale divisor))]
            (when (== (.signum divisor) 0)
              (when (== (.signum dividend) 0) (throw (ArithmeticException. "Division undefined")))
              (throw (ArithmeticException. "Division by zero")))
            (if (== (.signum dividend) 0)
                (BigDecimal/zeroValueOf (BigDecimal/saturateLong preferredScale))
                (let [xscale (.precision dividend)
                      yscale (.precision divisor)]
                  (cond
                    (not (== (.-intCompact dividend) INFLATED))
                      (if (not (== (.-intCompact divisor) INFLATED))
                          (BigDecimal/divide (.-intCompact dividend)
                                             xscale
                                             (.-intCompact divisor)
                                             yscale
                                             preferredScale
                                             mc)
                          (BigDecimal/divide (.-intCompact dividend)
                                             xscale
                                             (.-intVal divisor)
                                             yscale
                                             preferredScale
                                             mc))
                    (not (== (.-intCompact divisor) INFLATED))
                      (BigDecimal/divide (.-intVal dividend)
                                         xscale
                                         (.-intCompact divisor)
                                         yscale
                                         preferredScale
                                         mc)
                    :else
                      (BigDecimal/divide (.-intVal dividend)
                                         xscale
                                         (.-intVal divisor)
                                         yscale
                                         preferredScale
                                         mc))))))))

  (method ^:public divideToIntegralValue ^BigDecimal [this ^BigDecimal divisor]
    (let [preferredScale (BigDecimal/saturateLong
                           (unchecked-subtract (long (.-scale this)) (.-scale divisor)))]
      (cond
        (< (.compareMagnitude this divisor) 0) (BigDecimal/zeroValueOf preferredScale)
        (and (== (.signum this) 0) (not (== (.signum divisor) 0)))
          (.setScale this preferredScale ROUND_UNNECESSARY)
        :else
          (let [maxDigits (unchecked-int
                            (Math/min (unchecked-add
                                        (unchecked-add
                                          (unchecked-add
                                            (.precision this)
                                            (unchecked-long
                                              (Math/ceil
                                                (unchecked-divide
                                                  (unchecked-multiply 10.0 (.precision divisor))
                                                  3.0))))
                                          (Math/abs
                                            (unchecked-subtract
                                              (long (.scale this))
                                              (.scale divisor))))
                                        2)
                                      Integer/MAX_VALUE))
                ^:mutable quotient (.divide this divisor (MathContext. maxDigits RoundingMode/DOWN))]
            (when (> (.-scale quotient) 0)
              (set! quotient (.setScale quotient 0 RoundingMode/DOWN))
              (set! quotient
                    (BigDecimal/stripZerosToMatchScale
                      (.-intVal quotient)
                      (.-intCompact quotient)
                      (.-scale quotient)
                      preferredScale)))
            (when (< (.-scale quotient) preferredScale)
              (set! quotient (.setScale quotient preferredScale ROUND_UNNECESSARY)))
            quotient))))

  (method ^:public divideToIntegralValue ^BigDecimal [this ^BigDecimal divisor ^MathContext mc]
    (if (or (== (.-precision mc) 0) (< (.compareMagnitude this divisor) 0))
        (.divideToIntegralValue this divisor)
        (let [preferredScale (BigDecimal/saturateLong
                               (unchecked-subtract (long (.-scale this)) (.-scale divisor)))
              ^:mutable result (.divide this
                                        divisor
                                        (MathContext. (.-precision mc) RoundingMode/DOWN))]
          (cond
            (< (.scale result) 0)
              (let [product (.multiply result divisor)]
                (when (>= (.compareMagnitude (.subtract this product) divisor) 0)
                  (throw (ArithmeticException. "Division impossible"))))
            (> (.scale result) 0) (set! result (.setScale result 0 RoundingMode/DOWN)))
          (let [^:mutable ^int precisionDiff 0]
            (if (and (> preferredScale (.scale result))
                     (> (set! precisionDiff
                              (unchecked-subtract-int (.-precision mc) (.precision result)))
                        0))
                (.setScale result
                           (unchecked-add-int (.scale result)
                                              (Math/min
                                                precisionDiff
                                                (unchecked-subtract-int
                                                  preferredScale
                                                  (.-scale result)))))
                (BigDecimal/stripZerosToMatchScale
                  (.-intVal result)
                  (.-intCompact result)
                  (.-scale result)
                  preferredScale))))))

  (method ^:public remainder ^BigDecimal [this ^BigDecimal divisor]
    (let [divrem (.divideAndRemainder this divisor)] (aget divrem 1)))

  (method ^:public remainder ^BigDecimal [this ^BigDecimal divisor ^MathContext mc]
    (let [divrem (.divideAndRemainder this divisor mc)] (aget divrem 1)))

  (method ^:public divideAndRemainder ^BigDecimal/1 [this ^BigDecimal divisor]
    (let [result (new BigDecimal/1 2)]
      (aset result 0 (.divideToIntegralValue this divisor))
      (aset result 1 (.subtract this (.multiply (aget result 0) divisor)))
      result))

  (method ^:public divideAndRemainder ^BigDecimal/1 [this ^BigDecimal divisor ^MathContext mc]
    (if (== (.-precision mc) 0)
        (.divideAndRemainder this divisor)
        (let [result (new BigDecimal/1 2)
              lhs this]
          (aset result 0 (.divideToIntegralValue lhs divisor mc))
          (aset result 1 (.subtract lhs (.multiply (aget result 0) divisor)))
          result)))

  (method ^:public sqrt ^BigDecimal [this ^MathContext mc]
    (let [signum (.signum this)]
      (when-not (== signum 1)
        (switch signum
          -1 (throw (ArithmeticException. "Attempted square root of negative BigDecimal"))
          0
            (let [result (BigDecimal/valueOf 0 (unchecked-divide-int scale 2))]
              (java-assert (.squareRootResultAssertions this result mc))
              (return result))
          (throw (AssertionError. "Bad value from signum"))))
      (let [preferredScale (^[int int] Math/ceilDiv (.-scale this) 2)
            ^:mutable ^BigDecimal result nil]
        (if (or (identical? (.-roundingMode mc) RoundingMode/UNNECESSARY) (== (.-precision mc) 0))
            (let [stripped (.stripTrailingZeros this)
                  strippedScale (.-scale stripped)]
              (when-not (== (bit-and-int strippedScale 1) 0)
                (throw (ArithmeticException. "Computed square root not exact.")))
              (if (.isPowerOfTen stripped)
                  (do
                    (set! result (BigDecimal/valueOf 1 (bit-shift-right-int strippedScale 1)))
                    (.adjustToPreferredScale result preferredScale (.-precision mc)))
                  (let [sqrtRem (.sqrtAndRemainder (.unscaledValue stripped))]
                    (set! result
                          (BigDecimal. (aget sqrtRem 0) (bit-shift-right-int strippedScale 1)))
                    (when (or (not (== (.-signum (aget sqrtRem 1)) 0))
                              (and (not (== (.-precision mc) 0))
                                   (> (.precision result) (.-precision mc))))
                      (throw (ArithmeticException. "Computed square root not exact.")))
                    (java-assert (.squareRootResultAssertions this result mc))
                    (.adjustToPreferredScale result preferredScale (.-precision mc)))))
            (let [halfWay (BigDecimal/isHalfWay (.-roundingMode mc))
                  minWorkingPrec (unchecked-subtract
                                   (bit-shift-left
                                     (unchecked-add (.-precision mc) (if halfWay 1 0))
                                     1)
                                   1)
                  ^:mutable normScale (unchecked-add
                                        (unchecked-subtract minWorkingPrec (.precision this))
                                        (.-scale this))]
              (set! normScale (unchecked-add normScale (bit-and normScale 1)))
              (let [workingScale (unchecked-subtract (.-scale this) normScale)]
                (when-not (== workingScale (unchecked-int workingScale))
                  (throw (ArithmeticException. "Overflow")))
                (let [working (BigDecimal. (.-intVal this)
                                           (.-intCompact this)
                                           (unchecked-int workingScale)
                                           (.-precision this))
                      workingInt (.toBigInteger working)
                      ^:mutable ^BigInteger sqrt nil
                      ^:mutable resultScale (bit-shift-right normScale 1)]
                  (if halfWay
                      (let [workingSqrt (.sqrt workingInt)
                            quotRem10 (.divideAndRemainder workingSqrt BigInteger/TEN)]
                        (set! sqrt (aget quotRem10 0))
                        (set! resultScale (unchecked-dec resultScale))
                        (let [^:mutable increment false
                              digit (.intValue (aget quotRem10 1))]
                          (cond
                            (> digit 5) (set! increment true)
                            (== digit 5)
                              (when (or (or (or (identical?
                                                  (.-roundingMode mc)
                                                  RoundingMode/HALF_UP)
                                                (and
                                                  (identical?
                                                    (.-roundingMode mc)
                                                    RoundingMode/HALF_EVEN)
                                                  (.testBit sqrt 0)))
                                            (not
                                              (.equals
                                                workingInt
                                                (.multiply workingSqrt workingSqrt))))
                                        (not (.isInteger working)))
                                (set! increment true)))
                          (when increment (set! sqrt (.add sqrt 1)))))
                      (switch (.-roundingMode mc)
                        (DOWN FLOOR) (set! sqrt (.sqrt workingInt))
                        (UP CEILING)
                          (let [sqrtRem (.sqrtAndRemainder workingInt)]
                            (set! sqrt (aget sqrtRem 0))
                            (when (or (not (== (.-signum (aget sqrtRem 1)) 0))
                                      (not (.isInteger working)))
                              (set! sqrt (.add sqrt 1))))
                        (throw (AssertionError.
                                 (java-str "Unexpected value for RoundingMode: "
                                           (.-roundingMode mc))))))
                  (set! result (BigDecimal. sqrt (BigDecimal/checkScale sqrt resultScale) mc))
                  (java-assert (.squareRootResultAssertions this result mc))
                  (when (> (.-scale result) preferredScale)
                    (set! result
                          (BigDecimal/stripZerosToMatchScale
                            (.-intVal result)
                            (.-intCompact result)
                            (.-scale result)
                            preferredScale)))
                  result)))))))

  (method ^:private adjustToPreferredScale ^BigDecimal [this ^int preferredScale ^int maxPrecision]
    (let [^:mutable result this]
      (cond
        (> (.-scale result) preferredScale)
          (set! result
                (BigDecimal/stripZerosToMatchScale
                  (.-intVal result)
                  (.-intCompact result)
                  (.-scale result)
                  preferredScale))
        (< (.-scale result) preferredScale)
          (let [^int maxScale (if (== maxPrecision 0)
                                  preferredScale
                                  (unchecked-int
                                    (Math/min preferredScale
                                              (unchecked-add
                                                (.-scale result)
                                                (long
                                                  (unchecked-subtract-int
                                                    maxPrecision
                                                    (.precision result)))))))]
            (set! result (.setScale result maxScale))))
      result))

  (method ^:private ^:static isHalfWay ^boolean [^RoundingMode m]
    (switch m
      (HALF_DOWN HALF_UP HALF_EVEN) true
      (FLOOR CEILING DOWN UP UNNECESSARY) false
      (throw (MatchException. nil nil))))

  (method ^:private square ^BigDecimal [this] (.multiply this this))

  (method ^:private isPowerOfTen ^boolean [this]
    (.equals BigInteger/ONE (.unscaledValue this)))

  (method ^:private squareRootResultAssertions ^boolean [this ^BigDecimal result ^MathContext mc]
    (if (== (.signum result) 0)
        (.squareRootZeroResultAssertions this result mc)
        (let [rm (.getRoundingMode mc)
              ^:mutable ulp (.ulp result)
              neighborUp (.add result ulp)]
          (when (.isPowerOfTen result) (set! ulp (.divide ulp TEN)))
          (let [neighborDown (.subtract result ulp)]
            (java-assert (and (== (.signum result) 1) (== (.signum this) 1))
              "Bad signum of this and/or its sqrt.")
            (switch rm
              (DOWN FLOOR)
                (do
                  (java-assert (and (<= (.compareTo (.square result) this) 0)
                                    (> (.compareTo (.square neighborUp) this) 0))
                    (java-str "Square of result out for bounds rounding " rm))
                  true)
              (UP CEILING)
                (do
                  (java-assert (and (>= (.compareTo (.square result) this) 0)
                                    (< (.compareTo (.square neighborDown) this) 0))
                    (java-str "Square of result out for bounds rounding " rm))
                  true)
              (HALF_DOWN HALF_EVEN HALF_UP)
                (let [err (.abs (.subtract (.square result) this))
                      errUp (.subtract (.square neighborUp) this)
                      errDown (.subtract this (.square neighborDown))
                      err_comp_errUp (.compareTo err errUp)
                      err_comp_errDown (.compareTo err errDown)]
                  (java-assert (and (== (.signum errUp) 1) (== (.signum errDown) 1))
                    "Errors of neighbors squared don't have correct signs")
                  (java-assert (or (<= err_comp_errUp 0) (<= err_comp_errDown 0))
                    (java-str "Computed square root has larger error than neighbors for " rm))
                  (java-assert (and (if (== err_comp_errUp 0) (< err_comp_errDown 0) true)
                                    (if (== err_comp_errDown 0) (< err_comp_errUp 0) true))
                    "Incorrect error relationships")
                  true)
              true)))))

  (method ^:private squareRootZeroResultAssertions ^boolean [this ^BigDecimal result ^MathContext mc]
    (== (.compareTo this ZERO) 0))

  (method ^:public pow ^BigDecimal [this ^int n]
    (when (or (< n 0) (> n 999999999)) (throw (ArithmeticException. "Invalid operation")))
    (let [newScale (.checkScale this (unchecked-multiply (long scale) n))]
      (BigDecimal. (.pow (.inflated this) n) newScale)))

  (method ^:public pow ^BigDecimal [this ^int n ^MathContext mc]
    (if (== (.-precision mc) 0)
        (.pow this n)
        (do
          (when (or (< n -999999999) (> n 999999999))
            (throw (ArithmeticException. "Invalid operation")))
          (if (== n 0)
              ONE
              (let [lhs this
                    ^:mutable workmc mc
                    ^:mutable mag (Math/abs n)]
                (when (> (.-precision mc) 0)
                  (let [elength (BigDecimal/longDigitLength mag)]
                    (when (> elength (.-precision mc))
                      (throw (ArithmeticException. "Invalid operation")))
                    (set! workmc
                          (MathContext. (unchecked-add-int
                                          (unchecked-add-int (.-precision mc) elength)
                                          1)
                                        (.-roundingMode mc)))))
                (let [^:mutable acc ONE
                      ^:mutable seenbit false]
                  (loop [^int i 1]
                    (set! mag (unchecked-add-int mag mag))
                    (when (< mag 0) (set! seenbit true) (set! acc (.multiply acc lhs workmc)))
                    (when-not (== i 31)
                      (if seenbit
                          (do (set! acc (.multiply acc acc workmc)) (recur (unchecked-inc-int i)))
                          (recur (unchecked-inc-int i)))))
                  (when (< n 0) (set! acc (.divide ONE acc workmc)))
                  (BigDecimal/doRound acc mc)))))))

  (method ^:public abs ^BigDecimal [this]
    (if (< (.signum this) 0) (.negate this) this))

  (method ^:public abs ^BigDecimal [this ^MathContext mc]
    (if (< (.signum this) 0) (.negate this mc) (.plus this mc)))

  (method ^:public negate ^BigDecimal [this]
    (if (== intCompact INFLATED)
        (BigDecimal. (.negate intVal) INFLATED scale precision)
        (BigDecimal/valueOf (unchecked-negate intCompact) scale precision)))

  (method ^:public negate ^BigDecimal [this ^MathContext mc]
    (.plus (.negate this) mc))

  (method ^:public plus ^BigDecimal [this] this)

  (method ^:public plus ^BigDecimal [this ^MathContext mc]
    (if (== (.-precision mc) 0) this (BigDecimal/doRound this mc)))

  (method ^:public signum ^int [this]
    (if (not (== intCompact INFLATED)) (Long/signum intCompact) (.signum intVal)))

  (method ^:public scale ^int [this] scale)

  (method ^:public precision ^int [this]
    (let [^:mutable result precision]
      (when (== result 0)
        (let [s intCompact]
          (if (not (== s INFLATED))
              (set! result (BigDecimal/longDigitLength s))
              (set! result (BigDecimal/bigDigitLength intVal)))
          (set! precision result)))
      result))

  (method ^:public unscaledValue ^BigInteger [this] (.inflated this))

  (field ^:public ^:static ^:final ^{Deprecated {:since "9"}} ^int ROUND_UP 0)

  (field ^:public ^:static ^:final ^{Deprecated {:since "9"}} ^int ROUND_DOWN 1)

  (field ^:public ^:static ^:final ^{Deprecated {:since "9"}} ^int ROUND_CEILING 2)

  (field ^:public ^:static ^:final ^{Deprecated {:since "9"}} ^int ROUND_FLOOR 3)

  (field ^:public ^:static ^:final ^{Deprecated {:since "9"}} ^int ROUND_HALF_UP 4)


        (or (< (Long/compareUnsigned x s2) 0) (> s BigInteger/LONG_MASK)) (unchecked-subtract s 1)
        (<= (Long/compareUnsigned x (unchecked-add s2 (bit-shift-left s 1))) 0) s
        :else (unchecked-add s 1))))

  (method ^:private sqrtRemKaratsuba ^MutableBigInteger/1 [this ^int len ^boolean needRemainder]
    (if (== len 2)
        (let [x (bit-or (bit-shift-left (bit-and (aget value offset) BigInteger/LONG_MASK) 32)
                        (bit-and (aget value (unchecked-add-int offset 1)) BigInteger/LONG_MASK))
              s (MutableBigInteger/unsignedLongSqrt x)
              sqrt (MutableBigInteger. (new int/1 (bit-shift-right-int intLen 1)))]
          (set! (.-intLen sqrt) 1)
          (aset (.-value sqrt) 0 (unchecked-int s))
          (new MutableBigInteger/1
               [sqrt (MutableBigInteger. (unchecked-subtract x (unchecked-multiply s s)))]))
        (let [halfLen (bit-shift-right-int len 1)
              sr (.sqrtRemKaratsuba this (unchecked-add-int halfLen (bit-and-int halfLen 1)) true)
              blockLen (bit-shift-right-int halfLen 1)
              dividend (aget sr 1)]
          (.shiftAddDisjoint dividend (.getBlockForSqrt this 1 len blockLen) blockLen)
          (let [sqrt (aget sr 0)
                q (MutableBigInteger.)
                u (.divide dividend sqrt q)]
            (when (.isOdd q) (.add u sqrt))
            (.rightShift q 1)
            (.shiftAdd sqrt q blockLen)
            (.shiftAddDisjoint u (.getBlockForSqrt this 0 len blockLen) blockLen)
            (let [qBig (.toBigInteger q)
                  qSqr (MutableBigInteger. (.-mag (.multiply qBig qBig)))
                  ^:mutable ^MutableBigInteger rem nil]
              (if needRemainder
                  (do
                    (set! rem u)
                    (when (< (.subtract rem qSqr) 0)
                      (let [twiceSqrt (MutableBigInteger. sqrt)]
                        (.leftShift twiceSqrt 1)
                        (.add rem ONE)
                        (.subtract rem twiceSqrt)
                        (.subtract sqrt ONE))))
                  (do (set! rem nil) (when (< (.compare u qSqr) 0) (.subtract sqrt ONE))))
              (aset sr 1 rem)

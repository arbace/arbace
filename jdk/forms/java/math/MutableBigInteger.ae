                      (bit-and-int (Integer/numberOfLeadingZeros (aget (.-value x) (.-offset x)))
                                   (bit-not-int 1))
                      (bit-shift-left-int (bit-and-int (.-intLen x) 1) 5))]
          (when-not (== shift 0) (set! x (MutableBigInteger. x)) (.leftShift x shift))
          (let [sqrtRem (.sqrtRemKaratsuba x (.-intLen x) needRemainder)]
            (when-not (== shift 0)
              (let [halfShift (bit-shift-right-int shift 1)]
                (when needRemainder
                  (let [^long s0 (bit-and-int (aget
                                                (.-value (aget sqrtRem 0))
                                                (unchecked-subtract-int
                                                  (unchecked-add-int
                                                    (.-offset (aget sqrtRem 0))
                                                    (.-intLen (aget sqrtRem 0)))
                                                  1))
                                              (unsigned-bit-shift-right-int
                                                -1
                                                (unchecked-negate-int halfShift)))]
                    (when-not (== s0 0)
                      (let [doubleProd (MutableBigInteger.)]
                        (.mul (aget sqrtRem 0) (unchecked-int (bit-shift-left s0 1)) doubleProd)
                        (.add (aget sqrtRem 1) doubleProd)
                        (.subtract (aget sqrtRem 1) (MutableBigInteger. (unchecked-multiply s0 s0)))))
                    (.rightShift (aget sqrtRem 1) shift)))
                (.primitiveRightShift (aget sqrtRem 0) halfShift)))

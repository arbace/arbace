  (method ^:private ^:static unsignedLongSqrt ^long [^long x]
    (let [s (unchecked-long
              (Math/sqrt (if (>= x 0) (double x) (unchecked-add x 1.8446744073709552E19))))
          s2 (unchecked-multiply s s)]

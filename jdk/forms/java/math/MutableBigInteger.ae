      (.mul s (unchecked-subtract-int n 1) dividend)
      (let [xDivSToN1 (MutableBigInteger.)]
        (.divide x (MutableBigInteger. (.-mag sToN1)) xDivSToN1 false)
        (.add dividend xDivSToN1)
        (.divideOneWord dividend n s))))

  (method sqrtRem ^MutableBigInteger/1 [this ^boolean needRemainder]
    (if (<= (.-intLen this) 2)
        (let [x (.toLong this)
              s (MutableBigInteger/unsignedLongSqrt x)]
          (new MutableBigInteger/1
               [(MutableBigInteger. (unchecked-int s))
                (when needRemainder
                  (MutableBigInteger. (unchecked-subtract x (unchecked-multiply s s))))]))

                                (bit-shift-left
                                  (long (aget value
                                              (unchecked-subtract-int
                                                (unchecked-add-int offset intLen)
                                                2)))
                                  32))))
                (let [^:mutable tLong (bit-and t BigInteger/LONG_MASK)]
                  (set!
                    tLong
                    (unchecked-multiply tLong
                                        (unchecked-subtract 2 (unchecked-multiply pLong tLong))))
                  (set! tLong
                        (if (== k 64)
                            tLong
                            (bit-and tLong (unchecked-subtract (bit-shift-left 1 k) 1))))
                  (let [result (MutableBigInteger. (new int/1 2))]
                    (aset (.-value result) 0 (unchecked-int (unsigned-bit-shift-right tLong 32)))
                    (aset (.-value result) 1 (unchecked-int tLong))
                    (set! (.-intLen result) 2)
                    (.normalize result)
                    result)))))))

  (method ^:static inverseMod32 ^int [^int val]
    (let [^:mutable t val]
      (set! t (unchecked-multiply-int t (unchecked-subtract-int 2 (unchecked-multiply-int val t))))
      (set! t (unchecked-multiply-int t (unchecked-subtract-int 2 (unchecked-multiply-int val t))))
      (set! t (unchecked-multiply-int t (unchecked-subtract-int 2 (unchecked-multiply-int val t))))
      (set! t (unchecked-multiply-int t (unchecked-subtract-int 2 (unchecked-multiply-int val t))))
      t))

  (method ^:static inverseMod64 ^long [^long val]
    (let [^:mutable t val]
      (set! t (unchecked-multiply t (unchecked-subtract 2 (unchecked-multiply val t))))
      (set! t (unchecked-multiply t (unchecked-subtract 2 (unchecked-multiply val t))))
      (set! t (unchecked-multiply t (unchecked-subtract 2 (unchecked-multiply val t))))
      (set! t (unchecked-multiply t (unchecked-subtract 2 (unchecked-multiply val t))))
      (set! t (unchecked-multiply t (unchecked-subtract 2 (unchecked-multiply val t))))
      (java-assert (== (unchecked-multiply t val) 1))
      t))

  (method ^:static modInverseBP2 ^MutableBigInteger [^MutableBigInteger mod ^int k]
    (MutableBigInteger/fixup (^[int] MutableBigInteger/new 1) (MutableBigInteger. mod) k))

  (method ^:private modInverse ^MutableBigInteger [this ^MutableBigInteger mod]
    (let [p (MutableBigInteger. mod)
          ^:mutable f (MutableBigInteger. this)
          ^:mutable g (MutableBigInteger. p)
          ^:mutable c (SignedMutableBigInteger. 1)
          ^:mutable d (SignedMutableBigInteger.)
          ^:mutable ^MutableBigInteger temp nil
          ^:mutable ^SignedMutableBigInteger sTemp nil
          ^:mutable ^int k 0]
      (when (.isEven f)
        (let [trailingZeros (.getLowestSetBit f)]
          (.rightShift f trailingZeros)
          (.leftShift d trailingZeros)
          (set! k trailingZeros)))
      (while (not (.isOne f))
        (when (.isZero f) (throw (ArithmeticException. "BigInteger not invertible.")))
        (when (< (.compare f g) 0)
          (set! temp f)
          (set! f g)
          (set! g temp)
          (set! sTemp d)
          (set! d c)
          (set! c sTemp))
        (if (== (bit-and-int (bit-xor-int (aget (.-value f)
                                                (unchecked-subtract-int
                                                  (unchecked-add-int (.-offset f) (.-intLen f))
                                                  1))
                                          (aget (.-value g)
                                                (unchecked-subtract-int
                                                  (unchecked-add-int (.-offset g) (.-intLen g))
                                                  1)))
                             3)
                0)
            (do (.subtract f g) (.signedSubtract c d))
            (do (.add f g) (.signedAdd c d)))
        (let [trailingZeros (.getLowestSetBit f)]
          (.rightShift f trailingZeros)
          (.leftShift d trailingZeros)
          (set! k (unchecked-add-int k trailingZeros))))
      (when (>= (.compare c p) 0)
        (let [remainder (.divide c p (MutableBigInteger.))] (.copyValue c remainder)))
      (when (< (.-sign c) 0) (.signedAdd c p))
      (MutableBigInteger/fixup c p k)))

  (method ^:static fixup ^MutableBigInteger [^:mutable ^MutableBigInteger c ^MutableBigInteger p
                                             ^int k]
    (let [temp (MutableBigInteger.)
          r (unchecked-negate-int
              (MutableBigInteger/inverseMod32
                (aget (.-value p)
                      (unchecked-subtract-int (unchecked-add-int (.-offset p) (.-intLen p)) 1))))]
      (loop [^int i 0
             ^int numWords (bit-shift-right-int k 5)]
        (when (< i numWords)
          (let [v (unchecked-multiply-int r
                                          (aget (.-value c)
                                                (unchecked-subtract-int
                                                  (unchecked-add-int (.-offset c) (.-intLen c))
                                                  1)))]
            (.mul p v temp)
            (.add c temp)
            (set! (.-intLen c) (unchecked-dec-int (.-intLen c)))
            (recur (unchecked-inc-int i) numWords))))
      (let [numBits (bit-and-int k 0x1f)]
        (when-not (== numBits 0)
          (let [^:mutable v (unchecked-multiply-int
                              r
                              (aget (.-value c)
                                    (unchecked-subtract-int
                                      (unchecked-add-int (.-offset c) (.-intLen c))
                                      1)))]
            (set! v (bit-and-int v (unchecked-subtract-int (bit-shift-left-int 1 numBits) 1)))
            (.mul p v temp)
            (.add c temp)
            (.rightShift c numBits)))
        (when (>= (.compare c p) 0) (set! c (.divide c p (MutableBigInteger.))))
        c)))

  (method euclidModInverse ^MutableBigInteger [this ^int k]
    (let [^:mutable b (^[int] MutableBigInteger/new 1)]
      (.leftShift b k)
      (let [mod (MutableBigInteger. b)
            ^:mutable a (MutableBigInteger. this)
            ^:mutable q (MutableBigInteger.)
            ^:mutable r (.divide b a q)
            ^:mutable swapper b]
        (set! b r)
        (set! r swapper)
        (let [t1 (MutableBigInteger. q)
              t0 (^[int] MutableBigInteger/new 1)
              ^:mutable temp (MutableBigInteger.)]
          (while (not (.isOne b))
            (set! r (.divide a b q))
            (when (== (.-intLen r) 0) (throw (ArithmeticException. "BigInteger not invertible.")))
            (set! swapper r)
            (set! a swapper)
            (if (== (.-intLen q) 1)
                (.mul t1 (aget (.-value q) (.-offset q)) temp)
                (.multiply q t1 temp))
            (set! swapper q)
            (set! q temp)
            (set! temp swapper)
            (.add t0 q)
            (when (.isOne a) (return t0))
            (set! r (.divide b a q))
            (when (== (.-intLen r) 0) (throw (ArithmeticException. "BigInteger not invertible.")))
            (set! swapper b)
            (set! b r)
            (if (== (.-intLen q) 1)
                (.mul t0 (aget (.-value q) (.-offset q)) temp)
                (.multiply q t0 temp))
            (set! swapper q)
            (set! q temp)
            (set! temp swapper)
            (.add t1 q))
          (.subtract mod t1)
          mod)))))

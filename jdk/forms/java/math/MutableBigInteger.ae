                      ^:mutable ^int qrem 0
                      ^:mutable skipCorrection false
                      nh (aget (.-value rem) (unchecked-add-int j (.-offset rem)))
                      nh2 (unchecked-add-int nh (unchecked-int 0x80000000))
                      nm (aget (.-value rem)
                               (unchecked-add-int (unchecked-add-int j 1) (.-offset rem)))]
                  (if (== nh dh)

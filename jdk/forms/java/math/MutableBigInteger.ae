  (method ^:private unsignedLongCompare ^boolean [this ^long one ^long two]
    (> (unchecked-add one Long/MIN_VALUE) (unchecked-add two Long/MIN_VALUE)))

  (method rootnRem ^MutableBigInteger/1 [this ^int n]
    (if (or (.isZero this) (.isOne this))
        (new MutableBigInteger/1 [this (MutableBigInteger.)])
        (let [bitLength (unchecked-int (.bitLength this))]
          (if (<= bitLength n)
              (let [rem (MutableBigInteger. this)]
                (.subtract rem ONE)
                (new MutableBigInteger/1 [(^[int] MutableBigInteger/new 1) rem]))
              (let [^:mutable ^MutableBigInteger s nil]
                (if (<= bitLength Long/SIZE)
                    (let [x (.toLong this)
                          ^:mutable sLong (unchecked-add
                                            (unchecked-long
                                              (MutableBigInteger/rootnApprox
                                                (Math/nextUp
                                                  (if (>= x 0)
                                                      (double x)
                                                      (unchecked-add x 1.8446744073709552E19)))
                                                n))
                                            1)]
                      (when (<= (unchecked-multiply-int
                                  (BigInteger/bitLengthForLong sLong)
                                  (unchecked-subtract-int n 1))
                                Long/SIZE)
                        (let [^:mutable sToN1 (BigInteger/unsignedLongPow
                                                sLong
                                                (unchecked-subtract-int n 1))]
                          (set! sLong
                                (unchecked-divide
                                  (unchecked-add
                                    (unchecked-multiply (unchecked-subtract-int n 1) sLong)
                                    (Long/divideUnsigned x sToN1))
                                  n))
                          (when (<= (unchecked-multiply-int
                                      (BigInteger/bitLengthForLong sLong)
                                      (unchecked-subtract-int n 1))
                                    Long/SIZE)
                            (let [^:mutable u sLong]
                              (loop []
                                (set! sLong u)
                                (set! sToN1
                                      (BigInteger/unsignedLongPow
                                        sLong
                                        (unchecked-subtract-int n 1)))
                                (set! u
                                      (unchecked-divide
                                        (unchecked-add
                                          (unchecked-multiply (unchecked-subtract-int n 1) sLong)
                                          (Long/divideUnsigned x sToN1))
                                        n))
                                (when (< u sLong) (recur)))
                              (return (new MutableBigInteger/1
                                           [(MutableBigInteger. sLong)
                                            (MutableBigInteger.
                                              (unchecked-subtract
                                                x
                                                (unchecked-multiply sToN1 sLong)))]))))))
                      (set! s (MutableBigInteger. sLong)))
                    (let [rootLen (unchecked-add-int
                                    (unchecked-divide-int (unchecked-subtract-int bitLength 1) n)
                                    1)
                          ^:mutable ^int rootSh 0
                          ^:mutable rad 0.0
                          ^:mutable approx 0.0]
                      (if (< n Double/PRECISION)
                          (do
                            (set! rootSh
                                  (unchecked-divide-int
                                    (unchecked-subtract-int bitLength Double/PRECISION)
                                    n))
                            (set! rad
                                  (.doubleValue (.shiftRight
                                                  (.toBigInteger this)
                                                  (unchecked-multiply-int rootSh n))))
                            (set! rad (Math/nextUp rad))
                            (set! approx (MutableBigInteger/rootnApprox rad n)))
                          (set! rootSh (unchecked-subtract-int rootLen 1)))

      (while (and (< from to) (== (aget value from) 0)) (set! from (unchecked-inc-int from)))
      (if (== from to) (MutableBigInteger.) (MutableBigInteger. (Arrays/copyOfRange value from to)))))

  (method hybridGCD ^MutableBigInteger [this ^:mutable ^MutableBigInteger b]
    (let [^:mutable a this
          q (MutableBigInteger.)]
      (while (not (== (.-intLen b) 0))
        (when (< (Math/abs (unchecked-subtract-int (.-intLen a) (.-intLen b))) 2)
          (return (.binaryGCD a b)))
        (let [r (.divide a b q)] (set! a b) (set! b r)))
      a))

  (method ^:private binaryGCD ^MutableBigInteger [this ^:mutable ^MutableBigInteger v]
    (let [^:mutable u this
          r (MutableBigInteger.)
          s1 (.getLowestSetBit u)
          s2 (.getLowestSetBit v)
          ^int k (if (< s1 s2) s1 s2)]
      (when-not (== k 0) (.rightShift u k) (.rightShift v k))
      (let [uOdd (== k s1)
            ^:mutable ^MutableBigInteger t (if uOdd v u)
            ^:mutable ^int tsign (if uOdd -1 1)
            ^:mutable ^int lb 0]
        (while (>= (set! lb (.getLowestSetBit t)) 0)
          (.rightShift t lb)
          (if (> tsign 0) (set! u t) (set! v t))
          (when (and (< (.-intLen u) 2) (< (.-intLen v) 2))
            (let [^:mutable x (aget (.-value u) (.-offset u))
                  y (aget (.-value v) (.-offset v))]
              (set! x (MutableBigInteger/binaryGcd x y))
              (aset (.-value r) 0 x)
              (set! (.-intLen r) 1)
              (set! (.-offset r) 0)
              (when (> k 0) (.leftShift r k))
              (return r)))
          (when (== (set! tsign (.difference u v)) 0) (break))
          (set! t (if (>= tsign 0) u v)))
        (when (> k 0) (.leftShift u k))
        u)))

  (method ^:static binaryGcd ^int [^:mutable ^int a ^:mutable ^int b]
    (cond
      (== b 0) a
      (== a 0) b
      :else
        (let [aZeros (Integer/numberOfTrailingZeros a)
              bZeros (Integer/numberOfTrailingZeros b)]
          (set! a (unsigned-bit-shift-right-int a aZeros))
          (set! b (unsigned-bit-shift-right-int b bZeros))
          (let [^int t (if (< aZeros bZeros) aZeros bZeros)]
            (while (not (== a b))
              (if (> (unchecked-add-int a (unchecked-int 0x80000000))
                     (unchecked-add-int b (unchecked-int 0x80000000)))
                  (do
                    (set! a (unchecked-subtract-int a b))
                    (set! a (unsigned-bit-shift-right-int a (Integer/numberOfTrailingZeros a))))
                  (do
                    (set! b (unchecked-subtract-int b a))
                    (set! b (unsigned-bit-shift-right-int b (Integer/numberOfTrailingZeros b))))))
            (bit-shift-left-int a t)))))

  (method mutableModInverse ^MutableBigInteger [this ^MutableBigInteger p]
    (if (.isOdd p)
        (.modInverse this p)
        (do
          (when (.isEven this) (throw (ArithmeticException. "BigInteger not invertible.")))
          (let [powersOf2 (.getLowestSetBit p)
                oddMod (MutableBigInteger. p)]
            (.rightShift oddMod powersOf2)
            (if (.isOne oddMod)
                (.modInverseMP2 this powersOf2)
                (let [oddPart (.modInverse this oddMod)
                      evenPart (.modInverseMP2 this powersOf2)
                      y1 (MutableBigInteger/modInverseBP2 oddMod powersOf2)
                      y2 (.modInverseMP2 oddMod powersOf2)
                      temp1 (MutableBigInteger.)
                      temp2 (MutableBigInteger.)
                      result (MutableBigInteger.)]
                  (.leftShift oddPart powersOf2)
                  (.multiply oddPart y1 result)
                  (.clear oddPart)
                  (.multiply evenPart oddMod temp1)
                  (.multiply temp1 y2 temp2)
                  (.add result temp2)
                  (.divide result p temp1)))))))

  (method modInverseMP2 ^MutableBigInteger [this ^int k]
    (when (.isEven this) (throw (ArithmeticException. "Non-invertible. (GCD != 1)")))
    (if (> k 64)
        (.euclidModInverse this k)
        (let [^:mutable t (MutableBigInteger/inverseMod32
                            (aget value
                                  (unchecked-subtract-int (unchecked-add-int offset intLen) 1)))]

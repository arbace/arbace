        (let [^:mutable carry (unchecked-add (unsigned-bit-shift-right product 32)
                                             (if (>
                                                   (bit-and difference BigInteger/LONG_MASK)
                                                   (bit-and
                                                     (bit-not-int (unchecked-int product))
                                                     BigInteger/LONG_MASK))
                                                 1
                                                 0))]
          (set! product
                (unchecked-add (unchecked-multiply (bit-and dh BigInteger/LONG_MASK) xLong) carry))
          (set! difference (unchecked-subtract (aget q offset) product))
          (aset q offset (unchecked-int difference))
          (set! offset (unchecked-dec-int offset))
          (set! carry
                (unchecked-add (unsigned-bit-shift-right product 32)
                               (if (> (bit-and difference BigInteger/LONG_MASK)
                                      (bit-and (bit-not-int (unchecked-int product))
                                               BigInteger/LONG_MASK))

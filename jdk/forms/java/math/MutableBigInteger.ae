                  this
                  s
                  n
                  (.pow (.toBigInteger s) (unchecked-subtract-int n 1)))
                (loop []
                  (let [sBig (.toBigInteger s)
                        sToN1 (.pow sBig (unchecked-subtract-int n 1))

                          (do
                            (set! s
                                  (MutableBigInteger.
                                    (new int/1
                                         (unchecked-add-int
                                           (unchecked-divide-int
                                             (unchecked-subtract-int intLen 1)
                                             n)
                                           1))))
                            (if (>= n Double/PRECISION)
                                (do (aset (.-value s) 0 2) (set! (.-intLen s) 1))
                                (let [wrongBits (unchecked-divide-int
                                                  (unchecked-subtract-int
                                                    (unchecked-add-int (Math/getExponent rad) 1)
                                                    Double/PRECISION)
                                                  n)]
                                  (set! rootSh (unchecked-add-int rootSh wrongBits))
                                  (set! approx (Math/scalb approx (unchecked-negate-int wrongBits)))
                                  (aset (.-value s) 0 (unchecked-add-int (unchecked-int approx) 1))
                                  (set! (.-intLen s) 1)))
                            (loop [^int correctBits (unchecked-subtract-int rootLen rootSh)]
                              (when (< correctBits rootSh)
                                (.leftShift s correctBits)
                                (set! rootSh (unchecked-subtract-int rootSh correctBits))
                                (let [x (MutableBigInteger. this)]
                                  (.rightShift x (unchecked-multiply-int rootSh n))
                                  (MutableBigInteger/newtonRecurrenceRootn
                                    x
                                    s
                                    n
                                    (.pow (.toBigInteger s) (unchecked-subtract-int n 1)))
                                  (.add s ONE)
                                  (recur (bit-shift-left-int correctBits 1)))))
                            (.leftShift s rootSh)))))

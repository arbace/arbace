  (method ^:private ^:static rootnApprox ^double [^double x ^int n]
    (Math/nextUp (if (== n 3) (Math/cbrt x) (Math/pow x (Math/nextUp (unchecked-divide 1.0 n))))))

  (method ^:private ^:static newtonRecurrenceRootn ^void [^MutableBigInteger x ^MutableBigInteger s
                                                          ^int n ^BigInteger sToN1]

                        (set! qhat (bit-not-int 0))
                        (set! qrem (unchecked-add-int nh nm))
                        (set! skipCorrection
                              (< (unchecked-add-int qrem (unchecked-int 0x80000000)) nh2)))
                      (let [nChunk (bit-or (bit-shift-left (long nh) 32)
                                           (bit-and nm BigInteger/LONG_MASK))]
                        (set! qhat (unchecked-int (Long/divideUnsigned nChunk dhLong)))
                        (set! qrem (unchecked-int (Long/remainderUnsigned nChunk dhLong)))))

  (method ^:private getBlockForSqrt ^MutableBigInteger [this ^int blockIndex ^int len ^int blockLen]
    (let [to (unchecked-subtract-int (unchecked-add-int offset len)
                                     (unchecked-multiply-int blockIndex blockLen))
          ^:mutable ^int from 0]

    (method write :throws [IOException] ^void [this ^byte/1 b ^:mutable ^int off ^:mutable ^int len
                                               ^boolean copy]
      (if (not (or copy blkmode))
          (do (.drain this) (.write out b off len))
          (while (> len 0)
            (when (>= pos MAX_BLOCK_SIZE) (.drain this))
            (if (and (and (>= len MAX_BLOCK_SIZE) (not copy)) (== pos 0))
                (do
                  (.writeBlockHeader this MAX_BLOCK_SIZE)
                  (.write out b off MAX_BLOCK_SIZE)
                  (set! off (unchecked-add-int off MAX_BLOCK_SIZE))
                  (set! len (unchecked-subtract-int len MAX_BLOCK_SIZE)))
                (let [wlen (Math/min len (unchecked-subtract-int MAX_BLOCK_SIZE pos))]
                  (System/arraycopy b off buf pos wlen)
                  (set! pos (unchecked-add-int pos wlen))
                  (set! off (unchecked-add-int off wlen))
                  (set! len (unchecked-subtract-int len wlen)))))))

    (method drain :throws [IOException] ^void [this]
      (when-not (== pos 0)
        (when blkmode (.writeBlockHeader this pos))
        (.write out buf 0 pos)
        (set! pos 0)))

    (method ^:private writeBlockHeader :throws [IOException] ^void [this ^int len]
      (if (<= len 0xFF)
          (do
            (aset hbuf 0 ObjectStreamConstants/TC_BLOCKDATA)
            (aset hbuf 1 (unchecked-byte len))
            (.write out hbuf 0 2))
          (do
            (aset hbuf 0 ObjectStreamConstants/TC_BLOCKDATALONG)
            (ByteArray/setInt hbuf 1 len)
            (.write out hbuf 0 5))))

    (method ^:public writeBoolean :throws [IOException] ^void [this ^boolean v]
      (when (>= pos MAX_BLOCK_SIZE) (.drain this))
      (ByteArray/setBoolean buf (let [old-2 pos] (set! pos (unchecked-inc-int pos)) old-2) v))

    (method ^:public writeByte :throws [IOException] ^void [this ^int v]
      (when (>= pos MAX_BLOCK_SIZE) (.drain this))
      (aset buf (let [old-3 pos] (set! pos (unchecked-inc-int pos)) old-3) (unchecked-byte v)))

    (method ^:public writeChar :throws [IOException] ^void [this ^int v]
      (if (<= (unchecked-add-int pos 2) MAX_BLOCK_SIZE)
          (do (ByteArray/setChar buf pos (unchecked-char v)) (set! pos (unchecked-add-int pos 2)))
          (.writeChar dout v)))

    (method ^:public writeShort :throws [IOException] ^void [this ^int v]
      (if (<= (unchecked-add-int pos 2) MAX_BLOCK_SIZE)
          (do (ByteArray/setShort buf pos (unchecked-short v)) (set! pos (unchecked-add-int pos 2)))
          (.writeShort dout v)))

    (method ^:public writeInt :throws [IOException] ^void [this ^int v]
      (if (<= (unchecked-add-int pos 4) MAX_BLOCK_SIZE)
          (do (ByteArray/setInt buf pos v) (set! pos (unchecked-add-int pos 4)))
          (.writeInt dout v)))

    (method ^:public writeFloat :throws [IOException] ^void [this ^float v]
      (if (<= (unchecked-add-int pos 4) MAX_BLOCK_SIZE)
          (do (ByteArray/setFloat buf pos v) (set! pos (unchecked-add-int pos 4)))
          (.writeFloat dout v)))

    (method ^:public writeLong :throws [IOException] ^void [this ^long v]
      (if (<= (unchecked-add-int pos 8) MAX_BLOCK_SIZE)
          (do (ByteArray/setLong buf pos v) (set! pos (unchecked-add-int pos 8)))
          (.writeLong dout v)))

    (method ^:public writeDouble :throws [IOException] ^void [this ^double v]
      (if (<= (unchecked-add-int pos 8) MAX_BLOCK_SIZE)
          (do (ByteArray/setDouble buf pos v) (set! pos (unchecked-add-int pos 8)))
          (.writeDouble dout v)))

    (method writeBytes :throws [IOException] ^void [this ^String s ^int len]
      (let [^:mutable pos (.-pos this)]
        (let [^:mutable ^int strpos 0]
          (while (< strpos len)
            (let [rem (unchecked-subtract-int MAX_BLOCK_SIZE pos)
                  csize (Math/min (unchecked-subtract-int len strpos) rem)]
              (.getBytes s strpos (unchecked-add-int strpos csize) buf pos)
              (set! pos (unchecked-add-int pos csize))
              (set! strpos (unchecked-add-int strpos csize))
              (when (== pos MAX_BLOCK_SIZE) (set! (.-pos this) pos) (.drain this) (set! pos 0)))))
        (set! (.-pos this) pos)))

    (method ^:public writeBytes :throws [IOException] ^void [this ^String s]
      (.writeBytes this s (.length s)))

    (method ^:public writeChars :throws [IOException] ^void [this ^String s]
      (let [endoff (.length s)
            ^:mutable ^int off 0]
        (while (< off endoff)
          (let [csize (Math/min (unchecked-subtract-int endoff off) CHAR_BUF_SIZE)]
            (.getChars s off (unchecked-add-int off csize) cbuf 0)
            (.writeChars this cbuf 0 csize)
            (set! off (unchecked-add-int off csize))))))

    (method ^:public writeUTF :throws [IOException] ^void [this ^String str]
      (.writeUTFInternal this str false))

    (method ^:private writeUTFInternal :throws [IOException] ^void [this ^String str
                                                                    ^boolean writeHeader]
      (let [strlen (.length str)
            countNonZeroAscii (.countNonZeroAscii JLA str)
            utflen (ModifiedUtf/utfLen str countNonZeroAscii)]
        (if (ExactConversionsSupport/isLongToCharExact utflen)
            (do
              (when writeHeader (.writeByte this ObjectStreamConstants/TC_STRING))
              (.writeShort this (unchecked-short utflen)))
            (do
              (when writeHeader (.writeByte this ObjectStreamConstants/TC_LONGSTRING))
              (.writeLong this utflen)))
        (when-not (== countNonZeroAscii 0) (.writeBytes this str countNonZeroAscii))
        (when-not (== countNonZeroAscii strlen) (.writeMoreUTF this str countNonZeroAscii))))

    (method ^:private writeMoreUTF :throws [IOException] ^void [this ^String str
                                                                ^:mutable ^int stroff]
      (let [^:mutable pos (.-pos this)]
        (loop [^int strlen (.length str)]
          (when (< stroff strlen)
            (let [c (.charAt str
                             (let [old-4 stroff] (set! stroff (unchecked-inc-int stroff)) old-4))
                  ^int csize (cond (and (not (== c 0)) (< c 0x80)) 1 (>= c 0x800) 3 :else 2)]
              (when (>= (unchecked-add-int pos csize) MAX_BLOCK_SIZE)
                (set! (.-pos this) pos)
                (.drain this)
                (set! pos 0))
              (set! pos (ModifiedUtf/putChar buf pos c))
              (recur strlen))))
        (set! (.-pos this) pos)))

    (method writeBooleans :throws [IOException] ^void [this ^boolean/1 v ^:mutable ^int off ^int len]
      (let [endoff (unchecked-add-int off len)]
        (while (< off endoff)
          (when (>= pos MAX_BLOCK_SIZE) (.drain this))
          (let [stop (Math/min endoff
                               (unchecked-add-int off (unchecked-subtract-int MAX_BLOCK_SIZE pos)))]
            (while (< off stop)
              (ByteArray/setBoolean buf
                                    (let [old-5 pos] (set! pos (unchecked-inc-int pos)) old-5)
                                    (aget v off))
              (set! off (unchecked-inc-int off)))))))

    (method writeChars :throws [IOException] ^void [this ^char/1 v ^:mutable ^int off ^int len]
      (let [limit (unchecked-subtract-int MAX_BLOCK_SIZE 2)
            endoff (unchecked-add-int off len)]
        (while (< off endoff)
          (if (<= pos limit)
              (let [avail (bit-shift-right-int (unchecked-subtract-int MAX_BLOCK_SIZE pos) 1)
                    stop (Math/min endoff (unchecked-add-int off avail))]
                (while (< off stop)
                  (ByteArray/setChar buf pos (aget v off))
                  (set! off (unchecked-inc-int off))
                  (set! pos (unchecked-add-int pos 2))))
              (do (.writeChar dout (aget v off)) (set! off (unchecked-inc-int off)))))))

    (method writeShorts :throws [IOException] ^void [this ^short/1 v ^:mutable ^int off ^int len]
      (let [limit (unchecked-subtract-int MAX_BLOCK_SIZE 2)
            endoff (unchecked-add-int off len)]
        (while (< off endoff)
          (if (<= pos limit)
              (let [avail (bit-shift-right-int (unchecked-subtract-int MAX_BLOCK_SIZE pos) 1)
                    stop (Math/min endoff (unchecked-add-int off avail))]
                (while (< off stop)
                  (ByteArray/setShort buf pos (aget v off))
                  (set! off (unchecked-inc-int off))
                  (set! pos (unchecked-add-int pos 2))))
              (do (.writeShort dout (aget v off)) (set! off (unchecked-inc-int off)))))))

    (method writeInts :throws [IOException] ^void [this ^int/1 v ^:mutable ^int off ^int len]
      (let [limit (unchecked-subtract-int MAX_BLOCK_SIZE 4)
            endoff (unchecked-add-int off len)]
        (while (< off endoff)
          (if (<= pos limit)
              (let [avail (bit-shift-right-int (unchecked-subtract-int MAX_BLOCK_SIZE pos) 2)
                    stop (Math/min endoff (unchecked-add-int off avail))]
                (while (< off stop)
                  (ByteArray/setInt buf pos (aget v off))
                  (set! off (unchecked-inc-int off))
                  (set! pos (unchecked-add-int pos 4))))
              (do (.writeInt dout (aget v off)) (set! off (unchecked-inc-int off)))))))

    (method writeFloats :throws [IOException] ^void [this ^float/1 v ^:mutable ^int off ^int len]
      (let [limit (unchecked-subtract-int MAX_BLOCK_SIZE 4)
            endoff (unchecked-add-int off len)]
        (while (< off endoff)
          (if (<= pos limit)
              (let [avail (bit-shift-right-int (unchecked-subtract-int MAX_BLOCK_SIZE pos) 2)
                    stop (Math/min endoff (unchecked-add-int off avail))]
                (while (< off stop)
                  (ByteArray/setFloat buf pos (aget v off))
                  (set! off (unchecked-inc-int off))
                  (set! pos (unchecked-add-int pos 4))))
              (do (.writeFloat dout (aget v off)) (set! off (unchecked-inc-int off)))))))

    (method writeLongs :throws [IOException] ^void [this ^long/1 v ^:mutable ^int off ^int len]
      (let [limit (unchecked-subtract-int MAX_BLOCK_SIZE 8)
            endoff (unchecked-add-int off len)]
        (while (< off endoff)
          (if (<= pos limit)
              (let [avail (bit-shift-right-int (unchecked-subtract-int MAX_BLOCK_SIZE pos) 3)
                    stop (Math/min endoff (unchecked-add-int off avail))]
                (while (< off stop)
                  (ByteArray/setLong buf pos (aget v off))
                  (set! off (unchecked-inc-int off))
                  (set! pos (unchecked-add-int pos 8))))
              (do (.writeLong dout (aget v off)) (set! off (unchecked-inc-int off)))))))

    (method writeDoubles :throws [IOException] ^void [this ^double/1 v ^:mutable ^int off ^int len]
      (let [limit (unchecked-subtract-int MAX_BLOCK_SIZE 8)
            endoff (unchecked-add-int off len)]
        (while (< off endoff)
          (if (<= pos limit)
              (let [avail (bit-shift-right-int (unchecked-subtract-int MAX_BLOCK_SIZE pos) 3)
                    stop (Math/min endoff (unchecked-add-int off avail))]
                (while (< off stop)
                  (ByteArray/setDouble buf pos (aget v off))
                  (set! off (unchecked-inc-int off))
                  (set! pos (unchecked-add-int pos 8))))
              (do (.writeDouble dout (aget v off)) (set! off (unchecked-inc-int off))))))))

  (defclass ^:private ^:static ^:final HandleTable
    (field ^:private ^int size)

    (field ^:private ^int threshold)

    (field ^:private ^:final ^float loadFactor)

    (field ^:private ^int/1 spine)

    (field ^:private ^int/1 next)

    (field ^:private ^Object/1 objs)

    (constructor [this ^int initialCapacity ^float loadFactor]
      (set! (.-loadFactor this) loadFactor)
      (set! spine (new int/1 initialCapacity))
      (set! next (new int/1 initialCapacity))
      (set! objs (new Object/1 initialCapacity))
      (set! threshold (unchecked-int (unchecked-multiply-float initialCapacity loadFactor)))
      (.clear this))

    (method assign ^int [this obj]
      (when (>= size (alength next)) (.growEntries this))
      (when (>= size threshold) (.growSpine this))
      (.insert this obj size)
      (let [size-6 size] (set! size (unchecked-inc-int size)) size-6))

    (method lookup ^int [this obj]
      (if (== size 0)
          -1
          (let [index (unchecked-remainder-int (.hash this obj) (alength spine))]
            (loop [^int i (aget spine index)]
              (if (>= i 0) (if (identical? (aget objs i) obj) (return i) (recur (aget next i))) nil))
            -1)))

    (method clear ^void [this]
      (Arrays/fill spine -1)
      (Arrays/fill objs 0 size nil)
      (set! size 0))

    (method size ^int [this] size)

    (method ^:private insert ^void [this obj ^int handle]
      (let [index (unchecked-remainder-int (.hash this obj) (alength spine))]
        (aset objs handle obj)
        (aset next handle (aget spine index))
        (aset spine index handle)))

    (method ^:private growSpine ^void [this]
      (set! spine (new int/1 (unchecked-add-int (bit-shift-left-int (alength spine) 1) 1)))
      (set! threshold (unchecked-int (unchecked-multiply-float (alength spine) loadFactor)))
      (Arrays/fill spine -1)
      (loop [^int i 0]
        (when (< i size) (.insert this (aget objs i) i) (recur (unchecked-inc-int i)))))

    (method ^:private growEntries ^void [this]
      (let [newLength (unchecked-add-int (bit-shift-left-int (alength next) 1) 1)
            newNext (new int/1 newLength)]
        (System/arraycopy next 0 newNext 0 size)
        (set! next newNext)
        (let [newObjs (new Object/1 newLength)]
          (System/arraycopy objs 0 newObjs 0 size)
          (set! objs newObjs))))

    (method ^:private hash ^int [this obj]
      (bit-and-int (System/identityHashCode obj) 0x7FFFFFFF)))

  (defclass ^:private ^:static ^:final ReplaceTable
    (field ^:private ^:final ^HandleTable htab)

    (field ^:private ^Object/1 reps)

    (constructor [this ^int initialCapacity ^float loadFactor]
      (set! htab (HandleTable. initialCapacity loadFactor))
      (set! reps (new Object/1 initialCapacity)))

    (method assign ^void [this obj rep]
      (let [index (.assign htab obj)]
        (while (>= index (alength reps)) (.grow this))
        (aset reps index rep)))

    (method lookup [this obj]
      (let [index (.lookup htab obj)] (if (>= index 0) (aget reps index) obj)))

    (method clear ^void [this]
      (Arrays/fill reps 0 (.size htab) nil)
      (.clear htab))

    (method size ^int [this] (.size htab))

    (method ^:private grow ^void [this]
      (let [newReps (new Object/1 (unchecked-add-int (bit-shift-left-int (alength reps) 1) 1))]
        (System/arraycopy reps 0 newReps 0 (alength reps))
        (set! reps newReps))))

  (defclass ^:private ^:static ^:final DebugTraceInfoStack
    (field ^:private ^:final ^{:tag (List String)} stack)

    (constructor [this] (set! stack (ArrayList.)))

    (method clear ^void [this] (.clear stack))

    (method pop ^void [this]
      (.remove stack (unchecked-subtract-int (.size stack) 1)))

    (method push ^void [this ^String entry]
      (.add stack (java-str "\t- " entry)))

    (method ^:public toString ^String [this]
      (let [sj (StringJoiner. "\n")]
        (loop [^int i (unchecked-subtract-int (.size stack) 1)]
          (when (>= i 0) (.add sj (cast CharSequence (.get stack i))) (recur (unchecked-dec-int i))))
        (.toString sj)))))

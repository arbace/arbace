        (let [^{:tag (Constructor ?)} ctr (.getDeclaredConstructor cls paramTypes)]
          (.setAccessible ctr true)
          ctr)
        (catch NoSuchMethodException e nil))))

  (method getRecordConstructor ^{:tag (Constructor ?)} [this]
    canonicalCtr)

  (method ^:private ^:static getInheritableMethod ^Method [^{:tag (Class ?)} cl ^String name
                                                           ^{:tag (array (Class ?))} argTypes
                                                           ^{:tag (Class ?)} returnType]
    (let [^:mutable ^Method meth nil
          ^:mutable ^{:tag (Class ?)} defCl cl]
      (while (some? defCl)
        (try
          (set! meth (.getDeclaredMethod defCl name argTypes))
          (break)
          (catch NoSuchMethodException ex (set! defCl (.getSuperclass defCl)))))
      (when-not (or (nil? meth) (not (identical? (.getReturnType meth) returnType)))
        (.setAccessible meth true)
        (let [mods (.getModifiers meth)]
          (when-not (not (== (bit-and-int mods (bit-or-int Modifier/STATIC Modifier/ABSTRACT)) 0))
            (cond
              (not (== (bit-and-int mods (bit-or-int Modifier/PUBLIC Modifier/PROTECTED)) 0)) meth
              (not (== (bit-and-int mods Modifier/PRIVATE) 0)) (when (identical? cl defCl) meth)
              (ObjectStreamClass/packageEquals cl defCl) meth))))))

  (method ^:private ^:static getPrivateMethod ^Method [^{:tag (Class ?)} cl ^String name
                                                       ^{:tag (array (Class ?))} argTypes
                                                       ^{:tag (Class ?)} returnType]
    (try
      (let [meth (.getDeclaredMethod cl name argTypes)]
        (.setAccessible meth true)
        (let [mods (.getModifiers meth)]
          (when (and (and (identical? (.getReturnType meth) returnType)
                          (== (bit-and-int mods Modifier/STATIC) 0))
                     (not (== (bit-and-int mods Modifier/PRIVATE) 0)))
            meth)))
      (catch NoSuchMethodException ex nil)))

  (method ^:private ^:static packageEquals ^boolean [^{:tag (Class ?)} cl1 ^{:tag (Class ?)} cl2]
    (and (identical? (.getClassLoader cl1) (.getClassLoader cl2))
         (identical? (.getPackageName cl1) (.getPackageName cl2))))

  (method ^:private ^:static classNamesEqual ^boolean [^String name1 ^String name2]
    (let [idx1 (unchecked-add-int (.lastIndexOf name1 \.) 1)
          idx2 (unchecked-add-int (.lastIndexOf name2 \.) 1)
          len1 (unchecked-subtract-int (.length name1) idx1)
          len2 (unchecked-subtract-int (.length name2) idx2)]
      (and (== len1 len2) (.regionMatches name1 idx1 name2 idx2 len1))))

  (method ^:private ^:static getMethodSignature ^String [^{:tag (array (Class ?))} paramTypes
                                                         ^{:tag (Class ?)} retType]
    (let [sb (StringBuilder.)]
      (.append sb \()
      (loop [^int i 0]
        (when (< i (alength paramTypes))
          (.append sb (.descriptorString (aget paramTypes i)))
          (recur (unchecked-inc-int i))))
      (.append sb \))
      (.append sb (.descriptorString retType))
      (.toString sb)))

  (method ^:private ^:static throwMiscException :throws [IOException] ^void [^Throwable th]
    (cond
      (instance? RuntimeException th) (throw (cast RuntimeException th))
      (instance? Error th) (throw (cast Error th))
      :else (throw (IOException. "unexpected exception type" th))))

  (method ^:private ^:static getSerialFields :throws [InvalidClassException] ^ObjectStreamField/1 [^{:tag (Class ?)} cl]
    (if (not (.isAssignableFrom Serializable cl))
        NO_FIELDS
        (let [^:mutable ^ObjectStreamField/1 fields nil]
          (cond
            (.isRecord cl)
              (do (set! fields (ObjectStreamClass/getDefaultSerialFields cl)) (Arrays/sort fields))
            (and (and (not (.isAssignableFrom Externalizable cl)) (not (Proxy/isProxyClass cl)))
                 (not (.isInterface cl)))
              (do
                (when (nil? (set! fields (ObjectStreamClass/getDeclaredSerialFields cl)))
                  (set! fields (ObjectStreamClass/getDefaultSerialFields cl)))
                (Arrays/sort fields))
            :else (set! fields NO_FIELDS))
          fields)))

  (method ^:private ^:static getDeclaredSerialFields :throws [InvalidClassException] ^ObjectStreamField/1 [^{:tag (Class ?)} cl]
    (let [^:mutable ^ObjectStreamField/1 serialPersistentFields nil]
      (try
        (let [f (.getDeclaredField cl "serialPersistentFields")
              mask (bit-or-int (bit-or-int Modifier/PRIVATE Modifier/STATIC) Modifier/FINAL)]
          (when (== (bit-and-int (.getModifiers f) mask) mask)
            (.setAccessible f true)
            (set! serialPersistentFields (cast ObjectStreamField/1 (.get f nil)))))
        (catch Exception ex))
      (when (some? serialPersistentFields)
        (if (== (alength serialPersistentFields) 0)
            NO_FIELDS
            (let [boundFields (new ObjectStreamField/1 (alength serialPersistentFields))
                  ^{:tag (Set String)} fieldNames (HashSet/newHashSet
                                                    (alength serialPersistentFields))]
              (loop [^int i 0]
                (when (< i (alength serialPersistentFields))
                  (let [spf (aget serialPersistentFields i)
                        fname (.getName spf)]

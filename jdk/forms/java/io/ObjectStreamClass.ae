                  (set! primDataSize (unchecked-add-int primDataSize 4))
                  (recur (unchecked-inc-int i)))
              (\J \D)
                (do
                  (.setOffset f primDataSize)
                  (set! primDataSize (unchecked-add-int primDataSize 8))
                  (recur (unchecked-inc-int i)))
              (\[ \L)
                (do
                  (.setOffset f
                              (let [old-2 numObjFields]
                                (set! numObjFields (unchecked-inc-int numObjFields))
                                old-2))
                  (if (== firstObjIndex -1)
                      (do (set! firstObjIndex i) (recur (unchecked-inc-int i)))
                      (recur (unchecked-inc-int i))))
              (throw (InternalError.))))))
      (when (and (not (== firstObjIndex -1))
                 (not (== (unchecked-add-int firstObjIndex numObjFields) (alength fields))))
        (throw (InvalidClassException. name "illegal field order")))))

  (method ^:private getVariantFor :throws [InvalidClassException] ^ObjectStreamClass [this
                                                                                      ^{:tag (Class ?)} cl]
    (if (identical? (.-cl this) cl)
        this
        (let [desc (ObjectStreamClass.)]
          (if isProxy (.initProxy desc cl nil superDesc) (.initNonProxy desc this cl nil superDesc))
          desc)))

  (method ^:private ^:static getExternalizableConstructor ^{:tag (Constructor ?)} [^{:tag (Class ?)} cl]
    (try
      (let [^{:tag (Constructor ?)} cons (.getDeclaredConstructor cl (cast Class/1 nil))]
        (.setAccessible cons true)
        (when-not (== (bit-and-int (.getModifiers cons) Modifier/PUBLIC) 0) cons))
      (catch NoSuchMethodException ex nil)))

  (method ^:static recordComponentFields ^Field/1 [^{:tag (Class ?)} cls]
    (let [^{:tag (ArrayList Field)} fs (ArrayList.)]
      (for-each [^Field f (.getDeclaredFields cls)]
        (when-not (Modifier/isStatic (.getModifiers f)) (.add fs f)))
      (cast Field/1 (.toArray fs (new Field/1 0)))))

  (method ^:private ^:static canonicalRecordCtr ^{:tag (Constructor ?)} [^{:tag (Class ?)} cls]
    (java-assert (.isRecord cls) (java-str "Expected record, got: " cls))
    (let [components (ObjectStreamClass/recordComponentFields cls)
          ^{:tag (array (Class ?))} paramTypes (new Class/1 (alength components))]
      (loop [^int i 0]
        (when (< i (alength components))
          (aset paramTypes i (.getType (aget components i)))
          (recur (unchecked-inc-int i))))

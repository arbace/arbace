          ^{:tag (ArrayList ObjectStreamField)} list (ArrayList.)
          mask (bit-or-int Modifier/STATIC Modifier/TRANSIENT)]
      (loop [^int i 0]
        (if (< i (alength clFields))
            (if (== (bit-and-int (.getModifiers (aget clFields i)) mask) 0)
                (do
                  (.add list (ObjectStreamField. (aget clFields i) false true))
                  (recur (unchecked-inc-int i)))
                (recur (unchecked-inc-int i)))
            nil))
      (let [size (.size list)]
        (if (== size 0)
            NO_FIELDS
            (cast ObjectStreamField/1 (.toArray list (new ObjectStreamField/1 size)))))))

  (method ^:private ^:static getDeclaredSUID ^Long [^{:tag (Class ?)} cl]
    (try
      (let [f (.getDeclaredField cl "serialVersionUID")
            mask (bit-or-int Modifier/STATIC Modifier/FINAL)]
        (when (== (bit-and-int (.getModifiers f) mask) mask)
          (.setAccessible f true)
          (return (.getLong f nil))))
      (catch Exception ex))
    nil)

  (method ^:private ^:static computeDefaultSUID ^long [^{:tag (Class ?)} cl]
    (cond
      (or (not (.isAssignableFrom Serializable cl)) (Proxy/isProxyClass cl)) 0
      (SerialAlloc/hasDefaultSUID cl) (SerialAlloc/defaultSUID cl)
      :else
        (try
          (let [bout (ByteArrayOutputStream.)
                dout (DataOutputStream. bout)]
            (.writeUTF dout (.getName cl))
            (let [^:mutable classMods (bit-and-int
                                        (.getModifiers cl)
                                        (bit-or-int
                                          (bit-or-int
                                            (bit-or-int Modifier/PUBLIC Modifier/FINAL)
                                            Modifier/INTERFACE)
                                          Modifier/ABSTRACT))
                  methods (.getDeclaredMethods cl)]
              (when-not (== (bit-and-int classMods Modifier/INTERFACE) 0)
                (set! classMods
                      (if (> (alength methods) 0)
                          (bit-or-int classMods Modifier/ABSTRACT)
                          (bit-and-int classMods (bit-not-int Modifier/ABSTRACT)))))
              (.writeInt dout classMods)
              (when-not (.isArray cl)
                (let [^{:tag (array (Class ?))} interfaces (.getInterfaces cl)
                      ifaceNames (new String/1 (alength interfaces))]
                  (loop [^int i 0]
                    (when (< i (alength interfaces))
                      (aset ifaceNames i (.getName (aget interfaces i)))
                      (recur (unchecked-inc-int i))))
                  (Arrays/sort ifaceNames)
                  (loop [^int i 0]
                    (when (< i (alength ifaceNames))
                      (.writeUTF dout (aget ifaceNames i))
                      (recur (unchecked-inc-int i))))))
              (let [fields (.getDeclaredFields cl)
                    fieldSigs (new MemberSignature/1 (alength fields))]
                (loop [^int i 0]
                  (when (< i (alength fields))
                    (aset fieldSigs i (MemberSignature. (aget fields i)))
                    (recur (unchecked-inc-int i))))
                (Arrays/sort fieldSigs
                             (anon ^:diamond (Comparator MemberSignature) []
                               (method ^:public compare ^int [this ^MemberSignature ms1
                                                              ^MemberSignature ms2]
                                 (.compareTo (.-name ms1) (.-name ms2)))))
                (loop [^int i 0]
                  (when (< i (alength fieldSigs))
                    (let [sig (aget fieldSigs i)
                          mods (bit-and-int (.getModifiers (.-member sig))
                                            (bit-or-int
                                              (bit-or-int
                                                (bit-or-int
                                                  (bit-or-int
                                                    (bit-or-int
                                                      (bit-or-int Modifier/PUBLIC Modifier/PRIVATE)
                                                      Modifier/PROTECTED)
                                                    Modifier/STATIC)
                                                  Modifier/FINAL)
                                                Modifier/VOLATILE)
                                              Modifier/TRANSIENT))]
                      (if (or (== (bit-and-int mods Modifier/PRIVATE) 0)
                              (== (bit-and-int mods (bit-or-int Modifier/STATIC Modifier/TRANSIENT))
                                  0))
                          (do
                            (.writeUTF dout (.-name sig))
                            (.writeInt dout mods)
                            (.writeUTF dout (.-signature sig))
                            (recur (unchecked-inc-int i)))
                          (recur (unchecked-inc-int i))))))
                (when (ObjectStreamClass/hasStaticInitializer cl)
                  (.writeUTF dout "<clinit>")
                  (.writeInt dout Modifier/STATIC)
                  (.writeUTF dout "()V"))
                (let [^{:tag (array (Constructor ?))} cons (.getDeclaredConstructors cl)
                      consSigs (new MemberSignature/1 (alength cons))]
                  (loop [^int i 0]
                    (when (< i (alength cons))
                      (aset consSigs i (MemberSignature. (aget cons i)))
                      (recur (unchecked-inc-int i))))
                  (Arrays/sort consSigs
                               (anon ^:diamond (Comparator MemberSignature) []
                                 (method ^:public compare ^int [this ^MemberSignature ms1
                                                                ^MemberSignature ms2]
                                   (.compareTo (.-signature ms1) (.-signature ms2)))))
                  (loop [^int i 0]
                    (when (< i (alength consSigs))
                      (let [sig (aget consSigs i)
                            mods (bit-and-int (.getModifiers (.-member sig))
                                              (bit-or-int
                                                (bit-or-int
                                                  (bit-or-int
                                                    (bit-or-int
                                                      (bit-or-int
                                                        (bit-or-int
                                                          (bit-or-int
                                                            (bit-or-int
                                                              Modifier/PUBLIC
                                                              Modifier/PRIVATE)
                                                            Modifier/PROTECTED)
                                                          Modifier/STATIC)
                                                        Modifier/FINAL)
                                                      Modifier/SYNCHRONIZED)
                                                    Modifier/NATIVE)
                                                  Modifier/ABSTRACT)
                                                Modifier/STRICT))]
                        (if (== (bit-and-int mods Modifier/PRIVATE) 0)
                            (do
                              (.writeUTF dout "<init>")
                              (.writeInt dout mods)
                              (.writeUTF dout (.replace (.-signature sig) \/ \.))
                              (recur (unchecked-inc-int i)))
                            (recur (unchecked-inc-int i))))))
                  (let [methSigs (new MemberSignature/1 (alength methods))]
                    (loop [^int i 0]
                      (when (< i (alength methods))
                        (aset methSigs i (MemberSignature. (aget methods i)))
                        (recur (unchecked-inc-int i))))
                    (Arrays/sort methSigs
                                 (anon ^:diamond (Comparator MemberSignature) []
                                   (method ^:public compare ^int [this ^MemberSignature ms1
                                                                  ^MemberSignature ms2]
                                     (let [^:mutable comp (.compareTo (.-name ms1) (.-name ms2))]
                                       (when (== comp 0)
                                         (set! comp
                                               (.compareTo (.-signature ms1) (.-signature ms2))))
                                       comp))))
                    (loop [^int i 0]
                      (when (< i (alength methSigs))
                        (let [sig (aget methSigs i)
                              mods (bit-and-int (.getModifiers (.-member sig))
                                                (bit-or-int
                                                  (bit-or-int
                                                    (bit-or-int
                                                      (bit-or-int
                                                        (bit-or-int
                                                          (bit-or-int
                                                            (bit-or-int
                                                              (bit-or-int
                                                                Modifier/PUBLIC
                                                                Modifier/PRIVATE)
                                                              Modifier/PROTECTED)
                                                            Modifier/STATIC)
                                                          Modifier/FINAL)
                                                        Modifier/SYNCHRONIZED)
                                                      Modifier/NATIVE)
                                                    Modifier/ABSTRACT)
                                                  Modifier/STRICT))]
                          (if (== (bit-and-int mods Modifier/PRIVATE) 0)
                              (do
                                (.writeUTF dout (.-name sig))
                                (.writeInt dout mods)
                                (.writeUTF dout (.replace (.-signature sig) \/ \.))
                                (recur (unchecked-inc-int i)))
                              (recur (unchecked-inc-int i))))))
                    (.flush dout)
                    (let [md (MessageDigest/getInstance "SHA")
                          hashBytes (.digest md (.toByteArray bout))
                          ^:mutable hash 0]
                      (loop [^int i (unchecked-subtract-int
                                      (^[int int] Math/min (alength hashBytes) 8)
                                      1)]
                        (when (>= i 0)
                          (set! hash
                                (bit-or (bit-shift-left hash 8)
                                        (bit-and-int (aget hashBytes i) 0xFF)))
                          (recur (unchecked-dec-int i))))
                      hash))))))
          (catch IOException ex (throw (InternalError. ex)))
          (catch NoSuchAlgorithmException ex (throw (SecurityException. (.getMessage ex)))))))

  (method ^:private ^:static ^:native hasStaticInitializer ^boolean [^{:tag (Class ?)} cl])

  (defclass ^:private ^:static ^:final MemberSignature
    (field ^:public ^:final ^Member member)

    (field ^:public ^:final ^String name)

    (field ^:public ^:final ^String signature)

    (constructor ^:public [this ^Field field]
      (set! member field)
      (set! name (.getName field))
      (set! signature (.descriptorString (.getType field))))

    (constructor ^:public [this ^{:tag (Constructor ?)} cons]
      (set! member cons)
      (set! name (.getName cons))
      (set! signature (ObjectStreamClass/getMethodSignature (.getParameterTypes cons) Void/TYPE)))

    (constructor ^:public [this ^Method meth]
      (set! member meth)
      (set! name (.getName meth))
      (set! signature
            (ObjectStreamClass/getMethodSignature (.getParameterTypes meth) (.getReturnType meth)))))

  (defclass ^:private ^:static ^:final FieldReflector
    (field ^:private ^:final ^ObjectStreamField/1 fields)

    (field ^:private ^:final ^int numPrimFields)

    (field ^:private ^:final ^Field/1 readFields)

    (field ^:private ^:final ^Field/1 writeFields)

    (field ^:private ^:final ^int/1 offsets)

    (field ^:private ^:final ^char/1 typeCodes)

    (field ^:private ^:final ^{:tag (array (Class ?))} types)

    (constructor [this ^ObjectStreamField/1 fields]
      (set! (.-fields this) fields)
      (let [nfields (alength fields)]
        (set! readFields (new Field/1 nfields))
        (set! writeFields (new Field/1 nfields))
        (set! offsets (new int/1 nfields))
        (set! typeCodes (new char/1 nfields))
        (let [^{:tag (ArrayList (Class ?))} typeList (ArrayList.)
              ^{:tag (Set Field)} usedFields (HashSet.)]
          (loop [^int i 0]
            (when (< i nfields)
              (let [f (aget fields i)
                    rf (.getField f)]
                (when (some? rf) (.setAccessible rf true))
                (aset readFields i rf)
                (aset writeFields i (when (and (some? rf) (.add usedFields rf)) rf))
                (aset offsets i (.getOffset f))
                (aset typeCodes i (.getTypeCode f))
                (if (not (.isPrimitive f))
                    (do
                      (.add typeList ^Class (when (some? rf) (.getType rf)))
                      (recur (unchecked-inc-int i)))
                    (recur (unchecked-inc-int i))))))
          (set! types (cast Class/1 (.toArray typeList (new Class/1 (.size typeList)))))
          (set! numPrimFields (unchecked-subtract-int nfields (alength types))))))

    (method getFields ^ObjectStreamField/1 [this] fields)

    (method getPrimFieldValues ^void [this obj ^byte/1 buf]
      (when (nil? obj) (throw (NullPointerException.)))
      (try
        (loop [^int i 0]
          (when (< i numPrimFields)
            (let [f (aget readFields i)
                  off (aget offsets i)]
              (switch (aget typeCodes i)
                \Z
                  (do
                    (ByteArray/setBoolean buf off (.getBoolean f obj))
                    (recur (unchecked-inc-int i)))
                \B (do (aset buf off (.getByte f obj)) (recur (unchecked-inc-int i)))
                \C (do (ByteArray/setChar buf off (.getChar f obj)) (recur (unchecked-inc-int i)))
                \S (do (ByteArray/setShort buf off (.getShort f obj)) (recur (unchecked-inc-int i)))
                \I (do (ByteArray/setInt buf off (.getInt f obj)) (recur (unchecked-inc-int i)))
                \F (do (ByteArray/setFloat buf off (.getFloat f obj)) (recur (unchecked-inc-int i)))
                \J (do (ByteArray/setLong buf off (.getLong f obj)) (recur (unchecked-inc-int i)))
                \D
                  (do
                    (ByteArray/setDouble buf off (.getDouble f obj))
                    (recur (unchecked-inc-int i)))
                (throw (InternalError.))))))
        (catch IllegalAccessException ex (throw (InternalError. ex)))))

    (method setPrimFieldValues ^void [this obj ^byte/1 buf]
      (when (nil? obj) (throw (NullPointerException.)))
      (try
        (loop [^int i 0]
          (when (< i numPrimFields)
            (let [f (aget writeFields i)]
              (if (nil? f)
                  (recur (unchecked-inc-int i))
                  (let [off (aget offsets i)]
                    (switch (aget typeCodes i)
                      \Z
                        (do
                          (.setBoolean f obj (ByteArray/getBoolean buf off))
                          (recur (unchecked-inc-int i)))
                      \B (do (.setByte f obj (aget buf off)) (recur (unchecked-inc-int i)))
                      \C
                        (do
                          (.setChar f obj (ByteArray/getChar buf off))
                          (recur (unchecked-inc-int i)))
                      \S
                        (do
                          (.setShort f obj (ByteArray/getShort buf off))
                          (recur (unchecked-inc-int i)))
                      \I
                        (do
                          (.setInt f obj (ByteArray/getInt buf off))
                          (recur (unchecked-inc-int i)))
                      \F
                        (do
                          (.setFloat f obj (ByteArray/getFloat buf off))
                          (recur (unchecked-inc-int i)))
                      \J
                        (do
                          (.setLong f obj (ByteArray/getLong buf off))
                          (recur (unchecked-inc-int i)))
                      \D
                        (do
                          (.setDouble f obj (ByteArray/getDouble buf off))
                          (recur (unchecked-inc-int i)))
                      (throw (InternalError.))))))))
        (catch IllegalAccessException ex (throw (InternalError. ex)))))

    (method getObjFieldValues ^void [this obj ^Object/1 vals]
      (when (nil? obj) (throw (NullPointerException.)))
      (try
        (loop [^int i numPrimFields]
          (when (< i (alength fields))
            (aset vals
                  (aget offsets i)
                  (switch (aget typeCodes i)
                    (\L \[) (.get (aget readFields i) obj)
                    (throw (InternalError.))))
            (recur (unchecked-inc-int i))))
        (catch IllegalAccessException ex (throw (InternalError. ex)))))

    (method checkObjectFieldValueTypes ^void [this obj ^Object/1 vals]
      (.setObjFieldValues this obj vals true))

    (method setObjFieldValues ^void [this obj ^Object/1 vals]
      (.setObjFieldValues this obj vals false))

    (method ^:private setObjFieldValues ^void [this obj ^Object/1 vals ^boolean dryRun]
      (when (nil? obj) (throw (NullPointerException.)))
      (loop [^int i numPrimFields]
        (when (< i (alength fields))
          (let [wf (aget writeFields i)]
            (if (nil? wf)
                (recur (unchecked-inc-int i))
                (switch (aget typeCodes i)
                  (\L \[)
                    (let [val (aget vals (aget offsets i))]
                      (when (and (some? val)
                                 (not (.isInstance
                                        (aget types (unchecked-subtract-int i numPrimFields))
                                        val)))
                        (let [f (.getField (aget fields i))]
                          (throw (ClassCastException.
                                   (java-str "cannot assign instance of "
                                             (.getName (.getClass val))
                                             " to field "
                                             (.getName (.getDeclaringClass f))
                                             "."
                                             (.getName f)
                                             " of type "
                                             (.getName (.getType f))
                                             " in instance of "
                                             (.getName (.getClass obj)))))))
                      (if (not dryRun)
                          (do
                            (try
                              (.set wf obj val)
                              (catch IllegalAccessException ex (throw (InternalError. ex))))
                            (recur (unchecked-inc-int i)))
                          (recur (unchecked-inc-int i))))
                  (throw (InternalError.)))))))))

  (method ^:private ^:static getReflector :throws [InvalidClassException] ^FieldReflector [^ObjectStreamField/1 fields
                                                                                           ^ObjectStreamClass localDesc]
    (let [^{:tag (Class ?)} cl (if (and (some? localDesc) (> (alength fields) 0))
                                   (.-cl localDesc)
                                   Void)
          clReflectors (cast Map (.get Caches/reflectors cl))
          key (FieldReflectorKey. fields)
          ^:mutable reflector (cast FieldReflector (.get clReflectors key))]
      (when (nil? reflector)
        (set! reflector (FieldReflector. (ObjectStreamClass/matchFields fields localDesc)))
        (let [oldReflector (cast FieldReflector (.putIfAbsent clReflectors key reflector))]
          (when (some? oldReflector) (set! reflector oldReflector))))
      reflector))

  (defclass ^:private ^:static FieldReflectorKey
    (field ^:private ^:final ^String/1 sigs)

    (field ^:private ^:final ^int hash)

    (constructor [this ^ObjectStreamField/1 fields]
      (set! sigs (new String/1 (unchecked-multiply-int 2 (alength fields))))
      (let [^:mutable ^int i 0
            ^:mutable ^int j 0]
        (while (< i (alength fields))

    (method ^:private ^:static isDriverAllowed ^boolean [^Driver driver ^ClassLoader classLoader]
      (let [^:mutable result false]
        (when (some? driver)
          (let [^:mutable ^{:tag (Class ?)} aClass nil]
            (try
              (set! aClass (Class/forName (.getName (.getClass driver)) true classLoader))
              (catch Exception ex (set! result false)))
            (set! result (if (identical? aClass (.getClass driver)) true false))))
        result))

    (method ^:private ^:static ensureDriversInitialized ^void []
      (when-not driversInitialized
        (locking lockForInitDrivers
          (when-not driversInitialized
            (let [^:mutable ^String drivers nil]
              (try
                (set! drivers (System/getProperty JDBC_DRIVERS_PROPERTY))
                (catch Exception ex (set! drivers nil)))
              (DriverManager/println (java-str "DriverManager.initialize: jdbc.drivers = " drivers))
              (when (and (some? drivers) (not (.isEmpty drivers)))
                (let [driversList (.split drivers ":")]
                  (DriverManager/println (java-str "number of Drivers:" (alength driversList)))
                  (for-each [^String aDriver driversList]
                    (try
                      (DriverManager/println
                        (java-str "DriverManager.Initialize: loading " aDriver))
                      (Class/forName aDriver true (ClassLoader/getSystemClassLoader))
                      (catch Exception ex
                        (DriverManager/println
                          (java-str "DriverManager.Initialize: load failed: " ex)))))))
              (set! driversInitialized true)
              (DriverManager/println "JDBC DriverManager initialized"))))))

    (method ^:private ^:static getConnection :throws [SQLException] ^Connection [^String url
                                                                                 ^Properties info
                                                                                 ^{:tag (Class ?)} caller]
      (let [^:mutable ^ClassLoader callerCL (when (some? caller) (.getClassLoader caller))]
        (when (or (nil? callerCL) (identical? callerCL (ClassLoader/getPlatformClassLoader)))
          (set! callerCL (.getContextClassLoader (Thread/currentThread))))
        (when (nil? url) (throw (SQLException. "The url cannot be null" "08001")))
        (DriverManager/println (java-str "DriverManager.getConnection(\"" url "\")"))
        (DriverManager/ensureDriversInitialized)
        (let [^:mutable ^SQLException reason nil]
          (for-each [^DriverInfo aDriver registeredDrivers]
            (if (DriverManager/isDriverAllowed (.-driver aDriver) callerCL)
                (try
                  (DriverManager/println
                    (java-str "    trying " (.getName (.getClass (.-driver aDriver)))))
                  (let [con (.connect (.-driver aDriver) url info)]
                    (when (some? con)
                      (DriverManager/println
                        (java-str "getConnection returning "
                                  (.getName (.getClass (.-driver aDriver)))))
                      (return con)))
                  (catch SQLException ex (when (nil? reason) (set! reason ex))))
                (DriverManager/println
                  (java-str "    skipping: " (.getName (.getClass (.-driver aDriver)))))))
          (when (some? reason)
            (DriverManager/println (java-str "getConnection failed: " reason))
            (throw reason))
          (DriverManager/println (java-str "getConnection: no suitable driver found for " url))
          (throw (SQLException. (java-str "No suitable driver found for " url) "08001"))))))

  (defclass DriverInfo

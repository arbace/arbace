                          (when (== (unchecked-add-int r 1) q) (.fail this "scope id expected"))
                          (.checkChars this
                                       (unchecked-add-int r 1)
                                       q
                                       L_SCOPE_ID
                                       H_SCOPE_ID
                                       "scope id"))
                        (.parseIPv6Reference this p q))
                    (set! host
                          (.substring input (unchecked-subtract-int p 1) (unchecked-add-int q 1)))
                    (set! p (unchecked-add-int q 1)))
                  (.failExpecting this "closing bracket for IPv6 address" q)))
            (do
              (set! q (.parseIPv4Address this p n))
              (when (<= q p) (set! q (.parseHostname this p n skipParseException)))
              (set! p q)))
        (cond
          (.at this p n \:)
            (do
              (set! p (unchecked-inc-int p))
              (set! q (.scan this p n "/"))
              (when (> q p)
                (.checkChars this p q L_DIGIT H_DIGIT "port number")
                (try
                  (set! port (Integer/parseInt input p q 10))
                  (catch NumberFormatException x (.fail this "Malformed port number" p)))
                (set! p q)))
          (and (< p n) skipParseException) (return p))
        (when (< p n) (.failExpecting this "port number" p))
        p))

    (method ^:private scanByte :throws [URISyntaxException] ^int [this ^int start ^int n]
      (let [p start
            q (.scan this p n L_DIGIT H_DIGIT)]
        (if (<= q p)
            q
            (let [^:mutable i p
                  ^:mutable ^int j 0]
              (while (> (set! j (.scan this i q \0)) i) (set! i j))
              (let [significantDigitsNum (unchecked-subtract-int q i)]
                (cond
                  (< significantDigitsNum 3) q
                  (> significantDigitsNum 3) p
                  (> (Integer/parseInt input p q 10) 255) p
                  :else q))))))

    (method ^:private scanIPv4Address :throws [URISyntaxException] ^int [this ^int start ^int n
                                                                         ^boolean strict]
      (let [^:mutable p start
            ^:mutable ^int q 0
            m (.scan this p n (bit-or L_DIGIT L_DOT) (bit-or H_DIGIT H_DOT))]
        (if (or (<= m p) (and strict (not (== m n))))
            -1
            (do
              (while true
                (when (<= (set! q (.scanByte this p m)) p) (break))
                (set! p q)
                (when (<= (set! q (.scan this p m \.)) p) (break))
                (set! p q)
                (when (<= (set! q (.scanByte this p m)) p) (break))
                (set! p q)
                (when (<= (set! q (.scan this p m \.)) p) (break))
                (set! p q)
                (when (<= (set! q (.scanByte this p m)) p) (break))
                (set! p q)
                (when (<= (set! q (.scan this p m \.)) p) (break))
                (set! p q)
                (when (<= (set! q (.scanByte this p m)) p) (break))
                (set! p q)
                (when (< q m) (break))
                (return q))
              (when strict (.fail this "Malformed IPv4 address" q))
              -1))))

    (method ^:private takeIPv4Address :throws [URISyntaxException] ^int [this ^int start ^int n
                                                                         ^String expected]
      (let [p (.scanIPv4Address this start n true)]
        (when (<= p start) (.failExpecting this expected start))
        p))

    (method ^:private parseIPv4Address ^int [this ^int start ^int n]
      (let [^:mutable ^int p 0]
        (try
          (set! p (.scanIPv4Address this start n false))
          (catch [URISyntaxException NumberFormatException] x (return -1)))
        (if (== p -1)
            p
            (do
              (when (and (> p start) (< p n)) (when-not (== (.charAt input p) \:) (return -1)))
              (when (> p start) (set! host (.substring input start p)))
              p))))

    (method ^:private parseHostname :throws [URISyntaxException] ^int [this ^int start ^int n
                                                                       ^boolean skipParseException]
      (let [^:mutable p start
            ^:mutable ^int q 0
            ^:mutable ^int l -1]
        (loop []
          (set! q (.scan this p n L_ALPHANUM H_ALPHANUM))
          (when (<= q p) (break))
          (set! l p)
          (set! p q)
          (set! q (.scan this p n (bit-or L_ALPHANUM L_DASH) (bit-or H_ALPHANUM H_DASH)))
          (when (> q p)
            (when (== (.charAt input (unchecked-subtract-int q 1)) \-)
              (.fail this "Illegal character in hostname" (unchecked-subtract-int q 1)))
            (set! p q))
          (set! q (.scan this p n \.))
          (when (<= q p) (break))
          (set! p q)
          (when (< p n) (recur)))
        (when (and (< p n) (not (.at this p n \:)))
          (when skipParseException (return p))
          (.fail this "Illegal character in hostname" p))
        (when (< l 0) (.failExpecting this "hostname" start))
        (when (and (> l start) (not (URI/match (.charAt input l) L_ALPHA H_ALPHA)))
          (.fail this "Illegal character in hostname" l))
        (set! host (.substring input start p))
        p))

    (field ^:private ^int ipv6byteCount 0)

    (method ^:private parseIPv6Reference :throws [URISyntaxException] ^int [this ^int start ^int n]
      (let [^:mutable p start
            ^:mutable ^int q 0
            ^:mutable compressedZeros false]
        (set! q (.scanHexSeq this p n))
        (if (> q p)
            (do
              (set! p q)
              (if (.at this p n "::")
                  (do
                    (set! compressedZeros true)
                    (set! p (.scanHexPost this (unchecked-add-int p 2) n)))
                  (when (.at this p n \:)
                    (set! p (.takeIPv4Address this (unchecked-add-int p 1) n "IPv4 address"))
                    (set! ipv6byteCount (unchecked-add-int ipv6byteCount 4)))))
            (when (.at this p n "::")
              (set! compressedZeros true)
              (set! p (.scanHexPost this (unchecked-add-int p 2) n))))
        (when (< p n) (.fail this "Malformed IPv6 address" start))
        (when (> ipv6byteCount 16) (.fail this "IPv6 address too long" start))
        (when (and (not compressedZeros) (< ipv6byteCount 16))
          (.fail this "IPv6 address too short" start))
        (when (and compressedZeros (== ipv6byteCount 16))
          (.fail this "Malformed IPv6 address" start))
        p))

    (method ^:private scanHexPost :throws [URISyntaxException] ^int [this ^int start ^int n]
      (let [^:mutable p start
            ^:mutable ^int q 0]
        (if (== p n)
            p
            (do
              (set! q (.scanHexSeq this p n))
              (if (> q p)
                  (do
                    (set! p q)
                    (when (.at this p n \:)
                      (set! p (unchecked-inc-int p))
                      (set! p (.takeIPv4Address this p n "hex digits or IPv4 address"))
                      (set! ipv6byteCount (unchecked-add-int ipv6byteCount 4))))
                  (do
                    (set! p (.takeIPv4Address this p n "hex digits or IPv4 address"))
                    (set! ipv6byteCount (unchecked-add-int ipv6byteCount 4))))
              p))))

    (method ^:private scanHexSeq :throws [URISyntaxException] ^int [this ^int start ^int n]
      (let [^:mutable p start
            ^:mutable ^int q 0]
        (set! q (.scan this p n L_HEX H_HEX))
        (cond
          (<= q p) -1
          (.at this q n \.) -1
          :else
            (do
              (when (> q (unchecked-add-int p 4))
                (.fail this "IPv6 hexadecimal digit sequence too long" p))
              (set! ipv6byteCount (unchecked-add-int ipv6byteCount 2))
              (set! p q)
              (while (< p n)
                (when-not (.at this p n \:) (break))
                (when (.at this (unchecked-add-int p 1) n \:) (break))
                (set! p (unchecked-inc-int p))
                (set! q (.scan this p n L_HEX H_HEX))
                (when (<= q p) (.failExpecting this "digits for an IPv6 address" p))
                (when (.at this q n \.) (set! p (unchecked-dec-int p)) (break))
                (when (> q (unchecked-add-int p 4))
                  (.fail this "IPv6 hexadecimal digit sequence too long" p))
                (set! ipv6byteCount (unchecked-add-int ipv6byteCount 2))
                (set! p q))
              p)))))

  (static-initializer
    (SharedSecrets/setJavaNetUriAccess
      (anon JavaNetUriAccess []
        (method ^:public create ^URI [this ^String scheme ^String path]
          (URI. scheme path))))))

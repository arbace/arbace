          ^:mutable skipped 0]
      (while (not (== skipped toSkip))
        (set! eachSkip (.skip is (unchecked-subtract toSkip skipped)))
        (when (<= eachSkip 0)
          (if (== (.read is) -1) (return skipped) (set! skipped (unchecked-inc skipped))))
        (set! skipped (unchecked-add skipped eachSkip)))
      skipped))

  (method ^:private checkConnected ^void [this]
    (when connected (throw (IllegalStateException. "Already connected")))))

(defclass UnknownContentHandler
  :extends ContentHandler

  (field ^:static ^:final ^ContentHandler INSTANCE (UnknownContentHandler.))

  (method ^:public getContent :throws [IOException] [this ^URLConnection uc]
    (.getInputStream uc)))

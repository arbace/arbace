        (when (== (bit-and-int mask LISTEN) LISTEN) (.add sj "listen"))
        (when (== (bit-and-int mask ACCEPT) ACCEPT) (.add sj "accept"))
        (when (== (bit-and-int mask RESOLVE) RESOLVE) (.add sj "resolve"))
        (.toString sj)))

    (method ^:public getActions ^String [this]
      (when (nil? actions) (set! actions (SocketPermission/getActions (.-mask this))))
      actions)

    (method ^:public newPermissionCollection ^PermissionCollection [this]
      (SocketPermissionCollection.))

    (method ^:private ^:synchronized writeObject :throws [IOException] ^void [this
                                                                              ^ObjectOutputStream s]
      (when (nil? actions) (.getActions this))
      (.defaultWriteObject s))

    (method ^:private ^:synchronized readObject :throws [IOException ClassNotFoundException] ^void [this
                                                                                                    ^ObjectInputStream s]
      (.defaultReadObject s)
      (.init this (.getName this) (SocketPermission/getMask actions)))

    (method ^:private ^:static initEphemeralPorts ^int [^String suffix]
      (let [^int val (Integer/getInteger (java-str "jdk.net.ephemeralPortRange." suffix) -1)]
        (cond
          (not (== val -1)) val
          (.equals suffix "low") (PortConfig/getLower)
          :else (PortConfig/getUpper))))

    (method ^:private ^:static inRange ^boolean [^int policyLow ^int policyHigh
                                                 ^:mutable ^int targetLow ^int targetHigh]
      (let [ephemeralLow EphemeralRange/low
            ephemeralHigh EphemeralRange/high]
        (when (== targetLow 0)
          (when-not (SocketPermission/inRange policyLow policyHigh ephemeralLow ephemeralHigh)
            (return false))
          (when (== targetHigh 0) (return true))
          (set! targetLow 1))
        (cond
          (and (== policyLow 0) (== policyHigh 0))
            (and (>= targetLow ephemeralLow) (<= targetHigh ephemeralHigh))
          (not (== policyLow 0)) (and (>= targetLow policyLow) (<= targetHigh policyHigh))
          (>= policyHigh (unchecked-subtract-int ephemeralLow 1)) (<= targetHigh ephemeralHigh)
          :else
            (or (and (<= targetLow policyHigh) (<= targetHigh policyHigh))
                (and (>= targetLow ephemeralLow) (<= targetHigh ephemeralHigh)))))))

  (defclass ^:final SocketPermissionCollection
    :extends PermissionCollection
    :implements [Serializable]

    (field ^:private ^:transient ^{:tag (Map String SocketPermission)} perms)

    (constructor ^:public [this] (set! perms (ConcurrentHashMap.)))

    (method ^:public add ^void [this ^Permission permission]
      (if-instance [^SocketPermission sp permission]
        (do
          (when (.isReadOnly this)
            (throw (SecurityException.
                     "attempt to add a Permission to a readonly PermissionCollection")))
          (.merge perms
                  (.getName sp)
                  sp
                  (lambda BiFunction ^SocketPermission [^SocketPermission existingVal
                                                        ^SocketPermission newVal]
                    (let [oldMask (.getMask existingVal)
                          newMask (.getMask newVal)]
                      (when-not (== oldMask newMask)
                        (let [effective (bit-or-int oldMask newMask)]
                          (when (== effective newMask) (return newVal))
                          (when-not (== effective oldMask)
                            (return (SocketPermission. (.getName sp) effective)))))
                      existingVal))))
        (throw (IllegalArgumentException. (java-str "invalid permission: " permission)))))

    (method ^:public implies ^boolean [this ^Permission permission]
      (if-instance [^SocketPermission np permission]
        (let [desired (.getMask np)
              ^:mutable ^int effective 0
              ^:mutable needed desired
              hit (cast SocketPermission (.get perms (.getName np)))]
          (when (some? hit)
            (when (and (not (== (bit-and-int needed (.getMask hit)) 0)) (.impliesIgnoreMask hit np))
              (set! effective (bit-or-int effective (.getMask hit)))
              (when (== (bit-and-int effective desired) desired) (return true))
              (set! needed (bit-and-int desired (bit-not-int effective)))))
          (for-each [^SocketPermission x (.values perms)]
            (when (and (not (== (bit-and-int needed (.getMask x)) 0)) (.impliesIgnoreMask x np))
              (set! effective (bit-or-int effective (.getMask x)))
              (when (== (bit-and-int effective desired) desired) (return true))
              (set! needed (bit-and-int desired (bit-not-int effective)))))
          false)
        false))

    (method ^:public elements ^{:tag (Enumeration Permission)} [this]
      (Collections/enumeration (.values perms)))

    (field ^:private ^:static ^:final ^long serialVersionUID 2787186408602843674)

    (field ^:private ^:static ^:final ^ObjectStreamField/1 serialPersistentFields
      (new ObjectStreamField/1 [(ObjectStreamField. "permissions" Vector)]))

    (method ^:private writeObject :throws [IOException] ^void [this ^ObjectOutputStream out]
      (let [^{:tag (Vector SocketPermission)} permissions (Vector. (.values perms))
            pfields (.putFields out)]
        (.put pfields "permissions" permissions)
        (.writeFields out)))

    (method ^:private readObject :throws [IOException ClassNotFoundException] ^void [this
                                                                                     ^ObjectInputStream in]
      (let [gfields (.readFields in)
            ^{:tag (Vector SocketPermission)} permissions (cast
                                                            Vector
                                                            (.get gfields "permissions" nil))]
        (set! perms (ConcurrentHashMap. (.size permissions)))
        (for-each [^SocketPermission sp permissions] (.put perms (.getName sp) sp))))))

                (set! ex uhe)
                (do (set! ex (UnknownHostException.)) (.initCause ex x))))))
      (let [^InetAddress/1 result (when (some? addresses)
                                    (cast
                                      InetAddress/1
                                      (.toArray
                                        addresses
                                        (lambda IntFunction ^InetAddress/1 ^:method-ref [^int n-1]
                                          (new InetAddress/1 n-1)))))]
        (when (or (nil? result) (== (alength result) 0))
          (throw (if (nil? ex)
                     (UnknownHostException.

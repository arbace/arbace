  (method ^:private ^:static getAllByName0 :throws [UnknownHostException] ^InetAddress/1 [^String host
                                                                                          ^boolean useCache]
    (let [now (System/nanoTime)]
      (for-each [^CachedLookup caddrs expirySet]
        (when-not (.tryRemoveExpiredAddress caddrs now) (break)))
      (let [^:mutable ^Addresses addrs nil]
        (if useCache
            (set! addrs (cast Addresses (.get cache host)))
            (do
              (set! addrs (cast Addresses (.remove cache host)))
              (when (some? addrs)
                (when (instance? CachedLookup addrs) (.remove expirySet addrs))
                (set! addrs nil))))
        (when (nil? addrs)
          (let [oldAddrs (cast Addresses
                               (.putIfAbsent cache host (set! addrs (NameServiceAddresses. host))))]
            (when (some? oldAddrs) (set! addrs oldAddrs))))
        (.clone (.get addrs)))))

  (method ^:static getAddressesFromNameService :throws [UnknownHostException] ^InetAddress/1 [^String host]
    (let [^:mutable ^{:tag (Stream InetAddress)} addresses nil
          ^:mutable ^UnknownHostException ex nil
          resolver (InetAddress/resolver)]

                                ^:mutable ^byte/1 addr nil]
                            (switch (aget data 1)
                              SocksSocketImpl/REQUEST_OK
                                (switch (aget data 3)
                                  SocksSocketImpl/IPV4
                                    (do
                                      (set! addr (new byte/1 4))
                                      (set! i (.readSocksReply this in addr deadlineMillis))
                                      (when-not (== i 4)
                                        (throw (SocketException.
                                                 "Reply from SOCKS server badly formatted")))
                                      (set! data (new byte/1 2))
                                      (set! i (.readSocksReply this in data deadlineMillis))
                                      (when-not (== i 2)
                                        (throw (SocketException.
                                                 "Reply from SOCKS server badly formatted"))))

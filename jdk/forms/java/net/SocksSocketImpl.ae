                                        (when-not (== i len)
                                          (throw
                                            (SocketException.
                                              "Reply from SOCKS server badly formatted")))
                                        (set! data (new byte/1 2))
                                        (set! i (.readSocksReply this in data deadlineMillis))
                                        (when-not (== i 2)
                                          (throw
                                            (SocketException.
                                              "Reply from SOCKS server badly formatted")))))
                                  SocksSocketImpl/IPV6
                                    (do
                                      (set! len 16)
                                      (set! addr (new byte/1 len))
                                      (set! i (.readSocksReply this in addr deadlineMillis))
                                      (when-not (== i len)
                                        (throw (SocketException.
                                                 "Reply from SOCKS server badly formatted")))
                                      (set! data (new byte/1 2))
                                      (set! i (.readSocksReply this in data deadlineMillis))
                                      (when-not (== i 2)
                                        (throw (SocketException.
                                                 "Reply from SOCKS server badly formatted"))))
                                  (set! ex
                                        (SocketException.
                                          "Reply from SOCKS server contains wrong code")))
                              SocksSocketImpl/GENERAL_FAILURE
                                (set! ex (SocketException. "SOCKS server general failure"))
                              SocksSocketImpl/NOT_ALLOWED
                                (set! ex
                                      (SocketException. "SOCKS: Connection not allowed by ruleset"))
                              SocksSocketImpl/NET_UNREACHABLE
                                (set! ex (SocketException. "SOCKS: Network unreachable"))
                              SocksSocketImpl/HOST_UNREACHABLE
                                (set! ex (SocketException. "SOCKS: Host unreachable"))
                              SocksSocketImpl/CONN_REFUSED
                                (set! ex (SocketException. "SOCKS: Connection refused"))
                              SocksSocketImpl/TTL_EXPIRED
                                (set! ex (SocketException. "SOCKS: TTL expired"))
                              SocksSocketImpl/CMD_NOT_SUPPORTED
                                (set! ex (SocketException. "SOCKS: Command not supported"))
                              SocksSocketImpl/ADDR_TYPE_NOT_SUP
                                (set! ex (SocketException. "SOCKS: address type not supported")))
                            (when (some? ex) (.close in) (.close out) (throw ex))
                            (set! external_address epoint)))))))))
        (throw (IllegalArgumentException. "Unsupported address type")))))


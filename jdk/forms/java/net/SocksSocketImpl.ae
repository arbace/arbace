                                    91 (SocketException. "SOCKS request rejected")
                                    92 (SocketException. "SOCKS server couldn't reach destination")
                                    93 (SocketException. "SOCKS authentication failed")
                                    (SocketException. "Reply from SOCKS server contains bad status"))]
          (when (some? ex) (.close in) (.close out) (throw ex))))))

  (method ^:protected connect :throws [IOException] ^void [this ^String host ^int port]
    (.connect this (InetSocketAddress. host port) 0))

  (method ^:protected connect :throws [IOException] ^void [this ^InetAddress address ^int port]

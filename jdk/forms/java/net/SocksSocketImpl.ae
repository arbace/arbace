                                  (bit-and-int (bit-shift-right-int (.getPort epoint) 8) 0xff))
                                (.write
                                  out
                                  (bit-and-int (bit-shift-right-int (.getPort epoint) 0) 0xff))))
                          (.flush out)
                          (set! data (new byte/1 4))
                          (set! i (.readSocksReply this in data deadlineMillis))
                          (when-not (== i 4)
                            (throw (SocketException. "Reply from SOCKS server has bad length")))
                          (let [^:mutable ^SocketException ex nil

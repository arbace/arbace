  (method ^:protected connect :throws [IOException] ^void [this ^SocketAddress endpoint ^int timeout]
    (let [^:mutable ^long deadlineMillis 0]
      (if (== timeout 0)
          (set! deadlineMillis 0)
          (let [finish (unchecked-add (System/currentTimeMillis) timeout)]
            (set! deadlineMillis (if (< finish 0) Long/MAX_VALUE finish))))
      (if-instance [^InetSocketAddress epoint endpoint]
        (do
          (if (nil? server)
              (let [sel (ProxySelector/getDefault)]
                (when (nil? sel)
                  (.connect (.-delegate this)
                            epoint
                            (SocksSocketImpl/remainingMillis deadlineMillis))
                  (return))
                (let [^:mutable ^URI uri nil
                      ^:mutable host (.getHostString epoint)]
                  (if (IPAddressUtil/isIPv6LiteralAddress host)
                      (set! host (java-str "[" host "]"))
                      (set! host (ParseUtil/encodePath host)))
                  (try
                    (set! uri (URI. (java-str "socket://" host ":" (.getPort epoint))))
                    (catch URISyntaxException e (throw (IOException. "Failed to select a proxy" e))))
                  (let [^:mutable ^Proxy p nil
                        ^:mutable ^IOException savedExc nil
                        ^:mutable ^{:tag (Iterator Proxy)} iProxy nil]
                    (try
                      (set! iProxy (.iterator (.select sel uri)))
                      (catch IllegalArgumentException iae
                        (throw (IOException. "Failed to select a proxy" iae))))
                    (when (or (nil? iProxy) (not (.hasNext iProxy)))
                      (.connect (.-delegate this)
                                epoint
                                (SocksSocketImpl/remainingMillis deadlineMillis))
                      (return))
                    (while (.hasNext iProxy)
                      (set! p (cast Proxy (.next iProxy)))
                      (when (or (nil? p) (not (identical? (.type p) Proxy$Type/SOCKS)))
                        (.connect (.-delegate this)
                                  epoint
                                  (SocksSocketImpl/remainingMillis deadlineMillis))
                        (return))
                      (when-not (instance? InetSocketAddress (.address p))
                        (throw (SocketException. (java-str "Unknown address type for proxy: " p))))
                      (set! server (.getHostString (cast InetSocketAddress (.address p))))
                      (set! serverPort (.getPort (cast InetSocketAddress (.address p))))
                      (set! useV4 (SocksSocketImpl/useV4 p))
                      (try
                        (.doConnect this
                                    server
                                    serverPort
                                    (SocksSocketImpl/remainingMillis deadlineMillis))
                        (break)
                        (catch IOException e
                          (.connectFailed sel uri (.address p) e)
                          (set! server nil)
                          (set! serverPort -1)
                          (set! savedExc e))))
                    (when (nil? server)
                      (throw (SocketException.
                               (java-str "Can't connect to SOCKS proxy:" (.getMessage savedExc))))))))
              (try
                (.doConnect this server serverPort (SocksSocketImpl/remainingMillis deadlineMillis))
                (catch IOException e (throw (SocketException. (.getMessage e) e)))))

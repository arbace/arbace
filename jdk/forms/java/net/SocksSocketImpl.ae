  (method ^:private connectV4 :throws [IOException] ^void [this ^InputStream in ^OutputStream out
                                                           ^InetSocketAddress endpoint
                                                           ^long deadlineMillis]
    (when-not (instance? Inet4Address (.getAddress endpoint))
      (throw (SocketException. "SOCKS V4 requires IPv4 only addresses")))
    (.write out SocksSocketImpl/PROTO_VERS4)
    (.write out SocksSocketImpl/CONNECT)
    (.write out (bit-and-int (bit-shift-right-int (.getPort endpoint) 8) 0xff))
    (.write out (bit-and-int (bit-shift-right-int (.getPort endpoint) 0) 0xff))
    (.write out (.getAddress (.getAddress endpoint)))
    (let [userName (.getUserName this)]
      (.write out (.getBytes userName StandardCharsets/ISO_8859_1))
      (.write out 0)
      (.flush out)
      (let [data (new byte/1 8)
            n (.readSocksReply this in data deadlineMillis)]
        (when-not (== n 8)
          (throw (SocketException. (java-str "Reply from SOCKS server has bad length: " n))))
        (when (and (not (== (aget data 0) 0)) (not (== (aget data 0) 4)))
          (throw (SocketException. "Reply from SOCKS server has bad version")))

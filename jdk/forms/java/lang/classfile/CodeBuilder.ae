  (method ^:default invokedynamic ^CodeBuilder [this ^InvokeDynamicEntry ref]
    (cast CodeBuilder (.with this (InvokeDynamicInstruction/of ref))))

  (method ^:default invokedynamic ^CodeBuilder [this ^DynamicCallSiteDesc ref]
    (let [bsMethod (BytecodeHelpers/handleDescToHandleInfo
                     (.constantPool this)
                     (cast DirectMethodHandleDesc (.bootstrapMethod ref)))
          cpArgs (.bootstrapArgs ref)
          ^{:tag (List LoadableConstantEntry)} bsArguments (ArrayList. (alength cpArgs))]
      (for-each [^ConstantDesc constantValue cpArgs]
        (.add bsArguments
              (.loadableConstantEntry (.constantPool this)
                                      (cast ConstantDesc (Objects/requireNonNull constantValue)))))
      (let [bm (.bsmEntry (.constantPool this) bsMethod bsArguments)
            nameAndType (.nameAndTypeEntry (.constantPool this)
                                           (.invocationName ref)
                                           (.invocationType ref))]
        (.invokedynamic this (.invokeDynamicEntry (.constantPool this) bm nameAndType)))))

  (method ^:default invokeinterface ^CodeBuilder [this ^InterfaceMethodRefEntry ref]
    (.invoke this Opcode/INVOKEINTERFACE ref))

  (method ^:default invokeinterface ^CodeBuilder [this ^ClassDesc owner ^String name
                                                  ^MethodTypeDesc type]
    (.invoke this
             Opcode/INVOKEINTERFACE
             (.interfaceMethodRefEntry (.constantPool this) owner name type)))


  (method ^:default tableswitch ^CodeBuilder [this ^int low ^int high ^Label defaultTarget
                                              ^{:tag (List SwitchCase)} cases]
    (cast CodeBuilder (.with this (TableSwitchInstruction/of low high defaultTarget cases))))

  (method ^:default tableswitch ^CodeBuilder [this ^Label defaultTarget
                                              ^{:tag (List SwitchCase)} cases]
    (let [^:mutable low Integer/MAX_VALUE
          ^:mutable high Integer/MIN_VALUE]
      (for-each [^SwitchCase c cases]
        (let [i (.caseValue c)] (when (< i low) (set! low i)) (when (> i high) (set! high i))))
      (.tableswitch this low high defaultTarget cases))))

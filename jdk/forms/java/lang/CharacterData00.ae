            0x2186 (set! retval 50)
            0x2187 (set! retval 50000)
            0x2188 (set! retval 100000)
            0x324B (set! retval 40)
            0x324C (set! retval 50)
            0x324D (set! retval 60)
            0x324E (set! retval 70)
            0x324F (set! retval 80)

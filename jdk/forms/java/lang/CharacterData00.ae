  (method toTitleCase ^int [this ^int ch]
    (let [^:mutable mapChar ch
          val (.getProperties this ch)]
      (if (not (== (bit-and-int val 0x00008000) 0))
          (cond
            (== (bit-and-int val 0x00010000) 0) (set! mapChar (unchecked-add-int ch 1))
            (== (bit-and-int val 0x00020000) 0)
              (if (and (>= ch 0x10D0) (<= ch 0x10FF))
                  (set! mapChar ch)
                  (set! mapChar (unchecked-subtract-int ch 1))))
          (when-not (== (bit-and-int val 0x00010000) 0) (set! mapChar (.toUpperCase this ch))))
      mapChar))

  (method digit ^int [this ^int ch ^int radix]
    (let [^:mutable ^int value -1]
      (when (and (>= radix Character/MIN_RADIX) (<= radix Character/MAX_RADIX))
        (let [val (.getProperties this ch)
              kind (bit-and-int val 0x1F)]
          (cond
            (== kind Character/DECIMAL_DIGIT_NUMBER)
              (set! value
                    (bit-and-int (unchecked-add-int
                                   ch
                                   (bit-shift-right-int (bit-and-int val 0x3E0) 5))
                                 0x1F))
            (== (bit-and-int val 0xC00) 0x00000C00)
              (set! value
                    (unchecked-add-int
                      (bit-and-int (unchecked-add-int
                                     ch
                                     (bit-shift-right-int (bit-and-int val 0x3E0) 5))
                                   0x1F)
                      10)))))
      (if (< value radix) value -1)))

  (method getNumericValue ^int [this ^int ch]
    (let [val (.getProperties this ch)

      (switch (bit-and-int val 0xC00)
        0x00000400
          (set! retval
                (bit-and-int (unchecked-add-int ch (bit-shift-right-int (bit-and-int val 0x3E0) 5))
                             0x1F))
        0x00000800
          (switch ch
            0x0BF1 (set! retval 100)
            0x0BF2 (set! retval 1000)
            0x0D71 (set! retval 100)
            0x0D72 (set! retval 1000)
            0x1375 (set! retval 40)

  (method toUpperCaseCharArray ^char/1 [this ^int ch]
    (let [^:mutable upperMap (new char/1 [(unchecked-char ch)])
          location (.findInCharMap this ch)]
      (when-not (== location -1) (set! upperMap (aget charMap location 1)))
      upperMap))

  (method findInCharMap ^int [this ^int ch]
    (if (or (nil? charMap) (== (alength charMap) 0))
        -1
        (let [^:mutable ^int top 0
              ^:mutable ^int bottom 0
              ^:mutable ^int current 0]
          (set! bottom 0)
          (set! top (alength charMap))
          (set! current (unchecked-divide-int top 2))
          (while (> (unchecked-subtract-int top bottom) 1)
            (if (>= ch (aget charMap current 0 0)) (set! bottom current) (set! top current))
            (set! current (unchecked-divide-int (unchecked-add-int top bottom) 2)))
          (if (== ch (aget charMap current 0 0)) current -1))))


        0x00000C00
          (set! retval
                (unchecked-add-int
                  (bit-and-int (unchecked-add-int
                                 ch
                                 (bit-shift-right-int (bit-and-int val 0x3E0) 5))
                               0x1F)
                  10))
        (set! retval -1))
      retval))

  (method isDigit ^boolean [this ^int ch]
    (let [props (.getProperties this ch)]
      (== (bit-and-int props 0x1F) Character/DECIMAL_DIGIT_NUMBER)))

  (method isLowerCase ^boolean [this ^int ch]
    (not (== (bit-and-int (.getPropertiesEx this ch) 0x0001) 0)))

  (method isUpperCase ^boolean [this ^int ch]
    (not (== (bit-and-int (.getPropertiesEx this ch) 0x0002) 0)))

  (method isWhitespace ^boolean [this ^int ch]
    (let [props (.getProperties this ch)] (== (bit-and-int props 0x00007000) 0x00004000)))

  (method getDirectionality ^byte [this ^int ch]
    (let [val (.getProperties this ch)
          ^:mutable directionality (unchecked-byte
                                     (bit-shift-right-int (bit-and-int val 0x78000000) 27))]
      (when (== directionality 0xF)
        (switch ch
          0x202A (set! directionality Character/DIRECTIONALITY_LEFT_TO_RIGHT_EMBEDDING)
          0x202B (set! directionality Character/DIRECTIONALITY_RIGHT_TO_LEFT_EMBEDDING)
          0x202C (set! directionality Character/DIRECTIONALITY_POP_DIRECTIONAL_FORMAT)
          0x202D (set! directionality Character/DIRECTIONALITY_LEFT_TO_RIGHT_OVERRIDE)
          0x202E (set! directionality Character/DIRECTIONALITY_RIGHT_TO_LEFT_OVERRIDE)
          0x2066 (set! directionality Character/DIRECTIONALITY_LEFT_TO_RIGHT_ISOLATE)
          0x2067 (set! directionality Character/DIRECTIONALITY_RIGHT_TO_LEFT_ISOLATE)
          0x2068 (set! directionality Character/DIRECTIONALITY_FIRST_STRONG_ISOLATE)
          0x2069 (set! directionality Character/DIRECTIONALITY_POP_DIRECTIONAL_ISOLATE)
          (set! directionality Character/DIRECTIONALITY_UNDEFINED)))
      directionality))

  (method isMirrored ^boolean [this ^int ch]
    (let [props (.getProperties this ch)]
      (not (== (bit-and-int props (unchecked-int 0x80000000)) 0))))


    (method ^:public ^:static of ^UnicodeBlock [^char c]
      (UnicodeBlock/of (int c)))

    (method ^:public ^:static of ^UnicodeBlock [^int codePoint]
      (when-not (Character/isValidCodePoint codePoint)
        (throw (IllegalArgumentException.
                 (String/format "Not a valid Unicode code point: 0x%X" (new Object/1 [codePoint])))))
      (let [^:mutable ^int top 0
            ^:mutable ^int bottom 0
            ^:mutable ^int current 0]
        (set! bottom 0)
        (set! top (alength blockStarts))
        (set! current (unchecked-divide-int top 2))
        (while (> (unchecked-subtract-int top bottom) 1)
          (if (>= codePoint (aget blockStarts current)) (set! bottom current) (set! top current))
          (set! current (unchecked-divide-int (unchecked-add-int top bottom) 2)))
        (aget blocks current)))

    (method ^:public ^:static ^:final forName ^UnicodeBlock [^String blockName]
      (let [block (cast UnicodeBlock (.get map (.toUpperCase blockName Locale/US)))]
        (when (nil? block)
          (throw (IllegalArgumentException. (java-str "Not a valid block name: " blockName))))
        block)))


  (method ^:public ^:static getName ^String [^int codePoint]
    (when-not (Character/isValidCodePoint codePoint)
      (throw (IllegalArgumentException.
               (String/format "Not a valid Unicode code point: 0x%X" (new Object/1 [codePoint])))))
    (let [name (.getName (CharacterName/getInstance) codePoint)]
      (if (some? name)
          name
          (when-not (== (Character/getType codePoint) UNASSIGNED)
            (let [block (UnicodeBlock/of codePoint)]
              (if (some? block)
                  (java-str (.replace (.toString block) \_ \space)
                            " "
                            (.toUpperCase (Integer/toHexString codePoint) Locale/ROOT))
                  (.toUpperCase (Integer/toHexString codePoint) Locale/ROOT)))))))

  (method ^:public ^:static codePointOf ^int [^:mutable ^String name]
    (set! name (.toUpperCase (.trim name) Locale/ROOT))
    (let [^:mutable cp (.getCodePoint (CharacterName/getInstance) name)]
      (if (not (== cp -1))
          cp
          (do
            (try
              (let [off (.lastIndexOf name \space)]
                (when-not (== off -1)
                  (set! cp (Integer/parseInt name (unchecked-add-int off 1) (.length name) 16))
                  (when (and (Character/isValidCodePoint cp) (.equals name (Character/getName cp)))
                    (return cp))))
              (catch Exception x))
            (throw (IllegalArgumentException. (java-str "Unrecognized character name :" name))))))))

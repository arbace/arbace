    (method ^:public ^:static of ^UnicodeScript [^int codePoint]
      (when-not (Character/isValidCodePoint codePoint)
        (throw (IllegalArgumentException.
                 (String/format "Not a valid Unicode code point: 0x%X" (new Object/1 [codePoint])))))
      (let [type (Character/getType codePoint)]
        (if (== type UNASSIGNED)
            UNKNOWN
            (let [^:mutable index (Arrays/binarySearch scriptStarts codePoint)]
              (when (< index 0)
                (set! index (unchecked-subtract-int (unchecked-negate-int index) 2)))
              (aget scripts index)))))

    (method ^:public ^:static ^:final forName ^UnicodeScript [^:mutable ^String scriptName]
      (set! scriptName (.toUpperCase scriptName Locale/ENGLISH))
      (let [sc (cast UnicodeScript (.get aliases scriptName))]
        (if (some? sc) sc (UnicodeScript/valueOf scriptName)))))

  (field ^:private ^:final ^char value)

  (field ^:private ^:static ^:final ^long serialVersionUID 3786198910865385080)

  (constructor ^:public ^{Deprecated {:since "9"}} [this ^char value]
    (set! (.-value this) value))

  (defclass ^:private ^:static ^:final CharacterCache
    (constructor ^:private [this])

    (field ^:static ^:final ^{Stable true} ^Character/1 cache)

    (field ^:static ^Character/1 archivedCache)

    (static-initializer
      (let [size (unchecked-add-int 127 1)]
        (CDS/initializeFromArchive CharacterCache)
        (when (nil? archivedCache)
          (let [c (new Character/1 size)]
            (loop [^int i 0]
              (when (< i size)
                (aset c i (Character. (unchecked-char i)))
                (recur (unchecked-inc-int i))))
            (set! archivedCache c)))
        (set! cache archivedCache)
        (java-assert (== (alength cache) size)))))

  (method ^:public ^:static ^{IntrinsicCandidate true} valueOf ^Character [^char c]
    (if (<= c 127) (aget CharacterCache/cache (int c)) (Character. c)))

  (method ^:public ^{IntrinsicCandidate true} charValue ^char [this]
    value)

  (method ^:public hashCode ^int [this] (Character/hashCode value))

  (method ^:public ^:static hashCode ^int [^char value] (int value))

  (method ^:public equals ^boolean [this obj]
    (if-instance [^Character c obj] (== value (.charValue c)) false))

  (method ^:public toString ^String [this] (String/valueOf value))

  (method ^:public ^:static toString ^String [^char c] (String/valueOf c))

  (method ^:public ^:static toString ^String [^int codePoint]
    (String/valueOfCodePoint codePoint))

  (method ^:public ^:static isValidCodePoint ^boolean [^int codePoint]
    (let [plane (unsigned-bit-shift-right-int codePoint 16)]
      (< plane (unsigned-bit-shift-right-int (unchecked-add-int MAX_CODE_POINT 1) 16))))

  (method ^:public ^:static isBmpCodePoint ^boolean [^int codePoint]
    (== (unsigned-bit-shift-right-int codePoint 16) 0))

  (method ^:public ^:static isSupplementaryCodePoint ^boolean [^int codePoint]
    (and (>= codePoint MIN_SUPPLEMENTARY_CODE_POINT)
         (< codePoint (unchecked-add-int MAX_CODE_POINT 1))))

  (method ^:public ^:static isHighSurrogate ^boolean [^char ch]
    (and (>= ch MIN_HIGH_SURROGATE) (< ch (unchecked-add-int MAX_HIGH_SURROGATE 1))))

  (method ^:public ^:static isLowSurrogate ^boolean [^char ch]
    (and (>= ch MIN_LOW_SURROGATE) (< ch (unchecked-add-int MAX_LOW_SURROGATE 1))))

  (method ^:public ^:static isSurrogate ^boolean [^char ch]
    (and (>= ch MIN_SURROGATE) (< ch (unchecked-add-int MAX_SURROGATE 1))))

  (method ^:public ^:static isSurrogatePair ^boolean [^char high ^char low]
    (and (Character/isHighSurrogate high) (Character/isLowSurrogate low)))

  (method ^:public ^:static charCount ^int [^int codePoint]
    (if (>= codePoint MIN_SUPPLEMENTARY_CODE_POINT) 2 1))

  (method ^:public ^:static toCodePoint ^int [^char high ^char low]
    (unchecked-add-int (unchecked-add-int (bit-shift-left-int high 10) low)
                       (unchecked-subtract-int
                         (unchecked-subtract-int
                           MIN_SUPPLEMENTARY_CODE_POINT
                           (bit-shift-left-int MIN_HIGH_SURROGATE 10))
                         MIN_LOW_SURROGATE)))

  (method ^:public ^:static codePointAt ^int [^CharSequence seq ^:mutable ^int index]
    (let [c1 (.charAt seq index)]
      (when (and (Character/isHighSurrogate c1)
                 (< (set! index (unchecked-inc-int index)) (.length seq)))
        (let [c2 (.charAt seq index)]
          (when (Character/isLowSurrogate c2) (return (Character/toCodePoint c1 c2)))))
      c1))

  (method ^:public ^:static codePointAt ^int [^char/1 a ^int index]
    (Character/codePointAtImpl a index (alength a)))

  (method ^:public ^:static codePointAt ^int [^char/1 a ^int index ^int limit]
    (when (or (or (>= index limit) (< index 0)) (> limit (alength a)))
      (throw (IndexOutOfBoundsException.)))
    (Character/codePointAtImpl a index limit))

  (method ^:static codePointAtImpl ^int [^char/1 a ^:mutable ^int index ^int limit]
    (let [c1 (aget a index)]
      (when (and (Character/isHighSurrogate c1) (< (set! index (unchecked-inc-int index)) limit))
        (let [c2 (aget a index)]
          (when (Character/isLowSurrogate c2) (return (Character/toCodePoint c1 c2)))))
      c1))

  (method ^:public ^:static codePointBefore ^int [^CharSequence seq ^:mutable ^int index]
    (let [c2 (.charAt seq (set! index (unchecked-dec-int index)))]
      (when (and (Character/isLowSurrogate c2) (> index 0))
        (let [c1 (.charAt seq (set! index (unchecked-dec-int index)))]
          (when (Character/isHighSurrogate c1) (return (Character/toCodePoint c1 c2)))))
      c2))

  (method ^:public ^:static codePointBefore ^int [^char/1 a ^int index]
    (Character/codePointBeforeImpl a index 0))

  (method ^:public ^:static codePointBefore ^int [^char/1 a ^int index ^int start]
    (when (or (or (<= index start) (< start 0)) (> index (alength a)))
      (throw (IndexOutOfBoundsException.)))
    (Character/codePointBeforeImpl a index start))

  (method ^:static codePointBeforeImpl ^int [^char/1 a ^:mutable ^int index ^int start]
    (let [c2 (aget a (set! index (unchecked-dec-int index)))]
      (when (and (Character/isLowSurrogate c2) (> index start))
        (let [c1 (aget a (set! index (unchecked-dec-int index)))]
          (when (Character/isHighSurrogate c1) (return (Character/toCodePoint c1 c2)))))
      c2))

  (method ^:public ^:static highSurrogate ^char [^int codePoint]
    (unchecked-char
      (unchecked-add-int (unsigned-bit-shift-right-int codePoint 10)
                         (unchecked-subtract-int
                           MIN_HIGH_SURROGATE
                           (unsigned-bit-shift-right-int MIN_SUPPLEMENTARY_CODE_POINT 10)))))

  (method ^:public ^:static lowSurrogate ^char [^int codePoint]
    (unchecked-char (unchecked-add-int (bit-and-int codePoint 0x3ff) MIN_LOW_SURROGATE)))

  (method ^:public ^:static toChars ^int [^int codePoint ^char/1 dst ^int dstIndex]
    (cond
      (Character/isBmpCodePoint codePoint) (do (aset dst dstIndex (unchecked-char codePoint)) 1)
      (Character/isValidCodePoint codePoint) (do (Character/toSurrogates codePoint dst dstIndex) 2)
      :else
        (throw (IllegalArgumentException.
                 (String/format "Not a valid Unicode code point: 0x%X" (new Object/1 [codePoint]))))))

  (method ^:public ^:static toChars ^char/1 [^int codePoint]
    (cond
      (Character/isBmpCodePoint codePoint) (new char/1 [(unchecked-char codePoint)])
      (Character/isValidCodePoint codePoint)
        (let [result (new char/1 2)] (Character/toSurrogates codePoint result 0) result)
      :else
        (throw (IllegalArgumentException.
                 (String/format "Not a valid Unicode code point: 0x%X" (new Object/1 [codePoint]))))))

  (method ^:static toSurrogates ^void [^int codePoint ^char/1 dst ^int index]
    (aset dst (unchecked-add-int index 1) (Character/lowSurrogate codePoint))
    (aset dst index (Character/highSurrogate codePoint)))

  (method ^:public ^:static codePointCount ^int [^CharSequence seq ^int beginIndex ^int endIndex]
    (Objects/checkFromToIndex beginIndex endIndex (.length seq))
    (let [^:mutable n (unchecked-subtract-int endIndex beginIndex)]
      (let [^:mutable i beginIndex]
        (while (< i endIndex)
          (when (and (and (Character/isHighSurrogate
                            (.charAt seq (let [old-1 i] (set! i (unchecked-inc-int i)) old-1)))
                          (< i endIndex))
                     (Character/isLowSurrogate (.charAt seq i)))
            (set! n (unchecked-dec-int n))
            (set! i (unchecked-inc-int i)))))
      n))

  (method ^:public ^:static codePointCount ^int [^char/1 a ^int offset ^int count]
    (Objects/checkFromIndexSize offset count (alength a))
    (Character/codePointCountImpl a offset count))

  (method ^:static codePointCountImpl ^int [^char/1 a ^int offset ^int count]
    (let [endIndex (unchecked-add-int offset count)
          ^:mutable n count]
      (let [^:mutable i offset]
        (while (< i endIndex)
          (when (and (and (Character/isHighSurrogate
                            (aget a (let [old-2 i] (set! i (unchecked-inc-int i)) old-2)))
                          (< i endIndex))
                     (Character/isLowSurrogate (aget a i)))
            (set! n (unchecked-dec-int n))
            (set! i (unchecked-inc-int i)))))
      n))

  (method ^:public ^:static offsetByCodePoints ^int [^CharSequence seq ^int index
                                                     ^int codePointOffset]
    (let [length (.length seq)]
      (when (or (< index 0) (> index length)) (throw (IndexOutOfBoundsException.)))
      (let [^:mutable x index]
        (if (>= codePointOffset 0)

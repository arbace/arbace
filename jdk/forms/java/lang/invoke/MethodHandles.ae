                                   (unchecked-add-int (.position buf) 2)
                                   (bit-and-int (.getShort buf (.position buf)) 0xFFFF)))
                    7 (aset classes k (bit-and-int (.getShort buf) 0xFFFF))
                    (8 16 19 20) (.getShort buf)
                    15 (do (.get buf) (.getShort buf))
                    (3 4 9 10 11 12 17 18) (.getInt buf)
                    (5 6) (do (.getLong buf) (set! k (unchecked-inc-int k)))

  (defclass ^:static ^:final Info
    :implements [MethodHandleInfo]

    (field ^:private ^:final ^int kind)

    (field ^:private ^:final ^{:tag (Class ?)} declaringClass)

    (field ^:private ^:final ^String name)

    (field ^:private ^:final ^MethodType type)

    (field ^:private ^:final ^Member member)

    (field ^:private ^:final ^boolean varargs)

    (constructor [this ^int kind ^{:tag (Class ?)} declaringClass ^String name ^MethodType type
                  ^Member member ^boolean varargs]

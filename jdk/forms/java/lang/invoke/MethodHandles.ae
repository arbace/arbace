                 Object/1
                 (unchecked-subtract-int (.parameterCount type) leadingArgCount)))

  (method ^:public ^:static exactInvoker ^MethodHandle [^MethodType type]
    (let [t (.insertParameterTypes type 0 (new Class/1 [MethodHandle]))
          n (.parameterCount type)]

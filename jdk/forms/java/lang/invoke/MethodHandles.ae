                                (lambda MethodHandleImpl$Body [^Object/1 a]
                                  (let [mh (cast MethodHandle (Objects/requireNonNull (aget a 0)))]
                                    (.invokeExactFrom
                                      mh
                                      type
                                      (Arrays/copyOfRange a 1 (unchecked-add-int n 1))))))))


                     target
                     pos)))
        (or (or (< pos 0) (>= pos (.parameterCount targetType)))
            (not (identical? (.parameterType targetType pos) rtype)))
          (throw (MethodHandleStatics/newIllegalArgumentException
                   "target and filter types do not match"
                   targetType
                   filterType)))
      (let [voidF (identical? rtype Void/TYPE)
            ^MethodType newType (if voidF
                                    (.insertParameterTypes
                                      targetType
                                      pos
                                      (.parameterArray filterType))
                                    (.insertParameterTypes
                                      (.dropParameterTypes targetType pos (unchecked-add-int pos 1))
                                      pos
                                      (.parameterArray filterType)))
            n (.parameterCount targetType)
            t (.asFixedArity target)]
        (MethodHandleImpl/adapter newType
                                  (lambda MethodHandleImpl$Body [^Object/1 a]
                                    (let [r (.invokeImpl
                                              filter
                                              (Arrays/copyOfRange a pos (unchecked-add-int pos k)))
                                          b (new Object/1 n)]
                                      (System/arraycopy a 0 b 0 pos)
                                      (let [^int after (if voidF pos (unchecked-add-int pos 1))]
                                        (when-not voidF (aset b pos r))
                                        (System/arraycopy
                                          a
                                          (unchecked-add-int pos k)
                                          b
                                          after
                                          (unchecked-subtract-int n after))
                                        (.invokeImpl t b))))))))

  (method ^:public ^:static filterReturnValue ^MethodHandle [^MethodHandle target
                                                             ^MethodHandle filter]
    (let [targetType (.type target)
          filterType (.type filter)
          ^{:tag (Class ?)} rtype (.returnType targetType)
          filterValues (.parameterCount filterType)]
      (when (if (== filterValues 0)
                (not (identical? rtype Void/TYPE))
                (or (not (identical? rtype (.parameterType filterType 0)))
                    (not (== filterValues 1))))
        (throw (MethodHandleStatics/newIllegalArgumentException
                 "target and filter types do not match"
                 targetType
                 filterType)))
      (let [newType (.changeReturnType targetType (.returnType filterType))
            t (.asFixedArity target)]
        (MethodHandleImpl/adapter newType
                                  (lambda MethodHandleImpl$Body [^Object/1 a]
                                    (let [r (.invokeImpl t a)]
                                      (.invokeImpl
                                        filter
                                        ^Object/1 (if (== filterValues 0)
                                                      (new Object/1 0)
                                                      (new Object/1 [r])))))))))

  (method ^:public ^:static foldArguments ^MethodHandle [^MethodHandle target ^MethodHandle combiner]
    (MethodHandles/foldArguments target 0 combiner))

  (method ^:public ^:static foldArguments ^MethodHandle [^MethodHandle target ^int pos
                                                         ^MethodHandle combiner]
    (let [targetType (.type target)
          combinerType (.type combiner)
          ^{:tag (Class ?)} rtype (.returnType combinerType)
          voidC (identical? rtype Void/TYPE)
          ^int foldVals (if voidC 0 1)
          afterInsertPos (unchecked-add-int pos foldVals)
          k (.parameterCount combinerType)
          ^:mutable ok (>= (.parameterCount targetType) (unchecked-add-int afterInsertPos k))]
      (when ok
        (loop [^int i 0]
          (if (< i k)
              (if (not
                    (identical? (.parameterType combinerType i)
                                (.parameterType targetType (unchecked-add-int afterInsertPos i))))
                  (set! ok false)
                  (recur (unchecked-inc-int i)))
              nil)))
      (when (and (and ok (not voidC)) (not (identical? rtype (.parameterType targetType pos))))
        (set! ok false))
      (when-not ok
        (throw (MethodHandles/misMatchedTypes "target and combiner types" targetType combinerType)))
      (let [^MethodType newType (if voidC
                                    targetType
                                    (.dropParameterTypes targetType pos (unchecked-add-int pos 1)))
            n (.parameterCount targetType)
            t (.asFixedArity target)]
        (MethodHandleImpl/adapter newType
                                  (lambda MethodHandleImpl$Body [^Object/1 a]
                                    (let [r (.invokeImpl
                                              combiner
                                              (Arrays/copyOfRange a pos (unchecked-add-int pos k)))]
                                      (if voidC
                                          (.invokeImpl t a)
                                          (let [b (new Object/1 n)]
                                            (System/arraycopy a 0 b 0 pos)
                                            (aset b pos r)
                                            (System/arraycopy
                                              a
                                              pos
                                              b
                                              (unchecked-add-int pos 1)
                                              (unchecked-subtract-int (alength a) pos))
                                            (.invokeImpl t b)))))))))

  (method ^:private ^:static prefix ^Object/1 [^Object/1 a ^int k]
    (if (== k (alength a)) a (Arrays/copyOf a k)))

  (method ^:private ^:static prefixMatches ^boolean [^MethodType h ^int skip ^MethodType t]
    (let [k (unchecked-subtract-int (.parameterCount h) skip)]
      (if (or (< k 0) (> k (.parameterCount t)))
          false
          (do
            (loop [^int i 0]
              (if (< i k)
                  (if (not (identical? (.parameterType h (unchecked-add-int skip i))
                                       (.parameterType t i)))
                      (return false)
                      (recur (unchecked-inc-int i)))
                  nil))
            true))))

  (method ^:public ^:static guardWithTest ^MethodHandle [^MethodHandle test ^MethodHandle target
                                                         ^MethodHandle fallback]
    (let [gtype (.type test)
          ttype (.type target)
          ftype (.type fallback)]
      (when-not (.equals ttype ftype)
        (throw (MethodHandles/misMatchedTypes "target and fallback types" ttype ftype)))
      (when-not (identical? (.returnType gtype) Boolean/TYPE)
        (throw (MethodHandleStatics/newIllegalArgumentException
                 (java-str "guard type is not a predicate " gtype))))
      (when-not (MethodHandles/prefixMatches gtype 0 ttype)
        (throw (MethodHandles/misMatchedTypes "target and test types" ttype gtype)))
      (let [k (.parameterCount gtype)
            t (.asFixedArity target)
            f (.asFixedArity fallback)]
        (MethodHandleImpl/adapter ttype
                                  (lambda MethodHandleImpl$Body [^Object/1 a]
                                    (if (.booleanValue
                                          (cast Boolean
                                                (.invokeImpl test (MethodHandles/prefix a k))))
                                        (.invokeImpl t a)
                                        (.invokeImpl f a)))))))

  (method ^:public ^:static catchException ^MethodHandle [^MethodHandle target
                                                          ^{:tag (Class (? extends Throwable))} exType
                                                          ^MethodHandle handler]
    (let [ttype (.type target)
          htype (.type handler)]
      (when-not (.isAssignableFrom Throwable exType)
        (throw (ClassCastException. (.getName exType))))
      (when (or (< (.parameterCount htype) 1)
                (not (.isAssignableFrom (.parameterType htype 0) exType)))
        (throw (MethodHandleStatics/newIllegalArgumentException
                 (java-str "handler does not accept exception type " exType))))
      (when-not (identical? (.returnType htype) (.returnType ttype))
        (throw (MethodHandles/misMatchedTypes "target and handler return types" ttype htype)))
      (when-not (MethodHandles/prefixMatches htype 1 ttype)
        (throw (MethodHandles/misMatchedTypes "target and handler types" ttype htype)))
      (let [k (unchecked-subtract-int (.parameterCount htype) 1)
            t (.asFixedArity target)
            h (.asFixedArity handler)]
        (MethodHandleImpl/adapter ttype
                                  (lambda MethodHandleImpl$Body [^Object/1 a]
                                    (try
                                      (.invokeImpl t a)
                                      (catch Throwable e
                                        (when-not (.isInstance exType e) (throw e))
                                        (let [b (new Object/1 (unchecked-add-int k 1))]
                                          (aset b 0 e)
                                          (System/arraycopy a 0 b 1 k)
                                          (.invokeImpl h b)))))))))

  (method ^:public ^:static throwException ^MethodHandle [^{:tag (Class ?)} returnType
                                                          ^{:tag (Class (? extends Throwable))} exType]
    (when-not (.isAssignableFrom Throwable exType) (throw (ClassCastException. (.getName exType))))
    (MethodHandleImpl/adapter (MethodType/methodType returnType exType)
                              (lambda MethodHandleImpl$Body [^Object/1 a]
                                (throw (cast Throwable (Objects/requireNonNull (aget a 0)))))))

  (method ^:public ^:static tryFinally ^MethodHandle [^MethodHandle target ^MethodHandle cleanup]
    (let [ttype (.type target)
          ^{:tag (Class ?)} rtype (.returnType ttype)
          cleanupType (.type cleanup)]
      (when-not (identical? rtype (.returnType cleanupType))
        (throw (MethodHandles/misMatchedTypes "target and return types"
                                              (.returnType cleanupType)
                                              rtype)))
      (when-not (.isAssignableFrom Throwable (.parameterType cleanupType 0))
        (throw (MethodHandles/misMatchedTypes "cleanup first argument and Throwable"
                                              cleanupType
                                              Throwable)))
      (when (and (not (identical? rtype Void/TYPE))
                 (not (identical? (.parameterType cleanupType 1) rtype)))
        (throw (MethodHandles/misMatchedTypes "cleanup second argument and target return type"
                                              cleanupType
                                              rtype)))
      (let [^int cleanupArgIndex (if (identical? rtype Void/TYPE) 1 2)]
        (when-not (MethodHandles/prefixMatches cleanupType cleanupArgIndex ttype)
          (throw (MethodHandles/misMatchedTypes
                   "cleanup parameters after (Throwable,result) and target parameter list prefix"
                   cleanupType
                   ttype)))
        (let [k (unchecked-subtract-int (.parameterCount cleanupType) cleanupArgIndex)
              ^{:tag (Class ?)} tt (.parameterType cleanupType 0)
              t (.asFixedArity target)
              c (.asFixedArity cleanup)]
          (MethodHandleImpl/adapter
            ttype
            (lambda MethodHandleImpl$Body [^Object/1 a]
              (let [^:mutable result (MethodHandleImpl/zero rtype)
                    ^:mutable ^Throwable thrown nil]
                (try (set! result (.invokeImpl t a)) (catch Throwable e (set! thrown e)))
                (when (and (some? thrown) (not (.isInstance tt thrown)))
                  (throw (ClassCastException. (.getName (.getClass thrown)))))
                (let [b (new Object/1 (unchecked-add-int cleanupArgIndex k))]
                  (aset b 0 thrown)
                  (when (== cleanupArgIndex 2) (aset b 1 result))
                  (System/arraycopy a 0 b cleanupArgIndex k)
                  (let [r (.invokeImpl c b)] (when (some? thrown) (throw thrown)) r))))))))))

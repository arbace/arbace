                                 (.getMethodType this))))

  (method ^:public ^:static spreadInvoker ^MethodHandle [^:mutable ^MethodType type
                                                         ^int leadingArgCount]
    (when (or (< leadingArgCount 0) (> leadingArgCount (.parameterCount type)))
      (throw (MethodHandleStatics/newIllegalArgumentException "bad argument count" leadingArgCount)))
    (set! type
          (.asSpreaderType type
                           Object/1
                           leadingArgCount
                           (unchecked-subtract-int (.parameterCount type) leadingArgCount)))

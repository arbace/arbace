            (Optional/of (MethodTypeDesc/of (cast ClassDesc (.get retDesc)) params))))))

  (field ^:private ^:static ^:final ^ObjectStreamField/1 serialPersistentFields
    (new ObjectStreamField/1 []))

  (method ^:private writeObject :throws [IOException] ^void [this ^ObjectOutputStream s]
    (.defaultWriteObject s)
    (.writeObject s (.returnType this))
    (.writeObject s (.parameterArray this)))

  (method ^:private readObject :throws [IOException ClassNotFoundException] ^void [this
                                                                                   ^ObjectInputStream s]
    (.putReference MethodHandleStatics/UNSAFE this OffsetHolder/rtypeOffset Void/TYPE)
    (.putReference MethodHandleStatics/UNSAFE this OffsetHolder/ptypesOffset NO_PTYPES)
    (.defaultReadObject s)
    (let [^{:tag (Class ?)} returnType (cast Class (.readObject s))
          ^{:tag (array (Class ?))} parameterArray (cast Class/1 (.readObject s))]
      (set! wrapAlt (new MethodType/1 [(MethodType/methodType returnType parameterArray)]))))

  (defclass ^:private ^:static OffsetHolder
    (field ^:static ^:final ^long rtypeOffset
      (.objectFieldOffset MethodHandleStatics/UNSAFE MethodType "rtype"))

    (field ^:static ^:final ^long ptypesOffset
      (.objectFieldOffset MethodHandleStatics/UNSAFE MethodType "ptypes")))

  (method ^:private readResolve [this]
    (let [mt (aget (cast MethodType/1 wrapAlt) 0)] (set! wrapAlt nil) mt))

  (method ^:private ^:static assemblySetup ^void []
    (.prepareForAOTCache internTable)))

          (aget definition (Integer/numberOfTrailingZeros flagBit)))))

    (method ^:public size ^int [this] (Integer/bitCount mask))

    (method ^:public contains ^boolean [this o]
      (if-instance [^AccessFlag flag (Objects/requireNonNull o)]
        (let [bit (.-mask flag)]
          (and (not (== (bit-and-int bit mask) 0))
               (identical? (aget definition (Integer/numberOfTrailingZeros bit)) flag)))
        false))

    (method ^:public isEmpty ^boolean [this] (== mask 0))))

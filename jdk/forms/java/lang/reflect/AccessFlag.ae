  (method ^:private ^:static undefinedMask ^int [^AccessFlag/1 definition ^int mask]
    (java-assert (== (alength definition) Character/SIZE))
    (let [^:mutable ^int definedMask 0]
      (loop [^int i 0]
        (if (< i Character/SIZE)
            (if (some? (aget definition i))
                (do
                  (set! definedMask (bit-or-int definedMask (bit-shift-left-int 1 i)))
                  (recur (unchecked-inc-int i)))
                (recur (unchecked-inc-int i)))
            nil))
      (bit-and-int mask (bit-not-int definedMask))))


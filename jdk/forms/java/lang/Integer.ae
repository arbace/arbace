          (bit-or-int (bit-shift-left-int (bit-and-int i 0x55555555) 1)
                      (bit-and-int (unsigned-bit-shift-right-int i 1) 0x55555555)))
    (set! i
          (bit-or-int (bit-shift-left-int (bit-and-int i 0x33333333) 2)
                      (bit-and-int (unsigned-bit-shift-right-int i 2) 0x33333333)))
    (set! i
          (bit-or-int (bit-shift-left-int (bit-and-int i 0x0f0f0f0f) 4)
                      (bit-and-int (unsigned-bit-shift-right-int i 4) 0x0f0f0f0f)))
    (Integer/reverseBytes i))

  (method ^:public ^:static ^{IntrinsicCandidate true} compress ^int [^:mutable ^int i
                                                                      ^:mutable ^int mask]
    (set! i (bit-and-int i mask))
    (let [^:mutable maskCount (bit-shift-left-int (bit-not-int mask) 1)]
      (loop [^int j 0]
        (when (< j 5)
          (let [maskPrefix (Integer/parallelSuffix maskCount)
                maskMove (bit-and-int maskPrefix mask)]
            (set! mask
                  (bit-or-int (bit-xor-int mask maskMove)
                              (unsigned-bit-shift-right-int maskMove (bit-shift-left-int 1 j))))
            (let [t (bit-and-int i maskMove)]
              (set! i
                    (bit-or-int (bit-xor-int i t)
                                (unsigned-bit-shift-right-int t (bit-shift-left-int 1 j))))
              (set! maskCount (bit-and-int maskCount (bit-not-int maskPrefix)))
              (recur (unchecked-inc-int j))))))
      i))

  (method ^:public ^:static ^{IntrinsicCandidate true} expand ^int [^:mutable ^int i
                                                                    ^:mutable ^int mask]
    (let [originalMask mask
          ^:mutable maskCount (bit-shift-left-int (bit-not-int mask) 1)
          ^:mutable maskPrefix (Integer/parallelSuffix maskCount)
          maskMove1 (bit-and-int maskPrefix mask)]
      (set! mask
            (bit-or-int (bit-xor-int mask maskMove1)
                        (unsigned-bit-shift-right-int maskMove1 (bit-shift-left-int 1 0))))
      (set! maskCount (bit-and-int maskCount (bit-not-int maskPrefix)))
      (set! maskPrefix (Integer/parallelSuffix maskCount))
      (let [maskMove2 (bit-and-int maskPrefix mask)]
        (set! mask
              (bit-or-int (bit-xor-int mask maskMove2)
                          (unsigned-bit-shift-right-int maskMove2 (bit-shift-left-int 1 1))))
        (set! maskCount (bit-and-int maskCount (bit-not-int maskPrefix)))
        (set! maskPrefix (Integer/parallelSuffix maskCount))
        (let [maskMove3 (bit-and-int maskPrefix mask)]
          (set! mask
                (bit-or-int (bit-xor-int mask maskMove3)
                            (unsigned-bit-shift-right-int maskMove3 (bit-shift-left-int 1 2))))
          (set! maskCount (bit-and-int maskCount (bit-not-int maskPrefix)))
          (set! maskPrefix (Integer/parallelSuffix maskCount))
          (let [maskMove4 (bit-and-int maskPrefix mask)]
            (set! mask
                  (bit-or-int (bit-xor-int mask maskMove4)
                              (unsigned-bit-shift-right-int maskMove4 (bit-shift-left-int 1 3))))
            (set! maskCount (bit-and-int maskCount (bit-not-int maskPrefix)))
            (set! maskPrefix (Integer/parallelSuffix maskCount))
            (let [maskMove5 (bit-and-int maskPrefix mask)
                  ^:mutable t (bit-shift-left-int i (bit-shift-left-int 1 4))]
              (set! i
                    (bit-or-int (bit-and-int i (bit-not-int maskMove5)) (bit-and-int t maskMove5)))
              (set! t (bit-shift-left-int i (bit-shift-left-int 1 3)))
              (set! i
                    (bit-or-int (bit-and-int i (bit-not-int maskMove4)) (bit-and-int t maskMove4)))
              (set! t (bit-shift-left-int i (bit-shift-left-int 1 2)))
              (set! i
                    (bit-or-int (bit-and-int i (bit-not-int maskMove3)) (bit-and-int t maskMove3)))
              (set! t (bit-shift-left-int i (bit-shift-left-int 1 1)))
              (set! i
                    (bit-or-int (bit-and-int i (bit-not-int maskMove2)) (bit-and-int t maskMove2)))
              (set! t (bit-shift-left-int i (bit-shift-left-int 1 0)))
              (set! i
                    (bit-or-int (bit-and-int i (bit-not-int maskMove1)) (bit-and-int t maskMove1)))
              (bit-and-int i originalMask)))))))

  (method ^:private ^:static ^{ForceInline true} parallelSuffix ^int [^int maskCount]
    (let [^:mutable maskPrefix (bit-xor-int maskCount (bit-shift-left-int maskCount 1))]
      (set! maskPrefix (bit-xor-int maskPrefix (bit-shift-left-int maskPrefix 2)))
      (set! maskPrefix (bit-xor-int maskPrefix (bit-shift-left-int maskPrefix 4)))
      (set! maskPrefix (bit-xor-int maskPrefix (bit-shift-left-int maskPrefix 8)))
      (set! maskPrefix (bit-xor-int maskPrefix (bit-shift-left-int maskPrefix 16)))
      maskPrefix))

  (method ^:public ^:static signum ^int [^int i]
    (bit-or-int (bit-shift-right-int i 31)
                (unsigned-bit-shift-right-int (unchecked-negate-int i) 31)))

  (method ^:public ^:static ^{IntrinsicCandidate true} reverseBytes ^int [^int i]
    (bit-or-int (bit-or-int (bit-or-int (bit-shift-left-int i 24)
                                        (bit-shift-left-int (bit-and-int i 0xff00) 8))
                            (bit-and-int (unsigned-bit-shift-right-int i 8) 0xff00))
                (unsigned-bit-shift-right-int i 24)))


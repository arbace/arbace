;; A function value: its arity and its code, one method per arity up to six (a1 ... a6), an above
;; (the arguments in an array). The translator (arbace.o2j) makes one subclass per Lambda function,
;; its free variables as fields; Rt/ap applies a closure to any number of arguments (partial
;; applications are Paps, over-applications apply the result).

(in-ns 'ocaml.rt)

(defclass ^:public ^:abstract Closure
  (field ^:public ^int arity)

  (constructor ^:public [this ^int arity]
    (set! (.-arity this) arity))

  (method ^:public a1 [this a] (Rt/badArity this 1))
  (method ^:public a2 [this a b] (Rt/badArity this 2))
  (method ^:public a3 [this a b c] (Rt/badArity this 3))
  (method ^:public a4 [this a b c d] (Rt/badArity this 4))
  (method ^:public a5 [this a b c d e] (Rt/badArity this 5))
  (method ^:public a6 [this a b c d e f] (Rt/badArity this 6))
  (method ^:public an [this ^Object/1 args] (Rt/badArity this (alength args)))

  ;; the call with exactly arity arguments
  (method ^:public exact [this ^Object/1 x]
    (switch arity
      1 (.a1 this (aget x 0))
      2 (.a2 this (aget x 0) (aget x 1))
      3 (.a3 this (aget x 0) (aget x 1) (aget x 2))
      4 (.a4 this (aget x 0) (aget x 1) (aget x 2) (aget x 3))
      5 (.a5 this (aget x 0) (aget x 1) (aget x 2) (aget x 3) (aget x 4))
      6 (.a6 this (aget x 0) (aget x 1) (aget x 2) (aget x 3) (aget x 4) (aget x 5))
      (.an this x))))

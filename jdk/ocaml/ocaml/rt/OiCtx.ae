;; The compile-time scope of one interpreted function (Oi, queue 544): its variables' slots in its frame, the free variables it
;; reads from the enclosing function (their names and slots, in the order they were met), the static exits in scope (a number's
;; variables' slots) and the enclosing scope.

(in-ns 'ocaml.rt)

(import '(java.util ArrayList HashMap))

(defclass ^:public ^:final OiCtx
  (field ^:public ^HashMap slots)
  (field ^:public ^int n)
  (field ^:public ^ArrayList free)
  (field ^:public ^ArrayList freeSlots)
  (field ^:public ^HashMap exits)
  (field ^:public ^OiCtx parent)

  (constructor ^:public [this ^OiCtx parent]
    (set! (.-slots this) (HashMap.))
    (set! (.-n this) 0)
    (set! (.-free this) (ArrayList.))
    (set! (.-freeSlots this) (ArrayList.))
    (set! (.-exits this) (HashMap.))
    (set! (.-parent this) parent)))

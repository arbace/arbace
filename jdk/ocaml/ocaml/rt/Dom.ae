;; A domain: its index, its domain-local storage (Domain.DLS's array) and its Gc.Memprof profile (ExtGc, OC235 (a)).

(in-ns 'ocaml.rt)

(defclass ^:public ^:final Dom
  (field ^:public ^long id)
  (field ^:public dls)
  ;; the domain's Gc.Memprof profile (ExtGc's [tracker lambda status]), nil before a start; a spawned domain's its spawner's
  (field ^:public mp)
  (constructor ^:public [this ^long id]
    (set! (.-id this) id)
    (set! (.-dls this) (Block. 0 (new Object/1 0)))))

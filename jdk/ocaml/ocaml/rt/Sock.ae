;; Sockets (doc/ocaml/DEFERRED-TRIAGE.md, §3 fix 6, "As built: OT9's fixes 6-8"), the AOT runtime's mirror of oi's ext_unix_sock.go
;; over java.net: a socket of Fd's table (Fd's sock) is TCP over IPv4 or IPv6 (PF_INET, PF_INET6 and SOCK_STREAM; Unix sockets
;; and the datagrams' traffic are oi's alone: EPROTONOSUPPORT, a datagram socket made but carrying nothing). Java's socket is made by its use: bind records the address, listen makes the
;; ServerSocket (bind already, for a stream socket), connect the Socket, accept the accepted one. The calls that may block (accept, connect, read, write) run outside
;; the Gil; select tests a socket's readiness by the bytes available (a listening socket's by a pending connection it accepts
;; ahead), a pipe's by its count, a file's always.
;; OC216 (a), the rest (doc/ocaml/OCAML-SURVEY.md, "As built: OC216 (a), the rest"): at the compiled level a socket of PF_UNIX (and
;; socketpair) is the OS's, made and used through the main's host (HostSys): `host` set, `os` its descriptor of the OS, its streams
;; HSockIn and HSockOut; every call below on such a socket is the host's system call (oi's ext_unix_sock.go, otherlibs/unix's
;; socket.c, socketpair.c, sendrecv.c and the rest). Where no host serves (the light level) PF_UNIX stays EPROTONOSUPPORT.

(in-ns 'ocaml.rt)

(import '(java.io InputStream OutputStream IOException)
        '(java.net InetAddress InetSocketAddress ServerSocket Socket SocketTimeoutException))

(defclass ^:public ^:final Sock
  (field ^:public ^long domain)
  ;; socket_type: 0 SOCK_STREAM, 1 SOCK_DGRAM (a datagram socket is made, for channels' checks, but carries nothing)
  (field ^:public ^long typ)
  (field ^:public ^InetSocketAddress bound)
  (field ^:public ^ServerSocket server)
  (field ^:public ^Socket conn)
  (field ^:public ^InputStream in)
  (field ^:public ^OutputStream out)
  ;; a connection select accepted ahead of accept
  (field ^:public ^Socket ahead)
  ;; its entry of Fd's table (its streams and what closes it are the entry's)
  (field ^:public ^Fd fd)
  ;; a socket of the OS through HostSys, and its descriptor there
  (field ^:public ^boolean host)
  (field ^:public ^long os)

  (method ^:public ^:static ofFd ^Sock [^long fd ^String fn]
    (let [d (Fd/get fd)]
      (when (nil? d) (throw (ExtUnix/error 9 fn "")))
      (when (nil? (.-sock d)) (throw (ExtUnix/error 88 fn "")))
      (cast Sock (.-sock d))))

  (method ^:static errno ^int [^Throwable t]
    (let [^String m (if (nil? (.getMessage t)) "" (.getMessage t))]
      (cond (.contains m "refused") 111
            (.contains m "in use") 98
            (.contains m "reset") 104
            (.contains m "closed") 9
            :else 5)))

  (method ^:public ^:static install ^long [^Sock s]
    (let [d (Fd.)]
      (set! (.-sock d) s)
      (set! (.-fd s) d)
      (set! (.-sdgram d) (== (.-typ s) 1))
      (set! (.-readable d) true)
      (set! (.-writable d) true)
      (Fd/install d)))

  (method ^:static addrOf ^InetSocketAddress [sa ^String fn]
    (let [b (cast Block sa)]
      (when (== (.-tag b) 0) (throw (ExtUnix/error 97 fn "")))
      (InetSocketAddress. (InetAddress/getByAddress (cast byte/1 (aget (.-f b) 0))) (Rt/ii (aget (.-f b) 1)))))

  (method ^:static valueOf [^InetSocketAddress a]
    (Block. 1 (new Object/1 [(.getAddress (.getAddress a)) (Long/valueOf (long (.getPort a)))])))

  ;; ---- the host's sockets (OC216 (a), the rest)

  ;; a Unix.sockaddr as the host's field: "u" and the path (an abstract name's leading NUL kept), or "i", the port's two bytes
  ;; (big-endian) and the address's 4 or 16
  (method ^:static hostAddr ^byte/1 [sa]
    (let [b (cast Block sa)]
      (if (== (.-tag b) 0)
        (let [p (cast byte/1 (aget (.-f b) 0))
              o (new byte/1 (unchecked-inc-int (alength p)))]
          (aset o 0 (unchecked-byte 117))
          (System/arraycopy p 0 o 1 (alength p))
          o)
        (let [ip (cast byte/1 (aget (.-f b) 0))
              port (Rt/ii (aget (.-f b) 1))
              o (new byte/1 (unchecked-add-int 3 (alength ip)))]
          (aset o 0 (unchecked-byte 105))
          (aset o 1 (unchecked-byte (bit-shift-right port 8)))
          (aset o 2 (unchecked-byte port))
          (System/arraycopy ip 0 o 3 (alength ip))
          o))))

  ;; the host's field as a Unix.sockaddr (alloc_sockaddr)
  (method ^:static hostValue [^byte/1 a]
    (if (and (> (alength a) 0) (== (aget a 0) 105))
      (Block. 1 (new Object/1 [(java.util.Arrays/copyOfRange a 3 (alength a))
                               (Long/valueOf (long (bit-or (bit-shift-left (bit-and (aget a 1) 255) 8) (bit-and (aget a 2) 255))))]))
      (Block. 0 (new Object/1 [(java.util.Arrays/copyOfRange a (if (> (alength a) 0) 1 0) (alength a))]))))

  ;; a socket of the OS (descriptor os of the host) entered into Fd's table
  (method ^:static hostInstall ^long [^long dom ^long typ ^long os]
    (let [s (Sock.)
          d (Fd.)
          in (HSockIn. os)]
      (set! (.-domain s) dom)
      (set! (.-typ s) typ)
      (set! (.-host s) true)
      (set! (.-os s) os)
      (set! (.-sock d) s)
      (set! (.-fd s) d)
      (set! (.-sdgram d) (== typ 1))
      (set! (.-readable d) true)
      (set! (.-writable d) true)
      (set! (.-sin d) in)
      (set! (.-sout d) (HSockOut. os))
      (set! (.-sclose d) in)
      (Fd/install d)))

  (method ^:static flags ^long [l]
    (let [xs (ExtUnixFd/ints l)]
      (loop [^int i 0 ^long f 0]
        (if (>= i (.size xs)) f (recur (unchecked-inc-int i) (bit-or f (bit-shift-left 1 (Rt/l (.get xs i)))))))))

  (method ^:static os [^Sock s] (Long/valueOf (.-os s)))
  ;; ?cloexec: None 0, Some b b's 0 or 1
  (method ^:static cloexecOf [c] (if (instance? Block c) (Long/valueOf (Rt/l (aget (.-f (cast Block c)) 0))) (Long/valueOf 0)))

  (method ^:public ^:static caml_unix_socketpair [cloexec dom typ proto]
    (when (not (HostSys/avail)) (throw (Rt/missing "caml_unix_socketpair")))
    (let [r (HostSys/call "socketpair" (new Object/1 ["socketpair" dom typ proto (Sock/cloexecOf cloexec)]))
          a (Sock/hostInstall (Rt/l dom) (Rt/l typ) (HostSys/num r 0))
          b (Sock/hostInstall (Rt/l dom) (Rt/l typ) (HostSys/num r 1))]
      (Rt/tuple (new Object/1 [(Long/valueOf a) (Long/valueOf b)]))))

  (method ^:public ^:static caml_unix_socket [cloexec dom typ proto]
    (let [dm (Rt/l dom)]
      (when (and (== dm 0) (HostSys/avail))
        (let [r (HostSys/call "socket" (new Object/1 ["socket" dom typ proto (Sock/cloexecOf cloexec)]))]
          (return (Long/valueOf (Sock/hostInstall dm (Rt/l typ) (HostSys/num r 0))))))
      (when (or (== dm 0) (> (Rt/l typ) 1)) (throw (ExtUnix/error 93 "socket" "")))
      (let [s (Sock.)]
        (set! (.-domain s) dm)
        (set! (.-typ s) (Rt/l typ))
        (Long/valueOf (Sock/install s)))))

  (method ^:public ^:static caml_unix_bind [fd sa]
    (let [s (Sock/ofFd (Rt/l fd) "bind")]
      (when (.-host s)
        (HostSys/call "bind" (new Object/1 ["bind" (Sock/os s) (Sock/hostAddr sa)]))
        (return Rt/UNIT))
      (set! (.-bound s) (Sock/addrOf sa "bind"))
      ;; a bound stream socket is a server's: its ServerSocket made now, so that getsockname before listen knows the port
      (when (== (.-typ s) 0)
        (try
          (let [ss (ServerSocket.)]
            (.setReuseAddress ss true)
            (.bind ss (.-bound s) 50)
            (set! (.-server s) ss)
            (when (some? (.-fd s)) (set! (.-sclose (.-fd s)) ss)))
          (catch IOException e (throw (ExtUnix/error (Sock/errno e) "bind" "")))))
      Rt/UNIT))

  (method ^:public ^:static caml_unix_listen [fd n]
    (let [s (Sock/ofFd (Rt/l fd) "listen")]
      (when (.-host s)
        (HostSys/call "listen" (new Object/1 ["listen" (Sock/os s) n]))
        (return Rt/UNIT))
      (when (nil? (.-server s))
       (try
        (let [ss (ServerSocket.)]
          (.setReuseAddress ss true)
          (.bind ss (if (nil? (.-bound s)) (InetSocketAddress. 0) (.-bound s)) (Rt/ii n))
          (set! (.-server s) ss)
          (when (some? (.-fd s)) (set! (.-sclose (.-fd s)) ss)))
        (catch IOException e (throw (ExtUnix/error (Sock/errno e) "listen" "")))))
      Rt/UNIT))

  (method ^:static attach ^void [^Sock s ^Socket c]
    (set! (.-conn s) c)
    (set! (.-in s) (.getInputStream c))
    (set! (.-out s) (.getOutputStream c))
    (when (some? (.-fd s))
      (set! (.-sin (.-fd s)) (.-in s))
      (set! (.-sout (.-fd s)) (.-out s))
      (set! (.-sclose (.-fd s)) c)))

  (method ^:public ^:static caml_unix_accept [cloexec fd]
    (let [s (Sock/ofFd (Rt/l fd) "accept")]
      (when (.-host s)
        (let [r (HostSys/callFree "accept" (new Object/1 ["accept" (Sock/os s) (Sock/cloexecOf cloexec)]))
              i (Sock/hostInstall (.-domain s) (.-typ s) (HostSys/num r 0))]
          (return (Rt/tuple (new Object/1 [(Long/valueOf i) (Sock/hostValue (cast byte/1 (.get r 1)))])))))
      (when (nil? (.-server s)) (throw (ExtUnix/error 22 "accept" "")))
      (let [c (if (some? (.-ahead s))
                (let [a (.-ahead s)] (set! (.-ahead s) nil) a)
                (do (Gil/unlock)
                    (try (.accept (.-server s))
                         (catch IOException e (throw (ExtUnix/error (Sock/errno e) "accept" "")))
                         (finally (Gil/lock)))))
            n (Sock.)]
        (set! (.-domain n) (.-domain s))
        (let [i (Sock/install n)]
          (Sock/attach n c)
          (Rt/tuple (new Object/1 [(Long/valueOf i) (Sock/valueOf (cast InetSocketAddress (.getRemoteSocketAddress c)))]))))))

  (method ^:public ^:static caml_unix_connect [fd sa]
    (let [s0 (Sock/ofFd (Rt/l fd) "connect")]
      (when (.-host s0)
        (HostSys/callFree "connect" (new Object/1 ["connect" (Sock/os s0) (Sock/hostAddr sa)]))
        (return Rt/UNIT)))
    (let [s (Sock/ofFd (Rt/l fd) "connect")
          a (Sock/addrOf sa "connect")
          c (Socket.)]
      (Gil/unlock)
      (try (.connect c a)
           (catch IOException e (throw (ExtUnix/error (Sock/errno e) "connect" "")))
           (finally (Gil/lock)))
      (Sock/attach s c)
      Rt/UNIT))

  (method ^:public ^:static caml_unix_shutdown [fd cmd]
    (let [s (Sock/ofFd (Rt/l fd) "shutdown")
          c (Rt/l cmd)]
      (when (.-host s)
        (HostSys/call "shutdown" (new Object/1 ["shutdown" (Sock/os s) cmd]))
        (return Rt/UNIT))
      (when (nil? (.-conn s)) (throw (ExtUnix/error 107 "shutdown" "")))
      (try
        (when (not (== c 1)) (.shutdownInput (.-conn s)))
        (when (not (== c 0)) (.shutdownOutput (.-conn s)))
        (catch IOException e (throw (ExtUnix/error (Sock/errno e) "shutdown" ""))))
      Rt/UNIT))

  (method ^:public ^:static caml_unix_getsockname [fd]
    (let [s (Sock/ofFd (Rt/l fd) "getsockname")]
      (when (.-host s)
        (return (Sock/hostValue (cast byte/1 (.get (HostSys/call "getsockname" (new Object/1 ["getsockname" (Sock/os s)])) 0)))))
      (cond (some? (.-server s)) (Sock/valueOf (cast InetSocketAddress (.getLocalSocketAddress (.-server s))))
            (some? (.-conn s)) (Sock/valueOf (cast InetSocketAddress (.getLocalSocketAddress (.-conn s))))
            (some? (.-bound s)) (Sock/valueOf (.-bound s))
            :else (Sock/valueOf (InetSocketAddress. (InetAddress/getByAddress (new byte/1 4)) 0)))))

  (method ^:public ^:static caml_unix_getpeername [fd]
    (let [s (Sock/ofFd (Rt/l fd) "getpeername")]
      (when (.-host s)
        (return (Sock/hostValue (cast byte/1 (.get (HostSys/call "getpeername" (new Object/1 ["getpeername" (Sock/os s)])) 0)))))
      (when (nil? (.-conn s)) (throw (ExtUnix/error 107 "getpeername" "")))
      (Sock/valueOf (cast InetSocketAddress (.getRemoteSocketAddress (.-conn s))))))

  ;; read(2) of a socket: the count (0 at the end) or -errno, outside the Gil
  (method ^:public ^:static read ^long [^Sock s ^byte/1 buf ^int off ^int len]
    (if (nil? (.-in s))
      (long -107)
      (do (Gil/unlock)
          (try (let [n (.read (.-in s) buf off len)] (if (< n 0) (long 0) (long n)))
               (catch IOException e (long (unchecked-negate (Sock/errno e))))
               (finally (Gil/lock))))))

  (method ^:public ^:static write ^long [^Sock s ^byte/1 buf ^int off ^int len]
    (if (nil? (.-out s))
      (long -107)
      (do (Gil/unlock)
          (try (.write (.-out s) buf off len) (.flush (.-out s)) (long len)
               (catch IOException e (long (unchecked-negate (Sock/errno e))))
               (finally (Gil/lock))))))

  (method ^:public ^:static close ^void [^Sock s]
    (try
      (when (some? (.-conn s)) (.close (.-conn s)))
      (when (some? (.-server s)) (.close (.-server s)))
      (catch IOException e nil)))

  ;; recv and recvfrom on a socket of the host: the bytes read put at ofs, and the sender's address (unix's sendrecv.c)
  (method ^:static hostRecv ^java.util.ArrayList [^Sock s ^String fn buf ofs len flags]
    (let [n (Math/min (Rt/ii len) (int 65536))
          r (HostSys/callFree fn (new Object/1 [fn (Sock/os s) (Long/valueOf (long n)) (Long/valueOf (Sock/flags flags))]))
          d (cast byte/1 (.get r 0))]
      (System/arraycopy d 0 (cast byte/1 buf) (Rt/ii ofs) (alength d))
      r))

  (method ^:public ^:static caml_unix_recvfrom [fd buf ofs len flags]
    (let [s (Sock/ofFd (Rt/l fd) "recvfrom")]
      (when (not (.-host s)) (throw (Rt/missing "caml_unix_recvfrom")))
      (let [r (Sock/hostRecv s "recvfrom" buf ofs len flags)]
        (Rt/tuple (new Object/1 [(Long/valueOf (long (alength (cast byte/1 (.get r 0))))) (Sock/hostValue (cast byte/1 (.get r 1)))])))))

  (method ^:public ^:static caml_unix_sendto_native [fd buf ofs len flags sa]
    (let [s (Sock/ofFd (Rt/l fd) "sendto")]
      (when (not (.-host s)) (throw (Rt/missing "caml_unix_sendto")))
      (let [n (Math/min (Rt/ii len) (int 65536))
            o (Rt/ii ofs)
            r (HostSys/callFree "sendto" (new Object/1 ["sendto" (Sock/os s) (java.util.Arrays/copyOfRange (cast byte/1 buf) o (unchecked-add-int o n))
                                                       (Long/valueOf (Sock/flags flags)) (Sock/hostAddr sa)]))]
        (Long/valueOf (HostSys/num r 0)))))

  (method ^:public ^:static caml_unix_sendto [fd buf ofs len flags sa] (Sock/caml_unix_sendto_native fd buf ofs len flags sa))

  (method ^:public ^:static caml_unix_recv [fd buf ofs len flags]
    (let [s0 (Sock/ofFd (Rt/l fd) "recv")]
      (when (.-host s0)
        (return (Long/valueOf (long (alength (cast byte/1 (.get (Sock/hostRecv s0 "recv" buf ofs len flags) 0))))))))
    (let [s (Sock/ofFd (Rt/l fd) "recv")
          n (Sock/read s (cast byte/1 buf) (Rt/ii ofs) (Math/min (Rt/ii len) (int 65536)))]
      (when (< n 0) (throw (ExtUnix/error (unchecked-int (unchecked-negate n)) "recv" "")))
      (Long/valueOf n)))

  (method ^:public ^:static caml_unix_send [fd buf ofs len flags]
    (let [s0 (Sock/ofFd (Rt/l fd) "send")]
      (when (.-host s0)
        (let [n (Math/min (Rt/ii len) (int 65536))
              o (Rt/ii ofs)]
          (return (Long/valueOf (HostSys/num (HostSys/callFree "send" (new Object/1 ["send" (Sock/os s0) (java.util.Arrays/copyOfRange (cast byte/1 buf) o (unchecked-add-int o n))
                                                                                     (Long/valueOf (Sock/flags flags))])) 0))))))
    (let [s (Sock/ofFd (Rt/l fd) "send")
          n (Sock/write s (cast byte/1 buf) (Rt/ii ofs) (Math/min (Rt/ii len) (int 65536)))]
      (when (< n 0) (throw (ExtUnix/error (unchecked-int (unchecked-negate n)) "send" "")))
      (Long/valueOf n)))

  ;; socket options are accepted and kept by no one (SO_REUSEADDR is the server's anyway); get answers false or 0
  ;; a host's socket: the boolean and integer options (kinds 0 and 1) are the OS's, the others kept by no one as above
  (method ^:public ^:static caml_unix_setsockopt [kind fd opt v]
    (let [s (Sock/ofFd (Rt/l fd) "setsockopt")]
      (when (and (.-host s) (<= (Rt/l kind) 1))
        (HostSys/call "setsockopt" (new Object/1 ["setsockopt" (Sock/os s) kind opt (Long/valueOf (Rt/l v))]))))
    Rt/UNIT)
  (method ^:public ^:static caml_unix_getsockopt [kind fd opt]
    (let [s (Sock/ofFd (Rt/l fd) "getsockopt")]
      (when (and (.-host s) (<= (Rt/l kind) 1))
        (return (Long/valueOf (HostSys/num (HostSys/call "getsockopt" (new Object/1 ["getsockopt" (Sock/os s) kind opt])) 0)))))
    (let [k (Rt/l kind)] (if (or (== k 2) (== k 4)) Rt/NONE (if (== k 3) (Double/valueOf 0.0) (Long/valueOf 0)))))

  ;; select's readiness of a descriptor for reading
  (method ^:static readable ^boolean [^long fd]
    (let [d (Fd/get fd)]
      (cond (nil? d) false
            (some? (.-sock d))
            (let [s (cast Sock (.-sock d))]
              (cond (.-host s) (== 1 (HostSys/num (HostSys/call "poll" (new Object/1 ["poll" (Sock/os s)])) 0))
                    (some? (.-ahead s)) true
                    (some? (.-server s))
                    (try (.setSoTimeout (.-server s) 1)
                         (let [c (.accept (.-server s))] (set! (.-ahead s) c) true)
                         (catch SocketTimeoutException e false)
                         (catch IOException e true)
                         (finally (try (.setSoTimeout (.-server s) 0) (catch IOException e nil))))
                    (some? (.-in s)) (try (> (.available (.-in s)) 0) (catch IOException e true))
                    :else false))
            (some? (.-pipe d)) (or (> (.-count (.-pipe d)) 0) (== (.-writers (.-pipe d)) 0))
            :else true)))

  (method ^:public ^:static caml_unix_select [r w e t]
    (let [rl (ExtUnixFd/ints r)
          wl (ExtUnixFd/ints w)
          timeout (Rt/d t)
          deadline (if (< timeout 0.0) Long/MAX_VALUE (unchecked-add (System/currentTimeMillis) (unchecked-long (* timeout 1000.0))))]
      (loop []
        (let [ro (java.util.ArrayList.)]
          (loop [^int i 0]
            (when (< i (.size rl))
              (when (Sock/readable (Rt/l (.get rl i))) (.add ro (.get rl i)))
              (recur (unchecked-inc-int i))))
          (if (or (> (.size ro) 0) (> (.size wl) 0) (>= (System/currentTimeMillis) deadline))
            (Rt/tuple (new Object/1 [(Rt/list (.toArray ro)) (Rt/list (.toArray wl)) (Long/valueOf 0)]))
            (do (Gil/unlock)
                (try (Thread/sleep 2) (catch InterruptedException x nil) (finally (Gil/lock)))
                (recur)))))))

  (method ^:public ^:static caml_unix_gethostbyaddr [a]
    (let [b (cast byte/1 a)]
      (when (not (or (== (alength b) 4) (== (alength b) 16))) (throw (Exn. Rt/Not_found)))
      (let [name (try (.getHostName (InetAddress/getByAddress b)) (catch Exception x nil))]
        (when (nil? name) (throw (Exn. Rt/Not_found)))
        (Rt/tuple (new Object/1 [(Rt/ofUtf8 name) (Block. 0 (new Object/1 0)) (Long/valueOf (if (== (alength b) 4) 1 2))
                                 (Block. 0 (new Object/1 [(java.util.Arrays/copyOf b (alength b))]))])))))

  ;; getaddrinfo: numeric hosts and the loopback (the triage's program asks names holding NUL: none)
  (method ^:public ^:static caml_unix_getaddrinfo [node serv opts]
    (if (or (not (ExtSys/cSafe node)) (not (ExtSys/cSafe serv)))
      (Long/valueOf 0)
      (throw (Rt/invalidArg "getaddrinfo")))))

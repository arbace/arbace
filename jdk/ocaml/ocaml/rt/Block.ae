;; OCaml's runtime as Java forms (doc/ocaml/OCAML-SURVEY.md, "As built: O6 (write-ahead)"): a block,
;; OCaml's structured value (tuples, records, constructors with arguments, arrays of non-floats,
;; modules, exceptions, objects, lazy values): its tag and its fields.

(in-ns 'ocaml.rt)

(defclass ^:public ^:final Block
  (field ^:public ^int tag)
  (field ^:public ^Object/1 f)

  (constructor ^:public [this ^int tag ^Object/1 f]
    (set! (.-tag this) tag)
    (set! (.-f this) f)))

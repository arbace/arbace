;; Another custom block (channels, mutexes, bigarrays...): its custom operations' identifier ("_chan",
;; "_mutex"...) and the runtime's object.

(in-ns 'ocaml.rt)

(defclass ^:public ^:final Custom
  (field ^:public ^String id)
  (field ^:public v)
  (constructor ^:public [this ^String id v] (set! (.-id this) id) (set! (.-v this) v)))

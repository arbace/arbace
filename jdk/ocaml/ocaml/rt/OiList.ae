;; A list, a vector or a map of a Lambda text the runtime's interpreter reads (Oi, queue 544): its elements and its kind (0 a list,
;; 1 a vector, 2 a map, its keys and values in turn).

(in-ns 'ocaml.rt)

(defclass ^:public ^:final OiList
  (field ^:public ^:final ^Object/1 xs)
  (field ^:public ^:final ^int kind)

  (constructor ^:public [this ^Object/1 xs ^int kind]
    (set! (.-xs this) xs)
    (set! (.-kind this) kind)))

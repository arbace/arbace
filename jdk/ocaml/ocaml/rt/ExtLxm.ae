;; caml_lxm_next (prng.c): the L64X128 member of the LXM family over a 4-element int64 bigarray;
;; ported from oi's ext_digest.go.

(in-ns 'ocaml.rt)

(defclass ^:public ^:final ExtLxm
  (method ^:public ^:static caml_lxm_next [s]
    (let [b (BigArray/of s)
          d (.-data b)
          o (.-off b)
          sa (.-v (cast I64 (aget d o)))
          ^:mutable ^long ss (.-v (cast I64 (aget d (unchecked-add-int o 1))))
          ^:mutable ^long q0 (.-v (cast I64 (aget d (unchecked-add-int o 2))))
          ^:mutable ^long q1 (.-v (cast I64 (aget d (unchecked-add-int o 3))))
          ^:mutable ^long z (unchecked-add ss q0)]
      (set! z (unchecked-multiply (bit-xor z (unsigned-bit-shift-right z 32)) -2685821657736338717))
      (set! z (unchecked-multiply (bit-xor z (unsigned-bit-shift-right z 32)) -2685821657736338717))
      (set! z (bit-xor z (unsigned-bit-shift-right z 32)))
      (set! ss (unchecked-add (unchecked-multiply ss -3372029247567499371) sa))
      (set! q1 (bit-xor q1 q0))
      (set! q0 (Long/rotateLeft q0 24))
      (set! q0 (bit-xor (bit-xor q0 q1) (bit-shift-left q1 16)))
      (set! q1 (Long/rotateLeft q1 37))
      (aset d (unchecked-add-int o 1) (I64. ss))
      (aset d (unchecked-add-int o 2) (I64. q0))
      (aset d (unchecked-add-int o 3) (I64. q1))
      (I64. z))))

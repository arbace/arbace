      Rt/UNIT))
  (method ^:public ^:static caml_ephe_set_data [e d]
    (aset (.-f (cast Block e)) 1 d)
    Rt/UNIT)
  (method ^:public ^:static caml_ephe_unset_data [e]
    (aset (.-f (cast Block e)) 1 ephNone)
    Rt/UNIT)
  (method ^:public ^:static caml_ephe_get_key [e n] (ExtGc/ephGet e (ExtGc/ephKeyOffset e n "Weak.get") false))
  (method ^:public ^:static caml_weak_get [e n] (ExtGc/ephGet e (ExtGc/ephKeyOffset e n "Weak.get") false))
  (method ^:public ^:static caml_ephe_get_key_copy [e n] (ExtGc/ephGet e (ExtGc/ephKeyOffset e n "Weak.get") true))
  (method ^:public ^:static caml_weak_get_copy [e n] (ExtGc/ephGet e (ExtGc/ephKeyOffset e n "Weak.get") true))
  (method ^:public ^:static caml_ephe_get_data [e] (ExtGc/ephGet e 1 false))
  (method ^:public ^:static caml_ephe_get_data_copy [e] (ExtGc/ephGet e 1 true))
  (method ^:public ^:static caml_ephe_check_key [e n]
    (Rt/b (not (identical? (ExtGc/ephSlot (aget (.-f (cast Block e)) (ExtGc/ephKeyOffset e n "Weak.check"))) ephNone))))
  (method ^:public ^:static caml_weak_check [e n]
    (Rt/b (not (identical? (ExtGc/ephSlot (aget (.-f (cast Block e)) (ExtGc/ephKeyOffset e n "Weak.check"))) ephNone))))
  (method ^:public ^:static caml_ephe_check_data [e]
    (ExtGc/ephClean e)
    (Rt/b (not (identical? (aget (.-f (cast Block e)) 1) ephNone))))
  (method ^:public ^:static caml_ephe_blit_key [es ofs ed ofd n] (ExtGc/ephBlit es ofs ed ofd n))
  (method ^:public ^:static caml_weak_blit [es ofs ed ofd n] (ExtGc/ephBlit es ofs ed ofd n))
  (method ^:public ^:static caml_ephe_blit_data [es ed]
    (aset (.-f (cast Block ed)) 1 (aget (.-f (cast Block es)) 1))
    Rt/UNIT)

  ;; backtrace.c: Bt's (OC217 (a)'s fifth stage, queue 370)


  ;; memprof.c (OC218 (a); queue 331's sampling, and since queue 438 OC218's heap model at the light level, oi's ext_sys.go allocV,
  ;; memprofSample, memprofMinorGC, memprofMajorGC, memprofRun, memprofCall: OC233 (a), OC234 (a), OC235 (a)). Once a profile was
  ;; started (memprofSampling, never cleared but by Main/reset), each counted allocation (Rt/words, Rt/wordsV with its value) fills a simulated minor heap of
  ;; Gc.control's minor_heap_size words; the one that would overflow it empties it first, a minor collection, as the asked collections
  ;; do (gcAsked). A profile (memprofProfile: [tracker lambda status], status 0 sampling, 1 stopped, 2 discarded) is its domain's
  ;; (Dom/mp), inherited by the domains it spawns; it samples the counted words at its rate, and an allocation with samples calls the
  ;; tracker's alloc_minor (alloc_major above Max_young_wosize, 256) with {n_samples; size; source; callstack} as the allocation
  ;; returns, its Some tracking the value (an entry [profile weak-ref data major]) through the simulated collections: a minor one gives
  ;; each tracked minor value its promote callback when it lives after System/gc (its WeakReference not cleared: jrt's weak pointers,
  ;; Go's reachability), else dealloc_minor; a major one (Gc.major, full_major, compact) gives each dead major value dealloc_major.
  ;; Callbacks never nest: those queued while one runs (the thread's queue of [kind n size major profile ref entry], kind 0 an
  ;; allocation's, 1 a promotion's, 2 a minor deallocation's, 3 a major one's) run after it; an exception drops the queued allocation
  ;; callbacks and keeps the others for the next Rt/tick. The callbacks' own allocations are not sampled; the callstack is empty.
  (field ^:static ^double memprofNext 0.0)
  (field ^:static ^long memprofRng 42)
  (field ^:static ^long minorUsed 0)
  ;; the young values (ocaml-aot, 2026-11-24; oi's youngSet since queue 461, lazy/minor_major_force): Obj.is_shared
  ;; (caml_obj_is_shared) is false for a block in the simulated minor heap. Once a program asks (its first is_shared, which finds
  ;; every value made before it old, and sets memprofSampling so that every counted allocation reaches memprofAlloc), the counted
  ;; minor allocations are kept in youngSet until the simulated minor heap's next collection (or an asked one) empties it
  (field ^:static ^boolean youngTrack false)
  (field ^:static ^:final ^java.util.IdentityHashMap youngSet (java.util.IdentityHashMap.))
  (method ^:static youngClear ^void [] (when youngTrack (.clear youngSet)))
  (method ^:public ^:static isShared ^boolean [x]
    (if (not youngTrack)
      (do (set! youngTrack true) (set! memprofSampling true) true)
      (or (not (or (instance? Block x) (instance? double/1 x) (instance? byte/1 x))) (not (.containsKey youngSet x)))))
  (field ^:static ^boolean minorDue false)
  (field ^:static ^:final ^ArrayList mpMinor (ArrayList.))
  (field ^:static ^:final ^ArrayList mpMajor (ArrayList.))
  ;; memprofPending: the callbacks queued in all threads; each thread's queue and in-callback flag its own (a ThreadLocal of
  ;; [queue inCallback]), as memprof.c's thread states: a callback that blocks leaves the other threads' callbacks running
  (field ^:public ^:static ^int memprofPending 0)
  (field ^:static ^:final ^ThreadLocal memprofTL (ThreadLocal.))
  (method ^:static mpState ^Object/1 []
    (let [x (.get memprofTL)]
      (if (nil? x)
        (let [st (new Object/1 [(ArrayList.) Boolean/FALSE])] (.set memprofTL st) st)
        (cast Object/1 x))))
  ;; (oc-tail) the thread's state, taken by the fresh thread of a deep call (Rt/hop), which runs as the same OCaml thread
  (method ^:public ^:static mpThread [] (.get memprofTL))
  (method ^:public ^:static mpAdopt ^void [st] (when (some? st) (.set memprofTL st)))
  (method ^:static mpInCb ^boolean [^Object/1 st] (.booleanValue (cast Boolean (aget st 1))))
  (method ^:static mpPush ^void [^Object/1 st ^long kind ^long n ^long size ^boolean major p r e]
    (ExtGc/mpPushSrc st kind n size major p r e 0))
  ;; (an entry's eighth field the allocation's source, info.source: 0 Normal, 2 Custom, 3 Map_file)
  (method ^:static mpPushSrc ^void [^Object/1 st ^long kind ^long n ^long size ^boolean major p r e ^long src]
    (.add (cast ArrayList (aget st 0))
          (new Object/1 [(Long/valueOf kind) (Long/valueOf n) (Long/valueOf size) (Boolean/valueOf major) p r e (Long/valueOf src)]))
    (set! memprofPending (unchecked-inc-int memprofPending))
    (Rt/force))
  (method ^:static mpStatus ^long [p] (Rt/l (aget (cast Object/1 p) 2)))
  (method ^:static mpDomProf [] (.-mp (.-dom (Effects/st))))
  (method ^:public ^:static spawnProf [] (ExtGc/mpDomProf))
  (method ^:static memprofGeom ^double [^double lambda]
    (set! memprofRng (unchecked-add (unchecked-multiply memprofRng 6364136223846793005) 1442695040888963407))
    ;; (Java arithmetic on doubles, unchecked-divide and unchecked-negate: the compiled level's j2g world has no Numbers for / and
    ;; unary -, queue 396)
    (let [u (unchecked-divide (+ (double (unsigned-bit-shift-right memprofRng 11)) 0.5) 9007199254740992.0)]
      (+ (Math/floor (unchecked-divide (Math/log u) (Math/log1p (unchecked-negate lambda)))) 1.0)))

  ;; an allocation of v (wosize words, counted by Rt; nil: a value without an identity): the simulated minor heap filled, collected first
  ;; when the allocation overflows it, then v sampled when the domain's profile samples, its callback run at once (OC234 (a)), unless the
  ;; thread is in a callback
  ;; memprofSample: an allocation whose value is not at hand (taken as dead at the next minor collection when tracked)
  (method ^:public ^:static memprofSample ^void [^long wosize] (ExtGc/memprofAlloc wosize nil))
  (method ^:public ^:static memprofAlloc ^void [^long wosize v]
    ;; the ring's allocation buckets (the instrumented runtime's caml_ev_alloc; ExtRtEvents/alloc, no-op unless the ring is active)
    (ExtRtEvents/alloc wosize)
    (let [st (ExtGc/mpState) ^:mutable full false]
      (when (<= wosize 256)
        (set! minorUsed (unchecked-add minorUsed (unchecked-inc wosize)))
        (when (> minorUsed (Rt/l (aget gcControl 0)))
          (set! minorUsed (unchecked-inc wosize))
          (set! customMinorExtra 0)
          (ExtGc/youngClear)
          (set! full true))
        (when (and youngTrack (some? v)) (.put youngSet v Boolean/TRUE)))
      (if (ExtGc/mpInCb st)
        (when full (set! minorDue true))
        (do
          (when (or full minorDue)
            (ExtGc/memprofMinorGC st false))
          (let [p (ExtGc/mpDomProf)]
            (when (and (some? p) (== (ExtGc/mpStatus p) 0))
              (ExtGc/memprofDraw st p wosize v)))
          (when (and (== combDepth 0) (> (.size (cast ArrayList (aget st 0))) 0))
            (ExtGc/memprofRun))))))
  ;; (queue 603) a combined allocation at the light level (o2j's comb-tree?: a tree of blocks made while a profile samples): its blocks'
  ;; callbacks queued as they are made and run once the tree is made (combEnd's v), as memprof.c runs a combined allocation's samples
  ;; after the allocation: a callback that stops or replaces the profile leaves the tree's other samples without theirs (memprofCall)
  (field ^:static ^int combDepth 0)
  (method ^:public ^:static combBegin [] (set! combDepth (unchecked-inc-int combDepth)) nil)
  (method ^:public ^:static combEnd [d v]
    (set! combDepth (unchecked-dec-int combDepth))
    (when (and (== combDepth 0) (> memprofPending 0)) (ExtGc/memprofRun))
    v)
  ;; the samples of an allocation of v by the profile p, its callback queued
  (method ^:static memprofDraw ^void [^Object/1 st p ^long wosize v]
    (ExtGc/memprofDrawW st p (unchecked-inc wosize) wosize v (> wosize 256) 0))
  ;; memprofDrawW: nw words sampled (a block's with its header; a custom block's memory alone, queue 523's memprofSampleW), reported as
  ;; size wosize, from the source src (0 Normal, 2 Custom, 3 Map_file)
  (method ^:static memprofDrawW ^void [^Object/1 st p ^long nw ^long wosize v ^boolean major ^long src]
    (let [lambda (Rt/d (aget (cast Object/1 p) 1)) ^:mutable n 0]
      (if (>= lambda 1.0)
        (set! n nw)
        (when (> lambda 0.0)
          (set! memprofNext (- memprofNext (double nw)))
          (loop []
            (when (<= memprofNext 0.0)
              (set! n (unchecked-inc n))
              (set! memprofNext (+ memprofNext (ExtGc/memprofGeom lambda)))
              (recur)))))
      (when (> n 0)
        (ExtGc/mpPushSrc st 0 n wosize major p (if (nil? v) nil (WeakReference. v)) nil src))))
  ;; the custom blocks' memory (ocaml-aot, 2026-11-25; oi's customMem and memprofCustom since queue 523, statmemprof/custom): custom.c's
  ;; caml_alloc_custom_mem of v, whose memory outside the heap is bytes: at most custom_minor_max_size bytes the block is the minor
  ;; heap's and its memory counts towards a minor collection (custom_minor_ratio percent of the minor heap's bytes, then a collection at
  ;; the next counted allocation), more the major heap's; then memprof.c's caml_memprof_sample_block of its memory (its words rounded
  ;; up, no header) from the source Custom (2), or Map_file (3) for Unix.map_file's; nothing when no profile samples, or in a callback
  (field ^:static ^long customMinorExtra 0)
  (method ^:public ^:static customMem ^void [v ^long bytes]
    (let [major (> bytes (Rt/l (aget gcControl 10)))]
      (when (and (not major) (> bytes 0))
        (set! customMinorExtra (unchecked-add customMinorExtra bytes))
        (when (>= customMinorExtra (unchecked-divide (unchecked-multiply (unchecked-multiply (Rt/l (aget gcControl 0)) 8) (Rt/l (aget gcControl 9))) 100))
          (set! customMinorExtra 0)
          (set! minorUsed (Rt/l (aget gcControl 0)))))
      (ExtGc/memprofCustom v bytes 2 major)))
  (method ^:public ^:static memprofCustom ^void [v ^long bytes ^long src ^boolean major]
    (when memprofSampling
      (let [st (ExtGc/mpState) w (unchecked-divide (unchecked-add bytes 7) 8)]
        (when (and (> w 0) (not (ExtGc/mpInCb st)))
          (let [p (ExtGc/mpDomProf)]
            (when (and (some? p) (== (ExtGc/mpStatus p) 0))
              (ExtGc/memprofDrawW st p w w v major src)))
          (when (> (.size (cast ArrayList (aget st 0))) 0)
            (ExtGc/memprofRun))))))
  ;; a tracked value lives after System/gc: its weak reference not cleared (none: a value without an identity, taken as dead)
  (method ^:static mpAlive ^boolean [r]
    (and (some? r) (some? (.get (cast WeakReference r)))))
  ;; a minor collection for the profiles (memprof.c's caml_memprof_after_minor_gc): System/gc unless gcDone, then each tracked minor
  ;; value's promote callback queued when it lives, else its dealloc_minor; a discarded profile's values dropped
  (method ^:static memprofMinorGC ^void [^Object/1 st ^boolean gcDone]
    (set! minorDue false)
    (when (> (.size mpMinor) 0)
      (when (not gcDone) (System/gc))
      (let [es (ArrayList. mpMinor)]
        (.clear mpMinor)
        (loop [^int i 0]
          (when (< i (.size es))
            (let [e (cast Object/1 (.get es i))]
              (when (not (== (ExtGc/mpStatus (aget e 0)) 2))
                (ExtGc/mpPush st (if (ExtGc/mpAlive (aget e 1)) 1 2) 0 0 false (aget e 0) nil e)))

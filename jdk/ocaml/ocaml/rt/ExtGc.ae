      (.clear mpMajor)
      (loop [^int i 0]
        (when (< i (.size es))
          (let [e (cast Object/1 (.get es i))]
            (when (not (== (ExtGc/mpStatus (aget e 0)) 2))
              (if (ExtGc/mpAlive (aget e 1))
                (.add mpMajor e)
                (ExtGc/mpPush st 3 0 0 false (aget e 0) nil e))))
          (recur (unchecked-inc-int i))))))
  ;; gcAsked's part: the simulated minor heap emptied (its tracked values promoted or dead), a major collection's deaths too, the
  ;; callbacks run now, or after the callback that asked for the collection
  (method ^:static memprofAsked ^void [^long majors]
    (when memprofSampling
      (let [st (ExtGc/mpState)]
        (set! minorUsed 0)
        (set! customMinorExtra 0)
        (when (or (> (.size mpMinor) 0) (and (> majors 0) (> (.size mpMajor) 0)))
          (System/gc))
        (ExtGc/memprofMinorGC st true)
        (when (> majors 0) (ExtGc/memprofMajorGC st))
        (when (> (.size (cast ArrayList (aget st 0))) 0)

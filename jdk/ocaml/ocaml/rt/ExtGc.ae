                  (let [r (Rt/ap1 (aget tf 2) (aget e 2))]
                    (when (instance? Block r)
                      (aset e 2 (aget (.-f (cast Block r)) 0))
                      (aset e 3 Boolean/TRUE)
                      (.add mpMajor e)))
                  (== kind 2) (Rt/ap1 (aget tf 3) (aget e 2))
                  :else (Rt/ap1 (aget tf 4) (aget e 2))))))))

  ;; Main/reset's part: no profile, no samples, no tracked values, the words counted from zero (a batch's next program)
  (method ^:public ^:static memprofReset ^void []
    (set! memprofSampling false)
    (set! combDepth 0)
    (set! youngTrack false)
    (.clear youngSet)
    (set! memprofPending 0)
    (set! minorUsed 0)
    (set! customMinorExtra 0)
    (set! minorDue false)
    (.clear mpMinor)
    (.clear mpMajor)
    (let [st (ExtGc/mpState)]
      (.clear (cast ArrayList (aget st 0)))
      (aset st 1 Boolean/FALSE))
    (set! (.-mp (.-dom (Effects/st))) nil)
    (set! Rt/minorWords 0)
    (set! Rt/majorWords 0))
  (method ^:public ^:static caml_memprof_start [lambda csize tracker]
    (when (or (not (instance? Double lambda)) (< (Rt/l csize) 0)
              (not (and (>= (Rt/d lambda) 0.0) (<= (Rt/d lambda) 1.0))))
      (throw (Rt/invalidArg "Gc.Memprof.start")))
    ;; the samples taken before get their callbacks first (memprof.c's final attempt); a profile sampling in this domain is replaced,
    ;; not stopped (it samples on in the domains that share it)
    (ExtGc/memprofRun)
    (let [p (new Object/1 [tracker lambda (Long/valueOf 0)])]
      (set! (.-mp (.-dom (Effects/st))) p)
      (set! memprofSampling true)
      (when (< (Rt/d lambda) 1.0) (set! memprofNext (ExtGc/memprofGeom (Rt/d lambda))))
      (Custom. "_memprof" p)))
  (method ^:public ^:static caml_memprof_is_sampling [u]
    (let [p (ExtGc/mpDomProf)] (Rt/b (and (some? p) (== (ExtGc/mpStatus p) 0)))))
  (method ^:public ^:static caml_memprof_stop [u]
    ;; the samples taken before the stop get their callbacks first
    (ExtGc/memprofRun)
    (let [p (ExtGc/mpDomProf)]
      (when (or (nil? p) (not (== (ExtGc/mpStatus p) 0)))
        (throw (Rt/failwith "Gc.Memprof.stop: no profile running.")))
      (aset (cast Object/1 p) 2 (Long/valueOf 1)))
    Rt/UNIT)
  (method ^:public ^:static caml_memprof_discard [t]
    (let [p (.-v (cast Custom t))]
      (when (== (ExtGc/mpStatus p) 0) (throw (Rt/failwith "Gc.Memprof.discard: profile not stopped.")))
      (when (== (ExtGc/mpStatus p) 2) (throw (Rt/failwith "Gc.Memprof.discard: profile already discarded.")))
      (aset (cast Object/1 p) 2 (Long/valueOf 2))
      (ExtGc/memprofDrop))
    Rt/UNIT))

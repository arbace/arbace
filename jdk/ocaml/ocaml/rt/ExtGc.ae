        (when (== (ExtGc/mpStatus (aget (cast Object/1 (.get mpMinor i)) 0)) 2) (.remove mpMinor i))
        (recur (unchecked-dec-int i))))
    (loop [^int i (unchecked-dec-int (.size mpMajor))]
      (when (>= i 0)
        (when (== (ExtGc/mpStatus (aget (cast Object/1 (.get mpMajor i)) 0)) 2) (.remove mpMajor i))
        (recur (unchecked-dec-int i)))))

  ;; the queued callbacks in order, those they queue too, and the promotions of a minor collection made while one ran; a callback's
  ;; exception is raised here, the allocation callbacks queued after it dropped (their allocations are never made in OCaml), the others
  ;; kept for the next Rt/tick
  (method ^:public ^:static memprofRun ^void []
    (let [st (ExtGc/mpState) mq (cast ArrayList (aget st 0)) ^:mutable finished false]
      (when (not (ExtGc/mpInCb st))
        (aset st 1 Boolean/TRUE)
        (try
          (loop []
            (if (== (.size mq) 0)
              (when minorDue
                (ExtGc/memprofMinorGC st false)
                (recur))
              (let [smp (cast Object/1 (.remove mq (unchecked-int 0)))]
                (set! memprofPending (unchecked-dec-int memprofPending))
                (ExtGc/memprofCall smp)
                (recur))))
          (set! finished true)
          (finally
            (aset st 1 Boolean/FALSE)
            (when (not finished)
              (loop [^int i (unchecked-dec-int (.size mq))]
                (when (>= i 0)
                  (when (== (Rt/l (aget (cast Object/1 (.get mq i)) 0)) 0)
                    (.remove mq i)
                    (set! memprofPending (unchecked-dec-int memprofPending)))
                  (recur (unchecked-dec-int i))))))))))
  ;; one queued callback: an allocation's (its value tracked when the callback returns Some), a promotion's (tracked on in the major heap
  ;; when it returns Some), a deallocation's
  (method ^:static memprofCall ^void [^Object/1 smp]
    (let [kind (Rt/l (aget smp 0)) p (aget smp 4) pf (cast Object/1 p)
          tf (.-f (cast Block (aget pf 0)))]
      (if (== kind 0)
        ;; a sample of a profile stopped or replaced since gets no callback (the block is not tracked)
        (when (and (identical? p (ExtGc/mpDomProf)) (== (ExtGc/mpStatus p) 0))
          (let [major (.booleanValue (cast Boolean (aget smp 3)))
                info (Block. 0 (new Object/1 [(aget smp 1) (aget smp 2) (aget smp 7) (Block. 0 (new Object/1 0))]))
                r (Rt/ap1 (aget tf (if major 1 0)) info)]
            (when (instance? Block r)
              (let [e (new Object/1 [p (aget smp 5) (aget (.-f (cast Block r)) 0) (Boolean/valueOf major)])]
                (if major (.add mpMajor e) (.add mpMinor e))))))
        ;; a tracked value's callbacks: none once its profile is discarded
        (when (not (== (ExtGc/mpStatus p) 2))

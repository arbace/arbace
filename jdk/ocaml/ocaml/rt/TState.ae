;; A Java thread's OCaml state: the fiber it runs (nil on a domain's main stack) and its domain.

(in-ns 'ocaml.rt)

(defclass ^:public ^:final TState
  (field ^:public ^Fiber fiber)
  (field ^:public ^Dom dom)
  (constructor ^:public [this ^Fiber fiber ^Dom dom]
    (set! (.-fiber this) fiber)
    (set! (.-dom this) dom)))

;; A fatal error of the runtime: its message is printed, the status is its code (2: "Fatal error: ...").

(in-ns 'ocaml.rt)

(defclass ^:public ^:final Fatal
  :extends RuntimeException

  (field ^:public ^int code)

  (constructor ^:public [this ^String msg ^int code]
    (super. msg nil false false)
    (set! (.-code this) code)))

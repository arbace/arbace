;; The runtime's lock (oi's gil, thread.go): OCaml code runs under it, one Java thread at a time
;; (the main program, an effect's fiber, a domain); released while a thread waits (a fiber's hand-
;; off, a mutex, a condition, a domain's join, cpu_relax). Its condition is the mutexes' and
;; conditions' (ext_domain.go's gilCond). The call depth (Rt/depth, OC92 (a)) is the holder's: a thread that releases the
;; lock keeps its depth in saved, and puts it back when it holds the lock again (a new thread starts at 0).

(in-ns 'ocaml.rt)

(defclass ^:public ^:final Gil
  (field ^:static ^:final ^Object lk (Object.))
  (field ^:static ^boolean held false)
  (field ^:static ^:final ^ThreadLocal saved (ThreadLocal.))

  (method ^:static save ^void [] (.set saved (Integer/valueOf Rt/depth)))
  (method ^:static restore ^void []
    (let [v (.get saved)]
      (set! Rt/depth (if (nil? v) 0 (.intValue (cast Integer v))))))

  ;; the threads waiting for the lock, and the times it was taken (yield's)
  (field ^:static ^int waiting 0)
  (field ^:static ^long turn 0)

  (method ^:public ^:static lock ^void []
    (locking lk
      (set! waiting (unchecked-inc-int waiting))
      (while held (.wait lk))
      (set! waiting (unchecked-dec-int waiting))
      (set! held true)
      (set! turn (unchecked-inc turn))
      (Gil/restore)))

  (method ^:public ^:static unlock ^void []
    (locking lk
      (Gil/save)
      (set! held false)
      (.notifyAll lk)))

  ;; releases the lock until another thread's broadcast, then takes it again (gilCond.Wait)
  (method ^:public ^:static await ^void []
    (locking lk
      (Gil/save)
      (set! held false)
      (.notifyAll lk)
      (.wait lk)
      (set! waiting (unchecked-inc-int waiting))
      (while held (.wait lk))
      (set! waiting (unchecked-dec-int waiting))
      (set! held true)
      (set! turn (unchecked-inc turn))
      (Gil/restore)))

  (method ^:public ^:static broadcast ^void []
    (locking lk (.notifyAll lk)))

  ;; lets a thread that waits for the lock run first, if one does: the lock given up until another thread took it (turn moved)
  ;; and gave it back (a plain unlock and lock would take it again before the waiting thread wakes)
  (method ^:public ^:static yield ^void []
    (locking lk
      (when (> waiting 0)
        (Gil/save)
        (let [t turn]
          (set! held false)
          (.notifyAll lk)
          (set! waiting (unchecked-inc-int waiting))
          (while (or held (== turn t)) (.wait lk))
          (set! waiting (unchecked-dec-int waiting))
          (set! held true)
          (set! turn (unchecked-inc turn))
          (Gil/restore))))))

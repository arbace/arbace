;; (queue 604) a tail call at the light level made by the caller's caller (o2j's tail-form): the function value and its arguments,
;; returned by a function entered from a tail call (Rt/tok) when its thread's frames are deep, and made by the nearest frame
;; entered from no tail call (Rt/bounce), so that a chain of tail calls keeps the interpreter's frames and Rt/depth bounded, as
;; ocamlopt's tail calls keep its stack (parallel/mctest's scheduler: every yield a handler's tail calls)

(in-ns 'ocaml.rt)

(defclass ^:public ^:final Tail
  (field ^:public ^:final f)
  (field ^:public ^:final ^Object/1 args)

  (constructor ^:public [this f ^Object/1 args]
    (set! (.-f this) f)
    (set! (.-args this) args)))

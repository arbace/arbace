;; A function of interpreted Lambda (Oi, queue 544): its node (ONode, the prototype) and the values of its free variables, called
;; by Oi/call with a frame of its own. Applied as any closure (Rt/ap, the translated code's a1 ... an).

(in-ns 'ocaml.rt)

(defclass ^:public ^:final OiFn
  :extends Closure

  (field ^:public ^:final ^ONode fn)
  (field ^:public ^:final ^Object/1 env)

  (constructor ^:public [this ^ONode fn ^Object/1 env]
    (super. (.-i fn))
    (set! (.-fn this) fn)
    (set! (.-env this) env))

  (method ^:public a1 [this a] (Oi/call this (new Object/1 [a])))
  (method ^:public a2 [this a b] (Oi/call this (new Object/1 [a b])))
  (method ^:public a3 [this a b c] (Oi/call this (new Object/1 [a b c])))
  (method ^:public a4 [this a b c d] (Oi/call this (new Object/1 [a b c d])))
  (method ^:public a5 [this a b c d e] (Oi/call this (new Object/1 [a b c d e])))
  (method ^:public a6 [this a b c d e f] (Oi/call this (new Object/1 [a b c d e f])))
  (method ^:public an [this ^Object/1 x] (Oi/call this x)))

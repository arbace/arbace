;; The minimal bigarray (caml_ba_*) and the bigstring accesses, ported from oi's ext_digest.go and
;; ext_bigstring.go; the objects are BigArray's, in a Custom "_bigarr02".

(in-ns (quote ocaml.rt))

(import (quote (java.util Arrays)))

(defclass ^:public ^:final ExtBigarray
  (method ^:static dimsOf ^int/1 [a]
    (let [f (.-f (cast Block a)) r (new int/1 (alength f))]
      (loop [^int i 0] (when (< i (alength f)) (aset r i (Rt/ii (aget f i))) (recur (unchecked-inc-int i))))
      r))
  (method ^:static idx ^Object/1 [a] (.-f (cast Block a)))
  (method ^:static wrap [^BigArray b ^int/1 dims ^int off]
    (BigArray/custom (BigArray. (.-kind b) (.-layout b) dims (.-data b) off)))

  (method ^:public ^:static caml_ba_create [kind layout dims]
    (let [d (ExtBigarray/dimsOf dims)]
      (loop [^int i 0]
        (when (< i (alength d))
          (when (< (aget d i) 0) (throw (Rt/invalidArg "Bigarray.create: negative dimension")))
          (recur (unchecked-inc-int i))))
      (BigArray/custom (BigArray/create (Rt/ii kind) (Rt/ii layout) d))))

  (method ^:public ^:static caml_ba_get_generic [b i] (.get (BigArray/of b) (ExtBigarray/idx i)))
  (method ^:public ^:static caml_ba_get_1 [b i] (.get (BigArray/of b) (new Object/1 [i])))
  (method ^:public ^:static caml_ba_get_2 [b i j] (.get (BigArray/of b) (new Object/1 [i j])))
  (method ^:public ^:static caml_ba_get_3 [b i j k] (.get (BigArray/of b) (new Object/1 [i j k])))
  (method ^:public ^:static caml_ba_set_generic [b i v] (.set (BigArray/of b) (ExtBigarray/idx i) v) Rt/UNIT)
  (method ^:public ^:static caml_ba_set_1 [b i v] (.set (BigArray/of b) (new Object/1 [i]) v) Rt/UNIT)
  (method ^:public ^:static caml_ba_set_2 [b i j v] (.set (BigArray/of b) (new Object/1 [i j]) v) Rt/UNIT)
  (method ^:public ^:static caml_ba_set_3 [b i j k v] (.set (BigArray/of b) (new Object/1 [i j k]) v) Rt/UNIT)

  (method ^:public ^:static caml_ba_dim [b n]
    (let [a (BigArray/of b) i (Rt/l n)]
      (when (or (< i 0) (>= i (alength (.-dims a)))) (throw (Rt/invalidArg "Bigarray.dim")))
      (Long/valueOf (long (aget (.-dims a) (unchecked-int i))))))
  (method ^:static dimN [b ^int n]
    (let [a (BigArray/of b)]
      (when (> n (alength (.-dims a))) (throw (Rt/invalidArg "Bigarray.dim")))
      (Long/valueOf (long (aget (.-dims a) (unchecked-dec-int n))))))
  (method ^:public ^:static caml_ba_dim_1 [b] (ExtBigarray/dimN b 1))
  (method ^:public ^:static caml_ba_dim_2 [b] (ExtBigarray/dimN b 2))
  (method ^:public ^:static caml_ba_dim_3 [b] (ExtBigarray/dimN b 3))
  (method ^:public ^:static caml_ba_num_dims [b] (Long/valueOf (long (alength (.-dims (BigArray/of b))))))
  (method ^:public ^:static caml_ba_kind [b] (Long/valueOf (long (.-kind (BigArray/of b)))))
  (method ^:public ^:static caml_ba_layout [b] (Long/valueOf (long (.-layout (BigArray/of b)))))

  (method ^:public ^:static caml_ba_fill [b v]
    (let [a (BigArray/of b) n (.size a)]
      (loop [^int i 0]
        (when (< i n)
          (aset (.-data a) (unchecked-add-int (.-off a) i) (BigArray/coerce (.-kind a) v))
          (recur (unchecked-inc-int i))))
      Rt/UNIT))

  (method ^:public ^:static caml_ba_blit [s d]
    (let [src (BigArray/of s) dst (BigArray/of d)]
      (when (or (not (== (.-kind src) (.-kind dst))) (not (== (.-layout src) (.-layout dst)))
                (not (== (alength (.-dims src)) (alength (.-dims dst)))))
        (throw (Rt/invalidArg "Bigarray.blit: dimension mismatch")))
      (loop [^int i 0]
        (when (< i (alength (.-dims src)))
          (when (not (== (aget (.-dims src) i) (aget (.-dims dst) i)))
            (throw (Rt/invalidArg "Bigarray.blit: dimension mismatch")))
          (recur (unchecked-inc-int i))))
      (let [n (.size src)]
        (System/arraycopy (.-data src) (.-off src) (.-data dst) (.-off dst) n)
        (when (>= (.-kind src) 10)
          (when (<= (.-kind src) 11)
            (loop [^int i 0]
              (when (< i n)
                (let [at (unchecked-add-int (.-off dst) i)]
                  (aset (.-data dst) at (.clone (cast double/1 (aget (.-data dst) at)))))
                (recur (unchecked-inc-int i)))))))
      Rt/UNIT))

  ;; caml_ba_sub: the C layout reduces the first dimension, the Fortran one the last (its offset from 1)
  (method ^:public ^:static caml_ba_sub [b o n]
    (let [a (BigArray/of b) nd (alength (.-dims a)) len (Rt/l n)]
      (when (== nd 0) (throw (Rt/invalidArg "Bigarray.sub: bad sub-array")))
      (let [fortran (not (== (.-layout a) 0))
            ch (if fortran (unchecked-dec-int nd) 0)
            ofs (if fortran (unchecked-dec (Rt/l o)) (Rt/l o))
            stride (if fortran (BigArray/product (Arrays/copyOfRange (.-dims a) 0 ch) 0) (BigArray/product (.-dims a) 1))
            dims (.clone (.-dims a))]
        (when (or (< ofs 0) (< len 0) (> (unchecked-add ofs len) (long (aget (.-dims a) ch))))
          (throw (Rt/invalidArg "Bigarray.sub: bad sub-array")))
        (aset dims ch (unchecked-int len))
        (ExtBigarray/wrap a dims (unchecked-add-int (.-off a) (unchecked-multiply-int (unchecked-int ofs) stride))))))

  ;; caml_ba_slice: the C layout fixes the first indices, the Fortran one the last (the others at their first position), the
  ;; offset caml_ba_offset's
  (method ^:public ^:static caml_ba_slice [b ix]
    (let [a (BigArray/of b) idx (ExtBigarray/idx ix) nd (alength (.-dims a)) k (alength idx)]
      (when (> k nd)
        (throw (Rt/invalidArg "Bigarray.slice: too many indices")))
      (let [full (new Object/1 nd) fortran (not (== (.-layout a) 0))]
        (loop [^int i 0]
          (when (< i nd)
            (aset full i (if fortran
                           (if (>= i (unchecked-subtract-int nd k)) (aget idx (unchecked-subtract-int i (unchecked-subtract-int nd k))) (Long/valueOf 1))
                           (if (< i k) (aget idx i) (Long/valueOf 0))))
            (recur (unchecked-inc-int i))))
        (let [off (.offset a full)
              rest (if fortran (Arrays/copyOfRange (.-dims a) 0 (unchecked-subtract-int nd k)) (Arrays/copyOfRange (.-dims a) k nd))]
          (BigArray/custom (BigArray. (.-kind a) (.-layout a) rest (.-data a) off))))))

  ;; caml_ba_reshape's checks: the number of dimensions, negative ones, an overflow of the product (a mismatch)
  (method ^:public ^:static caml_ba_reshape [b ds]
    (let [a (BigArray/of b) dims (ExtBigarray/dimsOf ds)]
      (when (> (alength dims) 16) (throw (Rt/invalidArg "Bigarray.reshape: bad number of dimensions")))
      (loop [^int i 0]
        (when (< i (alength dims))
          (when (< (aget dims i) 0) (throw (Rt/invalidArg "Bigarray.reshape: negative dimension")))
          (recur (unchecked-inc-int i))))
      (when (not (== (BaOps/elements dims) (long (.size a))))
        (throw (Rt/invalidArg "Bigarray.reshape: size mismatch")))
      (ExtBigarray/wrap a dims (.-off a))))

  (method ^:public ^:static caml_ba_change_layout [b l]
    (let [a (BigArray/of b) n (alength (.-dims a)) dims (new int/1 n)]
      (loop [^int i 0]
        (when (< i n) (aset dims i (aget (.-dims a) (unchecked-subtract-int (unchecked-dec-int n) i))) (recur (unchecked-inc-int i))))
      (BigArray/custom (BigArray. (.-kind a) (Rt/ii l) dims (.-data a) (.-off a)))))

  ;; the bigstring accesses: little-endian loads and stores of 2, 4 and 8 bytes in a char bigarray
  (method ^:static bsGet [b i ^int width]
    (let [a (BigArray/of b) k (Rt/l i)]
      (when (or (< k 0) (> (unchecked-add k width) (long (.size a)))) (throw (Rt/boundError)))
      (let [^:mutable ^long x 0 at (unchecked-add-int (.-off a) (unchecked-int k))]
        (loop [^int j (unchecked-dec-int width)]
          (when (>= j 0)
            (set! x (bit-or (bit-shift-left x 8) (bit-and (Rt/l (aget (.-data a) (unchecked-add-int at j))) 255)))
            (recur (unchecked-dec-int j))))
        (switch width
          2 (Long/valueOf x)
          4 (Integer/valueOf (unchecked-int x))
          (I64. x)))))
  (method ^:static bsSet [b i v ^int width]
    (let [a (BigArray/of b) k (Rt/l i)
          x (if (instance? Long v) (Rt/l v) (Rt/bv v))]
      (when (or (< k 0) (> (unchecked-add k width) (long (.size a)))) (throw (Rt/boundError)))
      (let [at (unchecked-add-int (.-off a) (unchecked-int k))]
        (loop [^int j 0]
          (when (< j width)
            (aset (.-data a) (unchecked-add-int at j) (Long/valueOf (bit-and (bit-shift-right x (unchecked-multiply-int 8 j)) 255)))
            (recur (unchecked-inc-int j)))))
      Rt/UNIT))
  (method ^:public ^:static caml_ba_uint8_get16 [b i] (ExtBigarray/bsGet b i 2))
  (method ^:public ^:static caml_ba_uint8_get32 [b i] (ExtBigarray/bsGet b i 4))
  (method ^:public ^:static caml_ba_uint8_get64 [b i] (ExtBigarray/bsGet b i 8))
  (method ^:public ^:static caml_ba_uint8_set16 [b i v] (ExtBigarray/bsSet b i v 2))
  (method ^:public ^:static caml_ba_uint8_set32 [b i v] (ExtBigarray/bsSet b i v 4))
  (method ^:public ^:static caml_ba_uint8_set64 [b i v] (ExtBigarray/bsSet b i v 8)))

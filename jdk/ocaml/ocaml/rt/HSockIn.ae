;; A socket of the OS read through the compiled level's host (HostSys; OC216 (a), the rest): Fd's sin and sclose for a socket Sock
;; made there (an AF_UNIX one), so that Unix.read, a channel and Unix.close reach it as they reach a java.net socket's stream.
;; Called without the Gil (Fd's sockRead); an error of the OS is Unix_error (errno, "read", "") as the C stub's.

(in-ns 'ocaml.rt)

(import '(java.io InputStream))

(defclass ^:public ^:final HSockIn
  :extends InputStream

  (field ^:public ^long os)
  (field ^:public ^boolean closed)

  (constructor ^:public [this ^long os]
    (super.)
    (set! (.-os this) os))

  (method ^:public read ^int [this ^byte/1 b ^int off ^int len]
    (let [r (HostSys/call "read" (new Object/1 ["read" (Long/valueOf os) (Long/valueOf (long len))]))
          d (cast byte/1 (.get r 0))]
      (System/arraycopy d 0 b off (alength d))
      ;; 0 bytes: the end (a stream's peer closed it), -1 as InputStream says
      (if (== (alength d) 0) (int -1) (int (alength d)))))

  (method ^:public read ^int [this]
    (let [b (new byte/1 1)
          n (.read this b 0 1)]
      (if (< n 1) (int -1) (unchecked-int (bit-and (aget b 0) 255)))))

  (method ^:public close ^void [this]
    (when (not closed)
      (set! (.-closed this) true)
      (HostSys/call "close" (new Object/1 ["close" (Long/valueOf os)])))))

;; Digests (runtime/md5.c, blake2.c). Ported from oi's ext_digest.go. The BLAKE2b context is the
;; class Blake2 (a Custom "_blake2"). Random's LXM generator is ExtLxm's.

(in-ns 'ocaml.rt)

(defclass ^:public ^:final ExtDigest

  (method ^:public ^:static caml_md5_string [s o n]
    (ExtIo/chk s o n)
    (let [md (Md5.)]
      (.update md (cast byte/1 s) (Rt/ii o) (Rt/ii n))
      (.digest md)))
  (method ^:public ^:static caml_md5_bytes [s o n] (ExtDigest/caml_md5_string s o n))
  (method ^:public ^:static caml_md5_chan [ch toread]
    (let [c (ExtIo/chan ch) md (Md5.) buf (new byte/1 4096)
          ^:mutable ^long left (Rt/l toread)]
      (if (< left 0)
        (loop []
          (let [n (.getblock c buf 0 4096)]
            (when (> n 0) (.update md buf 0 n) (recur))))
        (while (> left 0)
          (let [want (if (< left 4096) (unchecked-int left) 4096)
                n (.getblock c buf 0 want)]
            (when (== n 0) (throw (Rt/endOfFile)))
            (.update md buf 0 n)
            (set! left (unchecked-subtract left n)))))
      (.digest md)))

  (method ^:public ^:static caml_blake2_create [hashlen key]
    (Custom. "_blake2" (Blake2. (Rt/ii hashlen) (cast byte/1 key))))
  (method ^:public ^:static caml_blake2_update [ctx s o n]
    (ExtIo/chk s o n)
    (.update (cast Blake2 (.-v (cast Custom ctx))) (cast byte/1 s) (Rt/ii o) (Rt/ii n))
    Rt/UNIT)
  (method ^:public ^:static caml_blake2_final [ctx hashlen]
    (.fin (cast Blake2 (.-v (cast Custom ctx))) (Rt/ii hashlen)))
  (method ^:public ^:static caml_blake2_string [hashlen key s o n]
    (ExtIo/chk s o n)
    (let [b (Blake2. (Rt/ii hashlen) (cast byte/1 key))]
      (.update b (cast byte/1 s) (Rt/ii o) (Rt/ii n))
      (.fin b (Rt/ii hashlen))))
  (method ^:public ^:static caml_blake2_bytes [hashlen key s o n] (ExtDigest/caml_blake2_string hashlen key s o n)))

;; A static exit of interpreted Lambda (Oi, queue 544; Lambda's staticraise, caught by the staticcatch of its number in the same
;; function): its number and its arguments' values. No Java stack trace; never an OCaml exception (Rt/exnValue throws it on, so
;; an interpreted trywith lets it through).

(in-ns 'ocaml.rt)

(defclass ^:public ^:final OiExit
  :extends RuntimeException

  (field ^:public ^:final ^int n)
  (field ^:public ^:final ^Object/1 vals)

  (constructor ^:public [this ^int n ^Object/1 vals]
    (super. nil nil false false)
    (set! (.-n this) n)
    (set! (.-vals this) vals)))

;; A tail call of interpreted Lambda (Oi, queue 544): an application in a function's tail position whose function is interpreted with
;; that many parameters returns it in place of calling, and Oi/call runs it in the same Java frame (the loop of a recursive function in
;; constant stack, as ocamlc's APPTERM). Never an OCaml value: only Oi/ev's tail applications make one and only Oi/call takes it.

(in-ns 'ocaml.rt)

(defclass ^:public ^:final OiTail
  (field ^:public ^:final ^OiFn f)
  (field ^:public ^:final ^Object/1 args)

  (constructor ^:public [this ^OiFn f ^Object/1 args]
    (set! (.-f this) f)
    (set! (.-args this) args)))

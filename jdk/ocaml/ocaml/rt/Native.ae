;; A function the runtime makes (Rt/native): its arity and its Code.

(in-ns 'ocaml.rt)

(defclass ^:public ^:final Native
  :extends Closure

  (field ^:public ^Code code)

  (constructor ^:public [this ^int arity ^Code code]
    (super. arity)
    (set! (.-code this) code))

  (method ^:public a1 [this a] (.call code (new Object/1 [a])))
  (method ^:public a2 [this a b] (.call code (new Object/1 [a b])))
  (method ^:public a3 [this a b c] (.call code (new Object/1 [a b c])))
  (method ^:public a4 [this a b c d] (.call code (new Object/1 [a b c d])))
  (method ^:public a5 [this a b c d e] (.call code (new Object/1 [a b c d e])))
  (method ^:public a6 [this a b c d e f] (.call code (new Object/1 [a b c d e f])))
  (method ^:public an [this ^Object/1 x] (.call code x)))

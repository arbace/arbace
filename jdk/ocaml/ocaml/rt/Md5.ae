;; MD5 (RFC 1321), the digest of Digest and Random's seeds (caml_md5_string, caml_md5_chan), as the runtime's own: the
;; JDK's MessageDigest asks java.security's configuration, a file the compiled level's programs do not embed (OT9's first
;; fix). The calls MessageDigest's: update, digest.

(in-ns 'ocaml.rt)

(defclass ^:public ^:final Md5
  (field ^:static ^:final ^int/1 K (new int/1 [-680876936 -389564586 606105819 -1044525330 -176418897 1200080426 -1473231341 -45705983 1770035416 -1958414417 -42063 -1990404162 1804603682 -40341101 -1502002290 1236535329 -165796510 -1069501632 643717713 -373897302 -701558691 38016083 -660478335 -405537848 568446438 -1019803690 -187363961 1163531501 -1444681467 -51403784 1735328473 -1926607734 -378558 -2022574463 1839030562 -35309556 -1530992060 1272893353 -155497632 -1094730640 681279174 -358537222 -722521979 76029189 -640364487 -421815835 530742520 -995338651 -198630844 1126891415 -1416354905 -57434055 1700485571 -1894986606 -1051523 -2054922799 1873313359 -30611744 -1560198380 1309151649 -145523070 -1120210379 718787259 -343485551]))
  (field ^:static ^:final ^int/1 S (new int/1 [7 12 17 22 7 12 17 22 7 12 17 22 7 12 17 22 5 9 14 20 5 9 14 20 5 9 14 20 5 9 14 20 4 11 16 23 4 11 16 23 4 11 16 23 4 11 16 23 6 10 15 21 6 10 15 21 6 10 15 21 6 10 15 21]))
  (field ^int/1 h)
  (field ^:final ^byte/1 block (new byte/1 64))
  (field ^int fill 0)
  (field ^long total 0)

  (constructor ^:public [this]
    (set! (.-h this) (new int/1 [(unchecked-int 0x67452301) (unchecked-int 0xefcdab89) (unchecked-int 0x98badcfe) (unchecked-int 0x10325476)])))

  (method ^:static word ^int [^byte/1 b ^int i]
    (bit-or-int (bit-and-int (aget b i) 255)
                (bit-or-int (bit-shift-left-int (bit-and-int (aget b (unchecked-add-int i 1)) 255) 8)
                            (bit-or-int (bit-shift-left-int (bit-and-int (aget b (unchecked-add-int i 2)) 255) 16)
                                        (bit-shift-left-int (bit-and-int (aget b (unchecked-add-int i 3)) 255) 24)))))

  (method compress ^void [this ^byte/1 b]
    (let [^:mutable ^int a (aget h 0) ^:mutable ^int bb (aget h 1) ^:mutable ^int c (aget h 2) ^:mutable ^int d (aget h 3)]
      (loop [^int i 0]
        (when (< i 64)
          (let [^int f (cond (< i 16) (bit-or-int (bit-and-int bb c) (bit-and-int (bit-not-int bb) d))
                             (< i 32) (bit-or-int (bit-and-int d bb) (bit-and-int (bit-not-int d) c))
                             (< i 48) (bit-xor-int bb (bit-xor-int c d))
                             :else (bit-xor-int c (bit-or-int bb (bit-not-int d))))
                ^int g (cond (< i 16) i
                             (< i 32) (bit-and-int (unchecked-add-int (unchecked-multiply-int 5 i) 1) 15)
                             (< i 48) (bit-and-int (unchecked-add-int (unchecked-multiply-int 3 i) 5) 15)
                             :else (bit-and-int (unchecked-multiply-int 7 i) 15))
                ^int x (unchecked-add-int (unchecked-add-int a f) (unchecked-add-int (aget K i) (Md5/word b (unchecked-multiply-int g 4))))
                ^int s (aget S i)
                ^int r (bit-or-int (bit-shift-left-int x s) (unsigned-bit-shift-right-int x (unchecked-subtract-int 32 s)))]
            (set! a d) (set! d c) (set! c bb)
            (set! bb (unchecked-add-int bb r)))
          (recur (unchecked-inc-int i))))
      (aset h 0 (unchecked-add-int (aget h 0) a))
      (aset h 1 (unchecked-add-int (aget h 1) bb))
      (aset h 2 (unchecked-add-int (aget h 2) c))
      (aset h 3 (unchecked-add-int (aget h 3) d))))

  (method ^:public update ^void [this ^byte/1 b ^int off ^int len]
    (set! total (unchecked-add total (long len)))
    (loop [^int i 0]
      (when (< i len)
        (aset block fill (aget b (unchecked-add-int off i)))
        (set! fill (unchecked-inc-int fill))
        (when (== fill 64) (.compress this block) (set! fill 0))
        (recur (unchecked-inc-int i)))))

  (method ^:public digest ^byte/1 [this]
    (let [bits (unchecked-multiply total 8)
          pad (new byte/1 72)]
      (aset pad 0 (unchecked-byte 128))
      (let [n (if (< fill 56) (unchecked-subtract-int 56 fill) (unchecked-subtract-int 120 fill))]
        (.update this pad 0 n))
      (loop [^int i 0]
        (when (< i 8)
          (aset pad i (unchecked-byte (bit-and (bit-shift-right bits (unchecked-multiply-int 8 i)) 255)))
          (recur (unchecked-inc-int i))))
      (.update this pad 0 8)
      (let [out (new byte/1 16)]
        (loop [^int i 0]
          (when (< i 16)
            (aset out i (unchecked-byte (bit-and-int (bit-shift-right-int (aget h (bit-shift-right-int i 2)) (unchecked-multiply-int 8 (bit-and-int i 3))) 255)))
            (recur (unchecked-inc-int i))))
        out))))

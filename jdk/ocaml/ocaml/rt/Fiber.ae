;; An effect's stack (oi's Fiber, thread.go; OC6 (a)): a Java thread that runs the handled
;; computation, its handlers (value, exception, effect), the queue its resumptions arrive on and
;; the queue it answers on (the current resumer's). Messages are Object/1: [kind v k], kind 0 done,
;; 1 exception, 2 effect, 3 a Java throwable.

(in-ns 'ocaml.rt)

(import '(java.util.concurrent SynchronousQueue))

(defclass ^:public Fiber
  (field ^:public hval)
  (field ^:public hexn)
  (field ^:public heff)
  (field ^:public ^SynchronousQueue resumeQ)
  (field ^:public ^SynchronousQueue reply)
  (field ^:public ^boolean started)

  (constructor ^:public [this hval hexn heff]
    (set! (.-hval this) hval)
    (set! (.-hexn this) hexn)
    (set! (.-heff this) heff)
    (set! (.-resumeQ this) (SynchronousQueue.))))

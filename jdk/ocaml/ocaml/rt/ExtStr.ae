;; The externals for strings and bytes (runtime/str.c), ported from oi's ext_str.go: lengths,
;; creation, reads and writes (also the 16, 32 and 64 bits little-endian ones), comparisons,
;; blit, fill and the identities. A string and a bytes are one type, byte/1.

(in-ns 'ocaml.rt)

(import '(java.util Arrays))

(defclass ^:public ^:final ExtStr

  ;; the sign of the unsigned lexicographic comparison of two byte arrays
  (method ^:static cmp ^long [a b]
    (let [x (cast byte/1 a) y (cast byte/1 b)
          nx (alength x) ny (alength y)
          n (if (< nx ny) nx ny)]
      (loop [^int i 0]
        (if (< i n)
          (let [p (bit-and (long (aget x i)) 255) q (bit-and (long (aget y i)) 255)]
            (cond (< p q) -1
                  (> p q) 1
                  :else (recur (unchecked-inc-int i))))
          (cond (< nx ny) -1
                (> nx ny) 1
                :else 0)))))

  (method ^:static eqv ^boolean [a b] (Arrays/equals (cast byte/1 a) (cast byte/1 b)))

  (method ^:static create [n ^String msg]
    (let [k (Rt/l n)]
      (when (or (< k 0) (> k 144115188075855863))
        (throw (Rt/invalidArg msg)))
      (new byte/1 (unchecked-int k))))

  (method ^:public ^:static caml_ml_string_length [s] (Rt/slen s))
  (method ^:public ^:static caml_ml_bytes_length [s] (Rt/slen s))
  (method ^:public ^:static caml_create_string [n] (ExtStr/create n "String.create"))
  (method ^:public ^:static caml_create_bytes [n] (ExtStr/create n "Bytes.create"))

  (method ^:public ^:static caml_string_get [s i] (Rt/sgetChecked s i))
  (method ^:public ^:static caml_bytes_get [s i] (Rt/sgetChecked s i))
  (method ^:public ^:static caml_bytes_set [s i c] (Rt/ssetChecked s i c))
  (method ^:public ^:static caml_string_set [s i c] (Rt/ssetChecked s i c))

  (method ^:public ^:static caml_string_get16 [s i] (Rt/sload s i 2))
  (method ^:public ^:static caml_bytes_get16 [s i] (Rt/sload s i 2))
  (method ^:public ^:static caml_string_get32 [s i] (Rt/sload s i 4))
  (method ^:public ^:static caml_bytes_get32 [s i] (Rt/sload s i 4))
  (method ^:public ^:static caml_string_get64 [s i] (Rt/sload s i 8))
  (method ^:public ^:static caml_bytes_get64 [s i] (Rt/sload s i 8))
  (method ^:public ^:static caml_bytes_set16 [s i v] (Rt/sstore s i v 2))
  (method ^:public ^:static caml_bytes_set32 [s i v] (Rt/sstore s i v 4))
  (method ^:public ^:static caml_bytes_set64 [s i v] (Rt/sstore s i v 8))

  (method ^:public ^:static caml_string_equal [a b] (Rt/b (ExtStr/eqv a b)))
  (method ^:public ^:static caml_bytes_equal [a b] (Rt/b (ExtStr/eqv a b)))
  (method ^:public ^:static caml_string_notequal [a b] (Rt/b (not (ExtStr/eqv a b))))
  (method ^:public ^:static caml_bytes_notequal [a b] (Rt/b (not (ExtStr/eqv a b))))
  (method ^:public ^:static caml_string_compare [a b] (Long/valueOf (ExtStr/cmp a b)))
  (method ^:public ^:static caml_bytes_compare [a b] (Long/valueOf (ExtStr/cmp a b)))
  (method ^:public ^:static caml_string_lessthan [a b] (Rt/b (< (ExtStr/cmp a b) 0)))
  (method ^:public ^:static caml_bytes_lessthan [a b] (Rt/b (< (ExtStr/cmp a b) 0)))
  (method ^:public ^:static caml_string_lessequal [a b] (Rt/b (<= (ExtStr/cmp a b) 0)))
  (method ^:public ^:static caml_bytes_lessequal [a b] (Rt/b (<= (ExtStr/cmp a b) 0)))
  (method ^:public ^:static caml_string_greaterthan [a b] (Rt/b (> (ExtStr/cmp a b) 0)))
  (method ^:public ^:static caml_bytes_greaterthan [a b] (Rt/b (> (ExtStr/cmp a b) 0)))
  (method ^:public ^:static caml_string_greaterequal [a b] (Rt/b (>= (ExtStr/cmp a b) 0)))
  (method ^:public ^:static caml_bytes_greaterequal [a b] (Rt/b (>= (ExtStr/cmp a b) 0)))

  (method ^:static blit [a o1 b o2 n]
    (let [s1 (cast byte/1 a) s2 (cast byte/1 b)
          p (Rt/l o1) q (Rt/l o2) k (Rt/l n)]
      (when (or (< k 0) (< p 0) (< q 0) (> (unchecked-add p k) (alength s1)) (> (unchecked-add q k) (alength s2)))
        (throw (Rt/boundError)))
      (System/arraycopy s1 (unchecked-int p) s2 (unchecked-int q) (unchecked-int k))
      Rt/UNIT))
  (method ^:public ^:static caml_blit_bytes [a o1 b o2 n] (ExtStr/blit a o1 b o2 n))
  (method ^:public ^:static caml_blit_string [a o1 b o2 n] (ExtStr/blit a o1 b o2 n))

  (method ^:static fill [a off n c]
    (let [s (cast byte/1 a) o (Rt/l off) k (Rt/l n)]
      (when (or (< k 0) (< o 0) (> (unchecked-add o k) (alength s)))
        (throw (Rt/boundError)))
      (Arrays/fill s (unchecked-int o) (unchecked-int (unchecked-add o k)) (unchecked-byte (Rt/l c)))
      Rt/UNIT))
  (method ^:public ^:static caml_fill_bytes [a o n c] (ExtStr/fill a o n c))
  (method ^:public ^:static caml_fill_string [a o n c] (ExtStr/fill a o n c))

  (method ^:public ^:static caml_string_of_bytes [b] b)
  (method ^:public ^:static caml_bytes_of_string [s] s))

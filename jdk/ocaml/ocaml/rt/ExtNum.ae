;; The externals for numbers (runtime/ints.c, runtime/floats.c), ported from oi's ext_num.go:
;; C's printf of integers and floats (caml_format_int, caml_format_float, caml_hexstring_of_float,
;; the int32, int64 and nativeint formats), the parsers (caml_int_of_string, caml_float_of_string
;; with C's strtod and hexadecimal floats), the float functions, and the int32, int64 and
;; nativeint arithmetic. Decimal conversions are exact (java.math.BigDecimal), as glibc's are.
;; A conversion specification is a long/1: 0 minus, 1 plus, 2 space, 3 alt, 4 zero, 5 width,
;; 6 precision (-1 none), 7 conversion letter, 8 index after it.

(in-ns 'ocaml.rt)

(import '(java.math BigDecimal MathContext RoundingMode))

(defclass ^:public ^:final ExtNum

  ;; ------------------------------------------------------------ formatting

  (method ^:static parseSpec ^long/1 [^String s ^int i0]
    (let [sp (new long/1 9) n (.length s)
          ^:mutable ^int i i0
          ^:mutable ^boolean go true]
      (aset sp 6 -1)
      (while (and go (< i n))
        (let [c (.charAt s i)]
          (cond (== c \-) (do (aset sp 0 1) (set! i (unchecked-inc-int i)))
                (== c \+) (do (aset sp 1 1) (set! i (unchecked-inc-int i)))
                (== c \space) (do (aset sp 2 1) (set! i (unchecked-inc-int i)))
                (== c \#) (do (aset sp 3 1) (set! i (unchecked-inc-int i)))
                (== c \0) (do (aset sp 4 1) (set! i (unchecked-inc-int i)))
                :else (set! go false))))
      (while (and (< i n) (>= (.charAt s i) \0) (<= (.charAt s i) \9))
        (aset sp 5 (unchecked-add (unchecked-multiply (aget sp 5) 10) (long (unchecked-subtract-int (.charAt s i) 48))))
        (set! i (unchecked-inc-int i)))
      (when (and (< i n) (== (.charAt s i) \.))
        (set! i (unchecked-inc-int i))
        (aset sp 6 0)
        (while (and (< i n) (>= (.charAt s i) \0) (<= (.charAt s i) \9))
          (aset sp 6 (unchecked-add (unchecked-multiply (aget sp 6) 10) (long (unchecked-subtract-int (.charAt s i) 48))))
          (set! i (unchecked-inc-int i))))
      (while (and (< i n) (>= (.indexOf "lnLhqjzt" (.charAt s i)) 0))
        (set! i (unchecked-inc-int i)))
      (when (< i n)
        (aset sp 7 (long (.charAt s i)))
        (set! i (unchecked-inc-int i)))
      (aset sp 8 (long i))
      sp))

  ;; the width: sign or prefix, then the digits, zero padded when asked
  (method ^:static pad ^String [^long/1 sp ^String prefix ^String body ^boolean zeroOK]
    (let [n (unchecked-add (long (.length prefix)) (long (.length body)))
          w (aget sp 5)]
      (if (>= n w)
        (.concat prefix body)
        (let [k (unchecked-int (unchecked-subtract w n))]
          (cond (== (aget sp 0) 1) (java-str prefix body (.repeat " " k))
                (and (== (aget sp 4) 1) zeroOK) (java-str prefix (.repeat "0" k) body)
                :else (java-str (.repeat " " k) prefix body))))))

  ;; C's printf of an integer conversion (d i u x X o c) of the value neg/mag (mag unsigned)
  (method ^:static formatCInt ^String [^long/1 sp ^boolean neg ^long mag]
    (let [conv (unchecked-int (aget sp 7))]
      (if (== conv 99)
        (ExtNum/pad sp "" (String/valueOf (unchecked-char (bit-and mag 255))) false)
        (let [^:mutable ^String body ""
              ^:mutable ^String prefix ""]
          (switch conv
            (100 105) (do (set! body (Long/toUnsignedString mag 10))
                          (set! prefix (cond neg "-"
                                             (== (aget sp 1) 1) "+"
                                             (== (aget sp 2) 1) " "
                                             :else ""))
                          nil)
            117 (do (set! body (Long/toUnsignedString mag 10)) nil)
            120 (do (set! body (Long/toHexString mag)) nil)
            88 (do (set! body (.toUpperCase (Long/toHexString mag))) nil)
            111 (do (set! body (Long/toOctalString mag)) nil)
            (throw (Rt/failwith "format_int: bad format")))
          (when (and (== (aget sp 6) 0) (== mag 0))
            (set! body ""))
          (when (> (aget sp 6) (long (.length body)))
            (set! body (.concat (.repeat "0" (unchecked-int (unchecked-subtract (aget sp 6) (long (.length body))))) body)))
          (when (== (aget sp 3) 1)
            (switch conv
              120 (do (when (not (== mag 0)) (set! prefix "0x")) nil)
              88 (do (when (not (== mag 0)) (set! prefix "0X")) nil)
              111 (do (when (not (.startsWith body "0")) (set! body (.concat "0" body))) nil)
              nil))
          (ExtNum/pad sp prefix body (< (aget sp 6) 0))))))

  ;; caml_alloc_sprintf(format, arg) for the integer formats of ints.c: signed is the value as a
  ;; signed integer, nbits its width (the unsigned conversions see that many bits; 63 for int)
  (method ^:static formatInteger [^String format ^long signed ^int nbits]
    (let [sb (StringBuilder.) n (.length format)
          ^:mutable ^int i 0]
      (while (< i n)
        (let [c (.charAt format i)]
          (cond (not (== c \%)) (do (.append sb c) (set! i (unchecked-inc-int i)))
                (and (< (unchecked-inc-int i) n) (== (.charAt format (unchecked-inc-int i)) \%))
                (do (.append sb \%) (set! i (unchecked-add-int i 2)))
                :else
                (let [sp (ExtNum/parseSpec format (unchecked-inc-int i))
                      conv (unchecked-int (aget sp 7))]
                  (set! i (unchecked-int (aget sp 8)))
                  (if (or (== conv 117) (== conv 120) (== conv 88) (== conv 111))
                    (.append sb (ExtNum/formatCInt sp false
                                  (if (< nbits 64)
                                    (bit-and signed (unchecked-dec (bit-shift-left 1 (long nbits))))
                                    signed)))
                    (if (< signed 0)
                      (.append sb (ExtNum/formatCInt sp true (unchecked-negate signed)))
                      (.append sb (ExtNum/formatCInt sp false signed))))))))
      (Rt/s (.toString sb))))

  ;; %f of a non-negative finite number: the exact value rounded half to even
  (method ^:static fixed ^String [^double abs ^int prec]
    (.toPlainString (.setScale (BigDecimal. abs) prec RoundingMode/HALF_EVEN)))

  ;; %e of a non-negative finite number
  (method ^:static expo ^String [^double abs ^int prec ^boolean alt]
    (let [^:mutable ^String digs ""
          ^:mutable ^long ex 0]
      (if (== abs 0.0)
        (set! digs (.repeat "0" (unchecked-inc-int prec)))
        (let [bd (.round (BigDecimal. abs) (MathContext. (unchecked-inc-int prec) RoundingMode/HALF_EVEN))
              u (.toString (.unscaledValue bd))
              p (.length u)]
          (set! ex (unchecked-subtract (unchecked-subtract (long p) 1) (long (.scale bd))))
          (set! digs (if (< p (unchecked-inc-int prec))
                       (.concat u (.repeat "0" (unchecked-subtract-int (unchecked-inc-int prec) p)))
                       u))))
      (let [sb (StringBuilder.)]
        (.append sb (.substring digs 0 1))
        (when (or (> prec 0) alt) (.append sb "."))
        (when (> prec 0) (.append sb (.substring digs 1)))
        (.append sb "e")
        (.append sb (if (< ex 0) "-" "+"))
        (let [ae (Math/abs ex)]
          (when (< ae 10) (.append sb "0"))
          (.append sb ae))
        (.toString sb))))

  ;; trailing zeros of a fraction, and a bare point, removed
  (method ^:static stripZeros ^String [^String s]
    (if (>= (.indexOf s ".") 0)
      (let [^:mutable ^int n (.length s)]
        (while (and (> n 0) (== (.charAt s (unchecked-dec-int n)) \0))
          (set! n (unchecked-dec-int n)))
        (when (and (> n 0) (== (.charAt s (unchecked-dec-int n)) \.))
          (set! n (unchecked-dec-int n)))
        (.substring s 0 n))
      s))

  ;; glibc's %a of a non-negative finite number (prec -1: none)
  (method ^:static cHex ^String [^double abs ^int prec ^boolean alt]
    (let [b (Double/doubleToRawLongBits abs)
          ^:mutable ^long ex (bit-and (unsigned-bit-shift-right b 52) 2047)
          ^:mutable ^long m (bit-and b 4503599627370495)]
      (if (== ex 0)
        (when (not (== m 0)) (set! ex -1022))
        (do (set! ex (unchecked-subtract ex 1023))
            (set! m (bit-or m 4503599627370496))))
      (when (and (>= prec 0) (< prec 13))
        (let [i (unchecked-subtract 52 (unchecked-multiply (long prec) 4))
              unit (bit-shift-left 1 i)
              half (unsigned-bit-shift-right unit 1)
              frac (bit-and m (unchecked-dec unit))]
          (set! m (bit-and m (bit-not (unchecked-dec unit))))
          (when (or (> frac half) (and (== frac half) (not (== (bit-and m unit) 0))))
            (set! m (unchecked-add m unit)))))
      (let [sb (StringBuilder.)
            ^:mutable ^int n prec]
        (.append sb "0x")
        (.append sb (unchecked-char (unchecked-add 48 (unsigned-bit-shift-right m 52))))
        (set! m (bit-and (bit-shift-left m 4) 72057594037927935))
        (when (or (> n 0) (and (< n 0) (not (== m 0))) alt)
          (.append sb "."))
        (while (or (> n 0) (and (< n 0) (not (== m 0))))
          (.append sb (.charAt "0123456789abcdef" (unchecked-int (unsigned-bit-shift-right m 52))))
          (set! m (bit-and (bit-shift-left m 4) 72057594037927935))
          (set! n (unchecked-dec-int n)))
        (.append sb "p")
        (when (>= ex 0) (.append sb "+"))
        (.append sb ex)
        (.toString sb))))

  ;; C's printf of one floating conversion (f F e E g G a A) of d
  (method ^:static formatCFloat ^String [^long/1 sp ^double d]
    (let [neg (< (Double/doubleToRawLongBits d) 0)
          abs (Math/abs d)
          prefix (cond neg "-" (== (aget sp 1) 1) "+" (== (aget sp 2) 1) " " :else "")
          conv (unchecked-int (aget sp 7))
          upper (or (== conv 70) (== conv 69) (== conv 71) (== conv 65))]
      (if (or (Double/isInfinite d) (Double/isNaN d))
        (let [body (if (Double/isNaN d) "nan" "inf")]
          (ExtNum/pad sp prefix (if upper (.toUpperCase body) body) false))
        (let [prec0 (unchecked-int (aget sp 6))
              alt (== (aget sp 3) 1)
              ^:mutable ^String body ""]
          (cond
            (or (== conv 102) (== conv 70))
            (let [prec (if (< prec0 0) 6 prec0)]
              (set! body (ExtNum/fixed abs prec))
              (when (and (== prec 0) alt) (set! body (.concat body "."))))
            (or (== conv 101) (== conv 69))
            (set! body (ExtNum/expo abs (if (< prec0 0) 6 prec0) alt))
            (or (== conv 103) (== conv 71))
            (let [prec1 (if (< prec0 0) 6 prec0)
                  prec (if (== prec1 0) 1 prec1)
                  e (ExtNum/expo abs (unchecked-dec-int prec) false)
                  x (Integer/parseInt (.substring e (unchecked-inc-int (.indexOf e "e"))))]
              (if (or (< x -4) (>= x prec))
                (do (set! body (ExtNum/expo abs (unchecked-dec-int prec) alt))
                    (when (not alt)
                      (let [k (.indexOf body "e")]
                        (set! body (.concat (ExtNum/stripZeros (.substring body 0 k)) (.substring body k))))))
                (do (set! body (ExtNum/fixed abs (unchecked-subtract-int (unchecked-dec-int prec) x)))
                    (if alt
                      (when (< (.indexOf body ".") 0) (set! body (.concat body ".")))
                      (set! body (ExtNum/stripZeros body))))))
            (or (== conv 97) (== conv 65))
            (set! body (ExtNum/cHex abs prec0 alt))
            :else (throw (Rt/failwith "format_float: bad format")))
          (ExtNum/pad sp prefix (if upper (.toUpperCase body) body) true)))))

  (method ^:static formatFloatC [^String format ^double d]
    (let [sb (StringBuilder.) n (.length format)
          ^:mutable ^int i 0]
      (while (< i n)
        (let [c (.charAt format i)]
          (cond (not (== c \%)) (do (.append sb c) (set! i (unchecked-inc-int i)))
                (and (< (unchecked-inc-int i) n) (== (.charAt format (unchecked-inc-int i)) \%))
                (do (.append sb \%) (set! i (unchecked-add-int i 2)))
                :else
                (let [sp (ExtNum/parseSpec format (unchecked-inc-int i))]
                  (set! i (unchecked-int (aget sp 8)))
                  (.append sb (ExtNum/formatCFloat sp d))))))
      (Rt/s (.toString sb))))

  (method ^:public ^:static caml_format_int [fmt n] (ExtNum/formatInteger (Rt/js fmt) (Rt/l n) 63))
  (method ^:public ^:static caml_int32_format [fmt n] (ExtNum/formatInteger (Rt/js fmt) (Rt/bv n) 32))
  (method ^:public ^:static caml_int64_format [fmt n] (ExtNum/formatInteger (Rt/js fmt) (Rt/bv n) 64))
  (method ^:public ^:static caml_nativeint_format [fmt n] (ExtNum/formatInteger (Rt/js fmt) (Rt/bv n) 64))
  (method ^:public ^:static caml_format_float [fmt d] (ExtNum/formatFloatC (Rt/js fmt) (Rt/d d)))

  (method ^:public ^:static caml_hexstring_of_float [x p st]
    (let [d (Rt/d x)
          prec (unchecked-int (Rt/l p))
          style (Rt/l st)
          b (Double/doubleToRawLongBits d)
          sb (StringBuilder.)]
      (if (< b 0)
        (.append sb "-")
        (cond (== style 43) (.append sb "+")
              (== style 32) (.append sb " ")))
      (if (== (bit-and (unsigned-bit-shift-right b 52) 2047) 2047)
        (.append sb (if (== (bit-and b 4503599627370495) 0) "infinity" "nan"))
        (.append sb (ExtNum/cHex (Math/abs d) prec false)))
      (Rt/s (.toString sb))))

  ;; ------------------------------------------------------------ parsing

  (method ^:static parseDigit ^int [^int c]
    (cond (and (>= c 48) (<= c 57)) (unchecked-subtract-int c 48)
          (and (>= c 65) (<= c 70)) (unchecked-add-int (unchecked-subtract-int c 65) 10)
          (and (>= c 97) (<= c 102)) (unchecked-add-int (unchecked-subtract-int c 97) 10)
          :else (unchecked-int -1)))

  (method ^:static at ^int [^String s ^int i]
    (if (< i (.length s)) (unchecked-int (.charAt s i)) (unchecked-int 0)))

  ;; ints.c's parse_intnat
  (method ^:static parseIntnat ^long [^String s ^int nbits ^String errmsg]
    (let [len (.length s)
          ^:mutable ^int p 0
          ^:mutable ^long sign 1
          ^:mutable ^long base 10
          ^:mutable ^boolean signedness true]
      (cond (== (ExtNum/at s p) 45) (do (set! sign -1) (set! p (unchecked-inc-int p)))
            (== (ExtNum/at s p) 43) (set! p (unchecked-inc-int p)))
      (when (== (ExtNum/at s p) 48)
        (let [c (ExtNum/at s (unchecked-inc-int p))]
          (cond (or (== c 120) (== c 88)) (do (set! base 16) (set! signedness false) (set! p (unchecked-add-int p 2)))
                (or (== c 111) (== c 79)) (do (set! base 8) (set! signedness false) (set! p (unchecked-add-int p 2)))
                (or (== c 98) (== c 66)) (do (set! base 2) (set! signedness false) (set! p (unchecked-add-int p 2)))
                (or (== c 117) (== c 85)) (do (set! signedness false) (set! p (unchecked-add-int p 2))))))
      (let [threshold (Long/divideUnsigned -1 base)
            d0 (ExtNum/parseDigit (ExtNum/at s p))]
        (when (or (< d0 0) (>= (long d0) base))
          (throw (Rt/failwith errmsg)))
        (let [^:mutable ^long res (long d0)
              ^:mutable ^boolean go true]
          (set! p (unchecked-inc-int p))
          (while go
            (let [c (ExtNum/at s p)]
              (if (and (== c 95) (< p len))
                (set! p (unchecked-inc-int p))
                (let [d (ExtNum/parseDigit c)]
                  (if (or (< d 0) (>= (long d) base) (>= p len))
                    (set! go false)
                    (do (when (> (Long/compareUnsigned res threshold) 0)
                          (throw (Rt/failwith errmsg)))
                        (set! res (unchecked-add (unchecked-multiply base res) (long d)))
                        (when (< (Long/compareUnsigned res (long d)) 0)
                          (throw (Rt/failwith errmsg)))
                        (set! p (unchecked-inc-int p))))))))
          (when (not (== p len))
            (throw (Rt/failwith errmsg)))
          (if signedness
            (let [lim (bit-shift-left 1 (long (unchecked-dec-int nbits)))]
              (if (>= sign 0)
                (when (>= (Long/compareUnsigned res lim) 0) (throw (Rt/failwith errmsg)))
                (when (> (Long/compareUnsigned res lim) 0) (throw (Rt/failwith errmsg)))))
            (when (and (< nbits 64) (>= (Long/compareUnsigned res (bit-shift-left 1 (long nbits))) 0))
              (throw (Rt/failwith errmsg))))
          (if (< sign 0) (unchecked-negate res) res)))))

  (method ^:public ^:static caml_int_of_string [s]
    (Rt/wrap (ExtNum/parseIntnat (Rt/js s) 63 "int_of_string")))
  (method ^:public ^:static caml_int32_of_string [s]
    (Integer/valueOf (unchecked-int (ExtNum/parseIntnat (Rt/js s) 32 "Int32.of_string"))))
  (method ^:public ^:static caml_int64_of_string [s]
    (I64. (ExtNum/parseIntnat (Rt/js s) 64 "Int64.of_string")))
  (method ^:public ^:static caml_nativeint_of_string [s]
    (NInt. (ExtNum/parseIntnat (Rt/js s) 64 "Nativeint.of_string")))

  ;; floats.c's caml_float_of_hex over s (after "0x"); malformed: Failure "float_of_string"
  (method ^:static floatOfHex ^double [^String s]
    (let [len (.length s)
          ^:mutable ^long m 0
          ^:mutable ^int nBits 0
          ^:mutable ^int mBits 0
          ^:mutable ^int xBits 0
          ^:mutable ^int decPoint -1
          ^:mutable ^long ex 0
          ^:mutable ^int i 0]
      (while (< i len)
        (let [c (.charAt s i)]
          (set! i (unchecked-inc-int i))
          (cond
            (== c \.)
            (do (when (>= decPoint 0) (throw (Rt/failwith "float_of_string")))
                (set! decPoint nBits))
            (or (== c \p) (== c \P))
            (let [rest (.substring s i)
                  rl (.length rest)]
              (when (== rl 0) (throw (Rt/failwith "float_of_string")))
              (let [^:mutable ^int k 0]
                (while (and (< k rl) (or (== (.charAt rest k) \space)
                                         (and (>= (.charAt rest k) 9) (<= (.charAt rest k) 13))))
                  (set! k (unchecked-inc-int k)))
                (let [st k]
                  (when (and (< k rl) (or (== (.charAt rest k) \+) (== (.charAt rest k) \-)))
                    (set! k (unchecked-inc-int k)))
                  (let [ds k]
                    (while (and (< k rl) (>= (.charAt rest k) \0) (<= (.charAt rest k) \9))
                      (set! k (unchecked-inc-int k)))
                    (when (or (== k ds) (not (== k rl))) (throw (Rt/failwith "float_of_string")))
                    (let [^:mutable ^long e 0]
                      (try
                        (set! e (Long/parseLong (.substring rest st k)))
                        (catch NumberFormatException x
                          (set! e (if (== (.charAt rest st) \-) Long/MIN_VALUE Long/MAX_VALUE))))
                      (when (<= e -2147483648) (return 0.0))
                      (when (>= e 2147483647)
                        (return (if (== m 0) 0.0 Double/POSITIVE_INFINITY)))
                      (set! ex e)))))
              (set! i len))
            :else
            (let [d (ExtNum/parseDigit (unchecked-int c))]
              (when (< d 0) (throw (Rt/failwith "float_of_string")))
              (set! nBits (unchecked-add-int nBits 4))
              (when (not (and (== d 0) (== m 0)))
                (if (< mBits 60)
                  (do (set! m (unchecked-add (bit-shift-left m 4) (long d)))
                      (set! mBits (unchecked-add-int mBits 4)))
                  (do (when (not (== d 0)) (set! m (bit-or m 1)))
                      (set! xBits (unchecked-add-int xBits 4)))))))))
      (when (== nBits 0) (throw (Rt/failwith "float_of_string")))
      (let [adj (unchecked-add (long xBits) (if (>= decPoint 0) (long (unchecked-subtract-int decPoint nBits)) 0))]
        (cond (and (> adj 0) (> ex (unchecked-subtract 2147483647 adj))) (set! ex 2147483647)
              (and (< adj 0) (< ex (unchecked-subtract -2147483648 adj))) (set! ex -2147483648)
              :else (set! ex (unchecked-add ex adj)))
        (if (not (== ex 0))
          (Math/scalb (double m) (unchecked-int ex))
          (double m)))))

  (method ^:static isSpace ^boolean [^int c] (or (== c 32) (and (>= c 9) (<= c 13))))

  ;; strtod's parse of the whole of s (decimal, inf, infinity, nan, nan(chars)), leading white
  ;; space allowed; Failure "float_of_string" when strtod would stop before the end
  (method ^:static strtodAll ^double [^String s]
    (let [n (.length s)
          ^:mutable ^int i 0]
      (while (and (< i n) (ExtNum/isSpace (unchecked-int (.charAt s i))))
        (set! i (unchecked-inc-int i)))
      (let [t (.substring s i)
            neg (and (> (.length t) 0) (== (.charAt t 0) \-))
            body (if (and (> (.length t) 0) (or (== (.charAt t 0) \+) (== (.charAt t 0) \-))) (.substring t 1) t)
            low (.toLowerCase body)]
        (cond
          (or (.equals low "inf") (.equals low "infinity"))
          (if neg Double/NEGATIVE_INFINITY Double/POSITIVE_INFINITY)
          (.startsWith low "nan")
          (let [rest (.substring low 3)]
            (when (> (.length rest) 0)
              (when (or (not (== (.charAt rest 0) \()) (not (== (.charAt rest (unchecked-dec-int (.length rest))) \))))
                (throw (Rt/failwith "float_of_string")))
              (loop [^int j 1]
                (when (< j (unchecked-dec-int (.length rest)))
                  (let [c (.charAt rest j)]
                    (when (not (or (== c \_) (and (>= c \0) (<= c \9)) (and (>= c \a) (<= c \z))))
                      (throw (Rt/failwith "float_of_string"))))
                  (recur (unchecked-inc-int j)))))
            (if neg (Double/longBitsToDouble -2251799813685248) Double/NaN))
          :else
          (let [bl (.length body)
                ^:mutable ^int k 0
                ^:mutable ^int nd 0]
            (while (and (< k bl) (>= (.charAt body k) \0) (<= (.charAt body k) \9))
              (set! k (unchecked-inc-int k)) (set! nd (unchecked-inc-int nd)))
            (when (and (< k bl) (== (.charAt body k) \.))
              (set! k (unchecked-inc-int k))
              (while (and (< k bl) (>= (.charAt body k) \0) (<= (.charAt body k) \9))
                (set! k (unchecked-inc-int k)) (set! nd (unchecked-inc-int nd))))
            (when (== nd 0) (throw (Rt/failwith "float_of_string")))
            (when (and (< k bl) (or (== (.charAt body k) \e) (== (.charAt body k) \E)))
              (set! k (unchecked-inc-int k))
              (when (and (< k bl) (or (== (.charAt body k) \+) (== (.charAt body k) \-)))
                (set! k (unchecked-inc-int k)))
              (let [^:mutable ^int ed 0]
                (while (and (< k bl) (>= (.charAt body k) \0) (<= (.charAt body k) \9))
                  (set! k (unchecked-inc-int k)) (set! ed (unchecked-inc-int ed)))
                (when (== ed 0) (throw (Rt/failwith "float_of_string")))))
            (when (not (== k bl)) (throw (Rt/failwith "float_of_string")))
            (Double/parseDouble t))))))

  ;; caml_float_of_string
  (method ^:static floatOfString ^double [^String s0]
    (let [s (.replace s0 "_" "")]
      (when (== (.length s) 0) (throw (Rt/failwith "float_of_string")))
      (let [sign (if (== (.charAt s 0) \-) -1.0 1.0)
            src (if (or (== (.charAt s 0) \-) (== (.charAt s 0) \+)) (.substring s 1) s)]

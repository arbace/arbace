  ;; ------------------------------------------------------------ int64 (I64)

  (method ^:static l64 ^long [x] (.-v (cast I64 x)))
  (method ^:static bl [^long v] (I64. v))

  (method ^:public ^:static caml_int64_neg [a] (ExtNum/bl (unchecked-negate (ExtNum/l64 a))))

  (method ^:public ^:static caml_int64_div [a b]
    (let [x (ExtNum/l64 a) y (ExtNum/l64 b)]
      (when (== y 0) (throw (Rt/divByZero)))
      (ExtNum/bl (if (== y -1) (unchecked-negate x) (unchecked-divide x y)))))
  (method ^:public ^:static caml_int64_mod [a b]
    (let [x (ExtNum/l64 a) y (ExtNum/l64 b)]
      (when (== y 0) (throw (Rt/divByZero)))
      (ExtNum/bl (if (== y -1) 0 (unchecked-remainder x y)))))

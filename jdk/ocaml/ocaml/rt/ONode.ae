;; A node of interpreted Lambda (Oi, queue 544): its kind (Oi's constants), two ints, a value and its children, as Oi/compile
;; makes them for each kind (Oi's comments). A function's node is its prototype too: its arity, its frame's size, its body, the
;; slots of the enclosing frame its free variables are read from when the closure is made, the slots of its own frame they are put
;; in, and their names (a letrec's closures set the ones that name each other after they are made).

(in-ns 'ocaml.rt)

(defclass ^:public ^:final ONode
  (field ^:public ^int k)
  (field ^:public ^int i)
  (field ^:public ^int j)
  (field ^:public v)
  (field ^:public ^ONode a)
  (field ^:public ^ONode b)
  (field ^:public ^ONode c)
  (field ^:public ^ONode/1 xs)
  (field ^:public ^ONode/1 ys)
  (field ^:public ^int/1 is)
  (field ^:public ^int/1 js)
  (field ^:public ^String/1 ss)
  ;; a global's value once read (Oi's global node)
  (field ^:public w)

  (constructor ^:public [this ^int k]
    (set! (.-k this) k)))

;; An OCaml exception in flight: the exception's value (a block of tag 248, or a block of tag 0
;; whose field 0 is one). No Java stack trace: raising is OCaml's cheap control flow.

(in-ns 'ocaml.rt)

(defclass ^:public ^:final Exn
  :extends RuntimeException

  (field ^:public v)

  (constructor ^:public [this v]
    (super. nil nil false false)
    (set! (.-v this) v)))

;; A custom block the C allocated (OC215 (a), CApi): its address in ci's memory, kept for the run (oicapi's CBlock), the object of a
;; Custom of its operations' identifier.

(in-ns 'ocaml.rt)

(defclass ^:public ^:final CBlock
  (field ^:public ^long addr)
  (constructor ^:public [this ^long addr] (set! (.-addr this) addr)))

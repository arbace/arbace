;; A socket of the OS written through the compiled level's host (HostSys; OC216 (a), the rest): Fd's sout for a socket Sock made
;; there. Called without the Gil (Fd's sockWrite); an error of the OS is Unix_error (errno, "write", "") as the C stub's.

(in-ns 'ocaml.rt)

(import '(java.io OutputStream))

(defclass ^:public ^:final HSockOut
  :extends OutputStream

  (field ^:public ^long os)

  (constructor ^:public [this ^long os]
    (super.)
    (set! (.-os this) os))

  (method ^:public write ^void [this ^byte/1 b ^int off ^int len]
    (loop [^int p off]
      (when (< p (unchecked-add-int off len))
        (let [r (HostSys/call "write" (new Object/1 ["write" (Long/valueOf os)
                                                      (java.util.Arrays/copyOfRange b p (unchecked-add-int off len))]))
              n (unchecked-int (HostSys/num r 0))]
          (recur (unchecked-add-int p n))))))

  (method ^:public write ^void [this ^int x]
    (.write this (new byte/1 [(unchecked-byte x)]) 0 1)))

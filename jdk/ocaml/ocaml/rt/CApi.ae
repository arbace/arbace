;; The C API at the compiled level (OC215 (a), the user 2026-11-10; doc/ocaml/OCAML-SURVEY.md, "As built: OC215"): an external the
;; runtime does not implement is the test's C stub of that name, run by ci in the compiled program's main (test/ocaml/o2j/capi,
;; through arbace/oicapi's boundary, as oi runs a program's stubs). The runtime drives: each message is written to the file the main
;; serves (capiPath) and its reply read back; the main answers a call with its end, or with a callback or a named value the C asks for
;; ('K', 'Q'), which this class answers with its next message ('A'). The wire form and the ops are capi.ae's (test/ocaml/o2j/capi).
;; At the light level (stage 0's interpreter) no host serves capiPath: the open fails, and when OI_CAPI_SERVER and OI_CSTUBS are set
;; (bin/oi's light level, for a test with C stubs: queue 413) the runtime spawns OI_CAPI_SERVER's `capi` (the driver of
;; arbace/oi, test/ocaml/oi/cmd) and speaks to it over its standard streams, the same messages framed (a message u32 its length then it;
;; the reply chunks 'o' and 'e', the C's output since the last reply, written into the program's System/out and System/err, 's'
;; the signals the C sent the process itself, one a byte, pending in ExtSignal, then 'm' the reply), and at the program's end (Main/run's finish) 'Z', the C's stdio flushed; else the external is missing, as before.
;;
;; The session: the values that crossed in an outermost call, by id (the order both sides gave them) and back; a C custom block the
;; C allocated is one Custom by its address (held weakly since queue 523: its finalize runs once the Custom is unreachable, at an
;; asked collection, collected); Marshal writes and reads one through the C's operations (serialize, deserialize: queue 527).

(in-ns 'ocaml.rt)

(import '(java.io ByteArrayOutputStream DataInputStream File OutputStream RandomAccessFile IOException) '(java.util ArrayList HashMap IdentityHashMap) '(java.lang.ref WeakReference))

(defclass ^:public ^:final CApi

  (field ^:static ^:final ^String capiPath "/proc/self/ocaml-capi")
  ;; the channel (opened once; nil and failed when no host serves it)
  (field ^:static ^RandomAccessFile chan)
  (field ^:static ^boolean failed false)
  ;; the light level's server (OI_CAPI_SERVER's `capi`): its process, its output read and its input written
  (field ^:static ^Process proc)
  (field ^:static ^DataInputStream pin)
  (field ^:static ^OutputStream pout)
  ;; the session's nodes and their ids; the depth of calls in it
  (field ^:static ^ArrayList nodes)
  (field ^:static ^IdentityHashMap ids)
  (field ^:static ^int depth 0)
  ;; the C's custom blocks by address: a WeakReference to the block's one Custom (queue 523: held weakly, the dead ones' addresses
  ;; sent to the server at the collections the program asks for, collected, so that the C's finalize runs)
  (field ^:static ^HashMap cblocks (HashMap.))
  (field ^:static ^:final ^ArrayList cbDead (ArrayList.))
  ;; a Java throwable a callback raised, rethrown when the C call has unwound
  (field ^:static ^Throwable pending)
  ;; (queue 530) the closures that crossed, a handle each for the run ('k' u32), so that one the C keeps past the outermost call (a
  ;; root, a C thread's) comes back as itself; the C's threads' agent (started at the server's 't'), and the program's generation it
  ;; serves (finish ends it)
  (field ^:static ^IdentityHashMap kept (IdentityHashMap.))
  (field ^:static ^ArrayList keptList (ArrayList.))
  (field ^:static ^long gen 0)
  (field ^:static ^boolean agentOn false)

  ;; ---- writing

  (method ^:static u8 ^void [^ByteArrayOutputStream o ^long b] (.write o (unchecked-int (bit-and b 255))))
  (method ^:static u32 ^void [^ByteArrayOutputStream o ^long v]
    (CApi/u8 o (bit-shift-right v 24)) (CApi/u8 o (bit-shift-right v 16)) (CApi/u8 o (bit-shift-right v 8)) (CApi/u8 o v))
  (method ^:static u64 ^void [^ByteArrayOutputStream o ^long v]
    (CApi/u32 o (bit-shift-right v 32)) (CApi/u32 o v))
  (method ^:static bytes ^void [^ByteArrayOutputStream o ^byte/1 b]
    (CApi/u32 o (alength b))
    (.write o b 0 (alength b)))

  (method ^:static add ^void [x]
    (.put ids x (Integer/valueOf (.size nodes)))
    (.add nodes x))

  ;; v in the wire form
  (method ^:static put ^void [^ByteArrayOutputStream o v]
    (cond
      (instance? Long v) (do (CApi/u8 o 105) (CApi/u64 o (.longValue (cast Long v))))
      (instance? Double v) (do (CApi/u8 o 100) (CApi/u64 o (Double/doubleToRawLongBits (.doubleValue (cast Double v)))))
      (instance? Integer v) (do (CApi/u8 o 108) (CApi/u32 o (long (.intValue (cast Integer v)))))
      (instance? I64 v) (do (CApi/u8 o 106) (CApi/u64 o (.-v (cast I64 v))))
      (instance? NInt v) (do (CApi/u8 o 110) (CApi/u64 o (.-v (cast NInt v))))
      (nil? v) (do (CApi/u8 o 105) (CApi/u64 o 0))
      (.containsKey ids v) (do (CApi/u8 o 114) (CApi/u32 o (long (.intValue (cast Integer (.get ids v))))))
      (instance? Block v)
      (let [b (cast Block v) f (.-f b)]
        (CApi/add v)
        (CApi/u8 o 98) (CApi/u32 o (long (.-tag b))) (CApi/u32 o (alength f))
        (loop [^int i 0] (when (< i (alength f)) (CApi/put o (aget f i)) (recur (unchecked-inc-int i)))))
      (instance? byte/1 v) (do (CApi/add v) (CApi/u8 o 115) (CApi/bytes o (cast byte/1 v)))
      (instance? double/1 v)
      (let [d (cast double/1 v)]
        (CApi/add v)
        (CApi/u8 o 102) (CApi/u32 o (alength d))
        (loop [^int i 0] (when (< i (alength d)) (CApi/u64 o (Double/doubleToRawLongBits (aget d i))) (recur (unchecked-inc-int i)))))
      (and (instance? Custom v) (instance? BigArray (.-v (cast Custom v))))
      (let [ba (cast BigArray (.-v (cast Custom v))) dims (.-dims ba) n (.size ba)]
        (CApi/add v)
        (CApi/u8 o 66) (CApi/u32 o (long (.-kind ba))) (CApi/u32 o (long (.-layout ba))) (CApi/u32 o (alength dims))
        (loop [^int i 0] (when (< i (alength dims)) (CApi/u32 o (long (aget dims i))) (recur (unchecked-inc-int i))))
        (CApi/u32 o n)
        (loop [^int i 0] (when (< i n) (CApi/put o (aget (.-data ba) (unchecked-add-int (.-off ba) i))) (recur (unchecked-inc-int i)))))
      (and (instance? Custom v) (instance? CBlock (.-v (cast Custom v))))
      (let [c (cast Custom v)]
        (CApi/u8 o 99) (CApi/bytes o (cast byte/1 (Rt/ofUtf8 (.-id c)))) (CApi/u64 o (.-addr (cast CBlock (.-v c)))))
      (instance? Closure v) (do (CApi/add v) (CApi/u8 o 107) (CApi/u32 o (long (CApi/keep v))))
      :else (do (CApi/add v) (CApi/u8 o 104))))

  ;; the closure v's handle, given at its first crossing (queue 530)
  (method ^:static keep ^int [v]
    (let [h (.get kept v)]
      (if (some? h)
        (.intValue (cast Integer h))
        (let [n (.size keptList)]
          (.put kept v (Integer/valueOf n))
          (.add keptList v)
          n))))

  ;; the contents of the nodes known now
  (method ^:static putUpdates ^void [^ByteArrayOutputStream o]
    (let [n (.size nodes)]
      (CApi/u32 o n)
      (loop [^int k 0]
        (when (< k n)
          (let [v (.get nodes k)]
            (cond
              (instance? Block v)
              (let [f (.-f (cast Block v))]
                (loop [^int i 0] (when (< i (alength f)) (CApi/put o (aget f i)) (recur (unchecked-inc-int i)))))
              (instance? byte/1 v) (.write o (cast byte/1 v) 0 (alength (cast byte/1 v)))
              (instance? double/1 v)
              (let [d (cast double/1 v)]
                (loop [^int i 0] (when (< i (alength d)) (CApi/u64 o (Double/doubleToRawLongBits (aget d i))) (recur (unchecked-inc-int i)))))
              (and (instance? Custom v) (instance? BigArray (.-v (cast Custom v))))
              (let [ba (cast BigArray (.-v (cast Custom v))) n (.size ba)]
                (loop [^int i 0] (when (< i n) (CApi/put o (aget (.-data ba) (unchecked-add-int (.-off ba) i))) (recur (unchecked-inc-int i)))))
              :else nil))
          (recur (unchecked-inc-int k))))))

  ;; ---- reading: a message and its position

  (field ^byte/1 msg)
  (field ^int pos)
  (constructor [this ^byte/1 msg] (set! (.-msg this) msg) (set! (.-pos this) 0))

  (method rd8 ^long [this]
    (let [b (long (bit-and (long (aget msg pos)) 255))] (set! pos (unchecked-inc-int pos)) b))
  (method rd32 ^long [this]
    (let [a (.rd8 this) b (.rd8 this) c (.rd8 this) d (.rd8 this)]
      (bit-or (bit-shift-left a 24) (bit-or (bit-shift-left b 16) (bit-or (bit-shift-left c 8) d)))))
  (method rd64 ^long [this]
    (let [h (.rd32 this) l (.rd32 this)] (bit-or (bit-shift-left h 32) l)))
  (method rdBytes ^byte/1 [this ^int n]
    (let [b (java.util.Arrays/copyOfRange msg pos (unchecked-add-int pos n))] (set! pos (unchecked-add-int pos n)) b))

;; a value in the wire form
  (method get [this]
    (let [op (unchecked-int (.rd8 this))]
      (switch op
        105 (Long/valueOf (.rd64 this))
        100 (Double/valueOf (Double/longBitsToDouble (.rd64 this)))
        108 (Integer/valueOf (unchecked-int (.rd32 this)))
        106 (I64. (.rd64 this))
        110 (NInt. (.rd64 this))
        114 (.get nodes (unchecked-int (.rd32 this)))
        107 (let [c (.get keptList (unchecked-int (.rd32 this)))] (CApi/add c) c)
        112 (CApi/predef (unchecked-int (.rd32 this)))
        98 (let [tag (unchecked-int (.rd32 this)) n (unchecked-int (.rd32 this)) f (new Object/1 n) b (Block. tag f)]
             (CApi/add b)
             (loop [^int i 0] (when (< i n) (aset f i (.get this)) (recur (unchecked-inc-int i))))
             b)
        115 (let [b (.rdBytes this (unchecked-int (.rd32 this)))] (CApi/add b) b)
        102 (let [n (unchecked-int (.rd32 this)) d (new double/1 n)]
              (loop [^int i 0] (when (< i n) (aset d i (Double/longBitsToDouble (.rd64 this))) (recur (unchecked-inc-int i))))
              (CApi/add d)
              d)
        66 (let [kind (unchecked-int (.rd32 this)) layout (unchecked-int (.rd32 this)) nd (unchecked-int (.rd32 this)) dims (new int/1 nd)]
             (loop [^int i 0] (when (< i nd) (aset dims i (unchecked-int (.rd32 this))) (recur (unchecked-inc-int i))))
             (let [n (unchecked-int (.rd32 this)) data (new Object/1 n) c (BigArray/custom (BigArray. kind layout dims data 0))]
               (CApi/add c)
               (loop [^int i 0] (when (< i n) (aset data i (.get this)) (recur (unchecked-inc-int i))))
               c))
        99 (let [id (Rt/utf8 (.rdBytes this (unchecked-int (.rd32 this)))) a (.rd64 this) k (Long/valueOf a)
                 r (cast WeakReference (.get cblocks k)) c (if (some? r) (.get r) nil)]
             (if (some? c)
               c
               (let [nc (Custom. id (CBlock. a))] (.put cblocks k (WeakReference. nc)) nc)))
        (throw (Rt/internal (java-str "the C API: a value of the wire form " op))))))

  ;; fail.h's predefined exception i
  (method ^:static predef [^int i]
    (switch i
      0 Rt/Out_of_memory 1 Rt/Sys_error 2 Rt/Failure 3 Rt/Invalid_argument 4 Rt/End_of_file 5 Rt/Division_by_zero
      6 Rt/Not_found 7 Rt/Match_failure 8 Rt/Stack_overflow 9 Rt/Sys_blocked_io 10 Rt/Assert_failure
      Rt/Undefined_recursive_module))

  ;; the contents of the nodes the sender knew, into them
  (method getUpdates ^void [this]
    (let [n (unchecked-int (.rd32 this))]
      (loop [^int k 0]
        (when (< k n)
          (let [v (.get nodes k)]
            (cond
              (instance? Block v)
              (let [f (.-f (cast Block v))]
                (loop [^int i 0] (when (< i (alength f)) (aset f i (.get this)) (recur (unchecked-inc-int i)))))
              (instance? byte/1 v)
              (let [b (cast byte/1 v)]
                (System/arraycopy msg pos b 0 (alength b))
                (set! pos (unchecked-add-int pos (alength b))))
              (instance? double/1 v)
              (let [d (cast double/1 v)]
                (loop [^int i 0] (when (< i (alength d)) (aset d i (Double/longBitsToDouble (.rd64 this))) (recur (unchecked-inc-int i)))))
              (and (instance? Custom v) (instance? BigArray (.-v (cast Custom v))))
              (let [ba (cast BigArray (.-v (cast Custom v))) m (.size ba)]
                (loop [^int i 0] (when (< i m) (aset (.-data ba) (unchecked-add-int (.-off ba) i) (.get this)) (recur (unchecked-inc-int i)))))
              :else nil))
          (recur (unchecked-inc-int k))))))

  ;; ---- the channel

  ;; message o (its op, the updates and the payload) sent, its reply read: the reader after the reply's op (op) and updates (none
  ;; with 'N')
  (field ^int op)
  (method ^:static exchange ^CApi [^ByteArrayOutputStream o]
    (let [b (.toByteArray o)
          r (if (some? chan)
              (do (.write chan b 0 (alength b))
                  (let [n (.readInt chan) r (new byte/1 n)]
                    (.readFully chan r)
                    r))
              (CApi/pipeExchange b))
          rd (CApi. r)]
      (set! (.-op rd) (unchecked-int (.rd8 rd)))
      (when (not (== (.-op rd) 78)) (.getUpdates rd))
      rd))

  ;; the light level's exchange: message b framed to the server, its reply's chunks read (the C's output into the program's streams)
  ;; until the reply itself
  (method ^:static pipeExchange ^byte/1 [^byte/1 b]
    (let [h (ByteArrayOutputStream.)]
      (CApi/u32 h (alength b))
      (.write h b 0 (alength b))
      (.write pout (.toByteArray h))
      (.flush pout)
      (loop []
        (let [k (.read pin) n (.readInt pin) r (new byte/1 n)]
          (.readFully pin r)
          (cond
            (== k 109) r
            (== k 111) (do (.write System/out r 0 n) (recur))
            (== k 101) (do (.write System/err r 0 n) (recur))
            ;; (queue 530) the C started a thread: its agent from now on
            (== k 116) (do (CApi/startAgent) (recur))
            ;; a signal the C sent the process itself (raise, kill of its pid): the runtime's own, pending (ExtSignal), its handler
            ;; run when the call returns (call3)
            (== k 115) (do (loop [^int i 0]
                             (when (< i n)
                               (ExtSignal/post (long (aget r i)))
                               (recur (unchecked-inc-int i))))
                           (recur))
            :else (throw (Rt/internal (java-str "the C API: a chunk " k))))))))

  (method ^:static open ^boolean []
    (when (and (nil? chan) (nil? proc) (not failed))
      (try (set! chan (RandomAccessFile. capiPath "rw"))
           (catch IOException e (CApi/spawn))))
    (or (some? chan) (some? proc)))

  ;; the light level's server spawned (OI_CAPI_SERVER and OI_CSTUBS set), else the channel failed
  (method ^:static spawn ^void []
    (let [srv (System/getenv "OI_CAPI_SERVER") stubs (System/getenv "OI_CSTUBS")]
      (if (or (nil? srv) (nil? stubs) (.isEmpty srv) (.isEmpty stubs))
        (set! failed true)
        (let [argv (ArrayList.)]
          (.add argv srv)
          (.add argv "capi")
          (let [pb (ProcessBuilder. ^java.util.List argv)]
            (.directory pb (File. ExtSys/cwd))
            (.redirectError pb ProcessBuilder$Redirect/INHERIT)
            (try
              (let [p (.start pb)]
                (set! pin (DataInputStream. (java.io.BufferedInputStream. (.getInputStream p))))
                (set! pout (java.io.BufferedOutputStream. (.getOutputStream p)))
                (set! proc p))
              (catch IOException e (set! failed true))))))))

  ;; the program's end (Main/run): the light level's server asked to flush the C's stdio ('Z'), its output written, the process ended
  (method ^:public ^:static finish ^void []
    (when (some? proc)
      (try
        (let [o (ByteArrayOutputStream.)]
          (CApi/u8 o 90)
          (CApi/pipeExchange (.toByteArray o))
          (.close pout)
          (.waitFor proc))
        (catch Throwable t nil))
      (set! proc nil)
      (set! pin nil)
      (set! pout nil)
      (set! gen (unchecked-inc gen))
      (set! agentOn false)
      (.clear kept)
      (.clear keptList)
      (.flush System/out)
      (.flush System/err)))

  ;; (queue 523) an asked collection (ExtGc/gcAsked, before the finalisers it fires): the C's custom blocks whose Custom is unreachable
  ;; forgotten, and at no call's depth their addresses sent to the server ('G'), which runs the finalize of those whose operations have
  ;; one, as the C runtime's sweep does; inside a call (a callback asked for it) they wait for the next asked collection
  (method ^:public ^:static collected ^void []
    (when (> (.size cblocks) 0)
      (System/gc)
      (let [ks (ArrayList. (.keySet cblocks))]
        (loop [^int i 0]
          (when (< i (.size ks))
            (let [k (.get ks i)]
              (when (nil? (.get (cast WeakReference (.get cblocks k))))
                (.remove cblocks k)
                (.add cbDead k)))
            (recur (unchecked-inc-int i))))))
    (when (and (== depth 0) (> (.size cbDead) 0) (or (some? chan) (some? proc)))
      (let [o (ByteArrayOutputStream.)]
        (CApi/u8 o 71)
        (CApi/u32 o (long (.size cbDead)))
        (loop [^int i 0]
          (when (< i (.size cbDead))
            (CApi/u64 o (.longValue (cast Long (.get cbDead i))))
            (recur (unchecked-inc-int i))))
        (.clear cbDead)
        (CApi/exchange o))))

;; ---- the C's threads (queue 530; oicapi's threads.go and wire.go): a thread the C started speaks to the runtime only when it asks.
  ;; Once the server said the C started one ('t'), an agent (a daemon thread) polls every two milliseconds, holding the runtime's lock
  ;; and at no call's depth ('P'): the server answers 'N' (nothing), or a C thread's conversation as the session's worker: 'D' u32 dom
  ;; (answered 'R' 1 when the domain runs, else 0), or 'L' u32 dom (the runtime taken for a thread of that domain: answered 'R' (),
  ;; then its callbacks 'K', each run on a thread state of that domain, until its release 'N'). The lock stays the agent's for the
  ;; whole conversation, as a registered C thread holds the master lock from its acquire to its release.

  (method ^:static startAgent ^void []
    (when (not agentOn)
      (set! agentOn true)
      (let [g gen
            t (Thread. (lambda Runnable []
                         (loop []
                           (when (== g gen)
                             (try (Thread/sleep 2) (catch InterruptedException e nil))
                             (Gil/lock)
                             (try
                               (when (and (== g gen) (== depth 0) (some? proc)) (CApi/poll))
                               (catch Throwable e nil)
                               (finally (Gil/unlock)))
                             (recur)))))]
        (.setDaemon t true)
        (.start t))))

  (method ^:static poll ^void []
    (set! nodes (ArrayList.))
    (set! ids (IdentityHashMap.))
    (set! depth 1)
    (let [prev (.get Effects/CUR)]
      (try
        (let [o (ByteArrayOutputStream.)]
          (CApi/u8 o 80)
          (CApi/serveThread (CApi/exchange o)))
        (finally
          (.set Effects/CUR prev)
          (set! depth 0)
          (set! nodes nil)
          (set! ids nil)))))

  ;; a C thread's conversation, until its end ('N')
  (method ^:static serveThread ^void [^CApi rd]
    (switch (.-op rd)
      78 nil
      68 (let [d (.rd32 rd)]
           (CApi/serveThread (CApi/answer 82 (Long/valueOf (if (Effects/domainRuns d) 1 0)))))
      76 (let [d (.rd32 rd)]
           (.set Effects/CUR (TState. nil (Effects/domainOf d)))
           (CApi/serveThread (CApi/answer 82 Rt/UNIT)))
      75 (let [f (.get rd) n (unchecked-int (.rd32 rd)) a (new Object/1 n)]
           (loop [^int i 0] (when (< i n) (aset a i (.get rd)) (recur (unchecked-inc-int i))))
           (CApi/serveThread (CApi/apply f a)))
      81 (let [v (.get Rt/named (Rt/utf8 (.rdBytes rd (unchecked-int (.rd32 rd)))))]
           (CApi/serveThread (if (nil? v) (CApi/answer 78 nil) (CApi/answer 82 v))))
      (throw (Rt/internal (java-str "the C API: a C thread's message " (.-op rd))))))
  ;; ---- (queue 527) Marshal of the C's custom blocks (extern_custom, intern's CODE_CUSTOM_LEN): the operations' serialize and
  ;; deserialize run by the server ('S', 'D'), as ocamlopt's runtime calls them; at any depth (a callback may marshal), the reply's
  ;; nodes in the call's session or, outside a call, one of its own

  ;; the C custom block c's operations' serialize: Object/1 [its bytes, Long the 32-bit size, Long the 64-bit size], nil when its
  ;; operations have none
  (method ^:public ^:static serialize [^Custom c]
    (if (not (CApi/open))
      nil
      (let [top (== depth 0)]
        (when top (set! nodes (ArrayList.)) (set! ids (IdentityHashMap.)))
        (try
          (let [o (ByteArrayOutputStream.)]
            (CApi/u8 o 83)
            (CApi/u64 o (.-addr (cast CBlock (.-v c))))
            (let [rd (CApi/exchange o)]
              (switch (.-op rd)
                78 nil
                82 (let [b (.rdBytes rd (unchecked-int (.rd32 rd))) s32 (.rd64 rd) s64 (.rd64 rd)]
                     (new Object/1 [b (Long/valueOf s32) (Long/valueOf s64)]))
                (CApi/serve rd "caml_serialize" false))))
          (finally (when top (set! nodes nil) (set! ids nil)))))))

  ;; a custom block of the operations the C registered under the identifier name, deserialized from src's bytes [pos, end) (expected
  ;; the size recorded): Object/1 [the block, Long the size deserialize returned, Long the bytes it read], nil when none is registered
  (method ^:public ^:static deserialize [^String name ^byte/1 src ^int pos ^int end ^long expected]
    (if (not (CApi/open))
      nil
      (let [top (== depth 0)]
        (when top (set! nodes (ArrayList.)) (set! ids (IdentityHashMap.)))
        (try
          (let [o (ByteArrayOutputStream.)]
            (CApi/u8 o 68)
            (CApi/bytes o (.getBytes name java.nio.charset.StandardCharsets/ISO_8859_1))
            (CApi/u32 o (long (unchecked-subtract-int end pos)))
            (.write o src pos (unchecked-subtract-int end pos))
            (CApi/u64 o expected)
            (let [rd (CApi/exchange o)]
              (switch (.-op rd)
                78 nil
                82 (let [v (.get rd) size (.rd64 rd) used (.rd64 rd)]
                     (new Object/1 [v (Long/valueOf size) (Long/valueOf used)]))
                (CApi/serve rd "caml_deserialize" false))))
          (finally (when top (set! nodes nil) (set! ids nil)))))))

  ;; ---- the call

  ;; external name applied to args: the stub's result; with no stub of that name, the runtime's missing external (call) or
  ;; unsupported primitive (prim: a name not caml_..., the translator's message before OC215)
  (method ^:public ^:static call [^String name ^Object/1 args] (CApi/call3 name "" args false))
  (method ^:public ^:static prim [^String name ^Object/1 args] (CApi/call3 name "" args true))
  ;; OC199 (a): an external with no bytecode name, its native function called with the representations reprs (env/prim-native's
  ;; letters, the arguments' then the result's)
  (method ^:public ^:static nativeCall [^String name ^String reprs ^Object/1 args] (CApi/call3 name reprs args false))
  (method ^:static none ^RuntimeException [^String name ^boolean prim] (if prim (Rt/unsupported name) (Rt/missing name)))

  (method ^:static call3 [^String name ^String reprs ^Object/1 args ^boolean prim]
    (when (not (CApi/open)) (throw (CApi/none name prim)))
    (when (== depth 0)
      (set! nodes (ArrayList.))
      (set! ids (IdentityHashMap.)))
    (set! depth (unchecked-inc-int depth))
    (try
      (let [o (ByteArrayOutputStream.)]
        (CApi/u8 o 67)
        (CApi/putUpdates o)
        (CApi/bytes o (cast byte/1 (Rt/ofUtf8 name)))
        (CApi/bytes o (cast byte/1 (Rt/ofUtf8 reprs)))
        (CApi/u32 o (alength args))
        (loop [^int i 0] (when (< i (alength args)) (CApi/put o (aget args i)) (recur (unchecked-inc-int i))))
        (let [v (CApi/serve (CApi/exchange o) name prim)]
          ;; the signals the C sent itself, handled as OCaml's runtime does when an external returns
          (when (not (== ExtSignal/pending 0)) (ExtSignal/process))
          v))
      (finally
        (set! depth (unchecked-dec-int depth))
        (when (== depth 0)
          (set! nodes nil)
          (set! ids nil)))))

  ;; the main's replies until the call's end: callbacks and named values answered, the end returned or raised
  (method ^:static serve [^CApi rd ^String name ^boolean prim]
    (switch (.-op rd)
      82 (.get rd)
      69 (throw (Exn. (.get rd)))
      88 (throw (Exit. (unchecked-int (.rd32 rd))))
      78 (throw (CApi/none name prim))
      70 (throw (Fatal. (Rt/utf8 (.rdBytes rd (unchecked-int (.rd32 rd)))) 125))
      84 (let [t pending] (set! pending nil) (throw (if (some? t) t (Rt/internal "the C API: an unwound call"))))
      75 (let [f (.get rd) n (unchecked-int (.rd32 rd)) a (new Object/1 n)]
           (loop [^int i 0] (when (< i n) (aset a i (.get rd)) (recur (unchecked-inc-int i))))
           (CApi/serve (CApi/apply f a) name prim))
      81 (let [v (.get Rt/named (Rt/utf8 (.rdBytes rd (unchecked-int (.rd32 rd)))))]
           (CApi/serve (if (nil? v) (CApi/answer 78 nil) (CApi/answer 82 v)) name prim))
      (throw (Rt/internal (java-str "the C API: a reply " (.-op rd))))))

  ;; a callback: f applied to a, the answer its result ('R'), the OCaml exception it raised ('E') or, for another throwable, kept for
  ;; the call's end ('T')
  ;; (queue 413) the callback runs as caml_callback runs it, on a stack of its own: no handler of the caller's reaches it, so an
  ;; effect it performs unhandled is Effect.Unhandled (callback/test7), the thread's fiber put back after
  (method ^:static apply ^CApi [f ^Object/1 a]
    (let [^:mutable ^int k 82 ^:mutable r nil
          ts (Effects/st)
          fb (.-fiber ts)]
      (set! (.-fiber ts) nil)
      (try (set! r (CApi/apN f a))
           (catch Exn e (set! k 69) (set! r (.-v e)))
           (catch Throwable t (set! pending t) (set! k 84))
           (finally (set! (.-fiber ts) fb)))
      (CApi/answer k r)))

  ;; f applied to a as Rt/ap applies it, an over-application a loop (queue 413: caml_callbackN of 10,000 arguments, one a closure
  ;; of arity 1 each, callback/test1, is 10,000 nested calls of Rt/ap, beyond the light level's interpreted depth)
  (method ^:static apN [f ^Object/1 a]
    (let [n (alength a)]
      (loop [g f ^int i 0]
        (let [c (Rt/fn g) ar (.-arity c)]
          (if (<= (unchecked-subtract-int n i) ar)
            (Rt/ap c (if (== i 0) a (java.util.Arrays/copyOfRange a i n)))
            (recur (.exact c (java.util.Arrays/copyOfRange a i (unchecked-add-int i ar))) (unchecked-add-int i ar)))))))

  ;; the answer 'A': K and its value (R and E carry one)
  (method ^:static answer ^CApi [^int k v]
    (let [o (ByteArrayOutputStream.)]
      (CApi/u8 o 65)
      (CApi/putUpdates o)
      (CApi/u8 o k)
      (when (or (== k 82) (== k 69)) (CApi/put o v))
      (CApi/exchange o))))

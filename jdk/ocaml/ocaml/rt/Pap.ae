;; A partial application: a closure and the arguments given so far.

(in-ns 'ocaml.rt)

(defclass ^:public ^:final Pap
  :extends Closure

  (field ^:public ^Closure fn)
  (field ^:public ^Object/1 args)

  (constructor ^:public [this ^Closure fn ^Object/1 args]
    (super. (unchecked-subtract-int (.-arity fn) (alength args)))
    (set! (.-fn this) fn)
    (set! (.-args this) args))

  (method ^:public a1 [this a] (.exact fn (Rt/cat args (new Object/1 [a]))))
  (method ^:public a2 [this a b] (.exact fn (Rt/cat args (new Object/1 [a b]))))
  (method ^:public a3 [this a b c] (.exact fn (Rt/cat args (new Object/1 [a b c]))))
  (method ^:public a4 [this a b c d] (.exact fn (Rt/cat args (new Object/1 [a b c d]))))
  (method ^:public a5 [this a b c d e] (.exact fn (Rt/cat args (new Object/1 [a b c d e]))))
  (method ^:public a6 [this a b c d e f] (.exact fn (Rt/cat args (new Object/1 [a b c d e f]))))
  (method ^:public an [this ^Object/1 x] (.exact fn (Rt/cat args x))))

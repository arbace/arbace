;; A tail call between the functions of one letrec group (OC84 (c); doc/ocaml/DEFERRED-TRIAGE.md, "As built: OT9's first
;; fix"): such a function's body (its method tb, arbace.o2j) returns a TailCall in place of calling the other function, and its
;; entry (a1 ... an) bounces (Rt/bounce): the called function's tb with the arguments, again while the result is a TailCall, in
;; one frame, so that mutual tail recursion does not grow the stack (basic/tailcalls' 10^7 steps). Never an OCaml value: only
;; tb returns one and only Rt/bounce receives it.

(in-ns 'ocaml.rt)

(defclass ^:public ^:final TailCall
  (field ^:public ^:final ^Closure c)
  (field ^:public ^:final ^Object/1 args)

  (constructor ^:public [this ^Object c ^Object/1 args]
    (set! (.-c this) (cast Closure c))
    (set! (.-args this) args)))

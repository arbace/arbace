;; A bigarray (the Custom "_bigarr02"'s object), as oi has it (ext_digest.go): the elements are
;; OCaml values in an array (a slice is a window on its parent's: data and off), kind as
;; bigarray.h's enumeration, layout 0 (C) or 1 (Fortran).

(in-ns 'ocaml.rt)

(defclass ^:public ^:final BigArray
  (field ^:public ^int kind)
  (field ^:public ^int layout)
  (field ^:public ^int/1 dims)
  (field ^:public ^Object/1 data)
  (field ^:public ^int off)

  (constructor ^:public [this ^int kind ^int layout ^int/1 dims ^Object/1 data ^int off]
    (set! (.-kind this) kind)
    (set! (.-layout this) layout)
    (set! (.-dims this) dims)
    (set! (.-data this) data)
    (set! (.-off this) off))

  (method ^:public ^:static product ^int [^int/1 d ^int from]
    (let [^:mutable ^long n 1]
      (loop [^int i from]
        (when (< i (alength d)) (set! n (unchecked-multiply n (long (aget d i)))) (recur (unchecked-inc-int i))))
      (unchecked-int n)))
  (method ^:public size ^int [this] (BigArray/product (.-dims this) 0))

  (method ^:public ^:static zero [^int kind]
    (switch kind
      (0 1 13) (Double/valueOf 0.0)
      6 (Integer/valueOf 0)
      7 (I64. 0)
      9 (NInt. 0)
      (10 11) (new double/1 2)
      (Long/valueOf 0)))

  ;; the value an element of the kind holds after a store
  (method ^:public ^:static coerce [^int kind v]
    (switch kind
      0 (Double/valueOf (double (unchecked-float (Rt/d v))))
      (1 13) (Double/valueOf (Rt/d v))
      2 (Long/valueOf (bit-shift-right (bit-shift-left (Rt/l v) 56) 56))
      (3 12) (Long/valueOf (bit-and (Rt/l v) 255))
      4 (Long/valueOf (bit-shift-right (bit-shift-left (Rt/l v) 48) 48))
      5 (Long/valueOf (bit-and (Rt/l v) 65535))
      (6 7 8 9) v
      10 (let [f (cast double/1 v) r (new double/1 2)]
           (aset r 0 (double (unchecked-float (aget f 0))))
           (aset r 1 (double (unchecked-float (aget f 1))))
           r)
      11 (.clone (cast double/1 v))
      v))

  (method ^:public ^:static create ^BigArray [^int kind ^int layout ^int/1 dims]
    (let [n (BigArray/product dims 0)
          data (new Object/1 n)]
      (loop [^int i 0]
        (when (< i n) (aset data i (BigArray/zero kind)) (recur (unchecked-inc-int i))))
      (BigArray. kind layout dims data 0)))

  (method ^:public ^:static custom [^BigArray b] (Custom. "_bigarr02" b))
  (method ^:public ^:static of ^BigArray [x]
    (if (and (instance? Custom x) (instance? BigArray (.-v (cast Custom x))))
      (cast BigArray (.-v (cast Custom x)))
      (throw (Rt/internal (java-str "not a bigarray: " (Rt/describe x))))))

  ;; the element's index in data (idx: an OCaml int array's fields)
  (method ^:public offset ^int [this ^Object/1 idx]
    (let [dims (.-dims this)]
      (when (not (== (alength idx) (alength dims)))
        (throw (Rt/invalidArg "Bigarray.get/set: wrong number of indices")))
      (let [^:mutable ^long o 0]
        (if (== (.-layout this) 0)
          (loop [^int i 0]
            (when (< i (alength dims))
              (let [j (Rt/l (aget idx i))]
                (when (or (< j 0) (>= j (long (aget dims i)))) (throw (Rt/invalidArg "index out of bounds")))
                (set! o (unchecked-add (unchecked-multiply o (long (aget dims i))) j)))
              (recur (unchecked-inc-int i))))
          (loop [^int i (unchecked-dec-int (alength dims))]
            (when (>= i 0)
              (let [j (unchecked-subtract (Rt/l (aget idx i)) 1)]
                (when (or (< j 0) (>= j (long (aget dims i)))) (throw (Rt/invalidArg "index out of bounds")))
                (set! o (unchecked-add (unchecked-multiply o (long (aget dims i))) j)))
              (recur (unchecked-dec-int i)))))
        (unchecked-add-int (.-off this) (unchecked-int o)))))

  (method ^:public get [this ^Object/1 idx]
    (let [v (aget (.-data this) (.offset this idx))]
      (if (instance? double/1 v) (.clone (cast double/1 v)) v)))
  (method ^:public set [this ^Object/1 idx v]
    (aset (.-data this) (.offset this idx) (BigArray/coerce (.-kind this) v))
    nil))

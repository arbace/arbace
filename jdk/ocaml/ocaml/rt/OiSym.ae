;; A symbol or a keyword of a Lambda text the runtime's interpreter reads (Oi: the embedded oi, queue 544): its name, a keyword's
;; with its colon.

(in-ns 'ocaml.rt)

(defclass ^:public ^:final OiSym
  (field ^:public ^:final ^String n)

  (constructor ^:public [this ^String n]
    (set! (.-n this) n)))

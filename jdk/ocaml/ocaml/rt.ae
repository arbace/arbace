;; OCaml's runtime as Java forms, the package ocaml.rt (doc/ocaml/OCAML-SURVEY.md, "As built: O6
;; (write-ahead)"): the values, the primitives and the externals the Java forms of arbace.o2j call.
;; One class a file, so that a class another one names is found by its file (SPEC §9.2); loaded
;; in an order where a class's static initializer finds the classes it makes defined.

(ns ocaml.rt)

(load "rt/Block")
(load "rt/I64")
(load "rt/NInt")
(load "rt/Custom")
(load "rt/Code")
(load "rt/Exn")
(load "rt/Exit")
(load "rt/Fatal")
(load "rt/Fiber")
(load "rt/Closure")
(load "rt/Pap")
(load "rt/Native")
(load "rt/Rt")
(load "rt/Gil")
(load "rt/Dom")
(load "rt/TState")
(load "rt/Effects")
(load "rt/ExtCore")
(load "rt/Main")
(load "rt/ExtNum")
(load "rt/ExtStr")
(load "rt/Compare")
(load "rt/Hash")
(load "rt/ExtArray")
(load "rt/Marshal")
(load "rt/Fd")
(load "rt/Channel")
(load "rt/ExtIo")
(load "rt/Blake2")
(load "rt/ExtDigest")
(load "rt/ExtLex")
(load "rt/ExtSys")
(load "rt/ExtUnix")
(load "rt/ExtGc")
(load "rt/ExtLxm")
(load "rt/BigArray")
(load "rt/ExtBigarray")

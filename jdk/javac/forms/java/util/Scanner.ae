      (if (and (.find matcher) (or (not (.hitEnd matcher)) sourceClosed))
          (do (set! position (.end matcher)) (set! advance (== (.start matcher) position)) true)
          (do (when-not sourceClosed (set! needInput true)) false))))

  (defclass ^:private ^:static PatternLRUCache
    (field ^:private ^Pattern/1 oa nil)

    (field ^:private ^:final ^int size)

    (constructor [this ^int size] (set! (.-size this) size))

    (method hasName ^boolean [this ^Pattern p ^String s]
      (.equals (.pattern p) s))

    (method moveToFront ^void [this ^Object/1 oa ^int i]
      (let [ob (aget oa i)]
        (loop [^int j i]
          (when (> j 0)
            (aset oa j (aget oa (unchecked-subtract-int j 1)))
            (recur (unchecked-dec-int j))))
        (aset oa 0 ob)))

    (method forName ^Pattern [this ^String name]
      (if (nil? oa)
          (let [temp (new Pattern/1 size)] (set! oa temp))
          (loop [^int i 0]
            (when (< i (alength oa))
              (let [ob (aget oa i)]
                (cond
                  (nil? ob) (recur (unchecked-inc-int i))
                  (.hasName this ob name) (do (when (> i 0) (.moveToFront this oa i)) (return ob))
                  :else (recur (unchecked-inc-int i)))))))
      (let [ob (Pattern/compile name)]
        (aset oa (unchecked-subtract-int (alength oa) 1) ob)
        (.moveToFront this oa (unchecked-subtract-int (alength oa) 1))
        ob))))

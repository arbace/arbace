  (method ^:private processFloatToken ^String [this ^String token]
    (let [^:mutable result (.replaceAll token groupSeparator "")]
      (when-not (.equals decimalSeparator "\\.")
        (set! result (.replaceAll result decimalSeparator ".")))
      (let [^:mutable isNegative false
            preLen (.length negativePrefix)]
        (when (and (> preLen 0) (.startsWith result negativePrefix))
          (set! isNegative true)
          (set! result (.substring result preLen)))
        (let [sufLen (.length negativeSuffix)]
          (when (and (> sufLen 0) (.endsWith result negativeSuffix))
            (set! isNegative true)
            (set! result
                  (.substring result
                              (unchecked-subtract-int (.length result) sufLen)
                              (.length result))))
          (when (.equals result nanString) (set! result "NaN"))
          (when (.equals result infinityString) (set! result "Infinity"))
          (when isNegative (set! result (java-str "-" result)))
          (let [m (.matcher NON_ASCII_DIGIT result)]
            (when (.find m)
              (let [inASCII (StringBuilder.)]
                (loop [^int i 0]
                  (when (< i (.length result))
                    (let [nextChar (.charAt result i)]
                      (if (Character/isDigit nextChar)
                          (let [d (Character/digit nextChar 10)]
                            (if (not (== d -1))
                                (do (.append inASCII d) (recur (unchecked-inc-int i)))
                                (do (.append inASCII nextChar) (recur (unchecked-inc-int i)))))
                          (do (.append inASCII nextChar) (recur (unchecked-inc-int i)))))))
                (set! result (.toString inASCII))))
            result)))))


    (method ^:public tryAdvance ^boolean [this ^{:tag (Consumer (? super MatchResult))} cons]
      (.ensureOpen Scanner/this)
      (if (>= expectedCount 0)
          (when-not (== expectedCount modCount) (throw (ConcurrentModificationException.)))
          (do (set! matchValid false) (.usePattern matcher pattern) (set! expectedCount modCount)))
      (while true
        (when (.nextInBuffer this)
          (.accept cons (.toMatchResult matcher))
          (when-not (== expectedCount modCount) (throw (ConcurrentModificationException.)))
          (return true))

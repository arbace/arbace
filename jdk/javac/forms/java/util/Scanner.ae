  (defclass FindSpliterator
    :extends (Spliterators$AbstractSpliterator MatchResult)

    (field ^:final ^Pattern pattern)

    (field ^int expectedCount -1)

    (field ^:private ^boolean advance false)

    (constructor [this ^Pattern pattern]
      (super. Long/MAX_VALUE
              (bit-or-int (bit-or-int Spliterator/IMMUTABLE Spliterator/NONNULL)
                          Spliterator/ORDERED))

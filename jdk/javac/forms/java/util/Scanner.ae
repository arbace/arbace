        (throw (ConcurrentModificationException.)))
      (if (.hasNext Scanner/this)
          (let [token (.next Scanner/this)]
            (set! expectedCount modCount)
            (.accept cons token)
            (when-not (== expectedCount modCount) (throw (ConcurrentModificationException.)))
            true)
          (do (set! expectedCount modCount) false))))


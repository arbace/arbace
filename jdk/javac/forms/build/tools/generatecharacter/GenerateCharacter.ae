        (when identifiers
          (let [^:mutable replacement 0]
            (when (>= (bit-and resultA maskIdentifierInfo) lowJavaStart)
              (set! replacement (bit-or replacement bitJavaStart)))
            (when (and (not (== (bit-and resultA nonzeroJavaPart) 0))
                       (not (== (bit-and resultA maskIdentifierInfo) valueIgnorable)))
              (set! replacement (bit-or replacement bitJavaPart)))
            (set! resultA replacement)))
        resultA)))

  (method ^:static addExProp ^void [^long/1 map ^PropList propList ^String prop ^long mask]
    (let [^{:tag (List Integer)} cps (.codepoints propList prop)]
      (when (some? cps)
        (for-each [^Integer cp cps]
          (when (< cp (alength map)) (aset map cp (bit-or (aget map cp) mask)))))))

  (method ^:static addEmojiProps ^void [^long/1 map ^EmojiData emojiData]
    (for-each [^int cp (.codepoints emojiData)]
      (let [index (bit-and-int cp 0xFFFF)]
        (when (< index (alength map))
          (aset map index (bit-or (aget map index) (.properties emojiData cp)))))))

  (method ^:static buildTable ^long/2 [^long/1 map ^int size]
    (let [n (alength map)]
      (when-not (== (bit-shift-left-int (bit-shift-right-int n size) size) n)
        (GenerateCharacter/FAIL
          (java-str "Length " n " is not a multiple of " (bit-shift-left-int 1 size))))
      (let [m (bit-shift-left-int 1 size)
            newmap (new long/1 (bit-shift-right-int n size))
            buffer (new long/1 n)
            ^:mutable ^int ptr 0]
        (label :OUTER
          (loop [^int i 0]
            (when (< i n)
              (label :MIDDLE
                (loop [^int j 0]
                  (when (< j ptr)
                    (loop [^int k 0]
                      (if (< k m)
                          (if (not (== (aget buffer (unchecked-add-int j k))
                                       (aget map (unchecked-add-int i k))))
                              (continue :MIDDLE (unchecked-add-int j m))
                              (recur (unchecked-inc-int k)))
                          nil))
                    (aset newmap (bit-shift-right-int i size) (bit-shift-right-int j size))
                    (continue :OUTER (unchecked-add-int i m)))))
              (when (> m 0) (System/arraycopy map i buffer ptr m))
              (aset newmap (bit-shift-right-int i size) (bit-shift-right-int ptr size))
              (set! ptr (unchecked-add-int ptr m))
              (recur (unchecked-add-int i m)))))
        (let [newdata (new long/1 ptr)]
          (when (> ptr 0) (System/arraycopy buffer 0 newdata 0 ptr))
          (new long/2 [newmap newdata])))))

  (method ^:static generateCharacterClass :throws [IOException] ^void [^String theTemplateFileName
                                                                       ^String theOutputFileName]
    (let [in (BufferedReader. (FileReader. theTemplateFileName))
          out (PrintWriter. (BufferedWriter. (FileWriter. theOutputFileName)))]
      (.println out
                (java-str commentStart
                          " This file was generated AUTOMATICALLY from a template file "
                          commentEnd))
      (let [marklen (.length commandMarker)]
        (while true
          (try
            (let [^:mutable line (.readLine in)]
              (when (nil? line) (break))
              (let [^:mutable ^int pos 0
                    ^:mutable ^int depth 0]
                (while (>= (set! pos (.indexOf line commandMarker pos)) 0)
                  (let [^:mutable newpos (unchecked-add-int pos marklen)
                        ^:mutable ^char ch (unchecked-char 0)]
                    (while (and (< newpos (.length line))
                                (or (or (Character/isJavaIdentifierStart
                                          (set! ch (.charAt line newpos)))
                                        (== ch \())
                                    (and (== ch \)) (> depth 0))))
                      (set! newpos (unchecked-inc-int newpos))
                      (if (== ch \()
                          (set! depth (unchecked-inc-int depth))
                          (when (== ch \))
                            (set! depth (unchecked-dec-int depth))
                            (when (== depth 0) (break)))))
                    (let [replacement (GenerateCharacter/replaceCommand
                                        (.substring line (unchecked-add-int pos marklen) newpos))]
                      (set! line
                            (java-str (.substring line 0 pos) replacement (.substring line newpos)))
                      (set! pos (unchecked-add-int pos (.length replacement))))))
                (.println out line)))
            (catch IOException e (break))))
        (.close in)
        (.close out))))

  (method ^:static replaceCommand ^String [^String x]
    (cond
      (.equals x "Tables") (GenerateCharacter/genTables)
      (.equals x "Initializers") (GenerateCharacter/genInitializers)
      (and (and (>= (.length x) 9) (.startsWith x "Lookup(")) (.endsWith x ")"))
        (GenerateCharacter/genAccess "A"
                                     (.substring x 7 (unchecked-subtract-int (.length x) 1))
                                     (if identifiers 2 32))
      (and (and (>= (.length x) 11) (.startsWith x "LookupEx(")) (.endsWith x ")"))
        (GenerateCharacter/genAccess "B" (.substring x 9 (unchecked-subtract-int (.length x) 1)) 16)
      (.equals x "shiftType") (Long/toString shiftType)
      (.equals x "shiftIdentifierInfo") (Long/toString shiftIdentifierInfo)
      (.equals x "maskIdentifierInfo") (java-str "0x" (GenerateCharacter/hex8 maskIdentifierInfo))
      (.equals x "maskUnicodePart") (java-str "0x" (GenerateCharacter/hex8 maskUnicodePart))
      (.equals x "shiftCaseOffset") (Long/toString shiftCaseOffset)
      (.equals x "shiftCaseOffsetSign") (Long/toString shiftCaseOffsetSign)
      (.equals x "maskCase") (java-str "0x" (GenerateCharacter/hex8 maskCase))
      (.equals x "maskCaseOffset") (java-str "0x" (GenerateCharacter/hex8 maskCaseOffset))
      (.equals x "maskLowerCase") (java-str "0x" (GenerateCharacter/hex8 maskLowerCase))
      (.equals x "maskUpperCase") (java-str "0x" (GenerateCharacter/hex8 maskUpperCase))
      (.equals x "maskTitleCase") (java-str "0x" (GenerateCharacter/hex8 maskTitleCase))
      (.equals x "maskOtherLowercase")
        (java-str "0x" (GenerateCharacter/hex4 (bit-shift-right maskOtherLowercase 32)))
      (.equals x "maskOtherUppercase")
        (java-str "0x" (GenerateCharacter/hex4 (bit-shift-right maskOtherUppercase 32)))
      (.equals x "maskOtherAlphabetic")
        (java-str "0x" (GenerateCharacter/hex4 (bit-shift-right maskOtherAlphabetic 32)))
      (.equals x "maskIdeographic")
        (java-str "0x" (GenerateCharacter/hex4 (bit-shift-right maskIdeographic 32)))
      (.equals x "maskIDStart")
        (java-str "0x" (GenerateCharacter/hex4 (bit-shift-right maskIDStart 32)))
      (.equals x "maskIDContinue")
        (java-str "0x" (GenerateCharacter/hex4 (bit-shift-right maskIDContinue 32)))
      (.equals x "maskEmoji")
        (java-str "0x" (GenerateCharacter/hex4 (bit-shift-right maskEmoji 32)))
      (.equals x "maskEmojiPresentation")
        (java-str "0x" (GenerateCharacter/hex4 (bit-shift-right maskEmojiPresentation 32)))
      (.equals x "maskEmojiModifier")
        (java-str "0x" (GenerateCharacter/hex4 (bit-shift-right maskEmojiModifier 32)))
      (.equals x "maskEmojiModifierBase")
        (java-str "0x" (GenerateCharacter/hex4 (bit-shift-right maskEmojiModifierBase 32)))
      (.equals x "maskEmojiComponent")
        (java-str "0x" (GenerateCharacter/hex4 (bit-shift-right maskEmojiComponent 32)))
      (.equals x "maskExtendedPictographic")
        (java-str "0x" (GenerateCharacter/hex4 (bit-shift-right maskExtendedPictographic 32)))
      (.equals x "valueIgnorable") (java-str "0x" (GenerateCharacter/hex8 valueIgnorable))
      (.equals x "valueJavaUnicodeStart")
        (java-str "0x" (GenerateCharacter/hex8 valueJavaUnicodeStart))
      (.equals x "valueJavaOnlyStart") (java-str "0x" (GenerateCharacter/hex8 valueJavaOnlyStart))
      (.equals x "valueJavaUnicodePart")
        (java-str "0x" (GenerateCharacter/hex8 valueJavaUnicodePart))
      (.equals x "valueJavaOnlyPart") (java-str "0x" (GenerateCharacter/hex8 valueJavaOnlyPart))
      (.equals x "valueJavaWhitespace") (java-str "0x" (GenerateCharacter/hex8 valueJavaWhitespace))
      (.equals x "lowJavaStart") (java-str "0x" (GenerateCharacter/hex8 lowJavaStart))
      (.equals x "nonzeroJavaPart") (java-str "0x" (GenerateCharacter/hex8 nonzeroJavaPart))
      (.equals x "bitJavaStart") (java-str "0x" (GenerateCharacter/hex8 bitJavaStart))
      (.equals x "bitJavaPart") (Long/toString bitJavaPart)
      (.equals x "valueUnicodeStart") (java-str "0x" (GenerateCharacter/hex8 valueUnicodeStart))
      (.equals x "maskIsJavaIdentifierStart")
        (java-str "0x" (GenerateCharacter/hex maskIsJavaIdentifierStart))
      (.equals x "maskIsJavaIdentifierPart")
        (java-str "0x" (GenerateCharacter/hex maskIsJavaIdentifierPart))
      (.equals x "shiftDigitOffset") (Long/toString shiftDigitOffset)
      (.equals x "maskDigitOffset") (java-str "0x" (GenerateCharacter/hex maskDigitOffset))
      (.equals x "maskDigit") (java-str "0x" (GenerateCharacter/hex maskDigit))
      (.equals x "shiftNumericType") (Long/toString shiftNumericType)
      (.equals x "maskNumericType") (java-str "0x" (GenerateCharacter/hex maskNumericType))
      (.equals x "valueNotNumeric") (java-str "0x" (GenerateCharacter/hex8 valueNotNumeric))

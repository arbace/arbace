                  (GenerateCharacter/FAIL
                    (java-str "Character "
                              (GenerateCharacter/hex c)
                              " has incompatible lowercase and uppercase mappings"))))))
        (when (or (and (.hasTitleMap us) (not (== (.-titleMap us) (.-upperMap us))))
                  (and bHasUpper (.hasLowerMap us)))
          (set! resultA (bit-or resultA maskTitleCase)))
        (when (and (and (and bHasUpper (not (.hasLowerMap us))) (not (.hasTitleMap us))) verbose)
          (.println System/out
                    (java-str "Warning: Character "
                              (GenerateCharacter/hex4 c)
                              " has upper but no title case; Java won't know this")))
        (when (< offset minOffsetSeen) (set! minOffsetSeen offset))
        (when (> offset maxOffsetSeen) (set! maxOffsetSeen offset))
        (when (or (> offset maxOffset) (< offset minOffset))

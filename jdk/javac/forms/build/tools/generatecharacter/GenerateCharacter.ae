  (method ^:static genTables ^String []
    (let [n (alength sizes)
          result (StringBuffer.)]
      (when debug
        (.append (.append (.append (.append
                                     (.append
                                       (.append
                                         (.append
                                           (.append
                                             (.append result commentStart)
                                             " The following tables and code generated using:")
                                           commentEnd)
                                         "\n  ")
                                       commentStart)
                                     \space)
                                   commandLineDescription)
                          commentEnd)
                 "\n  "))
      (when (and (== plane 0) (not bLatin1))
        (GenerateCharacter/genCaseMapTableDeclaration result)
        (GenerateCharacter/genCaseMapTable initializers specialCaseMaps))
      (let [^:mutable ^int totalBytes 0]
        (loop [^int k 0]
          (when (< k (unchecked-subtract-int n 1))
            (GenerateCharacter/genTable result
                                        (aget tableNames k)
                                        (aget tables k)
                                        0
                                        (bit-shift-left-int (aget bytes k) 3)
                                        (aget sizes k)
                                        (aget preshifted k)
                                        (aget sizes (unchecked-add-int k 1))
                                        false
                                        false
                                        (== k 0))
            (let [^:mutable s (aget bytes k)]
              (when (and (== s 1) useCharForByte) (set! s 2))
              (set! totalBytes
                    (unchecked-add-int totalBytes
                                       (unchecked-multiply-int (alength (aget tables k)) s)))
              (recur (unchecked-inc-int k)))))
        (GenerateCharacter/genTable result
                                    "A"
                                    (aget tables (unchecked-subtract-int n 1))
                                    0
                                    (if identifiers 2 32)
                                    (aget sizes (unchecked-subtract-int n 1))
                                    false
                                    0
                                    true
                                    (not identifiers)
                                    false)
        (GenerateCharacter/genTable result
                                    "B"
                                    (aget tables (unchecked-subtract-int n 1))
                                    32
                                    16
                                    (aget sizes (unchecked-subtract-int n 1))
                                    false
                                    0
                                    true
                                    true
                                    false)
        (set! totalBytes
              (unchecked-add-int totalBytes
                                 (bit-shift-left-int
                                   (bit-shift-right-int
                                     (unchecked-add-int
                                       (unchecked-multiply-int
                                         (alength (aget tables (unchecked-subtract-int n 1)))
                                         (if identifiers 2 32))
                                       31)
                                     5)
                                   2)))
        (.append result commentStart)
        (.append result " In all, the character property tables require ")
        (.append (.append (.append result totalBytes) " bytes.") commentEnd)
        (when verbose
          (.println System/out
                    (java-str "The character property tables require " totalBytes " bytes.")))
        (.toString result))))

  (method ^:static genInitializers ^String [] (.toString initializers))

  (method ^:static getTotalBytes ^int []
    (let [n (alength sizes)
          ^:mutable ^int totalBytes 0]
      (loop [^int k 0]
        (when (< k (unchecked-subtract-int n 1))
          (set! totalBytes
                (unchecked-add-int
                  totalBytes
                  (unchecked-multiply-int (alength (aget tables k)) (aget bytes k))))
          (recur (unchecked-inc-int k))))
      (set! totalBytes
            (unchecked-add-int totalBytes
                               (bit-shift-left-int
                                 (bit-shift-right-int
                                   (unchecked-add-int
                                     (unchecked-multiply-int
                                       (alength (aget tables (unchecked-subtract-int n 1)))
                                       (if identifiers 2 32))
                                     31)
                                   5)
                                 2)))
      totalBytes))

  (field ^:static ^String SMALL_INITIALIZER
    "        { // THIS CODE WAS AUTOMATICALLY CREATED BY GenerateCharacter:\n            int len = $$name_DATA.length();\n            int j=0;\n            for (int i=0; i<len; ++i) {\n                int c = $$name_DATA.charAt(i);\n                for (int k=0; k<$$entriesPerChar; ++k) {\n                    $$name[j++] = ($$type)c;\n                    c >>= $$bits;\n                }\n            }\n            assert (j == $$size);\n        }\n")

  (field ^:static ^String SAME_SIZE_INITIALIZER
    "        { // THIS CODE WAS AUTOMATICALLY CREATED BY GenerateCharacter:\n            assert ($$name_DATA.length() == $$size);\n            for (int i=0; i<$$size; ++i)\n                $$name[i] = ($$type)$$name_DATA.charAt(i);\n        }\n")

  (field ^:static ^String BIG_INITIALIZER
    "        { // THIS CODE WAS AUTOMATICALLY CREATED BY GenerateCharacter:\n            int len = $$name_DATA.length();\n            int j=0;\n            int charsInEntry=0;\n            $$type entry=0;\n            for (int i=0; i<len; ++i) {\n                entry |= $$name_DATA.charAt(i);\n                if (++charsInEntry == $$charsPerEntry) {\n                    $$name[j++] = entry;\n                    entry = 0;\n                    charsInEntry = 0;\n                }\n                else {\n                    entry <<= 16;\n                }\n            }\n            assert (j == $$size);\n        }\n")

  (field ^:static ^String INT32_INITIALIZER
    "        { // THIS CODE WAS AUTOMATICALLY CREATED BY GenerateCharacter:\n            char[] data = $$name_DATA.toCharArray();\n            assert (data.length == ($$size * 2));\n            int i = 0, j = 0;\n            while (i < ($$size * 2)) {\n                int entry = data[i++] << 16;\n                $$name[j++] = entry | data[i++];\n            }\n        }\n")

  (method ^:static addInitializer ^void [^String name ^String type ^int entriesPerChar ^int bits
                                         ^int size]
    (let [^:mutable ^String template (cond
                                       (== entriesPerChar 1) SAME_SIZE_INITIALIZER
                                       (> entriesPerChar 0) SMALL_INITIALIZER
                                       :else BIG_INITIALIZER)]
      (when (== entriesPerChar -2) (set! template INT32_INITIALIZER))
      (let [marklen (.length commandMarker)
            ^:mutable ^int pos 0]
        (while (>= (set! pos (.indexOf template commandMarker pos)) 0)
          (let [^:mutable newpos (unchecked-add-int pos marklen)
                ^:mutable ^char ch (unchecked-char 0)]
            (while (and (and (< newpos (.length template))
                             (Character/isJavaIdentifierStart (set! ch (.charAt template newpos))))
                        (not (== ch \_)))
              (set! newpos (unchecked-inc-int newpos)))
            (let [token (.substring template (unchecked-add-int pos marklen) newpos)
                  ^String replacement (switch token
                                        "name" name
                                        "type" type
                                        "bits" (java-str "" bits)
                                        "size" (java-str "" size)
                                        "entriesPerChar" (java-str "" entriesPerChar)
                                        "charsPerEntry"
                                          (java-str "" (unchecked-negate-int entriesPerChar))
                                        (do
                                          (GenerateCharacter/FAIL
                                            (java-str "Unrecognized token: " token))
                                          "ERROR"))]
              (set! template
                    (java-str (.substring template 0 pos) replacement (.substring template newpos)))
              (set! pos (unchecked-add-int pos (.length replacement))))))
        (.append initializers template))))

  (method ^:static genTable ^void [^StringBuffer result ^String name ^long/1 table ^int extract
                                   ^int bits ^int size ^boolean preshifted ^int shift
                                   ^boolean hexFormat ^boolean properties ^boolean hexComment]
    (let [^:mutable ^String atype (cond
                                    (== bits 1) (if Csyntax "unsigned long" "int")
                                    (== bits 2) (if Csyntax "unsigned long" "int")
                                    (== bits 4) (if Csyntax "unsigned long" "int")
                                    (== bits 8) (if Csyntax "unsigned char" "byte")
                                    (== bits 16) (if Csyntax "unsigned short" "char")
                                    (== bits 32) (if Csyntax "unsigned long" "int")
                                    Csyntax "int64"
                                    :else "long")
          ^:mutable maxPosEntry (cond
                                  (== bits 1) (long Integer/MAX_VALUE)
                                  (== bits 2) (long Integer/MAX_VALUE)
                                  (== bits 4) (long Integer/MAX_VALUE)
                                  (== bits 8) (long Byte/MAX_VALUE)
                                  (== bits 16) (long Short/MAX_VALUE)
                                  (== bits 32) (long Integer/MAX_VALUE)
                                  :else Long/MAX_VALUE)
          ^:mutable ^int entriesPerChar (if (<= bits 16)
                                            (unchecked-divide-int 16 bits)
                                            (unchecked-negate-int (unchecked-divide-int bits 16)))
          shiftEntries (and preshifted (not (== shift 0)))]
      (when (and (and (== bits 8) tableAsString) useCharForByte)
        (set! atype "char")
        (set! maxPosEntry Character/MAX_VALUE)
        (set! entriesPerChar 1))
      (let [noConversion (.equals atype "char")]
        (.append result commentStart)
        (.append (.append (.append (.append result " The ") name) " table has ") (alength table))
        (.append result " entries for a total of ")
        (let [^:mutable sizeOfTable (bit-shift-left-int
                                      (bit-shift-right-int
                                        (unchecked-add-int
                                          (unchecked-multiply-int (alength table) bits)
                                          31)
                                        5)
                                      2)]
          (when (and (and (== bits 8) tableAsString) useCharForByte)
            (set! sizeOfTable (unchecked-multiply-int sizeOfTable 2)))
          (.append result sizeOfTable)
          (.append (.append (.append result " bytes.") commentEnd) "\n\n")
          (if Csyntax (.append result "  static ") (.append result "  @Stable static final "))
          (.append result atype)
          (.append (.append (.append result " ") name) "[")
          (when Csyntax
            (.append result
                     (bit-shift-right-int (alength table)
                                          (cond (== bits 1) 5 (== bits 2) 4 (== bits 4) 3 :else 0))))
          (if tableAsString
              (do
                (if noConversion
                    (.append result "] = (\n")
                    (do
                      (.append (.append (.append (.append (.append result "] = new ") atype) "[")
                                        (alength table))
                               "];\n  ")
                      (.append (.append (.append result "static final String ") name) "_DATA =\n")))
                (let [theString (StringBuilder.)
                      ^:mutable ^int entriesInCharSoFar 0
                      ^:mutable ch \u0000
                      charsPerEntry (unchecked-negate-int entriesPerChar)]
                  (for-each [^long l table]
                    (let [^:mutable ^long entry (if (.equals "A" name)
                                                    (bit-shift-right (bit-and l 0xffffffff) extract)
                                                    (bit-shift-right l extract))]
                      (when shiftEntries (set! entry (bit-shift-left entry shift)))
                      (when (>= entry (bit-shift-left 1 bits))
                        (GenerateCharacter/FAIL "Entry too big"))
                      (if (> entriesPerChar 0)
                          (do
                            (set! ch
                                  (unchecked-char
                                    (bit-or (bit-shift-right-int (int ch) bits)
                                            (bit-shift-left
                                              entry
                                              (unchecked-multiply-int
                                                (unchecked-subtract-int entriesPerChar 1)
                                                bits)))))
                            (set! entriesInCharSoFar (unchecked-inc-int entriesInCharSoFar))
                            (when (== entriesInCharSoFar entriesPerChar)
                              (.append theString ch)
                              (set! entriesInCharSoFar 0)
                              (set! ch \u0000)))
                          (loop [^int k 0]
                            (when (< k charsPerEntry)
                              (set! ch
                                    (unchecked-char
                                      (bit-shift-right
                                        entry
                                        (unchecked-multiply-int
                                          (unchecked-subtract-int charsPerEntry 1)
                                          16))))
                              (set! entry (bit-shift-left entry 16))
                              (.append theString ch)
                              (recur (unchecked-inc-int k)))))))
                  (when (> entriesInCharSoFar 0)
                    (while (< entriesInCharSoFar entriesPerChar)
                      (set! ch (unchecked-char (bit-shift-right-int (int ch) bits)))
                      (set! entriesInCharSoFar (unchecked-inc-int entriesInCharSoFar)))
                    (.append theString ch))
                  (.append result (Utility/formatForSource (.toString theString) "    "))
                  (when noConversion (.append result ").toCharArray()"))
                  (.append result ";\n\n  ")
                  (when-not noConversion
                    (GenerateCharacter/addInitializer
                      name
                      atype
                      entriesPerChar
                      bits
                      (alength table)))))
              (do
                (.append result "] = {")
                (let [castEntries (and shiftEntries (< bits 32))
                      ^int printPerLine (cond
                                          hexFormat
                                            (cond
                                              (== bits 1) (unchecked-multiply-int 32 4)
                                              (== bits 2) (unchecked-multiply-int 16 4)
                                              (== bits 4) (unchecked-multiply-int 8 4)
                                              (== bits 8) 8
                                              (== bits 16) 8
                                              (== bits 32) 4
                                              :else 2)
                                          (== bits 8) 8
                                          (== bits 16) 8
                                          :else 4)
                      ^int printMask (if properties
                                         0
                                         (unchecked-subtract-int
                                           (Math/min
                                             (bit-shift-left-int 1 size)
                                             (bit-shift-right-int
                                               printPerLine
                                               (if castEntries (if Csyntax 2 1) 0)))
                                           1))
                      ^int commentShift (if (== (bit-shift-left-int 1 size) (alength table)) 0 size)
                      ^int commentMask (if (== (bit-shift-left-int 1 size) (alength table))
                                           printMask
                                           (unchecked-subtract-int (bit-shift-left-int 1 size) 1))
                      ^:mutable val 0]
                  (loop [^int j 0]
                    (when (< j (alength table))
                      (when (== (bit-and-int j printMask) 0)
                        (while (== (.charAt result (unchecked-subtract-int (.length result) 1))
                                   \space)
                          (.setLength result (unchecked-subtract-int (.length result) 1)))
                        (.append result "\n    "))
                      (label :PRINT
                        (when castEntries (.append (.append (.append result "(") atype) ")("))
                        (let [entry (bit-shift-right (aget table j) extract)
                              packMask (unchecked-subtract-int
                                         (bit-shift-left-int
                                           1
                                           (cond (== bits 1) 5 (== bits 2) 4 (== bits 4) 3 :else 2))
                                         1)
                              k (bit-and-int j packMask)]
                          (cond
                            (>= bits 8) (set! val entry)
                            (== k 0) (do (set! val entry) (break :PRINT))
                            :else
                              (do
                                (set! val
                                      (bit-or
                                        val
                                        (bit-shift-left entry (unchecked-multiply-int k bits))))
                                (when-not (== k packMask) (break :PRINT))))
                          (when (and (> val maxPosEntry) (not Csyntax))
                            (.append result \-)
                            (set! val
                                  (unchecked-subtract
                                    (unchecked-add (unchecked-add maxPosEntry maxPosEntry) 2)
                                    val)))
                          (cond
                            hexFormat
                              (do
                                (.append result "0x")
                                (cond
                                  (== bits 8)
                                    (.append result (GenerateCharacter/hex2 (unchecked-byte val)))
                                  (== bits 16)
                                    (.append result (GenerateCharacter/hex4 (unchecked-short val)))
                                  (or (== bits 32) (< bits 8))
                                    (.append result (GenerateCharacter/hex8 (unchecked-int val)))
                                  :else
                                    (do
                                      (.append result (GenerateCharacter/hex16 val))
                                      (when-not Csyntax (.append result "L")))))
                            (== bits 8) (.append result (GenerateCharacter/dec3 val))
                            (== bits 64)
                              (do
                                (.append result (GenerateCharacter/dec5 val))
                                (when-not Csyntax (.append result "L")))
                            :else (.append result (GenerateCharacter/dec5 val)))
                          (when shiftEntries (.append (.append result "<<") shift))
                          (when castEntries (.append result ")"))
                          (if (< j (unchecked-subtract-int (alength table) 1))
                              (.append result ", ")
                              (.append result "  "))
                          (if (== (bit-and-int j printMask) printMask)
                              (do
                                (.append (.append (.append result " ") commentStart) " ")
                                (if hexComment
                                    (.append (.append result "0x")
                                             (GenerateCharacter/hex4
                                               (bit-shift-left-int
                                                 (bit-and-int j (bit-not-int commentMask))
                                                 (unchecked-subtract-int 16 size))))
                                    (.append result
                                             (GenerateCharacter/dec3
                                               (bit-shift-right-int
                                                 (bit-and-int j (bit-not-int commentMask))
                                                 commentShift))))
                                (when properties
                                  (GenerateCharacter/propertiesComments
                                    result
                                    (bit-shift-left val extract)))
                                (.append result commentEnd)
                                (recur (unchecked-inc-int j)))
                              (recur (unchecked-inc-int j)))))))
                  (.append result "\n  };\n\n  "))))))))

  (method ^:static genCaseMapTableDeclaration ^void [^StringBuffer result]
    (.append result "    @Stable static final char[][][] charMap;\n"))

  (method ^:static genCaseMapTable ^void [^StringBuffer result ^SpecialCaseMap/1 specialCaseMaps]
    (let [myTab "    "
          ^:mutable ^int ch 0
          ^:mutable ^char/1 map nil]
      (.append (.append result myTab) "charMap = new char[][][] {\n")
      (for-each [^SpecialCaseMap specialCaseMap specialCaseMaps]
        (set! ch (.getCharSource specialCaseMap))
        (set! map (.getUpperCaseMap specialCaseMap))
        (.append (.append (.append result myTab) myTab) "{ ")
        (.append (.append (.append result "{'\\u") (GenerateCharacter/hex4 ch)) "'}, {")
        (for-each [^char c map]
          (.append (.append (.append result "'\\u") (GenerateCharacter/hex4 c)) "', "))
        (.append result "} },\n"))
      (.append (.append result myTab) "};\n")))

  (method ^:static propertiesComments ^void [^StringBuffer result ^long val]
    (.append result "   ")
    (switch (unchecked-int (bit-and val maskType))
      UnicodeSpec/CONTROL (.append result "Cc")
      UnicodeSpec/FORMAT (.append result "Cf")
      UnicodeSpec/PRIVATE_USE (.append result "Co")
      UnicodeSpec/SURROGATE (.append result "Cs")
      UnicodeSpec/LOWERCASE_LETTER (.append result "Ll")
      UnicodeSpec/MODIFIER_LETTER (.append result "Lm")
      UnicodeSpec/OTHER_LETTER (.append result "Lo")
      UnicodeSpec/TITLECASE_LETTER (.append result "Lt")
      UnicodeSpec/UPPERCASE_LETTER (.append result "Lu")
      UnicodeSpec/COMBINING_SPACING_MARK (.append result "Mc")
      UnicodeSpec/ENCLOSING_MARK (.append result "Me")
      UnicodeSpec/NON_SPACING_MARK (.append result "Mn")
      UnicodeSpec/DECIMAL_DIGIT_NUMBER (.append result "Nd")
      UnicodeSpec/LETTER_NUMBER (.append result "Nl")
      UnicodeSpec/OTHER_NUMBER (.append result "No")
      UnicodeSpec/CONNECTOR_PUNCTUATION (.append result "Pc")
      UnicodeSpec/DASH_PUNCTUATION (.append result "Pd")
      UnicodeSpec/END_PUNCTUATION (.append result "Pe")
      UnicodeSpec/OTHER_PUNCTUATION (.append result "Po")
      UnicodeSpec/START_PUNCTUATION (.append result "Ps")
      UnicodeSpec/CURRENCY_SYMBOL (.append result "Sc")
      UnicodeSpec/MODIFIER_SYMBOL (.append result "Sk")
      UnicodeSpec/MATH_SYMBOL (.append result "Sm")
      UnicodeSpec/OTHER_SYMBOL (.append result "So")
      UnicodeSpec/LINE_SEPARATOR (.append result "Zl")
      UnicodeSpec/PARAGRAPH_SEPARATOR (.append result "Zp")
      UnicodeSpec/SPACE_SEPARATOR (.append result "Zs")
      UnicodeSpec/UNASSIGNED (.append result "unassigned"))
    (switch (unchecked-int (bit-shift-right (bit-and val maskBidi) shiftBidi))
      UnicodeSpec/DIRECTIONALITY_LEFT_TO_RIGHT (.append result ", L")
      UnicodeSpec/DIRECTIONALITY_RIGHT_TO_LEFT (.append result ", R")
      UnicodeSpec/DIRECTIONALITY_EUROPEAN_NUMBER (.append result ", EN")
      UnicodeSpec/DIRECTIONALITY_EUROPEAN_NUMBER_SEPARATOR (.append result ", ES")
      UnicodeSpec/DIRECTIONALITY_EUROPEAN_NUMBER_TERMINATOR (.append result ", ET")
      UnicodeSpec/DIRECTIONALITY_ARABIC_NUMBER (.append result ", AN")
      UnicodeSpec/DIRECTIONALITY_COMMON_NUMBER_SEPARATOR (.append result ", CS")
      UnicodeSpec/DIRECTIONALITY_PARAGRAPH_SEPARATOR (.append result ", B")
      UnicodeSpec/DIRECTIONALITY_SEGMENT_SEPARATOR (.append result ", S")
      UnicodeSpec/DIRECTIONALITY_WHITESPACE (.append result ", WS")
      UnicodeSpec/DIRECTIONALITY_OTHER_NEUTRALS (.append result ", ON"))
    (when-not (== (bit-and val maskUpperCase) 0)
      (.append result ", hasUpper (subtract ")
      (.append (.append result (bit-shift-right (bit-and val maskCaseOffset) shiftCaseOffset)) ")"))
    (when-not (== (bit-and val maskLowerCase) 0)
      (.append result ", hasLower (add ")
      (.append (.append result (bit-shift-right (bit-and val maskCaseOffset) shiftCaseOffset)) ")"))
    (when-not (== (bit-and val maskTitleCase) 0) (.append result ", hasTitle"))
    (when (== (bit-and val maskIdentifierInfo) valueIgnorable) (.append result ", ignorable"))
    (when (== (bit-and val maskIdentifierInfo) valueJavaUnicodePart)
      (.append result ", identifier part"))
    (when (== (bit-and val maskIdentifierInfo) valueJavaStartUnicodePart)
      (.append result ", underscore"))
    (when (== (bit-and val maskIdentifierInfo) valueJavaWhitespace) (.append result ", whitespace"))
    (when (== (bit-and val maskIdentifierInfo) valueJavaOnlyStart) (.append result ", currency"))
    (when (== (bit-and val maskIdentifierInfo) valueJavaUnicodeStart)
      (.append result ", identifier start"))
    (when (== (bit-and val maskNumericType) valueDigit)
      (.append result ", decimal ")
      (.append result (bit-shift-right (bit-and val maskDigitOffset) shiftDigitOffset)))
    (when (== (bit-and val maskNumericType) valueStrangeNumeric) (.append result ", strange"))
    (when (== (bit-and val maskNumericType) valueJavaSupradecimal)
      (.append result ", supradecimal ")
      (.append result (bit-shift-right (bit-and val maskDigitOffset) shiftDigitOffset)))
    (when (== (bit-and val maskOtherLowercase) maskOtherLowercase)
      (.append result ", otherLowercase"))
    (when (== (bit-and val maskOtherUppercase) maskOtherUppercase)
      (.append result ", otherUppercase"))
    (when (== (bit-and val maskOtherAlphabetic) maskOtherAlphabetic)
      (.append result ", otherAlphabetic"))
    (when (== (bit-and val maskIdeographic) maskIdeographic) (.append result ", ideographic"))
    (when (== (bit-and val maskIDStart) maskIDStart) (.append result ", IDStart"))
    (when (== (bit-and val maskIDContinue) maskIDContinue) (.append result ", IDContinue"))
    (when (== (bit-and val maskEmoji) maskEmoji) (.append result ", emoji"))
    (when (== (bit-and val maskEmojiPresentation) maskEmojiPresentation)
      (.append result ", emojiPresentation"))
    (when (== (bit-and val maskEmojiModifier) maskEmojiModifier) (.append result ", emojiModifier"))
    (when (== (bit-and val maskEmojiModifierBase) maskEmojiModifierBase)
      (.append result ", emojiModifierBase"))
    (when (== (bit-and val maskEmojiComponent) maskEmojiComponent)
      (.append result ", emojiComponent"))
    (when (== (bit-and val maskExtendedPictographic) maskExtendedPictographic)
      (.append result ", extendedPictographic")))

  (field ^:static ^String/1 tableNames (new String/1 ["X" "Y" "Z" "P" "Q" "R" "S" "T" "U" "V" "W"]))

  (method ^:static tableName ^String [^int j] (aget tableNames j))

  (method ^:static genAccess ^String [^String tbl ^String var ^int bits]
    (let [^:mutable ^String access nil
          ^int bitoffset (cond (== bits 1) 5 (== bits 2) 4 (== bits 4) 3 :else 0)]
      (loop [^int k 0]
        (when (< k (alength sizes))
          (let [^int offset (if (< k (unchecked-subtract-int (alength sizes) 1)) 0 bitoffset)
                shift (unchecked-add-int (aget shifts k) offset)
                ^String shifted (if (== shift 0) var (java-str "(" var ">>" shift ")"))
                mask (unchecked-subtract-int
                       (bit-shift-left-int 1 (unchecked-subtract-int (aget sizes k) offset))
                       1)
                ^String masked (if (== k 0)
                                   shifted
                                   (java-str "(" shifted "&0x" (GenerateCharacter/hex mask) ")"))
                ^String index (cond
                                (== k 0) masked
                                (== mask 0) access
                                :else (java-str "(" access "|" masked ")"))
                ^String indexNoParens (if (not (== (.charAt index 0) \())
                                          index
                                          (.substring
                                            index
                                            1
                                            (unchecked-subtract-int (.length index) 1)))
                ^String tblname (if (== k (unchecked-subtract-int (alength sizes) 1))
                                    tbl
                                    (GenerateCharacter/tableName k))
                fetched (java-str tblname "[" indexNoParens "]")
                ^String zeroextended (if (== (aget zeroextend k) 0)
                                         fetched
                                         (java-str
                                           "("
                                           fetched
                                           "&0x"
                                           (GenerateCharacter/hex (aget zeroextend k))
                                           ")"))
                ^int adjustment (if (aget preshifted k)
                                    0
                                    (unchecked-subtract-int
                                      (aget sizes (unchecked-add-int k 1))
                                      (if (== k (unchecked-subtract-int (alength sizes) 2))
                                          bitoffset
                                          0)))
                ^String adjusted (if (or (aget preshifted k) (== adjustment 0))
                                     zeroextended
                                     (java-str "(" zeroextended "<<" adjustment ")"))
                ^String bitshift (cond
                                   (== bits 1) (java-str "(" var "&0x1F)")
                                   (== bits 2) (java-str "((" var "&0xF)<<1)")
                                   (== bits 4) (java-str "((" var "&7)<<2)"))]
            (set! access
                  (if (or (< k (unchecked-subtract-int (alength sizes) 1)) (>= bits 8))
                      adjusted
                      (java-str "(("
                                adjusted
                                ">>"
                                bitshift
                                ")&"
                                (if (== bits 4)
                                    "0xF"
                                    (java-str
                                      ""
                                      (unchecked-subtract-int (bit-shift-left-int 1 bits) 1)))
                                ")")))
            (recur (unchecked-inc-int k)))))
      access))

  (field ^:static ^boolean verbose false)

  (field ^:static ^boolean debug false)

  (field ^:static ^boolean nobidi false)

  (field ^:static ^boolean nomirror false)

  (field ^:static ^boolean identifiers false)

  (field ^:static ^boolean Csyntax false)

  (field ^:static ^String TemplateFileName nil)

  (field ^:static ^String OutputFileName nil)

  (field ^:static ^String UnicodeSpecFileName nil)

  (field ^:static ^String SpecialCasingFileName nil)

  (field ^:static ^String PropListFileName nil)

  (field ^:static ^String DerivedPropsFileName nil)

  (field ^:static ^String EmojiDataFileName nil)

  (field ^:static ^boolean useCharForByte false)

  (field ^:static ^int/1 sizes)

  (field ^:static ^int bins 0)

  (field ^:static ^boolean tableAsString false)

  (field ^:static ^boolean bLatin1 false)

  (field ^:static ^String commandLineDescription)

  (field ^:static ^int/1 shifts)

  (field ^:static ^int/1 zeroextend)

  (field ^:static ^int/1 bytes)

  (field ^:static ^boolean/1 preshifted)

  (field ^:static ^long/2 tables)

  (field ^:static ^String commentStart)

  (field ^:static ^String commentEnd)

  (field ^:static ^StringBuffer initializers (StringBuffer.))

  (field ^:static ^SpecialCaseMap/1 specialCaseMaps)

  (method ^:static processArgs ^void [^String/1 args]
    (let [desc (StringBuilder. "java GenerateCharacter")]
      (for-each [^String arg args] (.append (.append desc " ") arg))
      (let [^:mutable ^int j 0]
        (while (< j (alength args))
          (cond
            (or (.equals (aget args j) "-verbose") (.equals (aget args j) "-v")) (set! verbose true)
            (.equals (aget args j) "-d") (set! debug true)
            (.equals (aget args j) "-nobidi") (set! nobidi true)
            (.equals (aget args j) "-nomirror") (set! nomirror true)
            (.equals (aget args j) "-identifiers") (set! identifiers true)
            (.equals (aget args j) "-c") (set! Csyntax true)
            (.equals (aget args j) "-string") (set! tableAsString true)
            (.equals (aget args j) "-o")
              (if (== j (unchecked-subtract-int (alength args) 1))
                  (GenerateCharacter/FAIL "File name missing after -o")
                  (set! OutputFileName (aget args (set! j (unchecked-inc-int j)))))
            (.equals (aget args j) "-search")
              (if (== j (unchecked-subtract-int (alength args) 1))
                  (GenerateCharacter/FAIL "Bin count missing after -search")
                  (do
                    (set! bins (Integer/parseInt (aget args (set! j (unchecked-inc-int j)))))
                    (when (or (< bins 1) (> bins 10))
                      (GenerateCharacter/FAIL "Bin count must be >= 1 and <= 10"))))
            (.equals (aget args j) "-template")
              (if (== j (unchecked-subtract-int (alength args) 1))
                  (GenerateCharacter/FAIL "File name missing after -template")
                  (set! TemplateFileName (aget args (set! j (unchecked-inc-int j)))))
            (.equals (aget args j) "-spec")
              (if (== j (unchecked-subtract-int (alength args) 1))
                  (GenerateCharacter/FAIL "File name missing after -spec")
                  (set! UnicodeSpecFileName (aget args (set! j (unchecked-inc-int j)))))
            (.equals (aget args j) "-specialcasing")
              (if (== j (unchecked-subtract-int (alength args) 1))
                  (GenerateCharacter/FAIL "File name missing after -specialcasing")
                  (set! SpecialCasingFileName (aget args (set! j (unchecked-inc-int j)))))
            (.equals (aget args j) "-proplist")
              (if (== j (unchecked-subtract-int (alength args) 1))
                  (GenerateCharacter/FAIL "File name missing after -proplist")
                  (set! PropListFileName (aget args (set! j (unchecked-inc-int j)))))
            (.equals (aget args j) "-derivedprops")
              (if (== j (unchecked-subtract-int (alength args) 1))
                  (GenerateCharacter/FAIL "File name missing after -derivedprops")
                  (set! DerivedPropsFileName (aget args (set! j (unchecked-inc-int j)))))
            (.equals (aget args j) "-emojidata")
              (if (== j (unchecked-subtract-int (alength args) 1))
                  (GenerateCharacter/FAIL "File name missing after -emojidata")
                  (set! EmojiDataFileName (aget args (set! j (unchecked-inc-int j)))))
            (.equals (aget args j) "-plane")
              (do
                (if (== j (unchecked-subtract-int (alength args) 1))
                    (GenerateCharacter/FAIL "Plane number missing after -plane")
                    (set! plane (Integer/parseInt (aget args (set! j (unchecked-inc-int j))))))
                (when (> plane 0) (set! bLatin1 false)))
            (.equals "-usecharforbyte" (aget args j)) (set! useCharForByte true)
            (.equals (aget args j) "-latin1") (do (set! bLatin1 true) (set! plane 0))
            :else
              (try
                (let [val (Integer/parseInt (aget args j))]
                  (when (or (< val 0) (> val 32))
                    (GenerateCharacter/FAIL (java-str "Incorrect bit field width: " (aget args j))))
                  (if (nil? sizes)
                      (set! sizes (new int/1 1))
                      (let [newsizes (new int/1 (unchecked-add-int (alength sizes) 1))]
                        (System/arraycopy sizes 0 newsizes 0 (alength sizes))
                        (set! sizes newsizes)))
                  (aset sizes (unchecked-subtract-int (alength sizes) 1) val))
                (catch NumberFormatException e
                  (GenerateCharacter/FAIL (java-str "Unknown switch: " (aget args j))))))
          (set! j (unchecked-inc-int j))))
      (when (and Csyntax tableAsString)
        (GenerateCharacter/FAIL "Can't specify table as string with C syntax"))
      (when (nil? sizes)
        (.append desc " [")
        (if identifiers
            (let [newsizes (new int/1 [8 4 4])] (.append desc "8 4 4]") (set! sizes newsizes))
            (let [newsizes (new int/1 [10 5 1])] (.append desc "10 5 1]") (set! sizes newsizes))))
      (when (nil? UnicodeSpecFileName)
        (set! UnicodeSpecFileName DefaultUnicodeSpecFileName)
        (.append desc (java-str " [-spec " UnicodeSpecFileName \])))
      (when (nil? SpecialCasingFileName)
        (set! SpecialCasingFileName DefaultSpecialCasingFileName)
        (.append desc (java-str " [-specialcasing " SpecialCasingFileName \])))
      (when (nil? PropListFileName)
        (set! PropListFileName DefaultPropListFileName)
        (.append desc (java-str " [-proplist " PropListFileName \])))
      (when (nil? DerivedPropsFileName)
        (set! DerivedPropsFileName DefaultDerivedPropsFileName)
        (.append desc (java-str " [-derivedprops " DerivedPropsFileName \])))
      (when (nil? EmojiDataFileName)
        (set! EmojiDataFileName DefaultEmojiDataFileName)
        (.append desc (java-str " [-emojidata " EmojiDataFileName \])))
      (when (nil? TemplateFileName)
        (set! TemplateFileName (if Csyntax DefaultCTemplateFileName DefaultJavaTemplateFileName))
        (.append desc (java-str " [-template " TemplateFileName \])))
      (when (nil? OutputFileName)
        (set! OutputFileName (if Csyntax DefaultCOutputFileName DefaultJavaOutputFileName))
        (.append desc (java-str " [-o " OutputFileName \])))
      (set! commentStart (if Csyntax "/*" "//"))
      (set! commentEnd (if Csyntax " */" ""))
      (set! commandLineDescription (.replace (.toString desc) "\\" "\\\\"))))

  (method ^:private ^:static searchBins :throws [Exception] ^void [^long/1 map ^int binsOccupied]
    (let [^:mutable ^int bitsFree 16]
      (loop [^int i 0]
        (when (< i binsOccupied)
          (set! bitsFree (unchecked-subtract-int bitsFree (aget sizes i)))
          (recur (unchecked-inc-int i))))
      (if (== binsOccupied (unchecked-subtract-int bins 1))
          (do (aset sizes binsOccupied bitsFree) (GenerateCharacter/generateForSizes map))
          (loop [^int i 1]
            (when (< i bitsFree)
              (aset sizes binsOccupied i)
              (GenerateCharacter/searchBins map (unchecked-add-int binsOccupied 1))
              (recur (unchecked-inc-int i)))))))

  (method ^:private ^:static generateForSizes :throws [Exception] ^void [^long/1 map]
    (let [^:mutable ^int sum 0]
      (set! shifts (new int/1 (alength sizes)))
      (loop [^int k (unchecked-subtract-int (alength sizes) 1)]
        (when (>= k 0)
          (aset shifts k sum)
          (set! sum (unchecked-add-int sum (aget sizes k)))
          (recur (unchecked-dec-int k))))
      (when (or (< (bit-shift-left-int 1 sum) (alength map))
                (>= (bit-shift-left-int 1 (unchecked-subtract-int sum 1)) (alength map)))
        (GenerateCharacter/FAIL
          (java-str "Bit field widths total to " sum ": wrong total for map of size " (alength map))))
      (set! tables (new long/2 (alength sizes)))
      (aset tables (unchecked-subtract-int (alength sizes) 1) map)
      (loop [^int j (unchecked-subtract-int (alength sizes) 1)]
        (when (> j 0)
          (when (and verbose (== bins 0))
            (.println System/err
                      (java-str "Building map "
                                (unchecked-add-int j 1)
                                " of bit width "
                                (aget sizes j))))
          (let [temp (GenerateCharacter/buildTable (aget tables j) (aget sizes j))]
            (aset tables (unchecked-subtract-int j 1) (aget temp 0))
            (aset tables j (aget temp 1))
            (recur (unchecked-dec-int j)))))
      (set! preshifted (new boolean/1 (alength sizes)))
      (set! zeroextend (new int/1 (alength sizes)))
      (set! bytes (new int/1 (alength sizes)))
      (loop [^int j 0]
        (when (< j (unchecked-subtract-int (alength sizes) 1))
          (let [^:mutable len (alength (aget tables (unchecked-add-int j 1)))
                size (aget sizes (unchecked-add-int j 1))]
            (cond
              (and (> len 0x100) (<= (bit-shift-right-int len size) 0x100))
                (do (set! len (bit-shift-right-int len size)) (aset preshifted j false))
              (and (> len 0x10000) (<= (bit-shift-right-int len size) 0x10000))
                (do (set! len (bit-shift-right-int len size)) (aset preshifted j false))
              :else (aset preshifted j true))
            (cond
              Csyntax (aset zeroextend j 0)
              (and (> len 0x7F) (<= len 0xFF)) (when-not useCharForByte (aset zeroextend j 0xFF))
              (and (> len 0x7FFF) (<= len 0xFFFF)) (aset zeroextend j 0xFFFF)
              :else (aset zeroextend j 0))
            (cond
              (<= len 0x100) (do (aset bytes j 1) (recur (unchecked-inc-int j)))
              (<= len 0x10000) (do (aset bytes j 2) (recur (unchecked-inc-int j)))
              :else (do (aset bytes j 4) (recur (unchecked-inc-int j)))))))
      (aset preshifted (unchecked-subtract-int (alength sizes) 1) true)
      (aset zeroextend (unchecked-subtract-int (alength sizes) 1) 0)
      (aset bytes (unchecked-subtract-int (alength sizes) 1) 0)
      (if (> bins 0)
          (let [totalBytes (GenerateCharacter/getTotalBytes)
                access (GenerateCharacter/genAccess "A" "ch" (if identifiers 2 32))
                ^:mutable ^int accessComplexity 0]
            (let [^:mutable ^int j 0]
              (while (< j (.length access))
                (let [ch (.charAt access j)]
                  (when (>= (.indexOf "[&|><" ch) 0)
                    (set! accessComplexity (unchecked-inc-int accessComplexity)))
                  (when (or (== ch \<) (== ch \>)) (set! j (unchecked-inc-int j))))
                (set! j (unchecked-inc-int j))))
            (.print System/out "(")
            (for-each [^int size sizes] (.print System/out (java-str " " size)))
            (.println System/out (java-str " ) " totalBytes " " accessComplexity " " access)))
          (do
            (when verbose
              (.println System/out "    n\t size\tlength\tshift\tzeroext\tbytes\tpreshifted")
              (loop [^int j 0]
                (when (< j (alength sizes))
                  (.println System/out
                            (java-str (GenerateCharacter/dec5 j)
                                      "\t"
                                      (GenerateCharacter/dec5 (aget sizes j))
                                      "\t"
                                      (GenerateCharacter/dec5 (alength (aget tables j)))
                                      "\t"
                                      (GenerateCharacter/dec5 (aget shifts j))
                                      "\t"
                                      (GenerateCharacter/dec5 (aget zeroextend j))
                                      "\t"
                                      (GenerateCharacter/dec5 (aget bytes j))
                                      "\t "
                                      (aget preshifted j)))
                  (recur (unchecked-inc-int j)))))
            (when verbose
              (.println System/out "Generating source code for class Character")
              (.println System/out
                        (java-str "A table access looks like "
                                  (GenerateCharacter/genAccess "A" "ch" (if identifiers 2 32)))))
            (GenerateCharacter/generateCharacterClass TemplateFileName OutputFileName)))))

  (method ^:public ^:static main ^void [^String/1 args]
    (GenerateCharacter/processArgs args)
    (try
      (let [data (UnicodeSpec/readSpecFile (File. UnicodeSpecFileName) plane)]
        (set! specialCaseMaps (SpecialCaseMap/readSpecFile (File. SpecialCasingFileName) plane))
        (let [propList (PropList/readSpecFile (File. PropListFileName) plane)]
          (.putAll propList (PropList/readSpecFile (File. DerivedPropsFileName) plane))
          (let [emojiData (EmojiData/readSpecFile
                            (Paths/get EmojiDataFileName (new String/1 []))
                            plane)]
            (when verbose
              (.println System/out
                        (java-str (alength data)
                                  " items read from Unicode spec file "
                                  UnicodeSpecFileName)))
            (let [map (GenerateCharacter/buildMap data specialCaseMaps propList emojiData)]
              (when verbose (.println System/err "Completed building of initial map"))
              (if (== bins 0)
                  (GenerateCharacter/generateForSizes map)
                  (while (> bins 0)
                    (set! sizes (new int/1 bins))
                    (GenerateCharacter/searchBins map 0)
                    (set! bins (unchecked-dec-int bins))))
              (when (and verbose false)
                (.println System/out
                          (java-str "Offset range seen: -"
                                    (GenerateCharacter/hex8 (unchecked-negate-int minOffsetSeen))
                                    "..+"
                                    (GenerateCharacter/hex8 maxOffsetSeen)))
                (.println System/out
                          (java-str "          allowed: -"
                                    (GenerateCharacter/hex8 (unchecked-negate-int minOffset))
                                    "..+"
                                    (GenerateCharacter/hex8 maxOffset))))))))
      (catch IOException e (GenerateCharacter/FAIL (.toString e)))
      (catch Throwable e
        (.println System/out "Unexpected exception:")
        (.printStackTrace e)
        (GenerateCharacter/FAIL "Unexpected exception!")))
    (when verbose (.println System/out "Done!"))))

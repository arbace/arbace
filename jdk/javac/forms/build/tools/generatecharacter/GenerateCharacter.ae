          (== (.-generalCategory us) UnicodeSpec/CONNECTOR_PUNCTUATION)
            (set! resultA (bit-or resultA valueJavaStartUnicodePart))
          (== (.-generalCategory us) UnicodeSpec/CURRENCY_SYMBOL)
            (set! resultA (bit-or resultA valueJavaOnlyStart))
          (or (or (or (and (>= c 0x0000) (<= c 0x0008)) (and (>= c 0x000E) (<= c 0x001B)))
                  (and (>= c 0x007F) (<= c 0x009F)))
              (== (.-generalCategory us) UnicodeSpec/FORMAT))
            (set! resultA (bit-or resultA valueIgnorable))
          (or (or (== (.-generalCategory us) UnicodeSpec/SPACE_SEPARATOR)
                  (== (.-generalCategory us) UnicodeSpec/LINE_SEPARATOR))
              (== (.-generalCategory us) UnicodeSpec/PARAGRAPH_SEPARATOR))
            (when-not (GenerateCharacter/isInvalidJavaWhiteSpace c)
              (set! resultA (bit-or resultA valueJavaWhitespace)))
          (or (and (>= c 0x0009) (<= c 0x000D)) (and (>= c 0x001C) (<= c 0x001F)))
            (set! resultA (bit-or resultA valueJavaWhitespace)))

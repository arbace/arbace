                  (set! resultA (bit-or resultA valueJavaSupradecimal)))
              (and (>= c 0xFF21) (<= c 0xFF3A))
                (do
                  (set! val (unchecked-subtract-int c 0xFF21))
                  (set! resultA (bit-or resultA valueJavaSupradecimal)))
              (and (>= c 0xFF41) (<= c 0xFF5A))
                (do
                  (set! val (unchecked-subtract-int c 0xFF41))
                  (set! resultA (bit-or resultA valueJavaSupradecimal)))
              (.isDecimalValue us)
                (do (set! val (.-decimalValue us)) (set! resultA (bit-or resultA valueDigit)))
              (.isDigitValue us)
                (do (set! val (.-digitValue us)) (set! resultA (bit-or resultA valueDigit)))
              (== (.length (.-numericValue us)) 0) (break :NUMERIC)
              :else
                (do
                  (try
                    (set! val (Integer/parseInt (.-numericValue us)))
                    (when (or (>= val 32) (< val 0)) (break :STRANGE))
                    (when (== c 0x215F) (break :STRANGE))
                    (catch NumberFormatException e (break :STRANGE)))
                  (set! resultA (bit-or resultA valueDigit))))
            (when-not (or (>= val 32) (< val 0))
              (set! resultA
                    (bit-or resultA
                            (bit-shift-left-int
                              (bit-and-int (unchecked-subtract-int val c) maskDigit)
                              shiftDigitOffset)))
              (break :NUMERIC))))
        (set! resultA (bit-or resultA valueStrangeNumeric)))
      (let [^:mutable ^int offset 0
            specialMap (SpecialCaseMap/find c specialCaseMaps)
            bHasUpper (or (.hasUpperMap us) (not (== specialMap -1)))]
        (when bHasUpper (set! resultA (bit-or resultA maskUpperCase)))
        (cond
          (not (== specialMap -1)) (set! offset -1)
          (.hasUpperMap us) (set! offset (unchecked-subtract-int c (.-upperMap us))))
        (when (.hasLowerMap us)
          (set! resultA (bit-or resultA maskLowerCase))
          (if (== offset 0)
              (set! offset (unchecked-subtract-int (.-lowerMap us) c))
              (when-not (== offset (unchecked-subtract-int (.-lowerMap us) c))

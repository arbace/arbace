        (cond
          (or (or (or (or (or (== (.-generalCategory us) UnicodeSpec/LOWERCASE_LETTER)
                              (== (.-generalCategory us) UnicodeSpec/UPPERCASE_LETTER))
                          (== (.-generalCategory us) UnicodeSpec/TITLECASE_LETTER))
                      (== (.-generalCategory us) UnicodeSpec/MODIFIER_LETTER))
                  (== (.-generalCategory us) UnicodeSpec/OTHER_LETTER))
              (== (.-generalCategory us) UnicodeSpec/LETTER_NUMBER))
            (set! resultA (bit-or resultA valueJavaUnicodeStart))
          (or (or (== (.-generalCategory us) UnicodeSpec/COMBINING_SPACING_MARK)
                  (== (.-generalCategory us) UnicodeSpec/NON_SPACING_MARK))
              (== (.-generalCategory us) UnicodeSpec/DECIMAL_DIGIT_NUMBER))

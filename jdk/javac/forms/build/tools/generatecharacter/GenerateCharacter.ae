  (method ^:static buildOne ^long [^int c ^UnicodeSpec us ^SpecialCaseMap/1 specialMaps]
    (let [^:mutable resultA 0]
      (set! resultA (bit-or resultA (.-generalCategory us)))
      (cond
        (== resultA Character/UPPERCASE_LETTER) (set! resultA (bit-or resultA maskOtherUppercase))
        (== resultA Character/LOWERCASE_LETTER) (set! resultA (bit-or resultA maskOtherLowercase)))
      (label :NUMERIC

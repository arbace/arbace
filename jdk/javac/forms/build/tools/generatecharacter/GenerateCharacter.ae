                      (aset result
                            k
                            (GenerateCharacter/buildOne codePoint (aget data j) specialMaps))
                      (set! k (unchecked-inc-int k))
                      (set! codePoint (unchecked-inc-int codePoint)))
                    (while (and (< codePoint (.-codePoint (aget data j))) (< k (alength result)))

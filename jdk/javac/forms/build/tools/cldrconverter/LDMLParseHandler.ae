  (field ^:private ^:static ^:final ^String/1 CONTEXTS (new String/1 ["stand-alone" "format"]))

  (field ^:private ^:static ^:final ^String/1 WIDTHS (new String/1 ["wide" "narrow" "abbreviated"]))

  (field ^:private ^:static ^:final ^String/1 LENGTHS
    (new String/1 ["full" "long" "medium" "short"]))

  (method ^:private populateWidthAlias ^void [this ^String type ^{:tag (Set String)} keys]
    (for-each [^String context CONTEXTS]
      (for-each [^String width WIDTHS]
        (let [keyName (.toJDKKey this (java-str type "Width") context width)]
          (when (> (.length keyName) 0) (.add keys (java-str keyName "," context "," width)))))))

  (method ^:private populateFormatLengthAlias ^void [this ^String type ^{:tag (Set String)} keys]
    (for-each [^String length LENGTHS]
      (let [keyName (.toJDKKey this (java-str type "FormatLength") currentContext length)]
        (when (> (.length keyName) 0) (.add keys (java-str keyName "," currentContext "," length))))))

  (method ^:private populateAliasKeys ^{:tag (Set String)} [this ^String qName ^String context
                                                            ^String width]
    (let [^{:tag (HashSet String)} ret (HashSet.)
          keyName qName]
      (switch qName
        ("monthWidth" "dayWidth"
                      "quarterWidth"
                      "dayPeriodWidth"
                      "dateFormatLength"
                      "timeFormatLength"
                      "dateTimeFormatLength"
                      "eraNames"
                      "eraAbbr"
                      "eraNarrow")
          (.add ret (java-str (.toJDKKey this qName context width) "," context "," width))
        "days" (.populateWidthAlias this "day" ret)
        "months" (.populateWidthAlias this "month" ret)
        "quarters" (.populateWidthAlias this "quarter" ret)
        "dayPeriods" (.populateWidthAlias this "dayPeriod" ret)
        "eras"
          (do
            (.add ret (java-str (.toJDKKey this "eraNames" context width) "," context "," width))
            (.add ret (java-str (.toJDKKey this "eraAbbr" context width) "," context "," width))
            (.add ret (java-str (.toJDKKey this "eraNarrow" context width) "," context "," width)))
        "dateFormats" (.populateFormatLengthAlias this "date" ret)
        "timeFormats" (.populateFormatLengthAlias this "time" ret)
        nil)
      ret))

  (method ^:private translateWidthAlias ^String [this ^String qName ^String context ^String width]
    (let [^:mutable keyName qName
          type (java-str (Character/toUpperCase (.charAt qName 0))
                         (.substring qName 1 (.indexOf qName "Width")))]
      (switch width
        "wide" (set! keyName (java-str type "Names/" context))
        "abbreviated" (set! keyName (java-str type "Abbreviations/" context))
        "narrow" (set! keyName (java-str type "Narrows/" context))
        (java-assert false))
      keyName))

  (method ^:private toJDKKey ^String [this ^String containerqName ^String context ^String type]
    (let [^:mutable keyName containerqName]
      (switch containerqName
        ("monthWidth" "dayWidth" "quarterWidth")
          (set! keyName (.translateWidthAlias this keyName context type))
        "dayPeriodWidth"
          (switch type
            "wide" (set! keyName (java-str "AmPmMarkers/" context))
            "narrow" (set! keyName (java-str "narrow.AmPmMarkers/" context))
            "abbreviated" (set! keyName (java-str "abbreviated.AmPmMarkers/" context)))
        ("dateFormatLength" "timeFormatLength" "dateTimeFormatLength")
          (set! keyName
                (java-str "DateTimePatterns/"
                          type
                          "-"
                          (.substring keyName 0 (.indexOf keyName "FormatLength"))))
        "eraNames" (set! keyName "long.Eras")
        "eraAbbr" (set! keyName "Eras")
        "eraNarrow" (set! keyName "narrow.Eras")
        ("dateFormats" "timeFormats" "days" "months" "quarters" "dayPeriods" "eras") nil
        "decimalFormatLength" (set! keyName (java-str type ".CompactNumberPatterns"))
        ("currencyFormat" "percentFormat")
          (set! keyName
                (java-str currentNumberingSystem
                          "NumberPatterns/"
                          (if (.equals type "standard")
                              (.replaceFirst containerqName "Format" "")
                              type)))
        "listPattern" (set! keyName type)
        (set! keyName ""))
      keyName))

  (method ^:private getTarget ^String [this ^String path ^:mutable ^String calType
                                       ^:mutable ^String context ^:mutable ^String width]
    (let [lastSlash (.lastIndexOf path \/)
          ^:mutable qName (.substring path (unchecked-add-int lastSlash 1))
          bracket (.indexOf qName \[)]
      (when-not (== bracket -1) (set! qName (.substring qName 0 bracket)))
      (let [^:mutable typeKey "/calendar[@type='"
            ^:mutable start (.indexOf path typeKey)]
        (when-not (== start -1)
          (set! calType
                (.substring path
                            (unchecked-add-int start (.length typeKey))
                            (.indexOf path "']" start))))
        (set! typeKey "Context[@type='")
        (set! start (.indexOf path typeKey))
        (when-not (== start -1)
          (set! context
                (.substring path
                            (unchecked-add-int start (.length typeKey))
                            (.indexOf path "']" start))))
        (set! typeKey "Width[@type='")
        (set! start (.indexOf path typeKey))
        (when-not (== start -1)
          (set! width
                (.substring path
                            (unchecked-add-int start (.length typeKey))
                            (.indexOf path "']" start))))
        (set! typeKey "decimalFormatLength[@type='")
        (set! start (.indexOf path typeKey))
        (if (not (== start -1))
            (let [style (.substring path
                                    (unchecked-add-int start (.length typeKey))
                                    (.indexOf path "']" start))]
              (.toJDKKey this qName "" style))
            (do
              (set! typeKey "currencyFormat[@type='")
              (set! start (.indexOf path typeKey))
              (if (not (== start -1))
                  (let [style (.substring path
                                          (unchecked-add-int start (.length typeKey))
                                          (.indexOf path "']" start))]
                    (.toJDKKey this qName "" style))
                  (do
                    (set! typeKey "percentFormat[@type='")
                    (set! start (.indexOf path typeKey))
                    (cond
                      (not (== start -1))
                        (let [style (.substring path
                                                (unchecked-add-int start (.length typeKey))
                                                (.indexOf path "']" start))]
                          (.toJDKKey this qName "" style))
                      (not (== (.indexOf path "../listPattern") -1))
                        (do
                          (set! typeKey "[@type='")
                          (set! start (.indexOf path typeKey))
                          (let [^String style (if (not (== start -1))
                                                  (java-str
                                                    "ListPatterns_"
                                                    (.substring
                                                      path
                                                      (unchecked-add-int start (.length typeKey))
                                                      (.indexOf path "']" start)))
                                                  "ListPatterns_standard")]
                            (.toJDKKey this qName "" style)))
                      :else (java-str calType "." (.toJDKKey this qName context width))))))))))

  (method ^:public endElement :throws [SAXException] ^void [this ^String uri ^String localName
                                                            ^String qName]
    (java-assert (.equals qName (.getqName (.-currentContainer this)))
      (java-str "current=" (.getqName (.-currentContainer this)) ", param=" qName))
    (switch qName
      "calendar"
        (do
          (java-assert (not (instance? Entry (.-currentContainer this))))
          (set! currentCalendarType nil))
      "defaultNumberingSystem"
        (if (instance? StringEntry (.-currentContainer this))
            (set! defaultNumberingSystem (cast String (.putIfEntry this)))
            (set! defaultNumberingSystem nil))
      "timeZoneNames" (set! zonePrefix nil)
      ("generic" "standard" "daylight" "exemplarCity")
        (when (and (some? zonePrefix) (instance? Entry (.-currentContainer this)))
          (let [^{:tag (Map String String)} valmap (cast
                                                     Map
                                                     (.get
                                                       this
                                                       (java-str zonePrefix (.getContainerKey this))))
                ^{:tag (Entry ?)} entry (cast Entry (.-currentContainer this))]
            (if (.equals qName "exemplarCity")
                (.put this
                      (java-str CLDRConverter/EXEMPLAR_CITY_PREFIX (.getContainerKey this))
                      (cast String (.getValue entry)))
                (.put valmap (.getKey entry) (cast String (.getValue entry))))))
      ("monthWidth" "dayWidth" "dayPeriodWidth" "quarterWidth")
        (do (set! currentWidth "") (.putIfEntry this))
      ("monthContext" "dayContext" "dayPeriodContext" "quarterContext")
        (do (set! currentContext "") (.putIfEntry this))
      "decimalFormatLength" (do (set! currentStyle "") (.putIfEntry this))
      ("currencyFormats" "decimalFormats" "percentFormats" "symbols")
        (do (set! currentNumberingSystem "") (.putIfEntry this))
      ("dateFormatLength" "dateTimeFormatLength" "timeFormatLength") (set! currentStyle "")
      "listPattern" (do (set! currentStyle "") (.putIfEntry this))
      "parseLenient"
        (when-instance [^StringEntry se (.-currentContainer this)]
          (.put this (.getKey se) (.replaceAll (.getValue se) "[\\[\\]\\\\ ]" "")))
      (.putIfEntry this))
    (set! (.-currentContainer this) (.getParent (.-currentContainer this))))

  (method ^:private putIfEntry [this]
    (cond
      (instance? AliasEntry (.-currentContainer this))
        (let [^{:tag (Entry ?)} entry (cast Entry (.-currentContainer this))
              containerqName (.getqName (.getParent entry))]
          (cond
            (.equals containerqName "decimalFormatLength")
              (let [srcKey (.toJDKKey this containerqName "" currentStyle)
                    targetKey (.getTarget this (.getKey entry) "" "" "")]
                (.put CLDRConverter/aliases srcKey targetKey))
            (or (.equals containerqName "currencyFormat") (.equals containerqName "percentFormat"))
              (let [kc (cast KeyContainer (.getParent entry))]
                (.put CLDRConverter/aliases
                      (.toJDKKey this containerqName "" (.getKey kc))
                      (.getTarget this (.getKey entry) "" "" "")))
            (.equals containerqName "listPattern")
              (let [sae (cast StringArrayEntry (.getParent entry))]
                (.put CLDRConverter/aliases
                      (.toJDKKey this containerqName "" (.getKey sae))
                      (.getTarget this (.getKey entry) "" "" "")))
            :else
              (let [^{:tag (Set String)} keyNames (.populateAliasKeys
                                                    this
                                                    containerqName
                                                    currentContext
                                                    currentWidth)]
                (when-not (.isEmpty keyNames)
                  (for-each [^String keyName keyNames]
                    (let [tmp (.split keyName "," 3)
                          calType (.lname currentCalendarType)
                          src (java-str calType "." (aget tmp 0))
                          ^:mutable target (.getTarget
                                             this
                                             (.getKey entry)
                                             calType
                                             ^String (if (> (.length (aget tmp 1)) 0)
                                                         (aget tmp 1)
                                                         currentContext)
                                             ^String (if (> (.length (aget tmp 2)) 0)
                                                         (aget tmp 2)
                                                         currentWidth))]
                      (when (.equals (.substring
                                       target
                                       (unchecked-add-int (.lastIndexOf target \.) 1))
                                     containerqName)
                        (set!
                          target
                          (java-str (.substring target 0 (.indexOf target \.)) "." (aget tmp 0))))
                      (.put CLDRConverter/aliases
                            (.replaceFirst src "^gregorian." "")
                            (.replaceFirst target "^gregorian." ""))))))))
      (instance? Entry (.-currentContainer this))
        (let [^{:tag (Entry ?)} entry (cast Entry (.-currentContainer this))
              ^:mutable value (.getValue entry)]
          (when (some? value)
            (let [key (.getKey entry)]
              (when (and (.equals id "root") (.startsWith key "MonthNames"))
                (set! value (.getShortMonths (DateFormatSymbols. Locale/US))))
              (return (.put this key value))))))
    nil)

  (method ^:public convertOldKeyName ^String [this ^String key]
    (switch key "calendar" "ca" "currency" "cu" "collation" "co" "numbers" "nu" "timezone" "tz" key))

  (method ^:private addNumberingScript ^void [this ^String script]
    (let [^:mutable ^{:tag (List String)} numberingScripts (cast
                                                             List
                                                             (.get this "numberingScripts"))]
      (when (nil? numberingScripts)
        (set! numberingScripts (ArrayList.))
        (.put this "numberingScripts" numberingScripts))
      (when-not (.contains numberingScripts script) (.add numberingScripts script)))))

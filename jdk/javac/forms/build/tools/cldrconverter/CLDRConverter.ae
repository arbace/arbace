  (method ^:private ^:static enableFileAccess :throws [SAXNotSupportedException] ^void [^SAXParser parser]
    (try
      (.setProperty parser "http://javax.xml.XMLConstants/property/accessExternalDTD" "file")
      (catch SAXNotRecognizedException ignore)))

  (method ^:private ^:static readBundleList :throws [Exception] ^{:tag (List Bundle)} []
    (let [^{:tag (List Bundle)} retList (ArrayList.)
          path (.getPath (FileSystems/getDefault) SOURCE_FILE_DIR)
          coverageMap (CLDRConverter/coverageLevelsMap)]
      (with-resources [^{:tag (DirectoryStream Path)} dirStr (Files/newDirectoryStream path)]
        (for-each [^Path entry dirStr]
          (let [fileName (.toString (.getFileName entry))]
            (when (.endsWith fileName ".xml")
              (let [id (.substring fileName 0 (.indexOf fileName \.))
                    cldrLoc (Locale/forLanguageTag (CLDRConverter/toLanguageTag id))
                    ^{:tag (List Locale)} candList (CLDRConverter/getCandidateLocales cldrLoc)]
                (when-not (and (not (.equals "root" id))
                               (.noneMatch (.stream candList)
                                           (method-ref
                                             Predicate
                                             [Locale]
                                             coverageMap
                                             Map/.containsKey)))
                  (let [sb (CLDRConverter/getCandLocales candList)]
                    (when (== (.indexOf sb "root") -1) (.append sb "root"))
                    (.add retList (Bundle. id (.toString sb) nil nil)))))))))
      (.sort retList
             (lambda Comparator ^int [^Bundle o1 ^Bundle o2]
               (let [^:mutable id1 (.getID o1)
                     ^:mutable id2 (.getID o2)]
                 (when (.equals id1 "root") (set! id1 ""))
                 (when (.equals id2 "root") (set! id2 ""))
                 (.compareTo id1 id2))))
      retList))

  (field ^:private ^:static ^:final ^{:tag (Map String (Map String Object))} cldrBundles (HashMap.))

  (field ^:private ^:static ^{:tag (Map String (SortedSet String))} metaInfo (HashMap.))

  (static-initializer (.put metaInfo "AvailableLocales" (TreeSet.)))

  (method ^:static getCLDRBundle :throws [Exception] ^{:tag (Map String Object)} [^String id]
    (let [^:mutable ^{:tag (Map String Object)} bundle (cast Map (.get cldrBundles id))]
      (if (some? bundle)
          bundle
          (let [file (File. (java-str SOURCE_FILE_DIR File/separator id ".xml"))]
            (if (not (.exists file))
                (Collections/emptyMap)
                (do
                  (CLDRConverter/info "..... main directory .....")
                  (let [handler (LDMLParseHandler. id)]
                    (CLDRConverter/parseLDMLFile file handler)
                    (set! bundle (.getData handler))
                    (.put cldrBundles id bundle)
                    (when (.equals id "root")
                      (set! bundle (.getData handlerSuppl "root"))
                      (when (some? bundle)
                        (let [^{:tag (Map String Object)} temp (cast Map (.remove cldrBundles id))]
                          (.putAll bundle temp)
                          (.put cldrBundles id bundle))))
                    bundle)))))))

  (method ^:private ^:static parseSupplemental :throws [Exception] ^void []
    (set! handlerSuppl (SupplementalDataParseHandler.))
    (CLDRConverter/parseLDMLFile (File. SPPL_SOURCE_FILE) handlerSuppl)
    (let [^{:tag (Map String Object)} parentData (.getData handlerSuppl "root")]
      (.forEach
        (.filter (.stream (.keySet parentData))
                 (lambda Predicate ^boolean [^String key] (.startsWith key PARENT_LOCALE_PREFIX)))
        (lambda Consumer ^void [^String key]
          (.put parentLocalesMap
                key
                (TreeSet. (Arrays/asList (.split (cast String (.get parentData key)) " "))))))
      (set! handlerNumbering (NumberingSystemsParseHandler.))
      (CLDRConverter/parseLDMLFile (File. NUMBERING_SOURCE_FILE) handlerNumbering)
      (set! handlerMetaZones (MetaZonesParseHandler.))
      (CLDRConverter/parseLDMLFile (File. METAZONES_SOURCE_FILE) handlerMetaZones)
      (set! handlerLikelySubtags (LikelySubtagsParseHandler.))
      (CLDRConverter/parseLDMLFile (File. LIKELYSUBTAGS_SOURCE_FILE) handlerLikelySubtags)
      (.forEach (.getData handlerLikelySubtags)
                (lambda BiConsumer ^void [^String from ^String to]
                  (when-not (.contains from "-")
                    (let [script (aget (.split to "-") 1)
                          key (java-str LIKELY_SCRIPT_PREFIX script)
                          prev (cast SortedSet
                                     (.putIfAbsent likelyScriptMap key (TreeSet. (Set/of from))))]
                      (when (some? prev) (.add prev from))))))
      (set! handlerSupplMeta (SupplementalMetadataParseHandler.))
      (CLDRConverter/parseLDMLFile (File. SPPL_META_SOURCE_FILE) handlerSupplMeta)
      (set! handlerWinZones (WinZonesParseHandler.))
      (CLDRConverter/parseLDMLFile (File. WINZONES_SOURCE_FILE) handlerWinZones)
      (set! handlerPlurals (PluralsParseHandler.))
      (CLDRConverter/parseLDMLFile (File. PLURALS_SOURCE_FILE) handlerPlurals)
      (set! handlerDayPeriodRule (DayPeriodRuleParseHandler.))
      (CLDRConverter/parseLDMLFile (File. DAYPERIODRULE_SOURCE_FILE) handlerDayPeriodRule)))

  (method ^:private ^:static parseBCP47 :throws [Exception] ^void []
    (set! handlerTimeZone (TimeZoneParseHandler.))
    (CLDRConverter/parseLDMLFile (File. TIMEZONE_SOURCE_FILE) handlerTimeZone)
    (.forEach (.getData handlerTimeZone)
              (lambda BiConsumer ^void [^String k v]
                (let [ids (.split (cast String v) "\\s")]
                  (loop [^int i 1]
                    (when (< i (alength ids))
                      (.put canonicalTZMap (aget ids i) (aget ids 0))
                      (recur (unchecked-inc-int i))))))))

  (method ^:private ^:static parseLDMLFile :throws [Exception] ^void [^File srcfile
                                                                      ^{:tag (AbstractLDMLHandler ?)} handler]
    (CLDRConverter/info (java-str "..... Parsing " (.getName srcfile) " ....."))
    (let [pf (SAXParserFactory/newInstance)]
      (.setValidating pf true)
      (let [parser (.newSAXParser pf)]
        (CLDRConverter/enableFileAccess parser)
        (.parse parser srcfile handler))))

  (method ^:private ^:static getCandLocales ^StringBuilder [^{:tag (List Locale)} candList]
    (let [sb (StringBuilder.)]
      (for-each [^Locale loc candList]
        (when-not (.equals loc Locale/ROOT)
          (.append sb (CLDRConverter/toLocaleName (.toLanguageTag loc)))
          (.append sb ",")))
      sb))

  (method ^:private ^:static getCandidateLocales ^{:tag (List Locale)} [^Locale cldrLoc]
    (let [^:mutable ^{:tag (List Locale)} candList (ArrayList.)]
      (set! candList (CLDRConverter/applyParentLocales "" (.getCandidateLocales defCon "" cldrLoc)))
      candList))

  (method ^:private ^:static convertBundles :throws [Exception] ^void [^{:tag (List Bundle)} bundles]
    (let [availableLangTags (cast SortedSet (.get metaInfo "AvailableLocales"))]
      (when isBaseModule (.putAll metaInfo parentLocalesMap) (.putAll metaInfo likelyScriptMap))
      (for-each [^Bundle bundle bundles]
        (let [^{:tag (Map String Object)} targetMap (.getTargetMap bundle)
              ^{:tag (EnumSet Bundle$Type)} bundleTypes (.getBundleTypes bundle)
              id (.getID bundle)]
          (when (.isRoot bundle) (.put targetMap "DateTimePatternChars" "GyMdkHmsSEDFwWahKzZ"))
          (when (.contains bundleTypes Bundle$Type/LOCALENAMES)
            (let [^{:tag (Map String Object)} localeNamesMap (CLDRConverter/extractLocaleNames
                                                               targetMap
                                                               id)]
              (when (or (not (.isEmpty localeNamesMap)) (.isRoot bundle))
                (.generateBundle bundleGenerator
                                 "util"
                                 "LocaleNames"
                                 id
                                 true
                                 localeNamesMap
                                 BundleGenerator$BundleType/OPEN))))
          (when (.contains bundleTypes Bundle$Type/CURRENCYNAMES)
            (let [^{:tag (Map String Object)} currencyNamesMap (CLDRConverter/extractCurrencyNames
                                                                 targetMap
                                                                 id
                                                                 (.getCurrencies bundle))]
              (when (or (not (.isEmpty currencyNamesMap)) (.isRoot bundle))
                (.generateBundle bundleGenerator
                                 "util"
                                 "CurrencyNames"
                                 id
                                 true
                                 currencyNamesMap
                                 BundleGenerator$BundleType/OPEN))))
          (when (.contains bundleTypes Bundle$Type/TIMEZONENAMES)
            (let [^{:tag (Map String Object)} zoneNamesMap (CLDRConverter/extractZoneNames
                                                             targetMap
                                                             id)]
              (when (or (not (.isEmpty zoneNamesMap)) (.isRoot bundle))
                (.generateBundle bundleGenerator
                                 "util"
                                 "TimeZoneNames"
                                 id
                                 true
                                 zoneNamesMap
                                 BundleGenerator$BundleType/TIMEZONE))))
          (when (.contains bundleTypes Bundle$Type/CALENDARDATA)
            (let [^{:tag (Map String Object)} calendarDataMap (CLDRConverter/extractCalendarData
                                                                targetMap
                                                                id)]
              (when (or (not (.isEmpty calendarDataMap)) (.isRoot bundle))
                (.generateBundle bundleGenerator
                                 "util"
                                 "CalendarData"
                                 id
                                 true
                                 calendarDataMap
                                 BundleGenerator$BundleType/PLAIN))))
          (when (.contains bundleTypes Bundle$Type/FORMATDATA)
            (let [^{:tag (Map String Object)} formatDataMap (CLDRConverter/extractFormatData
                                                              targetMap
                                                              id)]
              (when (or (not (.isEmpty formatDataMap)) (.isRoot bundle))
                (.generateBundle bundleGenerator
                                 "text"
                                 "FormatData"
                                 id
                                 true
                                 formatDataMap
                                 BundleGenerator$BundleType/PLAIN))))
          (let [langTag (CLDRConverter/toLanguageTag id)]
            (.add availableLangTags langTag)
            (CLDRConverter/addLikelySubtags langTag))))
      (.forEach (.filter (.map (.filter (.stream (.entrySet (.getData handlerLikelySubtags)))
                                        (lambda Predicate ^boolean [^Map$Entry e]
                                          (.contains availableLangTags (.getValue e))))
                               (method-ref Function ^String [Map$Entry] Map$Entry/.getKey))
                         (lambda Predicate ^boolean [^String t]
                           (and (and (not (.equals t "in")) (not (.equals t "iw")))
                                (not (.equals t "ji")))))
                (method-ref Consumer [String] availableLangTags SortedSet/.add))
      (.generateMetaInfo bundleGenerator metaInfo)))

  (field ^:static ^:final ^{:tag (Map String String)} aliases (HashMap.))

  (method ^:static handleAliases ^void [^{:tag (Map String Object)} bundleMap]
    (for-each [^String key (.keySet aliases)]
      (let [^:mutable sourceKey (cast String (.get aliases key))]
        (when (.startsWith key "ListPatterns_")
          (let [^:mutable ^String k nil]
            (while (some? (set! k (cast String (.get aliases sourceKey)))) (set! sourceKey k))))
        (let [source (.get bundleMap sourceKey)]
          (when (some? source)
            (when-instance [^String/1 sa (.get bundleMap key)]
              (loop [^int i 0]
                (if (< i (alength sa))
                    (if (and (nil? (aget sa i)) (some? (aget (cast String/1 source) i)))
                        (do
                          (aset sa i (aget (cast String/1 source) i))
                          (recur (unchecked-inc-int i)))
                        (recur (unchecked-inc-int i)))
                    nil)))
            (.putIfAbsent bundleMap key source))))))

  (method ^:static getLanguageCode ^String [^String id]
    (if (.equals "root" id) "" (.getLanguage (Locale/forLanguageTag (.replaceAll id "_" "-")))))

  (method ^:static getCountryCode ^String [^String id]
    (let [rgn (CLDRConverter/getRegionCode id)] (when (== (.length rgn) 2) rgn)))

  (method ^:static getRegionCode ^String [^String id]
    (.getCountry (Locale/forLanguageTag (.replaceAll id "_" "-"))))

  (method ^:static getScriptCode ^String [^String id]
    (.getScript (Locale/forLanguageTag (.replaceAll id "_" "-"))))

  (defclass ^:private ^:static KeyComparator
    :implements [(Comparator String)]

    (field ^:static ^KeyComparator INSTANCE (KeyComparator.))

    (constructor ^:private [this])

    (method ^:public compare ^int [this ^String o1 ^String o2]
      (let [len1 (.length o1)
            len2 (.length o2)]
        (when (and (not (.isDigit this (.charAt o1 0))) (not (.isDigit this (.charAt o2 0))))
          (when (< len1 len2) (return -1))
          (when (> len1 len2) (return 1)))
        (.compareTo o1 o2)))

    (method ^:private isDigit ^boolean [this ^char c]
      (and (>= c \0) (<= c \9))))

  (method ^:private ^:static extractLocaleNames ^{:tag (Map String Object)} [^{:tag (Map String Object)} map
                                                                             ^String id]
    (let [^{:tag (Map String Object)} localeNames (TreeMap. KeyComparator/INSTANCE)]
      (for-each [^String key (.keySet map)]
        (when (.startsWith key LOCALE_NAME_PREFIX)
          (switch key
            LOCALE_SEPARATOR (.put localeNames "ListCompositionPattern" (.get map key))
            LOCALE_KEYTYPE (.put localeNames "ListKeyTypePattern" (.get map key))
            (.put localeNames (.substring key (.length LOCALE_NAME_PREFIX)) (.get map key)))))
      (when (.equals id "root")
        (.put localeNames "DisplayNamePattern" "{0,choice,0#|1#{1}|2#{1} ({2})}"))
      localeNames))

  (method ^:private ^:static extractCurrencyNames :throws [Exception] ^{:tag (Map String Object)} [^{:tag (Map String Object)} map
                                                                                                   ^String id
                                                                                                   ^String names]
    (let [^{:tag (Map String Object)} currencyNames (TreeMap. KeyComparator/INSTANCE)]
      (for-each [^String key (.keySet map)]
        (cond
          (.startsWith key CURRENCY_NAME_PREFIX)
            (.put currencyNames (.substring key (.length CURRENCY_NAME_PREFIX)) (.get map key))
          (.startsWith key CURRENCY_SYMBOL_PREFIX)
            (.put currencyNames (.substring key (.length CURRENCY_SYMBOL_PREFIX)) (.get map key))))
      currencyNames))

  (method ^:private ^:static extractZoneNames ^{:tag (Map String Object)} [^{:tag (Map String Object)} map
                                                                           ^String id]
    (let [^{:tag (Map String Object)} names (TreeMap. KeyComparator/INSTANCE)
          availableIds (CLDRConverter/getAvailableZoneIds)]
      (.forEach availableIds
                (lambda Consumer ^void [^String tzid]
                  (let [tzKey (cast String
                                    (.orElse (Optional/ofNullable
                                               (cast String (.get handlerSupplMeta tzid)))
                                             tzid))
                        ^:mutable tzLink (CLDRConverter/getTZDBLink tzKey)]
                    (when (and (nil? tzLink) (.containsValue tzdbLinks tzKey))
                      (set! tzLink
                            (cast String
                                  (.orElse (.findAny
                                             (.map
                                               (.filter
                                                 (.stream (.entrySet tzdbLinks))
                                                 (lambda Predicate ^boolean [^Map$Entry e]
                                                   (.equals (cast String (.getValue e)) tzKey)))
                                               (method-ref
                                                 Function
                                                 ^String [Map$Entry]
                                                 Map$Entry/.getKey)))
                                           nil))))
                    (let [^:mutable data (.get map (java-str TIMEZONE_ID_PREFIX tzKey))]
                      (when (and (nil? data) (some? tzLink))
                        (set! data (.get map (java-str TIMEZONE_ID_PREFIX tzLink))))
                      (if-instance [^:mutable ^String/1 tznames data]
                        (if (and (.equals tzid "Etc/UTC")
                                 (not (.containsKey map (java-str TIMEZONE_ID_PREFIX "UTC"))))
                            (do
                              (.put names
                                    (java-str METAZONE_ID_PREFIX META_ETCUTC_ZONE_NAME)
                                    tznames)
                              (.put names tzid META_ETCUTC_ZONE_NAME)
                              (.put names "UTC" META_ETCUTC_ZONE_NAME))
                            (do
                              (set! tznames
                                    (cast String/1 (Arrays/copyOf tznames (alength tznames))))
                              (CLDRConverter/fillTZDBShortNames tzKey tznames)
                              (.put names tzid tznames)))
                        (let [^:mutable meta (cast String (.get handlerMetaZones tzKey))]
                          (when (and (nil? meta) (some? tzLink))
                            (set! meta (cast String (.get handlerMetaZones tzLink))))
                          (cond
                            (some? meta)
                              (let [metaKey (java-str METAZONE_ID_PREFIX meta)]
                                (set! data (.get map metaKey))
                                (when-instance [^:mutable ^String/1 tznames data]
                                  (when (CLDRConverter/isDefaultZone meta tzKey)
                                    (set! tznames
                                          (cast String/1 (Arrays/copyOf tznames (alength tznames))))
                                    (CLDRConverter/fillTZDBShortNames tzKey tznames)
                                    (.put names metaKey tznames))
                                  (.put names tzid meta)
                                  (when (and (some? tzLink) (.contains availableIds tzLink))
                                    (.put names tzLink meta))))
                            (.equals id "root")
                              (when (.containsKey tzdbShortNamesMap tzid)
                                (let [tznames (new String/1 6)]
                                  (CLDRConverter/fillTZDBShortNames tzid tznames)
                                  (.put names tzid tznames))))))))))
      (let [^{:tag (Map String Object)} exCities (cast
                                                   Map
                                                   (.collect
                                                     (.filter
                                                       (.stream (.entrySet map))
                                                       (lambda Predicate ^boolean [^Map$Entry e]
                                                         (.startsWith
                                                           (cast String (.getKey e))
                                                           CLDRConverter/EXEMPLAR_CITY_PREFIX)))
                                                     (Collectors/toMap
                                                       (method-ref
                                                         Function
                                                         ^String [Map$Entry]
                                                         Map$Entry/.getKey)
                                                       (method-ref
                                                         Function
                                                         [Map$Entry]
                                                         Map$Entry/.getValue))))]
        (.putAll names exCities)
        (when (and (not (.isEmpty names)) (not (.containsKey names "UTC")))
          (.putIfAbsent names (java-str METAZONE_ID_PREFIX META_EMPTY_ZONE_NAME) EMPTY_ZONE)
          (.put names "UTC" META_EMPTY_ZONE_NAME))
        (.forEach (.filter (.stream (.entrySet ZoneId/SHORT_IDS))
                           (lambda Predicate ^boolean [^Map$Entry e]
                             (and (not (.containsKey names (.getKey e)))
                                  (.containsKey names (.getValue e)))))
                  (lambda Consumer ^void [^Map$Entry e]
                    (.put names (cast String (.getKey e)) (.get names (.getValue e)))))
        names)))

  (method ^:private ^:static extractCalendarData ^{:tag (Map String Object)} [^{:tag (Map String Object)} map
                                                                              ^String id]
    (let [^{:tag (Map String Object)} calendarData (LinkedHashMap.)]
      (when (.equals id "root")
        (.put calendarData
              "firstDayOfWeek"
              (.collect (.map (.filter (.mapToObj
                                         (IntStream/range 1 8)
                                         (method-ref IntFunction ^String [int] String/valueOf))
                                       (lambda Predicate ^boolean [^String d]
                                         (.contains
                                           (.keySet map)
                                           (java-str CALENDAR_FIRSTDAY_PREFIX d))))
                              (lambda Function ^String [^String d]
                                (java-str d ": " (.get map (java-str CALENDAR_FIRSTDAY_PREFIX d)))))
                        (Collectors/joining ";")))
        (.put calendarData
              "minimalDaysInFirstWeek"
              (.collect (.map (.filter (.mapToObj
                                         (IntStream/range 0 7)
                                         (method-ref IntFunction ^String [int] String/valueOf))
                                       (lambda Predicate ^boolean [^String d]
                                         (.contains
                                           (.keySet map)
                                           (java-str CALENDAR_MINDAYS_PREFIX d))))
                              (lambda Function ^String [^String d]
                                (java-str d ": " (.get map (java-str CALENDAR_MINDAYS_PREFIX d)))))
                        (Collectors/joining ";"))))
      calendarData))

  (field ^:static ^:final ^String/1 FORMAT_DATA_ELEMENTS
    (new
      String/1
      ["MonthNames" "standalone.MonthNames" "MonthAbbreviations" "standalone.MonthAbbreviations"
       "MonthNarrows" "standalone.MonthNarrows" "DayNames" "standalone.DayNames" "DayAbbreviations"
       "standalone.DayAbbreviations" "DayNarrows" "standalone.DayNarrows" "QuarterNames"
       "standalone.QuarterNames" "QuarterAbbreviations" "standalone.QuarterAbbreviations"
       "QuarterNarrows" "standalone.QuarterNarrows" "AmPmMarkers" "narrow.AmPmMarkers"
       "abbreviated.AmPmMarkers" "long.Eras" "Eras" "narrow.Eras" "field.era" "field.year"
       "field.month" "field.week" "field.weekday" "field.dayperiod" "field.hour"
       "timezone.hourFormat" "timezone.gmtFormat" "timezone.gmtZeroFormat" "timezone.regionFormat"
       "timezone.regionFormat.daylight" "timezone.regionFormat.standard" "field.minute"
       "field.second" "field.zone" "TimePatterns" "DatePatterns" "DateTimePatterns"
       "DateTimePatternChars" "PluralRules" "DayPeriodRules" "DateFormatItemInputRegions.allowed"
       "DateFormatItemInputRegions.preferred" "ListPatterns"]))

  (field ^:static ^:final ^{:tag (Set String)} availableSkeletons (HashSet.))

  (method ^:private ^:static extractFormatData ^{:tag (Map String Object)} [^{:tag (Map String Object)} map
                                                                            ^String id]
    (let [^{:tag (Map String Object)} formatData (LinkedHashMap.)]
      (for-each [^CalendarType calendarType (CalendarType/values)]
        (let [prefix (.keyElementName calendarType)]
          (.forEach (Arrays/stream FORMAT_DATA_ELEMENTS)
                    (lambda Consumer ^void [^String elem]
                      (let [key (java-str prefix elem)]
                        (CLDRConverter/copyIfPresent map (java-str "java.time." key) formatData)
                        (CLDRConverter/copyIfPresent map key formatData))))
          (.forEach availableSkeletons
                    (lambda Consumer ^void [^String s]
                      (CLDRConverter/copyIfPresent
                        map
                        (java-str prefix "DateFormatItem." s)
                        formatData)))))
      (for-each [^String key (.keySet map)]
        (when (.startsWith key CLDRConverter/LOCALE_TYPE_PREFIX_CA)
          (let [type (.substring key (.length CLDRConverter/LOCALE_TYPE_PREFIX_CA))]
            (for-each [^CalendarType calendarType (CalendarType/values)]
              (when (.equals type (.lname calendarType))
                (let [value (.get map key)
                      dataKey (.replace key LOCALE_TYPE_PREFIX_CA CALENDAR_NAME_PREFIX)]
                  (.put formatData dataKey value)
                  (let [ukey (java-str CALENDAR_NAME_PREFIX (.uname calendarType))]
                    (when-not (.equals dataKey ukey) (.put formatData ukey value)))))))))
      (CLDRConverter/copyIfPresent map "DefaultNumberingSystem" formatData)
      (let [^{:tag (List String)} numberingScripts (cast List (.remove map "numberingScripts"))]
        (if (some? numberingScripts)
            (for-each [^String script numberingScripts]
              (CLDRConverter/copyIfPresent map (java-str script ".NumberElements") formatData)
              (CLDRConverter/copyIfPresent map (java-str script ".NumberPatterns") formatData))
            (do
              (CLDRConverter/copyIfPresent map "NumberElements" formatData)
              (CLDRConverter/copyIfPresent map "NumberPatterns" formatData)))
        (CLDRConverter/copyIfPresent map "short.CompactNumberPatterns" formatData)
        (CLDRConverter/copyIfPresent map "long.CompactNumberPatterns" formatData)
        (when (.equals id "root")
          (.forEach (.filter (.stream (.keySet handlerNumbering))
                             (lambda Predicate ^boolean [^String k]
                               (not (.contains numberingScripts k))))
                    (lambda Consumer ^void [^String k]
                      (let [ne (cast String/1 (.get map "latn.NumberElements"))
                            neNew (cast String/1 (Arrays/copyOf ne (alength ne)))]
                        (aset neNew 4 (.substring (cast String (.get handlerNumbering k)) 0 1))
                        (.put formatData (java-str k ".NumberElements") neNew)))))
        (for-each [^String lpKey Bundle/LIST_PATTERN_KEYS]
          (CLDRConverter/copyIfPresent map lpKey formatData)
          (CLDRConverter/copyIfPresent map (java-str lpKey "-short") formatData)
          (CLDRConverter/copyIfPresent map (java-str lpKey "-narrow") formatData))
        formatData)))

  (method ^:private ^:static copyIfPresent ^void [^{:tag (Map String Object)} src ^String key
                                                  ^{:tag (Map String Object)} dest]
    (let [value (.get src key)] (when (some? value) (.put dest key value))))

  (field ^:private ^:static ^:final ^String specialSaveCharsJava "\"")

  (field ^:private ^:static ^:final ^String specialSaveCharsProperties "=: \t\r\n\f#!")

  (method ^:static saveConvert ^String [^String theString ^boolean useJava]
    (if (nil? theString)
        ""
        (let [^String specialSaveChars (if useJava specialSaveCharsJava specialSaveCharsProperties)]
          (let [escapeSpace false
                len (.length theString)
                outBuffer (StringBuilder. (unchecked-multiply-int len 2))
                formatter (Formatter. outBuffer Locale/ROOT)]
            (loop [^int x 0]
              (when (< x len)
                (let [aChar (.charAt theString x)]
                  (switch aChar
                    \space
                      (do
                        (when (or (== x 0) escapeSpace) (.append outBuffer \\))
                        (.append outBuffer \space)
                        (recur (unchecked-inc-int x)))
                    \\
                      (do
                        (.append outBuffer \\)
                        (.append outBuffer \\)
                        (recur (unchecked-inc-int x)))
                    \tab
                      (do
                        (.append outBuffer \\)
                        (.append outBuffer \t)
                        (recur (unchecked-inc-int x)))
                    \newline
                      (do
                        (.append outBuffer \\)
                        (.append outBuffer \n)
                        (recur (unchecked-inc-int x)))
                    \return
                      (do
                        (.append outBuffer \\)
                        (.append outBuffer \r)
                        (recur (unchecked-inc-int x)))
                    \formfeed
                      (do
                        (.append outBuffer \\)
                        (.append outBuffer \f)
                        (recur (unchecked-inc-int x)))
                    (if (or (< aChar 0x0020) (and (not USE_UTF8) (> aChar 0x007e)))
                        (do
                          (.format formatter "\\u%04x" (new Object/1 [(int aChar)]))
                          (recur (unchecked-inc-int x)))
                        (do
                          (when-not (== (.indexOf specialSaveChars aChar) -1)
                            (.append outBuffer \\))
                          (.append outBuffer aChar)
                          (recur (unchecked-inc-int x))))))))
            (.toString outBuffer)))))

  (method ^:static toLanguageTag ^String [^String locName]
    (if (== (.indexOf locName \_) -1)
        locName
        (let [tag (.replaceAll locName "_" "-")
              loc (Locale/forLanguageTag tag)]
          (.toLanguageTag loc))))

  (method ^:private ^:static addLikelySubtags ^void [^String langTag]
    (let [likelySubtag (cast String (.get handlerLikelySubtags langTag))]
      (when (some? likelySubtag)
        (let [availableLangTags (cast SortedSet (.get metaInfo "AvailableLocales"))]
          (.add availableLangTags (.replaceFirst likelySubtag "-[A-Z][a-z]{3}" ""))
          (.add availableLangTags likelySubtag)))))

  (method ^:private ^:static toLocaleName ^String [^String tag]
    (if (== (.indexOf tag \-) -1) tag (.replaceAll tag "-" "_")))

  (method ^:private ^:static setupBaseLocales ^void [^String localeList]
    (.forEach (.map (.map (.map (Arrays/stream (.split localeList ","))
                                (method-ref Function ^Locale [String] Locale/forLanguageTag))
                          (lambda Function ^Locale [^Locale l]
                            (.build (.setScript (.setLocale (Locale$Builder.) l) "Latn"))))
                    (lambda Function ^List [^Locale l]
                      (.getCandidateLocales
                        (ResourceBundle$Control/getControl ResourceBundle$Control/FORMAT_DEFAULT)
                        ""
                        l)))
              (method-ref Consumer [List] BASE_LOCALES Set/.addAll)))

  (field ^:private ^:static ^{:tag (Map Locale Locale)} childToParentLocaleMap nil)

  (method ^:private ^:static applyParentLocales ^{:tag (List Locale)} [^String baseName
                                                                       ^{:tag (List Locale)} candidates]
    (when (Objects/isNull childToParentLocaleMap)
      (set! childToParentLocaleMap (HashMap.))
      (.forEach
        (.keySet parentLocalesMap)
        (lambda Consumer ^void [^String key]
          (let [parent (.replaceAll (.substring key (.length PARENT_LOCALE_PREFIX)) "_" "-")]
            (.forEach (.stream (cast SortedSet (.get parentLocalesMap key)))
                      (lambda Consumer ^void [^String child]
                        (.put childToParentLocaleMap
                              (Locale/forLanguageTag child)
                              ^Locale (if (.equals "root" parent)
                                          Locale/ROOT
                                          (Locale/forLanguageTag parent)))))))))
    (loop [^int i 0]
      (when (< i (.size candidates))
        (let [l (cast Locale (.get candidates i))
              p (CLDRConverter/getParentLocale l)]
          (if (and (and (not (.equals l Locale/ROOT)) (Objects/nonNull p))
                   (not (.equals (cast Locale (.get candidates (unchecked-add-int i 1))) p)))
              (let [^{:tag (List Locale)} applied (.subList candidates 0 (unchecked-add-int i 1))]
                (if (.contains applied p)
                    (recur (unchecked-inc-int i))
                    (do
                      (.addAll applied
                               (CLDRConverter/applyParentLocales
                                 baseName
                                 (.getCandidateLocales defCon baseName p)))
                      (return applied))))
              (recur (unchecked-inc-int i))))))
    candidates)

  (method ^:private ^:static getParentLocale ^Locale [^Locale child]
    (let [^:mutable parent (cast Locale (.get childToParentLocaleMap child))]
      (when (and (and nonlikelyScript (nil? parent)) (.isEmpty (.getCountry child)))
        (let [lang (java-str " " (.getLanguage child) " ")
              script (.getScript child)]
          (when-not (.isEmpty script)
            (set! parent
                  (cast Locale
                        (.orElse (.map
                                   (.map
                                     (.findAny
                                       (.filter (.stream (.entrySet likelyScriptMap))
                                                (lambda Predicate ^boolean [^Map$Entry e]
                                                  (.contains (cast SortedSet (.getValue e)) lang))))
                                     (method-ref Function ^String [Map$Entry] Map$Entry/.getKey))
                                   (lambda Function ^Locale [^String likely]
                                     (when-not (.equals likely script) Locale/ROOT)))
                                 nil))))))
      parent))

  (method ^:private ^:static generateZoneName :throws [Exception] ^void []
    (Files/createDirectories (Paths/get DESTINATION_DIR (new String/1 ["java" "time" "format"])))
    (Files/write
      (Paths/get DESTINATION_DIR (new String/1 ["java" "time" "format" "ZoneName.java"]))
      (cast Iterable
            (.collect (.flatMap (Files/lines (Paths/get zoneNameTempFile (new String/1 [])))
                                (lambda Function ^Stream [^String l]
                                  (cond
                                    (.equals l "%%%%ZIDMAP%%%%") (CLDRConverter/zidMapEntry)
                                    (.equals l "%%%%MZONEMAP%%%%") (.mzoneMapEntry handlerMetaZones)
                                    (.equals l "%%%%DEPRECATED%%%%")
                                      (.deprecatedMap handlerSupplMeta)
                                    (.equals l "%%%%TZDATALINK%%%%") (CLDRConverter/tzDataLinkEntry)
                                    :else (Stream/of l))))
                      (Collectors/toList)))
      (new OpenOption/1 [StandardOpenOption/CREATE StandardOpenOption/TRUNCATE_EXISTING])))

  (method ^:private ^:static getAvailableZoneIds ^{:tag (Set String)} []
    (java-assert (some? handlerMetaZones))
    (when (nil? AVAILABLE_TZIDS)
      (set! AVAILABLE_TZIDS (HashSet. (Arrays/asList (TimeZone/getAvailableIDs))))
      (.addAll AVAILABLE_TZIDS (.keySet handlerMetaZones))
      (.remove AVAILABLE_TZIDS MetaZonesParseHandler/NO_METAZONE_KEY))
    AVAILABLE_TZIDS)

  (method ^:private ^:static zidMapEntry ^{:tag (Stream String)} []
    (.sorted (.filter (.map (.stream (CLDRConverter/getAvailableZoneIds))
                            (lambda Function ^String [^String id]
                              (let [canonId (cast String (.getOrDefault canonicalTZMap id id))
                                    meta (cast String (.get handlerMetaZones canonId))
                                    zone001 (cast String (.get (.zidMap handlerMetaZones) meta))]
                                (if (nil? zone001)
                                    ""
                                    (String/format
                                      "        \"%s\", \"%s\", \"%s\","
                                      (new Object/1 [id meta zone001]))))))
                      (lambda Predicate ^boolean [^String s] (not (.isEmpty s))))))

  (method ^:private ^:static tzDataLinkEntry ^{:tag (Stream String)} []
    (try
      (.sorted
        (.flatMap
          (.filter
            (.filter (Files/walk (Paths/get tzDataDir (new String/1 []))
                                 1
                                 (new FileVisitOption/1 []))
                     (lambda Predicate ^boolean [^Path p] (.isFile (.toFile p))))
            (lambda Predicate ^boolean [^Path p]
              (.matches
                (.toString (.getFileName p))
                "africa|antarctica|asia|australasia|backward|etcetera|europe|northamerica|southamerica")))
          (method-ref Function ^Stream [Path] CLDRConverter/extractLinks)))
      (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:private ^:static extractLinks ^{:tag (Stream String)} [^Path tzFile]
    (try
      (.map (.filter (Files/lines tzFile)
                     (lambda Predicate ^boolean [^String l] (.startsWith l "Link")))
            (lambda Function ^String [^String l]
              (.replaceFirst l "^Link[\\s]+(\\S+)\\s+(\\S+).*" "        \"$2\", \"$1\",")))
      (catch IOException e (throw (UncheckedIOException. e)))))

  (field ^:private ^:static ^Pattern OVERRIDE_PATTERN
    (Pattern/compile "(?<win>([^:]+:[^:]+)):(?<java>[^:]+):"))

  (method ^:private ^:static generateWindowsTZMappings :throws [Exception] ^void []
    (Files/createDirectories (Paths/get DESTINATION_DIR (new String/1 ["windows" "conf"])))
    (let [override (Path/of tzDataDir (new String/1 ["tzmappings.override"]))]
      (when (.exists (.toFile override))
        (.forEach (.filter (.map (.stream (Files/readAllLines override))
                                 (method-ref Function ^String [String] String/.trim))
                           (lambda Predicate ^boolean [^String o]
                             (and (not (.isBlank o)) (not (.startsWith o "#")))))
                  (lambda Consumer ^void [^String o]
                    (let [m (.matcher OVERRIDE_PATTERN o)]
                      (if (.matches m)
                          (.put handlerWinZones (.group m "win") (.group m "java"))
                          (.printf System/out
                                   "Unrecognized tzmappings override: %s. Ignored%n"
                                   (new Object/1 [o])))))))
      (Files/write (Paths/get DESTINATION_DIR (new String/1 ["windows" "conf" "tzmappings"]))
                   (cast Iterable
                         (.collect (.sorted
                                     (.map (.filter
                                             (.stream (.keySet handlerWinZones))
                                             (lambda Predicate ^boolean [^String k]
                                               (or
                                                 (.endsWith k ":001")
                                                 (not
                                                   (.equals
                                                     (.get handlerWinZones k)
                                                     (.get
                                                       handlerWinZones
                                                       (.replaceFirst k ":\\w{2,3}$" ":001")))))))
                                           (lambda Function ^String [^String k]
                                             (java-str k ":" (.get handlerWinZones k) ":")))
                                     (anon (Comparator String) []
                                       (method ^:public compare ^int [this ^String t1 ^String t2]
                                         (let [s1 (.split t1 ":")
                                               s2 (.split t2 ":")]
                                           (if (.equals (aget s1 0) (aget s2 0))
                                               (cond
                                                 (.equals (aget s1 1) "001") 1
                                                 (.equals (aget s2 1) "001") -1
                                                 :else (.compareTo (aget s1 1) (aget s2 1)))
                                               (.compareTo (aget s1 0) (aget s2 0)))))))
                                   (Collectors/toList)))
                   (new OpenOption/1
                        [StandardOpenOption/CREATE StandardOpenOption/TRUNCATE_EXISTING]))))

  (method ^:private ^:static generateRules ^{:tag (Map String String)} [^{:tag (AbstractLDMLHandler (Map String String))} handler]
    (cast Map
          (.collect (.stream (.entrySet (.getData handler)))
                    (Collectors/toMap (method-ref Function ^String [Map$Entry] Map$Entry/.getKey)
                                      (lambda Function ^String [^Map$Entry e]
                                        (let [^{:tag (Map String String)} rules (cast
                                                                                  Map
                                                                                  (.getValue e))]
                                          (cast String
                                                (.collect
                                                  (.map
                                                    (.map
                                                      (.stream (.entrySet rules))
                                                      (lambda Function ^String [^Map$Entry rule]
                                                        (java-str
                                                          (cast String (.getKey rule))
                                                          ":"
                                                          (.replaceFirst
                                                            (cast String (.getValue rule))
                                                            "@.*"
                                                            ""))))
                                                    (method-ref
                                                      Function
                                                      ^String [String]
                                                      String/.trim))
                                                  (Collectors/joining ";")))))))))

  (method ^:private ^:static coverageLevelsMap :throws [Exception] ^{:tag (Map Locale String)} []
    (let [covMap (cast HashMap
                       (.collect (.filter (.map (.filter
                                                  (.stream
                                                    (Files/readAllLines
                                                      (Path/of
                                                        COVERAGELEVELS_FILE
                                                        (new String/1 []))))
                                                  (lambda Predicate ^boolean [^String line]
                                                    (and
                                                      (not (.isBlank line))
                                                      (not (.startsWith line "#")))))
                                                (lambda Function ^String/1 [^String line]
                                                  (.split line "[ \t]*;[ \t]*" 3)))
                                          (lambda Predicate ^boolean [^String/1 a]
                                            (.matches
                                              (aget a 1)
                                              "basic|moderate|modern|comprehensive")))
                                 (Collectors/toMap
                                   (lambda Function ^Locale [^String/1 a]
                                     (Locale/forLanguageTag (.replaceAll (aget a 0) "_" "-")))
                                   (lambda Function ^String [^String/1 a] (aget a 1))
                                   (lambda BinaryOperator ^String [^String v1 ^String v2] v2)
                                   (method-ref Supplier ^HashMap [] HashMap/new))))]
      (.forEach (.keySet (ResourceBundle/getBundle
                           (java-str (.getPackageName CLDRConverter) ".OtherCommonLocales")))
                (lambda Consumer ^void [^String k] (.put covMap (Locale/forLanguageTag k) "")))
      covMap))

  (method ^:private ^:static generateTZDBShortNamesMap :throws [IOException] ^void []
    (.forEach
      (.filter
        (.filter (Files/walk (Path/of tzDataDir (new String/1 []))
                             1
                             (new FileVisitOption/1 [FileVisitOption/FOLLOW_LINKS]))
                 (lambda Predicate ^boolean [^Path p] (.isFile (.toFile p))))
        (lambda Predicate ^boolean [^Path p]
          (.matches
            (.toString (.getFileName p))
            "africa|antarctica|asia|australasia|backward|etcetera|europe|northamerica|southamerica")))
      (lambda Consumer ^void [^Path p]
        (try
          (let [^:mutable ^String zone nil
                ^:mutable ^String rule nil
                ^:mutable ^String format nil
                ^:mutable inVanguard false]
            (for-each [^:mutable ^String line (Files/readAllLines p)]
              (cond
                (.startsWith line "# Vanguard section") (set! inVanguard true)
                (and inVanguard (.startsWith line "# Rearguard section")) (set! inVanguard false)
                :else
                  (when-not (or (.isBlank line) (.matches line "^[ \t]*#.*"))
                    (set! line (.replaceAll line "[ \t]*#.*" ""))
                    (let [tokens (.split line "[ \t]+" -1)
                          ^int token0len (if (> (alength tokens) 0) (.length (aget tokens 0)) 0)]
                      (cond
                        (and (> token0len 0)
                             (.regionMatches (aget tokens 0) true 0 "Zone" 0 token0len))
                          (do
                            (when (some? zone)
                              (.put tzdbShortNamesMap zone (java-str format NBSP rule)))
                            (set! zone (aget tokens 1))
                            (set! rule (aget tokens 3))
                            (set! format (CLDRConverter/flipIfNeeded inVanguard (aget tokens 4))))
                        (some? zone)
                          (if (and (> token0len 0)
                                   (or (.regionMatches (aget tokens 0) true 0 "Rule" 0 token0len)
                                       (.regionMatches (aget tokens 0) true 0 "Link" 0 token0len)))
                              (do
                                (.put tzdbShortNamesMap zone (java-str format NBSP rule))
                                (set! zone nil)
                                (set! rule nil)
                                (set! format nil))
                              (do
                                (set! rule (aget tokens 2))
                                (set! format
                                      (CLDRConverter/flipIfNeeded inVanguard (aget tokens 3))))))
                      (when (and (> token0len 0)
                                 (.regionMatches (aget tokens 0) true 0 "Rule" 0 token0len))
                        (.put tzdbSubstLetters
                              (java-str (aget tokens 1)
                                        NBSP
                                        (if (.equals (aget tokens 8) "0") STD DST))
                              (.replace (aget tokens 9) NO_SUBST "")))
                      (when (and (> token0len 0)
                                 (.regionMatches (aget tokens 0) true 0 "Link" 0 token0len))
                        (.put tzdbLinks (aget tokens 2) (aget tokens 1)))))))
            (when (some? zone) (.put tzdbShortNamesMap zone (java-str format NBSP rule))))
          (catch IOException ioe (throw (UncheckedIOException. ioe)))))))

  (method ^:private ^:static flipIfNeeded ^String [^boolean inVanguard ^String format]
    (when inVanguard
      (let [stddst (.split format "/")]
        (when (== (alength stddst) 2) (return (java-str (aget stddst 1) "/" (aget stddst 0))))))
    format)

  (method ^:private ^:static fillTZDBShortNames ^void [^String tzid ^String/1 names]
    (let [val (cast
                String
                (.getOrDefault tzdbShortNamesMap
                               tzid
                               (cast String
                                     (.get tzdbShortNamesMap (CLDRConverter/getTZDBLink tzid)))))]
      (when (some? val)
        (let [format (aget (.split val NBSP) 0)
              rule (aget (.split val NBSP) 1)]
          (.forEach (IntStream/of (new int/1 [1 3 5]))
                    (lambda IntConsumer ^void [^int i]
                      (when (or (nil? (aget names i)) (.isEmpty (aget names i)))
                        (cond
                          (.contains format "%s")
                            (aset names
                                  i
                                  (switch i
                                    1
                                      (.formatted
                                        format
                                        (.get tzdbSubstLetters (java-str rule NBSP STD)))
                                    3
                                      (.formatted
                                        format
                                        (.get tzdbSubstLetters (java-str rule NBSP DST)))
                                    5 (.formatted format "")
                                    (throw (InternalError.))))
                          (.contains format "/")
                            (aset names
                                  i
                                  (switch i
                                    (1 5)
                                      (CLDRConverter/convertGMTName
                                        (.substring format 0 (.indexOf format "/")))
                                    3
                                      (CLDRConverter/convertGMTName
                                        (.substring
                                          format
                                          (unchecked-add-int (.indexOf format "/") 1)))
                                    (throw (InternalError.))))
                          :else (aset names i (CLDRConverter/convertGMTName format))))))))))

  (method ^:private ^:static isDefaultZone ^boolean [^String meta ^String tzid]
    (let [zone001 (cast String (.get (.zidMap handlerMetaZones) meta))
          tzLink (CLDRConverter/getTZDBLink tzid)]
      (or (.equals (cast String (.getOrDefault canonicalTZMap tzid tzid)) zone001)
          (and (some? tzLink)
               (.equals (cast String (.getOrDefault canonicalTZMap tzLink tzLink)) zone001)))))

  (method ^:private ^:static getTZDBLink ^String [^String tzid]
    (let [^:mutable ^String tzLink nil]
      (let [^:mutable k tzid]
        (while (.containsKey tzdbLinks k) (set! k (set! tzLink (cast String (.get tzdbLinks k))))))
      tzLink))

  (method ^:private ^:static convertGMTName ^String [^String f]
    (try (when-not (.equals f "%z") (ZoneOffset/of f)) (return nil) (catch DateTimeException dte))
    f)

  (method ^:static dumpMap ^void [^{:tag (Map String Object)} map]
    (.forEach (.map (.sorted (.stream (.entrySet map)) (Map$Entry/comparingByKey))
                    (lambda Function ^String [^Map$Entry e]
                      (let [val (.getValue e)
                            ^:mutable ^String valStr nil]
                        (cond
                          (instance? String/1 val)
                            (set! valStr (.toString (Arrays/asList (cast String/1 val))))
                          (some? val) (set! valStr (.toString val)))
                        (java-str (cast String (.getKey e)) " = " valStr))))
              (method-ref Consumer [String] System/out PrintStream/.println))))

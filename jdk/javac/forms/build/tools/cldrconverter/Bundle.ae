                  (set! value newValue)
                  (when (nil? (aget value (unchecked-subtract-int (alength value) 1)))
                    (aset value
                          (unchecked-subtract-int (alength value) 1)
                          (if (.startsWith key "narrow.") "R" "Reiwa"))))

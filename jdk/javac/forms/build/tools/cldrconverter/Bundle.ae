                            (do (aset strings i (aget pstrings i)) (recur (unchecked-inc-int i)))
                            (recur (unchecked-inc-int i)))
                        nil))
                  (return (Arrays/equals strings pstrings))))))
          false)))

  (method ^:private adjustEraNames ^void [this ^{:tag (Map String Object)} map
                                          ^{:tag (Map String Object)} pMap ^CalendarType type]

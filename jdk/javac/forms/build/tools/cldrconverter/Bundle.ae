                    (let [nextc (.charAt pattern (unchecked-add-int i 1))]
                      (when (== nextc \')
                        (set! i (unchecked-inc-int i))
                        (when-not (== count 0)
                          (.convert converter calendarType patternKey lastLetter count jrePattern)
                          (set! lastLetter 0)
                          (set! count 0))
                        (.append jrePattern "''")
                        (set! i (unchecked-inc-int i))
                        (continue))))
                  (if (not inQuote)
                      (do
                        (when-not (== count 0)
                          (.convert converter calendarType patternKey lastLetter count jrePattern)
                          (set! lastLetter 0)
                          (set! count 0))
                        (set! inQuote true))
                      (set! inQuote false))
                  (.append jrePattern c))
              inQuote (.append jrePattern c)
              (not (or (and (>= c \a) (<= c \z)) (and (>= c \A) (<= c \Z))))
                (do
                  (when-not (== count 0)
                    (.convert converter calendarType patternKey lastLetter count jrePattern)
                    (set! lastLetter 0)
                    (set! count 0))
                  (.append jrePattern c))
              (or (== lastLetter 0) (== lastLetter c))
                (do (set! lastLetter c) (set! count (unchecked-inc-int count)))
              :else
                (do
                  (.convert converter calendarType patternKey lastLetter count jrePattern)
                  (set! lastLetter c)
                  (set! count 1))))
          (set! i (unchecked-inc-int i))))
      (when inQuote
        (throw (InternalError. (java-str "Unterminated quote in date-time pattern: " cldrFormat))))
      (when-not (== count 0)
        (.convert converter calendarType patternKey lastLetter count jrePattern))
      (if (.contentEquals cldrFormat jrePattern) cldrFormat (.toString jrePattern))))

  (method ^:private toMetaZoneKey ^String [this ^String tzKey]
    (when (.startsWith tzKey CLDRConverter/TIMEZONE_ID_PREFIX)
      (let [tz (.substring tzKey (.length CLDRConverter/TIMEZONE_ID_PREFIX))
            meta (cast String (.get CLDRConverter/handlerMetaZones tz))]
        (when (some? meta) (return (java-str CLDRConverter/METAZONE_ID_PREFIX meta)))))
    nil)

  (method ^:private convertDateTimePatternLetter ^void [this ^CalendarType calendarType
                                                        ^String patternKey ^char cldrLetter
                                                        ^int count ^StringBuilder sb]
    (switch cldrLetter (\u \U) (.appendN this \y count sb) (.appendN this cldrLetter count sb)))

  (method ^:private convertSDFLetter ^void [this ^CalendarType calendarType ^String patternKey
                                            ^char cldrLetter ^:mutable ^int count ^StringBuilder sb]
    (switch cldrLetter
      \G
        (do
          (when-not (identical? calendarType CalendarType/GREGORIAN)
            (cond (== count 5) (set! count 1) (== count 1) (set! count 4)))
          (.appendN this cldrLetter count sb))
      (\c \e)
        (switch count 1 (.append sb \u) (3 4) (.appendN this \E count sb) 5 (.appendN this \E 3 sb))
      (\v \V) (.appendN this \z count sb)
      \y
        (do
          (when (and (identical? calendarType CalendarType/JAPANESE)
                     (or (.contains patternKey "full-") (.contains patternKey "long-")))
            (set! count 4))
          (.appendN this cldrLetter count sb))
      \Z (when (or (== count 4) (== count 5)) (.append sb "XXX"))
      \B (.appendN this \a count sb)
      (.appendN this cldrLetter count sb)))


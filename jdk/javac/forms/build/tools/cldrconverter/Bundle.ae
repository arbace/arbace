          (.remove map standaloneMapKey)
          (let [standaloneResourceKey (java-str "standalone." key)]
            (.put map standaloneResourceKey standalone)
            (when (.fillInElements this parents standaloneMapKey standalone)
              (.remove map standaloneResourceKey)))))))


  (method ^:private translateDateFormatLetters ^String [this ^CalendarType calendarType
                                                        ^String patternKey ^String cldrFormat
                                                        ^ConvertDateTimeLetters converter]
    (let [pattern cldrFormat
          length (.length pattern)
          ^:mutable inQuote false
          jrePattern (StringBuilder. length)
          ^:mutable ^int count 0
          ^:mutable ^char lastLetter 0]
      (let [^:mutable ^int i 0]
        (while (< i length)
          (let [c (.charAt pattern i)]
            (cond
              (== c \')
                (do

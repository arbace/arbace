                    (when-not (.endsWith key "accounting")
                      (throw
                        (InternalError. (java-str "NumberPatterns: null for " key ", id: " id))))
                    (do
                      (java-assert (identical? keys NUMBER_ELEMENT_KEYS))
                      (cond
                        (.endsWith key "/pattern") (aset numArray idx "#")
                        (and (not (.endsWith key "currencyDecimal"))
                             (not (.endsWith key "currencyGroup")))
                          (throw (InternalError.
                                   (java-str "NumberElements: null for " key ", id: " id))))))))
            (recur (unchecked-inc-int i)))))
      numArray))

  (method ^:private ^:static skeletonInputRegions ^void [^{:tag (Map String Object)} myMap]
    (.putAll myMap
             (cast Map
                   (.collect (.filter (.stream (.entrySet myMap))
                                      (lambda Predicate ^boolean [^Map$Entry e]
                                        (.startsWith
                                          (cast String (.getKey e))
                                          Bundle/DATEFORMATITEM_INPUT_REGIONS_PREFIX)))
                             (Collectors/toMap
                               (lambda Function ^String [^Map$Entry e] (cast String (.getKey e)))
                               (lambda Function ^String [^Map$Entry e]
                                 (.trim (cast String (.getValue e)))))))))

  (method ^:private ^:static escapeReservedChars ^String [^String pattern]
    (let [out (StringBuilder.)
          ^:mutable inQuote false]
      (let [^:mutable ^int i 0]
        (while (< i (.length pattern))
          (let [c (.charAt pattern i)]
            (cond
              (== c \')
                (if (and (< (unchecked-add-int i 1) (.length pattern))
                         (== (.charAt pattern (unchecked-add-int i 1)) \'))
                    (do (.append out "''") (set! i (unchecked-inc-int i)))
                    (do (set! inQuote (not inQuote)) (.append out c)))
              (and (not inQuote)
                   (or (or (or (or (== c \#) (== c \{)) (== c \})) (== c \[)) (== c \])))
                (.append (.append (.append out \') c) \')
              :else (.append out c)))
          (set! i (unchecked-inc-int i))))
      (.toString out))))

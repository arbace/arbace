        (when (< i (alength keys))
          (let [key (java-str script "." (aget keys i))
                idx i]
            (.ifPresentOrElse
              (Optional/ofNullable
                (.getOrDefault
                  myMap
                  key
                  (.getOrDefault parentsMap

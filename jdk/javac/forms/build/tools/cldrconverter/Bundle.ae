          realKeys (new String/1 (alength ERA_KEYS))
          ^:mutable ^int index 0]
      (for-each [^String key ERA_KEYS]
        (let [realKey (java-str (.keyElementName type) key)
              ^:mutable value (cast String/1 (.get map realKey))]
          (when (some? value)
            (.fillInElements this pMap realKey value)
            (switch type
              GREGORIAN nil
              JAPANESE
                (let [newValue (new String/1 (unchecked-add-int (alength value) 1))
                      julianEras (cast String/1 (.get map key))]
                  (if (and (some? julianEras) (>= (alength julianEras) 2))
                      (aset newValue 0 (aget julianEras 1))
                      (aset newValue 0 ""))

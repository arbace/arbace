  (method ^:public resolveEntity :throws [IOException SAXException] ^InputSource [this
                                                                                  ^String publicID
                                                                                  ^String systemID]
    (when (.startsWith systemID CLDRConverter/SPPL_LDML_DTD_SYSTEM_ID)

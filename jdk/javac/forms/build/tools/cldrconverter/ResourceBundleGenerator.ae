                                       (.setLanguage
                                         (.clear LOCALE_BUILDER)
                                         (CLDRConverter/getLanguageCode localeID))
                                       (CLDRConverter/getRegionCode localeID))
                                     (CLDRConverter/getScriptCode localeID)))]

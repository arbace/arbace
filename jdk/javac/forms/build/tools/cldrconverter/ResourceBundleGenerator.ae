  (method ^:private ^:static generateStringArray :throws [IOException] ^void [^{:tag (SortedSet String)} set
                                                                              ^PrintWriter out]
    (let [children (.split (ResourceBundleGenerator/toLocaleList set true) " ")]
      (Arrays/sort children)
      (.printf out "            new String[] {\n                " (new Object/1 []))
      (let [^:mutable ^int count 0]
        (loop [^int i 0]
          (when (< i (alength children))
            (let [child (aget children i)]
              (.printf out "\"%s\", " (new Object/1 [child]))
              (set! count (unchecked-add-int count (unchecked-add-int (.length child) 4)))
              (if (and (not (== i (unchecked-subtract-int (alength children) 1))) (> count 64))
                  (do
                    (.printf out "\n                " (new Object/1 []))
                    (set! count 0)
                    (recur (unchecked-inc-int i)))
                  (recur (unchecked-inc-int i))))))
        (.printf out "\n            });\n" (new Object/1 [])))))


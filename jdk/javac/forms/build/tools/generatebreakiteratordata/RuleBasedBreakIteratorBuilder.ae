  (field ^:private ^:static ^:final ^int BMP_INDICES_LENGTH 512)

  (method ^:protected writeTables ^void [this ^String datafile]
    (let [^:mutable ^String filename nil
          ^:mutable ^String outputDir nil
          tmpbuf (GenerateBreakIteratorData/getOutputDirectory)]
      (if (.equals tmpbuf "")
          (do (set! filename datafile) (set! outputDir ""))
          (let [sep File/separatorChar]
            (cond
              (== sep \/) (set! outputDir tmpbuf)
              (== sep \\) (set! outputDir (.replaceAll tmpbuf "/" "\\\\"))
              :else (set! outputDir (.replaceAll tmpbuf "/" (String/valueOf sep))))
            (set! filename (java-str outputDir sep datafile))))
      (try
        (when-not (.equals outputDir "") (.mkdirs (File. outputDir)))
        (let [out (BufferedOutputStream. (FileOutputStream. filename))
              ^:mutable BMPdata (.getStringArray charCategoryTable)
              ^:mutable BMPindices (.getIndexArray charCategoryTable)
              ^:mutable nonBMPdata (.getArray supplementaryCharCategoryTable)]
          (when (<= (alength BMPdata) 0)
            (throw (InternalError. (java-str "Wrong BMP data length(" (alength BMPdata) ")"))))
          (when-not (== (alength BMPindices) BMP_INDICES_LENGTH)
            (throw (InternalError. (java-str "Wrong BMP indices length(" (alength BMPindices) ")"))))
          (when (<= (alength nonBMPdata) 0)
            (throw
              (InternalError. (java-str "Wrong non-BMP data length(" (alength nonBMPdata) ")"))))
          (let [^:mutable ^int len 0
                crc32 (CRC32.)]
            (set! len (alength stateTable))
            (loop [^int i 0]
              (when (< i len) (.update crc32 (aget stateTable i)) (recur (unchecked-inc-int i))))
            (set! len (alength backwardsStateTable))
            (loop [^int i 0]
              (when (< i len)
                (.update crc32 (aget backwardsStateTable i))
                (recur (unchecked-inc-int i))))
            (.update crc32 (.toByteArray this endStates))
            (.update crc32 (.toByteArray this lookaheadStates))
            (loop [^int i 0]
              (when (< i BMP_INDICES_LENGTH)
                (.update crc32 (aget BMPindices i))
                (recur (unchecked-inc-int i))))
            (.update crc32 BMPdata)
            (set! len (alength nonBMPdata))
            (loop [^int i 0]
              (when (< i len) (.update crc32 (aget nonBMPdata i)) (recur (unchecked-inc-int i))))
            (when (some? additionalData)
              (set! len (alength additionalData))
              (loop [^int i 0]
                (when (< i len)
                  (.update crc32 (aget additionalData i))
                  (recur (unchecked-inc-int i)))))
            (set! len
                  (unchecked-add-int
                    (unchecked-add-int
                      (unchecked-add-int
                        (unchecked-add-int
                          (unchecked-add-int
                            (unchecked-add-int
                              (unchecked-add-int
                                HEADER_LENGTH
                                (unchecked-multiply-int
                                  (unchecked-add-int
                                    (alength stateTable)
                                    (alength backwardsStateTable))
                                  2))
                              (alength endStates))
                            (alength lookaheadStates))
                          1024)
                        (alength BMPdata))
                      (unchecked-multiply-int (alength nonBMPdata) 4))
                    (if (nil? additionalData) 0 (alength additionalData))))
            (.write out LABEL)
            (.write out supportedVersion)
            (.write out (.toByteArray this len))
            (.write out (.toByteArray this (alength stateTable)))
            (.write out (.toByteArray this (alength backwardsStateTable)))
            (.write out (.toByteArray this (alength endStates)))
            (.write out (.toByteArray this (alength lookaheadStates)))
            (.write out (.toByteArray this (alength BMPdata)))
            (.write out (.toByteArray this (alength nonBMPdata)))
            (if (nil? additionalData)
                (.write out (^[int] RuleBasedBreakIteratorBuilder/.toByteArray this 0))
                (.write out (.toByteArray this (alength additionalData))))
            (.write out (.toByteArray this (.getValue crc32)))
            (set! len (alength stateTable))
            (loop [^int i 0]
              (when (< i len)
                (.write out (.toByteArray this (aget stateTable i)))
                (recur (unchecked-inc-int i))))
            (set! len (alength backwardsStateTable))
            (loop [^int i 0]
              (when (< i len)
                (.write out (.toByteArray this (aget backwardsStateTable i)))
                (recur (unchecked-inc-int i))))
            (.write out (.toByteArray this endStates))
            (.write out (.toByteArray this lookaheadStates))
            (loop [^int i 0]
              (when (< i BMP_INDICES_LENGTH)
                (.write out (.toByteArray this (aget BMPindices i)))
                (recur (unchecked-inc-int i))))
            (set! BMPindices nil)
            (.write out BMPdata)
            (set! BMPdata nil)
            (set! len (alength nonBMPdata))
            (loop [^int i 0]
              (when (< i len)
                (.write out (.toByteArray this (aget nonBMPdata i)))
                (recur (unchecked-inc-int i))))
            (set! nonBMPdata nil)
            (when (some? additionalData) (.write out additionalData))
            (.close out)))
        (catch Exception e (throw (InternalError. (.toString e)))))))

  (method toByteArray ^byte/1 [this ^short val]
    (let [buf (new byte/1 2)]
      (aset buf 0 (unchecked-byte (bit-and-int (unsigned-bit-shift-right-int val 8) 0xFF)))
      (aset buf 1 (unchecked-byte (bit-and-int val 0xFF)))
      buf))

  (method toByteArray ^byte/1 [this ^int val]
    (let [buf (new byte/1 4)]
      (aset buf 0 (unchecked-byte (bit-and-int (unsigned-bit-shift-right-int val 24) 0xFF)))
      (aset buf 1 (unchecked-byte (bit-and-int (unsigned-bit-shift-right-int val 16) 0xFF)))
      (aset buf 2 (unchecked-byte (bit-and-int (unsigned-bit-shift-right-int val 8) 0xFF)))
      (aset buf 3 (unchecked-byte (bit-and-int val 0xFF)))
      buf))

  (method toByteArray ^byte/1 [this ^long val]
    (let [buf (new byte/1 8)]
      (aset buf 0 (unchecked-byte (bit-and (unsigned-bit-shift-right val 56) 0xff)))
      (aset buf 1 (unchecked-byte (bit-and (unsigned-bit-shift-right val 48) 0xff)))
      (aset buf 2 (unchecked-byte (bit-and (unsigned-bit-shift-right val 40) 0xff)))
      (aset buf 3 (unchecked-byte (bit-and (unsigned-bit-shift-right val 32) 0xff)))
      (aset buf 4 (unchecked-byte (bit-and (unsigned-bit-shift-right val 24) 0xff)))
      (aset buf 5 (unchecked-byte (bit-and (unsigned-bit-shift-right val 16) 0xff)))
      (aset buf 6 (unchecked-byte (bit-and (unsigned-bit-shift-right val 8) 0xff)))
      (aset buf 7 (unchecked-byte (bit-and val 0xff)))
      buf))

  (method toByteArray ^byte/1 [this ^boolean/1 data]
    (let [buf (new byte/1 (alength data))]
      (loop [^int i 0]
        (when (< i (alength data))
          (aset buf i (if (aget data i) (unchecked-byte 1) (unchecked-byte 0)))
          (recur (unchecked-inc-int i))))
      buf))

  (method setAdditionalData ^void [this ^byte/1 data]
    (set! additionalData data)))

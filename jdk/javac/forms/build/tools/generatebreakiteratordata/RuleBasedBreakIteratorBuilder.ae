                                              (unchecked-add-int column backTableOffset)))
                                      (recur (unchecked-inc-int nextColumn)))
                                    (recur (unchecked-inc-int nextColumn))))))
                          (recur (unchecked-inc-int row)))
                        (recur (unchecked-inc-int row))))))

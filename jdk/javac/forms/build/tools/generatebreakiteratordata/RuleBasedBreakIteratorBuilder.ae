  (method ^:private buildBackwardsStateTable ^void [this ^{:tag (Vector String)} tempRuleList]
    (set! tempStateTable (Vector.))
    (.addElement tempStateTable (new short/1 (unchecked-add-int numCategories 1)))
    (.addElement tempStateTable (new short/1 (unchecked-add-int numCategories 1)))
    (loop [^int i 0]
      (when (< i (.size tempRuleList))

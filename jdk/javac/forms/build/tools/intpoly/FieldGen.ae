  (method ^:private generateFile :throws [IOException] ^void [this ^FieldParams params]
    (let [text (.generate this params)
          fileName (java-str (.getClassName params) ".java")
          out (PrintWriter. (Files/newBufferedWriter
                              (.resolve destPath fileName)
                              (new OpenOption/1 [])))]
      (.println out text)
      (.close out)))


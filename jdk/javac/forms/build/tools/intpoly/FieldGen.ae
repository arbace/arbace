  (method ^:private generate :throws [IOException] ^String [this ^FieldParams params]
    (let [result (CodeBuffer.)
          header (.readHeader this)]
      (.appendLine result header)
      (when (some? packageName)
        (.appendLine result (java-str "package " packageName ";"))
        (.appendLine result))
      (.appendLine result "import java.math.BigInteger;")
      (.appendLine result
                   (java-str "public final class "
                             (.getClassName params)
                             " extends "
                             (.-parentName this)
                             " {"))
      (.incrIndent result)
      (.appendLine result
                   (java-str "private static final int BITS_PER_LIMB = "
                             (.getBitsPerLimb params)
                             ";"))
      (.appendLine result
                   (java-str "private static final int NUM_LIMBS = " (.getNumLimbs params) ";"))
      (.appendLine result
                   (java-str "private static final int MAX_ADDS = " (.getMaxAdds params) ";"))
      (.appendLine result "public static final BigInteger MODULUS = evaluateModulus();")
      (.appendLine result
                   (java-str "private static final long CARRY_ADD = 1 << "
                             (unchecked-subtract-int (.getBitsPerLimb params) 1)
                             ";"))
      (when-not (== (unchecked-multiply-int (.getBitsPerLimb params) (.getNumLimbs params))
                    (.getPower params))
        (.appendLine result "private static final long LIMB_MASK = -1L >>> (64 - BITS_PER_LIMB);"))
      (.appendLine result)
      (.appendLine result
                   (java-str "public static final "
                             (.getClassName params)
                             " ONE = new "
                             (.getClassName params)
                             "();"))
      (.appendLine result)
      (.appendLine result (java-str "private " (.getClassName params) "() {"))
      (.appendLine result)
      (.appendLine result "    super(BITS_PER_LIMB, NUM_LIMBS, MAX_ADDS, MODULUS);")
      (.appendLine result)
      (.appendLine result "}")
      (let [coqTerms (StringBuilder. "//")]
        (for-each [^Term t (.getTerms params)]
          (.append coqTerms (java-str "(" (.getPower t) "%nat,"))
          (.append coqTerms (java-str (.getCoefficient t) ")::")))
        (.append coqTerms "nil.")
        (.appendLine result (.toString coqTerms))
        (.appendLine result "private static BigInteger evaluateModulus() {")
        (.incrIndent result)
        (.appendLine result
                     (java-str "BigInteger result = BigInteger.valueOf(2).pow("
                               (.getPower params)
                               ");"))
        (for-each [^Term t (.getTerms params)]
          (let [^:mutable subtract false
                ^:mutable coefValue (.getCoefficient t)]
            (when (< coefValue 0)
              (set! coefValue (unchecked-subtract-int 0 coefValue))
              (set! subtract true))
            (let [coefExpr (java-str "BigInteger.valueOf(" coefValue ")")
                  powExpr (java-str ".shiftLeft(" (.getPower t) ")")
                  ^:mutable termExpr "ERROR"]
              (if (== (.getPower t) 0)
                  (set! termExpr coefExpr)
                  (set! termExpr (java-str coefExpr powExpr)))
              (if subtract
                  (.appendLine result (java-str "result = result.subtract(" termExpr ");"))
                  (.appendLine result (java-str "result = result.add(" termExpr ");"))))))
        (.appendLine result "return result;")
        (.decrIndent result)
        (.appendLine result "}")
        (.appendLine result "@Override")
        (.appendLine result "protected void reduceIn(long[] limbs, long v, int i) {")
        (.incrIndent result)
        (let [c "v"]
          (for-each [^Term t (.getTerms params)]
            (let [reduceBits (unchecked-subtract-int (.getPower params) (.getPower t))
                  coefficient (unchecked-multiply-int -1 (.getCoefficient t))
                  ^:mutable x (java-str coefficient " * " c)
                  ^:mutable accOp "+="
                  ^:mutable ^String temp nil]
              (cond
                (== coefficient 1) (set! x c)
                (== coefficient -1) (do (set! x c) (set! accOp "-="))
                :else (do (set! temp (.getTemporary result "long" x)) (set! x temp)))
              (if (== (unchecked-remainder-int reduceBits (.getBitsPerLimb params)) 0)
                  (let [pos (unchecked-divide-int reduceBits (.getBitsPerLimb params))]
                    (.appendLine result (java-str "limbs[i - " pos "] " accOp " " x ";")))
                  (let [secondPos (unchecked-divide-int reduceBits (.getBitsPerLimb params))
                        bitOffset (unchecked-subtract-int
                                    (unchecked-multiply-int
                                      (unchecked-add-int secondPos 1)
                                      (.getBitsPerLimb params))
                                    reduceBits)
                        rightBitOffset (unchecked-subtract-int (.getBitsPerLimb params) bitOffset)]
                    (.appendLine result
                                 (java-str "limbs[i - "
                                           (unchecked-add-int secondPos 1)
                                           "] "
                                           accOp
                                           " ("
                                           x
                                           " << "
                                           bitOffset
                                           ") & LIMB_MASK;"))
                    (.appendLine result
                                 (java-str "limbs[i - "
                                           secondPos
                                           "] "
                                           accOp
                                           " "
                                           x
                                           " >> "
                                           rightBitOffset
                                           ";"))))))
          (.decrIndent result)
          (.appendLine result "}")
          (.appendLine result "@Override")
          (.appendLine result "protected void finalCarryReduceLast(long[] limbs) {")
          (.incrIndent result)
          (let [extraBits (unchecked-subtract-int
                            (unchecked-multiply-int (.getBitsPerLimb params) (.getNumLimbs params))
                            (.getPower params))
                highBits (unchecked-subtract-int (.getBitsPerLimb params) extraBits)]
            (.appendLine result
                         (java-str "long c = limbs["
                                   (unchecked-subtract-int (.getNumLimbs params) 1)
                                   "] >> "
                                   highBits
                                   ";"))
            (.appendLine result
                         (java-str "limbs["
                                   (unchecked-subtract-int (.getNumLimbs params) 1)
                                   "] -= c << "
                                   highBits
                                   ";"))
            (for-each [^Term t (.getTerms params)]
              (let [reduceBits (unchecked-subtract-int
                                 (unchecked-add-int (.getPower params) extraBits)
                                 (.getPower t))
                    negatedCoefficient (unchecked-multiply-int -1 (.getCoefficient t))]
                (FieldGen/modReduceInBits result
                                          params
                                          true
                                          "limbs"
                                          (.getNumLimbs params)
                                          reduceBits
                                          negatedCoefficient
                                          "c")))
            (.decrIndent result)
            (.appendLine result "}")
            (.appendIndent result)
            (.append result "private void carryReduce(long[] r, ")
            (loop [^int i 0]
              (when (< i
                       (unchecked-subtract-int (unchecked-multiply-int 2 (.getNumLimbs params)) 1))
                (.append result (java-str "long c" i))
                (if (< i
                       (unchecked-subtract-int (unchecked-multiply-int 2 (.getNumLimbs params)) 2))
                    (do (.append result ", ") (recur (unchecked-inc-int i)))
                    (recur (unchecked-inc-int i)))))
            (.append result ") {\n")
            (.newTempScope result)
            (.incrIndent result)
            (.appendLine result
                         (java-str "long c"
                                   (unchecked-subtract-int
                                     (unchecked-multiply-int 2 (.getNumLimbs params))
                                     1)
                                   " = 0;"))
            (FieldGen/write result
                            (.getCrSequence params)
                            params
                            "c"
                            (unchecked-multiply-int 2 (.getNumLimbs params)))
            (.appendLine result)
            (loop [^int i 0]
              (when (< i (.getNumLimbs params))
                (.appendLine result (java-str "r[" i "] = c" i ";"))
                (recur (unchecked-inc-int i))))
            (.decrIndent result)
            (.appendLine result "}")
            (.appendIndent result)
            (.append result "private void carryReduce(long[] r, ")
            (loop [^int i 0]
              (when (< i (.getNumLimbs params))
                (.append result (java-str "long c" i))
                (if (< i (unchecked-subtract-int (.getNumLimbs params) 1))
                    (do (.append result ", ") (recur (unchecked-inc-int i)))
                    (recur (unchecked-inc-int i)))))
            (.append result ") {\n")
            (.newTempScope result)
            (.incrIndent result)
            (.appendLine result (java-str "long c" (.getNumLimbs params) " = 0;"))
            (FieldGen/write result
                            (.getSmallCrSequence params)
                            params
                            "c"
                            (unchecked-add-int (.getNumLimbs params) 1))
            (.appendLine result)
            (loop [^int i 0]
              (when (< i (.getNumLimbs params))
                (.appendLine result (java-str "r[" i "] = c" i ";"))
                (recur (unchecked-inc-int i))))
            (.decrIndent result)
            (.appendLine result "}")
            (.appendLine result "@Override")
            (.appendLine result "protected void mult(long[] a, long[] b, long[] r) {")
            (.incrIndent result)
            (loop [^int i 0]
              (when (< i
                       (unchecked-subtract-int (unchecked-multiply-int 2 (.getNumLimbs params)) 1))
                (.appendIndent result)
                (.append result (java-str "long c" i " = "))
                (let [startJ (^[int int] Math/max
                               (unchecked-subtract-int
                                 (unchecked-add-int i 1)
                                 (.getNumLimbs params))
                               0)
                      endJ (Math/min (.getNumLimbs params) (unchecked-add-int i 1))]
                  (loop [^int j startJ]
                    (when (< j endJ)
                      (let [bIndex (unchecked-subtract-int i j)]
                        (.append result (java-str "(a[" j "] * b[" bIndex "])"))
                        (if (< j (unchecked-subtract-int endJ 1))
                            (do (.append result " + ") (recur (unchecked-inc-int j)))
                            (recur (unchecked-inc-int j))))))
                  (.append result ";\n")
                  (recur (unchecked-inc-int i)))))
            (.appendLine result)
            (.appendIndent result)
            (.append result "carryReduce(r, ")
            (loop [^int i 0]
              (when (< i
                       (unchecked-subtract-int (unchecked-multiply-int 2 (.getNumLimbs params)) 1))
                (.append result (java-str "c" i))
                (if (< i
                       (unchecked-subtract-int (unchecked-multiply-int 2 (.getNumLimbs params)) 2))
                    (do (.append result ", ") (recur (unchecked-inc-int i)))
                    (recur (unchecked-inc-int i)))))
            (.append result ");\n")
            (.decrIndent result)
            (.appendLine result "}")
            (.appendLine result "@Override")
            (.appendLine result "protected void reduce(long[] a) {")
            (.incrIndent result)
            (.appendIndent result)
            (.append result "carryReduce(a, ")
            (loop [^int i 0]
              (when (< i (.getNumLimbs params))
                (.append result (java-str "a[" i "]"))
                (if (< i (unchecked-subtract-int (.getNumLimbs params) 1))
                    (do (.append result ", ") (recur (unchecked-inc-int i)))
                    (recur (unchecked-inc-int i)))))
            (.append result ");\n")
            (.decrIndent result)
            (.appendLine result "}")
            (.appendLine result "@Override")
            (.appendLine result "protected void square(long[] a, long[] r) {")
            (.incrIndent result)
            (loop [^int i 0]
              (when (< i
                       (unchecked-subtract-int (unchecked-multiply-int 2 (.getNumLimbs params)) 1))
                (.appendIndent result)
                (.append result (java-str "long c" i " = "))
                (let [startJ (^[int int] Math/max
                               (unchecked-subtract-int
                                 (unchecked-add-int i 1)
                                 (.getNumLimbs params))
                               0)
                      endJ (Math/min (.getNumLimbs params) (unchecked-add-int i 1))
                      jDiff (unchecked-subtract-int endJ startJ)]
                  (when (> jDiff 1) (.append result "2 * ("))
                  (loop [^int j 0]
                    (when (< j (unchecked-divide-int jDiff 2))
                      (let [aIndex (unchecked-add-int j startJ)
                            bIndex (unchecked-subtract-int i aIndex)]
                        (.append result (java-str "(a[" aIndex "] * a[" bIndex "])"))
                        (if (< j (unchecked-subtract-int (unchecked-divide-int jDiff 2) 1))
                            (do (.append result " + ") (recur (unchecked-inc-int j)))
                            (recur (unchecked-inc-int j))))))
                  (when (> jDiff 1) (.append result ")"))
                  (when (== (unchecked-remainder-int jDiff 2) 1)
                    (let [aIndex (unchecked-divide-int i 2)]
                      (when (> jDiff 1) (.append result " + "))
                      (.append result (java-str "(a[" aIndex "] * a[" aIndex "])"))))
                  (.append result ";\n")
                  (recur (unchecked-inc-int i)))))
            (.appendLine result)
            (.appendIndent result)
            (.append result "carryReduce(r, ")
            (loop [^int i 0]
              (when (< i
                       (unchecked-subtract-int (unchecked-multiply-int 2 (.getNumLimbs params)) 1))
                (.append result (java-str "c" i))
                (if (< i
                       (unchecked-subtract-int (unchecked-multiply-int 2 (.getNumLimbs params)) 2))
                    (do (.append result ", ") (recur (unchecked-inc-int i)))
                    (recur (unchecked-inc-int i)))))
            (.append result ");\n")
            (.decrIndent result)
            (.appendLine result "}")
            (.decrIndent result)
            (.appendLine result "}")
            (.toString result))))))

  (method ^:private ^:static write ^void [^CodeBuffer out ^{:tag (List CarryReduce)} sequence
                                          ^FieldParams params ^String prefix ^int numLimbs]
    (.startCrSequence out numLimbs)
    (loop [^int i 0]
      (when (< i (.size sequence))
        (let [cr (cast CarryReduce (.get sequence i))
              ^{:tag (Iterator CarryReduce)} remainingIter (.listIterator
                                                             sequence
                                                             (unchecked-add-int i 1))
              ^{:tag (List CarryReduce)} remaining (ArrayList.)]
          (.forEachRemaining remainingIter (method-ref Consumer [CarryReduce] remaining List/.add))
          (.write cr out params prefix remaining)
          (recur (unchecked-inc-int i))))))

  (method ^:private ^:static reduce ^void [^CodeBuffer out ^FieldParams params ^String prefix
                                           ^int index ^{:tag (Iterable CarryReduce)} remaining]
    (.record out Reduce)
    (.appendLine out (java-str "//reduce from position " index))
    (let [reduceFrom (FieldGen/indexedExpr false prefix index)
          ^:mutable referenced false]
      (for-each [^CarryReduce cr remaining] (when (== (.-index cr) index) (set! referenced true)))
      (for-each [^Term t (.getTerms params)]
        (let [reduceBits (unchecked-subtract-int (.getPower params) (.getPower t))
              negatedCoefficient (unchecked-multiply-int -1 (.getCoefficient t))]
          (FieldGen/modReduceInBits out
                                    params
                                    false
                                    prefix
                                    index
                                    reduceBits
                                    negatedCoefficient
                                    reduceFrom)))
      (when referenced (.appendLine out (java-str reduceFrom " = 0;")))))

  (method ^:private ^:static carry ^void [^CodeBuffer out ^FieldParams params ^String prefix
                                          ^int index]
    (.record out Carry)
    (.appendLine out (java-str "//carry from position " index))
    (let [carryFrom (java-str prefix index)
          carryTo (java-str prefix (unchecked-add-int index 1))
          carry (java-str "(" carryFrom " + CARRY_ADD) >> " (.getBitsPerLimb params))
          temp (.getTemporary out "long" carry)]
      (.appendLine out (java-str carryFrom " -= (" temp " << " (.getBitsPerLimb params) ");"))
      (.appendLine out (java-str carryTo " += " temp ";"))
      (.freeTemporary out temp)))

  (method ^:private ^:static indexedExpr ^String [^boolean isArray ^String prefix ^int index]
    (let [^:mutable result (java-str prefix index)]
      (when isArray (set! result (java-str prefix "[" index "]")))
      result))

  (method ^:private ^:static modReduceInBits ^void [^CodeBuffer result ^FieldParams params
                                                    ^boolean isArray ^String prefix ^int index
                                                    ^int reduceBits ^int coefficient ^String c]
    (let [^:mutable x (java-str coefficient " * " c)
          ^:mutable accOp "+="
          ^:mutable ^String temp nil]
      (cond
        (== coefficient 1) (set! x c)
        (== coefficient -1) (do (set! x c) (set! accOp "-="))
        :else (do (set! temp (.getTemporary result "long" x)) (set! x temp)))
      (if (== (unchecked-remainder-int reduceBits (.getBitsPerLimb params)) 0)
          (let [pos (unchecked-divide-int reduceBits (.getBitsPerLimb params))]
            (.appendLine result
                         (java-str (FieldGen/indexedExpr
                                     isArray
                                     prefix
                                     (unchecked-subtract-int index pos))
                                   " "
                                   accOp
                                   " "
                                   x
                                   ";")))
          (let [secondPos (unchecked-divide-int reduceBits (.getBitsPerLimb params))
                bitOffset (unchecked-subtract-int
                            (unchecked-multiply-int
                              (unchecked-add-int secondPos 1)
                              (.getBitsPerLimb params))
                            reduceBits)
                rightBitOffset (unchecked-subtract-int (.getBitsPerLimb params) bitOffset)]
            (.appendLine result
                         (java-str (FieldGen/indexedExpr
                                     isArray
                                     prefix
                                     (unchecked-subtract-int index (unchecked-add-int secondPos 1)))
                                   " "
                                   accOp
                                   " ("
                                   x
                                   " << "
                                   bitOffset
                                   ") & LIMB_MASK;"))
            (.appendLine result
                         (java-str (FieldGen/indexedExpr
                                     isArray
                                     prefix
                                     (unchecked-subtract-int index secondPos))
                                   " "
                                   accOp
                                   " "
                                   x
                                   " >> "
                                   rightBitOffset
                                   ";"))))
      (when (some? temp) (.freeTemporary result temp))))

  (method ^:private readHeader :throws [IOException] ^String [this]
    (let [reader (Files/newBufferedReader headerPath)
          result (StringBuffer.)]
      (.forEach (.lines reader)
                (lambda Consumer ^void [^String s] (.append result (java-str s "\n"))))
      (.toString result))))

  (method ^:private ^:static checkCurrencyCode ^void [^String currencyCode]
    (when-not (== (.length currencyCode) 3)
      (throw (RuntimeException. (java-str "illegal length for currency code: " currencyCode))))
    (loop [^int i 0]
      (when (< i 3)
        (let [aChar (.charAt currencyCode i)]
          (if (and (or (< aChar \A) (> aChar \Z)) (not (.equals currencyCode "XB5")))
              (throw (RuntimeException.
                       (java-str "currency code contains illegal character: " currencyCode)))
              (recur (unchecked-inc-int i))))))
    (when (== (.indexOf validCurrencyCodes currencyCode) -1)
      (throw (RuntimeException. (java-str "currency code not listed as valid: " currencyCode)))))

  (method ^:private ^:static writeOutput :throws [IOException] ^void []
    (.writeInt out MAGIC_NUMBER)
    (.writeInt out (Integer/parseInt formatVersion))
    (.writeInt out (Integer/parseInt dataVersion))
    (GenerateCurrencyData/writeIntArray mainTable (alength mainTable))
    (.writeInt out specialCaseCount)
    (GenerateCurrencyData/writeSpecialCaseEntries)
    (.writeInt out otherCurrenciesCount)
    (GenerateCurrencyData/writeOtherCurrencies))

  (method ^:private ^:static writeIntArray :throws [IOException] ^void [^int/1 ia ^int count]

          (set! str
                (if (some? (aget specialCaseNewCurrencies index))
                    (aget specialCaseNewCurrencies index)
                    ""))
          (.writeUTF out str)
          (.writeInt out (aget specialCaseOldCurrenciesDefaultFractionDigits index))
          (.writeInt out (aget specialCaseNewCurrenciesDefaultFractionDigits index))
          (.writeInt out (aget specialCaseOldCurrenciesNumericCode index))
          (.writeInt out (aget specialCaseNewCurrenciesNumericCode index))
          (recur (unchecked-inc-int index))))))

  (method ^:private ^:static writeOtherCurrencies :throws [IOException] ^void []

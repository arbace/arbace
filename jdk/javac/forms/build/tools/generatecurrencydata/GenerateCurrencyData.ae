                    (throw (RuntimeException. "too many other currencies")))
                  (aset otherCurrencies otherCurrenciesCount currencyCode)
                  (aset otherCurrenciesDefaultFractionDigits
                        otherCurrenciesCount
                        (GenerateCurrencyData/getDefaultFractionDigits currencyCode))
                  (aset otherCurrenciesNumericCode

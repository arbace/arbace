                                   (unchecked-subtract-int (.charAt currencyCode 1) \A)))
                futureCurrency (.contains (Arrays/asList specialCaseNewCurrencies) currencyCode)
                simpleCurrency (== (bit-and-int tableEntry SIMPLE_CASE_COUNTRY_FINAL_CHAR_MASK)
                                   (unchecked-subtract-int (.charAt currencyCode 2) \A))]
            (if (and (not futureCurrency) (not simpleCurrency))

                  (.trim (.replaceFirst (.replaceFirst input ".*\\.\\." "") ";.*" "")))
                start)))

    (method ^:public toString ^String [this]
      (java-str "Start: "
                (GenerateExtraProperties/toHexString start)
                ", Last: "
                (GenerateExtraProperties/toHexString last)))

    (method ^:public compareTo ^int [this ^Range other]

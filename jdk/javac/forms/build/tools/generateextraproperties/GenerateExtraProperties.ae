  (method ^:static rangeToString ^String [^Range r]
    (cond
      (== (.-start r) (.-last r))
        (java-str (.repeat " " 12) "cp == 0x" (GenerateExtraProperties/toHexString (.-start r)))
      (== (.-start r) (unchecked-subtract-int (.-last r) 1))
        (java-str (.repeat " " 12)
                  "cp == 0x"
                  (GenerateExtraProperties/toHexString (.-start r))
                  " ||\n"
                  (.repeat " " 12)
                  "cp == 0x"
                  (GenerateExtraProperties/toHexString (.-last r)))
      :else
        (java-str (.repeat " " 11)
                  "(cp >= 0x"
                  (GenerateExtraProperties/toHexString (.-start r))
                  " && cp <= 0x"
                  (GenerateExtraProperties/toHexString (.-last r))
                  ")")))

  (method ^:static toInt ^int [^String hexStr]
    (Integer/parseUnsignedInt hexStr 16))

  (method ^:static toHexString ^String [^int cp]
    (let [^:mutable ret (.toUpperCase (Integer/toUnsignedString cp 16))]
      (when (< (.length ret) 4)
        (set! ret (java-str (.repeat "0" (unchecked-subtract-int 4 (.length ret))) ret)))
      ret))

  (defclass ^:static Range
    :implements [(Comparable Range)]

    (field ^int start)

    (field ^int last)

    (constructor [this ^int start ^int last]
      (set! (.-start this) start)
      (set! (.-last this) last))

    (constructor [this ^:mutable ^String input]

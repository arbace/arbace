                        (Collections/sort lastRules))
                      (Collections/sort trules)
                      (set! effectiveSavings (unchecked-negate-int negativeSavings))
                      (for-each [^TransRule rule trules]
                        (when (> (.toEpochSecond rule stdOffsetPrev savings)
                                 (.toEpochSecond zoneStart wallOffset))
                          (break))
                        (set! effectiveSavings
                              (unchecked-subtract-int
                                (.-savingsAmount (.-rule rule))
                                negativeSavings))))))
                (let [effectiveWallOffset (ZoneOffset/ofTotalSeconds
                                            (unchecked-add-int
                                              (.getTotalSeconds stdOffset)
                                              effectiveSavings))]
                  (when-not (.equals wallOffset effectiveWallOffset)
                    (.add transitionList
                          (ZoneOffsetTransition/of zoneStart wallOffset effectiveWallOffset)))
                  (set! savings effectiveSavings)
                  (when (some? trules)
                    (let [zoneStartEpochSecs (.toEpochSecond zoneStart wallOffset)]
                      (for-each [^TransRule trule trules]
                        (when (.isTransition trule savings negativeSavings)
                          (let [epochSecs (.toEpochSecond trule stdOffset savings)]
                            (when-not (or (< epochSecs zoneStartEpochSecs)
                                          (>= epochSecs (.toDateTimeEpochSecond zone savings)))
                              (.add transitionList
                                    (.toTransition trule stdOffset savings negativeSavings))
                              (set! savings
                                    (unchecked-subtract-int
                                      (.-savingsAmount (.-rule trule))
                                      negativeSavings))))))))
                  (when (some? lastRules)
                    (for-each [^TransRule trule lastRules]
                      (.add lastTransitionRuleList
                            (.toTransitionRule (.-rule trule) stdOffset savings negativeSavings))
                      (set! savings
                            (unchecked-subtract-int
                              (.-savingsAmount (.-rule trule))
                              negativeSavings))))
                  (set! wallOffset
                        (ZoneOffset/ofTotalSeconds
                          (unchecked-add-int (.getTotalSeconds stdOffset) savings)))
                  (set! zoneStart
                        (LocalDateTime/ofEpochSecond
                          (.toDateTimeEpochSecond zone savings)
                          0
                          wallOffset))))))))
      (ZoneRules. firstStdOffset
                  firstWallOffset
                  standardTransitionList
                  transitionList
                  lastTransitionRuleList)))

  (method ^:private findNegativeSavings ^int [this ^LocalDateTime zoneStart ^ZoneLine zl]
    (let [^:mutable ^int negativeSavings 0
          zoneEnd (.toDateTime zl)]
      (when (some? (.-savingsRule zl))
        (let [^{:tag (List RuleLine)} rlines (cast List (.get rules (.-savingsRule zl)))]
          (when (nil? rlines)
            (throw (IllegalArgumentException. (java-str "<Rule> not found: " (.-savingsRule zl)))))
          (set! negativeSavings
                (^[int int] Math/min 0
                                     (.intValue (cast
                                                  Integer
                                                  (.orElse
                                                    (.min
                                                      (.map
                                                        (.filter
                                                          (.stream rlines)
                                                          (lambda Predicate ^boolean [^RuleLine l]
                                                            (.windowOverlap
                                                              this
                                                              l
                                                              (.getYear zoneStart)
                                                              (.getYear zoneEnd))))
                                                        (lambda Function ^Integer [^RuleLine l]
                                                          (.-savingsAmount l)))
                                                      (Comparator/naturalOrder))
                                                    (Integer/valueOf 0))))))))
      negativeSavings))

  (method ^:private windowOverlap ^boolean [this ^RuleLine ruleLine ^int zoneStartYear
                                            ^int zoneEndYear]
    (let [overlap (or (and (<= zoneStartYear (.-startYear ruleLine))
                           (>= zoneEndYear (.-startYear ruleLine)))
                      (and (<= zoneStartYear (.-endYear ruleLine))
                           (>= zoneEndYear (.-endYear ruleLine))))]
      overlap)))

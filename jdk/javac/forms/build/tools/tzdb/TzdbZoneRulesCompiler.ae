  (method ^:private ^:static outputHelp ^void []
    (.println System/out "Usage: TzdbZoneRulesCompiler <options> <tzdb source filenames>")
    (.println System/out "where options include:")
    (.println System/out "   -srcdir  <directory>  Where to find tzdb source directory (required)")

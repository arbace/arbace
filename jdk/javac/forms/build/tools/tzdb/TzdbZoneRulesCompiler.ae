    (.println System/out "   -help                 Print this usage message")
    (.println System/out "   -verbose              Output verbose information during compilation")
    (.println System/out
              " The source directory must contain the unpacked tzdb files, such as asia or europe"))

  (method ^:private outputFile ^void [this ^Path dstFile ^String version
                                      ^{:tag (SortedMap String ZoneRules)} builtZones
                                      ^{:tag (Map String String)} links]

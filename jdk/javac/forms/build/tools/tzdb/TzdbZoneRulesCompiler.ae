              (.writeShort out (.size builtZones))
              (for-each [^{:tag (Map$Entry String ZoneRules)} entry (.entrySet builtZones)]
                (let [regionIndex (TzdbZoneRulesCompiler/findRegionIndex
                                    regionArray

                      rulesIndex (.indexOf rulesList (.getValue entry))]
                  (.writeShort out regionIndex)
                  (.writeShort out rulesIndex)))
              (.writeShort out (.size links))
              (for-each [^{:tag (Map$Entry String String)} entry (.entrySet links)]
                (let [aliasIndex (TzdbZoneRulesCompiler/findRegionIndex
                                   regionArray
                                   (cast String (.getKey entry)))
                      regionIndex (TzdbZoneRulesCompiler/findRegionIndex

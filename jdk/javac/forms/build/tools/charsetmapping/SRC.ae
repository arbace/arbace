(in-ns 'build.tools.charsetmapping)

(import '(java.io File FileOutputStream PrintStream)
        '(java.util Scanner))

(defclass ^:public SRC
  (method ^:public ^:static genClass :throws [Exception] ^void [^Charset cs ^String srcDir
                                                                ^String dstDir]
    (let [clzName (.-clzName cs)
          csName (.-csName cs)
          pkgName (.-pkgName cs)]
      (with-resources [s (Scanner. (File. srcDir (java-str clzName ".java.template")))
                       out (PrintStream. (FileOutputStream.
                                           (File. dstDir (java-str clzName ".java"))))]
        (while (.hasNextLine s)
          (let [line (.nextLine s)]
            (cond
              (< (.indexOf line "$") 0) (.println out line)
              (not (== (.indexOf line "$PACKAGE$") -1))
                (.println out (.replace line "$PACKAGE$" pkgName))
              (not (== (.indexOf line "$ALIASES$") -1))
                (if (.equals "sun.nio.cs" pkgName)
                    (.println out
                              (.replace line
                                        "$ALIASES$"
                                        (java-str "StandardCharsets.aliases_" clzName "()")))
                    (.println out
                              (.replace line
                                        "$ALIASES$"
                                        (java-str "ExtendedCharsets.aliasesFor(\"" csName "\")"))))
              :else (.println out line))))))))

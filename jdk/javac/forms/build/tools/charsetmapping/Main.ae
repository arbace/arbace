;; Converted from jdk26u make/jdk/src/classes/build/tools/charsetmapping/Main.java by arbace.repr.java. Regenerate rather than edit.

(in-ns 'build.tools.charsetmapping)

(import '(java.io File)
        '(java.util ArrayList LinkedHashMap Locale Scanner))

(defclass ^:public Main
  (method ^:public ^:static main :throws [Throwable] ^void [^String/1 args]
    (let [^int SRC_DIR 0
          ^int DST_DIR 1
          ^int TYPE 2
          ^int CHARSETS 3
          ^int OS 4
          ^int TEMPLATE 5
          ^int EXT_SRC 6
          ^int COPYRIGHT_SRC 7]
      (when (< (alength args) 3)
        (.println System/out
                  "Usage: java -jar charsetmapping.jar src dst spiType charsets os [template]")
        (System/exit 1))
      (let [isStandard (.equals "stdcs" (aget args TYPE))
            isExtended (.equals "extcs" (aget args TYPE))]
        (cond
          (or isStandard isExtended)
            (let [^{:tag (LinkedHashMap String Charset)} charsets (Main/getCharsets
                                                                    (File.
                                                                      (aget args SRC_DIR)
                                                                      (aget args CHARSETS)))
                  osStdcs (Main/getOSStdCSList (File. (aget args SRC_DIR) (aget args OS)))
                  ^:mutable hasBig5_HKSCS false
                  ^:mutable hasMS950_HKSCS false
                  ^:mutable hasMS950_HKSCS_XP false
                  ^:mutable hasEUC_TW false]
              (for-each [^String name osStdcs]
                (let [cs (cast Charset (.get charsets name))]
                  (when (some? cs) (set! (.-pkgName cs) "sun.nio.cs"))
                  (cond
                    (.equals name "Big5_HKSCS") (set! hasBig5_HKSCS true)
                    (.equals name "MS950_HKSCS") (set! hasMS950_HKSCS true)
                    (.equals name "MS950_HKSCS_XP") (set! hasMS950_HKSCS_XP true)
                    (.equals name "EUC_TW") (set! hasEUC_TW true))))
              (for-each [^Charset cs (.values charsets)]
                (when-not (or (and isStandard (.equals (.-pkgName cs) "sun.nio.cs.ext"))
                              (and isExtended (.equals (.-pkgName cs) "sun.nio.cs")))
                  (Main/verbose cs)
                  (switch (.-type cs)
                    "template" (SRC/genClass cs (aget args EXT_SRC) (aget args DST_DIR))
                    "sbcs"
                      (SBCS/genClass cs
                                     (aget args SRC_DIR)
                                     (aget args DST_DIR)
                                     "SingleByte-X.java.template")
                    "source" nil
                    (DBCS/genClass
                      ^String (if (.equals "dbcs" (.-type cs))
                                  ""
                                  (java-str "_" (.toUpperCase (.-type cs) Locale/ENGLISH)))
                      cs
                      (aget args SRC_DIR)
                      (aget args DST_DIR)
                      "DoubleByte-X.java.template"))))
              (SPI/genClass (aget args TYPE)
                            charsets
                            (aget args SRC_DIR)
                            (aget args DST_DIR)
                            (aget args TEMPLATE)
                            ^String (if (.endsWith (aget args OS) "windows") "windows" "unix"))
              (when (or (and isStandard (or hasBig5_HKSCS hasMS950_HKSCS))
                        (and isExtended (not (or hasBig5_HKSCS hasMS950_HKSCS))))
                (HKSCS/genClass2008 (aget args SRC_DIR)
                                    (aget args DST_DIR)
                                    ^String (if isStandard "sun.nio.cs" "sun.nio.cs.ext")
                                    (File. (aget args COPYRIGHT_SRC) "HKSCS.java")))
              (when (or (and isStandard hasMS950_HKSCS_XP) (and isExtended (not hasMS950_HKSCS_XP)))
                (HKSCS/genClassXP (aget args SRC_DIR)
                                  (aget args DST_DIR)
                                  ^String (if isStandard "sun.nio.cs" "sun.nio.cs.ext")
                                  (File. (aget args COPYRIGHT_SRC) "HKSCS.java")))
              (when (and isStandard hasEUC_TW) (EUC_TW/genClass "sun.nio.cs" args))
              (when (and (not isStandard) (not hasEUC_TW)) (EUC_TW/genClass "sun.nio.cs.ext" args)))
          (.equals "sjis0213" (aget args TYPE)) (JIS0213/genClass args)
          (.equals "hkscs" (aget args TYPE)) (HKSCS/genClass2001 args)))))

  (method ^:private ^:static getCharsets :throws [Throwable] ^{:tag (LinkedHashMap String Charset)} [^File cslist]
    (let [^{:tag (LinkedHashMap String Charset)} charsets (LinkedHashMap.)]
      (with-resources [s (Scanner. cslist)]
        (let [^:mutable ^Charset cs nil
              ^{:tag (ArrayList String)} names (ArrayList.)]
          (while (.hasNextLine s)
            (let [line (.nextLine s)]
              (when-not (or (.startsWith line "#") (== (.length line) 0))
                (let [tokens (.split line "\\s+")]
                  (when-not (< (alength tokens) 2)
                    (if (.equals "charset" (aget tokens 0))
                        (do
                          (when (some? cs)
                            (set! (.-aliases cs)
                                  (cast String/1 (.toArray names (new String/1 (.size names)))))
                            (.put charsets (.-clzName cs) cs)
                            (set! cs nil)
                            (.clear names))
                          (when (< (alength tokens) 3)
                            (throw (RuntimeException.
                                     (java-str "Error: incorrect charset line [" line "]"))))
                          (when (some? (set! cs (cast Charset (.get charsets (aget tokens 2)))))
                            (throw (RuntimeException.
                                     (java-str "Error: duplicate charset line [" line "]"))))
                          (set! cs (Charset.))
                          (set! (.-csName cs) (aget tokens 1))
                          (set! (.-clzName cs) (aget tokens 2)))
                        (let [key (aget tokens 1)]
                          (switch key
                            "alias"
                              (cond
                                (< (alength tokens) 3)
                                  (throw (RuntimeException.
                                           (java-str "Error: incorrect alias line [" line "]")))
                                (some? names) (.add names (aget tokens 2)))
                            "package" (set! (.-pkgName cs) (aget tokens 2))
                            "type" (set! (.-type cs) (aget tokens 2))
                            "os" (set! (.-os cs) (aget tokens 2))
                            "histname" (set! (.-histName cs) (aget tokens 2))
                            "ascii" (set! (.-isASCII cs) (Boolean/parseBoolean (aget tokens 2)))
                            "minmax"
                              (do
                                (set! (.-b1Min cs) (Main/toInteger (aget tokens 2)))
                                (set! (.-b1Max cs) (Main/toInteger (aget tokens 3)))
                                (set! (.-b2Min cs) (Main/toInteger (aget tokens 4)))
                                (set! (.-b2Max cs) (Main/toInteger (aget tokens 5))))
                            "internal"
                              (set! (.-isInternal cs) (Boolean/parseBoolean (aget tokens 2)))
                            nil))))))))
          (when (some? cs)
            (set! (.-aliases cs) (cast String/1 (.toArray names (new String/1 (.size names)))))
            (.put charsets (.-clzName cs) cs))))
      charsets))

  (method ^:private ^:static getOSStdCSList :throws [Throwable] ^String/1 [^File stdcsos]
    (let [^{:tag (ArrayList String)} names (ArrayList.)]
      (when (.exists stdcsos)
        (with-resources [s (Scanner. stdcsos)]
          (while (.hasNextLine s)
            (let [^:mutable line (.nextLine s)
                  i (.indexOf line \#)]
              (when-not (== i -1) (set! line (.substring line 0 i)))
              (set! line (.trim line))
              (when-not (== (.length line) 0) (.add names line))))))
      (cast String/1 (.toArray names (new String/1 (.size names))))))

  (method ^:static verbose ^void [^Charset cs]
    (.printf System/out
             "%s, %s, %s, %s, %s  %b%n"
             (new Object/1
                  [(.-clzName cs)
                   (.-csName cs)
                   (.-histName cs)
                   (.-pkgName cs)
                   (.-type cs)
                   (.-isASCII cs)])))

  (method ^:static toInteger ^int [^String s]
    (if (or (.startsWith s "0x") (.startsWith s "0X"))
        (Integer/valueOf (.substring s 2) 16)
        (Integer/valueOf s))))

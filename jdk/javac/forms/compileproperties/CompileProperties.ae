  (method ^:private createFile ^boolean [this ^String propertiesPath ^String outputPath
                                         ^String superClass]
    (let [^:mutable ok true]
      (.verbose log (java-str "parsing: " propertiesPath))
      (let [p (Properties.)]
        (try
          (with-resources [input (Files/newBufferedReader
                                   (Path/of propertiesPath (new String/1 [])))]
            (.load p input))
          (catch FileNotFoundException e
            (set! ok false)
            (.error log (java-str "Cannot find file " propertiesPath) e))
          (catch IOException e
            (set! ok false)
            (.error log (java-str "IO error on file " propertiesPath) e)))
        (when ok
          (let [packageName (CompileProperties/inferPackageName propertiesPath outputPath)]
            (.verbose log (java-str "inferred package name: " packageName))
            (let [^{:tag (List String)} sortedKeys (ArrayList.)]
              (for-each [key (.keySet p)] (.add sortedKeys (cast String key)))
              (Collections/sort sortedKeys)
              (let [^{:tag (Iterator String)} keys (.iterator sortedKeys)
                    data (StringBuffer.)]
                (while (.hasNext keys)
                  (let [key (cast String (.next keys))]
                    (.append data
                             (java-str "            { \""
                                       (CompileProperties/escape key)
                                       "\", \""
                                       (CompileProperties/escape (cast String (.get p key)))
                                       "\" },\n"))))
                (let [file (File. outputPath)
                      name (.getName file)
                      dotIndex (.lastIndexOf name \.)
                      ^String className (if (== dotIndex -1) name (.substring name 0 dotIndex))]
                  (let [^:mutable packageString ""]
                    (when (and (some? packageName) (not (.equals packageName "")))
                      (set! packageString (java-str "package " packageName ";\n\n")))
                    (let [^:mutable ^Writer writer nil]
                      (try
                        (set! writer
                              (BufferedWriter.
                                (OutputStreamWriter.
                                  (FileOutputStream. outputPath)
                                  StandardCharsets/US_ASCII)))
                        (let [format (MessageFormat. FORMAT)]
                          (.write
                            writer
                            (.format format
                                     (new Object/1 [packageString className superClass data]))))
                        (catch IOException e
                          (set! ok false)
                          (.error log (java-str "IO error writing to file " outputPath) e)))
                      (when (some? writer)
                        (try
                          (.flush writer)
                          (catch IOException e
                            (set! ok false)
                            (.error log (java-str "IO error flush " outputPath) e)))
                        (try
                          (.close writer)
                          (catch IOException e
                            (set! ok false)
                            (.error log (java-str "IO error close " outputPath) e))))
                      (.verbose log (java-str "wrote: " outputPath)))))))))
        ok)))

  (method ^:private ^:static usage ^void [^Log log]
    (.info log "usage:")
    (.info
      log
      "    java CompileProperties {-compile path_to_properties_file path_to_java_output_file super_class} -or- @optionsfile")
    (.info log "")
    (.info log "Example:")
    (.info
      log
      "    java CompileProperties -compile test.properties test.java java.util.ListResourceBundle")
    (.info log "    java CompileProperties @optionsfile")
    (.info log
           "optionsfile contains: -compile test.properties test.java java.util.ListResourceBundle"))

  (method ^:private ^:static escape ^String [^String theString]
    (let [len (.length theString)
          outBuffer (StringBuffer. (unchecked-multiply-int len 2))]
      (loop [^int x 0]
        (when (< x len)
          (let [aChar (.charAt theString x)]
            (switch aChar
              \\ (do (.append outBuffer \\) (.append outBuffer \\) (recur (unchecked-inc-int x)))
              \tab (do (.append outBuffer \\) (.append outBuffer \t) (recur (unchecked-inc-int x)))
              \newline
                (do (.append outBuffer \\) (.append outBuffer \n) (recur (unchecked-inc-int x)))
              \return
                (do (.append outBuffer \\) (.append outBuffer \r) (recur (unchecked-inc-int x)))
              \formfeed
                (do (.append outBuffer \\) (.append outBuffer \f) (recur (unchecked-inc-int x)))
              (if (or (< aChar 0x0020) (> aChar 0x007e))
                  (do
                    (.append outBuffer \\)
                    (.append outBuffer \u)
                    (.append outBuffer
                             (CompileProperties/toHex
                               (bit-and-int (bit-shift-right-int aChar 12) 0xF)))
                    (.append outBuffer
                             (CompileProperties/toHex
                               (bit-and-int (bit-shift-right-int aChar 8) 0xF)))
                    (.append outBuffer
                             (CompileProperties/toHex
                               (bit-and-int (bit-shift-right-int aChar 4) 0xF)))
                    (.append outBuffer (CompileProperties/toHex (bit-and-int aChar 0xF)))
                    (recur (unchecked-inc-int x)))
                  (do
                    (when-not (== (.indexOf specialSaveChars aChar) -1) (.append outBuffer \\))
                    (.append outBuffer aChar)
                    (recur (unchecked-inc-int x))))))))
      (.toString outBuffer)))

  (method ^:private ^:static inferPackageName ^String [^:mutable ^String inputPath
                                                       ^:mutable ^String outputPath]
    (set! inputPath (.getPath (File. inputPath)))
    (set! outputPath (.getPath (File. outputPath)))
    (let [^String sep (if (== File/separatorChar \\) "\\\\" File/separator)]
      (let [inputs (.split inputPath sep)
            outputs (.split outputPath sep)
            ^:mutable ^int inStart 0
            inEnd (unchecked-subtract-int (alength inputs) 2)
            outEnd (unchecked-subtract-int (alength outputs) 2)
            ^:mutable i inEnd
            ^:mutable j outEnd]
        (while (and (>= i 0) (>= j 0))
          (when (or (or
                      (not (.equals (aget inputs i) (aget outputs j)))
                      (and (.equals (aget inputs i) "gensrc") (.equals (aget outputs j) "gensrc")))
                    (.contains (aget inputs i) "."))
            (set! i (unchecked-inc-int i))
            (set! j (unchecked-inc-int j))
            (break))
          (set! i (unchecked-dec-int i))
          (set! j (unchecked-dec-int j)))
        (let [^:mutable ^String result nil]
          (if (or (or (or (< i 0) (< j 0)) (>= i inEnd)) (>= j outEnd))
              (set! result "")
              (do
                (set! inStart i)
                (let [buf (StringBuffer.)]
                  (set! i inStart)
                  (while (<= i inEnd)
                    (.append buf (aget inputs i))
                    (when (< i inEnd) (.append buf \.))
                    (set! i (unchecked-inc-int i)))
                  (set! result (.toString buf)))))
          result))))

  (field ^:private ^:static ^:final ^String FORMAT
    "{0}public final class {1} extends {2} '{'\n    protected final Object[][] getContents() '{'\n        return new Object[][] '{'\n{3}        };\n    }\n}\n")


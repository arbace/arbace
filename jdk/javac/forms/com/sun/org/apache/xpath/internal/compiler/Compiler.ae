  (method ^:public getWhatToShow ^int [this ^int opPos]
    (let [axesType (.getOp this opPos)
          testType (.getOp this (unchecked-add-int opPos 3))]
      (switch testType
        OpCodes/NODETYPE_COMMENT DTMFilter/SHOW_COMMENT
        OpCodes/NODETYPE_TEXT (bit-or-int DTMFilter/SHOW_TEXT DTMFilter/SHOW_CDATA_SECTION)
        OpCodes/NODETYPE_PI DTMFilter/SHOW_PROCESSING_INSTRUCTION
        OpCodes/NODETYPE_NODE
          (switch axesType
            OpCodes/FROM_NAMESPACE DTMFilter/SHOW_NAMESPACE
            (OpCodes/FROM_ATTRIBUTES OpCodes/MATCH_ATTRIBUTE) DTMFilter/SHOW_ATTRIBUTE
            (OpCodes/FROM_SELF OpCodes/FROM_ANCESTORS_OR_SELF OpCodes/FROM_DESCENDANTS_OR_SELF)
              DTMFilter/SHOW_ALL
            (if (== (.getOp this 0) OpCodes/OP_MATCHPATTERN)
                (bit-and-int (bit-and-int (bit-not-int DTMFilter/SHOW_ATTRIBUTE)
                                          (bit-not-int DTMFilter/SHOW_DOCUMENT))
                             (bit-not-int DTMFilter/SHOW_DOCUMENT_FRAGMENT))
                (bit-not-int DTMFilter/SHOW_ATTRIBUTE)))
        OpCodes/NODETYPE_ROOT (bit-or-int DTMFilter/SHOW_DOCUMENT DTMFilter/SHOW_DOCUMENT_FRAGMENT)
        OpCodes/NODETYPE_FUNCTEST NodeTest/SHOW_BYFUNCTION
        OpCodes/NODENAME
          (switch axesType
            OpCodes/FROM_NAMESPACE DTMFilter/SHOW_NAMESPACE
            (OpCodes/FROM_ATTRIBUTES OpCodes/MATCH_ATTRIBUTE) DTMFilter/SHOW_ATTRIBUTE
            (OpCodes/MATCH_ANY_ANCESTOR OpCodes/MATCH_IMMEDIATE_ANCESTOR) DTMFilter/SHOW_ELEMENT
            DTMFilter/SHOW_ELEMENT)
        DTMFilter/SHOW_ALL)))

  (field ^:private ^:static ^:final ^boolean DEBUG false)

  (method ^:protected stepPattern :throws [TransformerException] ^StepPattern [this
                                                                               ^:mutable ^int opPos
                                                                               ^int stepCount
                                                                               ^StepPattern ancestorPattern]
    (let [startOpPos opPos
          stepType (.getOp this opPos)]
      (when-not (== OpCodes/ENDOP stepType)
        (let [^:mutable addMagicSelf true
              endStep (.getNextOpPos this opPos)
              ^:mutable ^StepPattern pattern nil
              ^:mutable ^int argLen 0]
          (switch stepType
            OpCodes/OP_FUNCTION
              (do
                (when DEBUG
                  (.println System/out (java-str "MATCH_FUNCTION: " (.-m_currentPattern this))))
                (set! addMagicSelf false)
                (set! argLen (.getOp this (unchecked-add-int opPos OpMap/MAPINDEX_LENGTH)))
                (set! pattern
                      (FunctionPattern. (.compileFunction this opPos) Axis/PARENT Axis/CHILD)))
            OpCodes/FROM_ROOT
              (do
                (when DEBUG
                  (.println System/out (java-str "FROM_ROOT, " (.-m_currentPattern this))))
                (set! addMagicSelf false)
                (set! argLen (.getArgLengthOfStep this opPos))
                (set! opPos (Compiler/getFirstChildPosOfStep opPos))
                (set! pattern
                      (StepPattern. (bit-or-int DTMFilter/SHOW_DOCUMENT
                                                DTMFilter/SHOW_DOCUMENT_FRAGMENT)
                                    Axis/PARENT
                                    Axis/CHILD)))
            OpCodes/MATCH_ATTRIBUTE
              (do
                (when DEBUG
                  (.println System/out
                            (java-str "MATCH_ATTRIBUTE: "
                                      (.getStepLocalName this startOpPos)
                                      ", "
                                      (.-m_currentPattern this))))
                (set! argLen (.getArgLengthOfStep this opPos))
                (set! opPos (Compiler/getFirstChildPosOfStep opPos))
                (set! pattern
                      (StepPattern. DTMFilter/SHOW_ATTRIBUTE
                                    (.getStepNS this startOpPos)
                                    (.getStepLocalName this startOpPos)
                                    Axis/PARENT
                                    Axis/ATTRIBUTE)))
            OpCodes/MATCH_ANY_ANCESTOR
              (do
                (when DEBUG
                  (.println System/out
                            (java-str "MATCH_ANY_ANCESTOR: "
                                      (.getStepLocalName this startOpPos)
                                      ", "
                                      (.-m_currentPattern this))))
                (set! argLen (.getArgLengthOfStep this opPos))
                (set! opPos (Compiler/getFirstChildPosOfStep opPos))
                (let [what (.getWhatToShow this startOpPos)]
                  (when (== 0x00000500 what) (set! addMagicSelf false))
                  (set! pattern
                        (StepPattern. (.getWhatToShow this startOpPos)
                                      (.getStepNS this startOpPos)
                                      (.getStepLocalName this startOpPos)
                                      Axis/ANCESTOR
                                      Axis/CHILD))))
            OpCodes/MATCH_IMMEDIATE_ANCESTOR
              (do
                (when DEBUG
                  (.println System/out
                            (java-str "MATCH_IMMEDIATE_ANCESTOR: "
                                      (.getStepLocalName this startOpPos)
                                      ", "
                                      (.-m_currentPattern this))))
                (set! argLen (.getArgLengthOfStep this opPos))
                (set! opPos (Compiler/getFirstChildPosOfStep opPos))
                (set! pattern
                      (StepPattern. (.getWhatToShow this startOpPos)
                                    (.getStepNS this startOpPos)
                                    (.getStepLocalName this startOpPos)
                                    Axis/PARENT
                                    Axis/CHILD)))
            (do (.error this XPATHErrorResources/ER_UNKNOWN_MATCH_OPERATION nil) (return nil)))
          (.setPredicates pattern (.getCompiledPredicates this (unchecked-add-int opPos argLen)))
          (when (some? ancestorPattern) (.setRelativePathPattern pattern ancestorPattern))
          (let [relativePathPattern (.stepPattern
                                      this
                                      endStep
                                      (unchecked-add-int stepCount 1)
                                      pattern)]
            (if (some? relativePathPattern) relativePathPattern pattern))))))

  (method ^:public getCompiledPredicates :throws [TransformerException] ^Expression/1 [this
                                                                                       ^int opPos]
    (let [count (.countPredicates this opPos)]
      (when (> count 0)
        (let [predicates (new Expression/1 count)]
          (.compilePredicates this opPos predicates)
          predicates))))

  (method ^:public countPredicates :throws [TransformerException] ^int [this ^:mutable ^int opPos]
    (let [^:mutable ^int count 0]
      (while (== OpCodes/OP_PREDICATE (.getOp this opPos))
        (set! count (unchecked-inc-int count))
        (set! opPos (.getNextOpPos this opPos)))
      count))

  (method ^:private compilePredicates :throws [TransformerException] ^void [this
                                                                            ^:mutable ^int opPos
                                                                            ^Expression/1 predicates]
    (loop [^int i 0]
      (when (== OpCodes/OP_PREDICATE (.getOp this opPos))
        (aset predicates i (.predicate this opPos))
        (set! opPos (.getNextOpPos this opPos))
        (recur (unchecked-inc-int i)))))

  (method compileFunction :throws [TransformerException] ^Expression [this ^:mutable ^int opPos]
    (let [endFunc (unchecked-subtract-int
                    (unchecked-add-int opPos (.getOp this (unchecked-add-int opPos 1)))
                    1)]
      (set! opPos (Compiler/getFirstChildPos opPos))
      (let [funcID (.getOp this opPos)]
        (set! opPos (unchecked-inc-int opPos))
        (if (not (== -1 funcID))
            (let [func (.getFunction m_functionTable funcID)]
              (when (instance? FuncExtFunctionAvailable func)
                (.setFunctionTable (cast FuncExtFunctionAvailable func) m_functionTable))
              (.postCompileStep func this)
              (try
                (let [^:mutable ^int i 0]
                  (let [^:mutable p opPos]
                    (while (< p endFunc)
                      (.setArg func (.compile this p) i)
                      (set! p (.getNextOpPos this p))
                      (set! i (unchecked-inc-int i))))
                  (.checkNumberArgs func i))
                (catch WrongNumberArgsException wnae
                  (let [name (.getFunctionName m_functionTable funcID)]
                    (.fatalError m_errorHandler
                                 (TransformerException.
                                   (XSLMessages/createXPATHMessage
                                     XPATHErrorResources/ER_ONLY_ALLOWS
                                     (new Object/1 [name (.getMessage wnae)]))
                                   m_locator)))))
              func)
            (do (.error this XPATHErrorResources/ER_FUNCTION_TOKEN_NOT_FOUND nil) nil)))))

  (field ^:private ^:static ^long s_nextMethodId 0)

  (method ^:private ^:synchronized getNextMethodId ^long [this]
    (when (== s_nextMethodId Long/MAX_VALUE) (set! s_nextMethodId 0))
    (let [s_nextMethodId-1 s_nextMethodId]
      (set! s_nextMethodId (unchecked-inc s_nextMethodId))
      s_nextMethodId-1))

  (method ^:private compileExtension :throws [TransformerException] ^Expression [this
                                                                                 ^:mutable ^int opPos]
    (let [endExtFunc (unchecked-subtract-int
                       (unchecked-add-int opPos (.getOp this (unchecked-add-int opPos 1)))
                       1)]
      (set! opPos (Compiler/getFirstChildPos opPos))
      (let [ns (cast String (.elementAt (.getTokenQueue this) (.getOp this opPos)))]
        (set! opPos (unchecked-inc-int opPos))
        (let [funcName (cast String (.elementAt (.getTokenQueue this) (.getOp this opPos)))]
          (set! opPos (unchecked-inc-int opPos))
          (let [^Function extension (FuncExtFunction.
                                      ns
                                      funcName
                                      (String/valueOf (.getNextMethodId this)))]
            (try
              (let [^:mutable ^int i 0]
                (while (< opPos endExtFunc)
                  (let [nextOpPos (.getNextOpPos this opPos)]
                    (.setArg extension (.compile this opPos) i)
                    (set! opPos nextOpPos)
                    (set! i (unchecked-inc-int i)))))
              (catch WrongNumberArgsException wnae))
            extension)))))

  (method ^:public warn :throws [TransformerException] ^void [this ^String msg ^Object/1 args]
    (let [fmsg (XSLMessages/createXPATHWarning msg args)]
      (if (some? m_errorHandler)
          (.warning m_errorHandler (TransformerException. fmsg m_locator))
          (.println System/out
                    (java-str fmsg
                              "; file "
                              (.getSystemId m_locator)
                              "; line "
                              (.getLineNumber m_locator)
                              "; column "
                              (.getColumnNumber m_locator))))))

  (method ^:public assertion ^void [this ^boolean b ^String msg]
    (when-not b
      (let [fMsg (XSLMessages/createXPATHMessage
                   XPATHErrorResources/ER_INCORRECT_PROGRAMMER_ASSERTION
                   (new Object/1 [msg]))]
        (throw (RuntimeException. fMsg)))))

  (method ^:public error :throws [TransformerException] ^void [this ^String msg ^Object/1 args]
    (let [fmsg (XSLMessages/createXPATHMessage msg args)]
      (if (some? m_errorHandler)
          (.fatalError m_errorHandler (TransformerException. fmsg m_locator))
          (throw (TransformerException. fmsg (cast SAXSourceLocator m_locator))))))


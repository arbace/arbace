              (.setOp m_ops
                      (unchecked-add-int opPos OpMap/MAPINDEX_LENGTH)
                      (unchecked-subtract-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) opPos))))
          (.LocationPath this))))

  (method ^:protected FilterExpr :throws [TransformerException] ^int [this]
    (let [opPos (.getOp m_ops OpMap/MAPINDEX_LENGTH)
          ^:mutable ^int filterMatch 0]
      (if (.PrimaryExpr this)
          (if (.tokenIs this Token/LBRACK)
              (do
                (.insertOp this opPos 2 OpCodes/OP_LOCATIONPATH)
                (while (.tokenIs this Token/LBRACK) (.Predicate this))
                (set! filterMatch FILTER_MATCH_PREDICATES))
              (set! filterMatch FILTER_MATCH_PRIMARY))
          (set! filterMatch FILTER_MATCH_FAILED))
      filterMatch))

  (method ^:protected PrimaryExpr :throws [TransformerException] ^boolean [this]
    (let [^:mutable ^boolean matchFound false
          opPos (.getOp m_ops OpMap/MAPINDEX_LENGTH)]
      (cond
        (or (== m_tokenChar Token/SQ) (== m_tokenChar Token/DQ))
          (do
            (.appendOp this 2 OpCodes/OP_LITERAL)
            (.Literal this)
            (.setOp m_ops
                    (unchecked-add-int opPos OpMap/MAPINDEX_LENGTH)
                    (unchecked-subtract-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) opPos))
            (set! matchFound true))
        (== m_tokenChar Token/DOLLAR)
          (do
            (.nextToken this)
            (.appendOp this 2 OpCodes/OP_VARIABLE)
            (.QName this)
            (.setOp m_ops
                    (unchecked-add-int opPos OpMap/MAPINDEX_LENGTH)
                    (unchecked-subtract-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) opPos))
            (set! matchFound true))
        (== m_tokenChar Token/LPAREN)
          (do
            (.nextToken this)
            (.appendOp this 2 OpCodes/OP_GROUP)
            (.Expr this)
            (.consumeExpected this Token/RPAREN)
            (.setOp m_ops
                    (unchecked-add-int opPos OpMap/MAPINDEX_LENGTH)
                    (unchecked-subtract-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) opPos))
            (set! matchFound true))
        (and (some? m_token)
             (or (and (and (== \. m_tokenChar) (> (.length m_token) 1))
                      (Character/isDigit (.charAt m_token 1)))
                 (Character/isDigit m_tokenChar)))
          (do
            (.appendOp this 2 OpCodes/OP_NUMBERLIT)
            (.Number this)
            (.setOp m_ops
                    (unchecked-add-int opPos OpMap/MAPINDEX_LENGTH)
                    (unchecked-subtract-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) opPos))
            (set! matchFound true))
        (or (.lookahead this Token/LPAREN 1)
            (and (.lookahead this Token/COLON 1) (.lookahead this Token/LPAREN 3)))
          (set! matchFound (.FunctionCall this))
        :else (set! matchFound false))
      matchFound))

  (method ^:protected Argument :throws [TransformerException] ^void [this]
    (let [opPos (.getOp m_ops OpMap/MAPINDEX_LENGTH)]
      (.appendOp this 2 OpCodes/OP_ARGUMENT)
      (.Expr this)
      (.setOp m_ops
              (unchecked-add-int opPos OpMap/MAPINDEX_LENGTH)
              (unchecked-subtract-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) opPos))))

  (method ^:protected FunctionCall :throws [TransformerException] ^boolean [this]
    (let [opPos (.getOp m_ops OpMap/MAPINDEX_LENGTH)]
      (if (.lookahead this Token/COLON 1)
          (do
            (.appendOp this 4 OpCodes/OP_EXTFUNCTION)
            (.setOp m_ops
                    (unchecked-add-int (unchecked-add-int opPos OpMap/MAPINDEX_LENGTH) 1)
                    (unchecked-subtract-int m_queueMark 1))
            (.nextToken this)
            (.consumeExpected this Token/COLON)
            (.setOp m_ops
                    (unchecked-add-int (unchecked-add-int opPos OpMap/MAPINDEX_LENGTH) 2)
                    (unchecked-subtract-int m_queueMark 1))
            (.nextToken this))
          (let [funcTok (.getFunctionToken this m_token)]
            (when (== -1 funcTok)
              (.error this XPATHErrorResources/ER_COULDNOT_FIND_FUNCTION (new Object/1 [m_token])))
            (switch funcTok
              (OpCodes/NODETYPE_PI OpCodes/NODETYPE_COMMENT
                                   OpCodes/NODETYPE_TEXT
                                   OpCodes/NODETYPE_NODE)
                (return false)
              (do
                (.appendOp this 3 OpCodes/OP_FUNCTION)
                (.setOp m_ops
                        (unchecked-add-int (unchecked-add-int opPos OpMap/MAPINDEX_LENGTH) 1)
                        funcTok)))
            (when (.isNodesetFunction this funcTok) (set! isLocationPath true))
            (.nextToken this)))
      (.consumeExpected this Token/LPAREN)
      (while (and (not (.tokenIs this Token/RPAREN)) (some? m_token))
        (when (.tokenIs this Token/COMMA)
          (.error this XPATHErrorResources/ER_FOUND_COMMA_BUT_NO_PRECEDING_ARG nil))
        (.Argument this)
        (when-not (.tokenIs this Token/RPAREN)
          (.consumeExpected this Token/COMMA)
          (when (.tokenIs this Token/RPAREN)
            (.error this XPATHErrorResources/ER_FOUND_COMMA_BUT_NO_FOLLOWING_ARG nil))))
      (.consumeExpected this Token/RPAREN)
      (.setOp m_ops (.getOp m_ops OpMap/MAPINDEX_LENGTH) OpCodes/ENDOP)
      (.setOp m_ops
              OpMap/MAPINDEX_LENGTH
              (unchecked-add-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) 1))
      (.setOp m_ops
              (unchecked-add-int opPos OpMap/MAPINDEX_LENGTH)
              (unchecked-subtract-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) opPos))
      true))

  (method ^:protected LocationPath :throws [TransformerException] ^void [this]
    (set! isLocationPath true)
    (let [opPos (.getOp m_ops OpMap/MAPINDEX_LENGTH)]
      (.appendOp this 2 OpCodes/OP_LOCATIONPATH)
      (let [seenSlash (.tokenIs this Token/SLASH)]
        (cond
          seenSlash
            (do
              (.appendOp this 4 OpCodes/FROM_ROOT)
              (.setOp m_ops (unchecked-subtract-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) 2) 4)
              (.setOp m_ops
                      (unchecked-subtract-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) 1)
                      OpCodes/NODETYPE_ROOT)
              (.nextToken this))
          (nil? m_token) (.error this XPATHErrorResources/ER_EXPECTED_LOC_PATH_AT_END_EXPR nil))
        (when (some? m_token)
          (when (and (not (.RelativeLocationPath this)) (not seenSlash))
            (.error this XPATHErrorResources/ER_EXPECTED_LOC_PATH (new Object/1 [m_token]))))
        (.setOp m_ops (.getOp m_ops OpMap/MAPINDEX_LENGTH) OpCodes/ENDOP)
        (.setOp m_ops
                OpMap/MAPINDEX_LENGTH
                (unchecked-add-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) 1))
        (.setOp m_ops
                (unchecked-add-int opPos OpMap/MAPINDEX_LENGTH)
                (unchecked-subtract-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) opPos)))))

  (method ^:protected RelativeLocationPath :throws [TransformerException] ^boolean [this]
    (if (not (.Step this))
        false
        (do
          (while (.tokenIs this Token/SLASH)
            (.nextToken this)
            (when-not (.Step this) (.error this XPATHErrorResources/ER_EXPECTED_LOC_STEP nil)))
          true)))

  (method ^:protected Step :throws [TransformerException] ^boolean [this]
    (let [^:mutable opPos (.getOp m_ops OpMap/MAPINDEX_LENGTH)
          doubleSlash (.tokenIs this Token/SLASH)]
      (when doubleSlash
        (.nextToken this)
        (.appendOp this 2 OpCodes/FROM_DESCENDANTS_OR_SELF)
        (.setOp m_ops
                OpMap/MAPINDEX_LENGTH
                (unchecked-add-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) 1))
        (.setOp m_ops (.getOp m_ops OpMap/MAPINDEX_LENGTH) OpCodes/NODETYPE_NODE)
        (.setOp m_ops
                OpMap/MAPINDEX_LENGTH
                (unchecked-add-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) 1))
        (.setOp m_ops
                (unchecked-add-int (unchecked-add-int opPos OpMap/MAPINDEX_LENGTH) 1)
                (unchecked-subtract-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) opPos))
        (.setOp m_ops
                (unchecked-add-int opPos OpMap/MAPINDEX_LENGTH)
                (unchecked-subtract-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) opPos))
        (set! opPos (.getOp m_ops OpMap/MAPINDEX_LENGTH)))
      (cond
        (.tokenIs this Token/DOT_STR)
          (do
            (.nextToken this)
            (when (.tokenIs this Token/LBRACK)
              (.error this XPATHErrorResources/ER_PREDICATE_ILLEGAL_SYNTAX nil))
            (.appendOp this 4 OpCodes/FROM_SELF)
            (.setOp m_ops (unchecked-subtract-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) 2) 4)
            (.setOp m_ops
                    (unchecked-subtract-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) 1)
                    OpCodes/NODETYPE_NODE))
        (.tokenIs this Token/DDOT)
          (do
            (.nextToken this)
            (.appendOp this 4 OpCodes/FROM_PARENT)
            (.setOp m_ops (unchecked-subtract-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) 2) 4)
            (.setOp m_ops
                    (unchecked-subtract-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) 1)
                    OpCodes/NODETYPE_NODE))
        (or (or (or (.tokenIs this Token/STAR) (.tokenIs this Token/AT)) (.tokenIs this Token/US))
            (and (some? m_token) (Character/isLetter (.charAt m_token 0))))
          (do
            (.Basis this)
            (while (.tokenIs this Token/LBRACK) (.Predicate this))
            (.setOp m_ops
                    (unchecked-add-int opPos OpMap/MAPINDEX_LENGTH)
                    (unchecked-subtract-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) opPos)))
        :else
          (do
            (when doubleSlash (.error this XPATHErrorResources/ER_EXPECTED_LOC_STEP nil))
            (return false)))
      true))

  (method ^:protected Basis :throws [TransformerException] ^void [this]
    (let [opPos (.getOp m_ops OpMap/MAPINDEX_LENGTH)
          ^:mutable ^int axesType 0]
      (cond
        (.lookahead this Token/DCOLON 1)
          (do (set! axesType (.AxisName this)) (.nextToken this) (.nextToken this))
        (.tokenIs this Token/AT)
          (do (set! axesType OpCodes/FROM_ATTRIBUTES) (.appendOp this 2 axesType) (.nextToken this))
        :else (do (set! axesType OpCodes/FROM_CHILDREN) (.appendOp this 2 axesType)))
      (.setOp m_ops
              OpMap/MAPINDEX_LENGTH
              (unchecked-add-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) 1))
      (.NodeTest this axesType)
      (.setOp m_ops
              (unchecked-add-int (unchecked-add-int opPos OpMap/MAPINDEX_LENGTH) 1)
              (unchecked-subtract-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) opPos))))

  (method ^:protected AxisName :throws [TransformerException] ^int [this]
    (let [^Object val (Keywords/getAxisName m_token)]
      (when (nil? val)
        (.error this XPATHErrorResources/ER_ILLEGAL_AXIS_NAME (new Object/1 [m_token])))
      (let [axesType (.intValue (cast Integer val))] (.appendOp this 2 axesType) axesType)))

  (method ^:protected NodeTest :throws [TransformerException] ^void [this ^int axesType]
    (if (.lookahead this Token/LPAREN 1)
        (let [^Object nodeTestOp (Keywords/getNodeType m_token)]
          (if (nil? nodeTestOp)
              (.error this XPATHErrorResources/ER_UNKNOWN_NODETYPE (new Object/1 [m_token]))
              (do
                (.nextToken this)
                (let [nt (.intValue (cast Integer nodeTestOp))]
                  (.setOp m_ops (.getOp m_ops OpMap/MAPINDEX_LENGTH) nt)
                  (.setOp m_ops
                          OpMap/MAPINDEX_LENGTH
                          (unchecked-add-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) 1))
                  (.consumeExpected this Token/LPAREN)
                  (when (== OpCodes/NODETYPE_PI nt)
                    (when-not (.tokenIs this Token/RPAREN) (.Literal this)))
                  (.consumeExpected this Token/RPAREN)))))
        (do
          (.setOp m_ops (.getOp m_ops OpMap/MAPINDEX_LENGTH) OpCodes/NODENAME)
          (.setOp m_ops
                  OpMap/MAPINDEX_LENGTH
                  (unchecked-add-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) 1))
          (if (.lookahead this Token/COLON 1)
              (do
                (if (.tokenIs this Token/STAR)
                    (.setOp m_ops (.getOp m_ops OpMap/MAPINDEX_LENGTH) OpCodes/ELEMWILDCARD)
                    (do
                      (.setOp m_ops
                              (.getOp m_ops OpMap/MAPINDEX_LENGTH)
                              (unchecked-subtract-int m_queueMark 1))
                      (when (and (not (Character/isLetter m_tokenChar))
                                 (not (.tokenIs this Token/US)))
                        (.error this XPATHErrorResources/ER_EXPECTED_NODE_TEST nil))))
                (.nextToken this)
                (.consumeExpected this Token/COLON))
              (.setOp m_ops (.getOp m_ops OpMap/MAPINDEX_LENGTH) OpCodes/EMPTY))
          (.setOp m_ops
                  OpMap/MAPINDEX_LENGTH
                  (unchecked-add-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) 1))
          (if (.tokenIs this Token/STAR)
              (.setOp m_ops (.getOp m_ops OpMap/MAPINDEX_LENGTH) OpCodes/ELEMWILDCARD)
              (do
                (.setOp m_ops
                        (.getOp m_ops OpMap/MAPINDEX_LENGTH)
                        (unchecked-subtract-int m_queueMark 1))
                (when (and (not (Character/isLetter m_tokenChar)) (not (.tokenIs this Token/US)))
                  (.error this XPATHErrorResources/ER_EXPECTED_NODE_TEST nil))))
          (.setOp m_ops
                  OpMap/MAPINDEX_LENGTH
                  (unchecked-add-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) 1))
          (.nextToken this))))

  (method ^:protected Predicate :throws [TransformerException] ^void [this]
    (when (.tokenIs this Token/LBRACK)
      (set! countPredicate (unchecked-inc-int countPredicate))
      (.nextToken this)
      (.PredicateExpr this)
      (set! countPredicate (unchecked-dec-int countPredicate))
      (.consumeExpected this Token/RBRACK)))

  (method ^:protected PredicateExpr :throws [TransformerException] ^void [this]
    (let [opPos (.getOp m_ops OpMap/MAPINDEX_LENGTH)]
      (.appendOp this 2 OpCodes/OP_PREDICATE)
      (.Expr this)
      (.setOp m_ops (.getOp m_ops OpMap/MAPINDEX_LENGTH) OpCodes/ENDOP)
      (.setOp m_ops
              OpMap/MAPINDEX_LENGTH
              (unchecked-add-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) 1))
      (.setOp m_ops
              (unchecked-add-int opPos OpMap/MAPINDEX_LENGTH)
              (unchecked-subtract-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) opPos))))

  (method ^:protected QName :throws [TransformerException] ^void [this]
    (if (.lookahead this Token/COLON 1)
        (do
          (.setOp m_ops (.getOp m_ops OpMap/MAPINDEX_LENGTH) (unchecked-subtract-int m_queueMark 1))
          (.setOp m_ops
                  OpMap/MAPINDEX_LENGTH
                  (unchecked-add-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) 1))
          (.nextToken this)
          (.consumeExpected this Token/COLON))
        (do
          (.setOp m_ops (.getOp m_ops OpMap/MAPINDEX_LENGTH) OpCodes/EMPTY)
          (.setOp m_ops
                  OpMap/MAPINDEX_LENGTH
                  (unchecked-add-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) 1))))
    (.setOp m_ops (.getOp m_ops OpMap/MAPINDEX_LENGTH) (unchecked-subtract-int m_queueMark 1))
    (.setOp m_ops OpMap/MAPINDEX_LENGTH (unchecked-add-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) 1))
    (.nextToken this))

  (method ^:protected NCName :throws [TransformerException] ^void [this]
    (.setOp m_ops (.getOp m_ops OpMap/MAPINDEX_LENGTH) (unchecked-subtract-int m_queueMark 1))
    (.setOp m_ops OpMap/MAPINDEX_LENGTH (unchecked-add-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) 1))
    (.nextToken this))

  (method ^:protected Literal :throws [TransformerException] ^void [this]
    (let [last (unchecked-subtract-int (.length m_token) 1)
          c0 m_tokenChar
          cX (.charAt m_token last)]
      (if (or (and (== c0 Token/DQ) (== cX Token/DQ)) (and (== c0 Token/SQ) (== cX Token/SQ)))
          (let [tokenQueuePos (unchecked-subtract-int m_queueMark 1)]
            (.setElementAt (.-m_tokenQueue m_ops) nil tokenQueuePos)
            (let [^Object obj (XString. (.substring m_token 1 last))]
              (.setElementAt (.-m_tokenQueue m_ops) obj tokenQueuePos)
              (.setOp m_ops (.getOp m_ops OpMap/MAPINDEX_LENGTH) tokenQueuePos)
              (.setOp m_ops
                      OpMap/MAPINDEX_LENGTH
                      (unchecked-add-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) 1))
              (.nextToken this)))
          (.error this
                  XPATHErrorResources/ER_PATTERN_LITERAL_NEEDS_BE_QUOTED
                  (new Object/1 [m_token])))))

  (method ^:protected Number :throws [TransformerException] ^void [this]
    (when (some? m_token)
      (let [^:mutable ^double num 0.0]
        (try
          (when (or (> (.indexOf m_token \e) -1) (> (.indexOf m_token \E) -1))
            (throw (NumberFormatException.)))
          (set! num (.doubleValue (Double/valueOf m_token)))
          (catch NumberFormatException nfe
            (set! num 0.0)
            (.error this
                    XPATHErrorResources/ER_COULDNOT_BE_FORMATTED_TO_NUMBER
                    (new Object/1 [m_token]))))
        (.setElementAt (.-m_tokenQueue m_ops) (XNumber. num) (unchecked-subtract-int m_queueMark 1))
        (.setOp m_ops (.getOp m_ops OpMap/MAPINDEX_LENGTH) (unchecked-subtract-int m_queueMark 1))
        (.setOp m_ops
                OpMap/MAPINDEX_LENGTH
                (unchecked-add-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) 1))
        (.nextToken this))))

  (method ^:protected Pattern :throws [TransformerException] ^void [this]
    (while true
      (.LocationPathPattern this)
      (if (.tokenIs this Token/VBAR) (.nextToken this) (break))))

  (method ^:protected LocationPathPattern :throws [TransformerException] ^void [this]
    (let [opPos (.getOp m_ops OpMap/MAPINDEX_LENGTH)
          ^:const ^int RELATIVE_PATH_NOT_PERMITTED 0
          ^:const ^int RELATIVE_PATH_PERMITTED 1
          ^:const ^int RELATIVE_PATH_REQUIRED 2
          ^:mutable relativePathStatus RELATIVE_PATH_NOT_PERMITTED]
      (.appendOp this 2 OpCodes/OP_LOCATIONPATHPATTERN)
      (cond
        (and (.lookahead this Token/LPAREN 1)
             (or (.tokenIs this Keywords/FUNC_ID_STRING) (.tokenIs this Keywords/FUNC_KEY_STRING)))
          (do
            (.IdKeyPattern this)
            (when (.tokenIs this Token/SLASH)
              (.nextToken this)
              (if (.tokenIs this Token/SLASH)
                  (do (.appendOp this 4 OpCodes/MATCH_ANY_ANCESTOR) (.nextToken this))
                  (.appendOp this 4 OpCodes/MATCH_IMMEDIATE_ANCESTOR))
              (.setOp m_ops (unchecked-subtract-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) 2) 4)
              (.setOp m_ops
                      (unchecked-subtract-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) 1)
                      OpCodes/NODETYPE_FUNCTEST)
              (set! relativePathStatus RELATIVE_PATH_REQUIRED)))
        (.tokenIs this Token/SLASH)
          (do
            (if (.lookahead this Token/SLASH 1)
                (do
                  (.appendOp this 4 OpCodes/MATCH_ANY_ANCESTOR)
                  (.nextToken this)
                  (set! relativePathStatus RELATIVE_PATH_REQUIRED))
                (do
                  (.appendOp this 4 OpCodes/FROM_ROOT)
                  (set! relativePathStatus RELATIVE_PATH_PERMITTED)))
            (.setOp m_ops (unchecked-subtract-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) 2) 4)
            (.setOp m_ops
                    (unchecked-subtract-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) 1)
                    OpCodes/NODETYPE_ROOT)
            (.nextToken this))
        :else (set! relativePathStatus RELATIVE_PATH_REQUIRED))
      (when-not (== relativePathStatus RELATIVE_PATH_NOT_PERMITTED)
        (cond
          (and (not (.tokenIs this Token/VBAR)) (some? m_token)) (.RelativePathPattern this)
          (== relativePathStatus RELATIVE_PATH_REQUIRED)
            (.error this XPATHErrorResources/ER_EXPECTED_REL_PATH_PATTERN nil)))
      (.setOp m_ops (.getOp m_ops OpMap/MAPINDEX_LENGTH) OpCodes/ENDOP)
      (.setOp m_ops
              OpMap/MAPINDEX_LENGTH
              (unchecked-add-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) 1))
      (.setOp m_ops
              (unchecked-add-int opPos OpMap/MAPINDEX_LENGTH)
              (unchecked-subtract-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) opPos))))

  (method ^:protected IdKeyPattern :throws [TransformerException] ^void [this]
    (.FunctionCall this))

  (method ^:protected RelativePathPattern :throws [TransformerException] ^void [this]
    (let [^:mutable trailingSlashConsumed (.StepPattern this false)]
      (while (.tokenIs this Token/SLASH)
        (.nextToken this)
        (set! trailingSlashConsumed (.StepPattern this (not trailingSlashConsumed))))))

  (method ^:protected StepPattern :throws [TransformerException] ^boolean [this
                                                                           ^boolean isLeadingSlashPermitted]
    (.AbbreviatedNodeTestStep this isLeadingSlashPermitted))

  (method ^:protected AbbreviatedNodeTestStep :throws [TransformerException] ^boolean [this
                                                                                       ^boolean isLeadingSlashPermitted]
    (let [opPos (.getOp m_ops OpMap/MAPINDEX_LENGTH)
          ^:mutable ^int axesType 0
          ^:mutable ^int matchTypePos -1]
      (cond
        (.tokenIs this Token/AT)
          (do (set! axesType OpCodes/MATCH_ATTRIBUTE) (.appendOp this 2 axesType) (.nextToken this))
        (.lookahead this Token/DCOLON 1)
          (do
            (cond
              (.tokenIs this Token/ATTR)
                (do (set! axesType OpCodes/MATCH_ATTRIBUTE) (.appendOp this 2 axesType))
              (.tokenIs this Token/CHILD)
                (do
                  (set! matchTypePos (.getOp m_ops OpMap/MAPINDEX_LENGTH))
                  (set! axesType OpCodes/MATCH_IMMEDIATE_ANCESTOR)
                  (.appendOp this 2 axesType))
              :else
                (do
                  (set! axesType -1)
                  (.error this
                          XPATHErrorResources/ER_AXES_NOT_ALLOWED
                          (new Object/1 [(.-m_token this)]))))
            (.nextToken this)
            (.nextToken this))
        (.tokenIs this Token/SLASH)
          (do
            (when-not isLeadingSlashPermitted
              (.error this XPATHErrorResources/ER_EXPECTED_STEP_PATTERN nil))
            (set! axesType OpCodes/MATCH_ANY_ANCESTOR)
            (.appendOp this 2 axesType)
            (.nextToken this))
        :else
          (do
            (set! matchTypePos (.getOp m_ops OpMap/MAPINDEX_LENGTH))
            (set! axesType OpCodes/MATCH_IMMEDIATE_ANCESTOR)
            (.appendOp this 2 axesType)))
      (.setOp m_ops
              OpMap/MAPINDEX_LENGTH
              (unchecked-add-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) 1))
      (.NodeTest this axesType)
      (.setOp m_ops
              (unchecked-add-int (unchecked-add-int opPos OpMap/MAPINDEX_LENGTH) 1)
              (unchecked-subtract-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) opPos))
      (while (.tokenIs this Token/LBRACK) (.Predicate this))
      (let [^:mutable ^boolean trailingSlashConsumed false]
        (if (and (and (> matchTypePos -1) (.tokenIs this Token/SLASH))
                 (.lookahead this Token/SLASH 1))
            (do
              (.setOp m_ops matchTypePos OpCodes/MATCH_ANY_ANCESTOR)
              (.nextToken this)
              (set! trailingSlashConsumed true))
            (set! trailingSlashConsumed false))
        (.setOp m_ops
                (unchecked-add-int opPos OpMap/MAPINDEX_LENGTH)
                (unchecked-subtract-int (.getOp m_ops OpMap/MAPINDEX_LENGTH) opPos))
        trailingSlashConsumed))))

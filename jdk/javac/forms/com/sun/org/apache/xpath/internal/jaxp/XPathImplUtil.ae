(defclass XPathImplUtil
  (field ^XPathFunctionResolver functionResolver)

  (field ^XPathVariableResolver variableResolver)

  (field ^JAXPPrefixResolver prefixResolver)

  (field ^boolean overrideDefaultParser)

  (field ^boolean featureSecureProcessing false)

  (field ^JdkXmlFeatures featureManager)

  (field ^XMLSecurityManager xmlSecMgr)

  (field ^XMLSecurityPropertyManager xmlSecPropMgr)

  (method eval :throws [TransformerException] ^XObject [this contextItem ^XPath xpath]
    (let [^:mutable ^XPathContext xpathSupport nil]
      (when (and (nil? contextItem) (instance? LocPathIterator (.getExpression xpath)))
        (throw (TransformerException.
                 (XSLMessages/createXPATHMessage
                   XPATHErrorResources/ER_CONTEXT_CAN_NOT_BE_NULL
                   (new Object/1 [])))))
      (if (some? functionResolver)
          (let [jep (JAXPExtensionsProvider. functionResolver)]
            (set! xpathSupport (XPathContext. jep)))
          (set! xpathSupport (XPathContext.)))
      (.setVarStack xpathSupport (JAXPVariableStack. variableResolver))
      (let [^:mutable ^XObject xobj nil
            contextNode (cast Node contextItem)]
        (if (nil? contextNode)
            (set! xobj (.execute xpath xpathSupport DTM/NULL prefixResolver))
            (set! xobj (.execute xpath xpathSupport contextNode prefixResolver)))
        xobj)))

  (method getDocument :throws [XPathExpressionException] ^Document [this ^InputSource source]
    (.requireNonNull this source "Source")
    (try
      (let [dbf (JdkXmlUtils/getDOMFactory overrideDefaultParser xmlSecMgr xmlSecPropMgr)]
        (when (and (some? xmlSecMgr) (.isSecureProcessingSet xmlSecMgr))
          (.setFeature dbf XMLConstants/FEATURE_SECURE_PROCESSING (.isSecureProcessing xmlSecMgr)))
        (.parse (.newDocumentBuilder dbf) source))
      (catch [ParserConfigurationException SAXException IOException] e
        (throw (XPathExpressionException. e)))))

  (method getResultAsType :throws [TransformerException] [this ^XObject resultObject
                                                          ^QName returnType]
    (cond
      (.equals returnType XPathConstants/STRING) (.str resultObject)
      (.equals returnType XPathConstants/NUMBER) (.num resultObject)
      (.equals returnType XPathConstants/BOOLEAN) (.bool resultObject)
      (.equals returnType XPathConstants/NODESET) (.nodelist resultObject)
      (.equals returnType XPathConstants/NODE) (let [ni (.nodeset resultObject)] (.nextNode ni))
      :else
        (let [fmsg (XSLMessages/createXPATHMessage
                     XPATHErrorResources/ER_UNSUPPORTED_RETURN_TYPE
                     (new Object/1 [(.toString returnType)]))]
          (throw (IllegalArgumentException. fmsg)))))

  (method getXPathResult :type-params [T] :throws [TransformerException] ^T [this
                                                                             ^XObject resultObject
                                                                             ^{:tag (Class T)} type]
    (let [resultType (.getType resultObject)]
      (switch resultType
        XObject/CLASS_BOOLEAN (return (.cast type (XPathResultImpl. resultObject Boolean)))
        XObject/CLASS_NUMBER (return (.cast type (XPathResultImpl. resultObject Double)))
        XObject/CLASS_STRING (return (.cast type (XPathResultImpl. resultObject String)))
        XObject/CLASS_NODESET (return (.cast type (XPathResultImpl. resultObject XPathNodes)))
        XObject/CLASS_RTREEFRAG (return (.cast type (XPathResultImpl. resultObject Node))))
      nil))

  (method isSupportedClassType :type-params [T] ^void [this ^{:tag (Class T)} type]
    (.requireNonNull this type "The class type")
    (when-not (or (or (or (or (or (or (or (identical? type Boolean) (identical? type Double))
                                      (identical? type Integer))
                                  (identical? type Long))
                              (identical? type String))
                          (identical? type XPathNodes))
                      (identical? type Node))
                  (identical? type XPathEvaluationResult))
      (let [fmsg (XSLMessages/createXPATHMessage
                   XPATHErrorResources/ER_UNSUPPORTED_RETURN_TYPE
                   (new Object/1 [(.toString type)]))]
        (throw (IllegalArgumentException. fmsg)))))

  (method isSupported ^void [this ^QName returnType]
    (.requireNonNull this returnType "returnType")
    (when-not (or (or (or (or (.equals returnType XPathConstants/STRING)
                              (.equals returnType XPathConstants/NUMBER))
                          (.equals returnType XPathConstants/BOOLEAN))
                      (.equals returnType XPathConstants/NODE))
                  (.equals returnType XPathConstants/NODESET))
      (let [fmsg (XSLMessages/createXPATHMessage
                   XPATHErrorResources/ER_UNSUPPORTED_RETURN_TYPE
                   (new Object/1 [(.toString returnType)]))]
        (throw (IllegalArgumentException. fmsg)))))

  (method requireNonNull :type-params [T] ^void [this ^T param ^String paramName]
    (when (nil? param)
      (let [fmsg (XSLMessages/createXPATHMessage
                   XPATHErrorResources/ER_ARG_CANNOT_BE_NULL
                   (new Object/1 [paramName]))]
        (throw (NullPointerException. fmsg))))))

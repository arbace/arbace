            OpCodes/FROM_CHILDREN
              (when (and (not foundDS) (not (and foundDorDS foundSelf))) (return false))
            OpCodes/FROM_DESCENDANTS_OR_SELF
              (do (set! foundDS true) (when (== 3 stepCount) (return false)) (set! foundDorDS true))
            OpCodes/FROM_DESCENDANTS
              (do (when (== 3 stepCount) (return false)) (set! foundDorDS true))
            OpCodes/FROM_SELF (do (when-not (== 1 stepCount) (return false)) (set! foundSelf true))

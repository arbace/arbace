                (OpCodes/OP_NUMBER OpCodes/OP_NUMBERLIT) (return true)
                OpCodes/OP_FUNCTION
                  (do
                    (set! isProx
                          (WalkerFactory/functionProximateOrContainsProximate
                            compiler
                            innerExprOpPos))
                    (when isProx (return true)))
                (OpCodes/OP_GT OpCodes/OP_GTE OpCodes/OP_LT OpCodes/OP_LTE OpCodes/OP_EQUALS)
                  (let [leftPos (OpMap/getFirstChildPos innerExprOpPos)
                        rightPos (.getNextOpPos compiler leftPos)]
                    (set! isProx (WalkerFactory/isProximateInnerExpr compiler leftPos))
                    (when isProx (return true))
                    (set! isProx (WalkerFactory/isProximateInnerExpr compiler rightPos))
                    (when isProx (return true)))

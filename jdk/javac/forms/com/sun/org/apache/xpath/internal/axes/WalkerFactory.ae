  (method ^:private ^:static isOptimizableForDescendantIterator :throws [TransformerException] ^boolean [^com.sun.org.apache.xpath.internal.compiler.Compiler compiler
                                                                                                         ^:mutable ^int stepOpCodePos
                                                                                                         ^int stepIndex]
    (let [^:mutable ^int stepType 0
          ^:mutable ^int stepCount 0
          ^:mutable foundDorDS false
          ^:mutable foundSelf false
          ^:mutable foundDS false
          ^:mutable nodeTestType OpCodes/NODETYPE_NODE]
      (while (not (== OpCodes/ENDOP (set! stepType (.getOp compiler stepOpCodePos))))
        (when (and (not (== nodeTestType OpCodes/NODETYPE_NODE))
                   (not (== nodeTestType OpCodes/NODETYPE_ROOT)))
          (return false))
        (set! stepCount (unchecked-inc-int stepCount))
        (when (> stepCount 3) (return false))
        (let [mightBeProximate (WalkerFactory/mightBeProximate compiler stepOpCodePos stepType)]
          (when mightBeProximate (return false))
          (switch stepType
            (OpCodes/FROM_FOLLOWING OpCodes/FROM_FOLLOWING_SIBLINGS
                                    OpCodes/FROM_PRECEDING
                                    OpCodes/FROM_PRECEDING_SIBLINGS
                                    OpCodes/FROM_PARENT
                                    OpCodes/OP_VARIABLE
                                    OpCodes/OP_EXTFUNCTION
                                    OpCodes/OP_FUNCTION
                                    OpCodes/OP_GROUP
                                    OpCodes/FROM_NAMESPACE
                                    OpCodes/FROM_ANCESTORS
                                    OpCodes/FROM_ANCESTORS_OR_SELF
                                    OpCodes/FROM_ATTRIBUTES
                                    OpCodes/MATCH_ATTRIBUTE
                                    OpCodes/MATCH_ANY_ANCESTOR
                                    OpCodes/MATCH_IMMEDIATE_ANCESTOR)
              (return false)

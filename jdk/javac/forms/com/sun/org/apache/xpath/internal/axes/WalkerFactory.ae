  (method ^:public ^:static mightBeProximate :throws [TransformerException] ^boolean [^com.sun.org.apache.xpath.internal.compiler.Compiler compiler
                                                                                      ^int opPos
                                                                                      ^int stepType]
    (let [mightBeProximate false

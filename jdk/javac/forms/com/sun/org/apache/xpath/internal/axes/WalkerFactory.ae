            (set! firstWalker walker)
            (do (.setNextWalker prevWalker walker) (.setPrevWalker walker prevWalker)))
        (set! prevWalker walker)
        (set! stepOpCodePos (.getNextStepPos compiler stepOpCodePos))
        (when (< stepOpCodePos 0) (break)))
      firstWalker))

  (method ^:public ^:static isSet ^boolean [^int analysis ^int bits]
    (not (== 0 (bit-and-int analysis bits))))

  (method ^:public ^:static diagnoseIterator ^void [^String name ^int analysis
                                                    ^com.sun.org.apache.xpath.internal.compiler.Compiler compiler]
    (.println System/out
              (java-str (.toString compiler)
                        ", "
                        name
                        ", "
                        (Integer/toBinaryString analysis)
                        ", "
                        (WalkerFactory/getAnalysisString analysis))))

  (method ^:public ^:static newDTMIterator :throws [TransformerException] ^DTMIterator [^com.sun.org.apache.xpath.internal.compiler.Compiler compiler
                                                                                        ^int opPos
                                                                                        ^boolean isTopLevel]

          stepType (.getOp compiler stepOpCodePos)]
      (when-not (== stepType OpCodes/ENDOP)
        (set! firstWalker (WalkerFactory/createDefaultWalker compiler stepType lpi 0))
        (.init firstWalker compiler stepOpCodePos stepType))
      firstWalker))


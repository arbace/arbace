            (when DEBUG_ITERATOR_CREATION
              (WalkerFactory/diagnoseIterator "WalkingIteratorSorted" analysis compiler))
            (set! iter (WalkingIteratorSorted. compiler opPos analysis true))))
      (when (instance? LocPathIterator iter)
        (.setIsTopLevel (cast LocPathIterator iter) isTopLevel))
      iter))

  (method ^:public ^:static getAxisFromStep :throws [TransformerException] ^int [^com.sun.org.apache.xpath.internal.compiler.Compiler compiler
                                                                                 ^int stepOpCodePos]
    (let [stepType (.getOp compiler stepOpCodePos)]
      (switch stepType
        OpCodes/FROM_FOLLOWING (return Axis/FOLLOWING)
        OpCodes/FROM_FOLLOWING_SIBLINGS (return Axis/FOLLOWINGSIBLING)
        OpCodes/FROM_PRECEDING (return Axis/PRECEDING)
        OpCodes/FROM_PRECEDING_SIBLINGS (return Axis/PRECEDINGSIBLING)
        OpCodes/FROM_PARENT (return Axis/PARENT)
        OpCodes/FROM_NAMESPACE (return Axis/NAMESPACE)
        OpCodes/FROM_ANCESTORS (return Axis/ANCESTOR)
        OpCodes/FROM_ANCESTORS_OR_SELF (return Axis/ANCESTORORSELF)
        OpCodes/FROM_ATTRIBUTES (return Axis/ATTRIBUTE)
        OpCodes/FROM_ROOT (return Axis/ROOT)
        OpCodes/FROM_CHILDREN (return Axis/CHILD)
        OpCodes/FROM_DESCENDANTS_OR_SELF (return Axis/DESCENDANTORSELF)
        OpCodes/FROM_DESCENDANTS (return Axis/DESCENDANT)
        OpCodes/FROM_SELF (return Axis/SELF)
        (OpCodes/OP_EXTFUNCTION OpCodes/OP_FUNCTION OpCodes/OP_GROUP OpCodes/OP_VARIABLE)
          (return Axis/FILTEREDLIST))
      (throw (RuntimeException.
               (XSLMessages/createXPATHMessage XPATHErrorResources/ER_NULL_ERROR_HANDLER
                                               (new Object/1 [(Integer/toString stepType)]))))))

  (method ^:public ^:static getAnalysisBitFromAxes ^int [^int axis]
    (switch axis
      Axis/ANCESTOR BIT_ANCESTOR
      Axis/ANCESTORORSELF BIT_ANCESTOR_OR_SELF
      Axis/ATTRIBUTE BIT_ATTRIBUTE
      Axis/CHILD BIT_CHILD
      Axis/DESCENDANT BIT_DESCENDANT
      Axis/DESCENDANTORSELF BIT_DESCENDANT_OR_SELF
      Axis/FOLLOWING BIT_FOLLOWING
      Axis/FOLLOWINGSIBLING BIT_FOLLOWING_SIBLING
      (Axis/NAMESPACE Axis/NAMESPACEDECLS) BIT_NAMESPACE
      Axis/PARENT BIT_PARENT
      Axis/PRECEDING BIT_PRECEDING
      Axis/PRECEDINGSIBLING BIT_PRECEDING_SIBLING
      Axis/SELF BIT_SELF
      Axis/ALLFROMNODE BIT_DESCENDANT_OR_SELF
      (Axis/DESCENDANTSFROMROOT Axis/ALL Axis/DESCENDANTSORSELFFROMROOT)
        BIT_ANY_DESCENDANT_FROM_ROOT
      Axis/ROOT BIT_ROOT
      Axis/FILTEREDLIST BIT_FILTER
      BIT_FILTER))


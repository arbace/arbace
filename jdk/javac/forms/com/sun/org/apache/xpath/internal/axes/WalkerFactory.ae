          analysis (WalkerFactory/analyze compiler firstStepPos 0)
          isOneStep (WalkerFactory/isOneStep analysis)
          ^:mutable ^DTMIterator iter nil]
      (cond
        (and (and (and isOneStep (WalkerFactory/walksSelfOnly analysis))
                  (WalkerFactory/isWild analysis))
             (not (WalkerFactory/hasPredicate analysis)))
          (do
            (when DEBUG_ITERATOR_CREATION
              (WalkerFactory/diagnoseIterator "SelfIteratorNoPredicate" analysis compiler))
            (set! iter (SelfIteratorNoPredicate. compiler opPos analysis)))
        (and (WalkerFactory/walksChildrenOnly analysis) isOneStep)
          (if (and (WalkerFactory/isWild analysis) (not (WalkerFactory/hasPredicate analysis)))
              (do
                (when DEBUG_ITERATOR_CREATION
                  (WalkerFactory/diagnoseIterator "ChildIterator" analysis compiler))
                (set! iter (ChildIterator. compiler opPos analysis)))
              (do
                (when DEBUG_ITERATOR_CREATION
                  (WalkerFactory/diagnoseIterator "ChildTestIterator" analysis compiler))
                (set! iter (ChildTestIterator. compiler opPos analysis))))
        (and isOneStep (WalkerFactory/walksAttributes analysis))
          (do
            (when DEBUG_ITERATOR_CREATION
              (WalkerFactory/diagnoseIterator "AttributeIterator" analysis compiler))
            (set! iter (AttributeIterator. compiler opPos analysis)))
        (and isOneStep (not (WalkerFactory/walksFilteredList analysis)))
          (if (and (not (WalkerFactory/walksNamespaces analysis))
                   (or (WalkerFactory/walksInDocOrder analysis)
                       (WalkerFactory/isSet analysis BIT_PARENT)))
              (do
                (when (or false DEBUG_ITERATOR_CREATION)
                  (WalkerFactory/diagnoseIterator "OneStepIteratorForward" analysis compiler))
                (set! iter (OneStepIteratorForward. compiler opPos analysis)))
              (do
                (when (or false DEBUG_ITERATOR_CREATION)
                  (WalkerFactory/diagnoseIterator "OneStepIterator" analysis compiler))
                (set! iter (OneStepIterator. compiler opPos analysis))))
        (WalkerFactory/isOptimizableForDescendantIterator compiler firstStepPos 0)
          (do
            (when DEBUG_ITERATOR_CREATION
              (WalkerFactory/diagnoseIterator "DescendantIterator" analysis compiler))
            (set! iter (DescendantIterator. compiler opPos analysis)))
        (WalkerFactory/isNaturalDocOrder compiler firstStepPos 0 analysis)
          (do
            (when (or false DEBUG_ITERATOR_CREATION)

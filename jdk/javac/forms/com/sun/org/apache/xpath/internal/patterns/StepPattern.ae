                              (when-not (.checkProximityPosition this xctxt i dtm currentNode pos)
                                (set! result false)
                                (break)))))
                      (when-not (.boolWithSideEffects pred) (set! result false) (break)))
                  (finally (.detach pred))))
              (finally (.popPredicatePos xctxt)))
            (recur (unchecked-inc-int i))))
        (finally (.popSubContextList xctxt)))
      result))

  (method ^:public toString ^String [this]
    (let [buf (StringBuffer.)]
      (loop [pat this]
        (when (some? pat)
          (when-not (identical? pat this) (.append buf "/"))
          (.append buf (Axis/getNames (.-m_axis pat)))
          (.append buf "::")
          (cond
            (== 0x000005000 (.-m_whatToShow pat)) (.append buf "doc()")
            (== DTMFilter/SHOW_BYFUNCTION (.-m_whatToShow pat)) (.append buf "function()")
            (== DTMFilter/SHOW_ALL (.-m_whatToShow pat)) (.append buf "node()")
            (== DTMFilter/SHOW_TEXT (.-m_whatToShow pat)) (.append buf "text()")
            (== DTMFilter/SHOW_PROCESSING_INSTRUCTION (.-m_whatToShow pat))
              (do
                (.append buf "processing-instruction(")
                (when (some? (.-m_name pat)) (.append buf (.-m_name pat)))
                (.append buf ")"))
            (== DTMFilter/SHOW_COMMENT (.-m_whatToShow pat)) (.append buf "comment()")
            (some? (.-m_name pat))
              (do
                (when (== DTMFilter/SHOW_ATTRIBUTE (.-m_whatToShow pat)) (.append buf "@"))
                (when (some? (.-m_namespace pat))
                  (.append buf "{")
                  (.append buf (.-m_namespace pat))
                  (.append buf "}"))
                (.append buf (.-m_name pat)))
            (== DTMFilter/SHOW_ATTRIBUTE (.-m_whatToShow pat)) (.append buf "@")
            (== (bit-or-int DTMFilter/SHOW_DOCUMENT DTMFilter/SHOW_DOCUMENT_FRAGMENT)
                (.-m_whatToShow pat))
              (.append buf "doc-root()")
            :else (.append (.append buf \?) (Integer/toHexString (.-m_whatToShow pat))))
          (if (some? (.-m_predicates pat))
              (do
                (loop [^int i 0]
                  (when (< i (alength (.-m_predicates pat)))
                    (.append buf "[")
                    (.append buf (aget (.-m_predicates pat) i))
                    (.append buf "]")
                    (recur (unchecked-inc-int i))))
                (recur (.-m_relativePathPattern pat)))
              (recur (.-m_relativePathPattern pat)))))
      (.toString buf)))


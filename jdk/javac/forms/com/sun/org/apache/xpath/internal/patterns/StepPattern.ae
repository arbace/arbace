            (.pushCurrentNode xctxt relative)
            (set! score (.execute this xctxt))
            (when-not (identical? score NodeTest/SCORE_NONE) (break))
            (finally (.popCurrentNode xctxt)))
          (recur (.next traverser context relative))))

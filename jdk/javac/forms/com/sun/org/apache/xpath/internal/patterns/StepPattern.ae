  (method ^:public callVisitors ^void [this ^ExpressionOwner owner ^XPathVisitor visitor]
    (when (.visitMatchPattern visitor owner this) (.callSubtreeVisitors this visitor)))

  (method ^:protected callSubtreeVisitors ^void [this ^XPathVisitor visitor]
    (when (some? m_predicates)
      (let [n (alength m_predicates)]
        (loop [^int i 0]
          (when (< i n)
            (let [^ExpressionOwner predOwner (PredOwner. i)]
              (if (.visitPredicate visitor predOwner (aget m_predicates i))
                  (do
                    (.callVisitors (aget m_predicates i) predOwner visitor)
                    (recur (unchecked-inc-int i)))
                  (recur (unchecked-inc-int i))))))))
    (when (some? m_relativePathPattern) (.callVisitors m_relativePathPattern this visitor)))


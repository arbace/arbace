  (method ^:public deepEquals ^boolean [this ^Expression expr]
    (if (not (.deepEquals super expr))
        false
        (let [sp (cast StepPattern expr)]
          (cond
            (some? m_predicates)
              (let [n (alength m_predicates)]
                (when (or (nil? (.-m_predicates sp)) (not (== (alength (.-m_predicates sp)) n)))
                  (return false))
                (loop [^int i 0]
                  (if (< i n)
                      (if (not (.deepEquals (aget m_predicates i) (aget (.-m_predicates sp) i)))
                          (return false)
                          (recur (unchecked-inc-int i)))
                      nil)))
            (some? (.-m_predicates sp)) (return false))
          (cond
            (some? m_relativePathPattern)
              (when-not (.deepEquals m_relativePathPattern (.-m_relativePathPattern sp))
                (return false))
            (some? (.-m_relativePathPattern sp)) (return false))
          true))))

                  (.setPositions il)
                  (set! currentMethodSize
                        (unchecked-add-int (.getPosition lastInst)
                                           (.getLength (.getInstruction lastInst))))
                  (recur (unchecked-dec-int i)))))))
        (when (and moreMethodsOutlined (> currentMethodSize TARGET_METHOD_SIZE)) (recur)))
      (when (> currentMethodSize MAX_METHOD_SIZE)
        (let [msg (.toString (ErrorMsg. ErrorMsg/OUTLINE_ERR_METHOD_TOO_BIG))]
          (throw (InternalError. msg))))
      (let [methodsArr (new Method/1 (unchecked-add-int (.size methodsOutlined) 1))]
        (.toArray methodsOutlined methodsArr)
        (aset methodsArr (.size methodsOutlined) (.getThisMethod this))
        methodsArr)))

  (method ^:private outline ^Method [this ^InstructionHandle first ^InstructionHandle last
                                     ^String outlinedMethodName ^ClassGenerator classGen]
    (when-not (== (alength (.getExceptionHandlers this)) 0)
      (let [msg (.toString (ErrorMsg. ErrorMsg/OUTLINE_ERR_TRY_CATCH))]
        (throw (InternalError. msg))))
    (let [outlineChunkStartOffset (.getPosition first)
          outlineChunkEndOffset (unchecked-add-int
                                  (.getPosition last)
                                  (.getLength (.getInstruction last)))
          cpg (.getConstantPool this)
          ^:final newIL (InstructionList.)
          ^:final xsltc (.getXSLTC (.getParser classGen))
          ^:final argTypeName (.getHelperClassName xsltc)
          ^:final argTypes (new com.sun.org.apache.bcel.internal.generic.Type/1
                                [(.toJCType (ObjectType. argTypeName))])
          ^:const argName "copyLocals"
          ^:final argNames (new String/1 [argName])
          ^:mutable methodAttributes (bit-or-int
                                       MethodGenerator/ACC_PRIVATE
                                       MethodGenerator/ACC_FINAL)
          ^:final isStaticMethod (not (== (bit-and-int
                                            (.getAccessFlags this)
                                            MethodGenerator/ACC_STATIC)
                                          0))]
      (when isStaticMethod
        (set! methodAttributes (bit-or-int methodAttributes MethodGenerator/ACC_STATIC)))
      (let [^:final outlinedMethodGen (MethodGenerator.
                                        methodAttributes
                                        com.sun.org.apache.bcel.internal.generic.Type/VOID
                                        argTypes
                                        argNames
                                        outlinedMethodName
                                        (.getClassName this)
                                        newIL
                                        cpg)
            ^ClassGenerator copyAreaCG (anon ClassGenerator [argTypeName
                                                             MethodGenerator/OBJECT_CLASS
                                                             (java-str argTypeName ".java")
                                                             (bit-or-int
                                                               (bit-or-int
                                                                 MethodGenerator/ACC_FINAL
                                                                 MethodGenerator/ACC_PUBLIC)
                                                               MethodGenerator/ACC_SUPER)
                                                             nil
                                                             (.getStylesheet classGen)]
                                         (method ^:public isExternal ^boolean [this] true))
            copyAreaCPG (.getConstantPool copyAreaCG)]
        (.addEmptyConstructor copyAreaCG MethodGenerator/ACC_PUBLIC)
        (let [^:mutable ^int copyAreaFieldCount 0
              limit (.getNext last)
              oldMethCopyInIL (InstructionList.)
              oldMethCopyOutIL (InstructionList.)
              newMethCopyInIL (InstructionList.)
              newMethCopyOutIL (InstructionList.)
              outlinedMethodCallSetup (.append oldMethCopyInIL (NEW. (.addClass cpg argTypeName)))]
          (.append oldMethCopyInIL InstructionConst/DUP)
          (.append oldMethCopyInIL InstructionConst/DUP)
          (.append oldMethCopyInIL (INVOKESPECIAL. (.addMethodref cpg argTypeName "<init>" "()V")))
          (let [^:mutable ^InstructionHandle outlinedMethodRef nil]
            (if isStaticMethod
                (set! outlinedMethodRef
                      (.append oldMethCopyOutIL
                               (INVOKESTATIC.
                                 (.addMethodref cpg
                                                (.getClassName classGen)
                                                outlinedMethodName
                                                (.getSignature outlinedMethodGen)))))
                (do
                  (.append oldMethCopyOutIL InstructionConst/THIS)
                  (.append oldMethCopyOutIL InstructionConst/SWAP)
                  (set! outlinedMethodRef
                        (.append oldMethCopyOutIL
                                 (INVOKEVIRTUAL.
                                   (.addMethodref
                                     cpg
                                     (.getClassName classGen)
                                     outlinedMethodName
                                     (.getSignature outlinedMethodGen)))))))
            (let [^:mutable chunkStartTargetMappingsPending false
                  ^:mutable ^InstructionHandle pendingTargetMappingHandle nil
                  ^:mutable ^InstructionHandle lastCopyHandle nil
                  ^{:tag (HashMap InstructionHandle InstructionHandle)} targetMap (HashMap.)
                  ^{:tag (HashMap LocalVariableGen LocalVariableGen)} localVarMap (HashMap.)
                  ^{:tag (HashMap LocalVariableGen InstructionHandle)} revisedLocalVarStart
                    (LinkedHashMap.)
                  ^{:tag (HashMap LocalVariableGen InstructionHandle)} revisedLocalVarEnd
                    (LinkedHashMap.)]
              (loop [ih first]
                (when-not (identical? ih limit)
                  (let [inst (.getInstruction ih)]
                    (if (instance? MarkerInstruction inst)
                        (if (.hasTargeters ih)
                            (cond
                              (instance? OutlineableChunkEnd inst)
                                (do (.put targetMap ih lastCopyHandle) (recur (.getNext ih)))
                              (not chunkStartTargetMappingsPending)
                                (do
                                  (set! chunkStartTargetMappingsPending true)
                                  (set! pendingTargetMappingHandle ih)
                                  (recur (.getNext ih)))
                              :else (recur (.getNext ih)))
                            (recur (.getNext ih)))
                        (let [c (.copy inst)]
                          (if (instance? BranchInstruction c)
                              (set! lastCopyHandle (.append newIL (cast BranchInstruction c)))
                              (set! lastCopyHandle (.append newIL c)))
                          (when (or (instance? LocalVariableInstruction c) (instance? RET c))
                            (let [lvi (cast IndexedInstruction c)
                                  oldLocalVarIndex (.getIndex lvi)
                                  oldLVG (.lookupRegisteredLocalVariable
                                           (.getLocalVariableRegistry this)
                                           oldLocalVarIndex
                                           (.getPosition ih))
                                  ^:mutable newLVG (cast LocalVariableGen (.get localVarMap oldLVG))]
                              (when (nil? (.get localVarMap oldLVG))
                                (let [copyInLocalValue (.offsetInLocalVariableGenRange
                                                         this
                                                         oldLVG
                                                         (if (not (== outlineChunkStartOffset 0))
                                                             (unchecked-subtract-int
                                                               outlineChunkStartOffset
                                                               1)
                                                             0))
                                      copyOutLocalValue (.offsetInLocalVariableGenRange
                                                          this
                                                          oldLVG
                                                          (unchecked-add-int
                                                            outlineChunkEndOffset
                                                            1))]
                                  (when (or copyInLocalValue copyOutLocalValue)
                                    (let [varName (.getName oldLVG)
                                          varType (.getType oldLVG)]
                                      (set! newLVG
                                            (.addLocalVariable
                                              outlinedMethodGen
                                              varName
                                              varType
                                              nil
                                              nil))
                                      (let [newLocalVarIndex (.getIndex newLVG)
                                            varSignature (.getSignature varType)]
                                        (.put localVarMap oldLVG newLVG)
                                        (set! copyAreaFieldCount
                                              (unchecked-inc-int copyAreaFieldCount))
                                        (let [copyAreaFieldName (java-str
                                                                  "field"
                                                                  copyAreaFieldCount)]
                                          (.addField
                                            copyAreaCG
                                            (Field.
                                              MethodGenerator/ACC_PUBLIC
                                              (.addUtf8 copyAreaCPG copyAreaFieldName)
                                              (.addUtf8 copyAreaCPG varSignature)
                                              nil
                                              (.getConstantPool copyAreaCPG)))
                                          (let [fieldRef (.addFieldref
                                                           cpg
                                                           argTypeName
                                                           copyAreaFieldName
                                                           varSignature)]
                                            (when copyInLocalValue
                                              (.append oldMethCopyInIL InstructionConst/DUP)
                                              (let [copyInLoad (.append
                                                                 oldMethCopyInIL
                                                                 (MethodGenerator/loadLocal
                                                                   oldLocalVarIndex
                                                                   varType))]
                                                (.append oldMethCopyInIL (PUTFIELD. fieldRef))
                                                (when-not copyOutLocalValue
                                                  (.put revisedLocalVarEnd oldLVG copyInLoad))
                                                (.append newMethCopyInIL InstructionConst/ALOAD_1)
                                                (.append newMethCopyInIL (GETFIELD. fieldRef))
                                                (.append
                                                  newMethCopyInIL
                                                  (MethodGenerator/storeLocal
                                                    newLocalVarIndex
                                                    varType))))
                                            (when copyOutLocalValue
                                              (.append newMethCopyOutIL InstructionConst/ALOAD_1)
                                              (.append
                                                newMethCopyOutIL
                                                (MethodGenerator/loadLocal newLocalVarIndex varType))
                                              (.append newMethCopyOutIL (PUTFIELD. fieldRef))
                                              (.append oldMethCopyOutIL InstructionConst/DUP)
                                              (.append oldMethCopyOutIL (GETFIELD. fieldRef))
                                              (let [copyOutStore (.append
                                                                   oldMethCopyOutIL
                                                                   (MethodGenerator/storeLocal
                                                                     oldLocalVarIndex
                                                                     varType))]
                                                (when-not copyInLocalValue
                                                  (.put revisedLocalVarStart oldLVG copyOutStore)))))))))))))
                          (when (.hasTargeters ih) (.put targetMap ih lastCopyHandle))
                          (if chunkStartTargetMappingsPending
                              (do
                                (loop []
                                  (.put targetMap pendingTargetMappingHandle lastCopyHandle)
                                  (set! pendingTargetMappingHandle
                                        (.getNext pendingTargetMappingHandle))
                                  (when-not (identical? pendingTargetMappingHandle ih) (recur)))
                                (set! chunkStartTargetMappingsPending false)
                                (recur (.getNext ih)))
                              (recur (.getNext ih))))))))
              (let [^:mutable ih first
                    ^:mutable ch (.getStart newIL)]
                (while (some? ch)
                  (let [i (.getInstruction ih)
                        c (.getInstruction ch)]
                    (cond
                      (instance? BranchInstruction i)
                        (let [bc (cast BranchInstruction c)
                              bi (cast BranchInstruction i)
                              itarget (.getTarget bi)
                              newTarget (cast InstructionHandle (.get targetMap itarget))]
                          (.setTarget bc newTarget)
                          (when (instance? Select bi)
                            (let [itargets (.getTargets (cast Select bi))
                                  ctargets (.getTargets (cast Select bc))]
                              (loop [^int j 0]
                                (when (< j (alength itargets))
                                  (aset ctargets
                                        j
                                        (cast InstructionHandle (.get targetMap (aget itargets j))))
                                  (recur (unchecked-inc-int j)))))))
                      (or (instance? LocalVariableInstruction i) (instance? RET i))
                        (let [lvi (cast IndexedInstruction c)
                              oldLocalVarIndex (.getIndex lvi)
                              oldLVG (.lookupRegisteredLocalVariable
                                       (.getLocalVariableRegistry this)
                                       oldLocalVarIndex
                                       (.getPosition ih))
                              ^:mutable newLVG (cast LocalVariableGen (.get localVarMap oldLVG))
                              ^:mutable ^int newLocalVarIndex 0]
                          (if (nil? newLVG)
                              (let [varName (.getName oldLVG)
                                    varType (.getType oldLVG)]
                                (set! newLVG
                                      (.addLocalVariable outlinedMethodGen varName varType nil nil))
                                (set! newLocalVarIndex (.getIndex newLVG))
                                (.put localVarMap oldLVG newLVG)
                                (.put revisedLocalVarStart oldLVG outlinedMethodRef)
                                (.put revisedLocalVarEnd oldLVG outlinedMethodRef))
                              (set! newLocalVarIndex (.getIndex newLVG)))
                          (.setIndex lvi newLocalVarIndex)))
                    (when (.hasTargeters ih)
                      (let [targeters (.getTargeters ih)]
                        (loop [^int idx 0]
                          (when (< idx (alength targeters))
                            (let [targeter (aget targeters idx)]
                              (if (and (instance? LocalVariableGen targeter)
                                       (identical? (.getEnd (cast LocalVariableGen targeter)) ih))
                                  (let [newLVG (cast LocalVariableGen (.get localVarMap targeter))]
                                    (if (some? newLVG)
                                        (do
                                          (.removeLocalVariable outlinedMethodGen newLVG)
                                          (recur (unchecked-inc-int idx)))
                                        (recur (unchecked-inc-int idx))))
                                  (recur (unchecked-inc-int idx))))))))
                    (when-not (instance? MarkerInstruction i) (set! ch (.getNext ch)))
                    (set! ih (.getNext ih))))
                (.append oldMethCopyOutIL InstructionConst/POP)
                (for-each [^{:tag (Map$Entry LocalVariableGen InstructionHandle)} lvgRangeStartPair
                             (.entrySet revisedLocalVarStart)]
                  (let [lvg (cast LocalVariableGen (.getKey lvgRangeStartPair))
                        startInst (cast InstructionHandle (.getValue lvgRangeStartPair))]
                    (.setStart lvg startInst)))
                (for-each [^{:tag (Map$Entry LocalVariableGen InstructionHandle)} lvgRangeEndPair
                             (.entrySet revisedLocalVarEnd)]
                  (let [lvg (cast LocalVariableGen (.getKey lvgRangeEndPair))
                        endInst (cast InstructionHandle (.getValue lvgRangeEndPair))]
                    (.setEnd lvg endInst)))
                (.dumpClass xsltc (.getJavaClass copyAreaCG))
                (let [oldMethodIL (.getInstructionList this)]
                  (.insert oldMethodIL first oldMethCopyInIL)
                  (.insert oldMethodIL first oldMethCopyOutIL)
                  (.insert newIL newMethCopyInIL)
                  (.append newIL newMethCopyOutIL)
                  (.append newIL InstructionConst/RETURN)
                  (try
                    (.delete oldMethodIL first last)
                    (catch TargetLostException e
                      (let [targets (.getTargets e)]
                        (loop [^int i 0]
                          (when (< i (alength targets))
                            (let [lostTarget (aget targets i)
                                  targeters (.getTargeters lostTarget)]
                              (loop [^int j 0]
                                (if (< j (alength targeters))
                                    (if (instance? LocalVariableGen (aget targeters j))
                                        (let [lvgTargeter (cast LocalVariableGen (aget targeters j))]
                                          (when (identical? (.getStart lvgTargeter) lostTarget)
                                            (.setStart lvgTargeter outlinedMethodRef))
                                          (if (identical? (.getEnd lvgTargeter) lostTarget)
                                              (do
                                                (.setEnd lvgTargeter outlinedMethodRef)
                                                (recur (unchecked-inc-int j)))
                                              (recur (unchecked-inc-int j))))
                                        (do
                                          (.updateTarget
                                            (aget targeters j)
                                            lostTarget
                                            outlinedMethodCallSetup)
                                          (recur (unchecked-inc-int j))))
                                    nil))
                              (recur (unchecked-inc-int i))))))))
                  (let [exceptions (.getExceptions this)]
                    (loop [^int i 0]
                      (when (< i (alength exceptions))
                        (.addException outlinedMethodGen (aget exceptions i))
                        (recur (unchecked-inc-int i))))
                    (.getThisMethod outlinedMethodGen))))))))))

  (method ^:private ^:static loadLocal ^Instruction [^int index
                                                     ^com.sun.org.apache.bcel.internal.generic.Type type]
    (cond
      (identical? type com.sun.org.apache.bcel.internal.generic.Type/BOOLEAN) (ILOAD. index)
      (identical? type com.sun.org.apache.bcel.internal.generic.Type/INT) (ILOAD. index)
      (identical? type com.sun.org.apache.bcel.internal.generic.Type/SHORT) (ILOAD. index)
      (identical? type com.sun.org.apache.bcel.internal.generic.Type/LONG) (LLOAD. index)
      (identical? type com.sun.org.apache.bcel.internal.generic.Type/BYTE) (ILOAD. index)
      (identical? type com.sun.org.apache.bcel.internal.generic.Type/CHAR) (ILOAD. index)
      (identical? type com.sun.org.apache.bcel.internal.generic.Type/FLOAT) (FLOAD. index)
      (identical? type com.sun.org.apache.bcel.internal.generic.Type/DOUBLE) (DLOAD. index)
      :else (ALOAD. index)))

  (method ^:private ^:static storeLocal ^Instruction [^int index
                                                      ^com.sun.org.apache.bcel.internal.generic.Type type]
    (cond
      (identical? type com.sun.org.apache.bcel.internal.generic.Type/BOOLEAN) (ISTORE. index)
      (identical? type com.sun.org.apache.bcel.internal.generic.Type/INT) (ISTORE. index)
      (identical? type com.sun.org.apache.bcel.internal.generic.Type/SHORT) (ISTORE. index)
      (identical? type com.sun.org.apache.bcel.internal.generic.Type/LONG) (LSTORE. index)
      (identical? type com.sun.org.apache.bcel.internal.generic.Type/BYTE) (ISTORE. index)
      (identical? type com.sun.org.apache.bcel.internal.generic.Type/CHAR) (ISTORE. index)
      (identical? type com.sun.org.apache.bcel.internal.generic.Type/FLOAT) (FSTORE. index)
      (identical? type com.sun.org.apache.bcel.internal.generic.Type/DOUBLE) (DSTORE. index)
      :else (ASTORE. index)))

  (field ^:private ^int m_totalChunks 0)

  (field ^:private ^int m_openChunks 0)

  (method ^:public markChunkStart ^void [this]
    (.append (.getInstructionList this) OutlineableChunkStart/OUTLINEABLECHUNKSTART)
    (set! m_totalChunks (unchecked-inc-int m_totalChunks))
    (set! m_openChunks (unchecked-inc-int m_openChunks)))

  (method ^:public markChunkEnd ^void [this]
    (.append (.getInstructionList this) OutlineableChunkEnd/OUTLINEABLECHUNKEND)
    (set! m_openChunks (unchecked-dec-int m_openChunks))
    (when (< m_openChunks 0)
      (let [msg (.toString (ErrorMsg. ErrorMsg/OUTLINE_ERR_UNBALANCED_MARKERS))]
        (throw (InternalError. msg)))))

  (method getGeneratedMethods ^Method/1 [this ^ClassGenerator classGen]
    (let [^:mutable ^Method/1 generatedMethods nil
          il (.getInstructionList this)
          ^:mutable last (.getEnd il)]
      (.setPositions il)
      (let [^:mutable instructionListSize (unchecked-add-int
                                            (.getPosition last)
                                            (.getLength (.getInstruction last)))]
        (when (> instructionListSize MAX_BRANCH_TARGET_OFFSET)
          (let [ilChanged (.widenConditionalBranchTargetOffsets this)]
            (when ilChanged
              (.setPositions il)
              (set! last (.getEnd il))
              (set! instructionListSize
                    (unchecked-add-int (.getPosition last) (.getLength (.getInstruction last)))))))
        (if (> instructionListSize MAX_METHOD_SIZE)
            (set! generatedMethods (.outlineChunks this classGen instructionListSize))
            (set! generatedMethods (new Method/1 [(.getThisMethod this)])))
        generatedMethods)))

  (method ^:protected getThisMethod ^Method [this]
    (.stripAttributes this true)
    (.setMaxLocals this)
    (.setMaxStack this)
    (.removeNOPs this)
    (.getMethod this))

  (method widenConditionalBranchTargetOffsets ^boolean [this]
    (let [^:mutable ilChanged false
          ^:mutable ^int maxOffsetChange 0
          il (.getInstructionList this)]
      (loop [ih (.getStart il)]
        (when (some? ih)
          (let [inst (.getInstruction ih)]
            (switch (.getOpcode inst)
              (Const/GOTO Const/JSR)
                (do
                  (set! maxOffsetChange (unchecked-add-int maxOffsetChange 2))
                  (recur (.getNext ih)))
              (Const/TABLESWITCH Const/LOOKUPSWITCH)
                (do
                  (set! maxOffsetChange (unchecked-add-int maxOffsetChange 3))
                  (recur (.getNext ih)))
              (Const/IF_ACMPEQ Const/IF_ACMPNE
                               Const/IF_ICMPEQ
                               Const/IF_ICMPGE
                               Const/IF_ICMPGT
                               Const/IF_ICMPLE
                               Const/IF_ICMPLT
                               Const/IF_ICMPNE
                               Const/IFEQ
                               Const/IFGE
                               Const/IFGT
                               Const/IFLE
                               Const/IFLT
                               Const/IFNE
                               Const/IFNONNULL
                               Const/IFNULL)
                (do
                  (set! maxOffsetChange (unchecked-add-int maxOffsetChange 5))
                  (recur (.getNext ih)))
              (recur (.getNext ih))))))
      (let [^:mutable ih (.getStart il)]
        (while (some? ih)
          (let [inst (.getInstruction ih)]
            (when (instance? IfInstruction inst)
              (let [oldIfInst (cast IfInstruction inst)
                    oldIfHandle (cast BranchHandle ih)
                    target (.getTarget oldIfInst)
                    relativeTargetOffset (unchecked-subtract-int
                                           (.getPosition target)
                                           (.getPosition oldIfHandle))]
                (when (or (< (unchecked-subtract-int relativeTargetOffset maxOffsetChange)
                             MIN_BRANCH_TARGET_OFFSET)
                          (> (unchecked-add-int relativeTargetOffset maxOffsetChange)
                             MAX_BRANCH_TARGET_OFFSET))
                  (let [^:mutable nextHandle (.getNext oldIfHandle)
                        invertedIfInst (.negate oldIfInst)
                        invertedIfHandle (.append il oldIfHandle invertedIfInst)
                        gotoHandle (.append il invertedIfHandle (GOTO. target))]
                    (when (nil? nextHandle)
                      (set! nextHandle (.append il gotoHandle InstructionConst/NOP)))
                    (.updateTarget invertedIfHandle target nextHandle)
                    (when (.hasTargeters oldIfHandle)
                      (let [targeters (.getTargeters oldIfHandle)]
                        (loop [^int i 0]
                          (when (< i (alength targeters))
                            (let [targeter (aget targeters i)]
                              (if (instance? LocalVariableGen targeter)
                                  (let [lvg (cast LocalVariableGen targeter)]
                                    (cond
                                      (identical? (.getStart lvg) oldIfHandle)
                                        (do
                                          (.setStart lvg invertedIfHandle)
                                          (recur (unchecked-inc-int i)))
                                      (identical? (.getEnd lvg) oldIfHandle)
                                        (do (.setEnd lvg gotoHandle) (recur (unchecked-inc-int i)))
                                      :else (recur (unchecked-inc-int i))))
                                  (do
                                    (.updateTarget targeter oldIfHandle invertedIfHandle)
                                    (recur (unchecked-inc-int i)))))))))
                    (try
                      (.delete il oldIfHandle)
                      (catch TargetLostException tle
                        (let [msg (.toString (ErrorMsg.
                                               ErrorMsg/OUTLINE_ERR_DELETED_TARGET
                                               (.getMessage tle)))]
                          (throw (InternalError. msg)))))
                    (set! ih gotoHandle)
                    (set! ilChanged true))))))
          (set! ih (.getNext ih))))
      ilChanged)))

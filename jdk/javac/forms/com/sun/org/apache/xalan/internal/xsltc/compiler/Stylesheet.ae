                                 (Util/getJCRefType Stylesheet/NODE_ITERATOR_SIG)
                                 (Util/getJCRefType Stylesheet/TRANSLET_OUTPUT_SIG)])
          ^:final argNames (new String/1
                                [Stylesheet/DOCUMENT_PNAME
                                 Stylesheet/ITERATOR_PNAME
                                 Stylesheet/TRANSLET_OUTPUT_PNAME])
          ^:final il (InstructionList.)
          ^:final toplevel (MethodGenerator. Stylesheet/ACC_PUBLIC
                                             com.sun.org.apache.bcel.internal.generic.Type/VOID
                                             argTypes
                                             argNames
                                             "topLevel"
                                             _className
                                             il
                                             (.getConstantPool classGen))]
      (.addException toplevel "com.sun.org.apache.xalan.internal.xsltc.TransletException")
      (let [^:final current (.addLocalVariable toplevel
                                               "current"
                                               com.sun.org.apache.bcel.internal.generic.Type/INT
                                               nil
                                               nil)
            ^:final setFilter (.addInterfaceMethodref
                                cpg
                                Stylesheet/DOM_INTF
                                "setFilter"
                                "(Lcom/sun/org/apache/xalan/internal/xsltc/StripFilter;)V")
            ^:final gitr (.addInterfaceMethodref
                           cpg
                           Stylesheet/DOM_INTF
                           "getIterator"
                           (java-str "()" Stylesheet/NODE_ITERATOR_SIG))]
        (.append il (.loadDOM toplevel))
        (.append il (INVOKEINTERFACE. gitr 1))
        (.append il (.nextNode toplevel))
        (.setStart current (.append il (ISTORE. (.getIndex current))))
        (let [^:mutable ^{:tag (List SyntaxTreeNode)} varDepElements (ArrayList. _globals)
              ^:mutable ^{:tag (Iterator SyntaxTreeNode)} elements (.elements this)]
          (while (.hasNext elements)
            (let [element (cast SyntaxTreeNode (.next elements))]
              (when (instance? Key element) (.add varDepElements element))))
          (set! varDepElements (.resolveDependencies this varDepElements))
          (let [^:final count (.size varDepElements)]
            (loop [^int i 0]
              (when (< i count)
                (let [^:final tle (cast TopLevelElement (.get varDepElements i))]
                  (.translate tle classGen toplevel)
                  (if (instance? Key tle)
                      (let [^:final key (cast Key tle)]
                        (.put _keys (.getName key) key)
                        (recur (unchecked-inc-int i)))
                      (recur (unchecked-inc-int i))))))
            (let [^{:tag (List Whitespace$WhitespaceRule)} whitespaceRules (ArrayList.)]
              (set! elements (.elements this))
              (while (.hasNext elements)
                (let [element (cast SyntaxTreeNode (.next elements))]
                  (cond
                    (instance? DecimalFormatting element)
                      (.translate (cast DecimalFormatting element) classGen toplevel)
                    (instance? Whitespace element)
                      (.addAll whitespaceRules (.getRules (cast Whitespace element))))))
              (when (> (.size whitespaceRules) 0)
                (Whitespace/translateRules whitespaceRules classGen))
              (when (some? (.containsMethod classGen
                                            Stylesheet/STRIP_SPACE
                                            Stylesheet/STRIP_SPACE_PARAMS))
                (.append il (.loadDOM toplevel))
                (.append il (.loadTranslet classGen))
                (.append il (INVOKEINTERFACE. setFilter 2)))
              (.append il Stylesheet/RETURN)
              (.addMethod classGen toplevel)
              (java-str (java-str (java-str (java-str "(" Stylesheet/DOM_INTF_SIG)
                                            Stylesheet/NODE_ITERATOR_SIG)
                                  Stylesheet/TRANSLET_OUTPUT_SIG)
                        ")V")))))))

  (method ^:private resolveDependencies ^{:tag (List SyntaxTreeNode)} [this
                                                                       ^{:tag (List SyntaxTreeNode)} input]
    (let [^{:tag (List SyntaxTreeNode)} result (ArrayList.)]
      (while (> (.size input) 0)
        (let [^:mutable changed false]
          (let [^:mutable ^int i 0]
            (while (< i (.size input))
              (let [^:final vde (cast TopLevelElement (.get input i))
                    ^:final ^{:tag (List SyntaxTreeNode)} dep (.getDependencies vde)]
                (if (or (nil? dep) (.containsAll result dep))
                    (do (.add result vde) (.remove input i) (set! changed true))
                    (set! i (unchecked-inc-int i))))))
          (when-not changed
            (let [err (ErrorMsg. ErrorMsg/CIRCULAR_VARIABLE_ERR (.toString input) this)]
              (.reportError (.getParser this) Constants/ERROR err)
              (return result)))))
      result))

  (method ^:private compileBuildKeys ^String [this ^ClassGenerator classGen]
    (let [^:final cpg (.getConstantPool classGen)
          ^:final argTypes (new com.sun.org.apache.bcel.internal.generic.Type/1
                                [(Util/getJCRefType Stylesheet/DOM_INTF_SIG)
                                 (Util/getJCRefType Stylesheet/NODE_ITERATOR_SIG)
                                 (Util/getJCRefType Stylesheet/TRANSLET_OUTPUT_SIG)
                                 com.sun.org.apache.bcel.internal.generic.Type/INT])
          ^:final argNames (new String/1
                                [Stylesheet/DOCUMENT_PNAME
                                 Stylesheet/ITERATOR_PNAME
                                 Stylesheet/TRANSLET_OUTPUT_PNAME
                                 "current"])
          ^:final il (InstructionList.)
          ^:final buildKeys (MethodGenerator. Stylesheet/ACC_PUBLIC
                                              com.sun.org.apache.bcel.internal.generic.Type/VOID
                                              argTypes
                                              argNames
                                              "buildKeys"
                                              _className
                                              il
                                              (.getConstantPool classGen))]
      (.addException buildKeys "com.sun.org.apache.xalan.internal.xsltc.TransletException")
      (let [^:final ^{:tag (Iterator SyntaxTreeNode)} elements (.elements this)]
        (while (.hasNext elements)
          (let [^:final element (cast SyntaxTreeNode (.next elements))]
            (when (instance? Key element)
              (let [^:final key (cast Key element)]
                (.translate key classGen buildKeys)
                (.put _keys (.getName key) key)))))
        (.append il Stylesheet/RETURN)
        (.stripAttributes buildKeys true)
        (.setMaxLocals buildKeys)
        (.setMaxStack buildKeys)
        (.removeNOPs buildKeys)
        (.addMethod classGen (.getMethod buildKeys))
        (java-str (java-str (java-str (java-str "(" Stylesheet/DOM_INTF_SIG)
                                      Stylesheet/NODE_ITERATOR_SIG)
                            Stylesheet/TRANSLET_OUTPUT_SIG)
                  "I)V"))))

  (method ^:private compileTransform ^void [this ^ClassGenerator classGen]
    (let [^:final cpg (.getConstantPool classGen)
          ^:final argTypes (new com.sun.org.apache.bcel.internal.generic.Type/1 3)]
      (aset argTypes 0 (Util/getJCRefType Stylesheet/DOM_INTF_SIG))
      (aset argTypes 1 (Util/getJCRefType Stylesheet/NODE_ITERATOR_SIG))
      (aset argTypes 2 (Util/getJCRefType Stylesheet/TRANSLET_OUTPUT_SIG))
      (let [^:final argNames (new String/1 3)]
        (aset argNames 0 Stylesheet/DOCUMENT_PNAME)
        (aset argNames 1 Stylesheet/ITERATOR_PNAME)
        (aset argNames 2 Stylesheet/TRANSLET_OUTPUT_PNAME)
        (let [^:final il (InstructionList.)
              ^:final transf (MethodGenerator. Stylesheet/ACC_PUBLIC
                                               com.sun.org.apache.bcel.internal.generic.Type/VOID
                                               argTypes
                                               argNames
                                               "transform"
                                               _className
                                               il
                                               (.getConstantPool classGen))]
          (.addException transf "com.sun.org.apache.xalan.internal.xsltc.TransletException")
          (let [^:final check (.addMethodref cpg
                                             Stylesheet/BASIS_LIBRARY_CLASS
                                             "resetPrefixIndex"
                                             "()V")]
            (.append il (INVOKESTATIC. check))
            (let [^:final current (.addLocalVariable
                                    transf
                                    "current"
                                    com.sun.org.apache.bcel.internal.generic.Type/INT
                                    nil
                                    nil)
                  ^:final applyTemplatesSig (.getApplyTemplatesSig classGen)
                  ^:final applyTemplates (.addMethodref
                                           cpg
                                           (.getClassName this)
                                           "applyTemplates"
                                           applyTemplatesSig)
                  ^:final domField (.addFieldref
                                     cpg
                                     (.getClassName this)
                                     Stylesheet/DOM_FIELD
                                     Stylesheet/DOM_INTF_SIG)]
              (.append il (.loadTranslet classGen))
              (when (.isMultiDocument this)
                (.append il (NEW. (.addClass cpg Stylesheet/MULTI_DOM_CLASS)))
                (.append il Stylesheet/DUP))
              (.append il (.loadTranslet classGen))
              (.append il (.loadDOM transf))
              (.append il
                       (INVOKEVIRTUAL.
                         (.addMethodref cpg
                                        Stylesheet/TRANSLET_CLASS
                                        "makeDOMAdapter"
                                        (java-str
                                          (java-str (java-str "(" Stylesheet/DOM_INTF_SIG) ")")
                                          Stylesheet/DOM_ADAPTER_SIG))))
              (when (.isMultiDocument this)
                (let [^:final init (.addMethodref
                                     cpg
                                     Stylesheet/MULTI_DOM_CLASS
                                     "<init>"
                                     (java-str (java-str "(" Stylesheet/DOM_INTF_SIG) ")V"))]
                  (.append il (INVOKESPECIAL. init))))
              (.append il (PUTFIELD. domField))
              (let [^:final gitr (.addInterfaceMethodref
                                   cpg
                                   Stylesheet/DOM_INTF
                                   "getIterator"
                                   (java-str "()" Stylesheet/NODE_ITERATOR_SIG))]
                (.append il (.loadDOM transf))
                (.append il (INVOKEINTERFACE. gitr 1))
                (.append il (.nextNode transf))
                (.setStart current (.append il (ISTORE. (.getIndex current))))
                (.append il (.loadTranslet classGen))
                (.append il (.loadHandler transf))
                (let [^:final index (.addMethodref
                                      cpg
                                      Stylesheet/TRANSLET_CLASS
                                      "transferOutputSettings"
                                      (java-str (java-str "(" Stylesheet/OUTPUT_HANDLER_SIG) ")V"))]
                  (.append il (INVOKEVIRTUAL. index))
                  (let [^:final keySig (.compileBuildKeys this classGen)
                        ^:final keyIdx (.addMethodref cpg (.getClassName this) "buildKeys" keySig)
                        ^:final ^{:tag (Iterator SyntaxTreeNode)} toplevel (.elements this)]
                    (when (or (> (.size _globals) 0) (.hasNext toplevel))
                      (let [^:final topLevelSig (.compileTopLevel this classGen)
                            ^:final topLevelIdx (.addMethodref
                                                  cpg
                                                  (.getClassName this)
                                                  "topLevel"
                                                  topLevelSig)]
                        (.append il (.loadTranslet classGen))
                        (.append il (.loadTranslet classGen))
                        (.append il (GETFIELD. domField))
                        (.append il (.loadIterator transf))
                        (.append il (.loadHandler transf))
                        (.append il (INVOKEVIRTUAL. topLevelIdx))))
                    (.append il (.loadHandler transf))
                    (.append il (.startDocument transf))
                    (.append il (.loadTranslet classGen))
                    (.append il (.loadTranslet classGen))
                    (.append il (GETFIELD. domField))
                    (.append il (.loadIterator transf))
                    (.append il (.loadHandler transf))
                    (.append il (INVOKEVIRTUAL. applyTemplates))
                    (.append il (.loadHandler transf))
                    (.append il (.endDocument transf))
                    (.append il Stylesheet/RETURN)
                    (.addMethod classGen transf))))))))))

  (method ^:private peepHoleOptimization ^void [this ^MethodGenerator methodGen]
    (let [^:const pattern "`aload'`pop'`instruction'"
          ^:final il (.getInstructionList methodGen)
          ^:final find (InstructionFinder. il)]
      (loop [^{:tag (Iterator InstructionHandle/1)} iter (.search find pattern)]
        (when (.hasNext iter)
          (let [match (cast InstructionHandle/1 (.next iter))]
            (try (.delete il (aget match 0) (aget match 1)) (catch TargetLostException e))
            (recur iter))))))

  (method ^:public addParam ^int [this ^Param param]
    (.add _globals param)
    (unchecked-subtract-int (.size _globals) 1))

  (method ^:public addVariable ^int [this ^Variable global]
    (.add _globals global)
    (unchecked-subtract-int (.size _globals) 1))

  (method ^:public display ^void [this ^int indent]
    (.indent this indent)
    (Util/println "Stylesheet")
    (.displayContents this (unchecked-add-int indent Stylesheet/IndentIncrement)))

  (method ^:public getNamespace ^String [this ^String prefix]
    (.lookupNamespace this prefix))

  (method ^:public getClassName ^String [this] _className)

  (method ^:public getTemplates ^{:tag (List Template)} [this] _templates)

  (method ^:public getAllValidTemplates ^{:tag (List Template)} [this]
    (if (nil? _includedStylesheets)
        _templates
        (do
          (when (nil? _allValidTemplates)
            (let [^{:tag (List Template)} templates (ArrayList.)]
              (.addAll templates _templates)
              (for-each [^Stylesheet included _includedStylesheets]
                (.addAll templates (.getAllValidTemplates included)))
              (when (some? _parentStylesheet) (return templates))
              (set! _allValidTemplates templates)))
          _allValidTemplates)))

  (method ^:protected addTemplate ^void [this ^Template template]
    (.add _templates template)))

    (method ^:public do_action :throws [Exception] ^Symbol [this ^int act_num ^lr_parser parser
                                                            ^{:tag (Stack Symbol)} stack ^int top]
      (.parser_do_action action_obj act_num parser stack top))

    (method ^:public start_state ^int [this] 0)

    (method ^:public start_production ^int [this] 0)

    (method ^:public EOF_sym ^int [this] 0)

    (method ^:public error_sym ^int [this] 1)

    (field ^:public ^:static ^:final ^{:tag (List Expression)} EmptyArgs (ArrayList. 0))

    (field ^:public ^:static ^:final ^VariableRef DummyVarRef nil)

    (field ^:private ^Parser _parser)

    (field ^:private ^XSLTC _xsltc)

    (field ^:private ^String _expression)

    (field ^:private ^int _lineNumber 0)

    (field ^:public ^SymbolTable _symbolTable)

    (field ^:private ^XMLSecurityManager _xmlSM)

    (field ^:private ^XMLLimitAnalyzer _limitAnalyzer nil)

    (constructor ^:public [this ^Parser parser]
      (set! _parser parser)
      (set! _xsltc (.getXSLTC parser))
      (set! _symbolTable (.getSymbolTable parser))
      (set! _xmlSM (cast XMLSecurityManager (.getProperty _xsltc JdkConstants/SECURITY_MANAGER)))
      (set! _limitAnalyzer (XMLLimitAnalyzer.))
      (set! (.-grpLimit this)
            (if (some? _xmlSM) (.getLimit _xmlSM XMLSecurityManager$Limit/XPATH_GROUP_LIMIT) 0))
      (set! (.-opLimit this)
            (if (some? _xmlSM) (.getLimit _xmlSM XMLSecurityManager$Limit/XPATH_OP_LIMIT) 0))
      (set! (.-totalOpLimit this)
            (if (some? _xmlSM) (.getLimit _xmlSM XMLSecurityManager$Limit/XPATH_TOTALOP_LIMIT) 0)))

    (method ^:public getLineNumber ^int [this] _lineNumber)

    (method ^:public getQNameIgnoreDefaultNs ^QName [this ^String name]
      (.getQNameIgnoreDefaultNs _parser name))

    (method ^:public getQName ^QName [this ^String namespace ^String prefix ^String localname]
      (.getQName _parser namespace prefix localname))

    (method ^:public setMultiDocument ^void [this ^boolean flag]
      (.setMultiDocument _xsltc flag))

    (method ^:public setCallsNodeset ^void [this ^boolean flag]
      (.setCallsNodeset _xsltc flag))

    (method ^:public setHasIdCall ^void [this ^boolean flag]
      (.setHasIdCall _xsltc flag))

    (method ^:public createStepPattern ^StepPattern [this ^int axis test
                                                     ^:mutable ^{:tag (List Predicate)} predicates]
      (let [^:mutable ^int nodeType 0]
        (cond
          (nil? test)
            (do
              (set! nodeType
                    (cond
                      (== axis Axis/ATTRIBUTE) NodeTest/ATTRIBUTE
                      (== axis Axis/NAMESPACE) -1
                      :else NodeTest/ELEMENT))
              (StepPattern. axis nodeType predicates))
          (instance? Integer test)
            (do (set! nodeType (cast Integer test)) (StepPattern. axis nodeType predicates))
          :else
            (let [name (cast QName test)
                  ^:mutable setPriority false]
              (if (== axis Axis/NAMESPACE)
                  (set! nodeType
                        (if (.equals (.toString name) "*")
                            -1
                            (.registerNamespacePrefix _xsltc name)))
                  (let [^:final uri (.getNamespace name)
                        ^:final local (.getLocalPart name)
                        ^:final namespace_uri (.getQNameIgnoreDefaultNs _parser "namespace-uri")]
                    (when (and (some? uri) (or (.equals local "*") (.equals local "@*")))
                      (when (nil? predicates) (set! predicates (ArrayList. 2)))
                      (set! setPriority (== (.size predicates) 0))
                      (.add predicates
                            (Predicate. (EqualityExpr.
                                          Operators/EQ
                                          (NamespaceUriCall. namespace_uri)
                                          (LiteralExpr. uri)))))
                    (cond
                      (.equals local "*")
                        (set! nodeType
                              (if (== axis Axis/ATTRIBUTE) NodeTest/ATTRIBUTE NodeTest/ELEMENT))
                      (.equals local "@*") (set! nodeType NodeTest/ATTRIBUTE)
                      :else
                        (set! nodeType
                              (if (== axis Axis/ATTRIBUTE)
                                  (.registerAttribute _xsltc name)
                                  (.registerElement _xsltc name))))))
              (let [^:final result (StepPattern. axis nodeType predicates)]
                (when setPriority (.setPriority result (unchecked-negate 0.25)))
                result)))))

    (method ^:public findNodeType ^int [this ^int axis test]
      (cond
        (nil? test)
          (cond
            (== axis Axis/ATTRIBUTE) NodeTest/ATTRIBUTE
            (== axis Axis/NAMESPACE) -1
            :else NodeTest/ELEMENT)
        (instance? Integer test) (cast Integer test)
        :else
          (let [name (cast QName test)]
            (if (== axis Axis/NAMESPACE)
                (if (.equals (.toString name) "*") -1 (.registerNamespacePrefix _xsltc name))
                (do
                  (when (nil? (.getNamespace name))
                    (let [^:final local (.getLocalPart name)]
                      (cond
                        (.equals local "*")
                          (return (if (== axis Axis/ATTRIBUTE) NodeTest/ATTRIBUTE NodeTest/ELEMENT))
                        (.equals local "@*") (return NodeTest/ATTRIBUTE))))
                  (if (== axis Axis/ATTRIBUTE)
                      (.registerAttribute _xsltc name)
                      (.registerElement _xsltc name)))))))

    (method ^:public parse :throws [Exception] ^Symbol [this ^String expression ^int lineNumber]
      (try
        (set! _expression expression)
        (set! _lineNumber lineNumber)
        (let [s (.parse super)]
          (when (.isOverLimit this)
            (let [grpCount (.getCount this XPathParser/ID_GROUP)
                  opCount (.getCount this XPathParser/ID_OPERATOR)
                  totalOpCount (.getCount this XPathParser/ID_TOTAL_OPERATOR)
                  ^:mutable ^String errCode nil
                  ^:mutable ^Object/1 params nil]
              (cond
                (and (> (.-grpLimit this) 0) (> grpCount (.-grpLimit this)))
                  (do
                    (set! errCode ErrorMsg/XPATH_GROUP_LIMIT)
                    (set! params
                          (new
                            Object/1
                            [grpCount
                             (.-grpLimit this)
                             (.getStateLiteral _xmlSM XMLSecurityManager$Limit/XPATH_GROUP_LIMIT)])))
                (and (> (.-opLimit this) 0) (> opCount (.-opLimit this)))
                  (do
                    (set! errCode ErrorMsg/XPATH_OPERATOR_LIMIT)
                    (set! params
                          (new Object/1
                               [opCount
                                (.-opLimit this)
                                (.getStateLiteral _xmlSM XMLSecurityManager$Limit/XPATH_OP_LIMIT)])))
                :else
                  (when (and (> (.-totalOpLimit this) 0) (> totalOpCount (.-totalOpLimit this)))
                    (set! errCode ErrorMsg/XPATH_TOTAL_OPERATOR_LIMIT)
                    (set! params
                          (new Object/1
                               [totalOpCount
                                (.-totalOpLimit this)
                                (.getStateLiteral
                                  _xmlSM
                                  XMLSecurityManager$Limit/XPATH_TOTALOP_LIMIT)]))))
              (when (some? errCode)
                (.reportError _parser Constants/FATAL (ErrorMsg. errCode lineNumber params))
                (throw (RuntimeException. ErrorMsg/XPATH_LIMIT)))))
          (return s))
        (catch IllegalCharException e
          (let [err (ErrorMsg. ErrorMsg/ILLEGAL_CHAR_ERR lineNumber (.getMessage e))]
            (.reportError _parser Constants/FATAL err))))
      nil)

    (method ^:final lookupName ^SyntaxTreeNode [this ^QName name]
      (let [^:final ^SyntaxTreeNode result (.lookupVariable _parser name)]
        (if (some? result) result (.lookupName _symbolTable name))))

    (method ^:public ^:final addError ^void [this ^ErrorMsg error]
      (.reportError _parser Constants/ERROR error))

    (method ^:public report_error ^void [this ^String message info]
      (let [^:final err (ErrorMsg. ErrorMsg/SYNTAX_ERR _lineNumber _expression)]
        (.reportError _parser Constants/FATAL err)))

    (method ^:public report_fatal_error ^void [this ^String message info])

    (method ^:public insertStep ^RelativeLocationPath [this ^Step step ^RelativeLocationPath rlp]
      (cond
        (instance? Step rlp) (ParentLocationPath. step (cast Step rlp))
        (instance? ParentLocationPath rlp)
          (let [^:final plp (cast ParentLocationPath rlp)
                ^:final newrlp (.insertStep this step (.getPath plp))]
            (ParentLocationPath. newrlp (.getStep plp)))
        :else (do (.addError this (ErrorMsg. ErrorMsg/INTERNAL_ERR "XPathParser.insertStep")) rlp)))

    (method ^:public isElementAxis ^boolean [this ^int axis]
      (or (or (or (== axis Axis/CHILD) (== axis Axis/ATTRIBUTE)) (== axis Axis/NAMESPACE))
          (== axis Axis/DESCENDANT))))

  (defclass parser_actions
    (field ^:private ^:final ^XPathParser parser)

    (constructor [this ^XPathParser parser] (set! (.-parser this) parser))

    (method ^:public ^:final parser_do_action :throws [Exception] ^Symbol [this ^int parser_act_num
                                                                           ^lr_parser parser_parser
                                                                           ^{:tag (Stack Symbol)} parser_stack
                                                                           ^int parser_top]
      (let [^:mutable ^Symbol parser_result nil]
        (switch parser_act_num
          0
            (do
              (let [start_val (cast SyntaxTreeNode
                                    (.-value (cast
                                               Symbol
                                               (.get
                                                 parser_stack
                                                 (unchecked-subtract-int parser_top 1)))))]
                (set! parser_result
                      (Symbol. 0
                               (.-left (cast Symbol
                                             (.get
                                               parser_stack
                                               (unchecked-subtract-int parser_top 1))))
                               (.-right (cast Symbol
                                              (.get
                                                parser_stack
                                                (unchecked-subtract-int parser_top 0))))
                               start_val)))
              (.done_parsing parser_parser)
              parser_result)
          1
            (do
              (let [pattern (cast Pattern
                                  (.-value (cast
                                             Symbol
                                             (.get
                                               parser_stack
                                               (unchecked-subtract-int parser_top 0)))))]
                (set! parser_result
                      (Symbol. 1
                               (.-left (cast Symbol
                                             (.get
                                               parser_stack
                                               (unchecked-subtract-int parser_top 1))))
                               (.-right (cast Symbol
                                              (.get
                                                parser_stack
                                                (unchecked-subtract-int parser_top 0))))
                               pattern)))
              parser_result)
          2
            (do
              (let [expr (cast Expression
                               (.-value (cast Symbol
                                              (.get
                                                parser_stack
                                                (unchecked-subtract-int parser_top 0)))))]
                (set! parser_result
                      (Symbol. 1
                               (.-left (cast Symbol
                                             (.get
                                               parser_stack
                                               (unchecked-subtract-int parser_top 1))))
                               (.-right (cast Symbol
                                              (.get
                                                parser_stack
                                                (unchecked-subtract-int parser_top 0))))
                               expr)))
              parser_result)
          3
            (do
              (let [lpp (cast Pattern
                              (.-value (cast Symbol
                                             (.get
                                               parser_stack
                                               (unchecked-subtract-int parser_top 0)))))]
                (set! parser_result
                      (Symbol. 28
                               (.-left (cast Symbol
                                             (.get
                                               parser_stack
                                               (unchecked-subtract-int parser_top 0))))
                               (.-right (cast Symbol
                                              (.get
                                                parser_stack
                                                (unchecked-subtract-int parser_top 0))))
                               lpp)))
              parser_result)
          4
            (do
              (let [lpp (cast Pattern
                              (.-value (cast Symbol
                                             (.get
                                               parser_stack
                                               (unchecked-subtract-int parser_top 2)))))
                    p (cast Pattern
                            (.-value (cast
                                       Symbol
                                       (.get parser_stack (unchecked-subtract-int parser_top 0)))))
                    ^Pattern result (AlternativePattern. lpp p)]
                (set! parser_result
                      (Symbol. 28
                               (.-left (cast Symbol
                                             (.get
                                               parser_stack

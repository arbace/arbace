  (method ^:public getSymbolTable ^SymbolTable [this] _symbolTable)

  (method ^:public getTemplate ^Template [this] _template)

  (method ^:public setTemplate ^void [this ^Template template]
    (set! _template template))

  (field ^:private ^int _templateIndex 0)

  (method ^:public getTemplateIndex ^int [this]
    (let [_templateIndex-1 _templateIndex]
      (set! _templateIndex (unchecked-inc-int _templateIndex))
      _templateIndex-1))

  (field ^:private ^boolean versionIsOne true)

  (method ^:public makeInstance ^SyntaxTreeNode [this ^String uri ^String prefix ^String local
                                                 ^Attributes attributes]
    (let [^:mutable ^SyntaxTreeNode node nil
          qname (.getQName this uri prefix local)
          className (cast String (.get _instructionClasses (.getStringRep qname)))]
      (if (some? className)
          (try
            (let [^:final ^{:tag (Class ?)} clazz (ObjectFactory/findProviderClass className true)]
              (set! node (cast SyntaxTreeNode (.newInstance (.getDeclaredConstructor clazz))))
              (.setQName node qname)
              (.setParser node this)
              (when (some? _locator) (.setLineNumber node (.getLineNumber this)))
              (when (instance? Stylesheet node) (.setStylesheet _xsltc (cast Stylesheet node)))
              (.checkForSuperfluousAttributes this node attributes))
            (catch ClassNotFoundException e
              (let [err (ErrorMsg. ErrorMsg/CLASS_NOT_FOUND_ERR node)]
                (.reportError this Parser/ERROR err)))
            (catch Exception e
              (let [err (ErrorMsg. ErrorMsg/INTERNAL_ERR (.getMessage e) node)]
                (.reportError this Parser/FATAL err))))
          (do
            (when (some? uri)
              (cond
                (.equals uri Parser/XSLT_URI)
                  (do
                    (set! node (UnsupportedElement. uri prefix local false))
                    (let [element (cast UnsupportedElement node)
                          msg (ErrorMsg. ErrorMsg/UNSUPPORTED_XSL_ERR (.getLineNumber this) local)]
                      (.setErrorMessage element msg)
                      (when versionIsOne (.reportError this Parser/UNSUPPORTED msg))))
                (.equals uri Parser/TRANSLET_URI)
                  (do
                    (set! node (UnsupportedElement. uri prefix local true))
                    (let [element (cast UnsupportedElement node)
                          msg (ErrorMsg. ErrorMsg/UNSUPPORTED_EXT_ERR (.getLineNumber this) local)]
                      (.setErrorMessage element msg)))
                :else
                  (let [sheet (.getStylesheet _xsltc)]
                    (when (and (some? sheet) (.isExtension sheet uri))
                      (when-not (identical? sheet (.peek _parentStack))
                        (set! node (UnsupportedElement. uri prefix local true))
                        (let [elem (cast UnsupportedElement node)
                              msg (ErrorMsg. ErrorMsg/UNSUPPORTED_EXT_ERR
                                             (.getLineNumber this)
                                             (java-str prefix ":" local))]
                          (.setErrorMessage elem msg)))))))
            (when (nil? node)
              (set! node (LiteralElement.))
              (.setLineNumber node (.getLineNumber this)))))
      (when (and (some? node) (instance? LiteralElement node))
        (.setQName (cast LiteralElement node) qname))
      node))

  (method ^:private checkForSuperfluousAttributes ^void [this ^SyntaxTreeNode node ^Attributes attrs]
    (let [qname (.getQName node)
          isStylesheet (instance? Stylesheet node)
          legal (cast String/1 (.get _instructionAttrs (.getStringRep qname)))]
      (when (and versionIsOne (some? legal))
        (let [^:mutable ^int j 0
              ^:final n (.getLength attrs)]
          (loop [^int i 0]
            (when (< i n)
              (let [^:final attrQName (.getQName attrs i)]
                (when (and isStylesheet (.equals attrQName "version"))
                  (set! versionIsOne (.equals (.getValue attrs i) "1.0")))
                (if (or (.startsWith attrQName "xml") (> (.indexOf attrQName \:) 0))
                    (recur (unchecked-inc-int i))
                    (do
                      (set! j 0)
                      (while (< j (alength legal))
                        (when (.equalsIgnoreCase attrQName (aget legal j)) (break))
                        (set! j (unchecked-inc-int j)))
                      (if (== j (alength legal))
                          (let [^:final err (ErrorMsg.
                                              ErrorMsg/ILLEGAL_ATTRIBUTE_ERR
                                              attrQName
                                              node)]
                            (.setWarningError err true)
                            (.reportError this Parser/WARNING err)
                            (recur (unchecked-inc-int i)))
                          (recur (unchecked-inc-int i))))))))))))

  (method ^:public parseExpression ^Expression [this ^SyntaxTreeNode parent ^String exp]
    (cast Expression (.parseTopLevel this parent (java-str "<EXPRESSION>" exp) nil)))

  (method ^:public parseExpression ^Expression [this ^SyntaxTreeNode parent ^String attr ^String def]
    (let [^:mutable exp (.getAttribute parent attr)]
      (when (and (== (.length exp) 0) (some? def)) (set! exp def))
      (cast Expression (.parseTopLevel this parent (java-str "<EXPRESSION>" exp) exp))))

  (method ^:public parsePattern ^Pattern [this ^SyntaxTreeNode parent ^String pattern]
    (cast Pattern (.parseTopLevel this parent (java-str "<PATTERN>" pattern) pattern)))

  (method ^:public parsePattern ^Pattern [this ^SyntaxTreeNode parent ^String attr ^String def]
    (let [^:mutable pattern (.getAttribute parent attr)]
      (when (and (== (.length pattern) 0) (some? def)) (set! pattern def))
      (cast Pattern (.parseTopLevel this parent (java-str "<PATTERN>" pattern) pattern))))

  (method ^:private parseTopLevel ^SyntaxTreeNode [this ^SyntaxTreeNode parent ^String text
                                                   ^String expression]
    (let [line (.getLineNumber this)]
      (try
        (.setScanner _xpathParser (XPathLexer. (StringReader. text)))
        (let [result (.parse _xpathParser expression line)]
          (when (some? result)
            (let [^:final node (cast SyntaxTreeNode (.-value result))]
              (when (some? node)
                (.setParser node this)
                (.setParent node parent)
                (.setLineNumber node line)
                (return node))))
          (.reportError this Parser/ERROR (ErrorMsg. ErrorMsg/XPATH_PARSER_ERR expression parent)))
        (catch Exception e
          (when (.equals ErrorMsg/XPATH_LIMIT (.getMessage e))
            (throw (RuntimeException. ErrorMsg/XPATH_LIMIT)))
          (when (.debug _xsltc) (.printStackTrace e))
          (.reportError this Parser/ERROR (ErrorMsg. ErrorMsg/XPATH_PARSER_ERR expression parent))))
      (.setParser SyntaxTreeNode/Dummy this)
      SyntaxTreeNode/Dummy))

  (method ^:public errorsFound ^boolean [this] (> (.size _errors) 0))

  (method ^:public printErrors ^void [this]
    (let [^:final size (.size _errors)]
      (when (> size 0)
        (.println System/err (ErrorMsg. ErrorMsg/COMPILER_ERROR_KEY))
        (loop [^int i 0]
          (when (< i size)
            (.println System/err (java-str "  " (.get _errors i)))
            (recur (unchecked-inc-int i)))))))

  (method ^:public printWarnings ^void [this]
    (let [^:final size (.size _warnings)]
      (when (> size 0)
        (.println System/err (ErrorMsg. ErrorMsg/COMPILER_WARNING_KEY))
        (loop [^int i 0]
          (when (< i size)
            (.println System/err (java-str "  " (.get _warnings i)))
            (recur (unchecked-inc-int i)))))))

  (method ^:public reportError ^void [this ^:final ^int category ^:final ^ErrorMsg error]
    (switch category
      Constants/INTERNAL (.add _errors error)
      Constants/UNSUPPORTED (.add _errors error)
      Constants/FATAL (.add _errors error)
      Constants/ERROR (.add _errors error)
      Constants/WARNING (.add _warnings error)))

  (method ^:public getErrors ^{:tag (ArrayList ErrorMsg)} [this] _errors)

  (method ^:public getWarnings ^{:tag (ArrayList ErrorMsg)} [this]
    _warnings)

  (field ^:private ^{:tag (Stack SyntaxTreeNode)} _parentStack nil)

  (field ^:private ^{:tag (Map String String)} _prefixMapping nil)

  (method ^:public startDocument ^void [this]
    (set! _root nil)
    (set! _target nil)
    (set! _prefixMapping nil)
    (set! _parentStack (Stack.)))

  (method ^:public endDocument ^void [this])

  (method ^:public startPrefixMapping ^void [this ^String prefix ^String uri]
    (when (nil? _prefixMapping) (set! _prefixMapping (HashMap.)))
    (.put _prefixMapping prefix uri))

  (method ^:public endPrefixMapping ^void [this ^String prefix])

  (method ^:public startElement :throws [SAXException] ^void [this ^String uri ^String localname
                                                              ^String qname ^Attributes attributes]
    (let [^:final col (.lastIndexOf qname \:)
          ^:final ^String prefix (when-not (== col -1) (.substring qname 0 col))
          element (.makeInstance this uri prefix localname attributes)]
      (when (nil? element)
        (let [err (ErrorMsg. ErrorMsg/ELEMENT_PARSE_ERR (java-str prefix \: localname))]
          (throw (SAXException. (.toString err)))))
      (if (nil? _root)
          (do
            (if (or (nil? _prefixMapping)
                    (= (.containsValue _prefixMapping Constants/XSLT_URI) false))
                (set! _rootNamespaceDef false)
                (set! _rootNamespaceDef true))
            (set! _root element))
          (let [parent (cast SyntaxTreeNode (.peek _parentStack))]
            (when (and (.isAssignableFrom (.getClass element) Import) (.notTypeOf parent Import))
              (let [err (ErrorMsg. ErrorMsg/IMPORT_PRECEDE_OTHERS_ERR
                                   (java-str prefix \: localname))]
                (throw (SAXException. (.toString err)))))
            (.addElement parent element)
            (.setParent element parent)))
      (.setAttributes element (AttributesImpl. attributes))
      (.setPrefixMapping element _prefixMapping)
      (when (instance? Stylesheet element)
        (.setCurrentNode (.getSymbolTable this) element)
        (.declareExtensionPrefixes (cast Stylesheet element) this))
      (set! _prefixMapping nil)
      (.push _parentStack element)))

  (method ^:public endElement ^void [this ^String uri ^String localname ^String qname]
    (.pop _parentStack))

  (method ^:public characters ^void [this ^char/1 ch ^int start ^int length]
    (let [string (String. ch start length)
          parent (cast SyntaxTreeNode (.peek _parentStack))]
      (when-not (== (.length string) 0)
        (if (instance? Text parent)
            (.setText (cast Text parent) string)
            (when-not (instance? Stylesheet parent)
              (let [bro (.lastChild parent)]
                (when (and (some? bro) (instance? Text bro))
                  (let [text (cast Text bro)]
                    (when-not (.isTextElement text)
                      (when (or (> length 1) (< (int (aget ch 0)) 0x100))
                        (.setText text string)
                        (return)))))
                (.addElement parent (Text. string))))))))

  (method ^:private getTokenValue ^String [this ^String token]
    (let [^:final start (.indexOf token \")
          ^:final stop (.lastIndexOf token \")]
      (.substring token (unchecked-add-int start 1) stop)))

  (method ^:public processingInstruction ^void [this ^String name ^String value]
    (when (and (nil? _target) (.equals name "xml-stylesheet"))
      (let [^:mutable ^String href nil
            ^:mutable ^String media nil
            ^:mutable ^String title nil
            ^:mutable ^String charset nil
            tokens (StringTokenizer. value)]
        (while (.hasMoreElements tokens)
          (let [token (cast String (.nextElement tokens))]
            (cond
              (.startsWith token "href") (set! href (.getTokenValue this token))
              (.startsWith token "media") (set! media (.getTokenValue this token))
              (.startsWith token "title") (set! title (.getTokenValue this token))
              (.startsWith token "charset") (set! charset (.getTokenValue this token)))))
        (when (and (and (or (nil? _PImedia) (.equals _PImedia media))
                        (or (nil? _PItitle) (.equals _PImedia title)))
                   (or (nil? _PIcharset) (.equals _PImedia charset)))
          (set! _target href)))))

  (method ^:public ignorableWhitespace ^void [this ^char/1 ch ^int start ^int length])

  (method ^:public skippedEntity ^void [this ^String name])

  (method ^:public setDocumentLocator ^void [this ^Locator locator]
    (set! _locator locator))

  (method ^:private getLineNumber ^int [this]
    (let [^:mutable ^int line 0] (when (some? _locator) (set! line (.getLineNumber _locator))) line)))

        (let [id (.getAttribute root "id")] (when (.equals id href) (return root))))
      (let [^{:tag (List SyntaxTreeNode)} children (.getContents root)]
        (when (some? children)
          (let [^:final count (.size children)]
            (loop [^int i 0]

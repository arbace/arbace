              (when (some? _standalone) (.setStandalone handler _standalone))
              (when _omitHeader (.setOmitXMLDeclaration handler true))
              (.setCdataSectionElements handler _cdata)
              (when (some? _version) (.setVersion handler _version))
              (.setIndent handler _indent)
              (when (>= _indentamount 0) (.setIndentAmount handler _indentamount))
              (when (some? _doctypeSystem) (.setDoctype handler _doctypeSystem _doctypePublic))
              (.setIsStandalone handler _isStandalone))
            (when (.equals _method "html")
              (.setIndent handler _indent)
              (.setDoctype handler _doctypeSystem _doctypePublic)
              (when (some? _mediaType) (.setMediaType handler _mediaType))))
        (do
          (.setCdataSectionElements handler _cdata)
          (when (some? _version) (.setVersion handler _version))
          (when (some? _standalone) (.setStandalone handler _standalone))
          (when _omitHeader (.setOmitXMLDeclaration handler true))
          (.setIndent handler _indent)
          (.setDoctype handler _doctypeSystem _doctypePublic)
          (.setIsStandalone handler _isStandalone))))


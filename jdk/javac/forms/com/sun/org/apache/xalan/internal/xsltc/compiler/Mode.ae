                                              ihText))
                                    (aset targets DTM/NAMESPACE_NODE ihLoop)
                                    (aset targets DTM/ELEMENT_NODE elemNamespaceHandle)
                                    (aset targets DTM/ATTRIBUTE_NODE attrNamespaceHandle)
                                    (let [^:mutable ihPI ihLoop]
                                      (when (some? _childNodeTestSeq) (set! ihPI ihElem))
                                      (if (some? (aget _testSeq DTM/PROCESSING_INSTRUCTION_NODE))
                                          (aset targets
                                                DTM/PROCESSING_INSTRUCTION_NODE
                                                (.compile
                                                  (aget _testSeq DTM/PROCESSING_INSTRUCTION_NODE)
                                                  classGen
                                                  methodGen
                                                  ihPI))
                                          (aset targets DTM/PROCESSING_INSTRUCTION_NODE ihPI))
                                      (let [^:mutable ihComment ihLoop]
                                        (when (some? _childNodeTestSeq) (set! ihComment ihElem))
                                        (aset targets
                                              DTM/COMMENT_NODE
                                              (if (some? (aget _testSeq DTM/COMMENT_NODE))
                                                  (.compile
                                                    (aget _testSeq DTM/COMMENT_NODE)
                                                    classGen
                                                    methodGen
                                                    ihComment)
                                                  ihComment))
                                        (aset targets DTM/CDATA_SECTION_NODE ihLoop)
                                        (aset targets DTM/DOCUMENT_FRAGMENT_NODE ihLoop)
                                        (aset targets DTM/DOCUMENT_TYPE_NODE ihLoop)
                                        (aset targets DTM/ENTITY_NODE ihLoop)
                                        (aset targets DTM/ENTITY_REFERENCE_NODE ihLoop)
                                        (aset targets DTM/NOTATION_NODE ihLoop)
                                        (arbace.core/loop
                                          [^int i DTM/NTYPES]
                                          (when (< i (alength targets))
                                            (let [^:final testSeq (aget _testSeq i)]
                                              (cond
                                                (or (nil? testSeq) (aget isNamespace i))
                                                  (if (aget isAttribute i)
                                                      (do
                                                        (aset targets i attrNamespaceHandle)
                                                        (recur (unchecked-inc-int i)))
                                                      (do
                                                        (aset targets i elemNamespaceHandle)
                                                        (recur (unchecked-inc-int i))))
                                                (aget isAttribute i)
                                                  (do
                                                    (aset
                                                      targets
                                                      i
                                                      (.compile
                                                        testSeq
                                                        classGen
                                                        methodGen
                                                        attrNamespaceHandle))
                                                    (recur (unchecked-inc-int i)))
                                                :else
                                                  (do
                                                    (aset
                                                      targets
                                                      i
                                                      (.compile
                                                        testSeq
                                                        classGen
                                                        methodGen
                                                        elemNamespaceHandle))
                                                    (recur (unchecked-inc-int i)))))))
                                        (when (some? ilKey) (.insert body ilKey))
                                        (let [^:final getType (.addInterfaceMethodref
                                                                cpg
                                                                Mode/DOM_INTF
                                                                "getExpandedTypeID"
                                                                "(I)I")]
                                          (.append body (.loadDOM methodGen))
                                          (.append body (ILOAD. _currentIndex))
                                          (.append body (INVOKEINTERFACE. getType 2))
                                          (let [disp (.append body (SWITCH. types targets ihLoop))]
                                            (.appendTestSequences this body)
                                            (.appendTemplateCode this body)
                                            (when (some? nsElem) (.append body nsElem))
                                            (when (some? nsAttr) (.append body nsAttr))
                                            (.append body ilRecurse)
                                            (.append body ilText)
                                            (.append mainIL body)
                                            (.append mainIL ilLoop)
                                            (.peepHoleOptimization this methodGen)
                                            (.addMethod classGen methodGen)
                                            (when (some? _importLevels)
                                              (for-each [^{:tag (Map$Entry Integer Integer)} entry
                                                           (.entrySet _importLevels)]
                                                (.compileApplyImports
                                                  this
                                                  classGen
                                                  (.intValue (cast Integer (.getValue entry)))
                                                  (.intValue (cast Integer (.getKey entry)))))))))))))))))))))))))))

  (method ^:private compileTemplateCalls ^void [this ^ClassGenerator classGen
                                                ^MethodGenerator methodGen ^InstructionHandle next
                                                ^int min ^int max]
    (.forEach (.stream (.keySet _neededTemplates))
              (lambda Consumer ^void [^Template template]
                (let [^:final prec (.getImportPrecedence template)]
                  (when (and (>= prec min) (< prec max))
                    (if (.hasContents template)
                        (let [til (.compile template classGen methodGen)]
                          (.append til (GOTO_W. next))
                          (.put _templateILs template til)
                          (.put _templateIHs template (.getStart til)))
                        (.put _templateIHs template next)))))))

  (method ^:public compileApplyImports ^void [this ^ClassGenerator classGen ^int min ^int max]
    (let [^:final xsltc (.getXSLTC (.getParser classGen))
          ^:final cpg (.getConstantPool classGen)
          ^:final ^{:tag (List String)} names (.getNamesIndex xsltc)]
      (set! _namedTemplates (LinkedHashMap.))
      (set! _neededTemplates (LinkedHashMap.))
      (set! _templateIHs (HashMap.))
      (set! _templateILs (HashMap.))
      (set! _patternGroups (cast List/1 (new ArrayList/1 32)))
      (set! _rootPattern nil)
      (let [^{:tag (List Template)} oldTemplates _templates]
        (set! _templates (ArrayList.))
        (for-each [^Template template oldTemplates]
          (let [^:final prec (.getImportPrecedence template)]
            (when (and (>= prec min) (< prec max)) (.addTemplate this template))))
        (.processPatterns this _keys)
        (let [^:final argTypes (new com.sun.org.apache.bcel.internal.generic.Type/1 4)]
          (aset argTypes 0 (Util/getJCRefType Mode/DOM_INTF_SIG))
          (aset argTypes 1 (Util/getJCRefType Mode/NODE_ITERATOR_SIG))
          (aset argTypes 2 (Util/getJCRefType Mode/TRANSLET_OUTPUT_SIG))
          (aset argTypes 3 com.sun.org.apache.bcel.internal.generic.Type/INT)
          (let [^:final argNames (new String/1 4)]
            (aset argNames 0 Mode/DOCUMENT_PNAME)
            (aset argNames 1 Mode/ITERATOR_PNAME)
            (aset argNames 2 Mode/TRANSLET_OUTPUT_PNAME)
            (aset argNames 3 Mode/NODE_PNAME)
            (let [^:final mainIL (InstructionList.)
                  ^:final methodGen (MethodGenerator.
                                      (bit-or-int Mode/ACC_PUBLIC Mode/ACC_FINAL)
                                      com.sun.org.apache.bcel.internal.generic.Type/VOID
                                      argTypes
                                      argNames
                                      (java-str (.functionName this) \_ max)
                                      (.getClassName this)
                                      mainIL
                                      (.getConstantPool classGen))]
              (.addException methodGen "com.sun.org.apache.xalan.internal.xsltc.TransletException")
              (let [^:mutable ^LocalVariableGen current nil]
                (set! current
                      (.addLocalVariable2 methodGen
                                          "current"
                                          com.sun.org.apache.bcel.internal.generic.Type/INT
                                          nil))
                (set! _currentIndex (.getIndex current))
                (.append mainIL (ILOAD. (.getLocalIndex methodGen Mode/NODE_PNAME)))
                (.setStart current (.append mainIL (ISTORE. _currentIndex)))
                (let [^:final body (InstructionList.)]
                  (.append body Mode/NOP)
                  (let [^:final ilLoop (InstructionList.)]
                    (.append ilLoop Mode/RETURN)
                    (let [^:final ihLoop (.getStart ilLoop)
                          ilRecurse (.compileDefaultRecursion this classGen methodGen ihLoop)
                          ihRecurse (.getStart ilRecurse)
                          ilText (.compileDefaultText this classGen methodGen ihLoop)
                          ^:mutable ihText (.getStart ilText)
                          ^:final types (new int/1 (unchecked-add-int DTM/NTYPES (.size names)))]
                      (loop [^int i 0]
                        (when (< i (alength types)) (aset types i i) (recur (unchecked-inc-int i))))
                      (let [^:final isAttribute (new boolean/1 (alength types))
                            ^:final isNamespace (new boolean/1 (alength types))]
                        (loop [^int i 0]
                          (when (< i (.size names))
                            (let [^:final name (cast String (.get names i))]
                              (aset isAttribute
                                    (unchecked-add-int i DTM/NTYPES)
                                    (Mode/isAttributeName name))
                              (aset isNamespace
                                    (unchecked-add-int i DTM/NTYPES)
                                    (Mode/isNamespaceName name))
                              (recur (unchecked-inc-int i)))))
                        (.compileTemplateCalls this classGen methodGen ihLoop min max)
                        (let [^:final elemTest (aget _testSeq DTM/ELEMENT_NODE)
                              ^:mutable ihElem ihRecurse]
                          (when (some? elemTest)
                            (set! ihElem (.compile elemTest classGen methodGen ihLoop)))
                          (let [^:final attrTest (aget _testSeq DTM/ATTRIBUTE_NODE)
                                ^:mutable ihAttr ihLoop]
                            (when (some? attrTest)
                              (set! ihAttr (.compile attrTest classGen methodGen ihAttr)))
                            (let [^:mutable ^InstructionList ilKey nil]
                              (when (some? _idxTestSeq)
                                (set! ilKey (.getInstructionList _idxTestSeq)))
                              (when (some? _childNodeTestSeq)
                                (let [nodePrio (.getPriority _childNodeTestSeq)
                                      nodePos (.getPosition _childNodeTestSeq)
                                      ^:mutable elemPrio (unchecked-subtract 0.0 Double/MAX_VALUE)
                                      ^:mutable elemPos Integer/MIN_VALUE]
                                  (when (some? elemTest)
                                    (set! elemPrio (.getPriority elemTest))
                                    (set! elemPos (.getPosition elemTest)))
                                  (when (or (or (Double/isNaN elemPrio) (< elemPrio nodePrio))
                                            (and (== elemPrio nodePrio) (< elemPos nodePos)))
                                    (set! ihElem
                                          (.compile _childNodeTestSeq classGen methodGen ihLoop)))
                                  (let [^:final textTest (aget _testSeq DTM/TEXT_NODE)
                                        ^:mutable textPrio (unchecked-subtract 0.0 Double/MAX_VALUE)
                                        ^:mutable textPos Integer/MIN_VALUE]
                                    (when (some? textTest)
                                      (set! textPrio (.getPriority textTest))
                                      (set! textPos (.getPosition textTest)))
                                    (when (or (or (Double/isNaN textPrio) (< textPrio nodePrio))
                                              (and (== textPrio nodePrio) (< textPos nodePos)))
                                      (set! ihText
                                            (.compile _childNodeTestSeq classGen methodGen ihLoop))
                                      (aset _testSeq DTM/TEXT_NODE _childNodeTestSeq)))))
                              (let [^:mutable elemNamespaceHandle ihElem
                                    nsElem (.compileNamespaces
                                             this
                                             classGen
                                             methodGen
                                             isNamespace
                                             isAttribute
                                             false
                                             ihElem)]
                                (when (some? nsElem) (set! elemNamespaceHandle (.getStart nsElem)))
                                (let [nsAttr (.compileNamespaces
                                               this
                                               classGen
                                               methodGen
                                               isNamespace
                                               isAttribute
                                               true
                                               ihAttr)
                                      ^:mutable attrNamespaceHandle ihAttr]
                                  (when (some? nsAttr)
                                    (set! attrNamespaceHandle (.getStart nsAttr)))
                                  (let [^:final targets (new InstructionHandle/1 (alength types))]
                                    (loop [^int i DTM/NTYPES]
                                      (when (< i (alength targets))
                                        (let [^:final testSeq (aget _testSeq i)]
                                          (cond
                                            (aget isNamespace i)
                                              (if (aget isAttribute i)
                                                  (do
                                                    (aset targets i attrNamespaceHandle)
                                                    (recur (unchecked-inc-int i)))
                                                  (do
                                                    (aset targets i elemNamespaceHandle)
                                                    (recur (unchecked-inc-int i))))
                                            (some? testSeq)
                                              (if (aget isAttribute i)
                                                  (do
                                                    (aset
                                                      targets
                                                      i
                                                      (.compile
                                                        testSeq
                                                        classGen
                                                        methodGen
                                                        attrNamespaceHandle))
                                                    (recur (unchecked-inc-int i)))
                                                  (do
                                                    (aset
                                                      targets
                                                      i
                                                      (.compile
                                                        testSeq
                                                        classGen
                                                        methodGen
                                                        elemNamespaceHandle))
                                                    (recur (unchecked-inc-int i))))
                                            :else
                                              (do
                                                (aset targets i ihLoop)
                                                (recur (unchecked-inc-int i)))))))
                                    (aset targets
                                          DTM/ROOT_NODE
                                          (if (some? _rootPattern)
                                              (.getTemplateInstructionHandle
                                                this
                                                (.getTemplate _rootPattern))
                                              ihRecurse))
                                    (aset targets
                                          DTM/DOCUMENT_NODE
                                          (if (some? _rootPattern)
                                              (.getTemplateInstructionHandle
                                                this
                                                (.getTemplate _rootPattern))
                                              ihRecurse))
                                    (aset targets
                                          DTM/TEXT_NODE
                                          (if (some? (aget _testSeq DTM/TEXT_NODE))
                                              (.compile
                                                (aget _testSeq DTM/TEXT_NODE)
                                                classGen
                                                methodGen
                                                ihText)
                                              ihText))
                                    (aset targets DTM/NAMESPACE_NODE ihLoop)
                                    (aset targets DTM/ELEMENT_NODE elemNamespaceHandle)
                                    (aset targets DTM/ATTRIBUTE_NODE attrNamespaceHandle)
                                    (let [^:mutable ihPI ihLoop]
                                      (when (some? _childNodeTestSeq) (set! ihPI ihElem))
                                      (if (some? (aget _testSeq DTM/PROCESSING_INSTRUCTION_NODE))
                                          (aset targets
                                                DTM/PROCESSING_INSTRUCTION_NODE
                                                (.compile
                                                  (aget _testSeq DTM/PROCESSING_INSTRUCTION_NODE)
                                                  classGen
                                                  methodGen
                                                  ihPI))
                                          (aset targets DTM/PROCESSING_INSTRUCTION_NODE ihPI))
                                      (let [^:mutable ihComment ihLoop]
                                        (when (some? _childNodeTestSeq) (set! ihComment ihElem))
                                        (aset targets
                                              DTM/COMMENT_NODE
                                              (if (some? (aget _testSeq DTM/COMMENT_NODE))
                                                  (.compile
                                                    (aget _testSeq DTM/COMMENT_NODE)
                                                    classGen
                                                    methodGen
                                                    ihComment)
                                                  ihComment))
                                        (aset targets DTM/CDATA_SECTION_NODE ihLoop)
                                        (aset targets DTM/DOCUMENT_FRAGMENT_NODE ihLoop)
                                        (aset targets DTM/DOCUMENT_TYPE_NODE ihLoop)
                                        (aset targets DTM/ENTITY_NODE ihLoop)
                                        (aset targets DTM/ENTITY_REFERENCE_NODE ihLoop)
                                        (aset targets DTM/NOTATION_NODE ihLoop)
                                        (loop [^int i DTM/NTYPES]
                                          (when (< i (alength targets))
                                            (let [^:final testSeq (aget _testSeq i)]
                                              (cond
                                                (or (nil? testSeq) (aget isNamespace i))
                                                  (if (aget isAttribute i)
                                                      (do
                                                        (aset targets i attrNamespaceHandle)
                                                        (recur (unchecked-inc-int i)))
                                                      (do
                                                        (aset targets i elemNamespaceHandle)
                                                        (recur (unchecked-inc-int i))))
                                                (aget isAttribute i)
                                                  (do
                                                    (aset
                                                      targets
                                                      i
                                                      (.compile
                                                        testSeq
                                                        classGen
                                                        methodGen
                                                        attrNamespaceHandle))
                                                    (recur (unchecked-inc-int i)))
                                                :else
                                                  (do
                                                    (aset
                                                      targets
                                                      i
                                                      (.compile
                                                        testSeq
                                                        classGen
                                                        methodGen
                                                        elemNamespaceHandle))
                                                    (recur (unchecked-inc-int i)))))))
                                        (when (some? ilKey) (.insert body ilKey))
                                        (let [^:final getType (.addInterfaceMethodref
                                                                cpg
                                                                Mode/DOM_INTF
                                                                "getExpandedTypeID"
                                                                "(I)I")]
                                          (.append body (.loadDOM methodGen))
                                          (.append body (ILOAD. _currentIndex))
                                          (.append body (INVOKEINTERFACE. getType 2))
                                          (let [disp (.append body (SWITCH. types targets ihLoop))]
                                            (.appendTestSequences this body)
                                            (.appendTemplateCode this body)
                                            (when (some? nsElem) (.append body nsElem))
                                            (when (some? nsAttr) (.append body nsAttr))
                                            (.append body ilRecurse)
                                            (.append body ilText)
                                            (.append mainIL body)
                                            (.setEnd current (.getEnd body))
                                            (.append mainIL ilLoop)
                                            (.peepHoleOptimization this methodGen)
                                            (.addMethod classGen methodGen)
                                            (set! _templates oldTemplates))))))))))))))))))))))

  (method ^:private peepHoleOptimization ^void [this ^MethodGenerator methodGen]
    (let [il (.getInstructionList methodGen)
          find (InstructionFinder. il)
          ^:mutable ^InstructionHandle ih nil
          ^:mutable ^String pattern nil]
      (set! pattern "loadinstruction pop")
      (loop [^{:tag (Iterator InstructionHandle/1)} iter (.search find pattern)]
        (when (.hasNext iter)
          (let [match (cast InstructionHandle/1 (.next iter))]
            (try
              (when (and (not (.hasTargeters (aget match 0))) (not (.hasTargeters (aget match 1))))
                (.delete il (aget match 0) (aget match 1)))
              (catch TargetLostException e))
            (recur iter))))
      (set! pattern "iload iload swap istore")
      (loop [^{:tag (Iterator InstructionHandle/1)} iter (.search find pattern)]
        (when (.hasNext iter)
          (let [match (cast InstructionHandle/1 (.next iter))]
            (try
              (let [iload1 (cast ILOAD (.getInstruction (aget match 0)))
                    iload2 (cast ILOAD (.getInstruction (aget match 1)))
                    istore (cast ISTORE (.getInstruction (aget match 3)))]
                (when (and (and (and (and (not (.hasTargeters (aget match 1)))
                                          (not (.hasTargeters (aget match 2))))
                                     (not (.hasTargeters (aget match 3))))
                                (== (.getIndex iload1) (.getIndex iload2)))
                           (== (.getIndex iload2) (.getIndex istore)))
                  (.delete il (aget match 1) (aget match 3))))
              (catch TargetLostException e))
            (recur iter))))
      (set! pattern "loadinstruction loadinstruction swap")
      (loop [^{:tag (Iterator InstructionHandle/1)} iter (.search find pattern)]
        (when (.hasNext iter)
          (let [match (cast InstructionHandle/1 (.next iter))]
            (try
              (when (and (and (not (.hasTargeters (aget match 0)))
                              (not (.hasTargeters (aget match 1))))
                         (not (.hasTargeters (aget match 2))))
                (let [load_m (.getInstruction (aget match 1))]
                  (.insert il (aget match 0) load_m)
                  (.delete il (aget match 1) (aget match 2))))
              (catch TargetLostException e))
            (recur iter))))
      (set! pattern "aload aload")
      (loop [^{:tag (Iterator InstructionHandle/1)} iter (.search find pattern)]
        (when (.hasNext iter)
          (let [match (cast InstructionHandle/1 (.next iter))]
            (try
              (when-not (.hasTargeters (aget match 1))
                (let [aload1 (cast ALOAD (.getInstruction (aget match 0)))
                      aload2 (cast ALOAD (.getInstruction (aget match 1)))]
                  (when (== (.getIndex aload1) (.getIndex aload2))
                    (.insert il (aget match 1) (DUP.))
                    (.delete il (aget match 1)))))
              (catch TargetLostException e))
            (recur iter))))))

  (method ^:public getTemplateInstructionHandle ^InstructionHandle [this ^Template template]
    (cast InstructionHandle (.get _templateIHs template)))

  (method ^:private ^:static isAttributeName ^boolean [^String qname]
    (let [^:final col (unchecked-add-int (.lastIndexOf qname \:) 1)] (== (.charAt qname col) \@)))

  (method ^:private ^:static isNamespaceName ^boolean [^String qname]
    (let [^:final col (.lastIndexOf qname \:)]
      (and (> col -1) (== (.charAt qname (unchecked-subtract-int (.length qname) 1)) \*)))))

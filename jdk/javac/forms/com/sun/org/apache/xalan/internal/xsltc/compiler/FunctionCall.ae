                  (loop [^int i 0]
                    (when (< i (alength paramTypes))
                      (.append buffer (FunctionCall/getSignature (aget paramTypes i)))
                      (recur (unchecked-inc-int i))))
                  (.append buffer \))
                  (.append buffer "V")
                  (set! index (.addMethodref cpg clazz "<init>" (.toString buffer)))
                  (.append il (INVOKESPECIAL. index))
                  (.translateFrom Type/Object
                                  classGen
                                  methodGen
                                  (.getDeclaringClass _chosenConstructor))))))
        :else
          (do
            (when (and isSecureProcessing (not isExtensionFunctionEnabled))
              (.translateUnallowedExtension this cpg il))
            (let [^:final clazz (.getName (.getDeclaringClass _chosenMethod))
                  ^{:tag (array (Class ?))} paramTypes (.getParameterTypes _chosenMethod)]
              (.generateAddReads this classGen methodGen clazz)
              (when (some? _thisArgument) (.translate _thisArgument classGen methodGen))
              (loop [^int i 0]
                (when (< i n)
                  (let [^:final exp (.argument this i)]
                    (.translate exp classGen methodGen)
                    (.startIterator exp classGen methodGen)
                    (.translateTo (.getType exp) classGen methodGen (aget paramTypes i))
                    (recur (unchecked-inc-int i)))))
              (let [^:final buffer (StringBuffer.)]
                (.append buffer \()
                (loop [^int i 0]
                  (when (< i (alength paramTypes))
                    (.append buffer (FunctionCall/getSignature (aget paramTypes i)))
                    (recur (unchecked-inc-int i))))
                (.append buffer \))
                (.append buffer (FunctionCall/getSignature (.getReturnType _chosenMethod)))
                (if (and (some? _thisArgument) (.isInterface _clazz))
                    (do
                      (set! index
                            (.addInterfaceMethodref
                              cpg
                              clazz
                              (.getLocalPart _fname)
                              (.toString buffer)))
                      (.append il (INVOKEINTERFACE. index (unchecked-add-int n 1))))
                    (do
                      (set! index
                            (.addMethodref cpg clazz (.getLocalPart _fname) (.toString buffer)))
                      (.append
                        il
                        ^com.sun.org.apache.bcel.internal.generic.Instruction (if (some?
                                                                                    _thisArgument)
                                                                                  ^InvokeInstruction ^com.sun.org.apache.bcel.internal.generic.Instruction (INVOKEVIRTUAL.
                                                                                                                                                             index)
                                                                                  ^InvokeInstruction ^com.sun.org.apache.bcel.internal.generic.Instruction (INVOKESTATIC.
                                                                                                                                                             index)))))
                (.translateFrom (.-_type this) classGen methodGen (.getReturnType _chosenMethod))))))))

  (method ^:private generateAddReads ^void [this ^ClassGenerator classGen ^MethodGenerator methodGen
                                            ^String clazz]
    (let [^:final cpg (.getConstantPool classGen)
          ^:final il (.getInstructionList methodGen)]
      (.markChunkStart methodGen)
      (let [^:mutable index (.addMethodref cpg
                                           FunctionCall/CLASS_CLASS
                                           FunctionCall/GET_MODULE
                                           FunctionCall/GET_MODULE_SIG)
            index2 (.addMethodref cpg
                                  FunctionCall/CLASS_CLASS
                                  FunctionCall/FOR_NAME
                                  FunctionCall/FOR_NAME_SIG)]
        (.append il (LDC. (.addString cpg (.getClassName classGen))))
        (.append il (INVOKESTATIC. index2))
        (.append il (INVOKEVIRTUAL. index))
        (.append il (LDC. (.addString cpg clazz)))
        (.append il (INVOKESTATIC. index2))
        (.append il (INVOKEVIRTUAL. index))
        (set! index
              (.addMethodref cpg
                             FunctionCall/MODULE_CLASS
                             FunctionCall/ADD_READS
                             FunctionCall/ADD_READS_SIG))
        (.append il (INVOKEVIRTUAL. index))
        (.append il InstructionConst/POP)
        (.markChunkEnd methodGen))))

  (method ^:public toString ^String [this]
    (java-str "funcall(" _fname ", " _arguments \)))

  (method ^:public isStandard ^boolean [this]
    (let [^:final namespace (.getNamespace _fname)]
      (or (nil? namespace) (.equals namespace Constants/EMPTYSTRING))))

  (method ^:public isExtension ^boolean [this]
    (let [^:final namespace (.getNamespace _fname)]
      (and (some? namespace) (.equals namespace EXT_XSLTC))))

  (method ^:private findMethods :throws [TypeCheckError] ^{:tag (List Method)} [this]
    (let [^:mutable ^{:tag (List Method)} result nil
          ^:final namespace (.getNamespace _fname)]
      (when (and (some? _className) (> (.length _className) 0))
        (let [^:final nArgs (.size _arguments)]
          (try
            (when (nil? _clazz)
              (let [^:final isSecureProcessing (.isSecureProcessing (.getXSLTC this))
                    ^:final isExtensionFunctionEnabled (.getFeature
                                                         (.getXSLTC this)
                                                         JdkXmlFeatures$XmlFeature/ENABLE_EXTENSION_FUNCTION)]
                (if isExtensionFunctionEnabled
                    (do
                      (if (.hasExtensionClassLoader (.getXSLTC this))
                          (set! _clazz (.loadExternalFunction (.getXSLTC this) _className))
                          (set! _clazz (ObjectFactory/findProviderClass _className true)))
                      (when (nil? _clazz)
                        (let [^:final msg (ErrorMsg. ErrorMsg/CLASS_NOT_FOUND_ERR _className)]
                          (.reportError (.getParser this) Constants/ERROR msg)
                          (return nil))))
                    (throw (TypeCheckError. ErrorMsg/UNSUPPORTED_EXT_FUNC_ERR _className)))))
            (let [^:final methodName (.getLocalPart _fname)
                  ^:final methods (.getMethods _clazz)]
              (loop [^int i 0]
                (when (< i (alength methods))
                  (let [^:final mods (.getModifiers (aget methods i))]
                    (if (and (and (Modifier/isPublic mods)
                                  (.equals (.getName (aget methods i)) methodName))
                             (== (alength (.getParameterTypes (aget methods i))) nArgs))
                        (do
                          (when (nil? result) (set! result (ArrayList.)))
                          (.add result (aget methods i))
                          (recur (unchecked-inc-int i)))
                        (recur (unchecked-inc-int i)))))))
            (catch ClassNotFoundException e
              (let [^:final msg (ErrorMsg. ErrorMsg/CLASS_NOT_FOUND_ERR _className)]
                (.reportError (.getParser this) Constants/ERROR msg))))))
      result))

  (method ^:private findConstructors ^{:tag (List (Constructor ?))} [this]
    (let [^:mutable ^{:tag (List (Constructor ?))} result nil
          ^:final nArgs (.size _arguments)]
      (try
        (when (nil? _clazz)
          (set! _clazz (ObjectFactory/findProviderClass _className true))
          (when (nil? _clazz)
            (let [^:final msg (ErrorMsg. ErrorMsg/CLASS_NOT_FOUND_ERR _className)]
              (.reportError (.getParser this) Constants/ERROR msg))))
        (let [^:final ^{:tag (array (Constructor ?))} constructors (.getConstructors _clazz)]
          (for-each [^{:tag (Constructor ?)} constructor constructors]
            (let [^:final mods (.getModifiers constructor)]
              (when (and (Modifier/isPublic mods)
                         (== (alength (.getParameterTypes constructor)) nArgs))
                (when (nil? result) (set! result (ArrayList.)))
                (.add result constructor)))))
        (catch ClassNotFoundException e
          (let [^:final msg (ErrorMsg. ErrorMsg/CLASS_NOT_FOUND_ERR _className)]
            (.reportError (.getParser this) Constants/ERROR msg))))
      result))

  (method ^:static ^:final getSignature ^String [^{:tag (Class ?)} clazz]
    (cond
      (.isArray clazz)
        (let [^:final sb (StringBuffer.)
              ^:mutable ^{:tag (Class ?)} cl clazz]
          (while (.isArray cl) (.append sb "[") (set! cl (.getComponentType cl)))
          (.append sb (FunctionCall/getSignature cl))
          (.toString sb))
      (.isPrimitive clazz)
        (cond
          (identical? clazz Integer/TYPE) "I"
          (identical? clazz Byte/TYPE) "B"
          (identical? clazz Long/TYPE) "J"
          (identical? clazz Float/TYPE) "F"
          (identical? clazz Double/TYPE) "D"
          (identical? clazz Short/TYPE) "S"
          (identical? clazz Character/TYPE) "C"
          (identical? clazz Boolean/TYPE) "Z"
          (identical? clazz Void/TYPE) "V"
          :else
            (let [^:final name (.toString clazz)
                  err (ErrorMsg. ErrorMsg/UNKNOWN_SIG_TYPE_ERR name)]
              (throw (Error. (.toString err)))))
      :else (java-str "L" (.replace (.getName clazz) \. \/) \;)))

  (method ^:static ^:final getSignature ^String [^Method meth]
    (let [^:final sb (StringBuffer.)]
      (.append sb \()
      (let [^:final ^{:tag (array (Class ?))} params (.getParameterTypes meth)]
        (loop [^int j 0]
          (when (< j (alength params))
            (.append sb (FunctionCall/getSignature (aget params j)))
            (recur (unchecked-inc-int j))))
        (.toString (.append (.append sb \)) (FunctionCall/getSignature (.getReturnType meth)))))))

  (method ^:static ^:final getSignature ^String [^{:tag (Constructor ?)} cons]
    (let [^:final sb (StringBuffer.)]
      (.append sb \()
      (let [^:final ^{:tag (array (Class ?))} params (.getParameterTypes cons)]
        (loop [^int j 0]
          (when (< j (alength params))
            (.append sb (FunctionCall/getSignature (aget params j)))
            (recur (unchecked-inc-int j))))
        (.toString (.append sb ")V")))))

  (method ^:private getMethodSignature ^String [this ^{:tag (List Type)} argsType]
    (let [^:final buf (StringBuffer. _className)]
      (.append (.append (.append buf \.) (.getLocalPart _fname)) \()
      (let [nArgs (.size argsType)]
        (loop [^int i 0]
          (when (< i nArgs)
            (let [^:final intType (cast Type (.get argsType i))]
              (.append buf (.toString intType))
              (if (< i (unchecked-subtract-int nArgs 1))
                  (do (.append buf ", ") (recur (unchecked-inc-int i)))
                  (recur (unchecked-inc-int i))))))
        (.append buf \))
        (.toString buf))))

  (method ^:protected ^:static replaceDash ^String [^String name]
    (let [dash \-
          ^:final buff (StringBuilder. "")]
      (loop [^int i 0]
        (when (< i (.length name))
          (cond
            (and (> i 0) (== (.charAt name (unchecked-subtract-int i 1)) dash))
              (do
                (.append buff (Character/toUpperCase (.charAt name i)))
                (recur (unchecked-inc-int i)))
            (not (== (.charAt name i) dash))
              (do (.append buff (.charAt name i)) (recur (unchecked-inc-int i)))
            :else (recur (unchecked-inc-int i)))))
      (.toString buff)))

  (method ^:private translateUnallowedExtension ^void [this ^ConstantPoolGen cpg ^InstructionList il]
    (let [index (.addMethodref cpg
                               FunctionCall/BASIS_LIBRARY_CLASS
                               "unallowed_extension_functionF"
                               "(Ljava/lang/String;)V")]
      (.append il (PUSH. cpg (.toString _fname)))
      (.append il (INVOKESTATIC. index)))))

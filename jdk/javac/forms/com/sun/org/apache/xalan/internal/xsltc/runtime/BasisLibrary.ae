        (do
          (set! dom (cast DOM obj))
          (let [iter (.getChildren dom DTMDefaultBase/ROOTNODE)] (.makeNode dom iter)))
      :else
        (let [^:final className (.getName (.getClass obj))]
          (BasisLibrary/runTimeError DATA_CONVERSION_ERR className "org.w3c.dom.Node")
          nil)))

  (method ^:public ^:static referenceToLong ^long [obj]
    (if (instance? Number obj)
        (.longValue (cast Number obj))
        (let [^:final className (.getName (.getClass obj))]
          (BasisLibrary/runTimeError DATA_CONVERSION_ERR className Long/TYPE)
          0)))

  (method ^:public ^:static referenceToDouble ^double [obj]
    (if (instance? Number obj)
        (.doubleValue (cast Number obj))
        (let [^:final className (.getName (.getClass obj))]
          (BasisLibrary/runTimeError DATA_CONVERSION_ERR className Double/TYPE)
          0.0)))

  (method ^:public ^:static referenceToBoolean ^boolean [obj]
    (if (instance? Boolean obj)
        (.booleanValue (cast Boolean obj))
        (let [^:final className (.getName (.getClass obj))]
          (BasisLibrary/runTimeError DATA_CONVERSION_ERR className Boolean/TYPE)
          false)))

  (method ^:public ^:static referenceToString ^String [obj ^DOM dom]
    (cond
      (instance? String obj) (cast String obj)
      (instance? DTMAxisIterator obj)
        (.getStringValueX dom (.next (.reset (cast DTMAxisIterator obj))))
      (instance? Node obj) (.getStringValueX dom (.-node (cast Node obj)))
      (instance? DOM obj) (.getStringValue (cast DOM obj))
      :else
        (let [^:final className (.getName (.getClass obj))]
          (BasisLibrary/runTimeError DATA_CONVERSION_ERR className String)
          nil)))

  (method ^:public ^:static node2Iterator ^DTMAxisIterator [^org.w3c.dom.Node node
                                                            ^Translet translet ^DOM dom]
    (let [^:final inNode node
          ^NodeList nodelist (anon NodeList []
                               (method ^:public getLength ^int [this] 1)

                               (method ^:public item ^org.w3c.dom.Node [this ^int index]
                                 (when (== index 0) inNode)))]
      (BasisLibrary/nodeList2Iterator nodelist translet dom)))

  (method ^:private ^:static nodeList2IteratorUsingHandleFromNode ^DTMAxisIterator [^NodeList nodeList
                                                                                    ^Translet translet
                                                                                    ^DOM dom]
    (let [^:final n (.getLength nodeList)
          ^:final dtmHandles (new int/1 n)
          ^:mutable ^DTMManager dtmManager nil]
      (when (instance? MultiDOM dom) (set! dtmManager (.getDTMManager (cast MultiDOM dom))))
      (loop [^int i 0]
        (when (< i n)
          (let [node (.item nodeList i)
                ^:mutable ^int handle 0]
            (cond
              (some? dtmManager) (set! handle (.getDTMHandleFromNode dtmManager node))
              (and (instance? DTMNodeProxy node)
                   (identical? (.getDTM (cast DTMNodeProxy node)) dom))
                (set! handle (.getDTMNodeNumber (cast DTMNodeProxy node)))
              :else
                (do (BasisLibrary/runTimeError RUN_TIME_INTERNAL_ERR "need MultiDOM") (return nil)))
            (aset dtmHandles i handle)
            (.println System/out (java-str "Node " i " has handle 0x" (Integer/toString handle 16)))
            (recur (unchecked-inc-int i)))))
      (ArrayNodeListIterator. dtmHandles)))

  (method ^:public ^:static nodeList2Iterator ^DTMAxisIterator [^NodeList nodeList
                                                                ^Translet translet ^DOM dom]
    (let [^:mutable ^int n 0
          ^:mutable ^Document doc nil
          ^:mutable ^DTMManager dtmManager nil
          proxyNodes (new int/1 (.getLength nodeList))]
      (when (instance? MultiDOM dom) (set! dtmManager (.getDTMManager (cast MultiDOM dom))))
      (loop [^int i 0]
        (when (< i (.getLength nodeList))
          (let [node (.item nodeList i)]
            (when (instance? DTMNodeProxy node)
              (let [proxy (cast DTMNodeProxy node)
                    nodeDTM (.getDTM proxy)
                    handle (.getDTMNodeNumber proxy)
                    ^:mutable isOurDOM (identical? nodeDTM dom)]
                (when (and (not isOurDOM) (some? dtmManager))
                  (try
                    (set! isOurDOM (identical? nodeDTM (.getDTM dtmManager handle)))
                    (catch ArrayIndexOutOfBoundsException e)))
                (when isOurDOM
                  (aset proxyNodes i handle)
                  (set! n (unchecked-inc-int n))
                  (continue (unchecked-inc-int i)))))
            (aset proxyNodes i DTM/NULL)
            (let [^int nodeType (.getNodeType node)]
              (when (nil? doc)
                (when (= (instance? MultiDOM dom) false)
                  (BasisLibrary/runTimeError RUN_TIME_INTERNAL_ERR "need MultiDOM")
                  (return nil))
                (try
                  (let [at (cast AbstractTranslet translet)]
                    (set! doc (.newDocument at "" "__top__")))
                  (catch ParserConfigurationException e
                    (BasisLibrary/runTimeError RUN_TIME_INTERNAL_ERR (.getMessage e))
                    (return nil))))
              (let [^:mutable ^Element mid nil]
                (switch nodeType
                  (org.w3c.dom.Node/ELEMENT_NODE
                    org.w3c.dom.Node/TEXT_NODE
                    org.w3c.dom.Node/CDATA_SECTION_NODE
                    org.w3c.dom.Node/COMMENT_NODE
                    org.w3c.dom.Node/ENTITY_REFERENCE_NODE
                    org.w3c.dom.Node/PROCESSING_INSTRUCTION_NODE)
                    (do
                      (set! mid (.createElementNS doc nil "__dummy__"))
                      (.appendChild mid (.importNode doc node true))
                      (.appendChild (.getDocumentElement doc) mid)
                      (set! n (unchecked-inc-int n))
                      (recur (unchecked-inc-int i)))
                  org.w3c.dom.Node/ATTRIBUTE_NODE
                    (do
                      (set! mid (.createElementNS doc nil "__dummy__"))
                      (.setAttributeNodeNS mid (cast Attr (.importNode doc node true)))
                      (.appendChild (.getDocumentElement doc) mid)
                      (set! n (unchecked-inc-int n))
                      (recur (unchecked-inc-int i)))
                  (do
                    (BasisLibrary/runTimeError RUN_TIME_INTERNAL_ERR
                                               (java-str
                                                 "Don't know how to convert node type "
                                                 nodeType))
                    (recur (unchecked-inc-int i)))))))))
      (let [^:mutable ^DTMAxisIterator iter nil
            ^:mutable ^DTMAxisIterator childIter nil
            ^:mutable ^DTMAxisIterator attrIter nil]
        (when (some? doc)
          (let [^:final multiDOM (cast MultiDOM dom)
                idom (cast DOM (.getDTM dtmManager (DOMSource. doc) false nil true false))
                domAdapter (DOMAdapter. idom
                                        (.getNamesArray translet)
                                        (.getUrisArray translet)
                                        (.getTypesArray translet)
                                        (.getNamespaceArray translet))]
            (.addDOMAdapter multiDOM domAdapter)
            (let [iter1 (.getAxisIterator idom Axis/CHILD)
                  iter2 (.getAxisIterator idom Axis/CHILD)]
              (set! iter (AbsoluteIterator. (StepIterator. iter1 iter2)))
              (.setStartNode iter DTMDefaultBase/ROOTNODE)
              (set! childIter (.getAxisIterator idom Axis/CHILD))
              (set! attrIter (.getAxisIterator idom Axis/ATTRIBUTE)))))
        (let [dtmHandles (new int/1 n)]
          (set! n 0)
          (loop [^int i 0]
            (if (< i (.getLength nodeList))
                (if (not (== (aget proxyNodes i) DTM/NULL))
                    (do
                      (aset dtmHandles n (aget proxyNodes i))
                      (set! n (unchecked-inc-int n))
                      (recur (unchecked-inc-int i)))
                    (let [node (.item nodeList i)
                          ^:mutable ^DTMAxisIterator iter3 nil
                          ^int nodeType (.getNodeType node)]
                      (switch nodeType
                        (org.w3c.dom.Node/ELEMENT_NODE
                          org.w3c.dom.Node/TEXT_NODE
                          org.w3c.dom.Node/CDATA_SECTION_NODE
                          org.w3c.dom.Node/COMMENT_NODE
                          org.w3c.dom.Node/ENTITY_REFERENCE_NODE
                          org.w3c.dom.Node/PROCESSING_INSTRUCTION_NODE)
                          (set! iter3 childIter)
                        org.w3c.dom.Node/ATTRIBUTE_NODE (set! iter3 attrIter)
                        (throw (InternalRuntimeError. "Mismatched cases")))
                      (if (some? iter3)
                          (do
                            (.setStartNode iter3 (.next iter))
                            (aset dtmHandles n (.next iter3))
                            (when (== (aget dtmHandles n) DTMAxisIterator/END)
                              (throw (InternalRuntimeError.
                                       (java-str "Expected element missing at " i))))
                            (when-not (== (.next iter3) DTMAxisIterator/END)
                              (throw (InternalRuntimeError. (java-str "Too many elements at " i))))
                            (set! n (unchecked-inc-int n))
                            (recur (unchecked-inc-int i)))
                          (recur (unchecked-inc-int i)))))
                nil))
          (when-not (== n (alength dtmHandles))
            (throw (InternalRuntimeError. "Nodes lost in second pass")))
          (ArrayNodeListIterator. dtmHandles)))))

  (method ^:public ^:static referenceToResultTree ^DOM [obj]
    (try
      (cast DOM obj)
      (catch IllegalArgumentException e
        (let [^:final className (.getName (.getClass obj))]
          (BasisLibrary/runTimeError DATA_CONVERSION_ERR "reference" className)
          nil))))

  (method ^:public ^:static getSingleNode ^DTMAxisIterator [^DTMAxisIterator iterator]
    (let [node (.next iterator)] (SingletonIterator. node)))

  (field ^:private ^:static ^char/1 _characterArray (new char/1 32))

  (method ^:public ^:static copy ^void [obj ^SerializationHandler handler ^int node ^DOM dom]
    (try
      (cond
        (instance? DTMAxisIterator obj)
          (let [iter (cast DTMAxisIterator obj)] (.copy dom (.reset iter) handler))
        (instance? Node obj) (.copy dom (.-node (cast Node obj)) handler)
        (instance? DOM obj)
          (let [newDom (cast DOM obj)] (.copy newDom (.getDocument newDom) handler))
        :else
          (let [string (.toString obj)
                ^:final length (.length string)]
            (when (> length (alength _characterArray)) (set! _characterArray (new char/1 length)))
            (.getChars string 0 length _characterArray 0)
            (.characters handler _characterArray 0 length)))
      (catch SAXException e (BasisLibrary/runTimeError RUN_TIME_COPY_ERR))))

  (method ^:public ^:static checkAttribQName ^void [^String name]
    (let [^:final firstOccur (.indexOf name \:)
          ^:final lastOccur (.lastIndexOf name \:)
          ^:final localName (.substring name (unchecked-add-int lastOccur 1))]
      (when (> firstOccur 0)
        (let [^:final newPrefix (.substring name 0 firstOccur)]
          (when-not (== firstOccur lastOccur)
            (let [^:final oriPrefix (.substring name (unchecked-add-int firstOccur 1) lastOccur)]
              (when-not (XML11Char/isXML11ValidNCName oriPrefix)
                (BasisLibrary/runTimeError INVALID_QNAME_ERR (java-str oriPrefix ":" localName)))))
          (when-not (XML11Char/isXML11ValidNCName newPrefix)
            (BasisLibrary/runTimeError INVALID_QNAME_ERR (java-str newPrefix ":" localName)))))
      (when (or (not (XML11Char/isXML11ValidNCName localName))
                (.equals localName Constants/XMLNS_PREFIX))
        (BasisLibrary/runTimeError INVALID_QNAME_ERR localName))))

  (method ^:public ^:static checkNCName ^void [^String name]
    (when-not (XML11Char/isXML11ValidNCName name)
      (BasisLibrary/runTimeError INVALID_NCNAME_ERR name)))

  (method ^:public ^:static checkQName ^void [^String name]
    (when-not (XML11Char/isXML11ValidQName name) (BasisLibrary/runTimeError INVALID_QNAME_ERR name)))

  (method ^:public ^:static startXslElement ^String [^:mutable ^String qname
                                                     ^:mutable ^String namespace
                                                     ^SerializationHandler handler ^DOM dom
                                                     ^int node]
    (try
      (let [^:mutable ^String prefix nil
            ^:final index (.indexOf qname \:)]
        (cond
          (> index 0)
            (do
              (set! prefix (.substring qname 0 index))
              (when (or (nil? namespace) (== (.length namespace) 0))
                (try
                  (set! namespace (.lookupNamespace dom node prefix))
                  (catch RuntimeException e
                    (.flushPending handler)
                    (let [nm (.getNamespaceMappings handler)]
                      (set! namespace (.lookupNamespace nm prefix))
                      (when (nil? namespace)
                        (BasisLibrary/runTimeError NAMESPACE_PREFIX_ERR prefix))))))
              (.startElement handler namespace (.substring qname (unchecked-add-int index 1)) qname)
              (.namespaceAfterStartElement handler prefix namespace))
          (and (some? namespace) (> (.length namespace) 0))
            (do
              (set! prefix (BasisLibrary/generatePrefix))
              (set! qname (java-str prefix \: qname))
              (.startElement handler namespace qname qname)
              (.namespaceAfterStartElement handler prefix namespace))
          :else (.startElement handler nil nil qname)))
      (catch SAXException e (throw (RuntimeException. (.getMessage e)))))
    qname)

  (method ^:public ^:static getPrefix ^String [^String qname]
    (let [^:final index (.indexOf qname \:)] (when (> index 0) (.substring qname 0 index))))

  (method ^:public ^:static generatePrefix ^String []
    (java-str "ns" (.getAndIncrement (cast AtomicInteger (.get threadLocalPrefixIndex)))))

  (method ^:public ^:static resetPrefixIndex ^void []
    (.set (cast AtomicInteger (.get threadLocalPrefixIndex)) 0))

  (field ^:private ^:static ^:final ^{:tag (ThreadLocal AtomicInteger)} threadLocalPrefixIndex
    (anon (ThreadLocal AtomicInteger) []
      (method ^:protected initialValue ^AtomicInteger [this] (AtomicInteger.))))

  (field ^:public ^:static ^:final ^String RUN_TIME_INTERNAL_ERR "RUN_TIME_INTERNAL_ERR")

  (field ^:public ^:static ^:final ^String RUN_TIME_COPY_ERR "RUN_TIME_COPY_ERR")

  (field ^:public ^:static ^:final ^String DATA_CONVERSION_ERR "DATA_CONVERSION_ERR")


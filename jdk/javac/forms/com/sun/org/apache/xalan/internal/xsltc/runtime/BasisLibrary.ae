  (field ^:private ^:static ^ResourceBundle m_bundle)

  (field ^:public ^:static ^:final ^String ERROR_MESSAGES_KEY "error-messages")

  (static-initializer
    (let [resource "com.sun.org.apache.xalan.internal.xsltc.runtime.ErrorMessages"]
      (set! m_bundle (SecuritySupport/getResourceBundle resource))))

  (method ^:public ^:static runTimeError ^void [^String code]
    (throw (RuntimeException. (.getString m_bundle code))))

  (method ^:public ^:static runTimeError ^void [^String code ^Object/1 args]
    (let [^:final message (MessageFormat/format (.getString m_bundle code) args)]
      (throw (RuntimeException. message))))

  (method ^:public ^:static runTimeError ^void [^String code arg0]
    (BasisLibrary/runTimeError code (new Object/1 [arg0])))

  (method ^:public ^:static runTimeError ^void [^String code arg0 arg1]
    (BasisLibrary/runTimeError code (new Object/1 [arg0 arg1])))

  (method ^:public ^:static consoleOutput ^void [^String msg]
    (.println System/out msg))

  (method ^:public ^:static replace ^String [^String base ^char ch ^String str]
    (if (< (.indexOf base ch) 0)
        base
        (BasisLibrary/replace base (String/valueOf ch) (new String/1 [str]))))

  (method ^:public ^:static replace ^String [^String base ^String delim ^String/1 str]
    (let [^:final len (.length base)
          ^:final result (cast StringBuilder (.get threadLocalStringBuilder))]
      (.setLength result 0)
      (loop [^int i 0]
        (when (< i len)
          (let [^:final ch (.charAt base i)
                ^:final k (.indexOf delim ch)]
            (if (>= k 0)
                (do (.append result (aget str k)) (recur (unchecked-inc-int i)))
                (do (.append result ch) (recur (unchecked-inc-int i)))))))
      (.toString result)))

  (method ^:public ^:static mapQNameToJavaName ^String [^String base]
    (BasisLibrary/replace base
                          ".-:/{}?#%*"
                          (new String/1
                               ["$dot$" "$dash$" "$colon$" "$slash$" "" "$colon$" "$ques$" "$hash$"
                                "$per$" "$aster$"])))

  (method ^:public ^:static getStringLength ^int [^String str]
    (.codePointCount str 0 (.length str))))

  (field ^:public ^:static ^:final ^String INVALID_ARGUMENT_ERR "INVALID_ARGUMENT_ERR")

  (field ^:public ^:static ^:final ^String FORMAT_NUMBER_ERR "FORMAT_NUMBER_ERR")

  (field ^:public ^:static ^:final ^String ITERATOR_CLONE_ERR "ITERATOR_CLONE_ERR")

  (field ^:public ^:static ^:final ^String AXIS_SUPPORT_ERR "AXIS_SUPPORT_ERR")

  (field ^:public ^:static ^:final ^String TYPED_AXIS_SUPPORT_ERR "TYPED_AXIS_SUPPORT_ERR")

  (field ^:public ^:static ^:final ^String STRAY_ATTRIBUTE_ERR "STRAY_ATTRIBUTE_ERR")

  (field ^:public ^:static ^:final ^String STRAY_NAMESPACE_ERR "STRAY_NAMESPACE_ERR")

  (field ^:public ^:static ^:final ^String NAMESPACE_PREFIX_ERR "NAMESPACE_PREFIX_ERR")

  (field ^:public ^:static ^:final ^String DOM_ADAPTER_INIT_ERR "DOM_ADAPTER_INIT_ERR")

  (field ^:public ^:static ^:final ^String PARSER_DTD_SUPPORT_ERR "PARSER_DTD_SUPPORT_ERR")

  (field ^:public ^:static ^:final ^String NAMESPACES_SUPPORT_ERR "NAMESPACES_SUPPORT_ERR")

  (field ^:public ^:static ^:final ^String CANT_RESOLVE_RELATIVE_URI_ERR
    "CANT_RESOLVE_RELATIVE_URI_ERR")

  (field ^:public ^:static ^:final ^String UNSUPPORTED_XSL_ERR "UNSUPPORTED_XSL_ERR")

  (field ^:public ^:static ^:final ^String UNSUPPORTED_EXT_ERR "UNSUPPORTED_EXT_ERR")

  (field ^:public ^:static ^:final ^String UNKNOWN_TRANSLET_VERSION_ERR
    "UNKNOWN_TRANSLET_VERSION_ERR")


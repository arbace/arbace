      (when (.isSimpleNamedTemplate foundTemplate) foundTemplate)))

  (method ^:private buildParameterList ^void [this]
    (let [^{:tag (List Param)} defaultParams (.getParameters _calleeTemplate)
          numParams (.size defaultParams)]
      (set! _parameters (new SyntaxTreeNode/1 numParams))

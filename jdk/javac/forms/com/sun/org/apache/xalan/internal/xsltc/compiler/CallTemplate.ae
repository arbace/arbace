              (.translateContents this classGen methodGen))))
      (let [^:final className (.getClassName stylesheet)
            methodName (Util/escape (.toString _name))]
        (.append il (.loadTranslet classGen))
        (.append il (.loadDOM methodGen))
        (.append il (.loadIterator methodGen))
        (.append il (.loadHandler methodGen))
        (.append il (.loadCurrentNode methodGen))
        (let [methodSig (StringBuffer.
                          (java-str (java-str (java-str
                                                (java-str "(" CallTemplate/DOM_INTF_SIG)
                                                CallTemplate/NODE_ITERATOR_SIG)
                                              CallTemplate/TRANSLET_OUTPUT_SIG)

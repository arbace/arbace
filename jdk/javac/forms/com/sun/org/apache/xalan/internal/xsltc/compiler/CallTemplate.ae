  (method ^:public translate ^void [this ^ClassGenerator classGen ^MethodGenerator methodGen]
    (let [^:final stylesheet (.getStylesheet classGen)
          ^:final cpg (.getConstantPool classGen)
          ^:final il (.getInstructionList methodGen)]

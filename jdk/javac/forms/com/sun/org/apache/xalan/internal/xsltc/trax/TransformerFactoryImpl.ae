      (TransformerHandlerImpl. (cast TransformerImpl transformer))))

  (method ^:public newTransformerHandler :throws [TransformerConfigurationException] ^TransformerHandler [this
                                                                                                          ^Templates templates]
    (let [^:final transformer (.newTransformer templates)
          ^:final internal (cast TransformerImpl transformer)]
      (TransformerHandlerImpl. internal)))

  (method ^:public newXMLFilter :throws [TransformerConfigurationException] ^XMLFilter [this
                                                                                        ^Source src]
    (let [templates (.newTemplates this src)]
      (when (some? templates) (.newXMLFilter this templates))))

  (method ^:public newXMLFilter :throws [TransformerConfigurationException] ^XMLFilter [this
                                                                                        ^Templates templates]
    (try
      (TrAXFilter. templates)
      (catch TransformerConfigurationException e1
        (when (some? _errorListener)
          (try
            (.fatalError _errorListener e1)
            (return nil)
            (catch TransformerException e2 (throw (TransformerConfigurationException. e2)))))
        (throw e1))))

  (method ^:public loadSource ^InputSource [this ^String href ^String context ^XSLTC xsltc]
    (try
      (let [^:mutable ^Source source nil]
        (when (some? _uriResolver) (set! source (.resolve _uriResolver href context)))
        (when (and (and (nil? source) (some? _catalogFiles))
                   (.getFeature _xmlFeatures JdkXmlFeatures$XmlFeature/USE_CATALOG))
          (when (nil? _catalogUriResolver)
            (set! _catalogUriResolver
                  (CatalogManager/catalogResolver _catalogFeatures (new URI/1 []))))
          (set! source (.resolve _catalogUriResolver href context)))
        (when (some? source) (return (Util/getInputSource xsltc source))))
      (catch TransformerException e
        (let [^:final msg (ErrorMsg. ErrorMsg/INVALID_URI_ERR
                                     (java-str href "\n" (.getMessage e))
                                     this)]
          (.reportError (.getParser xsltc) Constants/FATAL msg)))
      (catch CatalogException e
        (let [^:final msg (ErrorMsg. ErrorMsg/CATALOG_EXCEPTION
                                     (java-str href "\n" (.getMessage e))
                                     this)]
          (.reportError (.getParser xsltc) Constants/FATAL msg))))
    nil)

  (method ^:private buildCatalogFeatures ^CatalogFeatures [this]
    (when (nil? _catalogFeatures) (set! _catalogFeatures (.build cfBuilder)))
    (set! _catalogFiles (.get _catalogFeatures CatalogFeatures$Feature/FILES))
    (set! _catalogDefer (.get _catalogFeatures CatalogFeatures$Feature/DEFER))
    (set! _catalogPrefer (.get _catalogFeatures CatalogFeatures$Feature/PREFER))
    (set! _catalogResolve (.get _catalogFeatures CatalogFeatures$Feature/RESOLVE))
    _catalogFeatures)

  (method ^:private resetTransientAttributes ^void [this]
    (set! _transletName DEFAULT_TRANSLET_NAME)
    (set! _destinationDirectory nil)
    (set! _packageName DEFAULT_TRANSLATE_PACKAGE)
    (set! _jarFileName nil))

  (method ^:private getBytecodesFromClasses ^byte/2 [this ^Source source ^String fullClassName]
    (when (some? fullClassName)
      (let [xslFileName (.getStylesheetFileName this source)
            ^:mutable ^File xslFile nil]
        (when (some? xslFileName) (set! xslFile (File. xslFileName)))
        (let [^:mutable ^String transletName nil
              lastDotIndex (.lastIndexOf fullClassName \.)]
          (if (> lastDotIndex 0)
              (set! transletName (.substring fullClassName (unchecked-add-int lastDotIndex 1)))
              (set! transletName fullClassName))
          (let [^:mutable transletPath (.replace fullClassName \. \/)]
            (cond
              (some? _destinationDirectory)
                (set! transletPath (java-str _destinationDirectory "/" transletPath ".class"))
              (and (some? xslFile) (some? (.getParent xslFile)))
                (set! transletPath (java-str (.getParent xslFile) "/" transletPath ".class"))
              :else (set! transletPath (java-str transletPath ".class")))
            (let [transletFile (File. transletPath)]
              (when-not (not (.exists transletFile))
                (when (and (some? xslFile) (.exists xslFile))
                  (let [xslTimestamp (.lastModified xslFile)
                        transletTimestamp (.lastModified transletFile)]
                    (when (< transletTimestamp xslTimestamp) (return nil))))
                (let [^{:tag (List byte/1)} bytecodes (ArrayList.)
                      fileLength (unchecked-int (.length transletFile))]
                  (when (> fileLength 0)
                    (let [^:mutable ^FileInputStream input nil]
                      (try
                        (set! input (FileInputStream. transletFile))
                        (catch FileNotFoundException e (return nil)))
                      (let [bytes (new byte/1 fileLength)]
                        (try
                          (.readFromInputStream this bytes input fileLength)
                          (.close input)
                          (catch IOException e (return nil)))
                        (.add bytecodes bytes)))
                    (let [^:mutable transletParentDir (.getParent transletFile)]
                      (when (nil? transletParentDir)
                        (set! transletParentDir (System/getProperty "user.dir")))
                      (let [transletParentFile (File. transletParentDir)
                            ^:final transletAuxPrefix (java-str transletName "$")
                            auxfiles (.listFiles
                                       transletParentFile
                                       (anon FilenameFilter []
                                         (method ^:public accept ^boolean [this ^File dir
                                                                           ^String name]
                                           (and (.endsWith name ".class")
                                                (.startsWith name transletAuxPrefix)))))]
                        (loop [^int i 0]
                          (when (< i (alength auxfiles))
                            (let [auxfile (aget auxfiles i)
                                  auxlength (unchecked-int (.length auxfile))]
                              (if (> auxlength 0)
                                  (let [^:mutable ^FileInputStream auxinput nil]
                                    (try
                                      (set! auxinput (FileInputStream. auxfile))
                                      (catch FileNotFoundException e
                                        (continue (unchecked-inc-int i))))
                                    (let [bytes (new byte/1 auxlength)]
                                      (try
                                        (.readFromInputStream this bytes auxinput auxlength)
                                        (.close auxinput)
                                        (catch IOException e (continue (unchecked-inc-int i))))
                                      (.add bytecodes bytes)
                                      (recur (unchecked-inc-int i))))
                                  (recur (unchecked-inc-int i))))))
                        (let [^:final count (.size bytecodes)]
                          (when (> count 0)
                            (let [^:final result (new byte/2 count 1)]
                              (loop [^int i 0]
                                (when (< i count)
                                  (aset result i (cast byte/1 (.get bytecodes i)))
                                  (recur (unchecked-inc-int i))))
                              result))))))))))))))

  (method ^:private getBytecodesFromJar ^byte/2 [this ^Source source ^String fullClassName]
    (let [xslFileName (.getStylesheetFileName this source)
          ^:mutable ^File xslFile nil]
      (when (some? xslFileName) (set! xslFile (File. xslFileName)))
      (let [^:mutable ^String jarPath nil]
        (cond
          (some? _destinationDirectory)
            (set! jarPath (java-str _destinationDirectory "/" _jarFileName))
          (and (some? xslFile) (some? (.getParent xslFile)))
            (set! jarPath (java-str (.getParent xslFile) "/" _jarFileName))
          :else (set! jarPath _jarFileName))
        (let [file (File. jarPath)]
          (when-not (not (.exists file))
            (when (and (some? xslFile) (.exists xslFile))
              (let [xslTimestamp (.lastModified xslFile)
                    transletTimestamp (.lastModified file)]
                (when (< transletTimestamp xslTimestamp) (return nil))))
            (let [^:mutable ^ZipFile jarFile nil]
              (try (set! jarFile (ZipFile. file)) (catch IOException e (return nil)))
              (let [transletPath (.replace fullClassName \. \/)
                    transletAuxPrefix (java-str transletPath "$")
                    transletFullName (java-str transletPath ".class")
                    ^{:tag (List byte/1)} bytecodes (ArrayList.)
                    ^{:tag (Enumeration (? extends ZipEntry))} entries (.entries jarFile)]
                (while (.hasMoreElements entries)
                  (let [entry (cast ZipEntry (.nextElement entries))
                        entryName (.getName entry)]
                    (when (and (> (.getSize entry) 0)
                               (or (.equals entryName transletFullName)
                                   (and (.endsWith entryName ".class")
                                        (.startsWith entryName transletAuxPrefix))))
                      (try
                        (let [input (.getInputStream jarFile entry)
                              size (unchecked-int (.getSize entry))
                              bytes (new byte/1 size)]
                          (.readFromInputStream this bytes input size)
                          (.close input)
                          (.add bytecodes bytes))
                        (catch IOException e (return nil))))))
                (let [^:final count (.size bytecodes)]
                  (when (> count 0)
                    (let [^:final result (new byte/2 count 1)]
                      (loop [^int i 0]
                        (when (< i count)
                          (aset result i (cast byte/1 (.get bytecodes i)))
                          (recur (unchecked-inc-int i))))
                      result))))))))))

  (method ^:private readFromInputStream :throws [IOException] ^void [this ^byte/1 bytes
                                                                     ^InputStream input ^int size]
    (let [^:mutable ^int n 0
          ^:mutable ^int offset 0
          ^:mutable length size]
      (while (and (> length 0) (> (set! n (.read input bytes offset length)) 0))
        (set! offset (unchecked-add-int offset n))
        (set! length (unchecked-subtract-int length n)))))

  (method ^:private getTransletBaseName ^String [this ^Source source]
    (let [^:mutable ^String transletBaseName nil]
      (if (not (.equals _transletName DEFAULT_TRANSLET_NAME))
          _transletName
          (do
            (let [systemId (.getSystemId source)]
              (when (some? systemId)
                (let [^:mutable baseName (Util/baseName systemId)]
                  (when (some? baseName)
                    (set! baseName (Util/noExtName baseName))
                    (set! transletBaseName (Util/toJavaName baseName))))))
            (if (some? transletBaseName) transletBaseName DEFAULT_TRANSLET_NAME)))))

  (method ^:private getStylesheetFileName ^String [this ^Source source]
    (let [systemId (.getSystemId source)]
      (when (some? systemId)
        (let [file (File. systemId)]
          (if (.exists file)
              systemId
              (let [^:mutable ^URL url nil]
                (try
                  (let [_unused (set! url (URL. systemId))] nil)
                  (catch MalformedURLException e (return nil)))
                (when (.equals "file" (.getProtocol url)) (.getFile url))))))))

  (method ^:protected ^:final createNewDTMManagerInstance ^XSLTCDTMManager [this]
    (XSLTCDTMManager/createNewDTMManagerInstance)))

        (when (or (some? doctypePublic) (some? doctypeSystem))
          (.setDoctype handler doctypeSystem doctypePublic))
        (when (.equals (cast String (.getValue _xsltcIsStandalone)) "yes")
          (.setIsStandalone handler true)))))

  (method ^:private createOutputProperties ^Properties [this ^Properties outputProperties]
    (let [^:final defaults (Properties.)]
      (.setDefaults this defaults "xml")
      (let [^:final base (Properties. defaults)]
        (if (some? outputProperties)

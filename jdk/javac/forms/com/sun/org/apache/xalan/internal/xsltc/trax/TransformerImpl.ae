  (method ^:private transferOutputProperties ^void [this ^AbstractTranslet translet]
    (when (some? _properties)
      (let [^{:tag (Enumeration ?)} names (.propertyNames _properties)]
        (while (.hasMoreElements names)
          (let [name (cast String (.nextElement names))
                value (cast String (.get _properties name))]
            (when (some? value)
              (cond
                (.equals name OutputKeys/ENCODING) (set! (.-_encoding translet) value)
                (.equals name OutputKeys/METHOD) (set! (.-_method translet) value)
                (.equals name OutputKeys/DOCTYPE_PUBLIC) (set! (.-_doctypePublic translet) value)
                (.equals name OutputKeys/DOCTYPE_SYSTEM) (set! (.-_doctypeSystem translet) value)
                (.equals name OutputKeys/MEDIA_TYPE) (set! (.-_mediaType translet) value)
                (.equals name OutputKeys/STANDALONE) (set! (.-_standalone translet) value)
                (.equals name OutputKeys/VERSION) (set! (.-_version translet) value)
                (.equals name OutputKeys/OMIT_XML_DECLARATION)
                  (set! (.-_omitHeader translet)
                        (and (some? value) (.equals (.toLowerCase value) "yes")))
                (.equals name OutputKeys/INDENT)
                  (set! (.-_indent translet)
                        (and (some? value) (.equals (.toLowerCase value) "yes")))
                (.equals name
                         (java-str OutputPropertiesFactory/S_BUILTIN_OLD_EXTENSIONS_UNIVERSAL
                                   "indent-amount"))
                  (when (some? value) (set! (.-_indentamount translet) (Integer/parseInt value)))
                (.equals name
                         (java-str OutputPropertiesFactory/S_BUILTIN_EXTENSIONS_UNIVERSAL
                                   "indent-amount"))
                  (when (some? value) (set! (.-_indentamount translet) (Integer/parseInt value)))
                (.equals name OutputKeys/CDATA_SECTION_ELEMENTS)
                  (when (some? value)
                    (set! (.-_cdata translet) nil)
                    (let [e (StringTokenizer. value)]
                      (while (.hasMoreTokens e) (.addCdataElement translet (.nextToken e)))))))))
        (when (.equals (cast String (.getValue _xsltcIsStandalone)) "yes")
          (set! (.-_isStandalone translet) true)))))

  (method ^:public transferOutputProperties ^void [this ^SerializationHandler handler]
    (when (some? _properties)
      (let [^:mutable ^String doctypePublic nil
            ^:mutable ^String doctypeSystem nil
            ^{:tag (Enumeration ?)} names (.propertyNames _properties)]
        (while (.hasMoreElements names)
          (let [name (cast String (.nextElement names))
                value (cast String (.get _properties name))]
            (when (some? value)
              (cond
                (.equals name OutputKeys/DOCTYPE_PUBLIC) (set! doctypePublic value)
                (.equals name OutputKeys/DOCTYPE_SYSTEM) (set! doctypeSystem value)
                (.equals name OutputKeys/MEDIA_TYPE) (.setMediaType handler value)
                (.equals name OutputKeys/STANDALONE) (.setStandalone handler value)
                (.equals name OutputKeys/VERSION) (.setVersion handler value)
                (.equals name OutputKeys/OMIT_XML_DECLARATION)
                  (.setOmitXMLDeclaration handler
                                          (and (some? value) (.equals (.toLowerCase value) "yes")))
                (.equals name OutputKeys/INDENT)
                  (.setIndent handler (and (some? value) (.equals (.toLowerCase value) "yes")))
                (.equals name
                         (java-str OutputPropertiesFactory/S_BUILTIN_OLD_EXTENSIONS_UNIVERSAL
                                   "indent-amount"))
                  (when (some? value) (.setIndentAmount handler (Integer/parseInt value)))
                (.equals name
                         (java-str OutputPropertiesFactory/S_BUILTIN_EXTENSIONS_UNIVERSAL
                                   "indent-amount"))
                  (when (some? value) (.setIndentAmount handler (Integer/parseInt value)))
                (.equals name OutputKeys/CDATA_SECTION_ELEMENTS)
                  (when (some? value)
                    (let [e (StringTokenizer. value)
                          ^:mutable ^{:tag (List String)} uriAndLocalNames nil]
                      (while (.hasMoreTokens e)
                        (let [^:final token (.nextToken e)
                              lastcolon (.lastIndexOf token \:)
                              ^:mutable ^String uri nil
                              ^:mutable ^String localName nil]

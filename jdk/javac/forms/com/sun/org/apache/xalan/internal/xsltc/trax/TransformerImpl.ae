              (.setProperty base OutputKeys/ENCODING (.-_encoding _translet))
              (when (some? (.-_method _translet))
                (.setProperty base OutputKeys/METHOD (.-_method _translet)))))
        (let [^:final method (.getProperty base OutputKeys/METHOD)]
          (when (some? method)
            (cond
              (.equals method "html") (.setDefaults this defaults "html")
              (.equals method "text") (.setDefaults this defaults "text")))
          base))))

  (method ^:private setDefaults ^void [this ^Properties props ^String method]
    (let [^:final method_props (OutputPropertiesFactory/getDefaultMethodProperties method)
          ^:final ^{:tag (Enumeration ?)} names (.propertyNames method_props)]
      (while (.hasMoreElements names)
        (let [^:final name (cast String (.nextElement names))]
          (.setProperty props name (.getProperty method_props name))))))

  (method ^:private validOutputProperty ^boolean [this ^String name]
    (or (or (or (or (or (or (or (or (or (or (or (.equals name OutputKeys/ENCODING)
                                                (.equals name OutputKeys/METHOD))
                                            (.equals name OutputKeys/INDENT))
                                        (.equals name OutputKeys/DOCTYPE_PUBLIC))
                                    (.equals name OutputKeys/DOCTYPE_SYSTEM))
                                (.equals name OutputKeys/CDATA_SECTION_ELEMENTS))
                            (.equals name OutputKeys/MEDIA_TYPE))
                        (.equals name OutputKeys/OMIT_XML_DECLARATION))
                    (.equals name OutputKeys/STANDALONE))
                (.equals name OutputKeys/VERSION))
            (.is JdkProperty$ImplPropMap/XSLTCISSTANDALONE name))
        (== (.charAt name 0) \{)))

  (method ^:private isDefaultProperty ^boolean [this ^String name ^Properties properties]
    (nil? (.get properties name)))

  (method ^:public setParameter ^void [this ^String name value]
    (when (nil? value)
      (let [err (ErrorMsg. ErrorMsg/JAXP_INVALID_SET_PARAM_VALUE name)]
        (throw (IllegalArgumentException. (.toString err)))))
    (if _isIdentity
        (do (when (nil? _parameters) (set! _parameters (HashMap.))) (.put _parameters name value))
        (.addParameter _translet name value)))

  (method ^:public clearParameters ^void [this]
    (if (and _isIdentity (some? _parameters)) (.clear _parameters) (.clearParameters _translet)))

  (method ^:public ^:final getParameter [this ^String name]
    (if _isIdentity
        (when (some? _parameters) (.get _parameters name))
        (.getParameter _translet name)))

  (method ^:public getURIResolver ^URIResolver [this] _uriResolver)

  (method ^:public setURIResolver ^void [this ^URIResolver resolver]
    (set! _uriResolver resolver))

  (method ^:public retrieveDocument ^DOM [this ^String baseURI ^:mutable ^String href
                                          ^Translet translet]
    (try
      (when (== (.length href) 0) (set! href baseURI))
      (let [^:mutable ^Source resolvedSource nil]
        (when (some? _uriResolver) (set! resolvedSource (.resolve _uriResolver href baseURI)))
        (when (and (and (nil? resolvedSource) _useCatalog)
                   (some? (.get _catalogFeatures CatalogFeatures$Feature/FILES)))
          (when (nil? _catalogUriResolver)
            (set! _catalogUriResolver
                  (CatalogManager/catalogResolver _catalogFeatures (new URI/1 []))))
          (set! resolvedSource (.resolve _catalogUriResolver href baseURI)))
        (if (nil? resolvedSource)
            (let [t (cast AbstractTranslet translet)
                  systemId (SystemIDResolver/getAbsoluteURI href baseURI)
                  ^:mutable ^String errMsg nil]
              (try
                (let [accessError (SecuritySupport/checkAccess
                                    systemId
                                    (.getAllowedProtocols t)
                                    JdkConstants/ACCESS_EXTERNAL_ALL)]
                  (when (some? accessError)
                    (let [msg (ErrorMsg. ErrorMsg/ACCESSING_XSLT_TARGET_ERR
                                         (SecuritySupport/sanitizePath href)
                                         accessError)]
                      (set! errMsg (.toString msg)))))
                (catch IOException ioe (set! errMsg (.getMessage ioe))))
              (if (some? errMsg)
                  (do (.setAccessError t errMsg) nil)
                  (let [streamSource (StreamSource. systemId)] (.getDOM this streamSource))))
            (.getDOM this resolvedSource)))
      (catch [TransformerException CatalogException] e
        (when (some? _errorListener)
          (.postErrorToListener this (java-str "File not found: " (.getMessage e))))
        nil)))

  (method ^:public reset ^void [this]
    (set! _method nil)
    (set! _encoding nil)
    (set! _sourceSystemId nil)
    (set! _errorListener _defaultListener)
    (set! _uriResolver nil)
    (set! _dom nil)
    (set! _parameters nil)
    (set! _indentNumber -1)
    (.setOutputProperties this nil)
    (set! _tohFactory nil)
    (set! _ostream nil)))

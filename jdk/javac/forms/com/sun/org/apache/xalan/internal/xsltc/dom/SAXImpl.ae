      Axis/SELF (return (DTMDefaultBaseIterators$SingletonIterator.))
      Axis/CHILD (return (SAX2DTM2$ChildrenIterator.))
      Axis/PARENT (return (SAX2DTM2$ParentIterator.))
      Axis/ANCESTOR (return (SAX2DTM2$AncestorIterator.))
      Axis/ANCESTORORSELF (return (.includeSelf (SAX2DTM2$AncestorIterator.)))
      Axis/ATTRIBUTE (return (SAX2DTM2$AttributeIterator.))
      Axis/DESCENDANT (return (SAX2DTM2$DescendantIterator.))
      Axis/DESCENDANTORSELF (return (.includeSelf (SAX2DTM2$DescendantIterator.)))
      Axis/FOLLOWING (return (SAX2DTM2$FollowingIterator.))
      Axis/PRECEDING (return (SAX2DTM2$PrecedingIterator.))
      Axis/FOLLOWINGSIBLING (return (SAX2DTM2$FollowingSiblingIterator.))
      Axis/PRECEDINGSIBLING (return (SAX2DTM2$PrecedingSiblingIterator.))
      Axis/NAMESPACE (return (DTMDefaultBaseIterators$NamespaceIterator.))
      Axis/ROOT (return (DTMDefaultBaseIterators$RootIterator.))
      (BasisLibrary/runTimeError BasisLibrary/AXIS_SUPPORT_ERR (Axis/getNames axis)))
    nil)

  (method ^:public getTypedAxisIterator ^DTMAxisIterator [this ^int axis ^int type]
    (cond
      (== axis Axis/CHILD) (SAX2DTM2$TypedChildrenIterator. type)
      (== type SAXImpl/NO_TYPE) EMPTYITERATOR
      :else
        (do
          (switch axis
            Axis/SELF (return (SAX2DTM2$TypedSingletonIterator. type))
            Axis/CHILD (return (SAX2DTM2$TypedChildrenIterator. type))
            Axis/PARENT (return (.setNodeType (SAX2DTM2$ParentIterator.) type))
            Axis/ANCESTOR (return (SAX2DTM2$TypedAncestorIterator. type))
            Axis/ANCESTORORSELF (return (.includeSelf (SAX2DTM2$TypedAncestorIterator. type)))
            Axis/ATTRIBUTE (return (SAX2DTM2$TypedAttributeIterator. type))
            Axis/DESCENDANT (return (SAX2DTM2$TypedDescendantIterator. type))
            Axis/DESCENDANTORSELF (return (.includeSelf (SAX2DTM2$TypedDescendantIterator. type)))
            Axis/FOLLOWING (return (SAX2DTM2$TypedFollowingIterator. type))
            Axis/PRECEDING (return (SAX2DTM2$TypedPrecedingIterator. type))
            Axis/FOLLOWINGSIBLING (return (SAX2DTM2$TypedFollowingSiblingIterator. type))
            Axis/PRECEDINGSIBLING (return (SAX2DTM2$TypedPrecedingSiblingIterator. type))
            Axis/NAMESPACE (return (TypedNamespaceIterator. type))
            Axis/ROOT (return (SAX2DTM2$TypedRootIterator. type))
            (BasisLibrary/runTimeError BasisLibrary/TYPED_AXIS_SUPPORT_ERR (Axis/getNames axis)))
          nil)))

  (method ^:public getNamespaceAxisIterator ^DTMAxisIterator [this ^int axis ^int ns]
    (if (== ns SAXImpl/NO_TYPE)
        EMPTYITERATOR
        (switch axis
          Axis/CHILD (NamespaceChildrenIterator. ns)
          Axis/ATTRIBUTE (NamespaceAttributeIterator. ns)
          (NamespaceWildcardIterator. axis ns))))

  (defclass ^:public ^:final NamespaceWildcardIterator
    :extends DTMDefaultBaseIterators$InternalAxisIteratorBase

    (field ^:protected ^int m_nsType)

    (field ^:protected ^DTMAxisIterator m_baseIterator)

    (constructor ^:public [this ^int axis ^int nsType]
      (set! m_nsType nsType)
      (switch axis
        Axis/ATTRIBUTE (set! m_baseIterator (.getAxisIterator SAXImpl/this axis))
        Axis/NAMESPACE (set! m_baseIterator (.getAxisIterator SAXImpl/this axis))
        (set! m_baseIterator (.getTypedAxisIterator SAXImpl/this axis DTM/ELEMENT_NODE))))

    (method ^:public setStartNode ^DTMAxisIterator [this ^int node]
      (when (.-_isRestartable this)
        (set! (.-_startNode this) node)
        (.setStartNode m_baseIterator node)
        (.resetPosition this))
      this)

    (method ^:public next ^int [this]
      (let [^:mutable ^int node 0]
        (while (not (== (set! node (.next m_baseIterator)) NamespaceWildcardIterator/END))
          (when (== (.getNSType SAXImpl/this node) m_nsType) (return (.returnNode this node))))
        NamespaceWildcardIterator/END))

    (method ^:public cloneIterator ^DTMAxisIterator [this]
      (try
        (let [nestedClone (.cloneIterator m_baseIterator)
              clone (cast NamespaceWildcardIterator (.clone super))]
          (set! (.-m_baseIterator clone) nestedClone)
          (set! (.-m_nsType clone) m_nsType)
          (set! (.-_isRestartable clone) false)
          clone)
        (catch CloneNotSupportedException e
          (BasisLibrary/runTimeError BasisLibrary/ITERATOR_CLONE_ERR (.toString e))
          nil)))

    (method ^:public isReverse ^boolean [this] (.isReverse m_baseIterator))

    (method ^:public setMark ^void [this] (.setMark m_baseIterator))

    (method ^:public gotoMark ^void [this] (.gotoMark m_baseIterator)))

  (defclass ^:public ^:final NamespaceChildrenIterator
    :extends DTMDefaultBaseIterators$InternalAxisIteratorBase

    (field ^:private ^:final ^int _nsType)

    (constructor ^:public [this ^:final ^int type] (set! _nsType type))

    (method ^:public setStartNode ^DTMAxisIterator [this ^:mutable ^int node]
      (when (== node DTMDefaultBase/ROOTNODE) (set! node (.getDocument SAXImpl/this)))
      (if (.-_isRestartable this)
          (do
            (set! (.-_startNode this) node)
            (set! (.-_currentNode this)
                  (if (== node DTM/NULL) DTM/NULL DTMDefaultBase/NOTPROCESSED))
            (.resetPosition this))
          this))

    (method ^:public next ^int [this]
      (when-not (== (.-_currentNode this) DTM/NULL)
        (loop [^int node (if (== DTMDefaultBase/NOTPROCESSED (.-_currentNode this))
                             (._firstch SAXImpl/this
                                        (.makeNodeIdentity SAXImpl/this (.-_startNode this)))
                             (._nextsib SAXImpl/this (.-_currentNode this)))]
          (when-not (== node NamespaceChildrenIterator/END)
            (let [nodeHandle (.makeNodeHandle SAXImpl/this node)]
              (if (== (.getNSType SAXImpl/this nodeHandle) _nsType)
                  (do (set! (.-_currentNode this) node) (return (.returnNode this nodeHandle)))
                  (recur (._nextsib SAXImpl/this node)))))))
      NamespaceChildrenIterator/END))

  (defclass ^:public ^:final NamespaceAttributeIterator
    :extends DTMDefaultBaseIterators$InternalAxisIteratorBase

    (field ^:private ^:final ^int _nsType)

    (constructor ^:public [this ^int nsType] (super.) (set! _nsType nsType))

    (method ^:public setStartNode ^DTMAxisIterator [this ^:mutable ^int node]
      (when (== node DTMDefaultBase/ROOTNODE) (set! node (.getDocument SAXImpl/this)))
      (if (.-_isRestartable this)
          (let [nsType _nsType]
            (set! (.-_startNode this) node)
            (set! node (.getFirstAttribute SAXImpl/this node))
            (while (not (== node NamespaceAttributeIterator/END))
              (when (== (.getNSType SAXImpl/this node) nsType) (break))
              (set! node (.getNextAttribute SAXImpl/this node)))
            (set! (.-_currentNode this) node)
            (.resetPosition this))
          this))

    (method ^:public next ^int [this]
      (let [node (.-_currentNode this)
            nsType _nsType
            ^:mutable ^int nextNode 0]
        (if (== node NamespaceAttributeIterator/END)
            NamespaceAttributeIterator/END
            (do
              (set! nextNode (.getNextAttribute SAXImpl/this node))
              (while (not (== nextNode NamespaceAttributeIterator/END))
                (when (== (.getNSType SAXImpl/this nextNode) nsType) (break))
                (set! nextNode (.getNextAttribute SAXImpl/this nextNode)))
              (set! (.-_currentNode this) nextNode)
              (.returnNode this node))))))

  (method ^:public getTypedDescendantIterator ^DTMAxisIterator [this ^int type]
    (SAX2DTM2$TypedDescendantIterator. type))

  (method ^:public getNthDescendant ^DTMAxisIterator [this ^int type ^int n ^boolean includeself]
    (DTMDefaultBaseIterators$NthDescendantIterator. n))

  (method ^:public characters :throws [TransletException] ^void [this ^:final ^int node
                                                                 ^SerializationHandler handler]
    (when-not (== node DTM/NULL)
      (try
        (.dispatchCharactersEvents this node handler false)
        (catch SAXException e (throw (TransletException. e))))))

  (method ^:public copy :throws [TransletException] ^void [this ^DTMAxisIterator nodes
                                                           ^SerializationHandler handler]
    (let [^:mutable ^int node 0]
      (while (not (== (set! node (.next nodes)) DTM/NULL)) (.copy this node handler))))

  (method ^:public copy :throws [TransletException] ^void [this ^SerializationHandler handler]
    (.copy this (.getDocument this) handler))

  (method ^:public copy :throws [TransletException] ^void [this ^:final ^int node
                                                           ^SerializationHandler handler]
    (.copy this node handler false))

  (method ^:private ^:final copy :throws [TransletException] ^void [this ^:final ^int node
                                                                    ^SerializationHandler handler
                                                                    ^boolean isChild]
    (let [nodeID (.makeNodeIdentity this node)
          eType (._exptype2 this nodeID)
          type (._exptype2Type this eType)]
      (try
        (switch type
          (DTM/ROOT_NODE DTM/DOCUMENT_NODE)
            (loop [^int c (._firstch2 this nodeID)]
              (when-not (== c DTM/NULL)
                (.copy this (.makeNodeHandle this c) handler true)
                (recur (._nextsib2 this c))))
          DTM/PROCESSING_INSTRUCTION_NODE (.copyPI this node handler)
          DTM/COMMENT_NODE (.comment handler (.getStringValueX this node))
          DTM/TEXT_NODE
            (let [^:mutable oldEscapeSetting false
                  ^:mutable escapeBit false]
              (when (some? _dontEscape)
                (set! escapeBit (.getBit _dontEscape (.getNodeIdent this node)))
                (when escapeBit (set! oldEscapeSetting (.setEscaping handler false))))
              (.copyTextNode this nodeID handler)
              (when escapeBit (.setEscaping handler oldEscapeSetting)))
          DTM/ATTRIBUTE_NODE (.copyAttribute this nodeID eType handler)
          DTM/NAMESPACE_NODE
            (.namespaceAfterStartElement handler
                                         (.getNodeNameX this node)
                                         (.getNodeValue this node))
          (if (== type DTM/ELEMENT_NODE)
              (let [^:final name (.copyElement this nodeID eType handler)]
                (.copyNS this nodeID handler (not isChild))
                (.copyAttributes this nodeID handler)
                (loop [^int c (._firstch2 this nodeID)]
                  (when-not (== c DTM/NULL)
                    (.copy this (.makeNodeHandle this c) handler true)
                    (recur (._nextsib2 this c))))
                (.endElement handler name))
              (let [^:final uri (.getNamespaceName this node)]
                (when-not (== (.length uri) 0)
                  (let [^:final prefix (.getPrefix this node)]
                    (.namespaceAfterStartElement handler prefix uri)))
                (.addAttribute handler (.getNodeName this node) (.getNodeValue this node)))))
        (catch Exception e (throw (TransletException. e))))))

  (method ^:private copyPI :throws [TransletException] ^void [this ^:final ^int node
                                                              ^SerializationHandler handler]
    (let [^:final target (.getNodeName this node)
          ^:final value (.getStringValueX this node)]
      (try
        (.processingInstruction handler target value)
        (catch Exception e (throw (TransletException. e))))))

  (method ^:public shallowCopy :throws [TransletException] ^String [this ^:final ^int node
                                                                    ^SerializationHandler handler]
    (let [nodeID (.makeNodeIdentity this node)
          exptype (._exptype2 this nodeID)
          type (._exptype2Type this exptype)]
      (try
        (switch type
          DTM/ELEMENT_NODE
            (let [^:final name (.copyElement this nodeID exptype handler)]
              (.copyNS this nodeID handler true)
              name)
          (DTM/ROOT_NODE DTM/DOCUMENT_NODE) EMPTYSTRING
          DTM/TEXT_NODE (do (.copyTextNode this nodeID handler) nil)
          DTM/PROCESSING_INSTRUCTION_NODE (do (.copyPI this node handler) nil)
          DTM/COMMENT_NODE (do (.comment handler (.getStringValueX this node)) nil)
          DTM/NAMESPACE_NODE
            (do
              (.namespaceAfterStartElement handler
                                           (.getNodeNameX this node)
                                           (.getNodeValue this node))
              nil)
          DTM/ATTRIBUTE_NODE (do (.copyAttribute this nodeID exptype handler) nil)
          (let [^:final uri1 (.getNamespaceName this node)]
            (when-not (== (.length uri1) 0)
              (let [^:final prefix (.getPrefix this node)]
                (.namespaceAfterStartElement handler prefix uri1)))
            (.addAttribute handler (.getNodeName this node) (.getNodeValue this node))
            nil))
        (catch Exception e (throw (TransletException. e))))))

  (method ^:public getLanguage ^String [this ^int node]
    (let [^:mutable parent node]
      (while (not (== DTM/NULL parent))
        (when (== DTM/ELEMENT_NODE (.getNodeType this parent))
          (let [langAttr (.getAttributeNode this
                                            parent
                                            "http://www.w3.org/XML/1998/namespace"
                                            "lang")]
            (when-not (== DTM/NULL langAttr) (return (.getNodeValue this langAttr)))))
        (set! parent (.getParent this parent)))
      nil))

  (method ^:public getBuilder ^DOMBuilder [this] this)

  (method ^:public getOutputDomBuilder ^SerializationHandler [this]
    (ToXMLSAXHandler. this "UTF-8"))

  (method ^:public getResultTreeFrag ^DOM [this ^int initSize ^int rtfType]
    (.getResultTreeFrag this initSize rtfType true))

  (method ^:public getResultTreeFrag ^DOM [this ^int initSize ^int rtfType ^boolean addToManager]
    (cond
      (== rtfType DOM/SIMPLE_RTF)
        (if addToManager
            (let [dtmPos (.getFirstFreeDTMID _dtmManager)
                  rtf (SimpleResultTreeImpl. _dtmManager
                                             (bit-shift-left-int
                                               dtmPos
                                               DTMManager/IDENT_DTM_NODE_BITS))]
              (.addDTM _dtmManager rtf dtmPos 0)
              rtf)
            (SimpleResultTreeImpl. _dtmManager 0))
      (== rtfType DOM/ADAPTIVE_RTF)
        (if addToManager
            (let [dtmPos (.getFirstFreeDTMID _dtmManager)
                  rtf (AdaptiveResultTreeImpl. _dtmManager
                                               (bit-shift-left-int
                                                 dtmPos
                                                 DTMManager/IDENT_DTM_NODE_BITS)
                                               (.-m_wsfilter this)
                                               initSize
                                               (.-m_buildIdIndex this))]
              (.addDTM _dtmManager rtf dtmPos 0)
              rtf)
            (AdaptiveResultTreeImpl. _dtmManager
                                     0
                                     (.-m_wsfilter this)
                                     initSize
                                     (.-m_buildIdIndex this)))
      :else
        (cast DOM
              (.getDTM _dtmManager
                       nil
                       true
                       (.-m_wsfilter this)
                       true
                       false
                       false
                       initSize
                       (.-m_buildIdIndex this)))))

  (method ^:public getElementsWithIDs ^{:tag (Map String Integer)} [this]
    (.-m_idAttributes this))

  (method ^:public getUnparsedEntityURI ^String [this ^String name]
    (if (some? _document)
        (let [^:mutable uri ""
              doctype (.getDoctype _document)]
          (when (some? doctype)
            (let [entities (.getEntities doctype)]
              (when (nil? entities) (return uri))
              (let [entity (cast Entity (.getNamedItem entities name))]
                (when (nil? entity) (return uri))
                (let [notationName (.getNotationName entity)]
                  (when (some? notationName)
                    (set! uri (.getSystemId entity))
                    (when (nil? uri) (set! uri (.getPublicId entity))))))))
          uri)
        (.getUnparsedEntityURI super name)))

  (method ^:public release ^void [this] (.release _dtmManager this true)))

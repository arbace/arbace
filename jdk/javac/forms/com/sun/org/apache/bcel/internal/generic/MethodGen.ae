  (method ^:public removeLineNumber ^void [this ^:final ^LineNumberGen l]
    (.remove lineNumberList l))

  (method ^:public removeLineNumbers ^void [this] (.clear lineNumberList))

  (method ^:public removeLocalVariable ^void [this ^:final ^LocalVariableGen l]
    (.remove variableList l))

  (method ^:public removeLocalVariables ^void [this]
    (.clear variableList))

  (method ^:public removeLocalVariableTypeTable ^void [this]
    (set! localVariableTypeTable nil))

  (method ^:public removeNOPs ^void [this]
    (when (some? il)
      (let [^:mutable ^InstructionHandle next nil]
        (loop [ih (.getStart il)]
          (when (some? ih)
            (set! next (.getNext ih))
            (if (and (some? next) (instance? NOP (.getInstruction ih)))
                (do
                  (try
                    (.delete il ih)
                    (catch TargetLostException e
                      (for-each [^InstructionHandle target (.getTargets e)]
                        (for-each [^InstructionTargeter targeter (.getTargeters target)]
                          (.updateTarget targeter target next)))))
                  (recur next))
                (recur next)))))))

  (method ^:public removeObserver ^void [this ^:final ^MethodObserver o]
    (when (some? observers) (.remove observers o)))

  (method ^:public removeRuntimeAttributes ^void [this ^:final ^Attribute/1 attributes]
    (.forEach (Utils/streamOfIfNonNull attributes)
              (method-ref Consumer [Attribute] this MethodGen/.removeAttribute)))

  (method ^:public setArgumentName ^void [this ^:final ^int i ^:final ^String name]
    (aset argNames i name))

  (method ^:public setArgumentNames ^void [this ^:final ^String/1 argNames]
    (set! (.-argNames this) (cast String/1 (Utils/createEmptyArrayIfNull argNames String/1))))

  (method ^:public setArgumentType ^void [this ^:final ^int i ^:final ^Type type]
    (aset argTypes i type))

  (method ^:public setArgumentTypes ^void [this ^:final ^Type/1 argTypes]
    (set! (.-argTypes this) (if (some? argTypes) argTypes Type/NO_ARGS)))

  (method ^:public setClassName ^void [this ^:final ^String className]
    (set! (.-className this) className))

  (method ^:public setInstructionList ^void [this ^:final ^InstructionList il]
    (set! (.-il this) il))

  (method ^:public setMaxLocals ^void [this]
    (if (some? il)
        (let [^:mutable ^int max (if (.isStatic this) 0 1)]
          (when (some? argTypes)
            (for-each [^Type argType argTypes]
              (set! max (unchecked-add-int max (.getSize argType)))))
          (loop [ih (.getStart il)]
            (when (some? ih)
              (let [^:final ins (.getInstruction ih)]
                (if (or (or (instance? LocalVariableInstruction ins) (instance? RET ins))
                        (instance? IINC ins))
                    (let [^:final index (unchecked-add-int
                                          (.getIndex (cast IndexedInstruction ins))
                                          (.getSize
                                            (.getType
                                              (cast TypedInstruction ins)
                                              (.getConstantPool super))))]
                      (if (> index max)
                          (do (set! max index) (recur (.getNext ih)))
                          (recur (.getNext ih))))
                    (recur (.getNext ih))))))
          (set! maxLocals max))
        (set! maxLocals 0)))

  (method ^:public setMaxLocals ^void [this ^:final ^int m]
    (set! maxLocals m))

  (method ^:public setMaxStack ^void [this]
    (if (some? il)
        (set! maxStack
              (MethodGen/getMaxStack (.getConstantPool super) il (.getExceptionHandlers this)))
        (set! maxStack 0)))

  (method ^:public setMaxStack ^void [this ^:final ^int m]
    (set! maxStack m))

  (method ^:public setReturnType ^void [this ^:final ^Type returnType]
    (.setType this returnType))

  (method ^:public stripAttributes ^void [this ^:final ^boolean flag]
    (set! stripAttributes flag))

  (method ^:public ^:final toString ^String [this]
    (let [^:final access (Utility/accessToString (.getAccessFlags super))
          ^:mutable signature (Type/getMethodSignature (.getType super) argTypes)]
      (set!
        signature
        (Utility/methodSignatureToString signature
                                         (.getName super)
                                         access
                                         true
                                         (.getLocalVariableTable this (.getConstantPool super))))
      (let [^:final buf (StringBuilder. signature)]
        (for-each [^Attribute a (.getAttributes this)]
          (when-not (or (instance? Code a) (instance? ExceptionTable a))
            (.append (.append (.append buf " [") a) "]")))
        (when-not (.isEmpty throwsList)
          (for-each [^String throwsDescriptor throwsList]
            (.append (.append buf "\n\t\tthrows ") throwsDescriptor)))
        (.toString buf))))

  (method ^:public update ^void [this]
    (when (some? observers) (for-each [^MethodObserver observer observers] (.notify observer this))))

  (method ^:private updateLocalVariableTable ^void [this ^:final ^LocalVariableTable a]
    (.removeLocalVariables this)
    (for-each [^LocalVariable l (.getLocalVariableTable a)]
      (let [^:mutable start (.findHandle il (.getStartPC l))
            ^:final end (.findHandle il (unchecked-add-int (.getStartPC l) (.getLength l)))]
        (when (nil? start) (set! start (.getStart il)))
        (.addLocalVariable this
                           (.getName l)
                           (Type/getType (.getSignature l))
                           (.getIndex l)
                           start
                           end
                           (.getOrigIndex l))))))

      (when (some? localVariableTypeTable)
        (when (some? lvt) (.adjustLocalVariableTypeTable this lvt))
        (.addCodeAttribute this localVariableTypeTable))
      (when (and (not (.isEmpty lineNumberList)) (not stripAttributes))
        (.addCodeAttribute this (set! lnt (.getLineNumberTable this cp))))

          ^:mutable ^int varIndex (if (.contains access "static") 0 1)]
      (try
        (set! index (unchecked-add-int (.indexOf signature \() 1))
        (when (<= index 0) (throw (InvalidMethodSignatureException. signature)))
        (while (not (== (.charAt signature index) \)))
          (let [^:final paramType (Utility/typeSignatureToString
                                    (.substring signature index)
                                    chopit)]
            (.append buf paramType)
            (if (some? vars)
                (let [^:final l (.getLocalVariable vars varIndex 0)]
                  (when (some? l) (.append (.append buf " ") (.getName l))))
                (.append (.append buf " arg") varIndex))
            (if (or (.equals "double" paramType) (.equals "long" paramType))
                (set! varIndex (unchecked-add-int varIndex 2))
                (set! varIndex (unchecked-inc-int varIndex)))
            (.append buf ", ")
            (set! index (unchecked-add-int index (Utility/unwrap CONSUMER_CHARS)))))
        (set! index (unchecked-inc-int index))
        (set! type (Utility/typeSignatureToString (.substring signature index) chopit))
        (catch StringIndexOutOfBoundsException e
          (throw (InvalidMethodSignatureException. signature e))))
      (when (> (.length buf) 1) (.setLength buf (unchecked-subtract-int (.length buf) 2)))
      (.append buf ")")
      (java-str access (if (not (.isEmpty access)) " " "") type " " name (.toString buf))))

  (method ^:public ^:static methodTypeToSignature :throws [ClassFormatException] ^String [^:final ^String ret
                                                                                          ^:final ^String/1 argv]
    (let [^:final buf (StringBuilder. "(")
          ^:mutable ^String str nil]
      (when (some? argv)
        (for-each [^String element argv]
          (set! str (Utility/getSignature element))
          (when (.endsWith str "V")
            (throw (ClassFormatException. (java-str "Invalid type: " element))))
          (.append buf str)))
      (set! str (Utility/getSignature ret))
      (.append (.append buf ")") str)
      (.toString buf)))

  (method ^:public ^:static packageToPath ^String [^:final ^String name]
    (.replace name \. \/))

  (method ^:public ^:static pathToPackage ^String [^:final ^String str]
    (.replace str \/ \.))

  (method ^:private ^:static pow2 ^int [^:final ^int n]
    (bit-shift-left-int 1 n))

  (method ^:public ^:static printArray ^String [^:final ^Object/1 obj]
    (Utility/printArray obj true))

  (method ^:public ^:static printArray ^String [^:final ^Object/1 obj ^:final ^boolean braces]
    (Utility/printArray obj braces false))

  (method ^:public ^:static printArray ^String [^:final ^Object/1 obj ^:final ^boolean braces
                                                ^:final ^boolean quote]
    (when (some? obj)
      (let [^:final buf (StringBuilder.)]
        (when braces (.append buf \{))
        (loop [^int i 0]
          (when (< i (alength obj))
            (if (some? (aget obj i))
                (.append (.append (.append buf ^String (if quote "\"" "")) (aget obj i))
                         ^String (if quote "\"" ""))
                (.append buf "null"))
            (if (< i (unchecked-subtract-int (alength obj) 1))
                (do (.append buf ", ") (recur (unchecked-inc-int i)))
                (recur (unchecked-inc-int i)))))
        (when braces (.append buf \}))
        (.toString buf))))

  (method ^:public ^:static printArray ^void [^:final ^PrintStream out ^:final ^Object/1 obj]
    (.println out (Utility/printArray obj true)))

  (method ^:public ^:static printArray ^void [^:final ^PrintWriter out ^:final ^Object/1 obj]
    (.println out (Utility/printArray obj true)))

  (method ^:public ^:static replace ^String [^:mutable ^String str ^:final ^String old
                                             ^:final ^String new_]
    (let [^:mutable ^int index 0
          ^:mutable ^int oldIndex 0]
      (try
        (when (.contains str old)
          (let [^:final buf (StringBuilder.)]
            (set! oldIndex 0)
            (while (not (== (set! index (.indexOf str old oldIndex)) -1))
              (.append buf str oldIndex index)
              (.append buf new_)
              (set! oldIndex (unchecked-add-int index (.length old))))
            (.append buf (.substring str oldIndex))
            (set! str (.toString buf))))
        (catch StringIndexOutOfBoundsException e (.println System/err e)))
      str))

  (method ^:public ^:static searchOpcode ^short [^:mutable ^String name]
    (set! name (.toLowerCase name Locale/ENGLISH))
    (loop [^short i 0]
      (if (< i Const/OPCODE_NAMES_LENGTH)
          (if (.equals (Const/getOpcodeName i) name)
              (return i)
              (recur (unchecked-short (unchecked-inc-int i))))
          nil))
    -1)

  (method ^:public ^:static setBit ^int [^:final ^int flag ^:final ^int i]
    (bit-or-int flag (Utility/pow2 i)))

  (method ^:public ^:static signatureToString ^String [^:final ^String signature]
    (Utility/signatureToString signature true))

  (method ^:public ^:static signatureToString ^String [^:final ^String signature
                                                       ^:final ^boolean chopit]
    (let [^:mutable type ""
          ^:mutable typeParams ""
          ^:mutable ^int index 0]
      (when (== (.charAt signature 0) \<)
        (set! typeParams (Utility/typeParamTypesToString signature chopit))
        (set! index (unchecked-add-int index (Utility/unwrap CONSUMER_CHARS))))
      (if (== (.charAt signature index) \()
          (do
            (set!
              type
              (java-str typeParams
                        (Utility/typeSignaturesToString (.substring signature index) chopit \))))
            (set! index (unchecked-add-int index (Utility/unwrap CONSUMER_CHARS)))
            (set! type
                  (java-str type
                            (Utility/typeSignatureToString (.substring signature index) chopit)))
            (set! index (unchecked-add-int index (Utility/unwrap CONSUMER_CHARS)))
            type)
          (do
            (set! type (Utility/typeSignatureToString (.substring signature index) chopit))
            (set! index (unchecked-add-int index (Utility/unwrap CONSUMER_CHARS)))
            (if (and (.isEmpty typeParams) (== index (.length signature)))
                type
                (let [^:final typeClass (StringBuilder. typeParams)]
                  (.append typeClass " extends ")
                  (.append typeClass type)
                  (when (< index (.length signature))
                    (.append typeClass " implements ")
                    (.append typeClass
                             (Utility/typeSignatureToString (.substring signature index) chopit))
                    (set! index (unchecked-add-int index (Utility/unwrap CONSUMER_CHARS))))
                  (while (< index (.length signature))
                    (.append typeClass ", ")
                    (.append typeClass
                             (Utility/typeSignatureToString (.substring signature index) chopit))
                    (set! index (unchecked-add-int index (Utility/unwrap CONSUMER_CHARS))))
                  (.toString typeClass)))))))

  (method ^:public ^:static toHexString ^String [^:final ^byte/1 bytes]
    (let [^:final buf (StringBuilder.)]
      (loop [^int i 0]
        (when (< i (alength bytes))
          (let [^:final b (Utility/byteToShort (aget bytes i))
                ^:final hex (Integer/toHexString b)]
            (when (< b 0x10) (.append buf \0))
            (.append buf hex)
            (if (< i (unchecked-subtract-int (alength bytes) 1))
                (do (.append buf \space) (recur (unchecked-inc-int i)))
                (recur (unchecked-inc-int i))))))
      (.toString buf)))

  (method ^:public ^:static typeOfMethodSignature :throws [ClassFormatException] ^byte [^:final ^String signature]
    (let [^:mutable ^int index 0]
      (try
        (when-not (== (.charAt signature 0) \()
          (throw (InvalidMethodSignatureException. signature)))
        (set! index (unchecked-add-int (.lastIndexOf signature \)) 1))
        (Utility/typeOfSignature (.substring signature index))
        (catch StringIndexOutOfBoundsException e
          (throw (InvalidMethodSignatureException. signature e))))))

  (method ^:public ^:static typeOfSignature :throws [ClassFormatException] ^byte [^:final ^String signature]
    (try
      (switch (.charAt signature 0)
        \B Const/T_BYTE
        \C Const/T_CHAR
        \D Const/T_DOUBLE
        \F Const/T_FLOAT
        \I Const/T_INT
        \J Const/T_LONG
        (\L \T) Const/T_REFERENCE
        \[ Const/T_ARRAY
        \V Const/T_VOID
        \Z Const/T_BOOLEAN
        \S Const/T_SHORT
        (\! \+ \*) (Utility/typeOfSignature (.substring signature 1))
        (throw (InvalidMethodSignatureException. signature)))
      (catch StringIndexOutOfBoundsException e
        (throw (InvalidMethodSignatureException. signature e)))))

  (method ^:private ^:static typeParamTypesToString ^String [^:final ^String signature
                                                             ^:final ^boolean chopit]
    (let [^:final typeParams (StringBuilder. "<")
          ^:mutable ^int index 1]
      (.append typeParams (Utility/typeParamTypeToString (.substring signature index) chopit))
      (set! index (unchecked-add-int index (Utility/unwrap CONSUMER_CHARS)))
      (while (not (== (.charAt signature index) \>))
        (.append typeParams ", ")
        (.append typeParams (Utility/typeParamTypeToString (.substring signature index) chopit))
        (set! index (unchecked-add-int index (Utility/unwrap CONSUMER_CHARS))))
      (Utility/wrap CONSUMER_CHARS (unchecked-add-int index 1))
      (.toString (.append typeParams ">"))))

  (method ^:private ^:static typeParamTypeToString ^String [^:final ^String signature
                                                            ^:final ^boolean chopit]
    (let [^:mutable index (.indexOf signature \:)]
      (when (<= index 0)
        (throw (ClassFormatException. (java-str "Invalid type parameter signature: " signature))))
      (let [^:final typeParam (StringBuilder. (.substring signature 0 index))]
        (set! index (unchecked-inc-int index))
        (when-not (== (.charAt signature index) \:)
          (.append typeParam " extends ")
          (.append typeParam (Utility/typeSignatureToString (.substring signature index) chopit))
          (set! index (unchecked-add-int index (Utility/unwrap CONSUMER_CHARS))))
        (while (== (.charAt signature index) \:)
          (set! index (unchecked-inc-int index))
          (.append typeParam " & ")
          (.append typeParam (Utility/typeSignatureToString (.substring signature index) chopit))
          (set! index (unchecked-add-int index (Utility/unwrap CONSUMER_CHARS))))
        (Utility/wrap CONSUMER_CHARS index)
        (.toString typeParam))))

  (method ^:private ^:static typeSignaturesToString ^String [^:final ^String signature
                                                             ^:final ^boolean chopit
                                                             ^:final ^char term]
    (let [^:final typeList (StringBuilder. (.substring signature 0 1))
          ^:mutable ^int index 1]
      (when-not (== (.charAt signature index) term)
        (.append typeList (Utility/typeSignatureToString (.substring signature index) chopit))
        (set! index (unchecked-add-int index (Utility/unwrap CONSUMER_CHARS))))
      (while (not (== (.charAt signature index) term))
        (.append typeList ", ")
        (.append typeList (Utility/typeSignatureToString (.substring signature index) chopit))
        (set! index (unchecked-add-int index (Utility/unwrap CONSUMER_CHARS))))
      (Utility/wrap CONSUMER_CHARS (unchecked-add-int index 1))
      (.toString (.append typeList term))))

  (method ^:public ^:static typeSignatureToString :throws [ClassFormatException] ^String [^:final ^String signature
                                                                                          ^:final ^boolean chopit]
    (Utility/wrap CONSUMER_CHARS 1)
    (try
      (switch (.charAt signature 0)
        \B "byte"
        \C "char"
        \D "double"
        \F "float"
        \I "int"
        \J "long"
        \T
          (let [^:final index (.indexOf signature \;)]
            (when (< index 0)
              (throw (ClassFormatException.
                       (java-str "Invalid type variable signature: " signature))))
            (Utility/wrap CONSUMER_CHARS (unchecked-add-int index 1))
            (Utility/compactClassName (.substring signature 1 index) chopit))
        \L
          (let [^:mutable fromIndex (.indexOf signature \<)]
            (if (< fromIndex 0)
                (set! fromIndex 0)
                (do
                  (set! fromIndex (.indexOf signature \> fromIndex))
                  (when (< fromIndex 0)
                    (throw (ClassFormatException. (java-str "Invalid signature: " signature))))))
            (let [^:final index (.indexOf signature \; fromIndex)]
              (when (< index 0)
                (throw (ClassFormatException. (java-str "Invalid signature: " signature))))
              (let [^:final bracketIndex (.indexOf (.substring signature 0 index) \<)]
                (if (< bracketIndex 0)
                    (do
                      (Utility/wrap CONSUMER_CHARS (unchecked-add-int index 1))
                      (Utility/compactClassName (.substring signature 1 index) chopit))
                    (do
                      (set! fromIndex (.indexOf signature \;))
                      (when (< fromIndex 0)
                        (throw (ClassFormatException. (java-str "Invalid signature: " signature))))
                      (if (< fromIndex bracketIndex)
                          (do
                            (Utility/wrap CONSUMER_CHARS (unchecked-add-int fromIndex 1))
                            (Utility/compactClassName (.substring signature 1 fromIndex) chopit))
                          (let [^:final type (.append
                                               (StringBuilder.
                                                 (Utility/compactClassName
                                                   (.substring signature 1 bracketIndex)
                                                   chopit))
                                               "<")
                                ^:mutable consumedChars (unchecked-add-int bracketIndex 1)]
                            (if (== (.charAt signature consumedChars) \+)
                                (do
                                  (.append type "? extends ")
                                  (set! consumedChars (unchecked-inc-int consumedChars)))
                                (when (== (.charAt signature consumedChars) \-)
                                  (.append type "? super ")
                                  (set! consumedChars (unchecked-inc-int consumedChars))))
                            (if (== (.charAt signature consumedChars) \*)
                                (do
                                  (.append type "?")
                                  (set! consumedChars (unchecked-inc-int consumedChars)))
                                (do
                                  (.append type
                                           (Utility/typeSignatureToString
                                             (.substring signature consumedChars)
                                             chopit))
                                  (set! consumedChars
                                        (unchecked-add-int
                                          (Utility/unwrap CONSUMER_CHARS)
                                          consumedChars))
                                  (Utility/wrap CONSUMER_CHARS consumedChars)))
                            (while (not (== (.charAt signature consumedChars) \>))
                              (.append type ", ")
                              (if (== (.charAt signature consumedChars) \+)
                                  (do
                                    (.append type "? extends ")
                                    (set! consumedChars (unchecked-inc-int consumedChars)))
                                  (when (== (.charAt signature consumedChars) \-)
                                    (.append type "? super ")
                                    (set! consumedChars (unchecked-inc-int consumedChars))))
                              (if (== (.charAt signature consumedChars) \*)
                                  (do
                                    (.append type "?")
                                    (set! consumedChars (unchecked-inc-int consumedChars)))
                                  (do
                                    (.append type
                                             (Utility/typeSignatureToString
                                               (.substring signature consumedChars)
                                               chopit))
                                    (set! consumedChars
                                          (unchecked-add-int
                                            (Utility/unwrap CONSUMER_CHARS)
                                            consumedChars))
                                    (Utility/wrap CONSUMER_CHARS consumedChars))))
                            (set! consumedChars (unchecked-inc-int consumedChars))
                            (.append type ">")
                            (if (== (.charAt signature consumedChars) \.)
                                (do
                                  (.append type ".")
                                  (.append type
                                           (Utility/typeSignatureToString
                                             (java-str
                                               "L"
                                               (.substring
                                                 signature
                                                 (unchecked-add-int consumedChars 1)))
                                             chopit))
                                  (set! consumedChars
                                        (unchecked-add-int
                                          (Utility/unwrap CONSUMER_CHARS)
                                          consumedChars))
                                  (Utility/wrap CONSUMER_CHARS consumedChars)
                                  (.toString type))
                                (do
                                  (when-not (== (.charAt signature consumedChars) \;)
                                    (throw (ClassFormatException.
                                             (java-str "Invalid signature: " signature))))
                                  (Utility/wrap CONSUMER_CHARS (unchecked-add-int consumedChars 1))
                                  (.toString type))))))))))
        \S "short"
        \Z "boolean"
        \[
          (let [^:mutable ^int n 0
                ^:mutable ^StringBuilder brackets nil
                ^:mutable ^String type nil
                ^:mutable ^int consumedChars 0]
            (set! brackets (StringBuilder.))
            (set! n 0)
            (while (== (.charAt signature n) \[)
              (.append brackets "[]")
              (set! n (unchecked-inc-int n)))
            (set! consumedChars n)
            (set! type (Utility/typeSignatureToString (.substring signature n) chopit))
            (let [^:final temp (unchecked-add-int (Utility/unwrap CONSUMER_CHARS) consumedChars)]
              (Utility/wrap CONSUMER_CHARS temp)
              (java-str type (.toString brackets))))
        \V "void"
        (throw (ClassFormatException. (java-str "Invalid signature: '" signature "'"))))
      (catch StringIndexOutOfBoundsException e
        (throw (ClassFormatException. (java-str "Invalid signature: " signature) e)))))

  (method ^:private ^:static unwrap ^int [^:final ^{:tag (ThreadLocal Integer)} tl]
    (.intValue (cast Integer (.get tl))))

  (method ^:private ^:static wrap ^void [^:final ^{:tag (ThreadLocal Integer)} tl ^:final ^int value]
    (.set tl (Integer/valueOf value))))

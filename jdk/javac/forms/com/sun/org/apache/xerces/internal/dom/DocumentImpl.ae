                                                            (.get gf "eventListeners" nil))]
      (set! mutationEvents (.get gf "mutationEvents" false))
      (when (some? it) (set! iterators (ArrayList. it)))
      (when (some? r) (set! ranges (ArrayList. r)))
      (when (some? el)
        (set! eventListeners (HashMap.))
        (for-each [^{:tag (Map$Entry NodeImpl (Vector LEntry))} e (.entrySet el)]
          (.put eventListeners
                (cast NodeImpl (.getKey e))
                (ArrayList. (cast Collection (.getValue e)))))))))

  (method ^:private findDTValidator ^XSSimpleType [this ^Element elm ^String refName
                                                   ^QName baseTypeStr ^short baseRefContext
                                                   ^XSDocumentInfo schemaDoc]
    (when (some? baseTypeStr)
      (let [baseType (cast XSTypeDefinition
                           (.getGlobalDecl (.-fSchemaHandler this)
                                           schemaDoc
                                           XSDHandler/TYPEDECL_TYPE
                                           baseTypeStr
                                           elm))]
        (when (some? baseType)
          (cond
            (not (== (.getTypeCategory baseType) XSTypeDefinition/SIMPLE_TYPE))
              (do
                (.reportSchemaError this
                                    "cos-st-restricts.1.1"
                                    (new Object/1 [(.-rawname baseTypeStr) refName])
                                    elm)
                nil)
            (and (identical? baseType SchemaGrammar/fAnySimpleType)
                 (== baseRefContext XSConstants/DERIVATION_RESTRICTION))
              (when-not (.checkBuiltIn this refName (.-fTargetNamespace schemaDoc))
                (.reportSchemaError this
                                    "cos-st-restricts.1.1"
                                    (new Object/1 [(.-rawname baseTypeStr) refName])
                                    elm)
                nil)
            (not (== (bit-and-int (.getFinal baseType) baseRefContext) 0))
              (do
                (cond
                  (== baseRefContext XSConstants/DERIVATION_RESTRICTION)
                    (.reportSchemaError this
                                        "st-props-correct.3"
                                        (new Object/1 [refName (.-rawname baseTypeStr)])
                                        elm)
                  (== baseRefContext XSConstants/DERIVATION_LIST)
                    (.reportSchemaError this
                                        "cos-st-restricts.2.3.1.1"
                                        (new Object/1 [(.-rawname baseTypeStr) refName])
                                        elm)
                  (== baseRefContext XSConstants/DERIVATION_UNION)
                    (.reportSchemaError this
                                        "cos-st-restricts.3.3.1.1"
                                        (new Object/1 [(.-rawname baseTypeStr) refName])
                                        elm))
                nil)
            :else (cast XSSimpleType baseType))))))

  (method ^:private ^:final checkBuiltIn ^boolean [this ^String name ^String namespace]
    (if (not (identical? namespace SchemaSymbols/URI_SCHEMAFORSCHEMA))
        false
        (do
          (when (some? (.getGlobalTypeDecl SchemaGrammar/SG_SchemaNS name)) (set! fIsBuiltIn true))
          fIsBuiltIn)))

  (method ^:private isListDatatype ^boolean [this ^XSSimpleType validator]
    (if (== (.getVariety validator) XSSimpleType/VARIETY_LIST)
        true
        (do
          (when (== (.getVariety validator) XSSimpleType/VARIETY_UNION)
            (let [temp (.getMemberTypes validator)]
              (loop [^int i 0]
                (if (< i (.getLength temp))
                    (if (== (.getVariety (cast XSSimpleType (.item temp i)))
                            XSSimpleType/VARIETY_LIST)
                        (return true)
                        (recur (unchecked-inc-int i)))
                    nil))))
          false)))

  (method ^:private errorType ^XSSimpleType [this ^String name ^String namespace ^short refType]
    (let [stringType (cast XSSimpleType (.getTypeDefinition SchemaGrammar/SG_SchemaNS "string"))]
      (switch refType
        XSConstants/DERIVATION_RESTRICTION
          (return (.createTypeRestriction (.-fDVFactory (.-fSchemaHandler this))
                                          name
                                          namespace
                                          (unchecked-short 0)
                                          stringType
                                          nil))
        XSConstants/DERIVATION_LIST
          (return (.createTypeList (.-fDVFactory (.-fSchemaHandler this))
                                   name
                                   namespace
                                   (unchecked-short 0)
                                   stringType
                                   nil))
        XSConstants/DERIVATION_UNION
          (return (.createTypeUnion (.-fDVFactory (.-fSchemaHandler this))
                                    name
                                    namespace
                                    (unchecked-short 0)
                                    (new XSSimpleType/1 [stringType])
                                    nil)))
      nil)))

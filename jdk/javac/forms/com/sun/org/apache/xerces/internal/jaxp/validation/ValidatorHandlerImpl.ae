          (let [^XSTypeDefinition t (.getMemberTypeDefinition psvi)]
            (when (some? t) (return (when (instance? TypeInfo t) (cast TypeInfo t))))))
        (let [t (.getTypeDefinition psvi)]
          (when (some? t) (when (instance? TypeInfo t) (cast TypeInfo t))))))

    (method ^:public isIdAttribute ^boolean [this ^int index]
      (.checkState this false)
      (let [type (cast XSSimpleType (.getAttributeType this index))]
        (if (nil? type) false (.isIDType type))))

    (method ^:public isSpecified ^boolean [this ^int index]
      (.checkState this false)
      (.isSpecified fAttributes index))

    (method getElementPSVI ^ElementPSVI [this]
      (when (some? fElementAugs) (cast ElementPSVI (.getItem fElementAugs Constants/ELEMENT_PSVI))))

    (method getAttributePSVI ^AttributePSVI [this ^int index]
      (when (some? fAttributes)
        (let [augs (.getAugmentations fAttributes index)]
          (when (some? augs) (return (cast AttributePSVI (.getItem augs Constants/ATTRIBUTE_PSVI))))))
      nil)

    (method getAttributePSVIByName ^AttributePSVI [this ^String uri ^String localname]
      (when (some? fAttributes)
        (let [augs (.getAugmentations fAttributes uri localname)]
          (when (some? augs) (return (cast AttributePSVI (.getItem augs Constants/ATTRIBUTE_PSVI))))))
      nil))

  (field ^:private ^:final ^ResolutionForwarder fResolutionForwarder (ResolutionForwarder. nil))

  (defclass ^:static ^:final ResolutionForwarder
    :implements [EntityResolver2]

    (field ^:private ^:static ^:final ^String XML_TYPE "http://www.w3.org/TR/REC-xml")

    (field ^:protected ^LSResourceResolver fEntityResolver)

    (constructor ^:public [this])

    (constructor ^:public [this ^LSResourceResolver entityResolver]
      (.setEntityResolver this entityResolver))

    (method ^:public setEntityResolver ^void [this ^LSResourceResolver entityResolver]
      (set! fEntityResolver entityResolver))

    (method ^:public getEntityResolver ^LSResourceResolver [this]
      fEntityResolver)

    (method ^:public getExternalSubset :throws [SAXException IOException] ^InputSource [this
                                                                                        ^String name
                                                                                        ^String baseURI]
      nil)

    (method ^:public resolveEntity :throws [SAXException IOException] ^InputSource [this
                                                                                    ^String name
                                                                                    ^String publicId
                                                                                    ^String baseURI
                                                                                    ^String systemId]
      (when (some? fEntityResolver)
        (let [lsInput (.resolveResource fEntityResolver XML_TYPE nil publicId systemId baseURI)]
          (when (some? lsInput)
            (let [^:final pubId (.getPublicId lsInput)
                  ^:final sysId (.getSystemId lsInput)
                  ^:final baseSystemId (.getBaseURI lsInput)
                  ^:final charStream (.getCharacterStream lsInput)
                  ^:final byteStream (.getByteStream lsInput)
                  ^:final data (.getStringData lsInput)
                  ^:final encoding (.getEncoding lsInput)
                  inputSource (InputSource.)]
              (.setPublicId inputSource pubId)
              (.setSystemId inputSource
                            ^String (if (some? baseSystemId)
                                        (.resolveSystemId this sysId baseSystemId)
                                        sysId))
              (cond
                (some? charStream) (.setCharacterStream inputSource charStream)
                (some? byteStream) (.setByteStream inputSource byteStream)
                (and (some? data) (not (== (.length data) 0)))
                  (.setCharacterStream inputSource (StringReader. data)))
              (.setEncoding inputSource encoding)
              (return inputSource)))))
      nil)

    (method ^:public resolveEntity :throws [SAXException IOException] ^InputSource [this
                                                                                    ^String publicId
                                                                                    ^String systemId]
      (.resolveEntity this nil publicId nil systemId))

    (method ^:private resolveSystemId ^String [this ^String systemId ^String baseURI]
      (try
        (XMLEntityManager/expandSystemId systemId baseURI false)
        (catch URI$MalformedURIException ex systemId)))))

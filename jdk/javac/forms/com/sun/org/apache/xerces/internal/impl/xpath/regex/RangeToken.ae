                    (if (== (aget (.-ranges this) i) (aget (.-ranges this) (unchecked-add-int i 1)))
                        (do
                          (.append sb (RangeToken/escapeCharInCharClass (aget (.-ranges this) i)))
                          (recur (unchecked-add-int i 2)))
                        (do
                          (.append sb (RangeToken/escapeCharInCharClass (aget (.-ranges this) i)))
                          (.append sb \-)
                          (.append sb
                                   (RangeToken/escapeCharInCharClass
                                     (aget (.-ranges this) (unchecked-add-int i 1))))
                          (recur (unchecked-add-int i 2))))))
                (.append sb \])
                (set! ret (.toString sb))))
        (identical? this Token/token_not_0to9) (set! ret "\\D")
        (identical? this Token/token_not_wordchars) (set! ret "\\W")
        (identical? this Token/token_not_spaces) (set! ret "\\S")
        :else
          (let [sb (StringBuffer.)]
            (.append sb "[^")
            (loop [^int i 0]
              (when (< i (alength (.-ranges this)))
                (when (and (not (== (bit-and-int options RegularExpression/SPECIAL_COMMA) 0))
                           (> i 0))
                  (.append sb \,))
                (if (== (aget (.-ranges this) i) (aget (.-ranges this) (unchecked-add-int i 1)))
                    (do
                      (.append sb (RangeToken/escapeCharInCharClass (aget (.-ranges this) i)))
                      (recur (unchecked-add-int i 2)))
                    (do
                      (.append sb (RangeToken/escapeCharInCharClass (aget (.-ranges this) i)))
                      (.append sb \-)
                      (.append sb
                               (RangeToken/escapeCharInCharClass
                                 (aget (.-ranges this) (unchecked-add-int i 1))))
                      (recur (unchecked-add-int i 2))))))
            (.append sb \])
            (set! ret (.toString sb))))
      ret))

  (method ^:private ^:static escapeCharInCharClass ^String [^int ch]
    (let [^:mutable ^String ret nil]
      (switch ch
        (\[ \] \- \^ \, \\) (set! ret (java-str "\\" (unchecked-char ch)))
        \formfeed (set! ret "\\f")
        \newline (set! ret "\\n")
        \return (set! ret "\\r")
        \tab (set! ret "\\t")
        0x1b (set! ret "\\e")
        (cond
          (< ch 0x20)
            (let [pre (java-str "0" (Integer/toHexString ch))]
              (set! ret
                    (java-str "\\x"
                              (.substring pre
                                          (unchecked-subtract-int (.length pre) 2)
                                          (.length pre)))))
          (>= ch 0x10000)
            (let [pre (java-str "0" (Integer/toHexString ch))]
              (set! ret
                    (java-str "\\v"
                              (.substring pre
                                          (unchecked-subtract-int (.length pre) 6)
                                          (.length pre)))))
          :else (set! ret (java-str "" (unchecked-char ch)))))
      ret)))

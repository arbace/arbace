                             (or (nil? fValidationManager) (not (.isCachedDTD fValidationManager))))
                    (.setInputSource fDTDScanner fExternalSubsetSource)
                    (set! fExternalSubsetSource nil)
                    (if (.-fSupportDTD XMLDocumentScannerImpl/this)
                        (.setScannerState XMLDocumentScannerImpl/this
                                          SCANNER_STATE_DTD_EXTERNAL_DECLS)
                        (.setScannerState XMLDocumentScannerImpl/this SCANNER_STATE_PROLOG))
                    (.setDriver XMLDocumentScannerImpl/this
                                (.-fContentDriver XMLDocumentScannerImpl/this))
                    (when (nil? fDTDDriver) (set! fDTDDriver (DTDDriver.)))
                    (return (.next fDTDDriver))))
              (when (some? fDTDScanner) (.setInputSource fDTDScanner nil))
              (.setScannerState XMLDocumentScannerImpl/this SCANNER_STATE_PROLOG)
              (return XMLEvent/DTD))
          XMLDocumentFragmentScannerImpl/SCANNER_STATE_CONTENT
            (do
              (.reportFatalError XMLDocumentScannerImpl/this "ContentIllegalInProlog" nil)
              (.scanChar (.-fEntityScanner XMLDocumentScannerImpl/this) nil)
              (return -1))
          XMLDocumentFragmentScannerImpl/SCANNER_STATE_REFERENCE
            (do
              (.reportFatalError XMLDocumentScannerImpl/this "ReferenceIllegalInProlog" nil)
              (return -1)))
        (catch MalformedByteSequenceException e
          (.reportError (.-fErrorReporter XMLDocumentScannerImpl/this)
                        (.getDomain e)
                        (.getKey e)
                        (.getArguments e)
                        XMLErrorReporter/SEVERITY_FATAL_ERROR
                        e)
          (return -1))
        (catch CharConversionException e
          (.reportError (.-fErrorReporter XMLDocumentScannerImpl/this)
                        XMLMessageFormatter/XML_DOMAIN
                        "CharConversionFailure"
                        nil
                        XMLErrorReporter/SEVERITY_FATAL_ERROR
                        e)
          (return -1))
        (catch EOFException e
          (.reportFatalError XMLDocumentScannerImpl/this "PrematureEOF" nil)
          (return -1)))
      -1))

  (defclass ^:protected ^:final DTDDriver
    :implements [XMLDocumentFragmentScannerImpl$Driver]

    (method ^:public next :throws [IOException XNIException] ^int [this]
      (.dispatch this true)
      (when (some? (.-fPropertyManager XMLDocumentScannerImpl/this))
        (set! (.-dtdGrammarUtil XMLDocumentScannerImpl/this)
              (DTDGrammarUtil. (.getGrammar (cast XMLDTDScannerImpl fDTDScanner))
                               (.-fSymbolTable XMLDocumentScannerImpl/this)
                               fNamespaceContext)))
      XMLEvent/DTD)

    (method ^:public dispatch :throws [IOException XNIException] ^boolean [this ^boolean complete]
      (.setEntityHandler (.-fEntityManager XMLDocumentScannerImpl/this) nil)
      (try
        (let [^:mutable ^boolean again false
              resourceIdentifier (XMLResourceIdentifierImpl.)]
          (when (nil? fDTDScanner)
            (if (instance? XML11EntityScanner
                           (.getEntityScanner (.-fEntityManager XMLDocumentScannerImpl/this)))
                (set! fDTDScanner (XML11DTDScannerImpl.))
                (set! fDTDScanner (XMLDTDScannerImpl.)))
            (.reset (cast XMLDTDScannerImpl fDTDScanner)
                    (.-fPropertyManager XMLDocumentScannerImpl/this)))
          (.setLimitAnalyzer fDTDScanner (.-fLimitAnalyzer XMLDocumentScannerImpl/this))
          (loop []
            (set! again false)
            (label :switch
              (switch (.-fScannerState XMLDocumentScannerImpl/this)
                SCANNER_STATE_DTD_INTERNAL_DECLS
                  (let [^:mutable moreToScan false]
                    (when-not (.skipDTD fDTDScanner (.-fSupportDTD XMLDocumentScannerImpl/this))
                      (let [completeDTD true]
                        (set! moreToScan
                              (.scanDTDInternalSubset
                                fDTDScanner
                                completeDTD
                                (.-fStandalone XMLDocumentScannerImpl/this)
                                (and (.-fHasExternalDTD XMLDocumentScannerImpl/this)
                                     fLoadExternalDTD)))))
                    (let [^Entity entity (.getCurrentEntity
                                           (.-fEntityScanner XMLDocumentScannerImpl/this))]
                      (when (instance? Entity$ScannedEntity entity)
                        (set! fEndPos (.-position (cast Entity$ScannedEntity entity))))
                      (set! fReadingDTD false)
                      (when-not moreToScan
                        (when-not (.skipChar (.-fEntityScanner XMLDocumentScannerImpl/this) \] nil)
                          (.reportFatalError XMLDocumentScannerImpl/this
                                             "DoctypedeclNotClosed"
                                             (new Object/1 [fDoctypeName])))
                        (.skipSpaces (.-fEntityScanner XMLDocumentScannerImpl/this))
                        (when-not (.skipChar (.-fEntityScanner XMLDocumentScannerImpl/this) \> nil)
                          (.reportFatalError XMLDocumentScannerImpl/this
                                             "DoctypedeclUnterminated"
                                             (new Object/1 [fDoctypeName])))
                        (set! (.-fMarkupDepth XMLDocumentScannerImpl/this)
                              (unchecked-dec-int (.-fMarkupDepth XMLDocumentScannerImpl/this)))
                        (if (not (.-fSupportDTD XMLDocumentScannerImpl/this))
                            (do
                              (set!
                                (.-fEntityStore XMLDocumentScannerImpl/this)
                                (.getEntityStore (.-fEntityManager XMLDocumentScannerImpl/this)))
                              (.reset (.-fEntityStore XMLDocumentScannerImpl/this)))
                            (when (and (some? fDoctypeSystemId)
                                       (or (.-fValidation XMLDocumentScannerImpl/this)
                                           fLoadExternalDTD))
                              (.setScannerState XMLDocumentScannerImpl/this
                                                SCANNER_STATE_DTD_EXTERNAL)
                              (break :switch)))
                        (.setEndDTDScanState XMLDocumentScannerImpl/this)
                        (return true))))
                SCANNER_STATE_DTD_EXTERNAL
                  (do
                    (.setValues resourceIdentifier fDoctypePublicId fDoctypeSystemId nil nil)
                    (let [^:mutable ^XMLInputSource xmlInputSource nil
                          staxInputSource (.resolveEntityAsPerStax
                                            (.-fEntityManager XMLDocumentScannerImpl/this)
                                            resourceIdentifier)]
                      (when-not (.isCreatedByResolver staxInputSource)
                        (let [accessError (.checkAccess
                                            XMLDocumentScannerImpl/this
                                            fDoctypeSystemId
                                            (.-fAccessExternalDTD XMLDocumentScannerImpl/this))]
                          (when (some? accessError)
                            (.reportFatalError XMLDocumentScannerImpl/this
                                               "AccessExternalDTD"
                                               (new
                                                 Object/1
                                                 [(SecuritySupport/sanitizePath fDoctypeSystemId)
                                                  accessError])))))
                      (set! xmlInputSource (.getXMLInputSource staxInputSource))
                      (.setInputSource fDTDScanner xmlInputSource)
                      (if (some? (.-fCurrentEntity (.-fEntityScanner XMLDocumentScannerImpl/this)))
                          (.setScannerState XMLDocumentScannerImpl/this
                                            SCANNER_STATE_DTD_EXTERNAL_DECLS)
                          (.setScannerState XMLDocumentScannerImpl/this SCANNER_STATE_PROLOG))
                      (set! again true)))
                SCANNER_STATE_DTD_EXTERNAL_DECLS
                  (let [completeDTD true
                        moreToScan (.scanDTDExternalSubset fDTDScanner completeDTD)]
                    (when-not moreToScan
                      (.setEndDTDScanState XMLDocumentScannerImpl/this)
                      (return true)))
                SCANNER_STATE_PROLOG
                  (do (.setEndDTDScanState XMLDocumentScannerImpl/this) (return true))
                (throw (XNIException.
                         (java-str "DTDDriver#dispatch: scanner state="
                                   (.-fScannerState XMLDocumentScannerImpl/this)
                                   " ("
                                   (.getScannerStateName
                                     XMLDocumentScannerImpl/this
                                     (.-fScannerState XMLDocumentScannerImpl/this))
                                   \))))))
            (when (or complete again) (recur))))
        (catch MalformedByteSequenceException e
          (.reportError (.-fErrorReporter XMLDocumentScannerImpl/this)
                        (.getDomain e)
                        (.getKey e)
                        (.getArguments e)
                        XMLErrorReporter/SEVERITY_FATAL_ERROR
                        e)
          (return false))
        (catch CharConversionException e
          (.reportError (.-fErrorReporter XMLDocumentScannerImpl/this)
                        XMLMessageFormatter/XML_DOMAIN
                        "CharConversionFailure"
                        nil
                        XMLErrorReporter/SEVERITY_FATAL_ERROR
                        e)
          (return false))
        (catch EOFException e
          (.reportFatalError XMLDocumentScannerImpl/this "PrematureEOF" nil)
          (return false))
        (finally
          (.setEntityHandler (.-fEntityManager XMLDocumentScannerImpl/this)
                             XMLDocumentScannerImpl/this)))
      true))

  (defclass ^:protected ContentDriver
    :extends XMLDocumentFragmentScannerImpl$FragmentContentDriver

    (method ^:protected scanForDoctypeHook :throws [IOException XNIException] ^boolean [this]
      (if (.skipString (.-fEntityScanner XMLDocumentScannerImpl/this) DOCTYPE)
          (do
            (.setScannerState XMLDocumentScannerImpl/this
                              XMLDocumentFragmentScannerImpl/SCANNER_STATE_DOCTYPE)
            true)
          false))

    (method ^:protected elementDepthIsZeroHook :throws [IOException XNIException] ^boolean [this]
      (.setScannerState XMLDocumentScannerImpl/this SCANNER_STATE_TRAILING_MISC)
      (.setDriver XMLDocumentScannerImpl/this fTrailingMiscDriver)
      true)

    (method ^:protected scanRootElementHook :throws [IOException XNIException] ^boolean [this]
      (if (.scanStartElement XMLDocumentScannerImpl/this)
          (do
            (.setScannerState XMLDocumentScannerImpl/this SCANNER_STATE_TRAILING_MISC)
            (.setDriver XMLDocumentScannerImpl/this fTrailingMiscDriver)
            true)
          false))

    (method ^:protected endOfFileHook :throws [IOException XNIException] ^void [this ^EOFException e]
      (.reportFatalError XMLDocumentScannerImpl/this "PrematureEOF" nil))

    (method ^:protected resolveExternalSubsetAndRead :throws [IOException XNIException] ^void [this]
      (.setValues fDTDDescription
                  nil
                  nil
                  (.getExpandedSystemId
                    (.getCurrentResourceIdentifier (.-fEntityManager XMLDocumentScannerImpl/this)))
                  nil)
      (.setRootName fDTDDescription (.-rawname (.-fElementQName XMLDocumentScannerImpl/this)))
      (let [src (.getExternalSubset (.-fExternalSubsetResolver XMLDocumentScannerImpl/this)
                                    fDTDDescription)]
        (when (some? src)
          (set! fDoctypeName (.-rawname (.-fElementQName XMLDocumentScannerImpl/this)))
          (set! fDoctypePublicId (.getPublicId src))
          (set! fDoctypeSystemId (.getSystemId src))
          (when (some? (.-fDocumentHandler XMLDocumentScannerImpl/this))
            (.doctypeDecl (.-fDocumentHandler XMLDocumentScannerImpl/this)
                          fDoctypeName
                          fDoctypePublicId
                          fDoctypeSystemId
                          nil))
          (try
            (.setInputSource fDTDScanner src)
            (while (.scanDTDExternalSubset fDTDScanner true))
            (finally
              (.setEntityHandler (.-fEntityManager XMLDocumentScannerImpl/this)
                                 XMLDocumentScannerImpl/this)))))))

  (defclass ^:protected ^:final TrailingMiscDriver
    :implements [XMLDocumentFragmentScannerImpl$Driver]

    (method ^:public next :throws [IOException XNIException] ^int [this]
      (if (.-fEmptyElement XMLDocumentScannerImpl/this)
          (do (set! (.-fEmptyElement XMLDocumentScannerImpl/this) false) XMLEvent/END_ELEMENT)
          (do
            (try
              (when (== (.-fScannerState XMLDocumentScannerImpl/this)
                        XMLDocumentFragmentScannerImpl/SCANNER_STATE_TERMINATED)
                (return XMLEvent/END_DOCUMENT))
              (loop []
                (switch (.-fScannerState XMLDocumentScannerImpl/this)
                  SCANNER_STATE_TRAILING_MISC
                    (do
                      (.skipSpaces (.-fEntityScanner XMLDocumentScannerImpl/this))
                      (when (== (.-fScannerState XMLDocumentScannerImpl/this)
                                XMLDocumentFragmentScannerImpl/SCANNER_STATE_TERMINATED)
                        (return XMLEvent/END_DOCUMENT))
                      (if (.skipChar (.-fEntityScanner XMLDocumentScannerImpl/this) \< nil)
                          (.setScannerState
                            XMLDocumentScannerImpl/this
                            XMLDocumentFragmentScannerImpl/SCANNER_STATE_START_OF_MARKUP)
                          (.setScannerState XMLDocumentScannerImpl/this
                                            XMLDocumentFragmentScannerImpl/SCANNER_STATE_CONTENT)))
                  XMLDocumentFragmentScannerImpl/SCANNER_STATE_START_OF_MARKUP
                    (do
                      (set! (.-fMarkupDepth XMLDocumentScannerImpl/this)
                            (unchecked-inc-int (.-fMarkupDepth XMLDocumentScannerImpl/this)))
                      (cond
                        (.skipChar (.-fEntityScanner XMLDocumentScannerImpl/this) \? nil)
                          (.setScannerState XMLDocumentScannerImpl/this
                                            XMLDocumentFragmentScannerImpl/SCANNER_STATE_PI)
                        (.skipChar (.-fEntityScanner XMLDocumentScannerImpl/this) \! nil)
                          (.setScannerState XMLDocumentScannerImpl/this
                                            XMLDocumentFragmentScannerImpl/SCANNER_STATE_COMMENT)
                        (.skipChar (.-fEntityScanner XMLDocumentScannerImpl/this) \/ nil)
                          (.reportFatalError XMLDocumentScannerImpl/this
                                             "MarkupNotRecognizedInMisc"
                                             nil)
                        (or (.isValidNameStartChar
                              XMLDocumentScannerImpl/this
                              (.peekChar (.-fEntityScanner XMLDocumentScannerImpl/this)))
                            (.isValidNameStartHighSurrogate
                              XMLDocumentScannerImpl/this
                              (.peekChar (.-fEntityScanner XMLDocumentScannerImpl/this))))
                          (do
                            (.reportFatalError XMLDocumentScannerImpl/this
                                               "MarkupNotRecognizedInMisc"
                                               nil)
                            (.scanStartElement XMLDocumentScannerImpl/this)
                            (.setScannerState XMLDocumentScannerImpl/this
                                              XMLDocumentFragmentScannerImpl/SCANNER_STATE_CONTENT))
                        :else
                          (.reportFatalError XMLDocumentScannerImpl/this
                                             "MarkupNotRecognizedInMisc"
                                             nil))))
                (when (or (== (.-fScannerState XMLDocumentScannerImpl/this)
                              XMLDocumentFragmentScannerImpl/SCANNER_STATE_START_OF_MARKUP)
                          (== (.-fScannerState XMLDocumentScannerImpl/this)
                              SCANNER_STATE_TRAILING_MISC))
                  (recur)))
              (switch (.-fScannerState XMLDocumentScannerImpl/this)
                XMLDocumentFragmentScannerImpl/SCANNER_STATE_PI
                  (do
                    (.clear (.-fContentBuffer XMLDocumentScannerImpl/this))
                    (.scanPI XMLDocumentScannerImpl/this
                             (.-fContentBuffer XMLDocumentScannerImpl/this))
                    (.setScannerState XMLDocumentScannerImpl/this SCANNER_STATE_TRAILING_MISC)
                    (return XMLEvent/PROCESSING_INSTRUCTION))
                XMLDocumentFragmentScannerImpl/SCANNER_STATE_COMMENT
                  (do
                    (when-not (.skipString (.-fEntityScanner XMLDocumentScannerImpl/this)
                                           COMMENTSTRING)
                      (.reportFatalError XMLDocumentScannerImpl/this "InvalidCommentStart" nil))
                    (.scanComment XMLDocumentScannerImpl/this)
                    (.setScannerState XMLDocumentScannerImpl/this SCANNER_STATE_TRAILING_MISC)
                    (return XMLEvent/COMMENT))
                XMLDocumentFragmentScannerImpl/SCANNER_STATE_CONTENT
                  (let [ch (.peekChar (.-fEntityScanner XMLDocumentScannerImpl/this))]
                    (if (== ch -1)
                        (do
                          (.setScannerState XMLDocumentScannerImpl/this
                                            XMLDocumentFragmentScannerImpl/SCANNER_STATE_TERMINATED)
                          (return XMLEvent/END_DOCUMENT))
                        (do
                          (.reportFatalError XMLDocumentScannerImpl/this
                                             "ContentIllegalInTrailingMisc"
                                             nil)
                          (.scanChar (.-fEntityScanner XMLDocumentScannerImpl/this) nil)
                          (.setScannerState XMLDocumentScannerImpl/this SCANNER_STATE_TRAILING_MISC)
                          (return XMLEvent/CHARACTERS))))
                XMLDocumentFragmentScannerImpl/SCANNER_STATE_REFERENCE
                  (do
                    (.reportFatalError XMLDocumentScannerImpl/this
                                       "ReferenceIllegalInTrailingMisc"
                                       nil)
                    (.setScannerState XMLDocumentScannerImpl/this SCANNER_STATE_TRAILING_MISC)
                    (return XMLEvent/ENTITY_REFERENCE))
                XMLDocumentFragmentScannerImpl/SCANNER_STATE_TERMINATED
                  (do
                    (.setScannerState XMLDocumentScannerImpl/this
                                      SCANNER_STATE_NO_SUCH_ELEMENT_EXCEPTION)
                    (return XMLEvent/END_DOCUMENT))
                SCANNER_STATE_NO_SUCH_ELEMENT_EXCEPTION
                  (throw (NoSuchElementException. "No more events to be parsed"))
                (throw (XNIException.
                         (java-str "Scanner State "
                                   (.-fScannerState XMLDocumentScannerImpl/this)
                                   " not Recognized "))))
              (catch MalformedByteSequenceException e
                (.reportError (.-fErrorReporter XMLDocumentScannerImpl/this)
                              (.getDomain e)
                              (.getKey e)
                              (.getArguments e)
                              XMLErrorReporter/SEVERITY_FATAL_ERROR
                              e)
                (return -1))
              (catch CharConversionException e
                (.reportError (.-fErrorReporter XMLDocumentScannerImpl/this)
                              XMLMessageFormatter/XML_DOMAIN
                              "CharConversionFailure"
                              nil
                              XMLErrorReporter/SEVERITY_FATAL_ERROR
                              e)
                (return -1))
              (catch EOFException e
                (when-not (== (.-fMarkupDepth XMLDocumentScannerImpl/this) 0)
                  (.reportFatalError XMLDocumentScannerImpl/this "PrematureEOF" nil)
                  (return -1))
                (.setScannerState XMLDocumentScannerImpl/this
                                  XMLDocumentFragmentScannerImpl/SCANNER_STATE_TERMINATED)))
            XMLEvent/END_DOCUMENT))))

  (method ^:public refresh ^void [this ^int refreshPosition]
    (.refresh super refreshPosition)
    (when fReadingDTD
      (let [^Entity entity (.getCurrentEntity (.-fEntityScanner this))]
        (when (instance? Entity$ScannedEntity entity)
          (set! fEndPos (.-position (cast Entity$ScannedEntity entity))))
        (.append fDTDDecl
                 (.-ch (cast Entity$ScannedEntity entity))
                 fStartPos
                 (unchecked-subtract-int fEndPos fStartPos))
        (set! fStartPos refreshPosition)))))

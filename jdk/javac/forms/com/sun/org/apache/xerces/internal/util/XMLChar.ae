  (method ^:public ^:static isSupplemental ^boolean [^int c]
    (and (>= c 0x10000) (<= c 0x10FFFF)))

  (method ^:public ^:static supplemental ^int [^char h ^char l]
    (unchecked-add-int
      (unchecked-add-int (unchecked-multiply-int (unchecked-subtract-int h 0xD800) 0x400)
                         (unchecked-subtract-int l 0xDC00))
      0x10000))

  (method ^:public ^:static highSurrogate ^char [^int c]
    (unchecked-char
      (unchecked-add-int (bit-shift-right-int (unchecked-subtract-int c 0x00010000) 10) 0xD800)))

  (method ^:public ^:static lowSurrogate ^char [^int c]
    (unchecked-char
      (unchecked-add-int (bit-and-int (unchecked-subtract-int c 0x00010000) 0x3FF) 0xDC00)))

  (method ^:public ^:static isHighSurrogate ^boolean [^int c]
    (and (<= 0xD800 c) (<= c 0xDBFF)))

  (method ^:public ^:static isLowSurrogate ^boolean [^int c]
    (and (<= 0xDC00 c) (<= c 0xDFFF)))

  (method ^:public ^:static isValid ^boolean [^int c]
    (or (and (< c 0x10000) (not (== (bit-and-int (aget CHARS c) MASK_VALID) 0)))
        (and (<= 0x10000 c) (<= c 0x10FFFF))))

  (method ^:public ^:static isInvalid ^boolean [^int c]
    (not (XMLChar/isValid c)))

  (method ^:public ^:static isContent ^boolean [^int c]
    (or (and (< c 0x10000) (not (== (bit-and-int (aget CHARS c) MASK_CONTENT) 0)))
        (and (<= 0x10000 c) (<= c 0x10FFFF))))

  (method ^:public ^:static isMarkup ^boolean [^int c]
    (or (or (== c \<) (== c \&)) (== c \%)))

  (method ^:public ^:static isSpace ^boolean [^int c]
    (and (<= c 0x20) (not (== (bit-and-int (aget CHARS c) MASK_SPACE) 0))))

  (method ^:public ^:static isNameStart ^boolean [^int c]
    (and (< c 0x10000) (not (== (bit-and-int (aget CHARS c) MASK_NAME_START) 0))))

  (method ^:public ^:static isName ^boolean [^int c]
    (and (< c 0x10000) (not (== (bit-and-int (aget CHARS c) MASK_NAME) 0))))

  (method ^:public ^:static isNCNameStart ^boolean [^int c]
    (and (< c 0x10000) (not (== (bit-and-int (aget CHARS c) MASK_NCNAME_START) 0))))

  (method ^:public ^:static isNCName ^boolean [^int c]
    (and (< c 0x10000) (not (== (bit-and-int (aget CHARS c) MASK_NCNAME) 0))))

  (method ^:public ^:static isPubid ^boolean [^int c]
    (and (< c 0x10000) (not (== (bit-and-int (aget CHARS c) MASK_PUBID) 0))))

  (method ^:public ^:static isValidName ^boolean [^String name]
    (let [length (.length name)]
      (if (== length 0)
          false
          (let [^:mutable ch (.charAt name 0)]
            (if (not (XMLChar/isNameStart ch))
                false
                (do
                  (loop [^int i 1]
                    (when (< i length)
                      (set! ch (.charAt name i))
                      (if (not (XMLChar/isName ch)) (return false) (recur (unchecked-inc-int i)))))
                  true))))))

  (method ^:public ^:static isValidNCName ^boolean [^String ncName]
    (let [length (.length ncName)]
      (if (== length 0)
          false
          (let [^:mutable ch (.charAt ncName 0)]
            (if (not (XMLChar/isNCNameStart ch))
                false
                (do
                  (loop [^int i 1]
                    (when (< i length)
                      (set! ch (.charAt ncName i))
                      (if (not (XMLChar/isNCName ch)) (return false) (recur (unchecked-inc-int i)))))
                  true))))))

  (method ^:public ^:static isValidNmtoken ^boolean [^String nmtoken]
    (let [length (.length nmtoken)]
      (if (== length 0)
          false
          (do
            (loop [^int i 0]
              (when (< i length)
                (let [ch (.charAt nmtoken i)]
                  (if (not (XMLChar/isName ch)) (return false) (recur (unchecked-inc-int i))))))
            true))))

  (method ^:public ^:static isValidIANAEncoding ^boolean [^String ianaEncoding]
    (when (some? ianaEncoding)
      (let [length (.length ianaEncoding)]
        (when (> length 0)
          (let [^:mutable c (.charAt ianaEncoding 0)]
            (when (or (and (>= c \A) (<= c \Z)) (and (>= c \a) (<= c \z)))
              (loop [^int i 1]
                (when (< i length)
                  (set! c (.charAt ianaEncoding i))
                  (if (and (and (and (and (and (or (< c \A) (> c \Z)) (or (< c \a) (> c \z)))
                                          (or (< c \0) (> c \9)))
                                     (not (== c \.)))
                                (not (== c \_)))
                           (not (== c \-)))
                      (return false)
                      (recur (unchecked-inc-int i)))))
              (return true))))))
    false)

  (method ^:public ^:static isValidJavaEncoding ^boolean [^String javaEncoding]
    (when (some? javaEncoding)
      (let [length (.length javaEncoding)]
        (when (> length 0)
          (loop [^int i 1]
            (when (< i length)
              (let [c (.charAt javaEncoding i)]
                (if (and (and (and (and (and (or (< c \A) (> c \Z)) (or (< c \a) (> c \z)))
                                        (or (< c \0) (> c \9)))
                                   (not (== c \.)))
                              (not (== c \_)))
                         (not (== c \-)))
                    (return false)
                    (recur (unchecked-inc-int i))))))
          (return true))))
    false)

  (method ^:public ^:static trim ^String [^String value]
    (let [^:mutable ^int start 0
          ^:mutable ^int end 0
          lengthMinusOne (unchecked-subtract-int (.length value) 1)]
      (set! start 0)
      (while (<= start lengthMinusOne)
        (when-not (XMLChar/isSpace (.charAt value start)) (break))
        (set! start (unchecked-inc-int start)))
      (set! end lengthMinusOne)
      (while (>= end start)
        (when-not (XMLChar/isSpace (.charAt value end)) (break))
        (set! end (unchecked-dec-int end)))
      (cond
        (and (== start 0) (== end lengthMinusOne)) value
        (> start lengthMinusOne) ""
        :else (.substring value start (unchecked-add-int end 1))))))

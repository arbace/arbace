    (field ^int unNormMonth)

    (field ^int unNormDay)

    (field ^int unNormHour)

    (field ^int unNormMinute)

    (field ^double unNormSecond)

    (field ^int position)

    (field ^:final ^AbstractDateTimeDV type)

    (field ^:private ^:volatile ^String canonical)

    (constructor ^:public [this ^String originalValue ^AbstractDateTimeDV type]
      (set! (.-originalValue this) originalValue)
      (set! (.-type this) type))

    (constructor ^:public [this ^int year ^int month ^int day ^int hour ^int minute ^double second
                           ^int utc ^String originalValue ^boolean normalized
                           ^AbstractDateTimeDV type]
      (set! (.-year this) year)
      (set! (.-month this) month)
      (set! (.-day this) day)
      (set! (.-hour this) hour)
      (set! (.-minute this) minute)
      (set! (.-second this) second)
      (set! (.-utc this) utc)
      (set! (.-type this) type)
      (set! (.-originalValue this) originalValue))

    (method ^:public equals ^boolean [this obj]
      (if (not (instance? DateTimeData obj))
          false
          (== (.compareDates type this (cast DateTimeData obj) true) 0)))

    (method ^:public hashCode ^int [this]
      (let [^:final tempDate (DateTimeData. nil type)]
        (.cloneDate type this tempDate)
        (.normalize type tempDate)
        (.hashCode (.dateToString type tempDate))))

    (method ^:public toString ^String [this]
      (when (nil? canonical) (set! canonical (.dateToString type this)))
      canonical)

    (method ^:public getYears ^int [this]
      (cond (instance? DurationDV type) 0 normalized year :else unNormYear))

    (method ^:public getMonths ^int [this]
      (cond
        (instance? DurationDV type) (unchecked-add-int (unchecked-multiply-int year 12) month)
        normalized month
        :else unNormMonth))

    (method ^:public getDays ^int [this]
      (cond (instance? DurationDV type) 0 normalized day :else unNormDay))

    (method ^:public getHours ^int [this]
      (cond (instance? DurationDV type) 0 normalized hour :else unNormHour))

    (method ^:public getMinutes ^int [this]
      (cond (instance? DurationDV type) 0 normalized minute :else unNormMinute))

    (method ^:public getSeconds ^double [this]
      (cond
        (instance? DurationDV type)
          (unchecked-add
            (unchecked-add-int
              (unchecked-add-int
                (unchecked-multiply-int (unchecked-multiply-int (unchecked-multiply-int day 24) 60)
                                        60)
                (unchecked-multiply-int (unchecked-multiply-int hour 60) 60))
              (unchecked-multiply-int minute 60))
            second)
        normalized second
        :else unNormSecond))

    (method ^:public hasTimeZone ^boolean [this] (not (== utc 0)))

    (method ^:public getTimeZoneHours ^int [this] timezoneHr)

    (method ^:public getTimeZoneMinutes ^int [this] timezoneMin)

    (method ^:public getLexicalValue ^String [this] originalValue)

    (method ^:public normalize ^XSDateTime [this]
      (if (not normalized)
          (let [dt (cast DateTimeData (.clone this))] (set! (.-normalized dt) true) dt)
          this))

    (method ^:public isNormalized ^boolean [this] normalized)

    (method ^:public clone [this]
      (let [dt (DateTimeData. (.-year this)
                              (.-month this)
                              (.-day this)
                              (.-hour this)
                              (.-minute this)
                              (.-second this)
                              (.-utc this)
                              (.-originalValue this)
                              (.-normalized this)
                              (.-type this))]
        (set! (.-canonical dt) (.-canonical this))
        (set! (.-position dt) position)
        (set! (.-timezoneHr dt) (.-timezoneHr this))
        (set! (.-timezoneMin dt) (.-timezoneMin this))
        (set! (.-unNormYear dt) (.-unNormYear this))
        (set! (.-unNormMonth dt) (.-unNormMonth this))
        (set! (.-unNormDay dt) (.-unNormDay this))
        (set! (.-unNormHour dt) (.-unNormHour this))
        (set! (.-unNormMinute dt) (.-unNormMinute this))
        (set! (.-unNormSecond dt) (.-unNormSecond this))
        dt))

    (method ^:public getXMLGregorianCalendar ^XMLGregorianCalendar [this]
      (.getXMLGregorianCalendar type this))

    (method ^:public getDuration ^Duration [this] (.getDuration type this)))

  (method ^:protected getXMLGregorianCalendar ^XMLGregorianCalendar [this ^DateTimeData data]
    nil)

  (method ^:protected getDuration ^Duration [this ^DateTimeData data] nil)

  (method ^:protected ^:final getFractionalSecondsAsBigDecimal ^BigDecimal [this ^DateTimeData data]
    (let [^:final buf (StringBuffer.)]
      (.append3 this buf (.-unNormSecond data))
      (let [^:mutable value (.toString buf)
            ^:final index (.indexOf value \.)]
        (when-not (== index -1)
          (set! value (.substring value index))
          (let [^:final _val (BigDecimal. value)]
            (when-not (== (.compareTo _val (BigDecimal/valueOf 0)) 0) _val)))))))

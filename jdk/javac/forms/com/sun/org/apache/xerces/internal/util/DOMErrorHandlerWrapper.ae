  (method ^:private printError ^void [this ^DOMError error]
    (let [^int severity (.getSeverity error)]
      (.print fOut "[")
      (cond
        (== severity DOMError/SEVERITY_WARNING) (.print fOut "Warning")
        (== severity DOMError/SEVERITY_ERROR) (.print fOut "Error")
        :else (do (.print fOut "FatalError") (set! eStatus false)))
      (.print fOut "] ")
      (let [locator (.getLocation error)]
        (when (some? locator)
          (.print fOut (.getLineNumber locator))
          (.print fOut ":")
          (.print fOut (.getColumnNumber locator))
          (.print fOut ":")
          (.print fOut (.getByteOffset locator))
          (.print fOut ",")
          (.print fOut (.getUtf16Offset locator))
          (let [node (.getRelatedNode locator)]
            (when (some? node)
              (.print fOut "[")
              (.print fOut (.getNodeName node))
              (.print fOut "]"))
            (let [^:mutable systemId (.getUri locator)]
              (when (some? systemId)
                (let [index (.lastIndexOf systemId \/)]
                  (when-not (== index -1)
                    (set! systemId (.substring systemId (unchecked-add-int index 1))))
                  (.print fOut ": ")
                  (.print fOut systemId))))))
        (.print fOut ":")
        (.print fOut (.getMessage error))
        (.println fOut)
        (.flush fOut))))


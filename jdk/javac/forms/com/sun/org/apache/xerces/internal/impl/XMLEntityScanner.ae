  (method ^:protected createReader :throws [IOException] ^Reader [this ^InputStream inputStream
                                                                  ^:mutable ^String encoding
                                                                  ^Boolean isBigEndian]
    (when (nil? encoding) (set! encoding "UTF-8"))
    (let [ENCODING (.toUpperCase encoding Locale/ENGLISH)]
      (cond
        (.equals ENCODING "UTF-8")
          (do
            (when DEBUG_ENCODINGS (.println System/out "$$$ creating UTF8Reader"))
            (UTF8Reader. inputStream
                         (.-fBufferSize fCurrentEntity)
                         (.getMessageFormatter fErrorReporter XMLMessageFormatter/XML_DOMAIN)
                         (.getLocale fErrorReporter)))
        (.equals ENCODING "US-ASCII")
          (do
            (when DEBUG_ENCODINGS (.println System/out "$$$ creating ASCIIReader"))
            (ASCIIReader. inputStream
                          (.-fBufferSize fCurrentEntity)
                          (.getMessageFormatter fErrorReporter XMLMessageFormatter/XML_DOMAIN)
                          (.getLocale fErrorReporter)))
        :else
          (do
            (when (.equals ENCODING "ISO-10646-UCS-4")
              (if (some? isBigEndian)
                  (let [isBE (.booleanValue isBigEndian)]
                    (if isBE
                        (return (UCSReader. inputStream UCSReader/UCS4BE))
                        (return (UCSReader. inputStream UCSReader/UCS4LE))))
                  (.reportError fErrorReporter
                                XMLMessageFormatter/XML_DOMAIN
                                "EncodingByteOrderUnsupported"
                                (new Object/1 [encoding])
                                XMLErrorReporter/SEVERITY_FATAL_ERROR)))
            (when (.equals ENCODING "ISO-10646-UCS-2")
              (if (some? isBigEndian)
                  (let [isBE (.booleanValue isBigEndian)]
                    (if isBE
                        (return (UCSReader. inputStream UCSReader/UCS2BE))
                        (return (UCSReader. inputStream UCSReader/UCS2LE))))
                  (.reportError fErrorReporter
                                XMLMessageFormatter/XML_DOMAIN
                                "EncodingByteOrderUnsupported"
                                (new Object/1 [encoding])
                                XMLErrorReporter/SEVERITY_FATAL_ERROR)))
            (let [validIANA (XMLChar/isValidIANAEncoding encoding)
                  validJava (XMLChar/isValidJavaEncoding encoding)]
              (when (or (not validIANA) (and fAllowJavaEncodings (not validJava)))
                (.reportError fErrorReporter
                              XMLMessageFormatter/XML_DOMAIN
                              "EncodingDeclInvalid"
                              (new Object/1 [encoding])
                              XMLErrorReporter/SEVERITY_FATAL_ERROR)
                (set! encoding "ISO-8859-1"))
              (let [^:mutable javaEncoding (EncodingMap/getIANA2JavaMapping ENCODING)]
                (if (nil? javaEncoding)
                    (if fAllowJavaEncodings
                        (set! javaEncoding encoding)
                        (do
                          (.reportError fErrorReporter
                                        XMLMessageFormatter/XML_DOMAIN
                                        "EncodingDeclInvalid"
                                        (new Object/1 [encoding])
                                        XMLErrorReporter/SEVERITY_FATAL_ERROR)
                          (set! javaEncoding "ISO8859_1")))
                    (when (.equals javaEncoding "ASCII")
                      (when DEBUG_ENCODINGS (.println System/out "$$$ creating ASCIIReader"))
                      (return (ASCIIReader. inputStream
                                            fBufferSize
                                            (.getMessageFormatter
                                              fErrorReporter
                                              XMLMessageFormatter/XML_DOMAIN)
                                            (.getLocale fErrorReporter)))))
                (when DEBUG_ENCODINGS
                  (.print System/out
                          (java-str "$$$ creating Java InputStreamReader: encoding=" javaEncoding))
                  (when (identical? javaEncoding encoding) (.print System/out " (IANA encoding)"))
                  (.println System/out))
                (InputStreamReader. inputStream javaEncoding)))))))

  (method ^:protected getEncodingName ^Object/1 [this ^byte/1 b4 ^int count]
    (if (< count 2)
        (new Object/1 ["UTF-8" nil])
        (let [b0 (bit-and-int (aget b4 0) 0xFF)
              b1 (bit-and-int (aget b4 1) 0xFF)]
          (cond
            (and (== b0 0xFE) (== b1 0xFF)) (new Object/1 ["UTF-16BE" true])
            (and (== b0 0xFF) (== b1 0xFE)) (new Object/1 ["UTF-16LE" false])
            (< count 3) (new Object/1 ["UTF-8" nil])
            :else
              (let [b2 (bit-and-int (aget b4 2) 0xFF)]
                (cond
                  (and (and (== b0 0xEF) (== b1 0xBB)) (== b2 0xBF)) (new Object/1 ["UTF-8" nil])
                  (< count 4) (new Object/1 ["UTF-8" nil])
                  :else
                    (let [b3 (bit-and-int (aget b4 3) 0xFF)]
                      (cond
                        (and (and (and (== b0 0x00) (== b1 0x00)) (== b2 0x00)) (== b3 0x3C))
                          (new Object/1 ["ISO-10646-UCS-4" true])
                        (and (and (and (== b0 0x3C) (== b1 0x00)) (== b2 0x00)) (== b3 0x00))
                          (new Object/1 ["ISO-10646-UCS-4" false])
                        (and (and (and (== b0 0x00) (== b1 0x00)) (== b2 0x3C)) (== b3 0x00))
                          (new Object/1 ["ISO-10646-UCS-4" nil])
                        (and (and (and (== b0 0x00) (== b1 0x3C)) (== b2 0x00)) (== b3 0x00))
                          (new Object/1 ["ISO-10646-UCS-4" nil])
                        (and (and (and (== b0 0x00) (== b1 0x3C)) (== b2 0x00)) (== b3 0x3F))
                          (new Object/1 ["UTF-16BE" true])
                        (and (and (and (== b0 0x3C) (== b1 0x00)) (== b2 0x3F)) (== b3 0x00))
                          (new Object/1 ["UTF-16LE" false])
                        (and (and (and (== b0 0x4C) (== b1 0x6F)) (== b2 0xA7)) (== b3 0x94))
                          (new Object/1 ["CP037" nil])
                        :else (new Object/1 ["UTF-8" nil])))))))))

  (method ^:final print ^void [this]
    (when DEBUG_BUFFER
      (if (some? fCurrentEntity)
          (do
            (.print System/out \[)
            (.print System/out (.-count fCurrentEntity))
            (.print System/out \space)
            (.print System/out (.-position fCurrentEntity))
            (when (> (.-count fCurrentEntity) 0)
              (.print System/out " \"")
              (loop [^int i 0]
                (when (< i (.-count fCurrentEntity))
                  (when (== i (.-position fCurrentEntity)) (.print System/out \^))
                  (let [c (aget (.-ch fCurrentEntity) i)]
                    (switch c
                      \newline (do (.print System/out "\\n") (recur (unchecked-inc-int i)))
                      \return (do (.print System/out "\\r") (recur (unchecked-inc-int i)))
                      \tab (do (.print System/out "\\t") (recur (unchecked-inc-int i)))
                      \\ (do (.print System/out "\\\\") (recur (unchecked-inc-int i)))
                      (do (.print System/out c) (recur (unchecked-inc-int i)))))))
              (when (== (.-position fCurrentEntity) (.-count fCurrentEntity))
                (.print System/out \^))
              (.print System/out \"))
            (.print System/out \])
            (.print System/out " @ ")
            (.print System/out (.-lineNumber fCurrentEntity))
            (.print System/out \,)
            (.print System/out (.-columnNumber fCurrentEntity)))
          (.print System/out "*NO CURRENT ENTITY*"))))

  (method ^:public registerListener ^void [this ^XMLBufferListener listener]
    (when-not (.contains listeners listener) (.add listeners listener)))

  (method ^:public invokeListeners ^void [this ^int loadPos]
    (loop [^int i 0]
      (when (< i (.size listeners))
        (.refresh (cast XMLBufferListener (.get listeners i)) loadPos)
        (recur (unchecked-inc-int i)))))

  (method ^:protected ^:final skipDeclSpaces :throws [IOException] ^boolean [this]
    (when DEBUG_BUFFER (.print System/out "(skipDeclSpaces: ") (.println System/out))
    (when (== (.-position fCurrentEntity) (.-count fCurrentEntity)) (.load this 0 true false))
    (let [^:mutable ^int c (aget (.-ch fCurrentEntity) (.-position fCurrentEntity))]
      (if (XMLChar/isSpace c)
          (let [external (.isExternal fCurrentEntity)]
            (loop []
              (let [^:mutable entityChanged false]
                (if (or (== c \newline) (and external (== c \return)))
                    (do
                      (set! (.-lineNumber fCurrentEntity)
                            (unchecked-inc-int (.-lineNumber fCurrentEntity)))
                      (set! (.-columnNumber fCurrentEntity) 1)
                      (when (== (.-position fCurrentEntity)
                                (unchecked-subtract-int (.-count fCurrentEntity) 1))
                        (aset (.-ch fCurrentEntity) 0 (unchecked-char c))
                        (set! entityChanged (.load this 1 true false))
                        (when-not entityChanged (set! (.-position fCurrentEntity) 0)))
                      (when (and (== c \return) external)
                        (when-not (== (aget (.-ch fCurrentEntity)
                                            (set!
                                              (.-position fCurrentEntity)
                                              (unchecked-inc-int (.-position fCurrentEntity))))
                                      \newline)
                          (set! (.-position fCurrentEntity)
                                (unchecked-dec-int (.-position fCurrentEntity))))))
                    (set! (.-columnNumber fCurrentEntity)
                          (unchecked-inc-int (.-columnNumber fCurrentEntity))))
                (when-not entityChanged
                  (set! (.-position fCurrentEntity) (unchecked-inc-int (.-position fCurrentEntity))))
                (when (== (.-position fCurrentEntity) (.-count fCurrentEntity))
                  (.load this 0 true false)))
              (when (XMLChar/isSpace
                      (set! c (aget (.-ch fCurrentEntity) (.-position fCurrentEntity))))
                (recur)))
            (when DEBUG_BUFFER
              (.print System/out ")skipDeclSpaces: ")
              (.println System/out " -> true"))
            true)
          (do
            (when DEBUG_BUFFER
              (.print System/out ")skipDeclSpaces: ")
              (.println System/out " -> false"))
            false))))

  (method ^:protected normalizeNewlines :throws [IOException] ^boolean [this ^short version
                                                                        ^XMLString buffer
                                                                        ^boolean append
                                                                        ^boolean storeWS
                                                                        ^XMLScanner$NameType nt]
    (set! offset (.-position fCurrentEntity))
    (let [^:mutable ^int c (aget (.-ch fCurrentEntity) offset)]
      (set! newlines 0)
      (set! counted false)
      (when (or (or (== c \newline) (== c \return))
                (and (and (== version Constants/XML_VERSION_1_1) (or (== c 0x85) (== c 0x2028)))
                     isExternal))
        (loop []
          (set! c
                (aget (.-ch fCurrentEntity)
                      (let [old-10 (.-position fCurrentEntity)]
                        (set! (.-position fCurrentEntity)
                              (unchecked-inc-int (.-position fCurrentEntity)))
                        old-10)))
          (if (or (or (== c \newline) (== c \return))
                  (and (== version Constants/XML_VERSION_1_1) (or (== c 0x85) (== c 0x2028))))
              (do
                (set! newlines (unchecked-inc-int newlines))
                (set! (.-lineNumber fCurrentEntity)
                      (unchecked-inc-int (.-lineNumber fCurrentEntity)))
                (set! (.-columnNumber fCurrentEntity) 1)
                (when (== (.-position fCurrentEntity) (.-count fCurrentEntity))
                  (.checkEntityLimit this nt fCurrentEntity offset newlines)
                  (set! offset 0)
                  (set! (.-position fCurrentEntity) newlines)
                  (when (.load this newlines false true) (set! counted true) (break)))
                (when (and (== c \return) isExternal)
                  (let [^int cc (aget (.-ch fCurrentEntity) (.-position fCurrentEntity))]
                    (if (or (== cc \newline)
                            (and (== version Constants/XML_VERSION_1_1) (== cc 0x85)))
                        (do
                          (set! (.-position fCurrentEntity)
                                (unchecked-inc-int (.-position fCurrentEntity)))
                          (set! offset (unchecked-inc-int offset)))
                        (set! newlines (unchecked-inc-int newlines))))))
              (do
                (set! (.-position fCurrentEntity) (unchecked-dec-int (.-position fCurrentEntity)))
                (break)))
          (when (< (.-position fCurrentEntity) (unchecked-subtract-int (.-count fCurrentEntity) 1))
            (recur)))
        (loop [^int i offset]
          (when (< i (.-position fCurrentEntity))
            (aset (.-ch fCurrentEntity) i \newline)
            (if storeWS
                (do (.storeWhiteSpace this i) (recur (unchecked-inc-int i)))
                (recur (unchecked-inc-int i)))))
        (let [length (unchecked-subtract-int (.-position fCurrentEntity) offset)]
          (when (== (.-position fCurrentEntity) (unchecked-subtract-int (.-count fCurrentEntity) 1))
            (.checkEntityLimit this nt fCurrentEntity offset length)
            (if append
                (.append buffer (.-ch fCurrentEntity) offset length)
                (.setValues buffer (.-ch fCurrentEntity) offset length))
            (return true))))
      false)))

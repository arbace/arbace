              (when-not (== count 0)
                (set! (.-fLastCount fCurrentEntity) count)
                (set! (.-count fCurrentEntity) (unchecked-add-int count offset))
                (set! (.-position fCurrentEntity) offset))
              (do
                (set! (.-count fCurrentEntity) offset)
                (set! (.-position fCurrentEntity) offset)

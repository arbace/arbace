        T_LOOKAHEAD (return (.processLookahead this))
        T_NEGATIVELOOKAHEAD (return (.processNegativelookahead this))
        T_LOOKBEHIND (return (.processLookbehind this))
        T_NEGATIVELOOKBEHIND (return (.processNegativelookbehind this))
        T_COMMENT (do (.next this) (return (Token/createEmpty)))
        T_BACKSOLIDUS
          (switch (.-chardata this)
            \A (return (.processBacksolidus_A this))
            \Z (return (.processBacksolidus_Z this))
            \z (return (.processBacksolidus_z this))
            \b (return (.processBacksolidus_b this))
            \B (return (.processBacksolidus_B this))
            \< (return (.processBacksolidus_lt this))
            \> (return (.processBacksolidus_gt this))))
      (set! tok (.parseAtom this))
      (set! ch (.read this))
      (switch ch
        T_STAR (return (.processStar this tok))
        T_PLUS (return (.processPlus this tok))
        T_QUESTION (return (.processQuestion this tok))
        T_CHAR
          (when (and (== (.-chardata this) \{) (< (.-offset this) (.-regexlen this)))
            (let [^:mutable off (.-offset this)
                  ^:mutable ^int min 0
                  ^:mutable ^int max -1]
              (if (and (>= (set! ch
                                 (.charAt
                                   (.-regex this)
                                   (let [old-9 off] (set! off (unchecked-inc-int off)) old-9)))
                           \0)
                       (<= ch \9))
                  (do
                    (set! min (unchecked-subtract-int ch \0))
                    (while (and (and (< off (.-regexlen this))
                                     (>= (set! ch
                                               (.charAt
                                                 (.-regex this)
                                                 (let [old-10 off]
                                                   (set! off (unchecked-inc-int off))
                                                   old-10)))
                                         \0))
                                (<= ch \9))
                      (set! min
                            (unchecked-subtract-int
                              (unchecked-add-int (unchecked-multiply-int min 10) ch)
                              \0))
                      (when (< min 0) (throw (.ex this "parser.quantifier.5" (.-offset this))))))
                  (throw (.ex this "parser.quantifier.1" (.-offset this))))
              (set! max min)
              (when (== ch \,)
                (cond
                  (>= off (.-regexlen this))
                    (throw (.ex this "parser.quantifier.3" (.-offset this)))
                  (and (>= (set! ch
                                 (.charAt (.-regex this)
                                          (let [old-11 off]
                                            (set! off (unchecked-inc-int off))
                                            old-11)))
                           \0)
                       (<= ch \9))
                    (do
                      (set! max (unchecked-subtract-int ch \0))
                      (while (and (and (< off (.-regexlen this))
                                       (>= (set!
                                             ch
                                             (.charAt
                                               (.-regex this)
                                               (let [old-12 off]
                                                 (set! off (unchecked-inc-int off))
                                                 old-12)))
                                           \0))
                                  (<= ch \9))
                        (set! max
                              (unchecked-subtract-int
                                (unchecked-add-int (unchecked-multiply-int max 10) ch)
                                \0))
                        (when (< max 0) (throw (.ex this "parser.quantifier.5" (.-offset this)))))
                      (when (> min max) (throw (.ex this "parser.quantifier.4" (.-offset this)))))
                  :else (set! max -1)))
              (when-not (== ch \}) (throw (.ex this "parser.quantifier.2" (.-offset this))))
              (if (.checkQuestion this off)
                  (do
                    (set! tok (Token/createNGClosure tok))
                    (set! (.-offset this) (unchecked-add-int off 1)))
                  (do (set! tok (Token/createClosure tok)) (set! (.-offset this) off)))
              (.setMin tok min)
              (.setMax tok max)
              (.next this))))
      tok))

  (method parseAtom :throws [ParseException] ^Token [this]
    (let [ch (.read this)
          ^:mutable ^Token tok nil]
      (switch ch
        T_LPAREN (return (.processParen this))
        T_LPAREN2 (return (.processParen2 this))
        T_CONDITION (return (.processCondition this))
        T_MODIFIERS (return (.processModifiers this))
        T_INDEPENDENT (return (.processIndependent this))
        T_DOT (do (.next this) (set! tok Token/token_dot))
        T_LBRACKET (return (.parseCharacterClass this true))
        T_SET_OPERATIONS (return (.parseSetOperations this))
        T_BACKSOLIDUS
          (do
            (switch (.-chardata this)
              (\d \D \w \W \s \S)
                (do
                  (set! tok (.getTokenForShorthand this (.-chardata this)))
                  (.next this)
                  (return tok))
              (\e \f \n \r \t \u \v \x)
                (let [ch2 (.decodeEscaped this)]
                  (if (< ch2 0x10000)
                      (set! tok (Token/createChar ch2))
                      (set! tok (Token/createString (REUtil/decomposeToSurrogates ch2)))))
              \c (return (.processBacksolidus_c this))
              \C (return (.processBacksolidus_C this))
              \i (return (.processBacksolidus_i this))
              \I (return (.processBacksolidus_I this))
              \g (return (.processBacksolidus_g this))
              \X (return (.processBacksolidus_X this))
              (\1 \2 \3 \4 \5 \6 \7 \8 \9) (return (.processBackreference this))
              (\P \p)
                (let [pstart (.-offset this)]
                  (set! tok (.processBacksolidus_pP this (.-chardata this)))
                  (when (nil? tok) (throw (.ex this "parser.atom.5" pstart))))
              (set! tok (Token/createChar (.-chardata this))))
            (.next this))
        T_CHAR
          (do
            (when (or (or (== (.-chardata this) \]) (== (.-chardata this) \{))
                      (== (.-chardata this) \}))
              (throw (.ex this "parser.atom.4" (unchecked-subtract-int (.-offset this) 1))))
            (set! tok (Token/createChar (.-chardata this)))
            (let [high (.-chardata this)]
              (.next this)
              (when (and (and (REUtil/isHighSurrogate high) (== (.read this) T_CHAR))
                         (REUtil/isLowSurrogate (.-chardata this)))
                (let [sur (new char/1 2)]
                  (aset sur 0 (unchecked-char high))
                  (aset sur 1 (unchecked-char (.-chardata this)))
                  (set! tok (Token/createParen (Token/createString (String. sur)) 0))
                  (.next this)))))
        (throw (.ex this "parser.atom.4" (unchecked-subtract-int (.-offset this) 1))))
      tok))

  (method ^:protected processBacksolidus_pP :throws [ParseException] ^RangeToken [this ^int c]
    (.next this)
    (when (or (not (== (.read this) T_CHAR)) (not (== (.-chardata this) \{)))
      (throw (.ex this "parser.atom.2" (unchecked-subtract-int (.-offset this) 1))))
    (let [positive (== c \p)
          namestart (.-offset this)
          nameend (.indexOf (.-regex this) \} namestart)]
      (when (< nameend 0) (throw (.ex this "parser.atom.3" (.-offset this))))
      (let [pname (.substring (.-regex this) namestart nameend)]
        (set! (.-offset this) (unchecked-add-int nameend 1))
        (Token/getRange pname positive (.isSet this RegularExpression/XMLSCHEMA_MODE)))))

  (method processCIinCharacterClass ^int [this ^RangeToken tok ^int c]
    (.decodeEscaped this))

  (method ^:protected parseCharacterClass :throws [ParseException] ^RangeToken [this
                                                                                ^boolean useNrange]
    (.setContext this S_INBRACKETS)
    (.next this)
    (let [^:mutable nrange false
          ^:mutable ^RangeToken base nil
          ^:mutable ^RangeToken tok nil]
      (if (and (== (.read this) T_CHAR) (== (.-chardata this) \^))
          (do
            (set! nrange true)
            (.next this)
            (if useNrange
                (set! tok (Token/createNRange))
                (do
                  (set! base (Token/createRange))
                  (.addRange base 0 Token/UTF16_MAX)
                  (set! tok (Token/createRange)))))
          (set! tok (Token/createRange)))
      (let [^:mutable ^int type 0
            ^:mutable firstloop true]
        (while (not (== (set! type (.read this)) T_EOF))
          (when (and (and (== type T_CHAR) (== (.-chardata this) \])) (not firstloop)) (break))
          (let [^:mutable c (.-chardata this)
                ^:mutable end false]
            (cond
              (== type T_BACKSOLIDUS)
                (switch c
                  (\d \D \w \W \s \S)
                    (do (.mergeRanges tok (.getTokenForShorthand this c)) (set! end true))
                  (\i \I \c \C)
                    (do
                      (set! c (.processCIinCharacterClass this tok c))
                      (when (< c 0) (set! end true)))
                  (\p \P)
                    (let [pstart (.-offset this)
                          tok2 (.processBacksolidus_pP this c)]
                      (when (nil? tok2) (throw (.ex this "parser.atom.5" pstart)))
                      (.mergeRanges tok tok2)
                      (set! end true))
                  (set! c (.decodeEscaped this)))
              (== type T_POSIX_CHARCLASS_START)
                (let [nameend (.indexOf (.-regex this) \: (.-offset this))]
                  (when (< nameend 0) (throw (.ex this "parser.cc.1" (.-offset this))))
                  (let [^:mutable positive true]
                    (when (== (.charAt (.-regex this) (.-offset this)) \^)
                      (set! (.-offset this) (unchecked-inc-int (.-offset this)))
                      (set! positive false))
                    (let [name (.substring (.-regex this) (.-offset this) nameend)
                          range (Token/getRange name
                                                positive
                                                (.isSet this RegularExpression/XMLSCHEMA_MODE))]
                      (when (nil? range) (throw (.ex this "parser.cc.3" (.-offset this))))
                      (.mergeRanges tok range)
                      (set! end true)
                      (when (or
                              (>= (unchecked-add-int nameend 1) (.-regexlen this))
                              (not (== (.charAt (.-regex this) (unchecked-add-int nameend 1)) \])))
                        (throw (.ex this "parser.cc.1" nameend)))
                      (set! (.-offset this) (unchecked-add-int nameend 2)))))
              :else
                (when (and (== type T_XMLSCHEMA_CC_SUBTRACTION) (not firstloop))
                  (when nrange
                    (set! nrange false)
                    (if useNrange
                        (set! tok (cast RangeToken (Token/complementRanges tok)))
                        (do (.subtractRanges base tok) (set! tok base))))
                  (let [range2 (.parseCharacterClass this false)]
                    (.subtractRanges tok range2)
                    (when (or (not (== (.read this) T_CHAR)) (not (== (.-chardata this) \])))
                      (throw (.ex this "parser.cc.5" (.-offset this))))
                    (break))))
            (.next this)
            (when-not end
              (cond
                (or (not (== (.read this) T_CHAR)) (not (== (.-chardata this) \-)))
                  (if (or (not (.isSet this RegularExpression/IGNORE_CASE)) (> c 0xffff))
                      (.addRange tok c c)
                      (RegexParser/addCaseInsensitiveChar tok c))
                (== type T_XMLSCHEMA_CC_SUBTRACTION)
                  (throw (.ex this "parser.cc.8" (unchecked-subtract-int (.-offset this) 1)))
                :else
                  (do
                    (.next this)
                    (when (== (set! type (.read this)) T_EOF)
                      (throw (.ex this "parser.cc.2" (.-offset this))))
                    (if (and (== type T_CHAR) (== (.-chardata this) \]))
                        (do
                          (if (or (not (.isSet this RegularExpression/IGNORE_CASE)) (> c 0xffff))
                              (.addRange tok c c)
                              (RegexParser/addCaseInsensitiveChar tok c))
                          (.addRange tok \- \-))
                        (let [^:mutable rangeend (.-chardata this)]
                          (when (== type T_BACKSOLIDUS) (set! rangeend (.decodeEscaped this)))
                          (.next this)
                          (when (> c rangeend)
                            (throw (.ex this
                                        "parser.ope.3"
                                        (unchecked-subtract-int (.-offset this) 1))))
                          (if (or (not (.isSet this RegularExpression/IGNORE_CASE))
                                  (and (> c 0xffff) (> rangeend 0xffff)))
                              (.addRange tok c rangeend)
                              (RegexParser/addCaseInsensitiveCharRange tok c rangeend)))))))
            (when (and (and (.isSet this RegularExpression/SPECIAL_COMMA) (== (.read this) T_CHAR))
                       (== (.-chardata this) \,))
              (.next this))
            (set! firstloop false)))
        (when (== (.read this) T_EOF) (throw (.ex this "parser.cc.2" (.-offset this))))
        (when (and (not useNrange) nrange) (.subtractRanges base tok) (set! tok base))
        (.sortRanges tok)
        (.compactRanges tok)
        (.setContext this S_NORMAL)
        (.next this)
        tok)))

  (method ^:protected parseSetOperations :throws [ParseException] ^RangeToken [this]
    (let [tok (.parseCharacterClass this false)
          ^:mutable ^int type 0]
      (while (not (== (set! type (.read this)) T_RPAREN))
        (let [ch (.-chardata this)]
          (if (or (and (== type T_CHAR) (or (== ch \-) (== ch \&))) (== type T_PLUS))
              (do
                (.next this)
                (when-not (== (.read this) T_LBRACKET)
                  (throw (.ex this "parser.ope.1" (unchecked-subtract-int (.-offset this) 1))))
                (let [t2 (.parseCharacterClass this false)]
                  (cond
                    (== type T_PLUS) (.mergeRanges tok t2)
                    (== ch \-) (.subtractRanges tok t2)
                    (== ch \&) (.intersectRanges tok t2)
                    :else (throw (RuntimeException. "ASSERT")))))
              (throw (.ex this "parser.ope.2" (unchecked-subtract-int (.-offset this) 1))))))
      (.next this)
      tok))

  (method getTokenForShorthand ^Token [this ^int ch]
    (let [^:mutable ^Token tok nil]
      (switch ch
        \d
          (set! tok
                (if (.isSet this RegularExpression/USE_UNICODE_CATEGORY)
                    ^Token (Token/getRange "Nd" true)
                    Token/token_0to9))
        \D
          (set! tok
                (if (.isSet this RegularExpression/USE_UNICODE_CATEGORY)
                    ^Token (Token/getRange "Nd" false)
                    Token/token_not_0to9))
        \w
          (set! tok
                (if (.isSet this RegularExpression/USE_UNICODE_CATEGORY)
                    ^Token (Token/getRange "IsWord" true)
                    Token/token_wordchars))
        \W
          (set! tok
                (if (.isSet this RegularExpression/USE_UNICODE_CATEGORY)
                    ^Token (Token/getRange "IsWord" false)
                    Token/token_not_wordchars))
        \s
          (set! tok
                (if (.isSet this RegularExpression/USE_UNICODE_CATEGORY)
                    ^Token (Token/getRange "IsSpace" true)
                    Token/token_spaces))
        \S
          (set! tok
                (if (.isSet this RegularExpression/USE_UNICODE_CATEGORY)
                    ^Token (Token/getRange "IsSpace" false)
                    Token/token_not_spaces))
        (throw (RuntimeException.
                 (java-str "Internal Error: shorthands: \\u" (Integer/toString ch 16)))))
      tok))

  (method decodeEscaped :throws [ParseException] ^int [this]
    (when-not (== (.read this) T_BACKSOLIDUS)
      (throw (.ex this "parser.next.1" (unchecked-subtract-int (.-offset this) 1))))
    (let [^:mutable c (.-chardata this)]
      (let [^:mutable ^int v1 0
            ^:mutable ^int uv 0]
        (switch c
          \e (set! c 0x1b)
          \f (set! c \formfeed)
          \n (set! c \newline)
          \r (set! c \return)
          \t (set! c \tab)
          \x
            (do
              (.next this)
              (when-not (== (.read this) T_CHAR)
                (throw (.ex this "parser.descape.1" (unchecked-subtract-int (.-offset this) 1))))
              (if (== (.-chardata this) \{)
                  (let [^:mutable ^int v1 0
                        ^:mutable ^int uv 0]
                    (loop []
                      (.next this)
                      (when-not (== (.read this) T_CHAR)
                        (throw (.ex this
                                    "parser.descape.1"
                                    (unchecked-subtract-int (.-offset this) 1))))
                      (when (< (set! v1 (RegexParser/hexChar (.-chardata this))) 0) (break))
                      (when (> uv (unchecked-multiply-int uv 16))
                        (throw (.ex this
                                    "parser.descape.2"
                                    (unchecked-subtract-int (.-offset this) 1))))
                      (set! uv (unchecked-add-int (unchecked-multiply-int uv 16) v1))
                      (when true (recur)))
                    (when-not (== (.-chardata this) \})
                      (throw (.ex this
                                  "parser.descape.3"
                                  (unchecked-subtract-int (.-offset this) 1))))
                    (when (> uv Token/UTF16_MAX)
                      (throw (.ex this
                                  "parser.descape.4"
                                  (unchecked-subtract-int (.-offset this) 1))))
                    (set! c uv))
                  (let [^:mutable ^int v1 0]
                    (when (or (not (== (.read this) T_CHAR))
                              (< (set! v1 (RegexParser/hexChar (.-chardata this))) 0))
                      (throw (.ex this
                                  "parser.descape.1"
                                  (unchecked-subtract-int (.-offset this) 1))))
                    (let [^:mutable uv v1]
                      (.next this)
                      (when (or (not (== (.read this) T_CHAR))
                                (< (set! v1 (RegexParser/hexChar (.-chardata this))) 0))
                        (throw (.ex this
                                    "parser.descape.1"
                                    (unchecked-subtract-int (.-offset this) 1))))
                      (set! uv (unchecked-add-int (unchecked-multiply-int uv 16) v1))
                      (set! c uv)))))
          \u
            (do
              (set! v1 0)
              (.next this)
              (when (or (not (== (.read this) T_CHAR))
                        (< (set! v1 (RegexParser/hexChar (.-chardata this))) 0))
                (throw (.ex this "parser.descape.1" (unchecked-subtract-int (.-offset this) 1))))
              (set! uv v1)
              (.next this)
              (when (or (not (== (.read this) T_CHAR))
                        (< (set! v1 (RegexParser/hexChar (.-chardata this))) 0))
                (throw (.ex this "parser.descape.1" (unchecked-subtract-int (.-offset this) 1))))
              (set! uv (unchecked-add-int (unchecked-multiply-int uv 16) v1))
              (.next this)
              (when (or (not (== (.read this) T_CHAR))
                        (< (set! v1 (RegexParser/hexChar (.-chardata this))) 0))
                (throw (.ex this "parser.descape.1" (unchecked-subtract-int (.-offset this) 1))))
              (set! uv (unchecked-add-int (unchecked-multiply-int uv 16) v1))
              (.next this)
              (when (or (not (== (.read this) T_CHAR))
                        (< (set! v1 (RegexParser/hexChar (.-chardata this))) 0))
                (throw (.ex this "parser.descape.1" (unchecked-subtract-int (.-offset this) 1))))
              (set! uv (unchecked-add-int (unchecked-multiply-int uv 16) v1))
              (set! c uv))
          \v
            (do
              (.next this)
              (when (or (not (== (.read this) T_CHAR))
                        (< (set! v1 (RegexParser/hexChar (.-chardata this))) 0))
                (throw (.ex this "parser.descape.1" (unchecked-subtract-int (.-offset this) 1))))
              (set! uv v1)
              (.next this)
              (when (or (not (== (.read this) T_CHAR))
                        (< (set! v1 (RegexParser/hexChar (.-chardata this))) 0))
                (throw (.ex this "parser.descape.1" (unchecked-subtract-int (.-offset this) 1))))
              (set! uv (unchecked-add-int (unchecked-multiply-int uv 16) v1))
              (.next this)
              (when (or (not (== (.read this) T_CHAR))
                        (< (set! v1 (RegexParser/hexChar (.-chardata this))) 0))
                (throw (.ex this "parser.descape.1" (unchecked-subtract-int (.-offset this) 1))))
              (set! uv (unchecked-add-int (unchecked-multiply-int uv 16) v1))
              (.next this)
              (when (or (not (== (.read this) T_CHAR))
                        (< (set! v1 (RegexParser/hexChar (.-chardata this))) 0))
                (throw (.ex this "parser.descape.1" (unchecked-subtract-int (.-offset this) 1))))
              (set! uv (unchecked-add-int (unchecked-multiply-int uv 16) v1))
              (.next this)
              (when (or (not (== (.read this) T_CHAR))
                        (< (set! v1 (RegexParser/hexChar (.-chardata this))) 0))
                (throw (.ex this "parser.descape.1" (unchecked-subtract-int (.-offset this) 1))))
              (set! uv (unchecked-add-int (unchecked-multiply-int uv 16) v1))
              (.next this)
              (when (or (not (== (.read this) T_CHAR))
                        (< (set! v1 (RegexParser/hexChar (.-chardata this))) 0))
                (throw (.ex this "parser.descape.1" (unchecked-subtract-int (.-offset this) 1))))
              (set! uv (unchecked-add-int (unchecked-multiply-int uv 16) v1))
              (when (> uv Token/UTF16_MAX)
                (throw (.ex this "parser.descappe.4" (unchecked-subtract-int (.-offset this) 1))))
              (set! c uv))
          (\A \Z \z)
            (throw (.ex this "parser.descape.5" (unchecked-subtract-int (.-offset this) 2)))
          nil))
      c))

  (method ^:private ^:static ^:final hexChar ^int [^int ch]
    (cond
      (< ch \0) -1
      (> ch \f) -1
      (<= ch \9) (unchecked-subtract-int ch \0)
      (< ch \A) -1
      (<= ch \F) (unchecked-add-int (unchecked-subtract-int ch \A) 10)
      (< ch \a) -1
      :else (unchecked-add-int (unchecked-subtract-int ch \a) 10)))

  (method ^:protected ^:static ^:final addCaseInsensitiveChar ^void [^RangeToken tok ^int c]
    (let [^:final caseMap (CaseInsensitiveMap/get c)]
      (.addRange tok c c)
      (when (some? caseMap)
        (loop [^int i 0]
          (when (< i (alength caseMap))
            (.addRange tok (aget caseMap i) (aget caseMap i))
            (recur (unchecked-add-int i 2)))))))

  (method ^:protected ^:static ^:final addCaseInsensitiveCharRange ^void [^RangeToken tok ^int start
                                                                          ^int end]
    (let [^:mutable ^int/1 caseMap nil
          ^:mutable ^int r1 0
          ^:mutable ^int r2 0]
      (if (<= start end) (do (set! r1 start) (set! r2 end)) (do (set! r1 end) (set! r2 start)))
      (.addRange tok r1 r2)
      (loop [^int ch r1]
        (when (<= ch r2)
          (set! caseMap (CaseInsensitiveMap/get ch))
          (if (some? caseMap)
              (do
                (loop [^int i 0]
                  (when (< i (alength caseMap))
                    (.addRange tok (aget caseMap i) (aget caseMap i))
                    (recur (unchecked-add-int i 2))))
                (recur (unchecked-inc-int ch)))
              (recur (unchecked-inc-int ch))))))))

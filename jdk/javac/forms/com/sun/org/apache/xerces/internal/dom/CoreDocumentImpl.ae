  (method ^:private writeObject :throws [IOException] ^void [this ^ObjectOutputStream out]
    (let [^:mutable ^{:tag (Hashtable Node (Hashtable String ParentNode$UserDataRecord))} nud nil]
      (when (some? nodeUserData)
        (set! nud (Hashtable.))
        (for-each [^{:tag (Map$Entry Node (Map String ParentNode$UserDataRecord))} e (.entrySet
                                                                                       nodeUserData)]
          (.put nud (cast Node (.getKey e)) (Hashtable. (cast Map (.getValue e))))))
      (let [^{:tag (Hashtable String Node)} ids (when (some? identifiers) (Hashtable. identifiers))
            ^{:tag (Hashtable Node Integer)} nt (when (some? nodeTable) (Hashtable. nodeTable))
            pf (.putFields out)]
        (.put pf "docType" docType)
        (.put pf "docElement" docElement)
        (.put pf "fFreeNLCache" fFreeNLCache)
        (.put pf "encoding" encoding)
        (.put pf "actualEncoding" actualEncoding)
        (.put pf "version" version)
        (.put pf "standalone" standalone)
        (.put pf "fDocumentURI" fDocumentURI)
        (.put pf "userData" nud)
        (.put pf "identifiers" ids)
        (.put pf "changes" changes)
        (.put pf "allowGrammarAccess" allowGrammarAccess)
        (.put pf "errorChecking" errorChecking)
        (.put pf "ancestorChecking" ancestorChecking)
        (.put pf "xmlVersionChanged" xmlVersionChanged)
        (.put pf "documentNumber" documentNumber)
        (.put pf "nodeCounter" nodeCounter)
        (.put pf "nodeTable" nt)
        (.put pf "xml11Version" xml11Version)
        (.writeFields out))))

  (method ^:private readObject :throws [IOException ClassNotFoundException] ^void [this
                                                                                   ^ObjectInputStream in]
    (let [gf (.readFields in)]
      (set! docType (cast DocumentTypeImpl (.get gf "docType" nil)))
      (set! docElement (cast ElementImpl (.get gf "docElement" nil)))
      (set! fFreeNLCache (cast NodeListCache (.get gf "fFreeNLCache" nil)))
      (set! encoding (cast String (.get gf "encoding" nil)))
      (set! actualEncoding (cast String (.get gf "actualEncoding" nil)))
      (set! version (cast String (.get gf "version" nil)))
      (set! standalone (.get gf "standalone" false))
      (set! fDocumentURI (cast String (.get gf "fDocumentURI" nil)))
      (let [^{:tag (Hashtable Node (Hashtable String ParentNode$UserDataRecord))} nud (cast
                                                                                        Hashtable
                                                                                        (.get
                                                                                          gf
                                                                                          "userData"
                                                                                          nil))
            ^{:tag (Hashtable String Node)} ids (cast Hashtable (.get gf "identifiers" nil))]
        (set! changes (^[String int] ObjectInputStream$GetField/.get gf "changes" 0))
        (set! allowGrammarAccess (.get gf "allowGrammarAccess" false))
        (set! errorChecking (.get gf "errorChecking" true))
        (set! ancestorChecking (.get gf "ancestorChecking" true))
        (set! xmlVersionChanged (.get gf "xmlVersionChanged" false))
        (set! documentNumber (^[String int] ObjectInputStream$GetField/.get gf "documentNumber" 0))
        (set! nodeCounter (^[String int] ObjectInputStream$GetField/.get gf "nodeCounter" 0))
        (let [^{:tag (Hashtable Node Integer)} nt (cast Hashtable (.get gf "nodeTable" nil))]
          (set! xml11Version (.get gf "xml11Version" false))
          (when (some? nud)
            (set! nodeUserData (HashMap.))
            (for-each [^{:tag (Map$Entry Node (Hashtable String ParentNode$UserDataRecord))} e
                         (.entrySet nud)]
              (.put nodeUserData (cast Node (.getKey e)) (HashMap. (cast Map (.getValue e))))))
          (when (some? ids) (set! identifiers (HashMap. ids)))
          (when (some? nt) (set! nodeTable (HashMap. nt))))))))

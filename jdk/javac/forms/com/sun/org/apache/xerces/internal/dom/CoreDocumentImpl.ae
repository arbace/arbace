                  (let [attr (cast AttrImpl source)]
                    (if (.hasStringValue attr)
                        (let [newattr (cast AttrImpl newnode)]
                          (.setValue newattr (.getValue attr))
                          (set! deep false))
                        (set! deep true)))
                (nil? (.getFirstChild source))
                  (do (.setNodeValue newnode (.getNodeValue source)) (set! deep false))
                :else (set! deep true)))
          CoreDocumentImpl/TEXT_NODE (set! newnode (.createTextNode this (.getNodeValue source)))
          CoreDocumentImpl/CDATA_SECTION_NODE
            (set! newnode (.createCDATASection this (.getNodeValue source)))
          CoreDocumentImpl/ENTITY_REFERENCE_NODE
            (do
              (set! newnode (.createEntityReference this (.getNodeName source)))
              (set! deep false))
          CoreDocumentImpl/ENTITY_NODE
            (let [srcentity (cast Entity source)
                  newentity (cast EntityImpl (.createEntity this (.getNodeName source)))]
              (.setPublicId newentity (.getPublicId srcentity))
              (.setSystemId newentity (.getSystemId srcentity))
              (.setNotationName newentity (.getNotationName srcentity))
              (.isReadOnly newentity false)
              (set! newnode newentity))
          CoreDocumentImpl/PROCESSING_INSTRUCTION_NODE
            (set! newnode
                  (.createProcessingInstruction this (.getNodeName source) (.getNodeValue source)))
          CoreDocumentImpl/COMMENT_NODE (set! newnode (.createComment this (.getNodeValue source)))
          CoreDocumentImpl/DOCUMENT_TYPE_NODE
            (do
              (when-not cloningDoc
                (let [msg (DOMMessageFormatter/formatMessage
                            DOMMessageFormatter/DOM_DOMAIN
                            "NOT_SUPPORTED_ERR"
                            nil)]
                  (throw (DOMException. DOMException/NOT_SUPPORTED_ERR msg))))
              (let [srcdoctype (cast DocumentType source)
                    newdoctype (cast DocumentTypeImpl
                                     (.createDocumentType
                                       this
                                       (.getNodeName srcdoctype)
                                       (.getPublicId srcdoctype)
                                       (.getSystemId srcdoctype)))
                    ^:mutable smap (.getEntities srcdoctype)
                    ^:mutable tmap (.getEntities newdoctype)]
                (when (some? smap)
                  (loop [^int i 0]
                    (when (< i (.getLength smap))
                      (.setNamedItem
                        tmap
                        (.importNode this (.item smap i) true true reversedIdentifiers))
                      (recur (unchecked-inc-int i)))))
                (set! smap (.getNotations srcdoctype))
                (set! tmap (.getNotations newdoctype))
                (when (some? smap)
                  (loop [^int i 0]
                    (when (< i (.getLength smap))
                      (.setNamedItem
                        tmap
                        (.importNode this (.item smap i) true true reversedIdentifiers))
                      (recur (unchecked-inc-int i)))))
                (set! newnode newdoctype)))
          CoreDocumentImpl/DOCUMENT_FRAGMENT_NODE (set! newnode (.createDocumentFragment this))
          CoreDocumentImpl/NOTATION_NODE
            (let [srcnotation (cast Notation source)
                  newnotation (cast NotationImpl (.createNotation this (.getNodeName source)))]
              (.setPublicId newnotation (.getPublicId srcnotation))
              (.setSystemId newnotation (.getSystemId srcnotation))
              (set! newnode newnotation))
          (let [msg (DOMMessageFormatter/formatMessage
                      DOMMessageFormatter/DOM_DOMAIN
                      "NOT_SUPPORTED_ERR"
                      nil)]
            (throw (DOMException. DOMException/NOT_SUPPORTED_ERR msg))))
        (when (some? userData)
          (.callUserDataHandlers this source newnode UserDataHandler/NODE_IMPORTED userData))
        (when deep
          (loop [srckid (.getFirstChild source)]
            (when (some? srckid)
              (.appendChild newnode (.importNode this srckid true cloningDoc reversedIdentifiers))
              (recur (.getNextSibling srckid)))))
        (when (== (.getNodeType newnode) Node/ENTITY_NODE)
          (.setReadOnly (cast NodeImpl newnode) true true))
        newnode)))

  (method ^:public adoptNode ^Node [this ^Node source]
    (let [^:mutable ^NodeImpl node nil
          ^:mutable ^{:tag (Map String ParentNode$UserDataRecord)} userData nil]
      (try (set! node (cast NodeImpl source)) (catch ClassCastException e (return nil)))
      (when (some? source)
        (when (some? (.getOwnerDocument source))
          (let [thisImpl (.getImplementation this)
                otherImpl (.getImplementation (.getOwnerDocument source))]
            (cond
              (not (identical? thisImpl otherImpl))
                (if (and (instance? DOMImplementationImpl thisImpl)
                         (instance? DeferredDOMImplementationImpl otherImpl))
                    (.undeferChildren this node)
                    (when-not (and (instance? DeferredDOMImplementationImpl thisImpl)
                                   (instance? DOMImplementationImpl otherImpl))
                      (return nil)))
              (instance? DeferredDOMImplementationImpl otherImpl) (.undeferChildren this node))))
        (switch (.getNodeType node)
          CoreDocumentImpl/ATTRIBUTE_NODE
            (let [attr (cast AttrImpl node)]
              (when (some? (.getOwnerElement attr))
                (.removeAttributeNode (.getOwnerElement attr) attr))
              (.isSpecified attr true)
              (set! userData (.getUserDataRecord node))
              (.setOwnerDocument attr this)
              (when (some? userData) (.setUserDataTable this node userData)))
          (CoreDocumentImpl/ENTITY_NODE CoreDocumentImpl/NOTATION_NODE)
            (let [msg (DOMMessageFormatter/formatMessage
                        DOMMessageFormatter/DOM_DOMAIN
                        "NO_MODIFICATION_ALLOWED_ERR"
                        nil)]
              (throw (DOMException. DOMException/NO_MODIFICATION_ALLOWED_ERR msg)))
          (CoreDocumentImpl/DOCUMENT_NODE CoreDocumentImpl/DOCUMENT_TYPE_NODE)
            (let [msg (DOMMessageFormatter/formatMessage
                        DOMMessageFormatter/DOM_DOMAIN
                        "NOT_SUPPORTED_ERR"
                        nil)]
              (throw (DOMException. DOMException/NOT_SUPPORTED_ERR msg)))
          CoreDocumentImpl/ENTITY_REFERENCE_NODE
            (do
              (set! userData (.getUserDataRecord node))
              (let [parent (.getParentNode node)]
                (when (some? parent) (.removeChild parent source))
                (let [^:mutable ^Node child nil]
                  (while (some? (set! child (.getFirstChild node))) (.removeChild node child))
                  (.setOwnerDocument node this)
                  (when (some? userData) (.setUserDataTable this node userData))
                  (when (some? docType)
                    (let [entities (.getEntities docType)
                          entityNode (.getNamedItem entities (.getNodeName node))]
                      (when (some? entityNode)
                        (set! child (.getFirstChild entityNode))
                        (while (some? child)
                          (let [childClone (.cloneNode child true)] (.appendChild node childClone))
                          (set! child (.getNextSibling child)))))))))
          CoreDocumentImpl/ELEMENT_NODE
            (do
              (set! userData (.getUserDataRecord node))
              (let [parent (.getParentNode node)]
                (when (some? parent) (.removeChild parent source))
                (.setOwnerDocument node this)
                (when (some? userData) (.setUserDataTable this node userData))
                (.reconcileDefaultAttributes (cast ElementImpl node))))
          (do
            (set! userData (.getUserDataRecord node))
            (let [parent (.getParentNode node)]
              (when (some? parent) (.removeChild parent source))
              (.setOwnerDocument node this)
              (when (some? userData) (.setUserDataTable this node userData)))))
        (when (some? userData)
          (.callUserDataHandlers this source nil UserDataHandler/NODE_ADOPTED userData))
        node)))

  (method ^:protected undeferChildren ^void [this ^:mutable ^Node node]
    (let [top node]
      (while (some? node)
        (when (.needsSyncData (cast NodeImpl node)) (.synchronizeData (cast NodeImpl node)))
        (let [attributes (.getAttributes node)]
          (when (some? attributes)
            (let [length (.getLength attributes)]
              (loop [^int i 0]
                (when (< i length)
                  (.undeferChildren this (.item attributes i))
                  (recur (unchecked-inc-int i))))))
          (let [^:mutable ^Node nextNode nil]
            (set! nextNode (.getFirstChild node))
            (while (nil? nextNode)
              (when (.equals top node) (break))
              (set! nextNode (.getNextSibling node))
              (when (nil? nextNode)
                (set! node (.getParentNode node))
                (when (or (nil? node) (.equals top node)) (set! nextNode nil) (break))))
            (set! node nextNode))))))

  (method ^:public getElementById ^Element [this ^String elementId]
    (.getIdentifier this elementId))

  (method ^:protected ^:final clearIdentifiers ^void [this]
    (when (some? identifiers) (.clear identifiers)))

  (method ^:public putIdentifier ^void [this ^String idName ^Element element]
    (if (nil? element)
        (.removeIdentifier this idName)
        (do
          (when (.needsSyncData this) (.synchronizeData this))
          (when (nil? identifiers) (set! identifiers (HashMap.)))
          (.put identifiers idName element))))

  (method ^:public getIdentifier ^Element [this ^String idName]
    (when (.needsSyncData this) (.synchronizeData this))
    (when (some? identifiers)
      (let [elem (cast Element (.get identifiers idName))]
        (when (some? elem)
          (let [^:mutable parent (.getParentNode elem)]
            (while (some? parent)
              (when (identical? parent this) (return elem))
              (set! parent (.getParentNode parent)))))
        nil)))

  (method ^:public removeIdentifier ^void [this ^String idName]
    (when (.needsSyncData this) (.synchronizeData this))
    (when (some? identifiers) (.remove identifiers idName)))

  (method ^:public createElementNS :throws [DOMException] ^Element [this ^String namespaceURI
                                                                    ^String qualifiedName]
    (ElementNSImpl. this namespaceURI qualifiedName))

  (method ^:public createElementNS :throws [DOMException] ^Element [this ^String namespaceURI
                                                                    ^String qualifiedName
                                                                    ^String localpart]
    (ElementNSImpl. this namespaceURI qualifiedName localpart))

  (method ^:public createAttributeNS :throws [DOMException] ^Attr [this ^String namespaceURI
                                                                   ^String qualifiedName]
    (AttrNSImpl. this namespaceURI qualifiedName))

  (method ^:public createAttributeNS :throws [DOMException] ^Attr [this ^String namespaceURI
                                                                   ^String qualifiedName
                                                                   ^String localpart]
    (AttrNSImpl. this namespaceURI qualifiedName localpart))

  (method ^:public getElementsByTagNameNS ^NodeList [this ^String namespaceURI ^String localName]
    (DeepNodeListImpl. this namespaceURI localName))

  (method ^:public clone :throws [CloneNotSupportedException] [this]
    (let [newdoc (cast CoreDocumentImpl (.clone super))]
      (set! (.-docType newdoc) nil)
      (set! (.-docElement newdoc) nil)
      newdoc))

  (method ^:public ^:static ^:final isXMLName ^boolean [^String s ^boolean xml11Version]
    (cond
      (nil? s) false
      (not xml11Version) (XMLChar/isValidName s)
      :else (XML11Char/isXML11ValidName s)))

  (method ^:public ^:static ^:final isValidQName ^boolean [^String prefix ^String local
                                                           ^boolean xml11Version]
    (if (nil? local)
        false
        (let [^:mutable validNCName false]
          (if (not xml11Version)
              (set! validNCName
                    (and (or (nil? prefix) (XMLChar/isValidNCName prefix))
                         (XMLChar/isValidNCName local)))
              (set! validNCName
                    (and (or (nil? prefix) (XML11Char/isXML11ValidNCName prefix))
                         (XML11Char/isXML11ValidNCName local))))
          validNCName)))

  (method ^:protected isKidOK ^boolean [this ^Node parent ^Node child]
    (if (and allowGrammarAccess (== (.getNodeType parent) Node/DOCUMENT_TYPE_NODE))
        (== (.getNodeType child) Node/ELEMENT_NODE)
        (not (== 0
                 (bit-and-int (aget kidOK (.getNodeType parent))
                              (bit-shift-left-int 1 (.getNodeType child)))))))

  (method ^:protected changed ^void [this]
    (set! changes (unchecked-inc-int changes)))

  (method ^:protected changes ^int [this] changes)

  (method getNodeListCache ^NodeListCache [this ^ParentNode owner]
    (if (nil? fFreeNLCache)
        (NodeListCache. owner)
        (let [c fFreeNLCache]
          (set! fFreeNLCache (.-next fFreeNLCache))
          (set! (.-fChild c) nil)
          (set! (.-fChildIndex c) -1)
          (set! (.-fLength c) -1)
          (when (some? (.-fOwner c)) (set! (.-fNodeListCache (.-fOwner c)) nil))
          (set! (.-fOwner c) owner)
          c)))

  (method freeNodeListCache ^void [this ^NodeListCache c]
    (set! (.-next c) fFreeNLCache)
    (set! fFreeNLCache c))

  (method ^:public setUserData [this ^Node n ^String key data ^UserDataHandler handler]
    (if (nil? data)
        (do
          (when (some? nodeUserData)
            (let [^{:tag (Map String ParentNode$UserDataRecord)} t (cast Map (.get nodeUserData n))]
              (when (some? t)
                (let [r (cast ParentNode$UserDataRecord (.remove t key))]
                  (when (some? r) (return (.-fData r)))))))
          nil)
        (let [^:mutable ^{:tag (Map String ParentNode$UserDataRecord)} t nil]
          (if (nil? nodeUserData)
              (do (set! nodeUserData (HashMap.)) (set! t (HashMap.)) (.put nodeUserData n t))
              (do
                (set! t (cast Map (.get nodeUserData n)))
                (when (nil? t) (set! t (HashMap.)) (.put nodeUserData n t))))
          (let [r (cast ParentNode$UserDataRecord
                        (.put t key (ParentNode$UserDataRecord. data handler)))]
            (when (some? r) (.-fData r))))))

  (method ^:public getUserData [this ^Node n ^String key]
    (when (some? nodeUserData)
      (let [^{:tag (Map String ParentNode$UserDataRecord)} t (cast Map (.get nodeUserData n))]
        (when (some? t)
          (let [r (cast ParentNode$UserDataRecord (.get t key))] (when (some? r) (.-fData r)))))))

  (method ^:protected getUserDataRecord ^{:tag (Map String ParentNode$UserDataRecord)} [this ^Node n]
    (when (some? nodeUserData)
      (let [^{:tag (Map String ParentNode$UserDataRecord)} t (cast Map (.get nodeUserData n))]
        (when (some? t) t))))

  (method removeUserDataTable ^{:tag (Map String ParentNode$UserDataRecord)} [this ^Node n]
    (when (some? nodeUserData) (cast Map (.get nodeUserData n))))

  (method setUserDataTable ^void [this ^Node n ^{:tag (Map String ParentNode$UserDataRecord)} data]
    (when (nil? nodeUserData) (set! nodeUserData (HashMap.)))
    (when (some? data) (.put nodeUserData n data)))

  (method callUserDataHandlers ^void [this ^Node n ^Node c ^short operation]
    (when (some? nodeUserData)
      (when (instance? NodeImpl n)
        (let [^{:tag (Map String ParentNode$UserDataRecord)} t (.getUserDataRecord
                                                                 (cast NodeImpl n))]
          (when-not (or (nil? t) (.isEmpty t)) (.callUserDataHandlers this n c operation t))))))

  (method callUserDataHandlers ^void [this ^Node n ^Node c ^short operation
                                      ^{:tag (Map String ParentNode$UserDataRecord)} userData]
    (when-not (or (nil? userData) (.isEmpty userData))
      (.forEach (.stream (.keySet userData))
                (lambda Consumer ^void [^String key]
                  (let [r (cast ParentNode$UserDataRecord (.get userData key))]
                    (when (some? (.-fHandler r))
                      (.handle (.-fHandler r) operation key (.-fData r) n c)))))))

  (method ^:protected ^:final checkNamespaceWF ^void [this ^String qname ^int colon1 ^int colon2]
    (when-not (not errorChecking)
      (when (or (or (== colon1 0) (== colon1 (unchecked-subtract-int (.length qname) 1)))
                (not (== colon2 colon1)))
        (let [msg (DOMMessageFormatter/formatMessage
                    DOMMessageFormatter/DOM_DOMAIN
                    "NAMESPACE_ERR"
                    nil)]
          (throw (DOMException. DOMException/NAMESPACE_ERR msg))))))

  (method ^:protected ^:final checkDOMNSErr ^void [this ^String prefix ^String namespace]
    (when errorChecking
      (cond
        (nil? namespace)
          (let [msg (DOMMessageFormatter/formatMessage
                      DOMMessageFormatter/DOM_DOMAIN
                      "NAMESPACE_ERR"
                      nil)]
            (throw (DOMException. DOMException/NAMESPACE_ERR msg)))
        (and (.equals prefix "xml") (not (.equals namespace NamespaceContext/XML_URI)))
          (let [msg (DOMMessageFormatter/formatMessage
                      DOMMessageFormatter/DOM_DOMAIN
                      "NAMESPACE_ERR"
                      nil)]
            (throw (DOMException. DOMException/NAMESPACE_ERR msg)))
        (or (and (.equals prefix "xmlns") (not (.equals namespace NamespaceContext/XMLNS_URI)))
            (and (not (.equals prefix "xmlns")) (.equals namespace NamespaceContext/XMLNS_URI)))
          (let [msg (DOMMessageFormatter/formatMessage
                      DOMMessageFormatter/DOM_DOMAIN
                      "NAMESPACE_ERR"
                      nil)]
            (throw (DOMException. DOMException/NAMESPACE_ERR msg))))))

  (method ^:protected ^:final checkQName ^void [this ^String prefix ^String local]
    (when-not (not errorChecking)
      (let [^:mutable validNCName false]
        (if (not xml11Version)
            (set! validNCName
                  (and (or (nil? prefix) (XMLChar/isValidNCName prefix))
                       (XMLChar/isValidNCName local)))
            (set! validNCName
                  (and (or (nil? prefix) (XML11Char/isXML11ValidNCName prefix))
                       (XML11Char/isXML11ValidNCName local))))
        (when-not validNCName
          (let [msg (DOMMessageFormatter/formatMessage
                      DOMMessageFormatter/DOM_DOMAIN
                      "INVALID_CHARACTER_ERR"
                      nil)]
            (throw (DOMException. DOMException/INVALID_CHARACTER_ERR msg)))))))

  (method isXML11Version ^boolean [this] xml11Version)


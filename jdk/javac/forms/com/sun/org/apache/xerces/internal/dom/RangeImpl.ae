          (set! stopNode (.getFirstChild fEndContainer))
          (while (and (> i 0) (some? stopNode))
            (set! i (unchecked-dec-int i))
            (set! stopNode (.getNextSibling stopNode)))
          (when (nil? stopNode) (set! stopNode (.nextNode this fEndContainer false)))))
      (while (not (identical? node stopNode))
        (when (nil? node) (break))
        (when (or (== (.getNodeType node) Node/TEXT_NODE)
                  (== (.getNodeType node) Node/CDATA_SECTION_NODE))
          (.append sb (.getNodeValue node)))
        (set! node (.nextNode this node true)))
      (when (or (== (.getNodeType fEndContainer) Node/TEXT_NODE)
                (== (.getNodeType fEndContainer) Node/CDATA_SECTION_NODE))
        (.append sb (.substring (.getNodeValue fEndContainer) 0 fEndOffset)))
      (.toString sb)))

  (method ^:public detach ^void [this]
    (when fDetach
      (throw (DOMException. DOMException/INVALID_STATE_ERR
                            (DOMMessageFormatter/formatMessage
                              DOMMessageFormatter/DOM_DOMAIN
                              "INVALID_STATE_ERR"
                              nil))))
    (set! fDetach true)
    (.removeRange fDocument this))

  (method signalSplitData ^void [this ^Node node ^Node newNode ^int offset]
    (set! fSplitNode node)
    (.splitData fDocument node newNode offset)
    (set! fSplitNode nil))

  (method receiveSplitData ^void [this ^Node node ^Node newNode ^int offset]
    (when-not (or (nil? node) (nil? newNode))
      (when-not (identical? fSplitNode node)
        (when (and (identical? node fStartContainer)
                   (== (.getNodeType fStartContainer) Node/TEXT_NODE))
          (when (> fStartOffset offset)
            (set! fStartOffset (unchecked-subtract-int fStartOffset offset))
            (set! fStartContainer newNode)))
        (when (and (identical? node fEndContainer) (== (.getNodeType fEndContainer) Node/TEXT_NODE))
          (when (> fEndOffset offset)
            (set! fEndOffset (unchecked-subtract-int fEndOffset offset))
            (set! fEndContainer newNode))))))

  (method deleteData ^void [this ^CharacterData node ^int offset ^int count]
    (set! fDeleteNode node)
    (.deleteData node offset count)
    (set! fDeleteNode nil))

  (method receiveDeletedText ^void [this ^Node node ^int offset ^int count]
    (when (some? node)
      (when-not (identical? fDeleteNode node)
        (when (and (identical? node fStartContainer)
                   (== (.getNodeType fStartContainer) Node/TEXT_NODE))
          (cond
            (> fStartOffset (unchecked-add-int offset count))
              (set! fStartOffset
                    (unchecked-add-int offset
                                       (unchecked-subtract-int
                                         fStartOffset
                                         (unchecked-add-int offset count))))
            (> fStartOffset offset) (set! fStartOffset offset)))
        (when (and (identical? node fEndContainer) (== (.getNodeType fEndContainer) Node/TEXT_NODE))
          (cond
            (> fEndOffset (unchecked-add-int offset count))
              (set! fEndOffset
                    (unchecked-add-int offset
                                       (unchecked-subtract-int
                                         fEndOffset
                                         (unchecked-add-int offset count))))
            (> fEndOffset offset) (set! fEndOffset offset))))))

  (method insertData ^void [this ^CharacterData node ^int index ^String insert]
    (set! fInsertNode node)
    (.insertData node index insert)
    (set! fInsertNode nil))

  (method receiveInsertedText ^void [this ^Node node ^int index ^int len]
    (when (some? node)
      (when-not (identical? fInsertNode node)
        (when (and (identical? node fStartContainer)
                   (== (.getNodeType fStartContainer) Node/TEXT_NODE))
          (when (< index fStartOffset) (set! fStartOffset (unchecked-add-int fStartOffset len))))
        (when (and (identical? node fEndContainer) (== (.getNodeType fEndContainer) Node/TEXT_NODE))
          (when (< index fEndOffset) (set! fEndOffset (unchecked-add-int fEndOffset len)))))))

  (method receiveReplacedText ^void [this ^Node node]
    (when (some? node)
      (when (and (identical? node fStartContainer)
                 (== (.getNodeType fStartContainer) Node/TEXT_NODE))
        (set! fStartOffset 0))
      (when (and (identical? node fEndContainer) (== (.getNodeType fEndContainer) Node/TEXT_NODE))
        (set! fEndOffset 0))))

  (method ^:public insertedNodeFromDOM ^void [this ^Node node]
    (when (some? node)
      (when-not (identical? fInsertNode node)
        (when-not fInsertedFromRange
          (let [parent (.getParentNode node)]
            (when (identical? parent fStartContainer)
              (let [index (.indexOf this node fStartContainer)]
                (when (< index fStartOffset) (set! fStartOffset (unchecked-inc-int fStartOffset)))))
            (when (identical? parent fEndContainer)
              (let [index (.indexOf this node fEndContainer)]
                (when (< index fEndOffset) (set! fEndOffset (unchecked-inc-int fEndOffset))))))))))

  (field ^Node fRemoveChild nil)

  (method removeChild ^Node [this ^Node parent ^Node child]
    (set! fRemoveChild child)
    (let [n (.removeChild parent child)] (set! fRemoveChild nil) n))

  (method removeNode ^void [this ^Node node]
    (when (some? node)
      (when-not (identical? fRemoveChild node)
        (let [parent (.getParentNode node)]
          (when (identical? parent fStartContainer)
            (let [index (.indexOf this node fStartContainer)]
              (when (< index fStartOffset) (set! fStartOffset (unchecked-dec-int fStartOffset)))))
          (when (identical? parent fEndContainer)
            (let [index (.indexOf this node fEndContainer)]
              (when (< index fEndOffset) (set! fEndOffset (unchecked-dec-int fEndOffset)))))
          (when (or (not (identical? parent fStartContainer))
                    (not (identical? parent fEndContainer)))
            (when (.isAncestorOf this node fStartContainer)
              (set! fStartContainer parent)
              (set! fStartOffset (.indexOf this node parent)))
            (when (.isAncestorOf this node fEndContainer)
              (set! fEndContainer parent)
              (set! fEndOffset (.indexOf this node parent))))))))

  (field ^:static ^:final ^int EXTRACT_CONTENTS 1)

  (field ^:static ^:final ^int CLONE_CONTENTS 2)

  (field ^:static ^:final ^int DELETE_CONTENTS 3)

  (method ^:private traverseContents :throws [DOMException] ^DocumentFragment [this ^int how]
    (when-not (or (nil? fStartContainer) (nil? fEndContainer))
      (when fDetach
        (throw (DOMException. DOMException/INVALID_STATE_ERR
                              (DOMMessageFormatter/formatMessage
                                DOMMessageFormatter/DOM_DOMAIN
                                "INVALID_STATE_ERR"
                                nil))))
      (if (identical? fStartContainer fEndContainer)
          (.traverseSameContainer this how)
          (let [^:mutable ^int endContainerDepth 0]
            (loop [c fEndContainer
                   p (.getParentNode c)]
              (when (some? p)
                (when (identical? p fStartContainer)
                  (return (.traverseCommonStartContainer this c how)))
                (set! endContainerDepth (unchecked-inc-int endContainerDepth))
                (recur p (.getParentNode p))))
            (let [^:mutable ^int startContainerDepth 0]
              (loop [c fStartContainer
                     p (.getParentNode c)]
                (when (some? p)
                  (when (identical? p fEndContainer)
                    (return (.traverseCommonEndContainer this c how)))
                  (set! startContainerDepth (unchecked-inc-int startContainerDepth))
                  (recur p (.getParentNode p))))
              (let [^:mutable depthDiff (unchecked-subtract-int
                                          startContainerDepth
                                          endContainerDepth)
                    ^:mutable startNode fStartContainer]
                (while (> depthDiff 0)
                  (set! startNode (.getParentNode startNode))
                  (set! depthDiff (unchecked-dec-int depthDiff)))
                (let [^:mutable endNode fEndContainer]
                  (while (< depthDiff 0)
                    (set! endNode (.getParentNode endNode))
                    (set! depthDiff (unchecked-inc-int depthDiff)))
                  (loop [sp (.getParentNode startNode)
                         ep (.getParentNode endNode)]
                    (when-not (identical? sp ep)
                      (set! startNode sp)
                      (set! endNode ep)
                      (recur (.getParentNode sp) (.getParentNode ep))))
                  (.traverseCommonAncestors this startNode endNode how))))))))

  (method ^:private traverseSameContainer ^DocumentFragment [this ^int how]
    (let [^:mutable ^DocumentFragment frag nil]
      (when-not (== how DELETE_CONTENTS) (set! frag (.createDocumentFragment fDocument)))
      (cond
        (== fStartOffset fEndOffset) frag
        (== (.getNodeType fStartContainer) Node/TEXT_NODE)
          (let [s (.getNodeValue fStartContainer)
                sub (.substring s fStartOffset fEndOffset)]
            (when-not (== how CLONE_CONTENTS)
              (.deleteData (cast TextImpl fStartContainer)
                           fStartOffset
                           (unchecked-subtract-int fEndOffset fStartOffset))
              (.collapse this true))
            (when-not (== how DELETE_CONTENTS)
              (.appendChild frag (.createTextNode fDocument sub))
              frag))
        :else
          (let [^:mutable n (.getSelectedNode this fStartContainer fStartOffset)
                ^:mutable cnt (unchecked-subtract-int fEndOffset fStartOffset)]
            (while (> cnt 0)
              (let [sibling (.getNextSibling n)
                    xferNode (.traverseFullySelected this n how)]
                (when (some? frag) (.appendChild frag xferNode))
                (set! cnt (unchecked-dec-int cnt))
                (set! n sibling)))
            (when-not (== how CLONE_CONTENTS) (.collapse this true))
            frag))))

  (method ^:private traverseCommonStartContainer ^DocumentFragment [this ^Node endAncestor ^int how]
    (let [^:mutable ^DocumentFragment frag nil]
      (when-not (== how DELETE_CONTENTS) (set! frag (.createDocumentFragment fDocument)))
      (let [^:mutable n (.traverseRightBoundary this endAncestor how)]
        (when (some? frag) (.appendChild frag n))
        (let [endIdx (.indexOf this endAncestor fStartContainer)
              ^:mutable cnt (unchecked-subtract-int endIdx fStartOffset)]
          (if (<= cnt 0)
              (do
                (when-not (== how CLONE_CONTENTS)
                  (.setEndBefore this endAncestor)
                  (.collapse this false))
                frag)
              (do
                (set! n (.getPreviousSibling endAncestor))
                (while (> cnt 0)
                  (let [sibling (.getPreviousSibling n)
                        xferNode (.traverseFullySelected this n how)]
                    (when (some? frag) (.insertBefore frag xferNode (.getFirstChild frag)))
                    (set! cnt (unchecked-dec-int cnt))
                    (set! n sibling)))
                (when-not (== how CLONE_CONTENTS)
                  (.setEndBefore this endAncestor)
                  (.collapse this false))
                frag))))))

  (method ^:private traverseCommonEndContainer ^DocumentFragment [this ^Node startAncestor ^int how]
    (let [^:mutable ^DocumentFragment frag nil]
      (when-not (== how DELETE_CONTENTS) (set! frag (.createDocumentFragment fDocument)))
      (let [^:mutable n (.traverseLeftBoundary this startAncestor how)]
        (when (some? frag) (.appendChild frag n))
        (let [^:mutable startIdx (.indexOf this startAncestor fEndContainer)]
          (set! startIdx (unchecked-inc-int startIdx))
          (let [^:mutable cnt (unchecked-subtract-int fEndOffset startIdx)]
            (set! n (.getNextSibling startAncestor))
            (while (> cnt 0)
              (let [sibling (.getNextSibling n)
                    xferNode (.traverseFullySelected this n how)]
                (when (some? frag) (.appendChild frag xferNode))
                (set! cnt (unchecked-dec-int cnt))
                (set! n sibling)))
            (when-not (== how CLONE_CONTENTS)
              (.setStartAfter this startAncestor)
              (.collapse this true))
            frag)))))

  (method ^:private traverseCommonAncestors ^DocumentFragment [this ^Node startAncestor
                                                               ^Node endAncestor ^int how]
    (let [^:mutable ^DocumentFragment frag nil]
      (when-not (== how DELETE_CONTENTS) (set! frag (.createDocumentFragment fDocument)))
      (let [^:mutable n (.traverseLeftBoundary this startAncestor how)]
        (when (some? frag) (.appendChild frag n))
        (let [commonParent (.getParentNode startAncestor)
              ^:mutable startOffset (.indexOf this startAncestor commonParent)
              endOffset (.indexOf this endAncestor commonParent)]
          (set! startOffset (unchecked-inc-int startOffset))
          (let [^:mutable cnt (unchecked-subtract-int endOffset startOffset)
                ^:mutable sibling (.getNextSibling startAncestor)]
            (while (> cnt 0)
              (let [nextSibling (.getNextSibling sibling)]
                (set! n (.traverseFullySelected this sibling how))
                (when (some? frag) (.appendChild frag n))
                (set! sibling nextSibling)
                (set! cnt (unchecked-dec-int cnt))))
            (set! n (.traverseRightBoundary this endAncestor how))
            (when (some? frag) (.appendChild frag n))
            (when-not (== how CLONE_CONTENTS)
              (.setStartAfter this startAncestor)
              (.collapse this true))
            frag)))))

  (method ^:private traverseRightBoundary ^Node [this ^Node root ^int how]
    (let [^:mutable next (.getSelectedNode this fEndContainer (unchecked-subtract-int fEndOffset 1))
          ^:mutable isFullySelected (not (identical? next fEndContainer))]
      (if (identical? next root)
          (.traverseNode this next isFullySelected false how)
          (let [^:mutable parent (.getParentNode next)
                ^:mutable clonedParent (.traverseNode this parent false false how)]
            (while (some? parent)
              (while (some? next)
                (let [prevSibling (.getPreviousSibling next)
                      clonedChild (.traverseNode this next isFullySelected false how)]
                  (when-not (== how DELETE_CONTENTS)
                    (.insertBefore clonedParent clonedChild (.getFirstChild clonedParent)))
                  (set! isFullySelected true)
                  (set! next prevSibling)))
              (when (identical? parent root) (return clonedParent))
              (set! next (.getPreviousSibling parent))
              (set! parent (.getParentNode parent))
              (let [clonedGrandParent (.traverseNode this parent false false how)]
                (when-not (== how DELETE_CONTENTS) (.appendChild clonedGrandParent clonedParent))
                (set! clonedParent clonedGrandParent)))
            nil))))

  (method ^:private traverseLeftBoundary ^Node [this ^Node root ^int how]
    (let [^:mutable next (.getSelectedNode this (.getStartContainer this) (.getStartOffset this))
          ^:mutable isFullySelected (not (identical? next (.getStartContainer this)))]
      (if (identical? next root)
          (.traverseNode this next isFullySelected true how)
          (let [^:mutable parent (.getParentNode next)
                ^:mutable clonedParent (.traverseNode this parent false true how)]
            (while (some? parent)
              (while (some? next)
                (let [nextSibling (.getNextSibling next)
                      clonedChild (.traverseNode this next isFullySelected true how)]
                  (when-not (== how DELETE_CONTENTS) (.appendChild clonedParent clonedChild))
                  (set! isFullySelected true)
                  (set! next nextSibling)))
              (when (identical? parent root) (return clonedParent))
              (set! next (.getNextSibling parent))
              (set! parent (.getParentNode parent))
              (let [clonedGrandParent (.traverseNode this parent false true how)]
                (when-not (== how DELETE_CONTENTS) (.appendChild clonedGrandParent clonedParent))
                (set! clonedParent clonedGrandParent)))
            nil))))

  (method ^:private traverseNode ^Node [this ^Node n ^boolean isFullySelected ^boolean isLeft
                                        ^int how]
    (cond
      isFullySelected (.traverseFullySelected this n how)
      (== (.getNodeType n) Node/TEXT_NODE) (.traverseTextNode this n isLeft how)
      :else (.traversePartiallySelected this n how)))

  (method ^:private traverseFullySelected ^Node [this ^Node n ^int how]
    (switch how
      CLONE_CONTENTS (return (.cloneNode n true))
      EXTRACT_CONTENTS
        (do
          (when (== (.getNodeType n) Node/DOCUMENT_TYPE_NODE)
            (throw (DOMException. DOMException/HIERARCHY_REQUEST_ERR
                                  (DOMMessageFormatter/formatMessage
                                    DOMMessageFormatter/DOM_DOMAIN
                                    "HIERARCHY_REQUEST_ERR"
                                    nil))))
          (return n))
      DELETE_CONTENTS (do (.removeChild (.getParentNode n) n) (return nil)))
    nil)

  (method ^:private traversePartiallySelected ^Node [this ^Node n ^int how]
    (switch how
      DELETE_CONTENTS (return nil)
      (CLONE_CONTENTS EXTRACT_CONTENTS) (return (.cloneNode n false)))
    nil)

  (method ^:private traverseTextNode ^Node [this ^Node n ^boolean isLeft ^int how]
    (let [txtValue (.getNodeValue n)
          ^:mutable ^String newNodeValue nil
          ^:mutable ^String oldNodeValue nil]
      (if isLeft
          (let [offset (.getStartOffset this)]
            (set! newNodeValue (.substring txtValue offset))
            (set! oldNodeValue (.substring txtValue 0 offset)))
          (let [offset (.getEndOffset this)]
            (set! newNodeValue (.substring txtValue 0 offset))
            (set! oldNodeValue (.substring txtValue offset))))
      (when-not (== how CLONE_CONTENTS) (.setNodeValue n oldNodeValue))
      (when-not (== how DELETE_CONTENTS)
        (let [newNode (.cloneNode n false)] (.setNodeValue newNode newNodeValue) newNode))))

  (method checkIndex :throws [DOMException] ^void [this ^Node refNode ^int offset]
    (when (< offset 0)
      (throw (DOMException. DOMException/INDEX_SIZE_ERR
                            (DOMMessageFormatter/formatMessage
                              DOMMessageFormatter/DOM_DOMAIN
                              "INDEX_SIZE_ERR"
                              nil))))
    (let [^int type (.getNodeType refNode)]
      (cond
        (or (or (or (== type Node/TEXT_NODE) (== type Node/CDATA_SECTION_NODE))
                (== type Node/COMMENT_NODE))
            (== type Node/PROCESSING_INSTRUCTION_NODE))
          (when (> offset (.length (.getNodeValue refNode)))
            (throw (DOMException. DOMException/INDEX_SIZE_ERR
                                  (DOMMessageFormatter/formatMessage
                                    DOMMessageFormatter/DOM_DOMAIN
                                    "INDEX_SIZE_ERR"
                                    nil))))
        (> offset (.getLength (.getChildNodes refNode)))
          (throw (DOMException. DOMException/INDEX_SIZE_ERR
                                (DOMMessageFormatter/formatMessage
                                  DOMMessageFormatter/DOM_DOMAIN
                                  "INDEX_SIZE_ERR"
                                  nil))))))

  (method ^:private getRootContainer ^Node [this ^:mutable ^Node node]
    (when (some? node) (while (some? (.getParentNode node)) (set! node (.getParentNode node))) node))

  (method ^:private isLegalContainer ^boolean [this ^:mutable ^Node node]
    (if (nil? node)
        false
        (do
          (while (some? node)
            (switch (.getNodeType node)
              (Node/ENTITY_NODE Node/NOTATION_NODE Node/DOCUMENT_TYPE_NODE) (return false))
            (set! node (.getParentNode node)))
          true)))

  (method ^:private hasLegalRootContainer ^boolean [this ^Node node]
    (if (nil? node)
        false
        (let [rootContainer (.getRootContainer this node)]
          (switch (.getNodeType rootContainer)
            (Node/ATTRIBUTE_NODE Node/DOCUMENT_NODE Node/DOCUMENT_FRAGMENT_NODE) (return true))
          false)))

  (method ^:private isLegalContainedNode ^boolean [this ^Node node]
    (if (nil? node)
        false
        (do
          (switch (.getNodeType node)
            (Node/DOCUMENT_NODE Node/DOCUMENT_FRAGMENT_NODE
                                Node/ATTRIBUTE_NODE
                                Node/ENTITY_NODE
                                Node/NOTATION_NODE)
              (return false))
          true)))

  (method nextNode ^Node [this ^Node node ^boolean visitChildren]
    (when (some? node)
      (let [^:mutable ^Node result nil]
        (when visitChildren
          (set! result (.getFirstChild node))
          (when (some? result) (return result)))
        (set! result (.getNextSibling node))
        (if (some? result)
            result
            (let [^:mutable parent (.getParentNode node)]
              (while (and (some? parent) (not (identical? parent fDocument)))
                (set! result (.getNextSibling parent))
                (if (some? result) (return result) (set! parent (.getParentNode parent))))
              nil)))))

  (method isAncestorOf ^boolean [this ^Node a ^Node b]
    (loop [node b]
      (if (some? node) (if (identical? node a) (return true) (recur (.getParentNode node))) nil))
    false)

  (method indexOf ^int [this ^Node child ^Node parent]
    (if (not (identical? (.getParentNode child) parent))
        -1
        (let [^:mutable ^int i 0]
          (loop [node (.getFirstChild parent)]
            (when-not (identical? node child)
              (set! i (unchecked-inc-int i))
              (recur (.getNextSibling node))))
          i)))

  (method ^:private getSelectedNode ^Node [this ^Node container ^:mutable ^int offset]
    (cond
      (== (.getNodeType container) Node/TEXT_NODE) container
      (< offset 0) container
      :else
        (let [^:mutable child (.getFirstChild container)]
          (while (and (some? child) (> offset 0))
            (set! offset (unchecked-dec-int offset))
            (set! child (.getNextSibling child)))
          (if (some? child) child container)))))

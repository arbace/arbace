      (.reportFatalError this "MSG_SPACE_REQUIRED_BEFORE_NOTATION_NAME_IN_NOTATIONDECL" nil))
    (let [name (.scanName (.-fEntityScanner this) XMLScanner$NameType/NOTATION)]
      (when (nil? name) (.reportFatalError this "MSG_NOTATION_NAME_REQUIRED_IN_NOTATIONDECL" nil))
      (when-not (.skipSeparator this true (not (.scanningInternalSubset this)))
        (.reportFatalError this
                           "MSG_SPACE_REQUIRED_AFTER_NOTATION_NAME_IN_NOTATIONDECL"
                           (new Object/1 [name])))
      (.scanExternalID this fStrings true)
      (let [systemId (aget fStrings 0)
            publicId (aget fStrings 1)
            baseSystemId (.getBaseSystemId (.-fEntityScanner this))]
        (when (and (nil? systemId) (nil? publicId))
          (.reportFatalError this "ExternalIDorPublicIDRequired" (new Object/1 [name])))
        (.skipSeparator this false (not (.scanningInternalSubset this)))
        (when-not (.skipChar (.-fEntityScanner this) \> nil)
          (.reportFatalError this "NotationDeclUnterminated" (new Object/1 [name])))
        (set! fMarkUpDepth (unchecked-dec-int fMarkUpDepth))
        (.setValues (.-fResourceIdentifier this)
                    publicId
                    systemId
                    baseSystemId
                    (XMLEntityManager/expandSystemId systemId baseSystemId))
        (when nonValidatingMode (.notationDecl nvGrammarInfo name (.-fResourceIdentifier this) nil))
        (when (some? fDTDHandler) (.notationDecl fDTDHandler name (.-fResourceIdentifier this) nil))

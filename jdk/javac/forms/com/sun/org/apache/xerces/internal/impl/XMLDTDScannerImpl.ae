  (method ^:private ^:final scanConditionalSect :throws [IOException XNIException] ^void [this
                                                                                          ^int currPEDepth]
    (set! (.-fReportEntity this) false)
    (.skipSeparator this false (not (.scanningInternalSubset this)))
    (cond
      (.skipString (.-fEntityScanner this) "INCLUDE")
        (do
          (.skipSeparator this false (not (.scanningInternalSubset this)))
          (when (and (not (== currPEDepth fPEDepth)) (.-fValidation this))
            (.reportError (.-fErrorReporter this)
                          XMLMessageFormatter/XML_DOMAIN
                          "INVALID_PE_IN_CONDITIONAL"
                          (new Object/1 [(.-name (.-fCurrentEntity (.-fEntityManager this)))])
                          XMLErrorReporter/SEVERITY_ERROR))
          (when-not (.skipChar (.-fEntityScanner this) \[ nil)
            (.reportFatalError this "MSG_MARKUP_NOT_RECOGNIZED_IN_DTD" nil))
          (when (some? fDTDHandler)
            (.startConditional fDTDHandler XMLDTDHandler/CONDITIONAL_INCLUDE nil))
          (set! fIncludeSectDepth (unchecked-inc-int fIncludeSectDepth))
          (set! (.-fReportEntity this) true))

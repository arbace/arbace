  (method ^:private ^:final scanAttType :throws [IOException XNIException] ^String [this
                                                                                    ^String elName
                                                                                    ^String atName]
    (let [^:mutable ^String type nil]
      (set! fEnumerationCount 0)
      (cond
        (.skipString (.-fEntityScanner this) "CDATA") (set! type "CDATA")
        (.skipString (.-fEntityScanner this) "IDREFS") (set! type "IDREFS")
        (.skipString (.-fEntityScanner this) "IDREF") (set! type "IDREF")
        (.skipString (.-fEntityScanner this) "ID") (set! type "ID")
        (.skipString (.-fEntityScanner this) "ENTITY") (set! type "ENTITY")
        (.skipString (.-fEntityScanner this) "ENTITIES") (set! type "ENTITIES")
        (.skipString (.-fEntityScanner this) "NMTOKENS") (set! type "NMTOKENS")
        (.skipString (.-fEntityScanner this) "NMTOKEN") (set! type "NMTOKEN")
        (.skipString (.-fEntityScanner this) "NOTATION")
          (do
            (set! type "NOTATION")
            (when-not (.skipSeparator this true (not (.scanningInternalSubset this)))
              (.reportFatalError this
                                 "MSG_SPACE_REQUIRED_AFTER_NOTATION_IN_NOTATIONTYPE"
                                 (new Object/1 [elName atName])))
            (let [^:mutable c (.scanChar (.-fEntityScanner this) nil)]
              (when-not (== c \()
                (.reportFatalError this
                                   "MSG_OPEN_PAREN_REQUIRED_IN_NOTATIONTYPE"
                                   (new Object/1 [elName atName])))
              (set! fMarkUpDepth (unchecked-inc-int fMarkUpDepth))
              (loop []
                (.skipSeparator this false (not (.scanningInternalSubset this)))
                (let [aName (.scanName (.-fEntityScanner this) XMLScanner$NameType/ATTRIBUTENAME)]
                  (when (nil? aName)
                    (.reportFatalError this
                                       "MSG_NAME_REQUIRED_IN_NOTATIONTYPE"
                                       (new Object/1 [elName atName])))
                  (.ensureEnumerationSize this (unchecked-add-int fEnumerationCount 1))
                  (aset fEnumeration
                        (let [old-2 fEnumerationCount]
                          (set! fEnumerationCount (unchecked-inc-int fEnumerationCount))
                          old-2)
                        aName)
                  (.skipSeparator this false (not (.scanningInternalSubset this)))
                  (set! c (.scanChar (.-fEntityScanner this) nil)))
                (when (== c \|) (recur)))
              (when-not (== c \))
                (.reportFatalError this "NotationTypeUnterminated" (new Object/1 [elName atName])))
              (set! fMarkUpDepth (unchecked-dec-int fMarkUpDepth))))
        :else
          (do
            (set! type "ENUMERATION")
            (let [^:mutable c (.scanChar (.-fEntityScanner this) nil)]
              (when-not (== c \()
                (.reportFatalError this "AttTypeRequiredInAttDef" (new Object/1 [elName atName])))
              (set! fMarkUpDepth (unchecked-inc-int fMarkUpDepth))
              (loop []
                (.skipSeparator this false (not (.scanningInternalSubset this)))
                (let [token (.scanNmtoken (.-fEntityScanner this))]
                  (when (nil? token)
                    (.reportFatalError this
                                       "MSG_NMTOKEN_REQUIRED_IN_ENUMERATION"
                                       (new Object/1 [elName atName])))
                  (.ensureEnumerationSize this (unchecked-add-int fEnumerationCount 1))
                  (aset fEnumeration
                        (let [old-3 fEnumerationCount]
                          (set! fEnumerationCount (unchecked-inc-int fEnumerationCount))
                          old-3)
                        token)
                  (.skipSeparator this false (not (.scanningInternalSubset this)))
                  (set! c (.scanChar (.-fEntityScanner this) nil)))
                (when (== c \|) (recur)))
              (when-not (== c \))
                (.reportFatalError this "EnumerationUnterminated" (new Object/1 [elName atName])))
              (set! fMarkUpDepth (unchecked-dec-int fMarkUpDepth)))))
      type))

  (method ^:protected ^:final scanAttDefaultDecl :throws [IOException XNIException] ^String [this
                                                                                             ^String elName
                                                                                             ^String atName
                                                                                             ^String type
                                                                                             ^XMLString defaultVal
                                                                                             ^XMLString nonNormalizedDefaultVal]
    (let [^:mutable ^String defaultType nil]
      (.clear fString)
      (.clear defaultVal)
      (cond
        (.skipString (.-fEntityScanner this) "#REQUIRED") (set! defaultType "#REQUIRED")
        (.skipString (.-fEntityScanner this) "#IMPLIED") (set! defaultType "#IMPLIED")
        :else
          (do
            (when (.skipString (.-fEntityScanner this) "#FIXED")
              (set! defaultType "#FIXED")
              (when-not (.skipSeparator this true (not (.scanningInternalSubset this)))
                (.reportFatalError this
                                   "MSG_SPACE_REQUIRED_AFTER_FIXED_IN_DEFAULTDECL"
                                   (new Object/1 [elName atName]))))
            (let [isVC (and (not fStandalone) (or fSeenExternalDTD fSeenExternalPE))]
              (.scanAttributeValue this
                                   defaultVal
                                   nonNormalizedDefaultVal
                                   atName
                                   fAttributes
                                   0
                                   isVC
                                   elName
                                   false))))
      defaultType))

  (method ^:private ^:final scanEntityDecl :throws [IOException XNIException] ^void [this]
    (let [^:mutable isPEDecl false
          ^:mutable sawPERef false]
      (set! (.-fReportEntity this) false)
      (cond
        (.skipSpaces (.-fEntityScanner this))
          (cond
            (not (.skipChar (.-fEntityScanner this) \% XMLScanner$NameType/REFERENCE))
              (set! isPEDecl false)
            (.skipSeparator this true (not (.scanningInternalSubset this))) (set! isPEDecl true)
            (.scanningInternalSubset this)
              (do
                (.reportFatalError this "MSG_SPACE_REQUIRED_BEFORE_ENTITY_NAME_IN_ENTITYDECL" nil)
                (set! isPEDecl true))
            (== (.peekChar (.-fEntityScanner this)) \%)
              (do
                (.skipSeparator this false (not (.scanningInternalSubset this)))
                (set! isPEDecl true))
            :else (set! sawPERef true))
        (or (.scanningInternalSubset this)
            (not (.skipChar (.-fEntityScanner this) \% XMLScanner$NameType/REFERENCE)))
          (do
            (.reportFatalError this "MSG_SPACE_REQUIRED_BEFORE_ENTITY_NAME_IN_ENTITYDECL" nil)
            (set! isPEDecl false))
        (.skipSpaces (.-fEntityScanner this))
          (do
            (.reportFatalError this "MSG_SPACE_REQUIRED_BEFORE_PERCENT_IN_PEDECL" nil)
            (set! isPEDecl false))
        :else (set! sawPERef true))
      (when sawPERef
        (while true
          (let [peName (.scanName (.-fEntityScanner this) XMLScanner$NameType/REFERENCE)]
            (cond
              (nil? peName) (.reportFatalError this "NameRequiredInPEReference" nil)
              (not (.skipChar (.-fEntityScanner this) \; XMLScanner$NameType/REFERENCE))
                (.reportFatalError this "SemicolonRequiredInPEReference" (new Object/1 [peName]))
              :else (.startPE this peName false))
            (.skipSpaces (.-fEntityScanner this))
            (when-not (.skipChar (.-fEntityScanner this) \% XMLScanner$NameType/REFERENCE) (break))
            (when-not isPEDecl
              (when (.skipSeparator this true (not (.scanningInternalSubset this)))
                (set! isPEDecl true)
                (break))
              (set! isPEDecl (.skipChar (.-fEntityScanner this) \% XMLScanner$NameType/REFERENCE))))))
      (let [^:mutable name (.scanName (.-fEntityScanner this) XMLScanner$NameType/ENTITY)]
        (when (nil? name) (.reportFatalError this "MSG_ENTITY_NAME_REQUIRED_IN_ENTITYDECL" nil))
        (when-not (.skipSeparator this true (not (.scanningInternalSubset this)))
          (.reportFatalError this
                             "MSG_SPACE_REQUIRED_AFTER_ENTITY_NAME_IN_ENTITYDECL"
                             (new Object/1 [name])))
        (.scanExternalID this fStrings false)
        (let [systemId (aget fStrings 0)
              publicId (aget fStrings 1)]
          (when (and isPEDecl (some? systemId)) (set! fSeenExternalPE true))
          (let [^:mutable ^String notation nil
                sawSpace (.skipSeparator this true (not (.scanningInternalSubset this)))]
            (when (and (not isPEDecl) (.skipString (.-fEntityScanner this) "NDATA"))
              (when-not sawSpace
                (.reportFatalError this
                                   "MSG_SPACE_REQUIRED_BEFORE_NDATA_IN_UNPARSED_ENTITYDECL"
                                   (new Object/1 [name])))
              (when-not (.skipSeparator this true (not (.scanningInternalSubset this)))
                (.reportFatalError this
                                   "MSG_SPACE_REQUIRED_BEFORE_NOTATION_NAME_IN_UNPARSED_ENTITYDECL"
                                   (new Object/1 [name])))
              (set! notation (.scanName (.-fEntityScanner this) XMLScanner$NameType/NOTATION))
              (when (nil? notation)
                (.reportFatalError this
                                   "MSG_NOTATION_NAME_REQUIRED_FOR_UNPARSED_ENTITYDECL"
                                   (new Object/1 [name]))))
            (when (nil? systemId)
              (.scanEntityValue this name isPEDecl fLiteral fLiteral2)
              (.clear fStringBuffer)
              (.clear fStringBuffer2)
              (.append fStringBuffer (.-ch fLiteral) (.-offset fLiteral) (.-length fLiteral))
              (.append fStringBuffer2 (.-ch fLiteral2) (.-offset fLiteral2) (.-length fLiteral2)))
            (.skipSeparator this false (not (.scanningInternalSubset this)))
            (when-not (.skipChar (.-fEntityScanner this) \> nil)
              (.reportFatalError this "EntityDeclUnterminated" (new Object/1 [name])))
            (set! fMarkUpDepth (unchecked-dec-int fMarkUpDepth))
            (when isPEDecl (set! name (java-str "%" name)))
            (if (some? systemId)
                (let [baseSystemId (.getBaseSystemId (.-fEntityScanner this))]
                  (if (some? notation)
                      (.addUnparsedEntity (.-fEntityStore this)
                                          name
                                          publicId
                                          systemId
                                          baseSystemId
                                          notation)
                      (.addExternalEntity (.-fEntityStore this) name publicId systemId baseSystemId))
                  (when (some? fDTDHandler)
                    (.setValues (.-fResourceIdentifier this)
                                publicId
                                systemId
                                baseSystemId
                                (XMLEntityManager/expandSystemId systemId baseSystemId))
                    (if (some? notation)
                        (.unparsedEntityDecl fDTDHandler
                                             name
                                             (.-fResourceIdentifier this)
                                             notation
                                             nil)
                        (.externalEntityDecl fDTDHandler name (.-fResourceIdentifier this) nil))))
                (do
                  (.addInternalEntity (.-fEntityStore this) name (.toString fStringBuffer))
                  (when (some? fDTDHandler)
                    (.internalEntityDecl fDTDHandler name fStringBuffer fStringBuffer2 nil))))
            (set! (.-fReportEntity this) true))))))

  (method ^:protected ^:final scanEntityValue :throws [IOException XNIException] ^void [this
                                                                                        ^String entityName
                                                                                        ^boolean isPEDecl
                                                                                        ^XMLString value
                                                                                        ^XMLString nonNormalizedValue]
    (let [quote (.scanChar (.-fEntityScanner this) nil)]
      (when (and (not (== quote \')) (not (== quote \")))
        (.reportFatalError this "OpenQuoteMissingInDecl" nil))
      (let [entityDepth (.-fEntityDepth this)
            ^:mutable literal fString
            ^:mutable literal2 fString
            ^:mutable ^int countChar 0]
        (when (nil? (.-fLimitAnalyzer this))
          (set! (.-fLimitAnalyzer this) (.-fLimitAnalyzer (.-fEntityManager this))))
        (.startEntity (.-fLimitAnalyzer this) entityName)
        (if (not (== (.scanLiteral (.-fEntityScanner this) quote fString false) quote))
            (do
              (.clear fStringBuffer)
              (.clear fStringBuffer2)
              (let [^:mutable ^int offset 0]
                (loop []
                  (set! countChar 0)
                  (set! offset (.-length fStringBuffer))
                  (.append fStringBuffer fString)
                  (.append fStringBuffer2 fString)
                  (cond
                    (.skipChar (.-fEntityScanner this) \& XMLScanner$NameType/REFERENCE)
                      (if (.skipChar (.-fEntityScanner this) \# XMLScanner$NameType/REFERENCE)
                          (do
                            (.append fStringBuffer2 "&#")
                            (.scanCharReferenceValue this fStringBuffer fStringBuffer2))
                          (do
                            (.append fStringBuffer \&)
                            (.append fStringBuffer2 \&)
                            (let [eName (.scanName
                                          (.-fEntityScanner this)
                                          XMLScanner$NameType/REFERENCE)]
                              (if (nil? eName)
                                  (.reportFatalError this "NameRequiredInReference" nil)
                                  (do (.append fStringBuffer eName) (.append fStringBuffer2 eName)))
                              (if (not (.skipChar
                                         (.-fEntityScanner this)
                                         \;
                                         XMLScanner$NameType/REFERENCE))
                                  (.reportFatalError
                                    this
                                    "SemicolonRequiredInReference"
                                    (new Object/1 [eName]))
                                  (do (.append fStringBuffer \;) (.append fStringBuffer2 \;))))))
                    (.skipChar (.-fEntityScanner this) \% XMLScanner$NameType/REFERENCE)
                      (while true
                        (.append fStringBuffer2 \%)
                        (let [peName (.scanName (.-fEntityScanner this)
                                                XMLScanner$NameType/REFERENCE)]
                          (cond
                            (nil? peName) (.reportFatalError this "NameRequiredInPEReference" nil)
                            (not (.skipChar (.-fEntityScanner this)
                                            \;
                                            XMLScanner$NameType/REFERENCE))
                              (.reportFatalError
                                this
                                "SemicolonRequiredInPEReference"
                                (new Object/1 [peName]))
                            :else
                              (do
                                (when (.scanningInternalSubset this)
                                  (.reportFatalError
                                    this
                                    "PEReferenceWithinMarkup"
                                    (new Object/1 [peName])))
                                (.append fStringBuffer2 peName)
                                (.append fStringBuffer2 \;)))
                          (.startPE this peName true)
                          (.skipSpaces (.-fEntityScanner this))
                          (when-not (.skipChar (.-fEntityScanner this)
                                               \%
                                               XMLScanner$NameType/REFERENCE)
                            (break))))
                    :else
                      (let [c (.peekChar (.-fEntityScanner this))]
                        (cond
                          (XMLChar/isHighSurrogate c)
                            (do
                              (set! countChar (unchecked-inc-int countChar))
                              (.scanSurrogates this fStringBuffer2))
                          (.isInvalidLiteral this c)
                            (do
                              (.reportFatalError
                                this
                                "InvalidCharInLiteral"
                                (new Object/1 [(Integer/toHexString c)]))
                              (.scanChar (.-fEntityScanner this) nil))
                          :else
                            (when (or (not (== c quote))
                                      (not (== entityDepth (.-fEntityDepth this))))
                              (.append fStringBuffer (unchecked-char c))
                              (.append fStringBuffer2 (unchecked-char c))
                              (.scanChar (.-fEntityScanner this) nil)))))
                  (.checkEntityLimit this
                                     isPEDecl
                                     entityName
                                     (unchecked-add-int
                                       (unchecked-subtract-int (.-length fStringBuffer) offset)
                                       countChar))
                  (when-not (== (.scanLiteral (.-fEntityScanner this) quote fString false) quote)
                    (recur)))
                (.checkEntityLimit this isPEDecl entityName (.-length fString))
                (.append fStringBuffer fString)
                (.append fStringBuffer2 fString)
                (set! literal fStringBuffer)
                (set! literal2 fStringBuffer2)))
            (.checkEntityLimit this isPEDecl entityName literal))
        (.setValues value literal)
        (.setValues nonNormalizedValue literal2)
        (when (some? (.-fLimitAnalyzer this))
          (if isPEDecl
              (.endEntity (.-fLimitAnalyzer this)
                          XMLSecurityManager$Limit/PARAMETER_ENTITY_SIZE_LIMIT

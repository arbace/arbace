  (method ^:protected ^:final scanDecls :throws [IOException XNIException] ^boolean [this
                                                                                     ^boolean complete]
    (.skipSeparator this false true)
    (let [^:mutable again true]
      (while (and again (== fScannerState SCANNER_STATE_MARKUP_DECL))
        (set! again complete)
        (cond
          (.skipChar (.-fEntityScanner this) \< nil)
            (do
              (set! fMarkUpDepth (unchecked-inc-int fMarkUpDepth))
              (cond
                (.skipChar (.-fEntityScanner this) \? nil)
                  (do
                    (.clear fStringBuffer)
                    (.scanPI this fStringBuffer)
                    (set! fMarkUpDepth (unchecked-dec-int fMarkUpDepth)))
                (.skipChar (.-fEntityScanner this) \! nil)
                  (cond
                    (.skipChar (.-fEntityScanner this) \- nil)
                      (if (not (.skipChar (.-fEntityScanner this) \- nil))
                          (.reportFatalError this "MSG_MARKUP_NOT_RECOGNIZED_IN_DTD" nil)
                          (.scanComment this))
                    (.skipString (.-fEntityScanner this) "ELEMENT") (.scanElementDecl this)
                    (.skipString (.-fEntityScanner this) "ATTLIST") (.scanAttlistDecl this)
                    (.skipString (.-fEntityScanner this) "ENTITY") (.scanEntityDecl this)
                    (.skipString (.-fEntityScanner this) "NOTATION") (.scanNotationDecl this)
                    (and (.skipChar (.-fEntityScanner this) \[ nil)
                         (not (.scanningInternalSubset this)))

          (.skipSeparator this false (not (.scanningInternalSubset this)))
          (when (and (not (== currPEDepth fPEDepth)) (.-fValidation this))
            (.reportError (.-fErrorReporter this)
                          XMLMessageFormatter/XML_DOMAIN
                          "INVALID_PE_IN_CONDITIONAL"
                          (new Object/1 [(.-name (.-fCurrentEntity (.-fEntityManager this)))])
                          XMLErrorReporter/SEVERITY_ERROR))
          (when (some? fDTDHandler)
            (.startConditional fDTDHandler XMLDTDHandler/CONDITIONAL_IGNORE nil))
          (when-not (.skipChar (.-fEntityScanner this) \[ nil)
            (.reportFatalError this "MSG_MARKUP_NOT_RECOGNIZED_IN_DTD" nil))
          (set! (.-fReportEntity this) true)
          (let [initialDepth (set! fIncludeSectDepth (unchecked-inc-int fIncludeSectDepth))]
            (when (some? fDTDHandler) (.clear fIgnoreConditionalBuffer))
            (while true
              (cond
                (.skipChar (.-fEntityScanner this) \< nil)
                  (do
                    (when (some? fDTDHandler) (.append fIgnoreConditionalBuffer \<))
                    (when (.skipChar (.-fEntityScanner this) \! nil)
                      (cond
                        (.skipChar (.-fEntityScanner this) \[ nil)
                          (do
                            (when (some? fDTDHandler) (.append fIgnoreConditionalBuffer "!["))
                            (set! fIncludeSectDepth (unchecked-inc-int fIncludeSectDepth)))
                        (some? fDTDHandler) (.append fIgnoreConditionalBuffer "!"))))
                (.skipChar (.-fEntityScanner this) \] nil)
                  (do
                    (when (some? fDTDHandler) (.append fIgnoreConditionalBuffer \]))
                    (when (.skipChar (.-fEntityScanner this) \] nil)
                      (when (some? fDTDHandler) (.append fIgnoreConditionalBuffer \]))
                      (while (.skipChar (.-fEntityScanner this) \] nil)
                        (when (some? fDTDHandler) (.append fIgnoreConditionalBuffer \])))
                      (when (.skipChar (.-fEntityScanner this) \> nil)
                        (cond
                          (== (let [old-4 fIncludeSectDepth]
                                (set! fIncludeSectDepth (unchecked-dec-int fIncludeSectDepth))
                                old-4)
                              initialDepth)
                            (do
                              (set! fMarkUpDepth (unchecked-dec-int fMarkUpDepth))
                              (when (some? fDTDHandler)
                                (.setValues fLiteral
                                            (.-ch fIgnoreConditionalBuffer)
                                            0
                                            (unchecked-subtract-int
                                              (.-length fIgnoreConditionalBuffer)
                                              2))
                                (.ignoredCharacters fDTDHandler fLiteral nil)
                                (.endConditional fDTDHandler nil))

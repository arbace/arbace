                    (.reportFatalError this "MSG_MARKUP_NOT_RECOGNIZED_IN_DTD" nil))))
          (and (> fIncludeSectDepth 0) (.skipChar (.-fEntityScanner this) \] nil))
            (do
              (when (or (not (.skipChar (.-fEntityScanner this) \] nil))
                        (not (.skipChar (.-fEntityScanner this) \> nil)))
                (.reportFatalError this "IncludeSectUnterminated" nil))
              (when (some? fDTDHandler) (.endConditional fDTDHandler nil))
              (set! fIncludeSectDepth (unchecked-dec-int fIncludeSectDepth))
              (set! fMarkUpDepth (unchecked-dec-int fMarkUpDepth)))
          (and (.scanningInternalSubset this) (== (.peekChar (.-fEntityScanner this)) \]))
            (return false)
          :else
            (when-not (.skipSpaces (.-fEntityScanner this))
              (.reportFatalError this "MSG_MARKUP_NOT_RECOGNIZED_IN_DTD" nil)))
        (.skipSeparator this false true))
      (not (== fScannerState SCANNER_STATE_END_OF_INPUT))))

  (method ^:private skipSeparator :throws [IOException XNIException] ^boolean [this
                                                                               ^boolean spaceRequired
                                                                               ^boolean lookForPERefs]
    (let [depth fPEDepth
          sawSpace (.skipSpaces (.-fEntityScanner this))]
      (if (or (not lookForPERefs)
              (not (.skipChar (.-fEntityScanner this) \% XMLScanner$NameType/REFERENCE)))
          (or (or (not spaceRequired) sawSpace) (not (== depth fPEDepth)))
          (while true
            (let [name (.scanName (.-fEntityScanner this) XMLScanner$NameType/ENTITY)]
              (if (nil? name)
                  (.reportFatalError this "NameRequiredInPEReference" nil)
                  (when-not (.skipChar (.-fEntityScanner this) \; XMLScanner$NameType/REFERENCE)
                    (.reportFatalError this "SemicolonRequiredInPEReference" (new Object/1 [name]))))
              (.startPE this name false)
              (.skipSpaces (.-fEntityScanner this))
              (when-not (.skipChar (.-fEntityScanner this) \% XMLScanner$NameType/REFERENCE)
                (return true)))))))

  (method ^:private ^:final pushContentStack ^void [this ^int c]
    (when (== (alength fContentStack) fContentDepth)
      (let [newStack (new int/1 (unchecked-multiply-int fContentDepth 2))]
        (System/arraycopy fContentStack 0 newStack 0 fContentDepth)
        (set! fContentStack newStack)))
    (aset fContentStack
          (let [old-5 fContentDepth] (set! fContentDepth (unchecked-inc-int fContentDepth)) old-5)
          c))

  (method ^:private ^:final popContentStack ^int [this]
    (aget fContentStack (set! fContentDepth (unchecked-dec-int fContentDepth))))

  (method ^:private ^:final pushPEStack ^void [this ^int depth ^boolean report]
    (when (== (alength fPEStack) fPEDepth)
      (let [newIntStack (new int/1 (unchecked-multiply-int fPEDepth 2))]
        (System/arraycopy fPEStack 0 newIntStack 0 fPEDepth)
        (set! fPEStack newIntStack)
        (let [newBooleanStack (new boolean/1 (unchecked-multiply-int fPEDepth 2))]
          (System/arraycopy fPEReport 0 newBooleanStack 0 fPEDepth)
          (set! fPEReport newBooleanStack))))
    (aset fPEReport fPEDepth report)
    (aset fPEStack (let [old-6 fPEDepth] (set! fPEDepth (unchecked-inc-int fPEDepth)) old-6) depth))

  (method ^:private ^:final popPEStack ^int [this]
    (aget fPEStack (set! fPEDepth (unchecked-dec-int fPEDepth))))

  (method ^:private ^:final peekReportEntity ^boolean [this]
    (aget fPEReport (unchecked-subtract-int fPEDepth 1)))

  (method ^:private ^:final ensureEnumerationSize ^void [this ^int size]
    (when (== (alength fEnumeration) size)
      (let [newEnum (new String/1 (unchecked-multiply-int size 2))]
        (System/arraycopy fEnumeration 0 newEnum 0 size)
        (set! fEnumeration newEnum))))

  (method ^:private init ^void [this]
    (set! fStartDTDCalled false)
    (set! fExtEntityDepth 0)
    (set! fIncludeSectDepth 0)
    (set! fMarkUpDepth 0)
    (set! fPEDepth 0)
    (set! fStandalone false)
    (set! fSeenExternalDTD false)
    (set! fSeenExternalPE false)
    (.setScannerState this SCANNER_STATE_TEXT_DECL)
    (set! (.-fLimitAnalyzer this) (.-fLimitAnalyzer (.-fEntityManager this)))
    (set! (.-fSecurityManager this) (.-fSecurityManager (.-fEntityManager this))))

  (method ^:public getGrammar ^DTDGrammar [this] nvGrammarInfo))

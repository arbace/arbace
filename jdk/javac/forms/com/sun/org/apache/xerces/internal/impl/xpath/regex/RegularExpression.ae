                            (and (== (unchecked-add-int offset 1) (.-limit con))
                                 (RegularExpression/isEOLChar (.charAt target offset))))
                        (and (and (== (unchecked-add-int offset 2) (.-limit con))
                                  (== (.charAt target offset) CARRIAGE_RETURN))
                             (== (.charAt target (unchecked-add-int offset 1)) LINE_FEED)))

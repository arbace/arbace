    (set! (.-firstChar this) nil)
    (when (and (not (RegularExpression/isSet (.-options this) PROHIBIT_HEAD_CHARACTER_OPTIMIZATION))
               (not (RegularExpression/isSet (.-options this) XMLSCHEMA_MODE)))
      (let [firstChar (Token/createRange)
            fresult (.analyzeFirstCharacter (.-tokentree this) firstChar (.-options this))]
        (when (== fresult Token/FC_TERMINAL)
          (.compactRanges firstChar)
          (set! (.-firstChar this) firstChar)
          (when DEBUG
            (.println System/err
                      (java-str "DEBUG: Use the first character optimization: " firstChar))))))
    (cond
      (and (and (some? (.-operations this))
                (or (== (.-type (.-operations this)) Op/STRING)
                    (== (.-type (.-operations this)) Op/CHAR)))
           (nil? (.-next (.-operations this))))
        (do
          (when DEBUG (.print System/err " *** Only fixed string! *** "))
          (set! (.-fixedStringOnly this) true)
          (cond
            (== (.-type (.-operations this)) Op/STRING)
              (set! (.-fixedString this) (.getString (.-operations this)))
            (>= (.getData (.-operations this)) 0x10000)
              (set! (.-fixedString this)
                    (REUtil/decomposeToSurrogates (.getData (.-operations this))))
            :else
              (let [ac (new char/1 1)]
                (aset ac 0 (unchecked-char (.getData (.-operations this))))
                (set! (.-fixedString this) (String. ac))))
          (set! (.-fixedStringOptions this) (.-options this))
          (set! (.-fixedStringTable this)
                (BMPattern. (.-fixedString this)
                            256
                            (RegularExpression/isSet (.-fixedStringOptions this) IGNORE_CASE))))
      (and (not (RegularExpression/isSet (.-options this) PROHIBIT_FIXED_STRING_OPTIMIZATION))
           (not (RegularExpression/isSet (.-options this) XMLSCHEMA_MODE)))
        (let [container (Token$FixedStringContainer.)]
          (.findFixedString (.-tokentree this) container (.-options this))
          (set! (.-fixedString this)
                (when (some? (.-token container)) (.getString (.-token container))))
          (set! (.-fixedStringOptions this) (.-options container))
          (when (and (some? (.-fixedString this)) (< (.length (.-fixedString this)) 2))
            (set! (.-fixedString this) nil))
          (when (some? (.-fixedString this))
            (set! (.-fixedStringTable this)
                  (BMPattern. (.-fixedString this)
                              256
                              (RegularExpression/isSet (.-fixedStringOptions this) IGNORE_CASE)))
            (when DEBUG
              (.println System/err
                        (java-str "DEBUG: The longest fixed string: "
                                  (.length (.-fixedString this))
                                  "//"
                                  (REUtil/createOptionString (.-fixedStringOptions this))))
              (.print System/err "String: ")
              (REUtil/dumpString (.-fixedString this)))))))

  (field ^:static ^:final ^int IGNORE_CASE (bit-shift-left-int 1 1))

  (field ^:static ^:final ^int SINGLE_LINE (bit-shift-left-int 1 2))

  (field ^:static ^:final ^int MULTIPLE_LINES (bit-shift-left-int 1 3))

  (field ^:static ^:final ^int EXTENDED_COMMENT (bit-shift-left-int 1 4))

  (field ^:static ^:final ^int USE_UNICODE_CATEGORY (bit-shift-left-int 1 5))

  (field ^:static ^:final ^int UNICODE_WORD_BOUNDARY (bit-shift-left-int 1 6))

  (field ^:static ^:final ^int PROHIBIT_HEAD_CHARACTER_OPTIMIZATION (bit-shift-left-int 1 7))

  (field ^:static ^:final ^int PROHIBIT_FIXED_STRING_OPTIMIZATION (bit-shift-left-int 1 8))

  (field ^:static ^:final ^int XMLSCHEMA_MODE (bit-shift-left-int 1 9))

  (field ^:static ^:final ^int SPECIAL_COMMA (bit-shift-left-int 1 10))

  (method ^:private ^:static ^:final isSet ^boolean [^int options ^int flag]
    (== (bit-and-int options flag) flag))

  (constructor :throws [ParseException] ^:public [this ^String regex]
    (this. regex nil))

  (constructor :throws [ParseException] ^:public [this ^String regex ^String options]
    (.setPattern this regex options))

  (constructor :throws [ParseException] ^:public [this ^String regex ^String options ^Locale locale]
    (.setPattern this regex options locale))

  (constructor [this ^String regex ^Token tok ^int parens ^boolean hasBackReferences ^int options]
    (set! (.-regex this) regex)
    (set! (.-tokentree this) tok)
    (set! (.-nofparen this) parens)
    (set! (.-options this) options)
    (set! (.-hasBackReferences this) hasBackReferences))

  (method ^:public setPattern :throws [ParseException] ^void [this ^String newPattern]
    (.setPattern this newPattern (Locale/getDefault)))

  (method ^:public setPattern :throws [ParseException] ^void [this ^String newPattern ^Locale locale]
    (.setPattern this newPattern (.-options this) locale))

  (method ^:private setPattern :throws [ParseException] ^void [this ^String newPattern ^int options
                                                               ^Locale locale]
    (set! (.-regex this) newPattern)
    (set! (.-options this) options)
    (let [^RegexParser rp (if (RegularExpression/isSet
                                (.-options this)
                                RegularExpression/XMLSCHEMA_MODE)
                              ^RegexParser (ParserForXMLSchema. locale)
                              (RegexParser. locale))]
      (set! (.-tokentree this) (.parse rp (.-regex this) (.-options this)))
      (set! (.-nofparen this) (.-parennumber rp))
      (set! (.-hasBackReferences this) (.-hasBackReferences rp))
      (set! (.-operations this) nil)
      (set! (.-context this) nil)))

  (method ^:public setPattern :throws [ParseException] ^void [this ^String newPattern
                                                              ^String options]
    (.setPattern this newPattern options (Locale/getDefault)))

  (method ^:public setPattern :throws [ParseException] ^void [this ^String newPattern
                                                              ^String options ^Locale locale]
    (.setPattern this newPattern (REUtil/parseOptions options) locale))

  (method ^:public getPattern ^String [this] (.-regex this))

  (method ^:public toString ^String [this]
    (.toString (.-tokentree this) (.-options this)))

  (method ^:public getOptions ^String [this]
    (REUtil/createOptionString (.-options this)))

  (method ^:public equals ^boolean [this obj]
    (cond
      (nil? obj) false
      (not (instance? RegularExpression obj)) false
      :else
        (let [r (cast RegularExpression obj)]
          (and (.equals (.-regex this) (.-regex r)) (== (.-options this) (.-options r))))))

  (method equals ^boolean [this ^String pattern ^int options]
    (and (.equals (.-regex this) pattern) (== (.-options this) options)))

  (method ^:public hashCode ^int [this]
    (.hashCode (java-str (.-regex this) "/" (.getOptions this))))

  (method ^:public getNumberOfGroups ^int [this] (.-nofparen this))

  (field ^:private ^:static ^:final ^int WT_IGNORE 0)

  (field ^:private ^:static ^:final ^int WT_LETTER 1)

  (field ^:private ^:static ^:final ^int WT_OTHER 2)

  (method ^:private ^:static ^:final getWordType0 ^int [^char ch ^int opts]
    (if (not (RegularExpression/isSet opts UNICODE_WORD_BOUNDARY))
        (cond
          (RegularExpression/isSet opts USE_UNICODE_CATEGORY)
            (if (.match (Token/getRange "IsWord" true) ch) WT_LETTER WT_OTHER)
          (RegularExpression/isWordChar ch) WT_LETTER
          :else WT_OTHER)
        (switch (Character/getType ch)
          (Character/UPPERCASE_LETTER Character/LOWERCASE_LETTER
                                      Character/TITLECASE_LETTER
                                      Character/MODIFIER_LETTER
                                      Character/OTHER_LETTER
                                      Character/LETTER_NUMBER
                                      Character/DECIMAL_DIGIT_NUMBER
                                      Character/OTHER_NUMBER
                                      Character/COMBINING_SPACING_MARK)
            WT_LETTER
          (Character/FORMAT Character/NON_SPACING_MARK Character/ENCLOSING_MARK) WT_IGNORE
          Character/CONTROL (switch ch (\tab \newline \u000b \formfeed \return) WT_OTHER WT_IGNORE)
          WT_OTHER)))

  (field ^:static ^:final ^int LINE_FEED 0x000A)

  (field ^:static ^:final ^int CARRIAGE_RETURN 0x000D)

  (field ^:static ^:final ^int LINE_SEPARATOR 0x2028)

  (field ^:static ^:final ^int PARAGRAPH_SEPARATOR 0x2029)

  (method ^:private ^:static ^:final isEOLChar ^boolean [^int ch]
    (or (or (or (== ch LINE_FEED) (== ch CARRIAGE_RETURN)) (== ch LINE_SEPARATOR))
        (== ch PARAGRAPH_SEPARATOR)))

  (method ^:private ^:static ^:final isWordChar ^boolean [^int ch]
    (cond
      (== ch \_) true
      (< ch \0) false
      (> ch \z) false
      (<= ch \9) true
      (< ch \A) false
      (<= ch \Z) true
      (< ch \a) false
      :else true))

  (method ^:private ^:static ^:final matchIgnoreCase ^boolean [^int chardata ^int ch]
    (cond
      (== chardata ch) true
      (or (> chardata 0xffff) (> ch 0xffff)) false
      :else
        (let [uch1 (Character/toUpperCase (unchecked-char chardata))
              uch2 (Character/toUpperCase (unchecked-char ch))]
          (if (== uch1 uch2) true (== (Character/toLowerCase uch1) (Character/toLowerCase uch2)))))))

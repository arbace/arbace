            (when (or (== (.-length con) 0) (== offset (.-start con))) (return false))
            (when (or (not (== (RegularExpression/getWordType
                                 target
                                 (.-start con)
                                 (.-limit con)
                                 offset
                                 opts)
                               WT_OTHER))

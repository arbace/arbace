  (method ^:private calcFollowList ^void [this ^CMNode nodeCur]
    (cond
      (== (.type nodeCur) XMLContentSpec/CONTENTSPECNODE_CHOICE)
        (do
          (.calcFollowList this (.getLeft (cast CMBinOp nodeCur)))
          (.calcFollowList this (.getRight (cast CMBinOp nodeCur))))
      (== (.type nodeCur) XMLContentSpec/CONTENTSPECNODE_SEQ)
        (do
          (.calcFollowList this (.getLeft (cast CMBinOp nodeCur)))
          (.calcFollowList this (.getRight (cast CMBinOp nodeCur)))
          (let [last (.lastPos (.getLeft (cast CMBinOp nodeCur)))
                first (.firstPos (.getRight (cast CMBinOp nodeCur)))]
            (loop [^int index 0]
              (if (< index fLeafCount)
                  (if (.getBit last index)
                      (do (.union (aget fFollowList index) first) (recur (unchecked-inc-int index)))
                      (recur (unchecked-inc-int index)))
                  nil))))
      (or (== (.type nodeCur) XMLContentSpec/CONTENTSPECNODE_ZERO_OR_MORE)
          (== (.type nodeCur) XMLContentSpec/CONTENTSPECNODE_ONE_OR_MORE))
        (do
          (.calcFollowList this (.getChild (cast CMUniOp nodeCur)))
          (let [first (.firstPos nodeCur)
                last (.lastPos nodeCur)]
            (loop [^int index 0]
              (if (< index fLeafCount)
                  (if (.getBit last index)
                      (do (.union (aget fFollowList index) first) (recur (unchecked-inc-int index)))
                      (recur (unchecked-inc-int index)))
                  nil))))
      (== (.type nodeCur) XMLContentSpec/CONTENTSPECNODE_ZERO_OR_ONE)
        (.calcFollowList this (.getChild (cast CMUniOp nodeCur)))))

  (method ^:private dumpTree ^void [this ^CMNode nodeCur ^int level]
    (loop [^int index 0]
      (when (< index level) (.print System/out "   ") (recur (unchecked-inc-int index))))
    (let [type (.type nodeCur)]
      (cond
        (or (== type XMLContentSpec/CONTENTSPECNODE_CHOICE)
            (== type XMLContentSpec/CONTENTSPECNODE_SEQ))
          (do
            (if (== type XMLContentSpec/CONTENTSPECNODE_CHOICE)
                (.print System/out "Choice Node ")
                (.print System/out "Seq Node "))
            (when (.isNullable nodeCur) (.print System/out "Nullable "))
            (.print System/out "firstPos=")
            (.print System/out (.toString (.firstPos nodeCur)))
            (.print System/out " lastPos=")
            (.println System/out (.toString (.lastPos nodeCur)))
            (.dumpTree this (.getLeft (cast CMBinOp nodeCur)) (unchecked-add-int level 1))
            (.dumpTree this (.getRight (cast CMBinOp nodeCur)) (unchecked-add-int level 1)))
        (== (.type nodeCur) XMLContentSpec/CONTENTSPECNODE_ZERO_OR_MORE)
          (do
            (.print System/out "Rep Node ")
            (when (.isNullable nodeCur) (.print System/out "Nullable "))
            (.print System/out "firstPos=")
            (.print System/out (.toString (.firstPos nodeCur)))
            (.print System/out " lastPos=")
            (.println System/out (.toString (.lastPos nodeCur)))
            (.dumpTree this (.getChild (cast CMUniOp nodeCur)) (unchecked-add-int level 1)))
        (== (.type nodeCur) XMLContentSpec/CONTENTSPECNODE_LEAF)
          (do
            (.print System/out
                    (java-str "Leaf: (pos="
                              (.getPosition (cast CMLeaf nodeCur))
                              "), "
                              (.getElement (cast CMLeaf nodeCur))
                              "(elemIndex="
                              (.getElement (cast CMLeaf nodeCur))
                              ") "))
            (when (.isNullable nodeCur) (.print System/out " Nullable "))
            (.print System/out "firstPos=")
            (.print System/out (.toString (.firstPos nodeCur)))
            (.print System/out " lastPos=")
            (.println System/out (.toString (.lastPos nodeCur))))
        :else (throw (RuntimeException. "ImplementationMessages.VAL_NIICM")))))

  (method ^:private makeDefStateList ^int/1 [this]
    (let [retArray (new int/1 fElemMapSize)]
      (loop [^int index 0]
        (when (< index fElemMapSize) (aset retArray index -1) (recur (unchecked-inc-int index))))
      retArray))

  (method ^:private postTreeBuildInit ^int [this ^CMNode nodeCur ^:mutable ^int curIndex]
    (.setMaxStates nodeCur fLeafCount)

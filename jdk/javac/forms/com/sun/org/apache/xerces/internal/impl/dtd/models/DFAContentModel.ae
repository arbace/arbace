      (or (or (== (bit-and-int (.type nodeCur) 0x0f) XMLContentSpec/CONTENTSPECNODE_ANY)
              (== (bit-and-int (.type nodeCur) 0x0f) XMLContentSpec/CONTENTSPECNODE_ANY_LOCAL))
          (== (bit-and-int (.type nodeCur) 0x0f) XMLContentSpec/CONTENTSPECNODE_ANY_OTHER))
        (let [qname (QName. nil nil nil (.getURI (cast CMAny nodeCur)))]
          (aset fLeafList curIndex (CMLeaf. qname (.getPosition (cast CMAny nodeCur))))
          (aset fLeafListType curIndex (.type nodeCur))
          (set! curIndex (unchecked-inc-int curIndex)))
      (or (== (.type nodeCur) XMLContentSpec/CONTENTSPECNODE_CHOICE)
          (== (.type nodeCur) XMLContentSpec/CONTENTSPECNODE_SEQ))
        (do
          (set! curIndex (.postTreeBuildInit this (.getLeft (cast CMBinOp nodeCur)) curIndex))
          (set! curIndex (.postTreeBuildInit this (.getRight (cast CMBinOp nodeCur)) curIndex)))
      (or (or (== (.type nodeCur) XMLContentSpec/CONTENTSPECNODE_ZERO_OR_MORE)
              (== (.type nodeCur) XMLContentSpec/CONTENTSPECNODE_ONE_OR_MORE))
          (== (.type nodeCur) XMLContentSpec/CONTENTSPECNODE_ZERO_OR_ONE))
        (set! curIndex (.postTreeBuildInit this (.getChild (cast CMUniOp nodeCur)) curIndex))
      (== (.type nodeCur) XMLContentSpec/CONTENTSPECNODE_LEAF)
        (let [node (.getElement (cast CMLeaf nodeCur))]
          (when-not (identical? (.-localpart node) fEpsilonString)
            (aset fLeafList curIndex (cast CMLeaf nodeCur))
            (aset fLeafListType curIndex XMLContentSpec/CONTENTSPECNODE_LEAF)
            (set! curIndex (unchecked-inc-int curIndex))))
      :else
        (throw (RuntimeException.
                 (java-str "ImplementationMessages.VAL_NIICM: type=" (.type nodeCur)))))
    curIndex))

  (method ^:public getNodeExtra ^int [this ^int nodeIndex ^boolean free]
    (if (== nodeIndex -1)
        -1
        (let [chunk (bit-shift-right-int nodeIndex CHUNK_SHIFT)
              index (bit-and-int nodeIndex CHUNK_MASK)]
          (if free
              (.clearChunkIndex this fNodeExtra chunk index)
              (.getChunkIndex this fNodeExtra chunk index)))))

  (method ^:public getNodeType ^short [this ^int nodeIndex]
    (.getNodeType this nodeIndex true))

  (method ^:public getNodeType ^short [this ^int nodeIndex ^boolean free]
    (if (== nodeIndex -1)
        -1
        (let [chunk (bit-shift-right-int nodeIndex CHUNK_SHIFT)
              index (bit-and-int nodeIndex CHUNK_MASK)]
          (if free
              (unchecked-short (.clearChunkIndex this fNodeType chunk index))
              (unchecked-short (.getChunkIndex this fNodeType chunk index))))))

  (method ^:public getAttribute ^String [this ^int elemIndex ^String name]
    (when-not (or (== elemIndex -1) (nil? name))
      (let [echunk (bit-shift-right-int elemIndex CHUNK_SHIFT)
            eindex (bit-and-int elemIndex CHUNK_MASK)
            ^:mutable attrIndex (.getChunkIndex this fNodeExtra echunk eindex)]
        (while (not (== attrIndex -1))
          (let [achunk (bit-shift-right-int attrIndex CHUNK_SHIFT)
                aindex (bit-and-int attrIndex CHUNK_MASK)]
            (when (identical? (.getChunkValue this fNodeName achunk aindex) name)
              (return (.getChunkValue this fNodeValue achunk aindex)))
            (set! attrIndex (.getChunkIndex this fNodePrevSib achunk aindex))))
        nil)))

  (method ^:public getNodeURI ^String [this ^int nodeIndex]
    (.getNodeURI this nodeIndex true))

  (method ^:public getNodeURI ^String [this ^int nodeIndex ^boolean free]
    (when-not (== nodeIndex -1)
      (let [chunk (bit-shift-right-int nodeIndex CHUNK_SHIFT)
            index (bit-and-int nodeIndex CHUNK_MASK)]
        (if free
            (.clearChunkValue this fNodeURI chunk index)
            (.getChunkValue this fNodeURI chunk index)))))

  (method ^:public putIdentifier ^void [this ^String name ^int elementNodeIndex]
    (when DEBUG_IDS
      (.println System/out
                (java-str "putIdentifier("
                          name
                          ", "
                          elementNodeIndex
                          \)
                          " // "
                          (.getChunkValue this
                                          fNodeName
                                          (bit-shift-right-int elementNodeIndex CHUNK_SHIFT)
                                          (bit-and-int elementNodeIndex CHUNK_MASK)))))
    (when (nil? fIdName) (set! fIdName (new String/1 64)) (set! fIdElement (new int/1 64)))
    (when (== fIdCount (alength fIdName))
      (let [idName (new String/1 (unchecked-multiply-int fIdCount 2))]
        (System/arraycopy fIdName 0 idName 0 fIdCount)
        (set! fIdName idName)
        (let [idElement (new int/1 (alength idName))]
          (System/arraycopy fIdElement 0 idElement 0 fIdCount)
          (set! fIdElement idElement))))
    (aset fIdName fIdCount name)
    (aset fIdElement fIdCount elementNodeIndex)
    (set! fIdCount (unchecked-inc-int fIdCount)))

  (method ^:public print ^void [this]
    (when DEBUG_PRINT_REF_COUNTS
      (.print System/out "num\t")
      (.print System/out "type\t")
      (.print System/out "name\t")
      (.print System/out "val\t")
      (.print System/out "par\t")
      (.print System/out "lch\t")
      (.print System/out "psib")
      (.println System/out)
      (loop [^int i 0]
        (if (< i (alength fNodeType))
            (if (some? (aget fNodeType i))
                (do
                  (.print System/out "--------")
                  (.print System/out "--------")
                  (.print System/out "--------")
                  (.print System/out "--------")
                  (.print System/out "--------")
                  (.print System/out "--------")
                  (.print System/out "--------")
                  (.println System/out)
                  (.print System/out i)
                  (.print System/out \tab)
                  (switch (aget fNodeType i CHUNK_SIZE)
                    DocumentImpl/ELEMENT_DEFINITION_NODE (.print System/out "EDef")
                    Node/DOCUMENT_NODE (.print System/out "Doc")
                    Node/DOCUMENT_TYPE_NODE (.print System/out "DType")
                    Node/COMMENT_NODE (.print System/out "Com")
                    Node/PROCESSING_INSTRUCTION_NODE (.print System/out "PI")
                    Node/ELEMENT_NODE (.print System/out "Elem")
                    Node/ENTITY_NODE (.print System/out "Ent")
                    Node/ENTITY_REFERENCE_NODE (.print System/out "ERef")
                    Node/TEXT_NODE (.print System/out "Text")
                    Node/ATTRIBUTE_NODE (.print System/out "Attr")
                    DeferredNode/TYPE_NODE (.print System/out "TypeInfo")
                    (.print System/out (java-str "?" (aget fNodeType i CHUNK_SIZE))))
                  (.print System/out \tab)
                  (.print System/out (aget fNodeName i CHUNK_SIZE))
                  (.print System/out \tab)
                  (.print System/out (aget fNodeValue i CHUNK_SIZE))
                  (.print System/out \tab)
                  (.print System/out (aget fNodeURI i CHUNK_SIZE))
                  (.print System/out \tab)
                  (.print System/out (aget fNodeParent i CHUNK_SIZE))
                  (.print System/out \tab)
                  (.print System/out (aget fNodeLastChild i CHUNK_SIZE))
                  (.print System/out \tab)
                  (.print System/out (aget fNodePrevSib i CHUNK_SIZE))
                  (.print System/out \tab)
                  (.print System/out (aget fNodeExtra i CHUNK_SIZE))
                  (.println System/out)
                  (recur (unchecked-inc-int i)))
                (recur (unchecked-inc-int i)))
            nil)))
    (when DEBUG_PRINT_TABLES
      (.println System/out "# start table")
      (loop [^int i 0]
        (when (< i fNodeCount)
          (let [chunk (bit-shift-right-int i CHUNK_SHIFT)
                index (bit-and-int i CHUNK_MASK)]
            (when (== (unchecked-remainder-int i 10) 0)
              (.print System/out "num\t")
              (.print System/out "type\t")
              (.print System/out "name\t")
              (.print System/out "val\t")
              (.print System/out "uri\t")
              (.print System/out "par\t")
              (.print System/out "lch\t")
              (.print System/out "psib\t")
              (.print System/out "xtra")
              (.println System/out))
            (.print System/out i)
            (.print System/out \tab)
            (switch (.getChunkIndex this fNodeType chunk index)
              DocumentImpl/ELEMENT_DEFINITION_NODE (.print System/out "EDef")
              Node/DOCUMENT_NODE (.print System/out "Doc")
              Node/DOCUMENT_TYPE_NODE (.print System/out "DType")
              Node/COMMENT_NODE (.print System/out "Com")
              Node/PROCESSING_INSTRUCTION_NODE (.print System/out "PI")
              Node/ELEMENT_NODE (.print System/out "Elem")
              Node/ENTITY_NODE (.print System/out "Ent")
              Node/ENTITY_REFERENCE_NODE (.print System/out "ERef")
              Node/TEXT_NODE (.print System/out "Text")
              Node/ATTRIBUTE_NODE (.print System/out "Attr")
              DeferredNode/TYPE_NODE (.print System/out "TypeInfo")
              (.print System/out (java-str "?" (.getChunkIndex this fNodeType chunk index))))
            (.print System/out \tab)
            (.print System/out (.getChunkValue this fNodeName chunk index))
            (.print System/out \tab)
            (.print System/out (.getNodeValue this chunk index))
            (.print System/out \tab)
            (.print System/out (.getChunkValue this fNodeURI chunk index))
            (.print System/out \tab)
            (.print System/out (.getChunkIndex this fNodeParent chunk index))
            (.print System/out \tab)
            (.print System/out (.getChunkIndex this fNodeLastChild chunk index))
            (.print System/out \tab)
            (.print System/out (.getChunkIndex this fNodePrevSib chunk index))
            (.print System/out \tab)
            (.print System/out (.getChunkIndex this fNodeExtra chunk index))
            (.println System/out)
            (recur (unchecked-inc-int i)))))
      (.println System/out "# end table")))

  (method ^:public getNodeIndex ^int [this] 0)

  (method ^:protected synchronizeData ^void [this]
    (.needsSyncData this false)
    (when (some? fIdElement)
      (let [path (IntVector.)
            ^:mutable ^int i 0]
        (while (< i fIdCount)
          (let [elementNodeIndex (aget fIdElement i)
                ^:mutable idName (aget fIdName i)]
            (when (some? idName)
              (.removeAllElements path)
              (let [^:mutable index elementNodeIndex]
                (loop []
                  (.addElement path index)
                  (let [pchunk (bit-shift-right-int index CHUNK_SHIFT)
                        pindex (bit-and-int index CHUNK_MASK)]
                    (set! index (.getChunkIndex this fNodeParent pchunk pindex)))
                  (when-not (== index -1) (recur)))
                (let [^:mutable ^Node place this]
                  (loop [^int j (unchecked-subtract-int (.size path) 2)]
                    (when (>= j 0)
                      (set! index (.elementAt path j))
                      (let [^:mutable child (.getLastChild place)]
                        (while (some? child)
                          (when (instance? DeferredNode child)
                            (let [nodeIndex (.getNodeIndex (cast DeferredNode child))]
                              (when (== nodeIndex index) (set! place child) (break))))
                          (set! child (.getPreviousSibling child)))
                        (recur (unchecked-dec-int j)))))
                  (let [element (cast Element place)]
                    (.putIdentifier0 this idName element)
                    (aset fIdName i nil)
                    (while (and (< (unchecked-add-int i 1) fIdCount)
                                (== (aget fIdElement (unchecked-add-int i 1)) elementNodeIndex))
                      (set! idName (aget fIdName (set! i (unchecked-inc-int i))))
                      (when (some? idName) (.putIdentifier0 this idName element))))))))
          (set! i (unchecked-inc-int i))))))

  (method ^:protected synchronizeChildren ^void [this]
    (when (.needsSyncData this)
      (.synchronizeData this)
      (when-not (.needsSyncChildren this) (return)))
    (let [orig (.-mutationEvents this)]
      (set! (.-mutationEvents this) false)
      (.needsSyncChildren this false)
      (.getNodeType this 0)
      (let [^:mutable ^ChildNode first nil
            ^:mutable ^ChildNode last nil]
        (loop [^int index (.getLastChild this 0)]
          (when-not (== index -1)
            (let [node (cast ChildNode (.getNodeObject this index))]
              (if (nil? last) (set! last node) (set! (.-previousSibling first) node))
              (set! (.-ownerNode node) this)
              (.isOwned node true)
              (set! (.-nextSibling node) first)
              (set! first node)
              (let [^int type (.getNodeType node)]
                (cond
                  (== type Node/ELEMENT_NODE)
                    (do
                      (set! (.-docElement this) (cast ElementImpl node))
                      (recur (.getPrevSibling this index)))
                  (== type Node/DOCUMENT_TYPE_NODE)
                    (do
                      (set! (.-docType this) (cast DocumentTypeImpl node))
                      (recur (.getPrevSibling this index)))
                  :else (recur (.getPrevSibling this index)))))))
        (when (some? first)
          (set! (.-firstChild this) first)
          (.isFirstChild first true)
          (.lastChild this last))
        (set! (.-mutationEvents this) orig))))

  (method ^:protected ^:final synchronizeChildren ^void [this ^AttrImpl a ^int nodeIndex]
    (let [orig (.getMutationEvents this)]
      (.setMutationEvents this false)
      (.needsSyncChildren a false)
      (let [last (.getLastChild this nodeIndex)
            prev (.getPrevSibling this last)]
        (if (== prev -1)
            (do (set! (.-value a) (.getNodeValueString this nodeIndex)) (.hasStringValue a true))
            (let [^:mutable ^ChildNode firstNode nil
                  ^:mutable ^ChildNode lastNode nil]
              (loop [^int index last]
                (when-not (== index -1)
                  (let [node (cast ChildNode (.getNodeObject this index))]
                    (if (nil? lastNode)
                        (set! lastNode node)
                        (set! (.-previousSibling firstNode) node))
                    (set! (.-ownerNode node) a)
                    (.isOwned node true)
                    (set! (.-nextSibling node) firstNode)
                    (set! firstNode node)
                    (recur (.getPrevSibling this index)))))
              (when (some? lastNode)
                (set! (.-value a) firstNode)
                (.isFirstChild firstNode true)
                (.lastChild a lastNode))
              (.hasStringValue a false)))
        (.setMutationEvents this orig))))

  (method ^:protected ^:final synchronizeChildren ^void [this ^ParentNode p ^int nodeIndex]
    (let [orig (.getMutationEvents this)]
      (.setMutationEvents this false)
      (.needsSyncChildren p false)
      (let [^:mutable ^ChildNode firstNode nil
            ^:mutable ^ChildNode lastNode nil]
        (loop [^int index (.getLastChild this nodeIndex)]
          (when-not (== index -1)
            (let [node (cast ChildNode (.getNodeObject this index))]
              (if (nil? lastNode) (set! lastNode node) (set! (.-previousSibling firstNode) node))
              (set! (.-ownerNode node) p)
              (.isOwned node true)
              (set! (.-nextSibling node) firstNode)
              (set! firstNode node)
              (recur (.getPrevSibling this index)))))
        (when (some? lastNode)
          (set! (.-firstChild p) firstNode)
          (.isFirstChild firstNode true)
          (.lastChild p lastNode))
        (.setMutationEvents this orig))))

  (method ^:protected ensureCapacity ^void [this ^int chunk]
    (cond
      (nil? fNodeType)
        (do
          (set! fNodeType (new int/2 INITIAL_CHUNK_COUNT))
          (set! fNodeName (new Object/2 INITIAL_CHUNK_COUNT))
          (set! fNodeValue (new Object/2 INITIAL_CHUNK_COUNT))
          (set! fNodeParent (new int/2 INITIAL_CHUNK_COUNT))
          (set! fNodeLastChild (new int/2 INITIAL_CHUNK_COUNT))
          (set! fNodePrevSib (new int/2 INITIAL_CHUNK_COUNT))
          (set! fNodeURI (new Object/2 INITIAL_CHUNK_COUNT))
          (set! fNodeExtra (new int/2 INITIAL_CHUNK_COUNT)))
      (<= (alength fNodeType) chunk)
        (let [newsize (unchecked-multiply-int chunk 2)
              ^:mutable newArray (new int/2 newsize)]
          (System/arraycopy fNodeType 0 newArray 0 chunk)
          (set! fNodeType newArray)
          (let [^:mutable newStrArray (new Object/2 newsize)]
            (System/arraycopy fNodeName 0 newStrArray 0 chunk)
            (set! fNodeName newStrArray)
            (set! newStrArray (new Object/2 newsize))
            (System/arraycopy fNodeValue 0 newStrArray 0 chunk)
            (set! fNodeValue newStrArray)
            (set! newArray (new int/2 newsize))
            (System/arraycopy fNodeParent 0 newArray 0 chunk)
            (set! fNodeParent newArray)
            (set! newArray (new int/2 newsize))
            (System/arraycopy fNodeLastChild 0 newArray 0 chunk)
            (set! fNodeLastChild newArray)
            (set! newArray (new int/2 newsize))
            (System/arraycopy fNodePrevSib 0 newArray 0 chunk)
            (set! fNodePrevSib newArray)
            (set! newStrArray (new Object/2 newsize))
            (System/arraycopy fNodeURI 0 newStrArray 0 chunk)
            (set! fNodeURI newStrArray)
            (set! newArray (new int/2 newsize))
            (System/arraycopy fNodeExtra 0 newArray 0 chunk)
            (set! fNodeExtra newArray)))
      (some? (aget fNodeType chunk)) (return))
    (.createChunk this fNodeType chunk)
    (.createChunk this fNodeName chunk)
    (.createChunk this fNodeValue chunk)
    (.createChunk this fNodeParent chunk)
    (.createChunk this fNodeLastChild chunk)
    (.createChunk this fNodePrevSib chunk)
    (.createChunk this fNodeURI chunk)
    (.createChunk this fNodeExtra chunk))

  (method ^:protected createNode ^int [this ^short nodeType]
    (let [chunk (bit-shift-right-int fNodeCount CHUNK_SHIFT)
          index (bit-and-int fNodeCount CHUNK_MASK)]
      (.ensureCapacity this chunk)
      (.setChunkIndex this fNodeType nodeType chunk index)
      (let [fNodeCount-1 fNodeCount] (set! fNodeCount (unchecked-inc-int fNodeCount)) fNodeCount-1)))

  (method ^:protected ^:static binarySearch ^int [^:final ^int/1 values ^:mutable ^int start
                                                  ^:mutable ^int end ^int target]
    (when DEBUG_IDS (.println System/out (java-str "binarySearch(), target: " target)))
    (while (<= start end)
      (let [^:mutable middle (unsigned-bit-shift-right-int (unchecked-add-int start end) 1)
            value (aget values middle)]
        (when DEBUG_IDS
          (.print System/out (java-str "  value: " value ", target: " target " // "))
          (DeferredDocumentImpl/print values start end middle target))
        (when (== value target)
          (while (and (> middle 0) (== (aget values (unchecked-subtract-int middle 1)) target))
            (set! middle (unchecked-dec-int middle)))
          (when DEBUG_IDS (.println System/out (java-str "FOUND AT " middle)))
          (return middle))
        (if (> value target)
            (set! end (unchecked-subtract-int middle 1))
            (set! start (unchecked-add-int middle 1)))))
    (when DEBUG_IDS (.println System/out "NOT FOUND!"))
    -1)

  (field ^:private ^:static ^:final ^int/1 INIT_ARRAY (new int/1 (unchecked-add-int CHUNK_SIZE 1)))

  (static-initializer
    (loop [^int i 0] (when (< i CHUNK_SIZE) (aset INIT_ARRAY i -1) (recur (unchecked-inc-int i)))))

  (method ^:private ^:final createChunk ^void [this ^int/2 data ^int chunk]
    (aset data chunk (new int/1 (unchecked-add-int CHUNK_SIZE 1)))
    (System/arraycopy INIT_ARRAY 0 (aget data chunk) 0 CHUNK_SIZE))

  (defclass ^:static ^:final RefCount
    (field ^int fCount))

  (method ^:private ^:final createChunk ^void [this ^Object/2 data ^int chunk]
    (aset data chunk (new Object/1 (unchecked-add-int CHUNK_SIZE 1)))
    (aset (aget data chunk) CHUNK_SIZE (RefCount.)))

  (method ^:private ^:final setChunkIndex ^int [this ^int/2 data ^int value ^int chunk ^int index]
    (if (== value -1)
        (.clearChunkIndex this data chunk index)
        (let [^:mutable dataChunk (aget data chunk)]
          (when (nil? dataChunk) (.createChunk this data chunk) (set! dataChunk (aget data chunk)))
          (let [ovalue (aget dataChunk index)]
            (when (== ovalue -1)
              (aset dataChunk CHUNK_SIZE (unchecked-inc-int (aget dataChunk CHUNK_SIZE))))
            (aset dataChunk index value)
            ovalue))))

  (method ^:private ^:final setChunkValue ^String [this ^Object/2 data value ^int chunk ^int index]
    (if (nil? value)
        (.clearChunkValue this data chunk index)
        (let [^:mutable dataChunk (aget data chunk)]
          (when (nil? dataChunk) (.createChunk this data chunk) (set! dataChunk (aget data chunk)))
          (let [ovalue (cast String (aget dataChunk index))]
            (when (nil? ovalue)
              (let [c (cast RefCount (aget dataChunk CHUNK_SIZE))]
                (set! (.-fCount c) (unchecked-inc-int (.-fCount c)))))
            (aset dataChunk index value)
            ovalue))))

  (method ^:private ^:final getChunkIndex ^int [this ^int/2 data ^int chunk ^int index]
    (if (some? (aget data chunk)) (aget data chunk index) -1))

  (method ^:private ^:final getChunkValue ^String [this ^Object/2 data ^int chunk ^int index]
    (when (some? (aget data chunk)) (cast String (aget data chunk index))))

  (method ^:private ^:final getNodeValue ^String [this ^int chunk ^int index]
    (let [data (aget fNodeValue chunk index)]
      (when (some? data) (if (instance? String data) (cast String data) (.toString data)))))

  (method ^:private ^:final clearChunkIndex ^int [this ^int/2 data ^int chunk ^int index]
    (let [^int value (if (some? (aget data chunk)) (aget data chunk index) -1)]
      (when-not (== value -1)
        (let [arr-2 (aget data chunk)]
          (aset arr-2 CHUNK_SIZE (unchecked-dec-int (aget arr-2 CHUNK_SIZE))))
        (aset (aget data chunk) index -1)
        (when (== (aget data chunk CHUNK_SIZE) 0) (aset data chunk nil)))
      value))

  (method ^:private ^:final clearChunkValue ^String [this ^Object/2 data ^int chunk ^int index]
    (let [^String value (when (some? (aget data chunk)) (cast String (aget data chunk index)))]
      (when (some? value)
        (aset (aget data chunk) index nil)
        (let [c (cast RefCount (aget data chunk CHUNK_SIZE))]
          (set! (.-fCount c) (unchecked-dec-int (.-fCount c)))
          (when (== (.-fCount c) 0) (aset data chunk nil))))
      value))

  (method ^:private ^:final putIdentifier0 ^void [this ^String idName ^Element element]
    (when DEBUG_IDS (.println System/out (java-str "putIdentifier0(" idName ", " element \))))
    (when (nil? (.-identifiers this)) (set! (.-identifiers this) (HashMap.)))
    (.put (.-identifiers this) idName element))

  (method ^:private ^:static print ^void [^int/1 values ^int start ^int end ^int middle ^int target]
    (when DEBUG_IDS
      (.print System/out start)
      (.print System/out " [")
      (loop [^int i start]
        (when (< i end)
          (when (== middle i) (.print System/out "!"))
          (.print System/out (aget values i))
          (when (== (aget values i) target) (.print System/out "*"))
          (if (< i (unchecked-subtract-int end 1))
              (do (.print System/out " ") (recur (unchecked-inc-int i)))
              (recur (unchecked-inc-int i)))))
      (.println System/out (java-str "] " end))))

  (defclass ^:static ^:final IntVector
    (field ^:private ^int/1 data)

    (field ^:private ^int size)

    (method ^:public size ^int [this] size)

    (method ^:public elementAt ^int [this ^int index] (aget data index))

    (method ^:public addElement ^void [this ^int element]
      (.ensureCapacity this (unchecked-add-int size 1))
      (aset data (let [old-3 size] (set! size (unchecked-inc-int size)) old-3) element))

    (method ^:public removeAllElements ^void [this] (set! size 0))

    (method ^:private ensureCapacity ^void [this ^int newsize]
      (cond
        (nil? data) (set! data (new int/1 (unchecked-add-int newsize 15)))
        (> newsize (alength data))
          (let [newdata (new int/1 (unchecked-add-int newsize 15))]
            (System/arraycopy data 0 newdata 0 (alength data))
            (set! data newdata))))))

                                            (unchecked-subtract-int fIdCount 1)
                                            nodeIndex)]
                    (while (not (== idIndex -1))
                      (when DEBUG_IDS
                        (.println System/out (java-str "  id index: " idIndex))
                        (.println System/out
                                  (java-str "  fIdName[" idIndex "]: " (aget fIdName idIndex))))
                      (let [name (aget fIdName idIndex)]
                        (when (some? name)
                          (when DEBUG_IDS
                            (.println System/out (java-str "  name: " name))
                            (.print System/out "getNodeObject()#"))
                          (.putIdentifier0 this name (cast Element node))
                          (aset fIdName idIndex nil))
                        (if (and (< (unchecked-add-int idIndex 1) fIdCount)
                                 (== (aget fIdElement (unchecked-add-int idIndex 1)) nodeIndex))
                            (set! idIndex (unchecked-inc-int idIndex))
                            (set! idIndex -1)))))))
            Node/ENTITY_NODE (set! node (DeferredEntityImpl. this nodeIndex))
            Node/ENTITY_REFERENCE_NODE (set! node (DeferredEntityReferenceImpl. this nodeIndex))
            Node/NOTATION_NODE (set! node (DeferredNotationImpl. this nodeIndex))
            Node/PROCESSING_INSTRUCTION_NODE
              (set! node (DeferredProcessingInstructionImpl. this nodeIndex))
            Node/TEXT_NODE (set! node (DeferredTextImpl. this nodeIndex))
            NodeImpl/ELEMENT_DEFINITION_NODE
              (set! node (DeferredElementDefinitionImpl. this nodeIndex))

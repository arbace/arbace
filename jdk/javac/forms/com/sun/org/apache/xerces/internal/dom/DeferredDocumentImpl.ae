                  (set! node (DeferredAttrImpl. this nodeIndex)))
            Node/CDATA_SECTION_NODE (set! node (DeferredCDATASectionImpl. this nodeIndex))
            Node/COMMENT_NODE (set! node (DeferredCommentImpl. this nodeIndex))
            Node/DOCUMENT_NODE (set! node this)
            Node/DOCUMENT_TYPE_NODE

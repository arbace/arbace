        (set! nchunk (bit-shift-right-int docTypeIndex CHUNK_SHIFT))
        (set! nindex (bit-and-int docTypeIndex CHUNK_MASK))
        (loop [^int index (.getChunkIndex this fNodeLastChild nchunk nindex)]
          (when-not (== index -1)
            (set! nchunk (bit-shift-right-int index CHUNK_SHIFT))
            (set! nindex (bit-and-int index CHUNK_MASK))
            (if (and (== (.getChunkIndex this fNodeType nchunk nindex)
                         NodeImpl/ELEMENT_DEFINITION_NODE)
                     (identical? (.getChunkValue this fNodeName nchunk nindex) elementName))
                (return index)
                (recur (.getChunkIndex this fNodePrevSib nchunk nindex)))))))
    -1)

  (method ^:public getNodeObject ^DeferredNode [this ^int nodeIndex]

  (method ^:public getNodeName ^String [this ^int nodeIndex ^boolean free]
    (when-not (== nodeIndex -1)
      (let [chunk (bit-shift-right-int nodeIndex CHUNK_SHIFT)
            index (bit-and-int nodeIndex CHUNK_MASK)]
        (if free
            (.clearChunkValue this fNodeName chunk index)
            (.getChunkValue this fNodeName chunk index)))))

  (method ^:public getNodeValueString ^String [this ^int nodeIndex]
    (.getNodeValueString this nodeIndex true))

  (method ^:public getNodeValueString ^String [this ^int nodeIndex ^boolean free]
    (when-not (== nodeIndex -1)
      (let [^:mutable chunk (bit-shift-right-int nodeIndex CHUNK_SHIFT)
            ^:mutable index (bit-and-int nodeIndex CHUNK_MASK)
            ^:mutable ^String value (if free
                                        (.clearChunkValue this fNodeValue chunk index)
                                        (.getChunkValue this fNodeValue chunk index))]
        (when (some? value)
          (let [type (.getChunkIndex this fNodeType chunk index)]
            (cond
              (== type Node/TEXT_NODE)
                (let [^:mutable prevSib (.getRealPrevSibling this nodeIndex)]
                  (when (and (not (== prevSib -1))
                             (== (.getNodeType this prevSib false) Node/TEXT_NODE))
                    (.add fStrChunks value)
                    (loop []
                      (set! chunk (bit-shift-right-int prevSib CHUNK_SHIFT))
                      (set! index (bit-and-int prevSib CHUNK_MASK))
                      (set! value (.getChunkValue this fNodeValue chunk index))
                      (.add fStrChunks value)
                      (set! prevSib (.getChunkIndex this fNodePrevSib chunk index))
                      (when (== prevSib -1) (break))
                      (when (== (.getNodeType this prevSib false) Node/TEXT_NODE) (recur)))
                    (let [chunkCount (.size fStrChunks)]
                      (loop [^int i (unchecked-subtract-int chunkCount 1)]
                        (when (>= i 0)
                          (.append fBufferStr (cast String (.get fStrChunks i)))
                          (recur (unchecked-dec-int i))))
                      (set! value (.toString fBufferStr))
                      (.clear fStrChunks)
                      (.setLength fBufferStr 0)
                      (return value))))
              (== type Node/CDATA_SECTION_NODE)
                (let [^:mutable child (.getLastChild this nodeIndex false)]
                  (when-not (== child -1)
                    (.append fBufferStr value)
                    (while (not (== child -1))
                      (set! chunk (bit-shift-right-int child CHUNK_SHIFT))
                      (set! index (bit-and-int child CHUNK_MASK))
                      (set! value (.getChunkValue this fNodeValue chunk index))
                      (.add fStrChunks value)
                      (set! child (.getChunkIndex this fNodePrevSib chunk index)))
                    (loop [^int i (unchecked-subtract-int (.size fStrChunks) 1)]
                      (when (>= i 0)
                        (.append fBufferStr (cast String (.get fStrChunks i)))
                        (recur (unchecked-dec-int i))))
                    (set! value (.toString fBufferStr))
                    (.clear fStrChunks)
                    (.setLength fBufferStr 0)
                    (return value))))
            value)))))

  (method ^:public getNodeValue ^String [this ^int nodeIndex]
    (.getNodeValue this nodeIndex true))

  (method ^:public getTypeInfo [this ^int nodeIndex]
    (when-not (== nodeIndex -1)
      (let [chunk (bit-shift-right-int nodeIndex CHUNK_SHIFT)
            index (bit-and-int nodeIndex CHUNK_MASK)
            value (when (some? (aget fNodeValue chunk)) (aget fNodeValue chunk index))]
        (when (some? value)
          (aset (aget fNodeValue chunk) index nil)
          (let [c (cast RefCount (aget fNodeValue chunk CHUNK_SIZE))]
            (set! (.-fCount c) (unchecked-dec-int (.-fCount c)))
            (when (== (.-fCount c) 0) (aset fNodeValue chunk nil))))
        value)))

  (method ^:public getNodeValue ^String [this ^int nodeIndex ^boolean free]
    (when-not (== nodeIndex -1)
      (let [chunk (bit-shift-right-int nodeIndex CHUNK_SHIFT)
            index (bit-and-int nodeIndex CHUNK_MASK)]
        (if free
            (.clearChunkValue this fNodeValue chunk index)
            (.getChunkValue this fNodeValue chunk index)))))

  (method ^:public getNodeExtra ^int [this ^int nodeIndex]

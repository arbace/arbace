                            (.add fNamespaceList tempNamespace)))
                        (catch InvalidDatatypeValueException ide
                          (throw
                            (InvalidDatatypeValueException.
                              "cvc-datatype-valid.1.2.3"
                              (new
                                Object/1
                                [value
                                 "((##any | ##other) | List of (anyURI | (##targetNamespace | ##local)) )"])))))
                      (let [num (.size fNamespaceList)
                            ^:mutable list (new String/1 num)]
                        (set! list (cast String/1 (.toArray fNamespaceList list)))
                        (aset attrValues ATTIDX_NAMESPACE_LIST list)))))
            DT_PROCESSCONTENTS
              (cond
                (.equals value SchemaSymbols/ATTVAL_STRICT) (set! retValue INT_ANY_STRICT)
                (.equals value SchemaSymbols/ATTVAL_LAX) (set! retValue INT_ANY_LAX)
                (.equals value SchemaSymbols/ATTVAL_SKIP) (set! retValue INT_ANY_SKIP)
                :else
                  (throw (InvalidDatatypeValueException.
                           "cvc-enumeration-valid"
                           (new Object/1 [value "(lax | skip | strict)"]))))
            DT_USE
              (cond
                (.equals value SchemaSymbols/ATTVAL_OPTIONAL) (set! retValue INT_USE_OPTIONAL)
                (.equals value SchemaSymbols/ATTVAL_REQUIRED) (set! retValue INT_USE_REQUIRED)
                (.equals value SchemaSymbols/ATTVAL_PROHIBITED) (set! retValue INT_USE_PROHIBITED)
                :else
                  (throw (InvalidDatatypeValueException.
                           "cvc-enumeration-valid"
                           (new Object/1 [value "(optional | prohibited | required)"]))))
            DT_WHITESPACE
              (cond
                (.equals value SchemaSymbols/ATTVAL_PRESERVE) (set! retValue INT_WS_PRESERVE)
                (.equals value SchemaSymbols/ATTVAL_REPLACE) (set! retValue INT_WS_REPLACE)
                (.equals value SchemaSymbols/ATTVAL_COLLAPSE) (set! retValue INT_WS_COLLAPSE)
                :else
                  (throw (InvalidDatatypeValueException.
                           "cvc-enumeration-valid"
                           (new Object/1 [value "(preserve | replace | collapse)"])))))
          retValue)))

    (method reportSchemaFatalError ^void [this ^String key ^Object/1 args ^Element ele]
      (.reportSchemaFatalError fSchemaHandler key args ele))

    (method reportSchemaError ^void [this ^String key ^Object/1 args ^Element ele]
      (.reportSchemaError fSchemaHandler key args ele))

    (method ^:public checkNonSchemaAttributes ^void [this ^XSGrammarBucket grammarBucket]
      (let [^:mutable ^XSAttributeDecl attrDecl nil]
        (for-each [^{:tag (Map$Entry String (List String))} entry (.entrySet fNonSchemaAttrs)]
          (let [attrRName (cast String (.getKey entry))
                attrURI (.substring attrRName 0 (.indexOf attrRName \,))
                attrLocal (.substring attrRName (unchecked-add-int (.indexOf attrRName \,) 1))
                sGrammar (.getGrammar grammarBucket attrURI)]
            (when (some? sGrammar)
              (set! attrDecl (.getGlobalAttributeDecl sGrammar attrLocal))
              (when (some? attrDecl)
                (let [dv (cast XSSimpleType (.getTypeDefinition attrDecl))]
                  (when (some? dv)
                    (let [^{:tag (List String)} values (cast List (.getValue entry))
                          ^:mutable ^String elName nil
                          attrName (cast String (.get values 0))
                          count (.size values)]
                      (loop [^int i 1]
                        (when (< i count)
                          (set! elName (cast String (.get values i)))
                          (try
                            (.validate dv
                                       (cast String (.get values (unchecked-add-int i 1)))
                                       nil
                                       nil)
                            (catch InvalidDatatypeValueException ide
                              (.reportSchemaError
                                this
                                "s4s-att-invalid-value"
                                (new Object/1 [elName attrName (.getMessage ide)])
                                nil)))
                          (recur (unchecked-add-int i 2)))))))))))))

    (method ^:public ^:static normalize ^String [^String content ^short ws]
      (let [^int len (if (nil? content) 0 (.length content))]
        (if (or (== len 0) (== ws XSSimpleType/WS_PRESERVE))
            content
            (let [sb (StringBuilder.)]
              (if (== ws XSSimpleType/WS_REPLACE)
                  (let [^:mutable ^char ch (unchecked-char 0)]
                    (loop [^int i 0]
                      (when (< i len)
                        (set! ch (.charAt content i))
                        (if (and (and (not (== ch 0x9)) (not (== ch 0xa))) (not (== ch 0xd)))
                            (do (.append sb ch) (recur (unchecked-inc-int i)))
                            (do (.append sb (unchecked-char 0x20)) (recur (unchecked-inc-int i)))))))
                  (let [^:mutable ^char ch (unchecked-char 0)
                        ^:mutable ^int i 0
                        ^:mutable isLeading true]
                    (set! i 0)
                    (while (< i len)
                      (set! ch (.charAt content i))
                      (if (and (and (and (not (== ch 0x9)) (not (== ch 0xa))) (not (== ch 0xd)))
                               (not (== ch 0x20)))
                          (do (.append sb ch) (set! isLeading false))
                          (do
                            (while (< i (unchecked-subtract-int len 1))
                              (set! ch (.charAt content (unchecked-add-int i 1)))
                              (when (and (and (and (not (== ch 0x9)) (not (== ch 0xa)))
                                              (not (== ch 0xd)))
                                         (not (== ch 0x20)))
                                (break))
                              (set! i (unchecked-inc-int i)))
                            (when (and (< i (unchecked-subtract-int len 1)) (not isLeading))
                              (.append sb (unchecked-char 0x20)))))
                      (set! i (unchecked-inc-int i)))))
              (.toString sb)))))

    (field ^:static ^:final ^int INIT_POOL_SIZE 10)

    (field ^:static ^:final ^int INC_POOL_SIZE 10)

    (field ^Object/2 fArrayPool (new Object/2 INIT_POOL_SIZE ATTIDX_COUNT))

    (field ^:private ^:static ^Object/1 fTempArray (new Object/1 ATTIDX_COUNT))

    (field ^int fPoolPos 0)

    (method ^:protected getAvailableArray ^Object/1 [this]
      (when (== (alength fArrayPool) fPoolPos)
        (set! fArrayPool (new Object/2 (unchecked-add-int fPoolPos INC_POOL_SIZE)))
        (loop [^int i fPoolPos]
          (when (< i (alength fArrayPool))
            (aset fArrayPool i (new Object/1 ATTIDX_COUNT))
            (recur (unchecked-inc-int i)))))
      (let [retArray (aget fArrayPool fPoolPos)]
        (aset fArrayPool
              (let [old-89 fPoolPos] (set! fPoolPos (unchecked-inc-int fPoolPos)) old-89)
              nil)
        (System/arraycopy fTempArray 0 retArray 0 (unchecked-subtract-int ATTIDX_COUNT 1))
        (aset retArray ATTIDX_ISRETURNED Boolean/FALSE)
        retArray))

    (method ^:public returnAttrArray ^void [this ^Object/1 attrArray ^XSDocumentInfo schemaDoc]
      (when (some? schemaDoc) (.popContext (.-fNamespaceSupport schemaDoc)))
      (when-not (or (or (or (== fPoolPos 0) (nil? attrArray))
                        (not (== (alength attrArray) ATTIDX_COUNT)))
                    (.booleanValue (cast Boolean (aget attrArray ATTIDX_ISRETURNED))))
        (aset attrArray ATTIDX_ISRETURNED Boolean/TRUE)
        (when (some? (aget attrArray ATTIDX_NONSCHEMA))
          (.clear (cast List (aget attrArray ATTIDX_NONSCHEMA))))
        (aset fArrayPool (set! fPoolPos (unchecked-dec-int fPoolPos)) attrArray)))

    (method ^:public resolveNamespace ^void [this ^Element element ^Attr/1 attrs
                                             ^SchemaNamespaceSupport nsSupport]
      (.pushContext nsSupport)
      (let [length (alength attrs)
            ^:mutable ^Attr sattr nil
            ^:mutable ^String rawname nil
            ^:mutable ^String prefix nil
            ^:mutable ^String uri nil]
        (loop [^int i 0]
          (when (< i length)
            (set! sattr (aget attrs i))
            (set! rawname (DOMUtil/getName sattr))
            (set! prefix nil)
            (cond
              (.equals rawname XMLSymbols/PREFIX_XMLNS) (set! prefix XMLSymbols/EMPTY_STRING)
              (.startsWith rawname "xmlns:")
                (set! prefix (.addSymbol fSymbolTable (DOMUtil/getLocalName sattr))))
            (if (some? prefix)
                (do
                  (set! uri (.addSymbol fSymbolTable (DOMUtil/getValue sattr)))
                  (.declarePrefix nsSupport prefix ^String (when-not (== (.length uri) 0) uri))
                  (recur (unchecked-inc-int i)))
                (recur (unchecked-inc-int i))))))))

  (defclass OneAttr
    (field ^:public ^String name)

    (field ^:public ^int dvIndex)

    (field ^:public ^int valueIndex)

    (field ^:public dfltValue)

    (constructor ^:public [this ^String name ^int dvIndex ^int valueIndex dfltValue]
      (set! (.-name this) name)
      (set! (.-dvIndex this) dvIndex)
      (set! (.-valueIndex this) valueIndex)
      (set! (.-dfltValue this) dfltValue)))

  (defclass ^:abstract Container
    (field ^:static ^:final ^int THRESHOLD 5)

    (method ^:static getContainer ^Container [^int size]
      (if (> size THRESHOLD) (LargeContainer. size) (SmallContainer. size)))

    (method ^:abstract put ^void [this ^String key ^OneAttr value])

    (method ^:abstract get ^OneAttr [this ^String key])

    (field ^OneAttr/1 values)

    (field ^int pos 0))

  (defclass SmallContainer
    :extends Container

    (field ^String/1 keys)

    (constructor [this ^int size]
      (set! keys (new String/1 size))
      (set! (.-values this) (new OneAttr/1 size)))

    (method put ^void [this ^String key ^OneAttr value]
      (aset keys (.-pos this) key)
      (aset (.-values this)
            (let [old-90 (.-pos this)] (set! (.-pos this) (unchecked-inc-int (.-pos this))) old-90)
            value))

    (method get ^OneAttr [this ^String key]
      (loop [^int i 0]
        (if (< i (.-pos this))
            (if (.equals (aget keys i) key)
                (return (aget (.-values this) i))
                (recur (unchecked-inc-int i)))
            nil))
      nil))

  (defclass LargeContainer
    :extends Container

    (field ^{:tag (Map String OneAttr)} items)

    (constructor [this ^int size]
      (set! items (HashMap/newHashMap size))
      (set! (.-values this) (new OneAttr/1 size)))

    (method put ^void [this ^String key ^OneAttr value]
      (.put items key value)
      (aset (.-values this)
            (let [old-91 (.-pos this)] (set! (.-pos this) (unchecked-inc-int (.-pos this))) old-91)
            value))

    (method get ^OneAttr [this ^String key]
      (let [ret (cast OneAttr (.get items key))] ret))))

    (field ^:protected ^XSDHandler fSchemaHandler nil)

    (field ^:protected ^SymbolTable fSymbolTable nil)

    (field ^:protected ^{:tag (Map String (List String))} fNonSchemaAttrs (HashMap.))

    (field ^:protected ^{:tag (List String)} fNamespaceList (ArrayList.))

    (field ^:protected ^boolean/1 fSeen (new boolean/1 ATTIDX_COUNT))

    (field ^:private ^:static ^boolean/1 fSeenTemp (new boolean/1 ATTIDX_COUNT))

    (constructor ^:public [this ^XSDHandler schemaHandler]
      (set! fSchemaHandler schemaHandler))

    (method ^:public reset ^void [this ^SymbolTable symbolTable]
      (set! fSymbolTable symbolTable)
      (.clear fNonSchemaAttrs))

    (method ^:public checkAttributes ^Object/1 [this ^Element element ^boolean isGlobal
                                                ^XSDocumentInfo schemaDoc]
      (.checkAttributes this element isGlobal schemaDoc false))

    (method ^:public checkAttributes ^Object/1 [this ^Element element ^boolean isGlobal
                                                ^XSDocumentInfo schemaDoc ^boolean enumAsQName]
      (when (some? element)
        (let [attrs (DOMUtil/getAttrs element)]
          (.resolveNamespace this element attrs (.-fNamespaceSupport schemaDoc))
          (let [uri (DOMUtil/getNamespaceURI element)
                elName (DOMUtil/getLocalName element)]
            (when-not (.equals SchemaSymbols/URI_SCHEMAFORSCHEMA uri)
              (.reportSchemaError this "s4s-elt-schema-ns" (new Object/1 [elName]) element))
            (let [^:mutable ^{:tag (Map String Container)} eleAttrsMap fEleAttrsMapG
                  ^:mutable lookupName elName]
              (when-not isGlobal
                (set! eleAttrsMap fEleAttrsMapL)
                (cond
                  (.equals elName SchemaSymbols/ELT_ELEMENT)
                    (if (some? (DOMUtil/getAttr element SchemaSymbols/ATT_REF))
                        (set! lookupName ELEMENT_R)
                        (set! lookupName ELEMENT_N))
                  (.equals elName SchemaSymbols/ELT_ATTRIBUTE)
                    (if (some? (DOMUtil/getAttr element SchemaSymbols/ATT_REF))
                        (set! lookupName ATTRIBUTE_R)
                        (set! lookupName ATTRIBUTE_N))))
              (let [attrList (cast Container (.get eleAttrsMap lookupName))]
                (if (nil? attrList)
                    (do
                      (.reportSchemaError this "s4s-elt-invalid" (new Object/1 [elName]) element)
                      nil)
                    (let [attrValues (.getAvailableArray this)
                          ^:mutable fromDefault 0]
                      (System/arraycopy fSeenTemp 0 fSeen 0 ATTIDX_COUNT)
                      (let [length (alength attrs)
                            ^:mutable ^Attr sattr nil]
                        (loop [^int i 0]
                          (when (< i length)
                            (set! sattr (aget attrs i))
                            (let [attrName (.getName sattr)
                                  ^:mutable attrURI (DOMUtil/getNamespaceURI sattr)
                                  attrVal (DOMUtil/getValue sattr)]
                              (when (.startsWith attrName "xml")
                                (let [attrPrefix (DOMUtil/getPrefix sattr)]
                                  (cond
                                    (or (.equals "xmlns" attrPrefix) (.equals "xmlns" attrName))
                                      (continue (unchecked-inc-int i))
                                    (and (.equals SchemaSymbols/ATT_XML_LANG attrName)
                                         (or (.equals SchemaSymbols/ELT_SCHEMA elName)
                                             (.equals SchemaSymbols/ELT_DOCUMENTATION elName)))
                                      (set! attrURI nil))))
                              (if (and (some? attrURI) (not (== (.length attrURI) 0)))
                                  (do
                                    (if (.equals attrURI SchemaSymbols/URI_SCHEMAFORSCHEMA)
                                        (.reportSchemaError
                                          this
                                          "s4s-att-not-allowed"
                                          (new Object/1 [elName attrName])
                                          element)
                                        (let [^{:tag (List String)} temp (if (nil?
                                                                               (aget
                                                                                 attrValues
                                                                                 ATTIDX_NONSCHEMA))
                                                                             (ArrayList. 4)
                                                                             (cast
                                                                               List
                                                                               (aget
                                                                                 attrValues
                                                                                 ATTIDX_NONSCHEMA)))]
                                          (.add temp attrName)
                                          (.add temp attrVal)
                                          (aset attrValues ATTIDX_NONSCHEMA temp)))
                                    (recur (unchecked-inc-int i)))
                                  (let [oneAttr (.get attrList attrName)]
                                    (if (nil? oneAttr)
                                        (do
                                          (.reportSchemaError
                                            this
                                            "s4s-att-not-allowed"
                                            (new Object/1 [elName attrName])
                                            element)
                                          (recur (unchecked-inc-int i)))
                                        (do
                                          (aset fSeen (.-valueIndex oneAttr) true)
                                          (try
                                            (if (>= (.-dvIndex oneAttr) 0)
                                                (if (and
                                                      (and
                                                        (not (== (.-dvIndex oneAttr) DT_STRING))
                                                        (not (== (.-dvIndex oneAttr) DT_XPATH)))
                                                      (not (== (.-dvIndex oneAttr) DT_XPATH1)))
                                                    (let [dv (aget fExtraDVs (.-dvIndex oneAttr))
                                                          avalue (.validate
                                                                   dv
                                                                   attrVal
                                                                   (.-fValidationContext schemaDoc)
                                                                   nil)]
                                                      (when (== (.-dvIndex oneAttr) DT_QNAME)
                                                        (let [qname (cast QName avalue)]
                                                          (when (and
                                                                  (and
                                                                    (identical?
                                                                      (.-prefix qname)
                                                                      XMLSymbols/EMPTY_STRING)
                                                                    (nil? (.-uri qname)))
                                                                  (.-fIsChameleonSchema schemaDoc))
                                                            (set!
                                                              (.-uri qname)
                                                              (.-fTargetNamespace schemaDoc)))))
                                                      (aset
                                                        attrValues
                                                        (.-valueIndex oneAttr)
                                                        avalue))
                                                    (aset attrValues (.-valueIndex oneAttr) attrVal))
                                                (aset
                                                  attrValues
                                                  (.-valueIndex oneAttr)
                                                  (.validate
                                                    this
                                                    attrValues
                                                    attrName
                                                    attrVal
                                                    (.-dvIndex oneAttr)
                                                    schemaDoc)))
                                            (catch InvalidDatatypeValueException ide
                                              (.reportSchemaError
                                                this
                                                "s4s-att-invalid-value"
                                                (new Object/1 [elName attrName (.getMessage ide)])
                                                element)
                                              (when (some? (.-dfltValue oneAttr))
                                                (aset
                                                  attrValues
                                                  (.-valueIndex oneAttr)
                                                  (.-dfltValue oneAttr)))))
                                          (if (and
                                                (.equals elName SchemaSymbols/ELT_ENUMERATION)
                                                enumAsQName)
                                              (do
                                                (aset
                                                  attrValues
                                                  ATTIDX_ENUMNSDECLS
                                                  (SchemaNamespaceSupport.
                                                    (.-fNamespaceSupport schemaDoc)))
                                                (recur (unchecked-inc-int i)))
                                              (recur (unchecked-inc-int i))))))))))
                        (let [reqAttrs (.-values attrList)]
                          (loop [^int i 0]
                            (when (< i (alength reqAttrs))
                              (let [oneAttr (aget reqAttrs i)]
                                (if (and (some? (.-dfltValue oneAttr))
                                         (not (aget fSeen (.-valueIndex oneAttr))))
                                    (do
                                      (aset attrValues (.-valueIndex oneAttr) (.-dfltValue oneAttr))
                                      (set! fromDefault
                                            (bit-or
                                              fromDefault
                                              (bit-shift-left-int 1 (.-valueIndex oneAttr))))
                                      (recur (unchecked-inc-int i)))
                                    (recur (unchecked-inc-int i))))))
                          (aset attrValues ATTIDX_FROMDEFAULT fromDefault)
                          (when (some? (aget attrValues ATTIDX_MAXOCCURS))
                            (let [min (.intValue (cast XInt (aget attrValues ATTIDX_MINOCCURS)))
                                  ^:mutable max (.intValue
                                                  (cast XInt (aget attrValues ATTIDX_MAXOCCURS)))]
                              (when-not (== max SchemaSymbols/OCCURRENCE_UNBOUNDED)
                                (when (some? (.-fSecurityManager fSchemaHandler))
                                  (let [localName (.getLocalName element)
                                        ^:final optimize (and
                                                           (and
                                                             (and
                                                               (or
                                                                 (.equals localName "element")
                                                                 (.equals localName "any"))
                                                               (nil? (.getNextSibling element)))
                                                             (nil? (.getPreviousSibling element)))
                                                           (.equals
                                                             (.getLocalName
                                                               (.getParentNode element))
                                                             "sequence"))]
                                    (when-not optimize
                                      (let [maxOccurNodeLimit (.getLimit
                                                                (.-fSecurityManager fSchemaHandler)
                                                                XMLSecurityManager$Limit/MAX_OCCUR_NODE_LIMIT)]
                                        (when (and
                                                (> max maxOccurNodeLimit)
                                                (not
                                                  (.isNoLimit
                                                    (.-fSecurityManager fSchemaHandler)
                                                    maxOccurNodeLimit)))
                                          (.reportSchemaFatalError
                                            this
                                            "MaxOccurLimit"
                                            (new Object/1 [maxOccurNodeLimit])
                                            element)
                                          (aset attrValues
                                                ATTIDX_MAXOCCURS
                                                (.getXInt fXIntPool maxOccurNodeLimit))
                                          (set! max maxOccurNodeLimit))))))
                                (when (> min max)
                                  (.reportSchemaError
                                    this
                                    "p-props-correct.2.1"
                                    (new Object/1
                                         [elName
                                          (aget attrValues ATTIDX_MINOCCURS)
                                          (aget attrValues ATTIDX_MAXOCCURS)])
                                    element)
                                  (aset attrValues
                                        ATTIDX_MINOCCURS
                                        (aget attrValues ATTIDX_MAXOCCURS))))))
                          attrValues))))))))))

    (method ^:private validate :throws [InvalidDatatypeValueException] [this ^Object/1 attrValues
                                                                        ^String attr ^String ivalue
                                                                        ^int dvIndex
                                                                        ^XSDocumentInfo schemaDoc]
      (when (some? ivalue)
        (let [^:mutable value (XMLChar/trim ivalue)
              ^:mutable ^Object retValue nil
              ^:mutable ^{:tag (List QName)} memberType nil
              ^:mutable ^int choice 0]
          (switch dvIndex
            DT_BOOLEAN
              (cond
                (or (.equals value SchemaSymbols/ATTVAL_FALSE)
                    (.equals value SchemaSymbols/ATTVAL_FALSE_0))
                  (set! retValue Boolean/FALSE)
                (or (.equals value SchemaSymbols/ATTVAL_TRUE)
                    (.equals value SchemaSymbols/ATTVAL_TRUE_1))
                  (set! retValue Boolean/TRUE)
                :else
                  (throw (InvalidDatatypeValueException.
                           "cvc-datatype-valid.1.2.1"
                           (new Object/1 [value "boolean"]))))
            DT_NONNEGINT
              (do
                (try
                  (when (and (> (.length value) 0) (== (.charAt value 0) \+))
                    (set! value (.substring value 1)))
                  (set! retValue (.getXInt fXIntPool (Integer/parseInt value)))
                  (catch NumberFormatException e
                    (throw (InvalidDatatypeValueException.
                             "cvc-datatype-valid.1.2.1"
                             (new Object/1 [value "nonNegativeInteger"])))))
                (when (< (.intValue (cast XInt retValue)) 0)
                  (throw (InvalidDatatypeValueException.
                           "cvc-datatype-valid.1.2.1"
                           (new Object/1 [value "nonNegativeInteger"])))))
            DT_POSINT
              (do
                (try
                  (when (and (> (.length value) 0) (== (.charAt value 0) \+))
                    (set! value (.substring value 1)))
                  (set! retValue (.getXInt fXIntPool (Integer/parseInt value)))
                  (catch NumberFormatException e
                    (throw (InvalidDatatypeValueException.
                             "cvc-datatype-valid.1.2.1"
                             (new Object/1 [value "positiveInteger"])))))
                (when (<= (.intValue (cast XInt retValue)) 0)
                  (throw (InvalidDatatypeValueException.
                           "cvc-datatype-valid.1.2.1"
                           (new Object/1 [value "positiveInteger"])))))
            DT_BLOCK
              (do
                (set! choice 0)
                (if (.equals value SchemaSymbols/ATTVAL_POUNDALL)
                    (set! choice
                          (bit-or-int (bit-or-int
                                        XSConstants/DERIVATION_SUBSTITUTION
                                        XSConstants/DERIVATION_EXTENSION)
                                      XSConstants/DERIVATION_RESTRICTION))
                    (let [t (StringTokenizer. value " \n\t\r")]
                      (while (.hasMoreTokens t)
                        (let [token (.nextToken t)]
                          (cond
                            (.equals token SchemaSymbols/ATTVAL_EXTENSION)
                              (set! choice (bit-or-int choice XSConstants/DERIVATION_EXTENSION))
                            (.equals token SchemaSymbols/ATTVAL_RESTRICTION)
                              (set! choice (bit-or-int choice XSConstants/DERIVATION_RESTRICTION))
                            (.equals token SchemaSymbols/ATTVAL_SUBSTITUTION)
                              (set! choice (bit-or-int choice XSConstants/DERIVATION_SUBSTITUTION))
                            :else
                              (throw
                                (InvalidDatatypeValueException.
                                  "cvc-datatype-valid.1.2.3"
                                  (new
                                    Object/1
                                    [value
                                     "(#all | List of (extension | restriction | substitution))"]))))))))
                (set! retValue (.getXInt fXIntPool choice)))
            (DT_BLOCK1 DT_FINAL)
              (do
                (set! choice 0)
                (if (.equals value SchemaSymbols/ATTVAL_POUNDALL)
                    (set! choice
                          (bit-or-int (bit-or-int
                                        (bit-or-int
                                          (bit-or-int
                                            XSConstants/DERIVATION_SUBSTITUTION
                                            XSConstants/DERIVATION_EXTENSION)
                                          XSConstants/DERIVATION_RESTRICTION)
                                        XSConstants/DERIVATION_LIST)
                                      XSConstants/DERIVATION_UNION))
                    (let [t (StringTokenizer. value " \n\t\r")]
                      (while (.hasMoreTokens t)
                        (let [token (.nextToken t)]
                          (cond
                            (.equals token SchemaSymbols/ATTVAL_EXTENSION)
                              (set! choice (bit-or-int choice XSConstants/DERIVATION_EXTENSION))
                            (.equals token SchemaSymbols/ATTVAL_RESTRICTION)
                              (set! choice (bit-or-int choice XSConstants/DERIVATION_RESTRICTION))
                            :else
                              (throw (InvalidDatatypeValueException.
                                       "cvc-datatype-valid.1.2.3"
                                       (new Object/1
                                            [value "(#all | List of (extension | restriction))"]))))))))
                (set! retValue (.getXInt fXIntPool choice)))
            DT_FINAL1
              (do
                (set! choice 0)
                (if (.equals value SchemaSymbols/ATTVAL_POUNDALL)
                    (set! choice
                          (bit-or-int (bit-or-int
                                        (bit-or-int
                                          (bit-or-int
                                            XSConstants/DERIVATION_SUBSTITUTION
                                            XSConstants/DERIVATION_EXTENSION)
                                          XSConstants/DERIVATION_RESTRICTION)
                                        XSConstants/DERIVATION_LIST)
                                      XSConstants/DERIVATION_UNION))
                    (let [t (StringTokenizer. value " \n\t\r")]
                      (while (.hasMoreTokens t)
                        (let [token (.nextToken t)]
                          (cond
                            (.equals token SchemaSymbols/ATTVAL_LIST)
                              (set! choice (bit-or-int choice XSConstants/DERIVATION_LIST))
                            (.equals token SchemaSymbols/ATTVAL_UNION)
                              (set! choice (bit-or-int choice XSConstants/DERIVATION_UNION))
                            (.equals token SchemaSymbols/ATTVAL_RESTRICTION)
                              (set! choice (bit-or-int choice XSConstants/DERIVATION_RESTRICTION))
                            :else
                              (throw
                                (InvalidDatatypeValueException.
                                  "cvc-datatype-valid.1.2.3"
                                  (new Object/1
                                       [value "(#all | List of (list | union | restriction))"]))))))))
                (set! retValue (.getXInt fXIntPool choice)))
            DT_FINAL2
              (do
                (set! choice 0)
                (if (.equals value SchemaSymbols/ATTVAL_POUNDALL)
                    (set! choice
                          (bit-or-int (bit-or-int
                                        (bit-or-int
                                          (bit-or-int
                                            XSConstants/DERIVATION_SUBSTITUTION
                                            XSConstants/DERIVATION_EXTENSION)
                                          XSConstants/DERIVATION_RESTRICTION)
                                        XSConstants/DERIVATION_LIST)
                                      XSConstants/DERIVATION_UNION))
                    (let [t (StringTokenizer. value " \n\t\r")]
                      (while (.hasMoreTokens t)
                        (let [token (.nextToken t)]
                          (cond
                            (.equals token SchemaSymbols/ATTVAL_EXTENSION)
                              (set! choice (bit-or-int choice XSConstants/DERIVATION_EXTENSION))
                            (.equals token SchemaSymbols/ATTVAL_RESTRICTION)
                              (set! choice (bit-or-int choice XSConstants/DERIVATION_RESTRICTION))
                            (.equals token SchemaSymbols/ATTVAL_LIST)
                              (set! choice (bit-or-int choice XSConstants/DERIVATION_LIST))
                            (.equals token SchemaSymbols/ATTVAL_UNION)
                              (set! choice (bit-or-int choice XSConstants/DERIVATION_UNION))
                            :else
                              (throw
                                (InvalidDatatypeValueException.
                                  "cvc-datatype-valid.1.2.3"
                                  (new
                                    Object/1
                                    [value
                                     "(#all | List of (extension | restriction | list | union))"]))))))))
                (set! retValue (.getXInt fXIntPool choice)))
            DT_FORM
              (cond
                (.equals value SchemaSymbols/ATTVAL_QUALIFIED) (set! retValue INT_QUALIFIED)
                (.equals value SchemaSymbols/ATTVAL_UNQUALIFIED) (set! retValue INT_UNQUALIFIED)
                :else
                  (throw (InvalidDatatypeValueException.
                           "cvc-enumeration-valid"
                           (new Object/1 [value "(qualified | unqualified)"]))))
            DT_MAXOCCURS
              (if (.equals value SchemaSymbols/ATTVAL_UNBOUNDED)
                  (set! retValue INT_UNBOUNDED)
                  (try
                    (set! retValue (.validate this attrValues attr value DT_NONNEGINT schemaDoc))
                    (catch NumberFormatException e
                      (throw (InvalidDatatypeValueException.
                               "cvc-datatype-valid.1.2.3"
                               (new Object/1 [value "(nonNegativeInteger | unbounded)"]))))))
            DT_MAXOCCURS1
              (if (.equals value "1")
                  (set! retValue (.getXInt fXIntPool 1))
                  (throw (InvalidDatatypeValueException.
                           "cvc-enumeration-valid"
                           (new Object/1 [value "(1)"]))))
            DT_MEMBERTYPES
              (do
                (set! memberType (ArrayList.))
                (try
                  (let [t (StringTokenizer. value " \n\t\r")]
                    (while (.hasMoreTokens t)
                      (let [token (.nextToken t)
                            qname (cast QName
                                        (.validate
                                          (aget fExtraDVs DT_QNAME)
                                          token
                                          (.-fValidationContext schemaDoc)
                                          nil))]
                        (when (and (and (identical? (.-prefix qname) XMLSymbols/EMPTY_STRING)
                                        (nil? (.-uri qname)))
                                   (.-fIsChameleonSchema schemaDoc))
                          (set! (.-uri qname) (.-fTargetNamespace schemaDoc)))
                        (.add memberType qname)))
                    (set! retValue memberType))
                  (catch InvalidDatatypeValueException ide
                    (throw (InvalidDatatypeValueException.
                             "cvc-datatype-valid.1.2.2"
                             (new Object/1 [value "(List of QName)"]))))))
            DT_MINOCCURS1
              (cond
                (.equals value "0") (set! retValue (.getXInt fXIntPool 0))
                (.equals value "1") (set! retValue (.getXInt fXIntPool 1))
                :else
                  (throw (InvalidDatatypeValueException.
                           "cvc-enumeration-valid"
                           (new Object/1 [value "(0 | 1)"]))))
            DT_NAMESPACE
              (cond
                (.equals value SchemaSymbols/ATTVAL_TWOPOUNDANY) (set! retValue INT_ANY_ANY)
                (.equals value SchemaSymbols/ATTVAL_TWOPOUNDOTHER)
                  (do
                    (set! retValue INT_ANY_NOT)
                    (let [list (new String/1 2)]
                      (aset list 0 (.-fTargetNamespace schemaDoc))
                      (aset list 1 nil)
                      (aset attrValues ATTIDX_NAMESPACE_LIST list)))
                :else
                  (do
                    (set! retValue INT_ANY_LIST)
                    (.clear fNamespaceList)
                    (let [tokens (StringTokenizer. value " \n\t\r")
                          ^:mutable ^String token nil
                          ^:mutable ^String tempNamespace nil]
                      (try
                        (while (.hasMoreTokens tokens)
                          (set! token (.nextToken tokens))
                          (cond
                            (.equals token SchemaSymbols/ATTVAL_TWOPOUNDLOCAL)
                              (set! tempNamespace nil)
                            (.equals token SchemaSymbols/ATTVAL_TWOPOUNDTARGETNS)
                              (set! tempNamespace (.-fTargetNamespace schemaDoc))
                            :else
                              (do
                                (.validate (aget fExtraDVs DT_ANYURI)
                                           token
                                           (.-fValidationContext schemaDoc)
                                           nil)
                                (set! tempNamespace (.addSymbol fSymbolTable token))))

            (.reconfigurePipeline this)
            (when (.scanStartElement XML11NSDocumentScannerImpl/this)
              (.setScannerState XML11NSDocumentScannerImpl/this
                                XMLDocumentScannerImpl/SCANNER_STATE_TRAILING_MISC)

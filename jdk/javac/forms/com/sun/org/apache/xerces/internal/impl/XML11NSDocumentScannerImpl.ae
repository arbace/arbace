                  handler (.getDocumentHandler fDTDValidator)]
              (.setDocumentHandler source handler)
              (when (some? handler) (.setDocumentSource handler source))
              (.setDocumentSource fDTDValidator nil)
              (.setDocumentHandler fDTDValidator nil)))))))

    (for-each [^XMLComponent c fXML11Components]
      (try (.setProperty c propertyId value) (catch Exception e)))
    (.setProperty super propertyId value))

  (method ^:public getLocale ^Locale [this] fLocale)

  (method ^:protected reset :throws [XNIException] ^void [this]
    (let [count (.size fComponents)]
      (loop [^int i 0]
        (when (< i count)
          (let [c (cast XMLComponent (.get fComponents i))]
            (.reset c this)
            (recur (unchecked-inc-int i)))))))

  (method ^:protected resetCommon :throws [XNIException] ^void [this]
    (let [count (.size fCommonComponents)]
      (loop [^int i 0]
        (when (< i count)
          (let [c (cast XMLComponent (.get fCommonComponents i))]
            (.reset c this)
            (recur (unchecked-inc-int i)))))))

  (method ^:protected resetXML11 :throws [XNIException] ^void [this]
    (let [count (.size fXML11Components)]
      (loop [^int i 0]
        (when (< i count)
          (let [c (cast XMLComponent (.get fXML11Components i))]
            (.reset c this)
            (recur (unchecked-inc-int i)))))))

  (method ^:protected configureXML11Pipeline ^void [this]
    (when-not (identical? fCurrentDVFactory fXML11DatatypeFactory)
      (set! fCurrentDVFactory fXML11DatatypeFactory)
      (.setProperty this DATATYPE_VALIDATOR_FACTORY fCurrentDVFactory))
    (when-not (identical? fCurrentDTDScanner fXML11DTDScanner)
      (set! fCurrentDTDScanner fXML11DTDScanner)
      (.setProperty this DTD_SCANNER fCurrentDTDScanner)
      (.setProperty this DTD_PROCESSOR fXML11DTDProcessor))
    (.setDTDHandler fXML11DTDScanner fXML11DTDProcessor)
    (.setDTDSource fXML11DTDProcessor fXML11DTDScanner)
    (.setDTDHandler fXML11DTDProcessor fDTDHandler)
    (when (some? fDTDHandler) (.setDTDSource fDTDHandler fXML11DTDProcessor))
    (.setDTDContentModelHandler fXML11DTDScanner fXML11DTDProcessor)
    (.setDTDContentModelSource fXML11DTDProcessor fXML11DTDScanner)
    (.setDTDContentModelHandler fXML11DTDProcessor fDTDContentModelHandler)
    (when (some? fDTDContentModelHandler)
      (.setDTDContentModelSource fDTDContentModelHandler fXML11DTDProcessor))
    (if (identical? (.get (.-fFeatures this) NAMESPACES) Boolean/TRUE)
        (do
          (when-not (identical? fCurrentScanner fXML11NSDocScanner)
            (set! fCurrentScanner fXML11NSDocScanner)
            (.setProperty this DOCUMENT_SCANNER fXML11NSDocScanner)
            (.setProperty this DTD_VALIDATOR fXML11NSDTDValidator))
          (.setDTDValidator fXML11NSDocScanner fXML11NSDTDValidator)
          (.setDocumentHandler fXML11NSDocScanner fXML11NSDTDValidator)
          (.setDocumentSource fXML11NSDTDValidator fXML11NSDocScanner)
          (.setDocumentHandler fXML11NSDTDValidator fDocumentHandler)
          (when (some? fDocumentHandler) (.setDocumentSource fDocumentHandler fXML11NSDTDValidator))
          (set! fLastComponent fXML11NSDTDValidator))
        (do
          (when (nil? fXML11DocScanner)
            (set! fXML11DocScanner (XML11DocumentScannerImpl.))
            (.addXML11Component this fXML11DocScanner)
            (set! fXML11DTDValidator (XML11DTDValidator.))
            (.addXML11Component this fXML11DTDValidator))
          (when-not (identical? fCurrentScanner fXML11DocScanner)
            (set! fCurrentScanner fXML11DocScanner)
            (.setProperty this DOCUMENT_SCANNER fXML11DocScanner)
            (.setProperty this DTD_VALIDATOR fXML11DTDValidator))
          (.setDocumentHandler fXML11DocScanner fXML11DTDValidator)
          (.setDocumentSource fXML11DTDValidator fXML11DocScanner)
          (.setDocumentHandler fXML11DTDValidator fDocumentHandler)
          (when (some? fDocumentHandler) (.setDocumentSource fDocumentHandler fXML11DTDValidator))
          (set! fLastComponent fXML11DTDValidator)))
    (when (identical? (.get (.-fFeatures this) XMLSCHEMA_VALIDATION) Boolean/TRUE)
      (when (nil? fSchemaValidator)
        (set! fSchemaValidator (XMLSchemaValidator.))
        (.setProperty this SCHEMA_VALIDATOR fSchemaValidator)
        (.addCommonComponent this fSchemaValidator)
        (.reset fSchemaValidator this)
        (when (nil? (.getMessageFormatter fErrorReporter XSMessageFormatter/SCHEMA_DOMAIN))
          (let [xmft (XSMessageFormatter.)]
            (.putMessageFormatter fErrorReporter XSMessageFormatter/SCHEMA_DOMAIN xmft))))
      (.setDocumentHandler fLastComponent fSchemaValidator)
      (.setDocumentSource fSchemaValidator fLastComponent)
      (.setDocumentHandler fSchemaValidator fDocumentHandler)
      (when (some? fDocumentHandler) (.setDocumentSource fDocumentHandler fSchemaValidator))
      (set! fLastComponent fSchemaValidator)))

  (method ^:protected configurePipeline ^void [this]
    (when-not (identical? fCurrentDVFactory fDatatypeValidatorFactory)
      (set! fCurrentDVFactory fDatatypeValidatorFactory)
      (.setProperty this DATATYPE_VALIDATOR_FACTORY fCurrentDVFactory))
    (when-not (identical? fCurrentDTDScanner fDTDScanner)
      (set! fCurrentDTDScanner fDTDScanner)
      (.setProperty this DTD_SCANNER fCurrentDTDScanner)
      (.setProperty this DTD_PROCESSOR fDTDProcessor))
    (.setDTDHandler fDTDScanner fDTDProcessor)
    (.setDTDSource fDTDProcessor fDTDScanner)
    (.setDTDHandler fDTDProcessor fDTDHandler)
    (when (some? fDTDHandler) (.setDTDSource fDTDHandler fDTDProcessor))
    (.setDTDContentModelHandler fDTDScanner fDTDProcessor)
    (.setDTDContentModelSource fDTDProcessor fDTDScanner)
    (.setDTDContentModelHandler fDTDProcessor fDTDContentModelHandler)
    (when (some? fDTDContentModelHandler)
      (.setDTDContentModelSource fDTDContentModelHandler fDTDProcessor))
    (if (identical? (.get (.-fFeatures this) NAMESPACES) Boolean/TRUE)
        (do
          (when-not (identical? fCurrentScanner fNamespaceScanner)
            (set! fCurrentScanner fNamespaceScanner)
            (.setProperty this DOCUMENT_SCANNER fNamespaceScanner)
            (.setProperty this DTD_VALIDATOR fDTDValidator))
          (.setDTDValidator fNamespaceScanner fDTDValidator)
          (.setDocumentHandler fNamespaceScanner fDTDValidator)
          (.setDocumentSource fDTDValidator fNamespaceScanner)
          (.setDocumentHandler fDTDValidator fDocumentHandler)
          (when (some? fDocumentHandler) (.setDocumentSource fDocumentHandler fDTDValidator))
          (set! fLastComponent fDTDValidator))
        (do
          (when (nil? fNonNSScanner)
            (set! fNonNSScanner (XMLDocumentScannerImpl.))
            (set! fNonNSDTDValidator (XMLDTDValidator.))
            (.addComponent this ^XMLComponent fNonNSScanner)
            (.addComponent this ^XMLComponent fNonNSDTDValidator))
          (when-not (identical? fCurrentScanner fNonNSScanner)
            (set! fCurrentScanner fNonNSScanner)
            (.setProperty this DOCUMENT_SCANNER fNonNSScanner)
            (.setProperty this DTD_VALIDATOR fNonNSDTDValidator))
          (.setDocumentHandler fNonNSScanner fNonNSDTDValidator)
          (.setDocumentSource fNonNSDTDValidator fNonNSScanner)
          (.setDocumentHandler fNonNSDTDValidator fDocumentHandler)
          (when (some? fDocumentHandler) (.setDocumentSource fDocumentHandler fNonNSDTDValidator))
          (set! fLastComponent fNonNSDTDValidator)))
    (when (identical? (.get (.-fFeatures this) XMLSCHEMA_VALIDATION) Boolean/TRUE)
      (when (nil? fSchemaValidator)
        (set! fSchemaValidator (XMLSchemaValidator.))
        (.setProperty this SCHEMA_VALIDATOR fSchemaValidator)
        (.addCommonComponent this fSchemaValidator)
        (.reset fSchemaValidator this)
        (when (nil? (.getMessageFormatter fErrorReporter XSMessageFormatter/SCHEMA_DOMAIN))
          (let [xmft (XSMessageFormatter.)]
            (.putMessageFormatter fErrorReporter XSMessageFormatter/SCHEMA_DOMAIN xmft))))
      (.setDocumentHandler fLastComponent fSchemaValidator)
      (.setDocumentSource fSchemaValidator fLastComponent)
      (.setDocumentHandler fSchemaValidator fDocumentHandler)
      (when (some? fDocumentHandler) (.setDocumentSource fDocumentHandler fSchemaValidator))
      (set! fLastComponent fSchemaValidator)))

  (method ^:protected checkFeature :throws [XMLConfigurationException] ^FeatureState [this
                                                                                      ^String featureId]
    (when (.startsWith featureId Constants/XERCES_FEATURE_PREFIX)
      (let [suffixLength (unchecked-subtract-int
                           (.length featureId)
                           (.length Constants/XERCES_FEATURE_PREFIX))]
        (when (and (== suffixLength (.length Constants/DYNAMIC_VALIDATION_FEATURE))
                   (.endsWith featureId Constants/DYNAMIC_VALIDATION_FEATURE))
          (return FeatureState/RECOGNIZED))
        (when (and (== suffixLength (.length Constants/DEFAULT_ATTRIBUTE_VALUES_FEATURE))
                   (.endsWith featureId Constants/DEFAULT_ATTRIBUTE_VALUES_FEATURE))
          (return FeatureState/NOT_SUPPORTED))
        (when (and (== suffixLength (.length Constants/VALIDATE_CONTENT_MODELS_FEATURE))
                   (.endsWith featureId Constants/VALIDATE_CONTENT_MODELS_FEATURE))
          (return FeatureState/NOT_SUPPORTED))
        (when (and (== suffixLength (.length Constants/LOAD_DTD_GRAMMAR_FEATURE))
                   (.endsWith featureId Constants/LOAD_DTD_GRAMMAR_FEATURE))
          (return FeatureState/RECOGNIZED))
        (when (and (== suffixLength (.length Constants/LOAD_EXTERNAL_DTD_FEATURE))
                   (.endsWith featureId Constants/LOAD_EXTERNAL_DTD_FEATURE))
          (return FeatureState/RECOGNIZED))
        (when (and (== suffixLength (.length Constants/VALIDATE_DATATYPES_FEATURE))
                   (.endsWith featureId Constants/VALIDATE_DATATYPES_FEATURE))
          (return FeatureState/NOT_SUPPORTED))
        (when (and (== suffixLength (.length Constants/SCHEMA_VALIDATION_FEATURE))
                   (.endsWith featureId Constants/SCHEMA_VALIDATION_FEATURE))
          (return FeatureState/RECOGNIZED))
        (when (and (== suffixLength (.length Constants/SCHEMA_FULL_CHECKING))
                   (.endsWith featureId Constants/SCHEMA_FULL_CHECKING))
          (return FeatureState/RECOGNIZED))
        (when (and (== suffixLength (.length Constants/SCHEMA_NORMALIZED_VALUE))
                   (.endsWith featureId Constants/SCHEMA_NORMALIZED_VALUE))
          (return FeatureState/RECOGNIZED))
        (when (and (== suffixLength (.length Constants/SCHEMA_ELEMENT_DEFAULT))
                   (.endsWith featureId Constants/SCHEMA_ELEMENT_DEFAULT))
          (return FeatureState/RECOGNIZED))
        (when (and (== suffixLength (.length Constants/PARSER_SETTINGS))
                   (.endsWith featureId Constants/PARSER_SETTINGS))
          (return FeatureState/NOT_SUPPORTED))))
    (.checkFeature super featureId))

  (method ^:protected checkProperty :throws [XMLConfigurationException] ^PropertyState [this
                                                                                        ^String propertyId]
    (when (.startsWith propertyId Constants/XERCES_PROPERTY_PREFIX)
      (let [suffixLength (unchecked-subtract-int
                           (.length propertyId)
                           (.length Constants/XERCES_PROPERTY_PREFIX))]
        (when (and (== suffixLength (.length Constants/DTD_SCANNER_PROPERTY))
                   (.endsWith propertyId Constants/DTD_SCANNER_PROPERTY))
          (return PropertyState/RECOGNIZED))
        (when (and (== suffixLength (.length Constants/SCHEMA_LOCATION))
                   (.endsWith propertyId Constants/SCHEMA_LOCATION))
          (return PropertyState/RECOGNIZED))
        (when (and (== suffixLength (.length Constants/SCHEMA_NONS_LOCATION))
                   (.endsWith propertyId Constants/SCHEMA_NONS_LOCATION))
          (return PropertyState/RECOGNIZED))))
    (when (.startsWith propertyId Constants/JAXP_PROPERTY_PREFIX)
      (let [suffixLength (unchecked-subtract-int
                           (.length propertyId)
                           (.length Constants/JAXP_PROPERTY_PREFIX))]
        (when (and (== suffixLength (.length Constants/SCHEMA_SOURCE))
                   (.endsWith propertyId Constants/SCHEMA_SOURCE))
          (return PropertyState/RECOGNIZED))))
    (when (.startsWith propertyId Constants/SAX_PROPERTY_PREFIX)
      (let [suffixLength (unchecked-subtract-int
                           (.length propertyId)
                           (.length Constants/SAX_PROPERTY_PREFIX))]
        (when (and (== suffixLength (.length Constants/XML_STRING_PROPERTY))
                   (.endsWith propertyId Constants/XML_STRING_PROPERTY))
          (return PropertyState/NOT_SUPPORTED))))
    (.checkProperty super propertyId))

  (method ^:protected addComponent ^void [this ^XMLComponent component]
    (when-not (.contains fComponents component)
      (.add fComponents component)
      (.addRecognizedParamsAndSetDefaults this component)))

  (method ^:protected addCommonComponent ^void [this ^XMLComponent component]
    (when-not (.contains fCommonComponents component)
      (.add fCommonComponents component)
      (.addRecognizedParamsAndSetDefaults this component)))

  (method ^:protected addXML11Component ^void [this ^XMLComponent component]
    (when-not (.contains fXML11Components component)
      (.add fXML11Components component)
      (.addRecognizedParamsAndSetDefaults this component)))

  (method ^:protected addRecognizedParamsAndSetDefaults ^void [this ^XMLComponent component]
    (let [recognizedFeatures (.getRecognizedFeatures component)]
      (.addRecognizedFeatures this recognizedFeatures)
      (let [recognizedProperties (.getRecognizedProperties component)]
        (.addRecognizedProperties this recognizedProperties)
        (when (some? recognizedFeatures)
          (loop [^int i 0]
            (when (< i (alength recognizedFeatures))
              (let [featureId (aget recognizedFeatures i)
                    state (.getFeatureDefault component featureId)]
                (if (some? state)
                    (if (not (.containsKey (.-fFeatures this) featureId))
                        (do
                          (.put (.-fFeatures this) featureId state)
                          (set! fConfigUpdated true)
                          (recur (unchecked-inc-int i)))
                        (recur (unchecked-inc-int i)))
                    (recur (unchecked-inc-int i)))))))
        (when (some? recognizedProperties)
          (loop [^int i 0]
            (when (< i (alength recognizedProperties))
              (let [propertyId (aget recognizedProperties i)
                    value (.getPropertyDefault component propertyId)]
                (if (some? value)
                    (if (not (.containsKey (.-fProperties this) propertyId))
                        (do
                          (.put (.-fProperties this) propertyId value)
                          (set! fConfigUpdated true)
                          (recur (unchecked-inc-int i)))
                        (recur (unchecked-inc-int i)))
                    (recur (unchecked-inc-int i))))))))))

  (method ^:private initXML11Components ^void [this]
    (when-not f11Initialized
      (set! fXML11DatatypeFactory (DTDDVFactory/getInstance XML11_DATATYPE_VALIDATOR_FACTORY))
      (set! fXML11DTDScanner (XML11DTDScannerImpl.))
      (.addXML11Component this fXML11DTDScanner)
      (set! fXML11DTDProcessor (XML11DTDProcessor.))
      (.addXML11Component this fXML11DTDProcessor)
      (set! fXML11NSDocScanner (XML11NSDocumentScannerImpl.))
      (.addXML11Component this fXML11NSDocScanner)
      (set! fXML11NSDTDValidator (XML11NSDTDValidator.))
      (.addXML11Component this fXML11NSDTDValidator)
      (set! f11Initialized true)))

  (method ^:private resetSymbolTable ^void [this]
    (when (and (.booleanValue
                 (cast Boolean (.get (.-fFeatures this) JdkConstants/RESET_SYMBOL_TABLE)))
               (not fSymbolTableProvided))
      (if fSymbolTableJustInitialized
          (set! fSymbolTableJustInitialized false)
          (do
            (set! fSymbolTable (SymbolTable.))
            (.put (.-fProperties this) SYMBOL_TABLE fSymbolTable)))))

  (method getFeatureState0 :throws [XMLConfigurationException] ^FeatureState [this ^String featureId]
    (.getFeatureState super featureId)))

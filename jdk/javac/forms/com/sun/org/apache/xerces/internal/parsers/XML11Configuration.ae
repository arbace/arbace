          (throw ex))
        (catch Exception ex
          (when PRINT_EXCEPTION_STACK_TRACE (.printStackTrace ex))
          (throw (XNIException. ex)))))
    (try
      (.scanDocument fCurrentScanner complete)
      (catch [IOException RuntimeException] ex
        (when PRINT_EXCEPTION_STACK_TRACE (.printStackTrace ex))
        (throw ex))
      (catch Exception ex
        (when PRINT_EXCEPTION_STACK_TRACE (.printStackTrace ex))
        (throw (XNIException. ex)))))


  (method ^:private normalize ^String [this ^String s]
    (let [str (StringBuffer.)
          length (.length s)]
      (loop [^int i 0]
        (when (< i length)
          (let [c (.charAt s i)]
            (switch c
              \newline (do (.append str "\\n") (recur (unchecked-inc-int i)))
              (do (.append str c) (recur (unchecked-inc-int i)))))))
      (.toString str)))

  (method ^:private ^:static matches ^boolean [^XPath$NodeTest nodeTest ^QName value]
    (cond
      (== (.-type nodeTest) XPath$NodeTest/QNAME) (.equals (.-name nodeTest) value)
      (== (.-type nodeTest) XPath$NodeTest/NAMESPACE)
        (identical? (.-uri (.-name nodeTest)) (.-uri value))
      :else true)))

                                         "InvalidCharInSystemID"
                                         (new Object/1 [(Integer/toString c 16)]))))
                (when-not (== (.scanLiteral fEntityScanner quote ident false) quote) (recur)))
              (.append fStringBuffer ident)
              (set! ident fStringBuffer))
            (set! systemId (.toString ident))
            (when-not (.skipChar fEntityScanner quote nil)
              (.reportFatalError this "SystemIDUnterminated" nil)))))
      (aset identifiers 0 systemId)
      (aset identifiers 1 publicId)))

  (method ^:protected scanPubidLiteral :throws [IOException XNIException] ^boolean [this
                                                                                    ^XMLString literal]
    (let [quote (.scanChar fEntityScanner nil)]
      (if (and (not (== quote \')) (not (== quote \")))
          (do (.reportFatalError this "QuoteRequiredInPublicID" nil) false)
          (do
            (.clear fStringBuffer)
            (let [^:mutable skipSpace true
                  ^:mutable dataok true]
              (while true
                (let [c (.scanChar fEntityScanner nil)]
                  (cond
                    (or (or (== c \space) (== c \newline)) (== c \return))
                      (when-not skipSpace (.append fStringBuffer \space) (set! skipSpace true))
                    (== c quote)
                      (do
                        (when skipSpace
                          (set! (.-length fStringBuffer)
                                (unchecked-dec-int (.-length fStringBuffer))))
                        (.setValues literal fStringBuffer)
                        (break))
                    (XMLChar/isPubid c)
                      (do (.append fStringBuffer (unchecked-char c)) (set! skipSpace false))
                    (== c -1)
                      (do (.reportFatalError this "PublicIDUnterminated" nil) (return false))
                    :else
                      (do
                        (set! dataok false)
                        (.reportFatalError this
                                           "InvalidCharInPublicID"
                                           (new Object/1 [(Integer/toHexString c)]))))))
              dataok)))))

  (method ^:protected normalizeWhitespace ^void [this ^XMLString value]
    (let [^:mutable ^int i 0
          ^:mutable ^int j 0
          buff (.-whiteSpaceLookup fEntityScanner)
          buffLen (.-whiteSpaceLen fEntityScanner)
          end (unchecked-add-int (.-offset value) (.-length value))]
      (while (< i buffLen)
        (set! j (aget buff i))
        (when (< j end) (aset (.-ch value) j \space))
        (set! i (unchecked-inc-int i)))))

  (method ^:public startEntity :throws [XNIException] ^void [this ^String name
                                                             ^XMLResourceIdentifier identifier
                                                             ^String encoding ^Augmentations augs]
    (set! fEntityDepth (unchecked-inc-int fEntityDepth))
    (set! fEntityScanner (.getEntityScanner fEntityManager))
    (set! fEntityStore (.getEntityStore fEntityManager)))

  (method ^:public endEntity :throws [IOException XNIException] ^void [this ^String name
                                                                       ^Augmentations augs]
    (when (> fEntityDepth 0) (set! fEntityDepth (unchecked-dec-int fEntityDepth))))

  (method ^:protected scanCharReferenceValue :throws [IOException XNIException] ^int [this
                                                                                      ^XMLStringBuffer buf
                                                                                      ^XMLStringBuffer buf2]
    (let [initLen (.-length buf)
          ^:mutable hex false]
      (if (.skipChar fEntityScanner \x NameType/REFERENCE)
          (do
            (when (some? buf2) (.append buf2 \x))
            (set! hex true)
            (.clear fStringBuffer3)
            (let [^:mutable digit true
                  ^:mutable c (.peekChar fEntityScanner)]
              (set! digit
                    (or (or (and (>= c \0) (<= c \9)) (and (>= c \a) (<= c \f)))
                        (and (>= c \A) (<= c \F))))
              (if digit
                  (do
                    (when (some? buf2) (.append buf2 (unchecked-char c)))
                    (.scanChar fEntityScanner NameType/REFERENCE)
                    (.append fStringBuffer3 (unchecked-char c))
                    (loop []
                      (set! c (.peekChar fEntityScanner))
                      (set! digit
                            (or (or (and (>= c \0) (<= c \9)) (and (>= c \a) (<= c \f)))
                                (and (>= c \A) (<= c \F))))
                      (when digit
                        (when (some? buf2) (.append buf2 (unchecked-char c)))
                        (.scanChar fEntityScanner NameType/REFERENCE)
                        (.append fStringBuffer3 (unchecked-char c)))
                      (when digit (recur))))
                  (.reportFatalError this "HexdigitRequiredInCharRef" nil))))
          (do
            (.clear fStringBuffer3)
            (let [^:mutable digit true
                  ^:mutable c (.peekChar fEntityScanner)]
              (set! digit (and (>= c \0) (<= c \9)))
              (if digit
                  (do
                    (when (some? buf2) (.append buf2 (unchecked-char c)))
                    (.scanChar fEntityScanner NameType/REFERENCE)
                    (.append fStringBuffer3 (unchecked-char c))
                    (loop []
                      (set! c (.peekChar fEntityScanner))
                      (set! digit (and (>= c \0) (<= c \9)))
                      (when digit
                        (when (some? buf2) (.append buf2 (unchecked-char c)))
                        (.scanChar fEntityScanner NameType/REFERENCE)
                        (.append fStringBuffer3 (unchecked-char c)))
                      (when digit (recur))))
                  (.reportFatalError this "DigitRequiredInCharRef" nil)))))
      (when-not (.skipChar fEntityScanner \; NameType/REFERENCE)
        (.reportFatalError this "SemicolonRequiredInCharRef" nil))
      (when (some? buf2) (.append buf2 \;))
      (let [^:mutable ^int value -1]
        (try
          (set! value (Integer/parseInt (.toString fStringBuffer3) (if hex 16 10)))
          (when (.isInvalid this value)
            (let [errorBuf (StringBuffer. (unchecked-add-int (.-length fStringBuffer3) 1))]
              (when hex (.append errorBuf \x))
              (.append errorBuf
                       (.-ch fStringBuffer3)
                       (.-offset fStringBuffer3)
                       (.-length fStringBuffer3))
              (.reportFatalError this "InvalidCharRef" (new Object/1 [(.toString errorBuf)]))))
          (catch NumberFormatException e
            (let [errorBuf (StringBuffer. (unchecked-add-int (.-length fStringBuffer3) 1))]
              (when hex (.append errorBuf \x))
              (.append errorBuf
                       (.-ch fStringBuffer3)
                       (.-offset fStringBuffer3)
                       (.-length fStringBuffer3))
              (.reportFatalError this "InvalidCharRef" (new Object/1 [(.toString errorBuf)])))))
        (if (not (XMLChar/isSupplemental value))
            (.append buf (unchecked-char value))
            (do
              (.append buf (XMLChar/highSurrogate value))
              (.append buf (XMLChar/lowSurrogate value))))
        (when (and fNotifyCharRefs (not (== value -1)))
          (let [literal (java-str "#" (if hex "x" "") (.toString fStringBuffer3))]
            (when-not fScanningAttribute (set! fCharRefLiteral literal))))
        (when (.-isGE (.-fCurrentEntity fEntityScanner))
          (.checkEntityLimit this
                             false
                             (.-name (.-fCurrentEntity fEntityScanner))
                             (unchecked-subtract-int (.-length buf) initLen)))
        value)))

  (method ^:protected isInvalid ^boolean [this ^int value]
    (XMLChar/isInvalid value))

  (method ^:protected isInvalidLiteral ^boolean [this ^int value]
    (XMLChar/isInvalid value))

  (method ^:protected isValidNameChar ^boolean [this ^int value]
    (XMLChar/isName value))

  (method ^:protected isValidNCName ^boolean [this ^int value]
    (XMLChar/isNCName value))

  (method ^:protected isValidNameStartChar ^boolean [this ^int value]
    (XMLChar/isNameStart value))

  (method ^:protected isValidNameStartHighSurrogate ^boolean [this ^int value]
    false)

  (method ^:protected versionSupported ^boolean [this ^String version]
    (or (.equals version "1.0") (.equals version "1.1")))

  (method ^:protected scanSurrogates :throws [IOException XNIException] ^boolean [this
                                                                                  ^XMLStringBuffer buf]
    (let [high (.scanChar fEntityScanner nil)
          low (.peekChar fEntityScanner)]
      (if (not (XMLChar/isLowSurrogate low))
          (do
            (.reportFatalError this
                               "InvalidCharInContent"
                               (new Object/1 [(Integer/toString high 16)]))
            false)
          (do
            (.scanChar fEntityScanner nil)
            (let [c (XMLChar/supplemental (unchecked-char high) (unchecked-char low))]
              (if (.isInvalid this c)
                  (do
                    (.reportFatalError this
                                       "InvalidCharInContent"
                                       (new Object/1 [(Integer/toString c 16)]))
                    false)
                  (do (.append buf (unchecked-char high)) (.append buf (unchecked-char low)) true)))))))

  (method ^:protected reportFatalError :throws [XNIException] ^void [this ^String msgId
                                                                     ^Object/1 args]
    (.reportError fErrorReporter
                  fEntityScanner
                  XMLMessageFormatter/XML_DOMAIN
                  msgId
                  args
                  XMLErrorReporter/SEVERITY_FATAL_ERROR))

  (method ^:private init ^void [this]
    (set! fEntityScanner nil)
    (set! fEntityDepth 0)
    (set! fReportEntity true)
    (.clear fResourceIdentifier)
    (when-not fAttributeCacheInitDone
      (loop [^int i 0]
        (when (< i initialCacheCount)
          (.add attributeValueCache (XMLString.))
          (.add stringBufferCache (XMLStringBuffer.))
          (recur (unchecked-inc-int i))))
      (set! fAttributeCacheInitDone true))
    (set! fStringBufferIndex 0)
    (set! fAttributeCacheUsedCount 0))

  (method getStringBuffer ^XMLStringBuffer [this]
    (if (or (< fStringBufferIndex initialCacheCount)
            (< fStringBufferIndex (.size stringBufferCache)))
        (cast XMLStringBuffer
              (.get stringBufferCache
                    (let [old-1 fStringBufferIndex]
                      (set! fStringBufferIndex (unchecked-inc-int fStringBufferIndex))
                      old-1)))
        (let [tmpObj (XMLStringBuffer.)]
          (set! fStringBufferIndex (unchecked-inc-int fStringBufferIndex))
          (.add stringBufferCache tmpObj)
          tmpObj)))

  (method checkEntityLimit ^void [this ^boolean isPEDecl ^String entityName ^XMLString buffer]
    (.checkEntityLimit this isPEDecl entityName (.-length buffer)))

  (method checkEntityLimit ^void [this ^boolean isPEDecl ^String entityName ^int len]
    (when (nil? fLimitAnalyzer) (set! fLimitAnalyzer (.-fLimitAnalyzer fEntityManager)))
    (if isPEDecl
        (do
          (.addValue fLimitAnalyzer
                     XMLSecurityManager$Limit/PARAMETER_ENTITY_SIZE_LIMIT
                     (java-str "%" entityName)
                     len)
          (when (.isOverLimit fSecurityManager
                              XMLSecurityManager$Limit/PARAMETER_ENTITY_SIZE_LIMIT
                              fLimitAnalyzer)
            (.debugPrint fSecurityManager fLimitAnalyzer)
            (.reportFatalError this
                               "MaxEntitySizeLimit"
                               (new Object/1
                                    [(java-str "%" entityName)
                                     (.getValue
                                       fLimitAnalyzer
                                       XMLSecurityManager$Limit/PARAMETER_ENTITY_SIZE_LIMIT)
                                     (.getLimit
                                       fSecurityManager
                                       XMLSecurityManager$Limit/PARAMETER_ENTITY_SIZE_LIMIT)
                                     (.systemProperty
                                       XMLSecurityManager$Limit/PARAMETER_ENTITY_SIZE_LIMIT)]))))
        (do
          (.addValue fLimitAnalyzer
                     XMLSecurityManager$Limit/GENERAL_ENTITY_SIZE_LIMIT
                     entityName
                     len)
          (when (.isOverLimit fSecurityManager
                              XMLSecurityManager$Limit/GENERAL_ENTITY_SIZE_LIMIT
                              fLimitAnalyzer)
            (.debugPrint fSecurityManager fLimitAnalyzer)
            (.reportFatalError this
                               "MaxEntitySizeLimit"
                               (new Object/1
                                    [entityName
                                     (.getValue fLimitAnalyzer
                                                XMLSecurityManager$Limit/GENERAL_ENTITY_SIZE_LIMIT)
                                     (.getLimit fSecurityManager
                                                XMLSecurityManager$Limit/GENERAL_ENTITY_SIZE_LIMIT)
                                     (.systemProperty
                                       XMLSecurityManager$Limit/GENERAL_ENTITY_SIZE_LIMIT)])))))
    (when (.isOverLimit fSecurityManager
                        XMLSecurityManager$Limit/TOTAL_ENTITY_SIZE_LIMIT
                        fLimitAnalyzer)
      (.debugPrint fSecurityManager fLimitAnalyzer)
      (.reportFatalError this
                         "TotalEntitySizeLimit"
                         (new Object/1
                              [(.getTotalValue fLimitAnalyzer
                                               XMLSecurityManager$Limit/TOTAL_ENTITY_SIZE_LIMIT)
                               (.getLimit fSecurityManager
                                          XMLSecurityManager$Limit/TOTAL_ENTITY_SIZE_LIMIT)
                               (.getStateLiteral
                                 fSecurityManager
                                 XMLSecurityManager$Limit/TOTAL_ENTITY_SIZE_LIMIT)])))))

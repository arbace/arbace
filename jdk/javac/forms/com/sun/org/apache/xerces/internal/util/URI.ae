  (method ^:public getFragment ^String [this] m_fragment)

  (method ^:public setScheme :throws [MalformedURIException] ^void [this ^String p_scheme]
    (when (nil? p_scheme) (throw (MalformedURIException. "Cannot set scheme from null string!")))
    (when-not (URI/isConformantSchemeName p_scheme)
      (throw (MalformedURIException. "The scheme is not conformant.")))
    (set! m_scheme (.toLowerCase p_scheme)))

  (method ^:public setUserinfo :throws [MalformedURIException] ^void [this ^String p_userinfo]

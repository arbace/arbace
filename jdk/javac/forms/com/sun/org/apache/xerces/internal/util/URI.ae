  (method ^:private ^:static isPathCharacter ^boolean [^char p_char]
    (and (<= p_char \~) (not (== (bit-and-int (aget fgLookupTable p_char) MASK_PATH_CHARACTER) 0))))

  (method ^:private ^:static isURIString ^boolean [^String p_uric]
    (if (nil? p_uric)
        false
        (let [end (.length p_uric)
              ^:mutable testChar \u0000]
          (let [^:mutable ^int i 0]
            (while (< i end)

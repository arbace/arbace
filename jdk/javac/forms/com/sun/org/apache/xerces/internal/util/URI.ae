              (set! testChar (.charAt p_scheme i))
              (if (not (URI/isSchemeCharacter testChar))
                  (return false)
                  (recur (unchecked-inc-int i)))))
          true)))

  (method ^:public ^:static isWellFormedAddress ^boolean [^String address]

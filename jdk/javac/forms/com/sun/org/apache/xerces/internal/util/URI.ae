        (do
          (when (nil? m_host)
            (throw (MalformedURIException. "Userinfo cannot be set when host is null!")))
          (let [^:mutable ^int index 0
                end (.length p_userinfo)
                ^:mutable testChar \u0000]
            (while (< index end)
              (set! testChar (.charAt p_userinfo index))
              (if (== testChar \%)
                  (when (or (or (>= (unchecked-add-int index 2) end)
                                (not (URI/isHex (.charAt p_userinfo (unchecked-add-int index 1)))))
                            (not (URI/isHex (.charAt p_userinfo (unchecked-add-int index 2)))))
                    (throw (MalformedURIException. "Userinfo contains invalid escape sequence!")))
                  (when-not (URI/isUserinfoCharacter testChar)
                    (throw (MalformedURIException.
                             (java-str "Userinfo contains invalid character:" testChar)))))
              (set! index (unchecked-inc-int index))))
          (set! m_userinfo p_userinfo))))

  (method ^:public setHost :throws [MalformedURIException] ^void [this ^String p_host]
    (if (or (nil? p_host) (== (.length p_host) 0))
        (do
          (when (some? p_host) (set! m_regAuthority nil))
          (set! m_host p_host)
          (set! m_userinfo nil)
          (set! m_port -1))
        (do
          (when-not (URI/isWellFormedAddress p_host)
            (throw (MalformedURIException. "Host is not a well formed address!")))
          (set! m_host p_host)
          (set! m_regAuthority nil))))

  (method ^:public setPort :throws [MalformedURIException] ^void [this ^int p_port]
    (if (and (>= p_port 0) (<= p_port 65535))
        (when (nil? m_host)
          (throw (MalformedURIException. "Port cannot be set when host is null!")))
        (when-not (== p_port -1) (throw (MalformedURIException. "Invalid port number!"))))
    (set! m_port p_port))

  (method ^:public setRegBasedAuthority :throws [MalformedURIException] ^void [this
                                                                               ^String authority]
    (if (nil? authority)
        (set! m_regAuthority nil)
        (do
          (when (or (or (< (.length authority) 1)
                        (not (.isValidRegistryBasedAuthority this authority)))
                    (not (== (.indexOf authority \/) -1)))
            (throw (MalformedURIException. "Registry based authority is not well formed.")))
          (set! m_regAuthority authority)
          (set! m_host nil)
          (set! m_userinfo nil)
          (set! m_port -1))))

  (method ^:public setPath :throws [MalformedURIException] ^void [this ^String p_path]
    (if (nil? p_path)
        (do (set! m_path nil) (set! m_queryString nil) (set! m_fragment nil))
        (.initializePath this p_path 0)))

  (method ^:public appendPath :throws [MalformedURIException] ^void [this ^String p_addToPath]
    (when-not (or (nil? p_addToPath) (== (.length (.trim p_addToPath)) 0))
      (when-not (URI/isURIString p_addToPath)
        (throw (MalformedURIException. "Path contains invalid character!")))
      (cond
        (or (nil? m_path) (== (.length (.trim m_path)) 0))
          (if (.startsWith p_addToPath "/")
              (set! m_path p_addToPath)
              (set! m_path (java-str "/" p_addToPath)))
        (.endsWith m_path "/")
          (if (.startsWith p_addToPath "/")
              (set! m_path (.concat m_path (.substring p_addToPath 1)))
              (set! m_path (.concat m_path p_addToPath)))
        (.startsWith p_addToPath "/") (set! m_path (.concat m_path p_addToPath))
        :else (set! m_path (.concat m_path (java-str "/" p_addToPath))))))

  (method ^:public setQueryString :throws [MalformedURIException] ^void [this ^String p_queryString]
    (cond
      (nil? p_queryString) (set! m_queryString nil)
      (not (.isGenericURI this))
        (throw (MalformedURIException. "Query string can only be set for a generic URI!"))
      (nil? (.getPath this))
        (throw (MalformedURIException. "Query string cannot be set when path is null!"))
      (not (URI/isURIString p_queryString))
        (throw (MalformedURIException. "Query string contains invalid character!"))
      :else (set! m_queryString p_queryString)))

  (method ^:public setFragment :throws [MalformedURIException] ^void [this ^String p_fragment]
    (cond
      (nil? p_fragment) (set! m_fragment nil)
      (not (.isGenericURI this))
        (throw (MalformedURIException. "Fragment can only be set for a generic URI!"))
      (nil? (.getPath this))
        (throw (MalformedURIException. "Fragment cannot be set when path is null!"))
      (not (URI/isURIString p_fragment))
        (throw (MalformedURIException. "Fragment contains invalid character!"))
      :else (set! m_fragment p_fragment)))

  (method ^:public equals ^boolean [this p_test]
    (when (instance? URI p_test)
      (let [testURI (cast URI p_test)]
        (when (and (and (and (and (and (and (or (and (nil? m_scheme) (nil? (.-m_scheme testURI)))
                                                (and
                                                  (and
                                                    (some? m_scheme)
                                                    (some? (.-m_scheme testURI)))
                                                  (.equals m_scheme (.-m_scheme testURI))))
                                            (or (and
                                                  (nil? m_userinfo)
                                                  (nil? (.-m_userinfo testURI)))
                                                (and
                                                  (and
                                                    (some? m_userinfo)
                                                    (some? (.-m_userinfo testURI)))
                                                  (.equals m_userinfo (.-m_userinfo testURI)))))
                                       (or (and (nil? m_host) (nil? (.-m_host testURI)))
                                           (and (and (some? m_host) (some? (.-m_host testURI)))
                                                (.equals m_host (.-m_host testURI)))))
                                  (== m_port (.-m_port testURI)))
                             (or (and (nil? m_path) (nil? (.-m_path testURI)))
                                 (and (and (some? m_path) (some? (.-m_path testURI)))
                                      (.equals m_path (.-m_path testURI)))))
                        (or (and (nil? m_queryString) (nil? (.-m_queryString testURI)))
                            (and (and (some? m_queryString) (some? (.-m_queryString testURI)))
                                 (.equals m_queryString (.-m_queryString testURI)))))
                   (or (and (nil? m_fragment) (nil? (.-m_fragment testURI)))
                       (and (and (some? m_fragment) (some? (.-m_fragment testURI)))
                            (.equals m_fragment (.-m_fragment testURI)))))
          (return true))))
    false)

  (method ^:public hashCode ^int [this]

    (and (<= p_char \~) (not (== (bit-and-int (aget fgLookupTable p_char) MASK_URI_CHARACTER) 0))))

  (method ^:private ^:static isSchemeCharacter ^boolean [^char p_char]
    (and (<= p_char \z)
         (not (== (bit-and-int (aget fgLookupTable p_char) MASK_SCHEME_CHARACTER) 0))))

  (method ^:private ^:static isUserinfoCharacter ^boolean [^char p_char]
    (and (<= p_char \z)

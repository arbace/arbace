              (when (== testChar \%)
                (if (or (or (>= (unchecked-add-int i 2) end)
                            (not (URI/isHex (.charAt p_uric (unchecked-add-int i 1)))))
                        (not (URI/isHex (.charAt p_uric (unchecked-add-int i 2)))))
                    (return false)
                    (do (set! i (unchecked-add-int i 2)) (set! i (unchecked-inc-int i)) (continue))))

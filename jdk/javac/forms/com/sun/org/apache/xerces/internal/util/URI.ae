      (set! hash (unchecked-add-int (unchecked-multiply-int 47 hash) (.-m_port this)))
      (set! hash
            (unchecked-add-int (unchecked-multiply-int 47 hash) (Objects/hashCode (.-m_path this))))
      (set! hash
            (unchecked-add-int (unchecked-multiply-int 47 hash)
                               (Objects/hashCode (.-m_queryString this))))
      (set! hash
            (unchecked-add-int (unchecked-multiply-int 47 hash)
                               (Objects/hashCode (.-m_fragment this))))
      hash))

  (method ^:public toString ^String [this]
    (let [uriSpecString (StringBuilder.)]
      (when (some? m_scheme) (.append uriSpecString m_scheme) (.append uriSpecString \:))
      (.append uriSpecString (.getSchemeSpecificPart this))
      (.toString uriSpecString)))


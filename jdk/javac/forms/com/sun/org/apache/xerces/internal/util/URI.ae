  (method ^:public getScheme ^String [this] m_scheme)

  (method ^:public getSchemeSpecificPart ^String [this]
    (let [schemespec (StringBuilder.)]
      (when (or (some? m_host) (some? m_regAuthority))
        (.append schemespec "//")
        (if (some? m_host)
            (do
              (when (some? m_userinfo) (.append schemespec m_userinfo) (.append schemespec \@))
              (.append schemespec m_host)
              (when-not (== m_port -1) (.append schemespec \:) (.append schemespec m_port)))
            (.append schemespec m_regAuthority)))
      (when (some? m_path) (.append schemespec m_path))
      (when (some? m_queryString) (.append schemespec \?) (.append schemespec m_queryString))
      (when (some? m_fragment) (.append schemespec \#) (.append schemespec m_fragment))
      (.toString schemespec)))

  (method ^:public getUserinfo ^String [this] m_userinfo)

  (method ^:public getHost ^String [this] m_host)

  (method ^:public getPort ^int [this] m_port)

  (method ^:public getRegBasedAuthority ^String [this] m_regAuthority)

  (method ^:public getAuthority ^String [this]
    (let [authority (StringBuilder.)]
      (when (or (some? m_host) (some? m_regAuthority))
        (.append authority "//")
        (if (some? m_host)
            (do
              (when (some? m_userinfo) (.append authority m_userinfo) (.append authority \@))
              (.append authority m_host)
              (when-not (== m_port -1) (.append authority \:) (.append authority m_port)))
            (.append authority m_regAuthority)))
      (.toString authority)))

  (method ^:public getPath ^String [this ^boolean p_includeQueryString ^boolean p_includeFragment]
    (let [pathString (StringBuilder. m_path)]
      (when (and p_includeQueryString (some? m_queryString))
        (.append pathString \?)
        (.append pathString m_queryString))
      (when (and p_includeFragment (some? m_fragment))
        (.append pathString \#)
        (.append pathString m_fragment))
      (.toString pathString)))


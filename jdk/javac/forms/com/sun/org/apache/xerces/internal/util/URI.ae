              (when (and (> numDigits 0)
                         (> (aset counter 0 (unchecked-inc-int (aget counter 0))) 8))
                (return -1))
              (when (or (== numDigits 0)
                        (and (< (unchecked-add-int index 1) end)
                             (== (.charAt address (unchecked-add-int index 1)) \:)))
                (return index))
              (set! numDigits 0))
          (not (URI/isHex testChar))

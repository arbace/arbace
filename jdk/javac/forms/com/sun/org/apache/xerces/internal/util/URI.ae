  (method ^:private ^:static isDigit ^boolean [^char p_char]
    (and (>= p_char \0) (<= p_char \9)))

  (method ^:private ^:static isHex ^boolean [^char p_char]
    (and (<= p_char \f) (not (== (bit-and-int (aget fgLookupTable p_char) ASCII_HEX_CHARACTERS) 0))))

  (method ^:private ^:static isAlpha ^boolean [^char p_char]

        false
        (let [chunk (bit-shift-right-int elementDeclIndex CHUNK_SHIFT)
              index (bit-and-int elementDeclIndex CHUNK_MASK)]
          (.setValues (.-name elementDecl) (aget fElementDeclName chunk index))
          (if (== (aget fElementDeclType chunk index) -1)
              (do (set! (.-type elementDecl) -1) (set! (.-list (.-simpleType elementDecl)) false))
              (do
                (set! (.-type elementDecl)
                      (unchecked-short (bit-and-int (aget fElementDeclType chunk index) LIST_MASK)))
                (set! (.-list (.-simpleType elementDecl))
                      (not (== (bit-and-int (aget fElementDeclType chunk index) LIST_FLAG) 0)))))
          (when (or (== (.-type elementDecl) XMLElementDecl/TYPE_CHILDREN)
                    (== (.-type elementDecl) XMLElementDecl/TYPE_MIXED))
            (set! (.-contentModelValidator elementDecl)
                  (.getElementContentModelValidator this elementDeclIndex)))
          (set! (.-datatypeValidator (.-simpleType elementDecl)) nil)
          (set! (.-defaultType (.-simpleType elementDecl)) -1)
          (set! (.-defaultValue (.-simpleType elementDecl)) nil)
          true)))

  (method getElementDeclName ^QName [this ^int elementDeclIndex]
    (when-not (or (< elementDeclIndex 0) (>= elementDeclIndex fElementDeclCount))
      (let [chunk (bit-shift-right-int elementDeclIndex CHUNK_SHIFT)
            index (bit-and-int elementDeclIndex CHUNK_MASK)]
        (aget fElementDeclName chunk index))))

  (method ^:public getFirstAttributeDeclIndex ^int [this ^int elementDeclIndex]
    (let [chunk (bit-shift-right-int elementDeclIndex CHUNK_SHIFT)
          index (bit-and-int elementDeclIndex CHUNK_MASK)]
      (aget fElementDeclFirstAttributeDeclIndex chunk index)))

  (method ^:public getNextAttributeDeclIndex ^int [this ^int attributeDeclIndex]
    (let [chunk (bit-shift-right-int attributeDeclIndex CHUNK_SHIFT)
          index (bit-and-int attributeDeclIndex CHUNK_MASK)]
      (aget fAttributeDeclNextAttributeDeclIndex chunk index)))

  (method ^:public getAttributeDecl ^boolean [this ^int attributeDeclIndex
                                              ^XMLAttributeDecl attributeDecl]
    (if (or (< attributeDeclIndex 0) (>= attributeDeclIndex fAttributeDeclCount))
        false
        (let [chunk (bit-shift-right-int attributeDeclIndex CHUNK_SHIFT)
              index (bit-and-int attributeDeclIndex CHUNK_MASK)]
          (.setValues (.-name attributeDecl) (aget fAttributeDeclName chunk index))
          (let [^:mutable ^short attributeType 0
                ^:mutable ^boolean isList false]
            (if (== (aget fAttributeDeclType chunk index) -1)
                (do (set! attributeType -1) (set! isList false))
                (do
                  (set! attributeType
                        (unchecked-short
                          (bit-and-int (aget fAttributeDeclType chunk index) LIST_MASK)))
                  (set! isList
                        (not (== (bit-and-int (aget fAttributeDeclType chunk index) LIST_FLAG) 0)))))
            (.setValues (.-simpleType attributeDecl)
                        attributeType
                        (.-localpart (aget fAttributeDeclName chunk index))
                        (aget fAttributeDeclEnumeration chunk index)
                        isList
                        (aget fAttributeDeclDefaultType chunk index)
                        (aget fAttributeDeclDefaultValue chunk index)
                        (aget fAttributeDeclNonNormalizedDefaultValue chunk index)
                        (aget fAttributeDeclDatatypeValidator chunk index))
            true))))

  (method ^:public isCDATAAttribute ^boolean [this ^QName elName ^QName atName]
    (let [elDeclIdx (.getElementDeclIndex this elName)]
      (if (and (.getAttributeDecl this elDeclIdx fAttributeDecl)
               (not (== (.-type (.-simpleType fAttributeDecl)) XMLSimpleType/TYPE_CDATA)))
          false
          true)))

  (method ^:public getEntityDeclIndex ^int [this ^String entityDeclName]
    (if (or (nil? entityDeclName) (nil? (.get fEntityIndexMap entityDeclName)))
        -1
        (.intValue (cast Integer (.get fEntityIndexMap entityDeclName)))))

  (method ^:public getEntityDecl ^boolean [this ^int entityDeclIndex ^XMLEntityDecl entityDecl]
    (if (or (< entityDeclIndex 0) (>= entityDeclIndex fEntityCount))
        false
        (let [chunk (bit-shift-right-int entityDeclIndex CHUNK_SHIFT)
              index (bit-and-int entityDeclIndex CHUNK_MASK)]
          (.setValues entityDecl
                      (aget fEntityName chunk index)
                      (aget fEntityPublicId chunk index)
                      (aget fEntitySystemId chunk index)
                      (aget fEntityBaseSystemId chunk index)
                      (aget fEntityNotation chunk index)
                      (aget fEntityValue chunk index)
                      (if (== (aget fEntityIsPE chunk index) 0) false true)
                      (if (== (aget fEntityInExternal chunk index) 0) false true))
          true)))

  (method ^:public getNotationDeclIndex ^int [this ^String notationDeclName]
    (if (or (nil? notationDeclName) (nil? (.get fNotationIndexMap notationDeclName)))
        -1
        (.intValue (cast Integer (.get fNotationIndexMap notationDeclName)))))

  (method ^:public getNotationDecl ^boolean [this ^int notationDeclIndex
                                             ^XMLNotationDecl notationDecl]
    (if (or (< notationDeclIndex 0) (>= notationDeclIndex fNotationCount))
        false
        (let [chunk (bit-shift-right-int notationDeclIndex CHUNK_SHIFT)
              index (bit-and-int notationDeclIndex CHUNK_MASK)]
          (.setValues notationDecl
                      (aget fNotationName chunk index)
                      (aget fNotationPublicId chunk index)
                      (aget fNotationSystemId chunk index)
                      (aget fNotationBaseSystemId chunk index))
          true)))

  (method ^:public getContentSpec ^boolean [this ^int contentSpecIndex ^XMLContentSpec contentSpec]
    (if (or (< contentSpecIndex 0) (>= contentSpecIndex fContentSpecCount))
        false
        (let [chunk (bit-shift-right-int contentSpecIndex CHUNK_SHIFT)
              index (bit-and-int contentSpecIndex CHUNK_MASK)]
          (set! (.-type contentSpec) (aget fContentSpecType chunk index))
          (set! (.-value contentSpec) (aget fContentSpecValue chunk index))
          (set! (.-otherValue contentSpec) (aget fContentSpecOtherValue chunk index))
          true)))

  (method ^:public getContentSpecIndex ^int [this ^int elementDeclIndex]
    (if (or (< elementDeclIndex 0) (>= elementDeclIndex fElementDeclCount))
        -1
        (let [chunk (bit-shift-right-int elementDeclIndex CHUNK_SHIFT)
              index (bit-and-int elementDeclIndex CHUNK_MASK)]
          (aget fElementDeclContentSpecIndex chunk index))))

  (method ^:public getContentSpecAsString ^String [this ^int elementDeclIndex]
    (when-not (or (< elementDeclIndex 0) (>= elementDeclIndex fElementDeclCount))
      (let [chunk (bit-shift-right-int elementDeclIndex CHUNK_SHIFT)
            index (bit-and-int elementDeclIndex CHUNK_MASK)
            contentSpecIndex (aget fElementDeclContentSpecIndex chunk index)
            contentSpec (XMLContentSpec.)]
        (when (.getContentSpec this contentSpecIndex contentSpec)
          (let [str (StringBuffer.)
                parentContentSpecType (bit-and-int (.-type contentSpec) 0x0f)
                ^:mutable ^int nextContentSpec 0]
            (switch parentContentSpecType
              XMLContentSpec/CONTENTSPECNODE_LEAF
                (do
                  (.append str \()
                  (if (and (nil? (.-value contentSpec)) (nil? (.-otherValue contentSpec)))
                      (.append str "#PCDATA")
                      (.append str (.-value contentSpec)))
                  (.append str \)))
              XMLContentSpec/CONTENTSPECNODE_ZERO_OR_ONE
                (do
                  (.getContentSpec this (aget (cast int/1 (.-value contentSpec)) 0) contentSpec)
                  (set! nextContentSpec (.-type contentSpec))
                  (cond
                    (== nextContentSpec XMLContentSpec/CONTENTSPECNODE_LEAF)
                      (do (.append str \() (.append str (.-value contentSpec)) (.append str \)))
                    (or (or (== nextContentSpec XMLContentSpec/CONTENTSPECNODE_ONE_OR_MORE)
                            (== nextContentSpec XMLContentSpec/CONTENTSPECNODE_ZERO_OR_MORE))
                        (== nextContentSpec XMLContentSpec/CONTENTSPECNODE_ZERO_OR_ONE))
                      (do
                        (.append str \()
                        (.appendContentSpec this contentSpec str true parentContentSpecType)
                        (.append str \)))
                    :else (.appendContentSpec this contentSpec str true parentContentSpecType))
                  (.append str \?))
              XMLContentSpec/CONTENTSPECNODE_ZERO_OR_MORE
                (do
                  (.getContentSpec this (aget (cast int/1 (.-value contentSpec)) 0) contentSpec)
                  (set! nextContentSpec (.-type contentSpec))
                  (cond
                    (== nextContentSpec XMLContentSpec/CONTENTSPECNODE_LEAF)
                      (do
                        (.append str \()
                        (cond
                          (and (nil? (.-value contentSpec)) (nil? (.-otherValue contentSpec)))
                            (.append str "#PCDATA")
                          (some? (.-otherValue contentSpec))
                            (.append (.append str "##any:uri=") (.-otherValue contentSpec))
                          (nil? (.-value contentSpec)) (.append str "##any")
                          :else (.appendContentSpec this contentSpec str true parentContentSpecType))
                        (.append str \)))
                    (or (or (== nextContentSpec XMLContentSpec/CONTENTSPECNODE_ONE_OR_MORE)
                            (== nextContentSpec XMLContentSpec/CONTENTSPECNODE_ZERO_OR_MORE))
                        (== nextContentSpec XMLContentSpec/CONTENTSPECNODE_ZERO_OR_ONE))
                      (do
                        (.append str \()
                        (.appendContentSpec this contentSpec str true parentContentSpecType)
                        (.append str \)))
                    :else (.appendContentSpec this contentSpec str true parentContentSpecType))
                  (.append str \*))
              XMLContentSpec/CONTENTSPECNODE_ONE_OR_MORE
                (do
                  (.getContentSpec this (aget (cast int/1 (.-value contentSpec)) 0) contentSpec)
                  (set! nextContentSpec (.-type contentSpec))
                  (cond
                    (== nextContentSpec XMLContentSpec/CONTENTSPECNODE_LEAF)
                      (do
                        (.append str \()
                        (cond
                          (and (nil? (.-value contentSpec)) (nil? (.-otherValue contentSpec)))
                            (.append str "#PCDATA")
                          (some? (.-otherValue contentSpec))
                            (.append (.append str "##any:uri=") (.-otherValue contentSpec))
                          (nil? (.-value contentSpec)) (.append str "##any")
                          :else (.append str (.-value contentSpec)))
                        (.append str \)))
                    (or (or (== nextContentSpec XMLContentSpec/CONTENTSPECNODE_ONE_OR_MORE)
                            (== nextContentSpec XMLContentSpec/CONTENTSPECNODE_ZERO_OR_MORE))
                        (== nextContentSpec XMLContentSpec/CONTENTSPECNODE_ZERO_OR_ONE))
                      (do
                        (.append str \()
                        (.appendContentSpec this contentSpec str true parentContentSpecType)
                        (.append str \)))
                    :else (.appendContentSpec this contentSpec str true parentContentSpecType))
                  (.append str \+))
              (XMLContentSpec/CONTENTSPECNODE_CHOICE XMLContentSpec/CONTENTSPECNODE_SEQ)
                (.appendContentSpec this contentSpec str true parentContentSpecType)
              XMLContentSpec/CONTENTSPECNODE_ANY
                (do
                  (.append str "##any")
                  (when (some? (.-otherValue contentSpec))
                    (.append str ":uri=")
                    (.append str (.-otherValue contentSpec))))
              XMLContentSpec/CONTENTSPECNODE_ANY_OTHER
                (do (.append str "##other:uri=") (.append str (.-otherValue contentSpec)))
              XMLContentSpec/CONTENTSPECNODE_ANY_LOCAL (.append str "##local")
              (.append str "???"))
            (.toString str))))))

  (method ^:public printElements ^void [this]
    (let [^:mutable ^int elementDeclIndex 0
          elementDecl (XMLElementDecl.)]
      (while (.getElementDecl this
                              (let [old-2 elementDeclIndex]
                                (set! elementDeclIndex (unchecked-inc-int elementDeclIndex))
                                old-2)
                              elementDecl)
        (.println System/out
                  (java-str "element decl: "
                            (.-name elementDecl)
                            ", "
                            (.-rawname (.-name elementDecl)))))))

  (method ^:public printAttributes ^void [this ^int elementDeclIndex]
    (let [^:mutable attributeDeclIndex (.getFirstAttributeDeclIndex this elementDeclIndex)]
      (.print System/out elementDeclIndex)
      (.print System/out " [")
      (while (not (== attributeDeclIndex -1))
        (.print System/out \space)
        (.print System/out attributeDeclIndex)
        (.printAttribute this attributeDeclIndex)
        (set! attributeDeclIndex (.getNextAttributeDeclIndex this attributeDeclIndex))
        (when-not (== attributeDeclIndex -1) (.print System/out ",")))
      (.println System/out " ]")))

  (method ^:protected addContentSpecToElement ^void [this ^XMLElementDecl elementDecl]
    (when (and (or (== fDepth 0)
                   (and (== fDepth 1) (== (.-type elementDecl) XMLElementDecl/TYPE_MIXED)))
               (some? fNodeIndexStack))
      (when (== (.-type elementDecl) XMLElementDecl/TYPE_MIXED)
        (let [pcdata (.addUniqueLeafNode this nil)]
          (if (== (aget fNodeIndexStack 0) -1)
              (aset fNodeIndexStack 0 pcdata)
              (aset fNodeIndexStack
                    0
                    (.addContentSpecNode this
                                         XMLContentSpec/CONTENTSPECNODE_CHOICE
                                         pcdata
                                         (aget fNodeIndexStack 0))))))
      (.setContentSpecIndex this fCurrentElementIndex (aget fNodeIndexStack fDepth))))

  (method ^:protected getElementContentModelValidator ^ContentModelValidator [this
                                                                              ^int elementDeclIndex]
    (let [chunk (bit-shift-right-int elementDeclIndex CHUNK_SHIFT)
          index (bit-and-int elementDeclIndex CHUNK_MASK)
          ^:mutable contentModel (aget fElementDeclContentModelValidator chunk index)]
      (if (some? contentModel)
          contentModel
          (let [^int contentType (aget fElementDeclType chunk index)]
            (when-not (== contentType XMLElementDecl/TYPE_SIMPLE)
              (let [contentSpecIndex (aget fElementDeclContentSpecIndex chunk index)
                    contentSpec (XMLContentSpec.)]
                (.getContentSpec this contentSpecIndex contentSpec)
                (cond
                  (== contentType XMLElementDecl/TYPE_MIXED)
                    (let [children (ChildrenList.)]
                      (.contentSpecTree this contentSpecIndex contentSpec children)
                      (set! contentModel
                            (MixedContentModel. (.-qname children)
                                                (.-type children)
                                                0
                                                (.-length children)
                                                false)))
                  (== contentType XMLElementDecl/TYPE_CHILDREN)
                    (set! contentModel (.createChildModel this contentSpecIndex))
                  :else
                    (throw
                      (RuntimeException.
                        "Unknown content type for a element decl in getElementContentModelValidator() in AbstractDTDGrammar class")))
                (aset (aget fElementDeclContentModelValidator chunk) index contentModel)
                contentModel))))))

  (method ^:protected createElementDecl ^int [this]
    (let [chunk (bit-shift-right-int fElementDeclCount CHUNK_SHIFT)
          index (bit-and-int fElementDeclCount CHUNK_MASK)]
      (.ensureElementDeclCapacity this chunk)
      (aset (aget fElementDeclName chunk) index (QName.))
      (aset (aget fElementDeclType chunk) index -1)
      (aset (aget fElementDeclContentModelValidator chunk) index nil)
      (aset (aget fElementDeclFirstAttributeDeclIndex chunk) index -1)
      (aset (aget fElementDeclLastAttributeDeclIndex chunk) index -1)
      (let [fElementDeclCount-3 fElementDeclCount]
        (set! fElementDeclCount (unchecked-inc-int fElementDeclCount))
        fElementDeclCount-3)))

  (method ^:protected setElementDecl ^void [this ^int elementDeclIndex ^XMLElementDecl elementDecl]
    (when-not (or (< elementDeclIndex 0) (>= elementDeclIndex fElementDeclCount))
      (let [chunk (bit-shift-right-int elementDeclIndex CHUNK_SHIFT)
            index (bit-and-int elementDeclIndex CHUNK_MASK)]
        (.setValues (aget fElementDeclName chunk index) (.-name elementDecl))
        (aset (aget fElementDeclType chunk) index (.-type elementDecl))
        (aset (aget fElementDeclContentModelValidator chunk)
              index
              (.-contentModelValidator elementDecl))
        (when (= (.-list (.-simpleType elementDecl)) true)
          (let [arr-4 (aget fElementDeclType chunk)]
            (aset arr-4 index (unchecked-short (bit-or-int (aget arr-4 index) LIST_FLAG)))))
        (.put fElementIndexMap (.-rawname (.-name elementDecl)) elementDeclIndex))))

  (method ^:protected putElementNameMapping ^void [this ^QName name ^int scope ^int elementDeclIndex])

  (method ^:protected setFirstAttributeDeclIndex ^void [this ^int elementDeclIndex
                                                        ^int newFirstAttrIndex]
    (when-not (or (< elementDeclIndex 0) (>= elementDeclIndex fElementDeclCount))
      (let [chunk (bit-shift-right-int elementDeclIndex CHUNK_SHIFT)
            index (bit-and-int elementDeclIndex CHUNK_MASK)]
        (aset (aget fElementDeclFirstAttributeDeclIndex chunk) index newFirstAttrIndex))))

  (method ^:protected setContentSpecIndex ^void [this ^int elementDeclIndex ^int contentSpecIndex]
    (when-not (or (< elementDeclIndex 0) (>= elementDeclIndex fElementDeclCount))
      (let [chunk (bit-shift-right-int elementDeclIndex CHUNK_SHIFT)
            index (bit-and-int elementDeclIndex CHUNK_MASK)]
        (aset (aget fElementDeclContentSpecIndex chunk) index contentSpecIndex))))

  (method ^:protected createAttributeDecl ^int [this]
    (let [chunk (bit-shift-right-int fAttributeDeclCount CHUNK_SHIFT)
          index (bit-and-int fAttributeDeclCount CHUNK_MASK)]
      (.ensureAttributeDeclCapacity this chunk)
      (aset (aget fAttributeDeclName chunk) index (QName.))
      (aset (aget fAttributeDeclType chunk) index -1)
      (aset (aget fAttributeDeclDatatypeValidator chunk) index nil)
      (aset (aget fAttributeDeclEnumeration chunk) index nil)
      (aset (aget fAttributeDeclDefaultType chunk) index XMLSimpleType/DEFAULT_TYPE_IMPLIED)
      (aset (aget fAttributeDeclDefaultValue chunk) index nil)
      (aset (aget fAttributeDeclNonNormalizedDefaultValue chunk) index nil)
      (aset (aget fAttributeDeclNextAttributeDeclIndex chunk) index -1)
      (let [fAttributeDeclCount-5 fAttributeDeclCount]
        (set! fAttributeDeclCount (unchecked-inc-int fAttributeDeclCount))
        fAttributeDeclCount-5)))

  (method ^:protected setAttributeDecl ^void [this ^int elementDeclIndex ^int attributeDeclIndex
                                              ^XMLAttributeDecl attributeDecl]
    (let [^:mutable attrChunk (bit-shift-right-int attributeDeclIndex CHUNK_SHIFT)
          ^:mutable attrIndex (bit-and-int attributeDeclIndex CHUNK_MASK)]
      (.setValues (aget fAttributeDeclName attrChunk attrIndex) (.-name attributeDecl))
      (aset (aget fAttributeDeclType attrChunk) attrIndex (.-type (.-simpleType attributeDecl)))
      (when (.-list (.-simpleType attributeDecl))
        (let [arr-6 (aget fAttributeDeclType attrChunk)]
          (aset arr-6 attrIndex (unchecked-short (bit-or-int (aget arr-6 attrIndex) LIST_FLAG)))))
      (aset (aget fAttributeDeclEnumeration attrChunk)
            attrIndex
            (.-enumeration (.-simpleType attributeDecl)))
      (aset (aget fAttributeDeclDefaultType attrChunk)
            attrIndex
            (.-defaultType (.-simpleType attributeDecl)))
      (aset (aget fAttributeDeclDatatypeValidator attrChunk)
            attrIndex
            (.-datatypeValidator (.-simpleType attributeDecl)))
      (aset (aget fAttributeDeclDefaultValue attrChunk)
            attrIndex
            (.-defaultValue (.-simpleType attributeDecl)))
      (aset (aget fAttributeDeclNonNormalizedDefaultValue attrChunk)
            attrIndex
            (.-nonNormalizedDefaultValue (.-simpleType attributeDecl)))
      (let [elemChunk (bit-shift-right-int elementDeclIndex CHUNK_SHIFT)
            elemIndex (bit-and-int elementDeclIndex CHUNK_MASK)
            ^:mutable index (aget fElementDeclFirstAttributeDeclIndex elemChunk elemIndex)]
        (while (not (== index -1))
          (when (== index attributeDeclIndex) (break))
          (set! attrChunk (bit-shift-right-int index CHUNK_SHIFT))
          (set! attrIndex (bit-and-int index CHUNK_MASK))
          (set! index (aget fAttributeDeclNextAttributeDeclIndex attrChunk attrIndex)))
        (when (== index -1)
          (if (== (aget fElementDeclFirstAttributeDeclIndex elemChunk elemIndex) -1)
              (aset (aget fElementDeclFirstAttributeDeclIndex elemChunk)
                    elemIndex
                    attributeDeclIndex)
              (do
                (set! index (aget fElementDeclLastAttributeDeclIndex elemChunk elemIndex))
                (set! attrChunk (bit-shift-right-int index CHUNK_SHIFT))
                (set! attrIndex (bit-and-int index CHUNK_MASK))
                (aset (aget fAttributeDeclNextAttributeDeclIndex attrChunk)
                      attrIndex
                      attributeDeclIndex)))
          (aset (aget fElementDeclLastAttributeDeclIndex elemChunk) elemIndex attributeDeclIndex)))))

  (method ^:protected createContentSpec ^int [this]
    (let [chunk (bit-shift-right-int fContentSpecCount CHUNK_SHIFT)
          index (bit-and-int fContentSpecCount CHUNK_MASK)]
      (.ensureContentSpecCapacity this chunk)
      (aset (aget fContentSpecType chunk) index -1)
      (aset (aget fContentSpecValue chunk) index nil)
      (aset (aget fContentSpecOtherValue chunk) index nil)
      (let [fContentSpecCount-7 fContentSpecCount]
        (set! fContentSpecCount (unchecked-inc-int fContentSpecCount))
        fContentSpecCount-7)))

  (method ^:protected setContentSpec ^void [this ^int contentSpecIndex ^XMLContentSpec contentSpec]
    (let [chunk (bit-shift-right-int contentSpecIndex CHUNK_SHIFT)
          index (bit-and-int contentSpecIndex CHUNK_MASK)]
      (aset (aget fContentSpecType chunk) index (.-type contentSpec))
      (aset (aget fContentSpecValue chunk) index (.-value contentSpec))
      (aset (aget fContentSpecOtherValue chunk) index (.-otherValue contentSpec))))

  (method ^:protected createEntityDecl ^int [this]
    (let [chunk (bit-shift-right-int fEntityCount CHUNK_SHIFT)
          index (bit-and-int fEntityCount CHUNK_MASK)]
      (.ensureEntityDeclCapacity this chunk)
      (aset (aget fEntityIsPE chunk) index 0)
      (aset (aget fEntityInExternal chunk) index 0)
      (let [fEntityCount-8 fEntityCount]
        (set! fEntityCount (unchecked-inc-int fEntityCount))
        fEntityCount-8)))

  (method ^:protected setEntityDecl ^void [this ^int entityDeclIndex ^XMLEntityDecl entityDecl]
    (let [chunk (bit-shift-right-int entityDeclIndex CHUNK_SHIFT)
          index (bit-and-int entityDeclIndex CHUNK_MASK)]
      (aset (aget fEntityName chunk) index (.-name entityDecl))
      (aset (aget fEntityValue chunk) index (.-value entityDecl))
      (aset (aget fEntityPublicId chunk) index (.-publicId entityDecl))
      (aset (aget fEntitySystemId chunk) index (.-systemId entityDecl))
      (aset (aget fEntityBaseSystemId chunk) index (.-baseSystemId entityDecl))
      (aset (aget fEntityNotation chunk) index (.-notation entityDecl))
      (aset (aget fEntityIsPE chunk)
            index
            (if (.-isPE entityDecl) (unchecked-byte 1) (unchecked-byte 0)))
      (aset (aget fEntityInExternal chunk)
            index
            (if (.-inExternal entityDecl) (unchecked-byte 1) (unchecked-byte 0)))
      (.put fEntityIndexMap (.-name entityDecl) entityDeclIndex)))

  (method ^:protected createNotationDecl ^int [this]
    (let [chunk (bit-shift-right-int fNotationCount CHUNK_SHIFT)]
      (.ensureNotationDeclCapacity this chunk)
      (let [fNotationCount-9 fNotationCount]
        (set! fNotationCount (unchecked-inc-int fNotationCount))
        fNotationCount-9)))

  (method ^:protected setNotationDecl ^void [this ^int notationDeclIndex
                                             ^XMLNotationDecl notationDecl]
    (let [chunk (bit-shift-right-int notationDeclIndex CHUNK_SHIFT)
          index (bit-and-int notationDeclIndex CHUNK_MASK)]
      (aset (aget fNotationName chunk) index (.-name notationDecl))
      (aset (aget fNotationPublicId chunk) index (.-publicId notationDecl))
      (aset (aget fNotationSystemId chunk) index (.-systemId notationDecl))
      (aset (aget fNotationBaseSystemId chunk) index (.-baseSystemId notationDecl))
      (.put fNotationIndexMap (.-name notationDecl) notationDeclIndex)))

  (method ^:protected addContentSpecNode ^int [this ^short nodeType ^String nodeValue]
    (let [contentSpecIndex (.createContentSpec this)]
      (.setValues fContentSpec nodeType nodeValue nil)
      (.setContentSpec this contentSpecIndex fContentSpec)
      contentSpecIndex))

  (method ^:protected addUniqueLeafNode ^int [this ^String elementName]
    (let [contentSpecIndex (.createContentSpec this)]
      (.setValues fContentSpec XMLContentSpec/CONTENTSPECNODE_LEAF elementName nil)
      (.setContentSpec this contentSpecIndex fContentSpec)
      contentSpecIndex))

  (method ^:protected addContentSpecNode ^int [this ^short nodeType ^int leftNodeIndex
                                               ^int rightNodeIndex]
    (let [contentSpecIndex (.createContentSpec this)
          leftIntArray (new int/1 1)
          rightIntArray (new int/1 1)]
      (aset leftIntArray 0 leftNodeIndex)
      (aset rightIntArray 0 rightNodeIndex)
      (.setValues fContentSpec nodeType leftIntArray rightIntArray)
      (.setContentSpec this contentSpecIndex fContentSpec)
      contentSpecIndex))

  (method ^:protected initializeContentModelStack ^void [this]
    (cond
      (nil? fOpStack)
        (do
          (set! fOpStack (new short/1 8))
          (set! fNodeIndexStack (new int/1 8))
          (set! fPrevNodeIndexStack (new int/1 8)))
      (== fDepth (alength fOpStack))
        (let [newStack (new short/1 (unchecked-multiply-int fDepth 2))]
          (System/arraycopy fOpStack 0 newStack 0 fDepth)
          (set! fOpStack newStack)
          (let [^:mutable newIntStack (new int/1 (unchecked-multiply-int fDepth 2))]
            (System/arraycopy fNodeIndexStack 0 newIntStack 0 fDepth)
            (set! fNodeIndexStack newIntStack)
            (set! newIntStack (new int/1 (unchecked-multiply-int fDepth 2)))
            (System/arraycopy fPrevNodeIndexStack 0 newIntStack 0 fDepth)
            (set! fPrevNodeIndexStack newIntStack))))
    (aset fOpStack fDepth -1)
    (aset fNodeIndexStack fDepth -1)
    (aset fPrevNodeIndexStack fDepth -1))

  (method isImmutable ^boolean [this] fIsImmutable)

  (method ^:private appendContentSpec ^void [this ^XMLContentSpec contentSpec ^StringBuffer str
                                             ^boolean parens ^int parentContentSpecType]
    (let [thisContentSpec (bit-and-int (.-type contentSpec) 0x0f)]
      (switch thisContentSpec
        XMLContentSpec/CONTENTSPECNODE_LEAF
          (cond
            (and (nil? (.-value contentSpec)) (nil? (.-otherValue contentSpec)))
              (.append str "#PCDATA")
            (and (nil? (.-value contentSpec)) (some? (.-otherValue contentSpec)))
              (.append (.append str "##any:uri=") (.-otherValue contentSpec))
            (nil? (.-value contentSpec)) (.append str "##any")
            :else (.append str (.-value contentSpec)))
        XMLContentSpec/CONTENTSPECNODE_ZERO_OR_ONE
          (do
            (if (or (or (== parentContentSpecType XMLContentSpec/CONTENTSPECNODE_ONE_OR_MORE)
                        (== parentContentSpecType XMLContentSpec/CONTENTSPECNODE_ZERO_OR_MORE))
                    (== parentContentSpecType XMLContentSpec/CONTENTSPECNODE_ZERO_OR_ONE))
                (do
                  (.getContentSpec this (aget (cast int/1 (.-value contentSpec)) 0) contentSpec)
                  (.append str \()
                  (.appendContentSpec this contentSpec str true thisContentSpec)
                  (.append str \)))
                (do
                  (.getContentSpec this (aget (cast int/1 (.-value contentSpec)) 0) contentSpec)
                  (.appendContentSpec this contentSpec str true thisContentSpec)))
            (.append str \?))
        XMLContentSpec/CONTENTSPECNODE_ZERO_OR_MORE
          (do
            (if (or (or (== parentContentSpecType XMLContentSpec/CONTENTSPECNODE_ONE_OR_MORE)
                        (== parentContentSpecType XMLContentSpec/CONTENTSPECNODE_ZERO_OR_MORE))
                    (== parentContentSpecType XMLContentSpec/CONTENTSPECNODE_ZERO_OR_ONE))
                (do
                  (.getContentSpec this (aget (cast int/1 (.-value contentSpec)) 0) contentSpec)
                  (.append str \()
                  (.appendContentSpec this contentSpec str true thisContentSpec)
                  (.append str \)))
                (do
                  (.getContentSpec this (aget (cast int/1 (.-value contentSpec)) 0) contentSpec)
                  (.appendContentSpec this contentSpec str true thisContentSpec)))
            (.append str \*))
        XMLContentSpec/CONTENTSPECNODE_ONE_OR_MORE
          (do
            (if (or (or (== parentContentSpecType XMLContentSpec/CONTENTSPECNODE_ONE_OR_MORE)
                        (== parentContentSpecType XMLContentSpec/CONTENTSPECNODE_ZERO_OR_MORE))
                    (== parentContentSpecType XMLContentSpec/CONTENTSPECNODE_ZERO_OR_ONE))
                (do
                  (.append str \()
                  (.getContentSpec this (aget (cast int/1 (.-value contentSpec)) 0) contentSpec)
                  (.appendContentSpec this contentSpec str true thisContentSpec)
                  (.append str \)))
                (do
                  (.getContentSpec this (aget (cast int/1 (.-value contentSpec)) 0) contentSpec)
                  (.appendContentSpec this contentSpec str true thisContentSpec)))
            (.append str \+))
        (XMLContentSpec/CONTENTSPECNODE_CHOICE XMLContentSpec/CONTENTSPECNODE_SEQ)
          (do
            (when parens (.append str \())
            (let [^int type (.-type contentSpec)
                  otherValue (aget (cast int/1 (.-otherValue contentSpec)) 0)]
              (.getContentSpec this (aget (cast int/1 (.-value contentSpec)) 0) contentSpec)
              (.appendContentSpec this
                                  contentSpec
                                  str
                                  (not (== (.-type contentSpec) type))
                                  thisContentSpec)
              (if (== type XMLContentSpec/CONTENTSPECNODE_CHOICE) (.append str \|) (.append str \,))
              (.getContentSpec this otherValue contentSpec)
              (.appendContentSpec this contentSpec str true thisContentSpec)
              (when parens (.append str \)))))
        XMLContentSpec/CONTENTSPECNODE_ANY
          (do
            (.append str "##any")
            (when (some? (.-otherValue contentSpec))
              (.append str ":uri=")
              (.append str (.-otherValue contentSpec))))
        XMLContentSpec/CONTENTSPECNODE_ANY_OTHER
          (do (.append str "##other:uri=") (.append str (.-otherValue contentSpec)))
        XMLContentSpec/CONTENTSPECNODE_ANY_LOCAL (.append str "##local")
        (.append str "???"))))

  (method ^:private printAttribute ^void [this ^int attributeDeclIndex]
    (let [attributeDecl (XMLAttributeDecl.)]
      (when (.getAttributeDecl this attributeDeclIndex attributeDecl)
        (.print System/out " { ")
        (.print System/out (.-localpart (.-name attributeDecl)))
        (.print System/out " }"))))

  (method ^:private ^:synchronized createChildModel ^ContentModelValidator [this
                                                                            ^int contentSpecIndex]
    (let [contentSpec (XMLContentSpec.)]
      (.getContentSpec this contentSpecIndex contentSpec)
      (when-not (or (or (== (bit-and-int (.-type contentSpec) 0x0f)
                            XMLContentSpec/CONTENTSPECNODE_ANY)
                        (== (bit-and-int (.-type contentSpec) 0x0f)
                            XMLContentSpec/CONTENTSPECNODE_ANY_OTHER))
                    (== (bit-and-int (.-type contentSpec) 0x0f)
                        XMLContentSpec/CONTENTSPECNODE_ANY_LOCAL))
        (cond
          (== (.-type contentSpec) XMLContentSpec/CONTENTSPECNODE_LEAF)
            (do
              (when (and (nil? (.-value contentSpec)) (nil? (.-otherValue contentSpec)))
                (throw (RuntimeException. "ImplementationMessages.VAL_NPCD")))
              (.setValues fQName
                          nil
                          (cast String (.-value contentSpec))
                          (cast String (.-value contentSpec))
                          (cast String (.-otherValue contentSpec)))
              (return (SimpleContentModel. (.-type contentSpec) fQName nil)))
          (or (== (.-type contentSpec) XMLContentSpec/CONTENTSPECNODE_CHOICE)
              (== (.-type contentSpec) XMLContentSpec/CONTENTSPECNODE_SEQ))
            (let [contentSpecLeft (XMLContentSpec.)
                  contentSpecRight (XMLContentSpec.)]
              (.getContentSpec this (aget (cast int/1 (.-value contentSpec)) 0) contentSpecLeft)
              (.getContentSpec this
                               (aget (cast int/1 (.-otherValue contentSpec)) 0)
                               contentSpecRight)
              (when (and (== (.-type contentSpecLeft) XMLContentSpec/CONTENTSPECNODE_LEAF)
                         (== (.-type contentSpecRight) XMLContentSpec/CONTENTSPECNODE_LEAF))
                (.setValues fQName
                            nil
                            (cast String (.-value contentSpecLeft))
                            (cast String (.-value contentSpecLeft))
                            (cast String (.-otherValue contentSpecLeft)))
                (.setValues fQName2
                            nil
                            (cast String (.-value contentSpecRight))
                            (cast String (.-value contentSpecRight))
                            (cast String (.-otherValue contentSpecRight)))
                (return (SimpleContentModel. (.-type contentSpec) fQName fQName2))))
          (or (or (== (.-type contentSpec) XMLContentSpec/CONTENTSPECNODE_ZERO_OR_ONE)
                  (== (.-type contentSpec) XMLContentSpec/CONTENTSPECNODE_ZERO_OR_MORE))
              (== (.-type contentSpec) XMLContentSpec/CONTENTSPECNODE_ONE_OR_MORE))
            (let [contentSpecLeft (XMLContentSpec.)]
              (.getContentSpec this (aget (cast int/1 (.-value contentSpec)) 0) contentSpecLeft)
              (when (== (.-type contentSpecLeft) XMLContentSpec/CONTENTSPECNODE_LEAF)
                (.setValues fQName
                            nil
                            (cast String (.-value contentSpecLeft))
                            (cast String (.-value contentSpecLeft))
                            (cast String (.-otherValue contentSpecLeft)))
                (return (SimpleContentModel. (.-type contentSpec) fQName nil))))
          :else (throw (RuntimeException. "ImplementationMessages.VAL_CST"))))
      (set! fLeafCount 0)
      (set! fLeafCount 0)
      (let [cmn (.buildSyntaxTree this contentSpecIndex contentSpec)]
        (DFAContentModel. cmn fLeafCount false))))

  (method ^:private ^:final buildSyntaxTree ^CMNode [this ^int startNode ^XMLContentSpec contentSpec]
    (let [^:mutable ^CMNode nodeRet nil]
      (.getContentSpec this startNode contentSpec)
      (cond
        (== (bit-and-int (.-type contentSpec) 0x0f) XMLContentSpec/CONTENTSPECNODE_ANY)
          (set! nodeRet
                (CMAny. (.-type contentSpec)
                        (cast String (.-otherValue contentSpec))
                        (let [old-10 fLeafCount]
                          (set! fLeafCount (unchecked-inc-int fLeafCount))
                          old-10)))
        (== (bit-and-int (.-type contentSpec) 0x0f) XMLContentSpec/CONTENTSPECNODE_ANY_OTHER)
          (set! nodeRet
                (CMAny. (.-type contentSpec)
                        (cast String (.-otherValue contentSpec))
                        (let [old-11 fLeafCount]
                          (set! fLeafCount (unchecked-inc-int fLeafCount))
                          old-11)))
        (== (bit-and-int (.-type contentSpec) 0x0f) XMLContentSpec/CONTENTSPECNODE_ANY_LOCAL)
          (set! nodeRet
                (CMAny. (.-type contentSpec)
                        nil
                        (let [old-12 fLeafCount]
                          (set! fLeafCount (unchecked-inc-int fLeafCount))
                          old-12)))
        (== (.-type contentSpec) XMLContentSpec/CONTENTSPECNODE_LEAF)
          (do
            (.setValues fQName
                        nil
                        (cast String (.-value contentSpec))
                        (cast String (.-value contentSpec))
                        (cast String (.-otherValue contentSpec)))
            (set! nodeRet
                  (CMLeaf. fQName
                           (let [old-13 fLeafCount]
                             (set! fLeafCount (unchecked-inc-int fLeafCount))
                             old-13))))
        :else
          (let [leftNode (aget (cast int/1 (.-value contentSpec)) 0)
                rightNode (aget (cast int/1 (.-otherValue contentSpec)) 0)]
            (cond
              (or (== (.-type contentSpec) XMLContentSpec/CONTENTSPECNODE_CHOICE)
                  (== (.-type contentSpec) XMLContentSpec/CONTENTSPECNODE_SEQ))
                (set! nodeRet
                      (CMBinOp. (.-type contentSpec)
                                (.buildSyntaxTree this leftNode contentSpec)
                                (.buildSyntaxTree this rightNode contentSpec)))
              (== (.-type contentSpec) XMLContentSpec/CONTENTSPECNODE_ZERO_OR_MORE)
                (set! nodeRet
                      (CMUniOp. (.-type contentSpec) (.buildSyntaxTree this leftNode contentSpec)))
              (or (or (== (.-type contentSpec) XMLContentSpec/CONTENTSPECNODE_ZERO_OR_MORE)
                      (== (.-type contentSpec) XMLContentSpec/CONTENTSPECNODE_ZERO_OR_ONE))
                  (== (.-type contentSpec) XMLContentSpec/CONTENTSPECNODE_ONE_OR_MORE))
                (set! nodeRet
                      (CMUniOp. (.-type contentSpec) (.buildSyntaxTree this leftNode contentSpec)))
              :else (throw (RuntimeException. "ImplementationMessages.VAL_CST")))))
      nodeRet))

  (method ^:private contentSpecTree ^void [this ^int contentSpecIndex ^XMLContentSpec contentSpec
                                           ^ChildrenList children]
    (.getContentSpec this contentSpecIndex contentSpec)
    (if (or (or (or (== (.-type contentSpec) XMLContentSpec/CONTENTSPECNODE_LEAF)
                    (== (bit-and-int (.-type contentSpec) 0x0f) XMLContentSpec/CONTENTSPECNODE_ANY))
                (== (bit-and-int (.-type contentSpec) 0x0f)
                    XMLContentSpec/CONTENTSPECNODE_ANY_LOCAL))
            (== (bit-and-int (.-type contentSpec) 0x0f) XMLContentSpec/CONTENTSPECNODE_ANY_OTHER))
        (do
          (when (== (.-length children) (alength (.-qname children)))
            (let [newQName (new QName/1 (unchecked-multiply-int (.-length children) 2))]
              (System/arraycopy (.-qname children) 0 newQName 0 (.-length children))
              (set! (.-qname children) newQName)
              (let [newType (new int/1 (unchecked-multiply-int (.-length children) 2))]
                (System/arraycopy (.-type children) 0 newType 0 (.-length children))
                (set! (.-type children) newType))))
          (aset (.-qname children)
                (.-length children)
                (QName. nil
                        (cast String (.-value contentSpec))
                        (cast String (.-value contentSpec))
                        (cast String (.-otherValue contentSpec))))
          (aset (.-type children) (.-length children) (.-type contentSpec))
          (set! (.-length children) (unchecked-inc-int (.-length children))))
        (let [^int leftNode (if (some? (.-value contentSpec))
                                (aget (cast int/1 (.-value contentSpec)) 0)
                                -1)
              ^:mutable ^int rightNode -1]
          (when (some? (.-otherValue contentSpec))
            (set! rightNode (aget (cast int/1 (.-otherValue contentSpec)) 0))
            (cond
              (or (== (.-type contentSpec) XMLContentSpec/CONTENTSPECNODE_CHOICE)
                  (== (.-type contentSpec) XMLContentSpec/CONTENTSPECNODE_SEQ))
                (do
                  (.contentSpecTree this leftNode contentSpec children)
                  (.contentSpecTree this rightNode contentSpec children))
              (or (or (== (.-type contentSpec) XMLContentSpec/CONTENTSPECNODE_ZERO_OR_ONE)
                      (== (.-type contentSpec) XMLContentSpec/CONTENTSPECNODE_ZERO_OR_MORE))
                  (== (.-type contentSpec) XMLContentSpec/CONTENTSPECNODE_ONE_OR_MORE))
                (.contentSpecTree this leftNode contentSpec children)
              :else
                (throw
                  (RuntimeException.
                    (java-str
                      "Invalid content spec type seen in contentSpecTree() method of AbstractDTDGrammar class : "
                      (.-type contentSpec)))))))))

  (method ^:private ensureElementDeclCapacity ^void [this ^int chunk]
    (cond
      (>= chunk (alength fElementDeclName))
        (do
          (set! fElementDeclIsExternal
                (DTDGrammar/resize fElementDeclIsExternal
                                   (unchecked-multiply-int (alength fElementDeclIsExternal) 2)))
          (set! fElementDeclName
                (DTDGrammar/resize fElementDeclName
                                   (unchecked-multiply-int (alength fElementDeclName) 2)))
          (set! fElementDeclType
                (DTDGrammar/resize fElementDeclType
                                   (unchecked-multiply-int (alength fElementDeclType) 2)))
          (set! fElementDeclContentModelValidator
                (DTDGrammar/resize fElementDeclContentModelValidator
                                   (unchecked-multiply-int
                                     (alength fElementDeclContentModelValidator)
                                     2)))
          (set! fElementDeclContentSpecIndex
                (DTDGrammar/resize
                  fElementDeclContentSpecIndex
                  (unchecked-multiply-int (alength fElementDeclContentSpecIndex) 2)))
          (set! fElementDeclFirstAttributeDeclIndex
                (DTDGrammar/resize fElementDeclFirstAttributeDeclIndex
                                   (unchecked-multiply-int
                                     (alength fElementDeclFirstAttributeDeclIndex)
                                     2)))
          (set! fElementDeclLastAttributeDeclIndex
                (DTDGrammar/resize fElementDeclLastAttributeDeclIndex
                                   (unchecked-multiply-int
                                     (alength fElementDeclLastAttributeDeclIndex)
                                     2))))
      (some? (aget fElementDeclName chunk)) (return))
    (aset fElementDeclIsExternal chunk (new int/1 CHUNK_SIZE))
    (aset fElementDeclName chunk (new QName/1 CHUNK_SIZE))
    (aset fElementDeclType chunk (new short/1 CHUNK_SIZE))
    (aset fElementDeclContentModelValidator chunk (new ContentModelValidator/1 CHUNK_SIZE))
    (aset fElementDeclContentSpecIndex chunk (new int/1 CHUNK_SIZE))
    (aset fElementDeclFirstAttributeDeclIndex chunk (new int/1 CHUNK_SIZE))
    (aset fElementDeclLastAttributeDeclIndex chunk (new int/1 CHUNK_SIZE)))

  (method ^:private ensureAttributeDeclCapacity ^void [this ^int chunk]
    (cond
      (>= chunk (alength fAttributeDeclName))
        (do
          (set! fAttributeDeclIsExternal

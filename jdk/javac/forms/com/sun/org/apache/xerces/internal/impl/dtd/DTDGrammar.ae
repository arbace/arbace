              (set! (.-list fSimpleType) true))
          (.equals type "ENTITY") (set! (.-type fSimpleType) XMLSimpleType/TYPE_ENTITY)
          (.equals type "NMTOKENS")
            (do
              (set! (.-type fSimpleType) XMLSimpleType/TYPE_NMTOKEN)
              (set! (.-list fSimpleType) true))
          (.equals type "NMTOKEN") (set! (.-type fSimpleType) XMLSimpleType/TYPE_NMTOKEN)
          (.startsWith type "NOTATION") (set! (.-type fSimpleType) XMLSimpleType/TYPE_NOTATION)

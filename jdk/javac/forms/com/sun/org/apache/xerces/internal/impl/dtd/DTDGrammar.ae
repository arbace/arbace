  (defclass ^:private ^:static ChildrenList
    (field ^:public ^int length 0)

    (field ^:public ^QName/1 qname (new QName/1 2))

    (field ^:public ^int/1 type (new int/1 2))

    (constructor ^:public [this]))

  (method ^:public isEntityDeclared ^boolean [this ^String name]
    (if (not (== (.getEntityDeclIndex this name) -1)) true false))

  (method ^:public isEntityUnparsed ^boolean [this ^String name]
    (let [entityIndex (.getEntityDeclIndex this name)]
      (if (> entityIndex -1)
          (let [chunk (bit-shift-right-int entityIndex CHUNK_SHIFT)
                index (bit-and-int entityIndex CHUNK_MASK)]
            (if (some? (aget fEntityNotation chunk index)) true false))
          false))))

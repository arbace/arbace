          (set! fAttributeDeclNonNormalizedDefaultValue
                (DTDGrammar/resize fAttributeDeclNonNormalizedDefaultValue
                                   (unchecked-multiply-int
                                     (alength fAttributeDeclNonNormalizedDefaultValue)
                                     2)))
          (set! fAttributeDeclNextAttributeDeclIndex
                (DTDGrammar/resize fAttributeDeclNextAttributeDeclIndex
                                   (unchecked-multiply-int
                                     (alength fAttributeDeclNextAttributeDeclIndex)
                                     2))))
      (some? (aget fAttributeDeclName chunk)) (return))
    (aset fAttributeDeclIsExternal chunk (new int/1 CHUNK_SIZE))
    (aset fAttributeDeclName chunk (new QName/1 CHUNK_SIZE))
    (aset fAttributeDeclType chunk (new short/1 CHUNK_SIZE))
    (aset fAttributeDeclEnumeration chunk (new String/2 CHUNK_SIZE))
    (aset fAttributeDeclDefaultType chunk (new short/1 CHUNK_SIZE))
    (aset fAttributeDeclDatatypeValidator chunk (new DatatypeValidator/1 CHUNK_SIZE))
    (aset fAttributeDeclDefaultValue chunk (new String/1 CHUNK_SIZE))
    (aset fAttributeDeclNonNormalizedDefaultValue chunk (new String/1 CHUNK_SIZE))
    (aset fAttributeDeclNextAttributeDeclIndex chunk (new int/1 CHUNK_SIZE)))

  (method ^:private ensureEntityDeclCapacity ^void [this ^int chunk]

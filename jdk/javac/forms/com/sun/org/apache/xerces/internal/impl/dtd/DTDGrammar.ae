          (set! fAttributeDeclDefaultType
                (DTDGrammar/resize fAttributeDeclDefaultType
                                   (unchecked-multiply-int (alength fAttributeDeclDefaultType) 2)))
          (set! fAttributeDeclDatatypeValidator
                (DTDGrammar/resize fAttributeDeclDatatypeValidator
                                   (unchecked-multiply-int
                                     (alength fAttributeDeclDatatypeValidator)
                                     2)))
          (set! fAttributeDeclDefaultValue

  (method ^:private calcFollowList ^void [this ^CMNode nodeCur]
    (cond
      (== (.type nodeCur) XSModelGroupImpl/MODELGROUP_CHOICE)
        (do
          (.calcFollowList this (.getLeft (cast XSCMBinOp nodeCur)))
          (.calcFollowList this (.getRight (cast XSCMBinOp nodeCur))))
      (== (.type nodeCur) XSModelGroupImpl/MODELGROUP_SEQUENCE)
        (do
          (.calcFollowList this (.getLeft (cast XSCMBinOp nodeCur)))
          (.calcFollowList this (.getRight (cast XSCMBinOp nodeCur)))
          (let [^:final last (.lastPos (.getLeft (cast XSCMBinOp nodeCur)))
                ^:final first (.firstPos (.getRight (cast XSCMBinOp nodeCur)))]
            (loop [^int index 0]
              (if (< index fLeafCount)
                  (if (.getBit last index)
                      (do (.union (aget fFollowList index) first) (recur (unchecked-inc-int index)))
                      (recur (unchecked-inc-int index)))
                  nil))))
      (or (== (.type nodeCur) XSParticleDecl/PARTICLE_ZERO_OR_MORE)
          (== (.type nodeCur) XSParticleDecl/PARTICLE_ONE_OR_MORE))
        (do
          (.calcFollowList this (.getChild (cast XSCMUniOp nodeCur)))
          (let [^:final first (.firstPos nodeCur)
                ^:final last (.lastPos nodeCur)]
            (loop [^int index 0]
              (if (< index fLeafCount)
                  (if (.getBit last index)
                      (do (.union (aget fFollowList index) first) (recur (unchecked-inc-int index)))
                      (recur (unchecked-inc-int index)))
                  nil))))
      (== (.type nodeCur) XSParticleDecl/PARTICLE_ZERO_OR_ONE)
        (.calcFollowList this (.getChild (cast XSCMUniOp nodeCur)))))

  (method ^:private dumpTree ^void [this ^CMNode nodeCur ^int level]
    (loop [^int index 0]
      (when (< index level) (.print System/out "   ") (recur (unchecked-inc-int index))))
    (let [type (.type nodeCur)]
      (switch type
        (XSModelGroupImpl/MODELGROUP_CHOICE XSModelGroupImpl/MODELGROUP_SEQUENCE)
          (do
            (if (== type XSModelGroupImpl/MODELGROUP_CHOICE)
                (.print System/out "Choice Node ")
                (.print System/out "Seq Node "))
            (when (.isNullable nodeCur) (.print System/out "Nullable "))
            (.print System/out "firstPos=")
            (.print System/out (.toString (.firstPos nodeCur)))
            (.print System/out " lastPos=")
            (.println System/out (.toString (.lastPos nodeCur)))
            (.dumpTree this (.getLeft (cast XSCMBinOp nodeCur)) (unchecked-add-int level 1))
            (.dumpTree this (.getRight (cast XSCMBinOp nodeCur)) (unchecked-add-int level 1)))
        (XSParticleDecl/PARTICLE_ZERO_OR_MORE XSParticleDecl/PARTICLE_ONE_OR_MORE
                                              XSParticleDecl/PARTICLE_ZERO_OR_ONE)
          (do
            (.print System/out "Rep Node ")
            (when (.isNullable nodeCur) (.print System/out "Nullable "))
            (.print System/out "firstPos=")
            (.print System/out (.toString (.firstPos nodeCur)))
            (.print System/out " lastPos=")
            (.println System/out (.toString (.lastPos nodeCur)))
            (.dumpTree this (.getChild (cast XSCMUniOp nodeCur)) (unchecked-add-int level 1)))
        XSParticleDecl/PARTICLE_ELEMENT
          (do
            (.print System/out
                    (java-str "Leaf: (pos="
                              (.getPosition (cast XSCMLeaf nodeCur))
                              "), (elemIndex="
                              (.getLeaf (cast XSCMLeaf nodeCur))
                              ") "))
            (when (.isNullable nodeCur) (.print System/out " Nullable "))
            (.print System/out "firstPos=")
            (.print System/out (.toString (.firstPos nodeCur)))
            (.print System/out " lastPos=")
            (.println System/out (.toString (.lastPos nodeCur))))
        XSParticleDecl/PARTICLE_WILDCARD
          (do
            (.print System/out "Any Node: ")
            (.print System/out "firstPos=")
            (.print System/out (.toString (.firstPos nodeCur)))
            (.print System/out " lastPos=")
            (.println System/out (.toString (.lastPos nodeCur))))
        (throw (RuntimeException. "ImplementationMessages.VAL_NIICM")))))

  (method ^:private makeDefStateList ^int/1 [this]
    (let [retArray (new int/1 fElemMapSize)]
      (loop [^int index 0]
        (when (< index fElemMapSize) (aset retArray index -1) (recur (unchecked-inc-int index))))
      retArray))

  (method ^:private postTreeBuildInit :throws [RuntimeException] ^void [this ^CMNode nodeCur]
    (.setMaxStates nodeCur fLeafCount)
    (let [^:mutable ^XSCMLeaf leaf nil
          ^:mutable ^int pos 0]
      (cond
        (== (.type nodeCur) XSParticleDecl/PARTICLE_WILDCARD)
          (do
            (set! leaf (cast XSCMLeaf nodeCur))
            (set! pos (.getPosition leaf))
            (aset fLeafList pos leaf)
            (aset fLeafListType pos XSParticleDecl/PARTICLE_WILDCARD))
        (or (== (.type nodeCur) XSModelGroupImpl/MODELGROUP_CHOICE)
            (== (.type nodeCur) XSModelGroupImpl/MODELGROUP_SEQUENCE))
          (do
            (.postTreeBuildInit this (.getLeft (cast XSCMBinOp nodeCur)))
            (.postTreeBuildInit this (.getRight (cast XSCMBinOp nodeCur))))
        (or (or (== (.type nodeCur) XSParticleDecl/PARTICLE_ZERO_OR_MORE)
                (== (.type nodeCur) XSParticleDecl/PARTICLE_ONE_OR_MORE))
            (== (.type nodeCur) XSParticleDecl/PARTICLE_ZERO_OR_ONE))
          (.postTreeBuildInit this (.getChild (cast XSCMUniOp nodeCur)))
        (== (.type nodeCur) XSParticleDecl/PARTICLE_ELEMENT)
          (do
            (set! leaf (cast XSCMLeaf nodeCur))
            (set! pos (.getPosition leaf))
            (aset fLeafList pos leaf)
            (aset fLeafListType pos XSParticleDecl/PARTICLE_ELEMENT))
        :else (throw (RuntimeException. "ImplementationMessages.VAL_NIICM")))))

  (method ^:public checkUniqueParticleAttribution :throws [XMLSchemaException] ^boolean [this
                                                                                         ^SubstitutionGroupHandler subGroupHandler]
    (let [conflictTable (new byte/2 fElemMapSize fElemMapSize)]
      (loop [^int i 0]

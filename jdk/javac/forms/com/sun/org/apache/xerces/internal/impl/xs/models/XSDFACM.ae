            (if (< j fElemMapSize)
                (if (== (aget conflictTable i j) 1)
                    (throw (XMLSchemaException. "cos-nonambig"
                                                (new
                                                  Object/1
                                                  [(.toString (aget fElemMap i))
                                                   (.toString (aget fElemMap j))])))
                    (recur (unchecked-inc-int j)))
                nil))
          (recur (unchecked-inc-int i))))
      (loop [^int i 0]
        (if (< i fElemMapSize)
            (if (== (aget fElemMapType i) XSParticleDecl/PARTICLE_WILDCARD)
                (let [wildcard (cast XSWildcardDecl (aget fElemMap i))]
                  (if (or (== (.-fType wildcard) XSWildcardDecl/NSCONSTRAINT_LIST)
                          (== (.-fType wildcard) XSWildcardDecl/NSCONSTRAINT_NOT))
                      (return true)
                      (recur (unchecked-inc-int i))))
                (recur (unchecked-inc-int i)))
            nil))
      false))

  (method ^:public whatCanGoHere ^{:tag (List Object)} [this ^int/1 state]
    (let [^:mutable curState (aget state 0)]
      (when (< curState 0) (set! curState (aget state 1)))
      (let [^Occurence o (when (some? fCountingStates) (aget fCountingStates curState))
            count (aget state 2)
            ^{:tag (List Object)} ret (ArrayList.)]
        (loop [^int elemIndex 0]
          (when (< elemIndex fElemMapSize)
            (let [nextState (aget fTransTable curState elemIndex)]
              (if (not (== nextState -1))
                  (do
                    (when (some? o)
                      (cond
                        (== curState nextState)
                          (when (and (>= count (.-maxOccurs o))
                                     (not (== (.-maxOccurs o) SchemaSymbols/OCCURRENCE_UNBOUNDED)))
                            (continue (unchecked-inc-int elemIndex)))
                        (< count (.-minOccurs o)) (continue (unchecked-inc-int elemIndex))))
                    (.add ret (aget fElemMap elemIndex))
                    (recur (unchecked-inc-int elemIndex)))
                  (recur (unchecked-inc-int elemIndex))))))
        ret)))

  (method ^:public checkMinMaxBounds ^{:tag (List String)} [this]
    (let [^:mutable ^{:tag (List String)} result nil]
      (loop [^int elemIndex 0]
        (when (< elemIndex fElemMapSize)
          (let [count (aget fElemMapCounter elemIndex)]
            (if (== count -1)
                (recur (unchecked-inc-int elemIndex))
                (let [^:final minOccurs (aget fElemMapCounterLowerBound elemIndex)
                      ^:final maxOccurs (aget fElemMapCounterUpperBound elemIndex)]
                  (when (< count minOccurs)
                    (when (nil? result) (set! result (ArrayList.)))
                    (.add result "cvc-complex-type.2.4.b")
                    (.add result (java-str "{" (aget fElemMap elemIndex) "}")))
                  (if (and (not (== maxOccurs -1)) (> count maxOccurs))
                      (do
                        (when (nil? result) (set! result (ArrayList.)))
                        (.add result "cvc-complex-type.2.4.d.1")
                        (.add result (java-str "{" (aget fElemMap elemIndex) "}"))
                        (recur (unchecked-inc-int elemIndex)))
                      (recur (unchecked-inc-int elemIndex))))))))
      result))

  (method ^:public occurenceInfo ^int/1 [this ^int/1 state]
    (when (some? fCountingStates)
      (let [^:mutable curState (aget state 0)]
        (when (< curState 0) (set! curState (aget state 1)))
        (let [o (aget fCountingStates curState)]
          (when (some? o)
            (let [occurenceInfo (new int/1 4)]
              (aset occurenceInfo 0 (.-minOccurs o))
              (aset occurenceInfo 1 (.-maxOccurs o))
              (aset occurenceInfo 2 (aget state 2))
              (aset occurenceInfo 3 (.-elemIndex o))
              (return occurenceInfo))))))
    nil)

  (method ^:public getTermName ^String [this ^int termId]
    (let [term (aget fElemMap termId)] (when (some? term) (.toString term))))

  (method ^:public isCompactedForUPA ^boolean [this] fIsCompactedForUPA))

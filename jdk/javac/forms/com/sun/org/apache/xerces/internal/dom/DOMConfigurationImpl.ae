        (if (not (== (bit-and-int features DTNORMALIZATION) 0)) Boolean/TRUE Boolean/FALSE)
      (.equalsIgnoreCase name Constants/DOM_CDATA_SECTIONS)
        (if (not (== (bit-and-int features CDATA) 0)) Boolean/TRUE Boolean/FALSE)
      (.equalsIgnoreCase name Constants/DOM_ENTITIES)
        (if (not (== (bit-and-int features ENTITIES) 0)) Boolean/TRUE Boolean/FALSE)
      (.equalsIgnoreCase name Constants/DOM_SPLIT_CDATA)
        (if (not (== (bit-and-int features SPLITCDATA) 0)) Boolean/TRUE Boolean/FALSE)
      (.equalsIgnoreCase name Constants/DOM_VALIDATE)
        (if (not (== (bit-and-int features VALIDATE) 0)) Boolean/TRUE Boolean/FALSE)
      (.equalsIgnoreCase name Constants/DOM_WELLFORMED)
        (if (not (== (bit-and-int features WELLFORMED) 0)) Boolean/TRUE Boolean/FALSE)
      (.equalsIgnoreCase name Constants/DOM_NAMESPACE_DECLARATIONS)
        (if (not (== (bit-and-int features NSDECL) 0)) Boolean/TRUE Boolean/FALSE)
      (.equalsIgnoreCase name Constants/DOM_INFOSET)
        (if (== (bit-and-int features INFOSET_MASK) INFOSET_TRUE_PARAMS) Boolean/TRUE Boolean/FALSE)
      (or (or (or (.equalsIgnoreCase name Constants/DOM_NORMALIZE_CHARACTERS)
                  (.equalsIgnoreCase name Constants/DOM_CANONICAL_FORM))
              (.equalsIgnoreCase name Constants/DOM_VALIDATE_IF_SCHEMA))
          (.equalsIgnoreCase name Constants/DOM_CHECK_CHAR_NORMALIZATION))
        Boolean/FALSE
      (.equalsIgnoreCase name SEND_PSVI) Boolean/TRUE
      (.equalsIgnoreCase name Constants/DOM_PSVI)
        (if (not (== (bit-and-int features PSVI) 0)) Boolean/TRUE Boolean/FALSE)
      (.equalsIgnoreCase name Constants/DOM_ELEMENT_CONTENT_WHITESPACE) Boolean/TRUE
      (.equalsIgnoreCase name Constants/DOM_ERROR_HANDLER) (.getErrorHandler fErrorHandlerWrapper)
      (.equalsIgnoreCase name Constants/DOM_RESOURCE_RESOLVER)
        (let [entityResolver (.getEntityResolver this)]
          (when (and (some? entityResolver) (instance? DOMEntityResolverWrapper entityResolver))
            (.getEntityResolver (cast DOMEntityResolverWrapper entityResolver))))
      (.equalsIgnoreCase name Constants/DOM_SCHEMA_TYPE)
        (.getProperty this (java-str Constants/JAXP_PROPERTY_PREFIX Constants/SCHEMA_LANGUAGE))
      (.equalsIgnoreCase name Constants/DOM_SCHEMA_LOCATION) fSchemaLocation
      (.equalsIgnoreCase name ENTITY_RESOLVER) (.getEntityResolver this)
      (.equalsIgnoreCase name SYMBOL_TABLE) (.getProperty this SYMBOL_TABLE)
      (.equalsIgnoreCase name GRAMMAR_POOL) (.getProperty this GRAMMAR_POOL)
      (.equalsIgnoreCase name SECURITY_MANAGER) (.getProperty this SECURITY_MANAGER)
      :else (throw (DOMConfigurationImpl/newFeatureNotFoundError name))))

  (method ^:public canSetParameter ^boolean [this ^String name value]
    (cond
      (nil? value) true
      (instance? Boolean value)
        (cond
          (or (or (or (or (or (or (or (or (or (.equalsIgnoreCase name Constants/DOM_COMMENTS)
                                              (.equalsIgnoreCase
                                                name
                                                Constants/DOM_DATATYPE_NORMALIZATION))
                                          (.equalsIgnoreCase name Constants/DOM_CDATA_SECTIONS))
                                      (.equalsIgnoreCase name Constants/DOM_ENTITIES))
                                  (.equalsIgnoreCase name Constants/DOM_SPLIT_CDATA))
                              (.equalsIgnoreCase name Constants/DOM_NAMESPACES))
                          (.equalsIgnoreCase name Constants/DOM_VALIDATE))
                      (.equalsIgnoreCase name Constants/DOM_WELLFORMED))
                  (.equalsIgnoreCase name Constants/DOM_INFOSET))
              (.equalsIgnoreCase name Constants/DOM_NAMESPACE_DECLARATIONS))
            true
          (or (or (or (.equalsIgnoreCase name Constants/DOM_NORMALIZE_CHARACTERS)
                      (.equalsIgnoreCase name Constants/DOM_CANONICAL_FORM))
                  (.equalsIgnoreCase name Constants/DOM_VALIDATE_IF_SCHEMA))
              (.equalsIgnoreCase name Constants/DOM_CHECK_CHAR_NORMALIZATION))
            (if (.equals value Boolean/TRUE) false true)
          (or (.equalsIgnoreCase name Constants/DOM_ELEMENT_CONTENT_WHITESPACE)
              (.equalsIgnoreCase name SEND_PSVI))
            (if (.equals value Boolean/TRUE) true false)
          :else false)
      (.equalsIgnoreCase name Constants/DOM_ERROR_HANDLER)
        (if (instance? DOMErrorHandler value) true false)
      (.equalsIgnoreCase name Constants/DOM_RESOURCE_RESOLVER)
        (if (instance? LSResourceResolver value) true false)
      (.equalsIgnoreCase name Constants/DOM_SCHEMA_LOCATION)
        (if (instance? String value) true false)
      (.equalsIgnoreCase name Constants/DOM_SCHEMA_TYPE)
        (if (and (instance? String value)
                 (or (.equals value Constants/NS_XMLSCHEMA) (.equals value Constants/NS_DTD)))
            true
            false)
      (.equalsIgnoreCase name ENTITY_RESOLVER) (if (instance? XMLEntityResolver value) true false)
      (.equalsIgnoreCase name SYMBOL_TABLE) (if (instance? SymbolTable value) true false)
      (.equalsIgnoreCase name GRAMMAR_POOL) (if (instance? XMLGrammarPool value) true false)
      :else false))

  (method ^:public getParameterNames ^DOMStringList [this]
    (when (nil? fRecognizedParameters)
      (let [^{:tag (List String)} parameters (ArrayList.)]
        (.add parameters Constants/DOM_COMMENTS)
        (.add parameters Constants/DOM_DATATYPE_NORMALIZATION)
        (.add parameters Constants/DOM_CDATA_SECTIONS)
        (.add parameters Constants/DOM_ENTITIES)
        (.add parameters Constants/DOM_SPLIT_CDATA)
        (.add parameters Constants/DOM_NAMESPACES)
        (.add parameters Constants/DOM_VALIDATE)
        (.add parameters Constants/DOM_INFOSET)
        (.add parameters Constants/DOM_NORMALIZE_CHARACTERS)
        (.add parameters Constants/DOM_CANONICAL_FORM)
        (.add parameters Constants/DOM_VALIDATE_IF_SCHEMA)
        (.add parameters Constants/DOM_CHECK_CHAR_NORMALIZATION)
        (.add parameters Constants/DOM_WELLFORMED)
        (.add parameters Constants/DOM_NAMESPACE_DECLARATIONS)
        (.add parameters Constants/DOM_ELEMENT_CONTENT_WHITESPACE)
        (.add parameters Constants/DOM_ERROR_HANDLER)
        (.add parameters Constants/DOM_SCHEMA_TYPE)
        (.add parameters Constants/DOM_SCHEMA_LOCATION)
        (.add parameters Constants/DOM_RESOURCE_RESOLVER)
        (.add parameters ENTITY_RESOLVER)
        (.add parameters GRAMMAR_POOL)
        (.add parameters SECURITY_MANAGER)
        (.add parameters SYMBOL_TABLE)
        (.add parameters SEND_PSVI)
        (set! fRecognizedParameters (DOMStringListImpl. parameters))))
    fRecognizedParameters)

  (method ^:protected reset :throws [XNIException] ^void [this]
    (when (some? fValidationManager) (.reset fValidationManager))
    (let [count (.size fComponents)]
      (loop [^int i 0]
        (when (< i count)
          (let [c (cast XMLComponent (.get fComponents i))]
            (.reset c this)
            (recur (unchecked-inc-int i)))))))

  (method ^:protected checkProperty :throws [XMLConfigurationException] ^PropertyState [this
                                                                                        ^String propertyId]
    (when (.startsWith propertyId Constants/SAX_PROPERTY_PREFIX)
      (let [^:final suffixLength (unchecked-subtract-int
                                   (.length propertyId)
                                   (.length Constants/SAX_PROPERTY_PREFIX))]
        (when (and (== suffixLength (.length Constants/XML_STRING_PROPERTY))
                   (.endsWith propertyId Constants/XML_STRING_PROPERTY))
          (return PropertyState/NOT_SUPPORTED))))
    (.checkProperty super propertyId))

  (method ^:protected addComponent ^void [this ^XMLComponent component]
    (when-not (.contains fComponents component)
      (.add fComponents component)
      (let [recognizedFeatures (.getRecognizedFeatures component)]
        (.addRecognizedFeatures this recognizedFeatures)
        (let [recognizedProperties (.getRecognizedProperties component)]
          (.addRecognizedProperties this recognizedProperties)))))

  (method ^:protected createValidationManager ^ValidationManager [this]
    (ValidationManager.))

  (method ^:protected ^:final setDTDValidatorFactory ^void [this ^String version]
    (if (.equals "1.1" version)
        (when-not (identical? fCurrentDVFactory fXML11DatatypeFactory)
          (set! fCurrentDVFactory fXML11DatatypeFactory)
          (.setProperty this DTD_VALIDATOR_FACTORY_PROPERTY fCurrentDVFactory))
        (when-not (identical? fCurrentDVFactory fDatatypeValidatorFactory)
          (set! fCurrentDVFactory fDatatypeValidatorFactory)
          (.setProperty this DTD_VALIDATOR_FACTORY_PROPERTY fCurrentDVFactory))))

  (method ^:private ^:static newFeatureNotSupportedError ^DOMException [^String name]
    (let [msg (DOMMessageFormatter/formatMessage
                DOMMessageFormatter/DOM_DOMAIN
                "FEATURE_NOT_SUPPORTED"
                (new Object/1 [name]))]
      (DOMException. DOMException/NOT_SUPPORTED_ERR msg)))

  (method ^:private ^:static newFeatureNotFoundError ^DOMException [^String name]
    (let [msg (DOMMessageFormatter/formatMessage
                DOMMessageFormatter/DOM_DOMAIN
                "FEATURE_NOT_FOUND"
                (new Object/1 [name]))]
      (DOMException. DOMException/NOT_FOUND_ERR msg)))

  (method ^:private ^:static newTypeMismatchError ^DOMException [^String name]
    (let [msg (DOMMessageFormatter/formatMessage
                DOMMessageFormatter/DOM_DOMAIN
                "TYPE_MISMATCH_ERR"
                (new Object/1 [name]))]
      (DOMException. DOMException/TYPE_MISMATCH_ERR msg))))

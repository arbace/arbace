  (method ^:public createTypeRestriction ^XSSimpleType [this ^String name ^String targetNamespace
                                                        ^short finalSet ^XSSimpleType base
                                                        ^XSObjectList annotations]
    (if (some? fDeclPool)
        (let [st (.getSimpleTypeDecl fDeclPool)]
          (.setRestrictionValues st
                                 (cast XSSimpleTypeDecl base)
                                 name
                                 targetNamespace
                                 finalSet
                                 annotations))
        (XSSimpleTypeDecl. (cast XSSimpleTypeDecl base)
                           name
                           targetNamespace
                           finalSet
                           false
                           annotations)))

  (method ^:public createTypeList ^XSSimpleType [this ^String name ^String targetNamespace
                                                 ^short finalSet ^XSSimpleType itemType
                                                 ^XSObjectList annotations]
    (if (some? fDeclPool)
        (let [st (.getSimpleTypeDecl fDeclPool)]
          (.setListValues st
                          name
                          targetNamespace
                          finalSet
                          (cast XSSimpleTypeDecl itemType)
                          annotations))
        (XSSimpleTypeDecl. name
                           targetNamespace
                           finalSet
                           (cast XSSimpleTypeDecl itemType)
                           false
                           annotations)))

  (method ^:public createTypeUnion ^XSSimpleType [this ^String name ^String targetNamespace
                                                  ^short finalSet ^XSSimpleType/1 memberTypes
                                                  ^XSObjectList annotations]
    (let [typeNum (alength memberTypes)
          mtypes (new XSSimpleTypeDecl/1 typeNum)]
      (System/arraycopy memberTypes 0 mtypes 0 typeNum)
      (if (some? fDeclPool)
          (let [st (.getSimpleTypeDecl fDeclPool)]
            (.setUnionValues st name targetNamespace finalSet mtypes annotations))
          (XSSimpleTypeDecl. name targetNamespace finalSet mtypes annotations))))

  (method ^:public setDeclPool ^void [this ^XSDeclarationPool declPool]
    (set! fDeclPool declPool))

  (method ^:public newXSSimpleTypeDecl ^XSSimpleTypeDecl [this]
    (XSSimpleTypeDecl.)))

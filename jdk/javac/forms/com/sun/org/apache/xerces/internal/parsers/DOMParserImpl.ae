        (.add parameters Constants/DOM_CANONICAL_FORM)
        (.add parameters Constants/DOM_NAMESPACE_DECLARATIONS)
        (.add parameters Constants/DOM_SPLIT_CDATA)
        (.add parameters Constants/DOM_ENTITIES)
        (.add parameters Constants/DOM_VALIDATE_IF_SCHEMA)
        (.add parameters Constants/DOM_VALIDATE)
        (.add parameters Constants/DOM_DATATYPE_NORMALIZATION)
        (.add parameters Constants/DOM_CHARSET_OVERRIDES_XML_ENCODING)
        (.add parameters Constants/DOM_CHECK_CHAR_NORMALIZATION)
        (.add parameters Constants/DOM_SUPPORTED_MEDIATYPES_ONLY)
        (.add parameters Constants/DOM_IGNORE_UNKNOWN_CHARACTER_DENORMALIZATIONS)
        (.add parameters Constants/DOM_NORMALIZE_CHARACTERS)
        (.add parameters Constants/DOM_WELLFORMED)
        (.add parameters Constants/DOM_INFOSET)
        (.add parameters Constants/DOM_DISALLOW_DOCTYPE)
        (.add parameters Constants/DOM_ELEMENT_CONTENT_WHITESPACE)
        (.add parameters Constants/DOM_COMMENTS)
        (.add parameters Constants/DOM_ERROR_HANDLER)
        (.add parameters Constants/DOM_RESOURCE_RESOLVER)
        (.add parameters Constants/DOM_SCHEMA_LOCATION)
        (.add parameters Constants/DOM_SCHEMA_TYPE)
        (set! fRecognizedParameters (DOMStringListImpl. parameters))))
    fRecognizedParameters)

  (method ^:public parseURI :throws [LSException] ^Document [this ^String uri]
    (when fBusy
      (let [msg (DOMMessageFormatter/formatMessage
                  DOMMessageFormatter/DOM_DOMAIN
                  "INVALID_STATE_ERR"
                  nil)]
        (throw (DOMException. DOMException/INVALID_STATE_ERR msg))))
    (let [source (XMLInputSource. nil uri nil false)]
      (try
        (set! currentThread (Thread/currentThread))
        (set! fBusy true)
        (.parse this source)
        (set! fBusy false)
        (when (and abortNow (.isInterrupted currentThread))
          (set! abortNow false)
          (Thread/interrupted))
        (catch Exception e
          (set! fBusy false)
          (when (and abortNow (.isInterrupted currentThread)) (Thread/interrupted))
          (when abortNow (set! abortNow false) (.restoreHandlers this) (return nil))
          (when-not (identical? e AbstractDOMParser$Abort/INSTANCE)
            (when (and (not (instance? XMLParseException e)) (some? (.-fErrorHandler this)))
              (let [error (DOMErrorImpl.)]
                (set! (.-fException error) e)
                (set! (.-fMessage error) (.getMessage e))
                (set! (.-fSeverity error) DOMError/SEVERITY_FATAL_ERROR)
                (.handleError (.getErrorHandler (.-fErrorHandler this)) error)))
            (when DEBUG (.printStackTrace e))
            (throw (cast LSException
                         (.fillInStackTrace (DOMUtil/createLSException LSException/PARSE_ERR e)))))))
      (let [doc (.getDocument this)] (.dropDocumentReferences this) doc)))

  (method ^:public parse :throws [LSException] ^Document [this ^LSInput is]
    (let [xmlInputSource (.dom2xmlInputSource this is)]
      (when fBusy
        (let [msg (DOMMessageFormatter/formatMessage
                    DOMMessageFormatter/DOM_DOMAIN
                    "INVALID_STATE_ERR"
                    nil)]
          (throw (DOMException. DOMException/INVALID_STATE_ERR msg))))
      (try
        (set! currentThread (Thread/currentThread))
        (set! fBusy true)
        (.parse this xmlInputSource)
        (set! fBusy false)
        (when (and abortNow (.isInterrupted currentThread))
          (set! abortNow false)
          (Thread/interrupted))
        (catch Exception e
          (set! fBusy false)
          (when (and abortNow (.isInterrupted currentThread)) (Thread/interrupted))
          (when abortNow (set! abortNow false) (.restoreHandlers this) (return nil))
          (when-not (identical? e AbstractDOMParser$Abort/INSTANCE)
            (when (and (not (instance? XMLParseException e)) (some? (.-fErrorHandler this)))
              (let [error (DOMErrorImpl.)]
                (set! (.-fException error) e)
                (set! (.-fMessage error) (.getMessage e))
                (set! (.-fSeverity error) DOMError/SEVERITY_FATAL_ERROR)
                (.handleError (.getErrorHandler (.-fErrorHandler this)) error)))
            (when DEBUG (.printStackTrace e))
            (throw (cast LSException
                         (.fillInStackTrace (DOMUtil/createLSException LSException/PARSE_ERR e)))))))
      (let [doc (.getDocument this)] (.dropDocumentReferences this) doc)))

  (method ^:private restoreHandlers ^void [this]
    (.setDocumentHandler (.-fConfiguration this) this)
    (.setDTDHandler (.-fConfiguration this) this)
    (.setDTDContentModelHandler (.-fConfiguration this) this))

  (method ^:public parseWithContext :throws [DOMException LSException] ^Node [this ^LSInput is
                                                                              ^Node cnode
                                                                              ^short action]
    (throw (DOMException. DOMException/NOT_SUPPORTED_ERR "Not supported")))

  (method dom2xmlInputSource ^XMLInputSource [this ^LSInput is]
    (let [^:mutable ^XMLInputSource xis nil]
      (cond
        (some? (.getCharacterStream is))
          (set! xis
                (XMLInputSource. (.getPublicId is)
                                 (.getSystemId is)
                                 (.getBaseURI is)
                                 (.getCharacterStream is)
                                 "UTF-16"))
        (some? (.getByteStream is))
          (set! xis
                (XMLInputSource. (.getPublicId is)
                                 (.getSystemId is)
                                 (.getBaseURI is)
                                 (.getByteStream is)
                                 (.getEncoding is)))
        (and (some? (.getStringData is)) (> (.length (.getStringData is)) 0))
          (set! xis
                (XMLInputSource. (.getPublicId is)
                                 (.getSystemId is)
                                 (.getBaseURI is)
                                 (StringReader. (.getStringData is))
                                 "UTF-16"))
        (or (and (some? (.getSystemId is)) (> (.length (.getSystemId is)) 0))
            (and (some? (.getPublicId is)) (> (.length (.getPublicId is)) 0)))
          (set! xis (XMLInputSource. (.getPublicId is) (.getSystemId is) (.getBaseURI is) false))
        :else
          (do
            (when (some? (.-fErrorHandler this))
              (let [error (DOMErrorImpl.)]
                (set! (.-fType error) "no-input-specified")
                (set! (.-fMessage error) "no-input-specified")
                (set! (.-fSeverity error) DOMError/SEVERITY_FATAL_ERROR)
                (.handleError (.getErrorHandler (.-fErrorHandler this)) error)))
            (throw (LSException. LSException/PARSE_ERR "no-input-specified"))))
      xis))

  (method ^:public getAsync ^boolean [this] false)

  (method ^:public getBusy ^boolean [this] fBusy)

  (method ^:public abort ^void [this]
    (when fBusy
      (set! fBusy false)
      (when (some? currentThread)
        (set! abortNow true)
        (when (nil? abortHandler) (set! abortHandler (AbortHandler.)))
        (.setDocumentHandler (.-fConfiguration this) abortHandler)
        (.setDTDHandler (.-fConfiguration this) abortHandler)
        (.setDTDContentModelHandler (.-fConfiguration this) abortHandler)
        (when (identical? currentThread (Thread/currentThread))
          (throw AbstractDOMParser$Abort/INSTANCE))
        (.interrupt currentThread))))

  (method ^:public startElement ^void [this ^QName element ^XMLAttributes attributes
                                       ^Augmentations augs]
    (when (and (not fNamespaceDeclarations) (.-fNamespaceAware this))
      (let [len (.getLength attributes)]
        (loop [^int i (unchecked-subtract-int len 1)]
          (if (>= i 0)
              (if (or (identical? XMLSymbols/PREFIX_XMLNS (.getPrefix attributes i))
                      (identical? XMLSymbols/PREFIX_XMLNS (.getQName attributes i)))
                  (do (.removeAttributeAt attributes i) (recur (unchecked-dec-int i)))
                  (recur (unchecked-dec-int i)))
              nil))))
    (.startElement super element attributes augs))


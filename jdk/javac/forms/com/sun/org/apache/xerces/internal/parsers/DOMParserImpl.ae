  (method ^:public getParameter :throws [DOMException] [this ^String name]
    (cond
      (.equalsIgnoreCase name Constants/DOM_COMMENTS)
        (if (.getFeature (.-fConfiguration this) DOMParserImpl/INCLUDE_COMMENTS_FEATURE)
            Boolean/TRUE
            Boolean/FALSE)
      (.equalsIgnoreCase name Constants/DOM_DATATYPE_NORMALIZATION)
        (if (.getFeature (.-fConfiguration this) NORMALIZE_DATA) Boolean/TRUE Boolean/FALSE)
      (.equalsIgnoreCase name Constants/DOM_ENTITIES)
        (if (.getFeature (.-fConfiguration this) DOMParserImpl/CREATE_ENTITY_REF_NODES)
            Boolean/TRUE
            Boolean/FALSE)
      (.equalsIgnoreCase name Constants/DOM_NAMESPACES)
        (if (.getFeature (.-fConfiguration this) NAMESPACES) Boolean/TRUE Boolean/FALSE)
      (.equalsIgnoreCase name Constants/DOM_VALIDATE)
        (if (.getFeature (.-fConfiguration this) VALIDATION_FEATURE) Boolean/TRUE Boolean/FALSE)
      (.equalsIgnoreCase name Constants/DOM_VALIDATE_IF_SCHEMA)
        (if (.getFeature (.-fConfiguration this) DYNAMIC_VALIDATION) Boolean/TRUE Boolean/FALSE)
      (.equalsIgnoreCase name Constants/DOM_ELEMENT_CONTENT_WHITESPACE)
        (if (.getFeature (.-fConfiguration this) DOMParserImpl/INCLUDE_IGNORABLE_WHITESPACE)
            Boolean/TRUE
            Boolean/FALSE)
      (.equalsIgnoreCase name Constants/DOM_DISALLOW_DOCTYPE)
        (if (.getFeature (.-fConfiguration this) DISALLOW_DOCTYPE_DECL_FEATURE)
            Boolean/TRUE
            Boolean/FALSE)
      (.equalsIgnoreCase name Constants/DOM_INFOSET)
        (let [infoset (and (and (and (and (and (and
                                                 (and
                                                   (.getFeature (.-fConfiguration this) NAMESPACES)
                                                   (.getFeature
                                                     (.-fConfiguration this)

                                                 (.getFeature
                                                   (.-fConfiguration this)
                                                   DOMParserImpl/INCLUDE_COMMENTS_FEATURE))
                                               (.getFeature
                                                 (.-fConfiguration this)
                                                 DOMParserImpl/INCLUDE_IGNORABLE_WHITESPACE))
                                          (not (.getFeature
                                                 (.-fConfiguration this)
                                                 DYNAMIC_VALIDATION)))
                                     (not (.getFeature
                                            (.-fConfiguration this)
                                            DOMParserImpl/CREATE_ENTITY_REF_NODES)))
                                (not (.getFeature (.-fConfiguration this) NORMALIZE_DATA)))
                           (not (.getFeature (.-fConfiguration this)
                                             DOMParserImpl/CREATE_CDATA_NODES_FEATURE)))]
          (if infoset Boolean/TRUE Boolean/FALSE))
      (.equalsIgnoreCase name Constants/DOM_CDATA_SECTIONS)
        (if (.getFeature (.-fConfiguration this) DOMParserImpl/CREATE_CDATA_NODES_FEATURE)
            Boolean/TRUE
            Boolean/FALSE)
      (or (.equalsIgnoreCase name Constants/DOM_CHECK_CHAR_NORMALIZATION)
          (.equalsIgnoreCase name Constants/DOM_NORMALIZE_CHARACTERS))
        Boolean/FALSE
      (or (or (or (or (or (or (.equalsIgnoreCase name Constants/DOM_NAMESPACE_DECLARATIONS)
                              (.equalsIgnoreCase name Constants/DOM_WELLFORMED))
                          (.equalsIgnoreCase
                            name
                            Constants/DOM_IGNORE_UNKNOWN_CHARACTER_DENORMALIZATIONS))
                      (.equalsIgnoreCase name Constants/DOM_CANONICAL_FORM))
                  (.equalsIgnoreCase name Constants/DOM_SUPPORTED_MEDIATYPES_ONLY))
              (.equalsIgnoreCase name Constants/DOM_SPLIT_CDATA))
          (.equalsIgnoreCase name Constants/DOM_CHARSET_OVERRIDES_XML_ENCODING))
        (if (.getFeature (.-fConfiguration this) (.toLowerCase name Locale/ENGLISH))
            Boolean/TRUE
            Boolean/FALSE)
      (.equalsIgnoreCase name Constants/DOM_ERROR_HANDLER)
        (when (some? (.-fErrorHandler this)) (.getErrorHandler (.-fErrorHandler this)))
      :else
        (do
          (cond
            (.equalsIgnoreCase name Constants/DOM_RESOURCE_RESOLVER)
              (try
                (let [entityResolver (cast XMLEntityResolver
                                           (.getProperty
                                             (.-fConfiguration this)
                                             DOMParserImpl/ENTITY_RESOLVER))]

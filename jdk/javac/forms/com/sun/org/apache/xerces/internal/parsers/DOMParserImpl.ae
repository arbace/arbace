  (method ^:public canSetParameter ^boolean [this ^String name value]
    (cond
      (nil? value) true
      (instance? Boolean value)
        (let [state (.booleanValue (cast Boolean value))]
          (cond
            (or (or (or (.equalsIgnoreCase name Constants/DOM_SUPPORTED_MEDIATYPES_ONLY)
                        (.equalsIgnoreCase name Constants/DOM_NORMALIZE_CHARACTERS))
                    (.equalsIgnoreCase name Constants/DOM_CHECK_CHAR_NORMALIZATION))
                (.equalsIgnoreCase name Constants/DOM_CANONICAL_FORM))
              (if state false true)
            (or (.equalsIgnoreCase name Constants/DOM_WELLFORMED)
                (.equalsIgnoreCase name Constants/DOM_IGNORE_UNKNOWN_CHARACTER_DENORMALIZATIONS))
              (if state true false)
            (or (or (or (or (or (or (or (or (or
                                              (or
                                                (or
                                                  (or
                                                    (.equalsIgnoreCase
                                                      name
                                                      Constants/DOM_CDATA_SECTIONS)
                                                    (.equalsIgnoreCase
                                                      name
                                                      Constants/DOM_CHARSET_OVERRIDES_XML_ENCODING))
                                                  (.equalsIgnoreCase name Constants/DOM_COMMENTS))
                                                (.equalsIgnoreCase
                                                  name
                                                  Constants/DOM_DATATYPE_NORMALIZATION))
                                              (.equalsIgnoreCase
                                                name
                                                Constants/DOM_DISALLOW_DOCTYPE))
                                            (.equalsIgnoreCase name Constants/DOM_ENTITIES))
                                        (.equalsIgnoreCase name Constants/DOM_INFOSET))
                                    (.equalsIgnoreCase name Constants/DOM_NAMESPACES))
                                (.equalsIgnoreCase name Constants/DOM_NAMESPACE_DECLARATIONS))
                            (.equalsIgnoreCase name Constants/DOM_VALIDATE))
                        (.equalsIgnoreCase name Constants/DOM_VALIDATE_IF_SCHEMA))
                    (.equalsIgnoreCase name Constants/DOM_ELEMENT_CONTENT_WHITESPACE))
                (.equalsIgnoreCase name Constants/DOM_XMLDECL))
              true
            :else
              (try
                (let [^String normalizedName (cond
                                               (.equalsIgnoreCase name NAMESPACE_GROWTH)
                                                 NAMESPACE_GROWTH
                                               (.equalsIgnoreCase name TOLERATE_DUPLICATES)
                                                 TOLERATE_DUPLICATES
                                               :else (.toLowerCase name Locale/ENGLISH))]
                  (.getFeature (.-fConfiguration this) normalizedName)
                  true)
                (catch XMLConfigurationException e false))))
      (.equalsIgnoreCase name Constants/DOM_ERROR_HANDLER)
        (if (or (instance? DOMErrorHandler value) (nil? value)) true false)
      (.equalsIgnoreCase name Constants/DOM_RESOURCE_RESOLVER)
        (if (or (instance? LSResourceResolver value) (nil? value)) true false)
      (.equalsIgnoreCase name Constants/DOM_SCHEMA_TYPE)
        (if (or (and (instance? String value)
                     (or (.equals value Constants/NS_XMLSCHEMA) (.equals value Constants/NS_DTD)))
                (nil? value))
            true
            false)
      (.equalsIgnoreCase name Constants/DOM_SCHEMA_LOCATION)
        (if (or (instance? String value) (nil? value)) true false)
      (.equalsIgnoreCase name DOMParserImpl/DOCUMENT_CLASS_NAME) true
      :else false))


            (== currChar \<) (.append newVal "&lt;")
            (== currChar \&) (.append newVal "&amp;")
            (== currChar 0x09) (.append newVal "&#x9;")
            (== currChar 0x0A) (.append newVal "&#xA;")
            (== currChar 0x0D) (.append newVal "&#xD;")

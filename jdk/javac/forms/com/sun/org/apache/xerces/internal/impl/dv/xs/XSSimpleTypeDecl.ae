  (method ^:public getFacets ^XSObjectList [this]
    (when (and (nil? fFacets) (or (not (== fFacetsDefined 0)) (== fValidationDV DV_INTEGER)))
      (let [facets (new XSFacetImpl/1 10)
            ^:mutable ^int count 0]
        (when (and (and (not (== (bit-and-int fFacetsDefined XSSimpleTypeDecl/FACET_WHITESPACE) 0))
                        (not (== fValidationDV DV_ANYSIMPLETYPE)))
                   (not (== fValidationDV DV_ANYATOMICTYPE)))
          (aset facets
                count
                (XSFacetImpl. XSSimpleTypeDecl/FACET_WHITESPACE
                              (aget WS_FACET_STRING fWhiteSpace)
                              0
                              nil
                              (not (== (bit-and-int fFixedFacet XSSimpleTypeDecl/FACET_WHITESPACE)
                                       0))
                              whiteSpaceAnnotation))
          (set! count (unchecked-inc-int count)))
        (when-not (== fLength -1)
          (aset facets
                count
                (XSFacetImpl. XSSimpleTypeDecl/FACET_LENGTH
                              (Integer/toString fLength)
                              fLength
                              nil
                              (not (== (bit-and-int fFixedFacet XSSimpleTypeDecl/FACET_LENGTH) 0))
                              lengthAnnotation))
          (set! count (unchecked-inc-int count)))
        (when-not (== fMinLength -1)
          (aset facets
                count
                (XSFacetImpl. XSSimpleTypeDecl/FACET_MINLENGTH
                              (Integer/toString fMinLength)
                              fMinLength
                              nil
                              (not
                                (== (bit-and-int fFixedFacet XSSimpleTypeDecl/FACET_MINLENGTH) 0))
                              minLengthAnnotation))
          (set! count (unchecked-inc-int count)))
        (when-not (== fMaxLength -1)
          (aset facets
                count
                (XSFacetImpl. XSSimpleTypeDecl/FACET_MAXLENGTH
                              (Integer/toString fMaxLength)
                              fMaxLength
                              nil
                              (not
                                (== (bit-and-int fFixedFacet XSSimpleTypeDecl/FACET_MAXLENGTH) 0))
                              maxLengthAnnotation))
          (set! count (unchecked-inc-int count)))
        (when-not (== fTotalDigits -1)
          (aset facets
                count
                (XSFacetImpl. XSSimpleTypeDecl/FACET_TOTALDIGITS
                              (Integer/toString fTotalDigits)
                              fTotalDigits
                              nil
                              (not (== (bit-and-int fFixedFacet XSSimpleTypeDecl/FACET_TOTALDIGITS)
                                       0))
                              totalDigitsAnnotation))
          (set! count (unchecked-inc-int count)))
        (if (== fValidationDV DV_INTEGER)
            (do
              (aset facets
                    count
                    (XSFacetImpl. XSSimpleTypeDecl/FACET_FRACTIONDIGITS
                                  "0"
                                  0
                                  nil
                                  true
                                  fractionDigitsAnnotation))
              (set! count (unchecked-inc-int count)))
            (when-not (== fFractionDigits -1)
              (aset facets
                    count
                    (XSFacetImpl. XSSimpleTypeDecl/FACET_FRACTIONDIGITS
                                  (Integer/toString fFractionDigits)
                                  fFractionDigits
                                  nil
                                  (not (== (bit-and-int
                                             fFixedFacet
                                             XSSimpleTypeDecl/FACET_FRACTIONDIGITS)
                                           0))
                                  fractionDigitsAnnotation))
              (set! count (unchecked-inc-int count))))
        (when (some? fMaxInclusive)
          (aset facets
                count
                (XSFacetImpl. XSSimpleTypeDecl/FACET_MAXINCLUSIVE
                              (.toString fMaxInclusive)
                              0
                              fMaxInclusive
                              (not (== (bit-and-int fFixedFacet XSSimpleTypeDecl/FACET_MAXINCLUSIVE)
                                       0))
                              maxInclusiveAnnotation))
          (set! count (unchecked-inc-int count)))
        (when (some? fMaxExclusive)
          (aset facets
                count
                (XSFacetImpl. XSSimpleTypeDecl/FACET_MAXEXCLUSIVE
                              (.toString fMaxExclusive)
                              0
                              fMaxExclusive
                              (not (== (bit-and-int fFixedFacet XSSimpleTypeDecl/FACET_MAXEXCLUSIVE)
                                       0))
                              maxExclusiveAnnotation))
          (set! count (unchecked-inc-int count)))
        (when (some? fMinExclusive)
          (aset facets
                count
                (XSFacetImpl. XSSimpleTypeDecl/FACET_MINEXCLUSIVE
                              (.toString fMinExclusive)
                              0
                              fMinExclusive
                              (not (== (bit-and-int fFixedFacet XSSimpleTypeDecl/FACET_MINEXCLUSIVE)
                                       0))
                              minExclusiveAnnotation))
          (set! count (unchecked-inc-int count)))
        (when (some? fMinInclusive)
          (aset facets
                count
                (XSFacetImpl. XSSimpleTypeDecl/FACET_MININCLUSIVE
                              (.toString fMinInclusive)
                              0
                              fMinInclusive
                              (not (== (bit-and-int fFixedFacet XSSimpleTypeDecl/FACET_MININCLUSIVE)
                                       0))
                              minInclusiveAnnotation))
          (set! count (unchecked-inc-int count)))
        (set! fFacets (if (> count 0) (XSObjectListImpl. facets count) XSObjectListImpl/EMPTY_LIST))))
    (if (some? fFacets) ^XSObjectList fFacets XSObjectListImpl/EMPTY_LIST))

  (method ^:public getFacet ^XSObject [this ^int facetType]
    (if (or (== facetType XSSimpleTypeDecl/FACET_ENUMERATION)
            (== facetType XSSimpleTypeDecl/FACET_PATTERN))
        (let [list (.getMultiValueFacets this)]
          (loop [^int i 0]
            (when (< i (.getLength list))
              (let [f (cast XSMultiValueFacet (.item list i))]
                (if (== (.getFacetKind f) facetType) (return f) (recur (unchecked-inc-int i)))))))
        (let [list (.getFacets this)]
          (loop [^int i 0]
            (when (< i (.getLength list))
              (let [f (cast XSFacet (.item list i))]
                (if (== (.getFacetKind f) facetType) (return f) (recur (unchecked-inc-int i))))))))
    nil)

  (method ^:public getMultiValueFacets ^XSObjectList [this]
    (when (and (nil? fMultiValueFacets)
               (or (or (or (not (== (bit-and-int fFacetsDefined XSSimpleTypeDecl/FACET_ENUMERATION)
                                    0))
                           (not (== (bit-and-int fFacetsDefined XSSimpleTypeDecl/FACET_PATTERN) 0)))
                       (not (== fPatternType SPECIAL_PATTERN_NONE)))
                   (== fValidationDV DV_INTEGER)))
      (let [facets (new XSMVFacetImpl/1 2)
            ^:mutable ^int count 0]
        (when (or (or (not (== (bit-and-int fFacetsDefined XSSimpleTypeDecl/FACET_PATTERN) 0))
                      (not (== fPatternType SPECIAL_PATTERN_NONE)))
                  (== fValidationDV DV_INTEGER))
          (aset facets
                count
                (XSMVFacetImpl. XSSimpleTypeDecl/FACET_PATTERN
                                (.getLexicalPattern this)
                                nil
                                patternAnnotations))
          (set! count (unchecked-inc-int count)))
        (when (some? fEnumeration)
          (aset facets
                count
                (XSMVFacetImpl. XSSimpleTypeDecl/FACET_ENUMERATION
                                (.getLexicalEnumeration this)
                                (ObjectListImpl. fEnumeration fEnumerationSize)
                                enumerationAnnotations))
          (set! count (unchecked-inc-int count)))
        (set! fMultiValueFacets (XSObjectListImpl. facets count))))
    (if (some? fMultiValueFacets) ^XSObjectList fMultiValueFacets XSObjectListImpl/EMPTY_LIST))


  (defclass ^:private ^:abstract ^:static AbstractObjectList
    :extends (AbstractList Object)
    :implements [ObjectList]

    (method ^:public get [this ^int index]
      (if (and (>= index 0) (< index (.getLength this)))
          (.item this index)
          (throw (IndexOutOfBoundsException. (java-str "Index: " index)))))

    (method ^:public size ^int [this] (.getLength this)))

  (method ^:public getTypeNamespace ^String [this] (.getNamespace this))

  (method ^:public isDerivedFrom ^boolean [this ^String typeNamespaceArg ^String typeNameArg
                                           ^int derivationMethod]
    (.isDOMDerivedFrom this typeNamespaceArg typeNameArg derivationMethod))

  (method ^:private convertToPrimitiveKind ^short [this ^short valueType]
    (cond
      (<= valueType XSConstants/NOTATION_DT) valueType
      (<= valueType XSConstants/ENTITY_DT) XSConstants/STRING_DT
      (<= valueType XSConstants/POSITIVEINTEGER_DT) XSConstants/DECIMAL_DT
      :else valueType))

  (method ^:private appendEnumString ^void [this ^StringBuffer sb]
    (.append sb \[)
    (loop [^int i 0]
      (when (< i fEnumerationSize)
        (when-not (== i 0) (.append sb ", "))
        (.append sb (.-actualValue (aget fEnumeration i)))
        (recur (unchecked-inc-int i))))
    (.append sb \])))

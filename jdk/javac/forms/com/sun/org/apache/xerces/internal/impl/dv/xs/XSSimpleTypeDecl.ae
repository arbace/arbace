                  (when (and (not (== (bit-and-int
                                        (.-fFacetsDefined fBase)
                                        XSSimpleTypeDecl/FACET_LENGTH)
                                      0))
                             (> (.-fLength fBase) fMaxLength))
                    (.reportError this
                                  "length-minLength-maxLength.2.1"
                                  (new Object/1
                                       [fTypeName
                                        (Integer/toString (.-fLength fBase))
                                        (Integer/toString fMaxLength)])))
                  (when (and (not (== (bit-and-int fFacetsDefined XSSimpleTypeDecl/FACET_LENGTH) 0))
                             (> fLength fMaxLength))
                    (.reportError this
                                  "length-minLength-maxLength.2.1"
                                  (new Object/1
                                       [fTypeName
                                        (Integer/toString fLength)
                                        (Integer/toString fMaxLength)])))
                  (when (== (bit-and-int (.-fFacetsDefined fBase) XSSimpleTypeDecl/FACET_MAXLENGTH)
                            0)
                    (.reportError this
                                  "length-minLength-maxLength.2.2.a"
                                  (new Object/1 [fTypeName])))
                  (when-not (== fMaxLength (.-fMaxLength fBase))
                    (.reportError this
                                  "length-minLength-maxLength.2.2.b"
                                  (new Object/1
                                       [fTypeName
                                        (Integer/toString fMaxLength)
                                        (Integer/toString (.-fMaxLength (.-fBase fBase)))])))))
              (when-not (== (bit-and-int fFacetsDefined XSSimpleTypeDecl/FACET_MINLENGTH) 0)
                (if (not (== (bit-and-int (.-fFacetsDefined fBase) XSSimpleTypeDecl/FACET_MAXLENGTH)
                             0))
                    (when (> fMinLength (.-fMaxLength fBase))
                      (.reportError this
                                    "minLength-less-than-equal-to-maxLength"
                                    (new Object/1
                                         [(Integer/toString fMinLength)
                                          (Integer/toString (.-fMaxLength fBase))
                                          fTypeName])))
                    (when-not (== (bit-and-int (.-fFacetsDefined fBase)
                                               XSSimpleTypeDecl/FACET_MINLENGTH)
                                  0)
                      (when (and (not (== (bit-and-int
                                            (.-fFixedFacet fBase)
                                            XSSimpleTypeDecl/FACET_MINLENGTH)
                                          0))
                                 (not (== fMinLength (.-fMinLength fBase))))
                        (.reportError this
                                      "FixedFacetValue"
                                      (new Object/1
                                           ["minLength"
                                            (Integer/toString fMinLength)
                                            (Integer/toString (.-fMinLength fBase))
                                            fTypeName])))
                      (when (< fMinLength (.-fMinLength fBase))
                        (.reportError this
                                      "minLength-valid-restriction"
                                      (new Object/1
                                           [(Integer/toString fMinLength)
                                            (Integer/toString (.-fMinLength fBase))
                                            fTypeName]))))))
              (when (and (not (== (bit-and-int fFacetsDefined XSSimpleTypeDecl/FACET_MAXLENGTH) 0))
                         (not (== (bit-and-int (.-fFacetsDefined fBase)
                                               XSSimpleTypeDecl/FACET_MINLENGTH)
                                  0)))
                (when (< fMaxLength (.-fMinLength fBase))
                  (.reportError this
                                "minLength-less-than-equal-to-maxLength"
                                (new Object/1
                                     [(Integer/toString (.-fMinLength fBase))
                                      (Integer/toString fMaxLength)]))))
              (when-not (== (bit-and-int fFacetsDefined XSSimpleTypeDecl/FACET_MAXLENGTH) 0)
                (when-not (== (bit-and-int (.-fFacetsDefined fBase)
                                           XSSimpleTypeDecl/FACET_MAXLENGTH)
                              0)
                  (when (and (not (== (bit-and-int
                                        (.-fFixedFacet fBase)
                                        XSSimpleTypeDecl/FACET_MAXLENGTH)
                                      0))
                             (not (== fMaxLength (.-fMaxLength fBase))))
                    (.reportError this
                                  "FixedFacetValue"
                                  (new Object/1
                                       ["maxLength"
                                        (Integer/toString fMaxLength)
                                        (Integer/toString (.-fMaxLength fBase))
                                        fTypeName])))
                  (when (> fMaxLength (.-fMaxLength fBase))
                    (.reportError this
                                  "maxLength-valid-restriction"
                                  (new Object/1
                                       [(Integer/toString fMaxLength)
                                        (Integer/toString (.-fMaxLength fBase))
                                        fTypeName])))))
              (when-not (== (bit-and-int fFacetsDefined XSSimpleTypeDecl/FACET_TOTALDIGITS) 0)
                (when-not (== (bit-and-int (.-fFacetsDefined fBase)
                                           XSSimpleTypeDecl/FACET_TOTALDIGITS)
                              0)
                  (when (and (not (== (bit-and-int
                                        (.-fFixedFacet fBase)
                                        XSSimpleTypeDecl/FACET_TOTALDIGITS)
                                      0))
                             (not (== fTotalDigits (.-fTotalDigits fBase))))
                    (.reportError this
                                  "FixedFacetValue"
                                  (new Object/1
                                       ["totalDigits"
                                        (Integer/toString fTotalDigits)
                                        (Integer/toString (.-fTotalDigits fBase))
                                        fTypeName])))
                  (when (> fTotalDigits (.-fTotalDigits fBase))
                    (.reportError this
                                  "totalDigits-valid-restriction"
                                  (new Object/1
                                       [(Integer/toString fTotalDigits)
                                        (Integer/toString (.-fTotalDigits fBase))
                                        fTypeName])))))
              (when-not (== (bit-and-int fFacetsDefined XSSimpleTypeDecl/FACET_FRACTIONDIGITS) 0)
                (when-not (== (bit-and-int (.-fFacetsDefined fBase)
                                           XSSimpleTypeDecl/FACET_TOTALDIGITS)
                              0)
                  (when (> fFractionDigits (.-fTotalDigits fBase))
                    (.reportError this
                                  "fractionDigits-totalDigits"
                                  (new Object/1
                                       [(Integer/toString fFractionDigits)
                                        (Integer/toString fTotalDigits)
                                        fTypeName])))))
              (when-not (== (bit-and-int fFacetsDefined XSSimpleTypeDecl/FACET_FRACTIONDIGITS) 0)
                (cond
                  (not (== (bit-and-int (.-fFacetsDefined fBase)
                                        XSSimpleTypeDecl/FACET_FRACTIONDIGITS)
                           0))
                    (do
                      (when (or (and (not (== (bit-and-int
                                                (.-fFixedFacet fBase)
                                                XSSimpleTypeDecl/FACET_FRACTIONDIGITS)
                                              0))
                                     (not (== fFractionDigits (.-fFractionDigits fBase))))
                                (and (== fValidationDV DV_INTEGER) (not (== fFractionDigits 0))))
                        (.reportError this
                                      "FixedFacetValue"
                                      (new Object/1
                                           ["fractionDigits"
                                            (Integer/toString fFractionDigits)
                                            (Integer/toString (.-fFractionDigits fBase))
                                            fTypeName])))
                      (when (> fFractionDigits (.-fFractionDigits fBase))
                        (.reportError this
                                      "fractionDigits-valid-restriction"
                                      (new Object/1
                                           [(Integer/toString fFractionDigits)
                                            (Integer/toString (.-fFractionDigits fBase))
                                            fTypeName]))))
                  (and (== fValidationDV DV_INTEGER) (not (== fFractionDigits 0)))
                    (.reportError this
                                  "FixedFacetValue"
                                  (new Object/1
                                       ["fractionDigits"
                                        (Integer/toString fFractionDigits)
                                        "0"
                                        fTypeName]))))
              (when (and (not (== (bit-and-int fFacetsDefined XSSimpleTypeDecl/FACET_WHITESPACE) 0))
                         (not (== (bit-and-int (.-fFacetsDefined fBase)
                                               XSSimpleTypeDecl/FACET_WHITESPACE)
                                  0)))
                (when (and (not (== (bit-and-int
                                      (.-fFixedFacet fBase)
                                      XSSimpleTypeDecl/FACET_WHITESPACE)
                                    0))
                           (not (== fWhiteSpace (.-fWhiteSpace fBase))))
                  (.reportError this
                                "FixedFacetValue"
                                (new Object/1
                                     ["whiteSpace"
                                      (.whiteSpaceValue this fWhiteSpace)
                                      (.whiteSpaceValue this (.-fWhiteSpace fBase))
                                      fTypeName])))
                (when (and (== fWhiteSpace XSSimpleTypeDecl/WS_PRESERVE)
                           (== (.-fWhiteSpace fBase) XSSimpleTypeDecl/WS_COLLAPSE))
                  (.reportError this
                                "whiteSpace-valid-restriction.1"
                                (new Object/1 [fTypeName "preserve"])))
                (when (and (== fWhiteSpace XSSimpleTypeDecl/WS_REPLACE)
                           (== (.-fWhiteSpace fBase) XSSimpleTypeDecl/WS_COLLAPSE))
                  (.reportError this
                                "whiteSpace-valid-restriction.1"
                                (new Object/1 [fTypeName "replace"])))
                (when (and (== fWhiteSpace XSSimpleTypeDecl/WS_PRESERVE)
                           (== (.-fWhiteSpace fBase) XSSimpleTypeDecl/WS_REPLACE))
                  (.reportError this "whiteSpace-valid-restriction.2" (new Object/1 [fTypeName])))))
            (when (and (== (bit-and-int fFacetsDefined XSSimpleTypeDecl/FACET_LENGTH) 0)
                       (not (== (bit-and-int (.-fFacetsDefined fBase) XSSimpleTypeDecl/FACET_LENGTH)
                                0)))
              (set! fFacetsDefined
                    (unchecked-short (bit-or-int fFacetsDefined XSSimpleTypeDecl/FACET_LENGTH)))
              (set! fLength (.-fLength fBase))
              (set! lengthAnnotation (.-lengthAnnotation fBase)))
            (when (and (== (bit-and-int fFacetsDefined XSSimpleTypeDecl/FACET_MINLENGTH) 0)
                       (not (== (bit-and-int (.-fFacetsDefined fBase)
                                             XSSimpleTypeDecl/FACET_MINLENGTH)
                                0)))
              (set! fFacetsDefined
                    (unchecked-short (bit-or-int fFacetsDefined XSSimpleTypeDecl/FACET_MINLENGTH)))
              (set! fMinLength (.-fMinLength fBase))
              (set! minLengthAnnotation (.-minLengthAnnotation fBase)))
            (when (and (== (bit-and-int fFacetsDefined XSSimpleTypeDecl/FACET_MAXLENGTH) 0)
                       (not (== (bit-and-int (.-fFacetsDefined fBase)
                                             XSSimpleTypeDecl/FACET_MAXLENGTH)
                                0)))
              (set! fFacetsDefined
                    (unchecked-short (bit-or-int fFacetsDefined XSSimpleTypeDecl/FACET_MAXLENGTH)))
              (set! fMaxLength (.-fMaxLength fBase))
              (set! maxLengthAnnotation (.-maxLengthAnnotation fBase)))
            (when-not (== (bit-and-int (.-fFacetsDefined fBase) XSSimpleTypeDecl/FACET_PATTERN) 0)
              (if (== (bit-and-int fFacetsDefined XSSimpleTypeDecl/FACET_PATTERN) 0)
                  (do
                    (set! fFacetsDefined
                          (unchecked-short
                            (bit-or-int fFacetsDefined XSSimpleTypeDecl/FACET_PATTERN)))
                    (set! fPattern (.-fPattern fBase))
                    (set! fPatternStr (.-fPatternStr fBase))
                    (set! patternAnnotations (.-patternAnnotations fBase)))
                  (do
                    (loop [^int i (unchecked-subtract-int (.size (.-fPattern fBase)) 1)]
                      (when (>= i 0)
                        (.add fPattern (cast RegularExpression (.get (.-fPattern fBase) i)))
                        (.add fPatternStr (cast String (.get (.-fPatternStr fBase) i)))
                        (recur (unchecked-dec-int i))))
                    (when (some? (.-patternAnnotations fBase))
                      (if (some? patternAnnotations)
                          (loop [^int i (unchecked-subtract-int
                                          (.getLength (.-patternAnnotations fBase))
                                          1)]
                            (when (>= i 0)
                              (.addXSObject patternAnnotations
                                            (.item (.-patternAnnotations fBase) i))
                              (recur (unchecked-dec-int i))))
                          (set! patternAnnotations (.-patternAnnotations fBase)))))))
            (when (and (== (bit-and-int fFacetsDefined XSSimpleTypeDecl/FACET_WHITESPACE) 0)
                       (not (== (bit-and-int (.-fFacetsDefined fBase)
                                             XSSimpleTypeDecl/FACET_WHITESPACE)
                                0)))
              (set! fFacetsDefined
                    (unchecked-short (bit-or-int fFacetsDefined XSSimpleTypeDecl/FACET_WHITESPACE)))
              (set! fWhiteSpace (.-fWhiteSpace fBase))
              (set! whiteSpaceAnnotation (.-whiteSpaceAnnotation fBase)))
            (when (and (== (bit-and-int fFacetsDefined XSSimpleTypeDecl/FACET_ENUMERATION) 0)
                       (not (== (bit-and-int (.-fFacetsDefined fBase)
                                             XSSimpleTypeDecl/FACET_ENUMERATION)
                                0)))
              (set!
                fFacetsDefined
                (unchecked-short (bit-or-int fFacetsDefined XSSimpleTypeDecl/FACET_ENUMERATION)))
              (set! fEnumeration (.-fEnumeration fBase))
              (set! fEnumerationSize (.-fEnumerationSize fBase))
              (set! enumerationAnnotations (.-enumerationAnnotations fBase)))
            (when (and (and (not (== (bit-and-int
                                       (.-fFacetsDefined fBase)
                                       XSSimpleTypeDecl/FACET_MAXEXCLUSIVE)
                                     0))
                            (not (not (== (bit-and-int
                                            fFacetsDefined
                                            XSSimpleTypeDecl/FACET_MAXEXCLUSIVE)
                                          0))))
                       (not (not (== (bit-and-int
                                       fFacetsDefined
                                       XSSimpleTypeDecl/FACET_MAXINCLUSIVE)
                                     0))))
              (set! fFacetsDefined
                    (unchecked-short
                      (bit-or-int fFacetsDefined XSSimpleTypeDecl/FACET_MAXEXCLUSIVE)))
              (set! fMaxExclusive (.-fMaxExclusive fBase))
              (set! maxExclusiveAnnotation (.-maxExclusiveAnnotation fBase)))
            (when (and (and (not (== (bit-and-int
                                       (.-fFacetsDefined fBase)
                                       XSSimpleTypeDecl/FACET_MAXINCLUSIVE)
                                     0))
                            (not (not (== (bit-and-int
                                            fFacetsDefined
                                            XSSimpleTypeDecl/FACET_MAXEXCLUSIVE)
                                          0))))
                       (not (not (== (bit-and-int
                                       fFacetsDefined
                                       XSSimpleTypeDecl/FACET_MAXINCLUSIVE)
                                     0))))
              (set! fFacetsDefined
                    (unchecked-short
                      (bit-or-int fFacetsDefined XSSimpleTypeDecl/FACET_MAXINCLUSIVE)))
              (set! fMaxInclusive (.-fMaxInclusive fBase))
              (set! maxInclusiveAnnotation (.-maxInclusiveAnnotation fBase)))
            (when (and (and (not (== (bit-and-int
                                       (.-fFacetsDefined fBase)
                                       XSSimpleTypeDecl/FACET_MINEXCLUSIVE)
                                     0))
                            (not (not (== (bit-and-int
                                            fFacetsDefined
                                            XSSimpleTypeDecl/FACET_MINEXCLUSIVE)
                                          0))))
                       (not (not (== (bit-and-int
                                       fFacetsDefined
                                       XSSimpleTypeDecl/FACET_MININCLUSIVE)
                                     0))))
              (set! fFacetsDefined
                    (unchecked-short
                      (bit-or-int fFacetsDefined XSSimpleTypeDecl/FACET_MINEXCLUSIVE)))
              (set! fMinExclusive (.-fMinExclusive fBase))
              (set! minExclusiveAnnotation (.-minExclusiveAnnotation fBase)))
            (when (and (and (not (== (bit-and-int
                                       (.-fFacetsDefined fBase)
                                       XSSimpleTypeDecl/FACET_MININCLUSIVE)
                                     0))
                            (not (not (== (bit-and-int
                                            fFacetsDefined
                                            XSSimpleTypeDecl/FACET_MINEXCLUSIVE)
                                          0))))
                       (not (not (== (bit-and-int
                                       fFacetsDefined
                                       XSSimpleTypeDecl/FACET_MININCLUSIVE)
                                     0))))
              (set! fFacetsDefined
                    (unchecked-short
                      (bit-or-int fFacetsDefined XSSimpleTypeDecl/FACET_MININCLUSIVE)))
              (set! fMinInclusive (.-fMinInclusive fBase))
              (set! minInclusiveAnnotation (.-minInclusiveAnnotation fBase)))
            (when (and (not (== (bit-and-int (.-fFacetsDefined fBase)
                                             XSSimpleTypeDecl/FACET_TOTALDIGITS)
                                0))
                       (not (not (== (bit-and-int fFacetsDefined XSSimpleTypeDecl/FACET_TOTALDIGITS)
                                     0))))
              (set!
                fFacetsDefined
                (unchecked-short (bit-or-int fFacetsDefined XSSimpleTypeDecl/FACET_TOTALDIGITS)))
              (set! fTotalDigits (.-fTotalDigits fBase))
              (set! totalDigitsAnnotation (.-totalDigitsAnnotation fBase)))
            (when (and (not (== (bit-and-int (.-fFacetsDefined fBase)
                                             XSSimpleTypeDecl/FACET_FRACTIONDIGITS)
                                0))
                       (not (not (== (bit-and-int
                                       fFacetsDefined
                                       XSSimpleTypeDecl/FACET_FRACTIONDIGITS)
                                     0))))
              (set! fFacetsDefined
                    (unchecked-short
                      (bit-or-int fFacetsDefined XSSimpleTypeDecl/FACET_FRACTIONDIGITS)))
              (set! fFractionDigits (.-fFractionDigits fBase))
              (set! fractionDigitsAnnotation (.-fractionDigitsAnnotation fBase)))
            (when (and (== fPatternType SPECIAL_PATTERN_NONE)
                       (not (== (.-fPatternType fBase) SPECIAL_PATTERN_NONE)))
              (set! fPatternType (.-fPatternType fBase)))
            (set! fFixedFacet (unchecked-short (bit-or-int fFixedFacet (.-fFixedFacet fBase))))
            (.calcFundamentalFacets this))))))

  (method ^:public validate :throws [InvalidDatatypeValueException] [this ^String content
                                                                     ^:mutable ^ValidationContext context
                                                                     ^:mutable ^ValidatedInfo validatedInfo]
    (when (nil? context) (set! context fEmptyContext))
    (if (nil? validatedInfo)
        (set! validatedInfo (ValidatedInfo.))
        (set! (.-memberType validatedInfo) nil))
    (let [needNormalize (or (nil? context) (.needToNormalize context))
          ob (.getActualValue this content context validatedInfo needNormalize)]
      (.validate this context validatedInfo)
      ob))

  (method ^:protected getActualEnumValue :throws [InvalidDatatypeValueException] ^ValidatedInfo [this
                                                                                                 ^String lexical
                                                                                                 ^ValidationContext ctx
                                                                                                 ^ValidatedInfo info]
    (.validateWithInfo fBase lexical ctx info))

  (method ^:public validateWithInfo :throws [InvalidDatatypeValueException] ^ValidatedInfo [this
                                                                                            ^String content
                                                                                            ^:mutable ^ValidationContext context
                                                                                            ^:mutable ^ValidatedInfo validatedInfo]
    (when (nil? context) (set! context fEmptyContext))
    (if (nil? validatedInfo)
        (set! validatedInfo (ValidatedInfo.))
        (set! (.-memberType validatedInfo) nil))
    (let [needNormalize (or (nil? context) (.needToNormalize context))]
      (.getActualValue this content context validatedInfo needNormalize)
      (.validate this context validatedInfo)
      validatedInfo))

  (method ^:public validate :throws [InvalidDatatypeValueException] [this content
                                                                     ^:mutable ^ValidationContext context
                                                                     ^:mutable ^ValidatedInfo validatedInfo]
    (when (nil? context) (set! context fEmptyContext))
    (if (nil? validatedInfo)
        (set! validatedInfo (ValidatedInfo.))
        (set! (.-memberType validatedInfo) nil))
    (let [needNormalize (or (nil? context) (.needToNormalize context))
          ob (.getActualValue this content context validatedInfo needNormalize)]
      (.validate this context validatedInfo)
      ob))

  (method ^:public validate :throws [InvalidDatatypeValueException] ^void [this
                                                                           ^:mutable ^ValidationContext context
                                                                           ^ValidatedInfo validatedInfo]
    (when (nil? context) (set! context fEmptyContext))
    (when (and (.needFacetChecking context)
               (and (not (== fFacetsDefined 0))
                    (not (== fFacetsDefined XSSimpleTypeDecl/FACET_WHITESPACE))))
      (.checkFacets this validatedInfo))
    (when (.needExtraChecking context) (.checkExtraRules this context validatedInfo)))

  (method ^:private checkFacets :throws [InvalidDatatypeValueException] ^void [this
                                                                               ^ValidatedInfo validatedInfo]
    (let [ob (.-actualValue validatedInfo)
          content (.-normalizedValue validatedInfo)
          type (.-actualValueType validatedInfo)
          itemType (.-itemValueTypes validatedInfo)]
      (when (and (not (== fValidationDV DV_QNAME)) (not (== fValidationDV DV_NOTATION)))
        (let [length (.getDataLength (aget fDVs fValidationDV) ob)]
          (when-not (== (bit-and-int fFacetsDefined XSSimpleTypeDecl/FACET_MAXLENGTH) 0)
            (when (> length fMaxLength)
              (throw (InvalidDatatypeValueException.
                       "cvc-maxLength-valid"
                       (new Object/1
                            [content
                             (Integer/toString length)
                             (Integer/toString fMaxLength)
                             fTypeName])))))
          (when-not (== (bit-and-int fFacetsDefined XSSimpleTypeDecl/FACET_MINLENGTH) 0)
            (when (< length fMinLength)
              (throw (InvalidDatatypeValueException.
                       "cvc-minLength-valid"
                       (new Object/1
                            [content
                             (Integer/toString length)
                             (Integer/toString fMinLength)
                             fTypeName])))))
          (when-not (== (bit-and-int fFacetsDefined XSSimpleTypeDecl/FACET_LENGTH) 0)
            (when-not (== length fLength)
              (throw (InvalidDatatypeValueException.
                       "cvc-length-valid"
                       (new
                         Object/1
                         [content (Integer/toString length) (Integer/toString fLength) fTypeName])))))))
      (when-not (== (bit-and-int fFacetsDefined XSSimpleTypeDecl/FACET_ENUMERATION) 0)
        (let [^:mutable present false
              ^:final enumSize fEnumerationSize
              ^:final primitiveType1 (.convertToPrimitiveKind this type)]
          (loop [^int i 0]
            (when (< i enumSize)
              (let [^:final primitiveType2 (.convertToPrimitiveKind
                                             this
                                             (.-actualValueType (aget fEnumeration i)))]
                (if (and (or (or (== primitiveType1 primitiveType2)
                                 (and (== primitiveType1 XSConstants/ANYSIMPLETYPE_DT)
                                      (== primitiveType2 XSConstants/STRING_DT)))
                             (and (== primitiveType1 XSConstants/STRING_DT)
                                  (== primitiveType2 XSConstants/ANYSIMPLETYPE_DT)))
                         (.equals (.-actualValue (aget fEnumeration i)) ob))
                    (if (or (== primitiveType1 XSConstants/LIST_DT)
                            (== primitiveType1 XSConstants/LISTOFUNION_DT))
                        (let [enumItemType (.-itemValueTypes (aget fEnumeration i))
                              ^:final ^int typeList1Length (if (some? itemType)
                                                               (.getLength itemType)
                                                               0)
                              ^:final ^int typeList2Length (if (some? enumItemType)
                                                               (.getLength enumItemType)
                                                               0)]
                          (if (== typeList1Length typeList2Length)
                              (let [^:mutable ^int j 0]
                                (set! j 0)
                                (while (< j typeList1Length)
                                  (let [^:final primitiveItem1 (.convertToPrimitiveKind
                                                                 this
                                                                 (.item itemType j))
                                        ^:final primitiveItem2 (.convertToPrimitiveKind
                                                                 this
                                                                 (.item enumItemType j))]
                                    (when-not (== primitiveItem1 primitiveItem2)
                                      (when-not (or
                                                  (and
                                                    (== primitiveItem1 XSConstants/ANYSIMPLETYPE_DT)
                                                    (== primitiveItem2 XSConstants/STRING_DT))
                                                  (and
                                                    (== primitiveItem1 XSConstants/STRING_DT)
                                                    (== primitiveItem2 XSConstants/ANYSIMPLETYPE_DT)))
                                        (break))))
                                  (set! j (unchecked-inc-int j)))
                                (if (== j typeList1Length)
                                    (set! present true)
                                    (recur (unchecked-inc-int i))))
                              (recur (unchecked-inc-int i))))
                        (set! present true))
                    (recur (unchecked-inc-int i))))))
          (when-not present
            (let [sb (StringBuffer.)]
              (.appendEnumString this sb)
              (throw (InvalidDatatypeValueException.
                       "cvc-enumeration-valid"
                       (new Object/1 [content (.toString sb)])))))))
      (when-not (== (bit-and-int fFacetsDefined XSSimpleTypeDecl/FACET_FRACTIONDIGITS) 0)
        (let [scale (.getFractionDigits (aget fDVs fValidationDV) ob)]
          (when (> scale fFractionDigits)
            (throw (InvalidDatatypeValueException.
                     "cvc-fractionDigits-valid"
                     (new Object/1
                          [content (Integer/toString scale) (Integer/toString fFractionDigits)]))))))
      (when-not (== (bit-and-int fFacetsDefined XSSimpleTypeDecl/FACET_TOTALDIGITS) 0)
        (let [totalDigits (.getTotalDigits (aget fDVs fValidationDV) ob)]
          (when (> totalDigits fTotalDigits)
            (throw
              (InvalidDatatypeValueException. "cvc-totalDigits-valid"
                                              (new
                                                Object/1
                                                [content
                                                 (Integer/toString totalDigits)
                                                 (Integer/toString fTotalDigits)]))))))
      (let [^:mutable ^int compare 0]
        (when-not (== (bit-and-int fFacetsDefined XSSimpleTypeDecl/FACET_MAXINCLUSIVE) 0)
          (set! compare (.compare (aget fDVs fValidationDV) ob fMaxInclusive))
          (when (and (not (== compare -1)) (not (== compare 0)))
            (throw (InvalidDatatypeValueException.
                     "cvc-maxInclusive-valid"
                     (new Object/1 [content fMaxInclusive fTypeName])))))
        (when-not (== (bit-and-int fFacetsDefined XSSimpleTypeDecl/FACET_MAXEXCLUSIVE) 0)
          (set! compare (.compare (aget fDVs fValidationDV) ob fMaxExclusive))
          (when-not (== compare -1)
            (throw (InvalidDatatypeValueException.
                     "cvc-maxExclusive-valid"
                     (new Object/1 [content fMaxExclusive fTypeName])))))
        (when-not (== (bit-and-int fFacetsDefined XSSimpleTypeDecl/FACET_MININCLUSIVE) 0)
          (set! compare (.compare (aget fDVs fValidationDV) ob fMinInclusive))
          (when (and (not (== compare 1)) (not (== compare 0)))
            (throw (InvalidDatatypeValueException.
                     "cvc-minInclusive-valid"
                     (new Object/1 [content fMinInclusive fTypeName])))))
        (when-not (== (bit-and-int fFacetsDefined XSSimpleTypeDecl/FACET_MINEXCLUSIVE) 0)
          (set! compare (.compare (aget fDVs fValidationDV) ob fMinExclusive))
          (when-not (== compare 1)
            (throw (InvalidDatatypeValueException.
                     "cvc-minExclusive-valid"
                     (new Object/1 [content fMinExclusive fTypeName]))))))))

  (method ^:private checkExtraRules :throws [InvalidDatatypeValueException] ^void [this
                                                                                   ^ValidationContext context
                                                                                   ^ValidatedInfo validatedInfo]
    (let [ob (.-actualValue validatedInfo)]
      (cond
        (== fVariety XSSimpleTypeDecl/VARIETY_ATOMIC)
          (.checkExtraRules (aget fDVs fValidationDV) ob context)
        (== fVariety XSSimpleTypeDecl/VARIETY_LIST)
          (let [values (cast ListDV$ListData ob)
                memberType (.-memberType validatedInfo)
                len (.getLength values)]
            (try
              (if (== (.-fVariety fItemType) XSSimpleTypeDecl/VARIETY_UNION)
                  (let [memberTypes (cast XSSimpleTypeDecl/1 (.-memberTypes validatedInfo))]
                    (loop [^int i (unchecked-subtract-int len 1)]
                      (when (>= i 0)
                        (set! (.-actualValue validatedInfo) (.item values i))
                        (set! (.-memberType validatedInfo) (aget memberTypes i))
                        (.checkExtraRules fItemType context validatedInfo)
                        (recur (unchecked-dec-int i)))))
                  (loop [^int i (unchecked-subtract-int len 1)]
                    (when (>= i 0)
                      (set! (.-actualValue validatedInfo) (.item values i))
                      (.checkExtraRules fItemType context validatedInfo)
                      (recur (unchecked-dec-int i)))))
              (finally
                (set! (.-actualValue validatedInfo) values)
                (set! (.-memberType validatedInfo) memberType))))
        :else
          (.checkExtraRules (cast XSSimpleTypeDecl (.-memberType validatedInfo))
                            context
                            validatedInfo))))

  (method ^:private getActualValue :throws [InvalidDatatypeValueException] [this content
                                                                            ^ValidationContext context
                                                                            ^ValidatedInfo validatedInfo
                                                                            ^boolean needNormalize]
    (let [^String nvalue (if needNormalize
                             (.normalize this content fWhiteSpace)
                             (.toString content))]
      (when-not (== (bit-and-int fFacetsDefined XSSimpleTypeDecl/FACET_PATTERN) 0)
        (let [^:mutable ^RegularExpression regex nil]
          (loop [^int idx (unchecked-subtract-int (.size fPattern) 1)]
            (when (>= idx 0)
              (set! regex (cast RegularExpression (.get fPattern idx)))
              (if (not (.matches regex nvalue))
                  (throw (InvalidDatatypeValueException.
                           "cvc-pattern-valid"
                           (new Object/1 [content (.get fPatternStr idx) fTypeName])))
                  (recur (unchecked-dec-int idx)))))))
      (cond
        (== fVariety XSSimpleTypeDecl/VARIETY_ATOMIC)
          (do
            (when-not (== fPatternType SPECIAL_PATTERN_NONE)
              (let [^:mutable seenErr false]
                (cond
                  (== fPatternType SPECIAL_PATTERN_NMTOKEN)
                    (set! seenErr (not (XMLChar/isValidNmtoken nvalue)))
                  (== fPatternType SPECIAL_PATTERN_NAME)
                    (set! seenErr (not (XMLChar/isValidName nvalue)))
                  (== fPatternType SPECIAL_PATTERN_NCNAME)
                    (set! seenErr (not (XMLChar/isValidNCName nvalue))))
                (when seenErr
                  (throw (InvalidDatatypeValueException.
                           "cvc-datatype-valid.1.2.1"
                           (new Object/1 [nvalue (aget SPECIAL_PATTERN_STRING fPatternType)]))))))
            (set! (.-normalizedValue validatedInfo) nvalue)
            (let [avalue (.getActualValue (aget fDVs fValidationDV) nvalue context)]
              (set! (.-actualValue validatedInfo) avalue)
              (set! (.-actualValueType validatedInfo) fBuiltInKind)
              (set! (.-actualType validatedInfo) this)
              avalue))
        (== fVariety XSSimpleTypeDecl/VARIETY_LIST)
          (let [parsedList (StringTokenizer. nvalue " ")
                countOfTokens (.countTokens parsedList)
                avalue (new Object/1 countOfTokens)
                isUnion (== (.getVariety fItemType) XSSimpleTypeDecl/VARIETY_UNION)
                itemTypes (new short/1 (if isUnion countOfTokens 1))]
            (when-not isUnion (aset itemTypes 0 (.-fBuiltInKind fItemType)))
            (let [memberTypes (new XSSimpleTypeDecl/1 countOfTokens)]
              (loop [^int i 0]
                (when (< i countOfTokens)
                  (aset avalue
                        i
                        (.getActualValue fItemType
                                         (.nextToken parsedList)
                                         context
                                         validatedInfo
                                         false))
                  (when (and (.needFacetChecking context)
                             (and (not (== (.-fFacetsDefined fItemType) 0))
                                  (not (== (.-fFacetsDefined fItemType)
                                           XSSimpleTypeDecl/FACET_WHITESPACE))))
                    (.checkFacets fItemType validatedInfo))
                  (aset memberTypes i (cast XSSimpleTypeDecl (.-memberType validatedInfo)))
                  (if isUnion
                      (do
                        (aset itemTypes i (.-fBuiltInKind (aget memberTypes i)))
                        (recur (unchecked-inc-int i)))
                      (recur (unchecked-inc-int i)))))
              (let [v (ListDV$ListData. avalue)]
                (set! (.-actualValue validatedInfo) v)
                (set! (.-actualValueType validatedInfo)
                      (if isUnion XSConstants/LISTOFUNION_DT XSConstants/LIST_DT))
                (set! (.-memberType validatedInfo) nil)
                (set! (.-memberTypes validatedInfo) memberTypes)
                (set! (.-itemValueTypes validatedInfo)
                      (ShortListImpl. itemTypes (alength itemTypes)))
                (set! (.-normalizedValue validatedInfo) nvalue)
                (set! (.-actualType validatedInfo) this)
                v)))
        :else
          (let [^:final _content (if (and (> (alength fMemberTypes) 1) (some? content))
                                     ^Object (.toString content)
                                     content)]
            (loop [^int i 0]
              (when (< i (alength fMemberTypes))
                (try
                  (let [aValue (.getActualValue (aget fMemberTypes i)
                                                _content
                                                context
                                                validatedInfo
                                                true)]
                    (when (and (.needFacetChecking context)
                               (and (not (== (.-fFacetsDefined (aget fMemberTypes i)) 0))
                                    (not (== (.-fFacetsDefined (aget fMemberTypes i))
                                             XSSimpleTypeDecl/FACET_WHITESPACE))))
                      (.checkFacets (aget fMemberTypes i) validatedInfo))
                    (set! (.-memberType validatedInfo) (aget fMemberTypes i))
                    (set! (.-actualType validatedInfo) this)
                    (return aValue))
                  (catch InvalidDatatypeValueException invalidValue))
                (recur (unchecked-inc-int i))))
            (let [typesBuffer (StringBuffer.)
                  ^:mutable ^XSSimpleTypeDecl decl nil]
              (loop [^int i 0]
                (when (< i (alength fMemberTypes))
                  (when-not (== i 0) (.append typesBuffer " | "))
                  (set! decl (aget fMemberTypes i))
                  (when (some? (.-fTargetNamespace decl))
                    (.append typesBuffer \{)
                    (.append typesBuffer (.-fTargetNamespace decl))
                    (.append typesBuffer \}))
                  (.append typesBuffer (.-fTypeName decl))
                  (if (some? (.-fEnumeration decl))
                      (do
                        (.append typesBuffer " : ")
                        (.appendEnumString decl typesBuffer)
                        (recur (unchecked-inc-int i)))
                      (recur (unchecked-inc-int i)))))
              (throw (InvalidDatatypeValueException.
                       "cvc-datatype-valid.1.2.3"
                       (new Object/1 [content fTypeName (.toString typesBuffer)]))))))))

  (method ^:public isEqual ^boolean [this value1 value2]
    (if (nil? value1) false (.equals value1 value2)))

  (method ^:public isIdentical ^boolean [this value1 value2]
    (if (nil? value1) false (.isIdentical (aget fDVs fValidationDV) value1 value2)))

  (method ^:public ^:static normalize ^String [^String content ^short ws]
    (let [^int len (if (nil? content) 0 (.length content))]
      (if (or (== len 0) (== ws XSSimpleTypeDecl/WS_PRESERVE))
          content
          (let [sb (StringBuffer.)]
            (if (== ws XSSimpleTypeDecl/WS_REPLACE)
                (let [^:mutable ^char ch (unchecked-char 0)]
                  (loop [^int i 0]
                    (when (< i len)
                      (set! ch (.charAt content i))
                      (if (and (and (not (== ch 0x9)) (not (== ch 0xa))) (not (== ch 0xd)))
                          (do (.append sb ch) (recur (unchecked-inc-int i)))
                          (do (.append sb (unchecked-char 0x20)) (recur (unchecked-inc-int i)))))))
                (let [^:mutable ^char ch (unchecked-char 0)
                      ^:mutable ^int i 0
                      ^:mutable isLeading true]
                  (set! i 0)
                  (while (< i len)
                    (set! ch (.charAt content i))
                    (if (and (and (and (not (== ch 0x9)) (not (== ch 0xa))) (not (== ch 0xd)))
                             (not (== ch 0x20)))
                        (do (.append sb ch) (set! isLeading false))
                        (do
                          (while (< i (unchecked-subtract-int len 1))
                            (set! ch (.charAt content (unchecked-add-int i 1)))
                            (when (and (and (and (not (== ch 0x9)) (not (== ch 0xa)))
                                            (not (== ch 0xd)))
                                       (not (== ch 0x20)))
                              (break))
                            (set! i (unchecked-inc-int i)))
                          (when (and (< i (unchecked-subtract-int len 1)) (not isLeading))
                            (.append sb (unchecked-char 0x20)))))
                    (set! i (unchecked-inc-int i)))))
            (.toString sb)))))

  (method ^:protected normalize ^String [this content ^short ws]
    (when (some? content)
      (when (== (bit-and-int fFacetsDefined XSSimpleTypeDecl/FACET_PATTERN) 0)
        (let [norm_type (aget fDVNormalizeType fValidationDV)]
          (cond
            (== norm_type NORMALIZE_NONE) (return (.toString content))
            (== norm_type NORMALIZE_TRIM) (return (XMLChar/trim (.toString content))))))
      (if (not (instance? StringBuffer content))
          (let [strContent (.toString content)] (XSSimpleTypeDecl/normalize strContent ws))
          (let [sb (cast StringBuffer content)
                len (.length sb)]
            (cond
              (== len 0) ""
              (== ws XSSimpleTypeDecl/WS_PRESERVE) (.toString sb)
              :else
                (do
                  (if (== ws XSSimpleTypeDecl/WS_REPLACE)
                      (let [^:mutable ^char ch (unchecked-char 0)]
                        (loop [^int i 0]
                          (when (< i len)
                            (set! ch (.charAt sb i))
                            (if (or (or (== ch 0x9) (== ch 0xa)) (== ch 0xd))
                                (do
                                  (.setCharAt sb i (unchecked-char 0x20))
                                  (recur (unchecked-inc-int i)))
                                (recur (unchecked-inc-int i))))))
                      (let [^:mutable ^char ch (unchecked-char 0)
                            ^:mutable ^int i 0
                            ^:mutable ^int j 0
                            ^:mutable isLeading true]
                        (set! i 0)
                        (while (< i len)
                          (set! ch (.charAt sb i))
                          (if (and (and (and (not (== ch 0x9)) (not (== ch 0xa))) (not (== ch 0xd)))
                                   (not (== ch 0x20)))
                              (do
                                (.setCharAt sb j ch)
                                (set! j (unchecked-inc-int j))
                                (set! isLeading false))
                              (do
                                (while (< i (unchecked-subtract-int len 1))
                                  (set! ch (.charAt sb (unchecked-add-int i 1)))
                                  (when (and (and
                                               (and (not (== ch 0x9)) (not (== ch 0xa)))
                                               (not (== ch 0xd)))
                                             (not (== ch 0x20)))
                                    (break))
                                  (set! i (unchecked-inc-int i)))
                                (when (and (< i (unchecked-subtract-int len 1)) (not isLeading))
                                  (.setCharAt sb j (unchecked-char 0x20))
                                  (set! j (unchecked-inc-int j)))))
                          (set! i (unchecked-inc-int i)))
                        (.setLength sb j)))
                  (.toString sb)))))))

  (method reportError :throws [InvalidDatatypeFacetException] ^void [this ^String key ^Object/1 args]
    (throw (InvalidDatatypeFacetException. key args)))

  (method ^:private whiteSpaceValue ^String [this ^short ws]
    (aget WS_FACET_STRING ws))

  (method ^:public getOrdered ^short [this] fOrdered)

  (method ^:public getBounded ^boolean [this] fBounded)

  (method ^:public getFinite ^boolean [this] fFinite)

  (method ^:public getNumeric ^boolean [this] fNumeric)

  (method ^:public isDefinedFacet ^boolean [this ^short facetName]
    (cond
      (or (== fValidationDV DV_ANYSIMPLETYPE) (== fValidationDV DV_ANYATOMICTYPE)) false
      (not (== (bit-and-int fFacetsDefined facetName) 0)) true
      (not (== fPatternType SPECIAL_PATTERN_NONE)) (== facetName XSSimpleTypeDecl/FACET_PATTERN)
      (== fValidationDV DV_INTEGER)
        (or (== facetName XSSimpleTypeDecl/FACET_PATTERN)
            (== facetName XSSimpleTypeDecl/FACET_FRACTIONDIGITS))
      :else false))

  (method ^:public getDefinedFacets ^short [this]
    (cond
      (or (== fValidationDV DV_ANYSIMPLETYPE) (== fValidationDV DV_ANYATOMICTYPE))
        XSSimpleTypeDecl/FACET_NONE
      (not (== fPatternType SPECIAL_PATTERN_NONE))
        (unchecked-short (bit-or-int fFacetsDefined XSSimpleTypeDecl/FACET_PATTERN))
      (== fValidationDV DV_INTEGER)
        (unchecked-short
          (bit-or-int (bit-or-int fFacetsDefined XSSimpleTypeDecl/FACET_PATTERN)
                      XSSimpleTypeDecl/FACET_FRACTIONDIGITS))
      :else fFacetsDefined))

  (method ^:public isFixedFacet ^boolean [this ^short facetName]
    (cond
      (not (== (bit-and-int fFixedFacet facetName) 0)) true
      (== fValidationDV DV_INTEGER) (== facetName XSSimpleTypeDecl/FACET_FRACTIONDIGITS)
      :else false))

  (method ^:public getFixedFacets ^short [this]
    (if (== fValidationDV DV_INTEGER)
        (unchecked-short (bit-or-int fFixedFacet XSSimpleTypeDecl/FACET_FRACTIONDIGITS))
        fFixedFacet))

  (method ^:public getLexicalFacetValue ^String [this ^short facetName]
    (switch facetName
      XSSimpleTypeDecl/FACET_LENGTH (return (when-not (== fLength -1) (Integer/toString fLength)))
      XSSimpleTypeDecl/FACET_MINLENGTH
        (return (when-not (== fMinLength -1) (Integer/toString fMinLength)))
      XSSimpleTypeDecl/FACET_MAXLENGTH
        (return (when-not (== fMaxLength -1) (Integer/toString fMaxLength)))
      XSSimpleTypeDecl/FACET_WHITESPACE
        (do
          (when (or (== fValidationDV DV_ANYSIMPLETYPE) (== fValidationDV DV_ANYATOMICTYPE))
            (return nil))
          (return (aget WS_FACET_STRING fWhiteSpace)))
      XSSimpleTypeDecl/FACET_MAXINCLUSIVE
        (return (when (some? fMaxInclusive) (.toString fMaxInclusive)))
      XSSimpleTypeDecl/FACET_MAXEXCLUSIVE
        (return (when (some? fMaxExclusive) (.toString fMaxExclusive)))
      XSSimpleTypeDecl/FACET_MINEXCLUSIVE
        (return (when (some? fMinExclusive) (.toString fMinExclusive)))
      XSSimpleTypeDecl/FACET_MININCLUSIVE
        (return (when (some? fMinInclusive) (.toString fMinInclusive)))
      XSSimpleTypeDecl/FACET_TOTALDIGITS
        (return (when-not (== fTotalDigits -1) (Integer/toString fTotalDigits)))
      XSSimpleTypeDecl/FACET_FRACTIONDIGITS
        (do
          (when (== fValidationDV DV_INTEGER) (return "0"))
          (return (when-not (== fFractionDigits -1) (Integer/toString fFractionDigits)))))
    nil)

  (method ^:public getLexicalEnumeration ^StringList [this]
    (when (nil? fLexicalEnumeration)
      (when (nil? fEnumeration) (return StringListImpl/EMPTY_LIST))
      (let [size fEnumerationSize
            strs (new String/1 size)]
        (loop [^int i 0]
          (when (< i size)
            (aset strs i (.-normalizedValue (aget fEnumeration i)))
            (recur (unchecked-inc-int i))))
        (set! fLexicalEnumeration (StringListImpl. strs size))))
    fLexicalEnumeration)

  (method ^:public getActualEnumeration ^ObjectList [this]
    (when (nil? fActualEnumeration)
      (set! fActualEnumeration
            (anon AbstractObjectList []
              (method ^:public getLength ^int [this]
                (if (some? fEnumeration) fEnumerationSize 0))

              (method ^:public contains ^boolean [this item]
                (if (nil? fEnumeration)
                    false
                    (do
                      (loop [^int i 0]
                        (if (< i fEnumerationSize)
                            (if (.equals (.getActualValue (aget fEnumeration i)) item)
                                (return true)
                                (recur (unchecked-inc-int i)))
                            nil))
                      false)))

              (method ^:public item [this ^int index]
                (when-not (or (< index 0) (>= index (.getLength this)))
                  (.getActualValue (aget fEnumeration index)))))))
    fActualEnumeration)

  (method ^:public getEnumerationItemTypeList ^ObjectList [this]
    (when (nil? fEnumerationItemTypeList)
      (when (nil? fEnumeration) (return nil))
      (set! fEnumerationItemTypeList
            (anon AbstractObjectList []
              (method ^:public getLength ^int [this]
                (if (some? fEnumeration) fEnumerationSize 0))

              (method ^:public contains ^boolean [this item]
                (if (or (nil? fEnumeration) (not (instance? ShortList item)))
                    false
                    (do
                      (loop [^int i 0]
                        (if (< i fEnumerationSize)
                            (if (identical? (.-itemValueTypes (aget fEnumeration i)) item)
                                (return true)
                                (recur (unchecked-inc-int i)))
                            nil))
                      false)))

              (method ^:public item [this ^int index]
                (when-not (or (< index 0) (>= index (.getLength this)))
                  (.-itemValueTypes (aget fEnumeration index)))))))
    fEnumerationItemTypeList)

  (method ^:public getEnumerationTypeList ^ShortList [this]
    (when (nil? fEnumerationTypeList)
      (when (nil? fEnumeration) (return ShortListImpl/EMPTY_LIST))
      (let [list (new short/1 fEnumerationSize)]
        (loop [^int i 0]
          (when (< i fEnumerationSize)
            (aset list i (.-actualValueType (aget fEnumeration i)))
            (recur (unchecked-inc-int i))))
        (set! fEnumerationTypeList (ShortListImpl. list fEnumerationSize))))
    fEnumerationTypeList)

  (method ^:public getLexicalPattern ^StringList [this]
    (if (and (and (== fPatternType SPECIAL_PATTERN_NONE) (not (== fValidationDV DV_INTEGER)))
             (nil? fPatternStr))
        StringListImpl/EMPTY_LIST
        (do
          (when (nil? fLexicalPattern)
            (let [^int size (if (nil? fPatternStr) 0 (.size fPatternStr))
                  ^:mutable ^String/1 strs nil]
              (cond
                (== fPatternType SPECIAL_PATTERN_NMTOKEN)
                  (do (set! strs (new String/1 (unchecked-add-int size 1))) (aset strs size "\\c+"))
                (== fPatternType SPECIAL_PATTERN_NAME)
                  (do
                    (set! strs (new String/1 (unchecked-add-int size 1)))
                    (aset strs size "\\i\\c*"))
                (== fPatternType SPECIAL_PATTERN_NCNAME)
                  (do
                    (set! strs (new String/1 (unchecked-add-int size 2)))
                    (aset strs size "\\i\\c*")
                    (aset strs (unchecked-add-int size 1) "[\\i-[:]][\\c-[:]]*"))
                (== fValidationDV DV_INTEGER)
                  (do
                    (set! strs (new String/1 (unchecked-add-int size 1)))
                    (aset strs size "[\\-+]?[0-9]+"))
                :else (set! strs (new String/1 size)))
              (loop [^int i 0]
                (when (< i size)
                  (aset strs i (cast String (.get fPatternStr i)))
                  (recur (unchecked-inc-int i))))
              (set! fLexicalPattern (StringListImpl. strs (alength strs)))))
          fLexicalPattern)))

  (method ^:public getAnnotations ^XSObjectList [this]
    (if (some? fAnnotations) fAnnotations XSObjectListImpl/EMPTY_LIST))

  (method ^:private calcFundamentalFacets ^void [this]
    (.setOrdered this)
    (.setNumeric this)
    (.setBounded this)
    (.setCardinality this))

  (method ^:private setOrdered ^void [this]
    (cond
      (== fVariety XSSimpleTypeDecl/VARIETY_ATOMIC) (set! (.-fOrdered this) (.-fOrdered fBase))
      (== fVariety XSSimpleTypeDecl/VARIETY_LIST)
        (set! (.-fOrdered this) XSSimpleTypeDecl/ORDERED_FALSE)
      (== fVariety XSSimpleTypeDecl/VARIETY_UNION)
        (let [length (alength fMemberTypes)]
          (if (== length 0)
              (set! (.-fOrdered this) XSSimpleTypeDecl/ORDERED_PARTIAL)
              (let [ancestorId (.getPrimitiveDV this (.-fValidationDV (aget fMemberTypes 0)))
                    ^:mutable commonAnc (not (== ancestorId DV_ANYSIMPLETYPE))
                    ^:mutable allFalse (== (.-fOrdered (aget fMemberTypes 0))
                                           XSSimpleTypeDecl/ORDERED_FALSE)]
                (loop [^int i 1]
                  (when (and (< i (alength fMemberTypes)) (or commonAnc allFalse))
                    (when commonAnc
                      (set! commonAnc
                            (== ancestorId
                                (.getPrimitiveDV this (.-fValidationDV (aget fMemberTypes i))))))
                    (if allFalse
                        (do
                          (set! allFalse
                                (== (.-fOrdered (aget fMemberTypes i))
                                    XSSimpleTypeDecl/ORDERED_FALSE))
                          (recur (unchecked-inc-int i)))
                        (recur (unchecked-inc-int i)))))
                (cond
                  commonAnc (set! (.-fOrdered this) (.-fOrdered (aget fMemberTypes 0)))
                  allFalse (set! (.-fOrdered this) XSSimpleTypeDecl/ORDERED_FALSE)
                  :else (set! (.-fOrdered this) XSSimpleTypeDecl/ORDERED_PARTIAL)))))))

  (method ^:private setNumeric ^void [this]
    (cond
      (== fVariety XSSimpleTypeDecl/VARIETY_ATOMIC) (set! (.-fNumeric this) (.-fNumeric fBase))
      (== fVariety XSSimpleTypeDecl/VARIETY_LIST) (set! (.-fNumeric this) false)
      (== fVariety XSSimpleTypeDecl/VARIETY_UNION)
        (let [^XSSimpleType/1 memberTypes fMemberTypes]
          (loop [^int i 0]
            (if (< i (alength memberTypes))
                (if (not (.getNumeric (aget memberTypes i)))
                    (do (set! (.-fNumeric this) false) (return))
                    (recur (unchecked-inc-int i)))
                nil))
          (set! (.-fNumeric this) true))))

  (method ^:private setBounded ^void [this]
    (cond
      (== fVariety XSSimpleTypeDecl/VARIETY_ATOMIC)
        (if (and (or (not (== (bit-and-int (.-fFacetsDefined this)
                                           XSSimpleTypeDecl/FACET_MININCLUSIVE)
                              0))
                     (not (== (bit-and-int (.-fFacetsDefined this)
                                           XSSimpleTypeDecl/FACET_MINEXCLUSIVE)
                              0)))
                 (or (not (== (bit-and-int (.-fFacetsDefined this)
                                           XSSimpleTypeDecl/FACET_MAXINCLUSIVE)
                              0))
                     (not (== (bit-and-int (.-fFacetsDefined this)
                                           XSSimpleTypeDecl/FACET_MAXEXCLUSIVE)
                              0))))
            (set! (.-fBounded this) true)
            (set! (.-fBounded this) false))
      (== fVariety XSSimpleTypeDecl/VARIETY_LIST)
        (if (or (not (== (bit-and-int (.-fFacetsDefined this) XSSimpleTypeDecl/FACET_LENGTH) 0))
                (and (not (== (bit-and-int (.-fFacetsDefined this) XSSimpleTypeDecl/FACET_MINLENGTH)
                              0))
                     (not (== (bit-and-int (.-fFacetsDefined this) XSSimpleTypeDecl/FACET_MAXLENGTH)
                              0))))
            (set! (.-fBounded this) true)
            (set! (.-fBounded this) false))
      (== fVariety XSSimpleTypeDecl/VARIETY_UNION)
        (let [memberTypes (.-fMemberTypes this)
              ^:mutable ^short ancestorId 0]
          (when (> (alength memberTypes) 0)
            (set! ancestorId (.getPrimitiveDV this (.-fValidationDV (aget memberTypes 0)))))
          (loop [^int i 0]
            (if (< i (alength memberTypes))
                (if (or (not (.getBounded (aget memberTypes i)))
                        (not (== ancestorId
                                 (.getPrimitiveDV this (.-fValidationDV (aget memberTypes i))))))
                    (do (set! (.-fBounded this) false) (return))
                    (recur (unchecked-inc-int i)))
                nil))
          (set! (.-fBounded this) true))))

  (method ^:private specialCardinalityCheck ^boolean [this]
    (if (or (or (or (or (or (== (.-fValidationDV fBase) XSSimpleTypeDecl/DV_DATE)
                            (== (.-fValidationDV fBase) XSSimpleTypeDecl/DV_GYEARMONTH))
                        (== (.-fValidationDV fBase) XSSimpleTypeDecl/DV_GYEAR))
                    (== (.-fValidationDV fBase) XSSimpleTypeDecl/DV_GMONTHDAY))
                (== (.-fValidationDV fBase) XSSimpleTypeDecl/DV_GDAY))
            (== (.-fValidationDV fBase) XSSimpleTypeDecl/DV_GMONTH))
        true
        false))

  (method ^:private setCardinality ^void [this]
    (cond
      (== fVariety XSSimpleTypeDecl/VARIETY_ATOMIC)
        (cond
          (.-fFinite fBase) (set! (.-fFinite this) true)
          (or (or (not (== (bit-and-int (.-fFacetsDefined this) XSSimpleTypeDecl/FACET_LENGTH) 0))
                  (not
                    (== (bit-and-int (.-fFacetsDefined this) XSSimpleTypeDecl/FACET_MAXLENGTH) 0)))
              (not (== (bit-and-int (.-fFacetsDefined this) XSSimpleTypeDecl/FACET_TOTALDIGITS) 0)))
            (set! (.-fFinite this) true)
          (and (or (not (== (bit-and-int (.-fFacetsDefined this)
                                         XSSimpleTypeDecl/FACET_MININCLUSIVE)
                            0))
                   (not (== (bit-and-int (.-fFacetsDefined this)
                                         XSSimpleTypeDecl/FACET_MINEXCLUSIVE)
                            0)))
               (or (not (== (bit-and-int (.-fFacetsDefined this)
                                         XSSimpleTypeDecl/FACET_MAXINCLUSIVE)
                            0))
                   (not (== (bit-and-int (.-fFacetsDefined this)
                                         XSSimpleTypeDecl/FACET_MAXEXCLUSIVE)
                            0))))
            (if (or (not (== (bit-and-int (.-fFacetsDefined this)
                                          XSSimpleTypeDecl/FACET_FRACTIONDIGITS)
                             0))
                    (.specialCardinalityCheck this))
                (set! (.-fFinite this) true)
                (set! (.-fFinite this) false))
          :else (set! (.-fFinite this) false))
      (== fVariety XSSimpleTypeDecl/VARIETY_LIST)
        (if (or (not (== (bit-and-int (.-fFacetsDefined this) XSSimpleTypeDecl/FACET_LENGTH) 0))
                (and (not (== (bit-and-int (.-fFacetsDefined this) XSSimpleTypeDecl/FACET_MINLENGTH)
                              0))
                     (not (== (bit-and-int (.-fFacetsDefined this) XSSimpleTypeDecl/FACET_MAXLENGTH)
                              0))))
            (set! (.-fFinite this) true)
            (set! (.-fFinite this) false))
      (== fVariety XSSimpleTypeDecl/VARIETY_UNION)
        (let [^XSSimpleType/1 memberTypes fMemberTypes]
          (loop [^int i 0]
            (if (< i (alength memberTypes))
                (if (not (.getFinite (aget memberTypes i)))
                    (do (set! (.-fFinite this) false) (return))
                    (recur (unchecked-inc-int i)))
                nil))
          (set! (.-fFinite this) true))))

  (method ^:private getPrimitiveDV ^short [this ^short validationDV]
    (cond
      (or (or (== validationDV DV_ID) (== validationDV DV_IDREF)) (== validationDV DV_ENTITY))
        DV_STRING
      (== validationDV DV_INTEGER) DV_DECIMAL
      (and Constants/SCHEMA_1_1_SUPPORT
           (or (== validationDV DV_YEARMONTHDURATION) (== validationDV DV_DAYTIMEDURATION)))
        DV_DURATION
      :else validationDV))

  (method ^:public derivedFromType ^boolean [this ^:mutable ^XSTypeDefinition ancestor
                                             ^short derivation]
    (if (nil? ancestor)
        false
        (do
          (while (instance? XSSimpleTypeDelegate ancestor)
            (set! ancestor (.-type (cast XSSimpleTypeDelegate ancestor))))
          (if (identical? (.getBaseType ancestor) ancestor)
              true
              (let [^:mutable ^XSTypeDefinition type this]
                (while (and (not (identical? type ancestor)) (not (identical? type fAnySimpleType)))
                  (set! type (.getBaseType type)))
                (identical? type ancestor))))))

  (method ^:public derivedFrom ^boolean [this ^String ancestorNS ^String ancestorName
                                         ^short derivation]
    (cond
      (nil? ancestorName) false
      (and (.equals URI_SCHEMAFORSCHEMA ancestorNS) (.equals ANY_TYPE ancestorName)) true
      :else
        (let [^:mutable ^XSTypeDefinition type this]
          (while (and (not (and (.equals ancestorName (.getName type))
                                (or (and (nil? ancestorNS) (nil? (.getNamespace type)))
                                    (and (some? ancestorNS)
                                         (.equals ancestorNS (.getNamespace type))))))
                      (not (identical? type fAnySimpleType)))
            (set! type (.getBaseType type)))
          (not (identical? type fAnySimpleType)))))

  (method ^:public isDOMDerivedFrom ^boolean [this ^String ancestorNS ^String ancestorName
                                              ^int derivationMethod]
    (cond
      (nil? ancestorName) false
      (and (and (.equals SchemaSymbols/URI_SCHEMAFORSCHEMA ancestorNS)
                (.equals SchemaSymbols/ATTVAL_ANYTYPE ancestorName))
           (or (not (== (bit-and-int derivationMethod DERIVATION_RESTRICTION) 0))
               (== derivationMethod DERIVATION_ANY)))
        true
      :else
        (do
          (when-not (== (bit-and-int derivationMethod DERIVATION_RESTRICTION) 0)
            (when (.isDerivedByRestriction this ancestorNS ancestorName this) (return true)))
          (when-not (== (bit-and-int derivationMethod DERIVATION_LIST) 0)
            (when (.isDerivedByList this ancestorNS ancestorName this) (return true)))
          (when-not (== (bit-and-int derivationMethod DERIVATION_UNION) 0)
            (when (.isDerivedByUnion this ancestorNS ancestorName this) (return true)))
          (cond
            (and (not (== (bit-and-int derivationMethod DERIVATION_EXTENSION) 0))
                 (and (and (== (bit-and-int derivationMethod DERIVATION_RESTRICTION) 0)
                           (== (bit-and-int derivationMethod DERIVATION_LIST) 0))
                      (== (bit-and-int derivationMethod DERIVATION_UNION) 0)))
              false
            (and (== (bit-and-int derivationMethod DERIVATION_EXTENSION) 0)
                 (and (and (== (bit-and-int derivationMethod DERIVATION_RESTRICTION) 0)
                           (== (bit-and-int derivationMethod DERIVATION_LIST) 0))
                      (== (bit-and-int derivationMethod DERIVATION_UNION) 0)))
              (.isDerivedByAny this ancestorNS ancestorName this)
            :else false))))

  (method ^:private isDerivedByAny ^boolean [this ^String ancestorNS ^String ancestorName
                                             ^:mutable ^XSTypeDefinition type]
    (let [^:mutable derivedFrom false
          ^:mutable ^XSTypeDefinition oldType nil]
      (while (and (some? type) (not (identical? type oldType)))
        (when (and (.equals ancestorName (.getName type))
                   (or (and (nil? ancestorNS) (nil? (.getNamespace type)))
                       (and (some? ancestorNS) (.equals ancestorNS (.getNamespace type)))))
          (set! derivedFrom true)
          (break))
        (cond
          (.isDerivedByRestriction this ancestorNS ancestorName type) (return true)
          (.isDerivedByList this ancestorNS ancestorName type) (return true)
          (.isDerivedByUnion this ancestorNS ancestorName type) (return true))
        (set! oldType type)
        (cond
          (or (== (.getVariety (cast XSSimpleTypeDecl type)) XSSimpleTypeDecl/VARIETY_ABSENT)
              (== (.getVariety (cast XSSimpleTypeDecl type)) XSSimpleTypeDecl/VARIETY_ATOMIC))
            (set! type (.getBaseType type))
          (== (.getVariety (cast XSSimpleTypeDecl type)) XSSimpleTypeDecl/VARIETY_UNION)
            (loop [^int i 0]
              (when (< i (.getLength (.getMemberTypes (cast XSSimpleTypeDecl type))))
                (return (.isDerivedByAny this
                                         ancestorNS
                                         ancestorName
                                         (cast XSTypeDefinition
                                               (.item
                                                 (.getMemberTypes (cast XSSimpleTypeDecl type))
                                                 i))))))
          (== (.getVariety (cast XSSimpleTypeDecl type)) XSSimpleTypeDecl/VARIETY_LIST)
            (set! type (.getItemType (cast XSSimpleTypeDecl type)))))
      derivedFrom))

  (method ^:private isDerivedByRestriction ^boolean [this ^String ancestorNS ^String ancestorName
                                                     ^:mutable ^XSTypeDefinition type]
    (let [^:mutable ^XSTypeDefinition oldType nil]
      (while (and (some? type) (not (identical? type oldType)))
        (when (and (.equals ancestorName (.getName type))
                   (or (and (some? ancestorNS) (.equals ancestorNS (.getNamespace type)))
                       (and (nil? (.getNamespace type)) (nil? ancestorNS))))
          (return true))
        (set! oldType type)
        (set! type (.getBaseType type)))
      false))

  (method ^:private isDerivedByList ^boolean [this ^String ancestorNS ^String ancestorName
                                              ^XSTypeDefinition type]
    (when (and (some? type)
               (== (.getVariety (cast XSSimpleTypeDefinition type)) XSSimpleTypeDecl/VARIETY_LIST))
      (let [^XSTypeDefinition itemType (.getItemType (cast XSSimpleTypeDefinition type))]
        (when (some? itemType)
          (when (.isDerivedByRestriction this ancestorNS ancestorName itemType) (return true)))))
    false)

  (method ^:private isDerivedByUnion ^boolean [this ^String ancestorNS ^String ancestorName
                                               ^XSTypeDefinition type]
    (when (and (some? type)
               (== (.getVariety (cast XSSimpleTypeDefinition type)) XSSimpleTypeDecl/VARIETY_UNION))
      (let [memberTypes (.getMemberTypes (cast XSSimpleTypeDefinition type))]
        (loop [^int i 0]
          (if (< i (.getLength memberTypes))
              (if (some? (.item memberTypes i))
                  (if (.isDerivedByRestriction this
                                               ancestorNS
                                               ancestorName
                                               (cast XSSimpleTypeDefinition (.item memberTypes i)))
                      (return true)
                      (recur (unchecked-inc-int i)))
                  (recur (unchecked-inc-int i)))
              nil))))
    false)

  (field ^:static ^:final ^XSSimpleTypeDecl fAnySimpleType
    (XSSimpleTypeDecl. nil
                       "anySimpleType"

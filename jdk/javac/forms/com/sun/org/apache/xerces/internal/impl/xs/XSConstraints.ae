                      XSParticleDecl/PARTICLE_ELEMENT)
                      (throw (XMLSchemaException.
                               "cos-particle-restrict.2"
                               (new Object/1 ["all:choice,sequence,elt"])))
                    (throw (XMLSchemaException. "Internal-Error"
                                                (new Object/1 ["in particleValidRestriction"]))))
                XSModelGroupImpl/MODELGROUP_CHOICE
                  (switch bType
                    XSParticleDecl/PARTICLE_WILDCARD
                      (do
                        (when (== dMinEffectiveTotalRange OCCURRENCE_UNKNOWN)
                          (set! dMinEffectiveTotalRange (.minEffectiveTotalRange dParticle)))
                        (when (== dMaxEffectiveTotalRange OCCURRENCE_UNKNOWN)
                          (set! dMaxEffectiveTotalRange (.maxEffectiveTotalRange dParticle)))
                        (XSConstraints/checkNSRecurseCheckCardinality
                          dChildren
                          dMinEffectiveTotalRange
                          dMaxEffectiveTotalRange
                          dSGHandler
                          bParticle
                          bMinOccurs
                          bMaxOccurs
                          checkWCOccurrence)
                        (return bExpansionHappened))
                    XSModelGroupImpl/MODELGROUP_CHOICE
                      (do
                        (XSConstraints/checkRecurseLax
                          dChildren
                          dMinOccurs
                          dMaxOccurs
                          dSGHandler
                          bChildren
                          bMinOccurs
                          bMaxOccurs
                          bSGHandler)
                        (return bExpansionHappened))
                    (XSModelGroupImpl/MODELGROUP_ALL
                      XSModelGroupImpl/MODELGROUP_SEQUENCE
                      XSParticleDecl/PARTICLE_ELEMENT)
                      (throw (XMLSchemaException.
                               "cos-particle-restrict.2"
                               (new Object/1 ["choice:all,sequence,elt"])))
                    (throw (XMLSchemaException. "Internal-Error"
                                                (new Object/1 ["in particleValidRestriction"]))))
                XSModelGroupImpl/MODELGROUP_SEQUENCE
                  (switch bType
                    XSParticleDecl/PARTICLE_WILDCARD
                      (do
                        (when (== dMinEffectiveTotalRange OCCURRENCE_UNKNOWN)
                          (set! dMinEffectiveTotalRange (.minEffectiveTotalRange dParticle)))
                        (when (== dMaxEffectiveTotalRange OCCURRENCE_UNKNOWN)
                          (set! dMaxEffectiveTotalRange (.maxEffectiveTotalRange dParticle)))
                        (XSConstraints/checkNSRecurseCheckCardinality
                          dChildren
                          dMinEffectiveTotalRange
                          dMaxEffectiveTotalRange
                          dSGHandler
                          bParticle
                          bMinOccurs
                          bMaxOccurs
                          checkWCOccurrence)
                        (return bExpansionHappened))
                    XSModelGroupImpl/MODELGROUP_ALL
                      (do
                        (XSConstraints/checkRecurseUnordered
                          dChildren
                          dMinOccurs
                          dMaxOccurs
                          dSGHandler
                          bChildren
                          bMinOccurs
                          bMaxOccurs
                          bSGHandler)
                        (return bExpansionHappened))
                    XSModelGroupImpl/MODELGROUP_SEQUENCE
                      (do
                        (XSConstraints/checkRecurse
                          dChildren
                          dMinOccurs
                          dMaxOccurs
                          dSGHandler
                          bChildren
                          bMinOccurs
                          bMaxOccurs
                          bSGHandler)
                        (return bExpansionHappened))
                    XSModelGroupImpl/MODELGROUP_CHOICE
                      (let [min1 (unchecked-multiply-int dMinOccurs (.size dChildren))
                            ^int max1 (if (== dMaxOccurs SchemaSymbols/OCCURRENCE_UNBOUNDED)
                                          dMaxOccurs
                                          (unchecked-multiply-int dMaxOccurs (.size dChildren)))]
                        (XSConstraints/checkMapAndSum
                          dChildren
                          min1
                          max1
                          dSGHandler
                          bChildren
                          bMinOccurs
                          bMaxOccurs
                          bSGHandler)
                        (return bExpansionHappened))
                    XSParticleDecl/PARTICLE_ELEMENT
                      (throw (XMLSchemaException.
                               "cos-particle-restrict.2"
                               (new Object/1 ["seq:elt"])))
                    (throw (XMLSchemaException. "Internal-Error"
                                                (new Object/1 ["in particleValidRestriction"])))))
              bExpansionHappened))))))

  (method ^:private ^:static addElementToParticleVector ^void [^{:tag (List XSParticleDecl)} v
                                                               ^XSElementDecl d]
    (let [p (XSParticleDecl.)]
      (set! (.-fValue p) d)
      (set! (.-fType p) XSParticleDecl/PARTICLE_ELEMENT)
      (.add v p)))

  (method ^:private ^:static getNonUnaryGroup ^XSParticleDecl [^XSParticleDecl p]
    (cond
      (or (== (.-fType p) XSParticleDecl/PARTICLE_ELEMENT)
          (== (.-fType p) XSParticleDecl/PARTICLE_WILDCARD))
        p
      (and (and (and (== (.-fMinOccurs p) 1) (== (.-fMaxOccurs p) 1)) (some? (.-fValue p)))
           (== (.-fParticleCount (cast XSModelGroupImpl (.-fValue p))) 1))
        (XSConstraints/getNonUnaryGroup
          (aget (.-fParticles (cast XSModelGroupImpl (.-fValue p))) 0))
      :else p))

  (method ^:private ^:static removePointlessChildren ^{:tag (List XSParticleDecl)} [^XSParticleDecl p]
    (when-not (or (== (.-fType p) XSParticleDecl/PARTICLE_ELEMENT)
                  (== (.-fType p) XSParticleDecl/PARTICLE_WILDCARD))
      (let [^{:tag (List XSParticleDecl)} children (ArrayList.)
            group (cast XSModelGroupImpl (.-fValue p))]
        (loop [^int i 0]
          (when (< i (.-fParticleCount group))
            (XSConstraints/gatherChildren (.-fCompositor group)
                                          (aget (.-fParticles group) i)
                                          children)
            (recur (unchecked-inc-int i))))
        children)))

  (method ^:private ^:static gatherChildren ^void [^int parentType ^XSParticleDecl p
                                                   ^{:tag (List XSParticleDecl)} children]
    (let [min (.-fMinOccurs p)
          max (.-fMaxOccurs p)
          ^:mutable ^int type (.-fType p)]
      (when (== type XSParticleDecl/PARTICLE_MODELGROUP)
        (set! type (.-fCompositor (cast XSModelGroupImpl (.-fValue p)))))
      (cond
        (or (== type XSParticleDecl/PARTICLE_ELEMENT) (== type XSParticleDecl/PARTICLE_WILDCARD))
          (.add children p)
        (not (and (== min 1) (== max 1))) (.add children p)
        (== parentType type)
          (let [group (cast XSModelGroupImpl (.-fValue p))]
            (loop [^int i 0]
              (when (< i (.-fParticleCount group))
                (XSConstraints/gatherChildren type (aget (.-fParticles group) i) children)
                (recur (unchecked-inc-int i)))))
        :else (when-not (.isEmpty p) (.add children p)))))

  (method ^:private ^:static checkNameAndTypeOK :throws [XMLSchemaException] ^void [^XSElementDecl dElement
                                                                                    ^int dMin
                                                                                    ^int dMax
                                                                                    ^XSElementDecl bElement
                                                                                    ^int bMin
                                                                                    ^int bMax]
    (when (or (not (identical? (.-fName dElement) (.-fName bElement)))
              (not (identical? (.-fTargetNamespace dElement) (.-fTargetNamespace bElement))))
      (throw (XMLSchemaException. "rcase-NameAndTypeOK.1"
                                  (new Object/1
                                       [(.-fName dElement)
                                        (.-fTargetNamespace dElement)
                                        (.-fName bElement)
                                        (.-fTargetNamespace bElement)]))))
    (when (and (not (.getNillable bElement)) (.getNillable dElement))
      (throw (XMLSchemaException. "rcase-NameAndTypeOK.2" (new Object/1 [(.-fName dElement)]))))
    (when-not (XSConstraints/checkOccurrenceRange dMin dMax bMin bMax)
      (throw (XMLSchemaException. "rcase-NameAndTypeOK.3"
                                  (new Object/1
                                       [(.-fName dElement)
                                        (Integer/toString dMin)
                                        (if (== dMax SchemaSymbols/OCCURRENCE_UNBOUNDED)
                                            "unbounded"
                                            ^Object (Integer/toString dMax))
                                        (Integer/toString bMin)
                                        (if (== bMax SchemaSymbols/OCCURRENCE_UNBOUNDED)
                                            "unbounded"
                                            ^Object (Integer/toString bMax))]))))
    (when (== (.getConstraintType bElement) XSConstants/VC_FIXED)
      (when-not (== (.getConstraintType dElement) XSConstants/VC_FIXED)
        (throw
          (XMLSchemaException. "rcase-NameAndTypeOK.4.a"
                               (new Object/1
                                    [(.-fName dElement) (.stringValue (.-fDefault bElement))]))))
      (let [^:mutable isSimple false]
        (when (or (== (.getTypeCategory (.-fType dElement)) XSTypeDefinition/SIMPLE_TYPE)
                  (== (.-fContentType (cast XSComplexTypeDecl (.-fType dElement)))
                      XSComplexTypeDecl/CONTENTTYPE_SIMPLE))
          (set! isSimple true))
        (when (or (and (not isSimple)
                       (not (.equals (.-normalizedValue (.-fDefault bElement))
                                     (.-normalizedValue (.-fDefault dElement)))))
                  (and isSimple
                       (not (.equals (.-actualValue (.-fDefault bElement))
                                     (.-actualValue (.-fDefault dElement))))))
          (throw (XMLSchemaException. "rcase-NameAndTypeOK.4.b"
                                      (new Object/1
                                           [(.-fName dElement)
                                            (.stringValue (.-fDefault dElement))
                                            (.stringValue (.-fDefault bElement))]))))))
    (XSConstraints/checkIDConstraintRestriction dElement bElement)
    (let [^int blockSet1 (.-fBlock dElement)
          ^int blockSet2 (.-fBlock bElement)]
      (when (or (not (== (bit-and-int blockSet1 blockSet2) blockSet2))
                (and (== blockSet1 XSConstants/DERIVATION_NONE)
                     (not (== blockSet2 XSConstants/DERIVATION_NONE))))
        (throw (XMLSchemaException. "rcase-NameAndTypeOK.6" (new Object/1 [(.-fName dElement)]))))
      (when-not (XSConstraints/checkTypeDerivationOk
                  (.-fType dElement)
                  (.-fType bElement)
                  (unchecked-short
                    (bit-or-int (bit-or-int XSConstants/DERIVATION_EXTENSION
                                            XSConstants/DERIVATION_LIST)
                                XSConstants/DERIVATION_UNION)))
        (throw (XMLSchemaException. "rcase-NameAndTypeOK.7"
                                    (new Object/1
                                         [(.-fName dElement)
                                          (.getName (.-fType dElement))
                                          (.getName (.-fType bElement))]))))))

  (method ^:private ^:static checkIDConstraintRestriction :throws [XMLSchemaException] ^void [^XSElementDecl derivedElemDecl
                                                                                              ^XSElementDecl baseElemDecl])

  (method ^:private ^:static checkOccurrenceRange ^boolean [^int min1 ^int max1 ^int min2 ^int max2]
    (if (and (>= min1 min2)
             (or (== max2 SchemaSymbols/OCCURRENCE_UNBOUNDED)
                 (and (not (== max1 SchemaSymbols/OCCURRENCE_UNBOUNDED)) (<= max1 max2))))
        true
        false))

  (method ^:private ^:static checkNSCompat :throws [XMLSchemaException] ^void [^XSElementDecl elem
                                                                               ^int min1 ^int max1
                                                                               ^XSWildcardDecl wildcard
                                                                               ^int min2 ^int max2
                                                                               ^boolean checkWCOccurrence]
    (when (and checkWCOccurrence (not (XSConstraints/checkOccurrenceRange min1 max1 min2 max2)))
      (throw (XMLSchemaException. "rcase-NSCompat.2"
                                  (new Object/1
                                       [(.-fName elem)
                                        (Integer/toString min1)
                                        (if (== max1 SchemaSymbols/OCCURRENCE_UNBOUNDED)
                                            "unbounded"
                                            ^Object (Integer/toString max1))
                                        (Integer/toString min2)
                                        (if (== max2 SchemaSymbols/OCCURRENCE_UNBOUNDED)
                                            "unbounded"
                                            ^Object (Integer/toString max2))]))))
    (when-not (.allowNamespace wildcard (.-fTargetNamespace elem))
      (throw (XMLSchemaException. "rcase-NSCompat.1"
                                  (new Object/1 [(.-fName elem) (.-fTargetNamespace elem)])))))

  (method ^:private ^:static checkNSSubset :throws [XMLSchemaException] ^void [^XSWildcardDecl dWildcard
                                                                               ^int min1 ^int max1
                                                                               ^XSWildcardDecl bWildcard
                                                                               ^int min2 ^int max2]
    (when-not (XSConstraints/checkOccurrenceRange min1 max1 min2 max2)
      (throw (XMLSchemaException. "rcase-NSSubset.2"
                                  (new Object/1
                                       [(Integer/toString min1)
                                        (if (== max1 SchemaSymbols/OCCURRENCE_UNBOUNDED)
                                            "unbounded"
                                            ^Object (Integer/toString max1))
                                        (Integer/toString min2)
                                        (if (== max2 SchemaSymbols/OCCURRENCE_UNBOUNDED)
                                            "unbounded"
                                            ^Object (Integer/toString max2))]))))
    (when-not (.isSubsetOf dWildcard bWildcard)
      (throw (XMLSchemaException. "rcase-NSSubset.1" nil)))
    (when (.weakerProcessContents dWildcard bWildcard)
      (throw (XMLSchemaException. "rcase-NSSubset.3"
                                  (new Object/1
                                       [(.getProcessContentsAsString dWildcard)
                                        (.getProcessContentsAsString bWildcard)])))))

  (method ^:private ^:static checkNSRecurseCheckCardinality :throws [XMLSchemaException] ^void [^{:tag (List XSParticleDecl)} children
                                                                                                ^int min1
                                                                                                ^int max1
                                                                                                ^SubstitutionGroupHandler dSGHandler
                                                                                                ^XSParticleDecl wildcard
                                                                                                ^int min2
                                                                                                ^int max2
                                                                                                ^boolean checkWCOccurrence]
    (when (and checkWCOccurrence (not (XSConstraints/checkOccurrenceRange min1 max1 min2 max2)))
      (throw (XMLSchemaException. "rcase-NSRecurseCheckCardinality.2"
                                  (new Object/1
                                       [(Integer/toString min1)
                                        (if (== max1 SchemaSymbols/OCCURRENCE_UNBOUNDED)
                                            "unbounded"
                                            ^Object (Integer/toString max1))
                                        (Integer/toString min2)
                                        (if (== max2 SchemaSymbols/OCCURRENCE_UNBOUNDED)
                                            "unbounded"
                                            ^Object (Integer/toString max2))]))))
    (let [count (.size children)]
      (try
        (loop [^int i 0]
          (when (< i count)
            (let [particle1 (cast XSParticleDecl (.get children i))]
              (XSConstraints/particleValidRestriction particle1 dSGHandler wildcard nil false)
              (recur (unchecked-inc-int i)))))
        (catch XMLSchemaException e
          (throw (XMLSchemaException. "rcase-NSRecurseCheckCardinality.1" nil))))))

  (method ^:private ^:static checkRecurse :throws [XMLSchemaException] ^void [^{:tag (List XSParticleDecl)} dChildren
                                                                              ^int min1 ^int max1
                                                                              ^SubstitutionGroupHandler dSGHandler
                                                                              ^{:tag (List XSParticleDecl)} bChildren
                                                                              ^int min2 ^int max2
                                                                              ^SubstitutionGroupHandler bSGHandler]
    (when-not (XSConstraints/checkOccurrenceRange min1 max1 min2 max2)
      (throw (XMLSchemaException. "rcase-Recurse.1"
                                  (new Object/1
                                       [(Integer/toString min1)
                                        (if (== max1 SchemaSymbols/OCCURRENCE_UNBOUNDED)
                                            "unbounded"
                                            ^Object (Integer/toString max1))
                                        (Integer/toString min2)
                                        (if (== max2 SchemaSymbols/OCCURRENCE_UNBOUNDED)
                                            "unbounded"
                                            ^Object (Integer/toString max2))]))))
    (let [count1 (.size dChildren)
          count2 (.size bChildren)
          ^:mutable ^int current 0]
      (label :label
        (loop [^int i 0]
          (when (< i count1)
            (let [particle1 (cast XSParticleDecl (.get dChildren i))]
              (loop [^int j current]
                (when (< j count2)
                  (let [particle2 (cast XSParticleDecl (.get bChildren j))]
                    (set! current (unchecked-add-int current 1))
                    (try
                      (XSConstraints/particleValidRestriction
                        particle1
                        dSGHandler
                        particle2
                        bSGHandler)
                      (continue :label (unchecked-inc-int i))
                      (catch XMLSchemaException e
                        (when-not (.emptiable particle2)
                          (throw (XMLSchemaException. "rcase-Recurse.2" nil)))))
                    (recur (unchecked-inc-int j)))))
              (throw (XMLSchemaException. "rcase-Recurse.2" nil))))))
      (loop [^int j current]
        (when (< j count2)
          (let [particle2 (cast XSParticleDecl (.get bChildren j))]
            (if (not (.emptiable particle2))
                (throw (XMLSchemaException. "rcase-Recurse.2" nil))
                (recur (unchecked-inc-int j))))))))

  (method ^:private ^:static checkRecurseUnordered :throws [XMLSchemaException] ^void [^{:tag (List XSParticleDecl)} dChildren
                                                                                       ^int min1
                                                                                       ^int max1
                                                                                       ^SubstitutionGroupHandler dSGHandler
                                                                                       ^{:tag (List XSParticleDecl)} bChildren
                                                                                       ^int min2
                                                                                       ^int max2
                                                                                       ^SubstitutionGroupHandler bSGHandler]
    (when-not (XSConstraints/checkOccurrenceRange min1 max1 min2 max2)
      (throw (XMLSchemaException. "rcase-RecurseUnordered.1"
                                  (new Object/1
                                       [(Integer/toString min1)
                                        (if (== max1 SchemaSymbols/OCCURRENCE_UNBOUNDED)
                                            "unbounded"
                                            ^Object (Integer/toString max1))
                                        (Integer/toString min2)
                                        (if (== max2 SchemaSymbols/OCCURRENCE_UNBOUNDED)
                                            "unbounded"
                                            ^Object (Integer/toString max2))]))))
    (let [count1 (.size dChildren)
          count2 (.size bChildren)
          foundIt (new boolean/1 count2)]
      (label :label
        (loop [^int i 0]
          (when (< i count1)
            (let [particle1 (cast XSParticleDecl (.get dChildren i))]
              (loop [^int j 0]
                (when (< j count2)
                  (let [particle2 (cast XSParticleDecl (.get bChildren j))]
                    (try
                      (XSConstraints/particleValidRestriction
                        particle1
                        dSGHandler
                        particle2
                        bSGHandler)
                      (if (aget foundIt j)
                          (throw (XMLSchemaException. "rcase-RecurseUnordered.2" nil))
                          (aset foundIt j true))
                      (continue :label (unchecked-inc-int i))
                      (catch XMLSchemaException e))
                    (recur (unchecked-inc-int j)))))
              (throw (XMLSchemaException. "rcase-RecurseUnordered.2" nil))))))
      (loop [^int j 0]
        (when (< j count2)
          (let [particle2 (cast XSParticleDecl (.get bChildren j))]
            (if (and (not (aget foundIt j)) (not (.emptiable particle2)))
                (throw (XMLSchemaException. "rcase-RecurseUnordered.2" nil))
                (recur (unchecked-inc-int j))))))))

  (method ^:private ^:static checkRecurseLax :throws [XMLSchemaException] ^void [^{:tag (List XSParticleDecl)} dChildren
                                                                                 ^int min1 ^int max1
                                                                                 ^SubstitutionGroupHandler dSGHandler
                                                                                 ^{:tag (List XSParticleDecl)} bChildren
                                                                                 ^int min2 ^int max2
                                                                                 ^SubstitutionGroupHandler bSGHandler]
    (when-not (XSConstraints/checkOccurrenceRange min1 max1 min2 max2)
      (throw (XMLSchemaException. "rcase-RecurseLax.1"
                                  (new Object/1
                                       [(Integer/toString min1)
                                        (if (== max1 SchemaSymbols/OCCURRENCE_UNBOUNDED)
                                            "unbounded"
                                            ^Object (Integer/toString max1))
                                        (Integer/toString min2)
                                        (if (== max2 SchemaSymbols/OCCURRENCE_UNBOUNDED)
                                            "unbounded"
                                            ^Object (Integer/toString max2))]))))
    (let [count1 (.size dChildren)
          count2 (.size bChildren)
          ^:mutable ^int current 0]
      (label :label
        (loop [^int i 0]
          (when (< i count1)
            (let [particle1 (cast XSParticleDecl (.get dChildren i))]
              (loop [^int j current]
                (when (< j count2)
                  (let [particle2 (cast XSParticleDecl (.get bChildren j))]
                    (set! current (unchecked-add-int current 1))
                    (try
                      (when (XSConstraints/particleValidRestriction
                              particle1
                              dSGHandler
                              particle2
                              bSGHandler)
                        (set! current (unchecked-dec-int current)))
                      (continue :label (unchecked-inc-int i))
                      (catch XMLSchemaException e))
                    (recur (unchecked-inc-int j)))))
              (throw (XMLSchemaException. "rcase-RecurseLax.2" nil))))))))

  (method ^:private ^:static checkMapAndSum :throws [XMLSchemaException] ^void [^{:tag (List XSParticleDecl)} dChildren
                                                                                ^int min1 ^int max1
                                                                                ^SubstitutionGroupHandler dSGHandler
                                                                                ^{:tag (List XSParticleDecl)} bChildren
                                                                                ^int min2 ^int max2
                                                                                ^SubstitutionGroupHandler bSGHandler]
    (when-not (XSConstraints/checkOccurrenceRange min1 max1 min2 max2)
      (throw (XMLSchemaException. "rcase-MapAndSum.2"
                                  (new Object/1
                                       [(Integer/toString min1)
                                        (if (== max1 SchemaSymbols/OCCURRENCE_UNBOUNDED)
                                            "unbounded"
                                            ^Object (Integer/toString max1))
                                        (Integer/toString min2)
                                        (if (== max2 SchemaSymbols/OCCURRENCE_UNBOUNDED)
                                            "unbounded"
                                            ^Object (Integer/toString max2))]))))
    (let [count1 (.size dChildren)
          count2 (.size bChildren)]
      (label :label
        (loop [^int i 0]
          (when (< i count1)
            (let [particle1 (cast XSParticleDecl (.get dChildren i))]
              (loop [^int j 0]
                (when (< j count2)
                  (let [particle2 (cast XSParticleDecl (.get bChildren j))]
                    (try
                      (XSConstraints/particleValidRestriction
                        particle1
                        dSGHandler
                        particle2
                        bSGHandler)
                      (continue :label (unchecked-inc-int i))
                      (catch XMLSchemaException e))
                    (recur (unchecked-inc-int j)))))
              (throw (XMLSchemaException. "rcase-MapAndSum.1" nil))))))))

  (method ^:public ^:static overlapUPA ^boolean [^XSElementDecl element1 ^XSElementDecl element2
                                                 ^SubstitutionGroupHandler sgHandler]
    (if (and (identical? (.-fName element1) (.-fName element2))
             (identical? (.-fTargetNamespace element1) (.-fTargetNamespace element2)))
        true
        (let [^:mutable subGroup (.getSubstitutionGroup sgHandler element1)]
          (loop [^int i (unchecked-subtract-int (alength subGroup) 1)]
            (if (>= i 0)
                (if (and (identical? (.-fName (aget subGroup i)) (.-fName element2))
                         (identical? (.-fTargetNamespace (aget subGroup i))
                                     (.-fTargetNamespace element2)))
                    (return true)
                    (recur (unchecked-dec-int i)))
                nil))
          (set! subGroup (.getSubstitutionGroup sgHandler element2))
          (loop [^int i (unchecked-subtract-int (alength subGroup) 1)]
            (if (>= i 0)
                (if (and (identical? (.-fName (aget subGroup i)) (.-fName element1))
                         (identical? (.-fTargetNamespace (aget subGroup i))
                                     (.-fTargetNamespace element1)))
                    (return true)
                    (recur (unchecked-dec-int i)))
                nil))
          false)))

  (method ^:public ^:static overlapUPA ^boolean [^XSElementDecl element ^XSWildcardDecl wildcard
                                                 ^SubstitutionGroupHandler sgHandler]
    (if (.allowNamespace wildcard (.-fTargetNamespace element))
        true
        (let [subGroup (.getSubstitutionGroup sgHandler element)]
          (loop [^int i (unchecked-subtract-int (alength subGroup) 1)]
            (if (>= i 0)
                (if (.allowNamespace wildcard (.-fTargetNamespace (aget subGroup i)))
                    (return true)
                    (recur (unchecked-dec-int i)))
                nil))
          false)))

  (method ^:public ^:static overlapUPA ^boolean [^XSWildcardDecl wildcard1 ^XSWildcardDecl wildcard2]
    (let [intersect (.performIntersectionWith wildcard1 wildcard2 (.-fProcessContents wildcard1))]
      (if (or (or (nil? intersect) (not (== (.-fType intersect) XSWildcardDecl/NSCONSTRAINT_LIST)))
              (not (== (alength (.-fNamespaceList intersect)) 0)))
          true
          false)))

  (method ^:public ^:static overlapUPA ^boolean [decl1 decl2 ^SubstitutionGroupHandler sgHandler]
    (cond
      (instance? XSElementDecl decl1)
        (if (instance? XSElementDecl decl2)
            (XSConstraints/overlapUPA (cast XSElementDecl decl1)
                                      (cast XSElementDecl decl2)
                                      sgHandler)
            (XSConstraints/overlapUPA (cast XSElementDecl decl1)
                                      (cast XSWildcardDecl decl2)
                                      sgHandler))
      (instance? XSElementDecl decl2)
        (XSConstraints/overlapUPA (cast XSElementDecl decl2) (cast XSWildcardDecl decl1) sgHandler)
      :else (XSConstraints/overlapUPA (cast XSWildcardDecl decl1) (cast XSWildcardDecl decl2)))))

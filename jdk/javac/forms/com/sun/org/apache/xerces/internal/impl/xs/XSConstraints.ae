  (method ^:public ^:static ElementDefaultValidImmediate [^XSTypeDefinition type ^String value
                                                          ^ValidationContext context
                                                          ^ValidatedInfo vinfo]
    (let [^:mutable ^XSSimpleType dv nil]
      (if (== (.getTypeCategory type) XSTypeDefinition/SIMPLE_TYPE)
          (set! dv (cast XSSimpleType type))
          (let [ctype (cast XSComplexTypeDecl type)]
            (cond
              (== (.-fContentType ctype) XSComplexTypeDecl/CONTENTTYPE_SIMPLE)
                (set! dv (.-fXSSimpleType ctype))
              (== (.-fContentType ctype) XSComplexTypeDecl/CONTENTTYPE_MIXED)
                (when-not (.emptiable (cast XSParticleDecl (.getParticle ctype))) (return nil))
              :else (return nil))))
      (let [^:mutable ^Object actualValue nil]
        (when (nil? dv) (set! dv STRING_TYPE))
        (try
          (set! actualValue (.validate dv value context vinfo))
          (when (some? vinfo) (set! actualValue (.validate dv (.stringValue vinfo) context vinfo)))
          (catch InvalidDatatypeValueException ide (return nil)))
        actualValue)))


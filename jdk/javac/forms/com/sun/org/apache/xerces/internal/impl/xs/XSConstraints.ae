  (method ^:public ^:static checkElementDeclsConsistent :throws [XMLSchemaException] ^void [^XSComplexTypeDecl type
                                                                                            ^XSParticleDecl particle
                                                                                            ^SymbolHash elemDeclHash
                                                                                            ^SubstitutionGroupHandler sgHandler]
    (let [^int pType (.-fType particle)]
      (when-not (== pType XSParticleDecl/PARTICLE_WILDCARD)
        (if (== pType XSParticleDecl/PARTICLE_ELEMENT)
            (let [elem (cast XSElementDecl (.-fValue particle))]
              (XSConstraints/findElemInTable type elem elemDeclHash)
              (when (== (.-fScope elem) XSConstants/SCOPE_GLOBAL)
                (let [subGroup (.getSubstitutionGroup sgHandler elem)]
                  (loop [^int i 0]
                    (when (< i (alength subGroup))
                      (XSConstraints/findElemInTable type (aget subGroup i) elemDeclHash)
                      (recur (unchecked-inc-int i)))))))
            (let [group (cast XSModelGroupImpl (.-fValue particle))]
              (loop [^int i 0]
                (when (< i (.-fParticleCount group))
                  (XSConstraints/checkElementDeclsConsistent
                    type
                    (aget (.-fParticles group) i)
                    elemDeclHash
                    sgHandler)
                  (recur (unchecked-inc-int i)))))))))

  (method ^:public ^:static findElemInTable :throws [XMLSchemaException] ^void [^XSComplexTypeDecl type
                                                                                ^XSElementDecl elem
                                                                                ^SymbolHash elemDeclHash]
    (let [name (java-str (.-fName elem) "," (.-fTargetNamespace elem))
          ^:mutable ^XSElementDecl existingElem nil]
      (if (nil? (set! existingElem (cast XSElementDecl (.get elemDeclHash name))))
          (.put elemDeclHash name elem)
          (when-not (identical? elem existingElem)
            (when-not (identical? (.-fType elem) (.-fType existingElem))
              (throw (XMLSchemaException. "cos-element-consistent"
                                          (new Object/1 [(.-fName type) (.-fName elem)]))))))))


                                    (.append buffer (unchecked-char ch)))
                                (set! previous (Token/createString nil))
                                (.set (.-children this) (unchecked-subtract-int size 1) previous)))
                            (do
                              (set! buffer
                                    (StringBuilder.
                                      (unchecked-add-int
                                        (.length (.getString previous))
                                        nextMaxLength)))
                              (.append buffer (.getString previous))))
                        (if (== (.-type tok) UnionToken/CHAR)
                            (let [ch (.getChar tok)]
                              (if (>= ch 0x10000)
                                  (.append buffer (REUtil/decomposeToSurrogates ch))
                                  (.append buffer (unchecked-char ch))))
                            (.append buffer (.getString tok)))
                        (set! (.-string (cast StringToken previous)) (String. buffer))))))))))

    (method size ^int [this]
      (if (nil? (.-children this)) 0 (.size (.-children this))))

    (method getChild ^Token [this ^int index]
      (cast Token (.get (.-children this) index)))

    (method ^:public toString ^String [this ^int options]
      (let [^:mutable ^String ret nil]
        (if (== (.-type this) UnionToken/CONCAT)
            (do
              (if (== (.size (.-children this)) 2)
                  (let [ch (.getChild this 0)
                        ch2 (.getChild this 1)]
                    (arbace.core/cond
                      (and (== (.-type ch2) UnionToken/CLOSURE) (identical? (.getChild ch2 0) ch))
                      (set! ret (java-str (.toString ch options) "+"))
                      (and (== (.-type ch2) UnionToken/NONGREEDYCLOSURE)
                           (identical? (.getChild ch2 0) ch))
                      (set! ret (java-str (.toString ch options) "+?"))
                      :else
                      (set! ret (java-str (.toString ch options) (.toString ch2 options)))))
                  (let [sb (StringBuilder.)]
                    (.forEach (.stream (.-children this))
                              (lambda Consumer ^void [^Token children1]
                                (.append sb (.toString children1 options))))
                    (set! ret (.toString sb))))
              ret)
            (do
              (arbace.core/cond
                (and (== (.size (.-children this)) 2)
                     (== (.-type (.getChild this 1)) UnionToken/EMPTY))
                (set! ret (java-str (.toString (.getChild this 0) options) "?"))
                (and (== (.size (.-children this)) 2)
                     (== (.-type (.getChild this 0)) UnionToken/EMPTY))
                (set! ret (java-str (.toString (.getChild this 1) options) "??"))
                :else
                (let [sb (StringBuilder.)]
                  (.append sb (.toString (cast Token (.get (.-children this) 0)) options))
                  (loop [^int i 1]
                    (when (< i (.size (.-children this)))
                      (.append sb \|)
                      (.append sb (.toString (cast Token (.get (.-children this) i)) options))
                      (recur (unchecked-inc-int i))))
                  (set! ret (.toString sb))))
              ret))))

    (method ^:private writeObject :throws [IOException] ^void [this ^ObjectOutputStream out]
      (let [^{:tag (Vector Token)} vChildren (when (some? children) (Vector. children))
            pf (.putFields out)]
        (.put pf "children" vChildren)
        (.writeFields out)))

    (method ^:private readObject :throws [IOException ClassNotFoundException] ^void [this
                                                                                     ^ObjectInputStream in]
      (let [gf (.readFields in)
            ^{:tag (Vector Token)} vChildren (cast Vector (.get gf "children" nil))]
        (when (some? vChildren) (set! children (ArrayList. vChildren)))))))

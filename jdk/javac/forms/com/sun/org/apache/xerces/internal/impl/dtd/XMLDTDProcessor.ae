    (when fValidation (set! fDTDElementDeclName elementName) (.clear fMixedElementTypes))
    (when (some? fDTDGrammar) (.startContentModel fDTDGrammar elementName augs))
    (when (some? fDTDContentModelHandler)
      (.startContentModel fDTDContentModelHandler elementName augs)))

  (method ^:public any :throws [XNIException] ^void [this ^Augmentations augs]
    (when (some? fDTDGrammar) (.any fDTDGrammar augs))
    (when (some? fDTDContentModelHandler) (.any fDTDContentModelHandler augs)))

  (method ^:public empty :throws [XNIException] ^void [this ^Augmentations augs]
    (when (some? fDTDGrammar) (.empty fDTDGrammar augs))
    (when (some? fDTDContentModelHandler) (.empty fDTDContentModelHandler augs)))

  (method ^:public startGroup :throws [XNIException] ^void [this ^Augmentations augs]
    (set! fMixed false)
    (when (some? fDTDGrammar) (.startGroup fDTDGrammar augs))
    (when (some? fDTDContentModelHandler) (.startGroup fDTDContentModelHandler augs)))

  (method ^:public pcdata ^void [this ^Augmentations augs]
    (set! fMixed true)
    (when (some? fDTDGrammar) (.pcdata fDTDGrammar augs))
    (when (some? fDTDContentModelHandler) (.pcdata fDTDContentModelHandler augs)))

  (method ^:public element :throws [XNIException] ^void [this ^String elementName
                                                         ^Augmentations augs]
    (when (and fMixed fValidation)
      (if (.contains fMixedElementTypes elementName)
          (.reportError fErrorReporter
                        XMLMessageFormatter/XML_DOMAIN
                        "DuplicateTypeInMixedContent"
                        (new Object/1 [fDTDElementDeclName elementName])
                        XMLErrorReporter/SEVERITY_ERROR)
          (.add fMixedElementTypes elementName)))
    (when (some? fDTDGrammar) (.element fDTDGrammar elementName augs))
    (when (some? fDTDContentModelHandler) (.element fDTDContentModelHandler elementName augs)))

  (method ^:public separator :throws [XNIException] ^void [this ^short separator ^Augmentations augs]
    (when (some? fDTDGrammar) (.separator fDTDGrammar separator augs))
    (when (some? fDTDContentModelHandler) (.separator fDTDContentModelHandler separator augs)))

  (method ^:public occurrence :throws [XNIException] ^void [this ^short occurrence
                                                            ^Augmentations augs]
    (when (some? fDTDGrammar) (.occurrence fDTDGrammar occurrence augs))
    (when (some? fDTDContentModelHandler) (.occurrence fDTDContentModelHandler occurrence augs)))

  (method ^:public endGroup :throws [XNIException] ^void [this ^Augmentations augs]
    (when (some? fDTDGrammar) (.endGroup fDTDGrammar augs))
    (when (some? fDTDContentModelHandler) (.endGroup fDTDContentModelHandler augs)))

  (method ^:public endContentModel :throws [XNIException] ^void [this ^Augmentations augs]
    (when (some? fDTDGrammar) (.endContentModel fDTDGrammar augs))
    (when (some? fDTDContentModelHandler) (.endContentModel fDTDContentModelHandler augs)))

  (method ^:private normalizeDefaultAttrValue ^boolean [this ^XMLString value]
    (let [^:mutable skipSpace true
          ^:mutable current (.-offset value)
          end (unchecked-add-int (.-offset value) (.-length value))]
      (loop [^int i (.-offset value)]
        (if (< i end)
            (if (== (aget (.-ch value) i) \space)
                (if (not skipSpace)
                    (do
                      (aset (.-ch value) current \space)
                      (set! current (unchecked-inc-int current))
                      (set! skipSpace true)
                      (recur (unchecked-inc-int i)))
                    (recur (unchecked-inc-int i)))
                (do
                  (when-not (== current i) (aset (.-ch value) current (aget (.-ch value) i)))
                  (set! current (unchecked-inc-int current))
                  (set! skipSpace false)
                  (recur (unchecked-inc-int i))))
            nil))
      (if (not (== current end))
          (do
            (when skipSpace (set! current (unchecked-dec-int current)))
            (set! (.-length value) (unchecked-subtract-int current (.-offset value)))
            true)
          false)))

  (method ^:protected isValidNmtoken ^boolean [this ^String nmtoken]
    (XMLChar/isValidNmtoken nmtoken))

  (method ^:protected isValidName ^boolean [this ^String name]
    (XMLChar/isValidName name))

  (method ^:private checkDeclaredElements ^void [this ^DTDGrammar grammar]
    (let [^:mutable elementIndex (.getFirstElementDeclIndex grammar)
          contentSpec (XMLContentSpec.)]
      (while (>= elementIndex 0)
        (let [^int type (.getContentSpecType grammar elementIndex)]
          (when (or (== type XMLElementDecl/TYPE_CHILDREN) (== type XMLElementDecl/TYPE_MIXED))
            (.checkDeclaredElements this
                                    grammar
                                    elementIndex
                                    (.getContentSpecIndex grammar elementIndex)
                                    contentSpec))
          (set! elementIndex (.getNextElementDeclIndex grammar elementIndex))))))

  (method ^:private checkDeclaredElements ^void [this ^DTDGrammar grammar ^int elementIndex
                                                 ^int contentSpecIndex ^XMLContentSpec contentSpec]
    (.getContentSpec grammar contentSpecIndex contentSpec)
    (cond
      (== (.-type contentSpec) XMLContentSpec/CONTENTSPECNODE_LEAF)
        (let [value (cast String (.-value contentSpec))]
          (when (and (some? value) (== (.getElementDeclIndex grammar value) -1))
            (.reportError fErrorReporter
                          XMLMessageFormatter/XML_DOMAIN
                          "UndeclaredElementInContentSpec"
                          (new Object/1
                               [(.-rawname (.getElementDeclName grammar elementIndex)) value])
                          XMLErrorReporter/SEVERITY_WARNING)))
      (or (== (.-type contentSpec) XMLContentSpec/CONTENTSPECNODE_CHOICE)
          (== (.-type contentSpec) XMLContentSpec/CONTENTSPECNODE_SEQ))
        (let [leftNode (aget (cast int/1 (.-value contentSpec)) 0)
              rightNode (aget (cast int/1 (.-otherValue contentSpec)) 0)]
          (.checkDeclaredElements this grammar elementIndex leftNode contentSpec)
          (.checkDeclaredElements this grammar elementIndex rightNode contentSpec))
      (or (or (== (.-type contentSpec) XMLContentSpec/CONTENTSPECNODE_ZERO_OR_MORE)
              (== (.-type contentSpec) XMLContentSpec/CONTENTSPECNODE_ZERO_OR_ONE))
          (== (.-type contentSpec) XMLContentSpec/CONTENTSPECNODE_ONE_OR_MORE))
        (let [leftNode (aget (cast int/1 (.-value contentSpec)) 0)]
          (.checkDeclaredElements this grammar elementIndex leftNode contentSpec)))))

          (.returnAttrArray (.-fAttrChecker this) complexContentAttrValues schemaDoc)
          (throw (ComplexTypeRecoverableError. "s4s-elt-invalid-content.2"
                                               (new
                                                 Object/1
                                                 [fName SchemaSymbols/ELT_COMPLEXCONTENT])
                                               complexContentElement)))
        (let [complexContentName (DOMUtil/getLocalName complexContent)]
          (cond
            (.equals complexContentName SchemaSymbols/ELT_RESTRICTION)
              (set! fDerivedBy XSConstants/DERIVATION_RESTRICTION)
            (.equals complexContentName SchemaSymbols/ELT_EXTENSION)
              (set! fDerivedBy XSConstants/DERIVATION_EXTENSION)
            :else
              (do
                (.returnAttrArray (.-fAttrChecker this) complexContentAttrValues schemaDoc)
                (throw (ComplexTypeRecoverableError.
                         "s4s-elt-invalid-content.1"
                         (new Object/1 [fName complexContentName])
                         complexContent))))
          (let [elemTmp (DOMUtil/getNextSiblingElement complexContent)]
            (when (some? elemTmp)
              (.returnAttrArray (.-fAttrChecker this) complexContentAttrValues schemaDoc)
              (let [siblingName (DOMUtil/getLocalName elemTmp)]
                (throw (ComplexTypeRecoverableError.
                         "s4s-elt-invalid-content.1"
                         (new Object/1 [fName siblingName])
                         elemTmp))))
            (let [derivationTypeAttrValues (.checkAttributes
                                             (.-fAttrChecker this)
                                             complexContent
                                             false
                                             schemaDoc)
                  baseTypeName (cast QName
                                     (aget derivationTypeAttrValues XSAttributeChecker/ATTIDX_BASE))]
              (when (nil? baseTypeName)
                (.returnAttrArray (.-fAttrChecker this) complexContentAttrValues schemaDoc)
                (.returnAttrArray (.-fAttrChecker this) derivationTypeAttrValues schemaDoc)

                          (if (nil? fParticle)
                              (do
                                (set! fContentType (.getContentType baseType))
                                (set! fXSSimpleType (cast XSSimpleType (.getSimpleType baseType)))
                                (set! fParticle baseContent))
                              (when-not (== (.getContentType baseType)
                                            XSComplexTypeDecl/CONTENTTYPE_EMPTY)
                                (if (and (== fContentType XSComplexTypeDecl/CONTENTTYPE_ELEMENT)
                                         (not (==
                                                (.getContentType baseType)
                                                XSComplexTypeDecl/CONTENTTYPE_ELEMENT)))
                                    (do
                                      (.returnAttrArray
                                        (.-fAttrChecker this)
                                        complexContentAttrValues
                                        schemaDoc)
                                      (.returnAttrArray
                                        (.-fAttrChecker this)
                                        derivationTypeAttrValues
                                        schemaDoc)
                                      (throw (ComplexTypeRecoverableError.
                                               "cos-ct-extends.1.4.3.2.2.1.a"
                                               (new Object/1 [fName])
                                               complexContent)))
                                    (when (and (== fContentType XSComplexTypeDecl/CONTENTTYPE_MIXED)
                                               (not
                                                 (==
                                                   (.getContentType baseType)
                                                   XSComplexTypeDecl/CONTENTTYPE_MIXED)))
                                      (.returnAttrArray
                                        (.-fAttrChecker this)
                                        complexContentAttrValues
                                        schemaDoc)
                                      (.returnAttrArray
                                        (.-fAttrChecker this)
                                        derivationTypeAttrValues
                                        schemaDoc)
                                      (throw (ComplexTypeRecoverableError.
                                               "cos-ct-extends.1.4.3.2.2.1.b"
                                               (new Object/1 [fName])
                                               complexContent))))
                                (when (or (and (==
                                                 (.-fType fParticle)
                                                 XSParticleDecl/PARTICLE_MODELGROUP)
                                               (==
                                                 (.-fCompositor
                                                   (cast XSModelGroupImpl (.-fValue fParticle)))
                                                 XSModelGroupImpl/MODELGROUP_ALL))
                                          (and
                                            (== (.-fType
                                                  (cast XSParticleDecl (.getParticle baseType)))
                                                XSParticleDecl/PARTICLE_MODELGROUP)
                                            (==
                                              (.-fCompositor
                                                (cast
                                                  XSModelGroupImpl
                                                  (.-fValue
                                                    (cast XSParticleDecl (.getParticle baseType)))))
                                              XSModelGroupImpl/MODELGROUP_ALL)))
                                  (.returnAttrArray
                                    (.-fAttrChecker this)
                                    complexContentAttrValues
                                    schemaDoc)
                                  (.returnAttrArray
                                    (.-fAttrChecker this)
                                    derivationTypeAttrValues
                                    schemaDoc)
                                  (throw (ComplexTypeRecoverableError.
                                           "cos-all-limited.1.2"
                                           (new Object/1 [])
                                           complexContent)))
                                (let [group (XSModelGroupImpl.)]
                                  (set! (.-fCompositor group) XSModelGroupImpl/MODELGROUP_SEQUENCE)
                                  (set! (.-fParticleCount group) 2)
                                  (set! (.-fParticles group) (new XSParticleDecl/1 2))
                                  (aset (.-fParticles group)
                                        0
                                        (cast XSParticleDecl (.getParticle baseType)))
                                  (aset (.-fParticles group) 1 fParticle)
                                  (set! (.-fAnnotations group) XSObjectListImpl/EMPTY_LIST)
                                  (let [particle (XSParticleDecl.)]
                                    (set! (.-fType particle) XSParticleDecl/PARTICLE_MODELGROUP)
                                    (set! (.-fValue particle) group)
                                    (set! (.-fAnnotations particle) XSObjectListImpl/EMPTY_LIST)
                                    (set! fParticle particle)))))
                          (.removeProhibitedAttrs fAttrGrp)
                          (try
                            (.mergeAttributes this
                                              (.getAttrGrp baseType)
                                              fAttrGrp
                                              fName
                                              true
                                              complexContent)
                            (catch ComplexTypeRecoverableError e
                              (.returnAttrArray (.-fAttrChecker this)
                                                complexContentAttrValues
                                                schemaDoc)
                              (.returnAttrArray (.-fAttrChecker this)
                                                derivationTypeAttrValues
                                                schemaDoc)
                              (throw e)))))
                    (.returnAttrArray (.-fAttrChecker this) complexContentAttrValues schemaDoc)
                    (.returnAttrArray (.-fAttrChecker this) derivationTypeAttrValues schemaDoc))))))))))

  (method ^:private mergeAttributes :throws [ComplexTypeRecoverableError] ^void [this
                                                                                 ^XSAttributeGroupDecl fromAttrGrp
                                                                                 ^XSAttributeGroupDecl toAttrGrp
                                                                                 ^String typeName
                                                                                 ^boolean extension
                                                                                 ^Element elem]
    (let [attrUseS (.getAttributeUses fromAttrGrp)
          ^:mutable ^XSAttributeUseImpl oneAttrUse nil
          attrCount (.getLength attrUseS)]
      (loop [^int i 0]
        (when (< i attrCount)
          (set! oneAttrUse (cast XSAttributeUseImpl (.item attrUseS i)))
          (let [existingAttrUse (.getAttributeUse
                                  toAttrGrp
                                  (.getNamespace (.-fAttrDecl oneAttrUse))
                                  (.getName (.-fAttrDecl oneAttrUse)))]
            (cond
              (nil? existingAttrUse)
                (let [idName (.addAttributeUse toAttrGrp oneAttrUse)]
                  (if (some? idName)
                      (throw (ComplexTypeRecoverableError.
                               "ct-props-correct.5"
                               (new Object/1 [typeName idName (.getName (.-fAttrDecl oneAttrUse))])
                               elem))
                      (recur (unchecked-inc-int i))))
              (not (identical? existingAttrUse oneAttrUse))
                (if extension
                    (do
                      (.reportSchemaError this
                                          "ct-props-correct.4"
                                          (new Object/1
                                               [typeName (.getName (.-fAttrDecl oneAttrUse))])
                                          elem)
                      (.replaceAttributeUse toAttrGrp existingAttrUse oneAttrUse)
                      (recur (unchecked-inc-int i)))
                    (recur (unchecked-inc-int i)))
              :else (recur (unchecked-inc-int i))))))
      (when extension
        (if (nil? (.-fAttributeWC toAttrGrp))
            (set! (.-fAttributeWC toAttrGrp) (.-fAttributeWC fromAttrGrp))
            (when (some? (.-fAttributeWC fromAttrGrp))
              (set! (.-fAttributeWC toAttrGrp)
                    (.performUnionWith (.-fAttributeWC toAttrGrp)
                                       (.-fAttributeWC fromAttrGrp)
                                       (.-fProcessContents (.-fAttributeWC toAttrGrp))))
              (when (nil? (.-fAttributeWC toAttrGrp))
                (throw (ComplexTypeRecoverableError. "src-ct.5" (new Object/1 [typeName]) elem))))))))

  (method ^:private processComplexContent :throws [ComplexTypeRecoverableError] ^void [this
                                                                                       ^Element complexContentChild
                                                                                       ^boolean isMixed
                                                                                       ^boolean isDerivation
                                                                                       ^XSDocumentInfo schemaDoc
                                                                                       ^SchemaGrammar grammar]
    (let [^:mutable ^Element attrNode nil
          ^:mutable ^XSParticleDecl particle nil
          ^:mutable emptyParticle false]
      (when (some? complexContentChild)
        (let [childName (DOMUtil/getLocalName complexContentChild)]
          (cond
            (.equals childName SchemaSymbols/ELT_GROUP)
              (do
                (set! particle
                      (.traverseLocal (.-fGroupTraverser (.-fSchemaHandler this))
                                      complexContentChild
                                      schemaDoc
                                      grammar))
                (set! attrNode (DOMUtil/getNextSiblingElement complexContentChild)))
            (.equals childName SchemaSymbols/ELT_SEQUENCE)
              (do
                (set! particle
                      (.traverseSequence this
                                         complexContentChild
                                         schemaDoc
                                         grammar
                                         XSDComplexTypeTraverser/NOT_ALL_CONTEXT
                                         fComplexTypeDecl))
                (when (some? particle)
                  (let [group (cast XSModelGroupImpl (.-fValue particle))]
                    (when (== (.-fParticleCount group) 0) (set! emptyParticle true))))
                (set! attrNode (DOMUtil/getNextSiblingElement complexContentChild)))
            (.equals childName SchemaSymbols/ELT_CHOICE)
              (do
                (set! particle
                      (.traverseChoice this
                                       complexContentChild
                                       schemaDoc
                                       grammar
                                       XSDComplexTypeTraverser/NOT_ALL_CONTEXT
                                       fComplexTypeDecl))
                (when (and (some? particle) (== (.-fMinOccurs particle) 0))
                  (let [group (cast XSModelGroupImpl (.-fValue particle))]
                    (when (== (.-fParticleCount group) 0) (set! emptyParticle true))))
                (set! attrNode (DOMUtil/getNextSiblingElement complexContentChild)))
            (.equals childName SchemaSymbols/ELT_ALL)
              (do
                (set! particle
                      (.traverseAll this
                                    complexContentChild
                                    schemaDoc
                                    grammar
                                    XSDComplexTypeTraverser/PROCESSING_ALL_GP
                                    fComplexTypeDecl))
                (when (some? particle)
                  (let [group (cast XSModelGroupImpl (.-fValue particle))]
                    (when (== (.-fParticleCount group) 0) (set! emptyParticle true))))
                (set! attrNode (DOMUtil/getNextSiblingElement complexContentChild)))
            :else (set! attrNode complexContentChild))))
      (when emptyParticle
        (let [^:mutable child (DOMUtil/getFirstChildElement complexContentChild)]
          (when (some? child)
            (when (.equals (DOMUtil/getLocalName child) SchemaSymbols/ELT_ANNOTATION)
              (set! child (DOMUtil/getNextSiblingElement child))))
          (when (nil? child) (set! particle nil))))
      (when (and (nil? particle) isMixed) (set! particle (XSConstraints/getEmptySequence)))
      (set! fParticle particle)
      (cond
        (nil? fParticle) (set! fContentType XSComplexTypeDecl/CONTENTTYPE_EMPTY)
        isMixed (set! fContentType XSComplexTypeDecl/CONTENTTYPE_MIXED)
        :else (set! fContentType XSComplexTypeDecl/CONTENTTYPE_ELEMENT))
      (when (some? attrNode)
        (when-not (.isAttrOrAttrGroup this attrNode)
          (throw (ComplexTypeRecoverableError. "s4s-elt-invalid-content.1"
                                               (new
                                                 Object/1
                                                 [fName (DOMUtil/getLocalName attrNode)])
                                               attrNode)))
        (let [node (.traverseAttrsAndAttrGrps this
                                              attrNode
                                              fAttrGrp
                                              schemaDoc
                                              grammar
                                              fComplexTypeDecl)]
          (when (some? node)
            (throw (ComplexTypeRecoverableError.
                     "s4s-elt-invalid-content.1"
                     (new Object/1 [fName (DOMUtil/getLocalName node)])
                     node)))
          (when-not isDerivation (.removeProhibitedAttrs fAttrGrp))))))

  (method ^:private isAttrOrAttrGroup ^boolean [this ^Element e]
    (let [elementName (DOMUtil/getLocalName e)]
      (if (or (or (.equals elementName SchemaSymbols/ELT_ATTRIBUTE)
                  (.equals elementName SchemaSymbols/ELT_ATTRIBUTEGROUP))
              (.equals elementName SchemaSymbols/ELT_ANYATTRIBUTE))
          true
          false)))

  (method ^:private traverseSimpleContentDecl ^void [this ^Element simpleContentDecl])

  (method ^:private traverseComplexContentDecl ^void [this ^Element complexContentDecl
                                                      ^boolean mixedOnComplexTypeDecl])

  (method ^:private genAnonTypeName ^String [this ^Element complexTypeDecl]
    (let [typeName (StringBuffer. "#AnonType_")
          ^:mutable node (DOMUtil/getParent complexTypeDecl)]
      (while (and (some? node) (not (identical? node (DOMUtil/getRoot (DOMUtil/getDocument node)))))
        (.append typeName (.getAttribute node SchemaSymbols/ATT_NAME))
        (set! node (DOMUtil/getParent node)))
      (.toString typeName)))

  (method ^:private handleComplexTypeError ^void [this ^String messageId ^Object/1 args ^Element e]
    (when (some? messageId) (.reportSchemaError this messageId args e))
    (set! fBaseType SchemaGrammar/fAnyType)
    (set! fContentType XSComplexTypeDecl/CONTENTTYPE_MIXED)
    (set! fXSSimpleType nil)
    (set! fParticle (XSDComplexTypeTraverser/getErrorContent))
    (set! (.-fAttributeWC fAttrGrp) (XSDComplexTypeTraverser/getErrorWildcard)))

  (method ^:private contentBackup ^void [this]
    (when (nil? fGlobalStore)
      (set! fGlobalStore (new Object/1 GLOBAL_NUM))
      (set! fGlobalStorePos 0))
    (when (== fGlobalStorePos (alength fGlobalStore))
      (let [newArray (new Object/1 (unchecked-add-int fGlobalStorePos GLOBAL_NUM))]
        (System/arraycopy fGlobalStore 0 newArray 0 fGlobalStorePos)
        (set! fGlobalStore newArray)))
    (aset fGlobalStore
          (let [old-1 fGlobalStorePos]
            (set! fGlobalStorePos (unchecked-inc-int fGlobalStorePos))
            old-1)
          fComplexTypeDecl)
    (aset fGlobalStore
          (let [old-2 fGlobalStorePos]
            (set! fGlobalStorePos (unchecked-inc-int fGlobalStorePos))
            old-2)
          (if fIsAbstract Boolean/TRUE Boolean/FALSE))
    (aset fGlobalStore
          (let [old-3 fGlobalStorePos]
            (set! fGlobalStorePos (unchecked-inc-int fGlobalStorePos))
            old-3)
          fName)
    (aset fGlobalStore
          (let [old-4 fGlobalStorePos]
            (set! fGlobalStorePos (unchecked-inc-int fGlobalStorePos))
            old-4)
          fTargetNamespace)
    (aset fGlobalStore
          (let [old-5 fGlobalStorePos]
            (set! fGlobalStorePos (unchecked-inc-int fGlobalStorePos))
            old-5)
          (unchecked-add-int (bit-shift-left-int fDerivedBy 16) fFinal))
    (aset fGlobalStore
          (let [old-6 fGlobalStorePos]
            (set! fGlobalStorePos (unchecked-inc-int fGlobalStorePos))
            old-6)
          (unchecked-add-int (bit-shift-left-int fBlock 16) fContentType))
    (aset fGlobalStore
          (let [old-7 fGlobalStorePos]
            (set! fGlobalStorePos (unchecked-inc-int fGlobalStorePos))
            old-7)
          fBaseType)
    (aset fGlobalStore
          (let [old-8 fGlobalStorePos]
            (set! fGlobalStorePos (unchecked-inc-int fGlobalStorePos))
            old-8)
          fAttrGrp)
    (aset fGlobalStore
          (let [old-9 fGlobalStorePos]
            (set! fGlobalStorePos (unchecked-inc-int fGlobalStorePos))
            old-9)
          fParticle)
    (aset fGlobalStore
          (let [old-10 fGlobalStorePos]
            (set! fGlobalStorePos (unchecked-inc-int fGlobalStorePos))
            old-10)
          fXSSimpleType)
    (aset fGlobalStore
          (let [old-11 fGlobalStorePos]
            (set! fGlobalStorePos (unchecked-inc-int fGlobalStorePos))
            old-11)
          fAnnotations))

  (method ^:private contentRestore ^void [this]
    (set! fAnnotations
          (cast XSAnnotationImpl/1
                (aget fGlobalStore (set! fGlobalStorePos (unchecked-dec-int fGlobalStorePos)))))
    (set! fXSSimpleType
          (cast XSSimpleType
                (aget fGlobalStore (set! fGlobalStorePos (unchecked-dec-int fGlobalStorePos)))))
    (set! fParticle
          (cast XSParticleDecl
                (aget fGlobalStore (set! fGlobalStorePos (unchecked-dec-int fGlobalStorePos)))))
    (set! fAttrGrp
          (cast XSAttributeGroupDecl
                (aget fGlobalStore (set! fGlobalStorePos (unchecked-dec-int fGlobalStorePos)))))
    (set! fBaseType
          (cast XSTypeDefinition
                (aget fGlobalStore (set! fGlobalStorePos (unchecked-dec-int fGlobalStorePos)))))
    (let [^:mutable ^int i (cast Integer
                                 (aget fGlobalStore
                                       (set! fGlobalStorePos (unchecked-dec-int fGlobalStorePos))))]
      (set! fBlock (unchecked-short (bit-shift-right-int i 16)))
      (set! fContentType (unchecked-short i))
      (set! i
            (cast Integer
                  (aget fGlobalStore (set! fGlobalStorePos (unchecked-dec-int fGlobalStorePos)))))
      (set! fDerivedBy (unchecked-short (bit-shift-right-int i 16)))
      (set! fFinal (unchecked-short i))
      (set! fTargetNamespace
            (cast String
                  (aget fGlobalStore (set! fGlobalStorePos (unchecked-dec-int fGlobalStorePos)))))
      (set! fName
            (cast String
                  (aget fGlobalStore (set! fGlobalStorePos (unchecked-dec-int fGlobalStorePos)))))
      (set! fIsAbstract
            (cast Boolean
                  (aget fGlobalStore (set! fGlobalStorePos (unchecked-dec-int fGlobalStorePos)))))
      (set! fComplexTypeDecl
            (cast XSComplexTypeDecl
                  (aget fGlobalStore (set! fGlobalStorePos (unchecked-dec-int fGlobalStorePos)))))))

  (method ^:private addAnnotation ^void [this ^XSAnnotationImpl annotation]
    (when (some? annotation)
      (if (nil? fAnnotations)
          (set! fAnnotations (new XSAnnotationImpl/1 1))
          (let [tempArray (new XSAnnotationImpl/1 (unchecked-add-int (alength fAnnotations) 1))]
            (System/arraycopy fAnnotations 0 tempArray 0 (alength fAnnotations))
            (set! fAnnotations tempArray)))
      (aset fAnnotations (unchecked-subtract-int (alength fAnnotations) 1) annotation))))

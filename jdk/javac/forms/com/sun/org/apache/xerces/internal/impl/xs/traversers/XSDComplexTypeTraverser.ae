                  (set! complexContent (DOMUtil/getFirstChildElement complexContent))
                  (if (some? complexContent)
                      (do
                        (if (.equals (DOMUtil/getLocalName complexContent)
                                     SchemaSymbols/ELT_ANNOTATION)
                            (do
                              (.addAnnotation this
                                              (.traverseAnnotationDecl
                                                this
                                                complexContent
                                                derivationTypeAttrValues
                                                false
                                                schemaDoc))
                              (set! complexContent (DOMUtil/getNextSiblingElement complexContent)))
                            (let [text (DOMUtil/getSyntheticAnnotation complexContent)]
                              (when (some? text)
                                (.addAnnotation this
                                                (.traverseSyntheticAnnotation
                                                  this
                                                  complexContent
                                                  text
                                                  derivationTypeAttrValues
                                                  false
                                                  schemaDoc)))))
                        (when (and (some? complexContent)
                                   (.equals (DOMUtil/getLocalName complexContent)
                                            SchemaSymbols/ELT_ANNOTATION))
                          (.returnAttrArray (.-fAttrChecker this)
                                            complexContentAttrValues
                                            schemaDoc)
                          (.returnAttrArray (.-fAttrChecker this)
                                            derivationTypeAttrValues
                                            schemaDoc)
                          (throw (ComplexTypeRecoverableError.
                                   "s4s-elt-invalid-content.1"
                                   (new Object/1 [fName SchemaSymbols/ELT_ANNOTATION])
                                   complexContent))))
                      (let [text (DOMUtil/getSyntheticAnnotation complexContent)]
                        (when (some? text)
                          (.addAnnotation this
                                          (.traverseSyntheticAnnotation
                                            this
                                            complexContent
                                            text
                                            derivationTypeAttrValues
                                            false
                                            schemaDoc)))))
                  (try
                    (.processComplexContent this complexContent mixedContent true schemaDoc grammar)
                    (catch ComplexTypeRecoverableError e
                      (.returnAttrArray (.-fAttrChecker this) complexContentAttrValues schemaDoc)
                      (.returnAttrArray (.-fAttrChecker this) derivationTypeAttrValues schemaDoc)
                      (throw e)))
                  (let [baseContent (cast XSParticleDecl (.getParticle baseType))]
                    (if (== fDerivedBy XSConstants/DERIVATION_RESTRICTION)
                        (do
                          (when (and (== fContentType XSComplexTypeDecl/CONTENTTYPE_MIXED)
                                     (not (== (.getContentType baseType)
                                              XSComplexTypeDecl/CONTENTTYPE_MIXED)))
                            (.returnAttrArray (.-fAttrChecker this)
                                              complexContentAttrValues
                                              schemaDoc)
                            (.returnAttrArray (.-fAttrChecker this)
                                              derivationTypeAttrValues
                                              schemaDoc)
                            (throw (ComplexTypeRecoverableError.
                                     "derivation-ok-restriction.5.4.1.2"
                                     (new Object/1 [fName (.getName baseType)])
                                     complexContent)))
                          (try
                            (.mergeAttributes this
                                              (.getAttrGrp baseType)
                                              fAttrGrp
                                              fName
                                              false
                                              complexContent)
                            (catch ComplexTypeRecoverableError e
                              (.returnAttrArray (.-fAttrChecker this)
                                                complexContentAttrValues
                                                schemaDoc)
                              (.returnAttrArray (.-fAttrChecker this)
                                                derivationTypeAttrValues
                                                schemaDoc)
                              (throw e)))
                          (.removeProhibitedAttrs fAttrGrp)
                          (when-not (identical? baseType SchemaGrammar/fAnyType)
                            (let [errArgs (.validRestrictionOf
                                            fAttrGrp
                                            fName
                                            (.getAttrGrp baseType))]
                              (when (some? errArgs)
                                (.returnAttrArray
                                  (.-fAttrChecker this)
                                  complexContentAttrValues
                                  schemaDoc)
                                (.returnAttrArray
                                  (.-fAttrChecker this)
                                  derivationTypeAttrValues
                                  schemaDoc)
                                (throw (ComplexTypeRecoverableError.
                                         (cast String
                                               (aget
                                                 errArgs
                                                 (unchecked-subtract-int (alength errArgs) 1)))
                                         errArgs
                                         complexContent))))))

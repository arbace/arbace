                                     (.-fAttrChecker this)
                                     complexContentElement
                                     false
                                     schemaDoc)
          ^:mutable mixedContent mixedOnType
          mixedAtt (cast Boolean (aget complexContentAttrValues XSAttributeChecker/ATTIDX_MIXED))]
      (when (some? mixedAtt) (set! mixedContent (.booleanValue mixedAtt)))
      (set! fXSSimpleType nil)
      (let [^:mutable complexContent (DOMUtil/getFirstChildElement complexContentElement)]
        (if (and (some? complexContent)
                 (.equals (DOMUtil/getLocalName complexContent) SchemaSymbols/ELT_ANNOTATION))
            (do
              (.addAnnotation this
                              (.traverseAnnotationDecl
                                this
                                complexContent
                                complexContentAttrValues
                                false
                                schemaDoc))
              (set! complexContent (DOMUtil/getNextSiblingElement complexContent)))
            (let [text (DOMUtil/getSyntheticAnnotation complexContentElement)]
              (when (some? text)
                (.addAnnotation this
                                (.traverseSyntheticAnnotation
                                  this
                                  complexContentElement
                                  text
                                  complexContentAttrValues
                                  false
                                  schemaDoc)))))

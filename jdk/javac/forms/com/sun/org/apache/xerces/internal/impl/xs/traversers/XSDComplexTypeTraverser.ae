                                                simpleContentElement)
                              (catch ComplexTypeRecoverableError e
                                (.returnAttrArray
                                  (.-fAttrChecker this)
                                  simpleContentAttrValues
                                  schemaDoc)
                                (.returnAttrArray
                                  (.-fAttrChecker this)
                                  derivationTypeAttrValues
                                  schemaDoc)
                                (throw e))))))
                    (.returnAttrArray (.-fAttrChecker this) simpleContentAttrValues schemaDoc)
                    (.returnAttrArray (.-fAttrChecker this) derivationTypeAttrValues schemaDoc))))))))))

  (method ^:private traverseComplexContent :throws [ComplexTypeRecoverableError] ^void [this
                                                                                        ^Element complexContentElement

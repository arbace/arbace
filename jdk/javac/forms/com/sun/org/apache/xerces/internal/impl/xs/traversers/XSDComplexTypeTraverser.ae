                  (when-not (== (bit-and-int (.getFinal baseType) fDerivedBy) 0)
                    (.returnAttrArray (.-fAttrChecker this) complexContentAttrValues schemaDoc)
                    (.returnAttrArray (.-fAttrChecker this) derivationTypeAttrValues schemaDoc)
                    (let [^String errorKey (if (== fDerivedBy XSConstants/DERIVATION_EXTENSION)
                                               "cos-ct-extends.1.1"
                                               "derivation-ok-restriction.1")]
                      (throw (ComplexTypeRecoverableError.
                               errorKey
                               (new Object/1 [fName (.getName fBaseType)])

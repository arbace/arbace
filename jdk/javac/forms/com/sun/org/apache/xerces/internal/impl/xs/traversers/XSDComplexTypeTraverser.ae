                         "s4s-att-must-appear"
                         (new Object/1 [complexContentName "base"])
                         complexContent)))
              (let [type (cast XSTypeDefinition
                               (.getGlobalDecl (.-fSchemaHandler this)
                                               schemaDoc
                                               XSDHandler/TYPEDECL_TYPE
                                               baseTypeName
                                               complexContent))]
                (when (nil? type)
                  (.returnAttrArray (.-fAttrChecker this) complexContentAttrValues schemaDoc)
                  (.returnAttrArray (.-fAttrChecker this) derivationTypeAttrValues schemaDoc)
                  (throw (ComplexTypeRecoverableError.)))
                (when-not (instance? XSComplexTypeDecl type)
                  (.returnAttrArray (.-fAttrChecker this) complexContentAttrValues schemaDoc)

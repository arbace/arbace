                        (let [^:mutable changedByNormalization false
                              oldValue (.getValue attributes i)
                              ^:mutable attrValue oldValue]
                          (when (and (.isSpecified attributes i)
                                     (not (identical? type XMLSymbols/fCDATASymbol)))
                            (set! changedByNormalization (.normalizeAttrValue this attributes i))
                            (set! attrValue (.getValue attributes i))
                            (when (and (and (and fPerformValidation (.getStandalone fGrammarBucket))
                                            changedByNormalization)
                                       (.getAttributeDeclIsExternal fDTDGrammar position))
                              (.reportError
                                fErrorReporter
                                XMLMessageFormatter/XML_DOMAIN
                                "MSG_ATTVALUE_CHANGED_DURING_NORMALIZATION_WHEN_STANDALONE"
                                (new Object/1 [attrRawName oldValue attrValue])
                                XMLErrorReporter/SEVERITY_ERROR)))
                          (if (not fPerformValidation)
                              (recur (unchecked-inc-int i))
                              (do
                                (when (== (.-defaultType (.-simpleType fTempAttDecl))
                                          XMLSimpleType/DEFAULT_TYPE_FIXED)
                                  (let [defaultValue (.-defaultValue (.-simpleType fTempAttDecl))]
                                    (when-not (.equals attrValue defaultValue)
                                      (let [args (new
                                                   Object/1
                                                   [(.-localpart elementName)
                                                    attrRawName
                                                    attrValue
                                                    defaultValue])]
                                        (.reportError
                                          fErrorReporter
                                          XMLMessageFormatter/XML_DOMAIN
                                          "MSG_FIXED_ATTVALUE_INVALID"
                                          args
                                          XMLErrorReporter/SEVERITY_ERROR)))))
                                (if (or (or (or (or
                                                  (or
                                                    (==
                                                      (.-type (.-simpleType fTempAttDecl))
                                                      XMLSimpleType/TYPE_ENTITY)
                                                    (==
                                                      (.-type (.-simpleType fTempAttDecl))
                                                      XMLSimpleType/TYPE_ENUMERATION))
                                                  (==
                                                    (.-type (.-simpleType fTempAttDecl))
                                                    XMLSimpleType/TYPE_ID))
                                                (==
                                                  (.-type (.-simpleType fTempAttDecl))
                                                  XMLSimpleType/TYPE_IDREF))
                                            (== (.-type (.-simpleType fTempAttDecl))
                                                XMLSimpleType/TYPE_NMTOKEN))
                                        (== (.-type (.-simpleType fTempAttDecl))
                                            XMLSimpleType/TYPE_NOTATION))
                                    (do
                                      (.validateDTDattribute
                                        this
                                        elementName
                                        attrValue
                                        fTempAttDecl)
                                      (recur (unchecked-inc-int i)))
                                    (recur (unchecked-inc-int i))))))))))))))))

  (method ^:protected getExternalEntityRefInAttrValue ^String [this ^String nonNormalizedValue]
    (let [valLength (.length nonNormalizedValue)
          ^:mutable ampIndex (.indexOf nonNormalizedValue \&)]
      (while (not (== ampIndex -1))
        (when (and (< (unchecked-add-int ampIndex 1) valLength)
                   (not (== (.charAt nonNormalizedValue (unchecked-add-int ampIndex 1)) \#)))
          (let [semicolonIndex (.indexOf nonNormalizedValue \; (unchecked-add-int ampIndex 1))
                ^:mutable entityName (.substring
                                       nonNormalizedValue
                                       (unchecked-add-int ampIndex 1)
                                       semicolonIndex)]
            (set! entityName (.addSymbol fSymbolTable entityName))
            (let [entIndex (.getEntityDeclIndex fDTDGrammar entityName)]
              (when (> entIndex -1)
                (.getEntityDecl fDTDGrammar entIndex fEntityDecl)
                (when (or (.-inExternal fEntityDecl)
                          (some? (set!
                                   entityName
                                   (.getExternalEntityRefInAttrValue this (.-value fEntityDecl)))))
                  (return entityName))))))
        (set! ampIndex (.indexOf nonNormalizedValue \& (unchecked-add-int ampIndex 1))))
      nil))

  (method ^:protected validateDTDattribute :throws [XNIException] ^void [this ^QName element
                                                                         ^String attValue
                                                                         ^XMLAttributeDecl attributeDecl]
    (switch (.-type (.-simpleType attributeDecl))
      XMLSimpleType/TYPE_ENTITY
        (let [isAlistAttribute (.-list (.-simpleType attributeDecl))]
          (try
            (if isAlistAttribute
                (.validate fValENTITIES attValue fValidationState)
                (.validate fValENTITY attValue fValidationState))
            (catch InvalidDatatypeValueException ex
              (.reportError fErrorReporter
                            XMLMessageFormatter/XML_DOMAIN
                            (.getKey ex)
                            (.getArgs ex)
                            XMLErrorReporter/SEVERITY_ERROR))))
      (XMLSimpleType/TYPE_NOTATION XMLSimpleType/TYPE_ENUMERATION)
        (let [^:mutable found false
              enumVals (.-enumeration (.-simpleType attributeDecl))]
          (if (nil? enumVals)
              (set! found false)
              (loop [^int i 0]
                (if (< i (alength enumVals))
                    (if (or (identical? attValue (aget enumVals i))
                            (.equals attValue (aget enumVals i)))
                        (set! found true)
                        (recur (unchecked-inc-int i)))
                    nil)))
          (when-not found
            (let [enumValueString (StringBuilder.)]
              (when (some? enumVals)
                (loop [^int i 0]
                  (when (< i (alength enumVals))
                    (.append enumValueString (java-str (aget enumVals i) " "))
                    (recur (unchecked-inc-int i)))))
              (.reportError fErrorReporter
                            XMLMessageFormatter/XML_DOMAIN
                            "MSG_ATTRIBUTE_VALUE_NOT_IN_LIST"
                            (new Object/1
                                 [(.-rawname (.-name attributeDecl)) attValue enumValueString])
                            XMLErrorReporter/SEVERITY_ERROR))))
      XMLSimpleType/TYPE_ID
        (try
          (.validate fValID attValue fValidationState)
          (catch InvalidDatatypeValueException ex
            (.reportError fErrorReporter
                          XMLMessageFormatter/XML_DOMAIN
                          (.getKey ex)
                          (.getArgs ex)
                          XMLErrorReporter/SEVERITY_ERROR)))
      XMLSimpleType/TYPE_IDREF
        (let [isAlistAttribute (.-list (.-simpleType attributeDecl))]
          (try
            (if isAlistAttribute
                (.validate fValIDRefs attValue fValidationState)
                (.validate fValIDRef attValue fValidationState))
            (catch InvalidDatatypeValueException ex
              (if isAlistAttribute
                  (.reportError fErrorReporter
                                XMLMessageFormatter/XML_DOMAIN
                                "IDREFSInvalid"
                                (new Object/1 [attValue])
                                XMLErrorReporter/SEVERITY_ERROR)
                  (.reportError fErrorReporter
                                XMLMessageFormatter/XML_DOMAIN
                                (.getKey ex)
                                (.getArgs ex)
                                XMLErrorReporter/SEVERITY_ERROR)))))
      XMLSimpleType/TYPE_NMTOKEN
        (let [isAlistAttribute (.-list (.-simpleType attributeDecl))]
          (try
            (if isAlistAttribute
                (.validate fValNMTOKENS attValue fValidationState)
                (.validate fValNMTOKEN attValue fValidationState))
            (catch InvalidDatatypeValueException ex
              (if isAlistAttribute
                  (.reportError fErrorReporter
                                XMLMessageFormatter/XML_DOMAIN
                                "NMTOKENSInvalid"
                                (new Object/1 [attValue])
                                XMLErrorReporter/SEVERITY_ERROR)
                  (.reportError fErrorReporter
                                XMLMessageFormatter/XML_DOMAIN
                                "NMTOKENInvalid"
                                (new Object/1 [attValue])
                                XMLErrorReporter/SEVERITY_ERROR)))))))

  (method ^:protected invalidStandaloneAttDef ^boolean [this ^QName element ^QName attribute]
    (let [state true] state))

  (method ^:private normalizeAttrValue ^boolean [this ^XMLAttributes attributes ^int index]
    (let [^:mutable leadingSpace true
          ^:mutable spaceStart false
          ^:mutable readingNonSpace false
          ^:mutable ^int count 0
          attrValue (.getValue attributes index)
          attValue (new char/1 (.length attrValue))]
      (.setLength fBuffer 0)
      (.getChars attrValue 0 (.length attrValue) attValue 0)
      (loop [^int i 0]
        (if (< i (alength attValue))
            (if (== (aget attValue i) \space)
                (do
                  (when readingNonSpace (set! spaceStart true) (set! readingNonSpace false))
                  (if (and spaceStart (not leadingSpace))
                      (do
                        (set! spaceStart false)
                        (.append fBuffer (aget attValue i))
                        (set! count (unchecked-inc-int count))
                        (recur (unchecked-inc-int i)))
                      (recur (unchecked-inc-int i))))
                (do
                  (set! readingNonSpace true)
                  (set! spaceStart false)
                  (set! leadingSpace false)
                  (.append fBuffer (aget attValue i))
                  (set! count (unchecked-inc-int count))
                  (recur (unchecked-inc-int i))))
            nil))
      (when (and (> count 0) (== (.charAt fBuffer (unchecked-subtract-int count 1)) \space))
        (.setLength fBuffer (unchecked-subtract-int count 1)))
      (let [newValue (.toString fBuffer)]
        (.setValue attributes index newValue)
        (not (.equals attrValue newValue)))))

  (method ^:private ^:final rootElementSpecified :throws [XNIException] ^void [this
                                                                               ^QName rootElement]
    (when fPerformValidation
      (let [root1 (.-rawname fRootElement)
            root2 (.-rawname rootElement)]
        (when (or (nil? root1) (not (.equals root1 root2)))
          (.reportError fErrorReporter
                        XMLMessageFormatter/XML_DOMAIN
                        "RootElementTypeMustMatchDoctypedecl"
                        (new Object/1 [root1 root2])
                        XMLErrorReporter/SEVERITY_ERROR)))))

  (method ^:private checkContent :throws [XNIException] ^int [this ^int elementIndex
                                                              ^QName/1 children ^int childOffset
                                                              ^int childCount]
    (.getElementDecl fDTDGrammar elementIndex fTempElementDecl)
    (let [contentType fCurrentContentSpecType]
      (if (== contentType XMLElementDecl/TYPE_EMPTY)
          (when-not (== childCount 0) (return 0))
          (when-not (== contentType XMLElementDecl/TYPE_ANY)
            (if (or (== contentType XMLElementDecl/TYPE_MIXED)
                    (== contentType XMLElementDecl/TYPE_CHILDREN))
                (let [^:mutable ^ContentModelValidator cmElem nil]
                  (set! cmElem (.-contentModelValidator fTempElementDecl))
                  (let [result (.validate cmElem children childOffset childCount)] (return result)))
                (when-not (== contentType -1)
                  (when (== contentType XMLElementDecl/TYPE_SIMPLE) nil)))))
      -1))

  (method ^:private charDataInContent ^void [this]
    (when DEBUG_ELEMENT_CHILDREN (.println System/out "charDataInContent()"))
    (when (<= (alength fElementChildren) fElementChildrenLength)
      (let [newarray (new QName/1 (unchecked-multiply-int (alength fElementChildren) 2))]
        (System/arraycopy fElementChildren 0 newarray 0 (alength fElementChildren))
        (set! fElementChildren newarray)))
    (let [^:mutable qname (aget fElementChildren fElementChildrenLength)]
      (when (nil? qname)
        (loop [^int i fElementChildrenLength]
          (when (< i (alength fElementChildren))
            (aset fElementChildren i (QName.))
            (recur (unchecked-inc-int i))))
        (set! qname (aget fElementChildren fElementChildrenLength)))
      (.clear qname)
      (set! fElementChildrenLength (unchecked-inc-int fElementChildrenLength))))

  (method ^:private getAttributeTypeName ^String [this ^XMLAttributeDecl attrDecl]
    (switch (.-type (.-simpleType attrDecl))
      XMLSimpleType/TYPE_ENTITY
        (return (if (.-list (.-simpleType attrDecl))
                    XMLSymbols/fENTITIESSymbol
                    XMLSymbols/fENTITYSymbol))
      XMLSimpleType/TYPE_ENUMERATION
        (let [^:mutable ^int totalLength 2]
          (loop [^int i 0]
            (when (< i (alength (.-enumeration (.-simpleType attrDecl))))
              (set! totalLength
                    (unchecked-add-int totalLength
                                       (unchecked-add-int
                                         (.length (aget (.-enumeration (.-simpleType attrDecl)) i))
                                         1)))
              (recur (unchecked-inc-int i))))
          (let [buffer (StringBuilder. totalLength)]
            (.append buffer \()
            (loop [^int i 0]
              (when (< i (alength (.-enumeration (.-simpleType attrDecl))))
                (when (> i 0) (.append buffer \|))
                (.append buffer (aget (.-enumeration (.-simpleType attrDecl)) i))
                (recur (unchecked-inc-int i))))
            (.append buffer \))
            (return (.addSymbol fSymbolTable (.toString buffer)))))
      XMLSimpleType/TYPE_ID (return XMLSymbols/fIDSymbol)
      XMLSimpleType/TYPE_IDREF
        (return (if (.-list (.-simpleType attrDecl))
                    XMLSymbols/fIDREFSSymbol
                    XMLSymbols/fIDREFSymbol))
      XMLSimpleType/TYPE_NMTOKEN
        (return (if (.-list (.-simpleType attrDecl))
                    XMLSymbols/fNMTOKENSSymbol
                    XMLSymbols/fNMTOKENSymbol))
      XMLSimpleType/TYPE_NOTATION (return XMLSymbols/fNOTATIONSymbol))
    XMLSymbols/fCDATASymbol)

  (method ^:protected init ^void [this]
    (when (or fValidation fDynamicValidation)
      (try
        (set! fValID (.getBuiltInDV fDatatypeValidatorFactory XMLSymbols/fIDSymbol))
        (set! fValIDRef (.getBuiltInDV fDatatypeValidatorFactory XMLSymbols/fIDREFSymbol))
        (set! fValIDRefs (.getBuiltInDV fDatatypeValidatorFactory XMLSymbols/fIDREFSSymbol))
        (set! fValENTITY (.getBuiltInDV fDatatypeValidatorFactory XMLSymbols/fENTITYSymbol))
        (set! fValENTITIES (.getBuiltInDV fDatatypeValidatorFactory XMLSymbols/fENTITIESSymbol))
        (set! fValNMTOKEN (.getBuiltInDV fDatatypeValidatorFactory XMLSymbols/fNMTOKENSymbol))
        (set! fValNMTOKENS (.getBuiltInDV fDatatypeValidatorFactory XMLSymbols/fNMTOKENSSymbol))
        (set! fValNOTATION (.getBuiltInDV fDatatypeValidatorFactory XMLSymbols/fNOTATIONSymbol))
        (catch Exception e (.printStackTrace e System/err)))))

  (method ^:private ensureStackCapacity ^void [this ^int newElementDepth]
    (when (== newElementDepth (alength fElementQNamePartsStack))
      (let [newStackOfQueue (new QName/1 (unchecked-multiply-int newElementDepth 2))]
        (System/arraycopy (.-fElementQNamePartsStack this) 0 newStackOfQueue 0 newElementDepth)
        (set! fElementQNamePartsStack newStackOfQueue)
        (let [qname (aget fElementQNamePartsStack newElementDepth)]
          (when (nil? qname)
            (loop [^int i newElementDepth]
              (when (< i (alength fElementQNamePartsStack))
                (aset fElementQNamePartsStack i (QName.))
                (recur (unchecked-inc-int i)))))
          (let [^:mutable newStack (new int/1 (unchecked-multiply-int newElementDepth 2))]
            (System/arraycopy fElementIndexStack 0 newStack 0 newElementDepth)
            (set! fElementIndexStack newStack)
            (set! newStack (new int/1 (unchecked-multiply-int newElementDepth 2)))
            (System/arraycopy fContentSpecTypeStack 0 newStack 0 newElementDepth)
            (set! fContentSpecTypeStack newStack))))))

  (method ^:protected handleStartElement :throws [XNIException] ^boolean [this ^QName element
                                                                          ^XMLAttributes attributes
                                                                          ^Augmentations augs]
    (when-not fSeenRootElement
      (set! fPerformValidation (.validate this))
      (set! fSeenRootElement true)
      (.setEntityState fValidationManager fDTDGrammar)
      (.setGrammarFound fValidationManager fSeenDoctypeDecl)
      (.rootElementSpecified this element))
    (if (nil? fDTDGrammar)
        (do
          (when-not fPerformValidation
            (set! fCurrentElementIndex -1)
            (set! fCurrentContentSpecType -1)
            (set! fInElementContent false))
          (when fPerformValidation
            (.reportError fErrorReporter
                          XMLMessageFormatter/XML_DOMAIN
                          "MSG_GRAMMAR_NOT_FOUND"
                          (new Object/1 [(.-rawname element)])
                          XMLErrorReporter/SEVERITY_ERROR))
          (when (some? fDocumentSource)
            (.setDocumentHandler fDocumentSource fDocumentHandler)
            (when (some? fDocumentHandler) (.setDocumentSource fDocumentHandler fDocumentSource))
            (return true)))
        (do
          (set! fCurrentElementIndex (.getElementDeclIndex fDTDGrammar element))
          (set! fCurrentContentSpecType (.getContentSpecType fDTDGrammar fCurrentElementIndex))
          (when (and (== fCurrentContentSpecType -1) fPerformValidation)
            (.reportError fErrorReporter
                          XMLMessageFormatter/XML_DOMAIN
                          "MSG_ELEMENT_NOT_DECLARED"
                          (new Object/1 [(.-rawname element)])
                          XMLErrorReporter/SEVERITY_ERROR))
          (.addDTDDefaultAttrsAndValidate this element fCurrentElementIndex attributes)))
    (set! fInElementContent (== fCurrentContentSpecType XMLElementDecl/TYPE_CHILDREN))
    (set! fElementDepth (unchecked-inc-int fElementDepth))
    (when fPerformValidation
      (when (<= (alength fElementChildrenOffsetStack) fElementDepth)
        (let [newarray (new int/1 (unchecked-multiply-int (alength fElementChildrenOffsetStack) 2))]
          (System/arraycopy fElementChildrenOffsetStack
                            0
                            newarray
                            0
                            (alength fElementChildrenOffsetStack))
          (set! fElementChildrenOffsetStack newarray)))
      (aset fElementChildrenOffsetStack fElementDepth fElementChildrenLength)
      (when (<= (alength fElementChildren) fElementChildrenLength)
        (let [newarray (new QName/1 (unchecked-multiply-int fElementChildrenLength 2))]
          (System/arraycopy fElementChildren 0 newarray 0 (alength fElementChildren))
          (set! fElementChildren newarray)))
      (let [^:mutable qname (aget fElementChildren fElementChildrenLength)]
        (when (nil? qname)
          (loop [^int i fElementChildrenLength]
            (when (< i (alength fElementChildren))
              (aset fElementChildren i (QName.))
              (recur (unchecked-inc-int i))))
          (set! qname (aget fElementChildren fElementChildrenLength)))
        (.setValues qname element)
        (set! fElementChildrenLength (unchecked-inc-int fElementChildrenLength))))
    (.setValues fCurrentElement element)
    (.ensureStackCapacity this fElementDepth)
    (.setValues (aget fElementQNamePartsStack fElementDepth) fCurrentElement)
    (aset fElementIndexStack fElementDepth fCurrentElementIndex)
    (aset fContentSpecTypeStack fElementDepth fCurrentContentSpecType)
    (.startNamespaceScope this element attributes augs)
    false)

  (method ^:protected startNamespaceScope ^void [this ^QName element ^XMLAttributes attributes
                                                 ^Augmentations augs])

  (method ^:protected handleEndElement :throws [XNIException] ^void [this ^QName element
                                                                     ^Augmentations augs
                                                                     ^boolean isEmpty]
    (set! fElementDepth (unchecked-dec-int fElementDepth))
    (when fPerformValidation
      (let [elementIndex fCurrentElementIndex]
        (when (and (not (== elementIndex -1)) (not (== fCurrentContentSpecType -1)))
          (let [children fElementChildren
                childrenOffset (unchecked-add-int
                                 (aget fElementChildrenOffsetStack
                                       (unchecked-add-int fElementDepth 1))
                                 1)
                childrenLength (unchecked-subtract-int fElementChildrenLength childrenOffset)
                result (.checkContent this elementIndex children childrenOffset childrenLength)]
            (when-not (== result -1)
              (.getElementDecl fDTDGrammar elementIndex fTempElementDecl)
              (if (== (.-type fTempElementDecl) XMLElementDecl/TYPE_EMPTY)
                  (.reportError fErrorReporter
                                XMLMessageFormatter/XML_DOMAIN
                                "MSG_CONTENT_INVALID"
                                (new Object/1 [(.-rawname element) "EMPTY"])
                                XMLErrorReporter/SEVERITY_ERROR)
                  (let [^String messageKey (if (not (== result childrenLength))
                                               "MSG_CONTENT_INVALID"
                                               "MSG_CONTENT_INCOMPLETE")]
                    (.reportError fErrorReporter
                                  XMLMessageFormatter/XML_DOMAIN
                                  messageKey
                                  (new Object/1
                                       [(.-rawname element)
                                        (.getContentSpecAsString fDTDGrammar elementIndex)])
                                  XMLErrorReporter/SEVERITY_ERROR))))))
        (set! fElementChildrenLength
              (unchecked-add-int
                (aget fElementChildrenOffsetStack (unchecked-add-int fElementDepth 1))
                1))))
    (.endNamespaceScope this fCurrentElement augs isEmpty)
    (when (< fElementDepth -1) (throw (RuntimeException. "FWK008 Element stack underflow")))
    (if (< fElementDepth 0)
        (do
          (.clear fCurrentElement)
          (set! fCurrentElementIndex -1)
          (set! fCurrentContentSpecType -1)
          (set! fInElementContent false)
          (when fPerformValidation
            (let [^{:tag (Iterator String)} invIdRefs (.checkIDRefID fValidationState)]
              (when (some? invIdRefs)
                (while (.hasNext invIdRefs)
                  (.reportError fErrorReporter
                                XMLMessageFormatter/XML_DOMAIN
                                "MSG_ELEMENT_WITH_ID_REQUIRED"
                                (new Object/1 [(.next invIdRefs)])
                                XMLErrorReporter/SEVERITY_ERROR))))))
        (do
          (.setValues fCurrentElement (aget fElementQNamePartsStack fElementDepth))
          (set! fCurrentElementIndex (aget fElementIndexStack fElementDepth))
          (set! fCurrentContentSpecType (aget fContentSpecTypeStack fElementDepth))
          (set! fInElementContent (== fCurrentContentSpecType XMLElementDecl/TYPE_CHILDREN)))))

  (method ^:protected endNamespaceScope ^void [this ^QName element ^Augmentations augs
                                               ^boolean isEmpty]
    (when (and (some? fDocumentHandler) (not isEmpty))
      (.endElement fDocumentHandler fCurrentElement augs)))

  (method ^:protected isSpace ^boolean [this ^int c] (XMLChar/isSpace c))

  (method ^:public characterData ^boolean [this ^String data ^Augmentations augs]
    (.characters this (XMLString. (.toCharArray data) 0 (.length data)) augs)
    true))

  (method ^:protected addDTDDefaultAttrsAndValidate :throws [XNIException] ^void [this
                                                                                  ^QName elementName
                                                                                  ^int elementIndex
                                                                                  ^XMLAttributes attributes]
    (when-not (or (== elementIndex -1) (nil? fDTDGrammar))
      (let [^:mutable attlistIndex (.getFirstAttributeDeclIndex fDTDGrammar elementIndex)]
        (while (not (== attlistIndex -1))
          (.getAttributeDecl fDTDGrammar attlistIndex fTempAttDecl)
          (when DEBUG_ATTRIBUTES
            (when (some? fTempAttDecl)
              (let [elementDecl (XMLElementDecl.)]
                (.getElementDecl fDTDGrammar elementIndex elementDecl)
                (.println System/out (java-str "element: " (.-localpart (.-name elementDecl))))
                (.println System/out
                          (java-str "attlistIndex "
                                    attlistIndex
                                    "\nattName : '"
                                    (.-localpart (.-name fTempAttDecl))
                                    "'\nattType : "
                                    (.-type (.-simpleType fTempAttDecl))
                                    "\nattDefaultType : "
                                    (.-defaultType (.-simpleType fTempAttDecl))
                                    "\nattDefaultValue : '"
                                    (.-defaultValue (.-simpleType fTempAttDecl))
                                    "'\n"
                                    (.getLength attributes)
                                    "\n")))))
          (let [^:mutable attPrefix (.-prefix (.-name fTempAttDecl))
                ^:mutable attLocalpart (.-localpart (.-name fTempAttDecl))
                attRawName (.-rawname (.-name fTempAttDecl))
                attType (.getAttributeTypeName this fTempAttDecl)
                ^int attDefaultType (.-defaultType (.-simpleType fTempAttDecl))
                ^:mutable ^String attValue nil]
            (when (some? (.-defaultValue (.-simpleType fTempAttDecl)))
              (set! attValue (.-defaultValue (.-simpleType fTempAttDecl))))
            (let [^:mutable specified false
                  required (== attDefaultType XMLSimpleType/DEFAULT_TYPE_REQUIRED)
                  cdata (identical? attType XMLSymbols/fCDATASymbol)]
              (when (or (or (not cdata) required) (some? attValue))
                (let [attrCount (.getLength attributes)]
                  (loop [^int i 0]
                    (if (< i attrCount)
                        (if (identical? (.getQName attributes i) attRawName)
                            (set! specified true)
                            (recur (unchecked-inc-int i)))
                        nil))))
              (when-not specified
                (if required
                    (when fPerformValidation
                      (let [args (new Object/1 [(.-localpart elementName) attRawName])]
                        (.reportError fErrorReporter
                                      XMLMessageFormatter/XML_DOMAIN
                                      "MSG_REQUIRED_ATTRIBUTE_NOT_SPECIFIED"
                                      args
                                      XMLErrorReporter/SEVERITY_ERROR)))
                    (when (some? attValue)
                      (when (and fPerformValidation (.getStandalone fGrammarBucket))
                        (when (.getAttributeDeclIsExternal fDTDGrammar attlistIndex)
                          (let [args (new Object/1 [(.-localpart elementName) attRawName])]
                            (.reportError fErrorReporter
                                          XMLMessageFormatter/XML_DOMAIN
                                          "MSG_DEFAULTED_ATTRIBUTE_NOT_SPECIFIED"
                                          args
                                          XMLErrorReporter/SEVERITY_ERROR))))
                      (when fNamespaces
                        (let [index (.indexOf attRawName \:)]
                          (when-not (== index -1)
                            (set! attPrefix (.substring attRawName 0 index))
                            (set! attPrefix (.addSymbol fSymbolTable attPrefix))
                            (set! attLocalpart (.substring attRawName (unchecked-add-int index 1)))
                            (set! attLocalpart (.addSymbol fSymbolTable attLocalpart)))))
                      (.setValues fTempQName
                                  attPrefix
                                  attLocalpart
                                  attRawName
                                  (.-uri (.-name fTempAttDecl)))
                      (.addAttribute attributes fTempQName attType attValue))))
              (set! attlistIndex (.getNextAttributeDeclIndex fDTDGrammar attlistIndex)))))
        (let [attrCount (.getLength attributes)]
          (loop [^int i 0]
            (when (< i attrCount)
              (let [attrRawName (.getQName attributes i)
                    ^:mutable declared false]
                (when fPerformValidation
                  (when (.getStandalone fGrammarBucket)
                    (let [nonNormalizedValue (.getNonNormalizedValue attributes i)]
                      (when (some? nonNormalizedValue)
                        (let [entityName (.getExternalEntityRefInAttrValue this nonNormalizedValue)]
                          (when (some? entityName)
                            (.reportError
                              fErrorReporter
                              XMLMessageFormatter/XML_DOMAIN
                              "MSG_REFERENCE_TO_EXTERNALLY_DECLARED_ENTITY_WHEN_STANDALONE"
                              (new Object/1 [entityName])
                              XMLErrorReporter/SEVERITY_ERROR)))))))
                (let [^:mutable position (.getFirstAttributeDeclIndex fDTDGrammar elementIndex)]
                  (while (not (== position -1))
                    (.getAttributeDecl fDTDGrammar position fTempAttDecl)
                    (when (identical? (.-rawname (.-name fTempAttDecl)) attrRawName)
                      (set! declared true)
                      (break))
                    (set! position (.getNextAttributeDeclIndex fDTDGrammar position)))
                  (if (not declared)
                      (do
                        (when fPerformValidation
                          (let [args (new Object/1 [(.-rawname elementName) attrRawName])]
                            (.reportError fErrorReporter
                                          XMLMessageFormatter/XML_DOMAIN
                                          "MSG_ATTRIBUTE_NOT_DECLARED"
                                          args
                                          XMLErrorReporter/SEVERITY_ERROR)))

            (let [enumVal (cast String (.get enumData enumIdx))
                  decodedVal (Base64/decode enumVal)]
              (if (and (some? decodedVal) (> (.length (String. decodedVal)) (.-maxLength xsFacets)))
                  (do
                    (.reportSchemaWarning this
                                          "FacetsContradict"
                                          (new Object/1
                                               [enumVal SchemaSymbols/ELT_MAXLENGTH typeName])
                                          contextNode)
                    (recur (unchecked-inc-int enumIdx)))
                  (recur (unchecked-inc-int enumIdx))))))
      :else
        (loop [^int enumIdx 0]
          (when (< enumIdx (.size enumData))
            (let [enumVal (cast String (.get enumData enumIdx))]
              (if (> (.length enumVal) (.-maxLength xsFacets))
                  (do
                    (.reportSchemaWarning this
                                          "FacetsContradict"
                                          (new Object/1

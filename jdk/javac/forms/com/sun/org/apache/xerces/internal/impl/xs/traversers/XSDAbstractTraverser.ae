                                                                     ^XSSimpleType baseValidator
                                                                     ^{:tag (List String)} enumData
                                                                     ^Element contextNode
                                                                     ^String typeName]
    (cond
      (and (.equals SchemaSymbols/URI_SCHEMAFORSCHEMA (.getNamespace baseValidator))
           (.equals SchemaSymbols/ATTVAL_HEXBINARY (.getName baseValidator)))
        (loop [^int enumIdx 0]
          (when (< enumIdx (.size enumData))
            (let [enumVal (cast String (.get enumData enumIdx))]
              (if (< (unchecked-divide-int (.length enumVal) 2) (.-minLength xsFacets))
                  (do
                    (.reportSchemaWarning this
                                          "FacetsContradict"
                                          (new Object/1
                                               [enumVal SchemaSymbols/ELT_MINLENGTH typeName])
                                          contextNode)
                    (recur (unchecked-inc-int enumIdx)))
                  (recur (unchecked-inc-int enumIdx))))))
      (and (.equals SchemaSymbols/URI_SCHEMAFORSCHEMA (.getNamespace baseValidator))
           (.equals SchemaSymbols/ATTVAL_BASE64BINARY (.getName baseValidator)))
        (loop [^int enumIdx 0]
          (when (< enumIdx (.size enumData))
            (let [enumVal (cast String (.get enumData enumIdx))
                  decodedVal (Base64/decode enumVal)]
              (if (and (some? decodedVal) (< (.length (String. decodedVal)) (.-minLength xsFacets)))
                  (do
                    (.reportSchemaWarning this
                                          "FacetsContradict"
                                          (new Object/1
                                               [enumVal SchemaSymbols/ELT_MINLENGTH typeName])
                                          contextNode)
                    (recur (unchecked-inc-int enumIdx)))
                  (recur (unchecked-inc-int enumIdx))))))
      :else
        (loop [^int enumIdx 0]
          (when (< enumIdx (.size enumData))
            (let [enumVal (cast String (.get enumData enumIdx))]
              (if (< (.length enumVal) (.-minLength xsFacets))
                  (do
                    (.reportSchemaWarning this
                                          "FacetsContradict"
                                          (new Object/1
                                               [enumVal SchemaSymbols/ELT_MINLENGTH typeName])
                                          contextNode)
                    (recur (unchecked-inc-int enumIdx)))
                  (recur (unchecked-inc-int enumIdx))))))))

  (method ^:private checkEnumerationAndLengthInconsistency ^void [this ^XSSimpleType baseValidator
                                                                  ^{:tag (List String)} enumData
                                                                  ^Element contextNode
                                                                  ^String typeName]
    (cond
      (and (.equals SchemaSymbols/URI_SCHEMAFORSCHEMA (.getNamespace baseValidator))
           (.equals SchemaSymbols/ATTVAL_HEXBINARY (.getName baseValidator)))
        (loop [^int enumIdx 0]
          (when (< enumIdx (.size enumData))
            (let [enumVal (cast String (.get enumData enumIdx))]
              (if (not (== (unchecked-divide-int (.length enumVal) 2) (.-length xsFacets)))
                  (do
                    (.reportSchemaWarning this
                                          "FacetsContradict"
                                          (new Object/1 [enumVal SchemaSymbols/ELT_LENGTH typeName])
                                          contextNode)
                    (recur (unchecked-inc-int enumIdx)))
                  (recur (unchecked-inc-int enumIdx))))))
      (and (.equals SchemaSymbols/URI_SCHEMAFORSCHEMA (.getNamespace baseValidator))
           (.equals SchemaSymbols/ATTVAL_BASE64BINARY (.getName baseValidator)))
        (loop [^int enumIdx 0]
          (when (< enumIdx (.size enumData))
            (let [enumVal (cast String (.get enumData enumIdx))
                  decodedVal (Base64/decode enumVal)]
              (if (and (some? decodedVal)
                       (not (== (.length (String. decodedVal)) (.-length xsFacets))))
                  (do
                    (.reportSchemaWarning this
                                          "FacetsContradict"
                                          (new Object/1 [enumVal SchemaSymbols/ELT_LENGTH typeName])
                                          contextNode)
                    (recur (unchecked-inc-int enumIdx)))
                  (recur (unchecked-inc-int enumIdx))))))
      :else
        (loop [^int enumIdx 0]
          (when (< enumIdx (.size enumData))
            (let [enumVal (cast String (.get enumData enumIdx))]
              (if (not (== (.length enumVal) (.-length xsFacets)))
                  (do
                    (.reportSchemaWarning this
                                          "FacetsContradict"
                                          (new Object/1 [enumVal SchemaSymbols/ELT_LENGTH typeName])
                                          contextNode)
                    (recur (unchecked-inc-int enumIdx)))
                  (recur (unchecked-inc-int enumIdx))))))))

  (method ^:private containsQName ^boolean [this ^XSSimpleType type]
    (cond
      (== (.getVariety type) XSSimpleType/VARIETY_ATOMIC)
        (let [primitive (.getPrimitiveKind type)]
          (or (== primitive XSSimpleType/PRIMITIVE_QNAME)
              (== primitive XSSimpleType/PRIMITIVE_NOTATION)))
      (== (.getVariety type) XSSimpleType/VARIETY_LIST)
        (.containsQName this (cast XSSimpleType (.getItemType type)))
      :else
        (do
          (when (== (.getVariety type) XSSimpleType/VARIETY_UNION)
            (let [members (.getMemberTypes type)]
              (loop [^int i 0]
                (if (< i (.getLength members))
                    (if (.containsQName this (cast XSSimpleType (.item members i)))
                        (return true)
                        (recur (unchecked-inc-int i)))
                    nil))))
          false)))

  (method traverseAttrsAndAttrGrps ^Element [this ^Element firstAttr ^XSAttributeGroupDecl attrGrp
                                             ^XSDocumentInfo schemaDoc ^SchemaGrammar grammar
                                             ^XSComplexTypeDecl enclosingCT]
    (let [^:mutable ^Element child nil
          ^:mutable ^XSAttributeGroupDecl tempAttrGrp nil
          ^:mutable ^XSAttributeUseImpl tempAttrUse nil
          ^:mutable ^XSAttributeUse otherUse nil
          ^:mutable ^String childName nil]
      (set! child firstAttr)
      (while (some? child)
        (set! childName (DOMUtil/getLocalName child))
        (cond
          (.equals childName SchemaSymbols/ELT_ATTRIBUTE)
            (do
              (set! tempAttrUse
                    (.traverseLocal (.-fAttributeTraverser fSchemaHandler)
                                    child
                                    schemaDoc
                                    grammar
                                    enclosingCT))
              (when (some? tempAttrUse)
                (if (== (.-fUse tempAttrUse) SchemaSymbols/USE_PROHIBITED)
                    (.addAttributeUse attrGrp tempAttrUse)
                    (do
                      (set! otherUse
                            (.getAttributeUseNoProhibited
                              attrGrp
                              (.getNamespace (.-fAttrDecl tempAttrUse))
                              (.getName (.-fAttrDecl tempAttrUse))))
                      (if (nil? otherUse)
                          (let [idName (.addAttributeUse attrGrp tempAttrUse)]
                            (when (some? idName)
                              (let [^String code (if (nil? enclosingCT)
                                                     "ag-props-correct.3"
                                                     "ct-props-correct.5")
                                    ^String name (if (nil? enclosingCT)
                                                     (.-fName attrGrp)
                                                     (.getName enclosingCT))]
                                (.reportSchemaError
                                  this
                                  code
                                  (new Object/1 [name (.getName (.-fAttrDecl tempAttrUse)) idName])
                                  child))))
                          (when-not (identical? otherUse tempAttrUse)
                            (let [^String code (if (nil? enclosingCT)
                                                   "ag-props-correct.2"
                                                   "ct-props-correct.4")
                                  ^String name (if (nil? enclosingCT)
                                                   (.-fName attrGrp)
                                                   (.getName enclosingCT))]
                              (.reportSchemaError
                                this
                                code
                                (new Object/1 [name (.getName (.-fAttrDecl tempAttrUse))])
                                child))))))))
          (.equals childName SchemaSymbols/ELT_ATTRIBUTEGROUP)
            (do
              (set! tempAttrGrp
                    (.traverseLocal (.-fAttributeGroupTraverser fSchemaHandler)
                                    child
                                    schemaDoc
                                    grammar))
              (when (some? tempAttrGrp)
                (let [attrUseS (.getAttributeUses tempAttrGrp)
                      ^:mutable ^XSAttributeUseImpl oneAttrUse nil
                      attrCount (.getLength attrUseS)]
                  (loop [^int i 0]
                    (when (< i attrCount)
                      (set! oneAttrUse (cast XSAttributeUseImpl (.item attrUseS i)))
                      (if (== (.-fUse oneAttrUse) SchemaSymbols/USE_PROHIBITED)
                          (do (.addAttributeUse attrGrp oneAttrUse) (recur (unchecked-inc-int i)))
                          (do
                            (set! otherUse
                                  (.getAttributeUseNoProhibited
                                    attrGrp
                                    (.getNamespace (.-fAttrDecl oneAttrUse))
                                    (.getName (.-fAttrDecl oneAttrUse))))
                            (cond
                              (nil? otherUse)
                                (let [idName (.addAttributeUse attrGrp oneAttrUse)]
                                  (if (some? idName)
                                      (let [^String code (if (nil? enclosingCT)
                                                             "ag-props-correct.3"
                                                             "ct-props-correct.5")
                                            ^String name (if (nil? enclosingCT)
                                                             (.-fName attrGrp)
                                                             (.getName enclosingCT))]
                                        (.reportSchemaError
                                          this
                                          code
                                          (new Object/1
                                               [name (.getName (.-fAttrDecl oneAttrUse)) idName])
                                          child)
                                        (recur (unchecked-inc-int i)))
                                      (recur (unchecked-inc-int i))))
                              (not (identical? oneAttrUse otherUse))
                                (let [^String code (if (nil? enclosingCT)
                                                       "ag-props-correct.2"
                                                       "ct-props-correct.4")
                                      ^String name (if (nil? enclosingCT)
                                                       (.-fName attrGrp)
                                                       (.getName enclosingCT))]
                                  (.reportSchemaError
                                    this
                                    code
                                    (new Object/1 [name (.getName (.-fAttrDecl oneAttrUse))])
                                    child)
                                  (recur (unchecked-inc-int i)))
                              :else (recur (unchecked-inc-int i)))))))
                  (when (some? (.-fAttributeWC tempAttrGrp))
                    (if (nil? (.-fAttributeWC attrGrp))
                        (set! (.-fAttributeWC attrGrp) (.-fAttributeWC tempAttrGrp))
                        (do
                          (set! (.-fAttributeWC attrGrp)
                                (.performIntersectionWith
                                  (.-fAttributeWC attrGrp)
                                  (.-fAttributeWC tempAttrGrp)
                                  (.-fProcessContents (.-fAttributeWC attrGrp))))
                          (when (nil? (.-fAttributeWC attrGrp))
                            (let [^String code (if (nil? enclosingCT)
                                                   "src-attribute_group.2"
                                                   "src-ct.4")
                                  ^String name (if (nil? enclosingCT)
                                                   (.-fName attrGrp)
                                                   (.getName enclosingCT))]
                              (.reportSchemaError this code (new Object/1 [name]) child)))))))))
          :else (break))
        (set! child (DOMUtil/getNextSiblingElement child)))
      (when (some? child)
        (set! childName (DOMUtil/getLocalName child))
        (when (.equals childName SchemaSymbols/ELT_ANYATTRIBUTE)
          (let [tempAttrWC (.traverseAnyAttribute
                             (.-fWildCardTraverser fSchemaHandler)
                             child
                             schemaDoc
                             grammar)]
            (if (nil? (.-fAttributeWC attrGrp))
                (set! (.-fAttributeWC attrGrp) tempAttrWC)
                (do
                  (set! (.-fAttributeWC attrGrp)
                        (.performIntersectionWith
                          tempAttrWC
                          (.-fAttributeWC attrGrp)
                          (.-fProcessContents tempAttrWC)))
                  (when (nil? (.-fAttributeWC attrGrp))
                    (let [^String code (if (nil? enclosingCT) "src-attribute_group.2" "src-ct.4")
                          ^String name (if (nil? enclosingCT)
                                           (.-fName attrGrp)
                                           (.getName enclosingCT))]
                      (.reportSchemaError this code (new Object/1 [name]) child)))))
            (set! child (DOMUtil/getNextSiblingElement child)))))
      child))

  (method reportSchemaError ^void [this ^String key ^Object/1 args ^Element ele]
    (.reportSchemaError fSchemaHandler key args ele))

  (method reportSchemaWarning ^void [this ^String key ^Object/1 args ^Element ele]
    (.reportSchemaWarning fSchemaHandler key args ele))

  (method checkNotationType ^void [this ^String refName ^XSTypeDefinition typeDecl ^Element elem]
    (when (and
            (and (== (.getTypeCategory typeDecl) XSTypeDefinition/SIMPLE_TYPE)
                 (== (.getVariety (cast XSSimpleType typeDecl)) XSSimpleType/VARIETY_ATOMIC))
            (== (.getPrimitiveKind (cast XSSimpleType typeDecl)) XSSimpleType/PRIMITIVE_NOTATION))
      (when (== (bit-and-int (.getDefinedFacets (cast XSSimpleType typeDecl))
                             XSSimpleType/FACET_ENUMERATION)
                0)
        (.reportSchemaError this
                            "enumeration-required-notation"
                            (new Object/1 [(.getName typeDecl) refName (DOMUtil/getLocalName elem)])
                            elem))))

  (method ^:protected checkOccurrences ^XSParticleDecl [this ^XSParticleDecl particle
                                                        ^String particleName ^Element parent
                                                        ^int allContextFlags ^long defaultVals]
    (let [^:mutable min (.-fMinOccurs particle)
          ^:mutable max (.-fMaxOccurs particle)
          defaultMin (not (== (bit-and defaultVals
                                       (bit-shift-left-int 1 XSAttributeChecker/ATTIDX_MINOCCURS))
                              0))
          defaultMax (not (== (bit-and defaultVals
                                       (bit-shift-left-int 1 XSAttributeChecker/ATTIDX_MAXOCCURS))
                              0))
          processingAllEl (not (== (bit-and-int allContextFlags PROCESSING_ALL_EL) 0))
          processingAllGP (not (== (bit-and-int allContextFlags PROCESSING_ALL_GP) 0))
          groupRefWithAll (not (== (bit-and-int allContextFlags GROUP_REF_WITH_ALL) 0))
          isGroupChild (not (== (bit-and-int allContextFlags CHILD_OF_GROUP) 0))]
      (when isGroupChild
        (when-not defaultMin
          (let [args (new Object/1 [particleName "minOccurs"])]
            (.reportSchemaError this "s4s-att-not-allowed" args parent)
            (set! min 1)))
        (when-not defaultMax
          (let [args (new Object/1 [particleName "maxOccurs"])]
            (.reportSchemaError this "s4s-att-not-allowed" args parent)
            (set! max 1))))
      (if (and (== min 0) (== max 0))
          (do (set! (.-fType particle) XSParticleDecl/PARTICLE_EMPTY) nil)
          (do
            (cond
              processingAllEl
                (when-not (== max 1)
                  (.reportSchemaError this
                                      "cos-all-limited.2"
                                      (new Object/1
                                           [(if (== max SchemaSymbols/OCCURRENCE_UNBOUNDED)
                                                SchemaSymbols/ATTVAL_UNBOUNDED
                                                ^Object (Integer/toString max))
                                            (.getName (cast XSElementDecl (.-fValue particle)))])
                                      parent)
                  (set! max 1)
                  (when (> min 1) (set! min 1)))
              (or processingAllGP groupRefWithAll)
                (when-not (== max 1)
                  (.reportSchemaError this "cos-all-limited.1.2" nil parent)
                  (when (> min 1) (set! min 1))
                  (set! max 1)))
            (set! (.-fMinOccurs particle) min)
            (set! (.-fMaxOccurs particle) max)
            particle))))

  (method ^:private ^:static processAttValue ^String [^String original]
    (let [^:final length (.length original)]
      (loop [^int i 0]
        (when (< i length)
          (let [currChar (.charAt original i)]
            (if (or (or (or (or (or (== currChar \") (== currChar \<)) (== currChar \&))
                            (== currChar 0x09))
                        (== currChar 0x0A))
                    (== currChar 0x0D))
                (return (XSDAbstractTraverser/escapeAttValue original i))
                (recur (unchecked-inc-int i))))))
      original))

  (method ^:private ^:static escapeAttValue ^String [^String original ^int from]
    (let [^:mutable ^int i 0
          ^:final length (.length original)
          newVal (StringBuilder. length)]
      (.append newVal (.substring original 0 from))
      (set! i from)
      (while (< i length)
        (let [currChar (.charAt original i)]
          (cond
            (== currChar \") (.append newVal "&quot;")
            (== currChar \<) (.append newVal "&lt;")
            (== currChar \&) (.append newVal "&amp;")
            (== currChar 0x09) (.append newVal "&#x9;")
            (== currChar 0x0A) (.append newVal "&#xA;")
            (== currChar 0x0D) (.append newVal "&#xD;")
            :else (.append newVal currChar)))
        (set! i (unchecked-inc-int i)))
      (.toString newVal))))

  (method ^:protected scanXMLDeclOrTextDecl :throws [IOException XNIException] ^void [this
                                                                                      ^boolean scanningTextDecl]
    (.scanXMLDeclOrTextDecl super scanningTextDecl fStrings)
    (set! fMarkupDepth (unchecked-dec-int fMarkupDepth))
    (let [version (aget fStrings 0)
          encoding (aget fStrings 1)
          standalone (aget fStrings 2)]
      (set! fDeclaredEncoding encoding)
      (set! fStandaloneSet (some? standalone))
      (set! fStandalone (and fStandaloneSet (.equals standalone "yes")))
      (.setStandalone (.-fEntityManager this) fStandalone)
      (when (some? fDocumentHandler)
        (if scanningTextDecl
            (.textDecl fDocumentHandler version encoding nil)
            (.xmlDecl fDocumentHandler version encoding standalone nil)))
      (when (some? version)
        (.setVersion (.-fEntityScanner this) version)
        (.setXMLVersion (.-fEntityScanner this) version))
      (when (and (some? encoding)
                 (not (.isEncodingExternallySpecified (.getCurrentEntity (.-fEntityScanner this)))))
        (.setEncoding (.-fEntityScanner this) encoding))))


    (if (.skipString (.-fEntityScanner this) rawname)
        (let [c (unchecked-char (.peekChar (.-fEntityScanner this)))]
          (if (or (or (== c \space) (== c \/)) (== c \>))
              (do (set! fElementRawname rawname) true)
              false))
        false))

  (method skipQElement :throws [IOException] ^boolean [this ^String rawname]
    (let [c (.getChar (.-fEntityScanner this) (.length rawname))]
      (if (XMLChar/isName c) false (.skipString (.-fEntityScanner this) rawname))))

  (method ^:protected skipElement :throws [IOException] ^boolean [this]
    (if (not fShouldSkip)
        false
        (do
          (when-not (== fLastPointerLocation 0)
            (let [rawname (aget fElementArray (unchecked-add-int fLastPointerLocation 1))]
              (if (and (some? rawname) (.skipFromTheBuffer this rawname))
                  (do
                    (set! fLastPointerLocation
                          (unchecked-short (unchecked-inc-int fLastPointerLocation)))
                    (when DEBUG_SKIP_ALGORITHM
                      (.println System/out
                                (java-str "Element "
                                          fElementRawname
                                          " was SKIPPED at pointer location = "
                                          fLastPointerLocation)))
                    (return true))
                  (set! fLastPointerLocation 0))))
          (and fShouldSkip (.skipElement this (unchecked-short 0))))))

  (method skipElement :throws [IOException] ^boolean [this ^short column]
    (let [depth (unchecked-short (.-fDepth fElementStack))]
      (if (> depth MAX_DEPTH_LIMIT)
          (set! fShouldSkip false)
          (do
            (loop [^short i column]
              (when (< i MAX_POINTER_AT_A_DEPTH)
                (let [pointer (.getElementPointer this depth i)]
                  (when (== pointer 0) (return (set! fShouldSkip false)))
                  (if (and (some? (aget fElementArray pointer))
                           (.skipFromTheBuffer this (aget fElementArray pointer)))
                      (do
                        (when DEBUG_SKIP_ALGORITHM
                          (.println System/out)
                          (.println System/out
                                    (java-str "Element "
                                              fElementRawname
                                              " was SKIPPED at depth = "
                                              (.-fDepth fElementStack)
                                              " column = "
                                              column))
                          (.println System/out))
                        (set! fLastPointerLocation pointer)
                        (return (set! fShouldSkip true)))
                      (recur (unchecked-short (unchecked-inc-int i)))))))
            (set! fShouldSkip false)))))

  (method ^:protected scanStartElement :throws [IOException XNIException] ^boolean [this]
    (when DEBUG_START_END_ELEMENT
      (.println System/out (java-str (.toString (.getClass this)) ">>> scanStartElement()")))
    (when (and fSkip (not fAdd))
      (let [name (.getNext fElementStack)]
        (when DEBUG_SKIP_ALGORITHM
          (.println System/out (java-str "Trying to skip String = " (.-rawname name))))
        (set! fSkip (.skipString (.-fEntityScanner this) (.-rawname name)))
        (if fSkip
            (do
              (when DEBUG_SKIP_ALGORITHM
                (.println System/out (java-str "Element SUCESSFULLY skipped = " (.-rawname name))))
              (.push fElementStack)
              (set! fElementQName name))
            (do
              (.reposition fElementStack)
              (when DEBUG_SKIP_ALGORITHM
                (.println System/out "Element was NOT skipped, REPOSITIONING stack"))))))
    (when (or (not fSkip) fAdd)
      (set! fElementQName (.nextElement fElementStack))
      (if (.-fNamespaces this)
          (.scanQName (.-fEntityScanner this) fElementQName XMLScanner$NameType/ELEMENTSTART)
          (let [name (.scanName (.-fEntityScanner this) XMLScanner$NameType/ELEMENTSTART)]
            (.setValues fElementQName nil name name nil)))
      (when DEBUG
        (.println System/out
                  (java-str "Element scanned in start element is " (.toString fElementQName))))
      (when DEBUG_SKIP_ALGORITHM
        (when fAdd
          (.println System/out
                    (java-str "Elements are being ADDED -- elemet added is = "
                              (.-rawname fElementQName)
                              " at count = "
                              (.-fCount fElementStack))))))
    (when fAdd (.matchElement fElementStack fElementQName))
    (set! fCurrentElement fElementQName)
    (let [rawname (.-rawname fElementQName)]
      (set! fEmptyElement false)
      (.removeAllAttributes fAttributes)
      (.checkDepth this rawname)
      (when-not (.seekCloseOfStartTag this)
        (set! fReadingAttributes true)
        (set! (.-fAttributeCacheUsedCount this) 0)
        (set! (.-fStringBufferIndex this) 0)
        (set! fAddDefaultAttr true)
        (loop []
          (.scanAttribute this fAttributes)
          (when (and (and (some? (.-fSecurityManager this))
                          (not (.isNoLimit (.-fSecurityManager this) fElementAttributeLimit)))
                     (> (.getLength fAttributes) fElementAttributeLimit))
            (.reportError (.-fErrorReporter this)
                          XMLMessageFormatter/XML_DOMAIN
                          "ElementAttributeLimit"
                          (new Object/1
                               [rawname
                                fElementAttributeLimit
                                (.systemProperty XMLSecurityManager$Limit/ELEMENT_ATTRIBUTE_LIMIT)])
                          XMLErrorReporter/SEVERITY_FATAL_ERROR))
          (when-not (.seekCloseOfStartTag this) (recur)))
        (set! fReadingAttributes false))
      (if fEmptyElement
          (do
            (set! fMarkupDepth (unchecked-dec-int fMarkupDepth))
            (when (< fMarkupDepth
                     (aget fEntityStack (unchecked-subtract-int (.-fEntityDepth this) 1)))
              (.reportFatalError this
                                 "ElementEntityMismatch"
                                 (new Object/1 [(.-rawname fCurrentElement)])))
            (when (some? fDocumentHandler)
              (.emptyElement fDocumentHandler fElementQName fAttributes nil))
            (.popElement fElementStack))
          (do
            (when (some? dtdGrammarUtil) (.startElement dtdGrammarUtil fElementQName fAttributes))
            (when (some? fDocumentHandler)
              (.startElement fDocumentHandler fElementQName fAttributes nil))))
      (when DEBUG_START_END_ELEMENT
        (.println System/out
                  (java-str (.toString (.getClass this)) "<<< scanStartElement(): " fEmptyElement)))
      fEmptyElement))

  (method ^:protected seekCloseOfStartTag :throws [IOException XNIException] ^boolean [this]
    (let [sawSpace (.skipSpaces (.-fEntityScanner this))
          c (.peekChar (.-fEntityScanner this))]
      (cond
        (== c \>) (do (.scanChar (.-fEntityScanner this) nil) true)
        (== c \/)
          (do
            (.scanChar (.-fEntityScanner this) nil)
            (when-not (.skipChar (.-fEntityScanner this) \> XMLScanner$NameType/ELEMENTEND)
              (.reportFatalError this
                                 "ElementUnterminated"
                                 (new Object/1 [(.-rawname fElementQName)])))
            (set! fEmptyElement true)
            true)
        :else
          (do
            (when (or (not (.isValidNameStartChar this c)) (not sawSpace))
              (when (or (not (.isValidNameStartHighSurrogate this c)) (not sawSpace))
                (.reportFatalError this
                                   "ElementUnterminated"
                                   (new Object/1 [(.-rawname fElementQName)]))))
            false))))

  (method ^:public hasAttributes ^boolean [this]
    (> (.getLength fAttributes) 0))

  (method ^:public getAttributeIterator ^XMLAttributesIteratorImpl [this]
    (when (and (some? dtdGrammarUtil) fAddDefaultAttr)
      (.addDTDDefaultAttrs dtdGrammarUtil fElementQName fAttributes)
      (set! fAddDefaultAttr false))
    fAttributes)

  (method ^:public standaloneSet ^boolean [this] fStandaloneSet)

  (method ^:public isStandAlone ^boolean [this] fStandalone)

  (method ^:protected scanAttribute :throws [IOException XNIException] ^void [this
                                                                              ^XMLAttributes attributes]
    (when DEBUG_START_END_ELEMENT
      (.println System/out (java-str (.toString (.getClass this)) ">>> scanAttribute()")))
    (if (.-fNamespaces this)
        (.scanQName (.-fEntityScanner this) fAttributeQName XMLScanner$NameType/ATTRIBUTENAME)
        (let [name (.scanName (.-fEntityScanner this) XMLScanner$NameType/ATTRIBUTENAME)]
          (.setValues fAttributeQName nil name name nil)))
    (.skipSpaces (.-fEntityScanner this))
    (when-not (.skipChar (.-fEntityScanner this) \= XMLScanner$NameType/ATTRIBUTE)
      (.reportFatalError this
                         "EqRequiredInAttribute"
                         (new Object/1 [(.-rawname fCurrentElement) (.-rawname fAttributeQName)])))
    (.skipSpaces (.-fEntityScanner this))
    (let [^:mutable ^int attIndex 0
          isVC (and fHasExternalDTD (not fStandalone))
          tmpStr (.getString this)]
      (.scanAttributeValue this
                           tmpStr
                           fTempString2
                           (.-rawname fAttributeQName)
                           attributes
                           attIndex
                           isVC
                           (.-rawname fCurrentElement)
                           false)
      (let [oldLen (.getLength attributes)]
        (set! attIndex (.addAttribute attributes fAttributeQName XMLSymbols/fCDATASymbol nil))
        (when (== oldLen (.getLength attributes))
          (.reportFatalError this
                             "AttributeNotUnique"
                             (new Object/1
                                  [(.-rawname fCurrentElement) (.-rawname fAttributeQName)])))
        (.setValue attributes attIndex nil tmpStr)
        (.setSpecified attributes attIndex true)
        (when DEBUG_START_END_ELEMENT
          (.println System/out (java-str (.toString (.getClass this)) "<<< scanAttribute()"))))))

  (method ^:protected scanContent :throws [IOException XNIException] ^int [this
                                                                           ^XMLStringBuffer content]
    (set! (.-length fTempString) 0)
    (let [^:mutable c (.scanContent (.-fEntityScanner this) fTempString)]
      (.append content fTempString)
      (set! (.-length fTempString) 0)
      (if (== c \return)
          (do
            (.scanChar (.-fEntityScanner this) nil)
            (.append content (unchecked-char c))
            (set! c -1))
          (when (== c \])
            (.append content (unchecked-char (.scanChar (.-fEntityScanner this) nil)))
            (set! fInScanContent true)
            (when (.skipChar (.-fEntityScanner this) \] nil)
              (.append content \])
              (while (.skipChar (.-fEntityScanner this) \] nil) (.append content \]))
              (when (.skipChar (.-fEntityScanner this) \> nil)
                (.reportFatalError this "CDEndInContent" nil)))
            (set! fInScanContent false)
            (set! c -1)))
      (when (and (some? fDocumentHandler) (> (.-length content) 0)) nil)
      c))

  (method ^:protected scanCDATASection :throws [IOException XNIException] ^boolean [this
                                                                                    ^XMLStringBuffer contentBuffer
                                                                                    ^boolean complete]
    (when (some? fDocumentHandler) nil)
    (while true
      (if (not (.scanData (.-fEntityScanner this) "]]>" contentBuffer fChunkSize))
          (do
            (set! fInCData false)
            (set! fCDataEnd true)
            (set! fMarkupDepth (unchecked-dec-int fMarkupDepth))
            (break))
          (let [c (.peekChar (.-fEntityScanner this))]
            (if (and (not (== c -1)) (.isInvalidLiteral this c))
                (if (XMLChar/isHighSurrogate c)
                    (.scanSurrogates this contentBuffer)
                    (do
                      (.reportFatalError this
                                         "InvalidCharInCDSect"
                                         (new Object/1 [(Integer/toString c 16)]))
                      (.scanChar (.-fEntityScanner this) nil)))
                (do (set! fInCData true) (set! fCDataEnd false) (break)))
            (when (some? fDocumentHandler) nil))))
    true)

  (method ^:protected scanEndElement :throws [IOException XNIException] ^int [this]
    (when DEBUG_START_END_ELEMENT
      (.println System/out (java-str (.toString (.getClass this)) ">>> scanEndElement()")))
    (let [endElementName (.popElement fElementStack)
          rawname (.-rawname endElementName)]
      (when DEBUG (.println System/out (java-str "endElementName = " (.toString endElementName))))
      (when-not (.skipString (.-fEntityScanner this) (.-rawname endElementName))
        (.reportFatalError this "ETagRequired" (new Object/1 [rawname])))
      (.skipSpaces (.-fEntityScanner this))
      (when-not (.skipChar (.-fEntityScanner this) \> XMLScanner$NameType/ELEMENTEND)
        (.reportFatalError this "ETagUnterminated" (new Object/1 [rawname])))
      (set! fMarkupDepth (unchecked-dec-int fMarkupDepth))
      (set! fMarkupDepth (unchecked-dec-int fMarkupDepth))
      (when (< fMarkupDepth (aget fEntityStack (unchecked-subtract-int (.-fEntityDepth this) 1)))
        (.reportFatalError this "ElementEntityMismatch" (new Object/1 [rawname])))
      (when (some? fDocumentHandler) (.endElement fDocumentHandler endElementName nil))
      (when (some? dtdGrammarUtil) (.endElement dtdGrammarUtil endElementName))
      fMarkupDepth))

  (method ^:protected scanCharReference :throws [IOException XNIException] ^void [this]
    (.clear fStringBuffer2)
    (let [ch (.scanCharReferenceValue this fStringBuffer2 nil)]
      (set! fMarkupDepth (unchecked-dec-int fMarkupDepth))
      (when-not (== ch -1)
        (when (some? fDocumentHandler)
          (when (.-fNotifyCharRefs this)
            (.startGeneralEntity fDocumentHandler (.-fCharRefLiteral this) nil nil nil))
          (let [^:mutable ^Augmentations augs nil]
            (when (and (.-fValidation this) (<= ch 0x20))
              (if (some? fTempAugmentations)
                  (.removeAllItems fTempAugmentations)
                  (set! fTempAugmentations (AugmentationsImpl.)))
              (set! augs fTempAugmentations)
              (.putItem augs Constants/CHAR_REF_PROBABLE_WS Boolean/TRUE))
            (when (.-fNotifyCharRefs this)
              (.endGeneralEntity fDocumentHandler (.-fCharRefLiteral this) nil)))))))

  (method ^:protected scanEntityReference :throws [IOException XNIException] ^void [this
                                                                                    ^XMLStringBuffer content]
    (let [name (.scanName (.-fEntityScanner this) XMLScanner$NameType/REFERENCE)]
      (if (nil? name)
          (.reportFatalError this "NameRequiredInReference" nil)
          (do
            (when-not (.skipChar (.-fEntityScanner this) \; XMLScanner$NameType/REFERENCE)
              (.reportFatalError this "SemicolonRequiredInReference" (new Object/1 [name])))
            (when (.isUnparsedEntity fEntityStore name)
              (.reportFatalError this "ReferenceToUnparsedEntity" (new Object/1 [name])))
            (set! fMarkupDepth (unchecked-dec-int fMarkupDepth))
            (set! fCurrentEntityName name)
            (cond
              (identical? name XMLDocumentFragmentScannerImpl/fAmpSymbol)
                (do
                  (.handleCharacter this \& XMLDocumentFragmentScannerImpl/fAmpSymbol content)
                  (set! fScannerState SCANNER_STATE_BUILT_IN_REFS))
              (identical? name XMLDocumentFragmentScannerImpl/fLtSymbol)
                (do
                  (.handleCharacter this \< XMLDocumentFragmentScannerImpl/fLtSymbol content)
                  (set! fScannerState SCANNER_STATE_BUILT_IN_REFS))
              (identical? name XMLDocumentFragmentScannerImpl/fGtSymbol)
                (do
                  (.handleCharacter this \> XMLDocumentFragmentScannerImpl/fGtSymbol content)
                  (set! fScannerState SCANNER_STATE_BUILT_IN_REFS))
              (identical? name XMLDocumentFragmentScannerImpl/fQuotSymbol)
                (do
                  (.handleCharacter this \" XMLDocumentFragmentScannerImpl/fQuotSymbol content)
                  (set! fScannerState SCANNER_STATE_BUILT_IN_REFS))
              (identical? name XMLDocumentFragmentScannerImpl/fAposSymbol)
                (do
                  (.handleCharacter this \' XMLDocumentFragmentScannerImpl/fAposSymbol content)
                  (set! fScannerState SCANNER_STATE_BUILT_IN_REFS))
              :else
                (let [isEE (.isExternalEntity fEntityStore name)]
                  (if (or (or (and isEE (not fSupportExternalEntities))
                              (and (not isEE) (not fReplaceEntityReferences)))
                          foundBuiltInRefs)
                      (set! fScannerState SCANNER_STATE_REFERENCE)
                      (do
                        (when-not (.isDeclaredEntity fEntityStore name)
                          (when (and (not fSupportDTD) fReplaceEntityReferences)
                            (.reportFatalError this "EntityNotDeclared" (new Object/1 [name]))
                            (return))
                          (if (and fHasExternalDTD (not fStandalone))
                              (when (.-fValidation this)
                                (.reportError (.-fErrorReporter this)
                                              (.-fEntityScanner this)
                                              XMLMessageFormatter/XML_DOMAIN
                                              "EntityNotDeclared"
                                              (new Object/1 [name])
                                              XMLErrorReporter/SEVERITY_ERROR))
                              (.reportFatalError this "EntityNotDeclared" (new Object/1 [name]))))
                        (if fCreateEntityRefNodes
                            (.startGeneralEntity fDocumentHandler name nil nil nil)
                            (.startEntity (.-fEntityManager this) true name false))))))))))

  (method checkDepth ^void [this ^String elementName]
    (.addValue (.-fLimitAnalyzer this)
               XMLSecurityManager$Limit/MAX_ELEMENT_DEPTH_LIMIT
               elementName
               (.-fDepth fElementStack))
    (when (.isOverLimit (.-fSecurityManager this)
                        XMLSecurityManager$Limit/MAX_ELEMENT_DEPTH_LIMIT
                        (.-fLimitAnalyzer this))
      (.debugPrint (.-fSecurityManager this) (.-fLimitAnalyzer this))
      (.reportFatalError this
                         "MaxElementDepthLimit"
                         (new Object/1
                              [elementName
                               (.getTotalValue (.-fLimitAnalyzer this)
                                               XMLSecurityManager$Limit/MAX_ELEMENT_DEPTH_LIMIT)
                               (.getLimit (.-fSecurityManager this)
                                          XMLSecurityManager$Limit/MAX_ELEMENT_DEPTH_LIMIT)
                               (.systemProperty XMLSecurityManager$Limit/MAX_ELEMENT_DEPTH_LIMIT)]))))

  (method ^:private handleCharacter :throws [XNIException] ^void [this ^char c ^String entity
                                                                  ^XMLStringBuffer content]
    (set! foundBuiltInRefs true)
    (.checkEntityLimit this false (.-name (.-fCurrentEntity (.-fEntityScanner this))) 1)
    (.append content c)
    (when (some? fDocumentHandler)
      (aset fSingleChar 0 c)
      (when fNotifyBuiltInRefs (.startGeneralEntity fDocumentHandler entity nil nil nil))
      (.setValues fTempString fSingleChar 0 1)
      (when-not fIsCoalesce
        (.characters fDocumentHandler fTempString nil)
        (set! builtInRefCharacterHandled true))
      (when fNotifyBuiltInRefs (.endGeneralEntity fDocumentHandler entity nil))))

  (method ^:protected ^:final setScannerState ^void [this ^int state]
    (set! fScannerState state)
    (when DEBUG_SCANNER_STATE
      (.print System/out "### setScannerState: ")
      (.print System/out (.getScannerStateName this state))
      (.println System/out)))

  (method ^:protected ^:final setDriver ^void [this ^Driver driver]
    (set! fDriver driver)
    (when DEBUG_DISPATCHER
      (.print System/out "%%% setDriver: ")
      (.print System/out (.getDriverName this driver))
      (.println System/out)))

  (method ^:protected getScannerStateName ^String [this ^int state]
    (switch state
      SCANNER_STATE_DOCTYPE (return "SCANNER_STATE_DOCTYPE")
      SCANNER_STATE_ROOT_ELEMENT (return "SCANNER_STATE_ROOT_ELEMENT")
      SCANNER_STATE_START_OF_MARKUP (return "SCANNER_STATE_START_OF_MARKUP")
      SCANNER_STATE_COMMENT (return "SCANNER_STATE_COMMENT")
      SCANNER_STATE_PI (return "SCANNER_STATE_PI")
      SCANNER_STATE_CONTENT (return "SCANNER_STATE_CONTENT")
      SCANNER_STATE_REFERENCE (return "SCANNER_STATE_REFERENCE")
      SCANNER_STATE_END_OF_INPUT (return "SCANNER_STATE_END_OF_INPUT")
      SCANNER_STATE_TERMINATED (return "SCANNER_STATE_TERMINATED")
      SCANNER_STATE_CDATA (return "SCANNER_STATE_CDATA")
      SCANNER_STATE_TEXT_DECL (return "SCANNER_STATE_TEXT_DECL")
      SCANNER_STATE_ATTRIBUTE (return "SCANNER_STATE_ATTRIBUTE")
      SCANNER_STATE_ATTRIBUTE_VALUE (return "SCANNER_STATE_ATTRIBUTE_VALUE")
      SCANNER_STATE_START_ELEMENT_TAG (return "SCANNER_STATE_START_ELEMENT_TAG")
      SCANNER_STATE_END_ELEMENT_TAG (return "SCANNER_STATE_END_ELEMENT_TAG")
      SCANNER_STATE_CHARACTER_DATA (return "SCANNER_STATE_CHARACTER_DATA"))
    (java-str "??? (" state \)))

  (method ^:public getEntityName ^String [this] fCurrentEntityName)

  (method ^:public getDriverName ^String [this ^Driver driver]
    (when DEBUG_DISPATCHER
      (when (some? driver)
        (let [^:mutable name (.getName (.getClass driver))
              ^:mutable index (.lastIndexOf name \.)]
          (when-not (== index -1)
            (set! name (.substring name (unchecked-add-int index 1)))
            (set! index (.lastIndexOf name \$))
            (when-not (== index -1) (set! name (.substring name (unchecked-add-int index 1)))))
          (return name))))
    "null")

  (method checkAccess :throws [IOException] ^String [this ^String systemId ^String allowedProtocols]
    (let [baseSystemId (.getBaseSystemId (.-fEntityScanner this))
          expandedSystemId (XMLEntityManager/expandSystemId systemId baseSystemId fStrictURI)]
      (SecuritySupport/checkAccess expandedSystemId
                                   allowedProtocols
                                   JdkConstants/ACCESS_EXTERNAL_ALL)))

  (defclass ^:protected ^:static ^:final Element
    (field ^:public ^QName qname)

    (field ^:public ^char/1 fRawname)

    (field ^:public ^Element next)

    (constructor ^:public [this ^QName qname ^Element next]
      (.setValues (.-qname this) qname)
      (set! (.-fRawname this) (.toCharArray (.-rawname qname)))
      (set! (.-next this) next)))

  (defclass ^:protected ElementStack2
    (field ^:protected ^QName/1 fQName (new QName/1 20))

    (field ^:protected ^int fDepth)

    (field ^:protected ^int fCount)

    (field ^:protected ^int fPosition)

    (field ^:protected ^int fMark)

    (field ^:protected ^int fLastDepth)

    (constructor ^:public [this]
      (loop [^int i 0]
        (when (< i (alength fQName)) (aset fQName i (QName.)) (recur (unchecked-inc-int i))))
      (set! fMark (set! fPosition 1)))

    (method ^:public resize ^void [this]
      (let [oldLength (alength fQName)
            tmp (new QName/1 (unchecked-multiply-int oldLength 2))]
        (System/arraycopy fQName 0 tmp 0 oldLength)
        (set! fQName tmp)
        (loop [^int i oldLength]
          (when (< i (alength fQName)) (aset fQName i (QName.)) (recur (unchecked-inc-int i))))))

    (method ^:public matchElement ^boolean [this ^QName element]
      (when DEBUG_SKIP_ALGORITHM
        (.println System/out (java-str "fLastDepth = " fLastDepth))
        (.println System/out (java-str "fDepth = " fDepth)))
      (let [^:mutable match false]
        (when (and (> fLastDepth fDepth) (<= fDepth 2))
          (when DEBUG_SKIP_ALGORITHM
            (.println System/out
                      (java-str "Checking if the elements match "
                                (.-rawname element)
                                " , "
                                (.-rawname (aget fQName fDepth)))))
          (if (identical? (.-rawname element) (.-rawname (aget fQName fDepth)))
              (do
                (set! fAdd false)
                (set! fMark (unchecked-subtract-int fDepth 1))
                (set! fPosition (unchecked-add-int fMark 1))
                (set! match true)
                (set! fCount (unchecked-dec-int fCount))
                (when DEBUG_SKIP_ALGORITHM
                  (.println System/out "fAdd FALSE -- NOW ELEMENT SHOULD NOT BE ADDED")
                  (.println System/out (java-str "fMark = " fMark))
                  (.println System/out (java-str "fPosition = " fPosition))
                  (.println System/out (java-str "fDepth = " fDepth))
                  (.println System/out (java-str "fCount = " fCount))))
              (do
                (set! fAdd true)
                (when DEBUG_SKIP_ALGORITHM (.println System/out (java-str "fAdd is " fAdd))))))
        (set! fLastDepth (let [old-1 fDepth] (set! fDepth (unchecked-inc-int fDepth)) old-1))
        match))

    (method ^:public nextElement ^QName [this]
      (if (== fCount (alength fQName))
          (do
            (set! fShouldSkip false)
            (set! fAdd false)
            (when DEBUG_SKIP_ALGORITHM
              (.println System/out (java-str "SKIPPING STOPPED, fShouldSkip = " fShouldSkip)))
            (aget fQName (set! fCount (unchecked-dec-int fCount))))
          (do
            (when DEBUG_SKIP_ALGORITHM (.println System/out (java-str "fCount = " fCount)))
            (let [fCount-2 fCount] (set! fCount (unchecked-inc-int fCount)) (aget fQName fCount-2)))))

    (method ^:public getNext ^QName [this]
      (when (== fPosition fCount) (set! fPosition fMark))
      (let [fPosition-3 fPosition]
        (set! fPosition (unchecked-inc-int fPosition))
        (aget fQName fPosition-3)))

    (method ^:public popElement ^int [this]
      (let [fDepth-4 fDepth] (set! fDepth (unchecked-dec-int fDepth)) fDepth-4))

    (method ^:public clear ^void [this]
      (set! fLastDepth 0)
      (set! fDepth 0)
      (set! fCount 0)
      (set! fPosition (set! fMark 1))))

  (defclass ^:protected ElementStack
    (field ^:protected ^QName/1 fElements)

    (field ^:protected ^int/1 fInt (new int/1 20))

    (field ^:protected ^int fDepth)

    (field ^:protected ^int fCount)

    (field ^:protected ^int fPosition)

    (field ^:protected ^int fMark)

    (field ^:protected ^int fLastDepth)

    (constructor ^:public [this]
      (set! fElements (new QName/1 20))
      (loop [^int i 0]
        (when (< i (alength fElements)) (aset fElements i (QName.)) (recur (unchecked-inc-int i)))))

    (method ^:public pushElement ^QName [this ^QName element]
      (when (== fDepth (alength fElements))
        (let [array (new QName/1 (unchecked-multiply-int (alength fElements) 2))]
          (System/arraycopy fElements 0 array 0 fDepth)
          (set! fElements array)
          (loop [^int i fDepth]
            (when (< i (alength fElements))
              (aset fElements i (QName.))
              (recur (unchecked-inc-int i))))))
      (.setValues (aget fElements fDepth) element)
      (let [fDepth-5 fDepth] (set! fDepth (unchecked-inc-int fDepth)) (aget fElements fDepth-5)))

    (method ^:public getNext ^QName [this]
      (when (== fPosition fCount) (set! fPosition fMark))
      (when DEBUG_SKIP_ALGORITHM
        (.println System/out
                  (java-str "Element at fPosition = "
                            fPosition
                            " is "
                            (.-rawname (aget fElements fPosition)))))
      (aget fElements fPosition))

    (method ^:public push ^void [this]
      (aset fInt
            (set! fDepth (unchecked-inc-int fDepth))
            (let [old-6 fPosition] (set! fPosition (unchecked-inc-int fPosition)) old-6)))

    (method ^:public matchElement ^boolean [this ^QName element]
      (let [^:mutable match false]
        (when (and (> fLastDepth fDepth) (<= fDepth 3))
          (when DEBUG_SKIP_ALGORITHM
            (.println System/out
                      "----------ENTERED THE LOOP WHERE WE CHECK FOR MATCHING OF ELMENT-----")
            (.println System/out
                      (java-str "Depth = "
                                fDepth
                                " Checking if INCOMING element "
                                (.-rawname element)
                                " match STORED ELEMENT "
                                (.-rawname (aget fElements (unchecked-subtract-int fDepth 1))))))
          (if (identical? (.-rawname element)
                          (.-rawname (aget fElements (unchecked-subtract-int fDepth 1))))
              (do
                (set! fAdd false)
                (set! fMark (unchecked-subtract-int fDepth 1))
                (set! fPosition fMark)
                (set! match true)
                (set! fCount (unchecked-dec-int fCount))
                (when DEBUG_SKIP_ALGORITHM
                  (.println System/out "NOW ELEMENT SHOULD NOT BE ADDED, fAdd is set to false")
                  (.println System/out (java-str "fMark = " fMark))
                  (.println System/out (java-str "fPosition = " fPosition))
                  (.println System/out (java-str "fDepth = " fDepth))
                  (.println System/out (java-str "fCount = " fCount))
                  (.println System/out "---------MATCH SUCEEDED-----------------")
                  (.println System/out "")))
              (do
                (set! fAdd true)
                (when DEBUG_SKIP_ALGORITHM (.println System/out (java-str "fAdd is " fAdd))))))
        (if match
            (aset fInt
                  fDepth
                  (let [old-7 fPosition] (set! fPosition (unchecked-inc-int fPosition)) old-7))
            (do
              (when DEBUG_SKIP_ALGORITHM
                (.println System/out
                          (java-str "At depth = "
                                    fDepth
                                    "array position is = "
                                    (unchecked-subtract-int fCount 1))))
              (aset fInt fDepth (unchecked-subtract-int fCount 1))))
        (if (== fCount (alength fElements))
            (do
              (set! fSkip false)
              (set! fAdd false)
              (.reposition this)
              (when DEBUG_SKIP_ALGORITHM
                (.println System/out "ALL THE ELMENTS IN ARRAY HAVE BEEN FILLED")
                (.println System/out "REPOSITIONING THE STACK")
                (.println System/out "-----------SKIPPING STOPPED----------")
                (.println System/out ""))
              false)
            (do
              (when DEBUG_SKIP_ALGORITHM
                (if match
                    (.println System/out
                              (java-str "Storing fPosition = "
                                        (aget fInt fDepth)
                                        " at fDepth = "
                                        fDepth))
                    (.println System/out
                              (java-str "Storing fCount = "
                                        (aget fInt fDepth)
                                        " at fDepth = "
                                        fDepth))))
              (set! fLastDepth fDepth)
              match))))

    (method ^:public nextElement ^QName [this]
      (if fSkip
          (do
            (set! fDepth (unchecked-inc-int fDepth))
            (let [fCount-8 fCount]
              (set! fCount (unchecked-inc-int fCount))
              (aget fElements fCount-8)))
          (do
            (when (== fDepth (alength fElements))
              (let [array (new QName/1 (unchecked-multiply-int (alength fElements) 2))]
                (System/arraycopy fElements 0 array 0 fDepth)
                (set! fElements array)
                (loop [^int i fDepth]
                  (when (< i (alength fElements))
                    (aset fElements i (QName.))
                    (recur (unchecked-inc-int i))))))
            (let [fDepth-9 fDepth]
              (set! fDepth (unchecked-inc-int fDepth))
              (aget fElements fDepth-9)))))

    (method ^:public popElement ^QName [this]
      (if (or fSkip fAdd)
          (do
            (when DEBUG_SKIP_ALGORITHM
              (.println System/out
                        (java-str "POPPING Element, at position "
                                  (aget fInt fDepth)
                                  " element at that count is = "
                                  (.-rawname (aget fElements (aget fInt fDepth)))))
              (.println System/out ""))
            (let [fDepth-10 fDepth]
              (set! fDepth (unchecked-dec-int fDepth))
              (aget fElements (aget fInt fDepth-10))))
          (do
            (when DEBUG_SKIP_ALGORITHM
              (.println System/out
                        (java-str "Retrieveing element at depth = "
                                  fDepth
                                  " is "
                                  (.-rawname (aget fElements fDepth)))))
            (aget fElements (set! fDepth (unchecked-dec-int fDepth))))))

    (method ^:public reposition ^void [this]
      (loop [^int i 2]
        (when (<= i fDepth)
          (aset fElements (unchecked-subtract-int i 1) (aget fElements (aget fInt i)))
          (recur (unchecked-inc-int i))))
      (when DEBUG_SKIP_ALGORITHM
        (loop [^int i 0]
          (when (< i fDepth)
            (.println System/out (java-str "fElements[" i "] = " (.-rawname (aget fElements i))))
            (recur (unchecked-inc-int i))))))

    (method ^:public clear ^void [this]
      (set! fDepth 0)
      (set! fLastDepth 0)
      (set! fCount 0)
      (set! fPosition (set! fMark 1)))

    (method ^:public getLastPoppedElement ^QName [this]
      (aget fElements fDepth)))

  (defclass ^:protected ^:interface Driver
    (method ^:public next :throws [IOException XNIException] ^int [this]))

  (defclass ^:protected FragmentContentDriver
    :implements [Driver]

    (method ^:private startOfMarkup :throws [IOException] ^void [this]
      (set! fMarkupDepth (unchecked-inc-int fMarkupDepth))
      (let [ch (.peekChar (.-fEntityScanner XMLDocumentFragmentScannerImpl/this))]
        (if (or (.isValidNameStartChar XMLDocumentFragmentScannerImpl/this ch)
                (.isValidNameStartHighSurrogate XMLDocumentFragmentScannerImpl/this ch))
            (.setScannerState XMLDocumentFragmentScannerImpl/this SCANNER_STATE_START_ELEMENT_TAG)
            (switch ch
              \?
                (do
                  (.setScannerState XMLDocumentFragmentScannerImpl/this SCANNER_STATE_PI)
                  (.skipChar (.-fEntityScanner XMLDocumentFragmentScannerImpl/this) ch nil))
              \!
                (do
                  (.skipChar (.-fEntityScanner XMLDocumentFragmentScannerImpl/this) ch nil)
                  (cond
                    (.skipChar (.-fEntityScanner XMLDocumentFragmentScannerImpl/this) \- nil)
                      (do
                        (when-not (.skipChar (.-fEntityScanner XMLDocumentFragmentScannerImpl/this)
                                             \-
                                             XMLScanner$NameType/COMMENT)
                          (.reportFatalError XMLDocumentFragmentScannerImpl/this
                                             "InvalidCommentStart"
                                             nil))
                        (.setScannerState XMLDocumentFragmentScannerImpl/this SCANNER_STATE_COMMENT))
                    (.skipString (.-fEntityScanner XMLDocumentFragmentScannerImpl/this) CDATA)
                      (do
                        (set! fCDataStart true)
                        (.setScannerState XMLDocumentFragmentScannerImpl/this SCANNER_STATE_CDATA))
                    :else
                      (when-not (.scanForDoctypeHook this)
                        (.reportFatalError XMLDocumentFragmentScannerImpl/this
                                           "MarkupNotRecognizedInContent"
                                           nil))))
              \/
                (do
                  (.setScannerState XMLDocumentFragmentScannerImpl/this
                                    SCANNER_STATE_END_ELEMENT_TAG)
                  (.skipChar (.-fEntityScanner XMLDocumentFragmentScannerImpl/this)
                             ch
                             XMLScanner$NameType/ELEMENTEND))
              (.reportFatalError XMLDocumentFragmentScannerImpl/this
                                 "MarkupNotRecognizedInContent"
                                 nil)))))

    (method ^:private startOfContent :throws [IOException] ^void [this]
      (cond
        (.skipChar (.-fEntityScanner XMLDocumentFragmentScannerImpl/this) \< nil)
          (.setScannerState XMLDocumentFragmentScannerImpl/this SCANNER_STATE_START_OF_MARKUP)
        (.skipChar (.-fEntityScanner XMLDocumentFragmentScannerImpl/this)
                   \&
                   XMLScanner$NameType/REFERENCE)
          (.setScannerState XMLDocumentFragmentScannerImpl/this SCANNER_STATE_REFERENCE)
        :else (.setScannerState XMLDocumentFragmentScannerImpl/this SCANNER_STATE_CHARACTER_DATA)))

    (method ^:public decideSubState :throws [IOException] ^void [this]
      (while (or (== fScannerState SCANNER_STATE_CONTENT)
                 (== fScannerState SCANNER_STATE_START_OF_MARKUP))
        (switch fScannerState
          SCANNER_STATE_CONTENT (.startOfContent this)
          SCANNER_STATE_START_OF_MARKUP (.startOfMarkup this))))

    (method ^:public next :throws [IOException XNIException] ^int [this]
      (while true
        (try
          (when (== fScannerState SCANNER_STATE_CONTENT)
            (let [ch (.peekChar (.-fEntityScanner XMLDocumentFragmentScannerImpl/this))]
              (cond
                (== ch \<)
                  (do
                    (.scanChar (.-fEntityScanner XMLDocumentFragmentScannerImpl/this) nil)
                    (.setScannerState XMLDocumentFragmentScannerImpl/this
                                      SCANNER_STATE_START_OF_MARKUP))
                (== ch \&)
                  (do
                    (.scanChar (.-fEntityScanner XMLDocumentFragmentScannerImpl/this)
                               XMLScanner$NameType/REFERENCE)
                    (.setScannerState XMLDocumentFragmentScannerImpl/this SCANNER_STATE_REFERENCE))
                :else
                  (.setScannerState XMLDocumentFragmentScannerImpl/this
                                    SCANNER_STATE_CHARACTER_DATA))))
          (when (== fScannerState SCANNER_STATE_START_OF_MARKUP) (.startOfMarkup this))
          (when fIsCoalesce
            (set! fUsebuffer true)
            (cond
              fLastSectionWasCharacterData
                (when (and (and (not (== fScannerState SCANNER_STATE_CDATA))
                                (not (== fScannerState SCANNER_STATE_REFERENCE)))
                           (not (== fScannerState SCANNER_STATE_CHARACTER_DATA)))
                  (set! fLastSectionWasCharacterData false)
                  (return XMLEvent/CHARACTERS))
              (or fLastSectionWasCData fLastSectionWasEntityReference)
                (when (and (and (not (== fScannerState SCANNER_STATE_CDATA))
                                (not (== fScannerState SCANNER_STATE_REFERENCE)))
                           (not (== fScannerState SCANNER_STATE_CHARACTER_DATA)))
                  (set! fLastSectionWasCData false)
                  (set! fLastSectionWasEntityReference false)
                  (return XMLEvent/CHARACTERS))))
          (switch fScannerState
            XMLEvent/START_DOCUMENT (return XMLEvent/START_DOCUMENT)
            SCANNER_STATE_START_ELEMENT_TAG
              (do
                (set! fEmptyElement (.scanStartElement XMLDocumentFragmentScannerImpl/this))
                (if fEmptyElement
                    (.setScannerState XMLDocumentFragmentScannerImpl/this
                                      SCANNER_STATE_END_ELEMENT_TAG)
                    (.setScannerState XMLDocumentFragmentScannerImpl/this SCANNER_STATE_CONTENT))
                (return XMLEvent/START_ELEMENT))
            SCANNER_STATE_CHARACTER_DATA
              (do
                (set! fUsebuffer
                      (or (or fLastSectionWasEntityReference fLastSectionWasCData)
                          fLastSectionWasCharacterData))
                (if (and fIsCoalesce
                         (or (or fLastSectionWasEntityReference fLastSectionWasCData)
                             fLastSectionWasCharacterData))
                    (do
                      (set! fLastSectionWasEntityReference false)
                      (set! fLastSectionWasCData false)
                      (set! fLastSectionWasCharacterData true)
                      (set! fUsebuffer true))
                    (.clear fContentBuffer))
                (set! (.-length fTempString) 0)
                (let [^:mutable c (.scanContent (.-fEntityScanner
                                                  XMLDocumentFragmentScannerImpl/this)
                                                fTempString)]
                  (if (.skipChar (.-fEntityScanner XMLDocumentFragmentScannerImpl/this) \< nil)
                      (do
                        (cond
                          (.skipChar (.-fEntityScanner XMLDocumentFragmentScannerImpl/this)
                                     \/
                                     XMLScanner$NameType/ELEMENTEND)
                            (do
                              (set! fMarkupDepth (unchecked-inc-int fMarkupDepth))
                              (set! fLastSectionWasCharacterData false)
                              (.setScannerState XMLDocumentFragmentScannerImpl/this
                                                SCANNER_STATE_END_ELEMENT_TAG))
                          (XMLChar/isNameStart
                            (.peekChar (.-fEntityScanner XMLDocumentFragmentScannerImpl/this)))
                            (do
                              (set! fMarkupDepth (unchecked-inc-int fMarkupDepth))
                              (set! fLastSectionWasCharacterData false)
                              (.setScannerState XMLDocumentFragmentScannerImpl/this
                                                SCANNER_STATE_START_ELEMENT_TAG))
                          :else
                            (do
                              (.setScannerState XMLDocumentFragmentScannerImpl/this
                                                SCANNER_STATE_START_OF_MARKUP)
                              (when fIsCoalesce
                                (set! fLastSectionWasCharacterData true)
                                (.bufferContent XMLDocumentFragmentScannerImpl/this)
                                (continue))))
                        (when fUsebuffer (.bufferContent XMLDocumentFragmentScannerImpl/this))
                        (if (and (some? dtdGrammarUtil)
                                 (.isIgnorableWhiteSpace dtdGrammarUtil fContentBuffer))
                            (do
                              (when DEBUG (.println System/out "Return SPACE EVENT"))
                              (return XMLEvent/SPACE))
                            (return XMLEvent/CHARACTERS)))
                      (.bufferContent XMLDocumentFragmentScannerImpl/this))
                  (if (== c \return)
                      (do
                        (when DEBUG (.println System/out "'\r' character found"))
                        (.scanChar (.-fEntityScanner XMLDocumentFragmentScannerImpl/this) nil)
                        (set! fUsebuffer true)
                        (.append fContentBuffer (unchecked-char c))
                        (set! c -1))
                      (when (== c \])
                        (set! fUsebuffer true)
                        (.append fContentBuffer
                                 (unchecked-char
                                   (.scanChar (.-fEntityScanner XMLDocumentFragmentScannerImpl/this)
                                              nil)))
                        (set! fInScanContent true)
                        (when (.skipChar (.-fEntityScanner XMLDocumentFragmentScannerImpl/this)
                                         \]
                                         nil)
                          (.append fContentBuffer \])
                          (while (.skipChar (.-fEntityScanner XMLDocumentFragmentScannerImpl/this)
                                            \]
                                            nil)
                            (.append fContentBuffer \]))
                          (when (.skipChar (.-fEntityScanner XMLDocumentFragmentScannerImpl/this)
                                           \>
                                           nil)
                            (.reportFatalError XMLDocumentFragmentScannerImpl/this
                                               "CDEndInContent"
                                               nil)))
                        (set! c -1)
                        (set! fInScanContent false)))
                  (loop []
                    (cond
                      (== c \<)
                        (do
                          (.scanChar (.-fEntityScanner XMLDocumentFragmentScannerImpl/this) nil)
                          (.setScannerState XMLDocumentFragmentScannerImpl/this
                                            SCANNER_STATE_START_OF_MARKUP)
                          (break))
                      (== c \&)
                        (do
                          (.scanChar (.-fEntityScanner XMLDocumentFragmentScannerImpl/this)
                                     XMLScanner$NameType/REFERENCE)
                          (.setScannerState XMLDocumentFragmentScannerImpl/this
                                            SCANNER_STATE_REFERENCE)
                          (break))
                      :else
                        (when (and (not (== c -1))
                                   (.isInvalidLiteral XMLDocumentFragmentScannerImpl/this c))
                          (if (XMLChar/isHighSurrogate c)
                              (do
                                (.scanSurrogates XMLDocumentFragmentScannerImpl/this fContentBuffer)
                                (.setScannerState
                                  XMLDocumentFragmentScannerImpl/this
                                  SCANNER_STATE_CONTENT))
                              (do
                                (.reportFatalError
                                  XMLDocumentFragmentScannerImpl/this
                                  "InvalidCharInContent"
                                  (new Object/1 [(Integer/toString c 16)]))
                                (.scanChar (.-fEntityScanner XMLDocumentFragmentScannerImpl/this)
                                           nil)))
                          (break)))
                    (set! c (.scanContent XMLDocumentFragmentScannerImpl/this fContentBuffer))
                    (when-not fIsCoalesce
                      (.setScannerState XMLDocumentFragmentScannerImpl/this SCANNER_STATE_CONTENT)
                      (break))
                    (when true (recur)))
                  (when DEBUG
                    (.println System/out
                              (java-str "USING THE BUFFER, STRING START="
                                        (.toString fContentBuffer)
                                        "=END")))
                  (cond
                    fIsCoalesce (set! fLastSectionWasCharacterData true)
                    (and (some? dtdGrammarUtil)
                         (.isIgnorableWhiteSpace dtdGrammarUtil fContentBuffer))
                      (do
                        (when DEBUG (.println System/out "Return SPACE EVENT"))
                        (return XMLEvent/SPACE))
                    :else (return XMLEvent/CHARACTERS))))
            SCANNER_STATE_END_ELEMENT_TAG
              (do
                (cond
                  fEmptyElement
                    (do
                      (set! fEmptyElement false)
                      (.setScannerState XMLDocumentFragmentScannerImpl/this SCANNER_STATE_CONTENT)
                      (return (if (and (== fMarkupDepth 0) (.elementDepthIsZeroHook this))
                                  XMLEvent/END_ELEMENT
                                  XMLEvent/END_ELEMENT)))
                  (== (.scanEndElement XMLDocumentFragmentScannerImpl/this) 0)
                    (when (.elementDepthIsZeroHook this) (return XMLEvent/END_ELEMENT)))
                (.setScannerState XMLDocumentFragmentScannerImpl/this SCANNER_STATE_CONTENT)
                (return XMLEvent/END_ELEMENT))
            SCANNER_STATE_COMMENT
              (do
                (.scanComment XMLDocumentFragmentScannerImpl/this)
                (.setScannerState XMLDocumentFragmentScannerImpl/this SCANNER_STATE_CONTENT)
                (return XMLEvent/COMMENT))
            SCANNER_STATE_PI
              (do
                (.clear fContentBuffer)
                (.scanPI XMLDocumentFragmentScannerImpl/this fContentBuffer)
                (.setScannerState XMLDocumentFragmentScannerImpl/this SCANNER_STATE_CONTENT)
                (return XMLEvent/PROCESSING_INSTRUCTION))
            SCANNER_STATE_CDATA
              (do
                (if (and fIsCoalesce
                         (or (or fLastSectionWasEntityReference fLastSectionWasCData)
                             fLastSectionWasCharacterData))
                    (do
                      (set! fLastSectionWasCData true)
                      (set! fLastSectionWasEntityReference false)
                      (set! fLastSectionWasCharacterData false))
                    (.clear fContentBuffer))
                (set! fUsebuffer true)
                (.scanCDATASection XMLDocumentFragmentScannerImpl/this fContentBuffer true)
                (if (not fCDataEnd)
                    (.setScannerState XMLDocumentFragmentScannerImpl/this SCANNER_STATE_CDATA)
                    (.setScannerState XMLDocumentFragmentScannerImpl/this SCANNER_STATE_CONTENT))
                (cond
                  fIsCoalesce (set! fLastSectionWasCData true)
                  fReportCdataEvent (return XMLEvent/CDATA)
                  :else (return XMLEvent/CHARACTERS)))
            SCANNER_STATE_REFERENCE
              (do
                (set! fMarkupDepth (unchecked-inc-int fMarkupDepth))
                (set! foundBuiltInRefs false)
                (if (and fIsCoalesce
                         (or (or fLastSectionWasEntityReference fLastSectionWasCData)
                             fLastSectionWasCharacterData))
                    (do
                      (set! fLastSectionWasEntityReference true)
                      (set! fLastSectionWasCData false)
                      (set! fLastSectionWasCharacterData false))
                    (.clear fContentBuffer))
                (set! fUsebuffer true)
                (if (.skipChar (.-fEntityScanner XMLDocumentFragmentScannerImpl/this)
                               \#
                               XMLScanner$NameType/REFERENCE)
                    (do
                      (.scanCharReferenceValue XMLDocumentFragmentScannerImpl/this
                                               fContentBuffer
                                               nil)
                      (set! fMarkupDepth (unchecked-dec-int fMarkupDepth))
                      (when-not fIsCoalesce
                        (.setScannerState XMLDocumentFragmentScannerImpl/this SCANNER_STATE_CONTENT)
                        (return XMLEvent/CHARACTERS)))
                    (do
                      (.scanEntityReference XMLDocumentFragmentScannerImpl/this fContentBuffer)
                      (when (and (== fScannerState SCANNER_STATE_BUILT_IN_REFS) (not fIsCoalesce))
                        (.setScannerState XMLDocumentFragmentScannerImpl/this SCANNER_STATE_CONTENT)
                        (if builtInRefCharacterHandled
                            (do
                              (set! builtInRefCharacterHandled false)
                              (return XMLEvent/ENTITY_REFERENCE))
                            (return XMLEvent/CHARACTERS)))
                      (when (== fScannerState SCANNER_STATE_TEXT_DECL)
                        (set! fLastSectionWasEntityReference true)
                        (continue))
                      (when (== fScannerState SCANNER_STATE_REFERENCE)
                        (.setScannerState XMLDocumentFragmentScannerImpl/this SCANNER_STATE_CONTENT)
                        (when (and fReplaceEntityReferences
                                   (.isDeclaredEntity fEntityStore fCurrentEntityName))
                          (continue))
                        (return XMLEvent/ENTITY_REFERENCE))))
                (.setScannerState XMLDocumentFragmentScannerImpl/this SCANNER_STATE_CONTENT)
                (set! fLastSectionWasEntityReference true))
            SCANNER_STATE_TEXT_DECL
              (do
                (when (.skipString (.-fEntityScanner XMLDocumentFragmentScannerImpl/this) "<?xml")
                  (set! fMarkupDepth (unchecked-inc-int fMarkupDepth))
                  (if (.isValidNameChar XMLDocumentFragmentScannerImpl/this
                                        (.peekChar
                                          (.-fEntityScanner XMLDocumentFragmentScannerImpl/this)))
                      (do
                        (.clear fStringBuffer)
                        (.append fStringBuffer "xml")
                        (if (.-fNamespaces XMLDocumentFragmentScannerImpl/this)
                            (while (.isValidNCName
                                     XMLDocumentFragmentScannerImpl/this
                                     (.peekChar (.-fEntityScanner
                                                  XMLDocumentFragmentScannerImpl/this)))
                              (.append fStringBuffer
                                       (unchecked-char
                                         (.scanChar
                                           (.-fEntityScanner XMLDocumentFragmentScannerImpl/this)
                                           nil))))
                            (while (.isValidNameChar
                                     XMLDocumentFragmentScannerImpl/this
                                     (.peekChar (.-fEntityScanner
                                                  XMLDocumentFragmentScannerImpl/this)))
                              (.append fStringBuffer
                                       (unchecked-char
                                         (.scanChar
                                           (.-fEntityScanner XMLDocumentFragmentScannerImpl/this)
                                           nil)))))
                        (let [target (.addSymbol
                                       (.-fSymbolTable XMLDocumentFragmentScannerImpl/this)
                                       (.-ch fStringBuffer)
                                       (.-offset fStringBuffer)
                                       (.-length fStringBuffer))]
                          (.clear fContentBuffer)
                          (.scanPIData XMLDocumentFragmentScannerImpl/this target fContentBuffer)))
                      (.scanXMLDeclOrTextDecl XMLDocumentFragmentScannerImpl/this true)))
                (set! (.-mayReadChunks
                        (.-fCurrentEntity (.-fEntityManager XMLDocumentFragmentScannerImpl/this)))
                      true)
                (.setScannerState XMLDocumentFragmentScannerImpl/this SCANNER_STATE_CONTENT))
            SCANNER_STATE_ROOT_ELEMENT
              (do
                (when (.scanRootElementHook this)
                  (set! fEmptyElement true)
                  (return XMLEvent/START_ELEMENT))
                (.setScannerState XMLDocumentFragmentScannerImpl/this SCANNER_STATE_CONTENT)
                (return XMLEvent/START_ELEMENT))
            SCANNER_STATE_CHAR_REFERENCE
              (do
                (.clear fContentBuffer)
                (.scanCharReferenceValue XMLDocumentFragmentScannerImpl/this fContentBuffer nil)
                (set! fMarkupDepth (unchecked-dec-int fMarkupDepth))
                (.setScannerState XMLDocumentFragmentScannerImpl/this SCANNER_STATE_CONTENT)
                (return XMLEvent/CHARACTERS))
            (throw (XNIException. (java-str "Scanner State " fScannerState " not Recognized "))))
          (catch MalformedByteSequenceException e
            (.reportError (.-fErrorReporter XMLDocumentFragmentScannerImpl/this)
                          (.getDomain e)
                          (.getKey e)
                          (.getArguments e)
                          XMLErrorReporter/SEVERITY_FATAL_ERROR
                          e)
            (return -1))
          (catch CharConversionException e
            (.reportError (.-fErrorReporter XMLDocumentFragmentScannerImpl/this)
                          XMLMessageFormatter/XML_DOMAIN
                          "CharConversionFailure"
                          nil
                          XMLErrorReporter/SEVERITY_FATAL_ERROR
                          e)
            (return -1))
          (catch EOFException e (.endOfFileHook this e) (return -1)))))

    (method ^:protected scanForDoctypeHook :throws [IOException XNIException] ^boolean [this]
      false)

    (method ^:protected elementDepthIsZeroHook :throws [IOException XNIException] ^boolean [this]
      false)

    (method ^:protected scanRootElementHook :throws [IOException XNIException] ^boolean [this]
      false)

    (method ^:protected endOfFileHook :throws [IOException XNIException] ^void [this ^EOFException e]
      (when-not (== fMarkupDepth 0)
        (.reportFatalError XMLDocumentFragmentScannerImpl/this "PrematureEOF" nil))))

  (method ^:static pr ^void [^String str] (.println System/out str))

  (field ^:protected ^boolean fUsebuffer)

  (method ^:protected getString ^XMLString [this]
    (if (or (< (.-fAttributeCacheUsedCount this) (.-initialCacheCount this))
            (< (.-fAttributeCacheUsedCount this) (.size (.-attributeValueCache this))))
        (cast XMLString
              (.get (.-attributeValueCache this)
                    (let [old-11 (.-fAttributeCacheUsedCount this)]
                      (set! (.-fAttributeCacheUsedCount this)
                            (unchecked-inc-int (.-fAttributeCacheUsedCount this)))
                      old-11)))
        (let [str (XMLString.)]
          (set! (.-fAttributeCacheUsedCount this)
                (unchecked-inc-int (.-fAttributeCacheUsedCount this)))
          (.add (.-attributeValueCache this) str)
          str)))

  (method ^:public refresh ^void [this] (.refresh this 0))

  (method ^:public refresh ^void [this ^int refreshPosition]
    (when fReadingAttributes (.refresh fAttributes))
    (when (== fScannerState SCANNER_STATE_CHARACTER_DATA) (.bufferContent this)))

  (method ^:private bufferContent ^void [this]
    (.append fContentBuffer fTempString)
    (set! (.-length fTempString) 0)
    (set! fUsebuffer true)))

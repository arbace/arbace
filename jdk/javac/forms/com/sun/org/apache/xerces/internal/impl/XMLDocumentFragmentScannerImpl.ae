  (method addElement ^void [this ^String rawname]
    (when (< fElementPointer ELEMENT_ARRAY_LENGTH)
      (aset fElementArray fElementPointer rawname)
      (when DEBUG_SKIP_ALGORITHM
        (let [sb (StringBuffer.)]
          (.append sb " Storing element information ")
          (.append sb (java-str " fElementPointer = " fElementPointer))
          (.append sb (java-str " fElementRawname = " (.-rawname fElementQName)))
          (.append sb (java-str " fElementStack.fDepth = " (.-fDepth fElementStack)))
          (.println System/out (.toString sb))))
      (when (< (.-fDepth fElementStack) MAX_DEPTH_LIMIT)
        (let [column (.storePointerForADepth this fElementPointer)]
          (when (> column 0)
            (let [pointer (.getElementPointer this
                                              (unchecked-short (.-fDepth fElementStack))
                                              (unchecked-short (unchecked-subtract-int column 1)))]
              (if (identical? rawname (aget fElementArray pointer))
                  (do
                    (set! fShouldSkip true)
                    (set! fLastPointerLocation pointer)
                    (.resetPointer this (unchecked-short (.-fDepth fElementStack)) column)
                    (aset fElementArray fElementPointer nil)
                    (return))
                  (set! fShouldSkip false))))))
      (set! fElementPointer (unchecked-short (unchecked-inc-int fElementPointer)))))

  (method resetPointer ^void [this ^short depth ^short column]
    (aset (aget fPointerInfo depth) column (unchecked-short 0)))

  (method storePointerForADepth ^short [this ^short elementPointer]
    (let [depth (unchecked-short (.-fDepth fElementStack))]
      (loop [^short i 0]
        (if (< i MAX_POINTER_AT_A_DEPTH)
            (if (.canStore this depth i)
                (do
                  (aset (aget fPointerInfo depth) i elementPointer)
                  (when DEBUG_SKIP_ALGORITHM
                    (let [sb (StringBuffer.)]
                      (.append sb " Pointer information ")
                      (.append sb (java-str " fElementPointer = " fElementPointer))
                      (.append sb (java-str " fElementStack.fDepth = " (.-fDepth fElementStack)))
                      (.append sb (java-str " column = " i))
                      (.println System/out (.toString sb))))
                  (return i))
                (recur (unchecked-short (unchecked-inc-int i))))
            nil))
      -1))


                   (.endsWith propertyId Constants/ENTITY_RESOLVER_PROPERTY))
          (set! fExternalSubsetResolver
                (when (instance? ExternalSubsetResolver value) (cast ExternalSubsetResolver value)))
          (return))))
    (cond
      (.startsWith propertyId Constants/XERCES_PROPERTY_PREFIX)
        (let [property (.substring propertyId (.length Constants/XERCES_PROPERTY_PREFIX))]
          (when (.equals property Constants/ENTITY_MANAGER_PROPERTY)
            (set! (.-fEntityManager this) (cast XMLEntityManager value))))
      (.equals propertyId XML_SECURITY_PROPERTY_MANAGER)
        (let [spm (cast XMLSecurityPropertyManager value)]
          (set! fAccessExternalDTD
                (.getValue spm XMLSecurityPropertyManager$Property/ACCESS_EXTERNAL_DTD)))))


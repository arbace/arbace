                           (.length propertyId)
                           (.length Constants/XERCES_PROPERTY_PREFIX))]
        (when (and (== suffixLength (.length Constants/ENTITY_MANAGER_PROPERTY))
                   (.endsWith propertyId Constants/ENTITY_MANAGER_PROPERTY))
          (set! (.-fEntityManager this) (cast XMLEntityManager value))
          (return))

              ^:mutable ^byte b 0]
          (try
            (set! bytes (.getBytes (.substring href i) "UTF-8"))
            (catch UnsupportedEncodingException e (return href)))
          (set! len (alength bytes))
          (set! i 0)
          (while (< i len)
            (set! b (aget bytes i))

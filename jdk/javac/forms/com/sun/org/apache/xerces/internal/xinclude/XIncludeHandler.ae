            (set! expandedSystemId (.getLiteralSystemId fCurrentBaseURI)))
          (catch URI$MalformedURIException e (.reportFatalError this "ExpandedSystemId"))))
      (.setExpandedSystemId fCurrentBaseURI expandedSystemId)))

  (method ^:protected searchForRecursiveIncludes ^boolean [this ^String includedSysId]
    (cond
      (.equals includedSysId (.getExpandedSystemId fCurrentBaseURI)) true
      (nil? fParentXIncludeHandler) false
      :else (.searchForRecursiveIncludes fParentXIncludeHandler includedSysId)))

  (method ^:protected isTopLevelIncludedItem ^boolean [this]
    (or (.isTopLevelIncludedItemViaInclude this) (.isTopLevelIncludedItemViaFallback this)))

  (method ^:protected isTopLevelIncludedItemViaInclude ^boolean [this]
    (and (== fDepth 1) (not (.isRootDocument this))))

  (method ^:protected isTopLevelIncludedItemViaFallback ^boolean [this]
    (.getSawFallback this (unchecked-subtract-int fDepth 1)))

  (method ^:protected processAttributes ^XMLAttributes [this ^:mutable ^XMLAttributes attributes]

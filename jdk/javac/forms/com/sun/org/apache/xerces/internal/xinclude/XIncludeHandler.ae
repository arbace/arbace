  (method ^:protected hasXIncludeNamespace ^boolean [this ^QName element]
    (or (identical? (.-uri element) XINCLUDE_NS_URI)
        (identical? (.getURI fNamespaceContext (.-prefix element)) XINCLUDE_NS_URI)))

  (method ^:protected isIncludeElement ^boolean [this ^QName element]
    (and (.equals (.-localpart element) XINCLUDE_INCLUDE) (.hasXIncludeNamespace this element)))

  (method ^:protected isFallbackElement ^boolean [this ^QName element]
    (and (.equals (.-localpart element) XINCLUDE_FALLBACK) (.hasXIncludeNamespace this element)))

  (method ^:protected sameBaseURIAsIncludeParent ^boolean [this]
    (let [parentBaseURI (.getIncludeParentBaseURI this)
          baseURI (.getExpandedSystemId fCurrentBaseURI)]
      (and (some? parentBaseURI) (.equals parentBaseURI baseURI))))

  (method ^:protected sameLanguageAsIncludeParent ^boolean [this]
    (let [parentLanguage (.getIncludeParentLanguage this)]
      (and (some? parentLanguage) (.equalsIgnoreCase parentLanguage fCurrentLanguage))))

  (method ^:private setupCurrentBaseURI ^void [this ^XMLLocator locator]
    (.setBaseSystemId fCurrentBaseURI (.getBaseSystemId locator))
    (if (some? (.getLiteralSystemId locator))
        (.setLiteralSystemId fCurrentBaseURI (.getLiteralSystemId locator))
        (.setLiteralSystemId fCurrentBaseURI fHrefFromParent))
    (let [^:mutable expandedSystemId (.getExpandedSystemId locator)]
      (when (nil? expandedSystemId)
        (try
          (set! expandedSystemId
                (XMLEntityManager/expandSystemId
                  (.getLiteralSystemId fCurrentBaseURI)
                  (.getBaseSystemId fCurrentBaseURI)
                  false))

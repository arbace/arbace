                    (when (and (< ch2 0xF0000) (<= (bit-and-int ch2 0xFFFF) 0xFFFD))
                      (set! j (unchecked-inc-int j))
                      (continue)))))
              (return href))
            (set! j (unchecked-inc-int j))))

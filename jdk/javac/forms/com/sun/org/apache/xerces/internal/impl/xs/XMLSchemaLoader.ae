              ^:mutable ^InputStream is nil]
          (try
            (set! is (BufferedInputStream. (FileInputStream. file)))
            (catch FileNotFoundException ex
              (.reportError fErrorReporter
                            XSMessageFormatter/SCHEMA_DOMAIN
                            "schema_reference.4"
                            (new Object/1 [(.toString file)])
                            XMLErrorReporter/SEVERITY_ERROR)))
          (XMLInputSource. nil (.toString (.toURI file)) nil is nil))
      :else
        (let [mf (.getMessageFormatter fErrorReporter XSMessageFormatter/SCHEMA_DOMAIN)]
          (throw (XMLConfigurationException. Status/NOT_SUPPORTED
                                             (.formatMessage
                                               mf
                                               (.getLocale fErrorReporter)
                                               "jaxp12-schema-source-type.1"
                                               (new
                                                 Object/1
                                                 [(if (some? val)
                                                      ^Object (.getName (.getClass val))
                                                      "null")])))))))

  (method ^:private ^:static saxToXMLInputSource ^XMLInputSource [^InputSource sis]
    (let [publicId (.getPublicId sis)
          systemId (.getSystemId sis)
          charStream (.getCharacterStream sis)]
      (if (some? charStream)
          (XMLInputSource. publicId systemId nil charStream nil)
          (let [byteStream (.getByteStream sis)]
            (if (some? byteStream)
                (XMLInputSource. publicId systemId nil byteStream (.getEncoding sis))
                (XMLInputSource. publicId systemId nil false))))))

  (defclass ^:public ^:static LocationArray
    (field ^int length)

    (field ^String/1 locations (new String/1 2))

    (method ^:public resize ^void [this ^int oldLength ^int newLength]
      (let [temp (new String/1 newLength)]
        (System/arraycopy locations 0 temp 0 (Math/min oldLength newLength))
        (set! locations temp)
        (set! length (Math/min oldLength newLength))))

    (method ^:public addLocation ^void [this ^String location]
      (when (>= length (alength locations))
        (.resize this length (^[int int] Math/max 1 (unchecked-multiply-int length 2))))
      (aset locations (let [old-1 length] (set! length (unchecked-inc-int length)) old-1) location))

    (method ^:public getLocationArray ^String/1 [this]
      (when (< length (alength locations)) (.resize this (alength locations) length))
      locations)

    (method ^:public getFirstLocation ^String [this]
      (when (> length 0) (aget locations 0)))

    (method ^:public getLength ^int [this] length))

  (method ^:public getFeatureDefault ^Boolean [this ^String featureId]
    (when (.equals featureId AUGMENT_PSVI) Boolean/TRUE))

  (method ^:public getPropertyDefault [this ^String propertyId] nil)

  (method ^:public reset :throws [XMLConfigurationException] ^void [this
                                                                    ^XMLComponentManager componentManager]
    (let [^:mutable spm (cast XMLSecurityPropertyManager
                              (.getProperty componentManager XML_SECURITY_PROPERTY_MANAGER))]
      (when (nil? spm)
        (set! spm (.getXMLSecurityPropertyManager (JdkXmlConfig/getInstance false) false))
        (.setProperty this XML_SECURITY_PROPERTY_MANAGER spm))
      (let [sm (cast XMLSecurityManager (.getProperty componentManager SECURITY_MANAGER))]
        (when (nil? sm)
          (.setProperty this
                        SECURITY_MANAGER
                        (.getXMLSecurityManager (JdkXmlConfig/getInstance false) false)))
        (set! faccessExternalSchema
              (.getValue spm XMLSecurityPropertyManager$Property/ACCESS_EXTERNAL_SCHEMA))
        (.reset fGrammarBucket)
        (.reset fSubGroupHandler)
        (let [^:mutable parser_settings true]
          (when-not (identical? componentManager fLoaderConfig)
            (set! parser_settings (.getFeature componentManager PARSER_SETTINGS true)))
          (if (or (not parser_settings) (not fSettingsChanged))
              (do
                (set! fJAXPProcessed false)
                (.initGrammarBucket this)
                (when (some? fDeclPool) (.reset fDeclPool)))
              (do
                (.reset fNodeFactory componentManager)
                (set! fEntityManager
                      (cast XMLEntityManager (.getProperty componentManager ENTITY_MANAGER)))
                (set! fErrorReporter
                      (cast XMLErrorReporter (.getProperty componentManager ERROR_REPORTER)))
                (let [^:mutable ^SchemaDVFactory dvFactory nil]
                  (set! dvFactory (.getDVFactory fSchemaHandler))
                  (when (nil? dvFactory)
                    (set! dvFactory (SchemaDVFactory/getInstance))
                    (.setDVFactory fSchemaHandler dvFactory))
                  (try
                    (set! fExternalSchemas
                          (cast String (.getProperty componentManager SCHEMA_LOCATION)))
                    (set! fExternalNoNSSchema
                          (cast String (.getProperty componentManager SCHEMA_NONS_LOCATION)))
                    (catch XMLConfigurationException e
                      (set! fExternalSchemas nil)
                      (set! fExternalNoNSSchema nil)))
                  (set! fJAXPSource (.getProperty componentManager JAXP_SCHEMA_SOURCE nil))
                  (set! fJAXPProcessed false)
                  (set! fGrammarPool
                        (cast XMLGrammarPool (.getProperty componentManager XMLGRAMMAR_POOL nil)))
                  (.initGrammarBucket this)
                  (let [psvi (.getFeature componentManager AUGMENT_PSVI false)]
                    (if (and (and (not psvi) (nil? fGrammarPool)) false)
                        (do
                          (if (some? fDeclPool)
                              (.reset fDeclPool)
                              (set! fDeclPool (XSDeclarationPool.)))
                          (.setDeclPool fCMBuilder fDeclPool)
                          (.setDeclPool fSchemaHandler fDeclPool)
                          (when (instance? SchemaDVFactoryImpl dvFactory)
                            (.setDVFactory fDeclPool (cast SchemaDVFactoryImpl dvFactory))
                            (.setDeclPool (cast SchemaDVFactoryImpl dvFactory) fDeclPool)))
                        (do
                          (.setDeclPool fCMBuilder nil)
                          (.setDeclPool fSchemaHandler nil)
                          (when (instance? SchemaDVFactoryImpl dvFactory)
                            (.setDeclPool (cast SchemaDVFactoryImpl dvFactory) nil))))
                    (try
                      (let [fatalError (.getFeature
                                         componentManager
                                         CONTINUE_AFTER_FATAL_ERROR
                                         false)]
                        (when-not fatalError
                          (.setFeature fErrorReporter CONTINUE_AFTER_FATAL_ERROR fatalError)))
                      (catch XMLConfigurationException e))
                    (set! fIsCheckedFully (.getFeature componentManager SCHEMA_FULL_CHECKING false))
                    (.setGenerateSyntheticAnnotations
                      fSchemaHandler
                      (.getFeature componentManager GENERATE_SYNTHETIC_ANNOTATIONS false))
                    (.reset fSchemaHandler componentManager)))))))))

  (method ^:private initGrammarBucket ^void [this]
    (when (some? fGrammarPool)
      (let [initialGrammars (.retrieveInitialGrammarSet
                              fGrammarPool
                              XMLGrammarDescription/XML_SCHEMA)
            ^:final ^int length (if (some? initialGrammars) (alength initialGrammars) 0)]
        (loop [^int i 0]
          (if (< i length)
              (if (not (.putGrammar fGrammarBucket
                                    (cast SchemaGrammar (aget initialGrammars i))
                                    true))
                  (do
                    (.reportError fErrorReporter
                                  XSMessageFormatter/SCHEMA_DOMAIN
                                  "GrammarConflict"
                                  nil
                                  XMLErrorReporter/SEVERITY_WARNING)
                    (recur (unchecked-inc-int i)))
                  (recur (unchecked-inc-int i)))
              nil)))))

  (method ^:public getConfig ^DOMConfiguration [this] this)

  (method ^:public load ^XSModel [this ^LSInput is]
    (try
      (let [g (.loadGrammar this (.dom2xmlInputSource this is))] (.toXSModel (cast XSGrammar g)))
      (catch Exception e (.reportDOMFatalError this e) nil)))

  (method ^:public loadInputList ^XSModel [this ^LSInputList is]
    (let [length (.getLength is)
          gs (new SchemaGrammar/1 length)]
      (loop [^int i 0]
        (when (< i length)
          (try
            (aset gs
                  i
                  (cast SchemaGrammar (.loadGrammar this (.dom2xmlInputSource this (.item is i)))))
            (catch Exception e (.reportDOMFatalError this e) (return nil)))
          (recur (unchecked-inc-int i))))
      (XSModelImpl. gs)))

  (method ^:public loadURI ^XSModel [this ^String uri]
    (try
      (let [g (.loadGrammar this (XMLInputSource. nil uri nil false))]
        (.toXSModel (cast XSGrammar g)))
      (catch Exception e (.reportDOMFatalError this e) nil)))

  (method ^:public loadURIList ^XSModel [this ^StringList uriList]
    (let [length (.getLength uriList)
          gs (new SchemaGrammar/1 length)]
      (loop [^int i 0]
        (when (< i length)
          (try
            (aset gs
                  i
                  (cast SchemaGrammar
                        (.loadGrammar this (XMLInputSource. nil (.item uriList i) nil false))))
            (catch Exception e (.reportDOMFatalError this e) (return nil)))
          (recur (unchecked-inc-int i))))
      (XSModelImpl. gs)))

  (method reportDOMFatalError ^void [this ^Exception e]
    (when (some? fErrorHandler)
      (let [error (DOMErrorImpl.)]
        (set! (.-fException error) e)
        (set! (.-fMessage error) (.getMessage e))
        (set! (.-fSeverity error) DOMError/SEVERITY_FATAL_ERROR)
        (.handleError (.getErrorHandler fErrorHandler) error))))

  (method ^:public canSetParameter ^boolean [this ^String name value]
    (cond
      (instance? Boolean value)
        (if (or (or (or (or (or (or (or (or (or (or
                                                  (.equals name Constants/DOM_VALIDATE)
                                                  (.equals name SCHEMA_FULL_CHECKING))
                                                (.equals name VALIDATE_ANNOTATIONS))
                                            (.equals name CONTINUE_AFTER_FATAL_ERROR))
                                        (.equals name ALLOW_JAVA_ENCODINGS))
                                    (.equals name STANDARD_URI_CONFORMANT_FEATURE))
                                (.equals name GENERATE_SYNTHETIC_ANNOTATIONS))
                            (.equals name HONOUR_ALL_SCHEMALOCATIONS))
                        (.equals name NAMESPACE_GROWTH))
                    (.equals name TOLERATE_DUPLICATES))
                (.equals name OVERRIDE_PARSER))
            true
            false)
      (or (or (or (or (or (or (or (or (or (or (.equals name Constants/DOM_ERROR_HANDLER)
                                              (.equals name Constants/DOM_RESOURCE_RESOLVER))
                                          (.equals name SYMBOL_TABLE))
                                      (.equals name ERROR_REPORTER))
                                  (.equals name ERROR_HANDLER))
                              (.equals name ENTITY_RESOLVER))
                          (.equals name XMLGRAMMAR_POOL))
                      (.equals name SCHEMA_LOCATION))
                  (.equals name SCHEMA_NONS_LOCATION))
              (.equals name JAXP_SCHEMA_SOURCE))
          (.equals name SCHEMA_DV_FACTORY))
        true
      :else false))

  (method ^:public getParameter :throws [DOMException] [this ^String name]
    (cond
      (.equals name Constants/DOM_ERROR_HANDLER)
        (when (some? fErrorHandler) ^Object (.getErrorHandler fErrorHandler))
      (.equals name Constants/DOM_RESOURCE_RESOLVER)
        (when (some? fResourceResolver) ^Object (.getEntityResolver fResourceResolver))
      :else
        (try
          (let [feature (.getFeature this name)] (if feature Boolean/TRUE Boolean/FALSE))
          (catch Exception e
            (let [^:mutable ^Object property nil]
              (try
                (set! property (.getProperty this name))
                property
                (catch Exception ex
                  (let [msg (DOMMessageFormatter/formatMessage
                              DOMMessageFormatter/DOM_DOMAIN
                              "FEATURE_NOT_SUPPORTED"
                              (new Object/1 [name]))]
                    (throw (DOMException. DOMException/NOT_SUPPORTED_ERR msg))))))))))

  (method ^:public getParameterNames ^DOMStringList [this]
    (when (nil? fRecognizedParameters)
      (let [^{:tag (ArrayList String)} v (ArrayList.)]
        (.add v Constants/DOM_VALIDATE)
        (.add v Constants/DOM_ERROR_HANDLER)
        (.add v Constants/DOM_RESOURCE_RESOLVER)
        (.add v SYMBOL_TABLE)
        (.add v ERROR_REPORTER)
        (.add v ERROR_HANDLER)
        (.add v ENTITY_RESOLVER)
        (.add v XMLGRAMMAR_POOL)
        (.add v SCHEMA_LOCATION)
        (.add v SCHEMA_NONS_LOCATION)
        (.add v JAXP_SCHEMA_SOURCE)
        (.add v SCHEMA_FULL_CHECKING)
        (.add v CONTINUE_AFTER_FATAL_ERROR)
        (.add v ALLOW_JAVA_ENCODINGS)
        (.add v STANDARD_URI_CONFORMANT_FEATURE)
        (.add v VALIDATE_ANNOTATIONS)
        (.add v GENERATE_SYNTHETIC_ANNOTATIONS)
        (.add v HONOUR_ALL_SCHEMALOCATIONS)
        (.add v NAMESPACE_GROWTH)
        (.add v TOLERATE_DUPLICATES)
        (.add v OVERRIDE_PARSER)
        (set! fRecognizedParameters (DOMStringListImpl. v))))
    fRecognizedParameters)

  (method ^:public setParameter :throws [DOMException] ^void [this ^String name value]
    (cond
      (instance? Boolean value)
        (let [state (.booleanValue (cast Boolean value))]
          (when-not (and (.equals name "validate") state)
            (try
              (.setFeature this name state)
              (catch Exception e
                (let [msg (DOMMessageFormatter/formatMessage
                            DOMMessageFormatter/DOM_DOMAIN
                            "FEATURE_NOT_SUPPORTED"
                            (new Object/1 [name]))]
                  (throw (DOMException. DOMException/NOT_SUPPORTED_ERR msg)))))))
      (.equals name Constants/DOM_ERROR_HANDLER)
        (if (instance? DOMErrorHandler value)
            (try
              (set! fErrorHandler (DOMErrorHandlerWrapper. (cast DOMErrorHandler value)))
              (.setErrorHandler this fErrorHandler)
              (catch XMLConfigurationException e))
            (let [msg (DOMMessageFormatter/formatMessage
                        DOMMessageFormatter/DOM_DOMAIN
                        "FEATURE_NOT_SUPPORTED"
                        (new Object/1 [name]))]
              (throw (DOMException. DOMException/NOT_SUPPORTED_ERR msg))))
      (.equals name Constants/DOM_RESOURCE_RESOLVER)
        (if (instance? LSResourceResolver value)
            (try
              (set! fResourceResolver (DOMEntityResolverWrapper. (cast LSResourceResolver value)))
              (.setEntityResolver this fResourceResolver)
              (catch XMLConfigurationException e))
            (let [msg (DOMMessageFormatter/formatMessage
                        DOMMessageFormatter/DOM_DOMAIN
                        "FEATURE_NOT_SUPPORTED"
                        (new Object/1 [name]))]
              (throw (DOMException. DOMException/NOT_SUPPORTED_ERR msg))))
      :else
        (try
          (.setProperty this name value)
          (catch Exception ex
            (let [msg (DOMMessageFormatter/formatMessage
                        DOMMessageFormatter/DOM_DOMAIN
                        "FEATURE_NOT_SUPPORTED"
                        (new Object/1 [name]))]
              (throw (DOMException. DOMException/NOT_SUPPORTED_ERR msg)))))))

  (method dom2xmlInputSource ^XMLInputSource [this ^LSInput is]
    (let [^:mutable ^XMLInputSource xis nil]
      (cond
        (some? (.getCharacterStream is))
          (set! xis
                (XMLInputSource. (.getPublicId is)
                                 (.getSystemId is)
                                 (.getBaseURI is)
                                 (.getCharacterStream is)
                                 "UTF-16"))
        (some? (.getByteStream is))
          (set! xis
                (XMLInputSource. (.getPublicId is)
                                 (.getSystemId is)
                                 (.getBaseURI is)
                                 (.getByteStream is)
                                 (.getEncoding is)))
        (and (some? (.getStringData is)) (not (== (.length (.getStringData is)) 0)))
          (set! xis
                (XMLInputSource. (.getPublicId is)
                                 (.getSystemId is)
                                 (.getBaseURI is)
                                 (StringReader. (.getStringData is))
                                 "UTF-16"))
        :else
          (set! xis (XMLInputSource. (.getPublicId is) (.getSystemId is) (.getBaseURI is) false)))
      xis))

  (method ^:public getGlobalElementDecl ^XSElementDecl [this ^QName element]
    (let [sGrammar (.getGrammar fGrammarBucket (.-uri element))]
      (when (some? sGrammar) (.getGlobalElementDecl sGrammar (.-localpart element))))))

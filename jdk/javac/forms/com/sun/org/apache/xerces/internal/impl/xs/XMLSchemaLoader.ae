              (catch IOException ex
                (.reportError fErrorReporter
                              XSMessageFormatter/SCHEMA_DOMAIN
                              "schema_reference.4"
                              (new Object/1 [loc])
                              XMLErrorReporter/SEVERITY_ERROR)))
            (if (nil? xis) (XMLInputSource. nil loc nil false) xis)))
      (instance? InputSource val) (XMLSchemaLoader/saxToXMLInputSource (cast InputSource val))
      (instance? InputStream val) (XMLInputSource. nil nil nil (cast InputStream val) nil)
      (instance? File val)

  (method ^:private xsdToXMLInputSource ^XMLInputSource [this val]
    (cond
      (instance? String val)
        (let [loc (cast String val)]
          (.reset fXSDDescription)
          (.setValues fXSDDescription nil loc nil nil)
          (let [^:mutable ^XMLInputSource xis nil]

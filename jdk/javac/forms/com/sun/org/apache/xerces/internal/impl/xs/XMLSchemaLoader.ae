                (let [g (cast SchemaGrammar (.get fJAXPCache fJAXPSource))]
                  (when (some? g) (.putGrammar fGrammarBucket g) (return))))
              (.reset fXSDDescription)
              (set! xis (.xsdToXMLInputSource this fJAXPSource))
              (set! sid (.getSystemId xis))
              (set! (.-fContextType fXSDDescription) XSDDescription/CONTEXT_PREPARSE)
              (when (some? sid)
                (.setBaseSystemId fXSDDescription (.getBaseSystemId xis))
                (.setLiteralSystemId fXSDDescription sid)
                (.setExpandedSystemId fXSDDescription sid)
                (set! (.-fLocationHints fXSDDescription) (new String/1 [sid])))
              (let [g (.loadSchema this fXSDDescription xis locationPairs)]
                (when (some? g)
                  (when (or (instance? InputStream fJAXPSource) (instance? InputSource fJAXPSource))
                    (.put fJAXPCache fJAXPSource g)
                    (when fIsCheckedFully
                      (XSConstraints/fullSchemaChecking
                        fGrammarBucket
                        fSubGroupHandler
                        fCMBuilder
                        fErrorReporter)))
                  (.putGrammar fGrammarBucket g))))
            (do
              (when (and (and (and (and (and (not (identical? componentType Object))
                                             (not (identical? componentType String)))
                                        (not (.isAssignableFrom File componentType)))
                                   (not (.isAssignableFrom InputStream componentType)))
                              (not (.isAssignableFrom InputSource componentType)))
                         (not (.isInterface componentType)))
                (let [mf (.getMessageFormatter fErrorReporter XSMessageFormatter/SCHEMA_DOMAIN)]
                  (throw (XMLConfigurationException.
                           Status/NOT_SUPPORTED
                           (.formatMessage mf
                                           (.getLocale fErrorReporter)
                                           "jaxp12-schema-source-type.2"
                                           (new Object/1 [(.getName componentType)]))))))
              (let [objArr (cast Object/1 fJAXPSource)
                    ^{:tag (ArrayList String)} jaxpSchemaSourceNamespaces (ArrayList.)]

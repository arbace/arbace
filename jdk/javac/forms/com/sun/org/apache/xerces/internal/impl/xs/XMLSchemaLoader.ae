            (when (nil? la) (set! la (LocationArray.)) (.put locations XMLSymbols/EMPTY_STRING la))
            (.addLocation la nsl)))
        (catch InvalidDatatypeValueException ex
          (.reportError er
                        XSMessageFormatter/SCHEMA_DOMAIN
                        (.getKey ex)
                        (.getArgs ex)
                        XMLErrorReporter/SEVERITY_WARNING)))))

  (method ^:public ^:static tokenizeSchemaLocationStr ^boolean [^String schemaStr
                                                                ^{:tag (Map String LocationArray)} locations
                                                                ^String base]
    (when (some? schemaStr)
      (let [t (StringTokenizer. schemaStr " \n\t\r")
            ^:mutable ^String namespace nil
            ^:mutable ^String location nil]
        (while (.hasMoreTokens t)
          (set! namespace (.nextToken t))
          (when-not (.hasMoreTokens t) (return false))
          (set! location (.nextToken t))
          (let [^:mutable la (cast LocationArray (.get locations namespace))]
            (when (nil? la) (set! la (LocationArray.)) (.put locations namespace la))
            (when (some? base)
              (try
                (set! location (XMLEntityManager/expandSystemId location base false))
                (catch URI$MalformedURIException e)))
            (.addLocation la location)))))
    true)

  (method ^:private processJAXPSchemaSource :throws [IOException] ^void [this
                                                                         ^{:tag (Map String LocationArray)} locationPairs]
    (set! fJAXPProcessed true)

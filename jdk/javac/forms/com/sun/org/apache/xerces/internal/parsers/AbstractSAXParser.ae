        (let [identifier (.getIdentifier e)]
          (if (identical? (.getType e) Status/NOT_RECOGNIZED)
              (throw (SAXNotRecognizedException.
                       (SAXMessageFormatter/formatMessage
                         (.getLocale (.-fConfiguration this))
                         "property-not-recognized"
                         (new Object/1 [identifier]))))
              (throw (SAXNotSupportedException.
                       (SAXMessageFormatter/formatMessage
                         (.getLocale (.-fConfiguration this))
                         "property-not-supported"
                         (new Object/1 [identifier])))))))))

  (method ^:public getProperty :throws [SAXNotRecognizedException SAXNotSupportedException] [this
                                                                                             ^String propertyId]
    (try
      (when (.startsWith propertyId Constants/SAX_PROPERTY_PREFIX)
        (let [suffixLength (unchecked-subtract-int
                             (.length propertyId)
                             (.length Constants/SAX_PROPERTY_PREFIX))]
          (when (and (== suffixLength (.length Constants/DOCUMENT_XML_VERSION_PROPERTY))

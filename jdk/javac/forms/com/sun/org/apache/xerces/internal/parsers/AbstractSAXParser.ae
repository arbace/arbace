                              (and (== suffixLength (.length Constants/USE_ATTRIBUTES2_FEATURE))
                                   (.endsWith featureId Constants/USE_ATTRIBUTES2_FEATURE)))
                          (and (== suffixLength (.length Constants/USE_LOCATOR2_FEATURE))
                               (.endsWith featureId Constants/USE_LOCATOR2_FEATURE)))
                      (and (== suffixLength (.length Constants/XML_11_FEATURE))
                           (.endsWith featureId Constants/XML_11_FEATURE)))
              (throw (SAXNotSupportedException.
                       (SAXMessageFormatter/formatMessage
                         (.getLocale (.-fConfiguration this))
                         "feature-read-only"
                         (new Object/1 [featureId]))))))
        (.equals featureId XMLConstants/FEATURE_SECURE_PROCESSING)
          (when state
            (when (nil? (.getProperty (.-fConfiguration this) SECURITY_MANAGER))
              (.setProperty (.-fConfiguration this)
                            SECURITY_MANAGER
                            (.getXMLSecurityManager (.-config this) true)))))
      (when-not (.setLimit (.-securityManager this) featureId JdkProperty$State/APIPROPERTY state)
        (.setFeature (.-fConfiguration this) featureId state))
      (catch XMLConfigurationException e
        (let [identifier (.getIdentifier e)]
          (if (identical? (.getType e) Status/NOT_RECOGNIZED)
              (throw (SAXNotRecognizedException.
                       (SAXMessageFormatter/formatMessage
                         (.getLocale (.-fConfiguration this))
                         "feature-not-recognized"
                         (new Object/1 [identifier]))))
              (throw (SAXNotSupportedException.
                       (SAXMessageFormatter/formatMessage
                         (.getLocale (.-fConfiguration this))
                         "feature-not-supported"
                         (new Object/1 [identifier])))))))))

  (method ^:public getFeature :throws [SAXNotRecognizedException SAXNotSupportedException] ^boolean [this
                                                                                                     ^String featureId]
    (try
      (when (.startsWith featureId Constants/SAX_FEATURE_PREFIX)
        (let [suffixLength (unchecked-subtract-int
                             (.length featureId)
                             (.length Constants/SAX_FEATURE_PREFIX))]
          (when (and (== suffixLength (.length Constants/NAMESPACE_PREFIXES_FEATURE))
                     (.endsWith featureId Constants/NAMESPACE_PREFIXES_FEATURE))
            (let [state (.getFeature (.-fConfiguration this) featureId)] (return state)))
          (when (and (== suffixLength (.length Constants/STRING_INTERNING_FEATURE))
                     (.endsWith featureId Constants/STRING_INTERNING_FEATURE))
            (return true))
          (when (and (== suffixLength (.length Constants/IS_STANDALONE_FEATURE))
                     (.endsWith featureId Constants/IS_STANDALONE_FEATURE))
            (return fStandalone))
          (when (and (== suffixLength (.length Constants/XML_11_FEATURE))
                     (.endsWith featureId Constants/XML_11_FEATURE))
            (return (instance? XML11Configurable (.-fConfiguration this))))
          (when (and (== suffixLength
                         (.length Constants/LEXICAL_HANDLER_PARAMETER_ENTITIES_FEATURE))
                     (.endsWith featureId Constants/LEXICAL_HANDLER_PARAMETER_ENTITIES_FEATURE))
            (return fLexicalHandlerParameterEntities))
          (when (and (== suffixLength (.length Constants/RESOLVE_DTD_URIS_FEATURE))
                     (.endsWith featureId Constants/RESOLVE_DTD_URIS_FEATURE))
            (return fResolveDTDURIs))
          (when (and (== suffixLength (.length Constants/XMLNS_URIS_FEATURE))
                     (.endsWith featureId Constants/XMLNS_URIS_FEATURE))
            (return fXMLNSURIs))
          (when (and (== suffixLength (.length Constants/UNICODE_NORMALIZATION_CHECKING_FEATURE))
                     (.endsWith featureId Constants/UNICODE_NORMALIZATION_CHECKING_FEATURE))
            (return false))
          (when (and (== suffixLength (.length Constants/USE_ENTITY_RESOLVER2_FEATURE))
                     (.endsWith featureId Constants/USE_ENTITY_RESOLVER2_FEATURE))
            (return fUseEntityResolver2))
          (when (or (and (== suffixLength (.length Constants/USE_ATTRIBUTES2_FEATURE))
                         (.endsWith featureId Constants/USE_ATTRIBUTES2_FEATURE))
                    (and (== suffixLength (.length Constants/USE_LOCATOR2_FEATURE))
                         (.endsWith featureId Constants/USE_LOCATOR2_FEATURE)))
            (return true))))
      (if (.equals featureId XMLSecurityManager/DISALLOW_DTD)
          (.is (.-securityManager this) XMLSecurityManager$Limit/XERCES_DISALLOW_DTD)
          (.getFeature (.-fConfiguration this) featureId))
      (catch XMLConfigurationException e
        (let [identifier (.getIdentifier e)]
          (if (identical? (.getType e) Status/NOT_RECOGNIZED)
              (throw (SAXNotRecognizedException.
                       (SAXMessageFormatter/formatMessage
                         (.getLocale (.-fConfiguration this))
                         "feature-not-recognized"
                         (new Object/1 [identifier]))))
              (throw (SAXNotSupportedException.
                       (SAXMessageFormatter/formatMessage
                         (.getLocale (.-fConfiguration this))
                         "feature-not-supported"
                         (new Object/1 [identifier])))))))))

  (method ^:public setProperty :throws [SAXNotRecognizedException SAXNotSupportedException] ^void [this
                                                                                                   ^String propertyId
                                                                                                   value]
    (try

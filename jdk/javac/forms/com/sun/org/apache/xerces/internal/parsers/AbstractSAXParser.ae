            (return))
          (when (and (== suffixLength (.length Constants/DECLARATION_HANDLER_PROPERTY))
                     (.endsWith propertyId Constants/DECLARATION_HANDLER_PROPERTY))
            (try
              (.setDeclHandler this (cast DeclHandler value))
              (catch ClassCastException e
                (throw (SAXNotSupportedException.
                         (SAXMessageFormatter/formatMessage
                           (.getLocale (.-fConfiguration this))
                           "incompatible-class"
                           (new Object/1 [propertyId "org.xml.sax.ext.DeclHandler"]))))))
            (return))
          (when (or (and (== suffixLength (.length Constants/DOM_NODE_PROPERTY))
                         (.endsWith propertyId Constants/DOM_NODE_PROPERTY))
                    (and (== suffixLength (.length Constants/DOCUMENT_XML_VERSION_PROPERTY))
                         (.endsWith propertyId Constants/DOCUMENT_XML_VERSION_PROPERTY)))

  (method ^:protected ^:final startNamespaceMapping :throws [SAXException] ^void [this]
    (let [count (.getDeclaredPrefixCount fNamespaceContext)]
      (when (> count 0)
        (let [^:mutable ^String prefix nil
              ^:mutable ^String uri nil]
          (loop [^int i 0]
            (when (< i count)
              (set! prefix (.getDeclaredPrefixAt fNamespaceContext i))
              (set! uri (.getURI fNamespaceContext prefix))
              (.startPrefixMapping fContentHandler prefix ^String (if (nil? uri) "" uri))
              (recur (unchecked-inc-int i))))))))

  (method ^:protected ^:final endNamespaceMapping :throws [SAXException] ^void [this]
    (let [count (.getDeclaredPrefixCount fNamespaceContext)]
      (when (> count 0)
        (loop [^int i 0]
          (when (< i count)
            (.endPrefixMapping fContentHandler (.getDeclaredPrefixAt fNamespaceContext i))
            (recur (unchecked-inc-int i)))))))

  (method ^:public reset :throws [XNIException] ^void [this]
    (.reset super)
    (set! (.-fInDTD this) false)
    (set! fVersion "1.0")
    (set! fStandalone false)
    (set! fNamespaces (.getFeature (.-fConfiguration this) NAMESPACES))
    (set! fNamespacePrefixes (.getFeature (.-fConfiguration this) NAMESPACE_PREFIXES))
    (set! fAugmentations nil)
    (set! fDeclaredAttrs nil))

  (defclass ^:protected LocatorProxy
    :implements [Locator2]

    (field ^:protected ^XMLLocator fLocator)

    (constructor ^:public [this ^XMLLocator locator]
      (set! fLocator locator))

    (method ^:public getPublicId ^String [this] (.getPublicId fLocator))

    (method ^:public getSystemId ^String [this]
      (.getExpandedSystemId fLocator))

    (method ^:public getLineNumber ^int [this] (.getLineNumber fLocator))

    (method ^:public getColumnNumber ^int [this]
      (.getColumnNumber fLocator))

    (method ^:public getXMLVersion ^String [this] (.getXMLVersion fLocator))

    (method ^:public getEncoding ^String [this] (.getEncoding fLocator)))

  (defclass ^:protected ^:static ^:final AttributesProxy
    :implements [AttributeList Attributes2]

    (field ^:protected ^XMLAttributes fAttributes)

    (method ^:public setAttributes ^void [this ^XMLAttributes attributes]
      (set! fAttributes attributes))

    (method ^:public getLength ^int [this] (.getLength fAttributes))

    (method ^:public getName ^String [this ^int i]
      (.getQName fAttributes i))

    (method ^:public getQName ^String [this ^int index]
      (.getQName fAttributes index))

    (method ^:public getURI ^String [this ^int index]
      (let [uri (.getURI fAttributes index)] (if (some? uri) uri "")))

    (method ^:public getLocalName ^String [this ^int index]
      (.getLocalName fAttributes index))

    (method ^:public getType ^String [this ^int i] (.getType fAttributes i))

    (method ^:public getType ^String [this ^String name]
      (.getType fAttributes name))

    (method ^:public getType ^String [this ^String uri ^String localName]
      (if (.equals uri "")
          (.getType fAttributes nil localName)
          (.getType fAttributes uri localName)))

    (method ^:public getValue ^String [this ^int i]
      (.getValue fAttributes i))

    (method ^:public getValue ^String [this ^String name]
      (.getValue fAttributes name))

    (method ^:public getValue ^String [this ^String uri ^String localName]
      (if (.equals uri "")
          (.getValue fAttributes nil localName)
          (.getValue fAttributes uri localName)))

    (method ^:public getIndex ^int [this ^String qName]
      (.getIndex fAttributes qName))

    (method ^:public getIndex ^int [this ^String uri ^String localPart]
      (if (.equals uri "")
          (.getIndex fAttributes nil localPart)
          (.getIndex fAttributes uri localPart)))

    (method ^:public isDeclared ^boolean [this ^int index]
      (when (or (< index 0) (>= index (.getLength fAttributes)))
        (throw (ArrayIndexOutOfBoundsException. index)))
      (.equals Boolean/TRUE
               (.getItem (.getAugmentations fAttributes index) Constants/ATTRIBUTE_DECLARED)))

    (method ^:public isDeclared ^boolean [this ^String qName]
      (let [index (.getIndex this qName)]
        (when (== index -1) (throw (IllegalArgumentException. qName)))
        (.equals Boolean/TRUE
                 (.getItem (.getAugmentations fAttributes index) Constants/ATTRIBUTE_DECLARED))))

    (method ^:public isDeclared ^boolean [this ^String uri ^String localName]
      (let [index (.getIndex this uri localName)]
        (when (== index -1) (throw (IllegalArgumentException. localName)))
        (.equals Boolean/TRUE
                 (.getItem (.getAugmentations fAttributes index) Constants/ATTRIBUTE_DECLARED))))

    (method ^:public isSpecified ^boolean [this ^int index]
      (when (or (< index 0) (>= index (.getLength fAttributes)))
        (throw (ArrayIndexOutOfBoundsException. index)))
      (.isSpecified fAttributes index))

    (method ^:public isSpecified ^boolean [this ^String qName]
      (let [index (.getIndex this qName)]
        (when (== index -1) (throw (IllegalArgumentException. qName)))
        (.isSpecified fAttributes index)))

    (method ^:public isSpecified ^boolean [this ^String uri ^String localName]
      (let [index (.getIndex this uri localName)]
        (when (== index -1) (throw (IllegalArgumentException. localName)))
        (.isSpecified fAttributes index))))

  (method ^:public getElementPSVI ^ElementPSVI [this]
    (when (some? fAugmentations)
      (cast ElementPSVI (.getItem fAugmentations Constants/ELEMENT_PSVI))))

  (method ^:public getAttributePSVI ^AttributePSVI [this ^int index]
    (cast AttributePSVI
          (.getItem (.getAugmentations (.-fAttributes fAttributesProxy) index)
                    Constants/ATTRIBUTE_PSVI)))

  (method ^:public getAttributePSVIByName ^AttributePSVI [this ^String uri ^String localname]
    (cast AttributePSVI
          (.getItem (.getAugmentations (.-fAttributes fAttributesProxy) uri localname)
                    Constants/ATTRIBUTE_PSVI))))

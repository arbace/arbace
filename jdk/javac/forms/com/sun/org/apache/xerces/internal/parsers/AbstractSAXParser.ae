          (when (and (== suffixLength (.length Constants/LEXICAL_HANDLER_PROPERTY))
                     (.endsWith propertyId Constants/LEXICAL_HANDLER_PROPERTY))
            (return (.getLexicalHandler this)))
          (when (and (== suffixLength (.length Constants/DECLARATION_HANDLER_PROPERTY))
                     (.endsWith propertyId Constants/DECLARATION_HANDLER_PROPERTY))
            (return (.getDeclHandler this)))
          (when (and (== suffixLength (.length Constants/DOM_NODE_PROPERTY))
                     (.endsWith propertyId Constants/DOM_NODE_PROPERTY))

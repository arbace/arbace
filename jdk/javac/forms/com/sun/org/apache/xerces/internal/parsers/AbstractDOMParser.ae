  (method ^:public ignorableWhitespace :throws [XNIException] ^void [this ^XMLString text
                                                                     ^Augmentations augs]
    (when-not (or (not fIncludeIgnorableWhitespace) fFilterReject)
      (if (not fDeferNodeExpansion)

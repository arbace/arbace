                          (set! fFirstChunk true)
                          (let [textNode (.createTextNode fDocument (.toString text))]
                            (.appendChild fCurrentNode textNode)))))))))
      (and fInCDATASection fCreateCDATANodes)
        (if (== fCurrentCDATASectionIndex -1)
            (let [cs (.createDeferredCDATASection fDeferredDocumentImpl (.toString text))]
              (.appendChild fDeferredDocumentImpl fCurrentNodeIndex cs)
              (set! fCurrentCDATASectionIndex cs)
              (set! fCurrentNodeIndex cs))

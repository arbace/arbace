        (.println System/out (java-str "   expandedSystemId:" (.getExpandedSystemId identifier)))
        (.println System/out (java-str "   baseURI:" (.getBaseSystemId identifier)))))
    (let [publicId (.getPublicId identifier)
          literalSystemId (.getLiteralSystemId identifier)]
      (when (and (some? fInternalSubset) (not fInDTDExternalSubset))
        (.append fInternalSubset "<!ENTITY ")

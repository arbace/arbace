            (if (and (some? child) (== (.getNodeType child) Node/TEXT_NODE))
                (let [textNode (cast Text child)] (.appendData textNode (.toString text)))
                (let [textNode (.createTextNode fDocument (.toString text))]
                  (when (some? fDocumentImpl)
                    (let [textNodeImpl (cast TextImpl textNode)]
                      (.setIgnorableWhitespace textNodeImpl true)))
                  (.appendChild fCurrentNode textNode))))
          (let [txt (.createDeferredTextNode fDeferredDocumentImpl (.toString text) true)]
            (.appendChild fDeferredDocumentImpl fCurrentNodeIndex txt)))))

  (method ^:public endElement :throws [XNIException] ^void [this ^QName element ^Augmentations augs]
    (when DEBUG_EVENTS (.println System/out (java-str "==>endElement (" (.-rawname element) ")")))
    (if (not fDeferNodeExpansion)
        (do
          (when (and (and (some? augs) (some? fDocumentImpl)) (or fNamespaceAware fStorePSVI))
            (let [elementPSVI (cast ElementPSVI (.getItem augs Constants/ELEMENT_PSVI))]
              (when (some? elementPSVI)
                (when fNamespaceAware
                  (let [^:mutable ^XSTypeDefinition type (.getMemberTypeDefinition elementPSVI)]
                    (when (nil? type) (set! type (.getTypeDefinition elementPSVI)))
                    (.setType (cast ElementNSImpl fCurrentNode) type)))
                (when fStorePSVI (.setPSVI (cast PSVIElementNSImpl fCurrentNode) elementPSVI)))))
          (if (some? fDOMFilter)
              (if fFilterReject
                  (when (== (let [old-1 fRejectedElementDepth]
                              (set! fRejectedElementDepth (unchecked-dec-int fRejectedElementDepth))
                              old-1)
                            0)
                    (set! fFilterReject false))
                  (do
                    (when-not (.isEmpty fSkippedElemStack)
                      (when (identical? (.pop fSkippedElemStack) Boolean/TRUE) (return)))
                    (.setCharacterData this false)
                    (when (and (and (not (identical? fCurrentNode fRoot)) (not fInEntityRef))
                               (not (== (bit-and-int
                                          (.getWhatToShow fDOMFilter)
                                          NodeFilter/SHOW_ELEMENT)
                                        0)))
                      (let [code (.acceptNode fDOMFilter fCurrentNode)]
                        (switch code
                          LSParserFilter/FILTER_INTERRUPT (throw Abort/INSTANCE)
                          LSParserFilter/FILTER_REJECT
                            (let [parent (.getParentNode fCurrentNode)]
                              (.removeChild parent fCurrentNode)
                              (set! fCurrentNode parent)
                              (return))
                          LSParserFilter/FILTER_SKIP
                            (do
                              (set! fFirstChunk true)
                              (let [parent (.getParentNode fCurrentNode)
                                    ls (.getChildNodes fCurrentNode)
                                    length (.getLength ls)]
                                (loop [^int i 0]
                                  (when (< i length)
                                    (.appendChild parent (.item ls 0))
                                    (recur (unchecked-inc-int i))))

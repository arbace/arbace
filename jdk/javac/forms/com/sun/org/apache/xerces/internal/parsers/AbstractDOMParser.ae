  (method ^:public internalEntityDecl :throws [XNIException] ^void [this ^String name
                                                                    ^XMLString text
                                                                    ^XMLString nonNormalizedText
                                                                    ^Augmentations augs]
    (when DEBUG_EVENTS
      (.println System/out (java-str "==>internalEntityDecl: " name))
      (when DEBUG_BASEURI
        (.println System/out (java-str "   baseURI:" (cast String (.peek fBaseURIStack))))))
    (when (and (some? fInternalSubset) (not fInDTDExternalSubset))
      (.append fInternalSubset "<!ENTITY ")
      (if (.startsWith name "%")
          (do (.append fInternalSubset "% ") (.append fInternalSubset (.substring name 1)))
          (.append fInternalSubset name))
      (.append fInternalSubset \space)
      (let [value (.toString nonNormalizedText)
            singleQuote (== (.indexOf value \') -1)]
        (.append fInternalSubset (if singleQuote \' \"))
        (.append fInternalSubset value)
        (.append fInternalSubset (if singleQuote \' \"))
        (.append fInternalSubset ">\n")))
    (when-not (.startsWith name "%")
      (when (some? fDocumentType)
        (let [entities (.getEntities fDocumentType)
              ^:mutable entity (cast EntityImpl (.getNamedItem entities name))]
          (when (nil? entity)
            (set! entity (cast EntityImpl (.createEntity fDocumentImpl name)))
            (.setBaseURI entity (cast String (.peek fBaseURIStack)))
            (.setNamedItem entities entity))))
      (when-not (== fDocumentTypeIndex -1)
        (let [^:mutable found false
              ^:mutable node (.getLastChild fDeferredDocumentImpl fDocumentTypeIndex false)]
          (while (not (== node -1))
            (let [nodeType (.getNodeType fDeferredDocumentImpl node false)]
              (when (== nodeType Node/ENTITY_NODE)
                (let [nodeName (.getNodeName fDeferredDocumentImpl node false)]
                  (when (.equals nodeName name) (set! found true) (break))))
              (set! node (.getRealPrevSibling fDeferredDocumentImpl node false))))
          (when-not found
            (let [entityIndex (.createDeferredEntity
                                fDeferredDocumentImpl
                                name
                                nil
                                nil
                                nil
                                (cast String (.peek fBaseURIStack)))]
              (.appendChild fDeferredDocumentImpl fDocumentTypeIndex entityIndex)))))))

  (method ^:public externalEntityDecl :throws [XNIException] ^void [this ^String name
                                                                    ^XMLResourceIdentifier identifier
                                                                    ^Augmentations augs]

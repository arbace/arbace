      (when-not fFilterReject (when fCreateCDATANodes (.setCharacterData this false)))))

  (method ^:public endCDATA :throws [XNIException] ^void [this ^Augmentations augs]
    (set! fInCDATASection false)
    (if (not fDeferNodeExpansion)
        (when-not fFilterReject
          (when (some? fCurrentCDATASection)
            (when (and (and (some? fDOMFilter) (not fInEntityRef))
                       (not (== (bit-and-int (.getWhatToShow fDOMFilter)
                                             NodeFilter/SHOW_CDATA_SECTION)
                                0)))
              (let [code (.acceptNode fDOMFilter fCurrentCDATASection)]
                (switch code
                  LSParserFilter/FILTER_INTERRUPT (throw Abort/INSTANCE)
                  LSParserFilter/FILTER_REJECT
                    (let [parent (.getParentNode fCurrentNode)]
                      (.removeChild parent fCurrentCDATASection)
                      (set! fCurrentNode parent)
                      (return))
                  LSParserFilter/FILTER_SKIP
                    (let [parent (.getParentNode fCurrentNode)]
                      (.removeChild parent fCurrentCDATASection)
                      (set! fCurrentNode parent)
                      (return))
                  nil)))
            (set! fCurrentNode (.getParentNode fCurrentNode))
            (set! fCurrentCDATASection nil)))
        (when-not (== fCurrentCDATASectionIndex -1)
          (set! fCurrentNodeIndex (.getParentNode fDeferredDocumentImpl fCurrentNodeIndex false))
          (set! fCurrentCDATASectionIndex -1))))

  (method ^:public endDocument :throws [XNIException] ^void [this ^Augmentations augs]
    (if (not fDeferNodeExpansion)
        (do
          (when (some? fDocumentImpl)
            (when (some? fLocator)
              (when (some? (.getEncoding fLocator))
                (.setInputEncoding fDocumentImpl (.getEncoding fLocator))))
            (.setStrictErrorChecking fDocumentImpl true))
          (set! fCurrentNode nil))
        (do
          (when (some? fLocator)
            (when (some? (.getEncoding fLocator))
              (.setInputEncoding fDeferredDocumentImpl (.getEncoding fLocator))))
          (set! fCurrentNodeIndex -1))))

  (method ^:public endGeneralEntity :throws [XNIException] ^void [this ^String name
                                                                  ^Augmentations augs]
    (when DEBUG_EVENTS (.println System/out (java-str "==>endGeneralEntity: (" name ")")))
    (if (not fDeferNodeExpansion)
        (when-not fFilterReject
          (.setCharacterData this true)
          (when (some? fDocumentType)
            (let [entities (.getEntities fDocumentType)]
              (set! fCurrentEntityDecl (cast EntityImpl (.getNamedItem entities name)))
              (when (some? fCurrentEntityDecl)
                (when (and (some? fCurrentEntityDecl) (nil? (.getFirstChild fCurrentEntityDecl)))
                  (.setReadOnly fCurrentEntityDecl false true)
                  (let [^:mutable child (.getFirstChild fCurrentNode)]
                    (while (some? child)
                      (let [copy (.cloneNode child true)]
                        (.appendChild fCurrentEntityDecl copy)
                        (set! child (.getNextSibling child))))
                    (.setReadOnly fCurrentEntityDecl true true)))
                (set! fCurrentEntityDecl nil))))
          (set! fInEntityRef false)
          (let [^:mutable removeEntityRef false]
            (when fCreateEntityRefNodes
              (when (some? fDocumentImpl) (.setReadOnly (cast NodeImpl fCurrentNode) true true))
              (if (and (some? fDOMFilter)
                       (not (== (bit-and-int (.getWhatToShow fDOMFilter)
                                             NodeFilter/SHOW_ENTITY_REFERENCE)
                                0)))
                  (let [code (.acceptNode fDOMFilter fCurrentNode)]
                    (switch code
                      LSParserFilter/FILTER_INTERRUPT (throw Abort/INSTANCE)
                      LSParserFilter/FILTER_REJECT
                        (let [parent (.getParentNode fCurrentNode)]
                          (.removeChild parent fCurrentNode)
                          (set! fCurrentNode parent)
                          (return))
                      LSParserFilter/FILTER_SKIP
                        (do (set! fFirstChunk true) (set! removeEntityRef true))
                      (set! fCurrentNode (.getParentNode fCurrentNode))))
                  (set! fCurrentNode (.getParentNode fCurrentNode))))
            (when (or (not fCreateEntityRefNodes) removeEntityRef)
              (let [children (.getChildNodes fCurrentNode)
                    parent (.getParentNode fCurrentNode)
                    length (.getLength children)]
                (when (> length 0)
                  (let [^:mutable node (.getPreviousSibling fCurrentNode)
                        child (.item children 0)]
                    (if (and (and (some? node) (== (.getNodeType node) Node/TEXT_NODE))
                             (== (.getNodeType child) Node/TEXT_NODE))
                        (do
                          (.appendData (cast Text node) (.getNodeValue child))
                          (.removeChild fCurrentNode child))
                        (do
                          (set! node (.insertBefore parent child fCurrentNode))
                          (.handleBaseURI this node)))
                    (loop [^int i 1]
                      (when (< i length)
                        (set! node (.insertBefore parent (.item children 0) fCurrentNode))
                        (.handleBaseURI this node)
                        (recur (unchecked-inc-int i))))))

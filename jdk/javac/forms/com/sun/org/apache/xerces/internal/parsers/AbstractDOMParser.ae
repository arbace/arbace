          (let [entities (.getEntities fDocumentType)
                ^:mutable entity (cast EntityImpl (.getNamedItem entities name))]
            (when (nil? entity)
              (set! entity (cast EntityImpl (.createEntity fDocumentImpl name)))
              (.setPublicId entity publicId)
              (.setSystemId entity literalSystemId)
              (.setBaseURI entity (.getBaseSystemId identifier))
              (.setNamedItem entities entity))))
        (when-not (== fDocumentTypeIndex -1)
          (let [^:mutable found false
                ^:mutable nodeIndex (.getLastChild fDeferredDocumentImpl fDocumentTypeIndex false)]
            (while (not (== nodeIndex -1))
              (let [nodeType (.getNodeType fDeferredDocumentImpl nodeIndex false)]
                (when (== nodeType Node/ENTITY_NODE)
                  (let [nodeName (.getNodeName fDeferredDocumentImpl nodeIndex false)]
                    (when (.equals nodeName name) (set! found true) (break))))
                (set! nodeIndex (.getRealPrevSibling fDeferredDocumentImpl nodeIndex false))))
            (when-not found
              (let [entityIndex (.createDeferredEntity
                                  fDeferredDocumentImpl
                                  name
                                  publicId
                                  literalSystemId
                                  nil
                                  (.getBaseSystemId identifier))]
                (.appendChild fDeferredDocumentImpl fDocumentTypeIndex entityIndex))))))))

  (method ^:public startParameterEntity :throws [XNIException] ^void [this ^String name
                                                                      ^XMLResourceIdentifier identifier
                                                                      ^String encoding
                                                                      ^Augmentations augs]

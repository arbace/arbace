              (while (not (== node -1))
                (let [nodeType (.getNodeType fDeferredDocumentImpl node false)]
                  (when (== nodeType Node/ENTITY_NODE)
                    (let [nodeName (.getNodeName fDeferredDocumentImpl node false)]
                      (when (.equals nodeName name) (set! fDeferredEntityDecl node) (break))))
                  (set! node (.getRealPrevSibling fDeferredDocumentImpl node false))))))
          (when (and (not (== fDeferredEntityDecl -1))
                     (== (.getLastChild fDeferredDocumentImpl fDeferredEntityDecl false) -1))
            (let [^:mutable ^int prevIndex -1
                  ^:mutable childIndex (.getLastChild fDeferredDocumentImpl fCurrentNodeIndex false)]
              (while (not (== childIndex -1))
                (let [cloneIndex (.cloneNode fDeferredDocumentImpl childIndex true)]
                  (.insertBefore fDeferredDocumentImpl fDeferredEntityDecl cloneIndex prevIndex)
                  (set! prevIndex cloneIndex)
                  (set! childIndex (.getRealPrevSibling fDeferredDocumentImpl childIndex false))))))
          (if fCreateEntityRefNodes
              (set! fCurrentNodeIndex
                    (.getParentNode fDeferredDocumentImpl fCurrentNodeIndex false))
              (let [^:mutable childIndex (.getLastChild
                                           fDeferredDocumentImpl
                                           fCurrentNodeIndex
                                           false)
                    parentIndex (.getParentNode fDeferredDocumentImpl fCurrentNodeIndex false)
                    ^:mutable prevIndex fCurrentNodeIndex
                    lastChild childIndex
                    ^:mutable ^int sibling -1]
                (while (not (== childIndex -1))
                  (.handleBaseURI this childIndex)
                  (set! sibling (.getRealPrevSibling fDeferredDocumentImpl childIndex false))
                  (.insertBefore fDeferredDocumentImpl parentIndex childIndex prevIndex)
                  (set! prevIndex childIndex)
                  (set! childIndex sibling))
                (if (not (== lastChild -1))
                    (.setAsLastChild fDeferredDocumentImpl parentIndex lastChild)

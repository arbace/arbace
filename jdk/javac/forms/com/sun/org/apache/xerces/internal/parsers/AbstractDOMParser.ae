              (.appendChild fDeferredDocumentImpl fDocumentTypeIndex notationIndex)))))))

  (method ^:public ignoredCharacters :throws [XNIException] ^void [this ^XMLString text
                                                                   ^Augmentations augs])

  (method ^:public elementDecl :throws [XNIException] ^void [this ^String name ^String contentModel
                                                             ^Augmentations augs]
    (when (and (some? fInternalSubset) (not fInDTDExternalSubset))
      (.append fInternalSubset "<!ELEMENT ")
      (.append fInternalSubset name)
      (.append fInternalSubset \space)
      (.append fInternalSubset contentModel)
      (.append fInternalSubset ">\n")))

  (method ^:public attributeDecl :throws [XNIException] ^void [this ^String elementName
                                                               ^String attributeName ^String type
                                                               ^String/1 enumeration
                                                               ^String defaultType
                                                               ^XMLString defaultValue
                                                               ^XMLString nonNormalizedDefaultValue
                                                               ^Augmentations augs]
    (when (and (some? fInternalSubset) (not fInDTDExternalSubset))
      (.append fInternalSubset "<!ATTLIST ")
      (.append fInternalSubset elementName)
      (.append fInternalSubset \space)
      (.append fInternalSubset attributeName)
      (.append fInternalSubset \space)
      (if (.equals type "ENUMERATION")
          (do
            (.append fInternalSubset \()
            (loop [^int i 0]
              (when (< i (alength enumeration))
                (when (> i 0) (.append fInternalSubset \|))
                (.append fInternalSubset (aget enumeration i))
                (recur (unchecked-inc-int i))))
            (.append fInternalSubset \)))
          (.append fInternalSubset type))
      (when (some? defaultType)
        (.append fInternalSubset \space)
        (.append fInternalSubset defaultType))
      (when (some? defaultValue)
        (.append fInternalSubset " '")
        (loop [^int i 0]
          (when (< i (.-length defaultValue))
            (let [c (aget (.-ch defaultValue) (unchecked-add-int (.-offset defaultValue) i))]
              (if (== c \')
                  (do (.append fInternalSubset "&apos;") (recur (unchecked-inc-int i)))
                  (do (.append fInternalSubset c) (recur (unchecked-inc-int i)))))))
        (.append fInternalSubset \'))
      (.append fInternalSubset ">\n"))
    (cond
      (some? fDeferredDocumentImpl)
        (when (some? defaultValue)
          (let [^:mutable elementDefIndex (.lookupElementDefinition
                                            fDeferredDocumentImpl
                                            elementName)]
            (when (== elementDefIndex -1)
              (set! elementDefIndex
                    (.createDeferredElementDefinition fDeferredDocumentImpl elementName))
              (.appendChild fDeferredDocumentImpl fDocumentTypeIndex elementDefIndex))
            (let [nsEnabled fNamespaceAware
                  ^:mutable ^String namespaceURI nil]
              (when nsEnabled
                (cond
                  (or (.startsWith attributeName "xmlns:") (.equals attributeName "xmlns"))
                    (set! namespaceURI NamespaceContext/XMLNS_URI)
                  (.startsWith attributeName "xml:") (set! namespaceURI NamespaceContext/XML_URI)))
              (let [attrIndex (.createDeferredAttribute
                                fDeferredDocumentImpl
                                attributeName
                                namespaceURI
                                (.toString defaultValue)
                                false)]
                (when (.equals "ID" type) (.setIdAttribute fDeferredDocumentImpl attrIndex))
                (.appendChild fDeferredDocumentImpl elementDefIndex attrIndex)))))
      (some? fDocumentImpl)
        (when (some? defaultValue)
          (let [elements (.getElements (cast DocumentTypeImpl fDocumentType))
                ^:mutable elementDef (cast ElementDefinitionImpl
                                           (.getNamedItem elements elementName))]
            (when (nil? elementDef)
              (set! elementDef (.createElementDefinition fDocumentImpl elementName))
              (.setNamedItem (.getElements (cast DocumentTypeImpl fDocumentType)) elementDef))
            (let [nsEnabled fNamespaceAware
                  ^:mutable ^AttrImpl attr nil]
              (if nsEnabled
                  (let [^:mutable ^String namespaceURI nil]
                    (cond
                      (or (.startsWith attributeName "xmlns:") (.equals attributeName "xmlns"))
                        (set! namespaceURI NamespaceContext/XMLNS_URI)
                      (.startsWith attributeName "xml:")
                        (set! namespaceURI NamespaceContext/XML_URI))
                    (set! attr
                          (cast AttrImpl
                                (.createAttributeNS fDocumentImpl namespaceURI attributeName))))
                  (set! attr (cast AttrImpl (.createAttribute fDocumentImpl attributeName))))
              (.setValue attr (.toString defaultValue))
              (.setSpecified attr false)
              (.setIdAttribute attr (.equals "ID" type))
              (if nsEnabled
                  (.setNamedItemNS (.getAttributes elementDef) attr)
                  (.setNamedItem (.getAttributes elementDef) attr)))))))

  (method ^:public startAttlist :throws [XNIException] ^void [this ^String elementName
                                                              ^Augmentations augs])

  (method ^:public endAttlist :throws [XNIException] ^void [this ^Augmentations augs])

  (method ^:protected createElementNode ^Element [this ^QName element]
    (let [^:mutable ^Element el nil]
      (if fNamespaceAware
          (if (some? fDocumentImpl)
              (set! el
                    (.createElementNS fDocumentImpl
                                      (.-uri element)
                                      (.-rawname element)
                                      (.-localpart element)))
              (set! el (.createElementNS fDocument (.-uri element) (.-rawname element))))
          (set! el (.createElement fDocument (.-rawname element))))
      el))

  (method ^:protected createAttrNode ^Attr [this ^QName attrQName]
    (let [^:mutable ^Attr attr nil]
      (if fNamespaceAware
          (if (some? fDocumentImpl)
              (set! attr
                    (.createAttributeNS fDocumentImpl
                                        (.-uri attrQName)
                                        (.-rawname attrQName)
                                        (.-localpart attrQName)))
              (set! attr (.createAttributeNS fDocument (.-uri attrQName) (.-rawname attrQName))))
          (set! attr (.createAttribute fDocument (.-rawname attrQName))))
      attr))

  (method ^:protected setCharacterData ^void [this ^boolean sawChars]
    (set! fFirstChunk sawChars)
    (let [child (.getLastChild fCurrentNode)]
      (when (some? child)
        (when (> (.length fStringBuilder) 0)
          (when (== (.getNodeType child) Node/TEXT_NODE)
            (if (some? fDocumentImpl)
                (.replaceData (cast TextImpl child) (.toString fStringBuilder))
                (.setData (cast Text child) (.toString fStringBuilder))))
          (.setLength fStringBuilder 0))
        (when (and (some? fDOMFilter) (not fInEntityRef))
          (when (and (== (.getNodeType child) Node/TEXT_NODE)
                     (not (== (bit-and-int (.getWhatToShow fDOMFilter) NodeFilter/SHOW_TEXT) 0)))
            (let [code (.acceptNode fDOMFilter child)]
              (switch code
                LSParserFilter/FILTER_INTERRUPT (throw Abort/INSTANCE)
                LSParserFilter/FILTER_REJECT (.removeChild fCurrentNode child)
                LSParserFilter/FILTER_SKIP (.removeChild fCurrentNode child)
                nil)))))))

  (method ^:public abort ^void [this] (throw Abort/INSTANCE)))

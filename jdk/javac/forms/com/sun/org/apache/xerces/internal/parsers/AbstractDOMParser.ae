  (method ^:protected ^:final handleBaseURI ^void [this ^Node node]
    (when (some? fDocumentImpl)
      (let [^:mutable ^String baseURI nil
            nodeType (.getNodeType node)]
        (if (== nodeType Node/ELEMENT_NODE)
            (do
              (cond
                fNamespaceAware
                  (when (some? (.getAttributeNodeNS
                                 (cast Element node)
                                 "http://www.w3.org/XML/1998/namespace"
                                 "base"))
                    (return))
                (some? (.getAttributeNode (cast Element node) "xml:base")) (return))
              (set! baseURI (.getBaseURI (cast EntityReferenceImpl fCurrentNode)))
              (when (and (some? baseURI) (not (.equals baseURI (.getDocumentURI fDocumentImpl))))
                (if fNamespaceAware
                    (.setAttributeNS (cast Element node)
                                     "http://www.w3.org/XML/1998/namespace"
                                     "xml:base"
                                     baseURI)
                    (.setAttribute (cast Element node) "xml:base" baseURI))))
            (when (== nodeType Node/PROCESSING_INSTRUCTION_NODE)
              (set! baseURI (.getBaseURI (cast EntityReferenceImpl fCurrentNode)))
              (when (and (some? baseURI) (some? fErrorHandler))
                (let [error (DOMErrorImpl.)]
                  (set! (.-fType error) "pi-base-uri-not-preserved")
                  (set! (.-fRelatedData error) baseURI)
                  (set! (.-fSeverity error) DOMError/SEVERITY_WARNING)
                  (.handleError (.getErrorHandler fErrorHandler) error))))))))

  (method ^:protected ^:final handleBaseURI ^void [this ^int node]
    (let [nodeType (.getNodeType fDeferredDocumentImpl node false)]
      (cond
        (== nodeType Node/ELEMENT_NODE)
          (let [^:mutable baseURI (.getNodeValueString
                                    fDeferredDocumentImpl
                                    fCurrentNodeIndex
                                    false)]
            (when (nil? baseURI)
              (set! baseURI (.getDeferredEntityBaseURI fDeferredDocumentImpl fDeferredEntityDecl)))
            (when (and (some? baseURI)
                       (not (.equals baseURI (.getDocumentURI fDeferredDocumentImpl))))
              (.setDeferredAttribute fDeferredDocumentImpl
                                     node
                                     "xml:base"
                                     "http://www.w3.org/XML/1998/namespace"
                                     baseURI
                                     true
                                     false
                                     nil)))
        (== nodeType Node/PROCESSING_INSTRUCTION_NODE)
          (let [^:mutable baseURI (.getNodeValueString
                                    fDeferredDocumentImpl
                                    fCurrentNodeIndex
                                    false)]
            (when (nil? baseURI)
              (set! baseURI (.getDeferredEntityBaseURI fDeferredDocumentImpl fDeferredEntityDecl)))
            (when (and (some? baseURI) (some? fErrorHandler))
              (let [error (DOMErrorImpl.)]
                (set! (.-fType error) "pi-base-uri-not-preserved")
                (set! (.-fRelatedData error) baseURI)
                (set! (.-fSeverity error) DOMError/SEVERITY_WARNING)
                (.handleError (.getErrorHandler fErrorHandler) error)))))))

  (method ^:public startDTD :throws [XNIException] ^void [this ^XMLLocator locator
                                                          ^Augmentations augs]
    (when DEBUG_EVENTS
      (.println System/out "==>startDTD")
      (when DEBUG_BASEURI
        (.println System/out (java-str "   expandedSystemId: " (.getExpandedSystemId locator)))
        (.println System/out (java-str "   baseURI:" (.getBaseSystemId locator)))))
    (set! fInDTD true)
    (when (some? locator) (.push fBaseURIStack (.getBaseSystemId locator)))
    (when (or fDeferNodeExpansion (some? fDocumentImpl))
      (set! fInternalSubset (StringBuilder. 1024))))

  (method ^:public endDTD :throws [XNIException] ^void [this ^Augmentations augs]
    (when DEBUG_EVENTS (.println System/out "==>endDTD()"))
    (set! fInDTD false)
    (when-not (.isEmpty fBaseURIStack) (.pop fBaseURIStack))
    (let [^String internalSubset (when (and (some? fInternalSubset) (> (.length fInternalSubset) 0))
                                   (.toString fInternalSubset))]
      (cond
        fDeferNodeExpansion
          (when (some? internalSubset)
            (.setInternalSubset fDeferredDocumentImpl fDocumentTypeIndex internalSubset))
        (some? fDocumentImpl)
          (when (some? internalSubset)
            (.setInternalSubset (cast DocumentTypeImpl fDocumentType) internalSubset)))))


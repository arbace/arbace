                (if (nil? namespaceURI)
                    (identical? namespace namespaceURI)
                    (.equals namespaceURI namespace))
                (do
                  (when (.hasAttributes this)
                    (let [elem (cast ElementImpl this)
                          attr (cast NodeImpl
                                     (.getAttributeNodeNS
                                       elem
                                       "http://www.w3.org/2000/xmlns/"
                                       "xmlns"))]
                      (when (some? attr)
                        (let [value (.getNodeValue attr)]
                          (when (nil? namespaceURI) (return (identical? namespace value)))
                          (return (.equals namespaceURI value))))))
                  (let [ancestor (cast NodeImpl (.getElementAncestor this this))]
                    (if (some? ancestor) (.isDefaultNamespace ancestor namespaceURI) false)))))
        Node/DOCUMENT_NODE
          (let [docElement (.getDocumentElement (cast Document this))]
            (if (some? docElement) (.isDefaultNamespace docElement namespaceURI) false))
        (Node/ENTITY_NODE Node/NOTATION_NODE Node/DOCUMENT_FRAGMENT_NODE Node/DOCUMENT_TYPE_NODE)
          false
        Node/ATTRIBUTE_NODE
          (if (== (.getNodeType (.-ownerNode this)) Node/ELEMENT_NODE)
              (.isDefaultNamespace ownerNode namespaceURI)
              false)
        (let [ancestor (cast NodeImpl (.getElementAncestor this this))]
          (if (some? ancestor) (.isDefaultNamespace ancestor namespaceURI) false)))))


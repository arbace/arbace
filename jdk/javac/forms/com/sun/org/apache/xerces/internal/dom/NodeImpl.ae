                                (return (when (> (.length value) 0) value))
                              (and (and (some? attrPrefix) (.equals attrPrefix "xmlns"))
                                   (.equals (.getLocalName attr) specifiedPrefix))
                                (return (when (> (.length value) 0) value))
                              :else (recur (unchecked-inc-int i))))
                          (recur (unchecked-inc-int i))))))))
            (let [ancestor (cast NodeImpl (.getElementAncestor this this))]
              (when (some? ancestor) (.lookupNamespaceURI ancestor specifiedPrefix))))
        Node/DOCUMENT_NODE
          (let [docElement (.getDocumentElement (cast Document this))]
            (when (some? docElement) (.lookupNamespaceURI docElement specifiedPrefix)))
        (Node/ENTITY_NODE Node/NOTATION_NODE Node/DOCUMENT_FRAGMENT_NODE Node/DOCUMENT_TYPE_NODE)
          nil
        Node/ATTRIBUTE_NODE
          (when (== (.getNodeType (.-ownerNode this)) Node/ELEMENT_NODE)
            (.lookupNamespaceURI ownerNode specifiedPrefix))
        (let [ancestor (cast NodeImpl (.getElementAncestor this this))]
          (when (some? ancestor) (.lookupNamespaceURI ancestor specifiedPrefix))))))

  (method getElementAncestor ^Node [this ^Node currentNode]
    (let [^:mutable parent (.getParentNode currentNode)]
      (while (some? parent)
        (let [type (.getNodeType parent)]
          (when (== type Node/ELEMENT_NODE) (return parent))
          (set! parent (.getParentNode parent))))
      nil))

  (method lookupNamespacePrefix ^String [this ^String namespaceURI ^ElementImpl el]
    (let [^:mutable namespace (.getNamespaceURI this)
          prefix (.getPrefix this)]
      (when (and (some? namespace) (.equals namespace namespaceURI))
        (when (some? prefix)
          (let [foundNamespace (.lookupNamespaceURI el prefix)]
            (when (and (some? foundNamespace) (.equals foundNamespace namespaceURI))
              (return prefix)))))
      (when (.hasAttributes this)
        (let [map (.getAttributes this)
              length (.getLength map)]
          (loop [^int i 0]
            (when (< i length)
              (let [attr (.item map i)]
                (set! namespace (.getNamespaceURI attr))
                (if (and (some? namespace) (.equals namespace "http://www.w3.org/2000/xmlns/"))
                    (let [attrPrefix (.getPrefix attr)
                          value (.getNodeValue attr)]
                      (if (or (.equals (.getNodeName attr) "xmlns")
                              (and (and (some? attrPrefix) (.equals attrPrefix "xmlns"))
                                   (.equals value namespaceURI)))
                          (let [localname (.getLocalName attr)
                                foundNamespace (.lookupNamespaceURI el localname)]
                            (if (and (some? foundNamespace) (.equals foundNamespace namespaceURI))
                                (return localname)
                                (recur (unchecked-inc-int i))))
                          (recur (unchecked-inc-int i))))
                    (recur (unchecked-inc-int i))))))))
      (let [ancestor (cast NodeImpl (.getElementAncestor this this))]
        (when (some? ancestor) (.lookupNamespacePrefix ancestor namespaceURI el)))))

  (method ^:public isEqualNode ^boolean [this ^Node arg]
    (cond
      (identical? arg this) true
      (not (== (.getNodeType arg) (.getNodeType this))) false
      :else
        (do
          (if (nil? (.getNodeName this))
              (when (some? (.getNodeName arg)) (return false))
              (when-not (.equals (.getNodeName this) (.getNodeName arg)) (return false)))
          (if (nil? (.getLocalName this))
              (when (some? (.getLocalName arg)) (return false))
              (when-not (.equals (.getLocalName this) (.getLocalName arg)) (return false)))
          (if (nil? (.getNamespaceURI this))
              (when (some? (.getNamespaceURI arg)) (return false))
              (when-not (.equals (.getNamespaceURI this) (.getNamespaceURI arg)) (return false)))
          (if (nil? (.getPrefix this))
              (when (some? (.getPrefix arg)) (return false))
              (when-not (.equals (.getPrefix this) (.getPrefix arg)) (return false)))
          (if (nil? (.getNodeValue this))
              (when (some? (.getNodeValue arg)) (return false))
              (when-not (.equals (.getNodeValue this) (.getNodeValue arg)) (return false)))
          true)))

  (method ^:public getFeature [this ^String feature ^String version]
    (when (.isSupported this feature version) ^Object this))

  (method ^:public setUserData [this ^String key data ^UserDataHandler handler]
    (.setUserData (.ownerDocument this) this key data handler))

  (method ^:public getUserData [this ^String key]
    (.getUserData (.ownerDocument this) this key))

  (method ^:protected getUserDataRecord ^{:tag (Map String ParentNode$UserDataRecord)} [this]
    (.getUserDataRecord (.ownerDocument this) this))

  (method ^:public setReadOnly ^void [this ^boolean readOnly ^boolean deep]
    (when (.needsSyncData this) (.synchronizeData this))
    (.isReadOnly this readOnly))

  (method ^:public getReadOnly ^boolean [this]
    (when (.needsSyncData this) (.synchronizeData this))
    (.isReadOnly this))

  (method ^:public setUserData ^void [this data]
    (.setUserData (.ownerDocument this) this data))

  (method ^:public getUserData [this]
    (.getUserData (.ownerDocument this) this))

  (method ^:protected changed ^void [this]
    (.changed (.ownerDocument this)))

  (method ^:protected changes ^int [this]
    (.changes (.ownerDocument this)))

  (method ^:protected synchronizeData ^void [this]
    (.needsSyncData this false))

  (method ^:protected getContainer ^Node [this] nil)

  (method ^:final isReadOnly ^boolean [this]
    (not (== (bit-and-int flags READONLY) 0)))

  (method ^:final isReadOnly ^void [this ^boolean value]
    (set! flags
          (unchecked-short
            (if value (bit-or-int flags READONLY) (bit-and-int flags (bit-not-int READONLY))))))

  (method ^:final needsSyncData ^boolean [this]
    (not (== (bit-and-int flags SYNCDATA) 0)))

  (method ^:final needsSyncData ^void [this ^boolean value]
    (set! flags
          (unchecked-short
            (if value (bit-or-int flags SYNCDATA) (bit-and-int flags (bit-not-int SYNCDATA))))))

  (method ^:final needsSyncChildren ^boolean [this]
    (not (== (bit-and-int flags SYNCCHILDREN) 0)))

  (method ^:public ^:final needsSyncChildren ^void [this ^boolean value]
    (set! flags
          (unchecked-short
            (if value
                (bit-or-int flags SYNCCHILDREN)
                (bit-and-int flags (bit-not-int SYNCCHILDREN))))))

  (method ^:final isOwned ^boolean [this]
    (not (== (bit-and-int flags OWNED) 0)))

  (method ^:final isOwned ^void [this ^boolean value]
    (set! flags
          (unchecked-short
            (if value (bit-or-int flags OWNED) (bit-and-int flags (bit-not-int OWNED))))))

  (method ^:final isFirstChild ^boolean [this]
    (not (== (bit-and-int flags FIRSTCHILD) 0)))

  (method ^:final isFirstChild ^void [this ^boolean value]
    (set! flags
          (unchecked-short
            (if value (bit-or-int flags FIRSTCHILD) (bit-and-int flags (bit-not-int FIRSTCHILD))))))

  (method ^:final isSpecified ^boolean [this]
    (not (== (bit-and-int flags SPECIFIED) 0)))

  (method ^:final isSpecified ^void [this ^boolean value]
    (set! flags
          (unchecked-short
            (if value (bit-or-int flags SPECIFIED) (bit-and-int flags (bit-not-int SPECIFIED))))))

  (method ^:final internalIsIgnorableWhitespace ^boolean [this]
    (not (== (bit-and-int flags IGNORABLEWS) 0)))

  (method ^:final isIgnorableWhitespace ^void [this ^boolean value]
    (set!
      flags
      (unchecked-short
        (if value (bit-or-int flags IGNORABLEWS) (bit-and-int flags (bit-not-int IGNORABLEWS))))))

  (method ^:final hasStringValue ^boolean [this]
    (not (== (bit-and-int flags HASSTRING) 0)))

  (method ^:final hasStringValue ^void [this ^boolean value]
    (set! flags
          (unchecked-short
            (if value (bit-or-int flags HASSTRING) (bit-and-int flags (bit-not-int HASSTRING))))))

  (method ^:final isNormalized ^boolean [this]
    (not (== (bit-and-int flags NORMALIZED) 0)))

  (method ^:final isNormalized ^void [this ^boolean value]
    (when (and (and (not value) (.isNormalized this)) (some? ownerNode))
      (.isNormalized ownerNode false))
    (set! flags
          (unchecked-short
            (if value (bit-or-int flags NORMALIZED) (bit-and-int flags (bit-not-int NORMALIZED))))))

  (method ^:final isIdAttribute ^boolean [this]
    (not (== (bit-and-int flags ID) 0)))

  (method ^:final isIdAttribute ^void [this ^boolean value]
    (set! flags
          (unchecked-short (if value (bit-or-int flags ID) (bit-and-int flags (bit-not-int ID))))))

  (method ^:public toString ^String [this]
    (java-str "[" (.getNodeName this) ": " (.getNodeValue this) "]"))

  (method ^:private writeObject :throws [IOException] ^void [this ^ObjectOutputStream out]
    (when (.needsSyncData this) (.synchronizeData this))
    (.defaultWriteObject out)))

  (defclass ^:protected ^:final XMLAttributesProxy
    :implements [XMLAttributes]

    (field ^:protected ^AttributeMap fAttributes)

    (field ^:protected ^CoreDocumentImpl fDocument)

    (field ^:protected ^ElementImpl fElement)

    (field ^:protected ^{:tag (Vector String)} fDTDTypes (Vector. 5))

    (field ^:protected ^{:tag (Vector Augmentations)} fAugmentations (Vector. 5))

    (method ^:public setAttributes ^void [this ^AttributeMap attributes ^CoreDocumentImpl doc
                                          ^ElementImpl elem]
      (set! fDocument doc)
      (set! fAttributes attributes)
      (set! fElement elem)
      (if (some? attributes)
          (let [length (.getLength attributes)]
            (.setSize fDTDTypes length)
            (.setSize fAugmentations length)
            (loop [^int i 0]
              (when (< i length)
                (.setElementAt fAugmentations (AugmentationsImpl.) i)
                (recur (unchecked-inc-int i)))))
          (do (.setSize fDTDTypes 0) (.setSize fAugmentations 0))))

    (method ^:public addAttribute ^int [this ^QName qname ^String attrType ^String attrValue]
      (let [^:mutable index (.getXercesAttribute fElement (.-uri qname) (.-localpart qname))]
        (when (< index 0)
          (let [attr (cast AttrImpl
                           (.createAttributeNS (cast CoreDocumentImpl (.getOwnerDocument fElement))
                                               (.-uri qname)
                                               (.-rawname qname)
                                               (.-localpart qname)))]
            (.setNodeValue attr attrValue)
            (set! index (.setXercesAttributeNode fElement attr))
            (.insertElementAt fDTDTypes attrType index)
            (.insertElementAt fAugmentations (AugmentationsImpl.) index)
            (.setSpecified attr false)))
        index))

    (method ^:public removeAllAttributes ^void [this])

    (method ^:public removeAttributeAt ^void [this ^int attrIndex])

    (method ^:public getLength ^int [this]
      (if (some? fAttributes) (.getLength fAttributes) 0))

    (method ^:public getIndex ^int [this ^String qName] -1)

    (method ^:public getIndex ^int [this ^String uri ^String localPart] -1)

    (method ^:public setName ^void [this ^int attrIndex ^QName attrName])

    (method ^:public getName ^void [this ^int attrIndex ^QName attrName]
      (when (some? fAttributes)
        (.updateQName DOMNormalizer/this (cast Node (.getItem fAttributes attrIndex)) attrName)))

    (method ^:public getPrefix ^String [this ^int index]
      (when (some? fAttributes)
        (let [node (cast Node (.getItem fAttributes index))
              ^:mutable prefix (.getPrefix node)]
          (set! prefix
                (when (and (some? prefix) (not (== (.length prefix) 0)))
                  (.addSymbol fSymbolTable prefix)))
          prefix)))

    (method ^:public getURI ^String [this ^int index]
      (when (some? fAttributes)
        (let [node (cast Node (.getItem fAttributes index))
              ^:mutable namespace (.getNamespaceURI node)]
          (set! namespace (when (some? namespace) (.addSymbol fSymbolTable namespace)))
          namespace)))

    (method ^:public getLocalName ^String [this ^int index]
      (when (some? fAttributes)
        (let [node (cast Node (.getItem fAttributes index))
              ^:mutable localName (.getLocalName node)]
          (set! localName (when (some? localName) (.addSymbol fSymbolTable localName)))
          localName)))

    (method ^:public getQName ^String [this ^int index]

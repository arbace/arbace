    (method ^:public getType ^String [this ^String qName] "CDATA")

    (method ^:public getType ^String [this ^String uri ^String localName]
      "CDATA")

    (method ^:private getReportableType ^String [this ^String type]
      (if (== (.charAt type 0) \() "NMTOKEN" type))

    (method ^:public setValue ^void [this ^int attrIndex ^String attrValue]
      (when (some? fAttributes)

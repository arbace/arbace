  (method ^:protected ^:final addNamespaceDecl ^void [this ^String prefix ^String uri
                                                      ^ElementImpl element]
    (when DEBUG (.println System/out (java-str "[ns-fixup] addNamespaceDecl [" prefix "]")))
    (if (identical? prefix XMLSymbols/EMPTY_STRING)
        (do
          (when DEBUG (.println System/out (java-str "=>add xmlns=\"" uri "\" declaration")))
          (.setAttributeNS element NamespaceContext/XMLNS_URI XMLSymbols/PREFIX_XMLNS uri))
        (do
          (when DEBUG
            (.println System/out (java-str "=>add xmlns:" prefix "=\"" uri "\" declaration")))

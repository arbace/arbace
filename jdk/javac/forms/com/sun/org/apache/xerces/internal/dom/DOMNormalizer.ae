        (let [node (cast Node (.getItem fAttributes index))
              rawname (.addSymbol fSymbolTable (.getNodeName node))]
          rawname)))

    (method ^:public getQualifiedName ^QName [this ^int index] nil)

    (method ^:public setType ^void [this ^int attrIndex ^String attrType]

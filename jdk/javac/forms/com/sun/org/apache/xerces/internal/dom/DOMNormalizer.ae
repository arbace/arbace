  (method ^:public ^:static ^:final reportDOMError ^void [^DOMErrorHandler errorHandler
                                                          ^DOMErrorImpl error
                                                          ^DOMLocatorImpl locator ^String message
                                                          ^short severity ^String type]
    (when (some? errorHandler)
      (.reset error)
      (set! (.-fMessage error) message)
      (set! (.-fSeverity error) severity)
      (set! (.-fLocator error) locator)
      (set! (.-fType error) type)
      (set! (.-fRelatedData error) (.-fRelatedNode locator))
      (when-not (.handleError errorHandler error) (throw (AbortException.))))
    (when (== severity DOMError/SEVERITY_FATAL_ERROR) (throw (AbortException.))))

  (method ^:protected ^:final updateQName ^void [this ^Node node ^QName qname]
    (let [prefix (.getPrefix node)
          namespace (.getNamespaceURI node)
          localName (.getLocalName node)]
      (set! (.-prefix qname)
            (when (and (some? prefix) (not (== (.length prefix) 0)))
              (.addSymbol fSymbolTable prefix)))
      (set! (.-localpart qname) (when (some? localName) (.addSymbol fSymbolTable localName)))
      (set! (.-rawname qname) (.addSymbol fSymbolTable (.getNodeName node)))
      (set! (.-uri qname) (when (some? namespace) (.addSymbol fSymbolTable namespace)))))

  (method ^:final normalizeAttributeValue ^String [this ^:mutable ^String value ^Attr attr]

  (method ^:public startDocument :throws [XNIException] ^void [this ^XMLLocator locator
                                                               ^String encoding
                                                               ^NamespaceContext namespaceContext
                                                               ^Augmentations augs])

  (method ^:public xmlDecl :throws [XNIException] ^void [this ^String version ^String encoding
                                                         ^String standalone ^Augmentations augs])

  (method ^:public doctypeDecl :throws [XNIException] ^void [this ^String rootElement
                                                             ^String publicId ^String systemId
                                                             ^Augmentations augs])

  (method ^:public comment :throws [XNIException] ^void [this ^XMLString text ^Augmentations augs])

  (method ^:public processingInstruction :throws [XNIException] ^void [this ^String target
                                                                       ^XMLString data
                                                                       ^Augmentations augs])

  (method ^:public startElement :throws [XNIException] ^void [this ^QName element
                                                              ^XMLAttributes attributes
                                                              ^Augmentations augs]
    (let [currentElement (cast Element fCurrentNode)
          attrCount (.getLength attributes)]
      (when DEBUG_EVENTS
        (.println System/out (java-str "==>startElement: " element " attrs.length=" attrCount)))
      (loop [^int i 0]
        (when (< i attrCount)
          (.getName attributes i fAttrQName)
          (let [^:mutable ^Attr attr nil]
            (set! attr
                  (.getAttributeNodeNS currentElement (.-uri fAttrQName) (.-localpart fAttrQName)))
            (when (nil? attr) (set! attr (.getAttributeNode currentElement (.-rawname fAttrQName))))
            (let [attrPSVI (cast AttributePSVI
                                 (.getItem (.getAugmentations attributes i)
                                           Constants/ATTRIBUTE_PSVI))]
              (if (some? attrPSVI)
                  (let [^:mutable ^XSTypeDefinition decl (.getMemberTypeDefinition attrPSVI)
                        ^:mutable id false]
                    (if (some? decl)
                        (set! id (.isIDType (cast XSSimpleType decl)))
                        (do
                          (set! decl (.getTypeDefinition attrPSVI))
                          (when (some? decl) (set! id (.isIDType (cast XSSimpleType decl))))))
                    (when id (.setIdAttributeNode (cast ElementImpl currentElement) attr true))
                    (when fPSVI (.setPSVI (cast PSVIAttrNSImpl attr) attrPSVI))
                    (.setType (cast AttrImpl attr) decl)
                    (if (not (== (bit-and-int (.-features fConfiguration)
                                              DOMConfigurationImpl/DTNORMALIZATION)
                                 0))
                        (let [^:final normalizedValue (.getNormalizedValue
                                                        (.getSchemaValue attrPSVI))]
                          (if (some? normalizedValue)
                              (let [specified (.getSpecified attr)]
                                (.setValue attr normalizedValue)
                                (if (not specified)
                                    (do
                                      (.setSpecified (cast AttrImpl attr) specified)
                                      (recur (unchecked-inc-int i)))
                                    (recur (unchecked-inc-int i))))
                              (recur (unchecked-inc-int i))))
                        (recur (unchecked-inc-int i))))
                  (let [^:mutable ^String type nil
                        isDeclared (.equals Boolean/TRUE
                                            (.getItem
                                              (.getAugmentations attributes i)
                                              Constants/ATTRIBUTE_DECLARED))]
                    (when isDeclared
                      (set! type (.getType attributes i))
                      (when (.equals "ID" type)
                        (.setIdAttributeNode (cast ElementImpl currentElement) attr true)))
                    (.setType (cast AttrImpl attr) type)
                    (recur (unchecked-inc-int i))))))))))

  (method ^:public emptyElement :throws [XNIException] ^void [this ^QName element
                                                              ^XMLAttributes attributes
                                                              ^Augmentations augs]
    (when DEBUG_EVENTS (.println System/out (java-str "==>emptyElement: " element)))
    (.startElement this element attributes augs)
    (.endElement this element augs))

  (method ^:public startGeneralEntity :throws [XNIException] ^void [this ^String name
                                                                    ^XMLResourceIdentifier identifier
                                                                    ^String encoding
                                                                    ^Augmentations augs])

  (method ^:public textDecl :throws [XNIException] ^void [this ^String version ^String encoding
                                                          ^Augmentations augs])

  (method ^:public endGeneralEntity :throws [XNIException] ^void [this ^String name
                                                                  ^Augmentations augs])

  (method ^:public characters :throws [XNIException] ^void [this ^XMLString text ^Augmentations augs])

  (method ^:public ignorableWhitespace :throws [XNIException] ^void [this ^XMLString text
                                                                     ^Augmentations augs]
    (set! fAllWhitespace true))

  (method ^:public endElement :throws [XNIException] ^void [this ^QName element ^Augmentations augs]
    (when DEBUG_EVENTS (.println System/out (java-str "==>endElement: " element)))
    (when (some? augs)
      (let [elementPSVI (cast ElementPSVI (.getItem augs Constants/ELEMENT_PSVI))]
        (when (some? elementPSVI)
          (let [elementNode (cast ElementImpl fCurrentNode)]
            (when fPSVI (.setPSVI (cast PSVIElementNSImpl fCurrentNode) elementPSVI))
            (when (instance? ElementNSImpl elementNode)
              (let [^:mutable ^XSTypeDefinition type (.getMemberTypeDefinition elementPSVI)]
                (when (nil? type) (set! type (.getTypeDefinition elementPSVI)))
                (.setType (cast ElementNSImpl elementNode) type)))
            (let [normalizedValue (.getNormalizedValue (.getSchemaValue elementPSVI))]
              (if (not (== (bit-and-int (.-features fConfiguration)
                                        DOMConfigurationImpl/DTNORMALIZATION)
                           0))
                  (when (some? normalizedValue) (.setTextContent elementNode normalizedValue))
                  (let [text (.getTextContent elementNode)]
                    (when (== (.length text) 0)
                      (when (some? normalizedValue) (.setTextContent elementNode normalizedValue)))))
              (return))))))
    (when (instance? ElementNSImpl fCurrentNode) (.setType (cast ElementNSImpl fCurrentNode) nil)))

  (method ^:public startCDATA :throws [XNIException] ^void [this ^Augmentations augs])

  (method ^:public endCDATA :throws [XNIException] ^void [this ^Augmentations augs])

  (method ^:public endDocument :throws [XNIException] ^void [this ^Augmentations augs])

  (method ^:public setDocumentSource ^void [this ^XMLDocumentSource source])

  (method ^:public getDocumentSource ^XMLDocumentSource [this] nil))

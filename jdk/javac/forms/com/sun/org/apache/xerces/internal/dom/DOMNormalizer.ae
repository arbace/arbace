  (method ^:private processDTD ^void [this ^String xmlVersion ^String schemaLocation]
    (let [^:mutable ^String rootName nil
          ^:mutable ^String publicId nil
          ^:mutable systemId schemaLocation
          baseSystemId (.getDocumentURI fDocument)
          ^:mutable ^String internalSubset nil
          docType (.getDoctype fDocument)]
      (if (some? docType)
          (do
            (set! rootName (.getName docType))
            (set! publicId (.getPublicId docType))
            (when (or (nil? systemId) (== (.length systemId) 0))
              (set! systemId (.getSystemId docType)))
            (set! internalSubset (.getInternalSubset docType)))
          (let [elem (.getDocumentElement fDocument)]
            (when (nil? elem) (return))
            (set! rootName (.getNodeName elem))
            (when (or (nil? systemId) (== (.length systemId) 0)) (return))))
      (let [^:mutable ^XMLDTDLoader loader nil]
        (try
          (.doctypeDecl fValidationHandler rootName publicId systemId nil)
          (set! loader (.getDTDLoader CoreDOMImplementationImpl/singleton xmlVersion))
          (.setFeature loader DOMConfigurationImpl/XERCES_VALIDATION true)
          (.setEntityResolver loader (.getEntityResolver fConfiguration))
          (.setErrorHandler loader (.getErrorHandler fConfiguration))
          (.loadGrammarWithContext loader
                                   (cast XMLDTDValidator fValidationHandler)
                                   rootName
                                   publicId
                                   systemId
                                   baseSystemId
                                   internalSubset)
          (catch IOException e)
          (finally
            (when (some? loader)
              (.releaseDTDLoader CoreDOMImplementationImpl/singleton xmlVersion loader)))))))

  (method ^:protected ^:final expandEntityRef ^void [this ^Node parent ^Node reference]
    (let [^:mutable ^Node kid nil
          ^:mutable ^Node next nil]
      (set! kid (.getFirstChild reference))
      (while (some? kid)
        (set! next (.getNextSibling kid))
        (.insertBefore parent kid reference)
        (set! kid next))))

  (method ^:protected ^:final namespaceFixUp ^void [this ^ElementImpl element
                                                    ^AttributeMap attributes]
    (when DEBUG
      (.println System/out
                (java-str "[ns-fixup] element:"
                          (.getNodeName element)
                          " uri: "
                          (.getNamespaceURI element))))
    (let [^:mutable ^String value nil
          ^:mutable ^String uri nil
          ^:mutable ^String prefix nil]
      (when (some? attributes)
        (loop [^int k 0]
          (when (< k (.getLength attributes))
            (let [attr (cast Attr (.getItem attributes k))]
              (set! uri (.getNamespaceURI attr))
              (if (and (some? uri) (.equals uri NamespaceContext/XMLNS_URI))
                  (do
                    (set! value (.getNodeValue attr))
                    (when (nil? value) (set! value XMLSymbols/EMPTY_STRING))
                    (if (and (.-errorChecking fDocument) (.equals value NamespaceContext/XMLNS_URI))
                        (do
                          (set! (.-fRelatedNode fLocator) attr)
                          (let [msg (DOMMessageFormatter/formatMessage
                                      DOMMessageFormatter/XML_DOMAIN
                                      "CantBindXMLNS"
                                      nil)]
                            (DOMNormalizer/reportDOMError
                              fErrorHandler
                              fError
                              fLocator
                              msg
                              DOMError/SEVERITY_ERROR
                              "CantBindXMLNS")
                            (recur (unchecked-inc-int k))))
                        (do
                          (set! prefix (.getPrefix attr))
                          (set! prefix
                                (if (or (nil? prefix) (== (.length prefix) 0))
                                    XMLSymbols/EMPTY_STRING
                                    (.addSymbol fSymbolTable prefix)))
                          (let [localpart (.addSymbol fSymbolTable (.getLocalName attr))]
                            (if (identical? prefix XMLSymbols/PREFIX_XMLNS)
                                (do
                                  (set! value (.addSymbol fSymbolTable value))
                                  (when-not (== (.length value) 0)
                                    (.declarePrefix fNamespaceContext localpart value))
                                  (recur (unchecked-inc-int k)))
                                (do
                                  (set! value (.addSymbol fSymbolTable value))
                                  (.declarePrefix
                                    fNamespaceContext
                                    XMLSymbols/EMPTY_STRING
                                    ^String (when-not (== (.length value) 0) value))
                                  (recur (unchecked-inc-int k))))))))
                  (recur (unchecked-inc-int k)))))))
      (set! uri (.getNamespaceURI element))
      (set! prefix (.getPrefix element))
      (cond
        (some? uri)
          (do
            (set! uri (.addSymbol fSymbolTable uri))
            (set! prefix
                  (if (or (nil? prefix) (== (.length prefix) 0))
                      XMLSymbols/EMPTY_STRING
                      (.addSymbol fSymbolTable prefix)))
            (when-not (identical? (.getURI fNamespaceContext prefix) uri)
              (.addNamespaceDecl this prefix uri element)
              (.declarePrefix fLocalNSBinder prefix uri)
              (.declarePrefix fNamespaceContext prefix uri)))
        (nil? (.getLocalName element))
          (if fNamespaceValidation
              (let [msg (DOMMessageFormatter/formatMessage
                          DOMMessageFormatter/DOM_DOMAIN
                          "NullLocalElementName"
                          (new Object/1 [(.getNodeName element)]))]
                (DOMNormalizer/reportDOMError fErrorHandler
                                              fError
                                              fLocator
                                              msg
                                              DOMError/SEVERITY_FATAL_ERROR
                                              "NullLocalElementName"))
              (let [msg (DOMMessageFormatter/formatMessage
                          DOMMessageFormatter/DOM_DOMAIN
                          "NullLocalElementName"
                          (new Object/1 [(.getNodeName element)]))]
                (DOMNormalizer/reportDOMError fErrorHandler
                                              fError
                                              fLocator
                                              msg
                                              DOMError/SEVERITY_ERROR
                                              "NullLocalElementName")))
        :else

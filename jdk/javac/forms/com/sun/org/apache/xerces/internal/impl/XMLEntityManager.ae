               (or (or (nil? host) (== (.length host) 0)) (.equals host "localhost")))
          (let [file (File. (XMLEntityManager/getPathWithoutEscapes (.getPath url)))]
            (when-not (.exists file)
              (let [parent (.getParentFile file)]
                (when (and (some? parent) (not (.exists parent))) (.mkdirs parent))))
            (set! out (FileOutputStream. file)))
          (let [urlCon (.openConnection url)]
            (.setDoInput urlCon false)
            (.setDoOutput urlCon true)
            (.setUseCaches urlCon false)

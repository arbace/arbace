                          (set! base
                                (URI. "file" "" (XMLEntityManager/fixURI baseSystemId) nil nil))
                          (let [^:mutable dir (.toString (XMLEntityManager/getUserDir))]
                            (set! dir (java-str dir (XMLEntityManager/fixURI baseSystemId)))
                            (set! base (URI. "file" "" dir nil nil)))))))
              (set! uri (URI. base id))
              (catch Exception e))
            (if (nil? uri) systemId (.toString uri))))))

  (method ^:public ^:static expandSystemId :throws [URI$MalformedURIException] ^String [^String systemId
                                                                                        ^String baseSystemId
                                                                                        ^boolean strict]
    (when (some? systemId)
      (if strict
          (do
            (try (URI. systemId) (return systemId) (catch URI$MalformedURIException ex))
            (let [^:mutable ^URI base nil]
              (if (or (nil? baseSystemId) (== (.length baseSystemId) 0))
                  (set! base (URI. "file" "" (.toString (XMLEntityManager/getUserDir)) nil nil))
                  (try
                    (set! base (URI. baseSystemId))
                    (catch URI$MalformedURIException e
                      (let [^:mutable dir (.toString (XMLEntityManager/getUserDir))]
                        (set! dir (java-str dir baseSystemId))
                        (set! base (URI. "file" "" dir nil nil))))))
              (let [uri (URI. base systemId)] (.toString uri))))
          (do
            (try
              (return (XMLEntityManager/expandSystemIdStrictOff systemId baseSystemId))
              (catch URI$MalformedURIException e
                (try
                  (return (XMLEntityManager/expandSystemIdStrictOff1 systemId baseSystemId))
                  (catch URISyntaxException ex))))
            (if (== (.length systemId) 0)
                systemId
                (let [id (XMLEntityManager/fixURI systemId)
                      ^:mutable ^URI base nil
                      ^:mutable ^URI uri nil]
                  (try
                    (if (or (or (nil? baseSystemId) (== (.length baseSystemId) 0))
                            (.equals baseSystemId systemId))
                        (set! base (XMLEntityManager/getUserDir))
                        (try
                          (set! base (URI. (.trim (XMLEntityManager/fixURI baseSystemId))))
                          (catch URI$MalformedURIException e
                            (if (not (== (.indexOf baseSystemId \:) -1))
                                (set! base
                                      (URI. "file"
                                            ""
                                            (.trim (XMLEntityManager/fixURI baseSystemId))
                                            nil
                                            nil))
                                (set! base
                                      (URI. (XMLEntityManager/getUserDir)
                                            (XMLEntityManager/fixURI baseSystemId)))))))
                    (set! uri (URI. base (.trim id)))
                    (catch Exception e))
                  (if (nil? uri) systemId (.toString uri))))))))

  (method ^:private ^:static expandSystemIdStrictOn :throws [URI$MalformedURIException] ^String [^String systemId
                                                                                                 ^String baseSystemId]
    (let [systemURI (URI. systemId true)]
      (if (.isAbsoluteURI systemURI)
          systemId
          (let [^:mutable ^URI baseURI nil]
            (if (or (nil? baseSystemId) (== (.length baseSystemId) 0))
                (set! baseURI (XMLEntityManager/getUserDir))
                (do
                  (set! baseURI (URI. baseSystemId true))
                  (when-not (.isAbsoluteURI baseURI)
                    (.absolutize baseURI (XMLEntityManager/getUserDir)))))
            (.absolutize systemURI baseURI)
            (.toString systemURI)))))

  (method ^:private ^:static expandSystemIdStrictOff :throws [URI$MalformedURIException] ^String [^String systemId
                                                                                                  ^String baseSystemId]
    (let [systemURI (URI. systemId true)]
      (when (.isAbsoluteURI systemURI)
        (when (> (.length (.getScheme systemURI)) 1) (return systemId))
        (throw (URI$MalformedURIException.)))
      (let [^:mutable ^URI baseURI nil]
        (if (or (nil? baseSystemId) (== (.length baseSystemId) 0))
            (set! baseURI (XMLEntityManager/getUserDir))
            (do
              (set! baseURI (URI. baseSystemId true))
              (when-not (.isAbsoluteURI baseURI)
                (.absolutize baseURI (XMLEntityManager/getUserDir)))))
        (.absolutize systemURI baseURI)
        (.toString systemURI))))

  (method ^:private ^:static expandSystemIdStrictOff1 :throws [URISyntaxException
                                                               URI$MalformedURIException] ^String [^String systemId
                                                                                                   ^String baseSystemId]
    (let [^:mutable systemURI (java.net.URI. systemId)]
      (when (.isAbsolute systemURI)
        (when (> (.length (.getScheme systemURI)) 1) (return systemId))
        (throw (URISyntaxException. systemId "the scheme's length is only one character")))
      (let [^:mutable ^URI baseURI nil]
        (if (or (nil? baseSystemId) (== (.length baseSystemId) 0))
            (set! baseURI (XMLEntityManager/getUserDir))
            (do
              (set! baseURI (URI. baseSystemId true))
              (when-not (.isAbsoluteURI baseURI)
                (.absolutize baseURI (XMLEntityManager/getUserDir)))))

      (.getPublicId (.-entityLocation fCurrentEntity))))

  (method ^:public getExpandedSystemId ^String [this]
    (when (some? fCurrentEntity)
      (if (and (some? (.-entityLocation fCurrentEntity))
               (some? (.getExpandedSystemId (.-entityLocation fCurrentEntity))))
          (return (.getExpandedSystemId (.-entityLocation fCurrentEntity)))
          (let [size (.size fEntityStack)]
            (loop [^int i (unchecked-subtract-int size 1)]
              (when (>= i 0)
                (let [externalEntity (cast Entity$ScannedEntity (.get fEntityStack i))]
                  (if (and (some? (.-entityLocation externalEntity))
                           (some? (.getExpandedSystemId (.-entityLocation externalEntity))))
                      (return (.getExpandedSystemId (.-entityLocation externalEntity)))
                      (recur (unchecked-dec-int i)))))))))
    nil)


        (.toString systemURI))))

  (method ^:protected getEncodingInfo ^EncodingInfo [this ^byte/1 b4 ^int count]
    (if (< count 2)
        EncodingInfo/UTF_8
        (let [b0 (bit-and-int (aget b4 0) 0xFF)
              b1 (bit-and-int (aget b4 1) 0xFF)]
          (cond
            (and (== b0 0xFE) (== b1 0xFF)) EncodingInfo/UTF_16_BIG_ENDIAN_WITH_BOM
            (and (== b0 0xFF) (== b1 0xFE)) EncodingInfo/UTF_16_LITTLE_ENDIAN_WITH_BOM
            (< count 3) EncodingInfo/UTF_8
            :else
              (let [b2 (bit-and-int (aget b4 2) 0xFF)]
                (cond
                  (and (and (== b0 0xEF) (== b1 0xBB)) (== b2 0xBF)) EncodingInfo/UTF_8_WITH_BOM
                  (< count 4) EncodingInfo/UTF_8
                  :else
                    (let [b3 (bit-and-int (aget b4 3) 0xFF)]
                      (cond
                        (and (and (and (== b0 0x00) (== b1 0x00)) (== b2 0x00)) (== b3 0x3C))
                          EncodingInfo/UCS_4_BIG_ENDIAN
                        (and (and (and (== b0 0x3C) (== b1 0x00)) (== b2 0x00)) (== b3 0x00))
                          EncodingInfo/UCS_4_LITTLE_ENDIAN
                        (and (and (and (== b0 0x00) (== b1 0x00)) (== b2 0x3C)) (== b3 0x00))
                          EncodingInfo/UCS_4_UNUSUAL_BYTE_ORDER
                        (and (and (and (== b0 0x00) (== b1 0x3C)) (== b2 0x00)) (== b3 0x00))
                          EncodingInfo/UCS_4_UNUSUAL_BYTE_ORDER
                        (and (and (and (== b0 0x00) (== b1 0x3C)) (== b2 0x00)) (== b3 0x3F))
                          EncodingInfo/UTF_16_BIG_ENDIAN
                        (and (and (and (== b0 0x3C) (== b1 0x00)) (== b2 0x3F)) (== b3 0x00))
                          EncodingInfo/UTF_16_LITTLE_ENDIAN
                        (and (and (and (== b0 0x4C) (== b1 0x6F)) (== b2 0xA7)) (== b3 0x94))
                          EncodingInfo/EBCDIC
                        :else EncodingInfo/UTF_8))))))))

  (method ^:protected createReader :throws [IOException] ^Reader [this ^InputStream inputStream
                                                                  ^:mutable ^String encoding
                                                                  ^Boolean isBigEndian]
    (let [^:mutable ^String enc (if (some? encoding) encoding EncodingInfo/STR_UTF8)]
      (set! enc (.toUpperCase enc Locale/ENGLISH))
      (let [f (.getMessageFormatter fErrorReporter XMLMessageFormatter/XML_DOMAIN)
            l (.getLocale fErrorReporter)]
        (switch enc
          EncodingInfo/STR_UTF8 (return (UTF8Reader. inputStream fBufferSize f l))
          EncodingInfo/STR_UTF16
            (when (some? isBigEndian)
              (return (UTF16Reader. inputStream fBufferSize isBigEndian f l)))
          EncodingInfo/STR_UTF16BE (return (UTF16Reader. inputStream fBufferSize true f l))
          EncodingInfo/STR_UTF16LE (return (UTF16Reader. inputStream fBufferSize false f l))
          EncodingInfo/STR_UCS4
            (if (some? isBigEndian)
                (if (.booleanValue isBigEndian)
                    (return (UCSReader. inputStream UCSReader/UCS4BE))
                    (return (UCSReader. inputStream UCSReader/UCS4LE)))
                (.reportError fErrorReporter
                              (.getEntityScanner this)
                              XMLMessageFormatter/XML_DOMAIN
                              "EncodingByteOrderUnsupported"
                              (new Object/1 [encoding])
                              XMLErrorReporter/SEVERITY_FATAL_ERROR))
          EncodingInfo/STR_UCS2
            (if (some? isBigEndian)
                (if (.booleanValue isBigEndian)
                    (return (UCSReader. inputStream UCSReader/UCS2BE))
                    (return (UCSReader. inputStream UCSReader/UCS2LE)))
                (.reportError fErrorReporter
                              (.getEntityScanner this)
                              XMLMessageFormatter/XML_DOMAIN
                              "EncodingByteOrderUnsupported"
                              (new Object/1 [encoding])
                              XMLErrorReporter/SEVERITY_FATAL_ERROR)))
        (let [validIANA (XMLChar/isValidIANAEncoding encoding)
              validJava (XMLChar/isValidJavaEncoding encoding)]
          (when (or (not validIANA) (and fAllowJavaEncodings (not validJava)))
            (.reportError fErrorReporter
                          (.getEntityScanner this)
                          XMLMessageFormatter/XML_DOMAIN
                          "EncodingDeclInvalid"
                          (new Object/1 [encoding])
                          XMLErrorReporter/SEVERITY_FATAL_ERROR)
            (set! encoding "ISO-8859-1"))
          (let [^:mutable javaEncoding (EncodingMap/getIANA2JavaMapping enc)]
            (when (nil? javaEncoding)
              (if fAllowJavaEncodings
                  (set! javaEncoding encoding)
                  (do
                    (.reportError fErrorReporter
                                  (.getEntityScanner this)
                                  XMLMessageFormatter/XML_DOMAIN
                                  "EncodingDeclInvalid"
                                  (new Object/1 [encoding])
                                  XMLErrorReporter/SEVERITY_FATAL_ERROR)
                    (set! javaEncoding "ISO8859_1"))))
            (when DEBUG_ENCODINGS
              (.print System/out
                      (java-str "$$$ creating Java InputStreamReader: encoding=" javaEncoding))
              (when (identical? javaEncoding encoding) (.print System/out " (IANA encoding)"))
              (.println System/out))
            (BufferedReader. (InputStreamReader. inputStream javaEncoding)))))))

  (method ^:public getPublicId ^String [this]

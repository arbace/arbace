  (method ^:public ^:static createOutputStream :throws [IOException] ^OutputStream [^String uri]
    (let [expanded (XMLEntityManager/expandSystemId uri nil true)
          url (URL. ^String (if (some? expanded) expanded uri))
          ^:mutable ^OutputStream out nil
          protocol (.getProtocol url)
          host (.getHost url)]

              result (StringBuilder. (.length origPath))
              size (.countTokens tokenizer)]
          (.append result (.nextToken tokenizer))
          (loop [^int i 1]
            (when (< i size)
              (let [token (.nextToken tokenizer)]
                (.append result
                         (unchecked-char (.intValue (Integer/valueOf (.substring token 0 2) 16))))
                (.append result (.substring token 2))
                (recur (unchecked-inc-int i)))))
          (.toString result))
        origPath))


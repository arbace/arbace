  (method ^:protected ^:static fixURI ^String [^:mutable ^String str]
    (set! str (.replace str File/separatorChar \/))
    (when (>= (.length str) 2)
      (let [ch1 (.charAt str 1)]
        (cond
          (== ch1 \:)
            (let [ch0 (Character/toUpperCase (.charAt str 0))]
              (when (and (>= ch0 \A) (<= ch0 \Z)) (set! str (java-str "/" str))))
          (and (== ch1 \/) (== (.charAt str 0) \/)) (set! str (java-str "file:" str)))))
    (let [pos (.indexOf str \space)]
      (when (>= pos 0)
        (let [sb (StringBuilder. (.length str))]
          (loop [^int i 0]
            (when (< i pos) (.append sb (.charAt str i)) (recur (unchecked-inc-int i))))
          (.append sb "%20")
          (loop [^int i (unchecked-add-int pos 1)]
            (if (< i (.length str))
                (if (== (.charAt str i) \space)
                    (do (.append sb "%20") (recur (unchecked-inc-int i)))
                    (do (.append sb (.charAt str i)) (recur (unchecked-inc-int i))))
                nil))
          (set! str (.toString sb))))
      str))

  (method ^:final print ^void [this]
    (when DEBUG_BUFFER
      (if (some? fCurrentEntity)
          (do
            (.print System/out \[)
            (.print System/out (.-count fCurrentEntity))
            (.print System/out \space)
            (.print System/out (.-position fCurrentEntity))
            (when (> (.-count fCurrentEntity) 0)
              (.print System/out " \"")
              (loop [^int i 0]
                (when (< i (.-count fCurrentEntity))
                  (when (== i (.-position fCurrentEntity)) (.print System/out \^))
                  (let [c (aget (.-ch fCurrentEntity) i)]
                    (switch c
                      \newline (do (.print System/out "\\n") (recur (unchecked-inc-int i)))
                      \return (do (.print System/out "\\r") (recur (unchecked-inc-int i)))
                      \tab (do (.print System/out "\\t") (recur (unchecked-inc-int i)))
                      \\ (do (.print System/out "\\\\") (recur (unchecked-inc-int i)))
                      (do (.print System/out c) (recur (unchecked-inc-int i)))))))
              (when (== (.-position fCurrentEntity) (.-count fCurrentEntity))
                (.print System/out \^))
              (.print System/out \"))
            (.print System/out \])
            (.print System/out " @ ")
            (.print System/out (.-lineNumber fCurrentEntity))
            (.print System/out \,)
            (.print System/out (.-columnNumber fCurrentEntity)))
          (.print System/out "*NO CURRENT ENTITY*"))))


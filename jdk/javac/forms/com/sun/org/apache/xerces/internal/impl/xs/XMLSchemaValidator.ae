                            "cvc-complex-type.5.2"
                            (new Object/1
                                 [(.-rawname element) wildcardIDName (.-fIDAttrName attrGrp)])))))

  (method processOneAttribute ^void [this ^QName element ^XMLAttributes attributes ^int index
                                     ^XSAttributeDecl currDecl ^XSAttributeUseImpl currUse
                                     ^AttributePSVImpl attrPSVI]
    (let [attrValue (.getValue attributes index)]
      (.pushContext fXSIErrorReporter)
      (let [attDV (.-fType currDecl)
            ^:mutable ^Object actualValue nil]
        (try
          (set! actualValue (.validate attDV attrValue fValidationState fValidatedInfo))
          (when fNormalizeData (.setValue attributes index (.-normalizedValue fValidatedInfo)))
          (when (and (== (.getVariety attDV) XSSimpleType/VARIETY_ATOMIC)
                     (== (.getPrimitiveKind attDV) XSSimpleType/PRIMITIVE_NOTATION))
            (let [qName (cast QName actualValue)
                  grammar (.getGrammar fGrammarBucket (.-uri qName))]
              (when (some? grammar)
                (set! fNotation (.getGlobalNotationDecl grammar (.-localpart qName))))))
          (catch InvalidDatatypeValueException idve
            (.reportSchemaError this (.getKey idve) (.getArgs idve))
            (.reportSchemaError this
                                "cvc-attribute.3"
                                (new Object/1
                                     [(.-rawname element)
                                      (.-rawname fTempQName)
                                      attrValue
                                      (if (instance? XSSimpleTypeDecl attDV)
                                          ^Object (.getTypeName (cast XSSimpleTypeDecl attDV))
                                          ^Object (.getName attDV))]))))
        (when (and (some? actualValue) (== (.getConstraintType currDecl) XSConstants/VC_FIXED))
          (when (or (not (ValidatedInfo/isComparable fValidatedInfo (.-fDefault currDecl)))
                    (not (.equals actualValue (.-actualValue (.-fDefault currDecl)))))
            (.reportSchemaError this
                                "cvc-attribute.4"
                                (new Object/1
                                     [(.-rawname element)
                                      (.-rawname fTempQName)
                                      attrValue
                                      (.stringValue (.-fDefault currDecl))]))))
        (when (and (and (some? actualValue) (some? currUse))
                   (== (.-fConstraintType currUse) XSConstants/VC_FIXED))
          (when (or (not (ValidatedInfo/isComparable fValidatedInfo (.-fDefault currUse)))
                    (not (.equals actualValue (.-actualValue (.-fDefault currUse)))))
            (.reportSchemaError this
                                "cvc-complex-type.3.1"
                                (new Object/1
                                     [(.-rawname element)
                                      (.-rawname fTempQName)
                                      attrValue
                                      (.stringValue (.-fDefault currUse))]))))
        (when fIdConstraint (.copyFrom (.-fValue attrPSVI) fValidatedInfo))
        (when fAugPSVI
          (set! (.-fDeclaration attrPSVI) currDecl)
          (set! (.-fTypeDecl attrPSVI) attDV)
          (.copyFrom (.-fValue attrPSVI) fValidatedInfo)
          (set! (.-fValidationAttempted attrPSVI) AttributePSVI/VALIDATION_FULL)
          (when (and (not fUseGrammarPoolOnly)
                     (not (and (< fElementDepth fIgnoreXSITypeDepth) (nil? fCurrentElemDecl))))
            (set! fNNoneValidationDepth fElementDepth))
          (let [errors (.mergeContext fXSIErrorReporter)]
            (set! (.-fErrors attrPSVI) errors)
            (set! (.-fValidity attrPSVI)
                  (if (nil? errors) AttributePSVI/VALIDITY_VALID AttributePSVI/VALIDITY_INVALID)))))))

  (method addDefaultAttributes ^void [this ^QName element ^XMLAttributes attributes
                                      ^XSAttributeGroupDecl attrGrp]
    (when DEBUG (.println System/out (java-str "==>addDefaultAttributes: " element)))
    (let [attrUses (.getAttributeUses attrGrp)
          useCount (.getLength attrUses)
          ^:mutable ^XSAttributeUseImpl currUse nil
          ^:mutable ^XSAttributeDecl currDecl nil
          ^:mutable ^short constType 0
          ^:mutable ^ValidatedInfo defaultValue nil
          ^:mutable ^boolean isSpecified false
          ^:mutable ^QName attName nil]
      (loop [^int i 0]
        (when (< i useCount)
          (set! currUse (cast XSAttributeUseImpl (.item attrUses i)))
          (set! currDecl (.-fAttrDecl currUse))
          (set! constType (.-fConstraintType currUse))
          (set! defaultValue (.-fDefault currUse))
          (when (== constType XSConstants/VC_NONE)
            (set! constType (.getConstraintType currDecl))
            (set! defaultValue (.-fDefault currDecl)))
          (set! isSpecified
                (some? (.getValue attributes (.-fTargetNamespace currDecl) (.-fName currDecl))))
          (when (== (.-fUse currUse) SchemaSymbols/USE_REQUIRED)
            (when-not isSpecified
              (if (some? (.-fTargetNamespace currDecl))
                  (.reportSchemaError this
                                      "cvc-complex-type.4_ns"
                                      (new Object/1
                                           [(.-rawname element)
                                            (.-fName currDecl)
                                            (.-fTargetNamespace currDecl)]))
                  (.reportSchemaError this
                                      "cvc-complex-type.4"
                                      (new Object/1 [(.-rawname element) (.-fName currDecl)])))))
          (if (and (not isSpecified) (not (== constType XSConstants/VC_NONE)))
              (do
                (set! attName
                      (QName. nil
                              (.-fName currDecl)
                              (.-fName currDecl)
                              (.-fTargetNamespace currDecl)))
                (let [^String normalized (if (some? defaultValue) (.stringValue defaultValue) "")
                      ^:mutable ^int attrIndex 0]
                  (if (instance? XMLAttributesImpl attributes)
                      (let [attrs (cast XMLAttributesImpl attributes)]
                        (set! attrIndex (.getLength attrs))
                        (.addAttributeNS attrs attName "CDATA" normalized))
                      (set! attrIndex (.addAttribute attributes attName "CDATA" normalized)))
                  (if fAugPSVI
                      (let [augs (.getAugmentations attributes attrIndex)
                            attrPSVI (AttributePSVImpl.)]
                        (.putItem augs Constants/ATTRIBUTE_PSVI attrPSVI)
                        (set! (.-fDeclaration attrPSVI) currDecl)
                        (set! (.-fTypeDecl attrPSVI) (.-fType currDecl))
                        (.copyFrom (.-fValue attrPSVI) defaultValue)
                        (set! (.-fValidationContext attrPSVI) fValidationRoot)
                        (set! (.-fValidity attrPSVI) AttributePSVI/VALIDITY_VALID)
                        (set! (.-fValidationAttempted attrPSVI) AttributePSVI/VALIDATION_FULL)
                        (set! (.-fSpecified attrPSVI) true)
                        (recur (unchecked-inc-int i)))
                      (recur (unchecked-inc-int i)))))
              (recur (unchecked-inc-int i)))))))

  (method processElementContent ^void [this ^QName element]
    (when (and (and (and (and (some? fCurrentElemDecl) (some? (.-fDefault fCurrentElemDecl)))
                         (not fSawText))
                    (not fSubElement))
               (not fNil))
      (let [strv (.stringValue (.-fDefault fCurrentElemDecl))
            bufLen (.length strv)]
        (when (or (nil? (.-ch fNormalizedStr)) (< (alength (.-ch fNormalizedStr)) bufLen))
          (set! (.-ch fNormalizedStr) (new char/1 bufLen)))
        (.getChars strv 0 bufLen (.-ch fNormalizedStr) 0)
        (set! (.-offset fNormalizedStr) 0)
        (set! (.-length fNormalizedStr) bufLen)
        (set! fDefaultValue fNormalizedStr)))
    (set! (.-normalizedValue fValidatedInfo) nil)
    (when fNil
      (when (or fSubElement fSawText)
        (.reportSchemaError this
                            "cvc-elt.3.2.1"
                            (new Object/1
                                 [(.-rawname element)
                                  (java-str SchemaSymbols/URI_XSI "," SchemaSymbols/XSI_NIL)]))))
    (.reset (.-fValidatedInfo this))
    (if (and (and (and (and (some? fCurrentElemDecl)
                            (not (== (.getConstraintType fCurrentElemDecl) XSConstants/VC_NONE)))
                       (not fSubElement))
                  (not fSawText))
             (not fNil))
        (do
          (when-not (identical? fCurrentType (.-fType fCurrentElemDecl))
            (when (nil? (XSConstraints/ElementDefaultValidImmediate
                          fCurrentType
                          (.stringValue (.-fDefault fCurrentElemDecl))
                          fState4XsiType
                          nil))
              (.reportSchemaError this
                                  "cvc-elt.5.1.1"
                                  (new Object/1
                                       [(.-rawname element)
                                        (.getName fCurrentType)
                                        (.stringValue (.-fDefault fCurrentElemDecl))]))))
          (.elementLocallyValidType this element (.stringValue (.-fDefault fCurrentElemDecl))))
        (let [actualValue (.elementLocallyValidType this element fBuffer)]
          (when (and (and (some? fCurrentElemDecl)
                          (== (.getConstraintType fCurrentElemDecl) XSConstants/VC_FIXED))
                     (not fNil))
            (let [content (.toString fBuffer)]
              (when fSubElement
                (.reportSchemaError this "cvc-elt.5.2.2.1" (new Object/1 [(.-rawname element)])))
              (cond
                (== (.getTypeCategory fCurrentType) XSTypeDefinition/COMPLEX_TYPE)
                  (let [ctype (cast XSComplexTypeDecl fCurrentType)]
                    (cond
                      (== (.-fContentType ctype) XSComplexTypeDecl/CONTENTTYPE_MIXED)
                        (when-not (.equals (.-normalizedValue (.-fDefault fCurrentElemDecl))
                                           content)
                          (.reportSchemaError
                            this
                            "cvc-elt.5.2.2.2.1"
                            (new Object/1
                                 [(.-rawname element)
                                  content
                                  (.-normalizedValue (.-fDefault fCurrentElemDecl))])))
                      (== (.-fContentType ctype) XSComplexTypeDecl/CONTENTTYPE_SIMPLE)
                        (when (and (some? actualValue)
                                   (or (not (ValidatedInfo/isComparable
                                              fValidatedInfo
                                              (.-fDefault fCurrentElemDecl)))
                                       (not (.equals
                                              actualValue
                                              (.-actualValue (.-fDefault fCurrentElemDecl))))))
                          (.reportSchemaError this
                                              "cvc-elt.5.2.2.2.2"
                                              (new
                                                Object/1
                                                [(.-rawname element)
                                                 content
                                                 (.stringValue (.-fDefault fCurrentElemDecl))])))))
                (== (.getTypeCategory fCurrentType) XSTypeDefinition/SIMPLE_TYPE)
                  (when (and (some? actualValue)
                             (or (not (ValidatedInfo/isComparable
                                        fValidatedInfo
                                        (.-fDefault fCurrentElemDecl)))
                                 (not (.equals actualValue
                                               (.-actualValue (.-fDefault fCurrentElemDecl))))))
                    (.reportSchemaError this
                                        "cvc-elt.5.2.2.2.2"
                                        (new Object/1
                                             [(.-rawname element)
                                              content
                                              (.stringValue (.-fDefault fCurrentElemDecl))]))))))))
    (when (and (and (and (nil? fDefaultValue) fNormalizeData) (some? fDocumentHandler)) fUnionType)
      (let [^:mutable content (.-normalizedValue fValidatedInfo)]
        (when (nil? content) (set! content (.toString fBuffer)))
        (let [bufLen (.length content)]
          (when (or (nil? (.-ch fNormalizedStr)) (< (alength (.-ch fNormalizedStr)) bufLen))
            (set! (.-ch fNormalizedStr) (new char/1 bufLen)))
          (.getChars content 0 bufLen (.-ch fNormalizedStr) 0)
          (set! (.-offset fNormalizedStr) 0)
          (set! (.-length fNormalizedStr) bufLen)
          (.characters fDocumentHandler fNormalizedStr nil)))))

  (method elementLocallyValidType [this ^QName element textContent]
    (when (some? fCurrentType)
      (let [^:mutable ^Object retValue nil]
        (if (== (.getTypeCategory fCurrentType) XSTypeDefinition/SIMPLE_TYPE)
            (do
              (when fSubElement
                (.reportSchemaError this "cvc-type.3.1.2" (new Object/1 [(.-rawname element)])))
              (when-not fNil
                (let [dv (cast XSSimpleType fCurrentType)]
                  (try
                    (when (or (not fNormalizeData) fUnionType)
                      (.setNormalizationRequired fValidationState true))
                    (set! retValue (.validate dv textContent fValidationState fValidatedInfo))
                    (catch InvalidDatatypeValueException e
                      (.reportSchemaError this (.getKey e) (.getArgs e))
                      (.reportSchemaError this
                                          "cvc-type.3.1.3"
                                          (new Object/1 [(.-rawname element) textContent])))))))
            (set! retValue (.elementLocallyValidComplexType this element textContent)))
        retValue)))

  (method elementLocallyValidComplexType [this ^QName element textContent]
    (let [^:mutable ^Object actualValue nil
          ctype (cast XSComplexTypeDecl fCurrentType)]
      (when-not fNil
        (cond
          (and (== (.-fContentType ctype) XSComplexTypeDecl/CONTENTTYPE_EMPTY)
               (or fSubElement fSawText))
            (.reportSchemaError this "cvc-complex-type.2.1" (new Object/1 [(.-rawname element)]))
          (== (.-fContentType ctype) XSComplexTypeDecl/CONTENTTYPE_SIMPLE)
            (do
              (when fSubElement
                (.reportSchemaError this
                                    "cvc-complex-type.2.2"
                                    (new Object/1 [(.-rawname element)])))
              (let [dv (.-fXSSimpleType ctype)]
                (try
                  (when (or (not fNormalizeData) fUnionType)
                    (.setNormalizationRequired fValidationState true))
                  (set! actualValue (.validate dv textContent fValidationState fValidatedInfo))
                  (catch InvalidDatatypeValueException e
                    (.reportSchemaError this (.getKey e) (.getArgs e))
                    (.reportSchemaError this
                                        "cvc-complex-type.2.2"
                                        (new Object/1 [(.-rawname element)]))))))
          (== (.-fContentType ctype) XSComplexTypeDecl/CONTENTTYPE_ELEMENT)
            (when fSawCharacters
              (.reportSchemaError this "cvc-complex-type.2.3" (new Object/1 [(.-rawname element)]))))
        (when (or (== (.-fContentType ctype) XSComplexTypeDecl/CONTENTTYPE_ELEMENT)
                  (== (.-fContentType ctype) XSComplexTypeDecl/CONTENTTYPE_MIXED))
          (when DEBUG (.println System/out fCurrCMState))
          (if (and (>= (aget fCurrCMState 0) 0) (not (.endContentModel fCurrentCM fCurrCMState)))
              (let [expected (.expectedStr this (.whatCanGoHere fCurrentCM fCurrCMState))
                    occurenceInfo (.occurenceInfo fCurrentCM fCurrCMState)]
                (if (some? occurenceInfo)
                    (let [minOccurs (aget occurenceInfo 0)
                          count (aget occurenceInfo 2)]
                      (if (< count minOccurs)
                          (let [required (unchecked-subtract-int minOccurs count)]
                            (if (> required 1)
                                (.reportSchemaError
                                  this
                                  "cvc-complex-type.2.4.j"
                                  (new Object/1
                                       [(.-rawname element)
                                        (.getTermName fCurrentCM (aget occurenceInfo 3))
                                        (Integer/toString minOccurs)
                                        (Integer/toString required)]))
                                (.reportSchemaError
                                  this
                                  "cvc-complex-type.2.4.i"
                                  (new Object/1
                                       [(.-rawname element)
                                        (.getTermName fCurrentCM (aget occurenceInfo 3))
                                        (Integer/toString minOccurs)]))))
                          (.reportSchemaError this
                                              "cvc-complex-type.2.4.b"
                                              (new Object/1 [(.-rawname element) expected]))))
                    (.reportSchemaError this
                                        "cvc-complex-type.2.4.b"
                                        (new Object/1 [(.-rawname element) expected]))))
              (let [^{:tag (List String)} errors (.checkMinMaxBounds fCurrentCM)]
                (when (some? errors)
                  (loop [^int i 0]
                    (when (< i (.size errors))
                      (.reportSchemaError this
                                          (cast String (.get errors i))
                                          (new Object/1
                                               [(.-rawname element)
                                                (.get errors (unchecked-add-int i 1))]))
                      (recur (unchecked-add-int i 2)))))))))
      actualValue))

  (method processRootTypeQName ^void [this ^:final ^javax.xml.namespace.QName rootTypeQName]
    (let [^:mutable rootTypeNamespace (.getNamespaceURI rootTypeQName)]
      (set! rootTypeNamespace (.addSymbol fSymbolTable rootTypeNamespace))
      (when (and (some? rootTypeNamespace) (.equals rootTypeNamespace XMLConstants/NULL_NS_URI))
        (set! rootTypeNamespace nil))
      (if (.equals SchemaSymbols/URI_SCHEMAFORSCHEMA rootTypeNamespace)
          (set! fCurrentType
                (.getGlobalTypeDecl SchemaGrammar/SG_SchemaNS (.getLocalPart rootTypeQName)))
          (let [grammarForRootType (.findSchemaGrammar
                                     this
                                     XSDDescription/CONTEXT_ELEMENT
                                     rootTypeNamespace
                                     nil
                                     nil
                                     nil)]
            (when (some? grammarForRootType)
              (set! fCurrentType
                    (.getGlobalTypeDecl grammarForRootType (.getLocalPart rootTypeQName))))))
      (when (nil? fCurrentType)
        (let [^String typeName (if (.equals (.getPrefix rootTypeQName)
                                            XMLConstants/DEFAULT_NS_PREFIX)
                                   (.getLocalPart rootTypeQName)
                                   (java-str (.getPrefix rootTypeQName)
                                             ":"
                                             (.getLocalPart rootTypeQName)))]
          (.reportSchemaError this "cvc-type.1" (new Object/1 [typeName]))))))

  (method processRootElementDeclQName ^void [this
                                             ^:final ^javax.xml.namespace.QName rootElementDeclQName
                                             ^:final ^QName element]
    (let [^:mutable rootElementDeclNamespace (.getNamespaceURI rootElementDeclQName)]
      (set! rootElementDeclNamespace (.addSymbol fSymbolTable rootElementDeclNamespace))
      (when (and (some? rootElementDeclNamespace)
                 (.equals rootElementDeclNamespace XMLConstants/NULL_NS_URI))
        (set! rootElementDeclNamespace nil))
      (let [grammarForRootElement (.findSchemaGrammar
                                    this
                                    XSDDescription/CONTEXT_ELEMENT
                                    rootElementDeclNamespace
                                    nil
                                    nil
                                    nil)]
        (when (some? grammarForRootElement)
          (set! fCurrentElemDecl
                (.getGlobalElementDecl grammarForRootElement (.getLocalPart rootElementDeclQName))))
        (if (nil? fCurrentElemDecl)
            (let [^String declName (if (.equals (.getPrefix rootElementDeclQName)
                                                XMLConstants/DEFAULT_NS_PREFIX)
                                       (.getLocalPart rootElementDeclQName)
                                       (java-str
                                         (.getPrefix rootElementDeclQName)
                                         ":"
                                         (.getLocalPart rootElementDeclQName)))]
              (.reportSchemaError this "cvc-elt.1.a" (new Object/1 [declName])))
            (.checkElementMatchesRootElementDecl this fCurrentElemDecl element)))))

  (method checkElementMatchesRootElementDecl ^void [this ^:final ^XSElementDecl rootElementDecl
                                                    ^:final ^QName element]
    (when (or (not (identical? (.-localpart element) (.-fName rootElementDecl)))
              (not (identical? (.-uri element) (.-fTargetNamespace rootElementDecl))))
      (.reportSchemaError this
                          "cvc-elt.1.b"
                          (new Object/1 [(.-rawname element) (.-fName rootElementDecl)]))))

  (method reportSchemaError ^void [this ^String key ^Object/1 arguments]
    (when fDoValidation
      (.reportError fXSIErrorReporter
                    XSMessageFormatter/SCHEMA_DOMAIN
                    key
                    arguments
                    XMLErrorReporter/SEVERITY_ERROR)))

  (method ^:private expectedStr ^String [this ^{:tag (List Object)} expected]
    (let [ret (StringBuilder. "{")
          size (.size expected)]
      (loop [^int i 0]
        (when (< i size)
          (when (> i 0) (.append ret ", "))
          (.append ret (.toString (.get expected i)))
          (recur (unchecked-inc-int i))))
      (.append ret \})
      (.toString ret)))

  (defclass ^:protected ^:static XPathMatcherStack
    (field ^:protected ^XPathMatcher/1 fMatchers (new XPathMatcher/1 4))

    (field ^:protected ^int fMatchersCount)

    (field ^:protected ^IntStack fContextStack (IntStack.))

    (constructor ^:public [this])

    (method ^:public clear ^void [this]
      (loop [^int i 0]
        (when (< i fMatchersCount) (aset fMatchers i nil) (recur (unchecked-inc-int i))))
      (set! fMatchersCount 0)
      (.clear fContextStack))

    (method ^:public size ^int [this] (.size fContextStack))

    (method ^:public getMatcherCount ^int [this] fMatchersCount)

    (method ^:public addMatcher ^void [this ^XPathMatcher matcher]
      (.ensureMatcherCapacity this)
      (aset fMatchers
            (let [old-8 fMatchersCount]
              (set! fMatchersCount (unchecked-inc-int fMatchersCount))
              old-8)
            matcher))

    (method ^:public getMatcherAt ^XPathMatcher [this ^int index]
      (aget fMatchers index))

    (method ^:public pushContext ^void [this]
      (.push fContextStack fMatchersCount))

    (method ^:public popContext ^void [this]
      (set! fMatchersCount (.pop fContextStack)))

    (method ^:private ensureMatcherCapacity ^void [this]
      (when (== fMatchersCount (alength fMatchers))
        (let [array (new XPathMatcher/1 (unchecked-multiply-int (alength fMatchers) 2))]
          (System/arraycopy fMatchers 0 array 0 (alength fMatchers))
          (set! fMatchers array)))))

  (defclass ^:protected ^:abstract ValueStoreBase
    :implements [ValueStore]

    (field ^:protected ^IdentityConstraint fIdentityConstraint)

    (field ^:protected ^int fFieldCount 0)

    (field ^:protected ^Field/1 fFields nil)

    (field ^:protected ^Object/1 fLocalValues nil)

    (field ^:protected ^short/1 fLocalValueTypes nil)

    (field ^:protected ^ShortList/1 fLocalItemValueTypes nil)

    (field ^:protected ^int fValuesCount)

    (field ^:protected ^boolean fHasValue false)

    (field ^:public ^:final ^{:tag (Vector Object)} fValues (Vector.))

    (field ^:public ^ShortVector fValueTypes nil)

    (field ^:public ^{:tag (Vector ShortList)} fItemValueTypes nil)

    (field ^:private ^boolean fUseValueTypeVector false)

    (field ^:private ^int fValueTypesLength 0)

    (field ^:private ^short fValueType 0)

    (field ^:private ^boolean fUseItemValueTypeVector false)

    (field ^:private ^int fItemValueTypesLength 0)

    (field ^:private ^ShortList fItemValueType nil)

    (field ^:final ^StringBuilder fTempBuffer (StringBuilder.))

    (constructor ^:protected [this ^IdentityConstraint identityConstraint]
      (set! fIdentityConstraint identityConstraint)
      (set! fFieldCount (.getFieldCount fIdentityConstraint))
      (set! fFields (new Field/1 fFieldCount))
      (set! fLocalValues (new Object/1 fFieldCount))
      (set! fLocalValueTypes (new short/1 fFieldCount))
      (set! fLocalItemValueTypes (new ShortList/1 fFieldCount))
      (loop [^int i 0]
        (when (< i fFieldCount)
          (aset fFields i (.getFieldAt fIdentityConstraint i))
          (recur (unchecked-inc-int i)))))

    (method ^:public clear ^void [this]
      (set! fValuesCount 0)
      (set! fUseValueTypeVector false)
      (set! fValueTypesLength 0)
      (set! fValueType 0)
      (set! fUseItemValueTypeVector false)
      (set! fItemValueTypesLength 0)
      (set! fItemValueType nil)
      (.setSize fValues 0)
      (when (some? fValueTypes) (.clear fValueTypes))
      (when (some? fItemValueTypes) (.setSize fItemValueTypes 0)))

    (method ^:public append ^void [this ^ValueStoreBase newVal]
      (loop [^int i 0]
        (when (< i (.size (.-fValues newVal)))
          (.add fValues (.get (.-fValues newVal) i))

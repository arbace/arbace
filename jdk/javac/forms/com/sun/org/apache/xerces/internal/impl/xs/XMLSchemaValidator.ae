  (field ^:protected ^ValueStoreCache fValueStoreCache (ValueStoreCache.))

  (constructor ^:public [this]
    (.setExtraChecking fState4XsiType false)
    (.setFacetChecking fState4ApplyDefault false))

  (method ^:public reset :throws [XMLConfigurationException] ^void [this
                                                                    ^XMLComponentManager componentManager]
    (set! fIdConstraint false)
    (.clear fLocationPairs)
    (.resetIDTables fValidationState)
    (.reset fSchemaLoader componentManager)
    (set! fCurrentElemDecl nil)
    (set! fCurrentCM nil)
    (set! fCurrCMState nil)
    (set! fSkipValidationDepth -1)
    (set! fNFullValidationDepth -1)
    (set! fNNoneValidationDepth -1)
    (set! fElementDepth -1)
    (set! fSubElement false)
    (set! fSchemaDynamicValidation false)
    (set! fEntityRef false)
    (set! fInCDATA false)
    (.clear fMatcherStack)
    (.reset fXSIErrorReporter
            (cast XMLErrorReporter (.getProperty componentManager ERROR_REPORTER)))
    (let [parser_settings (.getFeature componentManager PARSER_SETTINGS true)]
      (if (not parser_settings)
          (do
            (.addValidationState fValidationManager fValidationState)
            (.reset nodeFactory)
            (XMLSchemaLoader/processExternalHints
              fExternalSchemas
              fExternalNoNamespaceSchema
              fLocationPairs
              (.-fErrorReporter fXSIErrorReporter)))
          (do
            (.reset nodeFactory componentManager)
            (let [symbolTable (cast SymbolTable (.getProperty componentManager SYMBOL_TABLE))]
              (when-not (identical? symbolTable fSymbolTable) (set! fSymbolTable symbolTable))
              (set! fNamespaceGrowth (.getFeature componentManager NAMESPACE_GROWTH false))
              (set! fDynamicValidation (.getFeature componentManager DYNAMIC_VALIDATION false))
              (if fDynamicValidation
                  (set! fDoValidation true)
                  (set! fDoValidation (.getFeature componentManager VALIDATION false)))
              (when fDoValidation
                (set! fDoValidation
                      (let [a-2 fDoValidation
                            b-3 (.getFeature componentManager
                                             XMLSchemaValidator/SCHEMA_VALIDATION
                                             false)]
                        (or a-2 b-3))))
              (set! fFullChecking (.getFeature componentManager SCHEMA_FULL_CHECKING false))
              (set! fNormalizeData (.getFeature componentManager NORMALIZE_DATA false))
              (set! fSchemaElementDefault
                    (.getFeature componentManager SCHEMA_ELEMENT_DEFAULT false))
              (set! fAugPSVI (.getFeature componentManager SCHEMA_AUGMENT_PSVI true))
              (set! fSchemaType
                    (cast String
                          (.getProperty componentManager
                                        (java-str
                                          Constants/JAXP_PROPERTY_PREFIX
                                          Constants/SCHEMA_LANGUAGE)
                                        nil)))
              (set! fUseGrammarPoolOnly (.getFeature componentManager USE_GRAMMAR_POOL_ONLY false))
              (set! fEntityResolver
                    (cast XMLEntityResolver (.getProperty componentManager ENTITY_MANAGER)))
              (set! fValidationManager
                    (cast ValidationManager (.getProperty componentManager VALIDATION_MANAGER)))
              (.addValidationState fValidationManager fValidationState)
              (.setSymbolTable fValidationState fSymbolTable)
              (try
                (let [rootType (.getProperty componentManager ROOT_TYPE_DEF)]
                  (cond
                    (nil? rootType) (do (set! fRootTypeQName nil) (set! fRootTypeDefinition nil))
                    (instance? javax.xml.namespace.QName rootType)
                      (do
                        (set! fRootTypeQName (cast javax.xml.namespace.QName rootType))
                        (set! fRootTypeDefinition nil))
                    :else
                      (do
                        (set! fRootTypeDefinition (cast XSTypeDefinition rootType))
                        (set! fRootTypeQName nil))))
                (catch XMLConfigurationException e
                  (set! fRootTypeQName nil)
                  (set! fRootTypeDefinition nil)))
              (try
                (let [rootDecl (.getProperty componentManager ROOT_ELEMENT_DECL)]
                  (cond
                    (nil? rootDecl)
                      (do (set! fRootElementDeclQName nil) (set! fRootElementDeclaration nil))
                    (instance? javax.xml.namespace.QName rootDecl)
                      (do
                        (set! fRootElementDeclQName (cast javax.xml.namespace.QName rootDecl))
                        (set! fRootElementDeclaration nil))
                    :else
                      (do
                        (set! fRootElementDeclaration (cast XSElementDecl rootDecl))
                        (set! fRootElementDeclQName nil))))
                (catch XMLConfigurationException e
                  (set! fRootElementDeclQName nil)
                  (set! fRootElementDeclaration nil)))
              (let [ignoreXSIType (.getFeature componentManager IGNORE_XSI_TYPE false)]
                (set! fIgnoreXSITypeDepth (if ignoreXSIType 0 -1))
                (try
                  (set! fIDCChecking (.getFeature componentManager IDENTITY_CONSTRAINT_CHECKING))
                  (catch XMLConfigurationException e (set! fIDCChecking true)))
                (try
                  (.setIdIdrefChecking fValidationState
                                       (.getFeature componentManager ID_IDREF_CHECKING))
                  (catch XMLConfigurationException e (.setIdIdrefChecking fValidationState true)))
                (try
                  (.setUnparsedEntityChecking fValidationState
                                              (.getFeature
                                                componentManager
                                                UNPARSED_ENTITY_CHECKING))
                  (catch XMLConfigurationException e
                    (.setUnparsedEntityChecking fValidationState true)))
                (try
                  (set! fExternalSchemas
                        (cast String (.getProperty componentManager SCHEMA_LOCATION)))
                  (set! fExternalNoNamespaceSchema
                        (cast String (.getProperty componentManager SCHEMA_NONS_LOCATION)))
                  (catch XMLConfigurationException e
                    (set! fExternalSchemas nil)
                    (set! fExternalNoNamespaceSchema nil)))
                (XMLSchemaLoader/processExternalHints
                  fExternalSchemas
                  fExternalNoNamespaceSchema
                  fLocationPairs
                  (.-fErrorReporter fXSIErrorReporter))
                (set! fJaxpSchemaSource (.getProperty componentManager JAXP_SCHEMA_SOURCE nil))
                (set! fGrammarPool
                      (cast XMLGrammarPool (.getProperty componentManager XMLGRAMMAR_POOL nil)))
                (.setSymbolTable fState4XsiType symbolTable)
                (.setSymbolTable fState4ApplyDefault symbolTable)))))))

  (method ^:public startValueScopeFor ^void [this ^IdentityConstraint identityConstraint
                                             ^int initialDepth]
    (let [valueStore (.getValueStoreFor fValueStoreCache identityConstraint initialDepth)]
      (.startValueScope valueStore)))

  (method ^:public activateField ^XPathMatcher [this ^Field field ^int initialDepth]
    (let [^ValueStore valueStore (.getValueStoreFor
                                   fValueStoreCache
                                   (.getIdentityConstraint field)
                                   initialDepth)
          matcher (.createMatcher field valueStore)]
      (.addMatcher fMatcherStack matcher)
      (.startDocumentFragment matcher)
      matcher))

  (method ^:public endValueScopeFor ^void [this ^IdentityConstraint identityConstraint
                                           ^int initialDepth]
    (let [valueStore (.getValueStoreFor fValueStoreCache identityConstraint initialDepth)]
      (.endValueScope valueStore)))

  (method ^:private activateSelectorFor ^void [this ^IdentityConstraint ic]
    (let [selector (.getSelector ic)
          ^FieldActivator activator this]
      (when (some? selector)
        (let [matcher (.createMatcher selector activator fElementDepth)]
          (.addMatcher fMatcherStack matcher)
          (.startDocumentFragment matcher)))))

  (method ^:public getGlobalElementDecl ^XSElementDecl [this ^QName element]
    (let [sGrammar (.findSchemaGrammar this
                                       XSDDescription/CONTEXT_ELEMENT
                                       (.-uri element)
                                       nil
                                       element
                                       nil)]
      (when (some? sGrammar) (.getGlobalElementDecl sGrammar (.-localpart element)))))

  (method ensureStackCapacity ^void [this]
    (when (== fElementDepth (alength fElemDeclStack))
      (let [newSize (unchecked-add-int fElementDepth INC_STACK_SIZE)
            ^:mutable newArrayB (new boolean/1 newSize)]
        (System/arraycopy fSubElementStack 0 newArrayB 0 fElementDepth)
        (set! fSubElementStack newArrayB)
        (let [newArrayE (new XSElementDecl/1 newSize)]
          (System/arraycopy fElemDeclStack 0 newArrayE 0 fElementDepth)
          (set! fElemDeclStack newArrayE)
          (set! newArrayB (new boolean/1 newSize))
          (System/arraycopy fNilStack 0 newArrayB 0 fElementDepth)
          (set! fNilStack newArrayB)
          (let [newArrayN (new XSNotationDecl/1 newSize)]
            (System/arraycopy fNotationStack 0 newArrayN 0 fElementDepth)
            (set! fNotationStack newArrayN)
            (let [newArrayT (new XSTypeDefinition/1 newSize)]
              (System/arraycopy fTypeStack 0 newArrayT 0 fElementDepth)
              (set! fTypeStack newArrayT)
              (let [newArrayC (new XSCMValidator/1 newSize)]
                (System/arraycopy fCMStack 0 newArrayC 0 fElementDepth)
                (set! fCMStack newArrayC)
                (set! newArrayB (new boolean/1 newSize))
                (System/arraycopy fSawTextStack 0 newArrayB 0 fElementDepth)
                (set! fSawTextStack newArrayB)
                (set! newArrayB (new boolean/1 newSize))
                (System/arraycopy fStringContent 0 newArrayB 0 fElementDepth)
                (set! fStringContent newArrayB)
                (set! newArrayB (new boolean/1 newSize))
                (System/arraycopy fStrictAssessStack 0 newArrayB 0 fElementDepth)
                (set! fStrictAssessStack newArrayB)
                (let [newArrayIA (new int/2 newSize)]
                  (System/arraycopy fCMStateStack 0 newArrayIA 0 fElementDepth)
                  (set! fCMStateStack newArrayIA)))))))))

  (method handleStartDocument ^void [this ^XMLLocator locator ^String encoding]
    (when fIDCChecking (.startDocument fValueStoreCache))
    (when fAugPSVI
      (set! (.-fGrammars fCurrentPSVI) nil)
      (set! (.-fSchemaInformation fCurrentPSVI) nil)))

  (method handleEndDocument ^void [this]
    (when fIDCChecking (.endDocument fValueStoreCache)))

  (method handleCharacters ^XMLString [this ^:mutable ^XMLString text]
    (if (>= fSkipValidationDepth 0)
        text
        (do
          (set! fSawText (or fSawText (> (.-length text) 0)))
          (when (and (and fNormalizeData (not (== fWhiteSpace -1)))
                     (not (== fWhiteSpace XSSimpleType/WS_PRESERVE)))
            (.normalizeWhitespace this text (== fWhiteSpace XSSimpleType/WS_COLLAPSE))
            (set! text fNormalizedStr))
          (when fAppendBuffer (.append fBuffer (.-ch text) (.-offset text) (.-length text)))
          (set! fSawOnlyWhitespaceInElementContent false)
          (when (and (some? fCurrentType)
                     (== (.getTypeCategory fCurrentType) XSTypeDefinition/COMPLEX_TYPE))
            (let [ctype (cast XSComplexTypeDecl fCurrentType)]
              (when (== (.-fContentType ctype) XSComplexTypeDecl/CONTENTTYPE_ELEMENT)
                (loop [^int i (.-offset text)]
                  (if (< i (unchecked-add-int (.-offset text) (.-length text)))
                      (if (not (XMLChar/isSpace (aget (.-ch text) i)))
                          (set! fSawCharacters true)
                          (do
                            (set! fSawOnlyWhitespaceInElementContent (not fSawCharacters))
                            (recur (unchecked-inc-int i))))
                      nil)))))
          text)))

  (method ^:private normalizeWhitespace ^void [this ^XMLString value ^boolean collapse]
    (let [^:mutable skipSpace collapse
          ^:mutable sawNonWS false
          ^:mutable leading false
          ^:mutable trailing false
          ^:mutable ^char c (unchecked-char 0)
          size (unchecked-add-int (.-offset value) (.-length value))]
      (when (or (nil? (.-ch fNormalizedStr))
                (< (alength (.-ch fNormalizedStr)) (unchecked-add-int (.-length value) 1)))
        (set! (.-ch fNormalizedStr) (new char/1 (unchecked-add-int (.-length value) 1))))
      (set! (.-offset fNormalizedStr) 1)
      (set! (.-length fNormalizedStr) 1)
      (loop [^int i (.-offset value)]
        (when (< i size)
          (set! c (aget (.-ch value) i))
          (if (XMLChar/isSpace c)
              (do
                (when-not skipSpace
                  (aset (.-ch fNormalizedStr)
                        (let [old-4 (.-length fNormalizedStr)]
                          (set! (.-length fNormalizedStr)
                                (unchecked-inc-int (.-length fNormalizedStr)))
                          old-4)
                        \space)
                  (set! skipSpace collapse))
                (if (not sawNonWS)
                    (do (set! leading true) (recur (unchecked-inc-int i)))
                    (recur (unchecked-inc-int i))))
              (do
                (aset (.-ch fNormalizedStr)
                      (let [old-5 (.-length fNormalizedStr)]
                        (set! (.-length fNormalizedStr)
                              (unchecked-inc-int (.-length fNormalizedStr)))
                        old-5)
                      c)
                (set! skipSpace false)
                (set! sawNonWS true)
                (recur (unchecked-inc-int i))))))
      (when skipSpace
        (cond
          (> (.-length fNormalizedStr) 1)
            (do
              (set! (.-length fNormalizedStr) (unchecked-dec-int (.-length fNormalizedStr)))
              (set! trailing true))
          (and leading (not fFirstChunk)) (set! trailing true)))
      (when (> (.-length fNormalizedStr) 1)
        (when (and (not fFirstChunk) (== fWhiteSpace XSSimpleType/WS_COLLAPSE))
          (if fTrailing
              (do (set! (.-offset fNormalizedStr) 0) (aset (.-ch fNormalizedStr) 0 \space))
              (when leading
                (set! (.-offset fNormalizedStr) 0)
                (aset (.-ch fNormalizedStr) 0 \space)))))
      (set! (.-length fNormalizedStr)
            (unchecked-subtract-int (.-length fNormalizedStr) (.-offset fNormalizedStr)))
      (set! fTrailing trailing)
      (when (or trailing sawNonWS) (set! fFirstChunk false))))

  (method ^:private normalizeWhitespace ^void [this ^String value ^boolean collapse]
    (let [^:mutable skipSpace collapse
          ^:mutable ^char c (unchecked-char 0)
          size (.length value)]
      (when (or (nil? (.-ch fNormalizedStr)) (< (alength (.-ch fNormalizedStr)) size))
        (set! (.-ch fNormalizedStr) (new char/1 size)))
      (set! (.-offset fNormalizedStr) 0)
      (set! (.-length fNormalizedStr) 0)
      (loop [^int i 0]
        (when (< i size)
          (set! c (.charAt value i))
          (if (XMLChar/isSpace c)
              (if (not skipSpace)
                  (do
                    (aset (.-ch fNormalizedStr)
                          (let [old-6 (.-length fNormalizedStr)]
                            (set! (.-length fNormalizedStr)
                                  (unchecked-inc-int (.-length fNormalizedStr)))
                            old-6)
                          \space)
                    (set! skipSpace collapse)
                    (recur (unchecked-inc-int i)))
                  (recur (unchecked-inc-int i)))
              (do
                (aset (.-ch fNormalizedStr)
                      (let [old-7 (.-length fNormalizedStr)]
                        (set! (.-length fNormalizedStr)
                              (unchecked-inc-int (.-length fNormalizedStr)))
                        old-7)
                      c)
                (set! skipSpace false)
                (recur (unchecked-inc-int i))))))
      (when skipSpace
        (when-not (== (.-length fNormalizedStr) 0)
          (set! (.-length fNormalizedStr) (unchecked-dec-int (.-length fNormalizedStr)))))))

  (method handleIgnorableWhitespace ^void [this ^XMLString text]
    (when (>= fSkipValidationDepth 0) nil))

  (method handleStartElement ^Augmentations [this ^QName element ^XMLAttributes attributes
                                             ^:mutable ^Augmentations augs]
    (when DEBUG (.println System/out (java-str "==>handleStartElement: " element)))
    (when (and (== fElementDepth -1) (.isGrammarFound fValidationManager))
      (when (and (nil? fSchemaType) (not fUseGrammarPoolOnly)) (set! fSchemaDynamicValidation true)))
    (when-not fUseGrammarPoolOnly
      (let [sLocation (.getValue attributes SchemaSymbols/URI_XSI SchemaSymbols/XSI_SCHEMALOCATION)
            nsLocation (.getValue attributes
                                  SchemaSymbols/URI_XSI
                                  SchemaSymbols/XSI_NONAMESPACESCHEMALOCATION)]
        (.storeLocations this sLocation nsLocation)))
    (if (>= fSkipValidationDepth 0)
        (do
          (set! fElementDepth (unchecked-inc-int fElementDepth))
          (when fAugPSVI (set! augs (.getEmptyAugs this augs)))
          augs)
        (let [^:mutable ^Object decl nil]
          (when (some? fCurrentCM)
            (set! decl (.oneTransition fCurrentCM element fCurrCMState fSubGroupHandler))
            (when (== (aget fCurrCMState 0) XSCMValidator/FIRST_ERROR)
              (let [ctype (cast XSComplexTypeDecl fCurrentType)
                    ^:mutable ^{:tag (List Object)} next nil]
                (if (and (some? (.-fParticle ctype))
                         (> (.size (set! next (.whatCanGoHere fCurrentCM fCurrCMState))) 0))
                    (let [expected (.expectedStr this next)
                          occurenceInfo (.occurenceInfo fCurrentCM fCurrCMState)
                          ^String elemExpandedQname (if (some? (.-uri element))
                                                        (java-str
                                                          (java-str "{" \")
                                                          (.-uri element)
                                                          \"
                                                          ":"
                                                          (.-localpart element)
                                                          "}")
                                                        (.-localpart element))]
                      (if (some? occurenceInfo)
                          (let [minOccurs (aget occurenceInfo 0)
                                maxOccurs (aget occurenceInfo 1)
                                count (aget occurenceInfo 2)]
                            (cond
                              (< count minOccurs)
                                (let [required (unchecked-subtract-int minOccurs count)]
                                  (if (> required 1)
                                      (.reportSchemaError
                                        this
                                        "cvc-complex-type.2.4.h"
                                        (new Object/1
                                             [(.-rawname element)
                                              (.getTermName fCurrentCM (aget occurenceInfo 3))
                                              (Integer/toString minOccurs)
                                              (Integer/toString required)]))
                                      (.reportSchemaError
                                        this
                                        "cvc-complex-type.2.4.g"
                                        (new Object/1
                                             [(.-rawname element)
                                              (.getTermName fCurrentCM (aget occurenceInfo 3))
                                              (Integer/toString minOccurs)]))))
                              (and (>= count maxOccurs)
                                   (not (== maxOccurs SchemaSymbols/OCCURRENCE_UNBOUNDED)))
                                (.reportSchemaError
                                  this
                                  "cvc-complex-type.2.4.e"
                                  (new Object/1
                                       [(.-rawname element) expected (Integer/toString maxOccurs)]))
                              :else
                                (.reportSchemaError
                                  this
                                  "cvc-complex-type.2.4.a"
                                  (new Object/1 [elemExpandedQname expected]))))
                          (.reportSchemaError this
                                              "cvc-complex-type.2.4.a"
                                              (new Object/1 [elemExpandedQname expected]))))
                    (let [occurenceInfo (.occurenceInfo fCurrentCM fCurrCMState)]
                      (if (some? occurenceInfo)
                          (let [maxOccurs (aget occurenceInfo 1)
                                count (aget occurenceInfo 2)]
                            (if (and (>= count maxOccurs)
                                     (not (== maxOccurs SchemaSymbols/OCCURRENCE_UNBOUNDED)))
                                (.reportSchemaError
                                  this
                                  "cvc-complex-type.2.4.f"
                                  (new Object/1
                                       [(.getTermName fCurrentCM (aget occurenceInfo 3))
                                        (Integer/toString maxOccurs)]))
                                (.reportSchemaError
                                  this
                                  "cvc-complex-type.2.4.d"
                                  (new Object/1 [(.-rawname element)]))))
                          (.reportSchemaError this
                                              "cvc-complex-type.2.4.d"
                                              (new Object/1 [(.-rawname element)]))))))))
          (when-not (== fElementDepth -1)
            (.ensureStackCapacity this)
            (aset fSubElementStack fElementDepth true)
            (set! fSubElement false)
            (aset fElemDeclStack fElementDepth fCurrentElemDecl)
            (aset fNilStack fElementDepth fNil)
            (aset fNotationStack fElementDepth fNotation)
            (aset fTypeStack fElementDepth fCurrentType)
            (aset fStrictAssessStack fElementDepth fStrictAssess)
            (aset fCMStack fElementDepth fCurrentCM)
            (aset fCMStateStack fElementDepth fCurrCMState)
            (aset fSawTextStack fElementDepth fSawText)
            (aset fStringContent fElementDepth fSawCharacters))
          (set! fElementDepth (unchecked-inc-int fElementDepth))
          (set! fCurrentElemDecl nil)
          (let [^:mutable ^XSWildcardDecl wildcard nil]
            (set! fCurrentType nil)
            (set! fStrictAssess true)
            (set! fNil false)
            (set! fNotation nil)
            (.setLength fBuffer 0)
            (set! fSawText false)
            (set! fSawCharacters false)
            (when (some? decl)
              (if (instance? XSElementDecl decl)
                  (set! fCurrentElemDecl (cast XSElementDecl decl))
                  (set! wildcard (cast XSWildcardDecl decl))))
            (if (and (some? wildcard) (== (.-fProcessContents wildcard) XSWildcardDecl/PC_SKIP))
                (do
                  (set! fSkipValidationDepth fElementDepth)
                  (when fAugPSVI (set! augs (.getEmptyAugs this augs)))
                  augs)
                (do
                  (when (== fElementDepth 0)
                    (cond
                      (some? fRootElementDeclaration)
                        (do
                          (set! fCurrentElemDecl fRootElementDeclaration)
                          (.checkElementMatchesRootElementDecl this fCurrentElemDecl element))
                      (some? fRootElementDeclQName)
                        (.processRootElementDeclQName this fRootElementDeclQName element)
                      (some? fRootTypeDefinition) (set! fCurrentType fRootTypeDefinition)
                      (some? fRootTypeQName) (.processRootTypeQName this fRootTypeQName)))
                  (when (nil? fCurrentType)
                    (when (nil? fCurrentElemDecl)
                      (let [sGrammar (.findSchemaGrammar
                                       this
                                       XSDDescription/CONTEXT_ELEMENT
                                       (.-uri element)
                                       nil
                                       element
                                       attributes)]
                        (when (some? sGrammar)
                          (set! fCurrentElemDecl
                                (.getGlobalElementDecl sGrammar (.-localpart element))))))
                    (when (some? fCurrentElemDecl) (set! fCurrentType (.-fType fCurrentElemDecl))))
                  (when (and (== fElementDepth fIgnoreXSITypeDepth) (nil? fCurrentElemDecl))
                    (set! fIgnoreXSITypeDepth (unchecked-inc-int fIgnoreXSITypeDepth)))
                  (let [^:mutable ^String xsiType nil]
                    (when (>= fElementDepth fIgnoreXSITypeDepth)
                      (set! xsiType
                            (.getValue attributes SchemaSymbols/URI_XSI SchemaSymbols/XSI_TYPE)))
                    (if (and (nil? fCurrentType) (nil? xsiType))
                        (do
                          (cond
                            (== fElementDepth 0)
                              (do
                                (when (or fDynamicValidation fSchemaDynamicValidation)
                                  (when (some? fDocumentSource)
                                    (.setDocumentHandler fDocumentSource fDocumentHandler)
                                    (when (some? fDocumentHandler)
                                      (.setDocumentSource fDocumentHandler fDocumentSource))
                                    (set! fElementDepth -2)
                                    (return augs))
                                  (set! fSkipValidationDepth fElementDepth)
                                  (when fAugPSVI (set! augs (.getEmptyAugs this augs)))
                                  (return augs))
                                (.reportError (.-fErrorReporter fXSIErrorReporter)
                                              XSMessageFormatter/SCHEMA_DOMAIN
                                              "cvc-elt.1.a"
                                              (new Object/1 [(.-rawname element)])
                                              XMLErrorReporter/SEVERITY_ERROR))
                            (and (some? wildcard)
                                 (== (.-fProcessContents wildcard) XSWildcardDecl/PC_STRICT))
                              (.reportSchemaError
                                this
                                "cvc-complex-type.2.4.c"
                                (new Object/1 [(.-rawname element)])))
                          (set! fCurrentType SchemaGrammar/fAnyType)
                          (set! fStrictAssess false)
                          (set! fNFullValidationDepth fElementDepth)
                          (set! fAppendBuffer false)
                          (.pushContext fXSIErrorReporter))
                        (do
                          (.pushContext fXSIErrorReporter)
                          (when (some? xsiType)
                            (let [oldType fCurrentType]
                              (set! fCurrentType
                                    (.getAndCheckXsiType this element xsiType attributes))
                              (when (nil? fCurrentType)
                                (if (nil? oldType)
                                    (set! fCurrentType SchemaGrammar/fAnyType)
                                    (set! fCurrentType oldType)))))
                          (set! fNNoneValidationDepth fElementDepth)
                          (cond
                            (and (some? fCurrentElemDecl)
                                 (== (.getConstraintType fCurrentElemDecl) XSConstants/VC_FIXED))
                              (set! fAppendBuffer true)
                            (== (.getTypeCategory fCurrentType) XSTypeDefinition/SIMPLE_TYPE)
                              (set! fAppendBuffer true)
                            :else
                              (let [ctype (cast XSComplexTypeDecl fCurrentType)]
                                (set! fAppendBuffer
                                      (== (.-fContentType ctype)
                                          XSComplexTypeDecl/CONTENTTYPE_SIMPLE))))))
                    (when (and (some? fCurrentElemDecl) (.getAbstract fCurrentElemDecl))
                      (.reportSchemaError this "cvc-elt.2" (new Object/1 [(.-rawname element)])))
                    (when (== fElementDepth 0) (set! fValidationRoot (.-rawname element)))
                    (when fNormalizeData
                      (set! fFirstChunk true)
                      (set! fTrailing false)
                      (set! fUnionType false)
                      (set! fWhiteSpace -1))
                    (cond
                      (== (.getTypeCategory fCurrentType) XSTypeDefinition/COMPLEX_TYPE)
                        (let [ctype (cast XSComplexTypeDecl fCurrentType)]
                          (when (.getAbstract ctype)
                            (.reportSchemaError this
                                                "cvc-type.2"
                                                (new Object/1 [(.-rawname element)])))
                          (when fNormalizeData
                            (when (== (.-fContentType ctype) XSComplexTypeDecl/CONTENTTYPE_SIMPLE)
                              (if (== (.getVariety (.-fXSSimpleType ctype))
                                      XSSimpleType/VARIETY_UNION)
                                  (set! fUnionType true)
                                  (try
                                    (set! fWhiteSpace (.getWhitespace (.-fXSSimpleType ctype)))
                                    (catch DatatypeException e))))))
                      fNormalizeData
                        (let [dv (cast XSSimpleType fCurrentType)]
                          (if (== (.getVariety dv) XSSimpleType/VARIETY_UNION)
                              (set! fUnionType true)
                              (try
                                (set! fWhiteSpace (.getWhitespace dv))
                                (catch DatatypeException e)))))
                    (set! fCurrentCM nil)
                    (when (== (.getTypeCategory fCurrentType) XSTypeDefinition/COMPLEX_TYPE)
                      (set! fCurrentCM
                            (.getContentModel (cast XSComplexTypeDecl fCurrentType) fCMBuilder)))
                    (set! fCurrCMState nil)
                    (when (some? fCurrentCM) (set! fCurrCMState (.startContentModel fCurrentCM)))
                    (let [xsiNil (.getValue attributes SchemaSymbols/URI_XSI SchemaSymbols/XSI_NIL)]
                      (when (and (some? xsiNil) (some? fCurrentElemDecl))
                        (set! fNil (.getXsiNil this element xsiNil)))
                      (let [^:mutable ^XSAttributeGroupDecl attrGrp nil]
                        (when (== (.getTypeCategory fCurrentType) XSTypeDefinition/COMPLEX_TYPE)
                          (let [ctype (cast XSComplexTypeDecl fCurrentType)]
                            (set! attrGrp (.getAttrGrp ctype))))
                        (when fIDCChecking
                          (.startElement fValueStoreCache)
                          (.pushContext fMatcherStack)
                          (when (and (some? fCurrentElemDecl) (> (.-fIDCPos fCurrentElemDecl) 0))
                            (set! fIdConstraint true)
                            (.initValueStoresFor fValueStoreCache fCurrentElemDecl this)))
                        (.processAttributes this element attributes attrGrp)
                        (when (some? attrGrp)
                          (.addDefaultAttributes this element attributes attrGrp))
                        (let [count (.getMatcherCount fMatcherStack)]
                          (loop [^int i 0]
                            (when (< i count)
                              (let [matcher (.getMatcherAt fMatcherStack i)]
                                (.startElement matcher element attributes)
                                (recur (unchecked-inc-int i)))))
                          (when fAugPSVI
                            (set! augs (.getEmptyAugs this augs))
                            (set! (.-fValidationContext fCurrentPSVI) fValidationRoot)
                            (set! (.-fDeclaration fCurrentPSVI) fCurrentElemDecl)
                            (set! (.-fTypeDecl fCurrentPSVI) fCurrentType)
                            (set! (.-fNotation fCurrentPSVI) fNotation)
                            (set! (.-fNil fCurrentPSVI) fNil))
                          augs))))))))))

  (method handleEndElement ^Augmentations [this ^QName element ^:mutable ^Augmentations augs]
    (when DEBUG (.println System/out (java-str "==>handleEndElement:" element)))
    (if (>= fSkipValidationDepth 0)
        (do
          (if (and (== fSkipValidationDepth fElementDepth) (> fSkipValidationDepth 0))
              (do
                (set! fNFullValidationDepth (unchecked-subtract-int fSkipValidationDepth 1))
                (set! fSkipValidationDepth -1)
                (set! fElementDepth (unchecked-dec-int fElementDepth))
                (set! fSubElement (aget fSubElementStack fElementDepth))
                (set! fCurrentElemDecl (aget fElemDeclStack fElementDepth))
                (set! fNil (aget fNilStack fElementDepth))
                (set! fNotation (aget fNotationStack fElementDepth))
                (set! fCurrentType (aget fTypeStack fElementDepth))
                (set! fCurrentCM (aget fCMStack fElementDepth))
                (set! fStrictAssess (aget fStrictAssessStack fElementDepth))
                (set! fCurrCMState (aget fCMStateStack fElementDepth))
                (set! fSawText (aget fSawTextStack fElementDepth))
                (set! fSawCharacters (aget fStringContent fElementDepth)))
              (set! fElementDepth (unchecked-dec-int fElementDepth)))
          (when (and (and (== fElementDepth -1) fFullChecking) (not fUseGrammarPoolOnly))
            (XSConstraints/fullSchemaChecking fGrammarBucket
                                              fSubGroupHandler
                                              fCMBuilder
                                              (.-fErrorReporter fXSIErrorReporter)))
          (when fAugPSVI (set! augs (.getEmptyAugs this augs)))
          augs)
        (do
          (.processElementContent this element)
          (when fIDCChecking
            (let [oldCount (.getMatcherCount fMatcherStack)]
              (loop [^int i (unchecked-subtract-int oldCount 1)]
                (when (>= i 0)
                  (let [matcher (.getMatcherAt fMatcherStack i)]
                    (if (nil? fCurrentElemDecl)
                        (do
                          (.endElement matcher
                                       element
                                       fCurrentType
                                       false
                                       (.-actualValue fValidatedInfo)
                                       (.-actualValueType fValidatedInfo)
                                       (.-itemValueTypes fValidatedInfo))
                          (recur (unchecked-dec-int i)))
                        (do
                          (.endElement matcher
                                       element
                                       fCurrentType
                                       (.getNillable fCurrentElemDecl)
                                       (if (nil? fDefaultValue)
                                           (.-actualValue fValidatedInfo)
                                           (.-actualValue (.-fDefault fCurrentElemDecl)))
                                       (if (nil? fDefaultValue)
                                           (.-actualValueType fValidatedInfo)
                                           (.-actualValueType (.-fDefault fCurrentElemDecl)))
                                       ^ShortList (if (nil? fDefaultValue)
                                                      (.-itemValueTypes fValidatedInfo)
                                                      (.-itemValueTypes
                                                        (.-fDefault fCurrentElemDecl))))
                          (recur (unchecked-dec-int i)))))))
              (when (> (.size fMatcherStack) 0) (.popContext fMatcherStack))
              (let [newCount (.getMatcherCount fMatcherStack)]
                (loop [^int i (unchecked-subtract-int oldCount 1)]
                  (when (>= i newCount)
                    (let [matcher (.getMatcherAt fMatcherStack i)]
                      (if (instance? Selector$Matcher matcher)
                          (let [selMatcher (cast Selector$Matcher matcher)
                                ^:mutable ^IdentityConstraint id nil]
                            (if (and (some? (set! id (.getIdentityConstraint selMatcher)))
                                     (not (== (.getCategory id) IdentityConstraint/IC_KEYREF)))
                                (do
                                  (.transplant fValueStoreCache id (.getInitialDepth selMatcher))
                                  (recur (unchecked-dec-int i)))
                                (recur (unchecked-dec-int i))))
                          (recur (unchecked-dec-int i))))))
                (loop [^int i (unchecked-subtract-int oldCount 1)]
                  (when (>= i newCount)
                    (let [matcher (.getMatcherAt fMatcherStack i)]
                      (if (instance? Selector$Matcher matcher)
                          (let [selMatcher (cast Selector$Matcher matcher)
                                ^:mutable ^IdentityConstraint id nil]
                            (if (and (some? (set! id (.getIdentityConstraint selMatcher)))
                                     (== (.getCategory id) IdentityConstraint/IC_KEYREF))
                                (let [values (.getValueStoreFor
                                               fValueStoreCache
                                               id
                                               (.getInitialDepth selMatcher))]
                                  (if (and (some? values) (.-fHasValue values))
                                      (do
                                        (.endDocumentFragment values)
                                        (recur (unchecked-dec-int i)))
                                      (recur (unchecked-dec-int i))))
                                (recur (unchecked-dec-int i))))
                          (recur (unchecked-dec-int i))))))
                (.endElement fValueStoreCache))))
          (when (< fElementDepth fIgnoreXSITypeDepth)
            (set! fIgnoreXSITypeDepth (unchecked-dec-int fIgnoreXSITypeDepth)))
          (let [^:mutable ^SchemaGrammar/1 grammars nil]
            (if (== fElementDepth 0)
                (let [^{:tag (Iterator String)} invIdRefs (.checkIDRefID fValidationState)]
                  (.resetIDTables fValidationState)
                  (when (some? invIdRefs)
                    (while (.hasNext invIdRefs)
                      (.reportSchemaError this "cvc-id.1" (new Object/1 [(.next invIdRefs)]))))
                  (when (and fFullChecking (not fUseGrammarPoolOnly))
                    (XSConstraints/fullSchemaChecking
                      fGrammarBucket
                      fSubGroupHandler
                      fCMBuilder
                      (.-fErrorReporter fXSIErrorReporter)))
                  (set! grammars (.getGrammars fGrammarBucket))
                  (when (some? fGrammarPool)
                    (loop [^int k 0]
                      (when (< k (alength grammars))
                        (.setImmutable (aget grammars k) true)
                        (recur (unchecked-inc-int k))))
                    (.cacheGrammars fGrammarPool XMLGrammarDescription/XML_SCHEMA grammars))
                  (set! augs (.endElementPSVI this true grammars augs)))
                (do
                  (set! augs (.endElementPSVI this false grammars augs))
                  (set! fElementDepth (unchecked-dec-int fElementDepth))
                  (set! fSubElement (aget fSubElementStack fElementDepth))
                  (set! fCurrentElemDecl (aget fElemDeclStack fElementDepth))
                  (set! fNil (aget fNilStack fElementDepth))
                  (set! fNotation (aget fNotationStack fElementDepth))
                  (set! fCurrentType (aget fTypeStack fElementDepth))
                  (set! fCurrentCM (aget fCMStack fElementDepth))
                  (set! fStrictAssess (aget fStrictAssessStack fElementDepth))
                  (set! fCurrCMState (aget fCMStateStack fElementDepth))
                  (set! fSawText (aget fSawTextStack fElementDepth))
                  (set! fSawCharacters (aget fStringContent fElementDepth))
                  (set! fWhiteSpace -1)
                  (set! fAppendBuffer false)
                  (set! fUnionType false)))
            augs))))

  (method ^:final endElementPSVI ^Augmentations [this ^boolean root ^SchemaGrammar/1 grammars
                                                 ^:mutable ^Augmentations augs]
    (when fAugPSVI
      (set! augs (.getEmptyAugs this augs))
      (set! (.-fDeclaration fCurrentPSVI) (.-fCurrentElemDecl this))
      (set! (.-fTypeDecl fCurrentPSVI) (.-fCurrentType this))
      (set! (.-fNotation fCurrentPSVI) (.-fNotation this))
      (set! (.-fValidationContext fCurrentPSVI) (.-fValidationRoot this))
      (set! (.-fNil fCurrentPSVI) (.-fNil this))
      (cond
        (> fElementDepth fNFullValidationDepth)
          (set! (.-fValidationAttempted fCurrentPSVI) ElementPSVI/VALIDATION_FULL)
        (> fElementDepth fNNoneValidationDepth)
          (set! (.-fValidationAttempted fCurrentPSVI) ElementPSVI/VALIDATION_NONE)
        :else (set! (.-fValidationAttempted fCurrentPSVI) ElementPSVI/VALIDATION_PARTIAL))
      (when (== fNFullValidationDepth fElementDepth)
        (set! fNFullValidationDepth (unchecked-subtract-int fElementDepth 1)))
      (when (== fNNoneValidationDepth fElementDepth)
        (set! fNNoneValidationDepth (unchecked-subtract-int fElementDepth 1)))
      (when (some? fDefaultValue) (set! (.-fSpecified fCurrentPSVI) true))
      (.copyFrom (.-fValue fCurrentPSVI) fValidatedInfo)
      (if fStrictAssess
          (let [errors (.mergeContext fXSIErrorReporter)]
            (set! (.-fErrors fCurrentPSVI) errors)
            (set! (.-fValidity fCurrentPSVI)
                  (if (nil? errors) ElementPSVI/VALIDITY_VALID ElementPSVI/VALIDITY_INVALID)))
          (do
            (set! (.-fValidity fCurrentPSVI) ElementPSVI/VALIDITY_NOTKNOWN)
            (.popContext fXSIErrorReporter)))
      (when root
        (set! (.-fGrammars fCurrentPSVI) grammars)
        (set! (.-fSchemaInformation fCurrentPSVI) nil)))
    augs)

  (method getEmptyAugs ^Augmentations [this ^:mutable ^Augmentations augs]
    (when (nil? augs) (set! augs fAugmentations) (.removeAllItems augs))
    (.putItem augs Constants/ELEMENT_PSVI fCurrentPSVI)
    (.reset fCurrentPSVI)
    augs)

  (method storeLocations ^void [this ^String sLocation ^:mutable ^String nsLocation]
    (when (some? sLocation)
      (when-not (XMLSchemaLoader/tokenizeSchemaLocationStr
                  sLocation
                  fLocationPairs
                  ^String (when (some? fLocator) (.getExpandedSystemId fLocator)))
        (.reportError fXSIErrorReporter
                      XSMessageFormatter/SCHEMA_DOMAIN
                      "SchemaLocation"
                      (new Object/1 [sLocation])
                      XMLErrorReporter/SEVERITY_WARNING)))
    (when (some? nsLocation)
      (let [^:mutable la (cast XMLSchemaLoader$LocationArray
                               (.get fLocationPairs XMLSymbols/EMPTY_STRING))]
        (when (nil? la)
          (set! la (XMLSchemaLoader$LocationArray.))
          (.put fLocationPairs XMLSymbols/EMPTY_STRING la))
        (when (some? fLocator)
          (try
            (set!
              nsLocation
              (XMLEntityManager/expandSystemId nsLocation (.getExpandedSystemId fLocator) false))
            (catch URI$MalformedURIException e)))
        (.addLocation la nsLocation))))

  (method findSchemaGrammar ^SchemaGrammar [this ^short contextType ^String namespace
                                            ^QName enclosingElement ^QName triggeringComponent
                                            ^XMLAttributes attributes]
    (let [^:mutable ^SchemaGrammar grammar nil]
      (set! grammar (.getGrammar fGrammarBucket namespace))
      (when (nil? grammar)
        (.setNamespace fXSDDescription namespace)
        (when (some? fGrammarPool)
          (set! grammar (cast SchemaGrammar (.retrieveGrammar fGrammarPool fXSDDescription)))
          (when (some? grammar)
            (when-not (.putGrammar fGrammarBucket grammar true fNamespaceGrowth)
              (.reportError (.-fErrorReporter fXSIErrorReporter)
                            XSMessageFormatter/SCHEMA_DOMAIN
                            "GrammarConflict"
                            nil
                            XMLErrorReporter/SEVERITY_WARNING)
              (set! grammar nil)))))
      (when (and
              (not fUseGrammarPoolOnly)
              (or (nil? grammar)
                  (and fNamespaceGrowth
                       (not (.hasSchemaComponent this grammar contextType triggeringComponent)))))
        (.reset fXSDDescription)
        (set! (.-fContextType fXSDDescription) contextType)
        (.setNamespace fXSDDescription namespace)
        (set! (.-fEnclosedElementName fXSDDescription) enclosingElement)
        (set! (.-fTriggeringComponent fXSDDescription) triggeringComponent)
        (set! (.-fAttributes fXSDDescription) attributes)
        (when (some? fLocator) (.setBaseSystemId fXSDDescription (.getExpandedSystemId fLocator)))
        (let [^:mutable ^{:tag (Map String XMLSchemaLoader$LocationArray)} locationPairs
                fLocationPairs
              locationArray (cast XMLSchemaLoader$LocationArray
                                  (.get locationPairs
                                        (if (nil? namespace)
                                            XMLSymbols/EMPTY_STRING
                                            ^Object namespace)))]
          (when (some? locationArray)
            (let [temp (.getLocationArray locationArray)]
              (when-not (== (alength temp) 0) (.setLocationHints this fXSDDescription temp grammar))))
          (when (or (nil? grammar) (some? (.-fLocationHints fXSDDescription)))
            (let [^:mutable toParseSchema true]
              (when (some? grammar) (set! locationPairs (Collections/emptyMap)))
              (try
                (let [xis (XMLSchemaLoader/resolveDocument
                            fXSDDescription
                            locationPairs
                            fEntityResolver)]
                  (when (and (some? grammar) fNamespaceGrowth)
                    (try
                      (when (.contains (.getDocumentLocations grammar)
                                       (XMLEntityManager/expandSystemId
                                         (.getSystemId xis)
                                         (.getBaseSystemId xis)
                                         false))
                        (set! toParseSchema false))
                      (catch URI$MalformedURIException e)))
                  (when toParseSchema
                    (set! grammar (.loadSchema fSchemaLoader fXSDDescription xis fLocationPairs))))
                (catch IOException ex
                  (let [locationHints (.getLocationHints fXSDDescription)]
                    (.reportError (.-fErrorReporter fXSIErrorReporter)
                                  XSMessageFormatter/SCHEMA_DOMAIN
                                  "schema_reference.4"
                                  (new Object/1
                                       [(if (some? locationHints)
                                            ^Object (aget locationHints 0)
                                            XMLSymbols/EMPTY_STRING)])
                                  XMLErrorReporter/SEVERITY_WARNING
                                  ex))))))))
      grammar))

  (method ^:private hasSchemaComponent ^boolean [this ^SchemaGrammar grammar ^short contextType
                                                 ^QName triggeringComponent]
    (when (and (some? grammar) (some? triggeringComponent))
      (let [localName (.-localpart triggeringComponent)]
        (when (and (some? localName) (> (.length localName) 0))
          (switch contextType
            XSDDescription/CONTEXT_ELEMENT
              (return (some? (.getElementDeclaration grammar localName)))
            XSDDescription/CONTEXT_ATTRIBUTE
              (return (some? (.getAttributeDeclaration grammar localName)))
            XSDDescription/CONTEXT_XSITYPE (return (some? (.getTypeDefinition grammar localName)))))))
    false)

  (method ^:private setLocationHints ^void [this ^XSDDescription desc ^String/1 locations
                                            ^SchemaGrammar grammar]
    (let [length (alength locations)]
      (if (nil? grammar)
          (do
            (set! (.-fLocationHints fXSDDescription) (new String/1 length))
            (System/arraycopy locations 0 (.-fLocationHints fXSDDescription) 0 length))
          (.setLocationHints this desc locations (.getDocumentLocations grammar)))))

  (method ^:private setLocationHints ^void [this ^XSDDescription desc ^String/1 locations
                                            ^StringList docLocations]
    (let [length (alength locations)
          hints (new String/1 length)
          ^:mutable ^int counter 0]
      (loop [^int i 0]
        (if (< i length)
            (if (not (.contains docLocations (aget locations i)))
                (do
                  (aset hints counter (aget locations i))
                  (set! counter (unchecked-inc-int counter))
                  (recur (unchecked-inc-int i)))
                (recur (unchecked-inc-int i)))
            nil))
      (when (> counter 0)
        (if (== counter length)
            (set! (.-fLocationHints fXSDDescription) hints)
            (do
              (set! (.-fLocationHints fXSDDescription) (new String/1 counter))
              (System/arraycopy hints 0 (.-fLocationHints fXSDDescription) 0 counter))))))

  (method getAndCheckXsiType ^XSTypeDefinition [this ^QName element ^String xsiType
                                                ^XMLAttributes attributes]
    (let [^:mutable ^QName typeName nil]
      (try
        (set! typeName (cast QName (.validate fQNameDV xsiType fValidationState nil)))
        (catch InvalidDatatypeValueException e
          (.reportSchemaError this (.getKey e) (.getArgs e))
          (.reportSchemaError this
                              "cvc-elt.4.1"
                              (new Object/1
                                   [(.-rawname element)
                                    (java-str SchemaSymbols/URI_XSI "," SchemaSymbols/XSI_TYPE)
                                    xsiType]))
          (return nil)))
      (let [^:mutable ^XSTypeDefinition type nil]
        (when (identical? (.-uri typeName) SchemaSymbols/URI_SCHEMAFORSCHEMA)
          (set! type (.getGlobalTypeDecl SchemaGrammar/SG_SchemaNS (.-localpart typeName))))
        (when (nil? type)
          (let [grammar (.findSchemaGrammar this
                                            XSDDescription/CONTEXT_XSITYPE
                                            (.-uri typeName)
                                            element
                                            typeName
                                            attributes)]
            (when (some? grammar) (set! type (.getGlobalTypeDecl grammar (.-localpart typeName))))))
        (if (nil? type)
            (do
              (.reportSchemaError this "cvc-elt.4.2" (new Object/1 [(.-rawname element) xsiType]))
              nil)
            (do
              (when (some? fCurrentType)
                (let [^:mutable block XSConstants/DERIVATION_NONE]
                  (when (some? fCurrentElemDecl) (set! block (.-fBlock fCurrentElemDecl)))
                  (when (== (.getTypeCategory fCurrentType) XSTypeDefinition/COMPLEX_TYPE)
                    (set! block
                          (unchecked-short
                            (bit-or-int block (.-fBlock (cast XSComplexTypeDecl fCurrentType))))))
                  (when-not (XSConstraints/checkTypeDerivationOk type fCurrentType block)
                    (.reportSchemaError this
                                        "cvc-elt.4.3"
                                        (new Object/1
                                             [(.-rawname element)
                                              xsiType
                                              (XS10TypeHelper/getSchemaTypeName fCurrentType)])))))
              type)))))

  (method getXsiNil ^boolean [this ^QName element ^String xsiNil]
    (if (and (some? fCurrentElemDecl) (not (.getNillable fCurrentElemDecl)))
        (.reportSchemaError this
                            "cvc-elt.3.1"
                            (new Object/1
                                 [(.-rawname element)
                                  (java-str SchemaSymbols/URI_XSI "," SchemaSymbols/XSI_NIL)]))
        (let [value (XMLChar/trim xsiNil)]
          (when (or (.equals value SchemaSymbols/ATTVAL_TRUE)
                    (.equals value SchemaSymbols/ATTVAL_TRUE_1))
            (when (and (some? fCurrentElemDecl)
                       (== (.getConstraintType fCurrentElemDecl) XSConstants/VC_FIXED))
              (.reportSchemaError
                this
                "cvc-elt.3.2.2"
                (new Object/1
                     [(.-rawname element)
                      (java-str SchemaSymbols/URI_XSI "," SchemaSymbols/XSI_NIL)])))
            (return true))))
    false)

  (method processAttributes ^void [this ^QName element ^XMLAttributes attributes
                                   ^XSAttributeGroupDecl attrGrp]
    (when DEBUG (.println System/out (java-str "==>processAttributes: " (.getLength attributes))))
    (let [^:mutable ^String wildcardIDName nil
          attCount (.getLength attributes)
          ^:mutable ^Augmentations augs nil
          ^:mutable ^AttributePSVImpl attrPSVI nil
          isSimple (or (nil? fCurrentType)
                       (== (.getTypeCategory fCurrentType) XSTypeDefinition/SIMPLE_TYPE))
          ^:mutable ^XSObjectList attrUses nil
          ^:mutable ^int useCount 0
          ^:mutable ^XSWildcardDecl attrWildcard nil]
      (when-not isSimple
        (set! attrUses (.getAttributeUses attrGrp))
        (set! useCount (.getLength attrUses))
        (set! attrWildcard (.-fAttributeWC attrGrp)))
      (loop [^int index 0]
        (when (< index attCount)
          (.getName attributes index fTempQName)
          (when DEBUG (.println System/out (java-str "==>process attribute: " fTempQName)))
          (when (or fAugPSVI fIdConstraint)
            (set! augs (.getAugmentations attributes index))
            (set! attrPSVI (cast AttributePSVImpl (.getItem augs Constants/ATTRIBUTE_PSVI)))
            (if (some? attrPSVI)
                (.reset attrPSVI)
                (do
                  (set! attrPSVI (AttributePSVImpl.))
                  (.putItem augs Constants/ATTRIBUTE_PSVI attrPSVI)))
            (set! (.-fValidationContext attrPSVI) fValidationRoot))
          (when (identical? (.-uri fTempQName) SchemaSymbols/URI_XSI)
            (let [^:mutable ^XSAttributeDecl attrDecl nil]
              (cond
                (identical? (.-localpart fTempQName) SchemaSymbols/XSI_TYPE)
                  (set! attrDecl XSI_TYPE)
                (identical? (.-localpart fTempQName) SchemaSymbols/XSI_NIL) (set! attrDecl XSI_NIL)
                (identical? (.-localpart fTempQName) SchemaSymbols/XSI_SCHEMALOCATION)
                  (set! attrDecl XSI_SCHEMALOCATION)
                (identical? (.-localpart fTempQName) SchemaSymbols/XSI_NONAMESPACESCHEMALOCATION)
                  (set! attrDecl XSI_NONAMESPACESCHEMALOCATION))
              (when (some? attrDecl)
                (.processOneAttribute this element attributes index attrDecl nil attrPSVI)
                (continue (unchecked-inc-int index)))))
          (cond
            (or (identical? (.-rawname fTempQName) XMLSymbols/PREFIX_XMLNS)
                (.startsWith (.-rawname fTempQName) "xmlns:"))
              (recur (unchecked-inc-int index))
            isSimple
              (do
                (.reportSchemaError this
                                    "cvc-type.3.1.1"
                                    (new Object/1 [(.-rawname element) (.-rawname fTempQName)]))
                (recur (unchecked-inc-int index)))
            :else
              (let [^:mutable ^XSAttributeUseImpl currUse nil
                    ^:mutable ^XSAttributeUseImpl oneUse nil]
                (loop [^int i 0]
                  (when (< i useCount)
                    (set! oneUse (cast XSAttributeUseImpl (.item attrUses i)))
                    (if (and (identical? (.-fName (.-fAttrDecl oneUse)) (.-localpart fTempQName))
                             (identical? (.-fTargetNamespace (.-fAttrDecl oneUse))
                                         (.-uri fTempQName)))
                        (set! currUse oneUse)
                        (recur (unchecked-inc-int i)))))
                (when (nil? currUse)
                  (when (or (nil? attrWildcard)
                            (not (.allowNamespace attrWildcard (.-uri fTempQName))))
                    (.reportSchemaError this
                                        "cvc-complex-type.3.2.2"
                                        (new Object/1 [(.-rawname element) (.-rawname fTempQName)]))
                    (set! fNFullValidationDepth fElementDepth)
                    (continue (unchecked-inc-int index))))
                (let [^:mutable ^XSAttributeDecl currDecl nil]
                  (if (some? currUse)
                      (set! currDecl (.-fAttrDecl currUse))
                      (do
                        (when (== (.-fProcessContents attrWildcard) XSWildcardDecl/PC_SKIP)
                          (continue (unchecked-inc-int index)))
                        (let [grammar (.findSchemaGrammar
                                        this
                                        XSDDescription/CONTEXT_ATTRIBUTE
                                        (.-uri fTempQName)
                                        element
                                        fTempQName
                                        attributes)]
                          (when (some? grammar)
                            (set! currDecl
                                  (.getGlobalAttributeDecl grammar (.-localpart fTempQName))))
                          (cond
                            (nil? currDecl)
                              (do
                                (when (== (.-fProcessContents attrWildcard)
                                          XSWildcardDecl/PC_STRICT)
                                  (.reportSchemaError
                                    this
                                    "cvc-complex-type.3.2.2"
                                    (new Object/1 [(.-rawname element) (.-rawname fTempQName)])))
                                (continue (unchecked-inc-int index)))
                            (and (== (.getTypeCategory (.-fType currDecl))
                                     XSTypeDefinition/SIMPLE_TYPE)
                                 (.isIDType (.-fType currDecl)))

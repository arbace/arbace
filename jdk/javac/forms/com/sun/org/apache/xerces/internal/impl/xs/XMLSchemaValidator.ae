  (field ^:private ^short fWhiteSpace -1)

  (field ^:private ^boolean fUnionType false)

  (field ^:private ^:final ^XSGrammarBucket fGrammarBucket (XSGrammarBucket.))

  (field ^:private ^:final ^SubstitutionGroupHandler fSubGroupHandler
    (SubstitutionGroupHandler. this))

  (field ^:private ^:final ^XSSimpleType fQNameDV
    (cast XSSimpleType (.getGlobalTypeDecl SchemaGrammar/SG_SchemaNS SchemaSymbols/ATTVAL_QNAME)))

  (field ^:private ^:final ^CMNodeFactory nodeFactory (CMNodeFactory.))

  (field ^:private ^:final ^CMBuilder fCMBuilder (CMBuilder. nodeFactory))

  (field ^:private ^:final ^XMLSchemaLoader fSchemaLoader
    (XMLSchemaLoader. (.-fErrorReporter fXSIErrorReporter)
                      fGrammarBucket
                      fSubGroupHandler
                      fCMBuilder))

  (field ^:private ^String fValidationRoot)

  (field ^:private ^int fSkipValidationDepth)

  (field ^:private ^int fNFullValidationDepth)

  (field ^:private ^int fNNoneValidationDepth)

  (field ^:private ^int fElementDepth)

  (field ^:private ^boolean fSubElement)

  (field ^:private ^boolean/1 fSubElementStack (new boolean/1 INITIAL_STACK_SIZE))

  (field ^:private ^XSElementDecl fCurrentElemDecl)

  (field ^:private ^XSElementDecl/1 fElemDeclStack (new XSElementDecl/1 INITIAL_STACK_SIZE))

  (field ^:private ^boolean fNil)

  (field ^:private ^boolean/1 fNilStack (new boolean/1 INITIAL_STACK_SIZE))

  (field ^:private ^XSNotationDecl fNotation)

  (field ^:private ^XSNotationDecl/1 fNotationStack (new XSNotationDecl/1 INITIAL_STACK_SIZE))

  (field ^:private ^XSTypeDefinition fCurrentType)

  (field ^:private ^XSTypeDefinition/1 fTypeStack (new XSTypeDefinition/1 INITIAL_STACK_SIZE))

  (field ^:private ^XSCMValidator fCurrentCM)

  (field ^:private ^XSCMValidator/1 fCMStack (new XSCMValidator/1 INITIAL_STACK_SIZE))

  (field ^:private ^int/1 fCurrCMState)

  (field ^:private ^int/2 fCMStateStack (new int/2 INITIAL_STACK_SIZE))

  (field ^:private ^boolean fStrictAssess true)

  (field ^:private ^boolean/1 fStrictAssessStack (new boolean/1 INITIAL_STACK_SIZE))

  (field ^:private ^:final ^StringBuilder fBuffer (StringBuilder.))

  (field ^:private ^boolean fAppendBuffer true)

  (field ^:private ^boolean fSawText false)

  (field ^:private ^boolean/1 fSawTextStack (new boolean/1 INITIAL_STACK_SIZE))

  (field ^:private ^boolean fSawCharacters false)

  (field ^:private ^boolean/1 fStringContent (new boolean/1 INITIAL_STACK_SIZE))

  (field ^:private ^:final ^QName fTempQName (QName.))

  (field ^:private ^javax.xml.namespace.QName fRootTypeQName nil)

  (field ^:private ^XSTypeDefinition fRootTypeDefinition nil)

  (field ^:private ^javax.xml.namespace.QName fRootElementDeclQName nil)

  (field ^:private ^XSElementDecl fRootElementDeclaration nil)

  (field ^:private ^int fIgnoreXSITypeDepth)

  (field ^:private ^boolean fIDCChecking)

  (field ^:private ^ValidatedInfo fValidatedInfo (ValidatedInfo.))

  (field ^:private ^ValidationState fState4XsiType (ValidationState.))

  (field ^:private ^ValidationState fState4ApplyDefault (ValidationState.))


                          (not (.equals value1 value2)))
                        (do (set! i next) (continue :LOOP))
                      (or (== valueType1 XSConstants/LIST_DT)
                          (== valueType1 XSConstants/LISTOFUNION_DT))
                        (let [list1 (aget fLocalItemValueTypes j)
                              list2 (.getItemValueTypeAt this i)]

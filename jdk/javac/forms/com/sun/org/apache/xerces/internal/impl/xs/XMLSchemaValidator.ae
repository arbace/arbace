  (defclass ^:protected ValueStoreCache
    (field ^:final ^LocalIDKey fLocalId (LocalIDKey.))

    (field ^:protected ^:final ^{:tag (List ValueStoreBase)} fValueStores (ArrayList.))

    (field ^:protected ^:final ^{:tag (Map LocalIDKey ValueStoreBase)} fIdentityConstraint2ValueStoreMap
      (HashMap.))

    (field ^:protected ^:final ^{:tag (Stack (Map IdentityConstraint ValueStoreBase))} fGlobalMapStack
      (Stack.))

    (field ^:protected ^:final ^{:tag (Map IdentityConstraint ValueStoreBase)} fGlobalIDConstraintMap
      (HashMap.))

    (constructor ^:public [this])

    (method ^:public startDocument ^void [this]
      (.clear fValueStores)
      (.clear fIdentityConstraint2ValueStoreMap)
      (.clear fGlobalIDConstraintMap)
      (.removeAllElements fGlobalMapStack))

    (method ^:public startElement ^void [this]

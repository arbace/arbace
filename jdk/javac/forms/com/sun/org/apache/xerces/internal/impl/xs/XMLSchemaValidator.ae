          (.push fGlobalMapStack (cast Map (.clone (cast HashMap fGlobalIDConstraintMap))))
          (.push fGlobalMapStack nil))
      (.clear fGlobalIDConstraintMap))

    (method ^:public endElement ^void [this]
      (when-not (.isEmpty fGlobalMapStack)
        (let [^{:tag (Map IdentityConstraint ValueStoreBase)} oldMap (cast
                                                                       Map
                                                                       (.pop fGlobalMapStack))]
          (when (some? oldMap)
            (for-each [^{:tag (Map$Entry IdentityConstraint ValueStoreBase)} entry (.entrySet
                                                                                     oldMap)]
              (let [id (cast IdentityConstraint (.getKey entry))
                    oldVal (cast ValueStoreBase (.getValue entry))]
                (when (some? oldVal)
                  (let [currVal (cast ValueStoreBase (.get fGlobalIDConstraintMap id))]
                    (if (nil? currVal)
                        (.put fGlobalIDConstraintMap id oldVal)
                        (when-not (identical? currVal oldVal) (.append currVal oldVal)))))))))))

    (method ^:public initValueStoresFor ^void [this ^XSElementDecl eDecl ^FieldActivator activator]
      (let [icArray (.-fIDConstraints eDecl)
            icCount (.-fIDCPos eDecl)]
        (loop [^int i 0]
          (when (< i icCount)
            (let [^:mutable ^LocalIDKey toHash nil]
              (switch (.getCategory (aget icArray i))
                IdentityConstraint/IC_UNIQUE
                  (let [unique (cast UniqueOrKey (aget icArray i))]
                    (set! toHash (LocalIDKey. unique fElementDepth))
                    (let [^:mutable uniqueValueStore (cast
                                                       UniqueValueStore
                                                       (.get
                                                         fIdentityConstraint2ValueStoreMap
                                                         toHash))]
                      (if (nil? uniqueValueStore)
                          (do
                            (set! uniqueValueStore (UniqueValueStore. unique))
                            (.put fIdentityConstraint2ValueStoreMap toHash uniqueValueStore))
                          (.clear uniqueValueStore))
                      (.add fValueStores uniqueValueStore)
                      (.activateSelectorFor XMLSchemaValidator/this (aget icArray i))
                      (recur (unchecked-inc-int i))))
                IdentityConstraint/IC_KEY
                  (let [key (cast UniqueOrKey (aget icArray i))]
                    (set! toHash (LocalIDKey. key fElementDepth))
                    (let [^:mutable keyValueStore (cast
                                                    KeyValueStore
                                                    (.get fIdentityConstraint2ValueStoreMap toHash))]
                      (if (nil? keyValueStore)
                          (do
                            (set! keyValueStore (KeyValueStore. key))
                            (.put fIdentityConstraint2ValueStoreMap toHash keyValueStore))
                          (.clear keyValueStore))
                      (.add fValueStores keyValueStore)
                      (.activateSelectorFor XMLSchemaValidator/this (aget icArray i))
                      (recur (unchecked-inc-int i))))
                IdentityConstraint/IC_KEYREF
                  (let [keyRef (cast KeyRef (aget icArray i))]
                    (set! toHash (LocalIDKey. keyRef fElementDepth))
                    (let [^:mutable keyRefValueStore (cast
                                                       KeyRefValueStore
                                                       (.get
                                                         fIdentityConstraint2ValueStoreMap
                                                         toHash))]
                      (if (nil? keyRefValueStore)
                          (do
                            (set! keyRefValueStore (KeyRefValueStore. keyRef nil))
                            (.put fIdentityConstraint2ValueStoreMap toHash keyRefValueStore))
                          (.clear keyRefValueStore))
                      (.add fValueStores keyRefValueStore)
                      (.activateSelectorFor XMLSchemaValidator/this (aget icArray i))
                      (recur (unchecked-inc-int i))))
                (recur (unchecked-inc-int i))))))))

    (method ^:public getValueStoreFor ^ValueStoreBase [this ^IdentityConstraint id ^int initialDepth]
      (set! (.-fDepth fLocalId) initialDepth)
      (set! (.-fId fLocalId) id)
      (cast ValueStoreBase (.get fIdentityConstraint2ValueStoreMap fLocalId)))

    (method ^:public getGlobalValueStoreFor ^ValueStoreBase [this ^IdentityConstraint id]
      (cast ValueStoreBase (.get fGlobalIDConstraintMap id)))

    (method ^:public transplant ^void [this ^IdentityConstraint id ^int initialDepth]
      (set! (.-fDepth fLocalId) initialDepth)
      (set! (.-fId fLocalId) id)
      (let [newVals (cast ValueStoreBase (.get fIdentityConstraint2ValueStoreMap fLocalId))]
        (when-not (== (.getCategory id) IdentityConstraint/IC_KEYREF)
          (let [currVals (cast ValueStoreBase (.get fGlobalIDConstraintMap id))]
            (if (some? currVals)
                (do (.append currVals newVals) (.put fGlobalIDConstraintMap id currVals))
                (.put fGlobalIDConstraintMap id newVals))))))

    (method ^:public endDocument ^void [this]
      (for-each [^ValueStoreBase valueStore fValueStores] (.endDocument valueStore)))

    (method ^:public toString ^String [this]
      (let [s (.toString super)
            index1 (.lastIndexOf s \$)]
        (if (not (== index1 -1))
            (.substring s (unchecked-add-int index1 1))
            (let [index2 (.lastIndexOf s \.)]
              (if (not (== index2 -1)) (.substring s (unchecked-add-int index2 1)) s))))))


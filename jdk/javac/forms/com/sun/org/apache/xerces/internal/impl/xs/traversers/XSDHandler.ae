        (.put fGlobalIDConstraintDecls declKey decl))))

  (method ^:private getGlobalAttributeDecl ^XSAttributeDecl [this ^String declKey]
    (cast XSAttributeDecl (.get fGlobalAttrDecls declKey)))

  (method ^:private getGlobalAttributeGroupDecl ^XSAttributeGroupDecl [this ^String declKey]
    (cast XSAttributeGroupDecl (.get fGlobalAttrGrpDecls declKey)))

  (method ^:private getGlobalElementDecl ^XSElementDecl [this ^String declKey]
    (cast XSElementDecl (.get fGlobalElemDecls declKey)))

  (method ^:private getGlobalGroupDecl ^XSGroupDecl [this ^String declKey]
    (cast XSGroupDecl (.get fGlobalGroupDecls declKey)))


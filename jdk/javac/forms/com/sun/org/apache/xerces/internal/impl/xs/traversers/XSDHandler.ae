      (cond
        (nil? sg) true
        (.isImmutable sg) false
        :else
          (let [componentType (.getType component)
                ^:final name (.getName component)]
            (switch componentType
              XSConstants/TYPE_DEFINITION
                (when (identical? (.getGlobalTypeDecl sg name) component) (return true))
              XSConstants/ATTRIBUTE_DECLARATION
                (when (identical? (.getGlobalAttributeDecl sg name) component) (return true))
              XSConstants/ATTRIBUTE_GROUP
                (when (identical? (.getGlobalAttributeDecl sg name) component) (return true))
              XSConstants/ELEMENT_DECLARATION
                (when (identical? (.getGlobalElementDecl sg name) component) (return true))
              XSConstants/MODEL_GROUP_DEFINITION
                (when (identical? (.getGlobalGroupDecl sg name) component) (return true))

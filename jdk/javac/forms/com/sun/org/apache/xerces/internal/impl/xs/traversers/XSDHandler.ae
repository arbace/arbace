          ^:mutable len (.getLength components)
          ^:mutable ^XSNotationDecl srcDecl nil
          ^:mutable ^XSNotationDecl dstDecl nil]
      (loop [^int i 0]
        (when (< i len)
          (set! srcDecl (cast XSNotationDecl (.item components i)))
          (set! dstDecl (.getGlobalNotationDecl dstGrammar (.getName srcDecl)))
          (cond
            (nil? dstDecl)
              (do (.addGlobalNotationDecl dstGrammar srcDecl) (recur (unchecked-inc-int i)))
            (and (not (identical? dstDecl srcDecl)) (not fTolerateDuplicates))
              (do
                (.reportSharingError this (.getNamespace srcDecl) (.getName srcDecl))
                (recur (unchecked-inc-int i)))
            :else (recur (unchecked-inc-int i)))))
      (let [componentsExt (.getComponentsExt srcGrammar XSConstants/NOTATION_DECLARATION)]
        (set! len (.getLength componentsExt))
        (loop [^int i 0]
          (when (< i len)
            (let [^:final key (cast String (.item componentsExt i))
                  ^:final index (.indexOf key \,)
                  ^:final location (.substring key 0 index)
                  ^:final name (.substring key (unchecked-add-int index 1) (.length key))]
              (set! srcDecl (cast XSNotationDecl (.item componentsExt (unchecked-add-int i 1))))
              (set! dstDecl (.getGlobalNotationDecl dstGrammar name location))
              (cond
                (nil? dstDecl)
                  (do
                    (.addGlobalNotationDecl dstGrammar srcDecl location)
                    (recur (unchecked-add-int i 2)))
                (not (identical? dstDecl srcDecl)) (recur (unchecked-add-int i 2))
                :else (recur (unchecked-add-int i 2)))))))))

  (method ^:private addGlobalGroupDecls ^void [this ^SchemaGrammar srcGrammar
                                               ^SchemaGrammar dstGrammar]
    (let [components (.getComponents srcGrammar XSConstants/MODEL_GROUP_DEFINITION)
          ^:mutable len (.getLength components)
          ^:mutable ^XSGroupDecl srcDecl nil
          ^:mutable ^XSGroupDecl dstDecl nil]
      (loop [^int i 0]
        (when (< i len)
          (set! srcDecl (cast XSGroupDecl (.item components i)))
          (set! dstDecl (.getGlobalGroupDecl dstGrammar (.getName srcDecl)))
          (cond
            (nil? dstDecl)
              (do (.addGlobalGroupDecl dstGrammar srcDecl) (recur (unchecked-inc-int i)))
            (and (not (identical? srcDecl dstDecl)) (not fTolerateDuplicates))
              (do
                (.reportSharingError this (.getNamespace srcDecl) (.getName srcDecl))
                (recur (unchecked-inc-int i)))
            :else (recur (unchecked-inc-int i)))))
      (let [componentsExt (.getComponentsExt srcGrammar XSConstants/MODEL_GROUP_DEFINITION)]
        (set! len (.getLength componentsExt))
        (loop [^int i 0]
          (when (< i len)
            (let [^:final key (cast String (.item componentsExt i))
                  ^:final index (.indexOf key \,)
                  ^:final location (.substring key 0 index)
                  ^:final name (.substring key (unchecked-add-int index 1) (.length key))]
              (set! srcDecl (cast XSGroupDecl (.item componentsExt (unchecked-add-int i 1))))
              (set! dstDecl (.getGlobalGroupDecl dstGrammar name location))
              (cond
                (nil? dstDecl)
                  (do
                    (.addGlobalGroupDecl dstGrammar srcDecl location)
                    (recur (unchecked-add-int i 2)))
                (not (identical? dstDecl srcDecl)) (recur (unchecked-add-int i 2))
                :else (recur (unchecked-add-int i 2)))))))))

  (method ^:private addGlobalTypeDecls ^void [this ^SchemaGrammar srcGrammar
                                              ^SchemaGrammar dstGrammar]
    (let [components (.getComponents srcGrammar XSConstants/TYPE_DEFINITION)
          ^:mutable len (.getLength components)
          ^:mutable ^XSTypeDefinition srcDecl nil
          ^:mutable ^XSTypeDefinition dstDecl nil]
      (loop [^int i 0]
        (when (< i len)
          (set! srcDecl (cast XSTypeDefinition (.item components i)))
          (set! dstDecl (.getGlobalTypeDecl dstGrammar (.getName srcDecl)))
          (cond
            (nil? dstDecl)
              (do (.addGlobalTypeDecl dstGrammar srcDecl) (recur (unchecked-inc-int i)))
            (and (not (identical? dstDecl srcDecl)) (not fTolerateDuplicates))
              (do
                (.reportSharingError this (.getNamespace srcDecl) (.getName srcDecl))
                (recur (unchecked-inc-int i)))
            :else (recur (unchecked-inc-int i)))))
      (let [componentsExt (.getComponentsExt srcGrammar XSConstants/TYPE_DEFINITION)]
        (set! len (.getLength componentsExt))
        (loop [^int i 0]
          (when (< i len)
            (let [^:final key (cast String (.item componentsExt i))
                  ^:final index (.indexOf key \,)
                  ^:final location (.substring key 0 index)
                  ^:final name (.substring key (unchecked-add-int index 1) (.length key))]
              (set! srcDecl (cast XSTypeDefinition (.item componentsExt (unchecked-add-int i 1))))
              (set! dstDecl (.getGlobalTypeDecl dstGrammar name location))
              (cond
                (nil? dstDecl)
                  (do
                    (.addGlobalTypeDecl dstGrammar srcDecl location)
                    (recur (unchecked-add-int i 2)))
                (not (identical? dstDecl srcDecl)) (recur (unchecked-add-int i 2))
                :else (recur (unchecked-add-int i 2)))))))))

  (method ^:private expandComponents ^{:tag (List XSObject)} [this ^XSObject/1 components
                                                              ^{:tag (Map String (List String))} dependencies]
    (let [^{:tag (List XSObject)} newComponents (ArrayList.)]
      (loop [^int i 0]
        (if (< i (alength components))
            (if (not (.contains newComponents (aget components i)))
                (do (.add newComponents (aget components i)) (recur (unchecked-inc-int i)))
                (recur (unchecked-inc-int i)))
            nil))
      (loop [^int i 0]
        (when (< i (.size newComponents))
          (let [^:final component (cast XSObject (.get newComponents i))]
            (.expandRelatedComponents this component newComponents dependencies)
            (recur (unchecked-inc-int i)))))
      newComponents))

  (method ^:private expandRelatedComponents ^void [this ^XSObject component
                                                   ^{:tag (List XSObject)} componentList
                                                   ^{:tag (Map String (List String))} dependencies]
    (let [componentType (.getType component)]
      (switch componentType
        XSConstants/TYPE_DEFINITION
          (.expandRelatedTypeComponents this
                                        (cast XSTypeDefinition component)
                                        componentList
                                        (.getNamespace component)
                                        dependencies)
        XSConstants/ATTRIBUTE_DECLARATION
          (.expandRelatedAttributeComponents this
                                             (cast XSAttributeDeclaration component)
                                             componentList
                                             (.getNamespace component)
                                             dependencies)
        XSConstants/ATTRIBUTE_GROUP
          (do
            (.expandRelatedAttributeGroupComponents
              this
              (cast XSAttributeGroupDefinition component)
              componentList
              (.getNamespace component)
              dependencies)
            (.expandRelatedElementComponents this
                                             (cast XSElementDeclaration component)
                                             componentList
                                             (.getNamespace component)
                                             dependencies))
        XSConstants/ELEMENT_DECLARATION
          (.expandRelatedElementComponents this
                                           (cast XSElementDeclaration component)
                                           componentList
                                           (.getNamespace component)
                                           dependencies)
        XSConstants/MODEL_GROUP_DEFINITION
          (.expandRelatedModelGroupDefinitionComponents
            this
            (cast XSModelGroupDefinition component)
            componentList
            (.getNamespace component)
            dependencies)
        nil)))

  (method ^:private expandRelatedAttributeComponents ^void [this ^XSAttributeDeclaration decl
                                                            ^{:tag (List XSObject)} componentList
                                                            ^String namespace
                                                            ^{:tag (Map String (List String))} dependencies]
    (.addRelatedType this (.getTypeDefinition decl) componentList namespace dependencies))

  (method ^:private expandRelatedElementComponents ^void [this ^XSElementDeclaration decl
                                                          ^{:tag (List XSObject)} componentList
                                                          ^String namespace
                                                          ^{:tag (Map String (List String))} dependencies]
    (.addRelatedType this (.getTypeDefinition decl) componentList namespace dependencies)
    (let [^:final subElemDecl (.getSubstitutionGroupAffiliation decl)]
      (when (some? subElemDecl)
        (.addRelatedElement this subElemDecl componentList namespace dependencies))))

  (method ^:private expandRelatedTypeComponents ^void [this ^XSTypeDefinition type
                                                       ^{:tag (List XSObject)} componentList
                                                       ^String namespace
                                                       ^{:tag (Map String (List String))} dependencies]
    (cond
      (instance? XSComplexTypeDecl type)
        (.expandRelatedComplexTypeComponents this
                                             (cast XSComplexTypeDecl type)
                                             componentList
                                             namespace
                                             dependencies)
      (instance? XSSimpleTypeDecl type)
        (.expandRelatedSimpleTypeComponents this
                                            (cast XSSimpleTypeDefinition type)
                                            componentList
                                            namespace
                                            dependencies)))

  (method ^:private expandRelatedModelGroupDefinitionComponents ^void [this
                                                                       ^XSModelGroupDefinition modelGroupDef
                                                                       ^{:tag (List XSObject)} componentList
                                                                       ^String namespace
                                                                       ^{:tag (Map String (List String))} dependencies]
    (.expandRelatedModelGroupComponents this
                                        (.getModelGroup modelGroupDef)
                                        componentList
                                        namespace
                                        dependencies))

  (method ^:private expandRelatedAttributeGroupComponents ^void [this
                                                                 ^XSAttributeGroupDefinition attrGroup
                                                                 ^{:tag (List XSObject)} componentList
                                                                 ^String namespace
                                                                 ^{:tag (Map String (List String))} dependencies]
    (.expandRelatedAttributeUsesComponents this
                                           (.getAttributeUses attrGroup)
                                           componentList
                                           namespace
                                           dependencies))

  (method ^:private expandRelatedComplexTypeComponents ^void [this ^XSComplexTypeDecl type
                                                              ^{:tag (List XSObject)} componentList
                                                              ^String namespace
                                                              ^{:tag (Map String (List String))} dependencies]
    (.addRelatedType this (.getBaseType type) componentList namespace dependencies)
    (.expandRelatedAttributeUsesComponents this
                                           (.getAttributeUses type)
                                           componentList
                                           namespace
                                           dependencies)
    (let [^:final particle (.getParticle type)]
      (when (some? particle)
        (.expandRelatedParticleComponents this particle componentList namespace dependencies))))

  (method ^:private expandRelatedSimpleTypeComponents ^void [this ^XSSimpleTypeDefinition type
                                                             ^{:tag (List XSObject)} componentList
                                                             ^String namespace
                                                             ^{:tag (Map String (List String))} dependencies]
    (let [^:final baseType (.getBaseType type)]
      (when (some? baseType) (.addRelatedType this baseType componentList namespace dependencies))
      (let [^:final ^XSTypeDefinition itemType (.getItemType type)]
        (when (some? itemType) (.addRelatedType this itemType componentList namespace dependencies))
        (let [^:final ^XSTypeDefinition primitiveType (.getPrimitiveType type)]
          (when (some? primitiveType)
            (.addRelatedType this primitiveType componentList namespace dependencies))
          (let [^:final memberTypes (.getMemberTypes type)]
            (when (> (.size memberTypes) 0)
              (loop [^int i 0]
                (when (< i (.size memberTypes))
                  (.addRelatedType this
                                   (cast XSTypeDefinition (.item memberTypes i))
                                   componentList
                                   namespace
                                   dependencies)
                  (recur (unchecked-inc-int i))))))))))

  (method ^:private expandRelatedAttributeUsesComponents ^void [this ^XSObjectList attrUses
                                                                ^{:tag (List XSObject)} componentList
                                                                ^String namespace
                                                                ^{:tag (Map String (List String))} dependencies]
    (let [^:final ^int attrUseSize (if (nil? attrUses) 0 (.size attrUses))]
      (loop [^int i 0]
        (when (< i attrUseSize)
          (.expandRelatedAttributeUseComponents this
                                                (cast XSAttributeUse (.item attrUses i))
                                                componentList
                                                namespace
                                                dependencies)
          (recur (unchecked-inc-int i))))))

  (method ^:private expandRelatedAttributeUseComponents ^void [this ^XSAttributeUse component
                                                               ^{:tag (List XSObject)} componentList
                                                               ^String namespace
                                                               ^{:tag (Map String (List String))} dependencies]
    (.addRelatedAttribute this (.getAttrDeclaration component) componentList namespace dependencies))

  (method ^:private expandRelatedParticleComponents ^void [this ^XSParticle component
                                                           ^{:tag (List XSObject)} componentList
                                                           ^String namespace
                                                           ^{:tag (Map String (List String))} dependencies]
    (let [term (.getTerm component)]
      (switch (.getType term)
        XSConstants/ELEMENT_DECLARATION
          (.addRelatedElement this
                              (cast XSElementDeclaration term)
                              componentList
                              namespace
                              dependencies)
        XSConstants/MODEL_GROUP
          (.expandRelatedModelGroupComponents this
                                              (cast XSModelGroup term)
                                              componentList
                                              namespace
                                              dependencies)
        nil)))

  (method ^:private expandRelatedModelGroupComponents ^void [this ^XSModelGroup modelGroup
                                                             ^{:tag (List XSObject)} componentList
                                                             ^String namespace
                                                             ^{:tag (Map String (List String))} dependencies]
    (let [particles (.getParticles modelGroup)
          ^:final ^int length (if (nil? particles) 0 (.getLength particles))]
      (loop [^int i 0]
        (when (< i length)
          (.expandRelatedParticleComponents this
                                            (cast XSParticle (.item particles i))
                                            componentList
                                            namespace
                                            dependencies)
          (recur (unchecked-inc-int i))))))

  (method ^:private addRelatedType ^void [this ^XSTypeDefinition type
                                          ^{:tag (List XSObject)} componentList ^String namespace
                                          ^{:tag (Map String (List String))} dependencies]
    (if (not (.getAnonymous type))
        (when-not (.equals SchemaSymbols/URI_SCHEMAFORSCHEMA (.getNamespace type))
          (when-not (.contains componentList type)
            (let [^:final ^{:tag (List String)} importedNamespaces (.findDependentNamespaces
                                                                     this
                                                                     namespace
                                                                     dependencies)]
              (.addNamespaceDependency this namespace (.getNamespace type) importedNamespaces)
              (.add componentList type))))
        (.expandRelatedTypeComponents this type componentList namespace dependencies)))

  (method ^:private addRelatedElement ^void [this ^XSElementDeclaration decl
                                             ^{:tag (List XSObject)} componentList ^String namespace
                                             ^{:tag (Map String (List String))} dependencies]
    (if (== (.getScope decl) XSConstants/SCOPE_GLOBAL)
        (when-not (.contains componentList decl)
          (let [^{:tag (List String)} importedNamespaces (.findDependentNamespaces
                                                           this
                                                           namespace
                                                           dependencies)]
            (.addNamespaceDependency this namespace (.getNamespace decl) importedNamespaces)
            (.add componentList decl)))
        (.expandRelatedElementComponents this decl componentList namespace dependencies)))

  (method ^:private addRelatedAttribute ^void [this ^XSAttributeDeclaration decl
                                               ^{:tag (List XSObject)} componentList
                                               ^String namespace
                                               ^{:tag (Map String (List String))} dependencies]
    (if (== (.getScope decl) XSConstants/SCOPE_GLOBAL)
        (when-not (.contains componentList decl)
          (let [^{:tag (List String)} importedNamespaces (.findDependentNamespaces
                                                           this
                                                           namespace
                                                           dependencies)]
            (.addNamespaceDependency this namespace (.getNamespace decl) importedNamespaces)
            (.add componentList decl)))
        (.expandRelatedAttributeComponents this decl componentList namespace dependencies)))

  (method ^:private addGlobalComponents ^void [this ^{:tag (List XSObject)} components
                                               ^{:tag (Map String (List String))} importDependencies]
    (let [^:final desc (XSDDescription.)
          ^:final size (.size components)]
      (loop [^int i 0]
        (when (< i size)
          (.addGlobalComponent this (cast XSObject (.get components i)) desc)
          (recur (unchecked-inc-int i))))
      (.updateImportDependencies this importDependencies)))

  (method ^:private addGlobalComponent ^void [this ^XSObject component ^XSDDescription desc]
    (let [^:final namespace (.getNamespace component)]
      (.setNamespace desc namespace)
      (let [^:final sg (.getSchemaGrammar this desc)
            componentType (.getType component)
            ^:final name (.getName component)]
        (switch componentType
          XSConstants/TYPE_DEFINITION
            (when-not (.getAnonymous (cast XSTypeDefinition component))
              (when (nil? (.getGlobalTypeDecl sg name))
                (.addGlobalTypeDecl sg (cast XSTypeDefinition component)))
              (when (nil? (.getGlobalTypeDecl sg name ""))
                (.addGlobalTypeDecl sg (cast XSTypeDefinition component) "")))
          XSConstants/ATTRIBUTE_DECLARATION
            (when (== (.getScope (cast XSAttributeDecl component)) XSAttributeDecl/SCOPE_GLOBAL)
              (when (nil? (.getGlobalAttributeDecl sg name))
                (.addGlobalAttributeDecl sg (cast XSAttributeDecl component)))
              (when (nil? (.getGlobalAttributeDecl sg name ""))
                (.addGlobalAttributeDecl sg (cast XSAttributeDecl component) "")))
          XSConstants/ATTRIBUTE_GROUP
            (do
              (when (nil? (.getGlobalAttributeDecl sg name))
                (.addGlobalAttributeGroupDecl sg (cast XSAttributeGroupDecl component)))
              (when (nil? (.getGlobalAttributeDecl sg name ""))
                (.addGlobalAttributeGroupDecl sg (cast XSAttributeGroupDecl component) "")))
          XSConstants/ELEMENT_DECLARATION
            (when (== (.getScope (cast XSElementDecl component)) XSElementDecl/SCOPE_GLOBAL)
              (.addGlobalElementDeclAll sg (cast XSElementDecl component))
              (when (nil? (.getGlobalElementDecl sg name))
                (.addGlobalElementDecl sg (cast XSElementDecl component)))
              (when (nil? (.getGlobalElementDecl sg name ""))
                (.addGlobalElementDecl sg (cast XSElementDecl component) "")))
          XSConstants/MODEL_GROUP_DEFINITION
            (do
              (when (nil? (.getGlobalGroupDecl sg name))
                (.addGlobalGroupDecl sg (cast XSGroupDecl component)))
              (when (nil? (.getGlobalGroupDecl sg name ""))
                (.addGlobalGroupDecl sg (cast XSGroupDecl component) "")))
          XSConstants/NOTATION_DECLARATION
            (do
              (when (nil? (.getGlobalNotationDecl sg name))
                (.addGlobalNotationDecl sg (cast XSNotationDecl component)))
              (when (nil? (.getGlobalNotationDecl sg name ""))
                (.addGlobalNotationDecl sg (cast XSNotationDecl component) "")))
          nil))))

  (method ^:private updateImportDependencies ^void [this ^{:tag (Map String (List String))} table]
    (when (some? table)
      (let [^:mutable ^String namespace nil
            ^:mutable ^{:tag (List String)} importList nil]
        (for-each [^{:tag (Map$Entry String (List String))} entry (.entrySet table)]
          (set! namespace (cast String (.getKey entry)))
          (set! importList (cast List (.getValue entry)))
          (when (> (.size importList) 0) (.expandImportList this namespace importList))))))

  (method ^:private expandImportList ^void [this ^String namespace
                                            ^{:tag (List String)} namespaceList]
    (let [sg (.getGrammar fGrammarBucket namespace)]
      (when (some? sg)
        (let [^:mutable ^{:tag (List SchemaGrammar)} isgs (.getImportedGrammars sg)]
          (if (nil? isgs)
              (do
                (set! isgs (ArrayList.))
                (.addImportList this sg isgs namespaceList)
                (.setImportedGrammars sg isgs))
              (.updateImportList this sg isgs namespaceList))))))

  (method ^:private addImportList ^void [this ^SchemaGrammar sg
                                         ^{:tag (List SchemaGrammar)} importedGrammars
                                         ^{:tag (List String)} namespaceList]
    (let [^:final size (.size namespaceList)
          ^:mutable ^SchemaGrammar isg nil]
      (loop [^int i 0]
        (when (< i size)
          (set! isg (.getGrammar fGrammarBucket (cast String (.get namespaceList i))))
          (if (some? isg)
              (do (.add importedGrammars isg) (recur (unchecked-inc-int i)))
              (recur (unchecked-inc-int i)))))))

  (method ^:private updateImportList ^void [this ^SchemaGrammar sg
                                            ^{:tag (List SchemaGrammar)} importedGrammars
                                            ^{:tag (List String)} namespaceList]
    (let [^:final size (.size namespaceList)
          ^:mutable ^SchemaGrammar isg nil]
      (loop [^int i 0]
        (when (< i size)
          (set! isg (.getGrammar fGrammarBucket (cast String (.get namespaceList i))))
          (if (some? isg)
              (if (not (.containedImportedGrammar this importedGrammars isg))
                  (do (.add importedGrammars isg) (recur (unchecked-inc-int i)))
                  (recur (unchecked-inc-int i)))
              (recur (unchecked-inc-int i)))))))

  (method ^:private containedImportedGrammar ^boolean [this
                                                       ^{:tag (List SchemaGrammar)} importedGrammar
                                                       ^SchemaGrammar grammar]
    (let [^:final size (.size importedGrammar)
          ^:mutable ^SchemaGrammar sg nil]
      (loop [^int i 0]
        (when (< i size)
          (set! sg (cast SchemaGrammar (.get importedGrammar i)))
          (if (.equals (.null2EmptyString this (.getTargetNamespace sg))
                       (.null2EmptyString this (.getTargetNamespace grammar)))
              (return true)
              (recur (unchecked-inc-int i)))))
      false))

  (method ^:private getSchemaGrammar ^SchemaGrammar [this ^XSDDescription desc]
    (let [^:mutable sg (.findGrammar this desc fNamespaceGrowth)]
      (cond
        (nil? sg)
          (do
            (set! sg (SchemaGrammar. (.getNamespace desc) (.makeClone desc) fSymbolTable))
            (.putGrammar fGrammarBucket sg))
        (.isImmutable sg) (set! sg (.createGrammarFrom this sg)))
      sg))

  (method ^:private findDependentNamespaces ^{:tag (List String)} [this ^String namespace
                                                                   ^{:tag (Map String (List String))} table]
    (let [^:final ns (.null2EmptyString this namespace)
          ^:mutable ^{:tag (List String)} namespaceList (.getFromMap this table ns)]
      (when (nil? namespaceList) (set! namespaceList (ArrayList.)) (.put table ns namespaceList))
      namespaceList))

  (method ^:private addNamespaceDependency ^void [this ^String namespace1 ^String namespace2
                                                  ^{:tag (List String)} list]
    (let [^:final ns1 (.null2EmptyString this namespace1)
          ^:final ns2 (.null2EmptyString this namespace2)]
      (when-not (.equals ns1 ns2) (when-not (.contains list ns2) (.add list ns2)))))

  (method ^:private reportSharingError ^void [this ^String namespace ^String name]
    (let [^:final ^String qName (if (nil? namespace)
                                    (java-str "," name)
                                    (java-str namespace "," name))]
      (.reportSchemaError this "sch-props-correct.2" (new Object/1 [qName]) nil)))

  (method ^:private createTraversers ^void [this]
    (set! fAttributeChecker (XSAttributeChecker. this))
    (set! fAttributeGroupTraverser (XSDAttributeGroupTraverser. this fAttributeChecker))
    (set! fAttributeTraverser (XSDAttributeTraverser. this fAttributeChecker))
    (set! fComplexTypeTraverser (XSDComplexTypeTraverser. this fAttributeChecker))
    (set! fElementTraverser (XSDElementTraverser. this fAttributeChecker))
    (set! fGroupTraverser (XSDGroupTraverser. this fAttributeChecker))
    (set! fKeyrefTraverser (XSDKeyrefTraverser. this fAttributeChecker))
    (set! fNotationTraverser (XSDNotationTraverser. this fAttributeChecker))
    (set! fSimpleTypeTraverser (XSDSimpleTypeTraverser. this fAttributeChecker))
    (set! fUniqueOrKeyTraverser (XSDUniqueOrKeyTraverser. this fAttributeChecker))
    (set! fWildCardTraverser (XSDWildcardTraverser. this fAttributeChecker)))

  (method prepareForParse ^void [this]
    (.clear fTraversed)
    (.clear fDoc2SystemId)
    (.clear fHiddenNodes)
    (set! fLastSchemaWasDuplicate false))

  (method prepareForTraverse ^void [this]
    (when-not registryEmpty
      (.clear fUnparsedAttributeRegistry)
      (.clear fUnparsedAttributeGroupRegistry)
      (.clear fUnparsedElementRegistry)
      (.clear fUnparsedGroupRegistry)
      (.clear fUnparsedIdentityConstraintRegistry)
      (.clear fUnparsedNotationRegistry)
      (.clear fUnparsedTypeRegistry)
      (.clear fUnparsedAttributeRegistrySub)
      (.clear fUnparsedAttributeGroupRegistrySub)
      (.clear fUnparsedElementRegistrySub)
      (.clear fUnparsedGroupRegistrySub)
      (.clear fUnparsedIdentityConstraintRegistrySub)
      (.clear fUnparsedNotationRegistrySub)
      (.clear fUnparsedTypeRegistrySub))
    (loop [^int i 1]
      (if (<= i TYPEDECL_TYPE)
          (if (some? (aget fUnparsedRegistriesExt i))
              (do (.clear (aget fUnparsedRegistriesExt i)) (recur (unchecked-inc-int i)))
              (recur (unchecked-inc-int i)))
          nil))
    (.clear fDependencyMap)
    (.clear fDoc2XSDocumentMap)
    (when (some? fRedefine2XSDMap) (.clear fRedefine2XSDMap))
    (when (some? fRedefine2NSSupport) (.clear fRedefine2NSSupport))
    (.clear fAllTNSs)
    (.clear fImportMap)
    (set! fRoot nil)
    (loop [^int i 0]
      (when (< i fLocalElemStackPos)
        (aset fParticle i nil)
        (aset fLocalElementDecl i nil)
        (aset fLocalElementDecl_schema i nil)
        (aset fLocalElemNamespaceContext i nil)
        (recur (unchecked-inc-int i))))
    (set! fLocalElemStackPos 0)
    (loop [^int i 0]
      (when (< i fKeyrefStackPos)
        (aset fKeyrefs i nil)
        (aset fKeyrefElems i nil)
        (aset fKeyrefNamespaceContext i nil)
        (aset fKeyrefsMapXSDocumentInfo i nil)
        (recur (unchecked-inc-int i))))
    (set! fKeyrefStackPos 0)
    (when (nil? fAttributeChecker) (.createTraversers this))
    (let [locale (.getLocale fErrorReporter)]
      (.reset fAttributeChecker fSymbolTable)
      (.reset fAttributeGroupTraverser fSymbolTable fValidateAnnotations locale)
      (.reset fAttributeTraverser fSymbolTable fValidateAnnotations locale)
      (.reset fComplexTypeTraverser fSymbolTable fValidateAnnotations locale)
      (.reset fElementTraverser fSymbolTable fValidateAnnotations locale)
      (.reset fGroupTraverser fSymbolTable fValidateAnnotations locale)
      (.reset fKeyrefTraverser fSymbolTable fValidateAnnotations locale)
      (.reset fNotationTraverser fSymbolTable fValidateAnnotations locale)
      (.reset fSimpleTypeTraverser fSymbolTable fValidateAnnotations locale)
      (.reset fUniqueOrKeyTraverser fSymbolTable fValidateAnnotations locale)
      (.reset fWildCardTraverser fSymbolTable fValidateAnnotations locale)
      (.clear fRedefinedRestrictedAttributeGroupRegistry)
      (.clear fRedefinedRestrictedGroupRegistry)
      (.clear fGlobalAttrDecls)
      (.clear fGlobalAttrGrpDecls)
      (.clear fGlobalElemDecls)
      (.clear fGlobalGroupDecls)
      (.clear fGlobalNotationDecls)
      (.clear fGlobalIDConstraintDecls)
      (.clear fGlobalTypeDecls)))

  (method ^:public setDeclPool ^void [this ^XSDeclarationPool declPool]
    (set! fDeclPool declPool))

  (method ^:public setDVFactory ^void [this ^SchemaDVFactory dvFactory]
    (set! fDVFactory dvFactory))

  (method ^:public getDVFactory ^SchemaDVFactory [this] fDVFactory)

  (method ^:public reset ^void [this ^XMLComponentManager componentManager]
    (set! fSymbolTable (cast SymbolTable (.getProperty componentManager SYMBOL_TABLE)))
    (set! fSecurityManager
          (cast XMLSecurityManager (.getProperty componentManager SECURITY_MANAGER nil)))
    (set! fEntityManager (cast XMLEntityManager (.getProperty componentManager ENTITY_MANAGER)))
    (let [er (cast XMLEntityResolver (.getProperty componentManager ENTITY_RESOLVER))]
      (when (some? er) (.setEntityResolver fSchemaParser er))
      (set! fErrorReporter (cast XMLErrorReporter (.getProperty componentManager ERROR_REPORTER)))
      (set! fErrorHandler (.getErrorHandler fErrorReporter))
      (set! fLocale (.getLocale fErrorReporter))
      (set! fValidateAnnotations (.getFeature componentManager VALIDATE_ANNOTATIONS false))
      (set! fHonourAllSchemaLocations
            (.getFeature componentManager HONOUR_ALL_SCHEMALOCATIONS false))
      (set! fNamespaceGrowth (.getFeature componentManager NAMESPACE_GROWTH false))
      (set! fTolerateDuplicates (.getFeature componentManager TOLERATE_DUPLICATES false))
      (try
        (when-not (identical? fErrorHandler (.getProperty fSchemaParser ERROR_HANDLER))
          (.setProperty fSchemaParser
                        ERROR_HANDLER
                        (if (some? fErrorHandler)
                            ^Object fErrorHandler
                            ^Object (DefaultErrorHandler.)))
          (when (some? fAnnotationValidator)
            (.setProperty fAnnotationValidator
                          ERROR_HANDLER
                          (if (some? fErrorHandler)
                              ^Object fErrorHandler
                              ^Object (DefaultErrorHandler.)))))
        (when-not (identical? fLocale (.getProperty fSchemaParser LOCALE))
          (.setProperty fSchemaParser LOCALE fLocale)
          (when (some? fAnnotationValidator) (.setProperty fAnnotationValidator LOCALE fLocale)))
        (catch XMLConfigurationException e))
      (try
        (.setFeature fSchemaParser
                     CONTINUE_AFTER_FATAL_ERROR
                     (.getFeature fErrorReporter CONTINUE_AFTER_FATAL_ERROR))
        (catch XMLConfigurationException e))
      (try
        (when (.getFeature componentManager ALLOW_JAVA_ENCODINGS false)
          (.setFeature fSchemaParser ALLOW_JAVA_ENCODINGS true))
        (catch XMLConfigurationException e))
      (try
        (when (.getFeature componentManager STANDARD_URI_CONFORMANT_FEATURE false)
          (.setFeature fSchemaParser STANDARD_URI_CONFORMANT_FEATURE true))
        (catch XMLConfigurationException e))
      (try
        (set! fGrammarPool (cast XMLGrammarPool (.getProperty componentManager XMLGRAMMAR_POOL)))
        (catch XMLConfigurationException e (set! fGrammarPool nil)))
      (try
        (when (.getFeature componentManager DISALLOW_DOCTYPE false)
          (.setFeature fSchemaParser DISALLOW_DOCTYPE true))
        (catch XMLConfigurationException e))
      (try
        (when (some? fSecurityManager)
          (.setProperty fSchemaParser SECURITY_MANAGER fSecurityManager))
        (catch XMLConfigurationException e))
      (set! fSecurityPropertyMgr
            (cast XMLSecurityPropertyManager
                  (.getProperty componentManager XML_SECURITY_PROPERTY_MANAGER)))
      (.setProperty fSchemaParser XML_SECURITY_PROPERTY_MANAGER fSecurityPropertyMgr)
      (set!
        fAccessExternalDTD
        (.getValue fSecurityPropertyMgr XMLSecurityPropertyManager$Property/ACCESS_EXTERNAL_DTD))
      (set! fAccessExternalSchema
            (.getValue fSecurityPropertyMgr
                       XMLSecurityPropertyManager$Property/ACCESS_EXTERNAL_SCHEMA))
      (set! fOverrideDefaultParser (.getFeature componentManager JdkConstants/OVERRIDE_PARSER))
      (.setFeature fSchemaParser JdkConstants/OVERRIDE_PARSER fOverrideDefaultParser)
      (.setFeature fEntityManager JdkConstants/OVERRIDE_PARSER fOverrideDefaultParser)
      (set! fUseCatalog (.getFeature componentManager XMLConstants/USE_CATALOG))
      (.setFeature fSchemaParser XMLConstants/USE_CATALOG fUseCatalog)
      (.setFeature fEntityManager XMLConstants/USE_CATALOG fUseCatalog)
      (set! fCatalogFile (cast String (.getProperty componentManager JdkXmlUtils/CATALOG_FILES)))
      (set! fDefer (cast String (.getProperty componentManager JdkXmlUtils/CATALOG_DEFER)))
      (set! fPrefer (cast String (.getProperty componentManager JdkXmlUtils/CATALOG_PREFER)))
      (set! fResolve (cast String (.getProperty componentManager JdkXmlUtils/CATALOG_RESOLVE)))
      (for-each [^CatalogFeatures$Feature f (CatalogFeatures$Feature/values)]
        (.setProperty fSchemaParser
                      (.getPropertyName f)
                      (.getProperty componentManager (.getPropertyName f)))
        (.setProperty fEntityManager
                      (.getPropertyName f)
                      (.getProperty componentManager (.getPropertyName f))))
      (.setProperty fSchemaParser
                    JdkConstants/CDATA_CHUNK_SIZE
                    (.getProperty componentManager JdkConstants/CDATA_CHUNK_SIZE))
      (.setProperty fEntityManager
                    JdkConstants/CDATA_CHUNK_SIZE
                    (.getProperty componentManager JdkConstants/CDATA_CHUNK_SIZE))))

  (method traverseLocalElements ^void [this]
    (set! (.-fDeferTraversingLocalElements fElementTraverser) false)
    (loop [^int i 0]
      (when (< i fLocalElemStackPos)
        (let [currElem (aget fLocalElementDecl i)
              currSchema (aget fLocalElementDecl_schema i)
              currGrammar (.getGrammar fGrammarBucket (.-fTargetNamespace currSchema))]
          (.traverseLocal fElementTraverser
                          (aget fParticle i)
                          currElem
                          currSchema
                          currGrammar
                          (aget fAllContext i)
                          (aget fParent i)
                          (aget fLocalElemNamespaceContext i))
          (if (== (.-fType (aget fParticle i)) XSParticleDecl/PARTICLE_EMPTY)
              (let [^:mutable ^XSModelGroupImpl group nil]
                (if (instance? XSComplexTypeDecl (aget fParent i))
                    (let [p (.getParticle (cast XSComplexTypeDecl (aget fParent i)))]
                      (when (some? p) (set! group (cast XSModelGroupImpl (.getTerm p)))))
                    (set! group (.-fModelGroup (cast XSGroupDecl (aget fParent i)))))
                (if (some? group)
                    (do
                      (.removeParticle this group (aget fParticle i))
                      (recur (unchecked-inc-int i)))
                    (recur (unchecked-inc-int i))))
              (recur (unchecked-inc-int i)))))))

  (method ^:private removeParticle ^boolean [this ^XSModelGroupImpl group ^XSParticleDecl particle]
    (let [^:mutable ^XSParticleDecl member nil]
      (loop [^int i 0]
        (when (< i (.-fParticleCount group))
          (set! member (aget (.-fParticles group) i))
          (when (identical? member particle)
            (loop [^int j i]
              (when (< j (unchecked-subtract-int (.-fParticleCount group) 1))
                (aset (.-fParticles group) j (aget (.-fParticles group) (unchecked-add-int j 1)))
                (recur (unchecked-inc-int j))))
            (set! (.-fParticleCount group) (unchecked-dec-int (.-fParticleCount group)))
            (return true))
          (if (== (.-fType member) XSParticleDecl/PARTICLE_MODELGROUP)
              (if (.removeParticle this (cast XSModelGroupImpl (.-fValue member)) particle)
                  (return true)
                  (recur (unchecked-inc-int i)))
              (recur (unchecked-inc-int i)))))
      false))

  (method fillInLocalElemInfo ^void [this ^Element elmDecl ^XSDocumentInfo schemaDoc
                                     ^int allContextFlags ^XSObject parent ^XSParticleDecl particle]
    (when (== (alength fParticle) fLocalElemStackPos)
      (let [newStackP (new XSParticleDecl/1 (unchecked-add-int fLocalElemStackPos INC_STACK_SIZE))]
        (System/arraycopy fParticle 0 newStackP 0 fLocalElemStackPos)
        (set! fParticle newStackP)
        (let [newStackE (new Element/1 (unchecked-add-int fLocalElemStackPos INC_STACK_SIZE))]
          (System/arraycopy fLocalElementDecl 0 newStackE 0 fLocalElemStackPos)
          (set! fLocalElementDecl newStackE)
          (let [newStackE_schema (new XSDocumentInfo/1
                                      (unchecked-add-int fLocalElemStackPos INC_STACK_SIZE))]
            (System/arraycopy fLocalElementDecl_schema 0 newStackE_schema 0 fLocalElemStackPos)
            (set! fLocalElementDecl_schema newStackE_schema)
            (let [newStackI (new int/1 (unchecked-add-int fLocalElemStackPos INC_STACK_SIZE))]
              (System/arraycopy fAllContext 0 newStackI 0 fLocalElemStackPos)
              (set! fAllContext newStackI)
              (let [newStackC (new XSObject/1 (unchecked-add-int fLocalElemStackPos INC_STACK_SIZE))]
                (System/arraycopy fParent 0 newStackC 0 fLocalElemStackPos)
                (set! fParent newStackC)
                (let [newStackN (new String/2 (unchecked-add-int fLocalElemStackPos INC_STACK_SIZE))]
                  (System/arraycopy fLocalElemNamespaceContext 0 newStackN 0 fLocalElemStackPos)
                  (set! fLocalElemNamespaceContext newStackN))))))))
    (aset fParticle fLocalElemStackPos particle)
    (aset fLocalElementDecl fLocalElemStackPos elmDecl)
    (aset fLocalElementDecl_schema fLocalElemStackPos schemaDoc)
    (aset fAllContext fLocalElemStackPos allContextFlags)
    (aset fParent fLocalElemStackPos parent)
    (aset fLocalElemNamespaceContext
          (let [old-2 fLocalElemStackPos]
            (set! fLocalElemStackPos (unchecked-inc-int fLocalElemStackPos))
            old-2)
          (.getEffectiveLocalContext (.-fNamespaceSupport schemaDoc))))

  (method checkForDuplicateNames ^void [this ^String qName ^int declType
                                        ^{:tag (Map String Element)} registry
                                        ^{:tag (Map String XSDocumentInfo)} registry_sub
                                        ^Element currComp ^XSDocumentInfo currSchema]
    (let [^:mutable ^Object objElem nil]
      (if (nil? (set! objElem (.get registry qName)))
          (do
            (when (and fNamespaceGrowth (not fTolerateDuplicates))
              (.checkForDuplicateNames this qName declType currComp))
            (.put registry qName currComp)
            (.put registry_sub qName currSchema))
          (let [collidingElem (cast Element objElem)
                collidingElemSchema (cast XSDocumentInfo (.get registry_sub qName))]
            (when (identical? collidingElem currComp) (return))
            (let [^:mutable ^Element elemParent nil
                  ^:mutable ^XSDocumentInfo redefinedSchema nil
                  ^:mutable collidedWithRedefine true]
              (if (.equals (DOMUtil/getLocalName
                             (set! elemParent (DOMUtil/getParent collidingElem)))
                           SchemaSymbols/ELT_REDEFINE)
                  (set! redefinedSchema
                        (when (some? fRedefine2XSDMap)
                          (cast XSDocumentInfo (.get fRedefine2XSDMap elemParent))))
                  (when (.equals (DOMUtil/getLocalName (DOMUtil/getParent currComp))
                                 SchemaSymbols/ELT_REDEFINE)
                    (set! redefinedSchema collidingElemSchema)
                    (set! collidedWithRedefine false)))
              (cond
                (some? redefinedSchema)
                  (do
                    (when (identical? collidingElemSchema currSchema)
                      (.reportSchemaError this
                                          "sch-props-correct.2"
                                          (new Object/1 [qName])
                                          currComp)
                      (return))
                    (let [newName (java-str (.substring
                                              qName
                                              (unchecked-add-int (.lastIndexOf qName \,) 1))
                                            REDEF_IDENTIFIER)]
                      (cond
                        (identical? redefinedSchema currSchema)
                          (do
                            (.setAttribute currComp SchemaSymbols/ATT_NAME newName)
                            (if (nil? (.-fTargetNamespace currSchema))
                                (do
                                  (.put registry (java-str "," newName) currComp)
                                  (.put registry_sub (java-str "," newName) currSchema))
                                (do
                                  (.put registry
                                        (java-str (.-fTargetNamespace currSchema) "," newName)
                                        currComp)
                                  (.put registry_sub
                                        (java-str (.-fTargetNamespace currSchema) "," newName)
                                        currSchema)))
                            (if (nil? (.-fTargetNamespace currSchema))
                                (.checkForDuplicateNames
                                  this
                                  (java-str "," newName)
                                  declType
                                  registry
                                  registry_sub
                                  currComp
                                  currSchema)
                                (.checkForDuplicateNames
                                  this
                                  (java-str (.-fTargetNamespace currSchema) "," newName)
                                  declType
                                  registry
                                  registry_sub
                                  currComp
                                  currSchema)))
                        collidedWithRedefine
                          (if (nil? (.-fTargetNamespace currSchema))
                              (.checkForDuplicateNames
                                this
                                (java-str "," newName)
                                declType
                                registry
                                registry_sub
                                currComp
                                currSchema)
                              (.checkForDuplicateNames
                                this
                                (java-str (.-fTargetNamespace currSchema) "," newName)
                                declType
                                registry
                                registry_sub
                                currComp
                                currSchema))
                        :else
                          (.reportSchemaError this
                                              "sch-props-correct.2"
                                              (new Object/1 [qName])
                                              currComp))))
                (not fTolerateDuplicates)
                  (.reportSchemaError this "sch-props-correct.2" (new Object/1 [qName]) currComp)
                (some? (aget fUnparsedRegistriesExt declType))
                  (when (identical? (.get (aget fUnparsedRegistriesExt declType) qName) currSchema)
                    (.reportSchemaError this "sch-props-correct.2" (new Object/1 [qName]) currComp))))))
      (when fTolerateDuplicates
        (when (nil? (aget fUnparsedRegistriesExt declType))
          (aset fUnparsedRegistriesExt declType (HashMap.)))
        (.put (aget fUnparsedRegistriesExt declType) qName currSchema))))

  (method checkForDuplicateNames ^void [this ^String qName ^int declType ^Element currComp]
    (let [namespaceEnd (.indexOf qName \,)
          namespace (.substring qName 0 namespaceEnd)
          grammar (.getGrammar fGrammarBucket (.emptyString2Null this namespace))]
      (when (some? grammar)
        (let [obj (.getGlobalDeclFromGrammar this
                                             grammar
                                             declType
                                             (.substring qName (unchecked-add-int namespaceEnd 1)))]
          (when (some? obj)
            (.reportSchemaError this "sch-props-correct.2" (new Object/1 [qName]) currComp))))))

  (method ^:private renameRedefiningComponents ^void [this ^XSDocumentInfo currSchema ^Element child
                                                      ^String componentType ^String oldName
                                                      ^String newName]
    (cond
      (.equals componentType SchemaSymbols/ELT_SIMPLETYPE)
        (let [^:mutable grandKid (DOMUtil/getFirstChildElement child)]
          (if (nil? grandKid)
              (.reportSchemaError this "src-redefine.5.a.a" nil child)
              (let [^:mutable grandKidName (DOMUtil/getLocalName grandKid)]
                (when (.equals grandKidName SchemaSymbols/ELT_ANNOTATION)
                  (set! grandKid (DOMUtil/getNextSiblingElement grandKid)))
                (if (nil? grandKid)
                    (.reportSchemaError this "src-redefine.5.a.a" nil child)
                    (do
                      (set! grandKidName (DOMUtil/getLocalName grandKid))
                      (if (not (.equals grandKidName SchemaSymbols/ELT_RESTRICTION))
                          (.reportSchemaError this
                                              "src-redefine.5.a.b"
                                              (new Object/1 [grandKidName])
                                              child)
                          (let [attrs (.checkAttributes fAttributeChecker grandKid false currSchema)
                                derivedBase (cast QName (aget attrs XSAttributeChecker/ATTIDX_BASE))]
                            (cond
                              (or (or (nil? derivedBase)
                                      (not (identical?
                                             (.-uri derivedBase)
                                             (.-fTargetNamespace currSchema))))
                                  (not (.equals (.-localpart derivedBase) oldName)))
                                (.reportSchemaError
                                  this
                                  "src-redefine.5.a.c"
                                  (new Object/1
                                       [grandKidName
                                        (java-str
                                          (if (nil? (.-fTargetNamespace currSchema))
                                              ""
                                              (.-fTargetNamespace currSchema))
                                          ","
                                          oldName)])
                                  child)
                              (and (some? (.-prefix derivedBase))
                                   (> (.length (.-prefix derivedBase)) 0))
                                (.setAttribute grandKid
                                               SchemaSymbols/ATT_BASE
                                               (java-str (.-prefix derivedBase) ":" newName))
                              :else (.setAttribute grandKid SchemaSymbols/ATT_BASE newName))
                            (.returnAttrArray fAttributeChecker attrs currSchema))))))))
      (.equals componentType SchemaSymbols/ELT_COMPLEXTYPE)
        (let [^:mutable grandKid (DOMUtil/getFirstChildElement child)]
          (if (nil? grandKid)
              (.reportSchemaError this "src-redefine.5.b.a" nil child)
              (do
                (when (.equals (DOMUtil/getLocalName grandKid) SchemaSymbols/ELT_ANNOTATION)
                  (set! grandKid (DOMUtil/getNextSiblingElement grandKid)))
                (if (nil? grandKid)
                    (.reportSchemaError this "src-redefine.5.b.a" nil child)
                    (let [^:mutable greatGrandKid (DOMUtil/getFirstChildElement grandKid)]
                      (if (nil? greatGrandKid)
                          (.reportSchemaError this "src-redefine.5.b.b" nil grandKid)
                          (let [^:mutable greatGrandKidName (DOMUtil/getLocalName greatGrandKid)]
                            (when (.equals greatGrandKidName SchemaSymbols/ELT_ANNOTATION)
                              (set! greatGrandKid (DOMUtil/getNextSiblingElement greatGrandKid)))
                            (if (nil? greatGrandKid)
                                (.reportSchemaError this "src-redefine.5.b.b" nil grandKid)
                                (do
                                  (set! greatGrandKidName (DOMUtil/getLocalName greatGrandKid))
                                  (if (and (not (.equals
                                                  greatGrandKidName
                                                  SchemaSymbols/ELT_RESTRICTION))
                                           (not (.equals
                                                  greatGrandKidName
                                                  SchemaSymbols/ELT_EXTENSION)))
                                      (.reportSchemaError
                                        this
                                        "src-redefine.5.b.c"
                                        (new Object/1 [greatGrandKidName])
                                        greatGrandKid)
                                      (let [attrs (.checkAttributes
                                                    fAttributeChecker
                                                    greatGrandKid
                                                    false
                                                    currSchema)
                                            derivedBase (cast
                                                          QName
                                                          (aget
                                                            attrs
                                                            XSAttributeChecker/ATTIDX_BASE))]
                                        (cond
                                          (or (or
                                                (nil? derivedBase)
                                                (not
                                                  (identical?
                                                    (.-uri derivedBase)
                                                    (.-fTargetNamespace currSchema))))
                                              (not (.equals (.-localpart derivedBase) oldName)))
                                            (.reportSchemaError
                                              this
                                              "src-redefine.5.b.d"
                                              (new
                                                Object/1
                                                [greatGrandKidName
                                                 (java-str
                                                   (if (nil? (.-fTargetNamespace currSchema))
                                                       ""
                                                       (.-fTargetNamespace currSchema))
                                                   ","
                                                   oldName)])
                                              greatGrandKid)
                                          (and (some? (.-prefix derivedBase))
                                               (> (.length (.-prefix derivedBase)) 0))
                                            (.setAttribute
                                              greatGrandKid
                                              SchemaSymbols/ATT_BASE
                                              (java-str (.-prefix derivedBase) ":" newName))
                                          :else
                                            (.setAttribute
                                              greatGrandKid
                                              SchemaSymbols/ATT_BASE
                                              newName)))))))))))))
      (.equals componentType SchemaSymbols/ELT_ATTRIBUTEGROUP)
        (let [^String processedBaseName (if (nil? (.-fTargetNamespace currSchema))
                                            (java-str "," oldName)
                                            (java-str (.-fTargetNamespace currSchema) "," oldName))
              attGroupRefsCount (.changeRedefineGroup
                                  this
                                  processedBaseName
                                  componentType
                                  newName
                                  child
                                  currSchema)]
          (if (> attGroupRefsCount 1)
              (.reportSchemaError this "src-redefine.7.1" (new Object/1 [attGroupRefsCount]) child)
              (when-not (== attGroupRefsCount 1)
                (if (nil? (.-fTargetNamespace currSchema))
                    (.put fRedefinedRestrictedAttributeGroupRegistry
                          processedBaseName
                          (java-str "," newName))
                    (.put fRedefinedRestrictedAttributeGroupRegistry
                          processedBaseName
                          (java-str (.-fTargetNamespace currSchema) "," newName))))))
      (.equals componentType SchemaSymbols/ELT_GROUP)
        (let [^String processedBaseName (if (nil? (.-fTargetNamespace currSchema))
                                            (java-str "," oldName)
                                            (java-str (.-fTargetNamespace currSchema) "," oldName))
              groupRefsCount (.changeRedefineGroup
                               this
                               processedBaseName
                               componentType
                               newName
                               child
                               currSchema)]
          (if (> groupRefsCount 1)
              (.reportSchemaError this "src-redefine.6.1.1" (new Object/1 [groupRefsCount]) child)
              (when-not (== groupRefsCount 1)
                (if (nil? (.-fTargetNamespace currSchema))
                    (.put fRedefinedRestrictedGroupRegistry
                          processedBaseName
                          (java-str "," newName))
                    (.put fRedefinedRestrictedGroupRegistry
                          processedBaseName
                          (java-str (.-fTargetNamespace currSchema) "," newName))))))
      :else
        (.reportSchemaError
          this
          "Internal-Error"
          (new
            Object/1
            ["could not handle this particular <redefine>; please submit your schemas and instance document in a bug report!"])
          child)))

  (method ^:private findQName ^String [this ^String name ^XSDocumentInfo schemaDoc]
    (let [currNSMap (.-fNamespaceSupport schemaDoc)
          colonPtr (.indexOf name \:)
          ^:mutable prefix XMLSymbols/EMPTY_STRING]
      (when (> colonPtr 0) (set! prefix (.substring name 0 colonPtr)))
      (let [^:mutable uri (.getURI currNSMap (.addSymbol fSymbolTable prefix))
            ^String localpart (if (== colonPtr 0)
                                  name
                                  (.substring name (unchecked-add-int colonPtr 1)))]
        (when (and (and (identical? prefix XMLSymbols/EMPTY_STRING) (nil? uri))
                   (.-fIsChameleonSchema schemaDoc))
          (set! uri (.-fTargetNamespace schemaDoc)))
        (if (nil? uri) (java-str "," localpart) (java-str uri "," localpart)))))

  (method ^:private changeRedefineGroup ^int [this ^String originalQName ^String elementSought
                                              ^String newName ^Element curr
                                              ^XSDocumentInfo schemaDoc]
    (let [^:mutable ^int result 0]
      (loop [child (DOMUtil/getFirstChildElement curr)]
        (when (some? child)
          (let [name (DOMUtil/getLocalName child)]
            (if (not (.equals name elementSought))
                (do
                  (set! result
                        (unchecked-add-int result
                                           (.changeRedefineGroup
                                             this
                                             originalQName
                                             elementSought
                                             newName
                                             child
                                             schemaDoc)))
                  (recur (DOMUtil/getNextSiblingElement child)))
                (let [ref (.getAttribute child SchemaSymbols/ATT_REF)]
                  (if (not (== (.length ref) 0))
                      (let [processedRef (.findQName this ref schemaDoc)]
                        (if (.equals originalQName processedRef)
                            (let [^:mutable prefix XMLSymbols/EMPTY_STRING
                                  colonptr (.indexOf ref ":")]
                              (if (> colonptr 0)
                                  (do
                                    (set! prefix (.substring ref 0 colonptr))
                                    (.setAttribute
                                      child
                                      SchemaSymbols/ATT_REF
                                      (java-str prefix ":" newName)))
                                  (.setAttribute child SchemaSymbols/ATT_REF newName))
                              (set! result (unchecked-inc-int result))
                              (if (.equals elementSought SchemaSymbols/ELT_GROUP)
                                  (let [minOccurs (.getAttribute child SchemaSymbols/ATT_MINOCCURS)
                                        maxOccurs (.getAttribute child SchemaSymbols/ATT_MAXOCCURS)]
                                    (if (not (and
                                               (or
                                                 (== (.length maxOccurs) 0)
                                                 (.equals maxOccurs "1"))
                                               (or
                                                 (== (.length minOccurs) 0)
                                                 (.equals minOccurs "1"))))
                                        (do
                                          (.reportSchemaError
                                            this
                                            "src-redefine.6.1.2"
                                            (new Object/1 [ref])
                                            child)
                                          (recur (DOMUtil/getNextSiblingElement child)))
                                        (recur (DOMUtil/getNextSiblingElement child))))
                                  (recur (DOMUtil/getNextSiblingElement child))))
                            (recur (DOMUtil/getNextSiblingElement child))))
                      (recur (DOMUtil/getNextSiblingElement child))))))))
      result))

  (method ^:private findXSDocumentForDecl ^XSDocumentInfo [this ^XSDocumentInfo currSchema
                                                           ^Element decl ^XSDocumentInfo decl_Doc]
    (when DEBUG_NODE_POOL
      (.println System/out
                (java-str "DOCUMENT NS:"
                          (.-fTargetNamespace currSchema)
                          " hashcode:"
                          (.hashCode ^Object (.-fSchemaElement currSchema)))))
    (let [^Object temp decl_Doc]
      (when (some? temp) (let [declDocInfo (cast XSDocumentInfo temp)] declDocInfo))))

  (method ^:private nonAnnotationContent ^boolean [this ^Element elem]
    (loop [child (DOMUtil/getFirstChildElement elem)]
      (if (some? child)
          (if (not (.equals (DOMUtil/getLocalName child) SchemaSymbols/ELT_ANNOTATION))
              (return true)
              (recur (DOMUtil/getNextSiblingElement child)))
          nil))
    false)

  (method ^:private setSchemasVisible ^void [this ^XSDocumentInfo startSchema]
    (when (DOMUtil/isHidden (.-fSchemaElement startSchema) fHiddenNodes)
      (DOMUtil/setVisible (.-fSchemaElement startSchema) fHiddenNodes)
      (let [^{:tag (List XSDocumentInfo)} dependingSchemas (cast
                                                             List
                                                             (.get fDependencyMap startSchema))]
        (loop [^int i 0]
          (when (< i (.size dependingSchemas))
            (.setSchemasVisible this (cast XSDocumentInfo (.get dependingSchemas i)))
            (recur (unchecked-inc-int i)))))))

  (field ^:private ^SimpleLocator xl (SimpleLocator.))

  (method ^:public element2Locator ^SimpleLocator [this ^Element e]
    (when-not (not (instance? ElementImpl e))
      (let [l (SimpleLocator.)] (when (.element2Locator this e l) l))))

  (method ^:public element2Locator ^boolean [this ^Element e ^SimpleLocator l]
    (cond
      (nil? l) false
      (instance? ElementImpl e)
        (let [ele (cast ElementImpl e)
              doc (.getOwnerDocument ele)
              sid (cast String (.get fDoc2SystemId (DOMUtil/getRoot doc)))
              line (.getLineNumber ele)
              column (.getColumnNumber ele)]
          (.setValues l sid sid line column (.getCharacterOffset ele))
          true)
      :else false))

  (method ^:private getElementFromMap ^Element [this ^{:tag (Map String Element)} registry
                                                ^String declKey]
    (when (some? registry) (cast Element (.get registry declKey))))

  (method ^:private getDocInfoFromMap ^XSDocumentInfo [this
                                                       ^{:tag (Map String XSDocumentInfo)} registry
                                                       ^String declKey]
    (when (some? registry) (cast XSDocumentInfo (.get registry declKey))))

  (method ^:private getFromMap ^{:tag (List String)} [this
                                                      ^{:tag (Map String (List String))} registry
                                                      ^String key]
    (when (some? registry) (cast List (.get registry key))))

  (method reportSchemaFatalError ^void [this ^String key ^Object/1 args ^Element ele]
    (.reportSchemaErr this key args ele XMLErrorReporter/SEVERITY_FATAL_ERROR nil))

  (method reportSchemaError ^void [this ^String key ^Object/1 args ^Element ele]
    (.reportSchemaErr this key args ele XMLErrorReporter/SEVERITY_ERROR nil))

  (method reportSchemaError ^void [this ^String key ^Object/1 args ^Element ele ^Exception exception]
    (.reportSchemaErr this key args ele XMLErrorReporter/SEVERITY_ERROR exception))

  (method reportSchemaWarning ^void [this ^String key ^Object/1 args ^Element ele]
    (.reportSchemaErr this key args ele XMLErrorReporter/SEVERITY_WARNING nil))

  (method reportSchemaWarning ^void [this ^String key ^Object/1 args ^Element ele
                                     ^Exception exception]
    (.reportSchemaErr this key args ele XMLErrorReporter/SEVERITY_WARNING exception))

  (method reportSchemaErr ^void [this ^String key ^Object/1 args ^Element ele ^short type
                                 ^Exception exception]
    (if (.element2Locator this ele xl)
        (.reportError fErrorReporter xl XSMessageFormatter/SCHEMA_DOMAIN key args type exception)
        (.reportError fErrorReporter XSMessageFormatter/SCHEMA_DOMAIN key args type exception)))

  (defclass ^:private ^:static XSAnnotationGrammarPool
    :implements [XMLGrammarPool]

    (field ^:private ^XSGrammarBucket fGrammarBucket)

    (field ^:private ^Grammar/1 fInitialGrammarSet)

    (method ^:public retrieveInitialGrammarSet ^Grammar/1 [this ^String grammarType]
      (if (identical? grammarType XMLGrammarDescription/XML_SCHEMA)
          (do
            (when (nil? fInitialGrammarSet)
              (if (nil? fGrammarBucket)
                  (set! fInitialGrammarSet
                        (new Grammar/1 [SchemaGrammar$Schema4Annotations/INSTANCE]))
                  (let [schemaGrammars (.getGrammars fGrammarBucket)]
                    (loop [^int i 0]
                      (if (< i (alength schemaGrammars))
                          (if (.equals SchemaSymbols/URI_SCHEMAFORSCHEMA
                                       (.getTargetNamespace (aget schemaGrammars i)))
                              (do
                                (set! fInitialGrammarSet schemaGrammars)
                                (return fInitialGrammarSet))
                              (recur (unchecked-inc-int i)))
                          nil))
                    (let [grammars (new Grammar/1 (unchecked-add-int (alength schemaGrammars) 1))]
                      (System/arraycopy schemaGrammars 0 grammars 0 (alength schemaGrammars))
                      (aset grammars
                            (unchecked-subtract-int (alength grammars) 1)
                            SchemaGrammar$Schema4Annotations/INSTANCE)
                      (set! fInitialGrammarSet grammars)))))
            fInitialGrammarSet)
          (new Grammar/1 0)))

    (method ^:public cacheGrammars ^void [this ^String grammarType ^Grammar/1 grammars])

    (method ^:public retrieveGrammar ^Grammar [this ^XMLGrammarDescription desc]
      (when (identical? (.getGrammarType desc) XMLGrammarDescription/XML_SCHEMA)
        (let [^:final tns (.getTargetNamespace (cast XMLSchemaDescription desc))]
          (when (some? fGrammarBucket)
            (let [^Grammar grammar (.getGrammar fGrammarBucket tns)]
              (when (some? grammar) (return grammar))))
          (when (.equals SchemaSymbols/URI_SCHEMAFORSCHEMA tns)
            (return SchemaGrammar$Schema4Annotations/INSTANCE))))
      nil)

    (method ^:public refreshGrammars ^void [this ^XSGrammarBucket gBucket]
      (set! fGrammarBucket gBucket)
      (set! fInitialGrammarSet nil))

    (method ^:public lockPool ^void [this])

    (method ^:public unlockPool ^void [this])

    (method ^:public clear ^void [this]))

  (defclass ^:private ^:static XSDKey
    (field ^String systemId)

    (field ^short referType)

    (field ^String referNS)

    (constructor [this ^String systemId ^short referType ^String referNS]
      (set! (.-systemId this) systemId)
      (set! (.-referType this) referType)
      (set! (.-referNS this) referNS))

    (method ^:public hashCode ^int [this]
      (if (nil? referNS) 0 (.hashCode referNS)))

    (method ^:public equals ^boolean [this obj]
      (if (not (instance? XSDKey obj))
          false
          (let [key (cast XSDKey obj)]
            (cond
              (not (identical? referNS (.-referNS key))) false
              (or (nil? systemId) (not (.equals systemId (.-systemId key)))) false
              :else true)))))

  (defclass ^:private ^:static ^:final SAX2XNIUtil
    :extends ErrorHandlerWrapper

    (method ^:public ^:static createXMLParseException0 ^XMLParseException [^SAXParseException exception]
      (SAX2XNIUtil/createXMLParseException exception))

    (method ^:public ^:static createXNIException0 ^XNIException [^SAXException exception]
      (SAX2XNIUtil/createXNIException exception)))

  (method ^:public setGenerateSyntheticAnnotations ^void [this ^boolean state]
    (.setFeature fSchemaParser GENERATE_SYNTHETIC_ANNOTATIONS state)))

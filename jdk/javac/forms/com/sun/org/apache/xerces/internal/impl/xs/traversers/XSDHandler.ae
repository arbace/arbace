                                            (new
                                              Object/1
                                              [callerTNS (.-fTargetNamespace currSchemaInfo)])
                                            schemaRoot)
                        (return nil)))
                  (when (and (not (== referType XSDDescription/CONTEXT_PREPARSE))
                             (not (identical? callerTNS (.-fTargetNamespace currSchemaInfo))))
                    (.reportSchemaError this
                                        (aget NS_ERROR_CODES referType secondIdx)
                                        (new Object/1
                                             [callerTNS (.-fTargetNamespace currSchemaInfo)])
                                        schemaRoot)
                    (return nil))))
          (some? (.-fTargetNamespace currSchemaInfo))
            (if (== referType XSDDescription/CONTEXT_PREPARSE)
                (do
                  (.setTargetNamespace desc (.-fTargetNamespace currSchemaInfo))
                  (set! callerTNS (.-fTargetNamespace currSchemaInfo)))
                (let [^int secondIdx 1]
                  (.reportSchemaError this
                                      (aget NS_ERROR_CODES referType secondIdx)
                                      (new Object/1 [callerTNS (.-fTargetNamespace currSchemaInfo)])
                                      schemaRoot)
                  (return nil))))
        (.addAllowedNS currSchemaInfo (.-fTargetNamespace currSchemaInfo))
        (let [^:mutable ^SchemaGrammar sg nil]
          (cond
            nsCollision
              (let [sg2 (.getGrammar fGrammarBucket (.-fTargetNamespace currSchemaInfo))]
                (if (.isImmutable sg2)
                    (do
                      (set! sg (SchemaGrammar. sg2))
                      (.putGrammar fGrammarBucket sg)
                      (.updateImportListWith this sg))
                    (set! sg sg2))
                (.updateImportListFor this sg))
            (or (== referType XSDDescription/CONTEXT_INCLUDE)
                (== referType XSDDescription/CONTEXT_REDEFINE))
              (set! sg (.getGrammar fGrammarBucket (.-fTargetNamespace currSchemaInfo)))
            (and fHonourAllSchemaLocations (== referType XSDDescription/CONTEXT_IMPORT))
              (do
                (set! sg (.findGrammar this desc false))
                (when (nil? sg)
                  (set! sg
                        (SchemaGrammar. (.-fTargetNamespace currSchemaInfo)
                                        (.makeClone desc)
                                        fSymbolTable))
                  (.putGrammar fGrammarBucket sg)))
            :else
              (do
                (set! sg
                      (SchemaGrammar. (.-fTargetNamespace currSchemaInfo)
                                      (.makeClone desc)
                                      fSymbolTable))
                (.putGrammar fGrammarBucket sg)))
          (.addDocument sg nil (cast String (.get fDoc2SystemId (.-fSchemaElement currSchemaInfo))))
          (.put fDoc2XSDocumentMap schemaRoot currSchemaInfo)
          (let [^{:tag (List XSDocumentInfo)} dependencies (ArrayList.)
                rootNode schemaRoot
                ^:mutable ^Element newSchemaRoot nil]
            (loop [child (DOMUtil/getFirstChildElement rootNode)]
              (when (some? child)
                (let [^:mutable ^String schemaNamespace nil
                      ^:mutable ^String schemaHint nil
                      localName (DOMUtil/getLocalName child)
                      ^:mutable ^short refType -1
                      ^:mutable importCollision false]
                  (if (.equals localName SchemaSymbols/ELT_ANNOTATION)
                      (recur (DOMUtil/getNextSiblingElement child))
                      (do
                        (cond
                          (.equals localName SchemaSymbols/ELT_IMPORT)
                            (do
                              (set! refType XSDDescription/CONTEXT_IMPORT)
                              (let [importAttrs (.checkAttributes
                                                  fAttributeChecker
                                                  child
                                                  true
                                                  currSchemaInfo)]
                                (set! schemaHint
                                      (cast String
                                            (aget
                                              importAttrs
                                              XSAttributeChecker/ATTIDX_SCHEMALOCATION)))
                                (set! schemaNamespace
                                      (cast String
                                            (aget importAttrs XSAttributeChecker/ATTIDX_NAMESPACE)))
                                (when (some? schemaNamespace)
                                  (set! schemaNamespace (.addSymbol fSymbolTable schemaNamespace)))
                                (let [importChild (DOMUtil/getFirstChildElement child)]
                                  (if (some? importChild)
                                      (let [importComponentType (DOMUtil/getLocalName importChild)]
                                        (if (.equals
                                              importComponentType
                                              SchemaSymbols/ELT_ANNOTATION)
                                            (.addAnnotation
                                              sg
                                              (.traverseAnnotationDecl
                                                fElementTraverser
                                                importChild
                                                importAttrs
                                                true
                                                currSchemaInfo))
                                            (.reportSchemaError
                                              this
                                              "s4s-elt-must-match.1"
                                              (new
                                                Object/1
                                                [localName "annotation?" importComponentType])
                                              child))
                                        (when (some? (DOMUtil/getNextSiblingElement importChild))
                                          (.reportSchemaError
                                            this
                                            "s4s-elt-must-match.1"
                                            (new
                                              Object/1
                                              [localName
                                               "annotation?"
                                               (DOMUtil/getLocalName
                                                 (DOMUtil/getNextSiblingElement importChild))])
                                            child)))
                                      (let [text (DOMUtil/getSyntheticAnnotation child)]
                                        (when (some? text)
                                          (.addAnnotation
                                            sg
                                            (.traverseSyntheticAnnotation
                                              fElementTraverser
                                              child
                                              text
                                              importAttrs
                                              true
                                              currSchemaInfo)))))
                                  (.returnAttrArray fAttributeChecker importAttrs currSchemaInfo)
                                  (when (identical?
                                          schemaNamespace
                                          (.-fTargetNamespace currSchemaInfo))
                                    (.reportSchemaError
                                      this
                                      ^String (if (some? schemaNamespace)
                                                  "src-import.1.1"
                                                  "src-import.1.2")
                                      (new Object/1 [schemaNamespace])
                                      child)
                                    (continue (DOMUtil/getNextSiblingElement child)))
                                  (if (.isAllowedNS currSchemaInfo schemaNamespace)
                                      (when (and
                                              (not fHonourAllSchemaLocations)
                                              (not fNamespaceGrowth))
                                        (continue (DOMUtil/getNextSiblingElement child)))
                                      (.addAllowedNS currSchemaInfo schemaNamespace))
                                  (let [tns (.null2EmptyString
                                              this
                                              (.-fTargetNamespace currSchemaInfo))
                                        ^:mutable ^{:tag (List String)} ins (cast
                                                                              List
                                                                              (.get fImportMap tns))]
                                    (if (nil? ins)
                                        (do
                                          (.add fAllTNSs tns)
                                          (set! ins (ArrayList.))
                                          (.put fImportMap tns ins)
                                          (.add ins schemaNamespace))
                                        (when-not (.contains ins schemaNamespace)
                                          (.add ins schemaNamespace)))
                                    (.reset fSchemaGrammarDescription)
                                    (.setContextType
                                      fSchemaGrammarDescription
                                      XSDDescription/CONTEXT_IMPORT)
                                    (.setBaseSystemId
                                      fSchemaGrammarDescription
                                      (.doc2SystemId this schemaRoot))
                                    (.setLiteralSystemId fSchemaGrammarDescription schemaHint)
                                    (.setLocationHints
                                      fSchemaGrammarDescription
                                      (new String/1 [schemaHint]))
                                    (.setTargetNamespace fSchemaGrammarDescription schemaNamespace)
                                    (let [isg (.findGrammar
                                                this
                                                fSchemaGrammarDescription
                                                fNamespaceGrowth)]
                                      (when (some? isg)
                                        (cond
                                          fNamespaceGrowth
                                            (try
                                              (if (.contains
                                                    (.getDocumentLocations isg)
                                                    (XMLEntityManager/expandSystemId
                                                      schemaHint
                                                      (.getBaseSystemId fSchemaGrammarDescription)
                                                      false))
                                                  (continue (DOMUtil/getNextSiblingElement child))
                                                  (set! importCollision true))
                                              (catch URI$MalformedURIException e))
                                          (or (not fHonourAllSchemaLocations)
                                              (.isExistingGrammar
                                                this
                                                fSchemaGrammarDescription
                                                false))
                                            (continue (DOMUtil/getNextSiblingElement child))))
                                      (set! newSchemaRoot
                                            (.resolveSchema
                                              this
                                              fSchemaGrammarDescription
                                              false
                                              child
                                              (nil? isg))))))))
                          (or (.equals localName SchemaSymbols/ELT_INCLUDE)
                              (.equals localName SchemaSymbols/ELT_REDEFINE))
                            (let [includeAttrs (.checkAttributes
                                                 fAttributeChecker
                                                 child
                                                 true
                                                 currSchemaInfo)]
                              (set! schemaHint
                                    (cast String
                                          (aget includeAttrs
                                                XSAttributeChecker/ATTIDX_SCHEMALOCATION)))
                              (when (.equals localName SchemaSymbols/ELT_REDEFINE)
                                (when (nil? fRedefine2NSSupport)
                                  (set! fRedefine2NSSupport (HashMap.)))
                                (.put
                                  fRedefine2NSSupport
                                  child
                                  (SchemaNamespaceSupport. (.-fNamespaceSupport currSchemaInfo))))
                              (if (.equals localName SchemaSymbols/ELT_INCLUDE)
                                  (let [includeChild (DOMUtil/getFirstChildElement child)]
                                    (if (some? includeChild)
                                        (let [includeComponentType (DOMUtil/getLocalName
                                                                     includeChild)]
                                          (if (.equals
                                                includeComponentType
                                                SchemaSymbols/ELT_ANNOTATION)
                                              (.addAnnotation
                                                sg
                                                (.traverseAnnotationDecl
                                                  fElementTraverser
                                                  includeChild
                                                  includeAttrs
                                                  true
                                                  currSchemaInfo))
                                              (.reportSchemaError
                                                this
                                                "s4s-elt-must-match.1"
                                                (new
                                                  Object/1
                                                  [localName "annotation?" includeComponentType])
                                                child))
                                          (when (some? (DOMUtil/getNextSiblingElement includeChild))
                                            (.reportSchemaError
                                              this
                                              "s4s-elt-must-match.1"
                                              (new
                                                Object/1
                                                [localName
                                                 "annotation?"
                                                 (DOMUtil/getLocalName
                                                   (DOMUtil/getNextSiblingElement includeChild))])
                                              child)))
                                        (let [text (DOMUtil/getSyntheticAnnotation child)]
                                          (when (some? text)
                                            (.addAnnotation
                                              sg
                                              (.traverseSyntheticAnnotation
                                                fElementTraverser
                                                child
                                                text
                                                includeAttrs
                                                true
                                                currSchemaInfo))))))
                                  (loop [redefinedChild (DOMUtil/getFirstChildElement child)]
                                    (when (some? redefinedChild)
                                      (let [redefinedComponentType (DOMUtil/getLocalName
                                                                     redefinedChild)]
                                        (if (.equals
                                              redefinedComponentType
                                              SchemaSymbols/ELT_ANNOTATION)
                                            (do
                                              (.addAnnotation
                                                sg
                                                (.traverseAnnotationDecl
                                                  fElementTraverser
                                                  redefinedChild
                                                  includeAttrs
                                                  true
                                                  currSchemaInfo))
                                              (DOMUtil/setHidden redefinedChild fHiddenNodes)
                                              (recur (DOMUtil/getNextSiblingElement redefinedChild)))
                                            (let [text (DOMUtil/getSyntheticAnnotation child)]
                                              (if (some? text)
                                                  (do
                                                    (.addAnnotation
                                                      sg
                                                      (.traverseSyntheticAnnotation
                                                        fElementTraverser
                                                        child
                                                        text
                                                        includeAttrs
                                                        true
                                                        currSchemaInfo))
                                                    (recur
                                                      (DOMUtil/getNextSiblingElement redefinedChild)))
                                                  (recur
                                                    (DOMUtil/getNextSiblingElement redefinedChild)))))))))
                              (.returnAttrArray fAttributeChecker includeAttrs currSchemaInfo)
                              (when (nil? schemaHint)
                                (.reportSchemaError
                                  this
                                  "s4s-att-must-appear"
                                  (new Object/1 ["<include> or <redefine>" "schemaLocation"])
                                  child))
                              (let [^:mutable mustResolve false]
                                (set! refType XSDDescription/CONTEXT_INCLUDE)
                                (when (.equals localName SchemaSymbols/ELT_REDEFINE)
                                  (set! mustResolve (.nonAnnotationContent this child))
                                  (set! refType XSDDescription/CONTEXT_REDEFINE))
                                (.reset fSchemaGrammarDescription)
                                (.setContextType fSchemaGrammarDescription refType)
                                (.setBaseSystemId
                                  fSchemaGrammarDescription
                                  (.doc2SystemId this schemaRoot))
                                (.setLocationHints
                                  fSchemaGrammarDescription
                                  (new String/1 [schemaHint]))
                                (.setTargetNamespace fSchemaGrammarDescription callerTNS)
                                (let [^:mutable alreadyTraversed false
                                      schemaSource (.resolveSchemaSource
                                                     this
                                                     fSchemaGrammarDescription
                                                     mustResolve
                                                     child
                                                     true)]
                                  (when (and fNamespaceGrowth
                                             (== refType XSDDescription/CONTEXT_INCLUDE))
                                    (try
                                      (let [^:final schemaId (XMLEntityManager/expandSystemId
                                                               (.getSystemId schemaSource)
                                                               (.getBaseSystemId schemaSource)
                                                               false)]
                                        (set! alreadyTraversed
                                              (.contains (.getDocumentLocations sg) schemaId)))
                                      (catch URI$MalformedURIException e)))
                                  (if (not alreadyTraversed)
                                      (do
                                        (set! newSchemaRoot
                                              (.resolveSchema
                                                this
                                                schemaSource
                                                fSchemaGrammarDescription
                                                mustResolve
                                                child))
                                        (set! schemaNamespace (.-fTargetNamespace currSchemaInfo)))
                                      (set! fLastSchemaWasDuplicate true)))))
                          :else (break))
                        (let [^:mutable ^XSDocumentInfo newSchemaInfo nil]
                          (if fLastSchemaWasDuplicate
                              (set!
                                newSchemaInfo
                                (when (some? newSchemaRoot)
                                  (cast XSDocumentInfo (.get fDoc2XSDocumentMap newSchemaRoot))))
                              (set! newSchemaInfo
                                    (.constructTrees
                                      this
                                      newSchemaRoot
                                      schemaHint
                                      fSchemaGrammarDescription
                                      importCollision)))
                          (when (and (.equals localName SchemaSymbols/ELT_REDEFINE)
                                     (some? newSchemaInfo))
                            (when (nil? fRedefine2XSDMap) (set! fRedefine2XSDMap (HashMap.)))
                            (.put fRedefine2XSDMap child newSchemaInfo))
                          (if (some? newSchemaRoot)
                              (do
                                (when (some? newSchemaInfo) (.add dependencies newSchemaInfo))
                                (set! newSchemaRoot nil)
                                (recur (DOMUtil/getNextSiblingElement child)))
                              (recur (DOMUtil/getNextSiblingElement child)))))))))
            (.put fDependencyMap currSchemaInfo dependencies)
            currSchemaInfo)))))

  (method ^:private isExistingGrammar ^boolean [this ^XSDDescription desc ^boolean ignoreConflict]
    (let [sg (.getGrammar fGrammarBucket (.getTargetNamespace desc))]
      (cond
        (nil? sg) (some? (.findGrammar this desc ignoreConflict))
        (.isImmutable sg) true
        :else
          (try
            (.contains (.getDocumentLocations sg)
                       (XMLEntityManager/expandSystemId
                         (.getLiteralSystemId desc)
                         (.getBaseSystemId desc)
                         false))
            (catch URI$MalformedURIException e false)))))

  (method ^:private updateImportListFor ^void [this ^SchemaGrammar grammar]
    (let [^{:tag (List SchemaGrammar)} importedGrammars (.getImportedGrammars grammar)]
      (when (some? importedGrammars)
        (loop [^int i 0]
          (when (< i (.size importedGrammars))
            (let [isg1 (cast SchemaGrammar (.get importedGrammars i))
                  isg2 (.getGrammar fGrammarBucket (.getTargetNamespace isg1))]
              (if (and (some? isg2) (not (identical? isg1 isg2)))
                  (do (.set importedGrammars i isg2) (recur (unchecked-inc-int i)))
                  (recur (unchecked-inc-int i)))))))))

  (method ^:private updateImportListWith ^void [this ^SchemaGrammar newGrammar]
    (let [schemaGrammars (.getGrammars fGrammarBucket)]
      (loop [^int i 0]
        (when (< i (alength schemaGrammars))
          (let [sg (aget schemaGrammars i)]
            (if (not (identical? sg newGrammar))
                (let [^{:tag (List SchemaGrammar)} importedGrammars (.getImportedGrammars sg)]
                  (if (some? importedGrammars)
                      (do
                        (loop [^int j 0]
                          (when (< j (.size importedGrammars))
                            (let [isg (cast SchemaGrammar (.get importedGrammars j))]
                              (if (.equals
                                    (.null2EmptyString this (.getTargetNamespace isg))
                                    (.null2EmptyString this (.getTargetNamespace newGrammar)))
                                  (when-not (identical? isg newGrammar)
                                    (.set importedGrammars j newGrammar))
                                  (recur (unchecked-inc-int j))))))
                        (recur (unchecked-inc-int i)))
                      (recur (unchecked-inc-int i))))
                (recur (unchecked-inc-int i))))))))

  (method ^:protected buildGlobalNameRegistries ^void [this]
    (set! registryEmpty false)
    (let [^{:tag (Stack XSDocumentInfo)} schemasToProcess (Stack.)]
      (.push schemasToProcess fRoot)
      (while (not (.empty schemasToProcess))
        (let [currSchemaDoc (cast XSDocumentInfo (.pop schemasToProcess))
              currDoc (.-fSchemaElement currSchemaDoc)]
          (when-not (DOMUtil/isHidden currDoc fHiddenNodes)
            (let [currRoot currDoc
                  ^:mutable dependenciesCanOccur true]
              (loop [globalComp (DOMUtil/getFirstChildElement currRoot)]
                (when (some? globalComp)
                  (cond
                    (.equals (DOMUtil/getLocalName globalComp) SchemaSymbols/ELT_ANNOTATION)
                      (recur (DOMUtil/getNextSiblingElement globalComp))
                    (or (.equals (DOMUtil/getLocalName globalComp) SchemaSymbols/ELT_INCLUDE)
                        (.equals (DOMUtil/getLocalName globalComp) SchemaSymbols/ELT_IMPORT))
                      (do
                        (when-not dependenciesCanOccur
                          (.reportSchemaError this
                                              "s4s-elt-invalid-content.3"
                                              (new Object/1 [(DOMUtil/getLocalName globalComp)])
                                              globalComp))
                        (DOMUtil/setHidden globalComp fHiddenNodes)
                        (recur (DOMUtil/getNextSiblingElement globalComp)))
                    (.equals (DOMUtil/getLocalName globalComp) SchemaSymbols/ELT_REDEFINE)
                      (do
                        (when-not dependenciesCanOccur
                          (.reportSchemaError this
                                              "s4s-elt-invalid-content.3"
                                              (new Object/1 [(DOMUtil/getLocalName globalComp)])
                                              globalComp))
                        (loop [redefineComp (DOMUtil/getFirstChildElement globalComp)]
                          (when (some? redefineComp)
                            (let [lName (DOMUtil/getAttrValue redefineComp SchemaSymbols/ATT_NAME)]
                              (if (== (.length lName) 0)
                                  (recur (DOMUtil/getNextSiblingElement redefineComp))
                                  (let [^:mutable ^String qName (if (nil?
                                                                      (.-fTargetNamespace
                                                                        currSchemaDoc))
                                                                    (java-str "," lName)
                                                                    (java-str
                                                                      (.-fTargetNamespace
                                                                        currSchemaDoc)
                                                                      ","
                                                                      lName))]
                                    (set! qName (XMLChar/trim qName))
                                    (let [componentType (DOMUtil/getLocalName redefineComp)]
                                      (cond
                                        (.equals componentType SchemaSymbols/ELT_ATTRIBUTEGROUP)
                                          (do
                                            (.checkForDuplicateNames
                                              this
                                              qName
                                              ATTRIBUTEGROUP_TYPE
                                              fUnparsedAttributeGroupRegistry
                                              fUnparsedAttributeGroupRegistrySub
                                              redefineComp
                                              currSchemaDoc)
                                            (let [targetLName (java-str
                                                                (DOMUtil/getAttrValue
                                                                  redefineComp
                                                                  SchemaSymbols/ATT_NAME)
                                                                REDEF_IDENTIFIER)]
                                              (.renameRedefiningComponents
                                                this
                                                currSchemaDoc
                                                redefineComp
                                                SchemaSymbols/ELT_ATTRIBUTEGROUP
                                                lName
                                                targetLName)
                                              (recur (DOMUtil/getNextSiblingElement redefineComp))))
                                        (or (.equals componentType SchemaSymbols/ELT_COMPLEXTYPE)
                                            (.equals componentType SchemaSymbols/ELT_SIMPLETYPE))
                                          (do
                                            (.checkForDuplicateNames
                                              this
                                              qName
                                              TYPEDECL_TYPE
                                              fUnparsedTypeRegistry
                                              fUnparsedTypeRegistrySub
                                              redefineComp
                                              currSchemaDoc)
                                            (let [targetLName (java-str
                                                                (DOMUtil/getAttrValue
                                                                  redefineComp
                                                                  SchemaSymbols/ATT_NAME)
                                                                REDEF_IDENTIFIER)]
                                              (if (.equals
                                                    componentType
                                                    SchemaSymbols/ELT_COMPLEXTYPE)
                                                  (do
                                                    (.renameRedefiningComponents
                                                      this
                                                      currSchemaDoc
                                                      redefineComp
                                                      SchemaSymbols/ELT_COMPLEXTYPE
                                                      lName
                                                      targetLName)
                                                    (recur
                                                      (DOMUtil/getNextSiblingElement redefineComp)))
                                                  (do
                                                    (.renameRedefiningComponents
                                                      this
                                                      currSchemaDoc
                                                      redefineComp
                                                      SchemaSymbols/ELT_SIMPLETYPE
                                                      lName
                                                      targetLName)
                                                    (recur
                                                      (DOMUtil/getNextSiblingElement redefineComp))))))
                                        (.equals componentType SchemaSymbols/ELT_GROUP)
                                          (do
                                            (.checkForDuplicateNames
                                              this
                                              qName
                                              GROUP_TYPE
                                              fUnparsedGroupRegistry
                                              fUnparsedGroupRegistrySub
                                              redefineComp
                                              currSchemaDoc)
                                            (let [targetLName (java-str
                                                                (DOMUtil/getAttrValue
                                                                  redefineComp
                                                                  SchemaSymbols/ATT_NAME)
                                                                REDEF_IDENTIFIER)]
                                              (.renameRedefiningComponents
                                                this
                                                currSchemaDoc
                                                redefineComp
                                                SchemaSymbols/ELT_GROUP
                                                lName
                                                targetLName)
                                              (recur (DOMUtil/getNextSiblingElement redefineComp))))
                                        :else (recur (DOMUtil/getNextSiblingElement redefineComp)))))))))
                        (recur (DOMUtil/getNextSiblingElement globalComp)))
                    :else
                      (do
                        (set! dependenciesCanOccur false)
                        (let [lName (DOMUtil/getAttrValue globalComp SchemaSymbols/ATT_NAME)]
                          (if (== (.length lName) 0)
                              (recur (DOMUtil/getNextSiblingElement globalComp))
                              (let [^:mutable ^String qName (if (nil?
                                                                  (.-fTargetNamespace currSchemaDoc))
                                                                (java-str "," lName)
                                                                (java-str
                                                                  (.-fTargetNamespace currSchemaDoc)
                                                                  ","
                                                                  lName))]
                                (set! qName (XMLChar/trim qName))
                                (let [componentType (DOMUtil/getLocalName globalComp)]
                                  (cond
                                    (.equals componentType SchemaSymbols/ELT_ATTRIBUTE)
                                      (do
                                        (.checkForDuplicateNames
                                          this
                                          qName
                                          ATTRIBUTE_TYPE
                                          fUnparsedAttributeRegistry
                                          fUnparsedAttributeRegistrySub
                                          globalComp
                                          currSchemaDoc)
                                        (recur (DOMUtil/getNextSiblingElement globalComp)))
                                    (.equals componentType SchemaSymbols/ELT_ATTRIBUTEGROUP)
                                      (do
                                        (.checkForDuplicateNames
                                          this
                                          qName
                                          ATTRIBUTEGROUP_TYPE
                                          fUnparsedAttributeGroupRegistry
                                          fUnparsedAttributeGroupRegistrySub
                                          globalComp
                                          currSchemaDoc)
                                        (recur (DOMUtil/getNextSiblingElement globalComp)))
                                    (or (.equals componentType SchemaSymbols/ELT_COMPLEXTYPE)
                                        (.equals componentType SchemaSymbols/ELT_SIMPLETYPE))
                                      (do
                                        (.checkForDuplicateNames
                                          this
                                          qName
                                          TYPEDECL_TYPE
                                          fUnparsedTypeRegistry
                                          fUnparsedTypeRegistrySub
                                          globalComp
                                          currSchemaDoc)
                                        (recur (DOMUtil/getNextSiblingElement globalComp)))
                                    (.equals componentType SchemaSymbols/ELT_ELEMENT)
                                      (do
                                        (.checkForDuplicateNames
                                          this
                                          qName
                                          ELEMENT_TYPE
                                          fUnparsedElementRegistry
                                          fUnparsedElementRegistrySub
                                          globalComp
                                          currSchemaDoc)
                                        (recur (DOMUtil/getNextSiblingElement globalComp)))
                                    (.equals componentType SchemaSymbols/ELT_GROUP)
                                      (do
                                        (.checkForDuplicateNames
                                          this
                                          qName
                                          GROUP_TYPE
                                          fUnparsedGroupRegistry
                                          fUnparsedGroupRegistrySub
                                          globalComp
                                          currSchemaDoc)
                                        (recur (DOMUtil/getNextSiblingElement globalComp)))
                                    (.equals componentType SchemaSymbols/ELT_NOTATION)
                                      (do
                                        (.checkForDuplicateNames
                                          this
                                          qName
                                          NOTATION_TYPE
                                          fUnparsedNotationRegistry
                                          fUnparsedNotationRegistrySub
                                          globalComp
                                          currSchemaDoc)
                                        (recur (DOMUtil/getNextSiblingElement globalComp)))
                                    :else (recur (DOMUtil/getNextSiblingElement globalComp)))))))))))
              (DOMUtil/setHidden currDoc fHiddenNodes)
              (let [^{:tag (List XSDocumentInfo)} currSchemaDepends (cast
                                                                      List
                                                                      (.get
                                                                        fDependencyMap
                                                                        currSchemaDoc))]
                (for-each [^XSDocumentInfo currSchemaDepend currSchemaDepends]
                  (.push schemasToProcess currSchemaDepend)))))))))

  (method ^:protected traverseSchemas ^void [this ^{:tag (List Object)} annotationInfo]
    (.setSchemasVisible this fRoot)
    (let [^{:tag (Stack XSDocumentInfo)} schemasToProcess (Stack.)]
      (.push schemasToProcess fRoot)
      (while (not (.empty schemasToProcess))
        (let [currSchemaDoc (cast XSDocumentInfo (.pop schemasToProcess))
              currDoc (.-fSchemaElement currSchemaDoc)
              currSG (.getGrammar fGrammarBucket (.-fTargetNamespace currSchemaDoc))]
          (when-not (DOMUtil/isHidden currDoc fHiddenNodes)
            (let [currRoot currDoc
                  ^:mutable sawAnnotation false]
              (loop [globalComp (DOMUtil/getFirstVisibleChildElement currRoot fHiddenNodes)]
                (when (some? globalComp)
                  (DOMUtil/setHidden globalComp fHiddenNodes)
                  (let [componentType (DOMUtil/getLocalName globalComp)]
                    (cond
                      (.equals (DOMUtil/getLocalName globalComp) SchemaSymbols/ELT_REDEFINE)
                        (do
                          (.backupNSSupport currSchemaDoc
                                            ^SchemaNamespaceSupport (when (some?
                                                                            fRedefine2NSSupport)
                                                                      (cast
                                                                        SchemaNamespaceSupport
                                                                        (.get
                                                                          fRedefine2NSSupport
                                                                          globalComp))))
                          (loop [redefinedComp (DOMUtil/getFirstVisibleChildElement
                                                 globalComp
                                                 fHiddenNodes)]
                            (when (some? redefinedComp)
                              (let [redefinedComponentType (DOMUtil/getLocalName redefinedComp)]
                                (DOMUtil/setHidden redefinedComp fHiddenNodes)
                                (cond
                                  (.equals redefinedComponentType SchemaSymbols/ELT_ATTRIBUTEGROUP)
                                    (do
                                      (.traverseGlobal
                                        fAttributeGroupTraverser
                                        redefinedComp
                                        currSchemaDoc
                                        currSG)
                                      (recur (DOMUtil/getNextVisibleSiblingElement
                                               redefinedComp
                                               fHiddenNodes)))
                                  (.equals redefinedComponentType SchemaSymbols/ELT_COMPLEXTYPE)
                                    (do
                                      (.traverseGlobal
                                        fComplexTypeTraverser
                                        redefinedComp
                                        currSchemaDoc
                                        currSG)
                                      (recur (DOMUtil/getNextVisibleSiblingElement
                                               redefinedComp
                                               fHiddenNodes)))
                                  (.equals redefinedComponentType SchemaSymbols/ELT_GROUP)
                                    (do
                                      (.traverseGlobal
                                        fGroupTraverser
                                        redefinedComp
                                        currSchemaDoc
                                        currSG)
                                      (recur (DOMUtil/getNextVisibleSiblingElement
                                               redefinedComp
                                               fHiddenNodes)))
                                  (.equals redefinedComponentType SchemaSymbols/ELT_SIMPLETYPE)
                                    (do
                                      (.traverseGlobal
                                        fSimpleTypeTraverser
                                        redefinedComp
                                        currSchemaDoc
                                        currSG)
                                      (recur (DOMUtil/getNextVisibleSiblingElement
                                               redefinedComp
                                               fHiddenNodes)))
                                  :else
                                    (do
                                      (.reportSchemaError
                                        this
                                        "s4s-elt-must-match.1"
                                        (new
                                          Object/1
                                          [(DOMUtil/getLocalName globalComp)
                                           "(annotation | (simpleType | complexType | group | attributeGroup))*"
                                           redefinedComponentType])
                                        redefinedComp)
                                      (recur (DOMUtil/getNextVisibleSiblingElement
                                               redefinedComp
                                               fHiddenNodes)))))))
                          (.restoreNSSupport currSchemaDoc)
                          (recur (DOMUtil/getNextVisibleSiblingElement globalComp fHiddenNodes)))
                      (.equals componentType SchemaSymbols/ELT_ATTRIBUTE)
                        (do
                          (.traverseGlobal fAttributeTraverser globalComp currSchemaDoc currSG)
                          (recur (DOMUtil/getNextVisibleSiblingElement globalComp fHiddenNodes)))
                      (.equals componentType SchemaSymbols/ELT_ATTRIBUTEGROUP)
                        (do
                          (.traverseGlobal fAttributeGroupTraverser globalComp currSchemaDoc currSG)
                          (recur (DOMUtil/getNextVisibleSiblingElement globalComp fHiddenNodes)))
                      (.equals componentType SchemaSymbols/ELT_COMPLEXTYPE)
                        (do
                          (.traverseGlobal fComplexTypeTraverser globalComp currSchemaDoc currSG)
                          (recur (DOMUtil/getNextVisibleSiblingElement globalComp fHiddenNodes)))
                      (.equals componentType SchemaSymbols/ELT_ELEMENT)
                        (do
                          (.traverseGlobal fElementTraverser globalComp currSchemaDoc currSG)
                          (recur (DOMUtil/getNextVisibleSiblingElement globalComp fHiddenNodes)))
                      (.equals componentType SchemaSymbols/ELT_GROUP)
                        (do
                          (.traverseGlobal fGroupTraverser globalComp currSchemaDoc currSG)
                          (recur (DOMUtil/getNextVisibleSiblingElement globalComp fHiddenNodes)))
                      (.equals componentType SchemaSymbols/ELT_NOTATION)
                        (do
                          (.traverse fNotationTraverser globalComp currSchemaDoc currSG)
                          (recur (DOMUtil/getNextVisibleSiblingElement globalComp fHiddenNodes)))
                      (.equals componentType SchemaSymbols/ELT_SIMPLETYPE)
                        (do
                          (.traverseGlobal fSimpleTypeTraverser globalComp currSchemaDoc currSG)
                          (recur (DOMUtil/getNextVisibleSiblingElement globalComp fHiddenNodes)))
                      (.equals componentType SchemaSymbols/ELT_ANNOTATION)
                        (do
                          (.addAnnotation currSG
                                          (.traverseAnnotationDecl
                                            fElementTraverser
                                            globalComp
                                            (.getSchemaAttrs currSchemaDoc)
                                            true
                                            currSchemaDoc))
                          (set! sawAnnotation true)
                          (recur (DOMUtil/getNextVisibleSiblingElement globalComp fHiddenNodes)))
                      :else
                        (do
                          (.reportSchemaError this
                                              "s4s-elt-invalid-content.1"
                                              (new
                                                Object/1
                                                [SchemaSymbols/ELT_SCHEMA
                                                 (DOMUtil/getLocalName globalComp)])
                                              globalComp)
                          (recur (DOMUtil/getNextVisibleSiblingElement globalComp fHiddenNodes)))))))
              (when-not sawAnnotation
                (let [text (DOMUtil/getSyntheticAnnotation currRoot)]
                  (when (some? text)
                    (.addAnnotation currSG
                                    (.traverseSyntheticAnnotation
                                      fElementTraverser
                                      currRoot
                                      text
                                      (.getSchemaAttrs currSchemaDoc)
                                      true
                                      currSchemaDoc)))))
              (when (some? annotationInfo)
                (let [info (.getAnnotations currSchemaDoc)]
                  (when (some? info)
                    (.add annotationInfo (.doc2SystemId this currDoc))
                    (.add annotationInfo info))))
              (.returnSchemaAttrs currSchemaDoc)
              (DOMUtil/setHidden currDoc fHiddenNodes)
              (let [^{:tag (List XSDocumentInfo)} currSchemaDepends (cast
                                                                      List
                                                                      (.get
                                                                        fDependencyMap
                                                                        currSchemaDoc))]
                (for-each [^XSDocumentInfo currSchemaDepend currSchemaDepends]
                  (.push schemasToProcess currSchemaDepend)))))))))

  (field ^:private ^{:tag (List String)} fReportedTNS nil)

  (method ^:private ^:final needReportTNSError ^boolean [this ^String uri]
    (cond
      (nil? fReportedTNS) (set! fReportedTNS (ArrayList.))
      (.contains fReportedTNS uri) (return false))
    (.add fReportedTNS uri)
    true)

  (field ^:private ^:static ^:final ^String/1 COMP_TYPE
    (new String/1
         [nil "attribute declaration" "attribute group" "element declaration" "group"
          "identity constraint" "notation" "type definition"]))

  (field ^:private ^:static ^:final ^String/1 CIRCULAR_CODES
    (new String/1
         ["Internal-Error" "Internal-Error" "src-attribute_group.3" "e-props-correct.6"
          "mg-props-correct.2" "Internal-Error" "Internal-Error" "st-props-correct.2"]))

  (method addGlobalAttributeDecl ^void [this ^XSAttributeDecl decl]
    (let [^:final namespace (.getNamespace decl)
          ^:final ^String declKey (if (or (nil? namespace) (== (.length namespace) 0))
                                      (java-str "," (.getName decl))
                                      (java-str namespace "," (.getName decl)))]
      (when (nil? (.get fGlobalAttrDecls declKey)) (.put fGlobalAttrDecls declKey decl))))

  (method addGlobalAttributeGroupDecl ^void [this ^XSAttributeGroupDecl decl]

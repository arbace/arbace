    (cast IdentityConstraint (.get fGlobalIDConstraintDecls declKey)))

  (method ^:protected getGlobalDecl [this ^XSDocumentInfo currSchema ^int declType
                                     ^QName declToTraverse ^Element elmNode]
    (when DEBUG_NODE_POOL
      (.println System/out (java-str "TRAVERSE_GL: " (.toString declToTraverse))))
    (when (and (some? (.-uri declToTraverse))
               (identical? (.-uri declToTraverse) SchemaSymbols/URI_SCHEMAFORSCHEMA))
      (when (== declType TYPEDECL_TYPE)
        (let [^Object retObj (.getGlobalTypeDecl
                               SchemaGrammar/SG_SchemaNS
                               (.-localpart declToTraverse))]
          (when (some? retObj) (return retObj)))))
    (when-not (.isAllowedNS currSchema (.-uri declToTraverse))
      (when (.needReportTNSError currSchema (.-uri declToTraverse))
        (let [^String code (if (nil? (.-uri declToTraverse)) "src-resolve.4.1" "src-resolve.4.2")]
          (.reportSchemaError this
                              code
                              (new Object/1
                                   [(.get fDoc2SystemId (.-fSchemaElement currSchema))
                                    (.-uri declToTraverse)
                                    (.-rawname declToTraverse)])
                              elmNode))))
    (let [sGrammar (.getGrammar fGrammarBucket (.-uri declToTraverse))]
      (if (nil? sGrammar)
          (do
            (when (.needReportTNSError this (.-uri declToTraverse))
              (.reportSchemaError this
                                  "src-resolve"
                                  (new Object/1
                                       [(.-rawname declToTraverse) (aget COMP_TYPE declType)])
                                  elmNode))
            nil)
          (let [retObj (.getGlobalDeclFromGrammar
                         this
                         sGrammar
                         declType
                         (.-localpart declToTraverse))
                ^String declKey (if (nil? (.-uri declToTraverse))
                                    (java-str "," (.-localpart declToTraverse))
                                    (java-str (.-uri declToTraverse)
                                              ","
                                              (.-localpart declToTraverse)))]
            (if (not fTolerateDuplicates)
                (when (some? retObj) (return retObj))
                (let [retObj2 (.getGlobalDecl this declKey declType)]
                  (when (some? retObj2) (return retObj2))))
            (let [^:mutable ^XSDocumentInfo schemaWithDecl nil
                  ^:mutable ^Element decl nil
                  ^:mutable ^XSDocumentInfo declDoc nil]
              (switch declType
                ATTRIBUTE_TYPE
                  (do
                    (set! decl (.getElementFromMap this fUnparsedAttributeRegistry declKey))
                    (set! declDoc (.getDocInfoFromMap this fUnparsedAttributeRegistrySub declKey)))
                ATTRIBUTEGROUP_TYPE
                  (do
                    (set! decl (.getElementFromMap this fUnparsedAttributeGroupRegistry declKey))
                    (set! declDoc
                          (.getDocInfoFromMap this fUnparsedAttributeGroupRegistrySub declKey)))
                ELEMENT_TYPE
                  (do
                    (set! decl (.getElementFromMap this fUnparsedElementRegistry declKey))
                    (set! declDoc (.getDocInfoFromMap this fUnparsedElementRegistrySub declKey)))
                GROUP_TYPE
                  (do
                    (set! decl (.getElementFromMap this fUnparsedGroupRegistry declKey))
                    (set! declDoc (.getDocInfoFromMap this fUnparsedGroupRegistrySub declKey)))
                IDENTITYCONSTRAINT_TYPE
                  (do
                    (set! decl
                          (.getElementFromMap this fUnparsedIdentityConstraintRegistry declKey))
                    (set! declDoc
                          (.getDocInfoFromMap this fUnparsedIdentityConstraintRegistrySub declKey)))
                NOTATION_TYPE
                  (do
                    (set! decl (.getElementFromMap this fUnparsedNotationRegistry declKey))
                    (set! declDoc (.getDocInfoFromMap this fUnparsedNotationRegistrySub declKey)))
                TYPEDECL_TYPE
                  (do
                    (set! decl (.getElementFromMap this fUnparsedTypeRegistry declKey))
                    (set! declDoc (.getDocInfoFromMap this fUnparsedTypeRegistrySub declKey)))
                (.reportSchemaError this
                                    "Internal-Error"
                                    (new Object/1
                                         [(java-str
                                            "XSDHandler asked to locate component of type "
                                            declType
                                            "; it does not recognize this type!")])
                                    elmNode))
              (if (nil? decl)
                  (do
                    (when (nil? retObj)
                      (.reportSchemaError this
                                          "src-resolve"
                                          (new Object/1
                                               [(.-rawname declToTraverse)
                                                (aget COMP_TYPE declType)])
                                          elmNode))
                    retObj)
                  (do
                    (set! schemaWithDecl (.findXSDocumentForDecl this currSchema decl declDoc))
                    (cond
                      (nil? schemaWithDecl)
                        (do
                          (when (nil? retObj)
                            (let [^String code (if (nil? (.-uri declToTraverse))
                                                   "src-resolve.4.1"
                                                   "src-resolve.4.2")]
                              (.reportSchemaError
                                this
                                code
                                (new Object/1
                                     [(.get fDoc2SystemId (.-fSchemaElement currSchema))
                                      (.-uri declToTraverse)
                                      (.-rawname declToTraverse)])
                                elmNode)))
                          retObj)
                      (DOMUtil/isHidden decl fHiddenNodes)
                        (do
                          (when (nil? retObj)
                            (let [^:mutable code (aget CIRCULAR_CODES declType)]
                              (when (== declType TYPEDECL_TYPE)
                                (when (.equals SchemaSymbols/ELT_COMPLEXTYPE
                                               (DOMUtil/getLocalName decl))
                                  (set! code "ct-props-correct.3")))
                              (.reportSchemaError
                                this
                                code
                                (new Object/1
                                     [(java-str (.-prefix declToTraverse)
                                                ":"
                                                (.-localpart declToTraverse))])
                                elmNode)))
                          retObj)
                      :else (.traverseGlobalDecl this declType decl schemaWithDecl sGrammar)))))))))

  (method ^:protected getGlobalDecl [this ^String declKey ^int declType]
    (let [^:mutable ^Object retObj nil]
      (switch declType
        ATTRIBUTE_TYPE (set! retObj (.getGlobalAttributeDecl this declKey))
        ATTRIBUTEGROUP_TYPE (set! retObj (.getGlobalAttributeGroupDecl this declKey))
        ELEMENT_TYPE (set! retObj (.getGlobalElementDecl this declKey))
        GROUP_TYPE (set! retObj (.getGlobalGroupDecl this declKey))
        IDENTITYCONSTRAINT_TYPE (set! retObj (.getIDConstraintDecl this declKey))
        NOTATION_TYPE (set! retObj (.getGlobalNotationDecl this declKey))
        TYPEDECL_TYPE (set! retObj (.getGlobalTypeDecl this declKey)))
      retObj))

  (method ^:protected getGlobalDeclFromGrammar [this ^SchemaGrammar sGrammar ^int declType
                                                ^String localpart]
    (let [^:mutable ^Object retObj nil]
      (switch declType
        ATTRIBUTE_TYPE (set! retObj (.getGlobalAttributeDecl sGrammar localpart))
        ATTRIBUTEGROUP_TYPE (set! retObj (.getGlobalAttributeGroupDecl sGrammar localpart))
        ELEMENT_TYPE (set! retObj (.getGlobalElementDecl sGrammar localpart))
        GROUP_TYPE (set! retObj (.getGlobalGroupDecl sGrammar localpart))
        IDENTITYCONSTRAINT_TYPE (set! retObj (.getIDConstraintDecl sGrammar localpart))
        NOTATION_TYPE (set! retObj (.getGlobalNotationDecl sGrammar localpart))
        TYPEDECL_TYPE (set! retObj (.getGlobalTypeDecl sGrammar localpart)))
      retObj))

  (method ^:protected getGlobalDeclFromGrammar [this ^SchemaGrammar sGrammar ^int declType
                                                ^String localpart ^String schemaLoc]
    (let [^:mutable ^Object retObj nil]
      (switch declType
        ATTRIBUTE_TYPE (set! retObj (.getGlobalAttributeDecl sGrammar localpart schemaLoc))
        ATTRIBUTEGROUP_TYPE
          (set! retObj (.getGlobalAttributeGroupDecl sGrammar localpart schemaLoc))
        ELEMENT_TYPE (set! retObj (.getGlobalElementDecl sGrammar localpart schemaLoc))
        GROUP_TYPE (set! retObj (.getGlobalGroupDecl sGrammar localpart schemaLoc))
        IDENTITYCONSTRAINT_TYPE (set! retObj (.getIDConstraintDecl sGrammar localpart schemaLoc))
        NOTATION_TYPE (set! retObj (.getGlobalNotationDecl sGrammar localpart schemaLoc))
        TYPEDECL_TYPE (set! retObj (.getGlobalTypeDecl sGrammar localpart schemaLoc)))
      retObj))

  (method ^:protected traverseGlobalDecl [this ^int declType ^Element decl ^XSDocumentInfo schemaDoc
                                          ^SchemaGrammar grammar]
    (let [^:mutable ^Object retObj nil]
      (DOMUtil/setHidden decl fHiddenNodes)
      (let [^:mutable ^SchemaNamespaceSupport nsSupport nil
            parent (DOMUtil/getParent decl)]
        (when (.equals (DOMUtil/getLocalName parent) SchemaSymbols/ELT_REDEFINE)
          (set! nsSupport
                (when (some? fRedefine2NSSupport)
                  (cast SchemaNamespaceSupport (.get fRedefine2NSSupport parent)))))
        (.backupNSSupport schemaDoc nsSupport)
        (switch declType
          TYPEDECL_TYPE
            (if (.equals (DOMUtil/getLocalName decl) SchemaSymbols/ELT_COMPLEXTYPE)
                (set! retObj (.traverseGlobal fComplexTypeTraverser decl schemaDoc grammar))
                (set! retObj (.traverseGlobal fSimpleTypeTraverser decl schemaDoc grammar)))
          ATTRIBUTE_TYPE (set! retObj (.traverseGlobal fAttributeTraverser decl schemaDoc grammar))
          ELEMENT_TYPE (set! retObj (.traverseGlobal fElementTraverser decl schemaDoc grammar))
          ATTRIBUTEGROUP_TYPE
            (set! retObj (.traverseGlobal fAttributeGroupTraverser decl schemaDoc grammar))
          GROUP_TYPE (set! retObj (.traverseGlobal fGroupTraverser decl schemaDoc grammar))
          NOTATION_TYPE (set! retObj (.traverse fNotationTraverser decl schemaDoc grammar))
          IDENTITYCONSTRAINT_TYPE nil)
        (.restoreNSSupport schemaDoc)
        retObj)))

  (method ^:public schemaDocument2SystemId ^String [this ^XSDocumentInfo schemaDoc]
    (cast String (.get fDoc2SystemId (.-fSchemaElement schemaDoc))))

  (method getGrpOrAttrGrpRedefinedByRestriction [this ^int type ^QName name
                                                 ^XSDocumentInfo currSchema ^Element elmNode]
    (let [^String realName (if (some? (.-uri name))
                               (java-str (.-uri name) "," (.-localpart name))
                               (java-str "," (.-localpart name)))
          ^:mutable ^String nameToFind nil]
      (switch type
        ATTRIBUTEGROUP_TYPE
          (set! nameToFind (cast String (.get fRedefinedRestrictedAttributeGroupRegistry realName)))
        GROUP_TYPE (set! nameToFind (cast String (.get fRedefinedRestrictedGroupRegistry realName)))
        (return nil))
      (when (some? nameToFind)
        (let [commaPos (.indexOf nameToFind ",")
              qNameToFind (QName. XMLSymbols/EMPTY_STRING
                                  (.substring nameToFind (unchecked-add-int commaPos 1))
                                  (.substring nameToFind commaPos)
                                  ^String (when-not (== commaPos 0)
                                            (.substring nameToFind 0 commaPos)))
              retObj (.getGlobalDecl this currSchema type qNameToFind elmNode)]
          (if (nil? retObj)
              (do
                (switch type
                  ATTRIBUTEGROUP_TYPE
                    (.reportSchemaError this
                                        "src-redefine.7.2.1"
                                        (new Object/1 [(.-localpart name)])
                                        elmNode)
                  GROUP_TYPE
                    (.reportSchemaError this
                                        "src-redefine.6.2.1"
                                        (new Object/1 [(.-localpart name)])
                                        elmNode))
                nil)
              retObj)))))

  (method ^:protected resolveKeyRefs ^void [this]
    (loop [^int i 0]
      (when (< i fKeyrefStackPos)
        (let [keyrefSchemaDoc (aget fKeyrefsMapXSDocumentInfo i)]
          (.makeGlobal (.-fNamespaceSupport keyrefSchemaDoc))
          (.setEffectiveContext (.-fNamespaceSupport keyrefSchemaDoc)
                                (aget fKeyrefNamespaceContext i))
          (let [keyrefGrammar (.getGrammar fGrammarBucket (.-fTargetNamespace keyrefSchemaDoc))]
            (DOMUtil/setHidden (aget fKeyrefs i) fHiddenNodes)
            (.traverse fKeyrefTraverser
                       (aget fKeyrefs i)
                       (aget fKeyrefElems i)
                       keyrefSchemaDoc
                       keyrefGrammar)
            (recur (unchecked-inc-int i)))))))

  (method ^:protected getIDRegistry ^{:tag (Map String Element)} [this]
    fUnparsedIdentityConstraintRegistry)

  (method ^:protected getIDRegistry_sub ^{:tag (Map String XSDocumentInfo)} [this]
    fUnparsedIdentityConstraintRegistrySub)

  (method ^:protected storeKeyRef ^void [this ^Element keyrefToStore ^XSDocumentInfo schemaDoc
                                         ^XSElementDecl currElemDecl]
    (let [keyrefName (DOMUtil/getAttrValue keyrefToStore SchemaSymbols/ATT_NAME)]
      (when-not (== (.length keyrefName) 0)
        (let [^String keyrefQName (if (nil? (.-fTargetNamespace schemaDoc))
                                      (java-str "," keyrefName)
                                      (java-str (.-fTargetNamespace schemaDoc) "," keyrefName))]
          (.checkForDuplicateNames this
                                   keyrefQName
                                   IDENTITYCONSTRAINT_TYPE
                                   fUnparsedIdentityConstraintRegistry
                                   fUnparsedIdentityConstraintRegistrySub
                                   keyrefToStore
                                   schemaDoc)))
      (when (== fKeyrefStackPos (alength fKeyrefs))
        (let [elemArray (new Element/1 (unchecked-add-int fKeyrefStackPos INC_KEYREF_STACK_AMOUNT))]
          (System/arraycopy fKeyrefs 0 elemArray 0 fKeyrefStackPos)
          (set! fKeyrefs elemArray)
          (let [declArray (new XSElementDecl/1
                               (unchecked-add-int fKeyrefStackPos INC_KEYREF_STACK_AMOUNT))]
            (System/arraycopy fKeyrefElems 0 declArray 0 fKeyrefStackPos)
            (set! fKeyrefElems declArray)
            (let [stringArray (new String/2
                                   (unchecked-add-int fKeyrefStackPos INC_KEYREF_STACK_AMOUNT))]
              (System/arraycopy fKeyrefNamespaceContext 0 stringArray 0 fKeyrefStackPos)
              (set! fKeyrefNamespaceContext stringArray)
              (let [xsDocumentInfo (new XSDocumentInfo/1
                                        (unchecked-add-int fKeyrefStackPos INC_KEYREF_STACK_AMOUNT))]
                (System/arraycopy fKeyrefsMapXSDocumentInfo 0 xsDocumentInfo 0 fKeyrefStackPos)
                (set! fKeyrefsMapXSDocumentInfo xsDocumentInfo))))))
      (aset fKeyrefs fKeyrefStackPos keyrefToStore)
      (aset fKeyrefElems fKeyrefStackPos currElemDecl)
      (aset fKeyrefNamespaceContext
            fKeyrefStackPos
            (.getEffectiveLocalContext (.-fNamespaceSupport schemaDoc)))
      (aset fKeyrefsMapXSDocumentInfo
            (let [old-1 fKeyrefStackPos]
              (set! fKeyrefStackPos (unchecked-inc-int fKeyrefStackPos))
              old-1)
            schemaDoc)))

  (method ^:private resolveSchema ^Element [this ^XSDDescription desc ^boolean mustResolve
                                            ^Element referElement ^boolean usePairs]
    (let [^:mutable ^XMLInputSource schemaSource nil]
      (try
        (let [^{:tag (Map String XMLSchemaLoader$LocationArray)} pairs (if usePairs
                                                                           fLocationPairs
                                                                           (Collections/emptyMap))]
          (set! schemaSource (XMLSchemaLoader/resolveDocument desc pairs fEntityManager)))
        (catch IOException ex
          (if mustResolve
              (.reportSchemaError this
                                  "schema_reference.4"
                                  (new Object/1 [(aget (.getLocationHints desc) 0)])
                                  referElement)
              (.reportSchemaWarning this
                                    "schema_reference.4"
                                    (new Object/1 [(aget (.getLocationHints desc) 0)])
                                    referElement))))
      (cond
        (instance? DOMInputSource schemaSource)
          (.getSchemaDocument this
                              (.getTargetNamespace desc)
                              (cast DOMInputSource schemaSource)
                              mustResolve
                              (.getContextType desc)
                              referElement)
        (instance? SAXInputSource schemaSource)
          (.getSchemaDocument this
                              (.getTargetNamespace desc)
                              (cast SAXInputSource schemaSource)
                              mustResolve
                              (.getContextType desc)
                              referElement)
        (instance? StAXInputSource schemaSource)
          (.getSchemaDocument this
                              (.getTargetNamespace desc)
                              (cast StAXInputSource schemaSource)
                              mustResolve
                              (.getContextType desc)
                              referElement)
        (instance? XSInputSource schemaSource)
          (.getSchemaDocument this (cast XSInputSource schemaSource) desc)
        :else
          (.getSchemaDocument this
                              (.getTargetNamespace desc)
                              schemaSource
                              mustResolve
                              (.getContextType desc)
                              referElement))))

  (method ^:private resolveSchema ^Element [this ^XMLInputSource schemaSource ^XSDDescription desc
                                            ^boolean mustResolve ^Element referElement]
    (cond
      (instance? DOMInputSource schemaSource)
        (.getSchemaDocument this
                            (.getTargetNamespace desc)
                            (cast DOMInputSource schemaSource)
                            mustResolve
                            (.getContextType desc)
                            referElement)
      (instance? SAXInputSource schemaSource)
        (.getSchemaDocument this
                            (.getTargetNamespace desc)
                            (cast SAXInputSource schemaSource)
                            mustResolve

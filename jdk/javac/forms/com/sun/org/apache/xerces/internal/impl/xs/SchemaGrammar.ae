    (when (< fCTCount (alength fComplexTypeDecls))
      (set! fComplexTypeDecls (SchemaGrammar/resize fComplexTypeDecls fCTCount))
      (set! fCTLocators (SchemaGrammar/resize fCTLocators fCTCount)))
    fComplexTypeDecls)

  (method ^:final getUncheckedCTLocators ^SimpleLocator/1 [this]

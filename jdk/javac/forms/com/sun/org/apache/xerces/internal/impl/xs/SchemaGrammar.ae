  (method ^:public addComplexTypeDecl ^void [this ^XSComplexTypeDecl decl ^SimpleLocator locator]
    (when (== fCTCount (alength fComplexTypeDecls))
      (set! fComplexTypeDecls
            (SchemaGrammar/resize fComplexTypeDecls (unchecked-add-int fCTCount INC_SIZE)))
      (set! fCTLocators (SchemaGrammar/resize fCTLocators (unchecked-add-int fCTCount INC_SIZE))))
    (aset fCTLocators fCTCount locator)
    (aset fComplexTypeDecls
          (let [old-2 fCTCount] (set! fCTCount (unchecked-inc-int fCTCount)) old-2)
          decl))

  (method ^:public addRedefinedGroupDecl ^void [this ^XSGroupDecl derived ^XSGroupDecl base
                                                ^SimpleLocator locator]
    (when (== fRGCount (alength fRedefinedGroupDecls))
      (set! fRedefinedGroupDecls
            (SchemaGrammar/resize fRedefinedGroupDecls (bit-shift-left-int fRGCount 1)))
      (set! fRGLocators (SchemaGrammar/resize fRGLocators fRGCount)))
    (aset fRGLocators (unchecked-divide-int fRGCount 2) locator)
    (aset fRedefinedGroupDecls
          (let [old-3 fRGCount] (set! fRGCount (unchecked-inc-int fRGCount)) old-3)
          derived)
    (aset fRedefinedGroupDecls
          (let [old-4 fRGCount] (set! fRGCount (unchecked-inc-int fRGCount)) old-4)
          base))


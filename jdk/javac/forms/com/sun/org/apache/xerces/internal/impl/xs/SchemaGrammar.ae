  (field ^:private ^:static ^:final ^short MAX_COMP_IDX XSTypeDefinition/SIMPLE_TYPE)

  (field ^:private ^:static ^:final ^boolean/1 GLOBAL_COMP
    (new boolean/1
         [false true true true false true true false false false true true false false false true
          true]))

  (field ^:private ^XSNamedMap/1 fComponents nil)

  (field ^:private ^ObjectList/1 fComponentsExt nil)

  (field ^:private ^{:tag (List Object)} fDocuments nil)

  (field ^:private ^{:tag (List String)} fLocations nil)

  (method ^:public ^:synchronized addDocument ^void [this document ^String location]
    (when (nil? fDocuments)
      (set! fDocuments (CopyOnWriteArrayList.))
      (set! fLocations (CopyOnWriteArrayList.)))
    (.add fDocuments document)
    (.add fLocations location))

  (method ^:public ^:synchronized removeDocument ^void [this ^int index]
    (when (and (and (some? fDocuments) (>= index 0)) (< index (.size fDocuments)))
      (.remove fDocuments index)
      (.remove fLocations index)))

  (method ^:public getSchemaNamespace ^String [this] fTargetNamespace)

  (method ^:synchronized getDOMParser ^DOMParser [this]
    (when (some? fDOMParser)
      (let [parser (cast DOMParser (.get fDOMParser))] (when (some? parser) (return parser))))
    (let [config (XML11Configuration. fSymbolTable)]
      (.setFeature config (java-str Constants/SAX_FEATURE_PREFIX Constants/NAMESPACES_FEATURE) true)
      (.setFeature config
                   (java-str Constants/SAX_FEATURE_PREFIX Constants/VALIDATION_FEATURE)
                   false)
      (let [parser (DOMParser. config)]
        (try
          (.setFeature parser
                       (java-str Constants/XERCES_FEATURE_PREFIX
                                 Constants/DEFER_NODE_EXPANSION_FEATURE)
                       false)
          (catch SAXException exc))
        (set! fDOMParser (SoftReference. parser))
        parser)))

  (method ^:synchronized getSAXParser ^SAXParser [this]
    (when (some? fSAXParser)
      (let [parser (cast SAXParser (.get fSAXParser))] (when (some? parser) (return parser))))
    (let [config (XML11Configuration. fSymbolTable)]
      (.setFeature config (java-str Constants/SAX_FEATURE_PREFIX Constants/NAMESPACES_FEATURE) true)
      (.setFeature config
                   (java-str Constants/SAX_FEATURE_PREFIX Constants/VALIDATION_FEATURE)
                   false)
      (let [parser (SAXParser. config)] (set! fSAXParser (SoftReference. parser)) parser)))

  (method ^:public ^:synchronized getComponents ^XSNamedMap [this ^short objectType]
    (if (or (or (<= objectType 0) (> objectType MAX_COMP_IDX)) (not (aget GLOBAL_COMP objectType)))
        XSNamedMapImpl/EMPTY_MAP
        (do
          (when (nil? fComponents)
            (set! fComponents (new XSNamedMap/1 (unchecked-add-int MAX_COMP_IDX 1))))
          (when (nil? (aget fComponents objectType))
            (let [^:mutable ^SymbolHash table nil]
              (switch objectType
                (XSConstants/TYPE_DEFINITION XSTypeDefinition/COMPLEX_TYPE
                                             XSTypeDefinition/SIMPLE_TYPE)
                  (set! table fGlobalTypeDecls)
                XSConstants/ATTRIBUTE_DECLARATION (set! table fGlobalAttrDecls)
                XSConstants/ELEMENT_DECLARATION (set! table fGlobalElemDecls)
                XSConstants/ATTRIBUTE_GROUP (set! table fGlobalAttrGrpDecls)
                XSConstants/MODEL_GROUP_DEFINITION (set! table fGlobalGroupDecls)
                XSConstants/NOTATION_DECLARATION (set! table fGlobalNotationDecls)
                XSConstants/IDENTITY_CONSTRAINT (set! table (.-fGlobalIDConstraintDecls this)))
              (if (or (== objectType XSTypeDefinition/COMPLEX_TYPE)
                      (== objectType XSTypeDefinition/SIMPLE_TYPE))
                  (aset fComponents
                        objectType
                        (XSNamedMap4Types. fTargetNamespace table objectType))
                  (aset fComponents objectType (XSNamedMapImpl. fTargetNamespace table)))))
          (aget fComponents objectType))))

  (method ^:public ^:synchronized getComponentsExt ^ObjectList [this ^short objectType]
    (if (or (or (<= objectType 0) (> objectType MAX_COMP_IDX)) (not (aget GLOBAL_COMP objectType)))
        ObjectListImpl/EMPTY_LIST
        (do
          (when (nil? fComponentsExt)
            (set! fComponentsExt (new ObjectList/1 (unchecked-add-int MAX_COMP_IDX 1))))
          (when (nil? (aget fComponentsExt objectType))
            (let [^:mutable ^SymbolHash table nil]
              (switch objectType
                (XSConstants/TYPE_DEFINITION XSTypeDefinition/COMPLEX_TYPE
                                             XSTypeDefinition/SIMPLE_TYPE)
                  (set! table fGlobalTypeDeclsExt)
                XSConstants/ATTRIBUTE_DECLARATION (set! table fGlobalAttrDeclsExt)
                XSConstants/ELEMENT_DECLARATION (set! table fGlobalElemDeclsExt)
                XSConstants/ATTRIBUTE_GROUP (set! table fGlobalAttrGrpDeclsExt)
                XSConstants/MODEL_GROUP_DEFINITION (set! table fGlobalGroupDeclsExt)
                XSConstants/NOTATION_DECLARATION (set! table fGlobalNotationDeclsExt)
                XSConstants/IDENTITY_CONSTRAINT (set! table (.-fGlobalIDConstraintDeclsExt this)))
              (let [entries (.getEntries table)]
                (aset fComponentsExt objectType (ObjectListImpl. entries (alength entries))))))
          (aget fComponentsExt objectType))))

  (method ^:public ^:synchronized resetComponents ^void [this]
    (set! fComponents nil)
    (set! fComponentsExt nil))

  (method ^:public getTypeDefinition ^XSTypeDefinition [this ^String name]
    (.getGlobalTypeDecl this name))

  (method ^:public getAttributeDeclaration ^XSAttributeDeclaration [this ^String name]
    (.getGlobalAttributeDecl this name))

  (method ^:public getElementDeclaration ^XSElementDeclaration [this ^String name]
    (.getGlobalElementDecl this name))

  (method ^:public getAttributeGroup ^XSAttributeGroupDefinition [this ^String name]
    (.getGlobalAttributeGroupDecl this name))

  (method ^:public getModelGroupDefinition ^XSModelGroupDefinition [this ^String name]
    (.getGlobalGroupDecl this name))

  (method ^:public getNotationDeclaration ^XSNotationDeclaration [this ^String name]
    (.getGlobalNotationDecl this name))

  (method ^:public getIDCDefinition ^XSIDCDefinition [this ^String name]
    (.getIDConstraintDecl this name))

  (method ^:public getDocumentLocations ^StringList [this]
    (StringListImpl. fLocations))

  (method ^:public toXSModel ^XSModel [this]
    (XSModelImpl. (new SchemaGrammar/1 [this])))

  (method ^:public toXSModel ^XSModel [this ^XSGrammar/1 grammars]
    (if (or (nil? grammars) (== (alength grammars) 0))
        (.toXSModel this)
        (let [len (alength grammars)
              ^:mutable hasSelf false]
          (loop [^int i 0]
            (if (< i len)
                (if (identical? (aget grammars i) this)
                    (set! hasSelf true)
                    (recur (unchecked-inc-int i)))
                nil))
          (let [gs (new SchemaGrammar/1 (if hasSelf len (unchecked-add-int len 1)))]
            (loop [^int i 0]
              (when (< i len)
                (aset gs i (cast SchemaGrammar (aget grammars i)))
                (recur (unchecked-inc-int i))))
            (when-not hasSelf (aset gs len this))
            (XSModelImpl. gs)))))

  (method ^:public getAnnotations ^XSObjectList [this]
    (if (== fNumAnnotations 0)
        XSObjectListImpl/EMPTY_LIST
        (XSObjectListImpl. fAnnotations fNumAnnotations)))

  (method ^:public addAnnotation ^void [this ^XSAnnotationImpl annotation]
    (when (some? annotation)
      (cond
        (nil? fAnnotations) (set! fAnnotations (new XSAnnotationImpl/1 2))
        (== fNumAnnotations (alength fAnnotations))
          (let [newArray (new XSAnnotationImpl/1 (bit-shift-left-int fNumAnnotations 1))]
            (System/arraycopy fAnnotations 0 newArray 0 fNumAnnotations)
            (set! fAnnotations newArray)))
      (aset fAnnotations
            (let [old-5 fNumAnnotations]
              (set! fNumAnnotations (unchecked-inc-int fNumAnnotations))
              old-5)
            annotation)))

  (method ^:public setImmutable ^void [this ^boolean isImmutable]
    (set! fIsImmutable isImmutable))

  (method ^:public isImmutable ^boolean [this] fIsImmutable))

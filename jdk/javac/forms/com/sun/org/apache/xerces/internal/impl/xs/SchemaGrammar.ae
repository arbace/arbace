    (method ^:private createAnnotationElementDecl ^XSElementDecl [this ^String localName]
      (let [eDecl (XSElementDecl.)]
        (set! (.-fName eDecl) localName)
        (set! (.-fTargetNamespace eDecl) (.-fTargetNamespace this))
        (.setIsGlobal eDecl)
        (set! (.-fBlock eDecl)
              (unchecked-short
                (bit-or-int (bit-or-int XSConstants/DERIVATION_EXTENSION
                                        XSConstants/DERIVATION_RESTRICTION)
                            XSConstants/DERIVATION_SUBSTITUTION)))
        (.setConstraintType eDecl XSConstants/VC_NONE)
        eDecl))

    (method ^:private createUnboundedModelGroupParticle ^XSParticleDecl [this]
      (let [particle (XSParticleDecl.)]
        (set! (.-fMinOccurs particle) 0)
        (set! (.-fMaxOccurs particle) SchemaSymbols/OCCURRENCE_UNBOUNDED)
        (set! (.-fType particle) XSParticleDecl/PARTICLE_MODELGROUP)
        particle))

    (method ^:private createChoiceElementParticle ^XSParticleDecl [this ^XSElementDecl ref]
      (let [particle (XSParticleDecl.)]
        (set! (.-fMinOccurs particle) 1)
        (set! (.-fMaxOccurs particle) 1)
        (set! (.-fType particle) XSParticleDecl/PARTICLE_ELEMENT)
        (set! (.-fValue particle) ref)
        particle))

    (method ^:private createUnboundedAnyWildcardSequenceParticle ^XSParticleDecl [this]
      (let [particle (.createUnboundedModelGroupParticle this)
            sequence (XSModelGroupImpl.)]
        (set! (.-fCompositor sequence) XSModelGroupImpl/MODELGROUP_SEQUENCE)
        (set! (.-fParticleCount sequence) 1)
        (set! (.-fParticles sequence) (new XSParticleDecl/1 1))
        (aset (.-fParticles sequence) 0 (.createAnyLaxWildcardParticle this))
        (set! (.-fValue particle) sequence)
        particle))

    (method ^:private createAnyLaxWildcardParticle ^XSParticleDecl [this]
      (let [particle (XSParticleDecl.)]
        (set! (.-fMinOccurs particle) 1)
        (set! (.-fMaxOccurs particle) 1)
        (set! (.-fType particle) XSParticleDecl/PARTICLE_WILDCARD)
        (let [anyWC (XSWildcardDecl.)]
          (set! (.-fNamespaceList anyWC) nil)
          (set! (.-fType anyWC) XSWildcard/NSCONSTRAINT_ANY)
          (set! (.-fProcessContents anyWC) XSWildcard/PC_LAX)
          (set! (.-fValue particle) anyWC)
          particle))))


  (defclass ^:private ^:static XSAnyType
    :extends XSComplexTypeDecl

    (constructor ^:public [this]
      (set! (.-fName this) SchemaSymbols/ATTVAL_ANYTYPE)
      (set! (.-fTargetNamespace super) SchemaSymbols/URI_SCHEMAFORSCHEMA)
      (set! (.-fBaseType this) this)
      (set! (.-fDerivedBy this) XSConstants/DERIVATION_RESTRICTION)
      (set! (.-fContentType this) XSComplexTypeDecl/CONTENTTYPE_MIXED)
      (set! (.-fParticle this) (.createParticle this))
      (set! (.-fAttrGrp this) (.createAttrGrp this)))

    (method ^:public setValues ^void [this ^String name ^String targetNamespace
                                      ^XSTypeDefinition baseType ^short derivedBy ^short schemaFinal
                                      ^short block ^short contentType ^boolean isAbstract
                                      ^XSAttributeGroupDecl attrGrp ^XSSimpleType simpleType
                                      ^XSParticleDecl particle])

    (method ^:public setName ^void [this ^String name])

    (method ^:public setIsAbstractType ^void [this])

    (method ^:public setContainsTypeID ^void [this])

    (method ^:public setIsAnonymous ^void [this])

    (method ^:public reset ^void [this])

    (method ^:public getAnnotations ^XSObjectList [this]
      XSObjectListImpl/EMPTY_LIST)

    (method ^:public getNamespaceItem ^XSNamespaceItem [this] SG_SchemaNS)

    (method ^:private createAttrGrp ^XSAttributeGroupDecl [this]
      (let [wildcard (XSWildcardDecl.)]
        (set! (.-fProcessContents wildcard) XSWildcardDecl/PC_LAX)
        (let [attrGrp (XSAttributeGroupDecl.)] (set! (.-fAttributeWC attrGrp) wildcard) attrGrp)))

    (method ^:private createParticle ^XSParticleDecl [this]
      (let [wildcard (XSWildcardDecl.)]
        (set! (.-fProcessContents wildcard) XSWildcardDecl/PC_LAX)
        (let [particleW (XSParticleDecl.)]
          (set! (.-fMinOccurs particleW) 0)
          (set! (.-fMaxOccurs particleW) SchemaSymbols/OCCURRENCE_UNBOUNDED)
          (set! (.-fType particleW) XSParticleDecl/PARTICLE_WILDCARD)
          (set! (.-fValue particleW) wildcard)
          (let [group (XSModelGroupImpl.)]
            (set! (.-fCompositor group) XSModelGroupImpl/MODELGROUP_SEQUENCE)
            (set! (.-fParticleCount group) 1)
            (set! (.-fParticles group) (new XSParticleDecl/1 1))
            (aset (.-fParticles group) 0 particleW)
            (let [particleG (XSParticleDecl.)]
              (set! (.-fType particleG) XSParticleDecl/PARTICLE_MODELGROUP)
              (set! (.-fValue particleG) group)
              particleG))))))


              (while true
                (set! node (unchecked-add-int node 1))
                (cond
                  (< (.-_sp this) 0) (do (set! node DTM/NULL) (break))
                  (>= node (aget (.-_stack this) (.-_sp this)))
                    (when (< (set! (.-_sp this) (unchecked-dec-int (.-_sp this))) 0)
                      (set! node DTM/NULL)
                      (break))
                  :else
                    (do
                      (set! expType (._exptype DTMDefaultBaseIterators/this node))
                      (cond
                        (< expType DTM/NTYPES) (when (== expType nodeType) (break))
                        (== (.getType (.-m_expandedNameTable DTMDefaultBaseIterators/this) expType)
                            nodeType)
                          (break)))))))
        (set! (.-_currentNode this) node)
        (if (== node DTM/NULL)
            DTM/NULL
            (.returnNode this (.makeNodeHandle DTMDefaultBaseIterators/this node))))))

  (defclass ^:public FollowingIterator
    :extends InternalAxisIteratorBase

    (field ^DTMAxisTraverser m_traverser)

    (constructor ^:public [this]
      (set! m_traverser (.getAxisTraverser DTMDefaultBaseIterators/this Axis/FOLLOWING)))

    (method ^:public setStartNode ^DTMAxisIterator [this ^:mutable ^int node]
      (when (== node DTMDefaultBase/ROOTNODE)
        (set! node (.getDocument DTMDefaultBaseIterators/this)))
      (if (.-_isRestartable this)
          (do
            (set! (.-_startNode this) node)
            (set! (.-_currentNode this) (.first m_traverser node))
            (.resetPosition this))
          this))

    (method ^:public next ^int [this]
      (let [node (.-_currentNode this)]
        (set! (.-_currentNode this) (.next m_traverser (.-_startNode this) (.-_currentNode this)))
        (.returnNode this node))))

  (defclass ^:public ^:final TypedFollowingIterator
    :extends FollowingIterator

    (field ^:private ^:final ^int _nodeType)

    (constructor ^:public [this ^int type] (set! _nodeType type))

    (method ^:public next ^int [this]
      (let [^:mutable ^int node 0]
        (loop []
          (set! node (.-_currentNode this))
          (set! (.-_currentNode this)
                (.next (.-m_traverser this) (.-_startNode this) (.-_currentNode this)))
          (when (and (not (== node DTM/NULL))
                     (and (not
                            (== (.getExpandedTypeID DTMDefaultBaseIterators/this node) _nodeType))
                          (not (== (.getNodeType DTMDefaultBaseIterators/this node) _nodeType))))
            (recur)))
        (if (== node DTM/NULL) DTM/NULL (.returnNode this node)))))

  (defclass ^:public AncestorIterator
    :extends InternalAxisIteratorBase

    (field ^NodeVector m_ancestors (NodeVector.))

    (field ^int m_ancestorsPos)

    (field ^int m_markedPos)

    (field ^int m_realStartNode)

    (method ^:public getStartNode ^int [this] m_realStartNode)

    (method ^:public ^:final isReverse ^boolean [this] true)

    (method ^:public cloneIterator ^DTMAxisIterator [this]
      (set! (.-_isRestartable this) false)
      (try
        (let [^:final clone (cast AncestorIterator (.clone super))]
          (set! (.-_startNode clone) (.-_startNode this))
          clone)
        (catch CloneNotSupportedException e
          (throw (DTMException.
                   (XMLMessages/createXMLMessage
                     XMLErrorResources/ER_ITERATOR_CLONE_NOT_SUPPORTED
                     nil))))))

    (method ^:public setStartNode ^DTMAxisIterator [this ^:mutable ^int node]
      (when (== node DTMDefaultBase/ROOTNODE)
        (set! node (.getDocument DTMDefaultBaseIterators/this)))
      (set! m_realStartNode node)
      (if (.-_isRestartable this)
          (let [^:mutable nodeID (.makeNodeIdentity DTMDefaultBaseIterators/this node)]
            (when (and (not (.-_includeSelf this)) (not (== node DTM/NULL)))
              (set! nodeID (._parent DTMDefaultBaseIterators/this nodeID))
              (set! node (.makeNodeHandle DTMDefaultBaseIterators/this nodeID)))
            (set! (.-_startNode this) node)
            (while (not (== nodeID AncestorIterator/END))
              (.addElement m_ancestors node)
              (set! nodeID (._parent DTMDefaultBaseIterators/this nodeID))
              (set! node (.makeNodeHandle DTMDefaultBaseIterators/this nodeID)))
            (set! m_ancestorsPos (unchecked-subtract-int (.size m_ancestors) 1))
            (set! (.-_currentNode this)
                  (if (>= m_ancestorsPos 0) (.elementAt m_ancestors m_ancestorsPos) DTM/NULL))
            (.resetPosition this))
          this))

    (method ^:public reset ^DTMAxisIterator [this]
      (set! m_ancestorsPos (unchecked-subtract-int (.size m_ancestors) 1))
      (set! (.-_currentNode this)
            (if (>= m_ancestorsPos 0) (.elementAt m_ancestors m_ancestorsPos) DTM/NULL))
      (.resetPosition this))

    (method ^:public next ^int [this]
      (let [next (.-_currentNode this)
            pos (set! m_ancestorsPos (unchecked-dec-int m_ancestorsPos))]
        (set! (.-_currentNode this)
              (if (>= pos 0) (.elementAt m_ancestors m_ancestorsPos) DTM/NULL))
        (.returnNode this next)))

    (method ^:public setMark ^void [this] (set! m_markedPos m_ancestorsPos))

    (method ^:public gotoMark ^void [this]
      (set! m_ancestorsPos m_markedPos)
      (set! (.-_currentNode this)
            (if (>= m_ancestorsPos 0) (.elementAt m_ancestors m_ancestorsPos) DTM/NULL))))

  (defclass ^:public ^:final TypedAncestorIterator
    :extends AncestorIterator

    (field ^:private ^:final ^int _nodeType)

    (constructor ^:public [this ^int type] (set! _nodeType type))

    (method ^:public setStartNode ^DTMAxisIterator [this ^:mutable ^int node]
      (when (== node DTMDefaultBase/ROOTNODE)
        (set! node (.getDocument DTMDefaultBaseIterators/this)))
      (set! (.-m_realStartNode this) node)
      (if (.-_isRestartable this)
          (let [^:mutable nodeID (.makeNodeIdentity DTMDefaultBaseIterators/this node)
                nodeType _nodeType]
            (when (and (not (.-_includeSelf this)) (not (== node DTM/NULL)))
              (set! nodeID (._parent DTMDefaultBaseIterators/this nodeID)))
            (set! (.-_startNode this) node)
            (if (>= nodeType DTM/NTYPES)
                (while (not (== nodeID TypedAncestorIterator/END))
                  (let [eType (._exptype DTMDefaultBaseIterators/this nodeID)]
                    (when (== eType nodeType)
                      (.addElement (.-m_ancestors this)
                                   (.makeNodeHandle DTMDefaultBaseIterators/this nodeID)))
                    (set! nodeID (._parent DTMDefaultBaseIterators/this nodeID))))
                (while (not (== nodeID TypedAncestorIterator/END))
                  (let [eType (._exptype DTMDefaultBaseIterators/this nodeID)]
                    (when (or (and (>= eType DTM/NTYPES)
                                   (== (.getType
                                         (.-m_expandedNameTable DTMDefaultBaseIterators/this)
                                         eType)
                                       nodeType))
                              (and (< eType DTM/NTYPES) (== eType nodeType)))
                      (.addElement (.-m_ancestors this)
                                   (.makeNodeHandle DTMDefaultBaseIterators/this nodeID)))
                    (set! nodeID (._parent DTMDefaultBaseIterators/this nodeID)))))
            (set! (.-m_ancestorsPos this) (unchecked-subtract-int (.size (.-m_ancestors this)) 1))
            (set! (.-_currentNode this)
                  (if (>= (.-m_ancestorsPos this) 0)
                      (.elementAt (.-m_ancestors this) (.-m_ancestorsPos this))
                      DTM/NULL))
            (.resetPosition this))
          this)))

  (defclass ^:public DescendantIterator
    :extends InternalAxisIteratorBase

    (method ^:public setStartNode ^DTMAxisIterator [this ^:mutable ^int node]
      (when (== node DTMDefaultBase/ROOTNODE)
        (set! node (.getDocument DTMDefaultBaseIterators/this)))
      (if (.-_isRestartable this)
          (do
            (set! node (.makeNodeIdentity DTMDefaultBaseIterators/this node))
            (set! (.-_startNode this) node)
            (when (.-_includeSelf this) (set! node (unchecked-dec-int node)))
            (set! (.-_currentNode this) node)
            (.resetPosition this))
          this))

    (method ^:protected isDescendant ^boolean [this ^int identity]
      (or (>= (._parent DTMDefaultBaseIterators/this identity) (.-_startNode this))
          (== (.-_startNode this) identity)))

    (method ^:public next ^int [this]
      (cond
        (== (.-_startNode this) DTM/NULL) DTM/NULL
        (and (.-_includeSelf this)
             (== (unchecked-add-int (.-_currentNode this) 1) (.-_startNode this)))
          (.returnNode this
                       (.makeNodeHandle DTMDefaultBaseIterators/this
                                        (set! (.-_currentNode this)
                                              (unchecked-inc-int (.-_currentNode this)))))
        :else
          (let [^:mutable node (.-_currentNode this)
                ^:mutable ^int type 0]
            (loop []
              (set! node (unchecked-inc-int node))
              (set! type (._type DTMDefaultBaseIterators/this node))
              (when (or (== DTM/NULL type) (not (.isDescendant this node)))
                (set! (.-_currentNode this) DTM/NULL)
                (return DescendantIterator/END))
              (when (or (or (== DTM/ATTRIBUTE_NODE type) (== DTM/TEXT_NODE type))
                        (== DTM/NAMESPACE_NODE type))
                (recur)))
            (set! (.-_currentNode this) node)
            (.returnNode this (.makeNodeHandle DTMDefaultBaseIterators/this node)))))

    (method ^:public reset ^DTMAxisIterator [this]
      (let [^:final temp (.-_isRestartable this)]
        (set! (.-_isRestartable this) true)
        (.setStartNode this (.makeNodeHandle DTMDefaultBaseIterators/this (.-_startNode this)))
        (set! (.-_isRestartable this) temp)
        this)))

  (defclass ^:public ^:final TypedDescendantIterator
    :extends DescendantIterator

    (field ^:private ^:final ^int _nodeType)

    (constructor ^:public [this ^int nodeType] (set! _nodeType nodeType))

    (method ^:public next ^int [this]
      (let [^:mutable ^int node 0
            ^:mutable ^int type 0]
        (if (== (.-_startNode this) DTM/NULL)
            DTM/NULL
            (do
              (set! node (.-_currentNode this))
              (loop []
                (set! node (unchecked-inc-int node))
                (set! type (._type DTMDefaultBaseIterators/this node))
                (when (or (== DTM/NULL type) (not (.isDescendant this node)))
                  (set! (.-_currentNode this) DTM/NULL)
                  (return TypedDescendantIterator/END))
                (when (and (not (== type _nodeType))
                           (not (== (._exptype DTMDefaultBaseIterators/this node) _nodeType)))
                  (recur)))
              (set! (.-_currentNode this) node)
              (.returnNode this (.makeNodeHandle DTMDefaultBaseIterators/this node)))))))

  (defclass ^:public NthDescendantIterator
    :extends DescendantIterator

    (field ^int _pos)

    (constructor ^:public [this ^int pos] (set! _pos pos))

    (method ^:public next ^int [this]
      (let [^:mutable ^int node 0]
        (while (not (== (set! node (.next super)) NthDescendantIterator/END))
          (set! node (.makeNodeIdentity DTMDefaultBaseIterators/this node))
          (let [parent (._parent DTMDefaultBaseIterators/this node)
                ^:mutable child (._firstch DTMDefaultBaseIterators/this parent)
                ^:mutable ^int pos 0]
            (loop []
              (let [^int type (._type DTMDefaultBaseIterators/this child)]
                (when (== DTM/ELEMENT_NODE type) (set! pos (unchecked-inc-int pos))))
              (when (and (< pos _pos)
                         (not (== (set! child (._nextsib DTMDefaultBaseIterators/this child))
                                  NthDescendantIterator/END)))
                (recur)))
            (when (== node child) (return node))))
        NthDescendantIterator/END)))

  (defclass ^:public SingletonIterator
    :extends InternalAxisIteratorBase

    (field ^:private ^boolean _isConstant)

    (constructor ^:public [this] (this. Integer/MIN_VALUE false))

    (constructor ^:public [this ^int node] (this. node false))

    (constructor ^:public [this ^int node ^boolean constant]
      (set! (.-_currentNode this) (set! (.-_startNode this) node))
      (set! _isConstant constant))

    (method ^:public setStartNode ^DTMAxisIterator [this ^:mutable ^int node]
      (when (== node DTMDefaultBase/ROOTNODE)
        (set! node (.getDocument DTMDefaultBaseIterators/this)))
      (cond
        _isConstant (do (set! (.-_currentNode this) (.-_startNode this)) (.resetPosition this))
        (.-_isRestartable this)
          (do (set! (.-_currentNode this) (set! (.-_startNode this) node)) (.resetPosition this))
        :else this))

    (method ^:public reset ^DTMAxisIterator [this]
      (if _isConstant
          (do (set! (.-_currentNode this) (.-_startNode this)) (.resetPosition this))
          (do
            (let [^:final temp (.-_isRestartable this)]
              (set! (.-_isRestartable this) true)
              (.setStartNode this (.-_startNode this))
              (set! (.-_isRestartable this) temp))
            this)))

    (method ^:public next ^int [this]
      (let [^:final result (.-_currentNode this)]
        (set! (.-_currentNode this) SingletonIterator/END)
        (.returnNode this result))))

  (defclass ^:public ^:final TypedSingletonIterator
    :extends SingletonIterator

    (field ^:private ^:final ^int _nodeType)

    (constructor ^:public [this ^int nodeType] (set! _nodeType nodeType))

    (method ^:public next ^int [this]
      (let [^:final result (.-_currentNode this)
            nodeType _nodeType]
        (set! (.-_currentNode this) TypedSingletonIterator/END)
        (cond
          (>= nodeType DTM/NTYPES)
            (when (== (.getExpandedTypeID DTMDefaultBaseIterators/this result) nodeType)
              (return (.returnNode this result)))
          (== (.getNodeType DTMDefaultBaseIterators/this result) nodeType)
            (return (.returnNode this result)))
        DTM/NULL))))

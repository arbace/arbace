  (method ^:public ^:static translateURItoJCEID ^String [^String algorithmURI]
    (let [algorithm (JCEMapper/getAlgorithm algorithmURI)]
      (when (some? algorithm) (.-jceName algorithm))))

  (method ^:public ^:static getAlgorithmClassFromURI ^String [^String algorithmURI]
    (let [algorithm (JCEMapper/getAlgorithm algorithmURI)]
      (when (some? algorithm) (.-algorithmClass algorithm))))

  (method ^:public ^:static getKeyLengthFromURI ^int [^String algorithmURI]
    (let [algorithm (JCEMapper/getAlgorithm algorithmURI)]
      (if (some? algorithm) (.-keyLength algorithm) 0)))

  (method ^:public ^:static getIVLengthFromURI ^int [^String algorithmURI]
    (let [algorithm (JCEMapper/getAlgorithm algorithmURI)]
      (if (some? algorithm) (.-ivLength algorithm) 0)))

  (method ^:public ^:static getJCEKeyAlgorithmFromURI ^String [^String algorithmURI]
    (let [algorithm (JCEMapper/getAlgorithm algorithmURI)]
      (when (some? algorithm) (.-requiredKey algorithm))))

  (method ^:public ^:static getJCEProviderFromURI ^String [^String algorithmURI]
    (let [algorithm (JCEMapper/getAlgorithm algorithmURI)]
      (when (some? algorithm) (.-jceProvider algorithm))))

  (method ^:private ^:static getAlgorithm ^Algorithm [^String algorithmURI]

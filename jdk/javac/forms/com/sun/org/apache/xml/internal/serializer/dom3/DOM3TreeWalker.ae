                          (when (and (XMLChar/isLowSurrogate ch2)
                                     (XMLChar/isSupplemental (XMLChar/supplemental ch ch2)))
                            (continue))))
                      (set! refInvalidChar ch)
                      (return refInvalidChar))))))
          nil))))

  (method ^:protected isCommentWellFormed ^void [this ^String data]
    (when-not (or (nil? data) (== (.length data) 0))
      (let [dataarray (.toCharArray data)
            datalength (alength dataarray)]
        (if fIsXMLVersion11
            (let [^:mutable ^int i 0]
              (while (< i datalength)
                (let [c (aget dataarray (let [old-9 i] (set! i (unchecked-inc-int i)) old-9))]
                  (cond
                    (XML11Char/isXML11Invalid c)
                      (do
                        (when (and (XMLChar/isHighSurrogate c) (< i datalength))
                          (let [c2 (aget dataarray
                                         (let [old-10 i] (set! i (unchecked-inc-int i)) old-10))]
                            (when (and (XMLChar/isLowSurrogate c2)
                                       (XMLChar/isSupplemental (XMLChar/supplemental c c2)))
                              (continue))))
                        (let [msg (.createMessage
                                    Utils/messages
                                    MsgKey/ER_WF_INVALID_CHARACTER_IN_COMMENT
                                    (new Object/1 [c]))]
                          (when (some? fErrorHandler)
                            (.handleError fErrorHandler
                                          (DOMErrorImpl.
                                            DOMError/SEVERITY_FATAL_ERROR
                                            msg
                                            MsgKey/ER_WF_INVALID_CHARACTER
                                            nil
                                            nil
                                            nil)))))
                    (and (and (== c \-) (< i datalength)) (== (aget dataarray i) \-))
                      (let [msg (.createMessage Utils/messages MsgKey/ER_WF_DASH_IN_COMMENT nil)]
                        (when (some? fErrorHandler)
                          (.handleError fErrorHandler
                                        (DOMErrorImpl.
                                          DOMError/SEVERITY_FATAL_ERROR
                                          msg
                                          MsgKey/ER_WF_INVALID_CHARACTER
                                          nil
                                          nil
                                          nil))))))))
            (let [^:mutable ^int i 0]
              (while (< i datalength)
                (let [c (aget dataarray (let [old-11 i] (set! i (unchecked-inc-int i)) old-11))]
                  (cond
                    (XMLChar/isInvalid c)
                      (do
                        (when (and (XMLChar/isHighSurrogate c) (< i datalength))
                          (let [c2 (aget dataarray
                                         (let [old-12 i] (set! i (unchecked-inc-int i)) old-12))]
                            (when (and (XMLChar/isLowSurrogate c2)
                                       (XMLChar/isSupplemental (XMLChar/supplemental c c2)))
                              (continue))))
                        (let [msg (.createMessage
                                    Utils/messages
                                    MsgKey/ER_WF_INVALID_CHARACTER_IN_COMMENT
                                    (new Object/1 [c]))]
                          (when (some? fErrorHandler)
                            (.handleError fErrorHandler
                                          (DOMErrorImpl.
                                            DOMError/SEVERITY_FATAL_ERROR
                                            msg
                                            MsgKey/ER_WF_INVALID_CHARACTER
                                            nil
                                            nil
                                            nil)))))
                    (and (and (== c \-) (< i datalength)) (== (aget dataarray i) \-))
                      (let [msg (.createMessage Utils/messages MsgKey/ER_WF_DASH_IN_COMMENT nil)]
                        (when (some? fErrorHandler)
                          (.handleError fErrorHandler
                                        (DOMErrorImpl.
                                          DOMError/SEVERITY_FATAL_ERROR
                                          msg
                                          MsgKey/ER_WF_INVALID_CHARACTER
                                          nil
                                          nil
                                          nil))))))))))))

  (method ^:protected isElementWellFormed ^void [this ^Node node]
    (let [^:mutable isNameWF false]
      (if (not (== (bit-and-int fFeatures NAMESPACES) 0))
          (set! isNameWF
                (.isValidQName this (.getPrefix node) (.getLocalName node) fIsXMLVersion11))
          (set! isNameWF (.isXMLName this (.getNodeName node) fIsXMLVersion11)))
      (when-not isNameWF
        (let [msg (.createMessage Utils/messages
                                  MsgKey/ER_WF_INVALID_CHARACTER_IN_NODE_NAME
                                  (new Object/1 ["Element" (.getNodeName node)]))]
          (when (some? fErrorHandler)
            (.handleError fErrorHandler
                          (DOMErrorImpl. DOMError/SEVERITY_FATAL_ERROR
                                         msg
                                         MsgKey/ER_WF_INVALID_CHARACTER_IN_NODE_NAME
                                         nil
                                         nil
                                         nil)))))))

  (method ^:protected isAttributeWellFormed ^void [this ^Node node]
    (let [^:mutable isNameWF false]
      (if (not (== (bit-and-int fFeatures NAMESPACES) 0))
          (set! isNameWF
                (.isValidQName this (.getPrefix node) (.getLocalName node) fIsXMLVersion11))
          (set! isNameWF (.isXMLName this (.getNodeName node) fIsXMLVersion11)))
      (when-not isNameWF
        (let [msg (.createMessage Utils/messages
                                  MsgKey/ER_WF_INVALID_CHARACTER_IN_NODE_NAME
                                  (new Object/1 ["Attr" (.getNodeName node)]))]
          (when (some? fErrorHandler)
            (.handleError fErrorHandler
                          (DOMErrorImpl. DOMError/SEVERITY_FATAL_ERROR
                                         msg
                                         MsgKey/ER_WF_INVALID_CHARACTER_IN_NODE_NAME
                                         nil
                                         nil
                                         nil)))))
      (let [value (.getNodeValue node)]
        (when (>= (.indexOf value \<) 0)
          (let [msg (.createMessage Utils/messages
                                    MsgKey/ER_WF_LT_IN_ATTVAL
                                    (new Object/1
                                         [(.getNodeName (.getOwnerElement (cast Attr node)))
                                          (.getNodeName node)]))]
            (when (some? fErrorHandler)
              (.handleError fErrorHandler
                            (DOMErrorImpl. DOMError/SEVERITY_FATAL_ERROR
                                           msg
                                           MsgKey/ER_WF_LT_IN_ATTVAL
                                           nil
                                           nil
                                           nil)))))
        (let [children (.getChildNodes node)]
          (loop [^int i 0]
            (when (< i (.getLength children))
              (let [child (.item children i)]
                (if (nil? child)
                    (recur (unchecked-inc-int i))
                    (switch (.getNodeType child)
                      Node/TEXT_NODE
                        (do
                          (.isTextWellFormed this (cast Text child))
                          (recur (unchecked-inc-int i)))
                      Node/ENTITY_REFERENCE_NODE
                        (do
                          (.isEntityReferneceWellFormed this (cast EntityReference child))
                          (recur (unchecked-inc-int i)))
                      (recur (unchecked-inc-int i)))))))))))

  (method ^:protected isPIWellFormed ^void [this ^ProcessingInstruction node]
    (when-not (.isXMLName this (.getNodeName node) fIsXMLVersion11)
      (let [msg (.createMessage Utils/messages
                                MsgKey/ER_WF_INVALID_CHARACTER_IN_NODE_NAME
                                (new Object/1 ["ProcessingInstruction" (.getTarget node)]))]
        (when (some? fErrorHandler)
          (.handleError fErrorHandler
                        (DOMErrorImpl. DOMError/SEVERITY_FATAL_ERROR
                                       msg
                                       MsgKey/ER_WF_INVALID_CHARACTER_IN_NODE_NAME
                                       nil
                                       nil
                                       nil)))))
    (let [invalidChar (.isWFXMLChar this (.getData node))]
      (when (some? invalidChar)
        (let [msg (.createMessage Utils/messages
                                  MsgKey/ER_WF_INVALID_CHARACTER_IN_PI
                                  (new Object/1
                                       [(Integer/toHexString
                                          (Character/getNumericValue (.charValue invalidChar)))]))]
          (when (some? fErrorHandler)
            (.handleError fErrorHandler
                          (DOMErrorImpl. DOMError/SEVERITY_FATAL_ERROR
                                         msg
                                         MsgKey/ER_WF_INVALID_CHARACTER
                                         nil
                                         nil
                                         nil)))))))

  (method ^:protected isCDATASectionWellFormed ^void [this ^CDATASection node]
    (let [invalidChar (.isWFXMLChar this (.getData node))]
      (when (some? invalidChar)
        (let [msg (.createMessage Utils/messages
                                  MsgKey/ER_WF_INVALID_CHARACTER_IN_CDATA
                                  (new Object/1
                                       [(Integer/toHexString
                                          (Character/getNumericValue (.charValue invalidChar)))]))]
          (when (some? fErrorHandler)
            (.handleError fErrorHandler
                          (DOMErrorImpl. DOMError/SEVERITY_FATAL_ERROR
                                         msg
                                         MsgKey/ER_WF_INVALID_CHARACTER
                                         nil
                                         nil
                                         nil)))))))

  (method ^:protected isTextWellFormed ^void [this ^Text node]
    (let [invalidChar (.isWFXMLChar this (.getData node))]
      (when (some? invalidChar)
        (let [msg (.createMessage Utils/messages
                                  MsgKey/ER_WF_INVALID_CHARACTER_IN_TEXT
                                  (new Object/1
                                       [(Integer/toHexString
                                          (Character/getNumericValue (.charValue invalidChar)))]))]
          (when (some? fErrorHandler)
            (.handleError fErrorHandler
                          (DOMErrorImpl. DOMError/SEVERITY_FATAL_ERROR
                                         msg
                                         MsgKey/ER_WF_INVALID_CHARACTER
                                         nil
                                         nil
                                         nil)))))))

  (method ^:protected isEntityReferneceWellFormed ^void [this ^EntityReference node]
    (when-not (.isXMLName this (.getNodeName node) fIsXMLVersion11)
      (let [msg (.createMessage Utils/messages
                                MsgKey/ER_WF_INVALID_CHARACTER_IN_NODE_NAME
                                (new Object/1 ["EntityReference" (.getNodeName node)]))]
        (when (some? fErrorHandler)
          (.handleError fErrorHandler
                        (DOMErrorImpl. DOMError/SEVERITY_FATAL_ERROR
                                       msg
                                       MsgKey/ER_WF_INVALID_CHARACTER_IN_NODE_NAME
                                       nil
                                       nil
                                       nil)))))
    (let [parent (.getParentNode node)
          docType (.getDoctype (.getOwnerDocument node))]
      (when (some? docType)
        (let [entities (.getEntities docType)]
          (loop [^int i 0]
            (when (< i (.getLength entities))
              (let [ent (cast Entity (.item entities i))
                    ^String nodeName (if (nil? (.getNodeName node)) "" (.getNodeName node))
                    ^String nodeNamespaceURI (if (nil? (.getNamespaceURI node))
                                                 ""
                                                 (.getNamespaceURI node))
                    ^String entName (if (nil? (.getNodeName ent)) "" (.getNodeName ent))
                    ^String entNamespaceURI (if (nil? (.getNamespaceURI ent))
                                                ""
                                                (.getNamespaceURI ent))]
                (when (== (.getNodeType parent) Node/ELEMENT_NODE)
                  (when (and (.equals entNamespaceURI nodeNamespaceURI) (.equals entName nodeName))
                    (when (some? (.getNotationName ent))
                      (let [msg (.createMessage Utils/messages
                                                MsgKey/ER_WF_REF_TO_UNPARSED_ENT
                                                (new Object/1 [(.getNodeName node)]))]
                        (when (some? fErrorHandler)
                          (.handleError fErrorHandler
                                        (DOMErrorImpl.
                                          DOMError/SEVERITY_FATAL_ERROR
                                          msg
                                          MsgKey/ER_WF_REF_TO_UNPARSED_ENT
                                          nil
                                          nil
                                          nil)))))))
                (if (== (.getNodeType parent) Node/ATTRIBUTE_NODE)
                    (if (and (.equals entNamespaceURI nodeNamespaceURI) (.equals entName nodeName))
                        (if (or (or (some? (.getPublicId ent)) (some? (.getSystemId ent)))
                                (some? (.getNotationName ent)))
                            (let [msg (.createMessage
                                        Utils/messages
                                        MsgKey/ER_WF_REF_TO_EXTERNAL_ENT
                                        (new Object/1 [(.getNodeName node)]))]
                              (if (some? fErrorHandler)
                                  (do
                                    (.handleError
                                      fErrorHandler
                                      (DOMErrorImpl.
                                        DOMError/SEVERITY_FATAL_ERROR
                                        msg
                                        MsgKey/ER_WF_REF_TO_EXTERNAL_ENT
                                        nil
                                        nil
                                        nil))
                                    (recur (unchecked-inc-int i)))
                                  (recur (unchecked-inc-int i))))
                            (recur (unchecked-inc-int i)))
                        (recur (unchecked-inc-int i)))
                    (recur (unchecked-inc-int i))))))))))

  (method ^:protected checkUnboundPrefixInEntRef ^void [this ^Node node]
    (let [^:mutable ^Node child nil
          ^:mutable ^Node next nil]
      (set! child (.getFirstChild node))
      (while (some? child)
        (set! next (.getNextSibling child))
        (when (== (.getNodeType child) Node/ELEMENT_NODE)
          (let [prefix (.getPrefix child)]
            (when (and (some? prefix) (nil? (.getURI fNSBinder prefix)))
              (let [msg (.createMessage Utils/messages
                                        MsgKey/ER_ELEM_UNBOUND_PREFIX_IN_ENTREF
                                        (new Object/1
                                             [(.getNodeName node) (.getNodeName child) prefix]))]
                (when (some? fErrorHandler)
                  (.handleError fErrorHandler
                                (DOMErrorImpl. DOMError/SEVERITY_FATAL_ERROR
                                               msg
                                               MsgKey/ER_ELEM_UNBOUND_PREFIX_IN_ENTREF
                                               nil
                                               nil
                                               nil)))))
            (let [attrs (.getAttributes child)]
              (loop [^int i 0]
                (when (< i (.getLength attrs))
                  (let [attrPrefix (.getPrefix (.item attrs i))]
                    (if (and (some? attrPrefix) (nil? (.getURI fNSBinder attrPrefix)))
                        (let [msg (.createMessage
                                    Utils/messages
                                    MsgKey/ER_ATTR_UNBOUND_PREFIX_IN_ENTREF
                                    (new Object/1
                                         [(.getNodeName node) (.getNodeName child) (.item attrs i)]))]
                          (if (some? fErrorHandler)
                              (do
                                (.handleError fErrorHandler
                                              (DOMErrorImpl.
                                                DOMError/SEVERITY_FATAL_ERROR
                                                msg
                                                MsgKey/ER_ATTR_UNBOUND_PREFIX_IN_ENTREF
                                                nil
                                                nil
                                                nil))
                                (recur (unchecked-inc-int i)))
                              (recur (unchecked-inc-int i))))
                        (recur (unchecked-inc-int i)))))))))
        (when (.hasChildNodes child) (.checkUnboundPrefixInEntRef this child))
        (set! child next))))

  (method ^:protected recordLocalNSDecl ^void [this ^Node node]
    (let [atts (.getAttributes (cast Element node))
          length (.getLength atts)]
      (loop [^int i 0]
        (when (< i length)
          (let [attr (.item atts i)
                ^:mutable localName (.getLocalName attr)
                ^:mutable attrPrefix (.getPrefix attr)
                ^:mutable attrValue (.getNodeValue attr)
                ^:mutable attrNS (.getNamespaceURI attr)]
            (set! localName
                  (if (or (nil? localName) (.equals XMLNS_PREFIX localName)) "" localName))
            (set! attrPrefix (if (nil? attrPrefix) "" attrPrefix))
            (set! attrValue (if (nil? attrValue) "" attrValue))
            (set! attrNS (if (nil? attrNS) "" attrNS))
            (if (.equals XMLNS_URI attrNS)
                (cond
                  (.equals XMLNS_URI attrValue)
                    (let [msg (.createMessage Utils/messages
                                              MsgKey/ER_NS_PREFIX_CANNOT_BE_BOUND
                                              (new Object/1 [attrPrefix XMLNS_URI]))]
                      (if (some? fErrorHandler)
                          (do
                            (.handleError fErrorHandler
                                          (DOMErrorImpl.
                                            DOMError/SEVERITY_ERROR
                                            msg
                                            MsgKey/ER_NS_PREFIX_CANNOT_BE_BOUND
                                            nil
                                            nil
                                            nil))
                            (recur (unchecked-inc-int i)))
                          (recur (unchecked-inc-int i))))
                  (.equals XMLNS_PREFIX attrPrefix)
                    (if (not (== (.length attrValue) 0))
                        (do
                          (.declarePrefix fNSBinder localName attrValue)
                          (recur (unchecked-inc-int i)))
                        (recur (unchecked-inc-int i)))
                  :else (do (.declarePrefix fNSBinder "" attrValue) (recur (unchecked-inc-int i))))
                (recur (unchecked-inc-int i))))))))

  (method ^:protected fixupElementNS :throws [SAXException] ^void [this ^Node node]
    (let [^:mutable namespaceURI (.getNamespaceURI (cast Element node))
          ^:mutable prefix (.getPrefix (cast Element node))
          localName (.getLocalName (cast Element node))]
      (cond
        (some? namespaceURI)
          (do
            (set! prefix (if (nil? prefix) "" prefix))
            (let [inScopeNamespaceURI (.getURI fNSBinder prefix)]
              (when-not (and (some? inScopeNamespaceURI) (.equals inScopeNamespaceURI namespaceURI))
                (when-not (== (bit-and-int fFeatures NAMESPACEDECLS) 0)
                  (if (or (.equals "" prefix) (.equals "" namespaceURI))
                      (.setAttributeNS (cast Element node) XMLNS_URI XMLNS_PREFIX namespaceURI)
                      (.setAttributeNS (cast Element node)
                                       XMLNS_URI
                                       (java-str (java-str XMLNS_PREFIX ":") prefix)
                                       namespaceURI)))
                (.declarePrefix fLocalNSBinder prefix namespaceURI)
                (.declarePrefix fNSBinder prefix namespaceURI))))
        (or (nil? localName) (.equals "" localName))
          (let [msg (.createMessage Utils/messages
                                    MsgKey/ER_NULL_LOCAL_ELEMENT_NAME
                                    (new Object/1 [(.getNodeName node)]))]
            (when (some? fErrorHandler)
              (.handleError fErrorHandler
                            (DOMErrorImpl. DOMError/SEVERITY_ERROR
                                           msg
                                           MsgKey/ER_NULL_LOCAL_ELEMENT_NAME
                                           nil
                                           nil
                                           nil))))
        :else
          (do
            (set! namespaceURI (.getURI fNSBinder ""))
            (when (and (some? namespaceURI) (> (.length namespaceURI) 0))
              (.setAttributeNS (cast Element node) XMLNS_URI XMLNS_PREFIX "")
              (.declarePrefix fLocalNSBinder "" "")
              (.declarePrefix fNSBinder "" ""))))))

  (field ^:private ^:static ^:final ^{:tag (Map String Integer)} fFeatureMap)

  (static-initializer
    (let [^{:tag (Map String Integer)} featureMap (HashMap.)]
      (.put featureMap
            (java-str DOMConstants/S_DOM3_PROPERTIES_NS DOMConstants/DOM_CDATA_SECTIONS)
            CDATA)
      (.put featureMap
            (java-str DOMConstants/S_DOM3_PROPERTIES_NS DOMConstants/DOM_COMMENTS)
            COMMENTS)
      (.put featureMap
            (java-str DOMConstants/S_DOM3_PROPERTIES_NS DOMConstants/DOM_ELEMENT_CONTENT_WHITESPACE)
            ELEM_CONTENT_WHITESPACE)
      (.put featureMap
            (java-str DOMConstants/S_DOM3_PROPERTIES_NS DOMConstants/DOM_ENTITIES)
            ENTITIES)
      (.put featureMap
            (java-str DOMConstants/S_DOM3_PROPERTIES_NS DOMConstants/DOM_NAMESPACES)
            NAMESPACES)
      (.put featureMap
            (java-str DOMConstants/S_DOM3_PROPERTIES_NS DOMConstants/DOM_NAMESPACE_DECLARATIONS)
            NAMESPACEDECLS)
      (.put featureMap
            (java-str DOMConstants/S_DOM3_PROPERTIES_NS DOMConstants/DOM_SPLIT_CDATA)
            SPLITCDATA)
      (.put featureMap
            (java-str DOMConstants/S_DOM3_PROPERTIES_NS DOMConstants/DOM_WELLFORMED)
            WELLFORMED)
      (.put featureMap
            (java-str DOMConstants/S_DOM3_PROPERTIES_NS DOMConstants/DOM_DISCARD_DEFAULT_CONTENT)
            DISCARDDEFAULT)
      (set! fFeatureMap (Collections/unmodifiableMap featureMap))))

  (method ^:protected initProperties ^void [this ^Properties properties]
    (for-each [^String key (.stringPropertyNames properties)]
      (let [^:final bitFlag (cast Integer (.get fFeatureMap key))]
        (cond
          (some? bitFlag)
            (if (.endsWith (.getProperty properties key) "yes")
                (set! fFeatures (bit-or-int fFeatures bitFlag))
                (set! fFeatures (bit-and-int fFeatures (bit-not-int bitFlag))))
          (.equals (java-str DOMConstants/S_DOM3_PROPERTIES_NS DOMConstants/DOM_FORMAT_PRETTY_PRINT)
                   key)
            (if (.endsWith (.getProperty properties key) "yes")
                (do (.setIndent fSerializer true) (.setIndentAmount fSerializer 4))
                (.setIndent fSerializer false))
          (.equals DOMConstants/S_XSL_OUTPUT_OMIT_XML_DECL key)
            (if (.endsWith (.getProperty properties key) "yes")
                (.setOmitXMLDeclaration fSerializer true)
                (.setOmitXMLDeclaration fSerializer false))
          (.equals (java-str DOMConstants/S_XERCES_PROPERTIES_NS DOMConstants/S_XML_VERSION) key)
            (let [version (.getProperty properties key)]
              (if (.equals "1.1" version)
                  (do (set! fIsXMLVersion11 true) (.setVersion fSerializer version))
                  (.setVersion fSerializer "1.0")))
          (.equals DOMConstants/S_XSL_OUTPUT_ENCODING key)
            (let [encoding (.getProperty properties key)]
              (when (some? encoding) (.setEncoding fSerializer encoding)))
          (.equals OutputPropertiesFactory/S_KEY_ENTITIES key)
            (let [entities (.getProperty properties key)]
              (when (.equals DOMConstants/S_XSL_VALUE_ENTITIES entities)
                (.setDTDEntityExpansion fSerializer false))))))
    (when (some? fNewLine)
      (.setOutputProperty fSerializer OutputPropertiesFactory/S_KEY_LINE_SEPARATOR fNewLine))))

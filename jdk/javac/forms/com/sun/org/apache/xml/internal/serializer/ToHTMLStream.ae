  (defclass ^:static Trie
    (field ^:public ^:static ^:final ^int ALPHA_SIZE 128)

    (field ^:final ^Node m_Root)

    (field ^:private ^char/1 m_charBuffer (new char/1 0))

    (field ^:private ^:final ^boolean m_lowerCaseOnly)

    (constructor ^:public [this]
      (set! m_Root (Node.))
      (set! m_lowerCaseOnly false))

    (constructor ^:public [this ^boolean lowerCaseOnly]
      (set! m_Root (Node.))
      (set! m_lowerCaseOnly lowerCaseOnly))

    (method ^:public put [this ^String key value]

    (.printText (.-_printer this) \"))

  (method ^:private printAttribute :throws [IOException] ^void [this ^String name ^String value
                                                                ^boolean isSpecified ^Attr attr]
    (when (or isSpecified (== (bit-and-int (.-features this) DOMSerializerImpl/DISCARDDEFAULT) 0))
      (when (and (some? (.-fDOMFilter this))
                 (not (== (bit-and-int (.getWhatToShow (.-fDOMFilter this))
                                       NodeFilter/SHOW_ATTRIBUTE)
                          0)))
        (let [code (.acceptNode (.-fDOMFilter this) attr)]
          (switch code (NodeFilter/FILTER_REJECT NodeFilter/FILTER_SKIP) (return) nil)))
      (.printSpace (.-_printer this))
      (.printText (.-_printer this) name)
      (.printText (.-_printer this) "=\"")
      (.printEscaped this value)
      (.printText (.-_printer this) \"))
    (when (.equals name "xml:space")
      (if (.equals value "preserve")
          (set! fPreserveSpace true)
          (set! fPreserveSpace (.getPreserveSpace (.-_format this))))))

  (method ^:protected getEntityRef ^String [this ^int ch]
    (switch ch
      \< (return "lt")
      \> (return "gt")
      \" (return "quot")
      \' (return "apos")
      \& (return "amp"))
    nil)

  (method ^:private extractNamespaces :throws [SAXException] ^Attributes [this ^Attributes attrs]
    (let [^:mutable ^AttributesImpl attrsOnly nil
          ^:mutable ^String rawName nil
          ^:mutable ^int i 0
          ^:mutable ^int length 0]
      (when (some? attrs)
        (set! length (.getLength attrs))
        (set! attrsOnly (AttributesImpl. attrs))
        (set! i (unchecked-subtract-int length 1))
        (while (>= i 0)
          (set! rawName (.getQName attrsOnly i))
          (when (.startsWith rawName "xmlns")
            (if (== (.length rawName) 5)
                (do
                  (.startPrefixMapping this "" (.getValue attrs i))
                  (.removeAttribute attrsOnly i))
                (when (== (.charAt rawName 5) \:)
                  (.startPrefixMapping this (.substring rawName 6) (.getValue attrs i))
                  (.removeAttribute attrsOnly i))))
          (set! i (unchecked-dec-int i)))
        attrsOnly)))

  (method ^:protected printEscaped :throws [IOException] ^void [this ^String source]
    (let [length (.length source)
          ^:mutable ^int i 0]
      (while (< i length)
        (let [^int ch (.charAt source i)]
          (cond
            (not (XMLChar/isValid ch))
              (if (< (set! i (unchecked-inc-int i)) length)
                  (.surrogates this ch (.charAt source i) false)
                  (.fatalError this
                               (java-str "The character '"
                                         (unchecked-char ch)
                                         "' is an invalid XML character")))
            (or (or (== ch \newline) (== ch \return)) (== ch \tab)) (.printHex this ch)
            (== ch \<) (.printText (.-_printer this) "&lt;")
            (== ch \&) (.printText (.-_printer this) "&amp;")
            (== ch \") (.printText (.-_printer this) "&quot;")
            (and (>= ch \space) (.isPrintable (.-_encodingInfo this) (unchecked-char ch)))
              (.printText (.-_printer this) (unchecked-char ch))
            :else (.printHex this ch)))
        (set! i (unchecked-inc-int i)))))

  (method ^:protected printXMLChar :throws [IOException] ^void [this ^int ch]
    (cond
      (== ch \return) (.printHex this ch)
      (== ch \<) (.printText (.-_printer this) "&lt;")
      (== ch \&) (.printText (.-_printer this) "&amp;")
      (== ch \>) (.printText (.-_printer this) "&gt;")
      (or (or (== ch \newline) (== ch \tab))
          (and (>= ch \space) (.isPrintable (.-_encodingInfo this) (unchecked-char ch))))
        (.printText (.-_printer this) (unchecked-char ch))
      :else (.printHex this ch)))

  (method ^:protected printText :throws [IOException] ^void [this ^String text
                                                             ^boolean preserveSpace
                                                             ^boolean unescaped]
    (let [^:mutable ^int index 0
          ^:mutable ^char ch (unchecked-char 0)
          length (.length text)]
      (if preserveSpace
          (do
            (set! index 0)
            (while (< index length)
              (set! ch (.charAt text index))
              (cond
                (not (XMLChar/isValid ch))
                  (if (< (set! index (unchecked-inc-int index)) length)
                      (.surrogates this ch (.charAt text index) true)
                      (.fatalError this
                                   (java-str "The character '" ch "' is an invalid XML character")))
                unescaped (.printText (.-_printer this) ch)
                :else (.printXMLChar this ch))
              (set! index (unchecked-inc-int index))))
          (do
            (set! index 0)
            (while (< index length)
              (set! ch (.charAt text index))
              (cond
                (not (XMLChar/isValid ch))
                  (if (< (set! index (unchecked-inc-int index)) length)
                      (.surrogates this ch (.charAt text index) true)
                      (.fatalError this
                                   (java-str "The character '" ch "' is an invalid XML character")))
                unescaped (.printText (.-_printer this) ch)
                :else (.printXMLChar this ch))
              (set! index (unchecked-inc-int index)))))))

  (method ^:protected printText :throws [IOException] ^void [this ^char/1 chars ^:mutable ^int start
                                                             ^:mutable ^int length
                                                             ^boolean preserveSpace
                                                             ^boolean unescaped]
    (if preserveSpace
        (while (> (let [old-1 length] (set! length (unchecked-dec-int length)) old-1) 0)
          (let [ch (aget chars (let [old-2 start] (set! start (unchecked-inc-int start)) old-2))]
            (cond
              (not (XMLChar/isValid ch))
                (if (> (let [old-3 length] (set! length (unchecked-dec-int length)) old-3) 0)
                    (do
                      (.surrogates this ch (aget chars start) true)
                      (set! start (unchecked-inc-int start)))
                    (.fatalError this
                                 (java-str "The character '" ch "' is an invalid XML character")))
              unescaped (.printText (.-_printer this) ch)
              :else (.printXMLChar this ch))))
        (while (> (let [old-4 length] (set! length (unchecked-dec-int length)) old-4) 0)
          (let [ch (aget chars (let [old-5 start] (set! start (unchecked-inc-int start)) old-5))]
            (cond
              (not (XMLChar/isValid ch))
                (if (> (let [old-6 length] (set! length (unchecked-dec-int length)) old-6) 0)
                    (do
                      (.surrogates this ch (aget chars start) true)
                      (set! start (unchecked-inc-int start)))
                    (.fatalError this
                                 (java-str "The character '" ch "' is an invalid XML character")))
              unescaped (.printText (.-_printer this) ch)
              :else (.printXMLChar this ch))))))

  (method ^:protected checkUnboundNamespacePrefixedNode :throws [IOException] ^void [this ^Node node]
    (when fNamespaces
      (when DEBUG
        (.println System/out
                  (java-str "==>serializeNode("
                            (.getNodeName node)
                            ") [Entity Reference - Namespaces on]"))
        (.println System/out
                  (java-str "==>Declared Prefix Count: " (.getDeclaredPrefixCount fNSBinder)))
        (.println System/out (java-str "==>Node Name: " (.getNodeName node)))
        (.println System/out
                  (java-str "==>First Child Node Name: " (.getNodeName (.getFirstChild node))))
        (.println System/out
                  (java-str "==>First Child Node Prefix: " (.getPrefix (.getFirstChild node))))
        (.println System/out
                  (java-str "==>First Child Node NamespaceURI: "
                            (.getNamespaceURI (.getFirstChild node)))))
      (let [^:mutable ^Node child nil
            ^:mutable ^Node next nil]
        (set! child (.getFirstChild node))
        (while (some? child)
          (set! next (.getNextSibling child))
          (when DEBUG
            (.println System/out
                      (java-str "==>serializeNode(" (.getNodeName child) ") [Child Node]"))
            (.println System/out
                      (java-str "==>serializeNode(" (.getPrefix child) ") [Child Node Prefix]")))
          (let [^:mutable prefix (.getPrefix child)]
            (set! prefix
                  (if (or (nil? prefix) (== (.length prefix) 0))
                      XMLSymbols/EMPTY_STRING
                      (.addSymbol fSymbolTable prefix)))
            (when (and (nil? (.getURI fNSBinder prefix)) (some? prefix))
              (.fatalError this
                           (java-str "The replacement text of the entity node '"
                                     (.getNodeName node)
                                     "' contains an element node '"
                                     (.getNodeName child)
                                     "' with an undeclared prefix '"
                                     prefix
                                     "'.")))
            (when (== (.getNodeType child) Node/ELEMENT_NODE)
              (let [attrs (.getAttributes child)]
                (loop [^int i 0]
                  (when (< i (.getLength attrs))
                    (let [^:mutable attrPrefix (.getPrefix (.item attrs i))]
                      (set! attrPrefix
                            (if (or (nil? attrPrefix) (== (.length attrPrefix) 0))
                                XMLSymbols/EMPTY_STRING
                                (.addSymbol fSymbolTable attrPrefix)))
                      (if (and (nil? (.getURI fNSBinder attrPrefix)) (some? attrPrefix))
                          (do
                            (.fatalError this
                                         (java-str
                                           "The replacement text of the entity node '"
                                           (.getNodeName node)
                                           "' contains an element node '"
                                           (.getNodeName child)
                                           "' with an attribute '"
                                           (.getNodeName (.item attrs i))
                                           "' an undeclared prefix '"
                                           attrPrefix
                                           "'."))
                            (recur (unchecked-inc-int i)))
                          (recur (unchecked-inc-int i))))))))
            (when (.hasChildNodes child) (.checkUnboundNamespacePrefixedNode this child)))
          (set! child next)))))

  (method ^:public reset ^boolean [this]
    (.reset super)
    (when (some? fNSBinder)
      (.reset fNSBinder)
      (.declarePrefix fNSBinder XMLSymbols/EMPTY_STRING XMLSymbols/EMPTY_STRING))
    true))

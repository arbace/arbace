                          ^:mutable ^int numDots 0]
                      (loop [^int i 0]
                        (when (< i addrLength)
                          (set! testChar (.charAt address i))
                          (cond
                            (== testChar \.)
                              (do
                                (when (or (not (URI/isDigit
                                                 (.charAt address (unchecked-subtract-int i 1))))
                                          (and (< (unchecked-add-int i 1) addrLength)
                                               (not
                                                 (URI/isDigit
                                                   (.charAt address (unchecked-add-int i 1))))))
                                  (return false))
                                (set! numDots (unchecked-inc-int numDots))
                                (recur (unchecked-inc-int i)))
                            (not (URI/isDigit testChar)) (return false)
                            :else (recur (unchecked-inc-int i)))))
                      (when-not (== numDots 3) (return false)))
                    (let [^:mutable ^char testChar (unchecked-char 0)]
                      (loop [^int i 0]
                        (when (< i addrLength)
                          (set! testChar (.charAt address i))
                          (cond
                            (== testChar \.)
                              (do
                                (when-not (URI/isAlphanum
                                            (.charAt address (unchecked-subtract-int i 1)))
                                  (return false))
                                (if (and (< (unchecked-add-int i 1) addrLength)
                                         (not (URI/isAlphanum
                                                (.charAt address (unchecked-add-int i 1)))))
                                    (return false)
                                    (recur (unchecked-inc-int i))))
                            (and (not (URI/isAlphanum testChar)) (not (== testChar \-)))
                              (return false)
                            :else (recur (unchecked-inc-int i)))))))
                true)))))

  (method ^:private ^:static isDigit ^boolean [^char p_char]
    (and (>= p_char \0) (<= p_char \9)))

  (method ^:private ^:static isHex ^boolean [^char p_char]
    (or (or (URI/isDigit p_char) (and (>= p_char \a) (<= p_char \f)))
        (and (>= p_char \A) (<= p_char \F))))

  (method ^:private ^:static isAlpha ^boolean [^char p_char]
    (or (and (>= p_char \a) (<= p_char \z)) (and (>= p_char \A) (<= p_char \Z))))

  (method ^:private ^:static isAlphanum ^boolean [^char p_char]
    (or (URI/isAlpha p_char) (URI/isDigit p_char)))

  (method ^:private ^:static isReservedCharacter ^boolean [^char p_char]
    (not (== (.indexOf RESERVED_CHARACTERS p_char) -1)))

  (method ^:private ^:static isUnreservedCharacter ^boolean [^char p_char]
    (or (URI/isAlphanum p_char) (not (== (.indexOf MARK_CHARACTERS p_char) -1))))

  (method ^:private ^:static isURIString ^boolean [^String p_uric]
    (if (nil? p_uric)
        false
        (let [end (.length p_uric)
              ^:mutable testChar \u0000]
          (let [^:mutable ^int i 0]
            (while (< i end)
              (set! testChar (.charAt p_uric i))
              (when (== testChar \%)
                (if (or (or (>= (unchecked-add-int i 2) end)
                            (not (URI/isHex (.charAt p_uric (unchecked-add-int i 1)))))
                        (not (URI/isHex (.charAt p_uric (unchecked-add-int i 2)))))
                    (return false)
                    (do (set! i (unchecked-add-int i 2)) (set! i (unchecked-inc-int i)) (continue))))
              (when-not (or (URI/isReservedCharacter testChar) (URI/isUnreservedCharacter testChar))
                (return false))
              (set! i (unchecked-inc-int i))))
          true))))

  (method ^:public endDocument :throws [SAXException] ^void [this]
    (.endDocument super)
    (.addElement (.-m_exptype this) SAX2DTM2/NULL)
    (.addElement (.-m_parent this) SAX2DTM2/NULL)
    (.addElement (.-m_nextsib this) SAX2DTM2/NULL)
    (.addElement (.-m_firstch this) SAX2DTM2/NULL)
    (set! m_extendedTypes (.getExtendedTypes (.-m_expandedNameTable this)))
    (set! m_exptype_map (.getMap (.-m_exptype this)))
    (set! m_nextsib_map (.getMap (.-m_nextsib this)))
    (set! m_firstch_map (.getMap (.-m_firstch this)))
    (set! m_parent_map (.getMap (.-m_parent this))))

  (method ^:protected ^:final addNode ^int [this ^int type ^int expandedTypeID ^int parentIndex
                                            ^int previousSibling ^int dataOrPrefix
                                            ^boolean canHaveFirstChild]
    (let [nodeIndex (let [old-9 (.-m_size this)]
                      (set! (.-m_size this) (unchecked-inc-int (.-m_size this)))
                      old-9)]
      (when (== nodeIndex m_maxNodeIndex)
        (.addNewDTMID this nodeIndex)
        (set! m_maxNodeIndex
              (unchecked-add-int m_maxNodeIndex
                                 (bit-shift-left-int 1 DTMManager/IDENT_DTM_NODE_BITS))))
      (.addElement (.-m_firstch this) DTM/NULL)
      (.addElement (.-m_nextsib this) DTM/NULL)
      (.addElement (.-m_parent this) parentIndex)
      (.addElement (.-m_exptype this) expandedTypeID)
      (.addElement (.-m_dataOrQName this) dataOrPrefix)
      (when (some? (.-m_prevsib this)) (.addElement (.-m_prevsib this) previousSibling))
      (when (and (some? (.-m_locator this)) (.-m_useSourceLocationProperty this))
        (.setSourceLocation this))
      (switch type
        DTM/NAMESPACE_NODE (.declareNamespaceInContext this parentIndex nodeIndex)
        DTM/ATTRIBUTE_NODE nil
        (if (not (== DTM/NULL previousSibling))
            (.setElementAt (.-m_nextsib this) nodeIndex previousSibling)
            (when-not (== DTM/NULL parentIndex)
              (.setElementAt (.-m_firstch this) nodeIndex parentIndex))))
      nodeIndex))

  (method ^:protected ^:final charactersFlush ^void [this]
    (when (>= (.-m_textPendingStart this) 0)
      (let [length (unchecked-subtract-int (.size (.-m_chars this)) (.-m_textPendingStart this))
            ^:mutable doStrip false]
        (when (.getShouldStripWhitespace this)
          (set! doStrip (.isWhitespace (.-m_chars this) (.-m_textPendingStart this) length)))
        (cond
          doStrip (.setLength (.-m_chars this) (.-m_textPendingStart this))
          (> length 0)
            (if (and (<= length TEXT_LENGTH_MAX) (<= (.-m_textPendingStart this) TEXT_OFFSET_MAX))
                (set! (.-m_previous this)
                      (.addNode this
                                (.-m_coalescedTextType this)
                                DTM/TEXT_NODE
                                (.peek (.-m_parents this))
                                (.-m_previous this)
                                (unchecked-add-int
                                  length
                                  (bit-shift-left-int (.-m_textPendingStart this) TEXT_LENGTH_BITS))
                                false))
                (let [dataIndex (.size (.-m_data this))]
                  (set! (.-m_previous this)
                        (.addNode this
                                  (.-m_coalescedTextType this)
                                  DTM/TEXT_NODE
                                  (.peek (.-m_parents this))
                                  (.-m_previous this)
                                  (unchecked-negate-int dataIndex)
                                  false))
                  (.addElement (.-m_data this) (.-m_textPendingStart this))
                  (.addElement (.-m_data this) length))))
        (set! (.-m_textPendingStart this) -1)
        (set! (.-m_textType this) (set! (.-m_coalescedTextType this) DTM/TEXT_NODE)))))

  (method ^:public processingInstruction :throws [SAXException] ^void [this ^String target
                                                                       ^String data]
    (.charactersFlush this)
    (let [dataIndex (.size (.-m_data this))]
      (set! (.-m_previous this)
            (.addNode this
                      DTM/PROCESSING_INSTRUCTION_NODE
                      DTM/PROCESSING_INSTRUCTION_NODE
                      (.peek (.-m_parents this))
                      (.-m_previous this)
                      (unchecked-negate-int dataIndex)
                      false))
      (.addElement (.-m_data this) (.stringToIndex (.-m_valuesOrPrefixes this) target))
      (.add m_values data)
      (.addElement (.-m_data this)
                   (let [old-10 m_valueIndex]
                     (set! m_valueIndex (unchecked-inc-int m_valueIndex))
                     old-10))))

  (method ^:public ^:final getFirstAttribute ^int [this ^int nodeHandle]
    (let [^:mutable nodeID (.makeNodeIdentity this nodeHandle)]
      (if (== nodeID DTM/NULL)
          DTM/NULL
          (let [^:mutable type (._type2 this nodeID)]
            (when (== DTM/ELEMENT_NODE type)
              (while true
                (set! nodeID (unchecked-inc-int nodeID))
                (set! type (._type2 this nodeID))
                (if (== type DTM/ATTRIBUTE_NODE)
                    (return (.makeNodeHandle this nodeID))
                    (when-not (== DTM/NAMESPACE_NODE type) (break)))))
            DTM/NULL))))

  (method ^:protected getFirstAttributeIdentity ^int [this ^:mutable ^int identity]
    (if (== identity SAX2DTM2/NULL)
        SAX2DTM2/NULL
        (let [^:mutable type (._type2 this identity)]
          (when (== DTM/ELEMENT_NODE type)
            (while true
              (set! identity (unchecked-inc-int identity))
              (set! type (._type2 this identity))
              (if (== type DTM/ATTRIBUTE_NODE)
                  (return identity)
                  (when-not (== DTM/NAMESPACE_NODE type) (break)))))
          DTM/NULL)))

  (method ^:protected getNextAttributeIdentity ^int [this ^:mutable ^int identity]
    (while true
      (set! identity (unchecked-inc-int identity))
      (let [type (._type2 this identity)]
        (if (== type DTM/ATTRIBUTE_NODE)
            (return identity)
            (when-not (== type DTM/NAMESPACE_NODE) (break)))))
    DTM/NULL)

  (method ^:protected ^:final getTypedAttribute ^int [this ^int nodeHandle ^int attType]
    (let [^:mutable nodeID (.makeNodeIdentity this nodeHandle)]
      (if (== nodeID DTM/NULL)
          DTM/NULL
          (let [^:mutable type (._type2 this nodeID)]
            (when (== DTM/ELEMENT_NODE type)
              (let [^:mutable ^int expType 0]
                (while true
                  (set! nodeID (unchecked-inc-int nodeID))
                  (set! expType (._exptype2 this nodeID))
                  (if (not (== expType DTM/NULL))
                      (set! type (.getNodeType (aget m_extendedTypes expType)))
                      (return DTM/NULL))
                  (if (== type DTM/ATTRIBUTE_NODE)
                      (when (== expType attType) (return (.makeNodeHandle this nodeID)))
                      (when-not (== DTM/NAMESPACE_NODE type) (break))))))
            DTM/NULL))))

  (method ^:public getLocalName ^String [this ^int nodeHandle]
    (let [expType (._exptype this (.makeNodeIdentity this nodeHandle))]
      (if (== expType DTM/PROCESSING_INSTRUCTION_NODE)
          (let [^:mutable dataIndex (._dataOrQName this (.makeNodeIdentity this nodeHandle))]
            (set! dataIndex (.elementAt (.-m_data this) (unchecked-negate-int dataIndex)))
            (.indexToString (.-m_valuesOrPrefixes this) dataIndex))
          (.getLocalName (.-m_expandedNameTable this) expType))))

  (method ^:public ^:final getNodeNameX ^String [this ^int nodeHandle]
    (let [nodeID (.makeNodeIdentity this nodeHandle)
          eType (._exptype2 this nodeID)]
      (if (== eType DTM/PROCESSING_INSTRUCTION_NODE)
          (let [^:mutable dataIndex (._dataOrQName this nodeID)]
            (set! dataIndex (.elementAt (.-m_data this) (unchecked-negate-int dataIndex)))
            (.indexToString (.-m_valuesOrPrefixes this) dataIndex))
          (let [^:final extType (aget m_extendedTypes eType)]
            (if (== (.length (.getNamespace extType)) 0)
                (.getLocalName extType)
                (let [^:mutable qnameIndex (.elementAt (.-m_dataOrQName this) nodeID)]
                  (if (== qnameIndex 0)
                      (.getLocalName extType)
                      (do
                        (when (< qnameIndex 0)
                          (set! qnameIndex (unchecked-negate-int qnameIndex))
                          (set! qnameIndex (.elementAt (.-m_data this) qnameIndex)))
                        (.indexToString (.-m_valuesOrPrefixes this) qnameIndex)))))))))

  (method ^:public getNodeName ^String [this ^int nodeHandle]
    (let [nodeID (.makeNodeIdentity this nodeHandle)
          eType (._exptype2 this nodeID)
          ^:final extType (aget m_extendedTypes eType)]
      (if (== (.length (.getNamespace extType)) 0)
          (let [type (.getNodeType extType)
                localName (.getLocalName extType)]
            (cond
              (== type DTM/NAMESPACE_NODE)
                (if (== (.length localName) 0) "xmlns" (java-str "xmlns:" localName))
              (== type DTM/PROCESSING_INSTRUCTION_NODE)
                (let [^:mutable dataIndex (._dataOrQName this nodeID)]
                  (set! dataIndex (.elementAt (.-m_data this) (unchecked-negate-int dataIndex)))
                  (.indexToString (.-m_valuesOrPrefixes this) dataIndex))
              (== (.length localName) 0) (.getFixedNames this type)
              :else localName))
          (let [^:mutable qnameIndex (.elementAt (.-m_dataOrQName this) nodeID)]
            (if (== qnameIndex 0)
                (.getLocalName extType)
                (do
                  (when (< qnameIndex 0)
                    (set! qnameIndex (unchecked-negate-int qnameIndex))
                    (set! qnameIndex (.elementAt (.-m_data this) qnameIndex)))
                  (.indexToString (.-m_valuesOrPrefixes this) qnameIndex)))))))

  (method ^:public getStringValue ^XMLString [this ^int nodeHandle]
    (let [^:mutable identity (.makeNodeIdentity this nodeHandle)]
      (if (== identity DTM/NULL)
          EMPTY_XML_STR
          (let [^:mutable type (._type2 this identity)]
            (cond
              (or (== type DTM/ELEMENT_NODE) (== type DTM/DOCUMENT_NODE))
                (let [startNode identity]
                  (set! identity (._firstch2 this identity))
                  (if (not (== DTM/NULL identity))
                      (let [^:mutable ^int offset -1
                            ^:mutable ^int length 0]
                        (loop []
                          (set! type (._exptype2 this identity))
                          (when (or (== type DTM/TEXT_NODE) (== type DTM/CDATA_SECTION_NODE))
                            (let [dataIndex (.elementAt (.-m_dataOrQName this) identity)]
                              (if (>= dataIndex 0)
                                  (do
                                    (when (== -1 offset)
                                      (set! offset
                                            (unsigned-bit-shift-right-int
                                              dataIndex
                                              TEXT_LENGTH_BITS)))
                                    (set! length
                                          (unchecked-add-int
                                            length
                                            (bit-and-int dataIndex TEXT_LENGTH_MAX))))
                                  (do
                                    (when (== -1 offset)
                                      (set! offset
                                            (.elementAt
                                              (.-m_data this)
                                              (unchecked-negate-int dataIndex))))
                                    (set!
                                      length
                                      (unchecked-add-int
                                        length
                                        (.elementAt
                                          (.-m_data this)
                                          (unchecked-add-int (unchecked-negate-int dataIndex) 1))))))))
                          (set! identity (unchecked-inc-int identity))
                          (when (>= (._parent2 this identity) startNode) (recur)))
                        (if (> length 0)
                            (if (some? (.-m_xstrf this))
                                (.newstr (.-m_xstrf this) (.-m_chars this) offset length)
                                (XMLStringDefault. (.getString (.-m_chars this) offset length)))
                            EMPTY_XML_STR))
                      EMPTY_XML_STR))
              (or (== DTM/TEXT_NODE type) (== DTM/CDATA_SECTION_NODE type))
                (let [dataIndex (.elementAt (.-m_dataOrQName this) identity)]
                  (cond
                    (>= dataIndex 0)
                      (if (some? (.-m_xstrf this))
                          (.newstr (.-m_xstrf this)
                                   (.-m_chars this)
                                   (unsigned-bit-shift-right-int dataIndex TEXT_LENGTH_BITS)
                                   (bit-and-int dataIndex TEXT_LENGTH_MAX))
                          (XMLStringDefault.
                            (.getString (.-m_chars this)
                                        (unsigned-bit-shift-right-int dataIndex TEXT_LENGTH_BITS)
                                        (bit-and-int dataIndex TEXT_LENGTH_MAX))))
                    (some? (.-m_xstrf this))
                      (.newstr (.-m_xstrf this)
                               (.-m_chars this)
                               (.elementAt (.-m_data this) (unchecked-negate-int dataIndex))
                               (.elementAt (.-m_data this)
                                           (unchecked-add-int (unchecked-negate-int dataIndex) 1)))
                    :else
                      (XMLStringDefault.
                        (.getString (.-m_chars this)
                                    (.elementAt (.-m_data this) (unchecked-negate-int dataIndex))
                                    (.elementAt (.-m_data this)
                                                (unchecked-add-int
                                                  (unchecked-negate-int dataIndex)
                                                  1))))))
              :else
                (let [^:mutable dataIndex (.elementAt (.-m_dataOrQName this) identity)]
                  (when (< dataIndex 0)
                    (set! dataIndex (unchecked-negate-int dataIndex))
                    (set! dataIndex (.elementAt (.-m_data this) (unchecked-add-int dataIndex 1))))
                  (if (some? (.-m_xstrf this))
                      (.newstr (.-m_xstrf this) (cast String (.get m_values dataIndex)))
                      (XMLStringDefault. (cast String (.get m_values dataIndex))))))))))

  (method ^:public ^:final getStringValueX ^String [this ^:final ^int nodeHandle]

  (method ^:public getStringValue ^String [this]
    (let [child (._firstch2 this SAX2DTM2/ROOTNODE)]
      (cond
        (== child DTM/NULL) EMPTY_STR
        (and (== (._exptype2 this child) DTM/TEXT_NODE) (== (._nextsib2 this child) DTM/NULL))
          (let [dataIndex (.elementAt (.-m_dataOrQName this) child)]
            (if (>= dataIndex 0)
                (.getString (.-m_chars this)
                            (unsigned-bit-shift-right-int dataIndex TEXT_LENGTH_BITS)
                            (bit-and-int dataIndex TEXT_LENGTH_MAX))
                (.getString (.-m_chars this)
                            (.elementAt (.-m_data this) (unchecked-negate-int dataIndex))
                            (.elementAt (.-m_data this)
                                        (unchecked-add-int (unchecked-negate-int dataIndex) 1)))))
        :else (.getStringValueX this (.getDocument this)))))

  (method ^:public ^:final dispatchCharactersEvents :throws [SAXException] ^void [this
                                                                                  ^int nodeHandle
                                                                                  ^ContentHandler ch
                                                                                  ^boolean normalize]
    (let [^:mutable identity (.makeNodeIdentity this nodeHandle)]
      (when-not (== identity DTM/NULL)
        (let [^:mutable type (._type2 this identity)]
          (cond
            (or (== type DTM/ELEMENT_NODE) (== type DTM/DOCUMENT_NODE))
              (let [startNode identity]
                (set! identity (._firstch2 this identity))
                (when-not (== DTM/NULL identity)
                  (let [^:mutable ^int offset -1
                        ^:mutable ^int length 0]
                    (loop []
                      (set! type (._exptype2 this identity))
                      (when (or (== type DTM/TEXT_NODE) (== type DTM/CDATA_SECTION_NODE))
                        (let [dataIndex (.elementAt (.-m_dataOrQName this) identity)]
                          (if (>= dataIndex 0)
                              (do
                                (when (== -1 offset)
                                  (set! offset
                                        (unsigned-bit-shift-right-int dataIndex TEXT_LENGTH_BITS)))
                                (set! length
                                      (unchecked-add-int
                                        length
                                        (bit-and-int dataIndex TEXT_LENGTH_MAX))))
                              (do
                                (when (== -1 offset)
                                  (set! offset
                                        (.elementAt
                                          (.-m_data this)
                                          (unchecked-negate-int dataIndex))))
                                (set! length
                                      (unchecked-add-int
                                        length
                                        (.elementAt
                                          (.-m_data this)
                                          (unchecked-add-int (unchecked-negate-int dataIndex) 1))))))))
                      (set! identity (unchecked-inc-int identity))
                      (when (>= (._parent2 this identity) startNode) (recur)))
                    (when (> length 0)
                      (if normalize
                          (.sendNormalizedSAXcharacters (.-m_chars this) ch offset length)
                          (.sendSAXcharacters (.-m_chars this) ch offset length))))))
            (or (== DTM/TEXT_NODE type) (== DTM/CDATA_SECTION_NODE type))
              (let [dataIndex (.elementAt (.-m_dataOrQName this) identity)]
                (cond
                  (>= dataIndex 0)
                    (if normalize
                        (.sendNormalizedSAXcharacters
                          (.-m_chars this)
                          ch
                          (unsigned-bit-shift-right-int dataIndex TEXT_LENGTH_BITS)
                          (bit-and-int dataIndex TEXT_LENGTH_MAX))
                        (.sendSAXcharacters (.-m_chars this)
                                            ch
                                            (unsigned-bit-shift-right-int
                                              dataIndex
                                              TEXT_LENGTH_BITS)
                                            (bit-and-int dataIndex TEXT_LENGTH_MAX)))
                  normalize
                    (.sendNormalizedSAXcharacters
                      (.-m_chars this)
                      ch
                      (.elementAt (.-m_data this) (unchecked-negate-int dataIndex))
                      (.elementAt (.-m_data this)
                                  (unchecked-add-int (unchecked-negate-int dataIndex) 1)))
                  :else
                    (.sendSAXcharacters (.-m_chars this)
                                        ch
                                        (.elementAt
                                          (.-m_data this)
                                          (unchecked-negate-int dataIndex))
                                        (.elementAt
                                          (.-m_data this)
                                          (unchecked-add-int (unchecked-negate-int dataIndex) 1)))))
            :else
              (let [^:mutable dataIndex (.elementAt (.-m_dataOrQName this) identity)]
                (when (< dataIndex 0)
                  (set! dataIndex (unchecked-negate-int dataIndex))
                  (set! dataIndex (.elementAt (.-m_data this) (unchecked-add-int dataIndex 1))))
                (let [str (cast String (.get m_values dataIndex))]
                  (if normalize
                      (FastStringBuffer/sendNormalizedSAXcharacters
                        (.toCharArray str)
                        0
                        (.length str)
                        ch)
                      (.characters ch (.toCharArray str) 0 (.length str))))))))))

  (method ^:public getNodeValue ^String [this ^int nodeHandle]
    (let [identity (.makeNodeIdentity this nodeHandle)
          type (._type2 this identity)]
      (if (or (== type DTM/TEXT_NODE) (== type DTM/CDATA_SECTION_NODE))
          (let [dataIndex (._dataOrQName this identity)]
            (if (> dataIndex 0)
                (.getString (.-m_chars this)
                            (unsigned-bit-shift-right-int dataIndex TEXT_LENGTH_BITS)
                            (bit-and-int dataIndex TEXT_LENGTH_MAX))
                (.getString (.-m_chars this)
                            (.elementAt (.-m_data this) (unchecked-negate-int dataIndex))
                            (.elementAt (.-m_data this)
                                        (unchecked-add-int (unchecked-negate-int dataIndex) 1)))))
          (when-not (or (or (== DTM/ELEMENT_NODE type) (== DTM/DOCUMENT_FRAGMENT_NODE type))
                        (== DTM/DOCUMENT_NODE type))
            (let [^:mutable dataIndex (.elementAt (.-m_dataOrQName this) identity)]
              (when (< dataIndex 0)
                (set! dataIndex (unchecked-negate-int dataIndex))
                (set! dataIndex (.elementAt (.-m_data this) (unchecked-add-int dataIndex 1))))
              (cast String (.get m_values dataIndex)))))))

  (method ^:protected ^:final copyTextNode :throws [SAXException] ^void [this ^:final ^int nodeID
                                                                         ^SerializationHandler handler]
    (when-not (== nodeID DTM/NULL)
      (let [dataIndex (.elementAt (.-m_dataOrQName this) nodeID)]
        (if (>= dataIndex 0)
            (.sendSAXcharacters (.-m_chars this)
                                handler
                                (unsigned-bit-shift-right-int dataIndex TEXT_LENGTH_BITS)
                                (bit-and-int dataIndex TEXT_LENGTH_MAX))
            (.sendSAXcharacters (.-m_chars this)
                                handler
                                (.elementAt (.-m_data this) (unchecked-negate-int dataIndex))
                                (.elementAt (.-m_data this)
                                            (unchecked-add-int (unchecked-negate-int dataIndex) 1)))))))

  (method ^:protected ^:final copyElement :throws [SAXException] ^String [this ^int nodeID
                                                                          ^int exptype
                                                                          ^SerializationHandler handler]
    (let [^:final extType (aget m_extendedTypes exptype)
          uri (.getNamespace extType)
          name (.getLocalName extType)]
      (if (== (.length uri) 0)
          (do (.startElement handler name) name)
          (let [^:mutable qnameIndex (.elementAt (.-m_dataOrQName this) nodeID)]
            (if (== qnameIndex 0)
                (do
                  (.startElement handler name)
                  (.namespaceAfterStartElement handler EMPTY_STR uri)
                  name)
                (do
                  (when (< qnameIndex 0)
                    (set! qnameIndex (unchecked-negate-int qnameIndex))
                    (set! qnameIndex (.elementAt (.-m_data this) qnameIndex)))
                  (let [qName (.indexToString (.-m_valuesOrPrefixes this) qnameIndex)]
                    (.startElement handler qName)
                    (let [prefixIndex (.indexOf qName \:)
                          ^String prefix (when (> prefixIndex 0) (.substring qName 0 prefixIndex))]
                      (.namespaceAfterStartElement handler prefix uri)
                      qName))))))))

  (method ^:protected ^:final copyNS :throws [SAXException] ^void [this ^:final ^int nodeID
                                                                   ^SerializationHandler handler
                                                                   ^boolean inScope]
    (when-not (and
                (and (and (some? (.-m_namespaceDeclSetElements this))
                          (== (.size (.-m_namespaceDeclSetElements this)) 1))
                     (some? (.-m_namespaceDeclSets this)))
                (== (.size (cast SuballocatedIntVector (.get (.-m_namespaceDeclSets this) 0))) 1))
      (let [^:mutable ^SuballocatedIntVector nsContext nil
            ^:mutable ^int nextNSNode 0]
        (if inScope
            (do
              (set! nsContext (.findNamespaceContext this nodeID))
              (if (or (nil? nsContext) (< (.size nsContext) 1))
                  (return)
                  (set! nextNSNode (.makeNodeIdentity this (.elementAt nsContext 0)))))
            (set! nextNSNode (.getNextNamespaceNode2 this nodeID)))
        (let [^:mutable ^int nsIndex 1]
          (while (not (== nextNSNode DTM/NULL))
            (let [eType (._exptype2 this nextNSNode)
                  nodeName (.getLocalName (aget m_extendedTypes eType))
                  ^:mutable dataIndex (.elementAt (.-m_dataOrQName this) nextNSNode)]
              (when (< dataIndex 0)
                (set! dataIndex (unchecked-negate-int dataIndex))
                (set! dataIndex (.elementAt (.-m_data this) (unchecked-add-int dataIndex 1))))
              (let [nodeValue (cast String (.get m_values dataIndex))]
                (.namespaceAfterStartElement handler nodeName nodeValue)
                (if inScope
                    (if (< nsIndex (.size nsContext))
                        (do
                          (set! nextNSNode (.makeNodeIdentity this (.elementAt nsContext nsIndex)))
                          (set! nsIndex (unchecked-inc-int nsIndex)))
                        (return))
                    (set! nextNSNode (.getNextNamespaceNode2 this nextNSNode))))))))))

  (method ^:protected ^:final getNextNamespaceNode2 ^int [this ^:mutable ^int baseID]
    (let [^:mutable ^int type 0]
      (while (== (set! type (._type2 this (set! baseID (unchecked-inc-int baseID))))
                 DTM/ATTRIBUTE_NODE))
      (if (== type DTM/NAMESPACE_NODE) baseID SAX2DTM2/NULL)))

  (method ^:protected ^:final copyAttributes :throws [SAXException] ^void [this ^:final ^int nodeID
                                                                           ^SerializationHandler handler]
    (loop [^int current (.getFirstAttributeIdentity this nodeID)]
      (when-not (== current DTM/NULL)
        (let [eType (._exptype2 this current)]
          (.copyAttribute this current eType handler)
          (recur (.getNextAttributeIdentity this current))))))

  (method ^:protected ^:final copyAttribute :throws [SAXException] ^void [this ^int nodeID
                                                                          ^int exptype
                                                                          ^SerializationHandler handler]
    (let [^:final extType (aget m_extendedTypes exptype)
          ^:final uri (.getNamespace extType)
          ^:final localName (.getLocalName extType)
          ^:mutable ^String prefix nil
          ^:mutable ^String qname nil
          dataIndex (._dataOrQName this nodeID)
          ^:mutable valueIndex dataIndex]
      (when (<= dataIndex 0)
        (let [prefixIndex (.elementAt (.-m_data this) (unchecked-negate-int dataIndex))]
          (set! valueIndex
                (.elementAt (.-m_data this) (unchecked-add-int (unchecked-negate-int dataIndex) 1)))
          (set! qname (.indexToString (.-m_valuesOrPrefixes this) prefixIndex))
          (let [colonIndex (.indexOf qname \:)]
            (when (> colonIndex 0) (set! prefix (.substring qname 0 colonIndex))))))
      (when-not (== (.length uri) 0) (.namespaceAfterStartElement handler prefix uri))
      (let [^String nodeName (if (some? prefix) qname localName)
            nodeValue (cast String (.get m_values valueIndex))]
        (.addAttribute handler uri localName nodeName "CDATA" nodeValue)))))

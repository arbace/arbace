  (method ^:public getNode ^Node [this ^int nodeHandle]
    (let [identity (.makeNodeIdentity this nodeHandle)] (cast Node (.get m_nodes identity))))

  (method ^:protected lookupNode ^Node [this ^int nodeIdentity]
    (cast Node (.get m_nodes nodeIdentity)))

  (method ^:protected getNextNodeIdentity ^int [this ^:mutable ^int identity]
    (set! identity (unchecked-add-int identity 1))
    (when (>= identity (.size m_nodes)) (when-not (.nextNode this) (set! identity DTM/NULL)))
    identity)

  (method ^:private getHandleFromNode ^int [this ^Node node]

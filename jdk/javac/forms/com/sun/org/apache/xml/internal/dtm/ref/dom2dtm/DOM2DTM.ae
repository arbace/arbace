            (when (identical? (.get m_nodes i) node) (return (.makeNodeHandle this i)))
            (set! i (unchecked-inc-int i)))
          (set! isMore (.nextNode this))
          (set! len (.size m_nodes))
          (when (or isMore (< i len)) (recur)))))
    DTM/NULL)

  (method ^:public getHandleOfNode ^int [this ^Node node]
    (when (some? node)
      (when (or (or (identical? m_root node)
                    (and (== (.getNodeType m_root) DOM2DTM/DOCUMENT_NODE)
                         (identical? m_root (.getOwnerDocument node))))
                (and (not (== (.getNodeType m_root) DOM2DTM/DOCUMENT_NODE))
                     (identical? (.getOwnerDocument m_root) (.getOwnerDocument node))))
        (loop [cursor node]
          (if (some? cursor)
              (if (identical? cursor m_root)
                  (return (.getHandleFromNode this node))
                  (recur (if (not (== (.getNodeType cursor) DOM2DTM/ATTRIBUTE_NODE))
                             (.getParentNode cursor)
                             ^Node (.getOwnerElement (cast Attr cursor)))))
              nil))))
    DTM/NULL)

  (method ^:public getAttributeNode ^int [this ^int nodeHandle ^:mutable ^String namespaceURI
                                          ^String name]
    (when (nil? namespaceURI) (set! namespaceURI ""))
    (let [^:mutable ^int type (.getNodeType this nodeHandle)]
      (when (== DTM/ELEMENT_NODE type)
        (let [^:mutable identity (.makeNodeIdentity this nodeHandle)]
          (while (not (== DTM/NULL (set! identity (.getNextNodeIdentity this identity))))
            (set! type (._type this identity))
            (if (or (== type DTM/ATTRIBUTE_NODE) (== type DTM/NAMESPACE_NODE))
                (let [node (.lookupNode this identity)
                      ^:mutable nodeuri (.getNamespaceURI node)]
                  (when (nil? nodeuri) (set! nodeuri ""))
                  (let [nodelocalname (.getLocalName node)]
                    (when (and (.equals nodeuri namespaceURI) (.equals name nodelocalname))
                      (return (.makeNodeHandle this identity)))))
                (break)))))
      DTM/NULL))

  (method ^:public getStringValue ^XMLString [this ^int nodeHandle]
    (let [^int type (.getNodeType this nodeHandle)
          ^:mutable node (.getNode this nodeHandle)]
      (cond
        (or (or (== DTM/ELEMENT_NODE type) (== DTM/DOCUMENT_NODE type))
            (== DTM/DOCUMENT_FRAGMENT_NODE type))
          (let [buf (StringBufferPool/get)
                ^:mutable ^String s nil]
            (try
              (DOM2DTM/getNodeData node buf)
              (set! s (if (> (.length buf) 0) (.toString buf) ""))
              (finally (StringBufferPool/free buf)))
            (.newstr (.-m_xstrf this) s))
        (or (== DOM2DTM/TEXT_NODE type) (== DOM2DTM/CDATA_SECTION_NODE type))
          (let [buf (StringBufferPool/get)]
            (while (some? node)
              (.append buf (.getNodeValue node))
              (set! node (.logicalNextDOMTextNode this node)))
            (let [^String s (if (> (.length buf) 0) (.toString buf) "")]
              (StringBufferPool/free buf)
              (.newstr (.-m_xstrf this) s)))
        :else (.newstr (.-m_xstrf this) (.getNodeValue node)))))

  (method ^:public isWhitespace ^boolean [this ^int nodeHandle]
    (let [^int type (.getNodeType this nodeHandle)
          ^:mutable node (.getNode this nodeHandle)]
      (if (or (== DOM2DTM/TEXT_NODE type) (== DOM2DTM/CDATA_SECTION_NODE type))
          (let [buf (StringBufferPool/get)]
            (while (some? node)
              (.append buf (.getNodeValue node))
              (set! node (.logicalNextDOMTextNode this node)))
            (let [b (.isWhitespace buf 0 (.length buf))] (StringBufferPool/free buf) b))
          false)))

  (method ^:protected ^:static getNodeData ^void [^Node node ^FastStringBuffer buf]
    (switch (.getNodeType node)
      (Node/DOCUMENT_FRAGMENT_NODE Node/DOCUMENT_NODE Node/ELEMENT_NODE)
        (loop [child (.getFirstChild node)]
          (when (some? child) (DOM2DTM/getNodeData child buf) (recur (.getNextSibling child))))
      (Node/TEXT_NODE Node/CDATA_SECTION_NODE Node/ATTRIBUTE_NODE)
        (.append buf (.getNodeValue node))
      Node/PROCESSING_INSTRUCTION_NODE nil
      nil))

  (method ^:public getNodeName ^String [this ^int nodeHandle]
    (let [node (.getNode this nodeHandle)] (.getNodeName node)))

  (method ^:public getNodeNameX ^String [this ^int nodeHandle]
    (let [^:mutable ^String name nil
          type (.getNodeType this nodeHandle)]
      (switch type
        DTM/NAMESPACE_NODE
          (let [node (.getNode this nodeHandle)]
            (set! name (.getNodeName node))
            (cond
              (.startsWith name "xmlns:") (set! name (QName/getLocalPart name))
              (.equals name "xmlns") (set! name "")))
        (DTM/ATTRIBUTE_NODE DTM/ELEMENT_NODE
                            DTM/ENTITY_REFERENCE_NODE
                            DTM/PROCESSING_INSTRUCTION_NODE)
          (let [node (.getNode this nodeHandle)] (set! name (.getNodeName node)))
        (set! name ""))
      name))

  (method ^:public getLocalName ^String [this ^int nodeHandle]
    (if JJK_NEWCODE
        (let [id (.makeNodeIdentity this nodeHandle)]
          (when-not (== DOM2DTM/NULL id)
            (let [newnode (cast Node (.get m_nodes id))
                  ^:mutable newname (.getLocalName newnode)]
              (when (nil? newname)
                (let [qname (.getNodeName newnode)]
                  (if (== \# (.charAt qname 0))
                      (set! newname "")
                      (let [index (.indexOf qname \:)]
                        (set! newname
                              (if (< index 0) qname (.substring qname (unchecked-add-int index 1))))))))
              newname)))
        (let [^:mutable ^String name nil
              type (.getNodeType this nodeHandle)]
          (switch type
            (DTM/ATTRIBUTE_NODE DTM/ELEMENT_NODE
                                DTM/ENTITY_REFERENCE_NODE
                                DTM/NAMESPACE_NODE
                                DTM/PROCESSING_INSTRUCTION_NODE)
              (let [node (.getNode this nodeHandle)]
                (set! name (.getLocalName node))
                (when (nil? name)
                  (let [qname (.getNodeName node)
                        index (.indexOf qname \:)]
                    (set! name
                          (if (< index 0) qname (.substring qname (unchecked-add-int index 1)))))))
            (set! name ""))
          name)))

  (method ^:public getPrefix ^String [this ^int nodeHandle]
    (let [^:mutable ^String prefix nil
          type (.getNodeType this nodeHandle)]
      (switch type
        DTM/NAMESPACE_NODE
          (let [node (.getNode this nodeHandle)
                qname (.getNodeName node)
                index (.indexOf qname \:)]
            (set! prefix (if (< index 0) "" (.substring qname (unchecked-add-int index 1)))))
        (DTM/ATTRIBUTE_NODE DTM/ELEMENT_NODE)
          (let [node (.getNode this nodeHandle)
                qname (.getNodeName node)
                index (.indexOf qname \:)]
            (set! prefix (if (< index 0) "" (.substring qname 0 index))))
        (set! prefix ""))
      prefix))

  (method ^:public getNamespaceURI ^String [this ^int nodeHandle]
    (if JJK_NEWCODE
        (let [id (.makeNodeIdentity this nodeHandle)]
          (when-not (== id DOM2DTM/NULL)
            (let [node (cast Node (.get m_nodes id))] (.getNamespaceURI node))))
        (let [^:mutable ^String nsuri nil
              type (.getNodeType this nodeHandle)]
          (switch type
            (DTM/ATTRIBUTE_NODE DTM/ELEMENT_NODE
                                DTM/ENTITY_REFERENCE_NODE
                                DTM/NAMESPACE_NODE
                                DTM/PROCESSING_INSTRUCTION_NODE)
              (let [node (.getNode this nodeHandle)] (set! nsuri (.getNamespaceURI node)))
            (set! nsuri nil))
          nsuri)))

  (method ^:private logicalNextDOMTextNode ^Node [this ^:mutable ^Node n]
    (let [^:mutable p (.getNextSibling n)]
      (when (nil? p)
        (set! n (.getParentNode n))
        (while (and (some? n) (== DOM2DTM/ENTITY_REFERENCE_NODE (.getNodeType n)))
          (set! p (.getNextSibling n))
          (when (some? p) (break))
          (set! n (.getParentNode n))))
      (set! n p)
      (while (and (some? n) (== DOM2DTM/ENTITY_REFERENCE_NODE (.getNodeType n)))
        (if (.hasChildNodes n) (set! n (.getFirstChild n)) (set! n (.getNextSibling n))))
      (when (some? n)
        (let [^int ntype (.getNodeType n)]
          (when (and (not (== DOM2DTM/TEXT_NODE ntype)) (not (== DOM2DTM/CDATA_SECTION_NODE ntype)))
            (set! n nil))))
      n))

  (method ^:public getNodeValue ^String [this ^int nodeHandle]
    (let [^:mutable type (._exptype this (.makeNodeIdentity this nodeHandle))]
      (set! type
            (if (not (== DOM2DTM/NULL type))
                (.getNodeType this nodeHandle)
                (unchecked-short DOM2DTM/NULL)))
      (if (and (not (== DOM2DTM/TEXT_NODE type)) (not (== DOM2DTM/CDATA_SECTION_NODE type)))
          (.getNodeValue (.getNode this nodeHandle))
          (let [node (.getNode this nodeHandle)
                ^:mutable n (.logicalNextDOMTextNode this node)]
            (if (nil? n)
                (.getNodeValue node)
                (let [buf (StringBufferPool/get)]
                  (.append buf (.getNodeValue node))
                  (while (some? n)
                    (.append buf (.getNodeValue n))
                    (set! n (.logicalNextDOMTextNode this n)))
                  (let [^String s (if (> (.length buf) 0) (.toString buf) "")]
                    (StringBufferPool/free buf)
                    s)))))))

  (method ^:public getDocumentTypeDeclarationSystemIdentifier ^String [this]
    (let [^Document doc (if (== (.getNodeType m_root) Node/DOCUMENT_NODE)
                            (cast Document m_root)
                            (.getOwnerDocument m_root))]
      (when (some? doc)
        (let [dtd (.getDoctype doc)] (when (some? dtd) (return (.getSystemId dtd)))))
      nil))

  (method ^:public getDocumentTypeDeclarationPublicIdentifier ^String [this]
    (let [^Document doc (if (== (.getNodeType m_root) Node/DOCUMENT_NODE)
                            (cast Document m_root)
                            (.getOwnerDocument m_root))]
      (when (some? doc)
        (let [dtd (.getDoctype doc)] (when (some? dtd) (return (.getPublicId dtd)))))
      nil))

  (method ^:public getElementById ^int [this ^String elementId]
    (let [^Document doc (if (== (.getNodeType m_root) Node/DOCUMENT_NODE)
                            (cast Document m_root)
                            (.getOwnerDocument m_root))]
      (when (some? doc)
        (let [^Node elem (.getElementById doc elementId)]
          (when (some? elem)
            (let [^:mutable elemHandle (.getHandleFromNode this elem)]
              (when (== DTM/NULL elemHandle)
                (let [^:mutable identity (unchecked-subtract-int (.size m_nodes) 1)]
                  (while (not (== DTM/NULL (set! identity (.getNextNodeIdentity this identity))))
                    (let [node (.getNode this identity)]
                      (when (identical? node elem)
                        (set! elemHandle (.getHandleFromNode this elem))
                        (break))))))
              (return elemHandle)))))
      DTM/NULL))

  (method ^:public getUnparsedEntityURI ^String [this ^String name]
    (let [^:mutable url ""
          ^Document doc (if (== (.getNodeType m_root) Node/DOCUMENT_NODE)
                            (cast Document m_root)
                            (.getOwnerDocument m_root))]
      (when (some? doc)
        (let [doctype (.getDoctype doc)]
          (when (some? doctype)
            (let [entities (.getEntities doctype)]
              (when (nil? entities) (return url))
              (let [entity (cast Entity (.getNamedItem entities name))]
                (when (nil? entity) (return url))
                (let [notationName (.getNotationName entity)]
                  (when (some? notationName)
                    (set! url (.getSystemId entity))
                    (when (nil? url) (set! url (.getPublicId entity))))))))))
      url))

  (method ^:public isAttributeSpecified ^boolean [this ^int attributeHandle]
    (let [^int type (.getNodeType this attributeHandle)]
      (if (== DTM/ATTRIBUTE_NODE type)
          (let [attr (cast Attr (.getNode this attributeHandle))] (.getSpecified attr))
          false)))


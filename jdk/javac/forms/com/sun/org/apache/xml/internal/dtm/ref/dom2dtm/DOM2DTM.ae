  (method ^:public getDeclHandler ^DeclHandler [this] nil)

  (method ^:public needsTwoThreads ^boolean [this] false)

  (method ^:private ^:static isSpace ^boolean [^char ch]
    (XMLCharacterRecognizer/isWhiteSpace ch))

  (method ^:public dispatchCharactersEvents :throws [SAXException] ^void [this ^int nodeHandle
                                                                          ^ContentHandler ch
                                                                          ^boolean normalize]
    (if normalize
        (let [^:mutable str (.getStringValue this nodeHandle)]
          (set! str (.fixWhiteSpace str true true false))
          (.dispatchCharactersEvents str ch))
        (let [^int type (.getNodeType this nodeHandle)
              ^:mutable node (.getNode this nodeHandle)]
          (DOM2DTM/dispatchNodeData node ch 0)
          (when (or (== DOM2DTM/TEXT_NODE type) (== DOM2DTM/CDATA_SECTION_NODE type))
            (while (some? (set! node (.logicalNextDOMTextNode this node)))
              (DOM2DTM/dispatchNodeData node ch 0))))))

  (method ^:protected ^:static dispatchNodeData :throws [SAXException] ^void [^Node node
                                                                              ^ContentHandler ch
                                                                              ^int depth]
    (switch (.getNodeType node)
      (Node/DOCUMENT_FRAGMENT_NODE Node/DOCUMENT_NODE Node/ELEMENT_NODE)
        (loop [child (.getFirstChild node)]
          (when (some? child)
            (DOM2DTM/dispatchNodeData child ch (unchecked-add-int depth 1))
            (recur (.getNextSibling child))))
      (Node/PROCESSING_INSTRUCTION_NODE Node/COMMENT_NODE)
        (when-not (not (== 0 depth))
          (let [str (.getNodeValue node)]
            (if (instance? CharacterNodeHandler ch)
                (.characters (cast CharacterNodeHandler ch) node)
                (.characters ch (.toCharArray str) 0 (.length str)))))
      (Node/TEXT_NODE Node/CDATA_SECTION_NODE Node/ATTRIBUTE_NODE)
        (let [str (.getNodeValue node)]
          (if (instance? CharacterNodeHandler ch)
              (.characters (cast CharacterNodeHandler ch) node)
              (.characters ch (.toCharArray str) 0 (.length str))))
      nil))

  (field ^TreeWalker m_walker (TreeWalker. nil))

  (method ^:public dispatchToEvents :throws [SAXException] ^void [this ^int nodeHandle
                                                                  ^ContentHandler ch]
    (let [^:mutable treeWalker m_walker
          prevCH (.getContentHandler treeWalker)]
      (when (some? prevCH) (set! treeWalker (TreeWalker. nil)))
      (.setContentHandler treeWalker ch)
      (try
        (let [node (.getNode this nodeHandle)] (.traverseFragment treeWalker node))
        (finally (.setContentHandler treeWalker nil)))))

  (defclass ^:public ^:interface CharacterNodeHandler
    (method ^:public characters :throws [SAXException] ^void [this ^Node node]))

  (method ^:public setProperty ^void [this ^String property value])

  (method ^:public getSourceLocatorFor ^SourceLocator [this ^int node]
    nil))

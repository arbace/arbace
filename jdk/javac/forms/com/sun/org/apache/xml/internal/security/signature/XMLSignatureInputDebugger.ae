              \& (do (.write (.-writer this) "&amp;amp;") (recur (unchecked-inc-int i)))
              \< (do (.write (.-writer this) "&amp;lt;") (recur (unchecked-inc-int i)))
              \" (do (.write (.-writer this) "&amp;quot;") (recur (unchecked-inc-int i)))
              0x09 (do (.write (.-writer this) "&amp;#x9;") (recur (unchecked-inc-int i)))
              0x0A (do (.write (.-writer this) "&amp;#xA;") (recur (unchecked-inc-int i)))
              0x0D (do (.write (.-writer this) "&amp;#xD;") (recur (unchecked-inc-int i)))
              (do (.write (.-writer this) c) (recur (unchecked-inc-int i)))))))
      (.write (.-writer this) "\"")))


                                (return NODE_BEFORE_DOCUMENT_ELEMENT)
                                (recur (.getNextSibling x)))
                            nil))
                      NODE_AFTER_DOCUMENT_ELEMENT)))))))

  (method ^:private outputAttrToWriter :throws [IOException] ^void [this ^String name ^String value]
    (.write (.-writer this) " ")
    (.write (.-writer this) name)
    (.write (.-writer this) "=\"")

(defclass ^:public Init
  (field ^:public ^:static ^:final ^String CONF_NS "http://www.xmlsecurity.org/NS/#configuration")

  (field ^:private ^:static ^:final ^Logger LOG (LoggerFactory/getLogger Init))

  (field ^:private ^:static ^boolean alreadyInitialized false)

  (method ^:public ^:static ^:final ^:synchronized isInitialized ^boolean []
    Init/alreadyInitialized)

  (method ^:public ^:static ^:synchronized init ^void []
    (when-not alreadyInitialized
      (let [^{:tag (PrivilegedAction InputStream)} action (lambda PrivilegedAction ^InputStream []
                                                            (let [cfile (System/getProperty

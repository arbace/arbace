              (.printText _printer ">")
              (.breakLine _printer))
            (when (and (some? dtd) (> (.length dtd) 0))
              (.printText _printer "<!DOCTYPE ")
              (.printText _printer name)
              (.printText _printer " [")
              (.printText this dtd true true)
              (.printText _printer "]>")
              (.breakLine _printer))))))

  (method ^:protected content :throws [IOException] ^ElementState [this]
    (let [^:mutable ^ElementState state nil]
      (set! state (.getElementState this))
      (when-not (.isDocumentState this)
        (when (and (.-inCData state) (not (.-doCData state)))
          (.printText _printer "]]>")
          (set! (.-inCData state) false))
        (when (.-empty state) (.printText _printer \>) (set! (.-empty state) false))
        (set! (.-afterElement state) false)
        (set! (.-afterComment state) false))
      state))

  (method ^:protected characters :throws [IOException] ^void [this ^String text]
    (let [^:mutable ^ElementState state nil]
      (set! state (.content this))
      (if (or (.-inCData state) (.-doCData state))
          (do
            (when-not (.-inCData state)
              (.printText _printer "<![CDATA[")
              (set! (.-inCData state) true))
            (let [saveIndent (.getNextIndent _printer)]
              (.setNextIndent _printer 0)
              (.printCDATAText this text)
              (.setNextIndent _printer saveIndent)))
          (let [^:mutable ^int saveIndent 0]
            (if (.-preserveSpace state)
                (do
                  (set! saveIndent (.getNextIndent _printer))
                  (.setNextIndent _printer 0)
                  (.printText this text true (.-unescaped state))
                  (.setNextIndent _printer saveIndent))
                (.printText this text false (.-unescaped state)))))))

  (method ^:protected ^:abstract getEntityRef ^String [this ^int ch])

  (method ^:protected ^:abstract serializeElement :throws [IOException] ^void [this ^Element elem])

  (method ^:protected serializePreRoot :throws [IOException] ^void [this]
    (let [^:mutable ^int i 0]
      (when (some? _preRoot)
        (set! i 0)
        (while (< i (.size _preRoot))
          (.printText this (cast String (.get _preRoot i)) true true)
          (when _indenting (.breakLine _printer))
          (set! i (unchecked-inc-int i)))
        (.clear _preRoot))))

  (method ^:protected printCDATAText :throws [IOException] ^void [this ^String text]
    (let [length (.length text)
          ^:mutable ^char ch (unchecked-char 0)
          ^:mutable ^int index 0]
      (while (< index length)
        (set! ch (.charAt text index))
        (cond
          (and (and (and (== ch \]) (< (unchecked-add-int index 2) length))
                    (== (.charAt text (unchecked-add-int index 1)) \]))
               (== (.charAt text (unchecked-add-int index 2)) \>))
            (do
              (when (some? fDOMErrorHandler)
                (if (== (bit-and-int features DOMSerializerImpl/SPLITCDATA) 0)
                    (let [msg (DOMMessageFormatter/formatMessage
                                DOMMessageFormatter/SERIALIZER_DOMAIN
                                "EndingCDATA"
                                nil)]
                      (when-not (== (bit-and-int features DOMSerializerImpl/WELLFORMED) 0)
                        (.modifyDOMError this
                                         msg
                                         DOMError/SEVERITY_FATAL_ERROR
                                         "wf-invalid-character"
                                         fCurrentNode)
                        (.handleError fDOMErrorHandler fDOMError)
                        (throw (LSException. LSException/SERIALIZE_ERR msg)))
                      (.modifyDOMError this
                                       msg
                                       DOMError/SEVERITY_ERROR
                                       "cdata-section-not-splitted"
                                       fCurrentNode)
                      (when-not (.handleError fDOMErrorHandler fDOMError)
                        (throw (LSException. LSException/SERIALIZE_ERR msg))))
                    (let [msg (DOMMessageFormatter/formatMessage
                                DOMMessageFormatter/SERIALIZER_DOMAIN
                                "SplittingCDATA"
                                nil)]
                      (.modifyDOMError this msg DOMError/SEVERITY_WARNING nil fCurrentNode)
                      (.handleError fDOMErrorHandler fDOMError))))
              (.printText _printer "]]]]><![CDATA[>")
              (set! index (unchecked-add-int index 2)))
          (not (XMLChar/isValid ch))
            (if (< (set! index (unchecked-inc-int index)) length)
                (.surrogates this ch (.charAt text index) true)
                (.fatalError this (java-str "The character '" ch "' is an invalid XML character")))
          (or (or (or (and (and (>= ch \space) (.isPrintable _encodingInfo ch)) (not (== ch 0x7F)))
                      (== ch \newline))
                  (== ch \return))
              (== ch \tab))
            (.printText _printer ch)
          :else
            (do
              (.printText _printer "]]>&#x")
              (.printText _printer (Integer/toHexString ch))
              (.printText _printer ";<![CDATA[")))
        (set! index (unchecked-inc-int index)))))

  (method ^:protected surrogates :throws [IOException] ^void [this ^int high ^int low
                                                              ^boolean inContent]
    (if (XMLChar/isHighSurrogate high)
        (if (not (XMLChar/isLowSurrogate low))
            (.fatalError this
                         (java-str "The character '"
                                   (unchecked-char low)
                                   "' is an invalid XML character"))
            (let [supplemental (XMLChar/supplemental (unchecked-char high) (unchecked-char low))]
              (cond
                (not (XMLChar/isValid supplemental))
                  (.fatalError this
                               (java-str "The character '"
                                         (unchecked-char supplemental)
                                         "' is an invalid XML character"))
                (and inContent (.-inCData (.content this)))
                  (do
                    (.printText _printer "]]>&#x")
                    (.printText _printer (Integer/toHexString supplemental))
                    (.printText _printer ";<![CDATA["))
                :else (.printHex this supplemental))))
        (.fatalError this
                     (java-str "The character '"
                               (unchecked-char high)
                               "' is an invalid XML character"))))

  (method ^:protected printText :throws [IOException] ^void [this ^char/1 chars ^:mutable ^int start
                                                             ^:mutable ^int length
                                                             ^boolean preserveSpace
                                                             ^boolean unescaped]
    (if preserveSpace
        (while (> (let [old-2 length] (set! length (unchecked-dec-int length)) old-2) 0)
          (let [ch (aget chars start)]
            (set! start (unchecked-inc-int start))
            (if (or (or (== ch \newline) (== ch \return)) unescaped)
                (.printText _printer ch)
                (.printEscaped this ch))))
        (while (> (let [old-3 length] (set! length (unchecked-dec-int length)) old-3) 0)
          (let [ch (aget chars start)]
            (set! start (unchecked-inc-int start))
            (cond
              (or (or (or (or (== ch \space) (== ch \formfeed)) (== ch \tab)) (== ch \newline))
                  (== ch \return))
                (.printSpace _printer)
              unescaped (.printText _printer ch)
              :else (.printEscaped this ch))))))

  (method ^:protected printText :throws [IOException] ^void [this ^String text
                                                             ^boolean preserveSpace
                                                             ^boolean unescaped]
    (let [^:mutable ^int index 0
          ^:mutable ^char ch (unchecked-char 0)]
      (if preserveSpace
          (do
            (set! index 0)
            (while (< index (.length text))
              (set! ch (.charAt text index))
              (if (or (or (== ch \newline) (== ch \return)) unescaped)
                  (.printText _printer ch)
                  (.printEscaped this ch))
              (set! index (unchecked-inc-int index))))
          (do
            (set! index 0)
            (while (< index (.length text))
              (set! ch (.charAt text index))
              (cond
                (or (or (or (or (== ch \space) (== ch \formfeed)) (== ch \tab)) (== ch \newline))
                    (== ch \return))
                  (.printSpace _printer)
                unescaped (.printText _printer ch)
                :else (.printEscaped this ch))
              (set! index (unchecked-inc-int index)))))))

  (method ^:protected printDoctypeURL :throws [IOException] ^void [this ^String url]
    (let [^:mutable ^int i 0]
      (.printText _printer \")
      (set! i 0)
      (while (< i (.length url))
        (if (or (or (== (.charAt url i) \") (< (.charAt url i) 0x20)) (> (.charAt url i) 0x7F))
            (do
              (.printText _printer \%)
              (.printText _printer (Integer/toHexString (.charAt url i))))
            (.printText _printer (.charAt url i)))
        (set! i (unchecked-inc-int i)))
      (.printText _printer \")))

  (method ^:protected printEscaped :throws [IOException] ^void [this ^int ch]
    (let [^:mutable ^String charRef nil]
      (set! charRef (.getEntityRef this ch))
      (cond
        (some? charRef)
          (do (.printText _printer \&) (.printText _printer charRef) (.printText _printer \;))
        (or (or (or (and (and (>= ch \space) (.isPrintable _encodingInfo (unchecked-char ch)))
                         (not (== ch 0x7F)))
                    (== ch \newline))
                (== ch \return))
            (== ch \tab))
          (if (< ch 0x10000)
              (.printText _printer (unchecked-char ch))
              (do
                (.printText _printer
                            (unchecked-char
                              (unchecked-add-int
                                (bit-shift-right-int (unchecked-subtract-int ch 0x10000) 10)
                                0xd800)))
                (.printText _printer
                            (unchecked-char
                              (unchecked-add-int
                                (bit-and-int (unchecked-subtract-int ch 0x10000) 0x3ff)
                                0xdc00)))))
        :else (.printHex this ch))))

  (method ^:final printHex :throws [IOException] ^void [this ^int ch]
    (.printText _printer "&#x")
    (.printText _printer (Integer/toHexString ch))
    (.printText _printer \;))

  (method ^:protected printEscaped :throws [IOException] ^void [this ^String source]
    (let [^:mutable ^int i 0]
      (while (< i (.length source))
        (let [^:mutable ^int ch (.charAt source i)]
          (when (and (== (bit-and-int ch 0xfc00) 0xd800)
                     (< (unchecked-add-int i 1) (.length source)))
            (let [^int lowch (.charAt source (unchecked-add-int i 1))]
              (when (== (bit-and-int lowch 0xfc00) 0xdc00)
                (set! ch
                      (unchecked-subtract-int
                        (unchecked-add-int
                          (unchecked-add-int 0x10000
                                             (bit-shift-left-int
                                               (unchecked-subtract-int ch 0xd800)
                                               10))
                          lowch)
                        0xdc00))
                (set! i (unchecked-inc-int i)))))
          (.printEscaped this ch))
        (set! i (unchecked-inc-int i)))))

  (method ^:protected getElementState ^ElementState [this]
    (aget _elementStates _elementStateCount))

  (method ^:protected enterElementState ^ElementState [this ^String namespaceURI ^String localName
                                                       ^String rawName ^boolean preserveSpace]
    (let [^:mutable ^ElementState state nil]
      (when (== (unchecked-add-int _elementStateCount 1) (alength _elementStates))
        (let [^:mutable ^ElementState/1 newStates nil]
          (set! newStates (new ElementState/1 (unchecked-add-int (alength _elementStates) 10)))
          (loop [^int i 0]
            (when (< i (alength _elementStates))
              (aset newStates i (aget _elementStates i))
              (recur (unchecked-inc-int i))))
          (loop [^int i (alength _elementStates)]
            (when (< i (alength newStates))
              (aset newStates i (ElementState.))
              (recur (unchecked-inc-int i))))
          (set! _elementStates newStates)))
      (set! _elementStateCount (unchecked-inc-int _elementStateCount))
      (set! state (aget _elementStates _elementStateCount))
      (set! (.-namespaceURI state) namespaceURI)
      (set! (.-localName state) localName)
      (set! (.-rawName state) rawName)
      (set! (.-preserveSpace state) preserveSpace)
      (set! (.-empty state) true)
      (set! (.-afterElement state) false)
      (set! (.-afterComment state) false)
      (set! (.-doCData state) (set! (.-inCData state) false))
      (set! (.-unescaped state) false)
      (set! (.-prefixes state) _prefixes)
      (set! _prefixes nil)
      state))

  (method ^:protected leaveElementState ^ElementState [this]
    (if (> _elementStateCount 0)
        (do
          (set! _prefixes nil)
          (set! _elementStateCount (unchecked-dec-int _elementStateCount))
          (aget _elementStates _elementStateCount))
        (let [msg (DOMMessageFormatter/formatMessage
                    DOMMessageFormatter/SERIALIZER_DOMAIN
                    "Internal"
                    nil)]
          (throw (IllegalStateException. msg)))))

  (method ^:protected isDocumentState ^boolean [this]
    (== _elementStateCount 0))

  (method ^:final clearDocumentState ^void [this]
    (set! _elementStateCount 0))

  (method ^:protected getPrefix ^String [this ^String namespaceURI]
    (let [^:mutable ^String prefix nil]
      (when (some? _prefixes)
        (set! prefix (cast String (.get _prefixes namespaceURI)))
        (when (some? prefix) (return prefix)))
      (when-not (== _elementStateCount 0)
        (loop [^int i _elementStateCount]
          (if (> i 0)
              (if (some? (.-prefixes (aget _elementStates i)))
                  (do
                    (set! prefix
                          (cast String (.get (.-prefixes (aget _elementStates i)) namespaceURI)))
                    (if (some? prefix) (return prefix) (recur (unchecked-dec-int i))))
                  (recur (unchecked-dec-int i)))
              nil))
        nil)))

  (method ^:protected modifyDOMError ^DOMError [this ^String message ^short severity ^String type
                                                ^Node node]
    (.reset fDOMError)
    (set! (.-fMessage fDOMError) message)
    (set! (.-fType fDOMError) type)
    (set! (.-fSeverity fDOMError) severity)
    (set! (.-fLocator fDOMError) (DOMLocatorImpl. -1 -1 -1 node nil))
    fDOMError)

  (method ^:protected fatalError :throws [IOException] ^void [this ^String message]
    (if (some? fDOMErrorHandler)
        (do
          (.modifyDOMError this message DOMError/SEVERITY_FATAL_ERROR nil fCurrentNode)
          (.handleError fDOMErrorHandler fDOMError))
        (throw (IOException. message))))

  (method ^:protected checkUnboundNamespacePrefixedNode :throws [IOException] ^void [this ^Node node]))

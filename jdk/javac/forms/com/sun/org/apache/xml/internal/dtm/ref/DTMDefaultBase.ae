  (method ^:public dumpDTM ^void [this ^:mutable ^OutputStream os]
    (try
      (when (nil? os)
        (let [f (File. (java-str "DTMDump" (.hashCode ^Object this) ".txt"))]
          (.println System/err (java-str "Dumping... " (.getAbsolutePath f)))
          (set! os (FileOutputStream. f))))
      (let [ps (PrintStream. os)]
        (while (.nextNode this))
        (let [nRecords m_size]
          (.println ps (java-str "Total nodes: " nRecords))
          (loop [^int index 0]
            (when (< index nRecords)
              (let [i (.makeNodeHandle this index)]
                (.println ps (java-str "=========== index=" index " handle=" i " ==========="))
                (.println ps (java-str "NodeName: " (.getNodeName this i)))
                (.println ps (java-str "NodeNameX: " (.getNodeNameX this i)))
                (.println ps (java-str "LocalName: " (.getLocalName this i)))
                (.println ps (java-str "NamespaceURI: " (.getNamespaceURI this i)))
                (.println ps (java-str "Prefix: " (.getPrefix this i)))
                (let [exTypeID (._exptype this index)]
                  (.println ps (java-str "Expanded Type ID: " (Integer/toHexString exTypeID)))
                  (let [^int type (._type this index)
                        ^:mutable ^String typestring nil]
                    (switch type
                      DTM/ATTRIBUTE_NODE (set! typestring "ATTRIBUTE_NODE")
                      DTM/CDATA_SECTION_NODE (set! typestring "CDATA_SECTION_NODE")
                      DTM/COMMENT_NODE (set! typestring "COMMENT_NODE")
                      DTM/DOCUMENT_FRAGMENT_NODE (set! typestring "DOCUMENT_FRAGMENT_NODE")
                      DTM/DOCUMENT_NODE (set! typestring "DOCUMENT_NODE")
                      DTM/DOCUMENT_TYPE_NODE (set! typestring "DOCUMENT_NODE")
                      DTM/ELEMENT_NODE (set! typestring "ELEMENT_NODE")
                      DTM/ENTITY_NODE (set! typestring "ENTITY_NODE")
                      DTM/ENTITY_REFERENCE_NODE (set! typestring "ENTITY_REFERENCE_NODE")
                      DTM/NAMESPACE_NODE (set! typestring "NAMESPACE_NODE")
                      DTM/NOTATION_NODE (set! typestring "NOTATION_NODE")
                      DTM/NULL (set! typestring "NULL")
                      DTM/PROCESSING_INSTRUCTION_NODE
                        (set! typestring "PROCESSING_INSTRUCTION_NODE")
                      DTM/TEXT_NODE (set! typestring "TEXT_NODE")
                      (set! typestring "Unknown!"))
                    (.println ps (java-str "Type: " typestring))
                    (let [firstChild (._firstch this index)]
                      (cond
                        (== DTM/NULL firstChild) (.println ps "First child: DTM.NULL")
                        (== NOTPROCESSED firstChild) (.println ps "First child: NOTPROCESSED")
                        :else (.println ps (java-str "First child: " firstChild)))
                      (when (some? m_prevsib)
                        (let [prevSibling (._prevsib this index)]
                          (cond
                            (== DTM/NULL prevSibling) (.println ps "Prev sibling: DTM.NULL")
                            (== NOTPROCESSED prevSibling) (.println ps "Prev sibling: NOTPROCESSED")
                            :else (.println ps (java-str "Prev sibling: " prevSibling)))))
                      (let [nextSibling (._nextsib this index)]
                        (cond
                          (== DTM/NULL nextSibling) (.println ps "Next sibling: DTM.NULL")
                          (== NOTPROCESSED nextSibling) (.println ps "Next sibling: NOTPROCESSED")
                          :else (.println ps (java-str "Next sibling: " nextSibling)))
                        (let [parent (._parent this index)]
                          (cond
                            (== DTM/NULL parent) (.println ps "Parent: DTM.NULL")
                            (== NOTPROCESSED parent) (.println ps "Parent: NOTPROCESSED")
                            :else (.println ps (java-str "Parent: " parent)))
                          (let [level (._level this index)]
                            (.println ps (java-str "Level: " level))
                            (.println ps (java-str "Node Value: " (.getNodeValue this i)))
                            (.println ps (java-str "String Value: " (.getStringValue this i)))
                            (recur (unchecked-inc-int index)))))))))))))
      (catch IOException ioe
        (.printStackTrace ioe System/err)
        (throw (RuntimeException. (.getMessage ioe))))))

  (method ^:public dumpNode ^String [this ^int nodeHandle]
    (if (== nodeHandle DTM/NULL)
        "[null]"
        (let [^:mutable ^String typestring nil]
          (switch (.getNodeType this nodeHandle)
            DTM/ATTRIBUTE_NODE (set! typestring "ATTR")
            DTM/CDATA_SECTION_NODE (set! typestring "CDATA")
            DTM/COMMENT_NODE (set! typestring "COMMENT")
            DTM/DOCUMENT_FRAGMENT_NODE (set! typestring "DOC_FRAG")
            DTM/DOCUMENT_NODE (set! typestring "DOC")
            DTM/DOCUMENT_TYPE_NODE (set! typestring "DOC_TYPE")
            DTM/ELEMENT_NODE (set! typestring "ELEMENT")
            DTM/ENTITY_NODE (set! typestring "ENTITY")
            DTM/ENTITY_REFERENCE_NODE (set! typestring "ENT_REF")
            DTM/NAMESPACE_NODE (set! typestring "NAMESPACE")
            DTM/NOTATION_NODE (set! typestring "NOTATION")
            DTM/NULL (set! typestring "null")
            DTM/PROCESSING_INSTRUCTION_NODE (set! typestring "PI")
            DTM/TEXT_NODE (set! typestring "TEXT")
            (set! typestring "Unknown!"))
          (java-str "["
                    nodeHandle
                    ": "
                    typestring
                    "(0x"
                    (Integer/toHexString (.getExpandedTypeID this nodeHandle))
                    ") "
                    (.getNodeNameX this nodeHandle)
                    " {"
                    (.getNamespaceURI this nodeHandle)
                    "}=\""
                    (.getNodeValue this nodeHandle)
                    "\"]"))))


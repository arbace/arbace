  (method ^:public migrateTo ^void [this ^DTMManager mgr]
    (set! m_mgr mgr)
    (when (instance? DTMManagerDefault mgr) (set! m_mgrDefault (cast DTMManagerDefault mgr))))

  (method ^:public getManager ^DTMManager [this] m_mgr)

  (method ^:public getDTMIDs ^SuballocatedIntVector [this]

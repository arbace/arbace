            (let [rootHandle (.getDocumentRoot this (.makeNodeHandle this elementNodeIndex))
                  rootID (.makeNodeIdentity this rootHandle)
                  ^:mutable ^int uppermostNSCandidateID 0]
              (if (== (.getNodeType this rootHandle) DTM/DOCUMENT_NODE)
                  (let [ch (._firstch this rootID)]
                    (set! uppermostNSCandidateID (if (not (== ch DTM/NULL)) ch rootID)))
                  (set! uppermostNSCandidateID rootID))
              (when (== candidate uppermostNSCandidateID)
                (return (cast SuballocatedIntVector (.get m_namespaceDeclSets wouldBeAt))))))
          (while (and (>= wouldBeAt 0) (> ancestor 0))
            (cond
              (== candidate ancestor)
                (return (cast SuballocatedIntVector (.get m_namespaceDeclSets wouldBeAt)))
              (< candidate ancestor)
                (loop []
                  (set! ancestor (._parent this ancestor))
                  (when (< candidate ancestor) (recur)))
              (> wouldBeAt 0)
                (set! candidate
                      (.elementAt m_namespaceDeclSetElements
                                  (set! wouldBeAt (unchecked-dec-int wouldBeAt))))
              :else (break))))))
    nil)

  (method ^:protected findInSortedSuballocatedIntVector ^int [this ^SuballocatedIntVector vector
                                                              ^int lookfor]
    (let [^:mutable ^int i 0]
      (when (some? vector)
        (let [^:mutable ^int first 0
              ^:mutable last (unchecked-subtract-int (.size vector) 1)]
          (while (<= first last)
            (set! i (unchecked-divide-int (unchecked-add-int first last) 2))
            (let [test (unchecked-subtract-int lookfor (.elementAt vector i))]
              (cond
                (== test 0) (return i)
                (< test 0) (set! last (unchecked-subtract-int i 1))
                :else (set! first (unchecked-add-int i 1)))))
          (when (> first i) (set! i first))))
      (unchecked-subtract-int -1 i)))

  (method ^:public getFirstNamespaceNode ^int [this ^int nodeHandle ^boolean inScope]
    (if inScope
        (let [identity (.makeNodeIdentity this nodeHandle)]
          (if (== (._type this identity) DTM/ELEMENT_NODE)
              (let [nsContext (.findNamespaceContext this identity)]
                (if (or (nil? nsContext) (< (.size nsContext) 1))
                    DTMDefaultBase/NULL
                    (.elementAt nsContext 0)))
              DTMDefaultBase/NULL))
        (let [^:mutable identity (.makeNodeIdentity this nodeHandle)]
          (if (== (._type this identity) DTM/ELEMENT_NODE)
              (do
                (while (not (== DTM/NULL (set! identity (.getNextNodeIdentity this identity))))
                  (let [^int type (._type this identity)]
                    (if (== type DTM/NAMESPACE_NODE)
                        (return (.makeNodeHandle this identity))
                        (when-not (== DTM/ATTRIBUTE_NODE type) (break)))))
                DTMDefaultBase/NULL)
              DTMDefaultBase/NULL))))

  (method ^:public getNextNamespaceNode ^int [this ^int baseHandle ^int nodeHandle ^boolean inScope]
    (if inScope
        (let [nsContext (.findNamespaceContext this (.makeNodeIdentity this baseHandle))]
          (if (nil? nsContext)
              DTMDefaultBase/NULL
              (let [i (unchecked-add-int 1 (.indexOf nsContext nodeHandle))]
                (if (or (<= i 0) (== i (.size nsContext)))
                    DTMDefaultBase/NULL
                    (.elementAt nsContext i)))))
        (do
          (let [^:mutable identity (.makeNodeIdentity this nodeHandle)]
            (while (not (== DTM/NULL (set! identity (.getNextNodeIdentity this identity))))
              (let [^int type (._type this identity)]
                (if (== type DTM/NAMESPACE_NODE)
                    (return (.makeNodeHandle this identity))
                    (when-not (== type DTM/ATTRIBUTE_NODE) (break))))))
          DTM/NULL)))

  (method ^:public getParent ^int [this ^int nodeHandle]
    (let [identity (.makeNodeIdentity this nodeHandle)]
      (if (> identity 0) (.makeNodeHandle this (._parent this identity)) DTM/NULL)))

  (method ^:public getDocument ^int [this] (.elementAt m_dtmIdent 0))

  (method ^:public getOwnerDocument ^int [this ^int nodeHandle]
    (if (== DTM/DOCUMENT_NODE (.getNodeType this nodeHandle))
        DTM/NULL
        (.getDocumentRoot this nodeHandle)))

  (method ^:public getDocumentRoot ^int [this ^int nodeHandle]
    (.getDocument (.getDTM (.getManager this) nodeHandle)))

  (method ^:public ^:abstract getStringValue ^XMLString [this ^int nodeHandle])

  (method ^:public getStringValueChunkCount ^int [this ^int nodeHandle]
    (.error this (XMLMessages/createXMLMessage XMLErrorResources/ER_METHOD_NOT_SUPPORTED nil))
    0)

  (method ^:public getStringValueChunk ^char/1 [this ^int nodeHandle ^int chunkIndex
                                                ^int/1 startAndLen]
    (.error this (XMLMessages/createXMLMessage XMLErrorResources/ER_METHOD_NOT_SUPPORTED nil))
    nil)

  (method ^:public getExpandedTypeID ^int [this ^int nodeHandle]
    (let [id (.makeNodeIdentity this nodeHandle)]
      (if (== id DTMDefaultBase/NULL) DTMDefaultBase/NULL (._exptype this id))))

  (method ^:public getExpandedTypeID ^int [this ^String namespace ^String localName ^int type]
    (let [ent m_expandedNameTable] (.getExpandedTypeID ent namespace localName type)))

  (method ^:public getLocalNameFromExpandedNameID ^String [this ^int expandedNameID]
    (.getLocalName m_expandedNameTable expandedNameID))

  (method ^:public getNamespaceFromExpandedNameID ^String [this ^int expandedNameID]
    (.getNamespace m_expandedNameTable expandedNameID))

  (method ^:public getNamespaceType ^int [this ^:final ^int nodeHandle]
    (let [identity (.makeNodeIdentity this nodeHandle)
          expandedNameID (._exptype this identity)]
      (.getNamespaceID m_expandedNameTable expandedNameID)))

  (method ^:public ^:abstract getNodeName ^String [this ^int nodeHandle])

  (method ^:public getNodeNameX ^String [this ^int nodeHandle]
    (.error this (XMLMessages/createXMLMessage XMLErrorResources/ER_METHOD_NOT_SUPPORTED nil))
    nil)

  (method ^:public ^:abstract getLocalName ^String [this ^int nodeHandle])

  (method ^:public ^:abstract getPrefix ^String [this ^int nodeHandle])

  (method ^:public ^:abstract getNamespaceURI ^String [this ^int nodeHandle])

  (method ^:public ^:abstract getNodeValue ^String [this ^int nodeHandle])

  (method ^:public getNodeType ^short [this ^int nodeHandle]
    (if (== nodeHandle DTM/NULL)
        (unchecked-short DTM/NULL)
        (.getType m_expandedNameTable (._exptype this (.makeNodeIdentity this nodeHandle)))))

  (method ^:public getLevel ^short [this ^int nodeHandle]
    (let [identity (.makeNodeIdentity this nodeHandle)]
      (unchecked-short (unchecked-add-int (._level this identity) 1))))

  (method ^:public getNodeIdent ^int [this ^int nodeHandle]
    (.makeNodeIdentity this nodeHandle))

  (method ^:public getNodeHandle ^int [this ^int nodeId]
    (.makeNodeHandle this nodeId))

  (method ^:public isSupported ^boolean [this ^String feature ^String version]
    false)

  (method ^:public getDocumentBaseURI ^String [this] m_documentBaseURI)

  (method ^:public setDocumentBaseURI ^void [this ^String baseURI]

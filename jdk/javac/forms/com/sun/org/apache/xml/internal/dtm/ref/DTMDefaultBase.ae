  (method ^:protected getShouldStripWhitespace ^boolean [this]
    m_shouldStripWS)

  (method ^:protected pushShouldStripWhitespace ^void [this ^boolean shouldStrip]
    (set! m_shouldStripWS shouldStrip)
    (when (some? m_shouldStripWhitespaceStack) (.push m_shouldStripWhitespaceStack shouldStrip)))

  (method ^:protected popShouldStripWhitespace ^void [this]
    (when (some? m_shouldStripWhitespaceStack)
      (set! m_shouldStripWS (.popAndTop m_shouldStripWhitespaceStack))))

  (method ^:protected setShouldStripWhitespace ^void [this ^boolean shouldStrip]
    (set! m_shouldStripWS shouldStrip)
    (when (some? m_shouldStripWhitespaceStack) (.setTop m_shouldStripWhitespaceStack shouldStrip)))


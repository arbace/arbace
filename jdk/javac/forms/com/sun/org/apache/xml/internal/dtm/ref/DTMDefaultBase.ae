    true)

  (method ^:public ^:abstract getDocumentTypeDeclarationSystemIdentifier ^String [this])

  (method ^:public ^:abstract getDocumentTypeDeclarationPublicIdentifier ^String [this])

  (method ^:public ^:abstract getElementById ^int [this ^String elementId])

  (method ^:public ^:abstract getUnparsedEntityURI ^String [this ^String name])

  (method ^:public supportsPreStripping ^boolean [this] true)

  (method ^:public isNodeAfter ^boolean [this ^int nodeHandle1 ^int nodeHandle2]
    (let [index1 (.makeNodeIdentity this nodeHandle1)
          index2 (.makeNodeIdentity this nodeHandle2)]
      (and (and (not (== index1 DTMDefaultBase/NULL)) (not (== index2 DTMDefaultBase/NULL)))
           (<= index1 index2))))


            (set! e (RetrievalMethodResolver/getDocFromBytes inputBytes secureValidation))
            (.debug LOG "we have to parse {} bytes" (new Object/1 [(alength inputBytes)]))))
      e))

  (method ^:private ^:static getRawCertificate :throws [CanonicalizationException
                                                        IOException
                                                        CertificateException] ^X509Certificate [^XMLSignatureInput resource]

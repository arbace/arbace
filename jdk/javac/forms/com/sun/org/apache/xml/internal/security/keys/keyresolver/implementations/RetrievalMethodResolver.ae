          transforms (.getTransforms rm)
          resContext (ResourceResolverContext. uri baseURI secureValidation)
          ^:mutable resource (ResourceResolver/resolve resContext)]
      (when (some? transforms)
        (.debug LOG "We have Transforms")
        (set! resource (.performTransforms transforms resource)))
      resource))


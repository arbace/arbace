  (method ^:protected engineResolvePublicKey ^PublicKey [this ^Element element ^String baseURI
                                                         ^StorageResolver storage
                                                         ^boolean secureValidation]
    (try
      (let [rm (RetrievalMethod. element baseURI)
            type (.getType rm)
            resource (RetrievalMethodResolver/resolveInput rm baseURI secureValidation)]
        (when (.equals RetrievalMethod/TYPE_RAWX509 type)
          (let [cert (RetrievalMethodResolver/getRawCertificate resource)]
            (when (some? cert) (return (.getPublicKey cert)))
            (return nil)))
        (let [e (RetrievalMethodResolver/obtainReferenceElement resource secureValidation)]
          (when (XMLUtils/elementIsInSignatureSpace e Constants/_TAG_RETRIEVALMETHOD)
            (when secureValidation
              (when (.isDebugEnabled LOG)
                (let [error
                        "Error: It is forbidden to have one RetrievalMethod point to another with secure validation"]
                  (.debug LOG error)))
              (return nil))
            (let [rm2 (RetrievalMethod. e baseURI)
                  resource2 (RetrievalMethodResolver/resolveInput rm2 baseURI secureValidation)
                  e2 (RetrievalMethodResolver/obtainReferenceElement resource2 secureValidation)]
              (when (identical? e2 element)
                (.debug LOG "Error: Can't have RetrievalMethods pointing to each other")
                (return nil))))
          (return (RetrievalMethodResolver/resolveKey e baseURI storage secureValidation))))
      (catch XMLSecurityException ex (.debug LOG "XMLSecurityException" ex))
      (catch CertificateException ex (.debug LOG "CertificateException" ex))
      (catch IOException ex (.debug LOG "IOException" ex)))
    nil)

  (method ^:protected engineResolveX509Certificate ^X509Certificate [this ^Element element
                                                                     ^String baseURI
                                                                     ^StorageResolver storage
                                                                     ^boolean secureValidation]
    (try
      (let [rm (RetrievalMethod. element baseURI)
            type (.getType rm)
            resource (RetrievalMethodResolver/resolveInput rm baseURI secureValidation)]
        (when (.equals RetrievalMethod/TYPE_RAWX509 type)
          (return (RetrievalMethodResolver/getRawCertificate resource)))
        (let [e (RetrievalMethodResolver/obtainReferenceElement resource secureValidation)]
          (when (XMLUtils/elementIsInSignatureSpace e Constants/_TAG_RETRIEVALMETHOD)
            (when secureValidation
              (when (.isDebugEnabled LOG)
                (let [error
                        "Error: It is forbidden to have one RetrievalMethod point to another with secure validation"]
                  (.debug LOG error)))
              (return nil))
            (let [rm2 (RetrievalMethod. e baseURI)
                  resource2 (RetrievalMethodResolver/resolveInput rm2 baseURI secureValidation)
                  e2 (RetrievalMethodResolver/obtainReferenceElement resource2 secureValidation)]
              (when (identical? e2 element)
                (.debug LOG "Error: Can't have RetrievalMethods pointing to each other")
                (return nil))))
          (return (RetrievalMethodResolver/resolveCertificate e baseURI storage secureValidation))))
      (catch XMLSecurityException ex (.debug LOG "XMLSecurityException" ex))
      (catch CertificateException ex (.debug LOG "CertificateException" ex))

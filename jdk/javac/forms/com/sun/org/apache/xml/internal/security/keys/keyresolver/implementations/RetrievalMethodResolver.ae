  (method ^:private ^:static getDocumentElement ^Element [^{:tag (Set Node)} set]
    (let [^:mutable ^Element e nil]
      (for-each [^Node currentNode set]
        (when (and (some? currentNode) (== Node/ELEMENT_NODE (.getNodeType currentNode)))
          (set! e (cast Element currentNode))
          (break)))
      (let [^{:tag (List Node)} parents (ArrayList.)]
        (while (some? e)
          (.add parents e)
          (let [n (.getParentNode e)]
            (when (or (nil? n) (not (== Node/ELEMENT_NODE (.getNodeType n)))) (break))
            (set! e (cast Element n))))

          doStrip (.setLength m_chars m_textPendingStart)
          (> length 0)
            (let [exName (.getExpandedTypeID (.-m_expandedNameTable this) DTM/TEXT_NODE)
                  dataIndex (.size m_data)]
              (set! m_previous
                    (.addNode this
                              m_coalescedTextType
                              exName
                              (.peek m_parents)
                              m_previous
                              dataIndex
                              false))
              (.addElement m_data m_textPendingStart)
              (.addElement m_data length)))
        (set! m_textPendingStart -1)
        (set! m_textType (set! m_coalescedTextType DTM/TEXT_NODE)))))

  (method ^:public resolveEntity :throws [SAXException] ^InputSource [this ^String publicId
                                                                      ^String systemId]
    nil)

  (method ^:public notationDecl :throws [SAXException] ^void [this ^String name ^String publicId
                                                              ^String systemId])

  (method ^:public unparsedEntityDecl :throws [SAXException] ^void [this ^String name
                                                                    ^String publicId
                                                                    ^:mutable ^String systemId
                                                                    ^String notationName]
    (when (nil? m_entities) (set! m_entities (ArrayList.)))
    (try
      (set! systemId (SystemIDResolver/getAbsoluteURI systemId (.getDocumentBaseURI this)))
      (catch Exception e (throw (SAXException. e))))
    (.add m_entities publicId)
    (.add m_entities systemId)
    (.add m_entities notationName)
    (.add m_entities name))

  (method ^:public setDocumentLocator ^void [this ^Locator locator]
    (set! m_locator locator)
    (set! m_systemId (.getSystemId locator)))

  (method ^:public startDocument :throws [SAXException] ^void [this]
    (when DEBUG (.println System/out "startDocument"))
    (let [doc (.addNode this
                        DTM/DOCUMENT_NODE
                        (.getExpandedTypeID (.-m_expandedNameTable this) DTM/DOCUMENT_NODE)
                        DTM/NULL
                        DTM/NULL
                        0
                        true)]
      (.push m_parents doc)
      (set! m_previous DTM/NULL)
      (.push m_contextIndexes (.size m_prefixMappings))))

  (method ^:public endDocument :throws [SAXException] ^void [this]
    (when DEBUG (.println System/out "endDocument"))
    (.charactersFlush this)
    (.setElementAt (.-m_nextsib this) SAX2DTM/NULL 0)
    (when (== (.elementAt (.-m_firstch this) 0) SAX2DTM/NOTPROCESSED)
      (.setElementAt (.-m_firstch this) SAX2DTM/NULL 0))
    (when-not (== DTM/NULL m_previous) (.setElementAt (.-m_nextsib this) DTM/NULL m_previous))
    (set! m_parents nil)
    (set! m_prefixMappings nil)
    (set! m_contextIndexes nil)
    (set! m_endDocumentOccured true)
    (set! m_locator nil))

  (method ^:public startPrefixMapping :throws [SAXException] ^void [this ^:mutable ^String prefix
                                                                    ^String uri]
    (when DEBUG
      (.println System/out (java-str "startPrefixMapping: prefix: " prefix ", uri: " uri)))
    (when (nil? prefix) (set! prefix ""))
    (.add m_prefixMappings prefix)
    (.add m_prefixMappings uri))

  (method ^:public endPrefixMapping :throws [SAXException] ^void [this ^:mutable ^String prefix]
    (when DEBUG (.println System/out (java-str "endPrefixMapping: prefix: " prefix)))
    (when (nil? prefix) (set! prefix ""))
    (let [^:mutable index (unchecked-subtract-int (.peek m_contextIndexes) 1)]
      (loop []
        (set! index (.indexOf m_prefixMappings prefix (set! index (unchecked-inc-int index))))
        (when (and (>= index 0) (== (bit-and-int index 0x01) 0x01)) (recur)))
      (when (> index -1)
        (.setElementAt m_prefixMappings "%@$#^@#" index)
        (.setElementAt m_prefixMappings "%@$#^@#" (unchecked-add-int index 1)))))

  (method ^:protected declAlreadyDeclared ^boolean [this ^String prefix]
    (let [startDecls (.peek m_contextIndexes)
          ^{:tag (Vector String)} prefixMappings m_prefixMappings
          nDecls (.size prefixMappings)]
      (loop [^int i startDecls]
        (when (< i nDecls)
          (let [prefixDecl (cast String (.get prefixMappings i))]
            (cond
              (nil? prefixDecl) (recur (unchecked-add-int i 2))
              (.equals prefixDecl prefix) (return true)
              :else (recur (unchecked-add-int i 2))))))
      false))

  (field ^boolean m_pastFirstElement false)

  (method ^:public startElement :throws [SAXException] ^void [this ^String uri
                                                              ^:mutable ^String localName
                                                              ^String qName ^Attributes attributes]
    (when DEBUG
      (.println System/out
                (java-str "startElement: uri: "
                          uri
                          ", localname: "
                          localName
                          ", qname: "
                          qName
                          ", atts: "
                          attributes))
      (let [DEBUG_ATTRS true]
        (when (let [a-2 DEBUG_ATTRS b-3 (some? attributes)] (and a-2 b-3))
          (let [n (.getLength attributes)]
            (if (== n 0)
                (.println System/out "\tempty attribute list")
                (loop [^int i 0]
                  (when (< i n)
                    (.println System/out
                              (java-str "\t attr: uri: "
                                        (.getURI attributes i)
                                        ", localname: "
                                        (.getLocalName attributes i)
                                        ", qname: "
                                        (.getQName attributes i)
                                        ", type: "
                                        (.getType attributes i)
                                        ", value: "
                                        (.getValue attributes i)))
                    (recur (unchecked-inc-int i)))))))))
    (.charactersFlush this)
    (when (and (or (nil? localName) (.isEmpty localName)) (or (nil? uri) (.isEmpty uri)))
      (set! localName qName))
    (let [^:mutable exName (.getExpandedTypeID (.-m_expandedNameTable this)
                                               uri
                                               localName
                                               DTM/ELEMENT_NODE)
          ^:mutable prefix (.getPrefix this qName uri)
          ^:mutable ^int prefixIndex (if (some? prefix) (.stringToIndex m_valuesOrPrefixes qName) 0)
          elemNode (.addNode this
                             DTM/ELEMENT_NODE
                             exName
                             (.peek m_parents)
                             m_previous
                             prefixIndex
                             true)]
      (when (.-m_indexing this) (.indexNode this exName elemNode))
      (.push m_parents elemNode)
      (let [startDecls (.peek m_contextIndexes)
            nDecls (.size m_prefixMappings)
            ^:mutable prev DTM/NULL]
        (when-not m_pastFirstElement
          (set! prefix "xml")
          (let [declURL "http://www.w3.org/XML/1998/namespace"]
            (set! exName
                  (.getExpandedTypeID (.-m_expandedNameTable this) nil prefix DTM/NAMESPACE_NODE))
            (let [val (.stringToIndex m_valuesOrPrefixes declURL)]
              (set! prev (.addNode this DTM/NAMESPACE_NODE exName elemNode prev val false))
              (set! m_pastFirstElement true))))
        (loop [^int i startDecls]
          (when (< i nDecls)
            (set! prefix (cast String (.get m_prefixMappings i)))
            (if (nil? prefix)
                (recur (unchecked-add-int i 2))
                (let [declURL (cast String (.get m_prefixMappings (unchecked-add-int i 1)))]
                  (set! exName
                        (.getExpandedTypeID (.-m_expandedNameTable this)
                                            nil
                                            prefix
                                            DTM/NAMESPACE_NODE))
                  (let [val (.stringToIndex m_valuesOrPrefixes declURL)]
                    (set! prev (.addNode this DTM/NAMESPACE_NODE exName elemNode prev val false))
                    (recur (unchecked-add-int i 2)))))))
        (let [n (.getLength attributes)]
          (loop [^int i 0]
            (when (< i n)
              (let [attrUri (.getURI attributes i)
                    attrQName (.getQName attributes i)
                    ^:mutable valString (.getValue attributes i)]
                (set! prefix (.getPrefix this attrQName attrUri))
                (let [^:mutable ^int nodeType 0
                      attrLocalName (.getLocalName attributes i)]
                  (if (and (some? attrQName)
                           (or (.equals attrQName "xmlns") (.startsWith attrQName "xmlns:")))
                      (do
                        (when (.declAlreadyDeclared this prefix) (continue (unchecked-inc-int i)))
                        (set! nodeType DTM/NAMESPACE_NODE))
                      (do
                        (set! nodeType DTM/ATTRIBUTE_NODE)
                        (when (.equalsIgnoreCase (.getType attributes i) "ID")
                          (.setIDAttribute this valString elemNode))))
                  (when (nil? valString) (set! valString ""))
                  (let [^:mutable val (.stringToIndex m_valuesOrPrefixes valString)]
                    (when (some? prefix)
                      (set! prefixIndex (.stringToIndex m_valuesOrPrefixes attrQName))
                      (let [dataIndex (.size m_data)]
                        (.addElement m_data prefixIndex)
                        (.addElement m_data val)
                        (set! val (unchecked-negate-int dataIndex))))
                    (set! exName
                          (.getExpandedTypeID (.-m_expandedNameTable this)
                                              attrUri
                                              attrLocalName
                                              nodeType))
                    (set! prev (.addNode this nodeType exName elemNode prev val false))
                    (recur (unchecked-inc-int i)))))))
          (when-not (== DTM/NULL prev) (.setElementAt (.-m_nextsib this) DTM/NULL prev))
          (when (some? (.-m_wsfilter this))
            (let [wsv (.getShouldStripSpace (.-m_wsfilter this)
                                            (.makeNodeHandle this elemNode)
                                            this)
                  shouldStrip (if (== DTMWSFilter/INHERIT wsv)
                                  (.getShouldStripWhitespace this)
                                  (== DTMWSFilter/STRIP wsv))]
              (.pushShouldStripWhitespace this shouldStrip)))
          (set! m_previous DTM/NULL)
          (.push m_contextIndexes (.size m_prefixMappings))))))

  (method ^:public endElement :throws [SAXException] ^void [this ^String uri ^String localName
                                                            ^String qName]
    (when DEBUG
      (.println System/out
                (java-str "endElement: uri: " uri ", localname: " localName ", qname: " qName)))
    (.charactersFlush this)
    (.quickPop m_contextIndexes 1)
    (let [topContextIndex (.peek m_contextIndexes)]
      (when-not (== topContextIndex (.size m_prefixMappings))
        (.setSize m_prefixMappings topContextIndex))
      (let [lastNode m_previous]
        (set! m_previous (.pop m_parents))
        (if (== DTM/NULL lastNode)
            (.setElementAt (.-m_firstch this) DTM/NULL m_previous)
            (.setElementAt (.-m_nextsib this) DTM/NULL lastNode))
        (.popShouldStripWhitespace this))))

  (method ^:public characters :throws [SAXException] ^void [this ^char/1 ch ^int start ^int length]
    (cond
      (== m_textPendingStart -1)
        (do (set! m_textPendingStart (.size m_chars)) (set! m_coalescedTextType m_textType))
      (== m_textType DTM/TEXT_NODE) (set! m_coalescedTextType DTM/TEXT_NODE))
    (.append m_chars ch start length))

  (method ^:public ignorableWhitespace :throws [SAXException] ^void [this ^char/1 ch ^int start
                                                                     ^int length]
    (.characters this ch start length))

  (method ^:public processingInstruction :throws [SAXException] ^void [this ^String target
                                                                       ^String data]
    (when DEBUG
      (.println System/out (java-str "processingInstruction: target: " target ", data: " data)))
    (.charactersFlush this)
    (let [exName (.getExpandedTypeID (.-m_expandedNameTable this)
                                     nil
                                     target
                                     DTM/PROCESSING_INSTRUCTION_NODE)
          dataIndex (.stringToIndex m_valuesOrPrefixes data)]
      (set! m_previous
            (.addNode this
                      DTM/PROCESSING_INSTRUCTION_NODE
                      exName
                      (.peek m_parents)
                      m_previous
                      dataIndex
                      false))))

  (method ^:public skippedEntity :throws [SAXException] ^void [this ^String name])

  (method ^:public warning :throws [SAXException] ^void [this ^SAXParseException e]
    (.println System/err (.getMessage e)))

  (method ^:public error :throws [SAXException] ^void [this ^SAXParseException e]
    (throw e))

  (method ^:public fatalError :throws [SAXException] ^void [this ^SAXParseException e]
    (throw e))

  (method ^:public elementDecl :throws [SAXException] ^void [this ^String name ^String model])

  (method ^:public attributeDecl :throws [SAXException] ^void [this ^String eName ^String aName
                                                               ^String type ^String valueDefault
                                                               ^String value])

  (method ^:public internalEntityDecl :throws [SAXException] ^void [this ^String name ^String value])

  (method ^:public externalEntityDecl :throws [SAXException] ^void [this ^String name
                                                                    ^String publicId
                                                                    ^String systemId])

  (method ^:public startDTD :throws [SAXException] ^void [this ^String name ^String publicId
                                                          ^String systemId]
    (set! m_insideDTD true))

  (method ^:public endDTD :throws [SAXException] ^void [this]
    (set! m_insideDTD false))

  (method ^:public startEntity :throws [SAXException] ^void [this ^String name])

  (method ^:public endEntity :throws [SAXException] ^void [this ^String name])

  (method ^:public startCDATA :throws [SAXException] ^void [this]
    (set! m_textType DTM/CDATA_SECTION_NODE))

  (method ^:public endCDATA :throws [SAXException] ^void [this]
    (set! m_textType DTM/TEXT_NODE))

  (method ^:public comment :throws [SAXException] ^void [this ^char/1 ch ^int start ^int length]
    (when-not m_insideDTD
      (.charactersFlush this)
      (let [exName (.getExpandedTypeID (.-m_expandedNameTable this) DTM/COMMENT_NODE)
            dataIndex (.stringToIndex m_valuesOrPrefixes (String. ch start length))]
        (set! m_previous
              (.addNode this DTM/COMMENT_NODE exName (.peek m_parents) m_previous dataIndex false)))))

  (method ^:public setProperty ^void [this ^String property value])

  (method ^:public getSourceLocatorFor ^SourceLocator [this ^:mutable ^int node]
    (cond
      m_useSourceLocationProperty
        (do
          (set! node (.makeNodeIdentity this node))
          (NodeLocator. nil
                        (.elementAt m_sourceSystemId node)
                        (.elementAt m_sourceLine node)
                        (.elementAt m_sourceColumn node)))
      (some? m_locator) (NodeLocator. nil (.getSystemId m_locator) -1 -1)
      (some? m_systemId) (NodeLocator. nil m_systemId -1 -1)))

  (method ^:public getFixedNames ^String [this ^int type]
    (aget m_fixednames type)))

                (let [^:final uri (cast String (.get URI_and_localNames i))
                      ^:final localName (cast String
                                              (.get URI_and_localNames (unchecked-add-int i 1)))]
                  (when (some? uri) (.append sb \{) (.append sb uri) (.append sb \}))
                  (.append sb localName)
                  (recur (unchecked-add-int i 2)))))

  (method ^:protected accumDefaultEscape :throws [IOException SAXException] ^int [this
                                                                                  ^Writer writer
                                                                                  ^char ch
                                                                                  ^:mutable ^int i
                                                                                  ^char/1 chars
                                                                                  ^int len
                                                                                  ^boolean fromTextNode
                                                                                  ^boolean escLF]

                        (.setLength buf 0))
                      (continue (unchecked-inc-int i)))
                  (== \{ c) (set! inCurly true)
                  (== \} c) (set! inCurly false))
                (.append buf c)
                (recur (unchecked-inc-int i)))))
          (when (> (.length buf) 0)
            (.addCdataSectionElement this (.toString buf) al)
            (.setLength buf 0))
          (.setCdataSectionElements this al)))))


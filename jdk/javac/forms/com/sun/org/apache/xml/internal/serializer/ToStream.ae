        (< (.getIndex (.-m_attributes this) rawName) 0)))

  (method ^:private doAddAttributeAlways ^boolean [this ^String uri ^String localName
                                                   ^:mutable ^String rawName ^String type
                                                   ^String value ^boolean xslAttribute]

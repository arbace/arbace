        (catch SAXException se))))

  (defclass ^:private WritertoStringBuffer
    :extends Writer

    (field ^:private ^:final ^StringBuffer m_stringbuf)

    (constructor [this ^StringBuffer sb] (set! m_stringbuf sb))

    (method ^:public write :throws [IOException] ^void [this ^char/1 arg0 ^int arg1 ^int arg2]
      (.append m_stringbuf arg0 arg1 arg2))

    (method ^:public flush :throws [IOException] ^void [this])

    (method ^:public close :throws [IOException] ^void [this])

    (method ^:public write ^void [this ^int i]
      (.append m_stringbuf (unchecked-char i)))

    (method ^:public write ^void [this ^String s] (.append m_stringbuf s)))

  (method ^:public setTransformer ^void [this ^Transformer transformer]
    (.setTransformer super transformer)
    (when (and (some? (.-m_tracer this)) (not (instance? SerializerTraceWriter (.-m_writer this))))
      (set! (.-m_writer this) (SerializerTraceWriter. (.-m_writer this) (.-m_tracer this)))))

  (method ^:public reset ^boolean [this]
    (let [^:mutable wasReset false]
      (when (.reset super) (.resetToStream this) (set! wasReset true))
      wasReset))

  (method ^:private resetToStream ^void [this]
    (set! (.-m_cdataStartCalled this) false)
    (.clear (.-m_disableOutputEscapingStates this))
    (set! (.-m_escaping this) true)
    (set! (.-m_inDoctype this) false)
    (set! (.-m_ispreserveSpace this) false)
    (.clear (.-m_preserveSpaces this))
    (set! (.-m_childNodeNum this) 0)
    (.clear (.-m_childNodeNumStack this))
    (.clear (.-m_charactersBuffer this))
    (set! (.-m_isprevtext this) false)
    (set! (.-m_isUTF8 this) false)
    (set! (.-m_shouldFlush this) true)
    (set! (.-m_spaceBeforeClose this) false)
    (set! (.-m_startNewLine this) false)
    (set! (.-m_lineSepUse this) true)
    (set! (.-m_expandDTDEntities this) true))

  (method ^:public setEncoding ^void [this ^String encoding]
    (.setOutputProperty this OutputKeys/ENCODING encoding))

  (defclass ^:static ^:final BoolStack
    (field ^:private ^boolean/1 m_values)

    (field ^:private ^int m_allocatedSize)

    (field ^:private ^int m_index)

    (constructor ^:public [this] (this. 32))

    (constructor ^:public [this ^int size]
      (set! m_allocatedSize size)
      (set! m_values (new boolean/1 size))
      (set! m_index -1))

    (method ^:public ^:final size ^int [this] (unchecked-add-int m_index 1))

    (method ^:public ^:final clear ^void [this] (set! m_index -1))

    (method ^:public ^:final push ^boolean [this ^boolean val]
      (when (== m_index (unchecked-subtract-int m_allocatedSize 1)) (.grow this))
      (aset m_values (set! m_index (unchecked-inc-int m_index)) val))

    (method ^:public ^:final pop ^boolean [this]
      (let [m_index-1 m_index] (set! m_index (unchecked-dec-int m_index)) (aget m_values m_index-1)))

    (method ^:public ^:final popAndTop ^boolean [this]
      (set! m_index (unchecked-dec-int m_index))
      (if (>= m_index 0) (aget m_values m_index) false))

    (method ^:public ^:final setTop ^void [this ^boolean b]
      (aset m_values m_index b))

    (method ^:public ^:final peek ^boolean [this] (aget m_values m_index))

    (method ^:public ^:final peekOrFalse ^boolean [this]
      (if (> m_index -1) (aget m_values m_index) false))

    (method ^:public ^:final peekOrTrue ^boolean [this]
      (if (> m_index -1) (aget m_values m_index) true))

    (method ^:public isEmpty ^boolean [this] (== m_index -1))

    (method ^:private grow ^void [this]
      (set! m_allocatedSize (unchecked-multiply-int m_allocatedSize 2))
      (let [newVector (new boolean/1 m_allocatedSize)]
        (System/arraycopy m_values 0 newVector 0 (unchecked-add-int m_index 1))
        (set! m_values newVector))))

  (defclass ^:private CharacterBuffer
    (defclass ^:private ^:abstract GenericCharacters
      (method ^:abstract flush :throws [SAXException] ^boolean [this ^boolean skipBeginningNewlines])

      (method ^:abstract toChars ^char/1 [this]))

    (field ^:private ^{:tag (List GenericCharacters)} bufferedCharacters (ArrayList.))

    (method ^:public addText ^void [this ^:final ^char/1 chars ^:final ^int start
                                    ^:final ^int length]
      (.add bufferedCharacters
            (anon GenericCharacters []
              (field ^char/1 text)

              (initializer
                (set! text (Arrays/copyOfRange chars start (unchecked-add-int start length))))

              (method flush :throws [SAXException] ^boolean [this ^boolean skipBeginningNewlines]
                (let [^:mutable ^int start 0]
                  (while (and skipBeginningNewlines (== (aget text start) \newline))
                    (set! start (unchecked-inc-int start))
                    (when (== start (alength text)) (return true)))
                  (.outputCharacters ToStream/this
                                     text
                                     start
                                     (unchecked-subtract-int (alength text) start))
                  false))

              (method toChars ^char/1 [this] text))))

    (method ^:public addEntityReference ^void [this ^String entityName]
      (.add bufferedCharacters
            (anon GenericCharacters []
              (method flush :throws [SAXException] ^boolean [this ^boolean skipBeginningNewlines]
                (when (.-m_startTagOpen (.-m_elemContext ToStream/this))
                  (.closeStartTag ToStream/this)
                  (set! (.-m_startTagOpen (.-m_elemContext ToStream/this)) false))
                (when (.-m_cdataTagOpen ToStream/this) (.closeCDATA ToStream/this))
                (let [cs (.toChars this)]
                  (try
                    (.write (.-m_writer ToStream/this) cs 0 (alength cs))
                    (set! m_isprevtext true)
                    (catch IOException e (throw (SAXException. e))))
                  false))

              (method toChars ^char/1 [this]
                (.toCharArray (java-str "&" entityName ";"))))))

    (method ^:public addRawText ^void [this ^:final ^char/1 chars ^:final ^int start
                                       ^:final ^int length]
      (.add bufferedCharacters
            (anon GenericCharacters []
              (field ^char/1 text)

              (initializer
                (set! text (Arrays/copyOfRange chars start (unchecked-add-int start length))))

              (method flush :throws [SAXException] ^boolean [this ^boolean skipBeginningNewlines]
                (try
                  (let [^:mutable ^int start 0]
                    (while (and skipBeginningNewlines (== (aget text start) \newline))
                      (set! start (unchecked-inc-int start))
                      (when (== start (alength text)) (return true)))
                    (.write (.-m_writer ToStream/this)
                            text
                            start
                            (unchecked-subtract-int (alength text) start))
                    (set! m_isprevtext true))
                  (catch IOException e (throw (SAXException. e))))
                false)

              (method toChars ^char/1 [this] text))))

    (method ^:public isAnyCharactersBuffered ^boolean [this]
      (> (.size bufferedCharacters) 0))

    (method ^:public flush :throws [SAXException] ^void [this ^boolean skipBeginningNewlines]
      (let [^{:tag (Iterator GenericCharacters)} itr (.iterator bufferedCharacters)
            ^:mutable continueSkipBeginningNewlines skipBeginningNewlines]
        (while (.hasNext itr)
          (let [element (cast GenericCharacters (.next itr))]
            (set! continueSkipBeginningNewlines (.flush element continueSkipBeginningNewlines))
            (.remove itr)))))

    (method ^:public toChars ^char/1 [this]
      (let [sb (StringBuilder.)]
        (for-each [^GenericCharacters element bufferedCharacters] (.append sb (.toChars element)))
        (.toCharArray (.toString sb))))

    (method ^:public clear ^void [this] (.clear bufferedCharacters)))

  (method ^:public notationDecl :throws [SAXException] ^void [this ^String name ^String pubID
                                                              ^String sysID]
    (try
      (.DTDprolog this)
      (.write (.-m_writer this) "<!NOTATION ")
      (.write (.-m_writer this) name)
      (.write (.-m_writer this) (JdkXmlUtils/getDTDExternalDecl pubID sysID))
      (.write (.-m_writer this) ">")
      (.write (.-m_writer this) m_lineSep 0 m_lineSepLen)
      (catch IOException e (.printStackTrace e))))

  (method ^:public unparsedEntityDecl :throws [SAXException] ^void [this ^String name ^String pubID
                                                                    ^String sysID
                                                                    ^String notationName]
    (try
      (.DTDprolog this)
      (.write (.-m_writer this) "<!ENTITY ")
      (.write (.-m_writer this) name)
      (.write (.-m_writer this) (JdkXmlUtils/getDTDExternalDecl pubID sysID))
      (.write (.-m_writer this) " NDATA ")
      (.write (.-m_writer this) notationName)
      (.write (.-m_writer this) " >")
      (.write (.-m_writer this) m_lineSep 0 m_lineSepLen)
      (catch IOException e (.printStackTrace e))))

  (method ^:private DTDprolog :throws [SAXException IOException] ^void [this]
    (let [^:final writer (.-m_writer this)]
      (when (.-m_needToOutputDocTypeDecl this)
        (.outputDocTypeDecl this (.-m_elementName (.-m_elemContext this)) false)
        (set! (.-m_needToOutputDocTypeDecl this) false))
      (when m_inDoctype
        (.write writer " [")
        (.write writer m_lineSep 0 m_lineSepLen)
        (set! m_inDoctype false))))

  (method ^:public setDTDEntityExpansion ^void [this ^boolean expand]
    (set! m_expandDTDEntities expand))

  (method ^:public addCdataSectionElements ^void [this ^String URI_and_localNames]
    (when (some? URI_and_localNames) (.initCdataElems this URI_and_localNames))
    (if (nil? (.-m_StringOfCDATASections this))
        (set! (.-m_StringOfCDATASections this) URI_and_localNames)
        (set! (.-m_StringOfCDATASections this)
              (java-str (.-m_StringOfCDATASections this) (java-str " " URI_and_localNames))))))

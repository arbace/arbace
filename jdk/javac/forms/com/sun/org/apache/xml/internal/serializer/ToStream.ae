            (when (or (nil? foundURI) (not (.equals foundURI ns)))
              (.startPrefixMapping this prefix ns)
              (.addAttributeAlways this
                                   "http://www.w3.org/2000/xmlns/"
                                   ^String (if no_prefix "xmlns" prefix)

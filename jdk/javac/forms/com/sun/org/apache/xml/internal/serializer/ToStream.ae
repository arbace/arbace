          ^:mutable ^int index 0]
      (set! index (.getIndex (.-m_attributes this) rawName))
      (if (>= index 0)
          (let [^:mutable ^String old_value nil]
            (when (some? (.-m_tracer this))
              (set! old_value (.getValue (.-m_attributes this) index))
              (when (.equals value old_value) (set! old_value nil)))
            (.setValue (.-m_attributes this) index value)
            (set! was_added false)
            (when (some? old_value) (.firePseudoAttributes this)))
          (do
            (when xslAttribute
              (let [^:final colonIndex (.indexOf rawName \:)]
                (when (> colonIndex 0)
                  (let [^:mutable prefix (.substring rawName 0 colonIndex)
                        existing_mapping (.getMappingFromPrefix (.-m_prefixMap this) prefix)]
                    (when (and (and (some? existing_mapping)
                                    (== (.-m_declarationDepth existing_mapping)
                                        (.-m_currentElemDepth (.-m_elemContext this))))
                               (not (.equals (.-m_uri existing_mapping) uri)))
                      (set! prefix (.lookupPrefix (.-m_prefixMap this) uri))
                      (when (nil? prefix) (set! prefix (.generateNextPrefix (.-m_prefixMap this))))

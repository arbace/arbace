            (when-not (not (== exptype expandedTypeID))
              (return (.makeNodeHandle DTMDefaultBaseTraversers/this current))))
          (set! current (unchecked-inc-int current))))))

  (defclass ^:private RootTraverser
    :extends AllFromRootTraverser

    (method ^:public first ^int [this ^int context ^int expandedTypeID]
      (let [root (.getDocumentRoot DTMDefaultBaseTraversers/this context)]
        (if (== (.getExpandedTypeID DTMDefaultBaseTraversers/this root) expandedTypeID)
            root
            DTM/NULL)))

    (method ^:public next ^int [this ^int context ^int current] DTM/NULL)

    (method ^:public next ^int [this ^int context ^int current ^int expandedTypeID]
      DTM/NULL))

  (defclass ^:private DescendantOrSelfFromRootTraverser
    :extends DescendantTraverser

    (method ^:protected getFirstPotential ^int [this ^int identity]
      identity)

    (method ^:protected getSubtreeRoot ^int [this ^int handle]
      (.makeNodeIdentity DTMDefaultBaseTraversers/this (.getDocument DTMDefaultBaseTraversers/this)))

    (method ^:public first ^int [this ^int context]
      (.getDocumentRoot DTMDefaultBaseTraversers/this context))

    (method ^:public first ^int [this ^int context ^int expandedTypeID]
      (if (.isIndexed this expandedTypeID)
          (let [^int identity 0
                firstPotential (.getFirstPotential this identity)]
            (.makeNodeHandle DTMDefaultBaseTraversers/this
                             (.getNextIndexed this identity firstPotential expandedTypeID)))
          (let [root (.first this context)] (.next this root root expandedTypeID)))))

  (defclass ^:private DescendantFromRootTraverser
    :extends DescendantTraverser

    (method ^:protected getFirstPotential ^int [this ^int identity]
      (._firstch DTMDefaultBaseTraversers/this 0))

    (method ^:protected getSubtreeRoot ^int [this ^int handle] 0)

    (method ^:public first ^int [this ^int context]
      (.makeNodeHandle DTMDefaultBaseTraversers/this (._firstch DTMDefaultBaseTraversers/this 0)))

    (method ^:public first ^int [this ^int context ^int expandedTypeID]
      (if (.isIndexed this expandedTypeID)
          (let [^int identity 0
                firstPotential (.getFirstPotential this identity)]
            (.makeNodeHandle DTMDefaultBaseTraversers/this
                             (.getNextIndexed this identity firstPotential expandedTypeID)))
          (let [root (.getDocumentRoot DTMDefaultBaseTraversers/this context)]
            (.next this root root expandedTypeID))))))

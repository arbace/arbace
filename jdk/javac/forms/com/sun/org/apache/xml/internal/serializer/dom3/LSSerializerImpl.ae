                    (throw (DOMException. DOMException/NOT_SUPPORTED_ERR msg)))
                (.equalsIgnoreCase name DOMConstants/DOM_CANONICAL_FORM)
                  (.setProperty fDOMConfigProperties
                                (java-str DOMConstants/S_DOM3_PROPERTIES_NS
                                          DOMConstants/DOM_CANONICAL_FORM)
                                DOMConstants/DOM3_EXPLICIT_FALSE)
                (.equalsIgnoreCase name DOMConstants/DOM_VALIDATE_IF_SCHEMA)
                  (.setProperty fDOMConfigProperties
                                (java-str DOMConstants/S_DOM3_PROPERTIES_NS
                                          DOMConstants/DOM_VALIDATE_IF_SCHEMA)
                                DOMConstants/DOM3_EXPLICIT_FALSE)
                (.equalsIgnoreCase name DOMConstants/DOM_VALIDATE)
                  (.setProperty fDOMConfigProperties
                                (java-str DOMConstants/S_DOM3_PROPERTIES_NS
                                          DOMConstants/DOM_VALIDATE)
                                DOMConstants/DOM3_EXPLICIT_FALSE)
                (.equalsIgnoreCase name DOMConstants/DOM_VALIDATE_IF_SCHEMA)
                  (.setProperty fDOMConfigProperties
                                (java-str DOMConstants/DOM_CHECK_CHAR_NORMALIZATION
                                          DOMConstants/DOM_CHECK_CHAR_NORMALIZATION)
                                DOMConstants/DOM3_EXPLICIT_FALSE)
                (.equalsIgnoreCase name DOMConstants/DOM_DATATYPE_NORMALIZATION)
                  (.setProperty fDOMConfigProperties
                                (java-str DOMConstants/S_DOM3_PROPERTIES_NS
                                          DOMConstants/DOM_DATATYPE_NORMALIZATION)
                                DOMConstants/DOM3_EXPLICIT_FALSE))
            (.equalsIgnoreCase name DOMConstants/DOM_INFOSET)
              (when bValue
                (set! fFeatures (bit-and-int fFeatures (bit-not-int ENTITIES)))
                (set! fFeatures (bit-and-int fFeatures (bit-not-int CDATA)))
                (set! fFeatures (bit-and-int fFeatures (bit-not-int SCHEMAVALIDATE)))
                (set! fFeatures (bit-and-int fFeatures (bit-not-int DTNORMALIZE)))
                (set! fFeatures (bit-or-int fFeatures NAMESPACES))
                (set! fFeatures (bit-or-int fFeatures NAMESPACEDECLS))
                (set! fFeatures (bit-or-int fFeatures WELLFORMED))
                (set! fFeatures (bit-or-int fFeatures ELEM_CONTENT_WHITESPACE))
                (set! fFeatures (bit-or-int fFeatures COMMENTS))
                (.setProperty fDOMConfigProperties
                              (java-str DOMConstants/S_DOM3_PROPERTIES_NS
                                        DOMConstants/DOM_NAMESPACES)
                              DOMConstants/DOM3_EXPLICIT_TRUE)
                (.setProperty fDOMConfigProperties
                              (java-str DOMConstants/S_DOM3_PROPERTIES_NS
                                        DOMConstants/DOM_NAMESPACE_DECLARATIONS)
                              DOMConstants/DOM3_EXPLICIT_TRUE)
                (.setProperty fDOMConfigProperties
                              (java-str DOMConstants/S_DOM3_PROPERTIES_NS DOMConstants/DOM_COMMENTS)
                              DOMConstants/DOM3_EXPLICIT_TRUE)
                (.setProperty fDOMConfigProperties
                              (java-str DOMConstants/S_DOM3_PROPERTIES_NS
                                        DOMConstants/DOM_ELEMENT_CONTENT_WHITESPACE)
                              DOMConstants/DOM3_EXPLICIT_TRUE)
                (.setProperty fDOMConfigProperties
                              (java-str DOMConstants/S_DOM3_PROPERTIES_NS
                                        DOMConstants/DOM_WELLFORMED)
                              DOMConstants/DOM3_EXPLICIT_TRUE)
                (.setProperty fDOMConfigProperties
                              (java-str DOMConstants/S_DOM3_PROPERTIES_NS DOMConstants/DOM_ENTITIES)
                              DOMConstants/DOM3_EXPLICIT_FALSE)
                (.setProperty fDOMConfigProperties
                              (java-str DOMConstants/S_DOM3_PROPERTIES_NS
                                        DOMConstants/DOM_CDATA_SECTIONS)
                              DOMConstants/DOM3_EXPLICIT_FALSE)
                (.setProperty fDOMConfigProperties
                              (java-str DOMConstants/S_DOM3_PROPERTIES_NS
                                        DOMConstants/DOM_VALIDATE_IF_SCHEMA)
                              DOMConstants/DOM3_EXPLICIT_FALSE)
                (.setProperty fDOMConfigProperties
                              (java-str DOMConstants/S_DOM3_PROPERTIES_NS
                                        DOMConstants/DOM_DATATYPE_NORMALIZATION)
                              DOMConstants/DOM3_EXPLICIT_FALSE))
            (.equalsIgnoreCase name DOMConstants/DOM_NORMALIZE_CHARACTERS)
              (let [msg (.createMessage Utils/messages
                                        MsgKey/ER_FEATURE_NOT_SUPPORTED
                                        (new Object/1 [name]))]
                (throw (DOMException. DOMException/NOT_SUPPORTED_ERR msg)))))
      (.equalsIgnoreCase name DOMConstants/DOM_ERROR_HANDLER)
        (if (or (nil? value) (instance? DOMErrorHandler value))
            (set! fDOMErrorHandler (cast DOMErrorHandler value))
            (let [msg (.createMessage Utils/messages
                                      MsgKey/ER_TYPE_MISMATCH_ERR
                                      (new Object/1 [name]))]
              (throw (DOMException. DOMException/TYPE_MISMATCH_ERR msg))))
      (or (or (.equalsIgnoreCase name DOMConstants/DOM_SCHEMA_LOCATION)
              (.equalsIgnoreCase name DOMConstants/DOM_SCHEMA_TYPE))
          (and (.equalsIgnoreCase name DOMConstants/DOM_NORMALIZE_CHARACTERS) (some? value)))
        (let [msg (.createMessage Utils/messages
                                  MsgKey/ER_FEATURE_NOT_SUPPORTED
                                  (new Object/1 [name]))]
          (throw (DOMException. DOMException/NOT_SUPPORTED_ERR msg)))
      :else
        (let [msg (.createMessage Utils/messages MsgKey/ER_FEATURE_NOT_FOUND (new Object/1 [name]))]
          (throw (DOMException. DOMException/NOT_FOUND_ERR msg)))))

  (method ^:public getDomConfig ^DOMConfiguration [this]
    ^DOMConfiguration this)

  (method ^:public getFilter ^LSSerializerFilter [this] fSerializerFilter)

  (method ^:public getNewLine ^String [this] fEndOfLine)

  (method ^:public setFilter ^void [this ^LSSerializerFilter filter]
    (set! fSerializerFilter filter))

  (method ^:public setNewLine ^void [this ^String newLine]
    (set! fEndOfLine (if (some? newLine) newLine fEndOfLine)))

  (method ^:public write :throws [LSException] ^boolean [this ^Node nodeArg ^LSOutput destination]
    (when (nil? destination)
      (let [msg (.createMessage Utils/messages MsgKey/ER_NO_OUTPUT_SPECIFIED nil)]
        (when (some? fDOMErrorHandler)
          (.handleError fDOMErrorHandler
                        (DOMErrorImpl. DOMError/SEVERITY_FATAL_ERROR
                                       msg
                                       MsgKey/ER_NO_OUTPUT_SPECIFIED)))
        (throw (LSException. LSException/SERIALIZE_ERR msg))))
    (if (nil? nodeArg)
        false
        (let [serializer fXMLSerializer]
          (.reset serializer)
          (when-not (identical? nodeArg fVisitedNode)
            (let [xmlVersion (.getXMLVersion this nodeArg)]
              (set! fEncoding (.getEncoding destination))
              (when (nil? fEncoding)
                (set! fEncoding (.getInputEncoding this nodeArg))
                (set! fEncoding
                      (cond
                        (some? fEncoding) fEncoding
                        (nil? (.getXMLEncoding this nodeArg)) "UTF-8"
                        :else (.getXMLEncoding this nodeArg))))
              (when-not (Encodings/isRecognizedEncoding fEncoding)
                (let [msg (.createMessage Utils/messages MsgKey/ER_UNSUPPORTED_ENCODING nil)]
                  (when (some? fDOMErrorHandler)
                    (.handleError fDOMErrorHandler
                                  (DOMErrorImpl.
                                    DOMError/SEVERITY_FATAL_ERROR
                                    msg
                                    MsgKey/ER_UNSUPPORTED_ENCODING)))
                  (throw (LSException. LSException/SERIALIZE_ERR msg))))
              (.setProperty (.getOutputFormat serializer) "version" xmlVersion)
              (.setProperty fDOMConfigProperties
                            (java-str DOMConstants/S_XERCES_PROPERTIES_NS
                                      DOMConstants/S_XML_VERSION)
                            xmlVersion)
              (.setProperty fDOMConfigProperties DOMConstants/S_XSL_OUTPUT_ENCODING fEncoding)
              (when (and (or (or (not (== (.getNodeType nodeArg) Node/DOCUMENT_NODE))
                                 (not (== (.getNodeType nodeArg) Node/ELEMENT_NODE)))
                             (not (== (.getNodeType nodeArg) Node/ENTITY_NODE)))
                         (not (== (bit-and-int fFeatures XMLDECL) 0)))
                (.setProperty fDOMConfigProperties
                              DOMConstants/S_XSL_OUTPUT_OMIT_XML_DECL
                              DOMConstants/DOM3_DEFAULT_FALSE))
              (set! fVisitedNode nodeArg)))
          (.setOutputFormat fXMLSerializer fDOMConfigProperties)
          (try
            (let [writer (.getCharacterStream destination)]
              (if (nil? writer)
                  (let [outputStream (.getByteStream destination)]
                    (if (nil? outputStream)
                        (let [uri (.getSystemId destination)]
                          (if (nil? uri)
                              (let [msg (.createMessage
                                          Utils/messages
                                          MsgKey/ER_NO_OUTPUT_SPECIFIED
                                          nil)]
                                (when (some? fDOMErrorHandler)
                                  (.handleError fDOMErrorHandler
                                                (DOMErrorImpl.
                                                  DOMError/SEVERITY_FATAL_ERROR
                                                  msg
                                                  MsgKey/ER_NO_OUTPUT_SPECIFIED)))
                                (throw (LSException. LSException/SERIALIZE_ERR msg)))
                              (let [absoluteURI (SystemIDResolver/getAbsoluteURI uri)
                                    url (URL. absoluteURI)
                                    ^:mutable ^OutputStream urlOutStream nil
                                    protocol (.getProtocol url)
                                    host (.getHost url)]
                                (if (and (.equalsIgnoreCase protocol "file")
                                         (or (or (nil? host) (== (.length host) 0))
                                             (.equals host "localhost")))
                                    (set! urlOutStream (FileOutputStream. (File. (.getPath url))))
                                    (let [urlCon (.openConnection url)]
                                      (.setDoInput urlCon false)
                                      (.setDoOutput urlCon true)
                                      (.setUseCaches urlCon false)
                                      (.setAllowUserInteraction urlCon false)
                                      (when (instance? HttpURLConnection urlCon)
                                        (let [httpCon (cast HttpURLConnection urlCon)]
                                          (.setRequestMethod httpCon "PUT")))
                                      (set! urlOutStream (.getOutputStream urlCon))))
                                (.setWriter serializer (OutputStreamWriter. urlOutStream)))))
                        (.setWriter serializer (OutputStreamWriter. outputStream fEncoding))))
                  (.setWriter serializer writer))
              (when (nil? fDOMSerializer)
                (set! fDOMSerializer (cast DOM3Serializer (.asDOM3Serializer serializer))))
              (when (some? fDOMErrorHandler) (.setErrorHandler fDOMSerializer fDOMErrorHandler))
              (when (some? fSerializerFilter) (.setNodeFilter fDOMSerializer fSerializerFilter))
              (.setNewLine fDOMSerializer fEndOfLine)
              (.serializeDOM3 fDOMSerializer nodeArg))
            (catch UnsupportedEncodingException ue
              (let [msg (.createMessage Utils/messages MsgKey/ER_UNSUPPORTED_ENCODING nil)]
                (when (some? fDOMErrorHandler)
                  (.handleError fDOMErrorHandler
                                (DOMErrorImpl. DOMError/SEVERITY_FATAL_ERROR
                                               msg
                                               MsgKey/ER_UNSUPPORTED_ENCODING
                                               ue)))
                (throw (LSException. LSException/SERIALIZE_ERR (.getMessage ue)))))
            (catch LSException lse (throw lse))
            (catch RuntimeException e
              (.printStackTrace e)
              (throw (LSException. LSException/SERIALIZE_ERR
                                   ^String (if (some? e) (.getMessage e) "NULL Exception"))))
            (catch Exception e
              (when (some? fDOMErrorHandler)
                (.handleError fDOMErrorHandler
                              (DOMErrorImpl. DOMError/SEVERITY_FATAL_ERROR (.getMessage e) nil e)))
              (.printStackTrace e)
              (throw (LSException. LSException/SERIALIZE_ERR (.toString e)))))
          true)))

  (method ^:public writeToString :throws [DOMException LSException] ^String [this ^Node nodeArg]
    (when (some? nodeArg)
      (let [serializer fXMLSerializer]
        (.reset serializer)
        (when-not (identical? nodeArg fVisitedNode)
          (let [xmlVersion (.getXMLVersion this nodeArg)]
            (.setProperty (.getOutputFormat serializer) "version" xmlVersion)
            (.setProperty fDOMConfigProperties
                          (java-str DOMConstants/S_XERCES_PROPERTIES_NS DOMConstants/S_XML_VERSION)
                          xmlVersion)
            (.setProperty fDOMConfigProperties DOMConstants/S_XSL_OUTPUT_ENCODING "UTF-16")
            (when (and (or (or (not (== (.getNodeType nodeArg) Node/DOCUMENT_NODE))
                               (not (== (.getNodeType nodeArg) Node/ELEMENT_NODE)))
                           (not (== (.getNodeType nodeArg) Node/ENTITY_NODE)))
                       (not (== (bit-and-int fFeatures XMLDECL) 0)))
              (.setProperty fDOMConfigProperties
                            DOMConstants/S_XSL_OUTPUT_OMIT_XML_DECL
                            DOMConstants/DOM3_DEFAULT_FALSE))
            (set! fVisitedNode nodeArg)))
        (.setOutputFormat fXMLSerializer fDOMConfigProperties)
        (let [output (StringWriter.)]
          (try
            (.setWriter serializer output)
            (when (nil? fDOMSerializer)
              (set! fDOMSerializer (cast DOM3Serializer (.asDOM3Serializer serializer))))
            (when (some? fDOMErrorHandler) (.setErrorHandler fDOMSerializer fDOMErrorHandler))
            (when (some? fSerializerFilter) (.setNodeFilter fDOMSerializer fSerializerFilter))
            (.setNewLine fDOMSerializer fEndOfLine)
            (.serializeDOM3 fDOMSerializer nodeArg)
            (catch LSException lse (throw lse))
            (catch RuntimeException e
              (.printStackTrace e)
              (throw (LSException. LSException/SERIALIZE_ERR (.toString e))))
            (catch Exception e
              (when (some? fDOMErrorHandler)
                (.handleError fDOMErrorHandler
                              (DOMErrorImpl. DOMError/SEVERITY_FATAL_ERROR (.getMessage e) nil e)))
              (.printStackTrace e)
              (throw (LSException. LSException/SERIALIZE_ERR (.toString e)))))
          (.toString output)))))

  (method ^:public writeToURI :throws [LSException] ^boolean [this ^Node nodeArg ^String uri]
    (if (nil? nodeArg)
        false
        (let [serializer fXMLSerializer]
          (.reset serializer)
          (when-not (identical? nodeArg fVisitedNode)
            (let [xmlVersion (.getXMLVersion this nodeArg)]
              (set! fEncoding (.getInputEncoding this nodeArg))
              (when (nil? fEncoding)
                (set! fEncoding
                      (cond
                        (some? fEncoding) fEncoding
                        (nil? (.getXMLEncoding this nodeArg)) "UTF-8"
                        :else (.getXMLEncoding this nodeArg))))
              (.setProperty (.getOutputFormat serializer) "version" xmlVersion)
              (.setProperty fDOMConfigProperties
                            (java-str DOMConstants/S_XERCES_PROPERTIES_NS
                                      DOMConstants/S_XML_VERSION)
                            xmlVersion)
              (.setProperty fDOMConfigProperties DOMConstants/S_XSL_OUTPUT_ENCODING fEncoding)
              (when (and (or (or (not (== (.getNodeType nodeArg) Node/DOCUMENT_NODE))
                                 (not (== (.getNodeType nodeArg) Node/ELEMENT_NODE)))
                             (not (== (.getNodeType nodeArg) Node/ENTITY_NODE)))
                         (not (== (bit-and-int fFeatures XMLDECL) 0)))
                (.setProperty fDOMConfigProperties
                              DOMConstants/S_XSL_OUTPUT_OMIT_XML_DECL
                              DOMConstants/DOM3_DEFAULT_FALSE))
              (set! fVisitedNode nodeArg)))
          (.setOutputFormat fXMLSerializer fDOMConfigProperties)
          (try
            (if (nil? uri)
                (let [msg (.createMessage Utils/messages MsgKey/ER_NO_OUTPUT_SPECIFIED nil)]
                  (when (some? fDOMErrorHandler)
                    (.handleError fDOMErrorHandler
                                  (DOMErrorImpl.
                                    DOMError/SEVERITY_FATAL_ERROR
                                    msg
                                    MsgKey/ER_NO_OUTPUT_SPECIFIED)))
                  (throw (LSException. LSException/SERIALIZE_ERR msg)))
                (let [absoluteURI (SystemIDResolver/getAbsoluteURI uri)
                      url (URL. absoluteURI)
                      ^:mutable ^OutputStream urlOutStream nil
                      protocol (.getProtocol url)
                      host (.getHost url)]
                  (if (and (.equalsIgnoreCase protocol "file")
                           (or (or (nil? host) (== (.length host) 0)) (.equals host "localhost")))
                      (set! urlOutStream (FileOutputStream. (File. (.getPath url))))
                      (let [urlCon (.openConnection url)]
                        (.setDoInput urlCon false)
                        (.setDoOutput urlCon true)
                        (.setUseCaches urlCon false)
                        (.setAllowUserInteraction urlCon false)
                        (when (instance? HttpURLConnection urlCon)
                          (let [httpCon (cast HttpURLConnection urlCon)]
                            (.setRequestMethod httpCon "PUT")))
                        (set! urlOutStream (.getOutputStream urlCon))))
                  (.setWriter serializer (OutputStreamWriter. urlOutStream fEncoding))))
            (when (nil? fDOMSerializer)
              (set! fDOMSerializer (cast DOM3Serializer (.asDOM3Serializer serializer))))
            (when (some? fDOMErrorHandler) (.setErrorHandler fDOMSerializer fDOMErrorHandler))
            (when (some? fSerializerFilter) (.setNodeFilter fDOMSerializer fSerializerFilter))
            (.setNewLine fDOMSerializer fEndOfLine)
            (.serializeDOM3 fDOMSerializer nodeArg)
            (catch LSException lse (throw lse))
            (catch RuntimeException e
              (.printStackTrace e)
              (throw (LSException. LSException/SERIALIZE_ERR (.toString e))))
            (catch Exception e
              (when (some? fDOMErrorHandler)
                (.handleError fDOMErrorHandler
                              (DOMErrorImpl. DOMError/SEVERITY_FATAL_ERROR (.getMessage e) nil e)))
              (.printStackTrace e)
              (throw (LSException. LSException/SERIALIZE_ERR (.toString e)))))
          true)))

  (method ^:protected getXMLVersion ^String [this ^Node nodeArg]
    (let [^:mutable ^Document doc nil]
      (when (some? nodeArg)
        (if (== (.getNodeType nodeArg) Node/DOCUMENT_NODE)
            (set! doc (cast Document nodeArg))
            (set! doc (.getOwnerDocument nodeArg)))
        (when (and (some? doc) (.hasFeature (.getImplementation doc) "Core" "3.0"))
          (try (return (.getXmlVersion doc)) (catch AbstractMethodError e))))
      "1.0"))

  (method ^:protected getXMLEncoding ^String [this ^Node nodeArg]
    (let [^:mutable ^Document doc nil]
      (when (some? nodeArg)
        (if (== (.getNodeType nodeArg) Node/DOCUMENT_NODE)
            (set! doc (cast Document nodeArg))
            (set! doc (.getOwnerDocument nodeArg)))
        (when (and (some? doc) (.hasFeature (.getImplementation doc) "Core" "3.0"))
          (return (.getXmlEncoding doc))))
      "UTF-8"))

  (method ^:protected getInputEncoding ^String [this ^Node nodeArg]
    (let [^:mutable ^Document doc nil]
      (when (some? nodeArg)
        (if (== (.getNodeType nodeArg) Node/DOCUMENT_NODE)
            (set! doc (cast Document nodeArg))
            (set! doc (.getOwnerDocument nodeArg)))
        (when (and (some? doc) (.hasFeature (.getImplementation doc) "Core" "3.0"))
          (return (.getInputEncoding doc))))
      nil))

  (method ^:public getErrorHandler ^DOMErrorHandler [this]
    fDOMErrorHandler))

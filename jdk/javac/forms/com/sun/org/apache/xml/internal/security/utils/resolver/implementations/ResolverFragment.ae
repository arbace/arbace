  (method ^:public engineResolveURI :throws [ResourceResolverException] ^XMLSignatureInput [this
                                                                                            ^ResourceResolverContext context]
    (let [doc (.getOwnerDocument (.getOwnerElement (.-attr context)))
          ^:mutable ^Node selectedElem nil]
      (if (.isEmpty (.-uriToResolve context))
          (do
            (.debug LOG "ResolverFragment with empty URI (means complete document)")
            (set! selectedElem doc))
          (let [id (.substring (.-uriToResolve context) 1)]

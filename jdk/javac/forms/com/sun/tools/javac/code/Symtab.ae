                                            objectType
                                            (List/nil)
                                            methodClass)
                                          arrayClass))
              (.enter (.members arrayClass) arrayCloneMethod)
              (when-not (identical? java_base noModule)
                (set! (.-completer java_base)
                      (method-ref Symbol$Completer moduleCompleter Symbol$Completer/.complete)))))))))

  (method ^:public defineClass ^Symbol$ClassSymbol [this ^Name name ^Symbol owner]
    (let [c (Symbol$ClassSymbol. 0 name owner)] (set! (.-completer c) initialCompleter) c))

  (method ^:public enterClass ^Symbol$ClassSymbol [this ^Symbol$ModuleSymbol msym ^Name name
                                                   ^Symbol$TypeSymbol owner]
    (Assert/checkNonNull msym)
    (let [flatname (Symbol$TypeSymbol/formFlatName name owner)
          ^:mutable c (.getClass this msym flatname)]
      (if (nil? c)
          (do (set! c (.defineClass this name owner)) (.doEnterClass this msym c))
          (when (and (and (and (or (not (identical? (.-name c) name))
                                   (not (identical? (.-owner c) owner)))
                               (identical? (.-kind owner) Kinds$Kind/TYP))
                          (identical? (.-kind (.-owner c)) Kinds$Kind/PCK))
                     (== (bit-and (.-flags_field c) Flags/FROM_SOURCE) 0))
            (.remove (.members (.-owner c)) c)
            (set! (.-name c) name)
            (set! (.-owner c) owner)
            (set! (.-fullname c) (Symbol$ClassSymbol/formFullName name owner))))
      c))

  (method ^:public getClass ^Symbol$ClassSymbol [this ^Symbol$ModuleSymbol msym ^Name flatName]
    (Assert/checkNonNull msym (method-ref Supplier ^String [] flatName Name/.toString))
    (cast Symbol$ClassSymbol
          (.get (cast Map (.getOrDefault classes flatName (Collections/emptyMap))) msym)))

  (method ^:public lookupPackage ^Symbol$PackageSymbol [this ^Symbol$ModuleSymbol msym
                                                        ^Name flatName]
    (.lookupPackage this msym flatName false))

  (method ^:private lookupPackage ^Symbol$PackageSymbol [this ^Symbol$ModuleSymbol msym
                                                         ^Name flatName ^boolean onlyExisting]
    (Assert/checkNonNull msym)
    (cond
      (.isEmpty flatName) (.-unnamedPackage msym)
      (identical? msym noModule) (.enterPackage this msym flatName)
      :else
        (do
          (.complete msym)
          (let [^:mutable ^Symbol$PackageSymbol pack nil]
            (set! pack (cast Symbol$PackageSymbol (.get (.-visiblePackages msym) flatName)))
            (if (some? pack)
                pack
                (do
                  (set! pack (.getPackage this msym flatName))
                  (if (or (and (some? pack) (.exists pack)) onlyExisting)
                      pack
                      (let [dependsOnUnnamed (and
                                               (some? (.-requires msym))
                                               (.anyMatch
                                                 (.map
                                                   (.stream (.-requires msym))
                                                   (lambda Function ^Symbol$ModuleSymbol [^Directive$RequiresDirective rd]
                                                     (.-module rd)))
                                                 (lambda Predicate ^boolean [^Symbol$ModuleSymbol mod]
                                                   (identical? mod unnamedModule))))]
                        (if dependsOnUnnamed
                            (let [^:mutable unnamedPack (.getPackage this unnamedModule flatName)]
                              (if (and (some? unnamedPack) (.exists unnamedPack))
                                  (do
                                    (.put (.-visiblePackages msym)
                                          (.-fullname unnamedPack)
                                          unnamedPack)
                                    unnamedPack)
                                  (do
                                    (set! pack (.enterPackage this msym flatName))
                                    (.complete pack)
                                    (if (.exists pack)
                                        pack
                                        (do
                                          (set! unnamedPack
                                                (.enterPackage this unnamedModule flatName))
                                          (.complete unnamedPack)
                                          (if (.exists unnamedPack)
                                              (do
                                                (.put
                                                  (.-visiblePackages msym)
                                                  (.-fullname unnamedPack)
                                                  unnamedPack)
                                                unnamedPack)
                                              pack))))))
                            (.enterPackage this msym flatName))))))))))

  (field ^:private ^:static ^:final ^{:tag (Map Symbol$ModuleSymbol Symbol$ClassSymbol)} EMPTY
    (HashMap.))

  (method ^:public removeClass ^void [this ^Symbol$ModuleSymbol msym ^Name flatName]
    (.remove (cast Map (.getOrDefault classes flatName EMPTY)) msym))

  (method ^:public getAllClasses ^{:tag (Iterable Symbol$ClassSymbol)} [this]
    (lambda Iterable ^Iterator []
      (Iterators/createCompoundIterator
        (.values classes)
        (lambda Function ^Iterator [^Map v] (.iterator (.values v))))))

  (method ^:private doEnterClass ^void [this ^Symbol$ModuleSymbol msym ^Symbol$ClassSymbol cs]
    (.put (cast Map
                (.computeIfAbsent classes
                                  (.-flatname cs)
                                  (lambda Function ^Map [^Name n] (HashMap.))))
          msym
          cs))

  (method ^:public enterClass ^Symbol$ClassSymbol [this ^Symbol$ModuleSymbol msym ^Name flatname]
    (Assert/checkNonNull msym)
    (let [ps (.lookupPackage this msym (Convert/packagePart flatname))]
      (Assert/checkNonNull ps)
      (Assert/checkNonNull (.-modle ps))
      (let [^:mutable c (.getClass this (.-modle ps) flatname)]
        (if (nil? c)
            (do
              (set! c (.defineClass this (Convert/shortName flatname) ps))
              (.doEnterClass this (.-modle ps) c)
              c)
            c))))

  (method ^:public packageExists ^boolean [this ^Symbol$ModuleSymbol msym ^Name fullname]
    (Assert/checkNonNull msym)
    (let [pack (.lookupPackage this msym fullname true)] (and (some? pack) (.exists pack))))

  (method ^:public enterPackage ^Symbol$PackageSymbol [this ^Symbol$ModuleSymbol currModule
                                                       ^Name fullname]
    (Assert/checkNonNull currModule)
    (let [^:mutable p (.getPackage this currModule fullname)]
      (when (nil? p)
        (Assert/check (not (.isEmpty fullname))
                      (lambda Supplier ^String []
                        (java-str "rootPackage missing!; currModule: " currModule)))
        (set!
          p
          (Symbol$PackageSymbol. (Convert/shortName fullname)
                                 (.enterPackage this currModule (Convert/packagePart fullname))))
        (set! (.-completer p) initialCompleter)
        (set! (.-modle p) currModule)
        (.doEnterPackage this currModule p))
      p))

  (method ^:private doEnterPackage ^void [this ^Symbol$ModuleSymbol msym ^Symbol$PackageSymbol pack]
    (.put (cast Map
                (.computeIfAbsent packages
                                  (.-fullname pack)
                                  (lambda Function ^Map [^Name n] (HashMap.))))
          msym
          pack)
    (set! (.-enclosedPackages msym) (.prepend (.-enclosedPackages msym) pack)))

  (method ^:private addRootPackageFor ^void [this ^Symbol$ModuleSymbol module]
    (.doEnterPackage this module rootPackage)
    (let [^Symbol$PackageSymbol unnamedPackage (anon Symbol$PackageSymbol [(.-empty names)
                                                                           rootPackage]
                                                 (method ^:public toString ^String [this]
                                                   (.getLocalizedString
                                                     messages
                                                     "compiler.misc.unnamed.package"
                                                     (new Object/1 []))))]
      (set! (.-modle unnamedPackage) module)
      (set! (.-completer unnamedPackage)
            (lambda Symbol$Completer ^void [^Symbol s] (.complete initialCompleter s)))
      (set! (.-flags_field unnamedPackage) (bit-or (.-flags_field unnamedPackage) Flags/EXISTS))
      (set! (.-unnamedPackage module) unnamedPackage)))

  (method ^:public getPackage ^Symbol$PackageSymbol [this ^Symbol$ModuleSymbol module ^Name fullname]
    (cast Symbol$PackageSymbol
          (.get (cast Map (.getOrDefault packages fullname (Collections/emptyMap))) module)))

  (method ^:public enterModule ^Symbol$ModuleSymbol [this ^Name name]
    (let [^:mutable msym (cast Symbol$ModuleSymbol (.get modules name))]
      (when (nil? msym)
        (set! msym (Symbol$ModuleSymbol/create name (.-module_info names)))
        (.addRootPackageFor this msym)
        (set! (.-completer msym)
              (lambda Symbol$Completer ^void [^Symbol s] (.complete moduleCompleter s)))
        (.put modules name msym))
      msym))

  (method ^:public getModule ^Symbol$ModuleSymbol [this ^Name name]
    (cast Symbol$ModuleSymbol (.get modules name)))

  (method ^:public inferModule ^Symbol$ModuleSymbol [this ^Name packageName]
    (if (.isEmpty packageName)
        (if (identical? java_base noModule) noModule unnamedModule)
        (let [^:mutable ^Symbol$ModuleSymbol msym nil
              ^{:tag (Map Symbol$ModuleSymbol Symbol$PackageSymbol)} map (cast
                                                                           Map
                                                                           (.get
                                                                             packages
                                                                             packageName))]
          (when (some? map)
            (for-each [^{:tag (Map$Entry Symbol$ModuleSymbol Symbol$PackageSymbol)} e (.entrySet
                                                                                        map)]
              (when-not (.isEmpty (.members (cast Symbol$PackageSymbol (.getValue e))))
                (if (nil? msym) (set! msym (cast Symbol$ModuleSymbol (.getKey e))) (return nil))))
            msym))))

  (method ^:public listPackageModules ^{:tag (List Symbol$ModuleSymbol)} [this ^Name packageName]
    (if (.isEmpty packageName)
        (List/nil)
        (let [^:mutable ^{:tag (List Symbol$ModuleSymbol)} result (List/nil)
              ^{:tag (Map Symbol$ModuleSymbol Symbol$PackageSymbol)} map (cast
                                                                           Map
                                                                           (.get
                                                                             packages
                                                                             packageName))]
          (when (some? map)
            (for-each [^{:tag (Map$Entry Symbol$ModuleSymbol Symbol$PackageSymbol)} e (.entrySet
                                                                                        map)]
              (when-not (.isEmpty (.members (cast Symbol$PackageSymbol (.getValue e))))
                (set! result (.prepend result (cast Symbol$ModuleSymbol (.getKey e)))))))
          result)))

  (method ^:public getAllModules ^{:tag (Collection Symbol$ModuleSymbol)} [this]
    (.values modules))

  (method ^:public getClassesForName ^{:tag (Iterable Symbol$ClassSymbol)} [this ^Name candidate]
    (.values (cast Map (.getOrDefault classes candidate (Collections/emptyMap)))))

  (method ^:public getPackagesForName ^{:tag (Iterable Symbol$PackageSymbol)} [this ^Name candidate]
    (.values (cast Map (.getOrDefault packages candidate (Collections/emptyMap))))))

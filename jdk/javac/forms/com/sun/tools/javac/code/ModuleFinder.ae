  (method ^:private scanModulePath ^{:tag (List Symbol$ModuleSymbol)} [this
                                                                       ^Symbol$ModuleSymbol toFind]
    (let [^{:tag (ListBuffer Symbol$ModuleSymbol)} results (ListBuffer.)
          ^{:tag (Map Name JavaFileManager$Location)} namesInSet (HashMap.)
          multiModuleMode (.hasLocation fileManager StandardLocation/MODULE_SOURCE_PATH)]
      (while (.hasNext moduleLocationIterator)
        (let [^{:tag (Set JavaFileManager$Location)} locns (.next moduleLocationIterator)]
          (.clear namesInSet)

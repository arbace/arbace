                                       (method doLookup ^{:tag (Iterable Symbol)} [this
                                                                                   ^Symbol$TypeSymbol tsym]
                                         (.getSymbolsByName (.members tsym) name sf lookupKind)))
                  ^{:tag (List (Iterable Symbol))} results (.importFrom
                                                             si
                                                             (cast
                                                               Symbol$TypeSymbol
                                                               (.-owner origin))
                                                             (List/nil))]
              (lambda Iterable ^Iterator []
                (Iterators/createFilterIterator
                  (Iterators/createCompoundIterator
                    results
                    (method-ref Function ^Iterator [Iterable] Iterable/.iterator))
                  (lambda Predicate ^boolean [^Symbol s] (.accepts filter origin s)))))
            (catch Symbol$CompletionFailure cf (.accept cfHandler imp cf) (Collections/emptyList)))))

    (method ^:public getOrigin ^Scope [this ^Symbol byName] origin)

    (method ^:public isStaticallyImported ^boolean [this ^Symbol byName]
      (.isStaticallyImported this))

    (method ^:public isStaticallyImported ^boolean [this]
      (.-staticImport imp))

    (defclass ^:abstract SymbolImporter
      (field ^{:tag (Set Symbol)} processed (HashSet.))

      (field ^{:tag (List (Iterable Symbol))} delegates (List/nil))

      (field ^:final ^boolean inspectSuperTypes)

      (constructor ^:public [this ^boolean inspectSuperTypes]
        (set! (.-inspectSuperTypes this) inspectSuperTypes))

      (method importFrom ^{:tag (List (Iterable Symbol))} [this ^Symbol$TypeSymbol tsym
                                                           ^:mutable ^{:tag (List (Iterable Symbol))} results]
        (if (or (nil? tsym) (not (.add processed tsym)))
            results
            (do
              (when inspectSuperTypes
                (set! results (.importFrom this (.-tsym (.supertype types (.-type tsym))) results))
                (for-each [^Type t (.interfaces types (.-type tsym))]
                  (set! results (.importFrom this (.-tsym t) results))))
              (.prepend results (.doLookup this tsym)))))

      (method ^:abstract doLookup ^{:tag (Iterable Symbol)} [this ^Symbol$TypeSymbol tsym])))

  (defclass ^:public ^:static CompoundScope
    :extends Scope
    :implements [ScopeListener]

    (field ^{:tag (ListBuffer Scope)} subScopes (ListBuffer.))

    (field ^:private ^int mark 0)

    (constructor ^:public [this ^Symbol owner] (super. owner))

    (method ^:public prependSubScope ^void [this ^Scope that]
      (when (some? that)
        (.prepend subScopes that)
        (.add (.-listeners that) this)
        (set! mark (unchecked-inc-int mark))
        (.symbolAdded (.-listeners this) nil this)))

    (method ^:public appendSubScope ^void [this ^Scope that]
      (when (some? that)
        (.append subScopes that)
        (.add (.-listeners that) this)
        (set! mark (unchecked-inc-int mark))
        (.symbolAdded (.-listeners this) nil this)))

    (method ^:public symbolAdded ^void [this ^Symbol sym ^Scope s]
      (set! mark (unchecked-inc-int mark))
      (.symbolAdded (.-listeners this) sym s))

    (method ^:public symbolRemoved ^void [this ^Symbol sym ^Scope s]
      (set! mark (unchecked-inc-int mark))
      (.symbolRemoved (.-listeners this) sym s))

    (method ^:public getMark ^int [this] mark)

    (method ^:public toString ^String [this]
      (let [buf (StringBuilder.)]
        (.append buf "CompoundScope{")
        (let [^:mutable sep ""]
          (for-each [^Scope s subScopes] (.append buf sep) (.append buf s) (set! sep ","))
          (.append buf "}")
          (.toString buf))))

    (method ^:public getSymbols ^{:tag (Iterable Symbol)} [this
                                                           ^:final ^{:tag (Predicate Symbol)} sf
                                                           ^:final ^LookupKind lookupKind]
      (lambda Iterable ^Iterator []
        (Iterators/createCompoundIterator subScopes
                                          (lambda Function ^Iterator [^Scope scope]
                                            (.iterator (.getSymbols scope sf lookupKind))))))

    (method ^:public getSymbolsByName ^{:tag (Iterable Symbol)} [this ^:final ^Name name
                                                                 ^:final ^{:tag (Predicate Symbol)} sf
                                                                 ^:final ^LookupKind lookupKind]
      (lambda Iterable ^Iterator []
        (Iterators/createCompoundIterator
          subScopes
          (lambda Function ^Iterator [^Scope scope]
            (.iterator (.getSymbolsByName scope name sf lookupKind))))))

    (method ^:public getOrigin ^Scope [this ^Symbol sym]
      (for-each [^Scope delegate subScopes]
        (when (.includes delegate sym) (return (.getOrigin delegate sym))))
      nil)

    (method ^:public isStaticallyImported ^boolean [this ^Symbol sym]
      (for-each [^Scope delegate subScopes]
        (when (.includes delegate sym) (return (.isStaticallyImported delegate sym))))
      false))

  (defclass ^:public ^:static ErrorScope
    :extends ScopeImpl

    (constructor [this ^ScopeImpl next ^Symbol errSymbol ^Entry/1 table]
      (super. next errSymbol table))

    (constructor ^:public [this ^Symbol errSymbol] (super. errSymbol))

    (method ^:public dup ^WriteableScope [this ^Symbol newOwner]
      (ErrorScope. this newOwner (.-table this)))

    (method ^:public dupUnshared ^WriteableScope [this ^Symbol newOwner]
      (ErrorScope. this newOwner ^Entry/1 (.clone (.-table this))))

    (method ^:public lookup ^Entry [this ^Name name]
      (let [e (.lookup super name)] (if (nil? (.-scope e)) (Entry. (.-owner this) nil nil nil) e)))))

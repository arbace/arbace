                  (TypeAnnotationPosition/methodThrows
                    (.toList location)
                    currentLambda
                    type_index
                    (.-pos frame)))
              (identical? (.-restype frameMethod) tree)
                (TypeAnnotationPosition/methodReturn (.toList location) currentLambda (.-pos frame))
              (.contains (.-typarams frameMethod) tree)

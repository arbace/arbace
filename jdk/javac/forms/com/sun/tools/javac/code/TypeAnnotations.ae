        (identical? (.-name (.-value e)) (.-METHOD names))
          (when (and (identical? (.-kind s) Kinds$Kind/MTH) (not (.isConstructor s)))
            (return AnnotationType/DECLARATION))
        (identical? (.-name (.-value e)) (.-PARAMETER names))

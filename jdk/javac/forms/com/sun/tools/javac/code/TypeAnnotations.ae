                  (if (.contains (.-implementing frameClassDecl) tree)
                      (let [type_index (.indexOf (.-implementing frameClassDecl) tree)]
                        (TypeAnnotationPosition/classExtends
                          (.toList location)
                          currentLambda
                          type_index
                          (.-pos frame)))
                      (TypeAnnotationPosition/classExtends
                        (.toList location)
                        currentLambda
                        (.-pos frame))))
              (.contains (.-typeargs frameNewClass) tree)
                (let [type_index (.indexOf (.-typeargs frameNewClass) tree)]
                  (TypeAnnotationPosition/constructorInvocationTypeArg
                    (.toList location)
                    currentLambda
                    type_index
                    (.-pos frame)))
              :else (TypeAnnotationPosition/newObj (.toList location) currentLambda (.-pos frame))))
        NEW_ARRAY (TypeAnnotationPosition/newObj (.toList location) currentLambda (.-pos frame))
        (ANNOTATION_TYPE CLASS ENUM INTERFACE RECORD)
          (cond
            (identical? (.-extending (cast JCTree$JCClassDecl frame)) tree)
              (TypeAnnotationPosition/classExtends (.toList location) currentLambda (.-pos frame))
            (.contains (.-implementing (cast JCTree$JCClassDecl frame)) tree)
              (let [type_index (.indexOf (.-implementing (cast JCTree$JCClassDecl frame)) tree)]
                (TypeAnnotationPosition/classExtends
                  (.toList location)
                  currentLambda
                  type_index
                  (.-pos frame)))
            (.contains (.-typarams (cast JCTree$JCClassDecl frame)) tree)
              (let [parameter_index (.indexOf (.-typarams (cast JCTree$JCClassDecl frame)) tree)]
                (TypeAnnotationPosition/typeParameter
                  (.toList location)
                  currentLambda
                  parameter_index
                  (.-pos frame)))
            :else
              (throw (AssertionError.
                       (java-str "Could not determine position of tree "
                                 tree
                                 " within frame "
                                 frame))))
        METHOD

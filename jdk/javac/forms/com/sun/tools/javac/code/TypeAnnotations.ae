                  (TypeAnnotationPosition/methodTypeParameter
                    (.toList location)
                    currentLambda
                    parameter_index
                    (.-pos frame)))
              :else
                (throw (AssertionError.
                         (java-str "Could not determine position of tree "
                                   tree
                                   " within frame "
                                   frame)))))
        PARAMETERIZED_TYPE
          (let [^{:tag (List JCTree)} newPath (.-tail path)]
            (when-not (identical? (.-clazz (cast JCTree$JCTypeApply frame)) tree)
              (if (.contains (.-arguments (cast JCTree$JCTypeApply frame)) tree)
                  (let [taframe (cast JCTree$JCTypeApply frame)
                        arg (.indexOf (.-arguments taframe) tree)]
                    (set! location
                          (.prepend location
                                    (TypeAnnotationPosition$TypePathEntry.
                                      TypeAnnotationPosition$TypePathEntryKind/TYPE_ARGUMENT
                                      arg)))
                    (let [^Type typeToUse (if (and
                                                (some? (.-tail newPath))
                                                (.hasTag
                                                  (cast JCTree (.-head (.-tail newPath)))
                                                  JCTree$Tag/NEWCLASS))
                                              (.-type (cast JCTree (.-head (.-tail newPath))))
                                              (.-type taframe))]
                      (set! location (.locateNestedTypes this typeToUse location))))
                  (throw (AssertionError.
                           (java-str "Could not determine type argument position of tree "
                                     tree
                                     " within frame "
                                     frame)))))
            (.resolveFrame this
                           (cast JCTree (.-head newPath))
                           (cast JCTree (.-head (.-tail newPath)))
                           newPath
                           currentLambda
                           outer_type_index
                           location))
        MEMBER_REFERENCE
          (let [mrframe (cast JCTree$JCMemberReference frame)]
            (cond
              (identical? (.-expr mrframe) tree)
                (switch (.-mode mrframe)
                  INVOKE
                    (TypeAnnotationPosition/methodRef
                      (.toList location)
                      currentLambda
                      (.-pos frame))
                  NEW
                    (TypeAnnotationPosition/constructorRef
                      (.toList location)
                      currentLambda
                      (.-pos frame))
                  (throw (AssertionError.
                           (java-str "Unknown method reference mode "
                                     (.-mode mrframe)
                                     " for tree "
                                     tree
                                     " within frame "
                                     frame))))
              (and (some? (.-typeargs mrframe)) (.contains (.-typeargs mrframe) tree))
                (let [type_index (.indexOf (.-typeargs mrframe) tree)]
                  (switch (.-mode mrframe)
                    INVOKE
                      (TypeAnnotationPosition/methodRefTypeArg
                        (.toList location)
                        currentLambda
                        type_index
                        (.-pos frame))
                    NEW
                      (TypeAnnotationPosition/constructorRefTypeArg
                        (.toList location)
                        currentLambda
                        type_index
                        (.-pos frame))
                    (throw (AssertionError.
                             (java-str "Unknown method reference mode "
                                       (.-mode mrframe)
                                       " for tree "
                                       tree
                                       " within frame "
                                       frame)))))
              :else
                (throw (AssertionError.
                         (java-str "Could not determine type argument position of tree "
                                   tree
                                   " within frame "
                                   frame)))))
        ARRAY_TYPE
          (do
            (set! location (.prepend location TypeAnnotationPosition$TypePathEntry/ARRAY))
            (let [^:mutable ^{:tag (List JCTree)} newPath (.-tail path)]
              (while true
                (let [npHead (cast JCTree (.-head (.-tail newPath)))]
                  (cond
                    (.hasTag npHead JCTree$Tag/TYPEARRAY)
                      (do
                        (set! newPath (.-tail newPath))
                        (set! location
                              (.prepend location TypeAnnotationPosition$TypePathEntry/ARRAY)))
                    (.hasTag npHead JCTree$Tag/ANNOTATED_TYPE) (set! newPath (.-tail newPath))
                    :else (break))))
              (.resolveFrame this
                             (cast JCTree (.-head newPath))
                             (cast JCTree (.-head (.-tail newPath)))
                             newPath
                             currentLambda
                             outer_type_index
                             location)))
        TYPE_PARAMETER
          (cond
            (.hasTag (cast JCTree (.-head (.-tail (.-tail path)))) JCTree$Tag/CLASSDEF)
              (let [clazz (cast JCTree$JCClassDecl (.-head (.-tail (.-tail path))))
                    parameter_index (.indexOf (.-typarams clazz) (.-head (.-tail path)))
                    ^int bound_index (if (.isInterface
                                           (.-type
                                             (cast
                                               JCTree$JCExpression
                                               (.get
                                                 (.-bounds (cast JCTree$JCTypeParameter frame))
                                                 0))))
                                         (unchecked-add-int
                                           (.indexOf
                                             (.-bounds (cast JCTree$JCTypeParameter frame))
                                             tree)
                                           1)
                                         (.indexOf
                                           (.-bounds (cast JCTree$JCTypeParameter frame))
                                           tree))]
                (TypeAnnotationPosition/typeParameterBound
                  (.toList location)
                  currentLambda
                  parameter_index
                  bound_index
                  (.-pos frame)))
            (.hasTag (cast JCTree (.-head (.-tail (.-tail path)))) JCTree$Tag/METHODDEF)
              (let [method (cast JCTree$JCMethodDecl (.-head (.-tail (.-tail path))))
                    parameter_index (.indexOf (.-typarams method) (.-head (.-tail path)))
                    ^int bound_index (if (.isInterface
                                           (.-type
                                             (cast
                                               JCTree$JCExpression
                                               (.get
                                                 (.-bounds (cast JCTree$JCTypeParameter frame))
                                                 0))))
                                         (unchecked-add-int
                                           (.indexOf
                                             (.-bounds (cast JCTree$JCTypeParameter frame))
                                             tree)
                                           1)
                                         (.indexOf
                                           (.-bounds (cast JCTree$JCTypeParameter frame))
                                           tree))]
                (TypeAnnotationPosition/methodTypeParameterBound
                  (.toList location)
                  currentLambda
                  parameter_index
                  bound_index
                  (.-pos frame)))
            :else
              (throw (AssertionError.
                       (java-str "Could not determine position of tree "
                                 tree
                                 " within frame "
                                 frame))))
        VARIABLE
          (let [v (.-sym (cast JCTree$JCVariableDecl frame))]
            (when-not (identical? (.getKind v) ElementKind/FIELD)
              (.appendTypeAnnotationsToOwner this v (.getRawTypeAttributes v)))
            (switch (.getKind v)
              (BINDING_VARIABLE LOCAL_VARIABLE)
                (TypeAnnotationPosition/localVariable
                  (.toList location)
                  currentLambda
                  (.-pos frame))
              FIELD (TypeAnnotationPosition/field (.toList location) currentLambda (.-pos frame))
              PARAMETER
                (if (.equals (.getQualifiedName v) (.-_this names))
                    (TypeAnnotationPosition/methodReceiver
                      (.toList location)
                      currentLambda
                      (.-pos frame))
                    (let [parameter_index (.methodParamIndex this path frame)]
                      (TypeAnnotationPosition/methodParameter
                        (.toList location)
                        currentLambda
                        parameter_index
                        (.-pos frame))))
              EXCEPTION_PARAMETER
                (TypeAnnotationPosition/exceptionParameter
                  (.toList location)
                  currentLambda
                  (.-pos frame))
              RESOURCE_VARIABLE
                (TypeAnnotationPosition/resourceVariable
                  (.toList location)
                  currentLambda
                  (.-pos frame))
              (throw (AssertionError.
                       (java-str "Found unexpected type annotation for variable: "
                                 v
                                 " with kind: "
                                 (.getKind v))))))
        ANNOTATED_TYPE
          (do
            (when (identical? frame tree)
              (let [atypetree (cast JCTree$JCAnnotatedType frame)
                    utype (.-type (.-underlyingType atypetree))]
                (Assert/checkNonNull utype)
                (let [^Symbol tsym (.-tsym utype)]
                  (when-not (or (or (.equals (.getKind tsym) ElementKind/TYPE_PARAMETER)
                                    (.equals (.getKind utype) TypeKind/WILDCARD))
                                (.equals (.getKind utype) TypeKind/ARRAY))
                    (set! location (.locateNestedTypes this utype location))))))
            (let [^{:tag (List JCTree)} newPath (.-tail path)]
              (.resolveFrame this
                             (cast JCTree (.-head newPath))
                             (cast JCTree (.-head (.-tail newPath)))
                             newPath
                             currentLambda
                             outer_type_index
                             location)))
        UNION_TYPE
          (let [^{:tag (List JCTree)} newPath (.-tail path)]
            (.resolveFrame this
                           (cast JCTree (.-head newPath))
                           (cast JCTree (.-head (.-tail newPath)))
                           newPath
                           currentLambda
                           outer_type_index
                           location))
        INTERSECTION_TYPE
          (let [isect (cast JCTree$JCTypeIntersection frame)
                ^{:tag (List JCTree)} newPath (.-tail path)]
            (.resolveFrame this
                           (cast JCTree (.-head newPath))
                           (cast JCTree (.-head (.-tail newPath)))
                           newPath
                           currentLambda
                           (.indexOf (.-bounds isect) tree)
                           location))
        METHOD_INVOCATION
          (let [invocation (cast JCTree$JCMethodInvocation frame)]
            (if (not (.contains (.-typeargs invocation) tree))
                TypeAnnotationPosition/unknown
                (let [exsym (TreeInfo/symbol (.getMethodSelect invocation))]
                  (if (.isErroneous (.-type exsym))
                      TypeAnnotationPosition/unknown
                      (let [type_index (.indexOf (.-typeargs invocation) tree)]
                        (cond
                          (nil? exsym)
                            (throw (AssertionError.
                                     (java-str "could not determine symbol for {" invocation "}")))
                          (.isConstructor exsym)
                            (TypeAnnotationPosition/constructorInvocationTypeArg
                              (.toList location)
                              currentLambda
                              type_index
                              (.-pos invocation))
                          :else
                            (TypeAnnotationPosition/methodInvocationTypeArg
                              (.toList location)
                              currentLambda
                              type_index
                              (.-pos invocation))))))))
        (EXTENDS_WILDCARD SUPER_WILDCARD)
          (let [^{:tag (List JCTree)} newPath (.-tail path)]
            (.resolveFrame this
                           (cast JCTree (.-head newPath))
                           (cast JCTree (.-head (.-tail newPath)))
                           newPath
                           currentLambda
                           outer_type_index
                           (.prepend location TypeAnnotationPosition$TypePathEntry/WILDCARD)))
        MEMBER_SELECT
          (let [^{:tag (List JCTree)} newPath (.-tail path)]
            (.resolveFrame this
                           (cast JCTree (.-head newPath))
                           (cast JCTree (.-head (.-tail newPath)))
                           newPath
                           currentLambda
                           outer_type_index
                           location))
        DECONSTRUCTION_PATTERN TypeAnnotationPosition/unknown
        (throw (AssertionError.
                 (java-str "Unresolved frame: "
                           frame
                           " of kind: "
                           (.getKind frame)
                           "\n    Looking for tree: "
                           tree)))))

    (method ^:private locateNestedTypes ^{:tag (ListBuffer TypeAnnotationPosition$TypePathEntry)} [this
                                                                                                   ^Type type
                                                                                                   ^:mutable ^{:tag (ListBuffer TypeAnnotationPosition$TypePathEntry)} depth]
      (let [^:mutable encl (.getEnclosingType type)]
        (while (and (and (some? encl) (not (identical? (.getKind encl) TypeKind/NONE)))
                    (not (identical? (.getKind encl) TypeKind/ERROR)))
          (set! depth (.prepend depth TypeAnnotationPosition$TypePathEntry/INNER_TYPE))
          (set! encl (.getEnclosingType encl)))
        depth))

    (method ^:private methodParamIndex ^int [this ^{:tag (List JCTree)} path ^JCTree param]
      (let [^:mutable ^{:tag (List JCTree)} curr path]
        (while (and (not (identical? (.getTag (cast JCTree (.-head curr))) JCTree$Tag/METHODDEF))
                    (not (identical? (.getTag (cast JCTree (.-head curr))) JCTree$Tag/LAMBDA)))
          (set! curr (.-tail curr)))
        (cond
          (identical? (.getTag (cast JCTree (.-head curr))) JCTree$Tag/METHODDEF)
            (let [method (cast JCTree$JCMethodDecl (.-head curr))]
              (.indexOf (.-params method) param))
          (identical? (.getTag (cast JCTree (.-head curr))) JCTree$Tag/LAMBDA)
            (let [lambda (cast JCTree$JCLambda (.-head curr))] (.indexOf (.-params lambda) param))
          :else
            (do
              (Assert/error (java-str
                              "methodParamIndex expected to find method or lambda for param: "
                              param))
              -1))))

    (field ^:private ^boolean isInClass false)

    (method ^:public visitClassDef ^void [this ^JCTree$JCClassDecl tree]
      (when-not isInClass
        (set! isInClass true)
        (when sigOnly
          (.scan this (.-mods tree))
          (.scan this (.-typarams tree))
          (.scan this (.-extending tree))
          (.scan this (.-implementing tree)))
        (.scan this (.-defs tree))
        (when (.isRecord (.-sym tree))
          (.forEach (.getRecordComponents (.-sym tree))
                    (lambda Consumer ^void [^Symbol$RecordComponent rc]
                      (.scan this (.-accessorMeth rc)))))))

    (method ^:public visitMethodDef ^void [this ^:final ^JCTree$JCMethodDecl tree]
      (when (nil? (.-sym tree)) (Assert/error "Visiting tree node before memberEnter"))
      (when sigOnly
        (when-not (.isEmpty (.-annotations (.-mods tree)))
          (if (.isConstructor (.-sym tree))
              (let [pos (TypeAnnotationPosition/methodReturn (.-pos tree))]
                (.separateAnnotationsKinds this tree tree nil (.-sym tree) pos))
              (let [pos (TypeAnnotationPosition/methodReturn (.-pos (.-restype tree)))]
                (.separateAnnotationsKinds this
                                           tree
                                           (.-restype tree)
                                           (.getReturnType (.-type (.-sym tree)))
                                           (.-sym tree)
                                           pos))))
        (when (and (and (some? (.-recvparam tree)) (some? (.-sym (.-recvparam tree))))
                   (not (.isEmpty (.-annotations (.-mods (.-recvparam tree))))))
          (let [pos (TypeAnnotationPosition/methodReceiver (.-pos (.-vartype (.-recvparam tree))))]
            (.push this (.-recvparam tree))
            (try
              (.separateAnnotationsKinds this
                                         tree
                                         (.-vartype (.-recvparam tree))
                                         (.-type (.-sym (.-recvparam tree)))
                                         (.-sym (.-recvparam tree))
                                         pos)
              (finally (.pop this)))))
        (let [^:mutable ^int i 0]
          (for-each [^JCTree$JCVariableDecl param (.-params tree)]
            (when-not (.isEmpty (.-annotations (.-mods param)))
              (let [pos (TypeAnnotationPosition/methodParameter i (.-pos (.-vartype param)))]
                (.push this param)
                (try
                  (.separateAnnotationsKinds this
                                             param
                                             (.-vartype param)
                                             (.-type (.-sym param))
                                             (.-sym param)
                                             pos)
                  (finally (.pop this)))))
            (set! i (unchecked-inc-int i)))))
      (if sigOnly
          (do
            (.scan this (.-mods tree))
            (.scan this (.-restype tree))
            (.scan this (.-typarams tree))
            (.scan this (.-recvparam tree))
            (.scan this (.-params tree))
            (.scan this (.-thrown tree)))
          (do (.scan this (.-defaultValue tree)) (.scan this (.-body tree)))))

    (field ^:private ^JCTree$JCLambda currentLambda nil)

    (method ^:public visitLambda ^void [this ^JCTree$JCLambda tree]
      (let [prevLambda currentLambda]
        (try
          (set! currentLambda tree)
          (let [^:mutable ^int i 0]
            (for-each [^JCTree$JCVariableDecl param (.-params tree)]
              (when-not (.isEmpty (.-annotations (.-mods param)))
                (let [pos (TypeAnnotationPosition/methodParameter tree i (.-pos (.-vartype param)))]
                  (.push this param)
                  (try
                    (when-not (.declaredUsingVar param)
                      (.separateAnnotationsKinds
                        this
                        param
                        (.-vartype param)
                        (.-type (.-sym param))
                        (.-sym param)
                        pos))
                    (finally (.pop this)))))
              (set! i (unchecked-inc-int i)))
            (.scan this (.-body tree))
            (.scan this (.-params tree)))
          (finally (set! currentLambda prevLambda)))))

    (method ^:public visitVarDef ^void [this ^:final ^JCTree$JCVariableDecl tree]
      (when-not (.isEmpty (.-annotations (.-mods tree)))
        (if (nil? (.-sym tree))
            (Assert/error "Visiting tree node before memberEnter")
            (when-not (identical? (.getKind (.-sym tree)) ElementKind/PARAMETER)
              (cond
                (identical? (.getKind (.-sym tree)) ElementKind/FIELD)
                  (when sigOnly
                    (let [pos (TypeAnnotationPosition/field (.-pos tree))]
                      (.separateAnnotationsKinds
                        this
                        tree
                        (.-vartype tree)
                        (.-type (.-sym tree))
                        (.-sym tree)
                        pos)))
                (identical? (.getKind (.-sym tree)) ElementKind/LOCAL_VARIABLE)
                  (let [pos (TypeAnnotationPosition/localVariable currentLambda (.-pos tree))]
                    (when-not (.declaredUsingVar tree)
                      (.separateAnnotationsKinds
                        this
                        tree
                        (.-vartype tree)
                        (.-type (.-sym tree))
                        (.-sym tree)
                        pos)))
                (identical? (.getKind (.-sym tree)) ElementKind/BINDING_VARIABLE)
                  (let [pos (TypeAnnotationPosition/localVariable currentLambda (.-pos tree))]
                    (.separateAnnotationsKinds this
                                               tree
                                               (.-vartype tree)
                                               (.-type (.-sym tree))
                                               (.-sym tree)
                                               pos))
                (identical? (.getKind (.-sym tree)) ElementKind/EXCEPTION_PARAMETER)
                  (let [pos (TypeAnnotationPosition/exceptionParameter currentLambda (.-pos tree))]
                    (.separateAnnotationsKinds this
                                               tree
                                               (.-vartype tree)
                                               (.-type (.-sym tree))
                                               (.-sym tree)
                                               pos))
                (identical? (.getKind (.-sym tree)) ElementKind/RESOURCE_VARIABLE)
                  (let [pos (TypeAnnotationPosition/resourceVariable currentLambda (.-pos tree))]
                    (.separateAnnotationsKinds this
                                               tree
                                               (.-vartype tree)
                                               (.-type (.-sym tree))
                                               (.-sym tree)
                                               pos))
                :else
                  (when-not (identical? (.getKind (.-sym tree)) ElementKind/ENUM_CONSTANT)
                    (Assert/error (java-str "Unhandled variable kind: " (.getKind (.-sym tree)))))))))
      (.scan this (.-mods tree))
      (.scan this (.-vartype tree))
      (when-not sigOnly (.scan this (.-init tree)))
      (when sigOnly
        (when (and (and (some? (.-sym tree)) (identical? (.getKind (.-sym tree)) ElementKind/FIELD))
                   (not (== (bit-and (.-flags_field (.-sym tree)) Flags/RECORD) 0)))
          (let [rc (.getRecordComponent (cast Symbol$ClassSymbol (.-owner (.-sym tree)))
                                        (.-sym tree))]
            (.setTypeAttributes rc (.getRawTypeAttributes (.-sym tree)))
            (set! (.-type rc) (.-type (.-sym tree)))))))

    (method ^:public visitBlock ^void [this ^JCTree$JCBlock tree]
      (when-not sigOnly (.scan this (.-stats tree))))

    (method ^:public visitAnnotatedType ^void [this ^JCTree$JCAnnotatedType tree]
      (.push this tree)
      (.findPosition this tree tree (.-annotations tree))
      (.pop this)
      (.visitAnnotatedType super tree))

    (method ^:public visitTypeParameter ^void [this ^JCTree$JCTypeParameter tree]
      (.findPosition this tree (.peek2 this) (.-annotations tree))
      (.visitTypeParameter super tree))

    (method ^:private propagateNewClassAnnotationsToOwner ^void [this ^JCTree$JCNewClass tree]
      (let [^Symbol sym (.-sym (.-def tree))
            ^{:tag (List TypeAnnotationPosition$TypePathEntry)} depth (.toList
                                                                        (.append
                                                                          (.locateNestedTypes
                                                                            this
                                                                            (.-type
                                                                              (.enclClass
                                                                                (.-owner sym)))
                                                                            (ListBuffer.))
                                                                          TypeAnnotationPosition$TypePathEntry/INNER_TYPE))
            pos (TypeAnnotationPosition/newObj depth nil (.-pos tree))
            ^{:tag (ListBuffer Attribute$TypeCompound)} newattrs (ListBuffer.)
            ^{:tag (List TypeAnnotationPosition$TypePathEntry)} expectedLocation (.toList
                                                                                   (.locateNestedTypes
                                                                                     this
                                                                                     (.-type
                                                                                       (.-clazz
                                                                                         tree))
                                                                                     (ListBuffer.)))]
        (for-each [^Attribute$TypeCompound old (.getRawTypeAttributes sym)]
          (when (.equals (.-location (.-position old)) expectedLocation)
            (.append newattrs (Attribute$TypeCompound. (.-type old) (.-values old) pos))))
        (.appendTypeAnnotationsToOwner this sym (.toList newattrs))))

    (method ^:public visitNewClass ^void [this ^JCTree$JCNewClass tree]
      (when (and (some? (.-def tree)) (some? (.-sym (.-def tree))))
        (.propagateNewClassAnnotationsToOwner this tree))
      (.scan this (.-encl tree))
      (.scan this (.-typeargs tree))
      (when (nil? (.-def tree)) (.scan this (.-clazz tree)))
      (.scan this (.-args tree)))

    (method ^:public visitNewArray ^void [this ^JCTree$JCNewArray tree]
      (.findPosition this tree tree (.-annotations tree))
      (let [dimAnnosCount (.size (.-dimAnnotations tree))
            ^:mutable ^{:tag (ListBuffer TypeAnnotationPosition$TypePathEntry)} depth (ListBuffer.)]
        (loop [^int i 0]
          (when (< i dimAnnosCount)
            (let [^:mutable ^{:tag (ListBuffer TypeAnnotationPosition$TypePathEntry)} location
                    (ListBuffer.)]
              (when-not (== i 0)
                (set! depth (.append depth TypeAnnotationPosition$TypePathEntry/ARRAY))
                (set! location (.appendList location (.toList depth))))
              (let [p (TypeAnnotationPosition/newObj (.toList location) currentLambda (.-pos tree))]
                (.setTypeAnnotationPos this (cast List (.get (.-dimAnnotations tree) i)) p)
                (recur (unchecked-inc-int i))))))
        (let [^:mutable elemType (.-elemtype tree)]
          (set! depth (.append depth TypeAnnotationPosition$TypePathEntry/ARRAY))
          (while (some? elemType)
            (cond
              (.hasTag elemType JCTree$Tag/ANNOTATED_TYPE)
                (let [at (cast JCTree$JCAnnotatedType elemType)
                      ^{:tag (ListBuffer TypeAnnotationPosition$TypePathEntry)} locationbuf
                        (.locateNestedTypes this (.-type elemType) (ListBuffer.))
                      ^{:tag (List TypeAnnotationPosition$TypePathEntry)} location (.prependList
                                                                                     (.toList
                                                                                       locationbuf)
                                                                                     (.toList depth))
                      p (TypeAnnotationPosition/newObj location currentLambda (.-pos tree))]
                  (.setTypeAnnotationPos this (.-annotations at) p)
                  (set! elemType (.-underlyingType at)))
              (.hasTag elemType JCTree$Tag/TYPEARRAY)
                (do
                  (set! depth (.append depth TypeAnnotationPosition$TypePathEntry/ARRAY))
                  (set! elemType (.-elemtype (cast JCTree$JCArrayTypeTree elemType))))
              (.hasTag elemType JCTree$Tag/SELECT)
                (set! elemType (.-selected (cast JCTree$JCFieldAccess elemType)))
              :else (break)))
          (.scan this (.-elems tree)))))

    (method ^:private findPosition ^void [this ^JCTree tree ^JCTree frame
                                          ^{:tag (List JCTree$JCAnnotation)} annotations]
      (when-not (.isEmpty annotations)
        (let [p (.resolveFrame this tree frame frames currentLambda 0 (ListBuffer.))]
          (.setTypeAnnotationPos this annotations p))))

    (method ^:private setTypeAnnotationPos ^void [this
                                                  ^{:tag (List JCTree$JCAnnotation)} annotations
                                                  ^TypeAnnotationPosition position]
      (for-each [^JCTree$JCAnnotation anno annotations]
        (when (some? (.-attribute anno))
          (set! (.-position (cast Attribute$TypeCompound (.-attribute anno))) position))))

    (method ^:public toString ^String [this]
      (java-str (.toString super) ": sigOnly: " sigOnly))))

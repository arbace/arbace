                                                (.-package_info p)
                                                (cast
                                                  Symbol$ClassSymbol
                                                  (.findFirst (.-members_field p) classname)))]
        (cond
          (nil? c)
            (do
              (set! c (.enterClass syms (.-modle p) classname p))
              (when (nil? (.-classfile c)) (set! (.-classfile c) file))
              (cond
                isPkgInfo (set! (.-package_info p) c)
                (identical? (.-owner c) p) (.enter (.-members_field p) c)))
          (and (and (not preferCurrent) (some? (.-classfile c)))
               (== (bit-and (.-flags_field c) seen) 0))
            (when-not (== (bit-and (.-flags_field c)
                                   (bit-or-int Flags/CLASS_SEEN Flags/SOURCE_SEEN))
                          0)
              (set! (.-classfile c) (.preferredFileObject this file (.-classfile c)))))
        (set! (.-flags_field c) (bit-or (.-flags_field c) seen)))))

  (method ^:protected preferredFileObject ^JavaFileObject [this ^JavaFileObject a ^JavaFileObject b]
    (if preferSource
        (if (identical? (.getKind a) JavaFileObject$Kind/SOURCE) a b)
        (let [adate (.getLastModified a) bdate (.getLastModified b)] (if (> adate bdate) a b))))


  (method ^:private fillIn :throws [IOException] ^void [this ^Symbol$PackageSymbol p]
    (when (nil? (.-members_field p)) (set! (.-members_field p) (Scope$WriteableScope/create p)))
    (let [msym (.-modle p)]
      (Assert/checkNonNull msym (method-ref Supplier ^String [] p Symbol$PackageSymbol/.toString))
      (.complete msym)
      (cond
        (identical? msym (.-noModule syms))
          (do
            (set! preferCurrent false)
            (if userPathsFirst
                (do
                  (.scanUserPaths this p true)
                  (set! preferCurrent true)
                  (.scanPlatformPath this p))
                (do (.scanPlatformPath this p) (.scanUserPaths this p true))))
        (identical? (.-classLocation msym) StandardLocation/CLASS_PATH)
          (.scanUserPaths this p (identical? (.-sourceLocation msym) StandardLocation/SOURCE_PATH))
        :else (.scanModulePaths this p msym))))

  (method ^:private scanModulePaths :throws [IOException] ^void [this ^Symbol$PackageSymbol p
                                                                 ^Symbol$ModuleSymbol msym]
    (let [^{:tag (Set JavaFileObject$Kind)} kinds (.getPackageFileKinds this)
          ^{:tag (Set JavaFileObject$Kind)} classKinds (EnumSet/copyOf kinds)]
      (.remove classKinds JavaFileObject$Kind/SOURCE)
      (let [wantClassFiles (not (.isEmpty classKinds))
            ^{:tag (Set JavaFileObject$Kind)} sourceKinds (EnumSet/copyOf kinds)]
        (.remove sourceKinds JavaFileObject$Kind/CLASS)
        (let [wantSourceFiles (not (.isEmpty sourceKinds))
              packageName (.toString (.-fullname p))
              classLocn (.-classLocation msym)
              sourceLocn (.-sourceLocation msym)
              patchLocn (.-patchLocation msym)
              patchOutLocn (.-patchOutputLocation msym)
              prevPreferCurrent preferCurrent]
          (try
            (set! preferCurrent false)
            (when (and wantClassFiles (some? patchOutLocn))
              (.fillIn this p patchOutLocn (.list this patchOutLocn p packageName classKinds)))
            (when (and (or wantClassFiles wantSourceFiles) (some? patchLocn))
              (let [^{:tag (Set JavaFileObject$Kind)} combined (EnumSet/noneOf JavaFileObject$Kind)]
                (.addAll combined classKinds)
                (.addAll combined sourceKinds)
                (.fillIn this p patchLocn (.list this patchLocn p packageName combined))))
            (set! preferCurrent true)
            (when (and wantClassFiles (some? classLocn))
              (.fillIn this p classLocn (.list this classLocn p packageName classKinds)))
            (when (and wantSourceFiles (some? sourceLocn))
              (.fillIn this p sourceLocn (.list this sourceLocn p packageName sourceKinds)))
            (finally (set! preferCurrent prevPreferCurrent)))))))

  (method ^:private scanUserPaths :throws [IOException] ^void [this ^Symbol$PackageSymbol p
                                                               ^boolean includeSourcePath]
    (let [^{:tag (Set JavaFileObject$Kind)} kinds (.getPackageFileKinds this)
          ^{:tag (Set JavaFileObject$Kind)} classKinds (EnumSet/copyOf kinds)]
      (.remove classKinds JavaFileObject$Kind/SOURCE)
      (let [wantClassFiles (not (.isEmpty classKinds))
            ^{:tag (Set JavaFileObject$Kind)} sourceKinds (EnumSet/copyOf kinds)]
        (.remove sourceKinds JavaFileObject$Kind/CLASS)
        (let [wantSourceFiles (not (.isEmpty sourceKinds))
              haveSourcePath (and includeSourcePath
                                  (.hasLocation fileManager StandardLocation/SOURCE_PATH))]
          (when (and verbose verbosePath)
            (set! verbosePath false)
            (when-instance [^StandardJavaFileManager standardJavaFileManager fileManager]
              (cond
                (and haveSourcePath wantSourceFiles)
                  (let [^:mutable ^{:tag (List Path)} path (List/nil)]
                    (for-each [^Path sourcePath (.getLocationAsPaths
                                                  standardJavaFileManager
                                                  StandardLocation/SOURCE_PATH)]
                      (set! path (.prepend path sourcePath)))
                    (.printVerbose log "sourcepath" (.toString (.reverse path))))
                wantSourceFiles
                  (let [^:mutable ^{:tag (List Path)} path (List/nil)]
                    (for-each [^Path classPath (.getLocationAsPaths
                                                 standardJavaFileManager
                                                 StandardLocation/CLASS_PATH)]
                      (set! path (.prepend path classPath)))
                    (.printVerbose log "sourcepath" (.toString (.reverse path)))))
              (when wantClassFiles
                (let [^:mutable ^{:tag (List Path)} path (List/nil)]
                  (for-each [^Path platformPath (.getLocationAsPaths
                                                  standardJavaFileManager
                                                  StandardLocation/PLATFORM_CLASS_PATH)]
                    (set! path (.prepend path platformPath)))
                  (for-each [^Path classPath (.getLocationAsPaths
                                               standardJavaFileManager
                                               StandardLocation/CLASS_PATH)]
                    (set! path (.prepend path classPath)))
                  (.printVerbose log "classpath" (.toString (.reverse path)))))))
          (let [packageName (.toString (.-fullname p))]
            (if (and wantSourceFiles (not haveSourcePath))
                (.fillIn this
                         p
                         StandardLocation/CLASS_PATH
                         (.list this StandardLocation/CLASS_PATH p packageName kinds))
                (do
                  (when wantClassFiles
                    (.fillIn this
                             p
                             StandardLocation/CLASS_PATH
                             (.list this StandardLocation/CLASS_PATH p packageName classKinds)))
                  (when wantSourceFiles
                    (.fillIn this
                             p
                             StandardLocation/SOURCE_PATH
                             (.list this StandardLocation/SOURCE_PATH p packageName sourceKinds))))))))))

  (method ^:private scanPlatformPath :throws [IOException] ^void [this ^Symbol$PackageSymbol p]
    (.fillIn this
             p
             StandardLocation/PLATFORM_CLASS_PATH
             (.list this

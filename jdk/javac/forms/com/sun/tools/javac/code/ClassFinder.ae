                    (.toString (.-fullname p))
                    (EnumSet/of JavaFileObject$Kind/CLASS))))

  (method ^:private fillIn ^void [this ^Symbol$PackageSymbol p ^JavaFileManager$Location location
                                  ^{:tag (Iterable JavaFileObject)} files]
    (set! currentLoc location)
    (for-each [^JavaFileObject fo files]
      (switch (.getKind fo)
        OTHER (.extraFileActions this p fo)
        (CLASS SOURCE)
          (let [binaryName (.inferBinaryName fileManager currentLoc fo)
                simpleName (.substring binaryName
                                       (unchecked-add-int (.lastIndexOf binaryName ".") 1))]
            (when (or (SourceVersion/isIdentifier simpleName) (.equals simpleName "package-info"))
              (.includeClassFile this p fo)))
        (.extraFileActions this p fo))))

  (method list :throws [IOException] ^{:tag (Iterable JavaFileObject)} [this
                                                                        ^JavaFileManager$Location location
                                                                        ^Symbol$PackageSymbol p
                                                                        ^String packageName
                                                                        ^{:tag (Set JavaFileObject$Kind)} kinds]
    (let [^{:tag (Iterable JavaFileObject)} listed (.list
                                                     fileManager
                                                     location
                                                     packageName
                                                     (EnumSet/allOf JavaFileObject$Kind)
                                                     false)]
      (lambda Iterable ^Iterator []
        (anon (Iterator JavaFileObject) []
          (field ^:private ^:final ^{:tag (Iterator JavaFileObject)} original (.iterator listed))

          (field ^:private ^JavaFileObject next)

          (method ^:public hasNext ^boolean [this]
            (when (nil? next)
              (while (.hasNext original)
                (let [fo (cast JavaFileObject (.next original))]
                  (when (and (not (identical? (.getKind fo) JavaFileObject$Kind/CLASS))
                             (not (identical? (.getKind fo) JavaFileObject$Kind/SOURCE)))
                    (set! (.-flags_field p) (bit-or (.-flags_field p) Flags/HAS_RESOURCE)))
                  (when (.contains kinds (.getKind fo)) (set! next fo) (break)))))
            (some? next))

          (method ^:public next ^JavaFileObject [this]
            (when-not (.hasNext this) (throw (NoSuchElementException.)))
            (let [result next] (set! next nil) result))))))

  (defclass ^:public ^:static BadClassFile
    :extends Symbol$CompletionFailure

    (field ^:private ^:static ^:final ^long serialVersionUID 0)

    (constructor ^:public [this ^Symbol$TypeSymbol sym ^JavaFileObject file ^JCDiagnostic diag
                           ^JCDiagnostic$Factory diagFactory ^DeferredCompletionFailureHandler dcfh]
      (super. sym
              (lambda Supplier ^JCDiagnostic []
                (BadClassFile/createBadClassFileDiagnostic file diag diagFactory))
              dcfh))

    (method ^:private ^:static createBadClassFileDiagnostic ^JCDiagnostic [^JavaFileObject file
                                                                           ^JCDiagnostic diag
                                                                           ^JCDiagnostic$Factory diagFactory]
      (let [^String key (if (identical? (.getKind file) JavaFileObject$Kind/SOURCE)
                            "bad.source.file.header"
                            "bad.class.file.header")]
        (.fragment diagFactory key (new Object/1 [file diag])))))


  (method ^:protected includeClassFile ^void [this ^Symbol$PackageSymbol p ^JavaFileObject file]
    (when (== (bit-and (.-flags_field p) Flags/EXISTS) 0)
      (loop [^Symbol q p]
        (when (and (some? q) (identical? (.-kind q) Kinds$Kind/PCK))
          (set! (.-flags_field q) (bit-or (.-flags_field q) Flags/EXISTS))
          (recur (.-owner q)))))

  (defclass ^:public ^:static UndetVar
    :extends DelegatedType

    (defclass ^:enum Kind
      (constants NORMAL CAPTURED THROWS))

    (defclass ^:public ^:interface UndetVarListener
      (method varBoundChanged ^void [this ^UndetVar uv ^InferenceBound ib ^Type bound
                                     ^boolean update])

      (method ^:default varInstantiated ^void [this ^UndetVar uv]
        (Assert/error)))

    (defclass ^:public ^:enum InferenceBound
      (constants
        (LOWER [] (method ^:public complement ^InferenceBound [this] UPPER))
        (EQ [] (method ^:public complement ^InferenceBound [this] EQ))
        (UPPER [] (method ^:public complement ^InferenceBound [this] LOWER)))

      (method ^:public ^:abstract complement ^InferenceBound [this])

      (method ^:public lessThan ^boolean [this ^InferenceBound that]
        (if (identical? that this)
            false
            (switch that
              UPPER true
              LOWER false
              EQ (not (identical? this UPPER))
              (do (Assert/error "Cannot get here!") false)))))

    (field ^:public ^{:tag (ArrayDeque Infer$IncorporationAction)} incorporationActions
      (ArrayDeque.))

    (field ^:protected ^{:tag (Map InferenceBound (List Type))} bounds)

    (field ^:private ^Type inst nil)

    (field ^:public ^int declaredCount)

    (field ^:public ^UndetVarListener listener nil)

    (field ^Kind kind)

    (method ^:public accept :type-params [R S] ^R [this ^{:tag (Visitor R S)} v ^S s]
      (.visitUndetVar v this s))

    (constructor ^:public [this ^TypeVar origin ^UndetVarListener listener ^Types types]
      (super. TypeTag/UNDETVAR origin)
      (set! (.-kind this) (if (.isCaptured origin) Kind/CAPTURED Kind/NORMAL))
      (set! (.-listener this) listener)
      (set! bounds (EnumMap. InferenceBound))
      (let [^{:tag (List Type)} declaredBounds (.getBounds types origin)]
        (set! declaredCount (.length declaredBounds))
        (.put bounds InferenceBound/UPPER (List/nil))
        (.put bounds InferenceBound/LOWER (List/nil))
        (.put bounds InferenceBound/EQ (List/nil))
        (for-each [^Type t (.reverse declaredBounds)]
          (.addBound this InferenceBound/UPPER t types true))
        (when (and (.isCaptured origin) (not (.hasTag (.-lower origin) TypeTag/BOT)))
          (.addBound this InferenceBound/LOWER (.-lower origin) types true))))

    (method ^:public toString ^String [this]
      (let [sb (StringBuilder.)]
        (.appendAnnotationsString this sb)
        (if (nil? inst) (do (.append sb (.-qtype this)) (.append sb \?)) (.append sb inst))
        (.toString sb)))

    (method ^:public debugString ^String [this]
      (let [^:mutable result (java-str "inference var = " (.-qtype this) "\n")]
        (when (some? inst) (set! result (java-str result (java-str "inst = " inst \newline))))
        (for-each [^InferenceBound bound (InferenceBound/values)]
          (let [^{:tag (List Type)} aboundList (cast List (.get bounds bound))]
            (when (and (some? aboundList) (> (.size aboundList) 0))
              (set! result (java-str result (java-str bound " = " aboundList \newline))))))
        result))

    (method ^:public setThrow ^void [this]
      (when (identical? (.-kind this) Kind/CAPTURED) (throw (IllegalStateException.)))
      (set! (.-kind this) Kind/THROWS))

    (method ^:public setNormal ^void [this]
      (Assert/check (identical? (.-kind this) Kind/CAPTURED))
      (set! (.-kind this) Kind/NORMAL))

    (method ^:public dup ^UndetVar [this ^Types types]
      (let [uv2 (UndetVar. (cast TypeVar (.-qtype this)) listener types)]
        (.dupTo this uv2 types)
        uv2))

    (method ^:public dupTo ^void [this ^UndetVar uv2 ^Types types]
      (set! (.-listener uv2) nil)
      (.clear (.-bounds uv2))
      (for-each [^InferenceBound ib (InferenceBound/values)]
        (.put (.-bounds uv2) ib (List/nil))
        (for-each [^Type t (.getBounds this ib)] (.addBound uv2 ib t types true)))
      (set! (.-inst uv2) inst)
      (set! (.-listener uv2) listener)
      (set! (.-incorporationActions uv2) (ArrayDeque.))
      (for-each [^Infer$IncorporationAction action incorporationActions]
        (.add (.-incorporationActions uv2) (.dup action uv2)))
      (set! (.-kind uv2) kind))

    (method ^:public isPartial ^boolean [this] true)

    (method ^:public baseType ^Type [this]
      (if (nil? inst) ^Type this (.baseType inst)))

    (method ^:public getInst ^Type [this] inst)

    (method ^:public setInst ^void [this ^Type inst]
      (set! (.-inst this) inst)
      (when (some? listener) (.varInstantiated listener this)))

    (method ^:public getBounds ^{:tag (List Type)} [this & ^InferenceBound/1 ibs]
      (let [^{:tag (ListBuffer Type)} buf (ListBuffer.)]
        (for-each [^InferenceBound ib ibs] (.appendList buf (cast List (.get bounds ib))))
        (.toList buf)))

    (method ^:public getDeclaredBounds ^{:tag (List Type)} [this]
      (let [^{:tag (ListBuffer Type)} buf (ListBuffer.)
            ^:mutable ^int count 0]
        (for-each [^Type b (.getBounds this InferenceBound/UPPER)]
          (when (== (let [old-1 count] (set! count (unchecked-inc-int count)) old-1) declaredCount)
            (break))
          (.append buf b))
        (.toList buf)))

    (method ^:public setBounds ^void [this ^InferenceBound ib ^{:tag (List Type)} newBounds]
      (.put bounds ib newBounds))

    (method ^:public ^:final addBound ^void [this ^InferenceBound ib ^Type bound ^Types types]
      (.addBound this ib bound types false))

    (method ^:private addBound ^void [this ^InferenceBound ib ^Type bound ^Types types
                                      ^boolean update]
      (if (and (identical? kind Kind/CAPTURED) (not update))
          (when (and (.hasTag bound TypeTag/UNDETVAR) (not (.isCaptured (cast UndetVar bound))))
            (.addBound (cast UndetVar bound) (.complement ib) this types false))
          (let [bound2 (.baseType (.map bound toTypeVarMap))
                ^{:tag (List Type)} prevBounds (cast List (.get bounds ib))]
            (when-not (identical? bound (.-qtype this))
              (for-each [^Type b prevBounds] (when (.isSameType types b bound2) (return)))
              (.put bounds ib (.prepend prevBounds bound2))
              (.notifyBoundChange this ib bound2 false)))))

    (field ^{:tag (Types$TypeMapping Void)} toTypeVarMap
      (anon (StructuralTypeMapping Void) []
        (method ^:public visitUndetVar ^Type [this ^UndetVar uv ^Void _unused]
          (if (some? (.-inst uv)) (.-inst uv) (.-qtype uv)))))

    (method ^:public substBounds ^void [this ^{:tag (List Type)} from ^{:tag (List Type)} to
                                        ^Types types]
      (let [^{:tag (ListBuffer (Pair InferenceBound Type))} boundsChanged (ListBuffer.)
            prevListener listener]
        (try
          (set! listener
                (lambda UndetVarListener ^void [^UndetVar uv ^InferenceBound ib ^Type t
                                                ^boolean _ignored]
                  (Assert/check (identical? uv this))
                  (.add boundsChanged (Pair. ib t))))
          (for-each [^{:tag (Map$Entry InferenceBound (List Type))} _entry (.entrySet bounds)]
            (let [ib (cast InferenceBound (.getKey _entry))
                  ^{:tag (List Type)} prevBounds (cast List (.getValue _entry))
                  ^{:tag (ListBuffer Type)} newBounds (ListBuffer.)
                  ^{:tag (ListBuffer Type)} deps (ListBuffer.)]
              (for-each [^Type t prevBounds]
                (if (not (.containsAny t from)) (.append newBounds t) (.append deps t)))
              (.put bounds ib (.toList newBounds))
              (for-each [^Type dep deps] (.addBound this ib (.subst types dep from to) types true))))
          (finally
            (set! listener prevListener)
            (for-each [^{:tag (Pair InferenceBound Type)} boundUpdate boundsChanged]
              (.notifyBoundChange this
                                  (cast InferenceBound (.-fst boundUpdate))
                                  (cast Type (.-snd boundUpdate))
                                  true))))))

    (method ^:private notifyBoundChange ^void [this ^InferenceBound ib ^Type bound ^boolean update]
      (when (some? listener) (.varBoundChanged listener this ib bound update)))


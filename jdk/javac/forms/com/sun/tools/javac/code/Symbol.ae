  (defclass ^:public ^:static ClassSymbol
    :extends TypeSymbol
    :implements [TypeElement]

    (field ^:public ^Scope$WriteableScope members_field)

    (field ^:public ^Name fullname)

    (field ^:public ^Name flatname)

    (field ^:public ^JavaFileObject sourcefile)

    (field ^:public ^JavaFileObject classfile)

    (field ^:public ^{:tag (List ClassSymbol)} trans_local)

    (field ^:private ^Annotate$AnnotationTypeMetadata annotationTypeMetadata)

    (field ^:private ^{:tag (List RecordComponent)} recordComponents (List/nil))

    (field ^:private ^{:tag (java.util.List PermittedClassWithPos)} permitted)

    (field ^:public ^boolean isPermittedExplicit false)

    (defclass ^:private ^:record PermittedClassWithPos [^Symbol permittedClass ^int pos])

    (constructor ^:public [this ^long flags ^Name name ^Type type ^Symbol owner]
      (super. Kinds$Kind/TYP flags name type owner)
      (set! (.-members_field this) nil)
      (set! (.-fullname this) (ClassSymbol/formFullName name owner))
      (set! (.-flatname this) (ClassSymbol/formFlatName name owner))
      (set! (.-sourcefile this) nil)
      (set! (.-classfile this) nil)
      (set! (.-annotationTypeMetadata this) (Annotate$AnnotationTypeMetadata/notAnAnnotationType))
      (set! (.-permitted this) (ArrayList.)))

    (constructor ^:public [this ^long flags ^Name name ^Symbol owner]
      (this. flags name (Type$ClassType. Type/noType nil nil) owner)
      (set! (.-tsym (.-type this)) this))

    (method ^:public addPermittedSubclass ^void [this ^ClassSymbol csym ^int pos]
      (Assert/check (not isPermittedExplicit))
      (let [element (PermittedClassWithPos. csym pos)
            ^:mutable index (Collections/binarySearch
                              permitted
                              element
                              (Comparator/comparing
                                (method-ref Function
                                            ^Integer [PermittedClassWithPos]
                                            PermittedClassWithPos/.pos)))]
        (when (< index 0)
          (set! index (unchecked-subtract-int (unchecked-negate-int index) 1))
          (.add permitted index element))))

    (method ^:public isPermittedSubclass ^boolean [this ^Symbol csym]
      (for-each [^PermittedClassWithPos permittedClassWithPos permitted]
        (when (.equals (.-permittedClass permittedClassWithPos) csym) (return true)))
      false)

    (method ^:public clearPermittedSubclasses ^void [this]
      (.clear permitted))

    (method ^:public setPermittedSubclasses ^void [this ^{:tag (List Symbol)} permittedSubs]
      (.clear permitted)
      (for-each [^Symbol csym permittedSubs] (.add permitted (PermittedClassWithPos. csym 0))))

    (method ^:public toString ^String [this] (.className this))

    (method ^:public flags ^long [this]
      (.complete this)
      (.-flags_field this))

    (method ^:public members ^Scope$WriteableScope [this]
      (.complete this)
      members_field)

    (method ^:public getRawAttributes ^{:tag (List Attribute$Compound)} [this]
      (.complete this)
      (.getRawAttributes super))

    (method ^:public getRawTypeAttributes ^{:tag (List Attribute$TypeCompound)} [this]
      (.complete this)
      (.getRawTypeAttributes super))

    (method ^:public erasure ^Type [this ^Types types]
      (when (nil? (.-erasure_field this))
        (set! (.-erasure_field this)
              (Type$ClassType. (.erasure types (.getEnclosingType (.-type this)))
                               (List/nil)
                               this
                               (.getMetadata (.-type this)))))
      (.-erasure_field this))

    (method ^:public className ^String [this]
      (if (.isEmpty (.-name this))
          (Log/getLocalizedString "anonymous.class" flatname)
          (.toString fullname)))

    (method ^:public getQualifiedName ^Name [this] fullname)

    (method ^:public getSimpleName ^Name [this] (.-name this))

    (method ^:public getEnclosedElements ^{:tag (List Symbol)} [this]
      (let [^:mutable ^{:tag (List Symbol)} result (.getEnclosedElements super)]
        (when-not (.isEmpty recordComponents)
          (let [^{:tag (List RecordComponent)} reversed (.reverse recordComponents)]
            (for-each [^RecordComponent rc reversed] (set! result (.prepend result rc)))))
        result))

    (method ^:public flatName ^Name [this] flatname)

    (method ^:public isSubClass ^boolean [this ^Symbol base ^Types types]
      (if (identical? this base)
          true
          (do
            (if (not (== (bit-and (.flags base) Flags/INTERFACE) 0))
                (loop [t (.-type this)]
                  (when (.hasTag t TypeTag/CLASS)
                    (loop [^{:tag (List Type)} is (.interfaces types t)]
                      (if (.nonEmpty is)
                          (if (.isSubClass (.-tsym (cast Type (.-head is))) base types)
                              (return true)
                              (recur (.-tail is)))
                          nil))
                    (recur (.supertype types t))))
                (loop [t (.-type this)]
                  (if (.hasTag t TypeTag/CLASS)
                      (if (identical? (.-tsym t) base) (return true) (recur (.supertype types t)))
                      nil)))
            false)))

    (method ^:public complete :throws [CompletionFailure] ^void [this]
      (let [origCompleter (.-completer this)]
        (try
          (.complete super)
          (catch CompletionFailure ex
            (.classSymbolCompleteFailed (.-dcfh ex) this origCompleter)
            (set! (.-flags_field this)
                  (bit-or (.-flags_field this) (bit-or-int Flags/PUBLIC Flags/STATIC)))
            (set! (.-type this) (Type$ErrorType. this Type/noType))
            (throw ex)))))

    (method ^:public getInterfaces ^{:tag (List Type)} [this]
      (.apiComplete this)
      (if-instance [^Type$ClassType classType (.-type this)]
        (do
          (when (nil? (.-interfaces_field classType))
            (set! (.-interfaces_field classType) (List/nil)))
          (if (some? (.-all_interfaces_field classType))
              (Type/getModelTypes (.-all_interfaces_field classType))
              (.-interfaces_field classType)))
        (List/nil)))

    (method ^:public getSuperclass ^Type [this]
      (.apiComplete this)
      (if-instance [^Type$ClassType classType (.-type this)]
        (do
          (when (nil? (.-supertype_field classType))
            (set! (.-supertype_field classType) Type/noType))
          (if (.isInterface classType) Type/noType (.getModelType (.-supertype_field classType))))
        Type/noType))

    (method ^:private getSuperClassToSearchForAnnotations ^ClassSymbol [this]
      (let [sup (.getSuperclass this)]
        (when-not (or (not (.hasTag sup TypeTag/CLASS)) (.isErroneous sup))
          (cast ClassSymbol (.-tsym sup)))))

    (method ^:protected getInheritedAnnotations :type-params [(A extends Annotation)] ^A/1 [this
                                                                                            ^{:tag (Class A)} annoType]
      (let [sup (.getSuperClassToSearchForAnnotations this)]
        (if (nil? sup)
            (.getInheritedAnnotations super annoType)
            (.getAnnotationsByType sup annoType))))

    (method ^:public getKind ^ElementKind [this]
      (.apiComplete this)
      (let [flags (.flags this)]
        (cond
          (not (== (bit-and flags Flags/ANNOTATION) 0)) ElementKind/ANNOTATION_TYPE
          (not (== (bit-and flags Flags/INTERFACE) 0)) ElementKind/INTERFACE
          (not (== (bit-and flags Flags/ENUM) 0)) ElementKind/ENUM
          (not (== (bit-and flags Flags/RECORD) 0)) ElementKind/RECORD
          :else ElementKind/CLASS)))

    (method ^:public getModifiers ^{:tag (Set Modifier)} [this]
      (.apiComplete this)
      (let [flags (.flags this)] (Flags/asModifierSet (bit-and flags (bit-not Flags/DEFAULT)))))

    (method ^:public getRecordComponent ^RecordComponent [this ^VarSymbol field]
      (for-each [^RecordComponent rc recordComponents]
        (when (identical? (.-name rc) (.-name field)) (return rc)))
      nil)

    (method ^:public createRecordComponent ^RecordComponent [this ^RecordComponent existing
                                                             ^JCTree$JCVariableDecl rcDecl
                                                             ^VarSymbol varSym]
      (let [^:mutable ^RecordComponent rc nil]
        (if (and (some? existing) (not (.isEmpty recordComponents)))
            (let [^{:tag (ListBuffer RecordComponent)} newRComps (ListBuffer.)]
              (for-each [^RecordComponent rcomp recordComponents]
                (if (identical? existing rcomp)
                    (.add newRComps
                          (set! rc
                                (RecordComponent. varSym (.-ast existing) (.-isVarargs existing))))
                    (.add newRComps rcomp)))
              (set! recordComponents (.toList newRComps)))
            (set! recordComponents
                  (.append recordComponents (set! rc (RecordComponent. varSym rcDecl)))))
        rc))

    (method ^:public getRecordComponents ^{:tag (List (? extends RecordComponent))} [this]
      recordComponents)

    (method ^:public setRecordComponents ^void [this ^{:tag (List RecordComponent)} recordComponents]
      (set! (.-recordComponents this) recordComponents))

    (method ^:public getNestingKind ^NestingKind [this]
      (.apiComplete this)
      (cond
        (identical? (.-kind (.-owner this)) Kinds$Kind/PCK) NestingKind/TOP_LEVEL
        (.isEmpty (.-name this)) NestingKind/ANONYMOUS
        (identical? (.-kind (.-owner this)) Kinds$Kind/MTH) NestingKind/LOCAL
        :else NestingKind/MEMBER))

    (method ^:protected getAttribute :type-params [(A extends Annotation)] ^Attribute$Compound [this
                                                                                                ^:final ^{:tag (Class A)} annoType]
      (let [attrib (.getAttribute super annoType)
            inherited (.isAnnotationPresent annoType Inherited)]
        (if (or (some? attrib) (not inherited))
            attrib
            (let [superType (.getSuperClassToSearchForAnnotations this)]
              (when (some? superType) (.getAttribute superType annoType))))))

    (method ^:public accept :type-params [R P] ^R [this ^{:tag (ElementVisitor R P)} v ^P p]
      (.visitType v this p))

    (method ^:public accept :type-params [R P] ^R [this ^{:tag (Visitor R P)} v ^P p]
      (.visitClassSymbol v this p))

    (method ^:public markAbstractIfNeeded ^void [this ^Types types]
      (when (and (and (and (some? (.getEnv (.-enter types) this))
                           (not (== (bit-and (.flags this) Flags/ENUM) 0)))
                      (identical? (.-tsym (.supertype types (.-type this)))
                                  (.-enumSym (.-syms types))))
                 (== (bit-and (.flags this) (bit-or-int Flags/FINAL Flags/ABSTRACT)) 0))
        (when (some? (.firstUnimplementedAbstract types this))
          (set! (.-flags_field this) (bit-or (.-flags_field this) Flags/ABSTRACT)))))

    (method ^:public reset ^void [this]
      (set! (.-kind this) Kinds$Kind/TYP)
      (set! (.-erasure_field this) nil)
      (set! members_field nil)
      (set! (.-flags_field this) 0)
      (when-instance [^Type$ClassType classType (.-type this)]
        (.setEnclosingType classType Type/noType)
        (set! (.-rank_field classType) -1)
        (set! (.-typarams_field classType) nil)
        (set! (.-allparams_field classType) nil)
        (set! (.-supertype_field classType) nil)
        (set! (.-interfaces_field classType) nil)
        (set! (.-all_interfaces_field classType) nil))
      (.clearAnnotationMetadata this))

    (method ^:public clearAnnotationMetadata ^void [this]
      (set! (.-metadata this) nil)
      (set! annotationTypeMetadata (Annotate$AnnotationTypeMetadata/notAnAnnotationType)))

    (method ^:public getAnnotationTypeMetadata ^Annotate$AnnotationTypeMetadata [this]
      annotationTypeMetadata)

    (method ^:public isAnnotationType ^boolean [this]
      (not (== (bit-and (.-flags_field this) Flags/ANNOTATION) 0)))

    (method ^:public setAnnotationTypeMetadata ^void [this ^Annotate$AnnotationTypeMetadata a]
      (Assert/checkNonNull a)
      (Assert/check (not (.isMetadataForAnnotationType annotationTypeMetadata)))
      (set! (.-annotationTypeMetadata this) a))

    (method ^:public isRecord ^boolean [this]
      (not (== (bit-and (.-flags_field this) Flags/RECORD) 0)))

    (method ^:public getPermittedSubclasses ^{:tag (List Type)} [this]
      (cast List
            (.collect (.map (.stream permitted)
                            (lambda Function ^Type [^PermittedClassWithPos s]
                              (.-type (.permittedClass s))))
                      (List/collector)))))

  (defclass ^:public ^:static VarSymbol
    :extends Symbol
    :implements [VariableElement]

    (field ^:public ^int pos Position/NOPOS)

    (field ^:public ^int adr -1)

    (constructor ^:public [this ^long flags ^Name name ^Type type ^Symbol owner]
      (super. Kinds$Kind/VAR flags name type owner))

    (method ^:public poolTag ^int [this] ClassFile/CONSTANT_Fieldref)

    (method ^:public asMethodHandle ^MethodHandleSymbol [this ^boolean getter]
      (MethodHandleSymbol. this getter))

    (method ^:public clone ^VarSymbol [this ^Symbol newOwner]
      (let [^VarSymbol v (anon VarSymbol [(.-flags_field this) (.-name this) (.-type this) newOwner]
                           (method ^:public baseSymbol ^Symbol [this] VarSymbol/this)

                           (method ^:public poolKey [this ^Types types]
                             (Pair. newOwner (.baseSymbol this))))]
        (set! (.-pos v) pos)
        (set! (.-adr v) adr)
        (set! (.-data v) data)
        v))

    (method ^:public toString ^String [this] (.toString (.-name this)))

    (method ^:public asMemberOf ^Symbol [this ^Type site ^Types types]
      (VarSymbol. (.-flags_field this) (.-name this) (.memberType types site this) (.-owner this)))

    (method ^:public getKind ^ElementKind [this]
      (let [flags (.flags this)]
        (cond
          (not (== (bit-and flags Flags/PARAMETER) 0))
            (if (.isExceptionParameter this) ElementKind/EXCEPTION_PARAMETER ElementKind/PARAMETER)
          (not (== (bit-and flags Flags/ENUM) 0)) ElementKind/ENUM_CONSTANT
          (or (identical? (.-kind (.-owner this)) Kinds$Kind/TYP)
              (identical? (.-kind (.-owner this)) Kinds$Kind/ERR))
            ElementKind/FIELD
          (.isResourceVariable this) ElementKind/RESOURCE_VARIABLE
          (not (== (bit-and flags Flags/MATCH_BINDING) 0))
            (let [kind ElementKind/BINDING_VARIABLE] kind)
          :else ElementKind/LOCAL_VARIABLE)))

    (method ^:public accept :type-params [R P] ^R [this ^{:tag (ElementVisitor R P)} v ^P p]
      (.visitVariable v this p))

    (method ^:public getConstantValue [this]
      (Constants/decode (.getConstValue this) (.-type this)))

    (method ^:public setLazyConstValue ^void [this ^:final ^{:tag (Env AttrContext)} env
                                              ^:final ^{:tag (Env AttrContext)} enclosingEnv
                                              ^:final ^Attr attr
                                              ^:final ^JCTree$JCVariableDecl variable]
      (.setData this
                (lambda Callable []
                  (.attribLazyConstantValue attr env enclosingEnv variable (.-type this)))))

    (field ^:private data)

    (method ^:public isExceptionParameter ^boolean [this]
      (identical? data ElementKind/EXCEPTION_PARAMETER))

    (method ^:public isResourceVariable ^boolean [this]
      (identical? data ElementKind/RESOURCE_VARIABLE))

    (method ^:public getConstValue [this]
      (when-not (or (identical? data ElementKind/EXCEPTION_PARAMETER)
                    (identical? data ElementKind/RESOURCE_VARIABLE))
        (when-instance [^{:tag (Callable ?)} callableData data]
          (set! data nil)
          (try (set! data (.call callableData)) (catch Exception ex (throw (AssertionError. ex)))))
        data))

    (method ^:public setData ^void [this data]
      (Assert/check (not (instance? Env data)) this)
      (set! (.-data this) data))

    (method ^:public accept :type-params [R P] ^R [this ^{:tag (Visitor R P)} v ^P p]
      (.visitVarSymbol v this p))

    (method ^:public isUnnamedVariable ^boolean [this]
      (.isEmpty (.-name this))))


      (.containsAll (.aliases this) (.aliases b)))

    (method aliases ^{:tag (List BindingSymbol)} [this] (List/of this))

    (method ^:public preserveBinding ^void [this]
      (set! (.-flags_field this) (bit-or (.-flags_field this) Flags/MATCH_BINDING_TO_OUTER)))

    (method ^:public isPreserved ^boolean [this]
      (not (== (bit-and (.-flags_field this) Flags/MATCH_BINDING_TO_OUTER) 0))))

  (defclass ^:public ^:static MethodSymbol
    :extends Symbol
    :implements [ExecutableElement]

    (field ^:public ^Code code nil)

    (field ^:public ^{:tag (List VarSymbol)} extraParams (List/nil))

    (field ^:public ^{:tag (List VarSymbol)} capturedLocals (List/nil))

    (field ^:public ^{:tag (List VarSymbol)} params nil)

    (field ^:public ^Attribute defaultValue nil)

    (constructor ^:public [this ^long flags ^Name name ^Type type ^Symbol owner]
      (super. Kinds$Kind/MTH flags name type owner)
      (when (.hasTag (.-type owner) TypeTag/TYPEVAR) (Assert/error (java-str owner "." name))))

    (method ^:public clone ^MethodSymbol [this ^Symbol newOwner]
      (let [^MethodSymbol m (anon MethodSymbol [(.-flags_field this)
                                                (.-name this)
                                                (.-type this)
                                                newOwner]
                              (method ^:public baseSymbol ^Symbol [this] MethodSymbol/this)

                              (method ^:public poolKey [this ^Types types]
                                (Pair. newOwner (.baseSymbol this))))]
        (set! (.-code m) code)
        m))

    (method ^:public getModifiers ^{:tag (Set Modifier)} [this]
      (let [flags (bit-and (.flags this) (bit-not Flags/RESTRICTED))]
        (Flags/asModifierSet
          (if (not (== (bit-and flags Flags/DEFAULT) 0))
              (bit-and flags (bit-not-int Flags/ABSTRACT))
              flags))))

    (method ^:public toString ^String [this]
      (if (not (== (bit-and (.flags this) Flags/BLOCK) 0))
          (.toString (.-name (.-owner this)))
          (let [^:mutable ^String s (if (identical?
                                          (.-name this)
                                          (.-init (.-names (.-table (.-name this)))))
                                        (.toString (.-name (.-owner this)))
                                        (.toString (.-name this)))]
            (when (some? (.-type this))
              (when (.hasTag (.-type this) TypeTag/FORALL)
                (set! s (java-str "<" (.getTypeArguments (cast Type$ForAll (.-type this))) ">" s)))
              (set! s
                    (java-str s
                              (java-str "("
                                        (.argtypes
                                          (.-type this)
                                          (not (== (bit-and (.flags this) Flags/VARARGS) 0)))
                                        ")"))))
            s)))

    (method ^:public poolTag ^int [this]
      (if (.isInterface (.-owner this))
          ClassFile/CONSTANT_InterfaceMethodref
          ClassFile/CONSTANT_Methodref))

    (method ^:public isHandle ^boolean [this] false)

    (method ^:public asHandle ^MethodHandleSymbol [this]
      (MethodHandleSymbol. this))

    (method ^:public implemented ^Symbol [this ^TypeSymbol c ^Types types]
      (let [^:mutable ^Symbol impl nil]
        (loop [^{:tag (List Type)} is (.interfaces types (.-type c))]
          (when (and (nil? impl) (.nonEmpty is))
            (let [i (.-tsym (cast Type (.-head is)))]
              (set! impl (.implementedIn this i types))
              (if (nil? impl)
                  (do (set! impl (.implemented this i types)) (recur (.-tail is)))
                  (recur (.-tail is))))))
        impl))

    (method ^:public implementedIn ^Symbol [this ^TypeSymbol c ^Types types]
      (let [^:mutable ^Symbol impl nil]
        (for-each [^Symbol sym (.getSymbolsByName (.members c) (.-name this))]
          (when (and (.overrides this sym (cast TypeSymbol (.-owner this)) types true)
                     (.isSameType types
                                  (.getReturnType (.-type this))
                                  (.getReturnType (.memberType types (.-type (.-owner this)) sym))))
            (set! impl sym)))
        impl))

    (method ^:public binaryOverrides ^boolean [this ^Symbol _other ^TypeSymbol origin ^Types types]
      (cond
        (or (.isConstructor this) (not (identical? (.-kind _other) Kinds$Kind/MTH))) false
        (identical? this _other) true
        :else
          (let [other (cast MethodSymbol _other)]
            (if (and (and (.isOverridableIn other (cast TypeSymbol (.-owner this)))
                          (some? (.asSuper types (.-type (.-owner this)) (.-owner other))))
                     (.isSameType types (.erasure this types) (.erasure other types)))
                true
                (and (and (and (== (bit-and (.flags this) Flags/ABSTRACT) 0)
                               (.isOverridableIn other origin))
                          (.isMemberOf this origin types))
                     (.isSameType types (.erasure this types) (.erasure other types)))))))

    (method ^:public binaryImplementation ^MethodSymbol [this ^ClassSymbol origin ^Types types]
      (loop [^TypeSymbol c origin]
        (when (some? c)
          (for-each [^Symbol sym (.getSymbolsByName (.members c) (.-name this))]
            (when (and (identical? (.-kind sym) Kinds$Kind/MTH)
                       (.binaryOverrides (cast MethodSymbol sym) this origin types))
              (return (cast MethodSymbol sym))))
          (recur (.-tsym (.supertype types (.-type c))))))
      nil)

    (method ^:public overrides ^boolean [this ^Symbol _other ^TypeSymbol origin ^Types types
                                         ^boolean checkResult]
      (.overrides this _other origin types checkResult true))

    (method ^:public overrides ^boolean [this ^Symbol _other ^TypeSymbol origin ^Types types
                                         ^boolean checkResult ^boolean requireConcreteIfInherited]
      (cond
        (or (.isConstructor this) (not (identical? (.-kind _other) Kinds$Kind/MTH))) false
        (identical? this _other) true
        :else
          (let [other (cast MethodSymbol _other)]
            (when (and (.isOverridableIn other (cast TypeSymbol (.-owner this)))
                       (some? (.asSuper types (.-type (.-owner this)) (.-owner other))))
              (let [mt (.memberType types (.-type (.-owner this)) this)
                    ot (.memberType types (.-type (.-owner this)) other)]
                (when (.isSubSignature types mt ot)
                  (when-not checkResult (return true))
                  (when (.returnTypeSubstitutable types mt ot) (return true)))))
            (if (or (or (or (and (not (== (bit-and (.flags this) Flags/ABSTRACT) 0))
                                 requireConcreteIfInherited)
                            (and (== (bit-and (.flags other) Flags/ABSTRACT) 0)
                                 (== (bit-and (.flags other) Flags/DEFAULT) 0)))
                        (not (.isOverridableIn other origin)))
                    (not (.isMemberOf this origin types)))
                false
                (let [mt (.memberType types (.-type origin) this)
                      ot (.memberType types (.-type origin) other)]
                  (and (.isSubSignature types mt ot)
                       (or (not checkResult) (.resultSubtype types mt ot (.-noWarnings types)))))))))

    (method ^:private isOverridableIn ^boolean [this ^TypeSymbol origin]
      (switch (unchecked-int (bit-and (.-flags_field this) Flags/AccessFlags))
        Flags/PRIVATE false
        Flags/PUBLIC
          (or (not (.isInterface (.-owner this)))
              (== (bit-and (.-flags_field this) Flags/STATIC) 0))
        Flags/PROTECTED (== (bit-and (.flags origin) Flags/INTERFACE) 0)
        0
          (and (identical? (.packge this) (.packge origin))
               (== (bit-and (.flags origin) Flags/INTERFACE) 0))
        false))

    (method ^:public isInheritedIn ^boolean [this ^Symbol clazz ^Types types]
      (switch (unchecked-int (bit-and (.-flags_field this) Flags/AccessFlags))
        Flags/PUBLIC
          (or (or (not (.isInterface (.-owner this))) (identical? clazz (.-owner this)))
              (== (bit-and (.-flags_field this) Flags/STATIC) 0))
        (.isInheritedIn super clazz types)))

    (method ^:public isLambdaMethod ^boolean [this]
      (== (bit-and (.flags this) Flags/LAMBDA_METHOD) Flags/LAMBDA_METHOD))

    (method ^:public originalEnclosingMethod ^MethodSymbol [this] this)

    (method ^:public implementation ^MethodSymbol [this ^TypeSymbol origin ^Types types
                                                   ^boolean checkResult]
      (.implementation this origin types checkResult implementation_filter))

    (field ^:public ^:static ^:final ^{:tag (Predicate Symbol)} implementation_filter
      (lambda Predicate ^boolean [^Symbol s]
        (and (identical? (.-kind s) Kinds$Kind/MTH) (== (bit-and (.flags s) Flags/SYNTHETIC) 0))))

    (method ^:public implementation ^MethodSymbol [this ^TypeSymbol origin ^Types types
                                                   ^boolean checkResult
                                                   ^{:tag (Predicate Symbol)} implFilter]
      (let [res (.implementation types this origin checkResult implFilter)]
        (cond
          (some? res) res
          (and (.isDerivedRaw types (.-type origin)) (not (.isInterface origin)))
            (.implementation this (.-tsym (.supertype types (.-type origin))) types checkResult))))

    (method ^:public params ^{:tag (List VarSymbol)} [this]
      (.complete (.-owner this))
      (when (nil? params)
        (let [^{:tag (ListBuffer VarSymbol)} newParams (ListBuffer.)
              ^:mutable ^int i 0]
          (for-each [^Type t (.getParameterTypes (.-type this))]
            (let [paramName (.fromString (.-table (.-name this)) (java-str "arg" i))
                  param (VarSymbol. Flags/PARAMETER paramName t this)]
              (.append newParams param)
              (set! i (unchecked-inc-int i))))
          (set! params (.toList newParams))))
      (Assert/checkNonNull params)
      params)

    (method ^:public asMemberOf ^Symbol [this ^Type site ^Types types]
      (MethodSymbol. (.-flags_field this)
                     (.-name this)
                     (.memberType types site this)
                     (.-owner this)))

    (method ^:public getKind ^ElementKind [this]
      (cond
        (identical? (.-name this) (.-init (.-names (.-table (.-name this)))))
          ElementKind/CONSTRUCTOR
        (identical? (.-name this) (.-clinit (.-names (.-table (.-name this)))))
          ElementKind/STATIC_INIT
        (not (== (bit-and (.flags this) Flags/BLOCK) 0))
          (if (.isStatic this) ElementKind/STATIC_INIT ElementKind/INSTANCE_INIT)
        :else ElementKind/METHOD))

    (method ^:public isStaticOrInstanceInit ^boolean [this]
      (or (identical? (.getKind this) ElementKind/STATIC_INIT)
          (identical? (.getKind this) ElementKind/INSTANCE_INIT)))

    (method ^:public getDefaultValue ^Attribute [this] defaultValue)

    (method ^:public getParameters ^{:tag (List VarSymbol)} [this]
      (.params this))

    (method ^:public isVarArgs ^boolean [this]
      (not (== (bit-and (.flags this) Flags/VARARGS) 0)))

    (method ^:public isDefault ^boolean [this]
      (not (== (bit-and (.flags this) Flags/DEFAULT) 0)))

    (method ^:public accept :type-params [R P] ^R [this ^{:tag (ElementVisitor R P)} v ^P p]
      (.visitExecutable v this p))

    (method ^:public accept :type-params [R P] ^R [this ^{:tag (Visitor R P)} v ^P p]
      (.visitMethodSymbol v this p))

    (method ^:public getReceiverType ^Type [this]
      (.getReceiverType (.asType this)))

    (method ^:public implicitReceiverType ^Type [this]
      (let [enclosingClass (.enclClass this)]
        (when (some? enclosingClass)
          (let [enclosingType (.-type enclosingClass)]
            (if (.isConstructor this)
                (.getEnclosingType enclosingType)
                (when-not (.isStatic this) enclosingType))))))

    (method ^:public getReturnType ^Type [this]
      (.getReturnType (.asType this)))

    (method ^:public getThrownTypes ^{:tag (List Type)} [this]
      (.getThrownTypes (.asType this))))

  (defclass ^:public ^:static DynamicMethodSymbol

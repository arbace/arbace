          (when (.anyMatch (.members sym)
                           (lambda Predicate ^boolean [^Symbol m]
                             (identical? (.-kind m) Kinds$Kind/TYP)))
            (set! list (.prepend list sym))))
        list))

    (method ^:public reset ^void [this]
      (set! (.-directives this) nil)
      (set! (.-requires this) nil)
      (set! (.-exports this) nil)
      (set! (.-provides this) nil)
      (set! (.-uses this) nil)
      (set! (.-visiblePackages this) nil)))

  (defclass ^:public ^:enum ModuleFlags

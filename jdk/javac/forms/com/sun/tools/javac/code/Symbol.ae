        (.setAttributes (.-metadata this) (.-metadata package_info))))

    (method ^:public exists ^boolean [this]
      (not (== (bit-and (.-flags_field this) Flags/EXISTS) 0)))

    (method ^:public getKind ^ElementKind [this] ElementKind/PACKAGE)


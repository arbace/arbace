      (set! (.-type this) (Type$PackageType. this)))

    (method ^:public toString ^String [this] (.toString fullname))

    (method ^:public getQualifiedName ^Name [this] fullname)

    (method ^:public isUnnamed ^boolean [this]
      (and (.isEmpty (.-name this)) (some? (.-owner this))))

    (method ^:public members ^Scope$WriteableScope [this]

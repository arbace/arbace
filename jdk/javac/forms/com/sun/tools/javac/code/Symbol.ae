  (defclass ^:public ^:static MethodHandleSymbol
    :extends MethodSymbol
    :implements [PoolConstant$LoadableConstant]

    (field ^:private ^Symbol refSym)

    (field ^:private ^boolean getter)

    (constructor ^:public [this ^Symbol msym] (this. msym false))

    (constructor ^:public [this ^Symbol msym ^boolean getter]
      (super. (.-flags_field msym) (.-name msym) (.-type msym) (.-owner msym))
      (set! (.-refSym this) msym)
      (set! (.-getter this) getter))

    (method ^:public referenceKind ^int [this]
      (cond
        (identical? (.-kind refSym) Kinds$Kind/VAR)
          (cond
            getter (if (.isStatic refSym) ClassFile/REF_getStatic ClassFile/REF_getField)
            (.isStatic refSym) ClassFile/REF_putStatic
            :else ClassFile/REF_putField)
        (.isConstructor refSym) ClassFile/REF_newInvokeSpecial
        (.isStatic refSym) ClassFile/REF_invokeStatic
        (and (not (== (bit-and (.flags refSym) Flags/PRIVATE) 0))
             (not (.allowPrivateInvokeVirtual this)))
          ClassFile/REF_invokeSpecial
        (.isInterface (.enclClass refSym)) ClassFile/REF_invokeInterface
        :else ClassFile/REF_invokeVirtual))

    (method ^:private allowPrivateInvokeVirtual ^boolean [this]
      (let [^:mutable ^Symbol rootPack this]
        (while (and (some? rootPack) (not (instance? RootPackageSymbol rootPack)))
          (set! rootPack (.-owner rootPack)))
        (and (some? rootPack) (.-allowPrivateInvokeVirtual (cast RootPackageSymbol rootPack)))))

    (method ^:public poolTag ^int [this] ClassFile/CONSTANT_MethodHandle)

    (method ^:public poolKey [this ^Types types]
      (Pair. (.baseSymbol this) (.referenceKind this)))

    (method ^:public asHandle ^MethodHandleSymbol [this] this)

    (method ^:public baseSymbol ^Symbol [this] refSym)

    (method ^:public isHandle ^boolean [this] true))

  (defclass ^:public ^:static OperatorSymbol
    :extends MethodSymbol

    (field ^:public ^int opcode)

    (field ^:private ^int accessCode Integer/MIN_VALUE)

    (constructor ^:public [this ^Name name ^Type type ^int opcode ^Symbol owner]
      (super. (bit-or-int Flags/PUBLIC Flags/STATIC) name type owner)
      (set! (.-opcode this) opcode))

    (method ^:public accept :type-params [R P] ^R [this ^{:tag (Visitor R P)} v ^P p]
      (.visitOperatorSymbol v this p))

    (method ^:public getAccessCode ^int [this ^JCTree$Tag tag]
      (if (and (not (== accessCode Integer/MIN_VALUE)) (not (.isIncOrDecUnaryOp tag)))
          accessCode
          (do (set! accessCode (AccessCode/from tag opcode)) accessCode)))

    (defclass ^:public ^:enum AccessCode
      (constants
        (UNKNOWN [-1 JCTree$Tag/NO_TAG])
        (DEREF [0 JCTree$Tag/NO_TAG])
        (ASSIGN [2 JCTree$Tag/ASSIGN])
        (PREINC [4 JCTree$Tag/PREINC])
        (PREDEC [6 JCTree$Tag/PREDEC])
        (POSTINC [8 JCTree$Tag/POSTINC])
        (POSTDEC [10 JCTree$Tag/POSTDEC])
        (FIRSTASGOP [12 JCTree$Tag/NO_TAG]))

      (field ^:public ^:final ^int code)

      (field ^:public ^:final ^JCTree$Tag tag)

      (field ^:public ^:static ^:final ^int numberOfAccessCodes
        (unchecked-add-int
          (unchecked-add-int
            (unchecked-multiply-int
              (unchecked-subtract-int
                (unchecked-add-int
                  (unchecked-add-int (unchecked-subtract-int ByteCodes/lushrl ByteCodes/ishll)
                                     ByteCodes/lxor)
                  2)
                ByteCodes/iadd)
              2)
            (.-code FIRSTASGOP))
          2))

      (constructor [this ^int code ^JCTree$Tag tag]
        (set! (.-code this) code)
        (set! (.-tag this) tag))

      (method ^:public ^:static getFromCode ^AccessCode [^int code]
        (for-each [^AccessCode aCodes (AccessCode/values)]
          (when (== (.-code aCodes) code) (return aCodes)))
        UNKNOWN)

      (method ^:static from ^int [^JCTree$Tag tag ^int opcode]
        (switch tag
          PREINC (return (.-code AccessCode/PREINC))
          PREDEC (return (.-code AccessCode/PREDEC))
          POSTINC (return (.-code AccessCode/POSTINC))
          POSTDEC (return (.-code AccessCode/POSTDEC)))
        (cond
          (and (<= ByteCodes/iadd opcode) (<= opcode ByteCodes/lxor))
            (unchecked-add-int
              (unchecked-multiply-int (unchecked-subtract-int opcode ByteCodes/iadd) 2)
              (.-code FIRSTASGOP))
          (== opcode ByteCodes/string_add)
            (unchecked-add-int
              (unchecked-multiply-int
                (unchecked-subtract-int (unchecked-add-int ByteCodes/lxor 1) ByteCodes/iadd)
                2)
              (.-code FIRSTASGOP))
          (and (<= ByteCodes/ishll opcode) (<= opcode ByteCodes/lushrl))
            (unchecked-add-int
              (unchecked-multiply-int
                (unchecked-subtract-int
                  (unchecked-add-int
                    (unchecked-add-int (unchecked-subtract-int opcode ByteCodes/ishll)
                                       ByteCodes/lxor)
                    2)
                  ByteCodes/iadd)
                2)
              (.-code FIRSTASGOP))
          :else -1))))

  (defclass ^:public ^:static ^:interface Completer
    (field ^:public ^:static ^:final ^Completer NULL_COMPLETER
      (anon Completer []
        (method ^:public complete ^void [this ^Symbol sym])

        (method ^:public isTerminal ^boolean [this] true)))

    (method complete :throws [CompletionFailure] ^void [this ^Symbol sym])

    (method ^:default isTerminal ^boolean [this] false))

  (defclass ^:public ^:static CompletionFailure
    :extends RuntimeException

    (field ^:private ^:static ^:final ^long serialVersionUID 0)

    (field ^:public ^:final ^:transient ^DeferredCompletionFailureHandler dcfh)

    (field ^:public ^:transient ^Symbol sym)

    (field ^:private ^:transient ^JCDiagnostic diag)

    (field ^:private ^:transient ^{:tag (Supplier JCDiagnostic)} diagSupplier)

    (constructor ^:public [this ^Symbol sym ^{:tag (Supplier JCDiagnostic)} diagSupplier
                           ^DeferredCompletionFailureHandler dcfh]
      (set! (.-dcfh this) dcfh)
      (set! (.-sym this) sym)
      (set! (.-diagSupplier this) diagSupplier))

    (method ^:public getDiagnostic ^JCDiagnostic [this]
      (when (and (nil? diag) (some? diagSupplier))
        (set! diag (cast JCDiagnostic (.get diagSupplier))))
      diag)

    (method ^:public getMessage ^String [this]
      (.getMessage (.getDiagnostic this) nil))

    (method ^:public getDetailValue ^JCDiagnostic [this]
      (.getDiagnostic this))

    (method ^:public initCause ^CompletionFailure [this ^Throwable cause]
      (.initCause super cause)
      this)

    (method ^:public resetDiagnostic ^void [this ^{:tag (Supplier JCDiagnostic)} diagSupplier]
      (set! (.-diagSupplier this) diagSupplier)
      (set! (.-diag this) nil)))

  (defclass ^:public ^:interface Visitor
    :type-params [R P]

    (method visitClassSymbol ^R [this ^ClassSymbol s ^P arg])

    (method visitMethodSymbol ^R [this ^MethodSymbol s ^P arg])

    (method visitPackageSymbol ^R [this ^PackageSymbol s ^P arg])

    (method visitOperatorSymbol ^R [this ^OperatorSymbol s ^P arg])

    (method visitVarSymbol ^R [this ^VarSymbol s ^P arg])

    (method visitTypeSymbol ^R [this ^TypeSymbol s ^P arg])

    (method visitSymbol ^R [this ^Symbol s ^P arg])))

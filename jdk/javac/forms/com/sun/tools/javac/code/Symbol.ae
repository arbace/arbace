      (WARN_INCUBATING [0x0008]))

    (method ^:public ^:static value ^int [^{:tag (Set ModuleResolutionFlags)} s]
      (let [^:mutable ^int v 0]
        (for-each [^ModuleResolutionFlags f s] (set! v (bit-or-int v (.-value f))))
        v))

    (constructor ^:private [this ^int value] (set! (.-value this) value))

    (field ^:public ^:final ^int value))

  (defclass ^:public ^:static PackageSymbol
    :extends TypeSymbol
    :implements [PackageElement]

    (field ^:public ^Scope$WriteableScope members_field)

    (field ^:public ^Name fullname)


    (method ^:public accept :type-params [R P] ^R [this ^{:tag (ElementVisitor R P)} v ^P p]
      (.visitRecordComponent v this p)))

  (defclass ^:public ^:static ParamSymbol
    :extends VarSymbol

    (constructor ^:public [this ^long flags ^Name name ^Type type ^Symbol owner]
      (super. flags name type owner))

    (method ^:public getSimpleName ^Name [this]
      (when (== (bit-and (.-flags_field this) Flags/NAME_FILLED) 0)
        (set! (.-flags_field this) (bit-or (.-flags_field this) Flags/NAME_FILLED))
        (let [^:mutable ^Symbol rootPack this]
          (while (and (some? rootPack) (not (instance? RootPackageSymbol rootPack)))
            (set! rootPack (.-owner rootPack)))
          (when (some? rootPack)
            (let [inferredName (.getParameterName
                                 (.-missingInfoHandler (cast RootPackageSymbol rootPack))
                                 this)]
              (when (some? inferredName) (set! (.-name this) inferredName))))))
      (.getSimpleName super)))

  (defclass ^:public ^:static BindingSymbol
    :extends VarSymbol

    (constructor ^:public [this ^long flags ^Name name ^Type type ^Symbol owner]
      (super. (bit-or (bit-or flags Flags/HASINIT) Flags/MATCH_BINDING) name type owner))


    (field ^:public ^:final ^{:tag (Set ModuleFlags)} flags (EnumSet/noneOf ModuleFlags))

    (field ^:public ^:final ^{:tag (Set ModuleResolutionFlags)} resolutionFlags
      (EnumSet/noneOf ModuleResolutionFlags))

    (method ^:public ^:static create ^ModuleSymbol [^Name name ^Name module_info]
      (let [msym (ModuleSymbol. name nil)
            info (ClassSymbol. Flags/MODULE module_info msym)]
        (set! (.-fullname info) (ModuleSymbol/formFullName module_info msym))
        (set! (.-flatname info) (.-fullname info))
        (set! (.-members_field info) (Scope$WriteableScope/create info))
        (set! (.-module_info msym) info)
        msym))

    (constructor ^:public [this ^Name name ^Symbol owner]
      (super. Kinds$Kind/MDL 0 name nil owner)
      (Assert/checkNonNull name)
      (set! (.-type this) (Type$ModuleType. this)))

    (method ^:public poolTag ^int [this] ClassFile/CONSTANT_Module)

    (method ^:public getSimpleName ^Name [this]
      (Convert/shortName (.-name this)))

    (method ^:public isOpen ^boolean [this]
      (.contains flags ModuleFlags/OPEN))

    (method ^:public isUnnamed ^boolean [this]
      (and (.isEmpty (.-name this)) (nil? (.-owner this))))

    (method ^:public isDeprecated ^boolean [this]
      (.hasDeprecatedAnnotation this))

    (method ^:public isNoModule ^boolean [this] false)

    (method ^:public getKind ^ElementKind [this] ElementKind/MODULE)

    (method ^:public getDirectives ^{:tag (java.util.List ModuleElement$Directive)} [this]
      (.apiComplete this)
      (.completeUsesProvides this)
      (Collections/unmodifiableList directives))

    (method ^:public completeUsesProvides ^void [this]
      (when-not (identical? usesProvidesCompleter Completer/NULL_COMPLETER)
        (let [c usesProvidesCompleter]
          (set! usesProvidesCompleter Completer/NULL_COMPLETER)
          (.complete c this))))

    (method ^:public outermostClass ^ClassSymbol [this] nil)

    (method ^:public toString ^String [this]
      (let [^String n (cond
                        (nil? (.-name this)) "<unknown>"
                        (.isEmpty (.-name this)) "<unnamed>"
                        :else (String/valueOf (.-name this)))]
        n))

    (method ^:public accept :type-params [R P] ^R [this ^{:tag (ElementVisitor R P)} v ^P p]
      (.visitModule v this p))

    (method ^:public getEnclosedElements ^{:tag (List Symbol)} [this]
      (let [^:mutable ^{:tag (List Symbol)} list (List/nil)]

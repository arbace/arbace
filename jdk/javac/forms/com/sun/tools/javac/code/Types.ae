  (method ^:private pendingBridges ^boolean [this ^Symbol$ClassSymbol origin ^Symbol$TypeSymbol s]
    (cond
      (and (and (some? (.-classfile origin))
                (identical? (.getKind (.-classfile origin)) JavaFileObject$Kind/CLASS))
           (nil? (.getEnv enter origin)))
        false
      (identical? origin s) true
      :else
        (do
          (for-each [^Type t (.interfaces this (.-type origin))]
            (when (.pendingBridges this (cast Symbol$ClassSymbol (.-tsym t)) s) (return true)))
          false)))

  (defclass DescriptorFilter
    :implements [(Predicate Symbol)]

    (field ^Symbol$TypeSymbol origin)

    (constructor [this ^Symbol$TypeSymbol origin]
      (set! (.-origin this) origin))

    (method ^:public test ^boolean [this ^Symbol sym]
      (and (and (and (identical? (.-kind sym) Kinds$Kind/MTH)
                     (== (bit-and (.flags sym) (bit-or Flags/ABSTRACT Flags/DEFAULT))
                         Flags/ABSTRACT))
                (not (.overridesObjectMethod Types/this origin sym)))
           (== (bit-and (.flags (cast Symbol$MethodSymbol
                                      (.-head (.interfaceCandidates
                                                Types/this
                                                (.-type origin)
                                                (cast Symbol$MethodSymbol sym)))))
                        Flags/DEFAULT)
               0))))

  (method ^:public isSubtypeUnchecked ^boolean [this ^Type t ^Type s]
    (.isSubtypeUnchecked this t s noWarnings))

  (method ^:public isSubtypeUnchecked ^boolean [this ^Type t ^Type s ^Warner warn]
    (let [result (.isSubtypeUncheckedInternal this t s true warn)]
      (when result (.checkUnsafeVarargsConversion this t s warn))
      result))

  (method ^:private isSubtypeUncheckedInternal ^boolean [this ^Type t ^Type s ^boolean capture
                                                         ^Warner warn]
    (cond
      (and (.hasTag t TypeTag/ARRAY) (.hasTag s TypeTag/ARRAY))
        (if (.isPrimitive (.-elemtype (cast Type$ArrayType t)))
            (.isSameType this (.elemtype this t) (.elemtype this s))
            (.isSubtypeUncheckedInternal this (.elemtype this t) (.elemtype this s) false warn))
      (.isSubtype this t s capture) true
      (.hasTag t TypeTag/TYPEVAR) (.isSubtypeUncheckedInternal this (.getUpperBound t) s false warn)
      :else
        (do
          (when-not (.isRaw s)
            (let [t2 (.asSuper this t (.-tsym s))]
              (when (and (some? t2) (.isRaw t2))
                (if (.isReifiable this s)
                    (.silentWarn warn Lint$LintCategory/UNCHECKED)
                    (.warn warn Lint$LintCategory/UNCHECKED))
                (return true))))
          false)))

  (method ^:private checkUnsafeVarargsConversion ^void [this ^Type t ^Type s ^Warner warn]
    (when-not (or (not (.hasTag t TypeTag/ARRAY)) (.isReifiable this t))
      (let [from (cast Type$ArrayType t)
            ^:mutable shouldWarn false]
        (switch (.getTag s)
          ARRAY
            (let [to (cast Type$ArrayType s)]
              (set! shouldWarn
                    (and (and (.isVarargs from) (not (.isVarargs to)))
                         (not (.isReifiable this from)))))
          CLASS (set! shouldWarn (.isVarargs from)))
        (when shouldWarn (.warn warn Lint$LintCategory/VARARGS)))))

  (method ^:public ^:final isSubtype ^boolean [this ^Type t ^Type s]
    (.isSubtype this t s true))

  (method ^:public ^:final isSubtypeNoCapture ^boolean [this ^Type t ^Type s]
    (.isSubtype this t s false))

  (method ^:public isSubtype ^boolean [this ^Type t ^Type s ^boolean capture]
    (cond
      (.equalsIgnoreMetadata t s) true
      (.isPartial s) (.isSuperType this s t)
      (.isCompound s)
        (do
          (for-each [^Type s2 (.prepend (.interfaces this s) (.supertype this s))]
            (when-not (.isSubtype this t s2 capture) (return false)))
          true)
      :else
        (do
          (when (and (not (.hasTag t TypeTag/UNDETVAR)) (not (.isCompound t)))
            (let [lower (.cvarLowerBound this (.wildLowerBound this s))]
              (when (and (not (identical? s lower)) (not (.hasTag lower TypeTag/BOT)))
                (return (.isSubtype this ^Type (if capture (.capture this t) t) lower false)))))
          (.booleanValue (cast Boolean (.visit isSubtype ^Type (if capture (.capture this t) t) s))))))

  (field ^:private ^TypeRelation isSubtype
    (anon TypeRelation []
      (method ^:public visitType ^Boolean [this ^Type t ^Type s]
        (switch (.getTag t)
          BYTE (and (not (.hasTag s TypeTag/CHAR)) (.isSubRangeOf (.getTag t) (.getTag s)))
          CHAR (and (not (.hasTag s TypeTag/SHORT)) (.isSubRangeOf (.getTag t) (.getTag s)))
          (SHORT INT LONG FLOAT DOUBLE) (.isSubRangeOf (.getTag t) (.getTag s))
          (BOOLEAN VOID) (.hasTag t (.getTag s))
          TYPEVAR (.isSubtypeNoCapture Types/this (.getUpperBound t) s)
          BOT
            (or (or (or (.hasTag s TypeTag/BOT) (.hasTag s TypeTag/CLASS))
                    (.hasTag s TypeTag/ARRAY))
                (.hasTag s TypeTag/TYPEVAR))
          (WILDCARD NONE) false
          (throw (AssertionError. (java-str "isSubtype " (.getTag t))))))

      (field ^:private ^{:tag (Set TypePair)} cache (HashSet.))

      (method ^:private containsTypeRecursive ^boolean [this ^Type t ^Type s]
        (let [pair (TypePair. t s)]
          (if (.add cache pair)
              (try
                (.containsType Types/this (.getTypeArguments t) (.getTypeArguments s))
                (finally (.remove cache pair)))
              (.containsType Types/this
                             (.getTypeArguments t)
                             (.getTypeArguments (.rewriteSupers this s))))))

      (method ^:private rewriteSupers ^Type [this ^Type t]
        (if (not (.isParameterized t))
            t
            (let [^{:tag (ListBuffer Type)} from (ListBuffer.)
                  ^{:tag (ListBuffer Type)} to (ListBuffer.)]
              (.adaptSelf Types/this t from to)
              (if (.isEmpty from)
                  t
                  (let [^{:tag (ListBuffer Type)} rewrite (ListBuffer.)
                        ^:mutable changed false]
                    (for-each [^Type orig (.toList to)]
                      (let [^:mutable s (.rewriteSupers this orig)]
                        (if (and (.isSuperBound s) (not (.isExtendsBound s)))
                            (do
                              (set! s
                                    (Type$WildcardType.
                                      (.-objectType syms)
                                      BoundKind/UNBOUND
                                      (.-boundClass syms)
                                      (.getMetadata s)))
                              (set! changed true))
                            (when-not (identical? s orig)
                              (set! s
                                    (Type$WildcardType.
                                      (.wildUpperBound Types/this s)
                                      BoundKind/EXTENDS
                                      (.-boundClass syms)
                                      (.getMetadata s)))
                              (set! changed true)))
                        (.append rewrite s)))
                    (if changed
                        (.subst Types/this (.-type (.-tsym t)) (.toList from) (.toList rewrite))
                        t))))))

      (method ^:public visitClassType ^Boolean [this ^Type$ClassType t ^Type s]
        (let [sup (.asSuper Types/this t (.-tsym s))]
          (cond
            (nil? sup) false
            (not (.hasTag sup TypeTag/CLASS)) (.isSubtypeNoCapture Types/this sup s)
            :else
              (and (and (identical? (.-tsym sup) (.-tsym s))
                        (or (not (.isParameterized s)) (.containsTypeRecursive this s sup)))
                   (.isSubtypeNoCapture Types/this (.getEnclosingType sup) (.getEnclosingType s))))))

      (method ^:public visitArrayType ^Boolean [this ^Type$ArrayType t ^Type s]
        (cond
          (.hasTag s TypeTag/ARRAY)
            (if (.isPrimitive (.-elemtype t))
                (.isSameType Types/this (.-elemtype t) (.elemtype Types/this s))
                (.isSubtypeNoCapture Types/this (.-elemtype t) (.elemtype Types/this s)))
          (.hasTag s TypeTag/CLASS)
            (let [sname (.getQualifiedName (.-tsym s))]
              (or (or (identical? sname (.-java_lang_Object names))
                      (identical? sname (.-java_lang_Cloneable names)))
                  (identical? sname (.-java_io_Serializable names))))
          :else false))

      (method ^:public visitUndetVar ^Boolean [this ^Type$UndetVar t ^Type s]
        (cond
          (or (or (identical? t s) (identical? (.-qtype t) s)) (.hasTag s TypeTag/ERROR)) true
          (.hasTag s TypeTag/BOT) false
          :else (do (.addBound t Type$UndetVar$InferenceBound/UPPER s Types/this) true)))

      (method ^:public visitErrorType ^Boolean [this ^Type$ErrorType t ^Type s]
        true)))

  (method ^:public isSubtypeUnchecked ^boolean [this ^Type t ^{:tag (List Type)} ts ^Warner warn]
    (loop [^{:tag (List Type)} l ts]
      (if (.nonEmpty l)
          (if (not (.isSubtypeUnchecked this t (cast Type (.-head l)) warn))
              (return false)
              (recur (.-tail l)))
          nil))
    true)

  (method ^:public isSubtypes ^boolean [this ^:mutable ^{:tag (List Type)} ts
                                        ^:mutable ^{:tag (List Type)} ss]
    (while (and (and (some? (.-tail ts)) (some? (.-tail ss)))
                (.isSubtype this (cast Type (.-head ts)) (cast Type (.-head ss))))
      (set! ts (.-tail ts))
      (set! ss (.-tail ss)))
    (and (nil? (.-tail ts)) (nil? (.-tail ss))))

  (method ^:public isSubtypesUnchecked ^boolean [this ^:mutable ^{:tag (List Type)} ts
                                                 ^:mutable ^{:tag (List Type)} ss ^Warner warn]
    (while (and (and (some? (.-tail ts)) (some? (.-tail ss)))
                (.isSubtypeUnchecked this (cast Type (.-head ts)) (cast Type (.-head ss)) warn))
      (set! ts (.-tail ts))
      (set! ss (.-tail ss)))
    (and (nil? (.-tail ts)) (nil? (.-tail ss))))

  (method ^:public isSuperType ^boolean [this ^Type t ^Type s]
    (switch (.getTag t)
      ERROR true
      UNDETVAR
        (let [undet (cast Type$UndetVar t)]
          (if (or (or (or (identical? t s) (identical? (.-qtype undet) s))
                      (.hasTag s TypeTag/ERROR))
                  (.hasTag s TypeTag/BOT))
              true
              (do (.addBound undet Type$UndetVar$InferenceBound/LOWER s this) true)))
      (.isSubtype this s t)))

  (method ^:public isSameTypes ^boolean [this ^:mutable ^{:tag (List Type)} ts
                                         ^:mutable ^{:tag (List Type)} ss]
    (while (and (and (some? (.-tail ts)) (some? (.-tail ss)))
                (.isSameType this (cast Type (.-head ts)) (cast Type (.-head ss))))
      (set! ts (.-tail ts))
      (set! ss (.-tail ss)))
    (and (nil? (.-tail ts)) (nil? (.-tail ss))))

  (method ^:public isSignaturePolymorphic ^boolean [this ^Symbol$MethodSymbol msym]
    (let [^{:tag (List Type)} argtypes (.getParameterTypes (.-type msym))]
      (and (and (and (and (not (== (bit-and (.-flags_field msym) Flags/NATIVE) 0))
                          (or (identical? (.-owner msym) (.-tsym (.-methodHandleType syms)))
                              (identical? (.-owner msym) (.-tsym (.-varHandleType syms)))))
                     (== (.length argtypes) 1))
                (.hasTag (cast Type (.-head argtypes)) TypeTag/ARRAY))
           (identical? (.-tsym (.-elemtype (cast Type$ArrayType (.-head argtypes))))
                       (.-tsym (.-objectType syms))))))

  (method ^:public isSameType ^boolean [this ^Type t ^Type s]
    (.booleanValue (cast Boolean (.visit isSameTypeVisitor t s))))

  (defclass ^:abstract TypeEqualityVisitor
    :extends TypeRelation

    (method ^:public visitType ^Boolean [this ^Type t ^Type s]
      (cond
        (.equalsIgnoreMetadata t s) true
        (.isPartial s) (cast Boolean (.visit this s t))
        :else
          (switch (.getTag t)
            (BYTE CHAR SHORT INT LONG FLOAT DOUBLE BOOLEAN VOID BOT NONE) (.hasTag t (.getTag s))
            TYPEVAR
              (if (.hasTag s TypeTag/TYPEVAR)
                  (identical? t s)
                  (and
                    (and (.isSuperBound s) (not (.isExtendsBound s)))
                    (.booleanValue (cast Boolean (.visit this t (.wildUpperBound Types/this s))))))
            (throw (AssertionError. (java-str "isSameType " (.getTag t)))))))

    (method ^:public visitWildcardType ^Boolean [this ^Type$WildcardType t ^Type s]
      (if (not (.hasTag s TypeTag/WILDCARD))
          false
          (let [t2 (cast Type$WildcardType s)]
            (and (or (identical? (.-kind t) (.-kind t2))
                     (and (.isExtendsBound t) (.isExtendsBound s)))
                 (.sameTypeComparator this (.-type t) (.-type t2))))))

    (method ^:abstract sameTypeComparator ^boolean [this ^Type t ^Type s])

    (method ^:public visitClassType ^Boolean [this ^Type$ClassType t ^Type s]
      (cond
        (identical? t s) true
        (.isPartial s) (cast Boolean (.visit this s t))
        (and (.isSuperBound s) (not (.isExtendsBound s)))
          (and (.booleanValue (cast Boolean (.visit this t (.wildUpperBound Types/this s))))
               (.booleanValue (cast Boolean (.visit this t (.wildLowerBound Types/this s)))))
        (and (.isCompound t) (.isCompound s))
          (if (not (.booleanValue
                     (cast Boolean
                           (.visit this (.supertype Types/this t) (.supertype Types/this s)))))
              false
              (let [^{:tag (Map Symbol Type)} tMap (HashMap.)]
                (for-each [^Type ti (.interfaces Types/this t)] (.put tMap (.-tsym ti) ti))
                (for-each [^Type si (.interfaces Types/this s)]
                  (when-not (.containsKey tMap (.-tsym si)) (return false))
                  (let [ti (cast Type (.remove tMap (.-tsym si)))]
                    (when-not (.booleanValue (cast Boolean (.visit this ti si))) (return false))))
                (.isEmpty tMap)))
        :else
          (and (and (identical? (.-tsym t) (.-tsym s))
                    (.booleanValue
                      (cast Boolean (.visit this (.getEnclosingType t) (.getEnclosingType s)))))
               (.sameTypeArguments this (.getTypeArguments t) (.getTypeArguments s)))))

    (method ^:abstract sameTypeArguments ^boolean [this ^{:tag (List Type)} ts
                                                   ^{:tag (List Type)} ss])

    (method ^:public visitArrayType ^Boolean [this ^Type$ArrayType t ^Type s]
      (cond
        (identical? t s) true
        (.isPartial s) (cast Boolean (.visit this s t))
        :else
          (and (.hasTag s TypeTag/ARRAY)
               (.containsTypeEquivalent Types/this (.-elemtype t) (.elemtype Types/this s)))))

    (method ^:public visitMethodType ^Boolean [this ^Type$MethodType t ^Type s]
      (and (.hasSameArgs Types/this t s)
           (.booleanValue (cast Boolean (.visit this (.getReturnType t) (.getReturnType s))))))

    (method ^:public visitPackageType ^Boolean [this ^Type$PackageType t ^Type s]
      (identical? t s))

    (method ^:public visitForAll ^Boolean [this ^Type$ForAll t ^Type s]
      (if (not (.hasTag s TypeTag/FORALL))
          false
          (let [forAll (cast Type$ForAll s)]
            (and
              (.hasSameBounds Types/this t forAll)
              (.booleanValue
                (cast Boolean
                      (.visit this
                              (.-qtype t)
                              (.subst Types/this (.-qtype forAll) (.-tvars forAll) (.-tvars t)))))))))

    (method ^:public visitUndetVar ^Boolean [this ^Type$UndetVar t ^Type s]
      (cond
        (.hasTag s TypeTag/WILDCARD) false
        (or (or (identical? t s) (identical? (.-qtype t) s)) (.hasTag s TypeTag/ERROR)) true
        :else (do (.addBound t Type$UndetVar$InferenceBound/EQ s Types/this) true)))

    (method ^:public visitErrorType ^Boolean [this ^Type$ErrorType t ^Type s]
      true))

  (field ^TypeEqualityVisitor isSameTypeVisitor
    (anon TypeEqualityVisitor []
      (method sameTypeComparator ^boolean [this ^Type t ^Type s]
        (.isSameType Types/this t s))

      (method sameTypeArguments ^boolean [this ^{:tag (List Type)} ts ^{:tag (List Type)} ss]
        (.containsTypeEquivalent Types/this ts ss))))

  (method ^:public containedBy ^boolean [this ^Type t ^Type s]
    (switch (.getTag t)
      UNDETVAR
        (if (.hasTag s TypeTag/WILDCARD)
            (let [undetvar (cast Type$UndetVar t)
                  wt (cast Type$WildcardType s)]
              (switch (.-kind wt)
                UNBOUND nil
                EXTENDS
                  (let [bound (.wildUpperBound this s)]
                    (.addBound undetvar Type$UndetVar$InferenceBound/UPPER bound this))
                SUPER
                  (let [bound (.wildLowerBound this s)]
                    (.addBound undetvar Type$UndetVar$InferenceBound/LOWER bound this)))
              true)
            (.isSameType this t s))
      ERROR true
      (.containsType this s t)))

  (method containsType ^boolean [this ^:mutable ^{:tag (List Type)} ts
                                 ^:mutable ^{:tag (List Type)} ss]
    (while (and (and (.nonEmpty ts) (.nonEmpty ss))
                (.containsType this (cast Type (.-head ts)) (cast Type (.-head ss))))
      (set! ts (.-tail ts))
      (set! ss (.-tail ss)))
    (and (.isEmpty ts) (.isEmpty ss)))

  (method ^:public containsType ^boolean [this ^Type t ^Type s]
    (.booleanValue (cast Boolean (.visit containsType t s))))

  (field ^:private ^TypeRelation containsType
    (anon TypeRelation []
      (method ^:public visitType ^Boolean [this ^Type t ^Type s]
        (if (.isPartial s) (.containedBy Types/this s t) (.isSameType Types/this t s)))

      (method ^:public visitWildcardType ^Boolean [this ^Type$WildcardType t ^Type s]
        (if (.isPartial s)
            (.containedBy Types/this s t)
            (or (or (.isSameWildcard Types/this t s) (.isCaptureOf Types/this s t))
                (and (or (.isExtendsBound t)
                         (.isSubtypeNoCapture Types/this
                                              (.wildLowerBound Types/this t)
                                              (.wildLowerBound Types/this s)))
                     (or (.isSuperBound t)
                         (.isSubtypeNoCapture Types/this
                                              (.wildUpperBound Types/this s)
                                              (.wildUpperBound Types/this t)))))))

      (method ^:public visitUndetVar ^Boolean [this ^Type$UndetVar t ^Type s]
        (if (not (.hasTag s TypeTag/WILDCARD)) (.isSameType Types/this t s) false))

      (method ^:public visitErrorType ^Boolean [this ^Type$ErrorType t ^Type s]
        true)))

  (method ^:public isCaptureOf ^boolean [this ^Type s ^Type$WildcardType t]
    (if (or (not (.hasTag s TypeTag/TYPEVAR)) (not (.isCaptured (cast Type$TypeVar s))))
        false
        (.isSameWildcard this t (.-wildcard (cast Type$CapturedType s)))))

  (method ^:public isSameWildcard ^boolean [this ^Type$WildcardType t ^Type s]
    (if (not (.hasTag s TypeTag/WILDCARD))
        false
        (let [w (cast Type$WildcardType s)]
          (and (identical? (.-kind w) (.-kind t)) (identical? (.-type w) (.-type t))))))

  (method ^:public containsTypeEquivalent ^boolean [this ^:mutable ^{:tag (List Type)} ts
                                                    ^:mutable ^{:tag (List Type)} ss]
    (while (and (and (.nonEmpty ts) (.nonEmpty ss))
                (.containsTypeEquivalent this (cast Type (.-head ts)) (cast Type (.-head ss))))
      (set! ts (.-tail ts))
      (set! ss (.-tail ss)))
    (and (.isEmpty ts) (.isEmpty ss)))

  (method ^:public isCastable ^boolean [this ^Type t ^Type s]
    (.isCastable this t s noWarnings))

  (method ^:public isCastable ^boolean [this ^:mutable ^Type t ^Type s ^Warner warn]
    (cond
      (identical? t s) true
      (not (= (.isPrimitive t) (.isPrimitive s)))
        (do
          (set! t (.skipTypeVars this t false))
          (or (.isConvertible this t s warn)
              (and (.isPrimitive s) (.isSubtype this (.-type (.boxedClass this s)) t))))
      :else
        (let [^:mutable ^boolean result false]
          (if (not (identical? warn (.-head warnStack)))
              (try
                (set! warnStack (.prepend warnStack warn))
                (.checkUnsafeVarargsConversion this t s warn)
                (set! result (.booleanValue (cast Boolean (.visit isCastable t s))))
                (finally (set! warnStack (.-tail warnStack))))
              (set! result (.booleanValue (cast Boolean (.visit isCastable t s)))))
          (if (and (and (and (and (and result (.hasTag t TypeTag/CLASS))
                                  (.matches (.-kind (.-tsym t)) Kinds$KindSelector/TYP))
                             (.hasTag s TypeTag/CLASS))
                        (.matches (.-kind (.-tsym s)) Kinds$KindSelector/TYP))
                   (or (.isSealed (.-tsym t)) (.isSealed (.-tsym s))))
              (if (or (.isCompound t) (.isCompound s))
                  true
                  (not (.areDisjoint (DisjointChecker.)
                                     (cast Symbol$ClassSymbol (.-tsym t))
                                     (cast Symbol$ClassSymbol (.-tsym s)))))
              result))))

  (defclass DisjointChecker
    (field ^{:tag (Set (Pair Symbol$ClassSymbol Symbol$ClassSymbol))} pairsSeen (HashSet.))

    (method ^:private areDisjoint ^boolean [this ^Symbol$ClassSymbol ts ^Symbol$ClassSymbol ss]
      (let [^{:tag (Pair Symbol$ClassSymbol Symbol$ClassSymbol)} newPair (Pair. ts ss)]
        (if (not (.add pairsSeen newPair))
            false
            (do
              (cond
                (not (= (.isInterface ts) (.isInterface ss)))
                  (let [^Symbol$ClassSymbol isym (if (.isInterface ts) ts ss)
                        ^Symbol$ClassSymbol csym (if (identical? isym ts) ss ts)]
                    (when-not (.isSubtype Types/this
                                          (.erasure Types/this (.-type csym))
                                          (.erasure Types/this (.-type isym)))
                      (cond
                        (.isFinal csym) (return true)
                        (.isSealed csym)
                          (return (.areDisjoint this isym (.getPermittedSubclasses csym)))
                        (.isSealed isym)
                          (return (.areDisjoint this csym (.getPermittedSubclasses isym))))))
                (not (.isInterface ts))
                  (return (and (not (.isSubtype Types/this
                                                (.erasure Types/this (.-type ss))
                                                (.erasure Types/this (.-type ts))))
                               (not (.isSubtype Types/this
                                                (.erasure Types/this (.-type ts))
                                                (.erasure Types/this (.-type ss))))))
                (and (not (.isSubtype Types/this
                                      (.erasure Types/this (.-type ts))
                                      (.erasure Types/this (.-type ss))))
                     (not (.isSubtype Types/this
                                      (.erasure Types/this (.-type ss))
                                      (.erasure Types/this (.-type ts)))))
                  (cond
                    (.isSealed ts) (return (.areDisjoint this ss (.getPermittedSubclasses ts)))
                    (.isSealed ss) (return (.areDisjoint this ts (.getPermittedSubclasses ss)))))
              false))))

    (method areDisjoint ^boolean [this ^Symbol$ClassSymbol csym
                                  ^{:tag (List Type)} permittedSubtypes]
      (.allMatch (.stream permittedSubtypes)
                 (lambda Predicate ^boolean [^Type psubtype]
                   (.areDisjoint this csym (cast Symbol$ClassSymbol (.-tsym psubtype)))))))

  (field ^:private ^TypeRelation isCastable
    (anon TypeRelation []
      (method ^:public visitType ^Boolean [this ^Type t ^Type s]
        (if (or (.hasTag s TypeTag/ERROR) (.hasTag t TypeTag/NONE))
            true
            (switch (.getTag t)
              (BYTE CHAR SHORT INT LONG FLOAT DOUBLE) (.isNumeric s)
              BOOLEAN (.hasTag s TypeTag/BOOLEAN)
              VOID false
              BOT (.isSubtype Types/this t s)
              (throw (AssertionError.)))))

      (method ^:public visitWildcardType ^Boolean [this ^Type$WildcardType t ^Type s]
        (.isCastable Types/this (.wildUpperBound Types/this t) s (cast Warner (.-head warnStack))))

      (method ^:public visitClassType ^Boolean [this ^Type$ClassType t ^Type s]
        (cond
          (or (.hasTag s TypeTag/ERROR) (.hasTag s TypeTag/BOT)) true
          (.hasTag s TypeTag/TYPEVAR)
            (if (.isCastable Types/this t (.getUpperBound s) noWarnings)
                (do (.warn (cast Warner (.-head warnStack)) Lint$LintCategory/UNCHECKED) true)
                false)
          (or (.isCompound t) (.isCompound s))
            (if (not (.isCompound t))
                (.visitCompoundType this (cast Type$ClassType s) t true)
                (.visitCompoundType this t s false))
          :else
            (do
              (when (or (.hasTag s TypeTag/CLASS) (.hasTag s TypeTag/ARRAY))
                (let [^:mutable ^boolean upcast false]
                  (when (or (set! upcast
                                  (.isSubtype Types/this
                                              (.erasure Types/this t)
                                              (.erasure Types/this s)))
                            (.isSubtype Types/this (.erasure Types/this s) (.erasure Types/this t)))
                    (cond
                      (and (not upcast) (.hasTag s TypeTag/ARRAY))
                        (do
                          (when-not (.isReifiable Types/this s)
                            (.warn (cast Warner (.-head warnStack)) Lint$LintCategory/UNCHECKED))
                          (return true))
                      (.isRaw s) (return true)
                      :else
                        (when (.isRaw t)
                          (when-not (.isUnbounded Types/this s)
                            (.warn (cast Warner (.-head warnStack)) Lint$LintCategory/UNCHECKED))
                          (return true)))
                    (let [^Type a (if upcast ^Type t s)
                          ^Type b (if upcast s ^Type t)
                          ^:const HIGH true
                          ^:const LOW false
                          ^:const DONT_REWRITE_TYPEVARS false
                          ^:mutable aHigh (.rewriteQuantifiers
                                            Types/this
                                            a
                                            HIGH
                                            DONT_REWRITE_TYPEVARS)
                          ^:mutable aLow (.rewriteQuantifiers
                                           Types/this
                                           a
                                           LOW
                                           DONT_REWRITE_TYPEVARS)
                          ^:mutable bHigh (.rewriteQuantifiers
                                            Types/this
                                            b
                                            HIGH
                                            DONT_REWRITE_TYPEVARS)
                          ^:mutable bLow (.rewriteQuantifiers
                                           Types/this
                                           b
                                           LOW
                                           DONT_REWRITE_TYPEVARS)
                          ^:mutable lowSub (.asSub Types/this bLow (.-tsym aLow))
                          ^:mutable ^Type highSub (when (some? lowSub)
                                                    (.asSub Types/this bHigh (.-tsym aHigh)))]
                      (when (nil? highSub)
                        (let [^:const REWRITE_TYPEVARS true]
                          (set! aHigh (.rewriteQuantifiers Types/this a HIGH REWRITE_TYPEVARS))
                          (set! aLow (.rewriteQuantifiers Types/this a LOW REWRITE_TYPEVARS))
                          (set! bHigh (.rewriteQuantifiers Types/this b HIGH REWRITE_TYPEVARS))
                          (set! bLow (.rewriteQuantifiers Types/this b LOW REWRITE_TYPEVARS))
                          (set! lowSub (.asSub Types/this bLow (.-tsym aLow)))
                          (set! highSub
                                (when (some? lowSub) (.asSub Types/this bHigh (.-tsym aHigh))))))
                      (when (some? highSub)
                        (when-not (and (identical? (.-tsym a) (.-tsym highSub))
                                       (identical? (.-tsym a) (.-tsym lowSub)))
                          (Assert/error (java-str
                                          (.-tsym a)
                                          " != "
                                          (.-tsym highSub)
                                          " != "
                                          (.-tsym lowSub))))
                        (when (and (and (and (not
                                               (.disjointTypes
                                                 Types/this
                                                 (.allparams aHigh)
                                                 (.allparams highSub)))
                                             (not
                                               (.disjointTypes
                                                 Types/this
                                                 (.allparams aHigh)
                                                 (.allparams lowSub))))
                                        (not (.disjointTypes
                                               Types/this
                                               (.allparams aLow)
                                               (.allparams highSub))))
                                   (not (.disjointTypes
                                          Types/this
                                          (.allparams aLow)
                                          (.allparams lowSub))))
                          (when (if upcast
                                    (.giveWarning Types/this a b)
                                    (.giveWarning Types/this b a))
                            (.warn (cast Warner (.-head warnStack)) Lint$LintCategory/UNCHECKED))
                          (return true)))
                      (if (.isReifiable Types/this s)
                          (return (.isSubtypeUnchecked Types/this a b))
                          (return (.isSubtypeUnchecked
                                    Types/this
                                    a
                                    b
                                    (cast Warner (.-head warnStack)))))))
                  (when (.hasTag s TypeTag/CLASS)
                    (cond
                      (not (== (bit-and (.flags (.-tsym s)) Flags/INTERFACE) 0))
                        (return
                          (if (== (bit-and (.flags (.-tsym t)) Flags/FINAL) 0)
                              (.sideCast Types/this t s (cast Warner (.-head warnStack)))
                              (.sideCastFinal Types/this t s (cast Warner (.-head warnStack)))))
                      (not (== (bit-and (.flags (.-tsym t)) Flags/INTERFACE) 0))
                        (return
                          (if (== (bit-and (.flags (.-tsym s)) Flags/FINAL) 0)
                              (.sideCast Types/this t s (cast Warner (.-head warnStack)))
                              (.sideCastFinal Types/this t s (cast Warner (.-head warnStack)))))
                      :else (return false)))))
              false)))

      (method visitCompoundType ^boolean [this ^Type$ClassType ct ^Type s ^boolean reverse]
        (let [warn noWarnings]
          (for-each [^Type c (.directSupertypes Types/this ct)]
            (.clear warn)
            (when (if reverse
                      (not (.isCastable Types/this s c warn))
                      (not (.isCastable Types/this c s warn)))
              (return false)))
          (when (.hasLint warn Lint$LintCategory/UNCHECKED)
            (.warn (cast Warner (.-head warnStack)) Lint$LintCategory/UNCHECKED))
          true))

      (method ^:public visitArrayType ^Boolean [this ^Type$ArrayType t ^Type s]
        (switch (.getTag s)
          (ERROR BOT) true
          TYPEVAR
            (if (.isCastable Types/this s t noWarnings)
                (do (.warn (cast Warner (.-head warnStack)) Lint$LintCategory/UNCHECKED) true)
                false)
          CLASS (.isSubtype Types/this t s)
          ARRAY
            (if (or (.isPrimitive (.elemtype Types/this t)) (.isPrimitive (.elemtype Types/this s)))
                (.hasTag (.elemtype Types/this t) (.getTag (.elemtype Types/this s)))
                (.isCastable Types/this
                             (.elemtype Types/this t)
                             (.elemtype Types/this s)
                             (cast Warner (.-head warnStack))))
          false))

      (method ^:public visitTypeVar ^Boolean [this ^Type$TypeVar t ^Type s]
        (switch (.getTag s)
          (ERROR BOT) true
          TYPEVAR
            (cond
              (.isSubtype Types/this t s) true
              (.isCastable Types/this (.getUpperBound t) s noWarnings)
                (do (.warn (cast Warner (.-head warnStack)) Lint$LintCategory/UNCHECKED) true)
              :else false)
          (.isCastable Types/this (.getUpperBound t) s (cast Warner (.-head warnStack)))))

      (method ^:public visitErrorType ^Boolean [this ^Type$ErrorType t ^Type s]
        true)))

  (method ^:public disjointTypes ^boolean [this ^:mutable ^{:tag (List Type)} ts
                                           ^:mutable ^{:tag (List Type)} ss]
    (while (and (some? (.-tail ts)) (some? (.-tail ss)))
      (when (.disjointType this (cast Type (.-head ts)) (cast Type (.-head ss))) (return true))
      (set! ts (.-tail ts))
      (set! ss (.-tail ss)))
    false)

  (method ^:public disjointType ^boolean [this ^Type t ^Type s]
    (.booleanValue (cast Boolean (.visit disjointType t s))))

  (field ^:private ^TypeRelation disjointType
    (anon TypeRelation []
      (field ^:private ^{:tag (Set TypePair)} cache (HashSet.))

      (method ^:public visitType ^Boolean [this ^Type t ^Type s]
        (if (.hasTag s TypeTag/WILDCARD)
            (cast Boolean (.visit this s t))
            (or (.notSoftSubtypeRecursive this t s) (.notSoftSubtypeRecursive this s t))))

      (method ^:private isCastableRecursive ^boolean [this ^Type t ^Type s]
        (let [pair (TypePair. t s)]
          (if (.add cache pair)
              (try (.isCastable Types/this t s) (finally (.remove cache pair)))
              true)))

      (method ^:private notSoftSubtypeRecursive ^boolean [this ^Type t ^Type s]
        (let [pair (TypePair. t s)]
          (if (.add cache pair)
              (try (.notSoftSubtype Types/this t s) (finally (.remove cache pair)))
              false)))

      (method ^:public visitWildcardType ^Boolean [this ^Type$WildcardType t ^Type s]
        (cond
          (.isUnbound t) false
          (not (.hasTag s TypeTag/WILDCARD))
            (if (.isExtendsBound t)
                (.notSoftSubtypeRecursive this s (.-type t))
                (.notSoftSubtypeRecursive this (.-type t) s))
          (.isUnbound s) false
          :else
            (do
              (cond
                (.isExtendsBound t)
                  (cond
                    (.isExtendsBound s)
                      (return (not (.isCastableRecursive
                                     this
                                     (.-type t)
                                     (.wildUpperBound Types/this s))))
                    (.isSuperBound s)
                      (return (.notSoftSubtypeRecursive
                                this
                                (.wildLowerBound Types/this s)
                                (.-type t))))
                (.isSuperBound t)
                  (when (.isExtendsBound s)
                    (return (.notSoftSubtypeRecursive
                              this
                              (.-type t)
                              (.wildUpperBound Types/this s)))))
              false)))))

  (method ^:public cvarLowerBounds ^{:tag (List Type)} [this ^{:tag (List Type)} ts]
    (.map ts cvarLowerBoundMapping))

  (field ^:private ^:final ^{:tag (TypeMapping Void)} cvarLowerBoundMapping
    (anon (TypeMapping Void) []
      (method ^:public visitCapturedType ^Type [this ^Type$CapturedType t ^Void _unused]
        (.cvarLowerBound Types/this t))))

  (method ^:public notSoftSubtype ^boolean [this ^Type t ^:mutable ^Type s]
    (cond
      (identical? t s) false
      (.hasTag t TypeTag/TYPEVAR)
        (let [tv (cast Type$TypeVar t)]
          (not (.isCastable this (.getUpperBound tv) (.relaxBound this s) noWarnings)))
      :else
        (do
          (when-not (.hasTag s TypeTag/WILDCARD) (set! s (.cvarUpperBound this s)))
          (not (.isSubtype this t (.relaxBound this s))))))

  (method ^:private relaxBound ^Type [this ^Type t]
    (if (.hasTag t TypeTag/TYPEVAR)
        (.rewriteQuantifiers this (.skipTypeVars this t false) true true)
        t))

  (method ^:public isReifiable ^boolean [this ^Type t]
    (.booleanValue (cast Boolean (.visit isReifiable t))))

  (field ^:private ^{:tag (UnaryVisitor Boolean)} isReifiable
    (anon (UnaryVisitor Boolean) []
      (method ^:public visitType ^Boolean [this ^Type t ^Void ignored] true)

      (method ^:public visitClassType ^Boolean [this ^Type$ClassType t ^Void ignored]
        (cond
          (.isCompound t) false
          (not (.isParameterized t)) true
          :else
            (do
              (for-each [^Type param (.allparams t)] (when-not (.isUnbound param) (return false)))
              true)))

      (method ^:public visitArrayType ^Boolean [this ^Type$ArrayType t ^Void ignored]
        (cast Boolean (.visit this (.-elemtype t))))

      (method ^:public visitTypeVar ^Boolean [this ^Type$TypeVar t ^Void ignored]
        false)))

  (method ^:public isArray ^boolean [this ^:mutable ^Type t]
    (while (.hasTag t TypeTag/WILDCARD) (set! t (.wildUpperBound this t)))
    (.hasTag t TypeTag/ARRAY))

  (method ^:public elemtype ^Type [this ^Type t]
    (switch (.getTag t)
      WILDCARD (.elemtype this (.wildUpperBound this t))
      ARRAY (.-elemtype (cast Type$ArrayType t))
      FORALL (.elemtype this (.-qtype (cast Type$ForAll t)))
      ERROR t
      nil))

  (method ^:public elemtypeOrType ^Type [this ^Type t]
    (let [elemtype (.elemtype this t)] (if (some? elemtype) elemtype t)))

  (field ^:private ^{:tag (TypeMapping Void)} elemTypeFun
    (anon (TypeMapping Void) []
      (method ^:public visitArrayType ^Type [this ^Type$ArrayType t ^Void _unused]
        (.-elemtype t))

      (method ^:public visitTypeVar ^Type [this ^Type$TypeVar t ^Void _unused]
        (.visit this (.skipTypeVars Types/this t false)))))

  (method ^:public dimensions ^int [this ^:mutable ^Type t]
    (let [^:mutable ^int result 0]
      (while (.hasTag t TypeTag/ARRAY)
        (set! result (unchecked-inc-int result))
        (set! t (.elemtype this t)))
      result))

  (method ^:public makeArrayType ^Type$ArrayType [this ^Type t]
    (when (or (.hasTag t TypeTag/VOID) (.hasTag t TypeTag/PACKAGE))
      (Assert/error (java-str "Type t must not be a VOID or PACKAGE type, " (.toString t))))
    (Type$ArrayType. t (.-arrayClass syms)))

  (method ^:public asSuper ^Type [this ^Type t ^Symbol sym]
    (if (identical? (.-type sym) (.-objectType syms))
        (.-objectType syms)
        (cast Type (.visit asSuper t sym))))

  (field ^:private ^{:tag (SimpleVisitor Type Symbol)} asSuper
    (anon (SimpleVisitor Type Symbol) []
      (field ^:private ^{:tag (Set Symbol)} seenTypes (HashSet.))

      (method ^:public visitType ^Type [this ^Type t ^Symbol sym] nil)

      (method ^:public visitClassType ^Type [this ^Type$ClassType t ^Symbol sym]
        (if (identical? (.-tsym t) sym)
            t
            (let [^Symbol c (.-tsym t)]
              (when-not (not (.add seenTypes c))
                (try
                  (let [st (.supertype Types/this t)]
                    (when (or (.hasTag st TypeTag/CLASS) (.hasTag st TypeTag/TYPEVAR))
                      (let [x (.asSuper Types/this st sym)] (when (some? x) (return x))))
                    (when-not (== (bit-and (.flags sym) Flags/INTERFACE) 0)
                      (loop [^{:tag (List Type)} l (.interfaces Types/this t)]
                        (if (.nonEmpty l)
                            (if (not (.hasTag (cast Type (.-head l)) TypeTag/ERROR))
                                (let [x (.asSuper Types/this (cast Type (.-head l)) sym)]
                                  (if (some? x) (return x) (recur (.-tail l))))
                                (recur (.-tail l)))
                            nil)))
                    nil)
                  (finally (.remove seenTypes c)))))))

      (method ^:public visitArrayType ^Type [this ^Type$ArrayType t ^Symbol sym]
        (when (.isSubtype Types/this t (.-type sym)) (.-type sym)))

      (method ^:public visitTypeVar ^Type [this ^Type$TypeVar t ^Symbol sym]
        (if (identical? (.-tsym t) sym) t (.asSuper Types/this (.getUpperBound t) sym)))

      (method ^:public visitErrorType ^Type [this ^Type$ErrorType t ^Symbol sym]
        t)))

  (method ^:public asOuterSuper ^Type [this ^Type t ^Symbol sym]
    (let [^:mutable t1 t]
      (while (not (.hasTag t1 TypeTag/NONE))
        (let [s (.asSuper this t1 sym)]
          (when (some? s) (return s))
          (set! t1 (.getEnclosingType t1))))
      nil))

  (method ^:public asEnclosingSuper ^Type [this ^Type t ^Symbol sym]
    (let [^:mutable t1 t]
      (while (not (.hasTag t1 TypeTag/NONE))
        (let [s (.asSuper this t1 sym)]
          (when (some? s) (return s))
          (set! t1
                (if (some? (.enclClass (.-owner (.-tsym t1))))
                    (.-type (.enclClass (.-owner (.-tsym t1))))
                    Type/noType))))
      nil))

  (method ^:public memberType ^Type [this ^Type t ^Symbol sym]
    (if (not (== (bit-and (.flags sym) Flags/STATIC) 0))
        (.-type sym)
        (cast Type (.visit memberType t sym))))

  (field ^:private ^{:tag (SimpleVisitor Type Symbol)} memberType
    (anon (SimpleVisitor Type Symbol) []
      (method ^:public visitType ^Type [this ^Type t ^Symbol sym]
        (.-type sym))

      (method ^:public visitWildcardType ^Type [this ^Type$WildcardType t ^Symbol sym]
        (.memberType Types/this (.wildUpperBound Types/this t) sym))

      (method ^:public visitClassType ^Type [this ^Type$ClassType t ^Symbol sym]
        (let [owner (.-owner sym)
              flags (.flags sym)]
          (when (and (== (bit-and flags Flags/STATIC) 0) (.isParameterized (.-type owner)))
            (let [^:mutable base (.asOuterSuper Types/this t owner)]
              (set! base (if (.isCompound t) (.capture Types/this base) base))
              (when (some? base)
                (let [^{:tag (List Type)} ownerParams (.allparams (.-type owner))
                      ^{:tag (List Type)} baseParams (.allparams base)]
                  (when (.nonEmpty ownerParams)
                    (if (.isEmpty baseParams)
                        (return (.erasure Types/this (.-type sym)))
                        (return (.subst Types/this (.-type sym) ownerParams baseParams))))))))
          (.-type sym)))

      (method ^:public visitTypeVar ^Type [this ^Type$TypeVar t ^Symbol sym]
        (.memberType Types/this (.getUpperBound t) sym))

      (method ^:public visitErrorType ^Type [this ^Type$ErrorType t ^Symbol sym]
        t)))

  (method ^:public isAssignable ^boolean [this ^Type t ^Type s]
    (.isAssignable this t s noWarnings))

  (method ^:public isAssignable ^boolean [this ^Type t ^Type s ^Warner warn]
    (if (.hasTag t TypeTag/ERROR)
        true
        (do
          (when (and (.isSubRangeOf (.getTag t) TypeTag/INT) (some? (.constValue t)))
            (let [value (.intValue (cast Number (.constValue t)))]
              (switch (.getTag s)
                (BYTE CHAR SHORT INT) (when (.checkRange (.getTag s) value) (return true))
                CLASS
                  (switch (.getTag (.unboxedType this s))
                    (BYTE CHAR SHORT) (return (.isAssignable this t (.unboxedType this s) warn))))))
          (.isConvertible this t s warn))))

  (method ^:public erasure ^Type [this ^Type t]
    (if (.eraseNotNeeded this t) t (.erasure this t false)))

  (method ^:private eraseNotNeeded ^boolean [this ^Type t]
    (or (.isPrimitive t) (identical? (.-tsym (.-stringType syms)) (.-tsym t))))

  (method ^:private erasure ^Type [this ^Type t ^boolean recurse]
    (if (.isPrimitive t) t (let [out (cast Type (.visit erasure t recurse))] out)))

  (field ^:private ^{:tag (TypeMapping Boolean)} erasure
    (anon (Type$StructuralTypeMapping Boolean) []
      (method ^:private combineMetadata ^Type [this ^:final ^Type s ^:final ^Type t]
        (if (.nonEmpty (.getMetadata t))
            (switch (.getTag s)
              CLASS
                (if (or (instance? Type$UnionClassType s) (instance? Type$IntersectionClassType s))
                    s
                    (.dropMetadata s TypeMetadata$Annotations))
              (BYTE CHAR SHORT LONG FLOAT INT DOUBLE BOOLEAN ARRAY MODULE TYPEVAR WILDCARD BOT)
                (.dropMetadata s TypeMetadata$Annotations)
              (VOID METHOD
                    PACKAGE
                    FORALL
                    DEFERRED
                    NONE
                    ERROR
                    UNDETVAR
                    UNINITIALIZED_THIS
                    UNINITIALIZED_OBJECT)
                s
              (throw (AssertionError. (.name (.getTag s)))))
            s))

      (method ^:public visitType ^Type [this ^Type t ^Boolean recurse]
        (if (.isPrimitive t) t (.combineMetadata this t t)))

      (method ^:public visitWildcardType ^Type [this ^Type$WildcardType t ^Boolean recurse]
        (let [erased (.erasure Types/this (.wildUpperBound Types/this t) recurse)]
          (.combineMetadata this erased t)))

      (method ^:public visitClassType ^Type [this ^Type$ClassType t ^Boolean recurse]
        (let [^:mutable erased (.erasure (.-tsym t) Types/this)]
          (if (.booleanValue recurse)
              (do
                (set! erased
                      (Type$ErasedClassType. (.getEnclosingType erased)
                                             (.-tsym erased)
                                             (.getMetadata
                                               (.dropMetadata t TypeMetadata$Annotations))))
                erased)
              (.combineMetadata this erased t))))

      (method ^:public visitTypeVar ^Type [this ^Type$TypeVar t ^Boolean recurse]
        (let [erased (.erasure Types/this (.getUpperBound t) recurse)]
          (.combineMetadata this erased t)))))

  (method ^:public erasure ^{:tag (List Type)} [this ^{:tag (List Type)} ts]
    (.visit erasure ts false))

  (method ^:public erasureRecursive ^Type [this ^Type t]
    (.erasure this t true))

  (method ^:public erasureRecursive ^{:tag (List Type)} [this ^{:tag (List Type)} ts]
    (.visit erasure ts true))

  (method ^:public makeIntersectionType ^Type$IntersectionClassType [this ^{:tag (List Type)} bounds]
    (.makeIntersectionType this bounds (.isInterface (.-tsym (cast Type (.-head bounds))))))

  (method ^:public makeIntersectionType ^Type$IntersectionClassType [this
                                                                     ^:mutable ^{:tag (List Type)} bounds
                                                                     ^boolean allInterfaces]
    (Assert/check (.nonEmpty bounds))
    (let [firstExplicitBound (cast Type (.-head bounds))]
      (when allInterfaces (set! bounds (.prepend bounds (.-objectType syms))))
      (let [bc (Symbol$ClassSymbol.
                 (bit-or-int (bit-or-int (bit-or-int
                                           (bit-or-int Flags/ABSTRACT Flags/PUBLIC)
                                           Flags/SYNTHETIC)
                                         Flags/COMPOUND)
                             Flags/ACYCLIC)
                 ^Name (if Type/moreInfo (.fromString names (.toString bounds)) (.-empty names))
                 nil
                 (.-noSymbol syms))
            intersectionType (Type$IntersectionClassType. bounds bc allInterfaces)]
        (set! (.-type bc) intersectionType)
        (set! (.-erasure_field bc)
              (if (.hasTag (cast Type (.-head bounds)) TypeTag/TYPEVAR)
                  (.-objectType syms)
                  (.erasure this firstExplicitBound)))
        (set! (.-members_field bc) (Scope$WriteableScope/create bc))
        intersectionType)))

  (method ^:public supertype ^Type [this ^Type t]
    (cast Type (.visit supertype t)))

  (field ^:private ^{:tag (UnaryVisitor Type)} supertype
    (anon (UnaryVisitor Type) []
      (method ^:public visitType ^Type [this ^Type t ^Void ignored]
        Type/noType)

      (method ^:public visitClassType ^Type [this ^Type$ClassType t ^Void ignored]
        (when (nil? (.-supertype_field t))
          (let [^:mutable supertype (.getSuperclass (cast Symbol$ClassSymbol (.-tsym t)))]
            (when (.isInterface t)
              (set! supertype (.-supertype_field (cast Type$ClassType (.-type (.-tsym t))))))
            (when (nil? (.-supertype_field t))
              (let [^{:tag (List Type)} actuals (.allparams (.classBound Types/this t))
                    ^{:tag (List Type)} formals (.allparams (.-type (.-tsym t)))]
                (cond
                  (.hasErasedSupertypes t)
                    (set! (.-supertype_field t) (.erasureRecursive Types/this supertype))
                  (.nonEmpty formals)
                    (set! (.-supertype_field t) (.subst Types/this supertype formals actuals))
                  :else (set! (.-supertype_field t) supertype))))))
        (.-supertype_field t))

      (method ^:public visitTypeVar ^Type [this ^Type$TypeVar t ^Void ignored]
        (if (or
              (.hasTag (.getUpperBound t) TypeTag/TYPEVAR)
              (and (not (.isCompound (.getUpperBound t))) (not (.isInterface (.getUpperBound t)))))
            (.getUpperBound t)
            (.supertype Types/this (.getUpperBound t))))

      (method ^:public visitArrayType ^Type [this ^Type$ArrayType t ^Void ignored]
        (if (or (.isPrimitive (.-elemtype t))
                (.isSameType Types/this (.-elemtype t) (.-objectType syms)))
            (.arraySuperType Types/this)
            (Type$ArrayType. (.supertype Types/this (.-elemtype t)) (.-tsym t))))

      (method ^:public visitErrorType ^Type [this ^Type$ErrorType t ^Void ignored]
        Type/noType)))

  (method ^:public interfaces ^{:tag (List Type)} [this ^Type t]
    (cast List (.visit interfaces t)))

  (field ^:private ^{:tag (UnaryVisitor (List Type))} interfaces
    (anon (UnaryVisitor (List Type)) []
      (method ^:public visitType ^{:tag (List Type)} [this ^Type t ^Void ignored]
        (List/nil))

      (method ^:public visitClassType ^{:tag (List Type)} [this ^Type$ClassType t ^Void ignored]
        (when (nil? (.-interfaces_field t))
          (let [^{:tag (List Type)} interfaces (.getInterfaces (cast Symbol$ClassSymbol (.-tsym t)))]
            (when (nil? (.-interfaces_field t))
              (Assert/check (not (identical? t (.-type (.-tsym t)))) t)
              (let [^{:tag (List Type)} actuals (.allparams t)
                    ^{:tag (List Type)} formals (.allparams (.-type (.-tsym t)))]
                (cond
                  (.hasErasedSupertypes t)
                    (set! (.-interfaces_field t) (.erasureRecursive Types/this interfaces))
                  (.nonEmpty formals)
                    (set! (.-interfaces_field t) (.subst Types/this interfaces formals actuals))
                  :else (set! (.-interfaces_field t) interfaces))))))
        (.-interfaces_field t))

      (method ^:public visitTypeVar ^{:tag (List Type)} [this ^Type$TypeVar t ^Void ignored]
        (cond
          (.isCompound (.getUpperBound t)) (.interfaces Types/this (.getUpperBound t))
          (.isInterface (.getUpperBound t)) (List/of (.getUpperBound t))
          :else (List/nil)))))

  (method ^:public directSupertypes ^{:tag (List Type)} [this ^Type t]
    (cast List (.visit directSupertypes t)))

  (field ^:private ^:final ^{:tag (UnaryVisitor (List Type))} directSupertypes
    (anon (UnaryVisitor (List Type)) []
      (method ^:public visitType ^{:tag (List Type)} [this ^:final ^Type type ^:final ^Void ignored]
        (if (not (.isIntersection type))
            (let [sup (.supertype Types/this type)]
              (if (or (or (identical? sup Type/noType) (identical? sup type)) (nil? sup))
                  (.interfaces Types/this type)
                  (.prepend (.interfaces Types/this type) sup)))
            (.getExplicitComponents (cast Type$IntersectionClassType type))))))

  (method ^:public isDirectSuperInterface ^boolean [this ^Symbol$TypeSymbol isym
                                                    ^Symbol$TypeSymbol origin]
    (for-each [^Type i2 (.interfaces this (.-type origin))]
      (when (identical? isym (.-tsym i2)) (return true)))
    false)

  (field ^{:tag (Map Type Boolean)} isDerivedRawCache (HashMap.))

  (method ^:public isDerivedRaw ^boolean [this ^Type t]
    (let [^:mutable result (cast Boolean (.get isDerivedRawCache t))]
      (when (nil? result)
        (set! result (.isDerivedRawInternal this t))
        (.put isDerivedRawCache t result))
      result))

  (method ^:public isDerivedRawInternal ^boolean [this ^Type t]
    (if (.isErroneous t)
        false
        (or (or (.isRaw t)
                (and (not (identical? (.supertype this t) Type/noType))
                     (.isDerivedRaw this (.supertype this t))))
            (.isDerivedRaw this (.interfaces this t)))))

  (method ^:public isDerivedRaw ^boolean [this ^{:tag (List Type)} ts]
    (let [^:mutable ^{:tag (List Type)} l ts]
      (while (and (.nonEmpty l) (not (.isDerivedRaw this (cast Type (.-head l)))))
        (set! l (.-tail l)))
      (.nonEmpty l)))

  (method ^:public setBounds ^void [this ^Type$TypeVar t ^{:tag (List Type)} bounds]
    (.setBounds this t bounds (.isInterface (.-tsym (cast Type (.-head bounds))))))

  (method ^:public setBounds ^void [this ^Type$TypeVar t ^{:tag (List Type)} bounds
                                    ^boolean allInterfaces]
    (.setUpperBound t
                    ^Type (if (.isEmpty (.-tail bounds))
                              (cast Type (.-head bounds))
                              ^Type (.makeIntersectionType this bounds allInterfaces)))
    (set! (.-rank_field t) -1))

  (method ^:public getBounds ^{:tag (List Type)} [this ^Type$TypeVar t]
    (cond
      (.hasTag (.getUpperBound t) TypeTag/NONE) (List/nil)
      (or (.isErroneous (.getUpperBound t)) (not (.isCompound (.getUpperBound t))))
        (List/of (.getUpperBound t))
      (== (bit-and (.flags (.-tsym (.erasure this t))) Flags/INTERFACE) 0)
        (.prepend (.interfaces this t) (.supertype this t))
      :else (.interfaces this t)))

  (method ^:public classBound ^Type [this ^Type t]
    (cast Type (.visit classBound t)))

  (field ^:private ^{:tag (UnaryVisitor Type)} classBound
    (anon (UnaryVisitor Type) []

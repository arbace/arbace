      (for-each [^Symbol$MethodSymbol m1 methods]
        (let [^:mutable isMin_m1 true]
          (for-each [^Symbol$MethodSymbol m2 methods]
            (when-not (identical? m1 m2)
              (when (and (not (identical? (.-owner m2) (.-owner m1)))
                         (some? (.asSuper this (.-type (.-owner m2)) (.-owner m1))))
                (set! isMin_m1 false)
                (break))))
          (when isMin_m1 (.append methodsMin m1))))
      (.toList methodsMin)))


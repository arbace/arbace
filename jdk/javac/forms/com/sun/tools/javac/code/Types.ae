                  (set! newBounds (.toList newBoundsBuf))
                  (for-each [^Type t (.toList newTvars)]
                    (let [tv (cast Type$TypeVar t)]
                      (.setUpperBound tv (cast Type (.-head newBounds)))
                      (set! newBounds (.-tail newBounds))))

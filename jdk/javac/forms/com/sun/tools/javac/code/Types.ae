  (field ^:public ^CandidatesCache candidatesCache (CandidatesCache.))

  (method ^:public interfaceCandidates ^{:tag (List Symbol$MethodSymbol)} [this ^Type site
                                                                           ^Symbol$MethodSymbol ms]
    (let [e (.new candidatesCache Types$CandidatesCache$Entry site ms)
          ^:mutable ^{:tag (List Symbol$MethodSymbol)} candidates (.get candidatesCache e)]
      (when (nil? candidates)
        (let [^{:tag (Predicate Symbol)} filter (MethodFilter. ms site)
              ^:mutable ^{:tag (List Symbol$MethodSymbol)} candidates2 (List/nil)]
          (for-each [^Symbol s (.getSymbols (.membersClosure this site false) filter)]
            (if (and (not (.isInterface (.-tsym site))) (not (.isInterface (.-owner s))))
                (return (List/of (cast Symbol$MethodSymbol s)))
                (when-not (.contains candidates2 s)
                  (set! candidates2 (.prepend candidates2 (cast Symbol$MethodSymbol s))))))
          (set! candidates (.prune this candidates2))
          (.put candidatesCache e candidates)))
      candidates))

  (method ^:public prune ^{:tag (List Symbol$MethodSymbol)} [this
                                                             ^{:tag (List Symbol$MethodSymbol)} methods]

    false)

  (defclass ^:public ^:enum MostSpecificReturnCheck
    (constants
      (BASIC []
             (method ^:public test ^boolean [this ^Type mt1 ^Type mt2 ^Types types]
               (let [^{:tag (List Type)} tvars (.getTypeArguments mt1)
                     ^{:tag (List Type)} svars (.getTypeArguments mt2)
                     t (.getReturnType mt1)
                     s (.subst types (.getReturnType mt2) svars tvars)]
                 (or (.isSameType types t s)
                     (and (and (not (.isPrimitive t)) (not (.isPrimitive s)))
                          (.isSubtype types t s))))))
      (RTS []
           (method ^:public test ^boolean [this ^Type mt1 ^Type mt2 ^Types types]
             (.returnTypeSubstitutable types mt1 mt2))))

    (method ^:public ^:abstract test ^boolean [this ^Type mt1 ^Type mt2 ^Types types]))

  (method ^:public mergeAbstracts ^{:tag (Optional Symbol)} [this
                                                             ^{:tag (List Symbol)} ambiguousInOrder
                                                             ^Type site ^boolean sigCheck]
    (let [^:mutable shouldErase false
          ^{:tag (List Type)} erasedParams (.getParameterTypes
                                             (.erasure (cast Symbol (.-head ambiguousInOrder)) this))]
      (for-each [^Symbol s ambiguousInOrder]
        (cond
          (or (== (bit-and (.flags s) Flags/ABSTRACT) 0)
              (and sigCheck
                   (not (.isSameTypes this erasedParams (.getParameterTypes (.erasure s this))))))
            (return (Optional/empty))
          (.hasTag (.-type s) TypeTag/FORALL) (set! shouldErase true)))
      (for-each [^MostSpecificReturnCheck mostSpecificReturnCheck (MostSpecificReturnCheck/values)]
        (label :outer
          (for-each [^Symbol s ambiguousInOrder]
            (let [mt (.memberType this site s)
                  ^:mutable ^{:tag (List Type)} allThrown (.getThrownTypes mt)]
              (for-each [^Symbol s2 ambiguousInOrder]
                (when-not (identical? s s2)
                  (let [mt2 (.memberType this site s2)]
                    (if (or (not (.isSubSignature this mt mt2))
                            (not (.test mostSpecificReturnCheck mt mt2 this)))
                        (continue :outer)
                        (let [^:mutable ^{:tag (List Type)} thrownTypes2 (.getThrownTypes mt2)]
                          (if (and (not (.hasTag mt TypeTag/FORALL)) shouldErase)
                              (set! thrownTypes2 (.erasure this thrownTypes2))
                              (when (.hasTag mt TypeTag/FORALL)
                                (Assert/check (.hasTag mt2 TypeTag/FORALL))
                                (set! thrownTypes2
                                      (.subst this
                                              thrownTypes2
                                              (.getTypeArguments mt2)
                                              (.getTypeArguments mt)))))
                          (set! allThrown (.intersect chk allThrown thrownTypes2)))))))
              (return (if (identical? allThrown (.getThrownTypes mt))
                          (Optional/of s)
                          (Optional/of (anon Symbol$MethodSymbol [(.flags s)
                                                                  (.-name s)
                                                                  (.createMethodTypeWithThrown
                                                                    this
                                                                    (.-type s)
                                                                    allThrown)
                                                                  (.-owner s)]
                                         (method ^:public baseSymbol ^Symbol [this] s)))))))))
      (Optional/empty)))

  (defclass ImplementationCache
    (field ^:private ^{:tag (WeakHashMap Symbol$MethodSymbol (SoftReference (Map Symbol$TypeSymbol Entry)))} _map
      (WeakHashMap.))

    (defclass Entry
      (field ^:final ^Symbol$MethodSymbol cachedImpl)

      (field ^:final ^{:tag (Predicate Symbol)} implFilter)

      (field ^:final ^boolean checkResult)

      (field ^:final ^int prevMark)

      (constructor ^:public [this ^Symbol$MethodSymbol cachedImpl
                             ^{:tag (Predicate Symbol)} scopeFilter ^boolean checkResult
                             ^int prevMark]
        (set! (.-cachedImpl this) cachedImpl)
        (set! (.-implFilter this) scopeFilter)
        (set! (.-checkResult this) checkResult)
        (set! (.-prevMark this) prevMark))

      (method matches ^boolean [this ^{:tag (Predicate Symbol)} scopeFilter ^boolean checkResult
                                ^int mark]
        (and (and (identical? (.-implFilter this) scopeFilter) (= (.-checkResult this) checkResult))
             (== (.-prevMark this) mark))))

    (method get ^Symbol$MethodSymbol [this ^Symbol$MethodSymbol ms ^Symbol$TypeSymbol origin
                                      ^boolean checkResult ^{:tag (Predicate Symbol)} implFilter]
      (let [^{:tag (SoftReference (Map Symbol$TypeSymbol Entry))} ref_cache (cast
                                                                              SoftReference
                                                                              (.get _map ms))
            ^:mutable ^{:tag (Map Symbol$TypeSymbol Entry)} cache (when (some? ref_cache)
                                                                    (cast Map (.get ref_cache)))]
        (when (nil? cache) (set! cache (HashMap.)) (.put _map ms (SoftReference. cache)))
        (let [e (cast Entry (.get cache origin))
              members (.membersClosure Types/this (.-type origin) true)]
          (if (or (nil? e) (not (.matches e implFilter checkResult (.getMark members))))
              (let [impl (.implementationInternal this ms origin checkResult implFilter)]
                (.put cache origin (Entry. impl implFilter checkResult (.getMark members)))
                impl)
              (.-cachedImpl e)))))

    (method ^:private implementationInternal ^Symbol$MethodSymbol [this ^Symbol$MethodSymbol ms
                                                                   ^Symbol$TypeSymbol origin
                                                                   ^boolean checkResult
                                                                   ^{:tag (Predicate Symbol)} implFilter]
      (let [^:mutable t (.-type origin)]
        (while (or (.hasTag t TypeTag/CLASS) (.hasTag t TypeTag/TYPEVAR))
          (set! t (.skipTypeVars Types/this t false))
          (let [c (.-tsym t)
                ^:mutable ^Symbol bestSoFar nil]
            (for-each [^Symbol sym (.getSymbolsByName (.members c) (.-name ms) implFilter)]
              (when (and (some? sym) (.overrides sym ms origin Types/this checkResult))
                (set! bestSoFar sym)
                (when (== (bit-and (.flags sym) Flags/ABSTRACT) 0) (break))))
            (when (some? bestSoFar) (return (cast Symbol$MethodSymbol bestSoFar))))
          (set! t (.supertype Types/this t))))
      nil))

  (field ^:private ^ImplementationCache implCache (ImplementationCache.))

  (method ^:public implementation ^Symbol$MethodSymbol [this ^Symbol$MethodSymbol ms
                                                        ^Symbol$TypeSymbol origin
                                                        ^boolean checkResult
                                                        ^{:tag (Predicate Symbol)} implFilter]
    (.get implCache ms origin checkResult implFilter))

  (defclass MembersClosureCache
    :extends (SimpleVisitor Scope$CompoundScope Void)

    (field ^:private ^{:tag (Map Symbol$TypeSymbol Scope$CompoundScope)} _map (HashMap.))

    (field ^{:tag (Set Symbol$TypeSymbol)} seenTypes (HashSet.))

    (defclass MembersScope
      :extends Scope$CompoundScope

      (field ^Scope$CompoundScope scope)

      (constructor ^:public [this ^Scope$CompoundScope scope]
        (super. (.-owner scope))
        (set! (.-scope this) scope))

      (method combine ^{:tag (Predicate Symbol)} [this ^{:tag (Predicate Symbol)} sf]
        (lambda Predicate ^boolean [^Symbol s]
          (and (not (.isInterface (.-owner s))) (or (nil? sf) (.test sf s)))))

      (method ^:public getSymbols ^{:tag (Iterable Symbol)} [this ^{:tag (Predicate Symbol)} sf
                                                             ^Scope$LookupKind lookupKind]
        (.getSymbols scope (.combine this sf) lookupKind))

      (method ^:public getSymbolsByName ^{:tag (Iterable Symbol)} [this ^Name name
                                                                   ^{:tag (Predicate Symbol)} sf
                                                                   ^Scope$LookupKind lookupKind]
        (.getSymbolsByName scope name (.combine this sf) lookupKind))

      (method ^:public getMark ^int [this] (.getMark scope)))

    (field ^Scope$CompoundScope nilScope)

    (method ^:public visitType ^Scope$CompoundScope [this ^Type t ^Void _unused]
      (when (nil? nilScope) (set! nilScope (Scope$CompoundScope. (.-noSymbol syms))))
      nilScope)

    (method ^:public visitClassType ^Scope$CompoundScope [this ^Type$ClassType t ^Void _unused]
      (if (not (.add seenTypes (.-tsym t)))
          (Scope$CompoundScope. (.-tsym t))
          (try
            (.add seenTypes (.-tsym t))
            (let [csym (cast Symbol$ClassSymbol (.-tsym t))
                  ^:mutable membersClosure (cast Scope$CompoundScope (.get _map csym))]
              (when (nil? membersClosure)
                (set! membersClosure (Scope$CompoundScope. csym))
                (for-each [^Type i (.interfaces Types/this t)]
                  (.prependSubScope membersClosure (cast Scope (.visit this i nil))))
                (.prependSubScope membersClosure
                                  (cast Scope (.visit this (.supertype Types/this t) nil)))
                (.prependSubScope membersClosure (.members csym))
                (.put _map csym membersClosure))
              membersClosure)
            (finally (.remove seenTypes (.-tsym t))))))

    (method ^:public visitTypeVar ^Scope$CompoundScope [this ^Type$TypeVar t ^Void _unused]
      (cast Scope$CompoundScope (.visit this (.getUpperBound t) nil))))

  (field ^:private ^MembersClosureCache membersCache (MembersClosureCache.))

  (method ^:public membersClosure ^Scope$CompoundScope [this ^Type site ^boolean skipInterface]
    (let [cs (cast Scope$CompoundScope (.visit membersCache site nil))]
      (Assert/checkNonNull cs (lambda Supplier ^String [] (java-str "type " site)))
      (if skipInterface
          ^Scope$CompoundScope (.new membersCache Types$MembersClosureCache$MembersScope cs)
          cs)))

  (method ^:public firstUnimplementedAbstract ^Symbol$MethodSymbol [this ^Symbol$ClassSymbol sym]
    (try
      (.firstUnimplementedAbstractImpl this sym sym)
      (catch Symbol$CompletionFailure ex
        (.completionError chk (.pos (.-tree (.getEnv enter sym))) ex)
        nil)))

  (method ^:private firstUnimplementedAbstractImpl ^Symbol$MethodSymbol [this
                                                                         ^Symbol$ClassSymbol impl
                                                                         ^Symbol$ClassSymbol c]
    (let [^:mutable ^Symbol$MethodSymbol undef nil]
      (when (or (identical? c impl)
                (not (== (bit-and (.flags c) (bit-or-int Flags/ABSTRACT Flags/INTERFACE)) 0)))
        (let [^Scope s (.members c)]
          (for-each [^Symbol sym (.getSymbols s Scope$LookupKind/NON_RECURSIVE)]
            (when (and (identical? (.-kind sym) Kinds$Kind/MTH)
                       (== (bit-and (.flags sym)
                                    (bit-or (bit-or Flags/ABSTRACT Flags/DEFAULT) Flags/PRIVATE))
                           Flags/ABSTRACT))
              (let [absmeth (cast Symbol$MethodSymbol sym)
                    ^:mutable implmeth (.implementation absmeth impl this true)]
                (when (or (nil? implmeth) (identical? implmeth absmeth))
                  (let [prov (cast Symbol$MethodSymbol
                                   (.-head (.interfaceCandidates this (.-type impl) absmeth)))]
                    (when (and (some? prov) (.overrides prov absmeth impl this true))
                      (set! implmeth prov))))
                (when (or (nil? implmeth) (identical? implmeth absmeth))
                  (set! undef absmeth)
                  (break)))))
          (when (nil? undef)
            (let [st (.supertype this (.-type c))]
              (when (.hasTag st TypeTag/CLASS)
                (set! undef
                      (.firstUnimplementedAbstractImpl
                        this
                        impl
                        (cast Symbol$ClassSymbol (.-tsym st)))))))
          (loop [^{:tag (List Type)} l (.interfaces this (.-type c))]
            (when (and (nil? undef) (.nonEmpty l))
              (set! undef
                    (.firstUnimplementedAbstractImpl
                      this
                      impl
                      (cast Symbol$ClassSymbol (.-tsym (cast Type (.-head l))))))
              (recur (.-tail l))))))
      undef))


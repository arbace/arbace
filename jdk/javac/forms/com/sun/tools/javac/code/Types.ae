  (defclass ^:private Subst
    :extends (Type$StructuralTypeMapping Void)

    (field ^{:tag (List Type)} from)

    (field ^{:tag (List Type)} to)

    (constructor ^:public [this ^:mutable ^{:tag (List Type)} from ^:mutable ^{:tag (List Type)} to]
      (let [^:mutable fromLength (.length from)
            ^:mutable toLength (.length to)]

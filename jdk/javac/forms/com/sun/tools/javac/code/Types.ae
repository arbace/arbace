        tvars
        (let [^{:tag (ListBuffer Type)} newBoundsBuf (ListBuffer.)
              ^:mutable changed false]
          (for-each [^Type t tvars]
            (let [tv (cast Type$TypeVar t)
                  bound (.subst this (.getUpperBound tv) from to)]
              (when-not (identical? bound (.getUpperBound tv)) (set! changed true))
              (.append newBoundsBuf bound)))
          (if (not changed)
              tvars
              (let [^{:tag (ListBuffer Type)} newTvars (ListBuffer.)]
                (for-each [^Type t tvars]
                  (.append newTvars
                           (Type$TypeVar. (.-tsym t) nil (.-botType syms) (.getMetadata t))))
                (let [^:mutable ^{:tag (List Type)} newBounds (.toList newBoundsBuf)]
                  (set! from tvars)

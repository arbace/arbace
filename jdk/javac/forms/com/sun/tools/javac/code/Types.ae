  (field ^:private ^:final ^{:tag (MapVisitor Type)} methodWithReturn
    (anon (MapVisitor Type) []
      (method ^:public visitType ^Type [this ^Type t ^Type newReturn]
        (throw (IllegalArgumentException. (java-str "Not a method type: " t))))

      (method ^:public visitMethodType ^Type [this1 ^Type$MethodType t ^Type newReturn]
        (anon Type$MethodType [(.-argtypes t) newReturn (.-thrown t) (.-tsym t)]
          (method ^:public baseType ^Type [this] t)))

      (method ^:public visitForAll ^Type [this1 ^Type$ForAll t ^Type newReturn]
        (anon Type$ForAll [(.-tvars t) (cast Type (.accept (.-qtype t) this1 newReturn))]
          (method ^:public baseType ^Type [this] t)))))

  (method ^:public createErrorType ^Type [this ^Type originalType]
    (Type$ErrorType. originalType (.-errSymbol syms)))

  (method ^:public createErrorType ^Type [this ^Symbol$ClassSymbol c ^Type originalType]
    (Type$ErrorType. c originalType))

  (method ^:public createErrorType ^Type [this ^Name name ^Symbol$TypeSymbol container
                                          ^Type originalType]
    (Type$ErrorType. name container originalType))

  (method ^:public rank ^int [this ^Type t]
    (switch (.getTag t)
      CLASS
        (let [cls (cast Type$ClassType t)]
          (when (< (.-rank_field cls) 0)
            (let [fullname (.getQualifiedName (.-tsym cls))]
              (if (identical? fullname (.-java_lang_Object names))
                  (set! (.-rank_field cls) 0)
                  (let [^:mutable r (.rank this (.supertype this cls))]
                    (loop [^{:tag (List Type)} l (.interfaces this cls)]
                      (if (.nonEmpty l)
                          (if (> (.rank this (cast Type (.-head l))) r)
                              (do (set! r (.rank this (cast Type (.-head l)))) (recur (.-tail l)))
                              (recur (.-tail l)))
                          nil))
                    (set! (.-rank_field cls) (unchecked-add-int r 1))))))
          (.-rank_field cls))
      TYPEVAR
        (let [tvar (cast Type$TypeVar t)]
          (when (< (.-rank_field tvar) 0)
            (let [^:mutable r (.rank this (.supertype this tvar))]
              (loop [^{:tag (List Type)} l (.interfaces this tvar)]
                (if (.nonEmpty l)
                    (if (> (.rank this (cast Type (.-head l))) r)
                        (do (set! r (.rank this (cast Type (.-head l)))) (recur (.-tail l)))
                        (recur (.-tail l)))
                    nil))
              (set! (.-rank_field tvar) (unchecked-add-int r 1))))
          (.-rank_field tvar))
      (ERROR NONE) 0
      (throw (AssertionError.))))

  (method ^:public toString ^String [this ^Type t ^Locale locale]
    (.visit (Printer/createStandardPrinter messages) t locale))

  (method ^:public toString ^String [this ^Symbol t ^Locale locale]
    (.visit (Printer/createStandardPrinter messages) t locale))

  (method ^:public ^{Deprecated true} toString ^String [this ^Type t]
    (if (.hasTag t TypeTag/FORALL)
        (let [forAll (cast Type$ForAll t)]
          (java-str (.typaramsString this (.-tvars forAll)) (.-qtype forAll)))
        (java-str "" t)))

  (method ^:private typaramsString ^String [this ^{:tag (List Type)} tvars]
    (let [s (StringBuilder.)]
      (.append s \<)
      (let [^:mutable first true]
        (for-each [^Type t tvars]
          (when-not first (.append s ", "))
          (set! first false)
          (.appendTyparamString this (cast Type$TypeVar t) s))
        (.append s \>)
        (.toString s))))

  (method ^:private appendTyparamString ^void [this ^Type$TypeVar t ^StringBuilder buf]
    (.append buf t)
    (when-not (or (nil? (.getUpperBound t))
                  (identical? (.getQualifiedName (.-tsym (.getUpperBound t)))
                              (.-java_lang_Object names)))
      (.append buf " extends ")
      (let [bound (.getUpperBound t)]
        (cond
          (not (.isCompound bound)) (.append buf bound)
          (== (bit-and (.flags (.-tsym (.erasure this t))) Flags/INTERFACE) 0)
            (do
              (.append buf (.supertype this t))
              (for-each [^Type intf (.interfaces this t)] (.append buf \&) (.append buf intf)))
          :else
            (let [^:mutable first true]
              (for-each [^Type intf (.interfaces this t)]
                (when-not first (.append buf \&))
                (set! first false)
                (.append buf intf)))))))

  (field ^:private ^{:tag (Map Type (List Type))} closureCache (HashMap.))

  (method ^:public closure ^{:tag (List Type)} [this ^Type t]
    (let [^:mutable ^{:tag (List Type)} cl (cast List (.get closureCache t))]
      (when (nil? cl)
        (let [st (.supertype this t)]
          (if (not (.isCompound t))
              (cond
                (.hasTag st TypeTag/CLASS) (set! cl (.insert this (.closure this st) t))
                (.hasTag st TypeTag/TYPEVAR) (set! cl (.prepend (.closure this st) t))
                :else (set! cl (List/of t)))
              (set! cl (.closure this (.supertype this t))))
          (loop [^{:tag (List Type)} l (.interfaces this t)]
            (when (.nonEmpty l)
              (set! cl (.union this cl (.closure this (cast Type (.-head l)))))
              (recur (.-tail l))))
          (.put closureCache t cl)))
      cl))

  (method ^:public closureCollector ^{:tag (Collector Type ClosureHolder (List Type))} [this
                                                                                        ^boolean minClosure
                                                                                        ^{:tag (BiPredicate Type Type)} shouldSkip]
    (Collector/of (lambda Supplier ^ClosureHolder [] (ClosureHolder. minClosure shouldSkip))
                  (method-ref BiConsumer [ClosureHolder Type] ClosureHolder/.add)
                  (method-ref BinaryOperator
                              ^ClosureHolder [ClosureHolder ClosureHolder]
                              ClosureHolder/.merge)
                  (method-ref Function ^List [ClosureHolder] ClosureHolder/.closure)
                  (new Collector$Characteristics/1 [])))

  (defclass ClosureHolder
    (field ^{:tag (List Type)} closure)

    (field ^:final ^boolean minClosure)

    (field ^:final ^{:tag (BiPredicate Type Type)} shouldSkip)

    (constructor [this ^boolean minClosure ^{:tag (BiPredicate Type Type)} shouldSkip]
      (set! (.-closure this) (List/nil))
      (set! (.-minClosure this) minClosure)
      (set! (.-shouldSkip this) shouldSkip))

    (method add ^void [this ^Type type]
      (set! closure (.insert Types/this closure type shouldSkip)))

    (method merge ^ClosureHolder [this ^ClosureHolder other]
      (set! closure (.union Types/this closure (.-closure other) shouldSkip))
      this)

    (method closure ^{:tag (List Type)} [this]
      (if minClosure (.closureMin Types/this closure) closure)))

  (field ^{:tag (BiPredicate Type Type)} basicClosureSkip
    (lambda BiPredicate ^boolean [^Type t1 ^Type t2] (identical? (.-tsym t1) (.-tsym t2))))

  (method ^:public insert ^{:tag (List Type)} [this ^{:tag (List Type)} cl ^Type t
                                               ^{:tag (BiPredicate Type Type)} shouldSkip]
    (cond
      (.isEmpty cl) (.prepend cl t)
      (.test shouldSkip t (cast Type (.-head cl))) cl
      (.precedes (.-tsym t) (.-tsym (cast Type (.-head cl))) this) (.prepend cl t)
      :else (.prepend (.insert this (.-tail cl) t shouldSkip) (cast Type (.-head cl)))))

  (method ^:public insert ^{:tag (List Type)} [this ^{:tag (List Type)} cl ^Type t]
    (.insert this cl t basicClosureSkip))

  (method ^:public union ^{:tag (List Type)} [this ^{:tag (List Type)} cl1 ^{:tag (List Type)} cl2
                                              ^{:tag (BiPredicate Type Type)} shouldSkip]
    (cond
      (.isEmpty cl1) cl2
      (.isEmpty cl2) cl1
      (.test shouldSkip (cast Type (.-head cl1)) (cast Type (.-head cl2)))
        (.prepend (.union this (.-tail cl1) (.-tail cl2) shouldSkip) (cast Type (.-head cl1)))
      (.precedes (.-tsym (cast Type (.-head cl2))) (.-tsym (cast Type (.-head cl1))) this)
        (.prepend (.union this cl1 (.-tail cl2) shouldSkip) (cast Type (.-head cl2)))
      :else (.prepend (.union this (.-tail cl1) cl2 shouldSkip) (cast Type (.-head cl1)))))

  (method ^:public union ^{:tag (List Type)} [this ^{:tag (List Type)} cl1 ^{:tag (List Type)} cl2]
    (.union this cl1 cl2 basicClosureSkip))

  (method ^:public intersect ^{:tag (List Type)} [this ^{:tag (List Type)} cl1
                                                  ^{:tag (List Type)} cl2]
    (cond
      (identical? cl1 cl2) cl1
      (or (.isEmpty cl1) (.isEmpty cl2)) (List/nil)
      (.precedes (.-tsym (cast Type (.-head cl1))) (.-tsym (cast Type (.-head cl2))) this)
        (.intersect this (.-tail cl1) cl2)
      (.precedes (.-tsym (cast Type (.-head cl2))) (.-tsym (cast Type (.-head cl1))) this)
        (.intersect this cl1 (.-tail cl2))
      (.isSameType this (cast Type (.-head cl1)) (cast Type (.-head cl2)))
        (.prepend (.intersect this (.-tail cl1) (.-tail cl2)) (cast Type (.-head cl1)))
      :else
        (do
          (when (and (and (identical? (.-tsym (cast Type (.-head cl1)))
                                      (.-tsym (cast Type (.-head cl2))))
                          (.hasTag (cast Type (.-head cl1)) TypeTag/CLASS))
                     (.hasTag (cast Type (.-head cl2)) TypeTag/CLASS))
            (when (and (.isParameterized (cast Type (.-head cl1)))
                       (.isParameterized (cast Type (.-head cl2))))
              (let [merge (.merge this (cast Type (.-head cl1)) (cast Type (.-head cl2)))]
                (return (.prepend (.intersect this (.-tail cl1) (.-tail cl2)) merge))))
            (when (or (.isRaw (cast Type (.-head cl1))) (.isRaw (cast Type (.-head cl2))))
              (return (.prepend (.intersect this (.-tail cl1) (.-tail cl2))
                                (.erasure this (cast Type (.-head cl1)))))))
          (.intersect this (.-tail cl1) (.-tail cl2)))))

  (defclass TypePair
    (field ^:final ^Type t1)

    (field ^:final ^Type t2)

    (constructor [this ^Type t1 ^Type t2]
      (set! (.-t1 this) t1)
      (set! (.-t2 this) t2))

    (method ^:public hashCode ^int [this]
      (unchecked-add-int (unchecked-multiply-int 127 (.hashCode Types/this t1))
                         (.hashCode Types/this t2)))

    (method ^:public equals ^boolean [this obj]
      (if-instance [^TypePair typePair obj]
        (if (.booleanValue (cast Boolean (.visit exactTypeVisitor t1 (.-t1 typePair))))
            (.booleanValue (cast Boolean (.visit exactTypeVisitor t2 (.-t2 typePair))))
            false)
        false)))

  (field ^TypeEqualityVisitor exactTypeVisitor
    (anon TypeEqualityVisitor []
      (method sameTypeArguments ^boolean [this ^:mutable ^{:tag (List Type)} ts
                                          ^:mutable ^{:tag (List Type)} ss]
        (while (and (and (.nonEmpty ts) (.nonEmpty ss))
                    (.sameTypeComparator this (cast Type (.-head ts)) (cast Type (.-head ss))))
          (set! ts (.-tail ts))
          (set! ss (.-tail ss)))
        (and (.isEmpty ts) (.isEmpty ss)))

      (method sameTypeComparator ^boolean [this ^Type t ^Type s]
        (.booleanValue (cast Boolean (.visit exactTypeVisitor t s))))))

  (field ^{:tag (Set TypePair)} mergeCache (HashSet.))

  (method ^:private merge ^Type [this ^Type c1 ^Type c2]
    (let [class1 (cast Type$ClassType c1)
          ^:mutable ^{:tag (List Type)} act1 (.getTypeArguments class1)
          class2 (cast Type$ClassType c2)
          ^:mutable ^{:tag (List Type)} act2 (.getTypeArguments class2)
          ^{:tag (ListBuffer Type)} merged (ListBuffer.)
          ^:mutable ^{:tag (List Type)} typarams (.getTypeArguments (.-type (.-tsym class1)))]
      (while (and (and (.nonEmpty act1) (.nonEmpty act2)) (.nonEmpty typarams))
        (cond
          (.containsType this (cast Type (.-head act1)) (cast Type (.-head act2)))
            (.append merged (cast Type (.-head act1)))
          (.containsType this (cast Type (.-head act2)) (cast Type (.-head act1)))
            (.append merged (cast Type (.-head act2)))
          :else
            (let [pair (TypePair. c1 c2)
                  ^:mutable ^Type m nil]
              (if (.add mergeCache pair)
                  (do
                    (set! m
                          (Type$WildcardType.
                            (.lub this
                                  (new Type/1
                                       [(.wildUpperBound this (cast Type (.-head act1)))
                                        (.wildUpperBound this (cast Type (.-head act2)))]))
                            BoundKind/EXTENDS
                            (.-boundClass syms)))
                    (.remove mergeCache pair))
                  (set! m
                        (Type$WildcardType. (.-objectType syms)
                                            BoundKind/UNBOUND
                                            (.-boundClass syms))))
              (.append merged (.withTypeVar m (cast Type (.-head typarams))))))
        (set! act1 (.-tail act1))
        (set! act2 (.-tail act2))
        (set! typarams (.-tail typarams)))
      (Assert/check (and (and (.isEmpty act1) (.isEmpty act2)) (.isEmpty typarams)))
      (Type$ClassType. (.getEnclosingType class1) (.toList merged) (.-tsym class1))))

  (method ^:private compoundMin ^Type [this ^{:tag (List Type)} cl]
    (if (.isEmpty cl)
        (.-objectType syms)
        (let [^{:tag (List Type)} compound (.closureMin this cl)]
          (when-not (.isEmpty compound)
            (if (.isEmpty (.-tail compound))
                (cast Type (.-head compound))
                (.makeIntersectionType this compound))))))

  (method ^:public closureMin ^{:tag (List Type)} [this ^:mutable ^{:tag (List Type)} cl]
    (let [^{:tag (ListBuffer Type)} classes (ListBuffer.)
          ^{:tag (ListBuffer Type)} interfaces (ListBuffer.)
          ^{:tag (Set Type)} toSkip (HashSet.)]
      (while (not (.isEmpty cl))
        (let [current (cast Type (.-head cl))
              ^:mutable keep (not (.contains toSkip current))]
          (when (and keep (.hasTag current TypeTag/TYPEVAR))
            (for-each [^Type t (.-tail cl)]
              (when (.isSubtypeNoCapture this t current) (set! keep false) (break))))
          (when keep
            (if (.isInterface current) (.append interfaces current) (.append classes current))
            (for-each [^Type t (.-tail cl)]
              (when (.isSubtypeNoCapture this current t) (.add toSkip t))))
          (set! cl (.-tail cl))))
      (.toList (.appendList classes interfaces))))

  (method ^:public lub ^Type [this ^{:tag (List Type)} ts]
    (.lub this (cast Type/1 (.toArray ts (new Type/1 (.length ts))))))

  (method ^:public lub ^Type [this & ^Type/1 ts]
    (let [^:const ^int UNKNOWN_BOUND 0
          ^:const ^int ARRAY_BOUND 1
          ^:const ^int CLASS_BOUND 2
          kinds (new int/1 (alength ts))
          ^:mutable boundkind UNKNOWN_BOUND]
      (loop [^int i 0]
        (when (< i (alength ts))
          (let [^:mutable t (aget ts i)]
            (switch (.getTag t)
              CLASS
                (do
                  (set! boundkind (bit-or-int boundkind (aset kinds i CLASS_BOUND)))
                  (recur (unchecked-inc-int i)))
              ARRAY
                (do
                  (set! boundkind (bit-or-int boundkind (aset kinds i ARRAY_BOUND)))
                  (recur (unchecked-inc-int i)))
              TYPEVAR
                (do
                  (loop [] (set! t (.getUpperBound t)) (when (.hasTag t TypeTag/TYPEVAR) (recur)))
                  (if (.hasTag t TypeTag/ARRAY)
                      (set! boundkind (bit-or-int boundkind (aset kinds i ARRAY_BOUND)))
                      (set! boundkind (bit-or-int boundkind (aset kinds i CLASS_BOUND))))
                  (recur (unchecked-inc-int i)))
              (do
                (aset kinds i UNKNOWN_BOUND)
                (if (.isPrimitive t) (return (.-errType syms)) (recur (unchecked-inc-int i))))))))
      (switch boundkind
        0 (.-botType syms)
        ARRAY_BOUND
          (let [elements (new Type/1 (alength ts))]
            (loop [^int i 0]
              (when (< i (alength ts))
                (let [elem (aset elements i (.apply elemTypeFun (aget ts i)))]
                  (if (.isPrimitive elem)
                      (let [first (aget ts 0)]
                        (loop [^int j 1]
                          (if (< j (alength ts))
                              (if (not (.isSameType this first (aget ts j)))
                                  (return (.arraySuperType this))
                                  (recur (unchecked-inc-int j)))
                              nil))
                        (return first))
                      (recur (unchecked-inc-int i))))))
            (Type$ArrayType. (.lub this elements) (.-arrayClass syms)))
        CLASS_BOUND
          (let [^:mutable ^int startIdx 0]
            (loop [^int i 0]
              (when (< i (alength ts))
                (let [t (aget ts i)]
                  (when-not (or (.hasTag t TypeTag/CLASS) (.hasTag t TypeTag/TYPEVAR))
                    (set! startIdx (unchecked-inc-int startIdx))
                    (recur (unchecked-inc-int i))))))
            (Assert/check (< startIdx (alength ts)))
            (let [^:mutable ^{:tag (List Type)} cl (.erasedSupertypes this (aget ts startIdx))]
              (loop [^int i (unchecked-add-int startIdx 1)]
                (when (< i (alength ts))
                  (let [t (aget ts i)]
                    (if (or (.hasTag t TypeTag/CLASS) (.hasTag t TypeTag/TYPEVAR))
                        (do
                          (set! cl (.intersect this cl (.erasedSupertypes this t)))
                          (recur (unchecked-inc-int i)))
                        (recur (unchecked-inc-int i))))))
              (let [^{:tag (List Type)} mec (.closureMin this cl)
                    ^:mutable ^{:tag (List Type)} candidates (List/nil)]
                (for-each [^Type erasedSupertype mec]
                  (let [^:mutable ^{:tag (List Type)} lci (List/of
                                                            (.asSuper
                                                              this
                                                              (aget ts startIdx)
                                                              (.-tsym erasedSupertype)))]
                    (loop [^int i (unchecked-add-int startIdx 1)]
                      (when (< i (alength ts))
                        (let [superType (.asSuper this (aget ts i) (.-tsym erasedSupertype))]
                          (set! lci
                                (.intersect this
                                            lci
                                            ^List (if (some? superType)
                                                      (List/of superType)
                                                      (List/nil))))
                          (recur (unchecked-inc-int i)))))
                    (set! candidates (.appendList candidates lci))))
                (.compoundMin this candidates))))
        (let [^:mutable ^{:tag (List Type)} classes (List/of (.arraySuperType this))]
          (loop [^int i 0]
            (if (< i (alength ts))
                (if (not (== (aget kinds i) ARRAY_BOUND))
                    (do (set! classes (.prepend classes (aget ts i))) (recur (unchecked-inc-int i)))
                    (recur (unchecked-inc-int i)))
                nil))
          (.lub this classes)))))

  (method ^:public erasedSupertypes ^{:tag (List Type)} [this ^Type t]
    (let [^{:tag (ListBuffer Type)} buf (ListBuffer.)]
      (for-each [^Type sup (.closure this t)]
        (if (.hasTag sup TypeTag/TYPEVAR) (.append buf sup) (.append buf (.erasure this sup))))
      (.toList buf)))

  (field ^:private ^Type arraySuperType)

  (method ^:private arraySuperType ^Type [this]
    (when (nil? arraySuperType)
      (set! arraySuperType
            (.makeIntersectionType this
                                   (List/of (.-serializableType syms) (.-cloneableType syms))
                                   true)))
    arraySuperType)

  (method ^:public glb ^Type [this ^{:tag (List Type)} ts]
    (let [^:mutable t1 (cast Type (.-head ts))]
      (for-each [^Type t2 (.-tail ts)]
        (when (.isErroneous t1) (return t1))
        (set! t1 (.glb this t1 t2)))
      t1))

  (method ^:public glb ^Type [this ^Type t ^Type s]
    (cond
      (nil? s) t
      (or (.isPrimitive t) (.isPrimitive s)) (.-errType syms)
      (.isSubtypeNoCapture this t s) t
      (.isSubtypeNoCapture this s t) s
      :else
        (let [^{:tag (List Type)} closure (.union this (.closure this t) (.closure this s))]
          (.glbFlattened this closure t))))

  (method ^:private glbFlattened ^Type [this ^{:tag (List Type)} flatBounds ^Type errT]
    (let [^{:tag (List Type)} bounds (.closureMin this flatBounds)]
      (cond
        (.isEmpty bounds) (.-objectType syms)
        (.isEmpty (.-tail bounds)) (cast Type (.-head bounds))
        :else
          (do
            (let [^:mutable ^int classCount 0
                  ^:mutable ^{:tag (List Type)} cvars (List/nil)
                  ^:mutable ^{:tag (List Type)} lowers (List/nil)]
              (for-each [^Type bound bounds]
                (when-not (.isInterface bound)
                  (set! classCount (unchecked-inc-int classCount))
                  (let [lower (.cvarLowerBound this bound)]
                    (when (and (not (identical? bound lower)) (not (.hasTag lower TypeTag/BOT)))
                      (set! cvars (.append cvars bound))
                      (set! lowers (.append lowers lower))))))
              (when (> classCount 1)
                (if (.isEmpty lowers)
                    (return (.createErrorType this errT))
                    (let [^{:tag (List Type)} newBounds (.appendList (.diff bounds cvars) lowers)]
                      (return (.glb this newBounds))))))
            (.makeIntersectionType this bounds)))))

  (method ^:public hashCode ^int [this ^Type t] (.hashCode this t false))

  (method ^:public hashCode ^int [this ^Type t ^boolean strict]
    (if strict
        (cast Integer (.visit hashCodeStrictVisitor t))
        (cast Integer (.visit hashCodeVisitor t))))

  (field ^:private ^:static ^:final ^HashCodeVisitor hashCodeVisitor (HashCodeVisitor.))

  (field ^:private ^:static ^:final ^HashCodeVisitor hashCodeStrictVisitor
    (anon HashCodeVisitor []
      (method ^:public visitTypeVar ^Integer [this ^Type$TypeVar t ^Void ignored]
        (System/identityHashCode t))))

  (defclass ^:private ^:static HashCodeVisitor
    :extends (UnaryVisitor Integer)

    (method ^:public visitType ^Integer [this ^Type t ^Void ignored]
      (.ordinal (.getTag t)))

    (method ^:public visitClassType ^Integer [this ^Type$ClassType t ^Void ignored]
      (let [^:mutable result (.intValue (cast Integer (.visit this (.getEnclosingType t))))]
        (set! result (unchecked-multiply-int result 127))
        (set! result (unchecked-add-int result (.hashCode (.flatName (.-tsym t)))))
        (for-each [^Type s (.getTypeArguments t)]
          (set! result (unchecked-multiply-int result 127))
          (set! result (unchecked-add-int result (.intValue (cast Integer (.visit this s))))))
        result))

    (method ^:public visitMethodType ^Integer [this ^Type$MethodType t ^Void ignored]
      (let [^:mutable h (.ordinal TypeTag/METHOD)]
        (loop [^{:tag (List Type)} thisargs (.-argtypes t)]
          (when (some? (.-tail thisargs))
            (set! h
                  (unchecked-add-int (bit-shift-left-int h 5)
                                     (.intValue (cast
                                                  Integer
                                                  (.visit this (cast Type (.-head thisargs)))))))
            (recur (.-tail thisargs))))
        (unchecked-add-int (bit-shift-left-int h 5)
                           (.intValue (cast Integer (.visit this (.-restype t)))))))

    (method ^:public visitWildcardType ^Integer [this ^Type$WildcardType t ^Void ignored]
      (let [^:mutable result (.hashCode (.-kind t))]
        (when (some? (.-type t))
          (set! result (unchecked-multiply-int result 127))
          (set! result
                (unchecked-add-int result (.intValue (cast Integer (.visit this (.-type t)))))))
        result))

    (method ^:public visitArrayType ^Integer [this ^Type$ArrayType t ^Void ignored]
      (unchecked-add-int (.intValue (cast Integer (.visit this (.-elemtype t)))) 12))

    (method ^:public visitTypeVar ^Integer [this ^Type$TypeVar t ^Void ignored]
      (System/identityHashCode t))

    (method ^:public visitUndetVar ^Integer [this ^Type$UndetVar t ^Void ignored]
      (System/identityHashCode t))

    (method ^:public visitErrorType ^Integer [this ^Type$ErrorType t ^Void ignored]
      (Integer/valueOf 0)))

  (method ^:public resultSubtype ^boolean [this ^Type t ^Type s ^Warner warner]
    (let [^{:tag (List Type)} tvars (.getTypeArguments t)
          ^{:tag (List Type)} svars (.getTypeArguments s)
          tres (.getReturnType t)
          sres (.subst this (.getReturnType s) svars tvars)]
      (.covariantReturnType this tres sres warner)))

  (method ^:public returnTypeSubstitutable ^boolean [this ^Type r1 ^Type r2]
    (if (.hasSameArgs this r1 r2)
        (.resultSubtype this r1 r2 noWarnings)
        (.covariantReturnType this
                              (.getReturnType r1)
                              (.erasure this (.getReturnType r2))
                              noWarnings)))

  (method ^:public returnTypeSubstitutable ^boolean [this ^Type r1 ^Type r2 ^Type r2res
                                                     ^Warner warner]
    (cond
      (.isSameType this (.getReturnType r1) r2res) true
      (or (.isPrimitive (.getReturnType r1)) (.isPrimitive r2res)) false
      (.hasSameArgs this r1 r2) (.covariantReturnType this (.getReturnType r1) r2res warner)
      (.isSubtypeUnchecked this (.getReturnType r1) r2res warner) true
      (not (.isSubtype this (.getReturnType r1) (.erasure this r2res))) false
      :else (do (.warn warner Lint$LintCategory/UNCHECKED) true)))

  (method ^:public covariantReturnType ^boolean [this ^Type t ^Type s ^Warner warner]
    (or (.isSameType this t s)
        (and (and (not (.isPrimitive t)) (not (.isPrimitive s))) (.isAssignable this t s warner))))

  (method ^:public boxedClass ^Symbol$ClassSymbol [this ^Type t]
    (.enterClass syms (.-java_base syms) (aget (.-boxedName syms) (.ordinal (.getTag t)))))

  (method ^:public boxedTypeOrType ^Type [this ^Type t]
    (if (.isPrimitive t) (.-type (.boxedClass this t)) t))

  (method ^:public unboxedType ^Type [this ^Type t]
    (if (.hasTag t TypeTag/ERROR)
        Type/noType
        (do
          (loop [^int i 0]
            (when (< i (alength (.-boxedName syms)))
              (let [box (aget (.-boxedName syms) i)]
                (if (and (some? box)
                         (some? (.asSuper this t (.enterClass syms (.-java_base syms) box))))
                    (return (aget (.-typeOfTag syms) i))
                    (recur (unchecked-inc-int i))))))
          Type/noType)))

  (method ^:public unboxedTypeOrType ^Type [this ^Type t]
    (let [unboxedType (.unboxedType this t)] (if (.hasTag unboxedType TypeTag/NONE) t unboxedType)))

  (method ^:public capture ^{:tag (List Type)} [this ^{:tag (List Type)} ts]
    (let [^:mutable ^{:tag (List Type)} buf (List/nil)]
      (for-each [^Type t ts] (set! buf (.prepend buf (.capture this t))))
      (.reverse buf)))

  (method ^:public capture ^Type [this ^:mutable ^Type t]
    (if (not (.hasTag t TypeTag/CLASS))
        t
        (do
          (when-not (identical? (.getEnclosingType t) Type/noType)
            (let [capturedEncl (.capture this (.getEnclosingType t))]
              (when-not (identical? capturedEncl (.getEnclosingType t))
                (let [type1 (.memberType this capturedEncl (.-tsym t))]
                  (set! t
                        (.subst this
                                type1
                                (.getTypeArguments (.-type (.-tsym t)))
                                (.getTypeArguments t)))))))
          (let [cls (cast Type$ClassType t)]
            (if (or (.isRaw cls) (not (.isParameterized cls)))
                cls
                (let [G (cast Type$ClassType (.asType (.asElement cls)))
                      ^{:tag (List Type)} A (.getTypeArguments G)
                      ^{:tag (List Type)} T (.getTypeArguments cls)
                      ^{:tag (List Type)} S (.freshTypeVariables this T)
                      ^:mutable ^{:tag (List Type)} currentA A
                      ^:mutable ^{:tag (List Type)} currentT T
                      ^:mutable ^{:tag (List Type)} currentS S
                      ^:mutable captured false]
                  (while (and (and (not (.isEmpty currentA)) (not (.isEmpty currentT)))
                              (not (.isEmpty currentS)))
                    (when-not (identical? (.-head currentS) (.-head currentT))
                      (set! captured true)
                      (let [Ti (cast Type$WildcardType (.-head currentT))
                            ^:mutable Ui (.getUpperBound (cast Type (.-head currentA)))
                            Si (cast Type$CapturedType (.-head currentS))]
                        (when (nil? Ui) (set! Ui (.-objectType syms)))
                        (switch (.-kind Ti)
                          UNBOUND
                            (do
                              (.setUpperBound Si (.subst this Ui A S))
                              (set! (.-lower Si) (.-botType syms)))
                          EXTENDS
                            (do
                              (.setUpperBound
                                Si
                                (.glb this (.getExtendsBound Ti) (.subst this Ui A S)))
                              (set! (.-lower Si) (.-botType syms)))
                          SUPER
                            (do
                              (.setUpperBound Si (.subst this Ui A S))
                              (set! (.-lower Si) (.getSuperBound Ti))))
                        (let [^Type tmpBound (if (.hasTag (.getUpperBound Si) TypeTag/UNDETVAR)
                                                 (.-qtype (cast Type$UndetVar (.getUpperBound Si)))
                                                 (.getUpperBound Si))
                              ^Type tmpLower (if (.hasTag (.-lower Si) TypeTag/UNDETVAR)
                                                 (.-qtype (cast Type$UndetVar (.-lower Si)))
                                                 (.-lower Si))]
                          (when (and (and (not (.hasTag (.getUpperBound Si) TypeTag/ERROR))
                                          (not (.hasTag (.-lower Si) TypeTag/ERROR)))
                                     (.isSameType this tmpBound tmpLower))
                            (set! (.-head currentS) (.getUpperBound Si))))))
                    (set! currentA (.-tail currentA))
                    (set! currentT (.-tail currentT))
                    (set! currentS (.-tail currentS)))
                  (cond
                    (or (or (not (.isEmpty currentA)) (not (.isEmpty currentT)))
                        (not (.isEmpty currentS)))
                      (.erasure this t)
                    captured
                      (Type$ClassType. (.getEnclosingType cls) S (.-tsym cls) (.getMetadata cls))
                    :else t)))))))

  (method ^:public freshTypeVariables ^{:tag (List Type)} [this ^{:tag (List Type)} types]
    (let [^{:tag (ListBuffer Type)} result (ListBuffer.)]
      (for-each [^Type t types]
        (if (.hasTag t TypeTag/WILDCARD)
            (let [^:mutable bound (.getExtendsBound (cast Type$WildcardType t))]
              (when (nil? bound) (set! bound (.-objectType syms)))
              (.append result
                       (Type$CapturedType. capturedName
                                           (.-noSymbol syms)
                                           bound
                                           (.-botType syms)
                                           (cast Type$WildcardType t))))
            (.append result t)))
      (.toList result)))

  (method ^:private sideCast ^boolean [this ^:mutable ^Type from ^:mutable ^Type to ^Warner warn]
    (let [^:mutable reverse false
          target to]
      (when (== (bit-and (.flags (.-tsym to)) Flags/INTERFACE) 0)
        (Assert/check (not (== (bit-and (.flags (.-tsym from)) Flags/INTERFACE) 0)))
        (set! reverse true)
        (set! to from)
        (set! from target))
      (let [^:mutable ^{:tag (List Type)} commonSupers (.supertypeClosure
                                                         this
                                                         to
                                                         (.erasure this from))
            ^:mutable giveWarning (.isEmpty commonSupers)]
        (while (.nonEmpty commonSupers)
          (let [t1 (.asSuper this from (.-tsym (cast Type (.-head commonSupers))))
                t2 (cast Type (.-head commonSupers))]
            (when (.disjointTypes this (.getTypeArguments t1) (.getTypeArguments t2))
              (return false))
            (set! giveWarning
                  (or giveWarning (if reverse (.giveWarning this t2 t1) (.giveWarning this t1 t2))))
            (set! commonSupers (.-tail commonSupers))))
        (when (and giveWarning (not (.isReifiable this ^Type (if reverse from to))))
          (.warn warn Lint$LintCategory/UNCHECKED))
        true)))

  (method ^:private sideCastFinal ^boolean [this ^:mutable ^Type from ^:mutable ^Type to
                                            ^Warner warn]
    (let [^:mutable reverse false
          target to]
      (when (== (bit-and (.flags (.-tsym to)) Flags/INTERFACE) 0)
        (Assert/check (not (== (bit-and (.flags (.-tsym from)) Flags/INTERFACE) 0)))
        (set! reverse true)
        (set! to from)
        (set! from target))
      (Assert/check (not (== (bit-and (.flags (.-tsym from)) Flags/FINAL) 0)))
      (let [t1 (.asSuper this from (.-tsym to))]
        (if (nil? t1)
            false
            (let [t2 to]
              (if (.disjointTypes this (.getTypeArguments t1) (.getTypeArguments t2))
                  false
                  (do
                    (when (and (not (.isReifiable this target))
                               (if reverse (.giveWarning this t2 t1) (.giveWarning this t1 t2)))
                      (.warn warn Lint$LintCategory/UNCHECKED))
                    true)))))))

  (method ^:private giveWarning ^boolean [this ^Type from ^Type to]
    (let [^{:tag (List Type)} bounds (if (.isCompound to) (.directSupertypes this to) (List/of to))]
      (for-each [^Type b bounds]
        (let [subFrom (.asSub this from (.-tsym b))]
          (when (and (.isParameterized b)
                     (not (or (or (.isUnbounded this b) (.isSubtype this from b))
                              (and (some? subFrom)
                                   (.containsType this (.allparams b) (.allparams subFrom))))))
            (return true))))
      false))

  (method ^:private supertypeClosure ^{:tag (List Type)} [this ^Type t ^Type s]
    (let [^:mutable ^{:tag (List Type)} cl (List/nil)]
      (loop [^{:tag (List Type)} l (.interfaces this t)]
        (if (.nonEmpty l)
            (if (.isSubtype this s (.erasure this (cast Type (.-head l))))
                (do (set! cl (.insert this cl (cast Type (.-head l)))) (recur (.-tail l)))
                (do
                  (set! cl (.union this cl (.supertypeClosure this (cast Type (.-head l)) s)))
                  (recur (.-tail l))))
            nil))
      cl))

  (method ^:private containsTypeEquivalent ^boolean [this ^Type t ^Type s]
    (or (.isSameType this t s) (and (.containsType this t s) (.containsType this s t))))

  (method ^:public adapt :throws [AdaptFailure] ^void [this ^Type source ^Type target
                                                       ^{:tag (ListBuffer Type)} from
                                                       ^{:tag (ListBuffer Type)} to]
    (.adapt (Adapter. from to) source target))

  (defclass Adapter
    :extends (SimpleVisitor Void Type)

    (field ^{:tag (ListBuffer Type)} from)

    (field ^{:tag (ListBuffer Type)} to)

    (field ^{:tag (Map Symbol Type)} mapping)

    (constructor [this ^{:tag (ListBuffer Type)} from ^{:tag (ListBuffer Type)} to]
      (set! (.-from this) from)
      (set! (.-to this) to)
      (set! mapping (HashMap.)))

    (method ^:public adapt :throws [AdaptFailure] ^void [this ^Type source ^Type target]
      (.visit this source target)
      (let [^:mutable ^{:tag (List Type)} fromList (.toList from)
            ^:mutable ^{:tag (List Type)} toList (.toList to)]
        (while (not (.isEmpty fromList))
          (let [val (cast Type (.get mapping (.-tsym (cast Type (.-head fromList)))))]
            (when-not (identical? (.-head toList) val) (set! (.-head toList) val))
            (set! fromList (.-tail fromList))
            (set! toList (.-tail toList))))))

    (method ^:public visitClassType :throws [AdaptFailure] ^Void [this ^Type$ClassType source
                                                                  ^Type target]
      (when (.hasTag target TypeTag/CLASS)
        (.adaptRecursive this (.allparams source) (.allparams target)))
      nil)

    (method ^:public visitArrayType :throws [AdaptFailure] ^Void [this ^Type$ArrayType source
                                                                  ^Type target]
      (when (.hasTag target TypeTag/ARRAY)
        (.adaptRecursive this (.elemtype Types/this source) (.elemtype Types/this target)))
      nil)

    (method ^:public visitWildcardType :throws [AdaptFailure] ^Void [this ^Type$WildcardType source
                                                                     ^Type target]
      (cond
        (.isExtendsBound source)
          (.adaptRecursive this
                           (.wildUpperBound Types/this source)
                           (.wildUpperBound Types/this target))
        (.isSuperBound source)
          (.adaptRecursive this
                           (.wildLowerBound Types/this source)
                           (.wildLowerBound Types/this target)))
      nil)

    (method ^:public visitTypeVar :throws [AdaptFailure] ^Void [this ^Type$TypeVar source
                                                                ^Type target]
      (let [^:mutable val (cast Type (.get mapping (.-tsym source)))]
        (if (some? val)
            (cond
              (and (.isSuperBound val) (.isSuperBound target))
                (set! val
                      (if (.isSubtype Types/this
                                      (.wildLowerBound Types/this val)
                                      (.wildLowerBound Types/this target))
                          target
                          val))
              (and (.isExtendsBound val) (.isExtendsBound target))
                (set! val
                      (if (.isSubtype Types/this
                                      (.wildUpperBound Types/this val)
                                      (.wildUpperBound Types/this target))
                          val
                          target))
              :else (when-not (.isSameType Types/this val target) (throw (AdaptFailure.))))
            (do (set! val target) (.append from source) (.append to target)))
        (.put mapping (.-tsym source) val)
        nil))

    (method ^:public visitType ^Void [this ^Type source ^Type target] nil)

    (field ^:private ^{:tag (Set TypePair)} cache (HashSet.))

    (method ^:private adaptRecursive ^void [this ^Type source ^Type target]
      (let [pair (TypePair. source target)]
        (when (.add cache pair) (try (.visit this source target) (finally (.remove cache pair))))))

    (method ^:private adaptRecursive ^void [this ^:mutable ^{:tag (List Type)} source
                                            ^:mutable ^{:tag (List Type)} target]
      (when (== (.length source) (.length target))
        (while (.nonEmpty source)
          (.adaptRecursive this (cast Type (.-head source)) (cast Type (.-head target)))
          (set! source (.-tail source))
          (set! target (.-tail target))))))

  (defclass ^:public ^:static AdaptFailure
    :extends RuntimeException

    (field ^:static ^:final ^long serialVersionUID -7490231548272701566))

  (method ^:private adaptSelf ^void [this ^Type t ^{:tag (ListBuffer Type)} from
                                     ^{:tag (ListBuffer Type)} to]
    (try
      (.adapt this (.-type (.-tsym t)) t from to)
      (catch AdaptFailure ex (throw (AssertionError. ex)))))

  (method ^:private rewriteQuantifiers ^Type [this ^Type t ^boolean high ^boolean rewriteTypeVars]
    (cast Type (.visit (Rewriter. high rewriteTypeVars) t)))

  (defclass Rewriter
    :extends (UnaryVisitor Type)

    (field ^boolean high)

    (field ^boolean rewriteTypeVars)

    (field ^{:tag (Map Type Type)} argMap (HashMap.))

    (field ^{:tag (Set Type)} seen (HashSet.))

    (constructor [this ^boolean high ^boolean rewriteTypeVars]
      (set! (.-high this) high)
      (set! (.-rewriteTypeVars this) rewriteTypeVars))

    (method ^:public visitClassType ^Type [this ^Type$ClassType t ^Void s]
      (let [^{:tag (ListBuffer Type)} rewritten (ListBuffer.)
            ^:mutable changed false]
        (for-each [^Type arg (.allparams t)]
          (let [^:mutable bound (cast Type (.get argMap arg))]
            (when (nil? bound) (.put argMap arg (set! bound (cast Type (.visit this arg)))))
            (when-not (identical? arg bound) (set! changed true))
            (.append rewritten bound)))
        (if changed
            (.subst Types/this
                    (.-type (.-tsym t))
                    (.allparams (.-type (.-tsym t)))
                    (.toList rewritten))
            t)))

    (method ^:public visitType ^Type [this ^Type t ^Void s] t)

    (method ^:public visitCapturedType ^Type [this ^Type$CapturedType t ^Void s]
      (let [w_bound (.-type (.-wildcard t))
            ^Type bound (if (.contains w_bound t)
                            (.erasure Types/this w_bound)
                            (cast Type (.visit this w_bound)))]
        (.rewriteAsWildcardType this
                                (cast Type (.visit this bound))
                                (.-bound (.-wildcard t))
                                (.-kind (.-wildcard t)))))

    (method ^:public visitTypeVar ^Type [this ^Type$TypeVar t ^Void s]
      (cond
        (.add seen t)
          (if rewriteTypeVars
              (let [^Type bound (if (.contains (.getUpperBound t) t)
                                    (.erasure Types/this (.getUpperBound t))
                                    (cast Type (.visit this (.getUpperBound t))))]
                (.rewriteAsWildcardType this bound t BoundKind/EXTENDS))
              t)
        rewriteTypeVars ^Type (.makeExtendsWildcard Types/this (.-objectType syms) t)
        :else ^Type t))

    (method ^:public visitWildcardType ^Type [this ^Type$WildcardType t ^Void s]
      (let [bound2 (cast Type (.visit this (.-type t)))]
        (if (identical? (.-type t) bound2)
            ^Type t
            (.rewriteAsWildcardType this bound2 (.-bound t) (.-kind t)))))

    (method ^:private rewriteAsWildcardType ^Type [this ^Type bound ^Type$TypeVar formal
                                                   ^BoundKind bk]
      (switch bk
        EXTENDS
          (if high
              ^Type (.makeExtendsWildcard Types/this (.B this bound) formal)
              ^Type (.makeExtendsWildcard Types/this (.-objectType syms) formal))
        SUPER
          (if high
              ^Type (.makeSuperWildcard Types/this (.-botType syms) formal)
              ^Type (.makeSuperWildcard Types/this (.B this bound) formal))
        UNBOUND (.makeExtendsWildcard Types/this (.-objectType syms) formal)
        (do (Assert/error (java-str "Invalid bound kind " bk)) nil)))

    (method B ^Type [this ^:mutable ^Type t]
      (while (.hasTag t TypeTag/WILDCARD)
        (let [w (cast Type$WildcardType t)]
          (set! t (if high (.getExtendsBound w) (.getSuperBound w)))
          (when (nil? t) (set! t (if high (.-objectType syms) (.-botType syms))))))
      t))

  (method ^:private makeExtendsWildcard ^Type$WildcardType [this ^Type bound ^Type$TypeVar formal]
    (if (identical? bound (.-objectType syms))
        (Type$WildcardType. (.-objectType syms) BoundKind/UNBOUND (.-boundClass syms) formal)
        (Type$WildcardType. bound BoundKind/EXTENDS (.-boundClass syms) formal)))

  (method ^:private makeSuperWildcard ^Type$WildcardType [this ^Type bound ^Type$TypeVar formal]
    (if (.hasTag bound TypeTag/BOT)
        (Type$WildcardType. (.-objectType syms) BoundKind/UNBOUND (.-boundClass syms) formal)
        (Type$WildcardType. bound BoundKind/SUPER (.-boundClass syms) formal)))

  (defclass ^:public ^:static UniqueType
    (field ^:public ^:final ^Type type)

    (field ^:final ^Types types)

    (constructor ^:public [this ^Type type ^Types types]
      (set! (.-type this) type)
      (set! (.-types this) types))

    (method ^:public hashCode ^int [this] (.hashCode types type))

    (method ^:public equals ^boolean [this obj]
      (if-instance [^UniqueType uniqueType obj] (.isSameType types type (.-type uniqueType)) false))

    (method ^:public toString ^String [this] (.toString type)))

  (defclass ^:public ^:abstract ^:static DefaultTypeVisitor
    :implements [(Type$Visitor R S)]
    :type-params [R S]

    (method ^:public ^:final visit ^R [this ^Type t ^S s]
      (.accept t this s))

    (method ^:public visitClassType ^R [this ^Type$ClassType t ^S s]
      (.visitType this t s))

    (method ^:public visitWildcardType ^R [this ^Type$WildcardType t ^S s]
      (.visitType this t s))

    (method ^:public visitArrayType ^R [this ^Type$ArrayType t ^S s]
      (.visitType this t s))

    (method ^:public visitMethodType ^R [this ^Type$MethodType t ^S s]
      (.visitType this t s))

    (method ^:public visitPackageType ^R [this ^Type$PackageType t ^S s]
      (.visitType this t s))

    (method ^:public visitModuleType ^R [this ^Type$ModuleType t ^S s]
      (.visitType this t s))

    (method ^:public visitTypeVar ^R [this ^Type$TypeVar t ^S s]
      (.visitType this t s))

    (method ^:public visitCapturedType ^R [this ^Type$CapturedType t ^S s]
      (.visitType this t s))

    (method ^:public visitForAll ^R [this ^Type$ForAll t ^S s]
      (.visitType this t s))

    (method ^:public visitUndetVar ^R [this ^Type$UndetVar t ^S s]
      (.visitType this t s))

    (method ^:public visitErrorType ^R [this ^Type$ErrorType t ^S s]
      (.visitType this t s)))

  (defclass ^:public ^:abstract ^:static DefaultSymbolVisitor
    :implements [(Symbol$Visitor R S)]
    :type-params [R S]

    (method ^:public ^:final visit ^R [this ^Symbol s ^S arg]
      (.accept s this arg))

    (method ^:public visitClassSymbol ^R [this ^Symbol$ClassSymbol s ^S arg]
      (.visitSymbol this s arg))

    (method ^:public visitMethodSymbol ^R [this ^Symbol$MethodSymbol s ^S arg]
      (.visitSymbol this s arg))

    (method ^:public visitOperatorSymbol ^R [this ^Symbol$OperatorSymbol s ^S arg]
      (.visitSymbol this s arg))

    (method ^:public visitPackageSymbol ^R [this ^Symbol$PackageSymbol s ^S arg]
      (.visitSymbol this s arg))

    (method ^:public visitTypeSymbol ^R [this ^Symbol$TypeSymbol s ^S arg]
      (.visitSymbol this s arg))

    (method ^:public visitVarSymbol ^R [this ^Symbol$VarSymbol s ^S arg]
      (.visitSymbol this s arg)))

  (defclass ^:public ^:abstract ^:static SimpleVisitor
    :extends (DefaultTypeVisitor R S)
    :type-params [R S]

    (method ^:public visitCapturedType ^R [this ^Type$CapturedType t ^S s]
      (.visitTypeVar this t s))

    (method ^:public visitForAll ^R [this ^Type$ForAll t ^S s]
      (.visit this (.-qtype t) s))

    (method ^:public visitUndetVar ^R [this ^Type$UndetVar t ^S s]
      (.visit this (.-qtype t) s)))

  (defclass ^:public ^:abstract ^:static TypeRelation
    :extends (SimpleVisitor Boolean Type))

  (defclass ^:public ^:abstract ^:static UnaryVisitor
    :extends (SimpleVisitor R Void)
    :type-params [R]

    (method ^:public ^:final visit ^R [this ^Type t] (.accept t this nil)))

  (defclass ^:public ^:static MapVisitor
    :extends (DefaultTypeVisitor Type S)
    :type-params [S]

    (method ^:public ^:final visit ^Type [this ^Type t]
      (cast Type (.accept t this nil)))

    (method ^:public visitType ^Type [this ^Type t ^S s] t))

  (defclass ^:public ^:static TypeMapping
    :extends (MapVisitor S)
    :implements [(Function Type Type)]
    :type-params [S]

    (method ^:public apply ^Type [this ^Type type] (.visit this type))

    (method visit ^{:tag (List Type)} [this ^{:tag (List Type)} ts ^S s]
      (.map ts (lambda Function ^Type [^Type t] (cast Type (.visit this t s)))))

    (method ^:public visitCapturedType ^Type [this ^Type$CapturedType t ^S s]
      (cast Type (.visitTypeVar this t s))))

  (method ^:public isUnconditionallyExactTypeBased ^boolean [this ^Type source ^Type target]
    (cond
      (.isSameType this source target) true
      (.isPrimitive target)
        (if (and (.isPrimitive source)
                 (and (.isStrictSubRangeOf (.getTag source) (.getTag target))
                      (not (or (or
                                 (and (.hasTag source TypeTag/BYTE) (.hasTag target TypeTag/CHAR))
                                 (and (.hasTag source TypeTag/INT) (.hasTag target TypeTag/FLOAT)))
                               (and (.hasTag source TypeTag/LONG)
                                    (or (.hasTag target TypeTag/DOUBLE)
                                        (.hasTag target TypeTag/FLOAT)))))))
            true
            false)
      :else (.isSubtype this (.boxedTypeOrType this (.erasure this source)) target)))

  (method ^:public isUnconditionallyExactValueBased ^boolean [this ^Type source ^Type target]
    (if-instance [^Number value (.constValue source)]
      (if (not (.isNumeric (.getTag target)))
          false
          (do
            (switch (.getTag source)
              BYTE
                (switch (.getTag target)
                  CHAR (return (ExactConversionsSupport/isIntToCharExact (.intValue value))))
              CHAR
                (switch (.getTag target)
                  BYTE (return (ExactConversionsSupport/isIntToByteExact (.intValue value)))
                  SHORT (return (ExactConversionsSupport/isIntToShortExact (.intValue value))))
              SHORT
                (switch (.getTag target)
                  BYTE (return (ExactConversionsSupport/isIntToByteExact (.intValue value)))
                  CHAR (return (ExactConversionsSupport/isIntToCharExact (.intValue value))))
              INT
                (switch (.getTag target)
                  BYTE (return (ExactConversionsSupport/isIntToByteExact (.intValue value)))
                  CHAR (return (ExactConversionsSupport/isIntToCharExact (.intValue value)))
                  SHORT (return (ExactConversionsSupport/isIntToShortExact (.intValue value)))
                  FLOAT (return (ExactConversionsSupport/isIntToFloatExact (.intValue value))))
              FLOAT
                (switch (.getTag target)
                  BYTE (return (ExactConversionsSupport/isFloatToByteExact (.floatValue value)))
                  CHAR (return (ExactConversionsSupport/isFloatToCharExact (.floatValue value)))
                  SHORT (return (ExactConversionsSupport/isFloatToShortExact (.floatValue value)))
                  INT (return (ExactConversionsSupport/isFloatToIntExact (.floatValue value)))
                  LONG (return (ExactConversionsSupport/isFloatToLongExact (.floatValue value))))
              LONG
                (switch (.getTag target)
                  BYTE (return (ExactConversionsSupport/isLongToByteExact (.longValue value)))
                  CHAR (return (ExactConversionsSupport/isLongToCharExact (.longValue value)))
                  SHORT (return (ExactConversionsSupport/isLongToShortExact (.longValue value)))
                  INT (return (ExactConversionsSupport/isLongToIntExact (.longValue value)))
                  FLOAT (return (ExactConversionsSupport/isLongToFloatExact (.longValue value)))
                  DOUBLE (return (ExactConversionsSupport/isLongToDoubleExact (.longValue value))))
              DOUBLE
                (switch (.getTag target)
                  BYTE (return (ExactConversionsSupport/isDoubleToByteExact (.doubleValue value)))
                  CHAR (return (ExactConversionsSupport/isDoubleToCharExact (.doubleValue value)))
                  SHORT (return (ExactConversionsSupport/isDoubleToShortExact (.doubleValue value)))
                  INT (return (ExactConversionsSupport/isDoubleToIntExact (.doubleValue value)))
                  FLOAT (return (ExactConversionsSupport/isDoubleToFloatExact (.doubleValue value)))
                  LONG (return (ExactConversionsSupport/isDoubleToLongExact (.doubleValue value)))))
            true))
      false))

  (method ^:public isUnconditionallyExactCombined ^boolean [this ^Type currentType ^Type testType]
    (or (.isUnconditionallyExactTypeBased this currentType testType)
        (and (instance? Number (.constValue currentType))
             (.isUnconditionallyExactValueBased this currentType testType))))

  (method ^:public getRetention ^Attribute$RetentionPolicy [this ^Attribute$Compound a]
    (.getRetention this (.-tsym (.-type a))))

  (method ^:public getRetention ^Attribute$RetentionPolicy [this ^Symbol$TypeSymbol sym]
    (let [^:mutable vis Attribute$RetentionPolicy/CLASS
          c (.attribute sym (.-tsym (.-retentionType syms)))]
      (when (some? c)
        (let [value (.member c (.-value names))]
          (when (some? value)
            (when-instance [^Attribute$Enum attributeEnum value]
              (let [levelName (.-name (.-value attributeEnum))]
                (cond
                  (identical? levelName (.-SOURCE names))
                    (set! vis Attribute$RetentionPolicy/SOURCE)
                  (identical? levelName (.-CLASS names)) (set! vis Attribute$RetentionPolicy/CLASS)
                  (identical? levelName (.-RUNTIME names))
                    (set! vis Attribute$RetentionPolicy/RUNTIME)))))))
      vis))

  (defclass ^:public ^:abstract SignatureGenerator
    (defclass ^:public InvalidSignatureException
      :extends CompilerInternalException

      (field ^:private ^:static ^:final ^long serialVersionUID 0)

      (field ^:private ^:final ^:transient ^Type type)

      (constructor [this ^Type type ^boolean dumpStackTraceOnError]
        (super. dumpStackTraceOnError)
        (set! (.-type this) type))

      (method ^:public type ^Type [this] type))

    (method ^:protected ^:abstract append ^void [this ^char ch])

    (method ^:protected ^:abstract append ^void [this ^byte/1 ba])

    (method ^:protected ^:abstract append ^void [this ^Name name])

    (method ^:protected classReference ^void [this ^Symbol$ClassSymbol c])

    (method ^:protected reportIllegalSignature ^void [this ^Type t]
      (throw (InvalidSignatureException. t (.-dumpStacktraceOnError Types/this))))

    (method ^:public assembleSig ^void [this ^Type type]
      (switch (.getTag type)
        BYTE (.append this \B)
        SHORT (.append this \S)
        CHAR (.append this \C)
        INT (.append this \I)
        LONG (.append this \J)
        FLOAT (.append this \F)
        DOUBLE (.append this \D)
        BOOLEAN (.append this \Z)
        VOID (.append this \V)
        CLASS
          (do
            (when (.isCompound type) (.reportIllegalSignature this type))
            (.append this \L)
            (.assembleClassSig this type)
            (.append this \;))
        ARRAY
          (let [at (cast Type$ArrayType type)]
            (.append this \[)
            (.assembleSig this (.-elemtype at)))
        METHOD
          (let [mt (cast Type$MethodType type)]
            (.append this \()
            (.assembleSig this (.-argtypes mt))
            (.append this \))
            (.assembleSig this (.-restype mt))
            (when (.hasTypeVar this (.-thrown mt))
              (loop [^{:tag (List Type)} l (.-thrown mt)]
                (when (.nonEmpty l)
                  (.append this \^)
                  (.assembleSig this (cast Type (.-head l)))
                  (recur (.-tail l))))))
        WILDCARD
          (let [ta (cast Type$WildcardType type)]
            (switch (.-kind ta)
              SUPER (do (.append this \-) (.assembleSig this (.-type ta)))
              EXTENDS (do (.append this \+) (.assembleSig this (.-type ta)))
              UNBOUND (.append this \*)
              (throw (AssertionError. (.-kind ta)))))
        TYPEVAR
          (do
            (when (.isCaptured (cast Type$TypeVar type)) (.reportIllegalSignature this type))
            (.append this \T)
            (.append this (.-name (.-tsym type)))
            (.append this \;))
        FORALL
          (let [ft (cast Type$ForAll type)]
            (.assembleParamsSig this (.-tvars ft))
            (.assembleSig this (.-qtype ft)))
        (throw (AssertionError. (java-str "typeSig " (.getTag type))))))

    (method ^:public hasTypeVar ^boolean [this ^:mutable ^{:tag (List Type)} l]
      (while (.nonEmpty l)
        (when (.hasTag (cast Type (.-head l)) TypeTag/TYPEVAR) (return true))
        (set! l (.-tail l)))
      false)

    (method ^:public assembleClassSig ^void [this ^Type type]
      (let [ct (cast Type$ClassType type)
            c (cast Symbol$ClassSymbol (.-tsym ct))]
        (.classReference this c)
        (let [outer (.getEnclosingType ct)]
          (if (.nonEmpty (.allparams outer))
              (let [rawOuter (or (identical? (.-kind (.-owner c)) Kinds$Kind/MTH)
                                 (identical? (.-name c) (.-empty (.-names Types/this))))]
                (.assembleClassSig this ^Type (if rawOuter (.erasure Types/this outer) outer))
                (.append this (if rawOuter \$ \.))
                (Assert/check (.startsWith (.-flatname c) (.-flatname (.enclClass (.-owner c)))))
                (.append this
                         ^Name (if rawOuter
                                   (.subName (.-flatname c)
                                             (unchecked-add-int
                                               (.length (.-flatname (.enclClass (.-owner c))))
                                               1))
                                   (.-name c))))
              (.append this (ClassFile/externalize (.-flatname c))))
          (when (.nonEmpty (.getTypeArguments ct))
            (.append this \<)
            (.assembleSig this (.getTypeArguments ct))
            (.append this \>)))))

    (method ^:public assembleParamsSig ^void [this ^{:tag (List Type)} typarams]
      (.append this \<)
      (loop [^{:tag (List Type)} ts typarams]
        (when (.nonEmpty ts)
          (let [tvar (cast Type$TypeVar (.-head ts))]
            (.append this (.-name (.-tsym tvar)))
            (let [^{:tag (List Type)} bounds (.getBounds Types/this tvar)]
              (when-not (== (bit-and (.flags (.-tsym (cast Type (.-head bounds)))) Flags/INTERFACE)
                            0)
                (.append this \:))
              (loop [^{:tag (List Type)} l bounds]
                (when (.nonEmpty l)
                  (.append this \:)
                  (.assembleSig this (cast Type (.-head l)))
                  (recur (.-tail l))))
              (recur (.-tail ts))))))
      (.append this \>))

    (method ^:public assembleSig ^void [this ^{:tag (List Type)} types]
      (loop [^{:tag (List Type)} ts types]
        (when (.nonEmpty ts) (.assembleSig this (cast Type (.-head ts))) (recur (.-tail ts))))))

  (method ^:public constantType ^Type [this ^PoolConstant$LoadableConstant c]
    (switch (.poolTag c)
      ClassFile/CONSTANT_Class (.-classType syms)
      ClassFile/CONSTANT_String (.-stringType syms)
      ClassFile/CONSTANT_Integer (.-intType syms)
      ClassFile/CONSTANT_Float (.-floatType syms)
      ClassFile/CONSTANT_Long (.-longType syms)
      ClassFile/CONSTANT_Double (.-doubleType syms)
      ClassFile/CONSTANT_MethodHandle (.-methodHandleType syms)
      ClassFile/CONSTANT_MethodType (.-methodTypeType syms)
      ClassFile/CONSTANT_Dynamic (.-type (cast Symbol$DynamicVarSymbol c))
      (throw (AssertionError. (java-str "Not a loadable constant: " (.poolTag c))))))

  (method ^:public newRound ^void [this]
    (.clear (.-_map descCache))
    (.clear isDerivedRawCache)
    (.clear (.-_map implCache))
    (.clear (.-_map membersCache))
    (.clear closureCache)))

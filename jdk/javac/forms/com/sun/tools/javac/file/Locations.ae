            (let [^{:tag (Iterable (Set JavaFileManager$Location))} searchPathLocations
                    (lambda Iterable ^Iterator [] (ModulePathIterator.))]
              (lambda Iterable ^Iterator []
                (Iterators/createCompoundIterator
                  (Arrays/asList (new Iterable/1 [explicitLocationsList searchPathLocations]))
                  (method-ref Function ^Iterator [Iterable] Iterable/.iterator)))))))

    (method contains :throws [IOException] ^boolean [this ^Path file]
      (when (nil? moduleTable) (.initModuleLocations this))
      (.contains moduleTable file))

    (method setPaths ^void [this ^{:tag (Iterable (? extends Path))} paths]
      (when (some? paths) (for-each [^Path p paths] (.checkValidModulePathEntry this p)))
      (.setPaths super paths)
      (set! moduleTable nil))

    (method setPathsForModule :throws [IOException] ^void [this ^String name
                                                           ^{:tag (Iterable (? extends Path))} paths]
      (let [^{:tag (List Path)} checkedPaths (.checkPaths this paths)]
        (.initModuleLocations this)
        (let [^:mutable l (.get moduleTable name)]
          (if (nil? l)
              (do
                (set! l
                      (ModuleLocationHandler. this
                                              (java-str (.getName (.-location this)) "[" name "]")
                                              name
                                              checkedPaths
                                              true))
                (.add moduleTable l))
              (do (set! (.-searchPath l) checkedPaths) (.updatePaths moduleTable l)))
          (set! (.-explicit l) true)
          (set! (.-explicit this) true))))

    (method ^:private checkPaths :throws [IOException] ^{:tag (List Path)} [this
                                                                            ^{:tag (Iterable (? extends Path))} paths]
      (Objects/requireNonNull paths)
      (let [^{:tag (List Path)} validPaths (ArrayList.)]
        (for-each [^Path p paths] (.add validPaths (.checkDirectory this p)))
        validPaths))

    (method ^:private initModuleLocations ^void [this]
      (when-not (some? moduleTable)
        (set! moduleTable (ModuleTable.))
        (for-each [^{:tag (Set JavaFileManager$Location)} set (.listLocationsForModules this)]
          (for-each [^JavaFileManager$Location locn set]
            (when-instance [^ModuleLocationHandler moduleLocationHandler locn]
              (when-not (.containsKey (.-nameMap moduleTable) (.-moduleName moduleLocationHandler))
                (.add moduleTable moduleLocationHandler)))))))

    (method ^:private checkValidModulePathEntry ^void [this ^Path p]
      (when-not (not (Files/exists p))
        (when-not (Files/isDirectory p)
          (let [name (.toString (.getFileName p))
                lastDot (.lastIndexOf name ".")]
            (when (> lastDot 0) (switch (.substring name lastDot) (".jar" ".jmod") (return)))
            (throw (IllegalArgumentException. (.toString p)))))))

    (defclass ModulePathIterator
      :implements [(Iterator (Set JavaFileManager$Location))]

      (field ^{:tag (Iterator Path)} pathIter
        (.iterator (.-searchPath ModulePathLocationHandler/this)))

      (field ^int pathIndex 0)

      (field ^{:tag (Set JavaFileManager$Location)} next nil)

      (method ^:public hasNext ^boolean [this]
        (if (some? next)
            true
            (do
              (while (nil? next)
                (if (.hasNext pathIter)
                    (let [path (cast Path (.next pathIter))]
                      (if (Files/isDirectory path)
                          (set! next (.scanDirectory this path))
                          (set! next (.scanFile this path)))
                      (set! pathIndex (unchecked-inc-int pathIndex)))
                    (return false)))
              true)))

      (method ^:public next ^{:tag (Set JavaFileManager$Location)} [this]
        (.hasNext this)
        (if (some? next)
            (let [^{:tag (Set JavaFileManager$Location)} result next] (set! next nil) result)
            (throw (NoSuchElementException.))))

      (method ^:private scanDirectory ^{:tag (Set JavaFileManager$Location)} [this ^Path path]
        (let [^{:tag (Set Path)} paths (LinkedHashSet.)
              ^:mutable ^Path moduleInfoClass nil]
          (try
            (with-resources [^{:tag (DirectoryStream Path)} stream (Files/newDirectoryStream path)]
              (for-each [^Path entry stream]
                (when (.endsWith entry "module-info.class") (set! moduleInfoClass entry) (break))
                (.add paths entry)))
            (catch [DirectoryIteratorException IOException] ignore
              (.error log (CompilerProperties$Errors/LocnCantReadDirectory path))
              (return (Collections/emptySet))))
          (when (some? moduleInfoClass)
            (try
              (let [moduleName (.readModuleName this moduleInfoClass)
                    name (java-str (.getName (.-location ModulePathLocationHandler/this))
                                   "["
                                   pathIndex
                                   ":"
                                   moduleName
                                   "]")
                    l (ModuleLocationHandler. ModulePathLocationHandler/this
                                              name
                                              moduleName
                                              (Collections/singletonList path)
                                              false)]
                (return (Collections/singleton l)))
              (catch ModuleNameReader$BadClassFile e
                (.error log (CompilerProperties$Errors/LocnBadModuleInfo path))
                (return (Collections/emptySet)))
              (catch IOException e
                (.error log (CompilerProperties$Errors/LocnCantReadFile path))
                (return (Collections/emptySet)))))
          (let [^{:tag (Set JavaFileManager$Location)} result (LinkedHashSet.)
                ^:mutable ^int index 0]
            (for-each [^Path entry paths]
              (let [^{:tag (Pair String Path)} module (.inferModuleName this entry)]
                (when (some? module)
                  (let [moduleName (cast String (.-fst module))
                        modulePath (cast Path (.-snd module))
                        name (java-str (.getName (.-location ModulePathLocationHandler/this))
                                       "["
                                       pathIndex
                                       "."
                                       (let [old-1 index]
                                         (set! index (unchecked-inc-int index))
                                         old-1)
                                       ":"
                                       moduleName
                                       "]")
                        l (ModuleLocationHandler.
                            ModulePathLocationHandler/this
                            name
                            moduleName
                            (Collections/singletonList modulePath)
                            false)]
                    (.add result l)))))
            result)))

      (method ^:private scanFile ^{:tag (Set JavaFileManager$Location)} [this ^Path path]
        (let [^{:tag (Pair String Path)} module (.inferModuleName this path)]
          (if (nil? module)
              (Collections/emptySet)
              (let [moduleName (cast String (.-fst module))
                    modulePath (cast Path (.-snd module))
                    name (java-str (.getName (.-location ModulePathLocationHandler/this))
                                   "["
                                   pathIndex
                                   ":"
                                   moduleName
                                   "]")
                    l (ModuleLocationHandler. ModulePathLocationHandler/this
                                              name
                                              moduleName
                                              (Collections/singletonList modulePath)
                                              false)]
                (Collections/singleton l)))))

      (method ^:private inferModuleName ^{:tag (Pair String Path)} [this ^Path p]
        (cond
          (Files/isDirectory p)
            (do
              (when (or (Files/exists (.resolve p "module-info.class"))
                        (Files/exists (.resolve p "module-info.sig")))
                (let [name (.toString (.getFileName p))]
                  (when (SourceVersion/isName name) (return (Pair. name p)))))
              nil)
          (and (.endsWith (.toString (.getFileName p)) ".jar") (.exists fsInfo p))
            (let [jarFSProvider (.getJarFSProvider fsInfo)]
              (if (nil? jarFSProvider)
                  (do (.error log (CompilerProperties$Errors/NoZipfsForArchive p)) nil)
                  (do
                    (try
                      (with-resources [fs (.newFileSystem
                                            jarFSProvider
                                            p
                                            (.readOnlyJarFSEnv fsInfo releaseVersion))]
                        (let [moduleInfoClass (.getPath fs "module-info.class")]
                          (when (Files/exists moduleInfoClass)
                            (let [moduleName (.readModuleName this moduleInfoClass)]
                              (return (Pair. moduleName p))))
                          (let [mf (.getPath fs "META-INF/MANIFEST.MF")]
                            (when (Files/exists mf)
                              (with-resources [in (Files/newInputStream mf)]
                                (let [man (Manifest. in)
                                      attrs (.getMainAttributes man)]
                                  (when (some? attrs)
                                    (let [moduleName (.getValue
                                                       attrs
                                                       (Attributes$Name. "Automatic-Module-Name"))]
                                      (when (some? moduleName)
                                        (if (.isModuleName
                                              ModulePathLocationHandler/this
                                              moduleName)
                                            (return (Pair. moduleName p))
                                            (do
                                              (.error
                                                log
                                                (CompilerProperties$Errors/LocnCantGetModuleNameForJar
                                                  p))
                                              (return nil))))))))))))
                      (catch ModuleNameReader$BadClassFile e
                        (.error log (CompilerProperties$Errors/LocnBadModuleInfo p))
                        (return nil))
                      (catch IOException e
                        (.error log (CompilerProperties$Errors/LocnCantReadFile p))
                        (return nil)))
                    (let [fn (.toString (.getFileName p))
                          ^:mutable mn (.substring fn 0 (unchecked-subtract-int (.length fn) 4))
                          matcher (.matcher (Pattern/compile "-(\\d+(\\.|$))") mn)]
                      (when (.find matcher)
                        (let [start (.start matcher)] (set! mn (.substring mn 0 start))))
                      (set! mn
                            (.replaceAll (.replaceAll
                                           (.replaceAll
                                             (.replaceAll mn "[^A-Za-z0-9]" ".")
                                             "(\\.)(\\1)+"
                                             ".")
                                           "^\\."
                                           "")
                                         "\\.$"
                                         ""))
                      (if (not (.isEmpty mn))
                          (Pair. mn p)
                          (do
                            (.error log (CompilerProperties$Errors/LocnCantGetModuleNameForJar p))
                            nil))))))
          :else
            (do
              (when (.endsWith (.toString (.getFileName p)) ".jmod")
                (try
                  (JmodFile/checkMagic p)
                  (let [^:mutable fs (cast FileSystem (.get fileSystems p))]
                    (when (nil? fs)
                      (let [jarFSProvider (.getJarFSProvider fsInfo)]
                        (when (nil? jarFSProvider)
                          (.error log (CompilerProperties$Errors/LocnCantReadFile p))
                          (return nil))
                        (set! fs (.newFileSystem jarFSProvider p (.readOnlyJarFSEnv fsInfo nil)))
                        (try
                          (let [moduleInfoClass (.getPath fs "classes/module-info.class")
                                moduleName (.readModuleName this moduleInfoClass)
                                modulePath (.getPath fs "classes")]
                            (.put fileSystems p fs)
                            (.add closeables fs)
                            (set! fs nil)
                            (return (Pair. moduleName modulePath)))
                          (finally (when (some? fs) (.close fs)))))))
                  (catch ModuleNameReader$BadClassFile e
                    (.error log (CompilerProperties$Errors/LocnBadModuleInfo p)))
                  (catch IOException e
                    (.error log (CompilerProperties$Errors/LocnCantReadFile p))
                    (return nil))))
              (when false
                (.warning log (CompilerProperties$LintWarnings/LocnUnknownFileOnModulePath p)))
              nil)))

      (method ^:private readModuleName :throws [IOException ModuleNameReader$BadClassFile] ^String [this
                                                                                                    ^Path path]
        (when (nil? moduleNameReader) (set! moduleNameReader (ModuleNameReader.)))
        (.readModuleName moduleNameReader path)))

    (method ^:private isModuleName ^boolean [this ^String name]
      (let [^:mutable ^int next 0
            ^:mutable ^int off 0]
        (while (not (== (set! next (.indexOf name \. off)) -1))
          (let [id (.substring name off next)]
            (when-not (SourceVersion/isName id) (return false))
            (set! off (unchecked-add-int next 1))))
        (let [last (.substring name off)] (SourceVersion/isName last)))))

  (defclass ^:private ModuleSourcePathLocationHandler
    :extends BasicLocationHandler

    (field ^:private ^ModuleTable moduleTable)

    (field ^:private ^{:tag (List Path)} paths)

    (constructor [this]
      (super. StandardLocation/MODULE_SOURCE_PATH Option/MODULE_SOURCE_PATH))

    (method handleOption ^boolean [this ^Option option ^String value]
      (set! (.-explicit this) true)
      (.init this value)
      true)

    (method init ^void [this ^String value]
      (let [moduleSpecificForm (Pattern/compile "([\\p{Alnum}$_.]+)=(.*)")
            ^{:tag (List String)} pathsForModules (ArrayList.)
            ^:mutable ^String modulePattern nil]
        (for-each [^String v (.split value "\u0000")]
          (if (.matches (.matcher moduleSpecificForm v))
              (.add pathsForModules v)
              (set! modulePattern v)))
        (when (some? modulePattern) (.initFromPattern this modulePattern))
        (.forEach
          pathsForModules
          (method-ref Consumer [String] this ModuleSourcePathLocationHandler/.initForModule))))

    (method initForModule ^void [this ^String value]
      (let [eq (.indexOf value \=)
            name (.substring value 0 eq)
            ^{:tag (List Path)} paths (ArrayList.)]
        (for-each [^String v (.split (.substring value (unchecked-add-int eq 1)) File/pathSeparator)]
          (try
            (.add paths (Paths/get v (new String/1 [])))
            (catch InvalidPathException e
              (throw (IllegalArgumentException. (java-str "invalid path: " v) e)))))
        (try
          (.setPathsForModule this name paths)
          (catch IOException e
            (.printStackTrace e)
            (throw (IllegalArgumentException. (java-str "cannot set path for module " name) e))))))

    (method initFromPattern ^void [this ^String value]
      (let [^{:tag (Collection String)} segments (ArrayList.)]
        (for-each [^String s (.split value File/pathSeparator)] (.expandBraces this s segments))
        (let [^{:tag (Map String (List Path))} map (LinkedHashMap.)
              ^{:tag (List Path)} noSuffixPaths (ArrayList.)
              ^:mutable anySuffix false
              ^:const MARKER "*"]
          (for-each [^String seg segments]
            (let [markStart (.indexOf seg MARKER)]
              (if (== markStart -1)
                  (let [p (.getPath Locations/this seg)]
                    (.add this map p nil)
                    (.add noSuffixPaths p))
                  (do
                    (when (or (== markStart 0)
                              (not (.isSeparator
                                     this
                                     (.charAt seg (unchecked-subtract-int markStart 1)))))
                      (throw
                        (IllegalArgumentException.
                          (java-str (java-str (java-str "illegal use of " MARKER) " in ") seg))))
                    (let [prefix (.getPath Locations/this
                                           (.substring seg 0 (unchecked-subtract-int markStart 1)))
                          ^:mutable ^Path suffix nil
                          markEnd (unchecked-add-int markStart (.length MARKER))]
                      (cond
                        (== markEnd (.length seg)) (set! suffix nil)
                        (or (not (.isSeparator this (.charAt seg markEnd)))
                            (not (== (.indexOf seg MARKER markEnd) -1)))
                          (throw (IllegalArgumentException.
                                   (java-str (java-str (java-str "illegal use of " MARKER) " in ")
                                             seg)))
                        :else
                          (do
                            (set! suffix
                                  (.getPath Locations/this
                                            (.substring seg (unchecked-add-int markEnd 1))))
                            (set! anySuffix true)))
                      (.add this map prefix suffix)
                      (when (nil? suffix) (.add noSuffixPaths prefix)))))))
          (.initModuleTable this map)
          (set! paths (when-not anySuffix noSuffixPaths)))))

    (method ^:private initModuleTable ^void [this ^{:tag (Map String (List Path))} map]
      (set! moduleTable (ModuleTable.))
      (.forEach map
                (lambda BiConsumer ^void [^String modName ^List modPath]
                  (let [hasModuleInfo (.anyMatch (.stream modPath) checkModuleInfo)]
                    (when hasModuleInfo
                      (let [locnName (java-str (.getName (.-location this)) "[" modName "]")
                            l (ModuleLocationHandler. this locnName modName modPath false)]
                        (.add moduleTable l)))))))

    (field ^:private ^:final ^{:tag (Predicate Path)} checkModuleInfo
      (lambda Predicate ^boolean [^Path p] (Files/exists (.resolve p "module-info.java"))))

    (method ^:private isSeparator ^boolean [this ^char ch]
      (or (== ch File/separatorChar) (== ch \/)))

    (method add ^void [this ^{:tag (Map String (List Path))} map ^Path prefix ^Path suffix]
      (if (not (Files/isDirectory prefix))
          (.warning
            log
            ^JCDiagnostic$Warning (if (Files/exists prefix)
                                      ^JCDiagnostic$Warning (CompilerProperties$LintWarnings/DirPathElementNotDirectory
                                                              prefix)
                                      ^JCDiagnostic$Warning (CompilerProperties$LintWarnings/DirPathElementNotFound
                                                              prefix)))
          (try
            (with-resources [^{:tag (DirectoryStream Path)} stream (Files/newDirectoryStream
                                                                     prefix
                                                                     (lambda DirectoryStream$Filter ^boolean [^Path path]
                                                                       (Files/isDirectory path)))]
              (for-each [^Path entry stream]
                (let [^Path path (if (nil? suffix) entry (.resolve entry suffix))]
                  (when (Files/isDirectory path)
                    (let [name (.toString (.getFileName entry))
                          ^:mutable ^{:tag (List Path)} paths (cast List (.get map name))]
                      (when (nil? paths) (.put map name (set! paths (ArrayList.))))
                      (.add paths path))))))
            (catch IOException e (.println System/err e)))))

    (method ^:private expandBraces ^void [this ^String value ^{:tag (Collection String)} results]
      (let [^:mutable ^int depth 0
            ^:mutable ^int start -1
            ^:mutable ^String prefix nil
            ^:mutable ^String suffix nil]
        (loop [^int i 0]
          (when (< i (.length value))
            (switch (.charAt value i)
              \{
                (do
                  (set! depth (unchecked-inc-int depth))
                  (when (== depth 1)
                    (set! prefix (.substring value 0 i))
                    (set! suffix
                          (.substring value (unchecked-add-int (.getMatchingBrace this value i) 1)))
                    (set! start (unchecked-add-int i 1)))
                  (recur (unchecked-inc-int i)))
              \,
                (do
                  (when (== depth 1)
                    (let [elem (.substring value start i)]
                      (.expandBraces this (java-str prefix elem suffix) results)
                      (set! start (unchecked-add-int i 1))))
                  (recur (unchecked-inc-int i)))
              \}
                (do
                  (switch depth
                    0 (throw (IllegalArgumentException. "mismatched braces"))
                    1
                      (let [elem (.substring value start i)]
                        (.expandBraces this (java-str prefix elem suffix) results)
                        (return))
                    (set! depth (unchecked-dec-int depth)))
                  (recur (unchecked-inc-int i)))
              (recur (unchecked-inc-int i)))))
        (when (> depth 0) (throw (IllegalArgumentException. "mismatched braces")))
        (.add results value)))

    (method getMatchingBrace ^int [this ^String value ^int offset]
      (let [^:mutable ^int depth 1]
        (loop [^int i (unchecked-add-int offset 1)]
          (when (< i (.length value))
            (switch (.charAt value i)
              \{ (do (set! depth (unchecked-inc-int depth)) (recur (unchecked-inc-int i)))
              \}
                (do
                  (when (== (set! depth (unchecked-dec-int depth)) 0) (return i))
                  (recur (unchecked-inc-int i)))
              (recur (unchecked-inc-int i)))))
        (throw (IllegalArgumentException. "mismatched braces"))))

    (method isSet ^boolean [this] (some? moduleTable))

    (method getPaths ^{:tag (Collection Path)} [this]
      (when (nil? paths) (throw (IllegalStateException. "paths not available")))
      paths)

    (method setPaths :throws [IOException] ^void [this ^{:tag (Iterable (? extends Path))} files]
      (let [^{:tag (Map String (List Path))} map (LinkedHashMap.)
            ^{:tag (List Path)} newPaths (ArrayList.)]
        (for-each [^Path file files] (.add this map file nil) (.add newPaths file))
        (.initModuleTable this map)
        (set! (.-explicit this) true)
        (set! paths (Collections/unmodifiableList newPaths))))

    (method setPathsForModule :throws [IOException] ^void [this ^String name
                                                           ^{:tag (Iterable (? extends Path))} paths]
      (let [^{:tag (List Path)} validPaths (.checkPaths this paths)]
        (when (nil? moduleTable) (set! moduleTable (ModuleTable.)))
        (let [^:mutable l (.get moduleTable name)]
          (if (nil? l)
              (do
                (set! l
                      (ModuleLocationHandler. this
                                              (java-str (.getName (.-location this)) "[" name "]")
                                              name
                                              validPaths
                                              true))
                (.add moduleTable l))
              (do (set! (.-searchPath l) validPaths) (.updatePaths moduleTable l)))
          (set! (.-explicit this) true))))

    (method ^:private checkPaths :throws [IOException] ^{:tag (List Path)} [this
                                                                            ^{:tag (Iterable (? extends Path))} paths]
      (Objects/requireNonNull paths)
      (let [^{:tag (List Path)} validPaths (ArrayList.)]
        (for-each [^Path p paths] (.add validPaths (.checkDirectory this p)))
        validPaths))

    (method getLocationForModule ^JavaFileManager$Location [this ^String name]
      (when (some? moduleTable) ^JavaFileManager$Location (.get moduleTable name)))

    (method getLocationForModule ^JavaFileManager$Location [this ^Path file]
      (when (some? moduleTable) ^JavaFileManager$Location (.get moduleTable file)))

    (method listLocationsForModules ^{:tag (Iterable (Set JavaFileManager$Location))} [this]
      (if (nil? moduleTable)
          (Collections/emptySet)
          (Collections/singleton (.locations moduleTable))))

    (method contains :throws [IOException] ^boolean [this ^Path file]
      (if (nil? moduleTable) false (.contains moduleTable file))))

  (defclass ^:private SystemModulesLocationHandler
    :extends BasicLocationHandler

    (field ^:private ^Path systemJavaHome)

    (field ^:private ^Path modules)

    (field ^:private ^ModuleTable moduleTable)

    (constructor [this]
      (super. StandardLocation/SYSTEM_MODULES Option/SYSTEM)
      (set! systemJavaHome Locations/javaHome))

    (method handleOption ^boolean [this ^Option option ^String value]
      (if (not (.contains (.-options this) option))
          false
          (do
            (set! (.-explicit this) true)
            (cond
              (nil? value) (set! systemJavaHome Locations/javaHome)
              (.equals value "none") (set! systemJavaHome nil)
              :else (.update this (.getPath Locations/this value)))
            (set! modules nil)
            true)))

    (method getPaths ^{:tag (Collection Path)} [this]
      (when (some? systemJavaHome) ^Collection (Collections/singleton systemJavaHome)))

    (method setPaths :throws [IOException] ^void [this ^{:tag (Iterable (? extends Path))} files]
      (if (nil? files)
          (set! systemJavaHome nil)
          (do
            (set! (.-explicit this) true)
            (let [dir (.checkSingletonDirectory this files)] (.update this dir)))))

    (method setPathsForModule :throws [IOException] ^void [this ^String name
                                                           ^{:tag (Iterable (? extends Path))} paths]
      (let [^{:tag (List Path)} checkedPaths (.checkPaths this paths)]
        (.initSystemModules this)
        (let [^:mutable l (.get moduleTable name)]
          (if (nil? l)
              (do
                (set! l
                      (ModuleLocationHandler. this
                                              (java-str (.getName (.-location this)) "[" name "]")
                                              name
                                              checkedPaths
                                              true))
                (.add moduleTable l))
              (do (set! (.-searchPath l) checkedPaths) (.updatePaths moduleTable l)))
          (set! (.-explicit this) true))))

    (method ^:private checkPaths :throws [IOException] ^{:tag (List Path)} [this
                                                                            ^{:tag (Iterable (? extends Path))} paths]
      (Objects/requireNonNull paths)
      (let [^{:tag (List Path)} validPaths (ArrayList.)]
        (for-each [^Path p paths] (.add validPaths (.checkDirectory this p)))
        validPaths))

    (method ^:private update ^void [this ^Path p]
      (when-not (.isCurrentPlatform this p)
        (let [noJavaRuntimeFS (Files/notExists
                                (SystemModulesLocationHandler/resolveInJavaHomeLib p "jrt-fs.jar"))
              noModulesFile (Files/notExists
                              (SystemModulesLocationHandler/resolveInJavaHomeLib p "modules"))]
          (when (or noJavaRuntimeFS noModulesFile)
            (throw (IllegalArgumentException. (.toString p))))))
      (set! systemJavaHome p)
      (set! modules nil))

    (method ^:private isCurrentPlatform ^boolean [this ^Path p]
      (try
        (Files/isSameFile p Locations/javaHome)
        (catch IOException ex (throw (IllegalArgumentException. (.toString p) ex)))))

    (method ^:private ^:static resolveInJavaHomeLib ^Path [^Path javaHomePath ^String name]
      (.resolve (.resolve javaHomePath "lib") name))

    (method getLocationForModule :throws [IOException] ^JavaFileManager$Location [this ^String name]
      (.initSystemModules this)
      (.get moduleTable name))

    (method getLocationForModule :throws [IOException] ^JavaFileManager$Location [this ^Path file]
      (.initSystemModules this)
      (.get moduleTable file))

    (method listLocationsForModules :throws [IOException] ^{:tag (Iterable (Set JavaFileManager$Location))} [this]
      (.initSystemModules this)
      (Collections/singleton (.locations moduleTable)))

    (method contains :throws [IOException] ^boolean [this ^Path file]
      (.initSystemModules this)
      (.contains moduleTable file))

    (method ^:private initSystemModules :throws [IOException] ^void [this]
      (when-not (some? moduleTable)
        (if (nil? systemJavaHome)
            (set! moduleTable (ModuleTable.))
            (do
              (when (nil? modules)
                (try
                  (let [jrtURI (URI/create "jrt:/")
                        ^:mutable ^FileSystem jrtfs nil]
                    (if (.isCurrentPlatform this systemJavaHome)
                        (set! jrtfs (FileSystems/getFileSystem jrtURI))
                        (do
                          (try
                            (let [^{:tag (Map String String)} attrMap (Collections/singletonMap
                                                                        "java.home"
                                                                        (.toString systemJavaHome))]
                              (set! jrtfs (FileSystems/newFileSystem jrtURI attrMap)))
                            (catch ProviderNotFoundException ex
                              (let [jfsJar (.toURL
                                             (.toUri
                                               (SystemModulesLocationHandler/resolveInJavaHomeLib
                                                 systemJavaHome
                                                 "jrt-fs.jar")))
                                    currentLoader (.getClassLoader Locations)
                                    fsLoader (URLClassLoader. (new URL/1 [jfsJar]) currentLoader)]
                                (set! jrtfs
                                      (FileSystems/newFileSystem
                                        jrtURI
                                        (Collections/emptyMap)
                                        fsLoader))
                                (.add closeables fsLoader))))
                          (.add closeables jrtfs)))
                    (set! modules (.getPath jrtfs "/modules")))
                  (catch [FileSystemNotFoundException ProviderNotFoundException] e
                    (set! modules
                          (SystemModulesLocationHandler/resolveInJavaHomeLib
                            systemJavaHome
                            "modules"))
                    (when-not (Files/exists modules)
                      (throw (IOException. "can't find system classes" e))))))
              (set! moduleTable (ModuleTable.))
              (with-resources [^{:tag (DirectoryStream Path)} stream (Files/newDirectoryStream
                                                                       modules
                                                                       (method-ref
                                                                         DirectoryStream$Filter
                                                                         [Path]
                                                                         Files/isDirectory))]
                (for-each [^Path entry stream]
                  (let [moduleName (.toString (.getFileName entry))
                        name (java-str (.getName (.-location this)) "[" moduleName "]")
                        h (ModuleLocationHandler.
                            this
                            name
                            moduleName
                            (Collections/singletonList entry)
                            false)]
                    (.add moduleTable h)))))))))

  (defclass ^:private PatchModulesLocationHandler
    :extends BasicLocationHandler

    (field ^:private ^:final ^ModuleTable moduleTable (ModuleTable.))

    (constructor [this]
      (super. StandardLocation/PATCH_MODULE_PATH Option/PATCH_MODULE))

    (method handleOption ^boolean [this ^Option option ^String value]
      (if (not (.contains (.-options this) option))
          false
          (do
            (set! (.-explicit this) true)
            (.clear moduleTable)
            (for-each [^String v (.split value "\u0000")]
              (let [eq (.indexOf v \=)]
                (if (> eq 0)
                    (let [moduleName (.substring v 0 eq)
                          mPatchPath (.addFiles (SearchPath.)
                                                (.substring v (unchecked-add-int eq 1)))
                          name (java-str (.getName (.-location this)) "[" moduleName "]")
                          h (ModuleLocationHandler. this name moduleName mPatchPath false)]
                      (.add moduleTable h))
                    (.error log (CompilerProperties$Errors/LocnInvalidArgForXpatch value)))))
            true)))

    (method isSet ^boolean [this] (not (.isEmpty moduleTable)))

    (method getPaths ^{:tag (Collection Path)} [this]
      (throw (UnsupportedOperationException.)))

    (method setPaths :throws [IOException] ^void [this ^{:tag (Iterable (? extends Path))} files]
      (throw (UnsupportedOperationException.)))

    (method setPathsForModule :throws [IOException] ^void [this ^String moduleName
                                                           ^{:tag (Iterable (? extends Path))} files]
      (throw (UnsupportedOperationException.)))

    (method getLocationForModule :throws [IOException] ^JavaFileManager$Location [this ^String name]
      (.get moduleTable name))

    (method getLocationForModule :throws [IOException] ^JavaFileManager$Location [this ^Path file]
      (.get moduleTable file))

    (method listLocationsForModules :throws [IOException] ^{:tag (Iterable (Set JavaFileManager$Location))} [this]
      (Collections/singleton (.locations moduleTable)))

    (method contains :throws [IOException] ^boolean [this ^Path file]
      (.contains moduleTable file)))

  (field ^{:tag (Map JavaFileManager$Location LocationHandler)} handlersForLocation)

  (field ^{:tag (Map Option LocationHandler)} handlersForOption)

  (method initHandlers ^void [this]
    (set! handlersForLocation (HashMap.))
    (set! handlersForOption (EnumMap. Option))
    (let [handlers (new BasicLocationHandler/1
                        [(BootClassPathLocationHandler.)
                         (ClassPathLocationHandler.)
                         (SimpleLocationHandler. StandardLocation/SOURCE_PATH Option/SOURCE_PATH)
                         (SimpleLocationHandler.
                           StandardLocation/ANNOTATION_PROCESSOR_PATH
                           Option/PROCESSOR_PATH)
                         (SimpleLocationHandler.
                           StandardLocation/ANNOTATION_PROCESSOR_MODULE_PATH
                           Option/PROCESSOR_MODULE_PATH)
                         (OutputLocationHandler. StandardLocation/CLASS_OUTPUT Option/D)
                         (OutputLocationHandler. StandardLocation/SOURCE_OUTPUT Option/S)
                         (OutputLocationHandler. StandardLocation/NATIVE_HEADER_OUTPUT Option/H)
                         (ModuleSourcePathLocationHandler.)
                         (PatchModulesLocationHandler.)
                         (ModulePathLocationHandler.
                           StandardLocation/UPGRADE_MODULE_PATH
                           Option/UPGRADE_MODULE_PATH)
                         (ModulePathLocationHandler.
                           StandardLocation/MODULE_PATH
                           Option/MODULE_PATH)
                         (SystemModulesLocationHandler.)])]
      (for-each [^BasicLocationHandler h handlers]
        (.put handlersForLocation (.-location h) h)
        (for-each [^Option o (.-options h)] (.put handlersForOption o h)))))

  (method handleOption ^boolean [this ^Option option ^String value]
    (let [h (cast LocationHandler (.get handlersForOption option))]
      (if (nil? h) false (.handleOption h option value))))

  (method hasLocation ^boolean [this ^JavaFileManager$Location location]
    (let [h (.getHandler this location)] (if (nil? h) false (.isSet h))))

  (method hasExplicitLocation ^boolean [this ^JavaFileManager$Location location]
    (let [h (.getHandler this location)] (if (nil? h) false (.isExplicit h))))

  (method getLocation ^{:tag (Collection Path)} [this ^JavaFileManager$Location location]
    (let [h (.getHandler this location)] (when (some? h) (.getPaths h))))

  (method getOutputLocation ^Path [this ^JavaFileManager$Location location]
    (when-not (.isOutputLocation location) (throw (IllegalArgumentException.)))
    (let [h (.getHandler this location)] (.-outputDir (cast OutputLocationHandler h))))

  (method setLocation :throws [IOException] ^void [this ^JavaFileManager$Location location
                                                   ^{:tag (Iterable (? extends Path))} files]
    (let [^:mutable h (.getHandler this location)]
      (when (nil? h)
        (if (.isOutputLocation location)
            (set! h (OutputLocationHandler. location))
            (set! h (SimpleLocationHandler. location)))
        (.put handlersForLocation location h))
      (.setPaths h files)))

  (method getLocationForModule :throws [IOException] ^JavaFileManager$Location [this
                                                                                ^JavaFileManager$Location location
                                                                                ^String name]
    (let [h (.getHandler this location)] (when (some? h) (.getLocationForModule h name))))

  (method getLocationForModule :throws [IOException] ^JavaFileManager$Location [this
                                                                                ^JavaFileManager$Location location
                                                                                ^Path file]
    (let [h (.getHandler this location)] (when (some? h) (.getLocationForModule h file))))

  (method setLocationForModule :throws [IOException] ^void [this ^JavaFileManager$Location location
                                                            ^String moduleName
                                                            ^{:tag (Iterable (? extends Path))} files]
    (let [^:mutable h (.getHandler this location)]
      (when (nil? h)
        (if (.isOutputLocation location)
            (set! h (OutputLocationHandler. location))
            (set! h (ModulePathLocationHandler. location)))
        (.put handlersForLocation location h))
      (.setPathsForModule h moduleName files)))

  (method inferModuleName ^String [this ^JavaFileManager$Location location]
    (let [h (.getHandler this location)] (when (some? h) (.inferModuleName h))))

  (method listLocationsForModules :throws [IOException] ^{:tag (Iterable (Set JavaFileManager$Location))} [this
                                                                                                           ^JavaFileManager$Location location]
    (let [h (.getHandler this location)] (when (some? h) (.listLocationsForModules h))))

  (method contains :throws [IOException] ^boolean [this ^JavaFileManager$Location location
                                                   ^Path file]
    (let [h (.getHandler this location)]
      (when (nil? h) (throw (IllegalArgumentException. "unknown location")))
      (.contains h file)))

  (method ^:protected getHandler ^LocationHandler [this ^JavaFileManager$Location location]
    (Objects/requireNonNull location)
    (if-instance [^LocationHandler locationHandler location]
      locationHandler
      (cast LocationHandler (.get handlersForLocation location))))

  (method ^:private isArchive ^boolean [this ^Path file]
    (let [n (StringUtils/toLowerCase (.toString (.getFileName file)))]
      (and (.isFile fsInfo file) (or (.endsWith n ".jar") (.endsWith n ".zip")))))

  (method ^:static normalize ^Path [^Path p]
    (try (.toRealPath p) (catch IOException e (.normalize (.toAbsolutePath p))))))

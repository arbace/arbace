      (.getFileForOutput this location name sibling)))

  (method ^:private getFileForOutput :throws [IOException] ^JavaFileObject [this
                                                                            ^JavaFileManager$Location location
                                                                            ^RelativePath$RelativeFile fileName
                                                                            ^FileObject sibling]
    (let [^:mutable ^Path dir nil]
      (cond
        (identical? location StandardLocation/CLASS_OUTPUT)
          (if (some? (.getClassOutDir this))
              (set! dir (.getClassOutDir this))
              (let [baseName (.basename fileName)]
                (if-instance [^PathFileObject pathFileObject sibling]
                  (if (not (.isJarFile pathFileObject))
                      (return (.getSibling pathFileObject baseName))
                      (let [userPath (.getPath this baseName)
                            realPath (.getCanonicalFile fsInfo userPath)]
                        (return (PathFileObject/forSimplePath this realPath userPath))))
                  (let [userPath (.getPath this baseName)
                        realPath (.getCanonicalFile fsInfo userPath)]
                    (return (PathFileObject/forSimplePath this realPath userPath))))))
        (identical? location StandardLocation/SOURCE_OUTPUT)
          (set! dir
                (if (some? (.getSourceOutDir this)) (.getSourceOutDir this) (.getClassOutDir this)))
        :else
          (let [^{:tag (Iterable (? extends Path))} path (.getLocation (.-locations this) location)]
            (set! dir nil)
            (for-each [^Path f path] (set! dir f) (break))))
      (try
        (when (nil? dir) (set! dir (.getPath this (System/getProperty "user.dir"))))
        (let [path (.resolveAgainst fileName (.getCanonicalFile fsInfo dir))]
          (PathFileObject/forDirectoryPath this path dir fileName))
        (catch InvalidPathException e (throw (IOException. (java-str "bad filename " fileName) e))))))

  (method ^:public getJavaFileObjectsFromFiles ^{:tag (Iterable (? extends JavaFileObject))} [this
                                                                                              ^{:tag (Iterable (? extends File))} files]
    (let [^{:tag (ArrayList PathFileObject)} result (if-instance [^{:tag (Collection ?)} collection
                                                                    files]
                                                      (ArrayList. (.size collection))
                                                      (ArrayList.))]
      (for-each [^File f files]
        (Objects/requireNonNull f)
        (let [p (.toPath f)]
          (.add result (PathFileObject/forSimplePath this (.getCanonicalFile fsInfo p) p))))
      result))

  (method ^:public getJavaFileObjectsFromPaths ^{:tag (Iterable (? extends JavaFileObject))} [this
                                                                                              ^{:tag (Collection (? extends Path))} paths]
    (let [^:mutable ^{:tag (ArrayList PathFileObject)} result nil]
      (if (some? paths)
          (do
            (set! result (ArrayList. (.size paths)))
            (for-each [^Path p paths]
              (.add result (PathFileObject/forSimplePath this (.getCanonicalFile fsInfo p) p))))
          (set! result (ArrayList.)))
      result))

  (method ^:public getJavaFileObjects ^{:tag (Iterable (? extends JavaFileObject))} [this &
                                                                                     ^File/1 files]
    (.getJavaFileObjectsFromFiles this
                                  (Arrays/asList (cast File/1 (JavacFileManager/nullCheck files)))))

  (method ^:public getJavaFileObjects ^{:tag (Iterable (? extends JavaFileObject))} [this &
                                                                                     ^Path/1 paths]
    (.getJavaFileObjectsFromPaths this
                                  (Arrays/asList (cast Path/1 (JavacFileManager/nullCheck paths)))))

  (method ^:public setLocation :throws [IOException] ^void [this ^JavaFileManager$Location location
                                                            ^{:tag (Iterable (? extends File))} searchpath]
    (JavacFileManager/nullCheck location)
    (.setLocation (.-locations this) location (JavacFileManager/asPaths searchpath))
    (.clearCachesForLocation this location))

  (method ^:public setLocationFromPaths :throws [IOException] ^void [this
                                                                     ^JavaFileManager$Location location
                                                                     ^{:tag (Collection (? extends Path))} searchpath]
    (JavacFileManager/nullCheck location)
    (.setLocation (.-locations this) location (JavacFileManager/nullCheck searchpath))
    (.clearCachesForLocation this location))

  (method ^:public getLocation ^{:tag (Iterable (? extends File))} [this
                                                                    ^JavaFileManager$Location location]
    (JavacFileManager/nullCheck location)
    (JavacFileManager/asFiles (.getLocation (.-locations this) location)))

  (method ^:public getLocationAsPaths ^{:tag (Collection (? extends Path))} [this
                                                                             ^JavaFileManager$Location location]
    (JavacFileManager/nullCheck location)
    (.getLocation (.-locations this) location))

  (method ^:private pathsAndContainers :throws [IOException] ^{:tag (List PathAndContainer)} [this
                                                                                              ^JavaFileManager$Location location
                                                                                              ^RelativePath$RelativeDirectory relativeDirectory]
    (try
      (cast List
            (.computeIfAbsent
              (cast Map
                    (.computeIfAbsent
                      pathsAndContainersByLocationAndRelativeDirectory
                      location
                      (method-ref Function
                                  ^Map [JavaFileManager$Location]
                                  this
                                  JavacFileManager/.indexPathsAndContainersByRelativeDirectory)))
              relativeDirectory
              (lambda Function ^List [^RelativePath$RelativeDirectory d]
                (cast List (.get nonIndexingContainersByLocation location)))))
      (catch UncheckedIOException e (throw (.getCause e)))))

  (method ^:private indexPathsAndContainersByRelativeDirectory ^{:tag (Map RelativePath$RelativeDirectory (List PathAndContainer))} [this
                                                                                                                                     ^JavaFileManager$Location location]
    (let [^{:tag (Map RelativePath$RelativeDirectory (List PathAndContainer))} result (HashMap.)
          ^{:tag (List PathAndContainer)} allPathsAndContainers (.pathsAndContainers this location)
          ^{:tag (List PathAndContainer)} nonIndexingContainers (ArrayList.)]
      (for-each [^PathAndContainer pathAndContainer allPathsAndContainers]
        (when-not (.maintainsDirectoryIndex (.-container pathAndContainer))
          (.add nonIndexingContainers pathAndContainer)))
      (for-each [^PathAndContainer pathAndContainer allPathsAndContainers]
        (let [container (.-container pathAndContainer)]
          (when (.maintainsDirectoryIndex container)
            (for-each [^RelativePath$RelativeDirectory directory (.indexedDirectories container)]
              (.add (cast List
                          (.computeIfAbsent
                            result
                            directory
                            (lambda Function ^List [^RelativePath$RelativeDirectory d]
                              (ArrayList. nonIndexingContainers))))
                    pathAndContainer)))))
      (.put nonIndexingContainersByLocation location nonIndexingContainers)
      (.forEach (.values result)
                (lambda Consumer ^void [^List pathAndContainerList]
                  (Collections/sort pathAndContainerList)))
      result))

  (method ^:private pathsAndContainers ^{:tag (List PathAndContainer)} [this
                                                                        ^JavaFileManager$Location location]
    (let [^{:tag (Collection (? extends Path))} paths (.getLocationAsPaths this location)]
      (if (nil? paths)
          (com.sun.tools.javac.util.List/nil)
          (let [^{:tag (List PathAndContainer)} pathsAndContainers (ArrayList. (.size paths))]
            (for-each [^Path path paths]
              (let [^:mutable ^Container container nil]
                (try
                  (set! container (.getContainer this path))
                  (catch IOException e (throw (UncheckedIOException. e))))
                (.add pathsAndContainers
                      (PathAndContainer. path container (.size pathsAndContainers)))))
            pathsAndContainers))))

  (defclass ^:private ^:static PathAndContainer
    :implements [(Comparable PathAndContainer)]

    (field ^:private ^:final ^Path path)

    (field ^:private ^:final ^Container container)

    (field ^:private ^:final ^int index)

    (constructor [this ^Path path ^Container container ^int index]
      (set! (.-path this) path)
      (set! (.-container this) container)
      (set! (.-index this) index))

    (method ^:public compareTo ^int [this ^PathAndContainer other]
      (unchecked-subtract-int index (.-index other)))

    (method ^:public equals ^boolean [this o]
      (if-instance [^PathAndContainer pathAndContainer o]
        (if (.equals path (.-path pathAndContainer))
            (if (.equals container (.-container pathAndContainer))
                (== index (.-index pathAndContainer))
                false)
            false)
        false))

    (method ^:public hashCode ^int [this]
      (Objects/hash path container index)))

  (method ^:public contains :throws [IOException] ^boolean [this ^JavaFileManager$Location location
                                                            ^FileObject fo]
    (JavacFileManager/nullCheck location)
    (JavacFileManager/nullCheck fo)
    (let [p (.asPath this fo)] (.contains (.-locations this) location p)))

  (method ^:private getClassOutDir ^Path [this]
    (.getOutputLocation (.-locations this) StandardLocation/CLASS_OUTPUT))

  (method ^:private getSourceOutDir ^Path [this]
    (.getOutputLocation (.-locations this) StandardLocation/SOURCE_OUTPUT))

  (method ^:public getLocationForModule :throws [IOException] ^JavaFileManager$Location [this
                                                                                         ^:mutable ^JavaFileManager$Location location
                                                                                         ^String moduleName]
    (.checkModuleOrientedOrOutputLocation this location)
    (JavacFileManager/nullCheck moduleName)
    (when (and (identical? location StandardLocation/SOURCE_OUTPUT) (nil? (.getSourceOutDir this)))
      (set! location StandardLocation/CLASS_OUTPUT))
    (.getLocationForModule (.-locations this) location moduleName))

  (method ^:public getServiceLoader :type-params [S] :throws [IOException] ^{:tag (ServiceLoader S)} [this
                                                                                                      ^JavaFileManager$Location location
                                                                                                      ^{:tag (Class S)} service]
    (JavacFileManager/nullCheck location)
    (JavacFileManager/nullCheck service)
    (.addUses (.getModule (.getClass this)) service)
    (if (.isModuleOrientedLocation location)
        (let [^{:tag (Collection Path)} paths (.getLocation (.-locations this) location)
              finder (ModuleFinder/of (cast Path/1 (.toArray paths (new Path/1 (.size paths)))))
              bootLayer (ModuleLayer/boot)
              cf (.resolveAndBind (.configuration bootLayer)
                                  (ModuleFinder/of)
                                  finder
                                  (Collections/emptySet))
              layer (.defineModulesWithOneLoader bootLayer cf (ClassLoader/getSystemClassLoader))]
          (ServiceLoader/load layer service))
        (ServiceLoader/load service (.getClassLoader this location))))

  (method ^:public getLocationForModule :throws [IOException] ^JavaFileManager$Location [this
                                                                                         ^JavaFileManager$Location location
                                                                                         ^JavaFileObject fo]
    (.checkModuleOrientedOrOutputLocation this location)
    (when-instance [^PathFileObject pathFileObject fo]
      (let [p (Locations/normalize (.-path pathFileObject))]
        (.getLocationForModule (.-locations this) location p))))

  (method ^:public setLocationForModule :throws [IOException] ^void [this
                                                                     ^JavaFileManager$Location location
                                                                     ^String moduleName
                                                                     ^{:tag (Collection (? extends Path))} paths]
    (JavacFileManager/nullCheck location)
    (.checkModuleOrientedOrOutputLocation this location)
    (.setLocationForModule (.-locations this)
                           location
                           (cast String (JavacFileManager/nullCheck moduleName))
                           (JavacFileManager/nullCheck paths))
    (.clearCachesForLocation this location))

  (method ^:public inferModuleName ^String [this ^JavaFileManager$Location location]
    (.checkNotModuleOrientedLocation this location)
    (.inferModuleName (.-locations this) location))

  (method ^:public listLocationsForModules :throws [IOException] ^{:tag (Iterable (Set JavaFileManager$Location))} [this
                                                                                                                    ^JavaFileManager$Location location]
    (.checkModuleOrientedOrOutputLocation this location)
    (.listLocationsForModules (.-locations this) location))

  (method ^:public asPath ^Path [this ^FileObject file]
    (if-instance [^PathFileObject pathFileObject file]
      (.-path pathFileObject)
      (throw (IllegalArgumentException. (.getName file)))))

  (method ^:protected ^:static isRelativeUri ^boolean [^URI uri]
    (if (.isAbsolute uri)
        false
        (let [path (.getPath (.normalize uri))]
          (cond
            (== (.length path) 0) false
            (not (.equals path (.getPath uri))) false
            (or (or (.startsWith path "/") (.startsWith path "./")) (.startsWith path "../")) false
            :else true))))

  (method ^:protected ^:static isRelativeUri ^boolean [^String u]
    (try (JavacFileManager/isRelativeUri (URI. u)) (catch URISyntaxException e false)))

  (method ^:public ^:static getRelativeName ^String [^File file]
    (when-not (.isAbsolute file)
      (let [result (.replace (.getPath file) File/separatorChar \/)]
        (when (JavacFileManager/isRelativeUri result) (return result))))
    (throw (IllegalArgumentException. (java-str "Invalid relative path: " file))))

  (method ^:public ^:static getMessage ^String [^IOException e]
    (let [^:mutable s (.getLocalizedMessage e)]
      (if (some? s) s (do (set! s (.getMessage e)) (if (some? s) s (.toString e))))))

  (method ^:private checkOutputLocation ^void [this ^JavaFileManager$Location location]
    (Objects/requireNonNull location)
    (when-not (.isOutputLocation location)
      (throw (IllegalArgumentException.
               (java-str "location is not an output location: " (.getName location))))))

  (method ^:private checkModuleOrientedOrOutputLocation ^void [this
                                                               ^JavaFileManager$Location location]
    (Objects/requireNonNull location)
    (when (and (not (.isModuleOrientedLocation location)) (not (.isOutputLocation location)))
      (throw (IllegalArgumentException.
               (java-str "location is not an output location or a module-oriented location: "
                         (.getName location))))))

  (method ^:private checkNotModuleOrientedLocation ^void [this ^JavaFileManager$Location location]
    (Objects/requireNonNull location)
    (when (.isModuleOrientedLocation location)
      (throw (IllegalArgumentException.
               (java-str "location is module-oriented: " (.getName location))))))

  (method ^:private ^:static asPaths ^{:tag (Iterable Path)} [^:final ^{:tag (Iterable (? extends File))} files]
    (when (some? files)
      (lambda Iterable ^Iterator []
        (anon (Iterator Path) []
          (field ^{:tag (Iterator (? extends File))} iter (.iterator files))

          (method ^:public hasNext ^boolean [this] (.hasNext iter))

          (method ^:public next ^Path [this] (.toPath (cast File (.next iter))))))))

  (method ^:private ^:static asFiles ^{:tag (Iterable File)} [^:final ^{:tag (Iterable (? extends Path))} paths]
    (when (some? paths)
      (lambda Iterable ^Iterator []
        (anon (Iterator File) []
          (field ^{:tag (Iterator (? extends Path))} iter (.iterator paths))

          (method ^:public hasNext ^boolean [this] (.hasNext iter))

          (method ^:public next ^File [this]
            (try
              (.toFile (cast Path (.next iter)))
              (catch UnsupportedOperationException e (throw (IllegalStateException. e)))))))))

  (method ^:public handleOption ^boolean [this ^Option option ^String value]
    (when (.contains JavacFileManager/javacFileManagerOptions option)
      (.clear pathsAndContainersByLocationAndRelativeDirectory)
      (.clear nonIndexingContainersByLocation))
    (.handleOption super option value))

  (method ^:private clearCachesForLocation ^void [this ^JavaFileManager$Location location]
    (JavacFileManager/nullCheck location)
    (.remove pathsAndContainersByLocationAndRelativeDirectory location)
    (.remove nonIndexingContainersByLocation location)))

                                                 (lambda Predicate ^boolean [^JavaFileObject fo]
                                                   (some? fo)))
                                               (lambda IntFunction ^JavaFileObject/1 [^int s]
                                                 (new JavaFileObject/1 s))))]
          originatingFiles)))

  (method ^:public createResource :throws [IOException] ^FileObject [this
                                                                     ^:mutable ^JavaFileManager$Location location
                                                                     ^CharSequence moduleAndPkg
                                                                     ^CharSequence relativeName &
                                                                     ^Element/1 originatingElements]

  (method ^:private checkOrInferModule :throws [FilerException] ^{:tag (Pair Symbol$ModuleSymbol String)} [this
                                                                                                           ^CharSequence moduleAndPkg]
    (let [moduleAndPkgString (.toString moduleAndPkg)
          slash (.indexOf moduleAndPkgString \/)
          ^:mutable ^String module nil
          ^:mutable ^String pkg nil]
      (if (== slash -1)
          (let [lastDot (.lastIndexOf moduleAndPkgString \.)
                ^String pack (if (not (== lastDot -1)) (.substring moduleAndPkgString 0 lastDot) "")
                msym (.inferModule this pack)]
            (when (some? msym) (return (Pair/of msym moduleAndPkgString)))
            (when (nil? defaultTargetModule)
              (throw (FilerException. "Cannot determine target module.")))
            (set! module defaultTargetModule)
            (set! pkg moduleAndPkgString))
          (do
            (set! module (.substring moduleAndPkgString 0 slash))
            (set! pkg (.substring moduleAndPkgString (unchecked-add-int slash 1)))))
      (let [explicitModule (.getModule syms (.fromString names module))]
        (when (nil? explicitModule)
          (throw (FilerException. (java-str "Module: " module " does not exist."))))
        (when-not (.isRootModule modules explicitModule)
          (throw (FilerException. "Cannot write to the given module.")))
        (Pair/of explicitModule pkg))))

  (method ^:private createSourceOrClassFile :throws [IOException] ^JavaFileObject [this
                                                                                   ^Symbol$ModuleSymbol mod
                                                                                   ^boolean isSourceFile
                                                                                   ^String name &
                                                                                   ^Element/1 originatingElements]
    (Assert/checkNonNull mod)
    (let [periodIndex (.lastIndexOf name ".")]
      (when-not (== periodIndex -1)
        (let [base (.substring name periodIndex)
              ^String extn (if isSourceFile ".java" ".class")]
          (when (.equals base extn)
            (.warning log (CompilerProperties$LintWarnings/ProcSuspiciousClassName name extn)))))
      (.checkNameAndExistence this mod name isSourceFile)
      (let [^:mutable ^JavaFileManager$Location loc (if isSourceFile
                                                        StandardLocation/SOURCE_OUTPUT
                                                        StandardLocation/CLASS_OUTPUT)]
        (when (.-multiModuleMode modules)
          (set! loc (.getLocationForModule (.-fileManager this) loc (.toString (.-name mod)))))
        (let [^JavaFileObject$Kind kind (if isSourceFile
                                            JavaFileObject$Kind/SOURCE
                                            JavaFileObject$Kind/CLASS)
              fileObject (.getJavaFileForOutputForOriginatingFiles
                           fileManager
                           loc
                           name
                           kind
                           (.originatingFiles this originatingElements))]
          (.checkFileReopening this fileObject true)
          (when lastRound (.warning log (CompilerProperties$Warnings/ProcFileCreateLastRound name)))
          (if isSourceFile
              (.add aggregateGeneratedSourceNames (Pair/of mod name))
              (.add aggregateGeneratedClassNames (Pair/of mod name)))
          (.add openTypeNames name)
          (FilerOutputJavaFileObject. mod name fileObject)))))

  (method ^:private originatingFiles ^JavaFileObject/1 [this ^Element/1 originatingElements]

      (let [msym (cast Symbol$ModuleSymbol (.-b locationModuleAndPackage))
            pkg (cast String (.-c locationModuleAndPackage))]
        (.locationCheck this location)
        (when (> (.length pkg) 0) (.checkName this pkg))
        (let [fileObject (.getFileForOutputForOriginatingFiles
                           fileManager
                           location
                           pkg
                           (.toString relativeName)
                           (.originatingFiles this originatingElements))]
          (.checkFileReopening this fileObject true)
          (if-instance [^JavaFileObject javaFileObject fileObject]
            (FilerOutputJavaFileObject. msym nil javaFileObject)
            (FilerOutputFileObject. msym nil fileObject))))))

  (method ^:private locationCheck ^void [this ^JavaFileManager$Location location]
    (when-instance [^StandardLocation standardLocation location]
      (when-not (.isOutputLocation standardLocation)
        (throw (IllegalArgumentException.
                 (java-str "Resource creation not supported in location " standardLocation))))))

  (method ^:public getResource :throws [IOException] ^FileObject [this
                                                                  ^:mutable ^JavaFileManager$Location location
                                                                  ^CharSequence moduleAndPkg
                                                                  ^CharSequence relativeName]
    (let [^{:tag (Tuple3 JavaFileManager$Location Symbol$ModuleSymbol String)} locationModuleAndPackage
            (.checkOrInferModule this location moduleAndPkg false)]
      (set! location (cast JavaFileManager$Location (.-a locationModuleAndPackage)))
      (let [pkg (cast String (.-c locationModuleAndPackage))]
        (when (> (.length pkg) 0) (.checkName this pkg))
        (let [^FileObject fileObject (if (.isOutputLocation location)
                                         (.getFileForOutputForOriginatingFiles
                                           fileManager
                                           location
                                           pkg
                                           (.toString relativeName))
                                         (.getFileForInput
                                           fileManager
                                           location
                                           pkg
                                           (.toString relativeName)))]
          (when (nil? fileObject)
            (let [^String name (if (== (.length pkg) 0)
                                   (.toString relativeName)
                                   (java-str pkg "/" relativeName))]
              (throw (FileNotFoundException. name))))
          (.checkFileReopening this fileObject false)
          (FilerInputFileObject. fileObject)))))

  (method ^:private checkOrInferModule :throws [IOException] ^{:tag (Tuple3 JavaFileManager$Location Symbol$ModuleSymbol String)} [this
                                                                                                                                   ^JavaFileManager$Location location
                                                                                                                                   ^CharSequence moduleAndPkg
                                                                                                                                   ^boolean write]
    (let [moduleAndPkgString (.toString moduleAndPkg)
          slash (.indexOf moduleAndPkgString \/)
          multiModuleLocation (or (.isModuleOrientedLocation location)
                                  (and (.-multiModuleMode modules) (.isOutputLocation location)))
          ^:mutable ^String module nil
          ^:mutable ^String pkg nil]
      (if (== slash -1)
          (do
            (when-not multiModuleLocation
              (return (Tuple3. location (.getDefaultModule modules) moduleAndPkgString)))
            (when (.isOutputLocation location)
              (let [msym (.inferModule this moduleAndPkgString)]
                (when (some? msym)
                  (let [moduleLoc (.getLocationForModule
                                    fileManager
                                    location
                                    (.toString (.-name msym)))]
                    (return (Tuple3. moduleLoc msym moduleAndPkgString))))))
            (when (nil? defaultTargetModule)
              (throw
                (FilerException.
                  "No module specified and the location is either a module-oriented location, or a multi-module output location.")))
            (set! module defaultTargetModule)
            (set! pkg moduleAndPkgString))
          (do
            (set! module (.substring moduleAndPkgString 0 slash))
            (set! pkg (.substring moduleAndPkgString (unchecked-add-int slash 1)))))
      (if multiModuleLocation
          (let [explicitModule (.getModule syms (.fromString names module))]
            (when (nil? explicitModule)
              (throw (FilerException. (java-str "Module: " module " does not exist."))))
            (when (and write (not (.isRootModule modules explicitModule)))
              (throw (FilerException. "Cannot write to the given module.")))
            (let [moduleLoc (.getLocationForModule fileManager location module)]
              (Tuple3. moduleLoc explicitModule pkg)))
          (throw
            (FilerException.
              "Module specified but the location is neither a module-oriented location, nor a multi-module output location.")))))

  (defclass ^:static ^:final Tuple3
    :type-params [A B C]

    (field ^:final ^A a)

    (field ^:final ^B b)

    (field ^:final ^C c)

    (constructor ^:public [this ^A a ^B b ^C c]
      (set! (.-a this) a)
      (set! (.-b this) b)
      (set! (.-c this) c)))

  (method ^:private inferModule ^Symbol$ModuleSymbol [this ^String pkg]
    (if (identical? (.getDefaultModule modules) (.-noModule syms))
        (.getDefaultModule modules)
        (let [^{:tag (Set Symbol$ModuleSymbol)} rootModules (.getRootModules modules)]
          (if (== (.size rootModules) 1)
              (cast Symbol$ModuleSymbol (.next (.iterator rootModules)))
              (let [pack (.getPackageElement elementUtils pkg)]
                (when (and (some? pack) (not (identical? (.-modle pack) (.-unnamedModule syms))))
                  (.-modle pack)))))))

  (method ^:private checkName :throws [FilerException] ^void [this ^String name]
    (.checkName this name false))

  (method ^:private checkName :throws [FilerException] ^void [this ^String name
                                                              ^boolean allowUnnamedPackageInfo]
    (when (and (not (SourceVersion/isName name))
               (not (.isPackageInfo this name allowUnnamedPackageInfo)))
      (.warning log (CompilerProperties$LintWarnings/ProcIllegalFileName name))
      (throw (FilerException. (java-str "Illegal name " name)))))

  (method ^:private isPackageInfo ^boolean [this ^String name ^boolean allowUnnamedPackageInfo]
    (let [^:const PKG_INFO "package-info"
          periodIndex (.lastIndexOf name ".")]
      (if (== periodIndex -1)
          (if allowUnnamedPackageInfo (.equals name PKG_INFO) false)
          (let [prefix (.substring name 0 periodIndex)
                simple (.substring name (unchecked-add-int periodIndex 1))]
            (and (SourceVersion/isName prefix) (.equals simple PKG_INFO))))))

  (method ^:private checkNameAndExistence :throws [FilerException] ^void [this
                                                                          ^Symbol$ModuleSymbol mod
                                                                          ^String typename
                                                                          ^boolean allowUnnamedPackageInfo]
    (.checkName this typename allowUnnamedPackageInfo)
    (let [existing (.getTypeElement elementUtils typename)
          alreadySeen (or (or (or (.contains aggregateGeneratedSourceNames (Pair/of mod typename))
                                  (.contains aggregateGeneratedClassNames (Pair/of mod typename)))
                              (.contains initialClassNames typename))
                          (.containedInInitialInputs this typename))]
      (when alreadySeen
        (.warning log (CompilerProperties$LintWarnings/ProcTypeRecreate typename))
        (throw (FilerException. (java-str "Attempt to recreate a file for type " typename))))
      (when (some? existing)
        (.warning log (CompilerProperties$LintWarnings/ProcTypeAlreadyExists typename)))
      (when (and (not (.isUnnamed mod)) (not (.contains typename ".")))
        (throw (FilerException.
                 (java-str "Attempt to create a type in unnamed package of a named module: "
                           typename))))))

  (method ^:private containedInInitialInputs ^boolean [this ^String typename]
    (let [^:mutable ^JavaFileObject sourceFile nil
          existingClass (.getTypeElement elementUtils typename)]
      (cond
        (some? existingClass) (set! sourceFile (.-sourcefile existingClass))
        (.endsWith typename ".package-info")
          (let [targetName (.substring typename
                                       0
                                       (unchecked-subtract-int
                                         (.length typename)
                                         (.length ".package-info")))
                existingPackage (.getPackageElement elementUtils targetName)]
            (when (some? existingPackage) (set! sourceFile (.-sourcefile existingPackage)))))
      (if (nil? sourceFile) false (.contains initialInputs sourceFile))))

  (method ^:private checkFileReopening :throws [FilerException] ^void [this ^FileObject fileObject
                                                                       ^boolean forWriting]
    (when (.isInFileObjectHistory this fileObject forWriting)
      (.warning log (CompilerProperties$LintWarnings/ProcFileReopening (.getName fileObject)))
      (throw
        (FilerException. (java-str "Attempt to reopen a file for path " (.getName fileObject)))))
    (when forWriting (.add fileObjectHistory fileObject)))

  (method ^:private isInFileObjectHistory ^boolean [this ^FileObject fileObject ^boolean forWriting]
    (when forWriting
      (for-each [^FileObject veteran initialInputs]
        (try
          (when (.isSameFile fileManager veteran fileObject) (return true))
          (catch IllegalArgumentException e)))
      (for-each [^String className initialClassNames]
        (try
          (let [existing (.getTypeElement elementUtils className)]
            (when (and (some? existing)
                       (or (and (some? (.-sourcefile existing))
                                (.isSameFile fileManager (.-sourcefile existing) fileObject))
                           (and (some? (.-classfile existing))
                                (.isSameFile fileManager (.-classfile existing) fileObject))))
              (return true)))
          (catch IllegalArgumentException e))))
    (for-each [^FileObject veteran fileObjectHistory]
      (when (.isSameFile fileManager veteran fileObject) (return true)))
    false)

  (method ^:public newFiles ^boolean [this]
    (or (not (.isEmpty generatedSourceNames)) (not (.isEmpty generatedClasses))))

  (method ^:public getGeneratedSourceNames ^{:tag (Set String)} [this]
    generatedSourceNames)

  (method ^:public getGeneratedSourceFileObjects ^{:tag (Set JavaFileObject)} [this]
    generatedSourceFileObjects)

  (method ^:public getGeneratedClasses ^{:tag (Map Symbol$ModuleSymbol (Map String JavaFileObject))} [this]
    generatedClasses)

  (method ^:public warnIfUnclosedFiles ^void [this]
    (when-not (.isEmpty openTypeNames)
      (.warning log (CompilerProperties$Warnings/ProcUnclosedTypeFiles openTypeNames))))

  (method ^:public newRound ^void [this] (.clearRoundState this))

  (method setLastRound ^void [this ^boolean lastRound]
    (set! (.-lastRound this) lastRound))

  (method ^:public setInitialState ^void [this
                                          ^{:tag (Collection (? extends JavaFileObject))} initialInputs
                                          ^{:tag (Collection String)} initialClassNames]
    (.addAll (.-initialInputs this) initialInputs)
    (.addAll (.-initialClassNames this) initialClassNames))

  (method ^:public close ^void [this]
    (.clearRoundState this)
    (.clear initialClassNames)
    (.clear initialInputs)
    (.clear fileObjectHistory)
    (.clear openTypeNames)
    (.clear aggregateGeneratedSourceNames)
    (.clear aggregateGeneratedClassNames))

  (method ^:private clearRoundState ^void [this]
    (.clear generatedSourceNames)
    (.clear generatedSourceFileObjects)
    (.clear generatedClasses))

  (method ^:public displayState ^void [this]
    (let [xout (.getWriter (cast Log (.get context Log/logKey)) Log$WriterKind/STDERR)]
      (.println xout (java-str "File Object History : " fileObjectHistory))
      (.println xout (java-str "Open Type Names     : " openTypeNames))
      (.println xout (java-str "Gen. Src Names      : " generatedSourceNames))
      (.println xout (java-str "Gen. Cls Names      : " (.keySet generatedClasses)))
      (.println xout (java-str "Agg. Gen. Src Names : " aggregateGeneratedSourceNames))
      (.println xout (java-str "Agg. Gen. Cls Names : " aggregateGeneratedClassNames))))

  (method ^:public toString ^String [this] "javac Filer")

  (method ^:private closeFileObject ^void [this ^Symbol$ModuleSymbol mod ^String typeName
                                           ^FileObject fileObject]
    (when (some? typeName)
      (if-instance [^JavaFileObject javaFileObject fileObject]
        (switch (.getKind javaFileObject)
          SOURCE
            (do
              (.add generatedSourceNames typeName)
              (.add generatedSourceFileObjects javaFileObject)
              (.remove openTypeNames typeName))
          CLASS
            (do
              (.put (cast Map
                          (.computeIfAbsent generatedClasses
                                            mod
                                            (lambda Function ^Map [^Symbol$ModuleSymbol m]
                                              (Collections/synchronizedMap (LinkedHashMap.)))))
                    typeName
                    javaFileObject)
              (.remove openTypeNames typeName))
          nil)
        (throw (AssertionError. (java-str "JavaFileObject not found for " fileObject)))))))

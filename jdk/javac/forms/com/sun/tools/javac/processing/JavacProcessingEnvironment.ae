  (method ^:private discoverAndRunProcs ^void [this ^{:tag (Set TypeElement)} annotationsPresent
                                               ^{:tag (List Symbol$ClassSymbol)} topLevelClasses
                                               ^{:tag (List Symbol$PackageSymbol)} packageInfoFiles
                                               ^{:tag (List Symbol$ModuleSymbol)} moduleInfoFiles]
    (let [^{:tag (Map String TypeElement)} unmatchedAnnotations (HashMap.
                                                                  (.size annotationsPresent))]
      (for-each [^TypeElement a annotationsPresent]
        (let [mod (.getModuleOf elementUtils a)
              ^String moduleSpec (if (and (.allowedInSource Source$Feature/MODULES source)
                                          (some? mod))
                                     (java-str (.getQualifiedName mod) "/")
                                     "")]
          (.put unmatchedAnnotations (java-str moduleSpec (.toString (.getQualifiedName a))) a)))
      (when (== (.size unmatchedAnnotations) 0) (.put unmatchedAnnotations "" nil))
      (let [psi (.iterator discoveredProcs)
            ^:mutable ^{:tag (Set Element)} rootElements (LinkedHashSet.)]
        (.addAll rootElements topLevelClasses)
        (.addAll rootElements packageInfoFiles)
        (.addAll rootElements moduleInfoFiles)
        (set! rootElements (Collections/unmodifiableSet rootElements))
        (let [^RoundEnvironment renv (JavacRoundEnvironment. false false rootElements this)]
          (while (and (> (.size unmatchedAnnotations) 0) (.hasNext psi))
            (let [ps (.next psi)
                  ^{:tag (Set String)} matchedNames (HashSet.)
                  ^{:tag (Set TypeElement)} typeElements (LinkedHashSet.)]
              (for-each [^{:tag (Map$Entry String TypeElement)} entry (.entrySet
                                                                        unmatchedAnnotations)]
                (let [unmatchedAnnotationName (cast String (.getKey entry))]
                  (when (.annotationSupported ps unmatchedAnnotationName)
                    (.add matchedNames unmatchedAnnotationName)
                    (let [te (cast TypeElement (.getValue entry))]
                      (when (some? te) (.add typeElements te))))))
              (when (or (> (.size matchedNames) 0) (.-contributed ps))
                (let [processingResult (.callProcessor this (.-processor ps) typeElements renv)]
                  (set! (.-contributed ps) true)
                  (.removeSupportedOptions ps unmatchedProcessorOptions)
                  (when (or printProcessorInfo verbose)
                    (.printLines log
                                 "x.print.processor.info"
                                 (new Object/1
                                      [(.getName (.getClass (.-processor ps)))
                                       (.toString matchedNames)
                                       processingResult])))
                  (when processingResult (.removeAll (.keySet unmatchedAnnotations) matchedNames))))))
          (.remove unmatchedAnnotations "")
          (when (> (.size unmatchedAnnotations) 0)
            (.removeAll (.keySet unmatchedAnnotations) platformAnnotations)
            (when (> (.size unmatchedAnnotations) 0)
              (.warning log
                        (CompilerProperties$LintWarnings/ProcAnnotationsWithoutProcessors
                          (.keySet unmatchedAnnotations)))))
          (.runContributingProcs psi renv)))))

  (defclass ^:public ^:static ComputeAnnotationSet
    :extends (ElementScanner14 (Set TypeElement) (Set TypeElement))

    (field ^:final ^Elements elements)

    (constructor ^:public [this ^Elements elements]
      (super.)
      (set! (.-elements this) elements))

    (method ^:public visitPackage ^{:tag (Set TypeElement)} [this ^PackageElement e
                                                             ^{:tag (Set TypeElement)} p]
      p)

    (method ^:public visitType ^{:tag (Set TypeElement)} [this ^TypeElement e
                                                          ^{:tag (Set TypeElement)} p]
      (.scan this (.getTypeParameters e) p)
      (cast Set (.visitType super e p)))

    (method ^:public visitExecutable ^{:tag (Set TypeElement)} [this ^ExecutableElement e
                                                                ^{:tag (Set TypeElement)} p]
      (.scan this (.getTypeParameters e) p)
      (cast Set (.visitExecutable super e p)))

    (method addAnnotations ^void [this ^Element e ^{:tag (Set TypeElement)} p]
      (for-each [^AnnotationMirror annotationMirror (.getAllAnnotationMirrors elements e)]
        (let [e2 (.asElement (.getAnnotationType annotationMirror))] (.add p (cast TypeElement e2)))))

    (method ^:public scan ^{:tag (Set TypeElement)} [this ^Element e ^{:tag (Set TypeElement)} p]
      (.addAnnotations this e p)
      (cast Set (.scan super e p))))

  (method ^:private callProcessor ^boolean [this ^Processor proc
                                            ^{:tag (Set (? extends TypeElement))} tes
                                            ^RoundEnvironment renv]
    (let [prevDeferredHandler (.setHandler dcfh (.-userCodeHandler dcfh))]
      (try
        (.process proc tes renv)
        (catch ClassFinder$BadClassFile ex
          (.error log (CompilerProperties$Errors/ProcCantAccess1 (.-sym ex) (.getDetailValue ex)))
          false)
        (catch Symbol$CompletionFailure ex
          (let [out (StringWriter.)]
            (.printStackTrace ex (PrintWriter. out))
            (.error log
                    (CompilerProperties$Errors/ProcCantAccess
                      (.-sym ex)
                      (.getDetailValue ex)
                      (.toString out)))
            false))
        (catch ClientCodeException e (throw e))
        (catch Throwable t (throw (AnnotationProcessingError. t)))
        (finally (.setHandler dcfh prevDeferredHandler)))))

  (defclass Round
    (field ^:final ^int number)

    (field ^:final ^Log$DeferredDiagnosticHandler deferredDiagnosticHandler)

    (field ^{:tag (List JCTree$JCCompilationUnit)} roots)

    (field ^{:tag (Set JCTree$JCCompilationUnit)} treesToClean)

    (field ^{:tag (Map Symbol$ModuleSymbol (Map String JavaFileObject))} genClassFiles)

    (field ^{:tag (Set TypeElement)} annotationsPresent)

    (field ^{:tag (List Symbol$ClassSymbol)} topLevelClasses)

    (field ^{:tag (List Symbol$PackageSymbol)} packageInfoFiles)

    (field ^{:tag (List Symbol$ModuleSymbol)} moduleInfoFiles)

    (constructor ^:private [this ^int number ^{:tag (Set JCTree$JCCompilationUnit)} treesToClean
                            ^Log$DeferredDiagnosticHandler deferredDiagnosticHandler]
      (set! (.-number this) number)
      (if (== number 1)
          (do
            (Assert/checkNonNull deferredDiagnosticHandler)
            (set! (.-deferredDiagnosticHandler this) deferredDiagnosticHandler))
          (do
            (set! (.-deferredDiagnosticHandler this) (.new log Log$DeferredDiagnosticHandler))
            (.setDeferredDiagnosticHandler compiler (.-deferredDiagnosticHandler this))))
      (set! topLevelClasses (List/nil))
      (set! packageInfoFiles (List/nil))
      (set! moduleInfoFiles (List/nil))
      (set! (.-treesToClean this) treesToClean))

    (constructor [this ^{:tag (List JCTree$JCCompilationUnit)} roots
                  ^{:tag (List Symbol$ClassSymbol)} classSymbols
                  ^{:tag (Set JCTree$JCCompilationUnit)} treesToClean
                  ^Log$DeferredDiagnosticHandler deferredDiagnosticHandler]
      (this. 1 treesToClean deferredDiagnosticHandler)
      (set! (.-roots this) roots)
      (set! genClassFiles (HashMap.))
      (set! topLevelClasses
            (.prependList (.getTopLevelClasses JavacProcessingEnvironment/this roots)
                          (.reverse classSymbols)))
      (set! packageInfoFiles (.getPackageInfoFiles JavacProcessingEnvironment/this roots))
      (set! moduleInfoFiles (.getModuleInfoFiles JavacProcessingEnvironment/this roots))
      (.findAnnotationsPresent this))

    (constructor ^:private [this ^Round prev ^{:tag (Set JavaFileObject)} newSourceFiles
                            ^{:tag (Map Symbol$ModuleSymbol (Map String JavaFileObject))} newClassFiles]
      (this. (unchecked-add-int (.-number prev) 1) (.-treesToClean prev) nil)
      (.newRound prev)
      (set! (.-genClassFiles this) (.-genClassFiles prev))
      (let [^{:tag (List JCTree$JCCompilationUnit)} parsedFiles (.parseFiles
                                                                  compiler
                                                                  newSourceFiles
                                                                  true)]
        (set! roots (.appendList (.-roots prev) parsedFiles))
        (if (.unrecoverableError this)
            (.initModules compiler (List/nil))
            (do
              (set! roots (.initModules compiler roots))
              (.enterClassFiles this genClassFiles)
              (let [^{:tag (List Symbol$ClassSymbol)} newClasses (.enterClassFiles
                                                                   this
                                                                   newClassFiles)]
                (for-each [^{:tag (Map$Entry Symbol$ModuleSymbol (Map String JavaFileObject))} moduleAndClassFiles
                             (.entrySet newClassFiles)]
                  (.putAll (cast
                             Map
                             (.computeIfAbsent genClassFiles
                                               (cast
                                                 Symbol$ModuleSymbol
                                                 (.getKey moduleAndClassFiles))
                                               (lambda Function ^Map [^Symbol$ModuleSymbol m]
                                                 (LinkedHashMap.))))
                           (cast Map (.getValue moduleAndClassFiles))))
                (.enterTrees this roots)
                (when-not (.unrecoverableError this)
                  (set! topLevelClasses
                        (JavacProcessingEnvironment/join
                          (.getTopLevelClasses JavacProcessingEnvironment/this parsedFiles)
                          (.getTopLevelClassesFromClasses
                            JavacProcessingEnvironment/this
                            newClasses)))
                  (set! packageInfoFiles
                        (JavacProcessingEnvironment/join
                          (.getPackageInfoFiles JavacProcessingEnvironment/this parsedFiles)
                          (.getPackageInfoFilesFromClasses
                            JavacProcessingEnvironment/this
                            newClasses)))
                  (set! moduleInfoFiles (List/nil))
                  (.findAnnotationsPresent this)))))))

    (method next ^Round [this ^{:tag (Set JavaFileObject)} newSourceFiles
                         ^{:tag (Map Symbol$ModuleSymbol (Map String JavaFileObject))} newClassFiles]
      (Round. this newSourceFiles newClassFiles))

    (method finalCompiler ^void [this] (.newRound this))

    (method errorCount ^int [this] (.errorCount compiler))

    (method warningCount ^int [this] (.warningCount compiler))

    (method unrecoverableError ^boolean [this]
      (if (.errorRaised messager)
          true
          (.anyMatch
            (.stream (.getDiagnostics deferredDiagnosticHandler))
            (lambda Predicate ^boolean [^JCDiagnostic d]
              (or (and (identical? (.getKind d) Diagnostic$Kind/WARNING) werror)
                  (and
                    (identical? (.getKind d) Diagnostic$Kind/ERROR)
                    (or fatalErrors (not (.isFlagSet d JCDiagnostic$DiagnosticFlag/RECOVERABLE)))))))))

    (method findAnnotationsPresent ^void [this]
      (let [annotationComputer (ComputeAnnotationSet. elementUtils)]
        (set! annotationsPresent (LinkedHashSet.))
        (for-each [^Symbol$ClassSymbol classSym topLevelClasses]
          (.scan annotationComputer classSym annotationsPresent))
        (for-each [^Symbol$PackageSymbol pkgSym packageInfoFiles]
          (.scan annotationComputer pkgSym annotationsPresent))
        (for-each [^Symbol$ModuleSymbol mdlSym moduleInfoFiles]
          (.scan annotationComputer mdlSym annotationsPresent))))

    (method ^:private enterClassFiles ^{:tag (List Symbol$ClassSymbol)} [this
                                                                         ^{:tag (Map Symbol$ModuleSymbol (Map String JavaFileObject))} modulesAndClassFiles]
      (let [^:mutable ^{:tag (List Symbol$ClassSymbol)} list (List/nil)]
        (for-each [^{:tag (Map$Entry Symbol$ModuleSymbol (Map String JavaFileObject))} moduleAndClassFiles
                     (.entrySet modulesAndClassFiles)]
          (for-each [^{:tag (Map$Entry String JavaFileObject)} entry (.entrySet
                                                                       (cast
                                                                         Map
                                                                         (.getValue
                                                                           moduleAndClassFiles)))]
            (let [name (.fromString names (cast String (.getKey entry)))
                  file (cast JavaFileObject (.getValue entry))]
              (when-not (identical? (.getKind file) JavaFileObject$Kind/CLASS)
                (throw (AssertionError. file)))
              (let [^:mutable ^Symbol$ClassSymbol cs nil]
                (if (.isPkgInfo JavacProcessingEnvironment/this file JavaFileObject$Kind/CLASS)
                    (let [packageName (Convert/packagePart name)
                          p (.enterPackage symtab
                                           (cast Symbol$ModuleSymbol (.getKey moduleAndClassFiles))
                                           packageName)]
                      (when (nil? (.-package_info p))
                        (set! (.-package_info p)
                              (.enterClass symtab
                                           (cast Symbol$ModuleSymbol (.getKey moduleAndClassFiles))
                                           (Convert/shortName name)
                                           p)))
                      (set! cs (.-package_info p))
                      (.reset cs)
                      (when (nil? (.-classfile cs)) (set! (.-classfile cs) file))
                      (set! (.-completer cs) initialCompleter))
                    (do
                      (set! cs
                            (.enterClass symtab
                                         (cast Symbol$ModuleSymbol (.getKey moduleAndClassFiles))
                                         name))
                      (.reset cs)
                      (set! (.-classfile cs) file)
                      (set! (.-completer cs) initialCompleter)
                      (when (identical? (.-kind (.-owner cs)) Kinds$Kind/PCK)
                        (.enter (.members (.-owner cs)) cs))))
                (set! list (.prepend list cs))))))
        (.reverse list)))

    (method ^:private enterTrees ^void [this ^{:tag (List JCTree$JCCompilationUnit)} roots]
      (.enterTrees compiler roots))

    (method run ^void [this ^boolean lastRound ^boolean errorStatus]
      (.printRoundInfo this lastRound)
      (when-not (.isEmpty taskListener)
        (.started taskListener (TaskEvent. TaskEvent$Kind/ANNOTATION_PROCESSING_ROUND)))
      (try
        (if lastRound
            (do
              (.setLastRound filer true)
              (let [^{:tag (Set Element)} emptyRootElements (Collections/emptySet)
                    ^RoundEnvironment renv (JavacRoundEnvironment.
                                             true
                                             errorStatus
                                             emptyRootElements
                                             JavacProcessingEnvironment/this)]
                (.runContributingProcs (.iterator discoveredProcs) renv)))
            (.discoverAndRunProcs JavacProcessingEnvironment/this
                                  annotationsPresent
                                  topLevelClasses
                                  packageInfoFiles
                                  moduleInfoFiles))
        (catch Throwable t (.reportDeferredDiagnosticAndClearHandler compiler) (throw t))
        (finally
          (when-not (.isEmpty taskListener)
            (.finished taskListener (TaskEvent. TaskEvent$Kind/ANNOTATION_PROCESSING_ROUND))))))

    (method showDiagnostics ^void [this ^boolean showAll]
      (.reportDeferredDiagnostics deferredDiagnosticHandler
                                  ^Predicate (if showAll ACCEPT_ALL ACCEPT_NON_RECOVERABLE))
      (.popDiagnosticHandler log deferredDiagnosticHandler)
      (.setDeferredDiagnosticHandler compiler nil))

    (field ^:private ^:final ^{:tag (Predicate JCDiagnostic)} ACCEPT_NON_RECOVERABLE
      (lambda Predicate ^boolean [^JCDiagnostic d]
        (or (or (not (identical? (.getKind d) Diagnostic$Kind/ERROR))
                (not (.isFlagSet d JCDiagnostic$DiagnosticFlag/RECOVERABLE)))
            (.isFlagSet d JCDiagnostic$DiagnosticFlag/API))))

    (field ^:private ^:final ^{:tag (Predicate JCDiagnostic)} ACCEPT_ALL
      (lambda Predicate ^boolean [^JCDiagnostic d] true))

    (method ^:private printRoundInfo ^void [this ^boolean lastRound]
      (when (or printRounds verbose)
        (let [^{:tag (List Symbol$ClassSymbol)} tlc (if lastRound (List/nil) topLevelClasses)
              ^{:tag (Set TypeElement)} ap (if lastRound (Collections/emptySet) annotationsPresent)]
          (.printLines log
                       "x.print.rounds"
                       (new Object/1 [number (java-str "{" (.toString tlc ", ") "}") ap lastRound])))))

    (method ^:private newRound ^void [this]
      (for-each [^{:tag (Env AttrContext)} env (.getEnvs enter)]
        (.add treesToClean (.-toplevel env)))
      (for-each [^JCTree$JCCompilationUnit node treesToClean] (.scan treeCleaner node))
      (.newRound chk)
      (.newRound enter)
      (.newRound filer)
      (.newRound messager)
      (.newRound compiler)
      (.newRound modules)
      (.newRound types)
      (.newRound annotate)
      (.newRound elementUtils)
      (let [^:mutable foundError false]
        (for-each [^Symbol$ClassSymbol cs (.getAllClasses symtab)]
          (when (identical? (.-kind cs) Kinds$Kind/ERR) (set! foundError true) (break)))
        (when foundError
          (for-each [^Symbol$ClassSymbol cs (.getAllClasses symtab)]
            (when (or (some? (.-classfile cs)) (identical? (.-kind cs) Kinds$Kind/ERR))
              (let [symKind (.-kind cs)]
                (.reset cs)
                (when (identical? symKind Kinds$Kind/ERR)
                  (set! (.-type cs) (Type$ClassType. (.getEnclosingType (.-type cs)) nil cs)))
                (when (.isCompleted cs) (set! (.-completer cs) initialCompleter)))))))))

  (method ^:public doProcessing ^boolean [this
                                          ^:mutable ^{:tag (List JCTree$JCCompilationUnit)} roots
                                          ^{:tag (List Symbol$ClassSymbol)} classSymbols
                                          ^{:tag (Iterable (? extends Symbol$PackageSymbol))} pckSymbols
                                          ^Log$DeferredDiagnosticHandler deferredDiagnosticHandler]
    (let [^{:tag (Set JCTree$JCCompilationUnit)} treesToClean (Collections/newSetFromMap
                                                                (IdentityHashMap.))]
      (for-each [^{:tag (Env AttrContext)} env (.getEnvs enter)]
        (.add treesToClean (.-toplevel env)))
      (let [^{:tag (Set Symbol$PackageSymbol)} specifiedPackages (LinkedHashSet.)]
        (for-each [^Symbol$PackageSymbol psym pckSymbols] (.add specifiedPackages psym))
        (set! (.-specifiedPackages this) (Collections/unmodifiableSet specifiedPackages))
        (let [^:mutable round (Round. roots classSymbols treesToClean deferredDiagnosticHandler)
              ^:mutable ^boolean errorStatus false
              ^:mutable ^boolean moreToDo false]
          (loop []
            (.run round false false)
            (set! errorStatus (.unrecoverableError round))
            (set! moreToDo (.moreToDo this))
            (.showDiagnostics round showResolveErrors)
            (set! round
                  (.next round
                         (LinkedHashSet. (.getGeneratedSourceFileObjects filer))
                         (LinkedHashMap. (.getGeneratedClasses filer))))
            (when (.unrecoverableError round) (set! errorStatus true))
            (when (and moreToDo (not errorStatus)) (recur)))
          (.run round true errorStatus)
          (.showDiagnostics round true)
          (.warnIfUnclosedFiles filer)
          (.warnIfUnmatchedOptions this)
          (when (or (.errorRaised messager)
                    (and (and werror (> (.warningCount round) 0)) (> (.errorCount round) 0)))
            (set! errorStatus true))
          (let [^{:tag (Set JavaFileObject)} newSourceFiles (LinkedHashSet.
                                                              (.getGeneratedSourceFileObjects filer))]
            (set! roots (.-roots round))
            (set! errorStatus (or errorStatus (> (.errorCount compiler) 0)))
            (when (> (.size newSourceFiles) 0)
              (set! roots (.appendList roots (.parseFiles compiler newSourceFiles))))
            (set! errorStatus (or errorStatus (> (.errorCount compiler) 0)))
            (when (and errorStatus (== (.errorCount compiler) 0))
              (let [o-1 (.-log compiler)]
                (set! (.-nerrors o-1) (unchecked-inc-int (.-nerrors o-1)))))
            (if (.continueAfterProcessAnnotations compiler)
                (do (.finalCompiler round) (.enterTrees compiler (.initModules compiler roots)))
                (.clear (.-todo compiler)))
            (.close this)
            (when-not (.isEmpty taskListener)
              (.finished taskListener (TaskEvent. TaskEvent$Kind/ANNOTATION_PROCESSING)))
            true)))))

  (method ^:private warnIfUnmatchedOptions ^void [this]
    (when-not (.isEmpty unmatchedProcessorOptions)
      (.warning log
                (CompilerProperties$Warnings/ProcUnmatchedProcessorOptions
                  (.toString unmatchedProcessorOptions)))))

  (method ^:public close ^void [this]
    (.close filer)
    (when (some? discoveredProcs) (.close discoveredProcs))
    (set! discoveredProcs nil))

  (method ^:private getTopLevelClasses ^{:tag (List Symbol$ClassSymbol)} [this
                                                                          ^{:tag (List (? extends JCTree$JCCompilationUnit))} units]
    (let [^:mutable ^{:tag (List Symbol$ClassSymbol)} classes (List/nil)]
      (for-each [^JCTree$JCCompilationUnit unit units]
        (for-each [^JCTree node (.-defs unit)]
          (when (.hasTag node JCTree$Tag/CLASSDEF)
            (let [sym (.-sym (cast JCTree$JCClassDecl node))]
              (Assert/checkNonNull sym)
              (set! classes (.prepend classes sym))))))
      (.reverse classes)))

  (method ^:private getTopLevelClassesFromClasses ^{:tag (List Symbol$ClassSymbol)} [this
                                                                                     ^{:tag (List (? extends Symbol$ClassSymbol))} syms]
    (let [^:mutable ^{:tag (List Symbol$ClassSymbol)} classes (List/nil)]
      (for-each [^Symbol$ClassSymbol sym syms]
        (when-not (.isPkgInfo this sym) (set! classes (.prepend classes sym))))
      (.reverse classes)))

  (method ^:private getPackageInfoFiles ^{:tag (List Symbol$PackageSymbol)} [this
                                                                             ^{:tag (List (? extends JCTree$JCCompilationUnit))} units]
    (let [^:mutable ^{:tag (List Symbol$PackageSymbol)} packages (List/nil)]
      (for-each [^JCTree$JCCompilationUnit unit units]
        (when (.isPkgInfo this (.-sourcefile unit) JavaFileObject$Kind/SOURCE)
          (set! packages (.prepend packages (.-packge unit)))))
      (.reverse packages)))

  (method ^:private getPackageInfoFilesFromClasses ^{:tag (List Symbol$PackageSymbol)} [this
                                                                                        ^{:tag (List (? extends Symbol$ClassSymbol))} syms]
    (let [^:mutable ^{:tag (List Symbol$PackageSymbol)} packages (List/nil)]
      (for-each [^Symbol$ClassSymbol sym syms]
        (when (.isPkgInfo this sym)
          (set! packages (.prepend packages (cast Symbol$PackageSymbol (.-owner sym))))))
      (.reverse packages)))

  (method ^:private getModuleInfoFiles ^{:tag (List Symbol$ModuleSymbol)} [this
                                                                           ^{:tag (List (? extends JCTree$JCCompilationUnit))} units]
    (let [^:mutable ^{:tag (List Symbol$ModuleSymbol)} modules (List/nil)]
      (for-each [^JCTree$JCCompilationUnit unit units]
        (when (and (.isModuleInfo this (.-sourcefile unit) JavaFileObject$Kind/SOURCE)
                   (.nonEmpty (.-defs unit)))
          (for-each [^JCTree tree (.-defs unit)]
            (when-not (.hasTag tree JCTree$Tag/IMPORT)
              (if (.hasTag tree JCTree$Tag/MODULEDEF)
                  (do (set! modules (.prepend modules (.-modle unit))) (break))
                  (break))))))
      (.reverse modules)))

  (method ^:private ^:static join :type-params [T] ^{:tag (List T)} [^{:tag (List T)} list1
                                                                     ^{:tag (List T)} list2]
    (.appendList list1 list2))

  (method ^:private isPkgInfo ^boolean [this ^JavaFileObject fo ^JavaFileObject$Kind kind]
    (.isNameCompatible fo "package-info" kind))

  (method ^:private isPkgInfo ^boolean [this ^Symbol$ClassSymbol sym]
    (and (.isPkgInfo this (.-classfile sym) JavaFileObject$Kind/CLASS)
         (identical? (.-package_info (.packge sym)) sym)))

  (method ^:private isModuleInfo ^boolean [this ^JavaFileObject fo ^JavaFileObject$Kind kind]
    (.isNameCompatible fo "module-info" kind))

  (defclass ImplicitCompleter
    :implements [Symbol$Completer]

    (field ^:private ^:final ^JCTree$JCCompilationUnit topLevel)

    (constructor ^:public [this ^JCTree$JCCompilationUnit topLevel]
      (set! (.-topLevel this) topLevel))

    (method ^:public complete :throws [Symbol$CompletionFailure] ^void [this ^Symbol sym]
      (.readSourceFile compiler topLevel (cast Symbol$ClassSymbol sym))))

  (field ^:private ^:final ^TreeScanner treeCleaner
    (anon TreeScanner []
      (method ^:public scan ^void [this ^JCTree node]
        (.scan super node)
        (when (some? node) (set! (.-type node) nil)))

      (field ^JCTree$JCCompilationUnit topLevel)

      (method ^:public visitTopLevel ^void [this ^JCTree$JCCompilationUnit node]
        (when (some? (.-packge node))
          (when (.isPkgInfo JavacProcessingEnvironment/this
                            (.-sourcefile node)
                            JavaFileObject$Kind/SOURCE)
            (.reset (.-package_info (.-packge node))))
          (.reset (.-packge node)))
        (when (.isModuleInfo JavacProcessingEnvironment/this
                             (.-sourcefile node)
                             JavaFileObject$Kind/SOURCE)
          (.reset (.-modle node))
          (set! (.-completer (.-modle node))
                (lambda Symbol$Completer ^void [^Symbol sym]
                  (.enter modules (List/of node) (.-module_info (.-modle node)))))
          (.reset (.-module_info (.-modle node)))
          (set! (.-members_field (.-module_info (.-modle node)))
                (Scope$WriteableScope/create (.-module_info (.-modle node)))))
        (set! (.-packge node) nil)
        (set! topLevel node)
        (try (.visitTopLevel super node) (finally (set! topLevel nil))))

      (method ^:public visitClassDef ^void [this ^JCTree$JCClassDecl node]
        (.visitClassDef super node)
        (let [^:mutable ^{:tag (List JCTree)} beforeConstructor (List/nil)
              ^:mutable ^{:tag (List JCTree)} defs (.-defs node)]
          (while (and (.nonEmpty defs)
                      (not (.hasTag (cast JCTree (.-head defs)) JCTree$Tag/METHODDEF)))
            (set! beforeConstructor (.prepend beforeConstructor (cast JCTree (.-head defs))))
            (set! defs (.-tail defs)))
          (when (and (.nonEmpty defs)
                     (not (== (bit-and (.-flags (.-mods (cast JCTree$JCMethodDecl (.-head defs))))
                                       Flags/GENERATEDCONSTR)
                              0)))
            (set! defs (.-tail defs))
            (while (.nonEmpty beforeConstructor)
              (set! defs (.prepend defs (cast JCTree (.-head beforeConstructor))))
              (set! beforeConstructor (.-tail beforeConstructor)))
            (set! (.-defs node) defs))
          (when (some? (.-sym node))
            (set! (.-completer (.-sym node)) (ImplicitCompleter. topLevel))
            (let [^{:tag (List (? extends Symbol$RecordComponent))} recordComponents
                    (.getRecordComponents (.-sym node))]
              (for-each [^Symbol$RecordComponent rc recordComponents]
                (let [^{:tag (List JCTree$JCAnnotation)} originalAnnos (.getOriginalAnnos rc)]
                  (.forEach originalAnnos
                            (lambda Consumer ^void [^JCTree$JCAnnotation a]
                              (.visitAnnotation this a)))))
              (.clearPermittedSubclasses (.-sym node))))
          (set! (.-sym node) nil)))

      (method ^:public visitMethodDef ^void [this ^JCTree$JCMethodDecl node]
        (when (and (and (and (and (and (and (TreeInfo/isConstructor node) (some? (.-sym node)))
                                       (.isEnum (.-owner (.-sym node))))
                                  (some? (.-body node)))
                             (.nonEmpty (.-stats (.-body node))))
                        (TreeInfo/isSuperCall (cast JCTree (.-head (.-stats (.-body node))))))
                   (== (.-pos (cast JCTree$JCStatement (.-head (.-stats (.-body node)))))
                       (.-pos (.-body node))))
          (set! (.-stats (.-body node)) (.-tail (.-stats (.-body node)))))
        (set! (.-sym node) nil)
        (.visitMethodDef super node))

      (method ^:public visitVarDef ^void [this ^JCTree$JCVariableDecl node]
        (set! (.-sym node) nil)
        (.visitVarDef super node))

      (method ^:public visitNewClass ^void [this ^JCTree$JCNewClass node]
        (set! (.-constructor node) nil)
        (.visitNewClass super node))

      (method ^:public visitAssignop ^void [this ^JCTree$JCAssignOp node]
        (set! (.-operator node) nil)
        (.visitAssignop super node))

      (method ^:public visitUnary ^void [this ^JCTree$JCUnary node]
        (set! (.-operator node) nil)
        (.visitUnary super node))

      (method ^:public visitBinary ^void [this ^JCTree$JCBinary node]
        (set! (.-operator node) nil)
        (.visitBinary super node))

      (method ^:public visitSelect ^void [this ^JCTree$JCFieldAccess node]
        (set! (.-sym node) nil)
        (.visitSelect super node))

      (method ^:public visitIdent ^void [this ^JCTree$JCIdent node]
        (set! (.-sym node) nil)
        (.visitIdent super node))

      (method ^:public visitAnnotation ^void [this ^JCTree$JCAnnotation node]
        (set! (.-attribute node) nil)
        (.visitAnnotation super node))))

  (method ^:private moreToDo ^boolean [this] (.newFiles filer))

  (method ^:public getOptions ^{:tag (Map String String)} [this]
    processorOptions)

  (method ^:public getMessager ^Messager [this] messager)

  (method ^:public getFiler ^JavacFiler [this] filer)

  (method ^:public getElementUtils ^JavacElements [this] elementUtils)

  (method ^:public getTypeUtils ^JavacTypes [this] typeUtils)

  (method ^:public getSourceVersion ^SourceVersion [this]
    (Source/toSourceVersion source))

  (method ^:public getLocale ^Locale [this] (.getCurrentLocale messages))

  (method ^:public isPreviewEnabled ^boolean [this] (.isEnabled preview))

  (method ^:public getSpecifiedPackages ^{:tag (Set Symbol$PackageSymbol)} [this]
    specifiedPackages)

  (field ^:public ^:static ^:final ^Pattern noMatches (Pattern/compile "(\\P{all})+"))

  (method ^:private ^:static importStringToPattern ^Pattern [^boolean allowModules ^String s
                                                             ^Processor p ^Log log]
    (let [^:mutable ^String module nil
          ^:mutable ^String pkg nil
          slash (.indexOf s \/)]
      (if (== slash -1)
          (do
            (when (.equals s "*") (return (MatchingUtils/validImportStringToPattern s)))
            (set! module (if allowModules ".*/" ""))
            (set! pkg s))
          (let [moduleName (.substring s 0 slash)]
            (when-not (SourceVersion/isName moduleName)
              (return (JavacProcessingEnvironment/warnAndNoMatches s p log)))
            (set! module (Pattern/quote (java-str moduleName "/")))
            (set! pkg (.substring s (unchecked-add-int slash 1)))))
      (if (MatchingUtils/isValidImportString pkg)
          (Pattern/compile (java-str module (MatchingUtils/validImportStringToPatternString pkg)))
          (JavacProcessingEnvironment/warnAndNoMatches s p log))))

  (method ^:private ^:static warnAndNoMatches ^Pattern [^String s ^Processor p ^Log log]
    (.warning log
              (CompilerProperties$LintWarnings/ProcMalformedSupportedString
                s
                (.getName (.getClass p))))
    noMatches)

  (method ^:public getContext ^Context [this] context)

  (method ^:public getProcessorClassLoader ^ClassLoader [this]
    processorClassLoader)

  (method ^:public toString ^String [this] "javac ProcessingEnvironment")

  (method ^:public ^:static isValidOptionName ^boolean [^String optionName]
    (for-each [^String s (.split optionName "\\." -1)]
      (when-not (SourceVersion/isIdentifier s) (return false)))
    true))

    (constructor [this ^Processor p ^Log log ^Source source ^DeferredCompletionFailureHandler dcfh
                  ^boolean allowModules ^ProcessingEnvironment env]
      (set! processor p)
      (set! contributed false)
      (let [prevDeferredHandler (.setHandler dcfh (.-userCodeHandler dcfh))]
        (try
          (.init processor env)
          (.checkSourceVersionCompatibility this source log)
          (set! supportedAnnotationStrings (LinkedHashSet.))
          (set! supportedAnnotationPatterns (LinkedHashSet.))
          (for-each [^String annotationPattern (.getSupportedAnnotationTypes processor)]
            (let [patternAdded (.add supportedAnnotationStrings annotationPattern)]
              (.add supportedAnnotationPatterns
                    (JavacProcessingEnvironment/importStringToPattern
                      allowModules
                      annotationPattern
                      processor
                      log))
              (when-not patternAdded
                (.warning log
                          (CompilerProperties$LintWarnings/ProcDuplicateSupportedAnnotation
                            annotationPattern
                            (.getName (.getClass p)))))))
          (when (and (.contains supportedAnnotationPatterns
                                (MatchingUtils/validImportStringToPattern "*"))
                     (> (.size supportedAnnotationPatterns) 1))
            (.warning log
                      (CompilerProperties$LintWarnings/ProcRedundantTypesWithWildcard
                        (.getName (.getClass p)))))
          (set! supportedOptionNames (LinkedHashSet.))
          (for-each [^String optionName (.getSupportedOptions processor)]
            (when (.checkOptionName this optionName log)
              (let [optionAdded (.add supportedOptionNames optionName)]
                (when-not optionAdded
                  (.warning log
                            (CompilerProperties$LintWarnings/ProcDuplicateOptionName
                              optionName
                              (.getName (.getClass p))))))))
          (catch ClientCodeException e (throw e))
          (catch Throwable t (throw (AnnotationProcessingError. t)))
          (finally (.setHandler dcfh prevDeferredHandler)))))


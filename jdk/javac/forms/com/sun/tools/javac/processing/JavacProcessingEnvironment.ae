      (let [procSourceVersion (.getSupportedSourceVersion processor)]
        (when (< (.compareTo procSourceVersion (Source/toSourceVersion source)) 0)
          (.warning log
                    (CompilerProperties$Warnings/ProcProcessorIncompatibleSourceVersion
                      procSourceVersion
                      (.getName (.getClass processor))
                      (.-name source))))))

    (method ^:private checkOptionName ^boolean [this ^String optionName ^Log log]
      (let [valid (JavacProcessingEnvironment/isValidOptionName optionName)]
        (when-not valid
          (.error log
                  (CompilerProperties$Errors/ProcProcessorBadOptionName
                    optionName
                    (.getName (.getClass processor)))))
        valid))


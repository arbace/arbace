  (method ^:protected readEnclosingMethodAttr ^void [this ^Symbol sym]
    (.remove (.members (.-owner sym)) sym)
    (let [self (cast Symbol$ClassSymbol sym)
          c (.getClass poolReader (.nextChar this))
          nt (cast PoolConstant$NameAndType
                   (.optPoolEntry this
                                  (.nextChar this)
                                  (method-ref IntFunction
                                              ^PoolConstant$NameAndType [int]
                                              poolReader
                                              PoolReader/.getNameAndType)
                                  nil))]
      (when (or (nil? (.-members_field c)) (not (identical? (.-kind c) Kinds$Kind/TYP)))
        (throw (.badClassFile this "bad.enclosing.class" (new Object/1 [self c]))))
      (let [m (.findMethod this nt (.-members_field c) (.flags self))]
        (when (and (some? nt) (nil? m)) (throw (.badEnclosingMethod this self)))
        (set! (.-name self) (.simpleBinaryName this (.-flatname self) (.-flatname c)))
        (set! (.-owner self) (if (some? m) ^Symbol m ^Symbol c))
        (if (.isEmpty (.-name self))
            (set! (.-fullname self) (.-empty names))
            (set! (.-fullname self) (Symbol$ClassSymbol/formFullName (.-name self) (.-owner self))))
        (cond
          (some? m) (.setEnclosingType (cast Type$ClassType (.-type sym)) (.-type m))
          (== (bit-and (.-flags_field self) Flags/STATIC) 0)
            (.setEnclosingType (cast Type$ClassType (.-type sym)) (.-type c))
          :else (.setEnclosingType (cast Type$ClassType (.-type sym)) Type/noType))
        (.enterTypevars this self (.-type self))
        (if (not (.isEmpty missingTypeVariables))
            (let [^{:tag (ListBuffer Type)} typeVars (ListBuffer.)]
              (for-each [^Type typevar missingTypeVariables]
                (.append typeVars (.findTypeVar this (.-name (.-tsym typevar)))))
              (set! foundTypeVariables (.toList typeVars)))
            (set! foundTypeVariables (List/nil))))))

  (method ^:private simpleBinaryName ^Name [this ^Name self ^Name enclosing]
    (when-not (.startsWith self enclosing)
      (throw (.badClassFile this "bad.enclosing.method" (new Object/1 [self]))))
    (let [simpleBinaryName (.substring (.toString self) (.length (.toString enclosing)))]
      (when (or (< (.length simpleBinaryName) 1) (not (== (.charAt simpleBinaryName 0) \$)))
        (throw (.badClassFile this "bad.enclosing.method" (new Object/1 [self]))))
      (let [^:mutable ^int index 1]
        (while (and (< index (.length simpleBinaryName))
                    (ClassReader/isAsciiDigit (.charAt simpleBinaryName index)))
          (set! index (unchecked-inc-int index)))
        (.fromString names (.substring simpleBinaryName index)))))

  (method ^:private findMethod ^Symbol$MethodSymbol [this ^:mutable ^PoolConstant$NameAndType nt
                                                     ^Scope scope ^long flags]

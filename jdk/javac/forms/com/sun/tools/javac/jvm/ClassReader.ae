      (let [type (.asMethodType (.-type nt))]
        (for-each [^Symbol sym (.getSymbolsByName scope (.-name nt))]
          (when (and (identical? (.-kind sym) Kinds$Kind/MTH)
                     (.isSameBinaryType this (.asMethodType (.-type sym)) type))
            (return (cast Symbol$MethodSymbol sym))))
        (when-not (not (identical? (.-name nt) (.-init names)))
          (when-not (not (== (bit-and flags Flags/INTERFACE) 0))
            (when-not (.isEmpty (.getParameterTypes (.-type nt)))
              (set! nt
                    (PoolConstant$NameAndType. (.-name nt)
                                               (Type$MethodType.
                                                 (.-tail (.getParameterTypes (.-type nt)))
                                                 (.getReturnType (.-type nt))
                                                 (.getThrownTypes (.-type nt))
                                                 (.-methodClass syms))))
              (.findMethod this nt scope flags)))))))

  (method ^:private isSameBinaryType ^boolean [this ^Type$MethodType mt1 ^Type$MethodType mt2]
    (let [^:mutable ^{:tag (List Type)} types1 (.prepend
                                                 (.erasure types (.getParameterTypes mt1))
                                                 (.erasure types (.getReturnType mt1)))
          ^:mutable ^{:tag (List Type)} types2 (.prepend
                                                 (.getParameterTypes mt2)
                                                 (.getReturnType mt2))]
      (while (and (not (.isEmpty types1)) (not (.isEmpty types2)))
        (when-not (identical? (.-tsym (cast Type (.-head types1)))
                              (.-tsym (cast Type (.-head types2))))
          (return false))
        (set! types1 (.-tail types1))
        (set! types2 (.-tail types2)))
      (and (.isEmpty types1) (.isEmpty types2))))

  (method ^:private ^:static isAsciiDigit ^boolean [^char c]
    (and (<= \0 c) (<= c \9)))

  (method readMemberAttrs ^void [this ^Symbol sym]
    (.readAttrs this sym AttributeKind/MEMBER))

  (method readAttrs ^void [this ^Symbol sym ^AttributeKind kind]
    (let [ac (.nextChar this)]
      (loop [^int i 0]
        (when (< i ac)
          (let [attrName (.getName poolReader (.nextChar this))
                attrLen (.nextInt this)
                r (cast AttributeReader (.get attributeReaders attrName))]
            (if (and (some? r) (.accepts r kind))
                (do (.read r sym attrLen) (recur (unchecked-inc-int i)))
                (do (set! bp (unchecked-add-int bp attrLen)) (recur (unchecked-inc-int i)))))))))

  (field ^:private ^boolean readingClassAttr false)

  (field ^:private ^{:tag (List Type)} missingTypeVariables (List/nil))

  (field ^:private ^{:tag (List Type)} foundTypeVariables (List/nil))

  (method readClassAttrs ^void [this ^Symbol$ClassSymbol c]
    (.readAttrs this c AttributeKind/CLASS))

  (method readCode ^Code [this ^Symbol owner]
    (.nextChar this)
    (.nextChar this)
    (let [code_length (.nextInt this)]
      (set! bp (unchecked-add-int bp code_length))
      (let [exception_table_length (.nextChar this)]
        (set! bp (unchecked-add-int bp (unchecked-multiply-int exception_table_length 8)))
        (.readMemberAttrs this owner)
        nil)))

  (method readAnnotations ^{:tag (List CompoundAnnotationProxy)} [this]
    (let [^int numAttributes (.nextChar this)
          ^{:tag (ListBuffer CompoundAnnotationProxy)} annotations (ListBuffer.)]
      (loop [^int i 0]
        (when (< i numAttributes)
          (.append annotations (.readCompoundAnnotation this))
          (recur (unchecked-inc-int i))))
      (.toList annotations)))

  (method attachAnnotations ^void [this ^:final ^Symbol sym]
    (.attachAnnotations this sym (.readAnnotations this)))

  (method attachAnnotations ^void [this ^:final ^Symbol sym
                                   ^{:tag (List CompoundAnnotationProxy)} annotations]
    (when-not (.isEmpty annotations)
      (let [^{:tag (ListBuffer CompoundAnnotationProxy)} proxies (ListBuffer.)]
        (for-each [^CompoundAnnotationProxy proxy annotations]
          (cond
            (identical? (.flatName (.-tsym (.-type proxy)))
                        (.flatName (.-tsym (.-proprietaryType syms))))
              (set! (.-flags_field sym) (bit-or (.-flags_field sym) Flags/PROPRIETARY))
            (identical? (.flatName (.-tsym (.-type proxy)))
                        (.flatName (.-tsym (.-profileType syms))))
              (when-not (identical? profile Profile/DEFAULT)
                (for-each [^{:tag (Pair Name Attribute)} v (.-values proxy)]
                  (when (identical? (.-fst v) (.-value names))
                    (when-instance [^Attribute$Constant constant (.-snd v)]
                      (when (and (identical? (.-type constant) (.-intType syms))
                                 (> (cast Integer (.-value constant)) (.-value profile)))
                        (set! (.-flags_field sym) (bit-or (.-flags_field sym) Flags/NOT_IN_PROFILE)))))))
            (identical? (.flatName (.-tsym (.-type proxy)))
                        (.flatName (.-tsym (.-previewFeatureInternalType syms))))
              (do
                (set! (.-flags_field sym) (bit-or (.-flags_field sym) Flags/PREVIEW_API))
                (.setFlagIfAttributeTrue this
                                         proxy
                                         sym
                                         (.-reflective names)
                                         Flags/PREVIEW_REFLECTIVE))
            (identical? (.flatName (.-tsym (.-type proxy)))
                        (.flatName (.-tsym (.-valueBasedInternalType syms))))
              (do
                (Assert/check (identical? (.-kind sym) Kinds$Kind/TYP))
                (set! (.-flags_field sym) (bit-or (.-flags_field sym) Flags/VALUE_BASED)))
            (identical? (.flatName (.-tsym (.-type proxy)))
                        (.flatName (.-tsym (.-restrictedInternalType syms))))
              (do
                (Assert/check (identical? (.-kind sym) Kinds$Kind/MTH))
                (set! (.-flags_field sym) (bit-or (.-flags_field sym) Flags/RESTRICTED)))
            (identical? (.flatName (.-tsym (.-type proxy)))
                        (.flatName (.-tsym (.-requiresIdentityInternalType syms))))
              (do
                (Assert/check (identical? (.-kind sym) Kinds$Kind/VAR))
                (set! (.-flags_field sym) (bit-or (.-flags_field sym) Flags/REQUIRES_IDENTITY)))
            :else
              (do
                (cond
                  (identical? (.-tsym (.-type proxy)) (.-tsym (.-annotationTargetType syms)))
                    (set! target proxy)
                  (identical? (.-tsym (.-type proxy)) (.-tsym (.-repeatableType syms)))
                    (set! repeatable proxy)
                  (identical? (.-tsym (.-type proxy)) (.-tsym (.-deprecatedType syms)))
                    (do
                      (set! (.-flags_field sym)
                            (bit-or (.-flags_field sym)
                                    (bit-or Flags/DEPRECATED Flags/DEPRECATED_ANNOTATION)))
                      (.setFlagIfAttributeTrue this
                                               proxy
                                               sym
                                               (.-forRemoval names)
                                               Flags/DEPRECATED_REMOVAL))
                  (identical? (.-tsym (.-type proxy)) (.-tsym (.-previewFeatureType syms)))
                    (do
                      (set! (.-flags_field sym) (bit-or (.-flags_field sym) Flags/PREVIEW_API))
                      (.setFlagIfAttributeTrue this
                                               proxy
                                               sym
                                               (.-reflective names)
                                               Flags/PREVIEW_REFLECTIVE))
                  (and (identical? (.-tsym (.-type proxy)) (.-tsym (.-valueBasedType syms)))
                       (identical? (.-kind sym) Kinds$Kind/TYP))
                    (set! (.-flags_field sym) (bit-or (.-flags_field sym) Flags/VALUE_BASED))
                  (identical? (.-tsym (.-type proxy)) (.-tsym (.-restrictedType syms)))
                    (do
                      (Assert/check (identical? (.-kind sym) Kinds$Kind/MTH))
                      (set! (.-flags_field sym) (bit-or (.-flags_field sym) Flags/RESTRICTED)))
                  :else
                    (when (identical? (.-tsym (.-type proxy))
                                      (.-tsym (.-requiresIdentityType syms)))
                      (Assert/check (identical? (.-kind sym) Kinds$Kind/VAR))
                      (set! (.-flags_field sym)
                            (bit-or (.-flags_field sym) Flags/REQUIRES_IDENTITY))))
                (.append proxies proxy))))
        (.normal annotate (AnnotationCompleter. sym (.toList proxies))))))

  (method ^:private setFlagIfAttributeTrue ^void [this ^CompoundAnnotationProxy proxy ^Symbol sym
                                                  ^Name attribute ^long flag]
    (for-each [^{:tag (Pair Name Attribute)} v (.-values proxy)]
      (when (identical? (.-fst v) attribute)
        (when-instance [^Attribute$Constant constant (.-snd v)]
          (when (and (identical? (.-type constant) (.-booleanType syms))
                     (not (== (cast Integer (.-value constant)) 0)))
            (set! (.-flags_field sym) (bit-or (.-flags_field sym) flag)))))))

  (method readParameterAnnotations ^void [this ^Symbol meth]
    (let [^:mutable ^int numParameters 0]
      (try
        (set! numParameters
              (bit-and-int (.getByte buf (let [old-10 bp] (set! bp (unchecked-inc-int bp)) old-10))
                           0xFF))
        (catch ByteBuffer$UnderflowException e
          (throw (.badClassFile this
                                (CompilerProperties$Fragments/BadClassTruncatedAtOffset
                                  (.getLength e))))))
      (if (nil? parameterAnnotations)
          (set! parameterAnnotations (new ParameterAnnotations/1 numParameters))
          (when-not (== (alength parameterAnnotations) numParameters)
            (.warning
              log
              (CompilerProperties$LintWarnings/RuntimeVisibleInvisibleParamAnnotationsMismatch
                currentClassFile))
            (loop [^int pnum 0]
              (when (< pnum numParameters) (.readAnnotations this) (recur (unchecked-inc-int pnum))))
            (set! parameterAnnotations nil)
            (return)))
      (loop [^int pnum 0]
        (when (< pnum numParameters)
          (when (nil? (aget parameterAnnotations pnum))
            (aset parameterAnnotations pnum (ParameterAnnotations.)))
          (.add (aget parameterAnnotations pnum) (.readAnnotations this))
          (recur (unchecked-inc-int pnum))))))

  (method attachTypeAnnotations ^void [this ^:final ^Symbol sym]
    (let [^int numAttributes (.nextChar this)]
      (when-not (== numAttributes 0)
        (let [^{:tag (ListBuffer TypeAnnotationProxy)} proxies (ListBuffer.)]
          (loop [^int i 0]
            (when (< i numAttributes)
              (.append proxies (.readTypeAnnotation this))
              (recur (unchecked-inc-int i))))
          (.normal annotate (TypeAnnotationCompleter. sym (.toList proxies)))))))

  (method attachAnnotationDefault ^void [this ^:final ^Symbol sym]
    (let [meth (cast Symbol$MethodSymbol sym)
          value (.readAttributeValue this)]
      (set! (.-defaultValue meth) value)
      (.normal annotate (AnnotationDefaultCompleter. meth value))))

  (method readTypeOrClassSymbol ^Type [this ^int i]
    (.readTypeToProxy this i))

  (method readTypeToProxy ^Type [this ^int i]
    (if (identical? (.-module_info currentModule) currentOwner)
        (ProxyType. i)
        (.getType poolReader i)))

  (method readCompoundAnnotation ^CompoundAnnotationProxy [this]
    (let [^:mutable ^Type t nil]
      (if (identical? (.-module_info currentModule) currentOwner)
          (let [^int cpIndex (.nextChar this)] (set! t (ProxyType. cpIndex)))
          (set! t (.readTypeOrClassSymbol this (.nextChar this))))
      (let [^int numFields (.nextChar this)
            ^{:tag (ListBuffer (Pair Name Attribute))} pairs (ListBuffer.)]
        (loop [^int i 0]
          (when (< i numFields)
            (let [name (.getName poolReader (.nextChar this))
                  value (.readAttributeValue this)]
              (.append pairs (Pair. name value))
              (recur (unchecked-inc-int i)))))
        (CompoundAnnotationProxy. t (.toList pairs)))))

  (method readTypeAnnotation ^TypeAnnotationProxy [this]
    (let [position (.readPosition this)
          proxy (.readCompoundAnnotation this)]
      (TypeAnnotationProxy. proxy position)))

  (method readPosition ^TypeAnnotationPosition [this]
    (let [tag (.nextByte this)]
      (when-not (TargetType/isValidTargetTypeValue tag)
        (throw (.badClassFile this
                              "bad.type.annotation.value"
                              (new Object/1 [(String/format "0x%02X" (new Object/1 [tag]))]))))
      (let [type (TargetType/fromTargetTypeValue tag)]
        (switch type
          INSTANCEOF
            (let [^int offset (.nextChar this)
                  position (TypeAnnotationPosition/instanceOf (.readTypePath this))]
              (set! (.-offset position) offset)
              position)
          NEW
            (let [^int offset (.nextChar this)
                  position (TypeAnnotationPosition/newObj (.readTypePath this))]
              (set! (.-offset position) offset)
              position)
          CONSTRUCTOR_REFERENCE
            (let [^int offset (.nextChar this)
                  position (TypeAnnotationPosition/constructorRef (.readTypePath this))]
              (set! (.-offset position) offset)
              position)
          METHOD_REFERENCE
            (let [^int offset (.nextChar this)
                  position (TypeAnnotationPosition/methodRef (.readTypePath this))]
              (set! (.-offset position) offset)
              position)
          LOCAL_VARIABLE
            (let [^int table_length (.nextChar this)
                  newLvarOffset (new int/1 table_length)
                  newLvarLength (new int/1 table_length)
                  newLvarIndex (new int/1 table_length)]
              (loop [^int i 0]
                (when (< i table_length)
                  (aset newLvarOffset i (.nextChar this))
                  (aset newLvarLength i (.nextChar this))
                  (aset newLvarIndex i (.nextChar this))
                  (recur (unchecked-inc-int i))))
              (let [position (TypeAnnotationPosition/localVariable (.readTypePath this))]
                (set! (.-lvarOffset position) newLvarOffset)
                (set! (.-lvarLength position) newLvarLength)
                (set! (.-lvarIndex position) newLvarIndex)
                position))
          RESOURCE_VARIABLE
            (let [^int table_length (.nextChar this)
                  newLvarOffset (new int/1 table_length)
                  newLvarLength (new int/1 table_length)
                  newLvarIndex (new int/1 table_length)]
              (loop [^int i 0]
                (when (< i table_length)
                  (aset newLvarOffset i (.nextChar this))
                  (aset newLvarLength i (.nextChar this))
                  (aset newLvarIndex i (.nextChar this))
                  (recur (unchecked-inc-int i))))
              (let [position (TypeAnnotationPosition/resourceVariable (.readTypePath this))]
                (set! (.-lvarOffset position) newLvarOffset)
                (set! (.-lvarLength position) newLvarLength)
                (set! (.-lvarIndex position) newLvarIndex)
                position))
          EXCEPTION_PARAMETER
            (let [^int exception_index (.nextChar this)
                  position (TypeAnnotationPosition/exceptionParameter (.readTypePath this))]
              (.setExceptionIndex position exception_index)
              position)
          METHOD_RECEIVER (TypeAnnotationPosition/methodReceiver (.readTypePath this))
          CLASS_TYPE_PARAMETER
            (let [parameter_index (.nextByte this)]
              (TypeAnnotationPosition/typeParameter (.readTypePath this) parameter_index))
          METHOD_TYPE_PARAMETER
            (let [parameter_index (.nextByte this)]
              (TypeAnnotationPosition/methodTypeParameter (.readTypePath this) parameter_index))
          CLASS_TYPE_PARAMETER_BOUND
            (let [parameter_index (.nextByte this)
                  bound_index (.nextByte this)]
              (TypeAnnotationPosition/typeParameterBound
                (.readTypePath this)
                parameter_index
                bound_index))
          METHOD_TYPE_PARAMETER_BOUND
            (let [parameter_index (.nextByte this)
                  bound_index (.nextByte this)]
              (TypeAnnotationPosition/methodTypeParameterBound
                (.readTypePath this)
                parameter_index
                bound_index))
          CLASS_EXTENDS
            (let [^int type_index (.nextChar this)]
              (TypeAnnotationPosition/classExtends (.readTypePath this) type_index))
          THROWS
            (let [^int type_index (.nextChar this)]
              (TypeAnnotationPosition/methodThrows (.readTypePath this) type_index))
          METHOD_FORMAL_PARAMETER
            (let [parameter_index (.nextByte this)]
              (TypeAnnotationPosition/methodParameter (.readTypePath this) parameter_index))
          CAST
            (let [^int offset (.nextChar this)
                  type_index (.nextByte this)
                  position (TypeAnnotationPosition/typeCast (.readTypePath this) type_index)]
              (set! (.-offset position) offset)
              position)
          CONSTRUCTOR_INVOCATION_TYPE_ARGUMENT
            (let [^int offset (.nextChar this)
                  type_index (.nextByte this)
                  position (TypeAnnotationPosition/constructorInvocationTypeArg
                             (.readTypePath this)
                             type_index)]
              (set! (.-offset position) offset)
              position)
          METHOD_INVOCATION_TYPE_ARGUMENT
            (let [^int offset (.nextChar this)
                  type_index (.nextByte this)
                  position (TypeAnnotationPosition/methodInvocationTypeArg
                             (.readTypePath this)
                             type_index)]
              (set! (.-offset position) offset)
              position)
          CONSTRUCTOR_REFERENCE_TYPE_ARGUMENT
            (let [^int offset (.nextChar this)
                  type_index (.nextByte this)
                  position (TypeAnnotationPosition/constructorRefTypeArg
                             (.readTypePath this)
                             type_index)]
              (set! (.-offset position) offset)
              position)
          METHOD_REFERENCE_TYPE_ARGUMENT
            (let [^int offset (.nextChar this)
                  type_index (.nextByte this)
                  position (TypeAnnotationPosition/methodRefTypeArg (.readTypePath this) type_index)]
              (set! (.-offset position) offset)
              position)
          METHOD_RETURN (TypeAnnotationPosition/methodReturn (.readTypePath this))
          FIELD (TypeAnnotationPosition/field (.readTypePath this))
          UNKNOWN
            (throw (AssertionError. "jvm.ClassReader: UNKNOWN target type should never occur!"))
          (throw (AssertionError.
                   (java-str "jvm.ClassReader: Unknown target type for position: " type)))))))

  (method readTypePath ^{:tag (List TypeAnnotationPosition$TypePathEntry)} [this]
    (let [len (.nextByte this)
          ^:mutable ^{:tag (ListBuffer Integer)} loc (ListBuffer.)]
      (loop [^int i 0]
        (when (< i (unchecked-multiply-int len TypeAnnotationPosition$TypePathEntry/bytesPerEntry))
          (set! loc (.append loc (.nextByte this)))
          (recur (unchecked-inc-int i))))
      (TypeAnnotationPosition/getTypePathFromBinary (.toList loc))))

  (method optPoolEntry :type-params [Z] ^Z [this ^int index ^{:tag (IntFunction Z)} poolFunc
                                            ^Z defaultValue]
    (if (== index 0) defaultValue (.apply poolFunc index)))

  (method readAttributeValue ^Attribute [this]
    (let [^:mutable ^char c (unchecked-char 0)]
      (try
        (set! c
              (unchecked-char
                (.getByte buf (let [old-11 bp] (set! bp (unchecked-inc-int bp)) old-11))))
        (catch ByteBuffer$UnderflowException e
          (throw (.badClassFile this
                                (CompilerProperties$Fragments/BadClassTruncatedAtOffset
                                  (.getLength e))))))
      (switch c
        \B (Attribute$Constant. (.-byteType syms) (.getConstant poolReader (.nextChar this)))
        \C (Attribute$Constant. (.-charType syms) (.getConstant poolReader (.nextChar this)))
        \D (Attribute$Constant. (.-doubleType syms) (.getConstant poolReader (.nextChar this)))
        \F (Attribute$Constant. (.-floatType syms) (.getConstant poolReader (.nextChar this)))
        \I (Attribute$Constant. (.-intType syms) (.getConstant poolReader (.nextChar this)))
        \J (Attribute$Constant. (.-longType syms) (.getConstant poolReader (.nextChar this)))
        \S (Attribute$Constant. (.-shortType syms) (.getConstant poolReader (.nextChar this)))
        \Z (Attribute$Constant. (.-booleanType syms) (.getConstant poolReader (.nextChar this)))
        \s
          (Attribute$Constant. (.-stringType syms)
                               (.toString (.getName poolReader (.nextChar this))))
        \e
          (EnumAttributeProxy. (.readTypeToProxy this (.nextChar this))
                               (.getName poolReader (.nextChar this)))
        \c (ClassAttributeProxy. (.readTypeOrClassSymbol this (.nextChar this)))
        \[
          (let [^int n (.nextChar this)
                ^{:tag (ListBuffer Attribute)} l (ListBuffer.)]
            (loop [^int i 0]
              (when (< i n) (.append l (.readAttributeValue this)) (recur (unchecked-inc-int i))))
            (ArrayAttributeProxy. (.toList l)))
        \@ (.readCompoundAnnotation this)
        (throw (AssertionError. (java-str "unknown annotation tag '" c "'"))))))

  (defclass ^:interface ProxyVisitor
    :extends [Attribute$Visitor]

    (method visitEnumAttributeProxy ^void [this ^EnumAttributeProxy proxy])

    (method visitClassAttributeProxy ^void [this ^ClassAttributeProxy proxy])

    (method visitArrayAttributeProxy ^void [this ^ArrayAttributeProxy proxy])

    (method visitCompoundAnnotationProxy ^void [this ^CompoundAnnotationProxy proxy]))

  (defclass ^:static EnumAttributeProxy
    :extends Attribute

    (field ^Type enumType)

    (field ^Name enumerator)

    (constructor ^:public [this ^Type enumType ^Name enumerator]
      (super. nil)
      (set! (.-enumType this) enumType)
      (set! (.-enumerator this) enumerator))

    (method ^:public accept ^void [this ^Attribute$Visitor v]
      (.visitEnumAttributeProxy (cast ProxyVisitor v) this))

    (method ^:public toString ^String [this]
      (java-str "/*proxy enum*/" enumType "." enumerator)))

  (defclass ^:static ClassAttributeProxy
    :extends Attribute

    (field ^Type classType)

    (constructor ^:public [this ^Type classType]
      (super. nil)
      (set! (.-classType this) classType))

    (method ^:public accept ^void [this ^Attribute$Visitor v]
      (.visitClassAttributeProxy (cast ProxyVisitor v) this))

    (method ^:public toString ^String [this]
      (java-str "/*proxy class*/" classType ".class")))

  (defclass ^:static ArrayAttributeProxy
    :extends Attribute

    (field ^{:tag (List Attribute)} values)

    (constructor [this ^{:tag (List Attribute)} values]
      (super. nil)
      (set! (.-values this) values))

    (method ^:public accept ^void [this ^Attribute$Visitor v]
      (.visitArrayAttributeProxy (cast ProxyVisitor v) this))

    (method ^:public toString ^String [this] (java-str "{" values "}")))

  (defclass ^:static CompoundAnnotationProxy
    :extends Attribute

    (field ^:final ^{:tag (List (Pair Name Attribute))} values)

    (constructor ^:public [this ^Type type ^{:tag (List (Pair Name Attribute))} values]
      (super. type)
      (set! (.-values this) values))

    (method ^:public accept ^void [this ^Attribute$Visitor v]
      (.visitCompoundAnnotationProxy (cast ProxyVisitor v) this))

    (method ^:public toString ^String [this]
      (let [buf (StringBuilder.)]
        (.append buf "@")
        (.append buf (.getQualifiedName (.-tsym (.-type this))))
        (.append buf "/*proxy*/{")
        (let [^:mutable first true]
          (loop [^{:tag (List (Pair Name Attribute))} v values]
            (when (.nonEmpty v)
              (let [^{:tag (Pair Name Attribute)} value (cast Pair (.-head v))]
                (when-not first (.append buf ","))
                (set! first false)
                (.append buf (cast CharSequence (.-fst value)))
                (.append buf "=")
                (.append buf (.-snd value))
                (recur (.-tail v)))))
          (.append buf "}")
          (.toString buf)))))

  (defclass ^:static TypeAnnotationProxy
    (field ^:final ^CompoundAnnotationProxy compound)

    (field ^:final ^TypeAnnotationPosition position)

    (constructor ^:public [this ^CompoundAnnotationProxy compound ^TypeAnnotationPosition position]
      (set! (.-compound this) compound)
      (set! (.-position this) position)))

  (defclass AnnotationDeproxy
    :implements [ProxyVisitor]

    (field ^:private ^Symbol$ClassSymbol requestingOwner)

    (constructor [this ^Symbol$ClassSymbol owner]
      (set! (.-requestingOwner this) owner))

    (method deproxyCompoundList ^{:tag (List Attribute$Compound)} [this
                                                                   ^{:tag (List CompoundAnnotationProxy)} pl]
      (let [^{:tag (ListBuffer Attribute$Compound)} buf (ListBuffer.)]
        (loop [^{:tag (List CompoundAnnotationProxy)} l pl]
          (when (.nonEmpty l)
            (.append buf (.deproxyCompound this (cast CompoundAnnotationProxy (.-head l))))
            (recur (.-tail l))))
        (.toList buf)))

    (method deproxyCompound ^Attribute$Compound [this ^CompoundAnnotationProxy a]
      (let [annotationType (.resolvePossibleProxyType this (.-type a))
            ^{:tag (ListBuffer (Pair Symbol$MethodSymbol Attribute))} buf (ListBuffer.)]
        (loop [^{:tag (List (Pair Name Attribute))} l (.-values a)]
          (when (.nonEmpty l)
            (let [meth (.findAccessMethod this
                                          annotationType
                                          (cast Name (.-fst (cast Pair (.-head l)))))]
              (.append buf
                       (Pair. meth
                              (.deproxy this
                                        (.getReturnType (.-type meth))
                                        (cast Attribute (.-snd (cast Pair (.-head l)))))))
              (recur (.-tail l)))))
        (Attribute$Compound. annotationType (.toList buf))))

    (method findAccessMethod ^Symbol$MethodSymbol [this ^Type container ^Name name]
      (let [^:mutable ^Symbol$CompletionFailure failure nil]
        (try
          (for-each [^Symbol sym (.getSymbolsByName (.members (.-tsym container)) name)]
            (when (and (identical? (.-kind sym) Kinds$Kind/MTH)
                       (== (.length (.getParameterTypes (.-type sym))) 0))
              (return (cast Symbol$MethodSymbol sym))))
          (catch Symbol$CompletionFailure ex (set! failure ex)))
        (let [prevSource (.useSource log (.-classfile requestingOwner))]
          (try
            (if (nil? failure)
                (.warning log
                          (CompilerProperties$LintWarnings/AnnotationMethodNotFound container name))
                (.warning log
                          (CompilerProperties$LintWarnings/AnnotationMethodNotFoundReason
                            container
                            name
                            (.getDetailValue failure))))
            (finally (.useSource log prevSource)))
          (let [mt (Type$MethodType. (List/nil) (.-botType syms) (List/nil) (.-methodClass syms))]
            (Symbol$MethodSymbol. (bit-or-int Flags/PUBLIC Flags/ABSTRACT)
                                  name
                                  mt
                                  (.-tsym container))))))

    (field ^Attribute result)

    (field ^Type type)

    (method deproxy ^Attribute [this ^Type t ^Attribute a]
      (let [oldType type] (try (set! type t) (.accept a this) result (finally (set! type oldType)))))

    (method ^:public visitConstant ^void [this ^Attribute$Constant value]
      (set! result value))

    (method ^:public visitClass ^void [this ^Attribute$Class clazz]
      (set! result clazz))

    (method ^:public visitEnum ^void [this ^Attribute$Enum e]
      (throw (AssertionError.)))

    (method ^:public visitCompound ^void [this ^Attribute$Compound compound]
      (throw (AssertionError.)))

    (method ^:public visitArray ^void [this ^Attribute$Array array]
      (throw (AssertionError.)))

    (method ^:public visitError ^void [this ^Attribute$Error e]
      (throw (AssertionError.)))

    (method ^:public visitEnumAttributeProxy ^void [this ^EnumAttributeProxy proxy]
      (let [enumType (.resolvePossibleProxyType this (.-enumType proxy))
            enumTypeSym (.-tsym enumType)
            ^:mutable ^Symbol$VarSymbol enumerator nil
            ^:mutable ^Symbol$CompletionFailure failure nil]
        (try
          (for-each [^Symbol sym (.getSymbolsByName (.members enumTypeSym) (.-enumerator proxy))]
            (when (identical? (.-kind sym) Kinds$Kind/VAR)
              (set! enumerator (cast Symbol$VarSymbol sym))
              (break)))
          (catch Symbol$CompletionFailure ex (set! failure ex)))
        (if (nil? enumerator)
            (do
              (if (some? failure)
                  (.warning log
                            (CompilerProperties$Warnings/UnknownEnumConstantReason
                              currentClassFile
                              enumTypeSym
                              (.-enumerator proxy)
                              (.getDiagnostic failure)))
                  (.warning log
                            (CompilerProperties$Warnings/UnknownEnumConstant
                              currentClassFile
                              enumTypeSym
                              (.-enumerator proxy))))
              (set! result
                    (Attribute$Enum. (.-type enumTypeSym)
                                     (Symbol$VarSymbol.
                                       0
                                       (.-enumerator proxy)
                                       (.-botType syms)
                                       enumTypeSym))))
            (set! result (Attribute$Enum. (.-type enumTypeSym) enumerator)))))

    (method ^:public visitClassAttributeProxy ^void [this ^ClassAttributeProxy proxy]
      (let [classType (.resolvePossibleProxyType this (.-classType proxy))]
        (set! result (Attribute$Class. types classType))))

    (method ^:public visitArrayAttributeProxy ^void [this ^ArrayAttributeProxy proxy]
      (let [length (.length (.-values proxy))
            ats (new Attribute/1 length)
            elemtype (.elemtype types type)
            ^:mutable ^int i 0]
        (loop [^{:tag (List Attribute)} p (.-values proxy)]
          (when (.nonEmpty p)
            (aset ats i (.deproxy this elemtype (cast Attribute (.-head p))))
            (set! i (unchecked-inc-int i))
            (recur (.-tail p))))
        (set! result (Attribute$Array. type ats))))

    (method ^:public visitCompoundAnnotationProxy ^void [this ^CompoundAnnotationProxy proxy]
      (set! result (.deproxyCompound this proxy)))

    (method resolvePossibleProxyType ^Type [this ^Type t]
      (if-instance [^ProxyType proxyType t]
        (do
          (Assert/check (instance? Symbol$ModuleSymbol (.-owner requestingOwner)))
          (let [prevCurrentModule currentModule]
            (set! currentModule (cast Symbol$ModuleSymbol (.-owner requestingOwner)))
            (try (.resolve proxyType) (finally (set! currentModule prevCurrentModule)))))
        t)))

  (defclass AnnotationDefaultCompleter
    :extends AnnotationDeproxy
    :implements [Runnable]

    (field ^:final ^Symbol$MethodSymbol sym)

    (field ^:final ^Attribute value)

    (field ^:final ^JavaFileObject classFile currentClassFile)

    (constructor [this ^Symbol$MethodSymbol sym ^Attribute value]
      (super. ^Symbol$ClassSymbol (if (identical? (.-kind currentOwner) Kinds$Kind/MTH)
                                      (.enclClass currentOwner)
                                      (cast Symbol$ClassSymbol currentOwner)))
      (set! (.-sym this) sym)
      (set! (.-value this) value))

    (method ^:public run ^void [this]
      (let [previousClassFile currentClassFile]
        (try
          (set! (.-defaultValue sym) nil)
          (set! currentClassFile classFile)
          (set! (.-defaultValue sym) (.deproxy this (.getReturnType (.-type sym)) value))
          (finally (set! currentClassFile previousClassFile)))))

    (method ^:public toString ^String [this]
      (java-str " ClassReader store default for " (.-owner sym) "." sym " is " value)))

  (defclass AnnotationCompleter
    :extends AnnotationDeproxy
    :implements [Runnable]

    (field ^:final ^Symbol sym)

    (field ^:final ^{:tag (List CompoundAnnotationProxy)} l)

    (field ^:final ^JavaFileObject classFile)

    (constructor [this ^Symbol sym ^{:tag (List CompoundAnnotationProxy)} l]
      (super. ^Symbol$ClassSymbol (if (identical? (.-kind currentOwner) Kinds$Kind/MTH)
                                      (.enclClass currentOwner)
                                      (cast Symbol$ClassSymbol currentOwner)))
      (if (and (identical? (.-kind sym) Kinds$Kind/TYP)
               (identical? (.-kind (.-owner sym)) Kinds$Kind/MDL))
          (set! (.-sym this) (.-owner sym))
          (set! (.-sym this) sym))
      (set! (.-l this) l)
      (set! (.-classFile this) currentClassFile))

    (method ^:public run ^void [this]
      (let [previousClassFile currentClassFile]
        (try
          (set! currentClassFile classFile)
          (let [^{:tag (List Attribute$Compound)} newList (.deproxyCompoundList this l)]
            (for-each [^Attribute$Compound attr newList]
              (when (identical? (.-tsym (.-type attr)) (.-tsym (.-deprecatedType syms)))
                (set! (.-flags_field sym)
                      (bit-or (.-flags_field sym)
                              (bit-or Flags/DEPRECATED Flags/DEPRECATED_ANNOTATION)))
                (let [forRemoval (.member attr (.-forRemoval names))]
                  (when-instance [^Attribute$Constant constant forRemoval]
                    (when (and (identical? (.-type constant) (.-booleanType syms))
                               (not (== (cast Integer (.-value constant)) 0)))
                      (set! (.-flags_field sym)
                            (bit-or (.-flags_field sym) Flags/DEPRECATED_REMOVAL)))))))
            (if (.annotationsPendingCompletion sym)
                (.setDeclarationAttributes sym newList)
                (.appendAttributes sym newList)))
          (finally (set! currentClassFile previousClassFile)))))

    (method ^:public toString ^String [this]
      (java-str " ClassReader annotate " (.-owner sym) "." sym " with " l)))

  (defclass TypeAnnotationCompleter
    :extends AnnotationCompleter

    (field ^{:tag (List TypeAnnotationProxy)} proxies)

    (constructor [this ^Symbol sym ^{:tag (List TypeAnnotationProxy)} proxies]
      (super. sym (List/nil))
      (set! (.-proxies this) proxies))

    (method deproxyTypeCompoundList ^{:tag (List Attribute$TypeCompound)} [this
                                                                           ^{:tag (List TypeAnnotationProxy)} proxies]
      (let [^{:tag (ListBuffer Attribute$TypeCompound)} buf (ListBuffer.)]
        (for-each [^TypeAnnotationProxy proxy proxies]
          (let [compound (.deproxyCompound this (.-compound proxy))
                typeCompound (Attribute$TypeCompound. compound (.-position proxy))]
            (.add buf typeCompound)))
        (.toList buf)))

    (method ^:public run ^void [this]
      (let [previousClassFile currentClassFile]
        (try
          (set! currentClassFile (.-classFile this))
          (let [^{:tag (List Attribute$TypeCompound)} newList (.deproxyTypeCompoundList
                                                                this
                                                                proxies)]
            (.setTypeAttributes (.-sym this)
                                (.prependList newList (.getRawTypeAttributes (.-sym this))))
            (.addTypeAnnotationsToSymbol ClassReader/this (.-sym this) newList))
          (finally (set! currentClassFile previousClassFile))))))

  (method ^:private addTypeAnnotationsToSymbol ^void [this ^Symbol s
                                                      ^{:tag (List Attribute$TypeCompound)} attributes]
    (try
      (.visit (TypeAnnotationSymbolVisitor. attributes) s nil)
      (catch Symbol$CompletionFailure ex
        (let [prev (.useSource log currentClassFile)]
          (try
            (.error log
                    (CompilerProperties$Errors/CantAttachTypeAnnotations
                      attributes
                      (.-owner s)
                      (.-name s)
                      (.getDetailValue ex)))
            (finally (.useSource log prev)))))))

  (defclass ^:private ^:static TypeAnnotationSymbolVisitor
    :extends (Types$DefaultSymbolVisitor Void Void)

    (field ^:private ^:final ^{:tag (List Attribute$TypeCompound)} attributes)

    (constructor ^:private [this ^{:tag (List Attribute$TypeCompound)} attributes]
      (set! (.-attributes this) attributes))

    (field ^:public ^:static ^:final ^int SUPERCLASS_INDEX 65535)

    (method ^:public visitClassSymbol ^Void [this ^Symbol$ClassSymbol s ^Void unused]
      (let [t (cast Type$ClassType (.-type s))
            ^:mutable ^int i 0
            ^{:tag (ListBuffer Type)} interfaces (ListBuffer.)]
        (for-each [^Type itf (.-interfaces_field t)]
          (.add interfaces
                (.addTypeAnnotations this itf (TypeAnnotationSymbolVisitor/classExtends i)))
          (set! i (unchecked-inc-int i)))
        (set! (.-interfaces_field t) (.toList interfaces))
        (set! (.-supertype_field t)
              (.addTypeAnnotations this
                                   (.-supertype_field t)
                                   (TypeAnnotationSymbolVisitor/classExtends SUPERCLASS_INDEX)))
        (when (some? (.-typarams_field t))
          (set! (.-typarams_field t)
                (.rewriteTypeParameters this
                                        (.-typarams_field t)
                                        TargetType/CLASS_TYPE_PARAMETER_BOUND)))
        nil))

    (method ^:public visitMethodSymbol ^Void [this ^Symbol$MethodSymbol s ^Void unused]
      (let [^:mutable t (.-type s)]
        (when (.hasTag t TypeTag/FORALL)
          (let [fa (cast Type$ForAll t)]
            (set! (.-tvars fa)
                  (.rewriteTypeParameters this (.-tvars fa) TargetType/METHOD_TYPE_PARAMETER_BOUND))
            (set! t (.-qtype fa))))
        (let [mt (cast Type$MethodType t)
              ^{:tag (ListBuffer Type)} argtypes (ListBuffer.)
              ^:mutable ^int i 0]
          (for-each [^Symbol$VarSymbol param (.-params s)]
            (set! (.-type param)
                  (.addTypeAnnotations this
                                       (.-type param)
                                       (TypeAnnotationSymbolVisitor/methodFormalParameter i)))
            (set! i (unchecked-inc-int i))
            (.add argtypes (.-type param)))
          (set! (.-argtypes mt) (.toList argtypes))
          (let [^{:tag (ListBuffer Type)} thrown (ListBuffer.)]
            (set! i 0)
            (for-each [^Type thrownType (.-thrown mt)]
              (.add
                thrown
                (.addTypeAnnotations this thrownType (TypeAnnotationSymbolVisitor/thrownType i)))
              (set! i (unchecked-inc-int i)))
            (set! (.-thrown mt) (.toList thrown))
            (when-not (.hasTag (.-restype mt) TypeTag/VOID)
              (set! (.-restype mt)
                    (.addTypeAnnotations this (.-restype mt) TargetType/METHOD_RETURN)))
            (let [^Type recvtype (if (some? (.-recvtype mt))
                                     (.-recvtype mt)
                                     (.implicitReceiverType s))]
              (when (some? recvtype)
                (let [annotated (.addTypeAnnotations this recvtype TargetType/METHOD_RECEIVER)]
                  (when-not (identical? annotated recvtype) (set! (.-recvtype mt) annotated))))
              nil)))))

    (method ^:public visitVarSymbol ^Void [this ^Symbol$VarSymbol s ^Void unused]
      (set! (.-type s) (.addTypeAnnotations this (.-type s) TargetType/FIELD))
      nil)

    (method ^:public visitSymbol ^Void [this ^Symbol s ^Void unused] nil)

    (method ^:private rewriteTypeParameters ^{:tag (List Type)} [this ^{:tag (List Type)} tvars
                                                                 ^TargetType boundType]
      (let [^{:tag (ListBuffer Type)} tvarbuf (ListBuffer.)
            ^:mutable ^int typeVariableIndex 0]
        (for-each [^Type tvar tvars]
          (let [^:mutable bound (.getUpperBound tvar)]
            (if (.isCompound bound)
                (let [ct (cast Type$ClassType bound)
                      ^:mutable ^int boundIndex 0]
                  (when (some? (.-supertype_field ct))
                    (set! (.-supertype_field ct)
                          (.addTypeAnnotations this
                                               (.-supertype_field ct)
                                               (TypeAnnotationSymbolVisitor/typeParameterBound
                                                 boundType
                                                 typeVariableIndex
                                                 boundIndex)))
                    (set! boundIndex (unchecked-inc-int boundIndex)))
                  (let [^{:tag (ListBuffer Type)} itfbuf (ListBuffer.)]
                    (for-each [^Type itf (.-interfaces_field ct)]
                      (.add itfbuf
                            (.addTypeAnnotations
                              this
                              itf
                              (TypeAnnotationSymbolVisitor/typeParameterBound
                                boundType
                                typeVariableIndex
                                boundIndex)))
                      (set! boundIndex (unchecked-inc-int boundIndex)))
                    (set! (.-interfaces_field ct) (.toList itfbuf))))
                (set! bound
                      (.addTypeAnnotations this
                                           bound
                                           (TypeAnnotationSymbolVisitor/typeParameterBound
                                             boundType
                                             typeVariableIndex
                                             (if (.isInterface bound) 1 0)))))
            (.setUpperBound (cast Type$TypeVar tvar) bound)
            (.add tvarbuf tvar)
            (set! typeVariableIndex (unchecked-inc-int typeVariableIndex))))
        (.toList tvarbuf)))

    (method ^:private addTypeAnnotations ^Type [this ^Type type ^TargetType targetType]
      (.addTypeAnnotations this
                           type
                           (lambda Predicate ^boolean [^TypeAnnotationPosition pos]
                             (identical? (.-type pos) targetType))))

    (method ^:private addTypeAnnotations ^Type [this ^:mutable ^Type type
                                                ^{:tag (Predicate TypeAnnotationPosition)} filter]
      (Assert/checkNonNull type)
      (let [^{:tag (ListBuffer Attribute$TypeCompound)} filtered (ListBuffer.)]
        (for-each [^Attribute$TypeCompound attribute (.-attributes this)]
          (when (.test filter (.-position attribute)) (.add filtered attribute)))
        (if (.isEmpty filtered)
            type
            (let [^{:tag (Map (List TypeAnnotationPosition$TypePathEntry) (ListBuffer Attribute$TypeCompound))} attributesByPath
                    (HashMap.)]
              (for-each [^Attribute$TypeCompound attribute (.toList filtered)]
                (.add (cast
                        ListBuffer
                        (.computeIfAbsent attributesByPath
                                          (.-location (.-position attribute))
                                          (lambda Function ^ListBuffer [^List k] (ListBuffer.))))
                      attribute))
              (set! type
                    (cast Type
                          (.visit (TypeAnnotationStructuralTypeMapping. attributesByPath)
                                  type
                                  (List/nil))))
              type))))

    (method ^:private ^:static typeParameterBound ^{:tag (Predicate TypeAnnotationPosition)} [^TargetType targetType
                                                                                              ^int parameterIndex
                                                                                              ^int boundIndex]
      (lambda Predicate ^boolean [^TypeAnnotationPosition pos]
        (and (and (identical? (.-type pos) targetType) (== (.-parameter_index pos) parameterIndex))
             (== (.-bound_index pos) boundIndex))))

    (method ^:private ^:static methodFormalParameter ^{:tag (Predicate TypeAnnotationPosition)} [^int index]
      (lambda Predicate ^boolean [^TypeAnnotationPosition pos]
        (and (identical? (.-type pos) TargetType/METHOD_FORMAL_PARAMETER)
             (== (.-parameter_index pos) index))))

    (method ^:private ^:static thrownType ^{:tag (Predicate TypeAnnotationPosition)} [^int index]
      (lambda Predicate ^boolean [^TypeAnnotationPosition pos]
        (and (identical? (.-type pos) TargetType/THROWS) (== (.-type_index pos) index))))

    (method ^:private ^:static classExtends ^{:tag (Predicate TypeAnnotationPosition)} [^int index]
      (lambda Predicate ^boolean [^TypeAnnotationPosition pos]
        (and (identical? (.-type pos) TargetType/CLASS_EXTENDS) (== (.-type_index pos) index)))))

  (defclass ^:private ^:static ^:final TypeAnnotationStructuralTypeMapping
    :extends (Types$TypeMapping (List TypeAnnotationPosition$TypePathEntry))

    (field ^:private ^:final ^{:tag (Map (List TypeAnnotationPosition$TypePathEntry) (ListBuffer Attribute$TypeCompound))} attributesByPath)

    (constructor ^:private [this
                            ^{:tag (Map (List TypeAnnotationPosition$TypePathEntry) (ListBuffer Attribute$TypeCompound))} attributesByPath]
      (set! (.-attributesByPath this) attributesByPath))

    (method ^:public visitClassType ^Type [this ^:mutable ^Type$ClassType t
                                           ^:mutable ^{:tag (List TypeAnnotationPosition$TypePathEntry)} path]
      (let [outer (.getEnclosingType t)
            ^Type outer1 (if (not (identical? outer Type/noType))
                             (cast Type (.visit this outer path))
                             outer)]
        (loop [curr (.getEnclosingType t)]
          (when-not (identical? curr Type/noType)
            (set! path (.append path TypeAnnotationPosition$TypePathEntry/INNER_TYPE))
            (recur (.getEnclosingType curr))))
        (let [^{:tag (List Type)} typarams (.getTypeArguments t)
              ^{:tag (List Type)} typarams1 (.rewriteTypeParams this path typarams)]
          (when (or (not (identical? outer1 outer)) (not (identical? typarams typarams1)))
            (set! t (Type$ClassType. outer1 typarams1 (.-tsym t) (.getMetadata t))))
          (.reannotate this t path))))

    (method ^:private rewriteTypeParams ^{:tag (List Type)} [this
                                                             ^{:tag (List TypeAnnotationPosition$TypePathEntry)} path
                                                             ^{:tag (List Type)} typarams]
      (let [i (.iterator (IntStream/iterate 0
                                            (lambda IntUnaryOperator ^int [^int x]
                                              (unchecked-add-int x 1))))]
        (.map typarams
              (lambda Function ^Type [^Type typaram]
                (cast Type
                      (.visit this
                              typaram
                              (.append path
                                       (TypeAnnotationPosition$TypePathEntry.
                                         TypeAnnotationPosition$TypePathEntryKind/TYPE_ARGUMENT
                                         (.nextInt i)))))))))

    (method ^:public visitWildcardType ^Type [this ^:mutable ^Type$WildcardType wt
                                              ^{:tag (List TypeAnnotationPosition$TypePathEntry)} path]
      (let [^:mutable t (.-type wt)]
        (when (some? t)
          (set! t
                (cast Type
                      (.visit this t (.append path TypeAnnotationPosition$TypePathEntry/WILDCARD)))))
        (when-not (identical? t (.-type wt))
          (set! wt (Type$WildcardType. t (.-kind wt) (.-tsym wt) (.-bound wt) (.getMetadata wt))))
        (.reannotate this wt path)))

    (method ^:public visitArrayType ^Type [this ^:mutable ^Type$ArrayType t
                                           ^{:tag (List TypeAnnotationPosition$TypePathEntry)} path]
      (let [elemtype (.-elemtype t)
            elemtype1 (cast Type
                            (.visit this
                                    elemtype
                                    (.append path TypeAnnotationPosition$TypePathEntry/ARRAY)))]
        (when-not (identical? elemtype1 elemtype)
          (set! t (Type$ArrayType. elemtype1 (.-tsym t) (.getMetadata t))))
        (.reannotate this t path)))

    (method ^:public visitType ^Type [this ^Type t
                                      ^{:tag (List TypeAnnotationPosition$TypePathEntry)} path]
      (.reannotate this t path))

    (method reannotate ^Type [this ^Type type
                              ^{:tag (List TypeAnnotationPosition$TypePathEntry)} path]
      (let [^{:tag (List Attribute$TypeCompound)} attributes (.attributesForPath this path)]
        (if (.isEmpty attributes)
            type
            (let [existing (cast TypeMetadata$Annotations
                                 (.getMetadata type TypeMetadata$Annotations))]
              (if (some? existing)
                  (do (.addAll (.annotationBuffer existing) attributes) type)
                  (.annotatedType type attributes))))))

    (method attributesForPath ^{:tag (List Attribute$TypeCompound)} [this
                                                                     ^{:tag (List TypeAnnotationPosition$TypePathEntry)} path]
      (let [^{:tag (ListBuffer Attribute$TypeCompound)} attributes (cast
                                                                     ListBuffer
                                                                     (.remove attributesByPath path))]
        (if (some? attributes) (.toList attributes) (List/nil)))))

  (method readField ^Symbol$VarSymbol [this]
    (let [rawFlags (.nextChar this)
          flags (.adjustFieldFlags this rawFlags)
          name (.getName poolReader (.nextChar this))
          type (.getType poolReader (.nextChar this))
          v (Symbol$VarSymbol. flags name type currentOwner)]
      (.readMemberAttrs this v)
      (when (or (> (Integer/bitCount
                     (bit-and-int rawFlags
                                  (bit-or-int (bit-or-int Flags/PUBLIC Flags/PRIVATE)
                                              Flags/PROTECTED)))
                   1)
                (> (Integer/bitCount (bit-and-int rawFlags (bit-or-int Flags/FINAL Flags/VOLATILE)))
                   1))
        (throw (.badClassFile this
                              "illegal.flag.combo"
                              (new Object/1 [(Flags/toString (long rawFlags)) "field" v]))))
      v))

  (method readMethod ^Symbol$MethodSymbol [this]
    (let [rawFlags (.nextChar this)
          ^:mutable flags (.adjustMethodFlags this rawFlags)
          name (.getName poolReader (.nextChar this))
          descriptorType (.getType poolReader (.nextChar this))
          ^:mutable type descriptorType]
      (when (and (and (.isInterface currentOwner) (== (bit-and flags Flags/ABSTRACT) 0))
                 (not (.equals name (.-clinit names))))
        (if (or (> majorVersion (.-major ClassFile$Version/V52))
                (and (== majorVersion (.-major ClassFile$Version/V52))
                     (>= minorVersion (.-minor ClassFile$Version/V52))))
            (when (== (bit-and flags (bit-or-int Flags/STATIC Flags/PRIVATE)) 0)
              (set! (.-flags_field currentOwner)
                    (bit-or (.-flags_field currentOwner) Flags/DEFAULT))
              (set! flags (bit-or flags (bit-or Flags/DEFAULT Flags/ABSTRACT))))
            (throw (.badClassFile this
                                  ^String (if (== (bit-and flags Flags/STATIC) 0)
                                              "invalid.default.interface"
                                              "invalid.static.interface")
                                  (new Object/1
                                       [(Integer/toString majorVersion)
                                        (Integer/toString minorVersion)])))))
      (.validateMethodType this name type)
      (let [^:mutable forceLocal false]
        (when (and (identical? name (.-init names)) (.hasOuterInstance currentOwner))
          (let [local (set! forceLocal
                            (not (.includes (.members (.-owner currentOwner))
                                            currentOwner
                                            Scope$LookupKind/NON_RECURSIVE)))]
            (when (and (not (.isEmpty (.-name currentOwner))) (not local))
              (set! type
                    (Type$MethodType. (.adjustMethodParams this flags (.getParameterTypes type))
                                      (.getReturnType type)
                                      (.getThrownTypes type)
                                      (.-methodClass syms))))))
        (let [m (Symbol$MethodSymbol. flags name type currentOwner)]
          (when (.isSignaturePolymorphic types m)
            (set! (.-flags_field m) (bit-or (.-flags_field m) Flags/SIGNATURE_POLYMORPHIC)))
          (when saveParameterNames (.initParameterNames this m))
          (let [prevOwner currentOwner]
            (set! currentOwner m)
            (try (.readMemberAttrs this m) (finally (set! currentOwner prevOwner)))
            (.validateMethodType this name (.-type m))
            (.adjustParameterAnnotations this m descriptorType forceLocal)
            (.setParameters this m type)
            (when (> (Integer/bitCount
                       (bit-and-int rawFlags
                                    (bit-or-int (bit-or-int Flags/PUBLIC Flags/PRIVATE)
                                                Flags/PROTECTED)))
                     1)
              (throw (.badClassFile this
                                    "illegal.flag.combo"
                                    (new Object/1 [(Flags/toString (long rawFlags)) "method" m]))))
            (when-not (== (bit-and flags Flags/VARARGS) 0)
              (let [last (cast Type (.last (.getParameterTypes type)))]
                (when (or (nil? last) (not (.hasTag last TypeTag/ARRAY)))
                  (set! (.-flags_field m) (bit-and (.-flags_field m) (bit-not Flags/VARARGS)))
                  (throw (.badClassFile this "malformed.vararg.method" (new Object/1 [m]))))))
            m)))))

  (method validateMethodType ^void [this ^Name name ^Type t]
    (when (or
            (and (not (.hasTag t TypeTag/METHOD)) (not (.hasTag t TypeTag/FORALL)))
            (and (identical? name (.-init names)) (not (.hasTag (.getReturnType t) TypeTag/VOID))))
      (throw (.badClassFile this "method.descriptor.invalid" (new Object/1 [name])))))

  (method ^:private adjustMethodParams ^{:tag (List Type)} [this ^long flags
                                                            ^:mutable ^{:tag (List Type)} args]
    (if (.isEmpty args)
        args
        (let [isVarargs (not (== (bit-and flags Flags/VARARGS) 0))]
          (when isVarargs
            (let [varargsElem (cast Type (.last args))
                  ^{:tag (ListBuffer Type)} adjustedArgs (ListBuffer.)]
              (for-each [^Type t args]
                (.append adjustedArgs
                         ^Type (if (not (identical? t varargsElem))
                                   t
                                   ^Type (.makeVarargs (cast Type$ArrayType t)))))
              (set! args (.toList adjustedArgs))))
          (.-tail args))))

  (method initParameterNames ^void [this ^Symbol$MethodSymbol sym]
    (let [^:const ^int excessSlots 4
          expectedParameterSlots (unchecked-add-int
                                   (Code/width (.getParameterTypes (.-type sym)))
                                   excessSlots)]
      (if (or (nil? parameterNameIndicesLvt)
              (< (alength parameterNameIndicesLvt) expectedParameterSlots))
          (set! parameterNameIndicesLvt (new int/1 expectedParameterSlots))
          (Arrays/fill parameterNameIndicesLvt 0))))

  (method setParameters ^void [this ^Symbol$MethodSymbol sym ^Type jvmType]
    (let [^:mutable ^int firstParamLvt (if (== (bit-and (.flags sym) Flags/STATIC) 0) 1 0)]
      (when (and (identical? (.-name sym) (.-init names)) (.hasOuterInstance currentOwner))
        (when-not (.isEmpty (.-name currentOwner))
          (set! firstParamLvt (unchecked-add-int firstParamLvt 1))))
      (when-not (identical? (.-type sym) jvmType)
        (let [skip (unchecked-subtract-int (Code/width (.getParameterTypes jvmType))
                                           (Code/width (.getParameterTypes (.-type sym))))]
          (set! firstParamLvt (unchecked-add-int firstParamLvt skip))))
      (let [^{:tag (Set Name)} paramNames (HashSet.)
            ^{:tag (ListBuffer Symbol$VarSymbol)} params (ListBuffer.)
            ^:mutable nameIndexLvt firstParamLvt
            ^:mutable ^int nameIndexMp 0
            ^:mutable ^int annotationIndex 0]
        (for-each [^Type t (.getParameterTypes (.-type sym))]
          (let [param (.parameter this nameIndexMp nameIndexLvt t sym paramNames)]
            (.append params param)
            (when (some? parameterAnnotations)
              (let [annotations (aget parameterAnnotations annotationIndex)]
                (when (and (some? annotations) (some? (.-proxies annotations)))
                  (.attachAnnotations this param (.-proxies annotations)))))
            (set! nameIndexLvt (unchecked-add-int nameIndexLvt (Code/width t)))
            (set! nameIndexMp (unchecked-inc-int nameIndexMp))
            (set! annotationIndex (unchecked-inc-int annotationIndex))))
        (Assert/check (or (nil? parameterAnnotations)
                          (== (alength parameterAnnotations) annotationIndex)))
        (Assert/checkNull (.-params sym))
        (set! (.-params sym) (.toList params))
        (set! parameterAnnotations nil)
        (set! parameterNameIndicesLvt nil)
        (set! parameterNameIndicesMp nil)
        (set! allParameterAccessFlags nil)
        (set! parameterAccessFlags nil))))

  (method adjustParameterAnnotations ^void [this ^Symbol$MethodSymbol sym ^Type methodDescriptor
                                            ^boolean forceLocal]
    (when (some? parameterAnnotations)
      (let [methodParameterCount (.size (.getParameterTypes (.-type sym)))]
        (when-not (== methodParameterCount (alength parameterAnnotations))
          (cond
            (some? allParameterAccessFlags)
              (let [^:mutable ^int realParameters 0]
                (loop [^int i 0]
                  (if (< i (alength allParameterAccessFlags))
                      (if (== (bit-and-int (aget allParameterAccessFlags i)
                                           (bit-or-int Flags/SYNTHETIC Flags/MANDATED))
                              0)
                          (do
                            (set! realParameters (unchecked-inc-int realParameters))
                            (recur (unchecked-inc-int i)))
                          (recur (unchecked-inc-int i)))
                      nil))
                (let [methodDescriptorParameterCount (.size (.getParameterTypes methodDescriptor))]
                  (cond
                    (and (== realParameters (alength parameterAnnotations))
                         (== (alength allParameterAccessFlags) methodDescriptorParameterCount))
                      (if (identical? (.-type sym) methodDescriptor)
                          (let [newParameterAnnotations (new
                                                          ParameterAnnotations/1
                                                          methodParameterCount)
                                ^:mutable ^int srcIndex 0]
                            (loop [^int i 0]
                              (if (< i methodParameterCount)
                                  (if (== (bit-and-int
                                            (aget allParameterAccessFlags i)
                                            (bit-or-int Flags/SYNTHETIC Flags/MANDATED))
                                          0)
                                      (do
                                        (aset newParameterAnnotations
                                              i
                                              (aget parameterAnnotations srcIndex))
                                        (set! srcIndex (unchecked-inc-int srcIndex))
                                        (recur (unchecked-inc-int i)))
                                      (recur (unchecked-inc-int i)))
                                  nil))
                            (set! parameterAnnotations newParameterAnnotations))
                          (.dropParameterAnnotations this))
                    (and (and (== realParameters methodParameterCount)
                              (== methodDescriptorParameterCount (alength parameterAnnotations)))
                         (== (alength allParameterAccessFlags) methodDescriptorParameterCount))
                      (let [newParameterAnnotations (new
                                                      ParameterAnnotations/1
                                                      methodParameterCount)
                            ^:mutable ^int targetIndex 0]
                        (loop [^int i 0]
                          (if (< i (alength parameterAnnotations))
                              (if (== (bit-and-int
                                        (aget allParameterAccessFlags i)
                                        (bit-or-int Flags/SYNTHETIC Flags/MANDATED))
                                      0)
                                  (do
                                    (aset newParameterAnnotations
                                          targetIndex
                                          (aget parameterAnnotations i))
                                    (set! targetIndex (unchecked-inc-int targetIndex))
                                    (recur (unchecked-inc-int i)))
                                  (recur (unchecked-inc-int i)))
                              nil))
                        (set! parameterAnnotations newParameterAnnotations))
                    :else (.dropParameterAnnotations this))))
            (not (.isConstructor sym)) (.dropParameterAnnotations this)
            :else
              (do
                (cond
                  (.isEnum (.-owner sym))
                    (when (and (== methodParameterCount
                                   (unchecked-add-int (alength parameterAnnotations) 2))
                               (identical? (.-type sym) methodDescriptor))
                      (let [newParameterAnnotations (new
                                                      ParameterAnnotations/1
                                                      (unchecked-add-int
                                                        (alength parameterAnnotations)
                                                        2))]
                        (System/arraycopy parameterAnnotations
                                          0
                                          newParameterAnnotations
                                          2
                                          (alength parameterAnnotations))
                        (set! parameterAnnotations newParameterAnnotations)
                        (return)))
                  (or (.isDirectlyOrIndirectlyLocal (.-owner sym)) forceLocal)
                    (when (and (> methodParameterCount (alength parameterAnnotations))
                               (identical? (.-type sym) methodDescriptor))
                      (let [newParameterAnnotations (new
                                                      ParameterAnnotations/1
                                                      methodParameterCount)]
                        (System/arraycopy parameterAnnotations
                                          0
                                          newParameterAnnotations
                                          1
                                          (alength parameterAnnotations))
                        (set! parameterAnnotations newParameterAnnotations)
                        (return))))
                (.dropParameterAnnotations this)))))))

  (method ^:private dropParameterAnnotations ^void [this]
    (set! parameterAnnotations nil)
    (.warning log
              (CompilerProperties$LintWarnings/RuntimeInvisibleParameterAnnotations
                currentClassFile)))

  (method ^:private parameter ^Symbol$VarSymbol [this ^int mpIndex ^int lvtIndex ^Type t
                                                 ^Symbol$MethodSymbol owner
                                                 ^{:tag (Set Name)} exclude]
    (let [^:mutable flags Flags/PARAMETER
          ^:mutable ^Name argName nil]
      (when (and (and (some? parameterAccessFlags) (< mpIndex (alength parameterAccessFlags)))
                 (not (== (aget parameterAccessFlags mpIndex) 0)))
        (set! flags (bit-or flags (aget parameterAccessFlags mpIndex))))
      (cond
        (and (and (some? parameterNameIndicesMp) (< mpIndex (alength parameterNameIndicesMp)))
             (not (== (aget parameterNameIndicesMp mpIndex) 0)))
          (do
            (set! argName
                  (cast Name
                        (.optPoolEntry this
                                       (aget parameterNameIndicesMp mpIndex)
                                       (method-ref
                                         IntFunction
                                         ^Name [int]
                                         poolReader
                                         PoolReader/.getName)
                                       (.-empty names))))
            (set! flags (bit-or flags Flags/NAME_FILLED)))
        (and (and (some? parameterNameIndicesLvt) (< lvtIndex (alength parameterNameIndicesLvt)))
             (not (== (aget parameterNameIndicesLvt lvtIndex) 0)))
          (do
            (set! argName
                  (cast Name
                        (.optPoolEntry this
                                       (aget parameterNameIndicesLvt lvtIndex)
                                       (method-ref
                                         IntFunction
                                         ^Name [int]
                                         poolReader
                                         PoolReader/.getName)
                                       (.-empty names))))
            (set! flags (bit-or flags Flags/NAME_FILLED)))
        :else
          (let [^:mutable prefix "arg"]
            (while true
              (set! argName (.fromString names (java-str prefix (.size exclude))))
              (when-not (.contains exclude argName) (break))
              (set! prefix (java-str prefix "$")))))
      (.add exclude argName)
      (Symbol$ParamSymbol. flags argName t owner)))

  (method skipBytes ^void [this ^int n]
    (set! bp (unchecked-add-int bp n)))

  (method skipMember ^void [this]
    (set! bp (unchecked-add-int bp 6))
    (let [ac (.nextChar this)]
      (loop [^int i 0]
        (when (< i ac)
          (set! bp (unchecked-add-int bp 2))
          (let [attrLen (.nextInt this)]
            (set! bp (unchecked-add-int bp attrLen))
            (recur (unchecked-inc-int i)))))))

  (method skipInnerClasses ^void [this]
    (let [^int n (.nextChar this)]
      (loop [^int i 0]
        (when (< i n)
          (.nextChar this)
          (.nextChar this)
          (.nextChar this)
          (.nextChar this)
          (recur (unchecked-inc-int i))))))

  (method ^:protected enterTypevars ^void [this ^Symbol sym ^Type t]
    (cond
      (some? (.getEnclosingType t))
        (when-not (.hasTag (.getEnclosingType t) TypeTag/NONE)
          (.enterTypevars this (.-owner sym) (.getEnclosingType t)))
      (and (identical? (.-kind sym) Kinds$Kind/MTH) (not (.isStatic sym)))
        (.enterTypevars this (.-owner sym) (.-type (.-owner sym))))
    (loop [^{:tag (List Type)} xs (.getTypeArguments t)]
      (when (.nonEmpty xs) (.enter typevars (.-tsym (cast Type (.-head xs)))) (recur (.-tail xs)))))

  (method ^:protected enterClass ^Symbol$ClassSymbol [this ^Name name]
    (.enterClass syms currentModule name))

  (method ^:protected enterClass ^Symbol$ClassSymbol [this ^Name name ^Symbol$TypeSymbol owner]
    (.enterClass syms currentModule name owner))

  (method readClass ^void [this ^Symbol$ClassSymbol c]
    (let [ct (cast Type$ClassType (.-type c))]
      (set! (.-members_field c) (Scope$WriteableScope/create c))
      (set! typevars (.dup typevars currentOwner))
      (when (.hasTag (.getEnclosingType ct) TypeTag/CLASS)
        (.enterTypevars this (.-owner c) (.getEnclosingType ct)))
      (let [^long f (.nextChar this)
            flags (.adjustClassFlags this f)]
        (if (== (bit-and flags Flags/MODULE) 0)
            (do
              (when (or (identical? (.-kind (.-owner c)) Kinds$Kind/PCK)
                        (identical? (.-kind (.-owner c)) Kinds$Kind/ERR))
                (set! (.-flags_field c) flags))
              (set! currentModule (.-modle (.packge c)))
              (let [self (.getClass poolReader (.nextChar this))]
                (when-not (identical? c self)
                  (throw (.badClassFile this
                                        "class.file.wrong.class"
                                        (new Object/1 [(.-flatname self)]))))))
            (do
              (when (< majorVersion (.-major ClassFile$Version/V53))
                (throw (.badClassFile this
                                      "anachronistic.module.info"
                                      (new Object/1
                                           [(Integer/toString majorVersion)
                                            (Integer/toString minorVersion)]))))
              (set! (.-flags_field c) flags)
              (when-not (identical? (.-kind (.-owner c)) Kinds$Kind/MDL)
                (throw (.badClassFile this "module.info.definition.expected" (new Object/1 []))))
              (set! currentModule (cast Symbol$ModuleSymbol (.-owner c)))
              (let [^int this_class (.nextChar this)] nil)))
        (let [startbp bp]
          (.nextChar this)
          (let [interfaceCount (.nextChar this)]
            (set! bp (unchecked-add-int bp (unchecked-multiply-int interfaceCount 2)))
            (let [fieldCount (.nextChar this)]
              (loop [^int i 0]
                (when (< i fieldCount) (.skipMember this) (recur (unchecked-inc-int i))))
              (let [methodCount (.nextChar this)]
                (loop [^int i 0]
                  (when (< i methodCount) (.skipMember this) (recur (unchecked-inc-int i))))
                (.readClassAttrs this c)
                (when-not (.isEmpty (.getPermittedSubclasses c))
                  (set! (.-flags_field c) (bit-or (.-flags_field c) Flags/SEALED)))
                (set! bp startbp)
                (let [^:mutable ^int n (.nextChar this)]
                  (when (and (not (== (bit-and flags Flags/MODULE) 0)) (> n 0))
                    (throw (.badClassFile this "module.info.invalid.super.class" (new Object/1 []))))
                  (when (nil? (.-supertype_field ct))
                    (set! (.-supertype_field ct)
                          (cast Type
                                (.optPoolEntry this
                                               n
                                               (lambda IntFunction ^Type [^int idx]
                                                 (.erasure (.getClass poolReader idx) types))
                                               Type/noType))))
                  (set! n (.nextChar this))
                  (let [^:mutable ^{:tag (List Type)} is (List/nil)]
                    (loop [^int i 0]
                      (when (< i n)
                        (let [_inter (.erasure (.getClass poolReader (.nextChar this)) types)]
                          (set! is (.prepend is _inter))
                          (recur (unchecked-inc-int i)))))
                    (when (nil? (.-interfaces_field ct))
                      (set! (.-interfaces_field ct) (.reverse is)))
                    (Assert/check (== fieldCount (.nextChar this)))
                    (loop [^int i 0]
                      (when (< i fieldCount)
                        (.enterMember this c (.readField this))
                        (recur (unchecked-inc-int i))))
                    (Assert/check (== methodCount (.nextChar this)))
                    (loop [^int i 0]
                      (when (< i methodCount)
                        (.enterMember this c (.readMethod this))
                        (recur (unchecked-inc-int i))))
                    (when (.isRecord c)
                      (for-each [^Symbol$RecordComponent rc (.getRecordComponents c)]
                        (set! (.-accessor rc) (.lookupMethod this c (.-name rc) (List/nil)))))
                    (set! typevars (.leave typevars)))))))))))

  (method ^:private lookupMethod ^Symbol$MethodSymbol [this ^Symbol$TypeSymbol tsym ^Name name
                                                       ^{:tag (List Type)} argtypes]
    (for-each [^Symbol s (.getSymbolsByName (.members tsym)
                                            name
                                            (lambda Predicate ^boolean [^Symbol s]
                                              (identical? (.-kind s) Kinds$Kind/MTH)))]
      (when (.isSameTypes types (.getParameterTypes (.-type s)) argtypes)
        (return (cast Symbol$MethodSymbol s))))
    nil)

  (method readInnerClasses ^void [this ^Symbol$ClassSymbol c]
    (let [^int n (.nextChar this)]
      (loop [^int i 0]
        (when (< i n)
          (.nextChar this)
          (let [^int outerIdx (.nextChar this)
                ^int nameIdx (.nextChar this)
                outer (cast Symbol$ClassSymbol
                            (.optPoolEntry this
                                           outerIdx
                                           (method-ref
                                             IntFunction
                                             ^Symbol$ClassSymbol [int]
                                             poolReader
                                             PoolReader/.getClass)
                                           nil))
                ^:mutable name (cast Name
                                     (.optPoolEntry
                                       this
                                       nameIdx
                                       (method-ref
                                         IntFunction
                                         ^Name [int]
                                         poolReader
                                         PoolReader/.getName)
                                       (.-empty names)))]
            (when (nil? name) (set! name (.-empty names)))
            (let [flags (.adjustClassFlags this (.nextChar this))]
              (if (some? outer)
                  (do
                    (when (identical? name (.-empty names)) (set! name (.-one names)))
                    (let [member (.enterClass this name outer)]
                      (cond
                        (== (bit-and (.-flags_field member) Flags/FROM_SOURCE) 0)
                          (do
                            (when (== (bit-and flags Flags/STATIC) 0)
                              (.setEnclosingType
                                (cast Type$ClassType (.-type member))
                                (.-type outer))
                              (when (some? (.-erasure_field member))
                                (.setEnclosingType
                                  (cast Type$ClassType (.-erasure_field member))
                                  (.erasure types (.-type outer)))))
                            (if (and (identical? c outer) (identical? (.-owner member) c))
                                (do
                                  (set! (.-flags_field member) flags)
                                  (.enterMember this c member)
                                  (recur (unchecked-inc-int i)))
                                (recur (unchecked-inc-int i))))
                        (not (== (bit-and flags Flags/STATIC)
                                 (bit-and (.-flags_field member) Flags/STATIC)))
                          (do
                            (.warning log
                                      (CompilerProperties$LintWarnings/InconsistentInnerClasses
                                        member
                                        currentClassFile))
                            (recur (unchecked-inc-int i)))
                        :else (recur (unchecked-inc-int i)))))
                  (recur (unchecked-inc-int i)))))))))

  (method ^:private readClassBuffer :throws [IOException] ^void [this ^Symbol$ClassSymbol c]
    (let [magic (.nextInt this)]
      (when-not (== magic ClassFile/JAVA_MAGIC)
        (throw (.badClassFile this "illegal.start.of.class.file" (new Object/1 []))))
      (set! minorVersion (.nextChar this))
      (set! majorVersion (.nextChar this))
      (let [maxMajor (.-major (ClassFile$Version/MAX))
            maxMinor (.-minor (ClassFile$Version/MAX))]
        (set! previewClassFile (== minorVersion ClassFile/PREVIEW_MINOR_VERSION))
        (when (or (> majorVersion maxMajor)
                  (< (unchecked-add-int (unchecked-multiply-int majorVersion 1000) minorVersion)
                     (unchecked-add-int
                       (unchecked-multiply-int (.-major (ClassFile$Version/MIN)) 1000)
                       (.-minor (ClassFile$Version/MIN)))))
          (if (and (== majorVersion (unchecked-add-int maxMajor 1)) (not previewClassFile))
              (.warning log
                        (CompilerProperties$Warnings/BigMajorVersion
                          currentClassFile
                          majorVersion
                          maxMajor))
              (throw (.badClassFile this
                                    "wrong.version"
                                    (new Object/1
                                         [(Integer/toString majorVersion)
                                          (Integer/toString minorVersion)
                                          (Integer/toString maxMajor)
                                          (Integer/toString maxMinor)])))))
        (set! utf8validation
              (if (< majorVersion (.-major ClassFile$Version/V48))
                  Convert$Validation/PREJDK14
                  Convert$Validation/STRICT))
        (when previewClassFile
          (if (not (.isEnabled preview))
              (.error log (.disabledError preview currentClassFile majorVersion))
              (.warnPreview preview (.-classfile c) majorVersion)))
        (set! poolReader (PoolReader. this names syms))
        (set! bp (.readPool poolReader buf bp))
        (when (< (alength signatureBuffer) bp)
          (let [ns (bit-shift-left-int (Integer/highestOneBit bp) 1)]
            (set! signatureBuffer (new byte/1 ns))))
        (.readClass this c))))

  (method ^:public readClassFile ^void [this ^Symbol$ClassSymbol c]
    (set! currentOwner c)
    (set! currentClassFile (.-classfile c))
    (.clear warnedAttrs)
    (set! filling true)
    (set! target nil)
    (set! repeatable nil)
    (try
      (set! bp 0)
      (.reset buf)
      (with-resources [input (.openInputStream (.-classfile c))] (.appendStream buf input))
      (.readClassBuffer this c)
      (if (and (not (.isEmpty missingTypeVariables)) (not (.isEmpty foundTypeVariables)))
          (let [^{:tag (List Type)} missing missingTypeVariables
                ^{:tag (List Type)} found foundTypeVariables]
            (set! missingTypeVariables (List/nil))
            (set! foundTypeVariables (List/nil))
            (set! interimUses (List/nil))
            (set! interimProvides (List/nil))
            (set! filling false)
            (let [ct (cast Type$ClassType (.-type currentOwner))]
              (set! (.-supertype_field ct) (.subst types (.-supertype_field ct) missing found))
              (set! (.-interfaces_field ct) (.subst types (.-interfaces_field ct) missing found))
              (set! (.-typarams_field ct) (.substBounds types (.-typarams_field ct) missing found))
              (loop [^{:tag (List Type)} types (.-typarams_field ct)]
                (when (.nonEmpty types)
                  (set! (.-type (.-tsym (cast Type (.-head types)))) (cast Type (.-head types)))
                  (recur (.-tail types))))))
          (when-not (= (.isEmpty missingTypeVariables) (.isEmpty foundTypeVariables))
            (let [name (.-name (.-tsym (cast Type (.-head missingTypeVariables))))]
              (throw (.badClassFile this "undecl.type.var" (new Object/1 [name]))))))
      (if (not (== (bit-and (.-flags_field c) Flags/ANNOTATION) 0))
          (.setAnnotationTypeMetadata c
                                      (Annotate$AnnotationTypeMetadata.
                                        c
                                        (CompleterDeproxy. c target repeatable)))
          (.setAnnotationTypeMetadata c (Annotate$AnnotationTypeMetadata/notAnAnnotationType)))
      (when (identical? c (.-module_info currentModule))
        (if (or (.nonEmpty interimUses) (.nonEmpty interimProvides))
            (do
              (Assert/check (.isCompleted currentModule))
              (set! (.-usesProvidesCompleter currentModule)
                    (UsesProvidesCompleter. currentModule interimUses interimProvides)))
            (do
              (set! (.-uses currentModule) (List/nil))
              (set! (.-provides currentModule) (List/nil)))))
      (catch [IOException ClosedFileSystemException] ex
        (throw (.badClassFile this "unable.to.access.file" (new Object/1 [(.toString ex)]))))
      (catch ArrayIndexOutOfBoundsException ex
        (throw (.badClassFile this "bad.class.file" (new Object/1 [(.-flatname c)]))))
      (finally
        (set! interimUses (List/nil))
        (set! interimProvides (List/nil))
        (set! missingTypeVariables (List/nil))
        (set! foundTypeVariables (List/nil))
        (set! filling false))))

  (field ^:public ^boolean filling false)

  (method adjustFieldFlags ^long [this ^long flags] flags)

  (method adjustMethodFlags ^long [this ^:mutable ^long flags]
    (when-not (== (bit-and flags Flags/ACC_BRIDGE) 0)
      (set! flags (bit-and flags (bit-not-int Flags/ACC_BRIDGE)))
      (set! flags (bit-or flags Flags/BRIDGE)))
    (when-not (== (bit-and flags Flags/ACC_VARARGS) 0)
      (set! flags (bit-and flags (bit-not-int Flags/ACC_VARARGS)))
      (set! flags (bit-or flags Flags/VARARGS)))
    flags)

  (method adjustClassFlags ^long [this ^:mutable ^long flags]
    (when-not (== (bit-and flags Flags/ACC_MODULE) 0)
      (set! flags (bit-and flags (bit-not-int Flags/ACC_MODULE)))
      (set! flags (bit-or flags Flags/MODULE)))
    (bit-and flags (bit-not-int Flags/ACC_SUPER)))

  (defclass ^:private ^:static SourceFileObject
    :implements [JavaFileObject]

    (field ^:private ^:final ^Name name)

    (constructor ^:public [this ^Name name] (set! (.-name this) name))

    (method ^:public toUri ^URI [this]
      (try
        (URI. nil (.toString name) nil)
        (catch URISyntaxException e
          (throw (PathFileObject$CannotCreateUriError. (.toString name) e)))))

    (method ^:public getName ^String [this] (.toString name))

    (method ^:public getKind ^JavaFileObject$Kind [this]
      (BaseFileManager/getKind (.getName this)))

    (method ^:public openInputStream ^InputStream [this]
      (throw (UnsupportedOperationException.)))

    (method ^:public openOutputStream ^OutputStream [this]
      (throw (UnsupportedOperationException.)))

    (method ^:public getCharContent ^CharBuffer [this ^boolean ignoreEncodingErrors]
      (throw (UnsupportedOperationException.)))

    (method ^:public openReader ^Reader [this ^boolean ignoreEncodingErrors]
      (throw (UnsupportedOperationException.)))

    (method ^:public openWriter ^Writer [this]
      (throw (UnsupportedOperationException.)))

    (method ^:public getLastModified ^long [this]
      (throw (UnsupportedOperationException.)))

    (method ^:public delete ^boolean [this]
      (throw (UnsupportedOperationException.)))

    (method ^:public isNameCompatible ^boolean [this ^String simpleName ^JavaFileObject$Kind kind]
      true)

    (method ^:public getNestingKind ^NestingKind [this] nil)

    (method ^:public getAccessLevel ^Modifier [this] nil)

    (method ^:public equals ^boolean [this other]
      (if (identical? this other)
          true
          (if-instance [^SourceFileObject sourceFileObject other]
            (.equals name (.-name sourceFileObject))
            false)))

    (method ^:public hashCode ^int [this] (.hashCode name)))

  (defclass ^:private CompleterDeproxy
    :implements [Annotate$AnnotationTypeCompleter]

    (field ^Symbol$ClassSymbol proxyOn)

    (field ^CompoundAnnotationProxy target)

    (field ^CompoundAnnotationProxy repeatable)

    (constructor ^:public [this ^Symbol$ClassSymbol c ^CompoundAnnotationProxy target
                           ^CompoundAnnotationProxy repeatable]
      (set! (.-proxyOn this) c)
      (set! (.-target this) target)
      (set! (.-repeatable this) repeatable))

    (method ^:public complete ^void [this ^Symbol$ClassSymbol sym]
      (Assert/check (identical? proxyOn sym))
      (let [^:mutable ^Attribute$Compound theTarget nil
            ^:mutable ^Attribute$Compound theRepeatable nil
            ^:mutable ^AnnotationDeproxy deproxy nil]
        (try
          (when (some? target)
            (set! deproxy (AnnotationDeproxy. proxyOn))
            (set! theTarget (.deproxyCompound deproxy target)))
          (when (some? repeatable)
            (set! deproxy (AnnotationDeproxy. proxyOn))
            (set! theRepeatable (.deproxyCompound deproxy repeatable)))
          (catch Exception e
            (throw (Symbol$CompletionFailure. sym
                                              (lambda Supplier ^JCDiagnostic []
                                                (.fragment
                                                  (.-diagFactory ClassReader/this)
                                                  (CompilerProperties$Fragments/ExceptionMessage
                                                    (.getMessage e))))
                                              dcfh))))
        (.setTarget (.getAnnotationTypeMetadata sym) theTarget)
        (.setRepeatable (.getAnnotationTypeMetadata sym) theRepeatable))))

  (defclass ^:private ProxyType
    :extends Type

    (field ^:private ^:final ^Name name)

    (constructor ^:public [this ^int index]
      (super. (.-noSymbol syms) (List/nil))
      (set! (.-name this) (.getName poolReader index)))

    (method ^:public getTag ^TypeTag [this] TypeTag/NONE)

    (method ^:public resolve ^Type [this]
      (cast Type
            (.map name
                  (method-ref Name$NameMapper
                              ^Type [byte/1 int int]
                              ClassReader/this
                              ClassReader/.sigToType))))

    (method ^:public toString ^String [this] "<ProxyType>"))

  (defclass ^:private ^:static ^:final InterimUsesDirective
    (field ^:public ^:final ^Name service)

    (constructor ^:public [this ^Name service]
      (set! (.-service this) service)))

  (defclass ^:private ^:static ^:final InterimProvidesDirective
    (field ^:public ^:final ^Name service)

    (field ^:public ^:final ^{:tag (List Name)} impls)

    (constructor ^:public [this ^Name service ^{:tag (List Name)} impls]
      (set! (.-service this) service)
      (set! (.-impls this) impls)))

  (defclass ^:private ^:final UsesProvidesCompleter
    :implements [Symbol$Completer]

    (field ^:private ^:final ^Symbol$ModuleSymbol currentModule)

    (field ^:private ^:final ^{:tag (List InterimUsesDirective)} interimUsesCopy)

    (field ^:private ^:final ^{:tag (List InterimProvidesDirective)} interimProvidesCopy)

    (constructor ^:public [this ^Symbol$ModuleSymbol currentModule
                           ^{:tag (List InterimUsesDirective)} interimUsesCopy
                           ^{:tag (List InterimProvidesDirective)} interimProvidesCopy]
      (set! (.-currentModule this) currentModule)
      (set! (.-interimUsesCopy this) interimUsesCopy)
      (set! (.-interimProvidesCopy this) interimProvidesCopy))

    (method ^:public complete :throws [Symbol$CompletionFailure] ^void [this ^Symbol sym]
      (let [^{:tag (ListBuffer Directive)} directives (ListBuffer.)]
        (.addAll directives (.-directives currentModule))
        (let [^{:tag (ListBuffer Directive$UsesDirective)} uses (ListBuffer.)]
          (for-each [^InterimUsesDirective interim interimUsesCopy]
            (let [d (Directive$UsesDirective. (.enterClass syms currentModule (.-service interim)))]
              (.add uses d)
              (.add directives d)))
          (set! (.-uses currentModule) (.toList uses))
          (let [^{:tag (ListBuffer Directive$ProvidesDirective)} provides (ListBuffer.)]
            (for-each [^InterimProvidesDirective interim interimProvidesCopy]
              (let [^{:tag (ListBuffer Symbol$ClassSymbol)} impls (ListBuffer.)]
                (for-each [^Name impl (.-impls interim)]
                  (.append impls (.enterClass syms currentModule impl)))
                (let [d (Directive$ProvidesDirective.
                          (.enterClass syms currentModule (.-service interim))
                          (.toList impls))]
                  (.add provides d)
                  (.add directives d))))
            (set! (.-provides currentModule) (.toList provides))
            (set! (.-directives currentModule) (.toList directives))))))))

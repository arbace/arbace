        (loop [^int i 0]
          (when (<= i lastLocal)
            (.print System/err (java-str "  " i ": "))
            (if (.isMember defined i)
                (let [var (aget lvar i)]
                  (cond
                    (nil? var) (do (.println System/err "(none)") (recur (unchecked-inc-int i)))
                    (nil? (.-sym var))
                      (do (.println System/err "UNKNOWN!") (recur (unchecked-inc-int i)))
                    :else

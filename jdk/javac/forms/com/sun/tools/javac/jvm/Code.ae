  (defclass ^:static LocalVar
    (field ^:final ^Symbol$VarSymbol sym)

    (field ^:final ^char reg)

    (defclass Range
      (field ^char start_pc Character/MAX_VALUE)

      (field ^char length Character/MAX_VALUE)

      (constructor [this])

      (constructor [this ^char start] (set! (.-start_pc this) start))

      (constructor [this ^char start ^char length]
        (set! (.-start_pc this) start)
        (set! (.-length this) length))

      (method closed ^boolean [this]
        (and (not (== start_pc Character/MAX_VALUE)) (not (== length Character/MAX_VALUE))))

      (method ^:public toString ^String [this]
        (let [^int currentStartPC start_pc
              ^int currentLength length]
          (java-str "startpc = " currentStartPC " length " currentLength))))

    (field ^{:tag (java.util.List Range)} aliveRanges (ArrayList.))

    (constructor [this ^Symbol$VarSymbol v]
      (set! (.-sym this) v)
      (set! (.-reg this) (unchecked-char (.-adr v))))

    (method ^:public dup ^LocalVar [this] (LocalVar. sym))

    (method firstRange ^Range [this]
      (when-not (.isEmpty aliveRanges) (cast Range (.get aliveRanges 0))))

    (method lastRange ^Range [this]
      (when-not (.isEmpty aliveRanges)
        (cast Range (.get aliveRanges (unchecked-subtract-int (.size aliveRanges) 1)))))

    (method removeLastRange ^void [this]
      (let [lastRange (.lastRange this)] (when (some? lastRange) (.remove aliveRanges lastRange))))

    (method ^:public toString ^String [this]
      (if (nil? aliveRanges)
          "empty local var"
          (let [sb (.append (.append (.append (.append (StringBuilder.) sym) " in register ")
                                     (int reg))
                            " \n")]
            (for-each [^Range r aliveRanges]
              (.append (.append (.append (.append
                                           (.append sb " starts at pc=")
                                           (Integer/toString (int (.-start_pc r))))
                                         " length=")
                                (Integer/toString (int (.-length r))))
                       "\n"))
            (.toString sb))))

    (method ^:public openRange ^void [this ^char start]
      (when-not (.hasOpenRange this) (.add aliveRanges (Range. start))))

    (method ^:public closeRange ^void [this ^char length]
      (if (and (.isLastRangeInitialized this) (> length 0))
          (let [range (.lastRange this)]
            (when (some? range)
              (when (== (.-length range) Character/MAX_VALUE) (set! (.-length range) length))))
          (.removeLastRange this)))

    (method ^:public hasOpenRange ^boolean [this]
      (if (.isEmpty aliveRanges) false (== (.-length (.lastRange this)) Character/MAX_VALUE)))

    (method ^:public isLastRangeInitialized ^boolean [this]
      (if (.isEmpty aliveRanges)
          false
          (not (== (.-start_pc (.lastRange this)) Character/MAX_VALUE))))

    (method ^:public getWidestRange ^Range [this]
      (if (.isEmpty aliveRanges)
          (Range.)
          (let [firstRange (.firstRange this)
                lastRange (.lastRange this)
                length (unchecked-char
                         (unchecked-add-int (.-length lastRange)
                                            (unchecked-subtract-int
                                              (.-start_pc lastRange)
                                              (.-start_pc firstRange))))]
            (Range. (.-start_pc firstRange) length)))))

  (field ^LocalVar/1 lvar)

  (method ^:private addLocalVar ^void [this ^Symbol$VarSymbol v]
    (let [adr (.-adr v)]
      (set! lvar (cast LocalVar/1 (ArrayUtils/ensureCapacity lvar (unchecked-add-int adr 1))))
      (Assert/checkNull (aget lvar adr))
      (when (some? pendingJumps) (.resolvePending this))
      (aset lvar adr (LocalVar. v))
      (.excl (.-defined state) adr)))

  (method adjustAliveRanges ^void [this ^int oldCP ^int delta]
    (for-each [^LocalVar localVar lvar]
      (when (some? localVar)
        (for-each [^Code$LocalVar$Range range (.-aliveRanges localVar)]
          (when (and (.closed range)
                     (>= (unchecked-add-int (.-start_pc range) (.-length range)) oldCP))
            (set! (.-length range)
                  (unchecked-char (unchecked-add-int (.-length range) (unchecked-char delta)))))))))

  (method ^:public getLVTSize ^int [this]
    (let [^:mutable result varBufferSize]
      (loop [^int i 0]
        (when (< i varBufferSize)
          (let [var (aget varBuffer i)]
            (set! result
                  (unchecked-add-int result (unchecked-subtract-int (.size (.-aliveRanges var)) 1)))
            (recur (unchecked-inc-int i)))))
      result))

  (method ^:public setDefined ^void [this ^Bits newDefined]
    (when (and alive (not (identical? newDefined (.-defined state))))
      (let [diff (.xorSet (Bits. (.-defined state)) newDefined)]
        (loop [^int adr (.nextBit diff 0)]
          (when (>= adr 0)
            (cond
              (>= adr nextreg)
                (do (.excl (.-defined state) adr) (recur (.nextBit diff (unchecked-add-int adr 1))))
              (.isMember (.-defined state) adr)
                (do (.setUndefined this adr) (recur (.nextBit diff (unchecked-add-int adr 1))))
              :else (do (.setDefined this adr) (recur (.nextBit diff (unchecked-add-int adr 1))))))))))

  (method ^:public setDefined ^void [this ^int adr]
    (let [v (aget lvar adr)]
      (if (nil? v)
          (.excl (.-defined state) adr)
          (do
            (.incl (.-defined state) adr)
            (when (< cp Character/MAX_VALUE) (.openRange v (unchecked-char cp)))))))

  (method ^:public setUndefined ^void [this ^int adr]
    (.excl (.-defined state) adr)
    (when (and (and (< adr (alength lvar)) (some? (aget lvar adr)))
               (.isLastRangeInitialized (aget lvar adr)))
      (let [v (aget lvar adr)
            length (unchecked-char
                     (unchecked-subtract-int (.curCP this) (.-start_pc (.lastRange v))))]
        (if (< length Character/MAX_VALUE)
            (do
              (aset lvar adr (.dup v))
              (.closeRange v length)
              (.putVar this v)
              (.fillLocalVarPosition this v))
            (.removeLastRange v)))))

  (method ^:private endScope ^void [this ^int adr]
    (let [v (aget lvar adr)]
      (when (some? v)
        (when (.isLastRangeInitialized v)
          (let [length (unchecked-char
                         (unchecked-subtract-int (.curCP this) (.-start_pc (.lastRange v))))]
            (when (< length Character/MAX_VALUE)
              (.closeRange v length)
              (.putVar this v)
              (.fillLocalVarPosition this v))))
        (aset lvar adr nil))
      (.excl (.-defined state) adr)))

  (method ^:private fillLocalVarPosition ^void [this ^LocalVar lv]
    (when-not (or (or (or (nil? lv) (nil? (.-sym lv))) (.isExceptionParameter (.-sym lv)))
                  (not (.hasTypeAnnotations (.-sym lv))))
      (let [validRanges (cast Code$LocalVar$Range/1
                              (.toArray (.filter
                                          (.stream (.-aliveRanges lv))
                                          (lambda Predicate ^boolean [^Code$LocalVar$Range r]
                                            (and (.closed r) (> (.-length r) 0))))
                                        (lambda IntFunction ^Code$LocalVar$Range/1 [^int s]
                                          (new Code$LocalVar$Range/1 s))))]
        (when-not (== (alength validRanges) 0)
          (let [lvarOffset (.toArray (.mapToInt (Arrays/stream validRanges)
                                                (lambda ToIntFunction ^int [^Code$LocalVar$Range r]
                                                  (.-start_pc r))))
                lvarLength (.toArray (.mapToInt (Arrays/stream validRanges)
                                                (lambda ToIntFunction ^int [^Code$LocalVar$Range r]
                                                  (.-length r))))
                lvarIndex (.toArray (.mapToInt (Arrays/stream validRanges)
                                               (lambda ToIntFunction ^int [^Code$LocalVar$Range r]
                                                 (.-reg lv))))]
            (for-each [^Attribute$TypeCompound ta (.getRawTypeAttributes (.-sym lv))]
              (let [p (.-position ta)]
                (set! (.-lvarOffset p) (.appendArray this (.-lvarOffset p) lvarOffset))
                (set! (.-lvarLength p) (.appendArray this (.-lvarLength p) lvarLength))
                (set! (.-lvarIndex p) (.appendArray this (.-lvarIndex p) lvarIndex))
                (set! (.-isValidOffset p) true))))))))

  (method ^:private appendArray ^int/1 [this ^int/1 source ^int/1 append]
    (if (or (nil? source) (== (alength source) 0))
        append
        (let [result (new int/1 (unchecked-add-int (alength source) (alength append)))]
          (System/arraycopy source 0 result 0 (alength source))
          (System/arraycopy append 0 result (alength source) (alength append))
          result)))

  (method ^:public fillExceptionParameterPositions ^void [this]
    (loop [^int i 0]
      (when (< i varBufferSize)
        (let [lv (aget varBuffer i)]
          (if (or (or (or (nil? lv) (nil? (.-sym lv))) (not (.hasTypeAnnotations (.-sym lv))))
                  (not (.isExceptionParameter (.-sym lv))))
              (recur (unchecked-inc-int i))
              (do
                (for-each [^Attribute$TypeCompound ta (.getRawTypeAttributes (.-sym lv))]
                  (let [p (.-position ta)]
                    (when (.hasCatchType p)
                      (let [idx (.findExceptionIndex this p)]
                        (when (== idx -1)
                          (Assert/error (java-str
                                          "Could not find exception index for type annotation "
                                          ta
                                          " on exception parameter")))
                        (.setExceptionIndex p idx)))))
                (recur (unchecked-inc-int i))))))))

  (method ^:private findExceptionIndex ^int [this ^TypeAnnotationPosition p]
    (let [catchType (.getCatchType p)
          startPos (.getStartPos p)
          len (.length catchInfo)
          ^:mutable ^{:tag (List char/1)} iter (.toList catchInfo)]
      (loop [^int i 0]
        (when (< i len)
          (let [catchEntry (cast char/1 (.-head iter))]
            (set! iter (.-tail iter))
            (let [^int ct (aget catchEntry 3)
                  ^int sp (aget catchEntry 0)]
              (if (and (== catchType ct) (== sp startPos)) (return i) (recur (unchecked-inc-int i)))))))
      -1))

  (method putVar ^void [this ^LocalVar var]
    (let [keepLocalVariables (or varDebugInfo
                                 (and (.isExceptionParameter (.-sym var))
                                      (.hasTypeAnnotations (.-sym var))))]
      (when-not (not keepLocalVariables)
        (let [ignoredSyntheticVar (and (not (== (bit-and (.flags (.-sym var)) Flags/SYNTHETIC) 0))
                                       (or (== (bit-and
                                                 (.flags (.-owner (.-sym var)))
                                                 Flags/LAMBDA_METHOD)
                                               0)
                                           (== (bit-and (.flags (.-sym var)) Flags/PARAMETER) 0)))]
          (when-not ignoredSyntheticVar
            (when-not (identical? (.-name (.-sym var))
                                  (.-empty (.-names (.-table (.-name (.-sym var))))))
              (if (nil? varBuffer)
                  (set! varBuffer (new LocalVar/1 20))
                  (set! varBuffer
                        (cast LocalVar/1 (ArrayUtils/ensureCapacity varBuffer varBufferSize))))
              (aset varBuffer
                    (let [old-12 varBufferSize]
                      (set! varBufferSize (unchecked-inc-int varBufferSize))
                      old-12)
                    var)))))))


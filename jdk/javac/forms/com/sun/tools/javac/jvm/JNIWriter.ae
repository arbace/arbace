        (let [ct (.getComponentType (cast Type$ArrayType t))]
          (switch (.getKind ct)
            BOOLEAN (return "jbooleanArray")
            BYTE (return "jbyteArray")
            CHAR (return "jcharArray")
            SHORT (return "jshortArray")
            INT (return "jintArray")
            LONG (return "jlongArray")
            FLOAT (return "jfloatArray")
            DOUBLE (return "jdoubleArray")
            (ARRAY DECLARED) (return "jobjectArray")
            (throw (Error. (.toString ct)))))
      VOID (return "void")
      BOOLEAN (return "jboolean")
      BYTE (return "jbyte")
      CHAR (return "jchar")
      SHORT (return "jshort")
      INT (return "jint")
      LONG (return "jlong")
      FLOAT (return "jfloat")
      DOUBLE (return "jdouble")
      DECLARED

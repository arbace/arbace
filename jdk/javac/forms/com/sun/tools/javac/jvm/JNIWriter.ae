          (identical? (.-type (.-tsym t)) (.-stringType syms)) (return "jstring")
          (.isAssignable types t (.-throwableType syms)) (return "jthrowable")
          (.isAssignable types t (.-classType syms)) (return "jclass")
          :else (return "jobject")))
    (Assert/check false "jni unknown type")
    nil)


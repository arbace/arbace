              fname (JNIWriter/encode (.getSimpleName f) EncoderType/FIELDSTUB)]
          (.println out (java-str cname "_" fname))
          (.print out (java-str "#define " cname "_"))
          (.println out (java-str fname " " valueStr))))))

  (method ^:protected writeMethods :throws [IOException JNIWriter$TypeSignature$SignatureException] ^void [this
                                                                                                           ^PrintWriter out

        (let [typeSig (TypeSignature. types)
              sig (.getParameterSignature typeSig (.-type msym) true)]
          (.append (.append result "__") (JNIWriter/encode sig EncoderType/JNI))))
      (.toString result)))

  (defclass ^:static ^:enum EncoderType
    (constants CLASS FIELDSTUB FIELD JNI SIGNATURE))

  (method ^:static encode ^String [^CharSequence name ^EncoderType mtype]
    (let [result (StringBuilder. 100)
          length (.length name)]
      (loop [^int i 0]
        (when (< i length)
          (let [ch (.charAt name i)]
            (if (JNIWriter/isalnum ch)
                (do (.append result ch) (recur (unchecked-inc-int i)))
                (switch mtype
                  CLASS
                    (do
                      (switch ch
                        (\. \_) (.append result "_")
                        \$ (.append result "__")
                        (.append result (JNIWriter/encodeChar ch)))
                      (recur (unchecked-inc-int i)))
                  JNI
                    (do
                      (switch ch
                        (\/ \.) (.append result "_")
                        \_ (.append result "_1")
                        \; (.append result "_2")
                        \[ (.append result "_3")
                        (.append result (JNIWriter/encodeChar ch)))
                      (recur (unchecked-inc-int i)))
                  SIGNATURE
                    (do
                      (.append result
                               (if (JNIWriter/isprint ch)
                                   (Character/valueOf ch)
                                   ^Object (JNIWriter/encodeChar ch)))
                      (recur (unchecked-inc-int i)))
                  FIELDSTUB
                    (do
                      (.append result
                               (if (== ch \_)
                                   (Character/valueOf ch)
                                   ^Object (JNIWriter/encodeChar ch)))
                      (recur (unchecked-inc-int i)))
                  (do (.append result (JNIWriter/encodeChar ch)) (recur (unchecked-inc-int i))))))))
      (.toString result)))

  (method ^:static encodeChar ^String [^char ch]
    (let [s (Integer/toHexString ch)
          nzeros (unchecked-subtract-int 5 (.length s))
          result (new char/1 6)]
      (aset result 0 \_)
      (loop [^int i 1] (when (<= i nzeros) (aset result i \0) (recur (unchecked-inc-int i))))
      (loop [^int i (unchecked-add-int nzeros 1)
             ^int j 0]
        (when (< i 6)
          (aset result i (.charAt s j))
          (recur (unchecked-inc-int i) (unchecked-inc-int j))))
      (String. result)))

  (method ^:private ^:static isalnum ^boolean [^char ch]
    (and (<= ch 0x7f)
         (or (or (and (>= ch \A) (<= ch \Z)) (and (>= ch \a) (<= ch \z)))
             (and (>= ch \0) (<= ch \9)))))

  (method ^:private ^:static isprint ^boolean [^char ch]
    (and (>= ch 32) (<= ch 126)))


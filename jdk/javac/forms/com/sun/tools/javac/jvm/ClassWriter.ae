          (when dumpInnerClassModifiers
            (let [pw (.getWriter log Log$WriterKind/ERROR)]
              (.println pw (java-str "INNERCLASS  " (.-name inner)))
              (.println pw (java-str "---" (ClassWriter/flagNames flags)))))
          (.appendChar databuf (.putClass poolWriter inner))
          (.appendChar databuf
                       (if (and (identical? (.-kind (.-owner inner)) Kinds$Kind/TYP)
                                (not (.isEmpty (.-name inner))))
                           (.putClass poolWriter (cast Symbol$ClassSymbol (.-owner inner)))
                           0))
          (.appendChar databuf
                       (if (not (.isEmpty (.-name inner))) (.putName poolWriter (.-name inner)) 0))
          (.appendChar databuf flags)))
      (.endAttr this alenIdx)))

  (method writeRecordAttribute ^int [this ^Symbol$ClassSymbol csym]
    (let [alenIdx (.writeAttr this (.-Record names))
          ^Scope s (.members csym)]
      (.appendChar databuf (.size (.getRecordComponents csym)))
      (for-each [^Symbol$VarSymbol v (.getRecordComponents csym)]
        (.appendChar databuf (.putName poolWriter (.-name v)))
        (.appendChar databuf (.putDescriptor poolWriter v))
        (let [acountIdx (.beginAttrs this)
              ^:mutable ^int acount 0]
          (set! acount (unchecked-add-int acount (.writeMemberAttrs this v true)))
          (.endAttrs this acountIdx acount)))
      (.endAttr this alenIdx)
      1))

  (method writeNestMembersIfNeeded ^int [this ^Symbol$ClassSymbol csym]
    (let [^{:tag (ListBuffer Symbol$ClassSymbol)} nested (ListBuffer.)]
      (.listNested this csym nested)
      (let [^{:tag (Set Symbol$ClassSymbol)} nestedUnique (LinkedHashSet. nested)]
        (if (and (identical? (.-kind (.-owner csym)) Kinds$Kind/PCK) (not (.isEmpty nestedUnique)))
            (let [alenIdx (.writeAttr this (.-NestMembers names))]
              (.appendChar databuf (.size nestedUnique))
              (for-each [^Symbol$ClassSymbol s nestedUnique]
                (.appendChar databuf (.putClass poolWriter s)))
              (.endAttr this alenIdx)
              1)
            0))))

  (method writeNestHostIfNeeded ^int [this ^Symbol$ClassSymbol csym]
    (if (not (identical? (.-kind (.-owner csym)) Kinds$Kind/PCK))
        (let [alenIdx (.writeAttr this (.-NestHost names))]
          (.appendChar databuf (.putClass poolWriter (.outermostClass csym)))
          (.endAttr this alenIdx)
          1)
        0))

  (method ^:private listNested ^void [this ^Symbol sym ^{:tag (ListBuffer Symbol$ClassSymbol)} seen]
    (when-not (not (identical? (.-kind sym) Kinds$Kind/TYP))
      (let [csym (cast Symbol$ClassSymbol sym)]
        (when-not (identical? (.-kind (.-owner csym)) Kinds$Kind/PCK) (.add seen csym))
        (when (some? (.members csym))
          (for-each [^Symbol s (.getSymbols (.members sym))] (.listNested this s seen)))
        (when (some? (.-trans_local csym))
          (for-each [^Symbol s (.-trans_local csym)] (.listNested this s seen))))))

  (method writePermittedSubclassesIfNeeded ^int [this ^Symbol$ClassSymbol csym]
    (if (.nonEmpty (.getPermittedSubclasses csym))
        (let [alenIdx (.writeAttr this (.-PermittedSubclasses names))]
          (.appendChar databuf (.size (.getPermittedSubclasses csym)))
          (for-each [^Type t (.getPermittedSubclasses csym)]
            (.appendChar databuf (.putClass poolWriter (cast Symbol$ClassSymbol (.-tsym t)))))
          (.endAttr this alenIdx)
          1)
        0))

  (method writeBootstrapMethods ^void [this]
    (let [alenIdx (.writeAttr this (.-BootstrapMethods names))
          ^:mutable ^int lastBootstrapMethods 0]
      (loop []
        (set! lastBootstrapMethods (.size (.-bootstrapMethods poolWriter)))
        (for-each [^PoolConstant$Dynamic$BsmKey bsmKey (java.util.List/copyOf
                                                         (.keySet (.-bootstrapMethods poolWriter)))]
          (for-each [^PoolConstant$LoadableConstant arg (.-staticArgs bsmKey)]
            (.putConstant poolWriter arg)))
        (when (< lastBootstrapMethods (.size (.-bootstrapMethods poolWriter))) (recur)))
      (.appendChar databuf (.size (.-bootstrapMethods poolWriter)))
      (for-each [^PoolConstant$Dynamic$BsmKey bsmKey (.keySet (.-bootstrapMethods poolWriter))]
        (.appendChar databuf (.putConstant poolWriter (.-bsm bsmKey)))
        (let [uniqueArgs (.-staticArgs bsmKey)]
          (.appendChar databuf (alength uniqueArgs))
          (for-each [^PoolConstant$LoadableConstant arg uniqueArgs]
            (.appendChar databuf (.putConstant poolWriter arg)))))
      (.endAttr this alenIdx)))

  (method writeField ^void [this ^Symbol$VarSymbol v]
    (let [flags (.adjustFlags this (.flags v))]
      (.appendChar databuf flags)
      (when dumpFieldModifiers
        (let [pw (.getWriter log Log$WriterKind/ERROR)]
          (.println pw (java-str "FIELD  " (.-name v)))
          (.println pw (java-str "---" (ClassWriter/flagNames (.flags v))))))
      (.appendChar databuf (.putName poolWriter (.-name v)))
      (.appendChar databuf (.putDescriptor poolWriter v))
      (let [acountIdx (.beginAttrs this)
            ^:mutable ^int acount 0]
        (when (some? (.getConstValue v))
          (let [alenIdx (.writeAttr this (.-ConstantValue names))]
            (.appendChar databuf (.putConstant poolWriter (.getConstValue v)))
            (.endAttr this alenIdx)
            (set! acount (unchecked-inc-int acount))))
        (set! acount (unchecked-add-int acount (.writeMemberAttrs this v false)))
        (set! acount (unchecked-add-int acount (.writeExtraAttributes this v)))
        (.endAttrs this acountIdx acount))))

  (method writeMethod ^void [this ^Symbol$MethodSymbol m]
    (let [flags (.adjustFlags this (.flags m))]
      (.appendChar databuf flags)
      (when dumpMethodModifiers
        (let [pw (.getWriter log Log$WriterKind/ERROR)]
          (.println pw (java-str "METHOD  " (.-name m)))
          (.println pw (java-str "---" (ClassWriter/flagNames (.flags m))))))
      (.appendChar databuf (.putName poolWriter (.-name m)))
      (.appendChar databuf (.putDescriptor poolWriter m))
      (let [acountIdx (.beginAttrs this)
            ^:mutable ^int acount 0]
        (when (some? (.-code m))
          (let [alenIdx (.writeAttr this (.-Code names))]
            (.writeCode this (.-code m))
            (set! (.-code m) nil)
            (.endAttr this alenIdx)
            (set! acount (unchecked-inc-int acount))))
        (let [^{:tag (List Type)} thrown (.getThrownTypes (.erasure m types))]
          (when (.nonEmpty thrown)
            (let [alenIdx (.writeAttr this (.-Exceptions names))]
              (.appendChar databuf (.length thrown))
              (loop [^{:tag (List Type)} l thrown]
                (when (.nonEmpty l)
                  (.appendChar databuf (.putClass poolWriter (cast Type (.-head l))))
                  (recur (.-tail l))))
              (.endAttr this alenIdx)
              (set! acount (unchecked-inc-int acount))))
          (when (some? (.-defaultValue m))
            (let [alenIdx (.writeAttr this (.-AnnotationDefault names))]
              (.accept (.-defaultValue m) awriter)
              (.endAttr this alenIdx)
              (set! acount (unchecked-inc-int acount))))
          (when (.hasMethodParameters target)
            (when-not (.isLambdaMethod m)
              (let [requiresParamNames (.requiresParamNames this m)]
                (when (or requiresParamNames (.requiresParamFlags this m))
                  (set! acount
                        (unchecked-add-int acount
                                           (.writeMethodParametersAttr this m requiresParamNames)))))))
          (set! acount (unchecked-add-int acount (.writeMemberAttrs this m false)))
          (when-not (.isLambdaMethod m)
            (set! acount (unchecked-add-int acount (.writeParameterAttrs this (.-params m)))))
          (set! acount (unchecked-add-int acount (.writeExtraAttributes this m)))
          (.endAttrs this acountIdx acount)))))

  (method ^:private requiresParamNames ^boolean [this ^Symbol$MethodSymbol m]
    (cond
      (.isSet options Option/PARAMETERS) true
      (and (.isConstructor m) (not (== (bit-and (.-flags_field m) Flags/RECORD) 0))) true
      :else false))

  (method ^:private requiresParamFlags ^boolean [this ^Symbol$MethodSymbol m]
    (cond
      (not (.isEmpty (.-extraParams m)))
        (.anyMatch (.stream (.-extraParams m))
                   (lambda Predicate ^boolean [^Symbol$VarSymbol p]
                     (not (== (bit-and (.-flags_field p)
                                       (bit-or-int Flags/SYNTHETIC Flags/MANDATED))
                              0))))
      (some? (.-params m))
        (.anyMatch (.stream (.-params m))
                   (lambda Predicate ^boolean [^Symbol$VarSymbol p]
                     (not (== (bit-and (.-flags_field p)
                                       (bit-or-int Flags/SYNTHETIC Flags/MANDATED))
                              0))))
      :else false))

  (method writeCode ^void [this ^Code code]
    (.appendChar databuf (.-max_stack code))
    (.appendChar databuf (.-max_locals code))
    (.appendInt databuf (.-cp code))
    (.appendBytes databuf (.-code code) 0 (.-cp code))
    (.appendChar databuf (.length (.-catchInfo code)))
    (loop [^{:tag (List char/1)} l (.toList (.-catchInfo code))]
      (when (.nonEmpty l)
        (loop [^int i 0]
          (when (< i (alength (cast char/1 (.-head l))))
            (.appendChar databuf (aget (cast char/1 (.-head l)) i))
            (recur (unchecked-inc-int i))))
        (recur (.-tail l))))
    (let [acountIdx (.beginAttrs this)
          ^:mutable ^int acount 0]
      (when (.nonEmpty (.-lineInfo code))
        (let [alenIdx (.writeAttr this (.-LineNumberTable names))]
          (.appendChar databuf (.length (.-lineInfo code)))
          (loop [^{:tag (List char/1)} l (.reverse (.-lineInfo code))]
            (when (.nonEmpty l)
              (loop [^int i 0]
                (when (< i (alength (cast char/1 (.-head l))))
                  (.appendChar databuf (aget (cast char/1 (.-head l)) i))
                  (recur (unchecked-inc-int i))))
              (recur (.-tail l))))
          (.endAttr this alenIdx)
          (set! acount (unchecked-inc-int acount))))
      (when (and genCrt (some? (.-crt code)))
        (let [crt (.-crt code)
              alenIdx (.writeAttr this (.-CharacterRangeTable names))
              crtIdx (.beginAttrs this)
              crtEntries (.writeCRT crt databuf (.-lineMap code) log)]
          (.endAttrs this crtIdx crtEntries)
          (.endAttr this alenIdx)
          (set! acount (unchecked-inc-int acount))))
      (when (and (.-varDebugInfo code) (> (.-varBufferSize code) 0))
        (let [^:mutable ^int nGenericVars 0
              ^:mutable alenIdx (.writeAttr this (.-LocalVariableTable names))]
          (.appendChar databuf (.getLVTSize code))
          (loop [^int i 0]
            (when (< i (.-varBufferSize code))
              (let [var (aget (.-varBuffer code) i)]
                (for-each [^Code$LocalVar$Range r (.-aliveRanges var)]
                  (Assert/check (and (>= (.-start_pc r) 0) (<= (.-start_pc r) (.-cp code))))
                  (.appendChar databuf (.-start_pc r))
                  (Assert/check (and (> (.-length r) 0)
                                     (<= (unchecked-add-int (.-start_pc r) (.-length r))
                                         (.-cp code))))
                  (.appendChar databuf (.-length r))
                  (let [sym (.-sym var)]
                    (.appendChar databuf (.putName poolWriter (.-name sym)))
                    (.appendChar databuf (.putDescriptor poolWriter sym))
                    (.appendChar databuf (.-reg var))
                    (when (.needsLocalVariableTypeEntry this (.-type (.-sym var)))
                      (set! nGenericVars (unchecked-inc-int nGenericVars)))))
                (recur (unchecked-inc-int i)))))
          (.endAttr this alenIdx)
          (set! acount (unchecked-inc-int acount))
          (when (> nGenericVars 0)
            (set! alenIdx (.writeAttr this (.-LocalVariableTypeTable names)))
            (.appendChar databuf nGenericVars)
            (let [^:mutable ^int count 0]
              (loop [^int i 0]
                (when (< i (.-varBufferSize code))
                  (let [var (aget (.-varBuffer code) i)
                        sym (.-sym var)]
                    (if (not (.needsLocalVariableTypeEntry this (.-type sym)))
                        (recur (unchecked-inc-int i))
                        (do
                          (for-each [^Code$LocalVar$Range r (.-aliveRanges var)]
                            (.appendChar databuf (.-start_pc r))
                            (.appendChar databuf (.-length r))
                            (.appendChar databuf (.putName poolWriter (.-name sym)))
                            (.appendChar databuf (.putSignature poolWriter sym))
                            (.appendChar databuf (.-reg var))
                            (set! count (unchecked-inc-int count)))
                          (recur (unchecked-inc-int i)))))))
              (Assert/check (== count nGenericVars))
              (.endAttr this alenIdx)
              (set! acount (unchecked-inc-int acount))))))
      (when (> (.-stackMapBufferSize code) 0)
        (when debugstackmap (.println System/out (java-str "Stack map for " (.-meth code))))
        (let [alenIdx (.writeAttr this (.getAttributeName (.-stackMap code) names))]
          (.writeStackMap this code)
          (.endAttr this alenIdx)
          (set! acount (unchecked-inc-int acount))))
      (set! acount
            (unchecked-add-int acount
                               (.writeTypeAnnotations
                                 this
                                 (.getRawTypeAttributes (.-meth code))
                                 true)))
      (.endAttrs this acountIdx acount)))

  (method ^:private needsLocalVariableTypeEntry ^boolean [this ^Type t]
    (and (not (.isSameType types t (.erasure types t))) (.checkDenotable check t)))

  (method writeStackMap ^void [this ^Code code]
    (let [nframes (.-stackMapBufferSize code)]
      (when debugstackmap (.println System/out (java-str " nframes = " nframes)))
      (.appendChar databuf nframes)
      (switch (.-stackMap code)
        CLDC
          (loop [^int i 0]
            (when (< i nframes)
              (when debugstackmap (.print System/out (java-str "  " i ":")))
              (let [frame (aget (.-stackMapBuffer code) i)]
                (when debugstackmap (.print System/out (java-str " pc=" (.-pc frame))))
                (.appendChar databuf (.-pc frame))
                (let [^:mutable ^int localCount 0]
                  (loop [^int j 0]
                    (when (< j (alength (.-locals frame)))
                      (set! localCount (unchecked-inc-int localCount))
                      (recur (unchecked-add-int j (Code/width (aget (.-locals frame) j))))))
                  (when debugstackmap (.print System/out (java-str " nlocals=" localCount)))
                  (.appendChar databuf localCount)
                  (loop [^int j 0]
                    (when (< j (alength (.-locals frame)))
                      (when debugstackmap (.print System/out (java-str " local[" j "]=")))
                      (.writeStackMapType this (aget (.-locals frame) j))
                      (recur (unchecked-add-int j (Code/width (aget (.-locals frame) j))))))
                  (let [^:mutable ^int stackCount 0]
                    (loop [^int j 0]
                      (when (< j (alength (.-stack frame)))
                        (set! stackCount (unchecked-inc-int stackCount))
                        (recur (unchecked-add-int j (Code/width (aget (.-stack frame) j))))))
                    (when debugstackmap (.print System/out (java-str " nstack=" stackCount)))
                    (.appendChar databuf stackCount)
                    (loop [^int j 0]
                      (when (< j (alength (.-stack frame)))
                        (when debugstackmap (.print System/out (java-str " stack[" j "]=")))
                        (.writeStackMapType this (aget (.-stack frame) j))
                        (recur (unchecked-add-int j (Code/width (aget (.-stack frame) j))))))
                    (if debugstackmap
                        (do (.println System/out) (recur (unchecked-inc-int i)))
                        (recur (unchecked-inc-int i))))))))
        JSR202
          (do
            (Assert/checkNull (.-stackMapBuffer code))
            (loop [^int i 0]
              (when (< i nframes)
                (when debugstackmap (.print System/out (java-str "  " i ":")))
                (let [frame (aget (.-stackMapTableBuffer code) i)]
                  (.write frame this)
                  (if debugstackmap
                      (do (.println System/out) (recur (unchecked-inc-int i)))
                      (recur (unchecked-inc-int i)))))))
        (throw (AssertionError. "Unexpected stackmap format value")))))

  (method writeStackMapType ^void [this ^Type t]
    (if (nil? t)
        (do (when debugstackmap (.print System/out "empty")) (.appendByte databuf 0))
        (switch (.getTag t)
          (BYTE CHAR SHORT INT BOOLEAN)
            (do (when debugstackmap (.print System/out "int")) (.appendByte databuf 1))
          FLOAT (do (when debugstackmap (.print System/out "float")) (.appendByte databuf 2))
          DOUBLE (do (when debugstackmap (.print System/out "double")) (.appendByte databuf 3))
          LONG (do (when debugstackmap (.print System/out "long")) (.appendByte databuf 4))
          BOT (do (when debugstackmap (.print System/out "null")) (.appendByte databuf 5))
          (CLASS ARRAY TYPEVAR)
            (do
              (when debugstackmap
                (.print System/out (java-str "object(" (.-tsym (.erasure types t)) ")")))
              (.appendByte databuf 7)
              (.appendChar databuf (.putClass poolWriter (.erasure types t))))
          UNINITIALIZED_THIS
            (do (when debugstackmap (.print System/out "uninit_this")) (.appendByte databuf 6))
          UNINITIALIZED_OBJECT
            (let [uninitType (cast UninitializedType t)]
              (.appendByte databuf 8)
              (when debugstackmap
                (.print System/out (java-str "uninit_object@" (.-offset uninitType))))
              (.appendChar databuf (.-offset uninitType)))
          (throw (AssertionError.)))))

  (defclass ^:abstract ^:static StackMapTableFrame
    (method ^:abstract getFrameType ^int [this])

    (method write ^void [this ^ClassWriter writer]
      (let [frameType (.getFrameType this)]
        (.appendByte (.-databuf writer) frameType)
        (when (.-debugstackmap writer) (.print System/out (java-str " frame_type=" frameType)))))

    (defclass ^:static SameFrame
      :extends StackMapTableFrame

      (field ^:final ^int offsetDelta)

      (constructor [this ^int offsetDelta]
        (set! (.-offsetDelta this) offsetDelta))

      (method getFrameType ^int [this]
        (if (< offsetDelta SAME_FRAME_SIZE) offsetDelta SAME_FRAME_EXTENDED))

      (method write ^void [this ^ClassWriter writer]
        (.write super writer)
        (when (== (.getFrameType this) SAME_FRAME_EXTENDED)
          (.appendChar (.-databuf writer) offsetDelta)
          (when (.-debugstackmap writer)
            (.print System/out (java-str " offset_delta=" offsetDelta))))))

    (defclass ^:static SameLocals1StackItemFrame
      :extends StackMapTableFrame

      (field ^:final ^int offsetDelta)

      (field ^:final ^Type stack)

      (constructor [this ^int offsetDelta ^Type stack]
        (set! (.-offsetDelta this) offsetDelta)
        (set! (.-stack this) stack))

      (method getFrameType ^int [this]
        (if (< offsetDelta SAME_FRAME_SIZE)
            (unchecked-add-int SAME_FRAME_SIZE offsetDelta)
            SAME_LOCALS_1_STACK_ITEM_EXTENDED))

      (method write ^void [this ^ClassWriter writer]
        (.write super writer)
        (when (== (.getFrameType this) SAME_LOCALS_1_STACK_ITEM_EXTENDED)
          (.appendChar (.-databuf writer) offsetDelta)
          (when (.-debugstackmap writer)
            (.print System/out (java-str " offset_delta=" offsetDelta))))
        (when (.-debugstackmap writer) (.print System/out (java-str (java-str " stack[" 0) "]=")))
        (.writeStackMapType writer stack)))

    (defclass ^:static ChopFrame
      :extends StackMapTableFrame

      (field ^:final ^int frameType)

      (field ^:final ^int offsetDelta)

      (constructor [this ^int frameType ^int offsetDelta]
        (set! (.-frameType this) frameType)
        (set! (.-offsetDelta this) offsetDelta))

      (method getFrameType ^int [this] frameType)

      (method write ^void [this ^ClassWriter writer]
        (.write super writer)
        (.appendChar (.-databuf writer) offsetDelta)
        (when (.-debugstackmap writer) (.print System/out (java-str " offset_delta=" offsetDelta)))))

    (defclass ^:static AppendFrame
      :extends StackMapTableFrame

      (field ^:final ^int frameType)

      (field ^:final ^int offsetDelta)

      (field ^:final ^Type/1 locals)

      (constructor [this ^int frameType ^int offsetDelta ^Type/1 locals]
        (set! (.-frameType this) frameType)
        (set! (.-offsetDelta this) offsetDelta)
        (set! (.-locals this) locals))

      (method getFrameType ^int [this] frameType)

      (method write ^void [this ^ClassWriter writer]
        (.write super writer)
        (.appendChar (.-databuf writer) offsetDelta)
        (when (.-debugstackmap writer) (.print System/out (java-str " offset_delta=" offsetDelta)))
        (loop [^int i 0]
          (when (< i (alength locals))
            (when (.-debugstackmap writer) (.print System/out (java-str " locals[" i "]=")))
            (.writeStackMapType writer (aget locals i))
            (recur (unchecked-inc-int i))))))

    (defclass ^:static FullFrame
      :extends StackMapTableFrame

      (field ^:final ^int offsetDelta)

      (field ^:final ^Type/1 locals)

      (field ^:final ^Type/1 stack)

      (constructor [this ^int offsetDelta ^Type/1 locals ^Type/1 stack]
        (set! (.-offsetDelta this) offsetDelta)
        (set! (.-locals this) locals)
        (set! (.-stack this) stack))

      (method getFrameType ^int [this] FULL_FRAME)

      (method write ^void [this ^ClassWriter writer]
        (.write super writer)
        (.appendChar (.-databuf writer) offsetDelta)
        (.appendChar (.-databuf writer) (alength locals))
        (when (.-debugstackmap writer)
          (.print System/out (java-str " offset_delta=" offsetDelta))
          (.print System/out (java-str " nlocals=" (alength locals))))
        (loop [^int i 0]
          (when (< i (alength locals))
            (when (.-debugstackmap writer) (.print System/out (java-str " locals[" i "]=")))
            (.writeStackMapType writer (aget locals i))
            (recur (unchecked-inc-int i))))
        (.appendChar (.-databuf writer) (alength stack))
        (when (.-debugstackmap writer) (.print System/out (java-str " nstack=" (alength stack))))
        (loop [^int i 0]
          (when (< i (alength stack))
            (when (.-debugstackmap writer) (.print System/out (java-str " stack[" i "]=")))
            (.writeStackMapType writer (aget stack i))
            (recur (unchecked-inc-int i))))))

    (method ^:static getInstance ^StackMapTableFrame [^Code$StackMapFrame this_frame ^int prev_pc
                                                      ^Type/1 prev_locals ^Types types]
      (let [locals (.-locals this_frame)
            stack (.-stack this_frame)
            offset_delta (unchecked-subtract-int
                           (unchecked-subtract-int (.-pc this_frame) prev_pc)
                           1)]
        (cond
          (== (alength stack) 1)
            (when (and (== (alength locals) (alength prev_locals))
                       (== (StackMapTableFrame/compare prev_locals locals types) 0))
              (return (SameLocals1StackItemFrame. offset_delta (aget stack 0))))
          (== (alength stack) 0)
            (let [diff_length (StackMapTableFrame/compare prev_locals locals types)]
              (cond
                (== diff_length 0) (return (SameFrame. offset_delta))
                (and (< (unchecked-negate-int MAX_LOCAL_LENGTH_DIFF) diff_length) (< diff_length 0))
                  (let [local_diff (new Type/1 (unchecked-negate-int diff_length))]
                    (loop [^int i (alength prev_locals)
                           ^int j 0]
                      (when (< i (alength locals))
                        (aset local_diff j (aget locals i))
                        (recur (unchecked-inc-int i) (unchecked-inc-int j))))
                    (return (AppendFrame. (unchecked-subtract-int SAME_FRAME_EXTENDED diff_length)
                                          offset_delta
                                          local_diff)))
                (and (< 0 diff_length) (< diff_length MAX_LOCAL_LENGTH_DIFF))
                  (return (ChopFrame. (unchecked-subtract-int SAME_FRAME_EXTENDED diff_length)
                                      offset_delta)))))
        (FullFrame. offset_delta locals stack)))

    (method ^:static isInt ^boolean [^Type t]
      (or (.isStrictSubRangeOf (.getTag t) TypeTag/INT) (.hasTag t TypeTag/BOOLEAN)))

    (method ^:static isSameType ^boolean [^Type t1 ^Type t2 ^Types types]
      (cond
        (nil? t1) (nil? t2)
        (nil? t2) false
        (and (StackMapTableFrame/isInt t1) (StackMapTableFrame/isInt t2)) true
        (.hasTag t1 TypeTag/UNINITIALIZED_THIS) (.hasTag t2 TypeTag/UNINITIALIZED_THIS)
        (.hasTag t1 TypeTag/UNINITIALIZED_OBJECT)
          (if (.hasTag t2 TypeTag/UNINITIALIZED_OBJECT)
              (== (.-offset (cast UninitializedType t1)) (.-offset (cast UninitializedType t2)))
              false)
        (or (.hasTag t2 TypeTag/UNINITIALIZED_THIS) (.hasTag t2 TypeTag/UNINITIALIZED_OBJECT)) false
        :else (.isSameType types t1 t2)))

    (method ^:static compare ^int [^Type/1 arr1 ^Type/1 arr2 ^Types types]
      (let [diff_length (unchecked-subtract-int (alength arr1) (alength arr2))]
        (if (or (> diff_length MAX_LOCAL_LENGTH_DIFF)
                (< diff_length (unchecked-negate-int MAX_LOCAL_LENGTH_DIFF)))
            Integer/MAX_VALUE
            (let [^int len (if (> diff_length 0) (alength arr2) (alength arr1))]
              (loop [^int i 0]
                (if (< i len)
                    (if (not (StackMapTableFrame/isSameType (aget arr1 i) (aget arr2 i) types))
                        (return Integer/MAX_VALUE)
                        (recur (unchecked-inc-int i)))
                    nil))
              diff_length)))))

  (method writeFields ^void [this ^Scope s]
    (let [^:mutable ^{:tag (List Symbol$VarSymbol)} vars (List/nil)]
      (for-each [^Symbol sym (.getSymbols s Scope$LookupKind/NON_RECURSIVE)]
        (when (identical? (.-kind sym) Kinds$Kind/VAR)
          (set! vars (.prepend vars (cast Symbol$VarSymbol sym)))))
      (while (.nonEmpty vars)
        (.writeField this (cast Symbol$VarSymbol (.-head vars)))
        (set! vars (.-tail vars)))))

  (method writeMethods ^void [this ^Scope s]
    (let [^:mutable ^{:tag (List Symbol$MethodSymbol)} methods (List/nil)]
      (for-each [^Symbol sym (.getSymbols s Scope$LookupKind/NON_RECURSIVE)]
        (when (and (identical? (.-kind sym) Kinds$Kind/MTH)
                   (== (bit-and (.flags sym) Flags/HYPOTHETICAL) 0))
          (set! methods (.prepend methods (cast Symbol$MethodSymbol sym)))))
      (while (.nonEmpty methods)
        (.writeMethod this (cast Symbol$MethodSymbol (.-head methods)))
        (set! methods (.-tail methods)))))

  (method ^:public writeClass :throws [IOException PoolOverflow StringOverflow] ^JavaFileObject [this
                                                                                                 ^Symbol$ClassSymbol c]
    (let [name (.toString (if (identical? (.-kind (.-owner c)) Kinds$Kind/MDL)
                              (.-name c)
                              (.-flatname c)))
          ^:mutable ^JavaFileManager$Location outLocn nil]
      (if multiModuleMode
          (let [^Symbol$ModuleSymbol msym (if (identical? (.-kind (.-owner c)) Kinds$Kind/MDL)
                                              (cast Symbol$ModuleSymbol (.-owner c))
                                              (.-modle (.packge c)))]
            (set! outLocn
                  (.getLocationForModule fileManager
                                         StandardLocation/CLASS_OUTPUT
                                         (.toString (.-name msym)))))
          (set! outLocn StandardLocation/CLASS_OUTPUT))
      (let [^:mutable outFile (.getJavaFileForOutput
                                fileManager
                                outLocn
                                name
                                JavaFileObject$Kind/CLASS
                                (.-sourcefile c))
            ^:mutable out (.openOutputStream outFile)]
        (try
          (.writeClassFile this out c)
          (when verbose (.printVerbose log "wrote.file" (.getName outFile)))
          (.close out)
          (set! out nil)
          (catch Types$SignatureGenerator$InvalidSignatureException ex
            (.error log
                    (CompilerProperties$Errors/CannotGenerateClass
                      c
                      (CompilerProperties$Fragments/IllegalSignature c (.type ex)))))
          (finally (when (some? out) (.close out) (.delete outFile) (set! outFile nil))))
        outFile)))

  (method ^:public writeClassFile :throws [IOException PoolOverflow StringOverflow] ^void [this
                                                                                           ^OutputStream out
                                                                                           ^Symbol$ClassSymbol c]
    (Assert/check (== (bit-and (.flags c) Flags/COMPOUND) 0))
    (.reset databuf)
    (.reset poolbuf)
    (let [supertype (.supertype types (.-type c))
          ^{:tag (List Type)} interfaces (.interfaces types (.-type c))
          ^{:tag (List Type)} typarams (.getTypeArguments (.-type c))
          ^:mutable ^int flags 0]
      (if (identical? (.-kind (.-owner c)) Kinds$Kind/MDL)
          (set! flags Flags/ACC_MODULE)
          (do
            (set! flags (.adjustFlags this (bit-and (.flags c) (bit-not Flags/DEFAULT))))
            (when-not (== (bit-and-int flags Flags/PROTECTED) 0)
              (set! flags (bit-or-int flags Flags/PUBLIC)))
            (set! flags
                  (bit-and-int (bit-and-int flags Flags/ClassFlags) (bit-not-int Flags/STRICTFP)))
            (when (== (bit-and-int flags Flags/INTERFACE) 0)
              (set! flags (bit-or-int flags Flags/ACC_SUPER)))))
      (when dumpClassModifiers
        (let [pw (.getWriter log Log$WriterKind/ERROR)]
          (.println pw)
          (.println pw (java-str "CLASSFILE  " (.getQualifiedName c)))
          (.println pw (java-str "---" (ClassWriter/flagNames flags)))))
      (.appendChar databuf flags)
      (if (identical? (.-kind (.-owner c)) Kinds$Kind/MDL)
          (let [unnamed (.-unnamedPackage (cast Symbol$ModuleSymbol (.-owner c)))]
            (.appendChar databuf
                         (.putClass poolWriter
                                    (Symbol$ClassSymbol. 0 (.-module_info names) unnamed))))
          (.appendChar databuf (.putClass poolWriter c)))
      (.appendChar databuf
                   (if (.hasTag supertype TypeTag/CLASS)
                       (.putClass poolWriter (cast Symbol$ClassSymbol (.-tsym supertype)))
                       0))
      (.appendChar databuf (.length interfaces))
      (loop [^{:tag (List Type)} l interfaces]
        (when (.nonEmpty l)
          (.appendChar databuf
                       (.putClass poolWriter
                                  (cast Symbol$ClassSymbol (.-tsym (cast Type (.-head l))))))
          (recur (.-tail l))))
      (let [^:mutable ^int fieldsCount 0
            ^:mutable ^int methodsCount 0]
        (for-each [^Symbol sym (.getSymbols (.members c) Scope$LookupKind/NON_RECURSIVE)]
          (switch (.-kind sym)
            VAR (set! fieldsCount (unchecked-inc-int fieldsCount))
            MTH
              (when (== (bit-and (.flags sym) Flags/HYPOTHETICAL) 0)
                (set! methodsCount (unchecked-inc-int methodsCount)))
            TYP (.enterInner poolWriter (cast Symbol$ClassSymbol sym))
            (Assert/error)))
        (when (some? (.-trans_local c))
          (for-each [^Symbol$ClassSymbol local (.-trans_local c)] (.enterInner poolWriter local)))
        (.appendChar databuf fieldsCount)
        (.writeFields this (.members c))
        (.appendChar databuf methodsCount)
        (.writeMethods this (.members c))
        (let [acountIdx (.beginAttrs this)
              ^:mutable ^int acount 0
              ^:mutable sigReq (or (not (== (.length typarams) 0))
                                   (not (== (.length (.allparams supertype)) 0)))]
          (loop [^{:tag (List Type)} l interfaces]
            (when (and (not sigReq) (.nonEmpty l))
              (set! sigReq (not (== (.length (.allparams (cast Type (.-head l)))) 0)))
              (recur (.-tail l))))
          (when sigReq
            (let [alenIdx (.writeAttr this (.-Signature names))]
              (.appendChar databuf (.putSignature poolWriter c))
              (.endAttr this alenIdx)
              (set! acount (unchecked-inc-int acount))))
          (when (and (some? (.-sourcefile c)) emitSourceFile)
            (let [alenIdx (.writeAttr this (.-SourceFile names))
                  simpleName (PathFileObject/getSimpleName (.-sourcefile c))]
              (.appendChar databuf (.putName poolWriter (.fromString names simpleName)))
              (.endAttr this alenIdx)
              (set! acount (unchecked-inc-int acount))))
          (when genCrt
            (let [^:mutable alenIdx (.writeAttr this (.-SourceID names))]
              (.appendChar databuf
                           (.putName poolWriter
                                     (.fromString
                                       names
                                       (Long/toString (.getLastModified this (.-sourcefile c))))))
              (.endAttr this alenIdx)
              (set! acount (unchecked-inc-int acount))
              (set! alenIdx (.writeAttr this (.-CompilationID names)))
              (.appendChar
                databuf
                (.putName poolWriter (.fromString names (Long/toString (System/currentTimeMillis)))))
              (.endAttr this alenIdx)
              (set! acount (unchecked-inc-int acount))))
          (set! acount (unchecked-add-int acount (.writeFlagAttrs this (.flags c))))
          (set! acount
                (unchecked-add-int acount (.writeJavaAnnotations this (.getRawAttributes c))))
          (set! acount
                (unchecked-add-int acount
                                   (.writeTypeAnnotations this (.getRawTypeAttributes c) false)))
          (set! acount (unchecked-add-int acount (.writeEnclosingMethodAttribute this c)))
          (when (identical? (.-kind (.-owner c)) Kinds$Kind/MDL)
            (set! acount (unchecked-add-int acount (.writeModuleAttribute this c)))
            (set!
              acount
              (unchecked-add-int acount
                                 (.writeFlagAttrs
                                   this
                                   (bit-and (.flags (.-owner c)) (bit-not-int Flags/DEPRECATED))))))
          (set! acount (unchecked-add-int acount (.writeExtraClassAttributes this c)))
          (set! acount (unchecked-add-int acount (.writeExtraAttributes this c)))
          (.appendInt poolbuf ClassWriter/JAVA_MAGIC)
          (if (and (.isEnabled preview) (.usesPreview preview (.-sourcefile c)))
              (.appendChar poolbuf ClassFile/PREVIEW_MINOR_VERSION)
              (.appendChar poolbuf (.-minorVersion target)))
          (.appendChar poolbuf (.-majorVersion target))
          (when-not (identical? (.-kind (.-owner c)) Kinds$Kind/MDL)
            (when (.hasNestmateAccess target)
              (set! acount (unchecked-add-int acount (.writeNestMembersIfNeeded this c)))
              (set! acount (unchecked-add-int acount (.writeNestHostIfNeeded this c)))))
          (when (.isRecord c)
            (set! acount (unchecked-add-int acount (.writeRecordAttribute this c))))
          (when (.hasSealedClasses target)
            (set! acount (unchecked-add-int acount (.writePermittedSubclassesIfNeeded this c))))
          (when-not (.isEmpty (.-bootstrapMethods poolWriter))
            (.writeBootstrapMethods this)
            (set! acount (unchecked-inc-int acount)))
          (when-not (.isEmpty (.-innerClasses poolWriter))
            (.writeInnerClasses this)
            (set! acount (unchecked-inc-int acount)))
          (.endAttrs this acountIdx acount)
          (.write out (.-elems poolbuf) 0 (.-length poolbuf))
          (.writePool poolWriter out)
          (.reset poolWriter)
          (.write out (.-elems databuf) 0 (.-length databuf))))))

  (method ^:protected writeExtraClassAttributes ^int [this ^Symbol$ClassSymbol c]
    0)

  (method ^:protected writeExtraAttributes ^int [this ^Symbol sym]
    (let [^:mutable ^int i 0]
      (for-each [^{:tag (ToIntFunction Symbol)} hook extraAttributeHooks]
        (set! i (unchecked-add-int i (.applyAsInt hook sym))))
      i))

  (method adjustFlags ^int [this ^:final ^long flags]
    (let [^:mutable result (unchecked-int flags)]
      (when (.obsoleteAccStrict target)
        (set! result (bit-and-int result (bit-not-int Flags/STRICTFP))))
      (when-not (== (bit-and flags Flags/BRIDGE) 0)
        (set! result (bit-or-int result Flags/ACC_BRIDGE)))
      (when-not (== (bit-and flags Flags/VARARGS) 0)
        (set! result (bit-or-int result Flags/ACC_VARARGS)))
      (when-not (== (bit-and flags Flags/DEFAULT) 0)
        (set! result (bit-and-int result (bit-not-int Flags/ABSTRACT))))
      result))

  (method getLastModified ^long [this ^FileObject filename]
    (.getLastModified filename)))

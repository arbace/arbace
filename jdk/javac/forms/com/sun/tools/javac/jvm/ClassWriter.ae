      (CLASS_TYPE_PARAMETER_BOUND METHOD_TYPE_PARAMETER_BOUND)
        (do (.appendByte databuf (.-parameter_index p)) (.appendByte databuf (.-bound_index p)))
      CLASS_EXTENDS (.appendChar databuf (.-type_index p))
      THROWS (.appendChar databuf (.-type_index p))
      METHOD_FORMAL_PARAMETER (.appendByte databuf (.-parameter_index p))

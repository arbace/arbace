              CHAR (.appendByte databuf \C)
              SHORT (.appendByte databuf \S)
              INT (.appendByte databuf \I)
              LONG (.appendByte databuf \J)
              FLOAT (.appendByte databuf \F)
              DOUBLE (.appendByte databuf \D)

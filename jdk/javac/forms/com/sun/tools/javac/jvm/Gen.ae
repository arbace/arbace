  (defclass ClassReferenceVisitor
    :extends JCTree$Visitor

    (method ^:public visitTree ^void [this ^JCTree tree])

    (method ^:public visitBinary ^void [this ^JCTree$JCBinary tree]
      (.accept (.-lhs tree) this)
      (.accept (.-rhs tree) this))

    (method ^:public visitSelect ^void [this ^JCTree$JCFieldAccess tree]
      (when (.hasTag (.-type (.-selected tree)) TypeTag/CLASS)
        (.makeRef Gen/this (.pos (.-selected tree)) (.-type (.-selected tree)))))

    (method ^:public visitIdent ^void [this ^JCTree$JCIdent tree]
      (when-instance [^Symbol$ClassSymbol classSymbol (.-owner (.-sym tree))]
        (.putClass poolWriter classSymbol)))

    (method ^:public visitConditional ^void [this ^JCTree$JCConditional tree]
      (.accept (.-cond tree) this)
      (.accept (.-truepart tree) this)
      (.accept (.-falsepart tree) this))

    (method ^:public visitUnary ^void [this ^JCTree$JCUnary tree]
      (.accept (.-arg tree) this))

    (method ^:public visitParens ^void [this ^JCTree$JCParens tree]
      (.accept (.-expr tree) this))

    (method ^:public visitTypeCast ^void [this ^JCTree$JCTypeCast tree]
      (.accept (.-expr tree) this)))

  (field ^:private ^ClassReferenceVisitor classReferenceVisitor (ClassReferenceVisitor.))

  (method ^:public genExpr ^Items$Item [this ^JCTree tree ^Type pt]
    (if (not (.isAlive code))
        (.makeStackItem items pt)
        (let [prevPt (.-pt this)]
          (try
            (if (some? (.constValue (.-type tree)))
                (do
                  (.accept tree classReferenceVisitor)
                  (.checkStringConstant this (.pos tree) (.constValue (.-type tree)))
                  (let [sym (TreeInfo/symbol tree)]
                    (if (and (some? sym) (.isConstantDynamic this sym))
                        (set! result (.makeDynamicItem items sym))
                        (set! result
                              (.makeImmediateItem items (.-type tree) (.constValue (.-type tree)))))))
                (do (set! (.-pt this) pt) (.accept tree this)))
            (.coerce result pt)
            (catch Symbol$CompletionFailure ex
              (.completionError chk (.pos tree) ex)
              (set! (.-stacksize (.-state code)) 1)
              (.makeStackItem items pt))
            (finally (set! (.-pt this) prevPt))))))

  (method ^:public isConstantDynamic ^boolean [this ^Symbol sym]
    (if (identical? (.-kind sym) Kinds$Kind/VAR)
        (if-instance [^Symbol$DynamicVarSymbol dynamicVarSymbol sym]
          (.isDynamic dynamicVarSymbol)
          false)
        false))

  (method ^:public genArgs ^void [this ^{:tag (List JCTree$JCExpression)} trees
                                  ^:mutable ^{:tag (List Type)} pts]
    (loop [^{:tag (List JCTree$JCExpression)} l trees]
      (when (.nonEmpty l)
        (.load (.genExpr this (cast JCTree (.-head l)) (cast Type (.-head pts))))
        (set! pts (.-tail pts))
        (recur (.-tail l))))
    (Assert/check (.isEmpty pts)))

  (defclass ^:public ^:static CodeSizeOverflow
    :extends RuntimeException

    (field ^:private ^:static ^:final ^long serialVersionUID 0)

    (constructor ^:public [this]))

  (method ^:public visitMethodDef ^void [this ^JCTree$JCMethodDecl tree]
    (let [^{:tag (Env GenContext)} localEnv (.dup env tree)]
      (set! (.-enclMethod localEnv) tree)
      (set! (.-pt this) (.getReturnType (.erasure (.-sym tree) types)))
      (.checkDimension this (.pos tree) (.erasure (.-sym tree) types))
      (.genMethod this tree localEnv false)))

  (method genMethod ^void [this ^JCTree$JCMethodDecl tree ^{:tag (Env GenContext)} env
                           ^boolean fatcode]
    (let [meth (.-sym tree)
          ^:mutable ^int extras 0]
      (arbace.core/cond (.isConstructor meth)
                        (do
                          (set! extras (unchecked-inc-int extras))
                          (when (and (.isInner (.enclClass meth))
                                     (not (.isStatic (.enclClass meth))))
                            (set! extras (unchecked-inc-int extras))))
                        (== (bit-and (.-flags (.-mods tree)) Flags/STATIC) 0)
                        (set! extras (unchecked-inc-int extras)))
      (arbace.core/cond
        (> (unchecked-add-int
             (Code/width (.getParameterTypes (.erasure types (.-type (.-sym (.-enclMethod env))))))
             extras)
           ClassFile/MAX_PARAMETERS)
        (do
          (.error log (.pos tree) CompilerProperties$Errors/LimitParameters)
          (set! nerrs (unchecked-inc-int nerrs)))
        (some? (.-body tree))
        (let [^:mutable startpcCrt (.initCode this tree env fatcode)]
          (try
            (.genStat this (.-body tree) env)
            (catch CodeSizeOverflow e
              (set! startpcCrt (.initCode this tree env fatcode))
              (.genStat this (.-body tree) env)))
          (when-not (== (.-stacksize (.-state code)) 0)
            (.error log (.pos (.-body tree)) (CompilerProperties$Errors/StackSimError (.-sym tree)))
            (throw (AssertionError.)))
          (when (.isAlive code)
            (.statBegin code (TreeInfo/endPos (.-body tree)))
            (if (or (nil? (.-enclMethod env))
                    (.hasTag (.getReturnType (.-type (.-sym (.-enclMethod env)))) TypeTag/VOID))
                (.emitop0 code ByteCodes/return_)
                (let [startpc (.entryPoint code)
                      c (.makeCondItem items ByteCodes/goto_)]
                  (.resolve code (.jumpTrue c) startpc))))
          (when genCrt
            (.put (.-crt code) (.-body tree) CRTFlags/CRT_BLOCK startpcCrt (.curCP code)))
          (.endScopes code 0)
          (if (.checkLimits code (.pos tree) log)
              (set! nerrs (unchecked-inc-int nerrs))
              (do
                (when (and (not fatcode) (.-fatcode code)) (.genMethod this tree env true))
                (when (identical? stackMap Code$StackMapFormat/JSR202)
                  (set! (.-lastFrame code) nil)
                  (set! (.-frameBeforeLast code) nil))
                (.compressCatchTable code)
                (.fillExceptionParameterPositions code)))))))

  (method ^:private initCode ^int [this ^JCTree$JCMethodDecl tree ^{:tag (Env GenContext)} env
                                   ^boolean fatcode]
    (let [meth (.-sym tree)]
      (set! (.-code meth)
            (set! code
                  (Code. meth
                         fatcode
                         ^Position$LineMap (when lineDebugInfo (.-lineMap toplevel))
                         varDebugInfo
                         stackMap
                         debugCode
                         ^CRTable (when genCrt (CRTable. tree (.-endPositions (.-toplevel env))))
                         syms
                         types
                         poolWriter)))
      (set! items (Items. poolWriter code syms types))
      (when (.-debugCode code) (.println System/err (java-str meth " for body " tree)))
      (when (== (bit-and (.-flags (.-mods tree)) Flags/STATIC) 0)
        (let [^:mutable selfType (.-type (.-owner meth))]
          (when (and (.isConstructor meth) (not (identical? selfType (.-objectType syms))))
            (set! selfType (UninitializedType/uninitializedThis selfType)))
          (.setDefined code
                       (.newLocal code
                                  (Symbol$VarSymbol.
                                    Flags/FINAL
                                    (.-_this names)
                                    selfType
                                    (.-owner meth))))))
      (loop [^{:tag (List JCTree$JCVariableDecl)} l (.-params tree)]
        (when (.nonEmpty l)
          (.checkDimension this
                           (.pos (cast JCTree$JCVariableDecl (.-head l)))
                           (.-type (.-sym (cast JCTree$JCVariableDecl (.-head l)))))
          (.setDefined code (.newLocal code (.-sym (cast JCTree$JCVariableDecl (.-head l)))))
          (recur (.-tail l))))
      (let [^int startpcCrt (if genCrt (.curCP code) 0)]
        (.entryPoint code)
        (set! (.-pendingStackMap code) false)
        startpcCrt)))

  (method ^:public visitVarDef ^void [this ^JCTree$JCVariableDecl tree]
    (let [v (.-sym tree)]
      (if (some? (.-init tree))
          (do
            (.checkStringConstant this (.pos (.-init tree)) (.getConstValue v))
            (when (or (nil? (.getConstValue v)) varDebugInfo)
              (Assert/check (.isStatementStart code))
              (.newLocal code v)
              (.load (.genExpr this (.-init tree) (.erasure v types)))
              (.store (.makeLocalItem items v))
              (Assert/check (.isStatementStart code))))
          (.newLocal code v))
      (.checkDimension this (.pos tree) (.-type v))))

  (method ^:public visitSkip ^void [this ^JCTree$JCSkip tree])

  (method ^:public visitBlock ^void [this ^JCTree$JCBlock tree]
    (if (some? (.-patternMatchingCatch tree))
        (.visitBlockWithPatterns this tree)
        (.internalVisitBlock this tree)))

  (method ^:private visitBlockWithPatterns ^void [this ^JCTree$JCBlock tree]
    (let [prevConfiguration patternMatchingCatchConfiguration]
      (try
        (set! patternMatchingCatchConfiguration
              (PatternMatchingCatchConfiguration.
                (.calls2Handle (.-patternMatchingCatch tree))
                (ListBuffer.)
                (.handler (.-patternMatchingCatch tree))
                (.dup (.-state code))))
        (.internalVisitBlock this tree)
        (finally
          (.generatePatternMatchingCatch this env)
          (set! patternMatchingCatchConfiguration prevConfiguration)))))

  (method ^:private generatePatternMatchingCatch ^void [this ^{:tag (Env GenContext)} env]
    (when (and (some? (.-handler patternMatchingCatchConfiguration))
               (not (.isEmpty (.-ranges patternMatchingCatchConfiguration))))
      (let [skipCatch (.branch code ByteCodes/goto_)
            handler (.handler patternMatchingCatchConfiguration)]
        (.entryPoint code
                     (.startState patternMatchingCatchConfiguration)
                     (.-type (.-sym (.-param handler))))
        (.genPatternMatchingCatch this
                                  handler
                                  env
                                  (.toList (.-ranges patternMatchingCatchConfiguration)))
        (.resolve code skipCatch))))

  (method ^:private internalVisitBlock ^void [this ^JCTree$JCBlock tree]
    (let [limit (.-nextreg code)
          ^{:tag (Env GenContext)} localEnv (.dup env tree (GenContext.))]
      (.genStats this (.-stats tree) localEnv)
      (when-not (.hasTag (.-tree env) JCTree$Tag/METHODDEF)
        (.statBegin code (.-bracePos tree))
        (.endScopes code limit)
        (set! (.-pendingStatPos code) Position/NOPOS))))

  (method ^:public visitDoLoop ^void [this ^JCTree$JCDoWhileLoop tree]
    (.genLoop this tree (.-body tree) (.-cond tree) (List/nil) false))

  (method ^:public visitWhileLoop ^void [this ^JCTree$JCWhileLoop tree]
    (.genLoop this tree (.-body tree) (.-cond tree) (List/nil) true))

  (method ^:public visitForLoop ^void [this ^JCTree$JCForLoop tree]
    (let [limit (.-nextreg code)]
      (.genStats this (.-init tree) env)
      (.genLoop this tree (.-body tree) (.-cond tree) (.-step tree) true)
      (.endScopes code limit)))

  (method ^:private genLoop ^void [this ^JCTree$JCStatement loop ^JCTree$JCStatement body
                                   ^JCTree$JCExpression cond
                                   ^{:tag (List JCTree$JCExpressionStatement)} step
                                   ^boolean testFirst]
    (let [^{:tag (Env GenContext)} loopEnv (.dup env loop (GenContext.))
          startpc (.entryPoint code)]
      (if testFirst
          (let [^:mutable ^Items$CondItem c nil]
            (if (some? cond)
                (do
                  (.statBegin code (.-pos cond))
                  (Assert/check (.isStatementStart code))
                  (set! c (.genCond this (TreeInfo/skipParens cond) CRTFlags/CRT_FLOW_CONTROLLER)))
                (set! c (.makeCondItem items ByteCodes/goto_)))
            (let [loopDone (.jumpFalse c)]
              (.resolve code (.-trueJumps c))
              (Assert/check (.isStatementStart code))
              (.genStat this
                        body
                        loopEnv
                        (bit-or-int CRTFlags/CRT_STATEMENT CRTFlags/CRT_FLOW_TARGET))
              (.resolve code (.-cont (cast GenContext (.-info loopEnv))))
              (.genStats this step loopEnv)
              (.resolve code (.branch code ByteCodes/goto_) startpc)
              (.resolve code loopDone)))
          (do
            (.genStat this
                      body
                      loopEnv
                      (bit-or-int CRTFlags/CRT_STATEMENT CRTFlags/CRT_FLOW_TARGET))
            (.resolve code (.-cont (cast GenContext (.-info loopEnv))))
            (.genStats this step loopEnv)
            (when (.isAlive code)
              (let [^:mutable ^Items$CondItem c nil]
                (if (some? cond)
                    (do
                      (.statBegin code (.-pos cond))
                      (Assert/check (.isStatementStart code))
                      (set! c
                            (.genCond this (TreeInfo/skipParens cond) CRTFlags/CRT_FLOW_CONTROLLER)))
                    (set! c (.makeCondItem items ByteCodes/goto_)))
                (.resolve code (.jumpTrue c) startpc)
                (Assert/check (.isStatementStart code))
                (.resolve code (.-falseJumps c))))))
      (.resolve code (.-exit (cast GenContext (.-info loopEnv))))))

  (method ^:public visitForeachLoop ^void [this ^JCTree$JCEnhancedForLoop tree]
    (throw (AssertionError.)))

  (method ^:public visitLabelled ^void [this ^JCTree$JCLabeledStatement tree]
    (let [^{:tag (Env GenContext)} localEnv (.dup env tree (GenContext.))]
      (.genStat this (.-body tree) localEnv CRTFlags/CRT_STATEMENT)
      (.resolve code (.-exit (cast GenContext (.-info localEnv))))))

  (method ^:public visitSwitch ^void [this ^JCTree$JCSwitch tree]
    (.handleSwitch this tree (.-selector tree) (.-cases tree) (.-patternSwitch tree)))

  (method ^:public visitSwitchExpression ^void [this ^JCTree$JCSwitchExpression tree]
    (.resolvePending code)
    (let [prevInCondSwitchExpression inCondSwitchExpression]
      (try
        (set! inCondSwitchExpression false)
        (.doHandleSwitchExpression this tree)
        (finally (set! inCondSwitchExpression prevInCondSwitchExpression)))
      (set! result (.makeStackItem items pt))))

  (method ^:private doHandleSwitchExpression ^void [this ^JCTree$JCSwitchExpression tree]
    (let [^{:tag (List Items$LocalItem)} prevStackBeforeSwitchExpression stackBeforeSwitchExpression
          prevSwitchResult switchResult
          limit (.-nextreg code)]
      (try
        (set! stackBeforeSwitchExpression (List/nil))
        (set! switchResult nil)
        (when (.hasTry this tree)
          (while (> (.-stacksize (.-state code)) 0)
            (let [type (.peek (.-state code))
                  varName (.fromString names
                                       (java-str
                                         (.syntheticNameChar target)
                                         "stack"
                                         (.syntheticNameChar target)
                                         (.-pos tree)
                                         (.syntheticNameChar target)
                                         (.-stacksize (.-state code))))
                  var (Symbol$VarSymbol. Flags/SYNTHETIC
                                         varName
                                         type
                                         (.-sym (.-enclMethod (.-env this))))
                  item (.new items Items$LocalItem type (.newLocal code var))]
              (set! stackBeforeSwitchExpression (.prepend stackBeforeSwitchExpression item))
              (.store item)))
          (set! switchResult (.makeTemp this (.-type tree))))
        (let [prevLetExprStart (.setLetExprStackPos code (.-stacksize (.-state code)))]
          (try
            (.handleSwitch this tree (.-selector tree) (.-cases tree) (.-patternSwitch tree))
            (finally (.setLetExprStackPos code prevLetExprStart))))
        (finally
          (set! stackBeforeSwitchExpression prevStackBeforeSwitchExpression)
          (set! switchResult prevSwitchResult)
          (.endScopes code limit)))))

  (method ^:private hasTry ^boolean [this ^JCTree$JCSwitchExpression tree]
    (letclass [(HasTryScanner
                 :extends TreeScanner

                 (field ^:private ^boolean hasTry)

                 (method ^:public visitTry ^void [this ^JCTree$JCTry tree]
                   (set! hasTry true))

                 (method ^:public visitSynchronized ^void [this ^JCTree$JCSynchronized tree]
                   (set! hasTry true))

                 (method ^:public visitClassDef ^void [this ^JCTree$JCClassDecl tree])

                 (method ^:public visitLambda ^void [this ^JCTree$JCLambda tree]))]
      (let [hasTryScanner (HasTryScanner.)] (.scan hasTryScanner tree) (.-hasTry hasTryScanner))))

  (method ^:private handleSwitch ^void [this ^JCTree swtch ^JCTree$JCExpression selector
                                        ^{:tag (List JCTree$JCCase)} cases ^boolean patternSwitch]
    (let [limit (.-nextreg code)]
      (Assert/check (not (.hasTag (.-type selector) TypeTag/CLASS)))
      (let [^int switchStart (if patternSwitch (.entryPoint code) -1)
            ^int startpcCrt (if genCrt (.curCP code) 0)]
        (Assert/check (.isStatementStart code))
        (let [sel (.genExpr this selector (.-intType syms))]
          (if (.isEmpty cases)
              (do
                (.drop (.load sel))
                (when genCrt
                  (.put (.-crt code)
                        (TreeInfo/skipParens selector)
                        CRTFlags/CRT_FLOW_CONTROLLER
                        startpcCrt
                        (.curCP code))))
              (do
                (.load sel)
                (when genCrt
                  (.put (.-crt code)
                        (TreeInfo/skipParens selector)
                        CRTFlags/CRT_FLOW_CONTROLLER
                        startpcCrt
                        (.curCP code)))
                (let [^{:tag (Env GenContext)} switchEnv (.dup env swtch (GenContext.))]
                  (set! (.-isSwitch (cast GenContext (.-info switchEnv))) true)
                  (let [^:mutable lo Integer/MAX_VALUE
                        ^:mutable hi Integer/MIN_VALUE
                        ^:mutable ^int nlabels 0
                        labels (new int/1 (.length cases))
                        ^:mutable ^int defaultIndex -1
                        ^:mutable ^{:tag (List JCTree$JCCase)} l cases]
                    (loop [^int i 0]
                      (when (< i (alength labels))
                        (if-instance [^JCTree$JCConstantCaseLabel constLabel (.-head
                                                                               (.-labels
                                                                                 (cast
                                                                                   JCTree$JCCase
                                                                                   (.-head l))))]
                          (do
                            (Assert/check (== (.size (.-labels (cast JCTree$JCCase (.-head l)))) 1))
                            (let [val (.intValue
                                        (cast Number (.constValue (.-type (.-expr constLabel)))))]
                              (aset labels i val)
                              (when (< val lo) (set! lo val))
                              (when (< hi val) (set! hi val))
                              (set! nlabels (unchecked-inc-int nlabels))))
                          (do (Assert/check (== defaultIndex -1)) (set! defaultIndex i)))
                        (set! l (.-tail l))
                        (recur (unchecked-inc-int i))))
                    (let [table_space_cost (unchecked-add
                                             4
                                             (unchecked-add (unchecked-subtract (long hi) lo) 1))
                          table_time_cost 3
                          lookup_space_cost (unchecked-add 3 (unchecked-multiply 2 (long nlabels)))
                          ^long lookup_time_cost nlabels
                          ^int opcode (if (and (> nlabels 0)
                                               (<=
                                                 (unchecked-add
                                                   table_space_cost
                                                   (unchecked-multiply 3 table_time_cost))
                                                 (unchecked-add
                                                   lookup_space_cost
                                                   (unchecked-multiply 3 lookup_time_cost))))
                                          ByteCodes/tableswitch
                                          ByteCodes/lookupswitch)
                          startpc (.curCP code)]
                      (.emitop0 code opcode)
                      (.align code 4)
                      (let [tableBase (.curCP code)
                            ^:mutable ^int/1 offsets nil]
                        (.emit4 code -1)
                        (if (== opcode ByteCodes/tableswitch)
                            (do
                              (.emit4 code lo)
                              (.emit4 code hi)
                              (loop [^long i lo]
                                (when (<= i hi) (.emit4 code -1) (recur (unchecked-inc i)))))
                            (do
                              (.emit4 code nlabels)
                              (loop [^int i 0]
                                (when (< i nlabels)
                                  (.emit4 code -1)
                                  (.emit4 code -1)
                                  (recur (unchecked-inc-int i))))
                              (set! offsets (new int/1 (alength labels)))))
                        (let [stateSwitch (.dup (.-state code))]
                          (.markDead code)
                          (set! l cases)
                          (loop [^int i 0]
                            (when (< i (alength labels))
                              (let [c (cast JCTree$JCCase (.-head l))]
                                (set! l (.-tail l))
                                (let [pc (.entryPoint code stateSwitch)]
                                  (if (not (== i defaultIndex))
                                      (if (== opcode ByteCodes/tableswitch)
                                          (.put4
                                            code
                                            (unchecked-add-int
                                              tableBase
                                              (unchecked-multiply-int
                                                4
                                                (unchecked-add-int
                                                  (unchecked-subtract-int (aget labels i) lo)
                                                  3)))
                                            (unchecked-subtract-int pc startpc))
                                          (aset offsets i (unchecked-subtract-int pc startpc)))
                                      (.put4 code tableBase (unchecked-subtract-int pc startpc)))
                                  (.genStats this (.-stats c) switchEnv CRTFlags/CRT_FLOW_TARGET)
                                  (recur (unchecked-inc-int i))))))
                          (when (some? (.-cont (cast GenContext (.-info switchEnv))))
                            (Assert/check patternSwitch)
                            (.resolve code
                                      (.-cont (cast GenContext (.-info switchEnv)))
                                      switchStart))
                          (.resolve code (.-exit (cast GenContext (.-info switchEnv))))
                          (when (== (.get4 code tableBase) -1)
                            (.put4 code
                                   tableBase
                                   (unchecked-subtract-int (.entryPoint code stateSwitch) startpc)))
                          (if (== opcode ByteCodes/tableswitch)
                              (let [defaultOffset (.get4 code tableBase)]
                                (loop [^long i lo]
                                  (when (<= i hi)
                                    (let [t (unchecked-int
                                              (unchecked-add
                                                tableBase
                                                (unchecked-multiply
                                                  4
                                                  (unchecked-add (unchecked-subtract i lo) 3))))]
                                      (if (== (.get4 code t) -1)
                                          (do
                                            (.put4 code t defaultOffset)
                                            (recur (unchecked-inc i)))
                                          (recur (unchecked-inc i)))))))
                              (do
                                (when (>= defaultIndex 0)
                                  (loop [^int i defaultIndex]
                                    (when (< i (unchecked-subtract-int (alength labels) 1))
                                      (aset labels i (aget labels (unchecked-add-int i 1)))
                                      (aset offsets i (aget offsets (unchecked-add-int i 1)))
                                      (recur (unchecked-inc-int i)))))
                                (when (> nlabels 0)
                                  (Gen/qsort2 labels offsets 0 (unchecked-subtract-int nlabels 1)))
                                (loop [^int i 0]
                                  (when (< i nlabels)
                                    (let [caseidx (unchecked-add-int
                                                    tableBase
                                                    (unchecked-multiply-int
                                                      8
                                                      (unchecked-add-int i 1)))]
                                      (.put4 code caseidx (aget labels i))
                                      (.put4 code (unchecked-add-int caseidx 4) (aget offsets i))
                                      (recur (unchecked-inc-int i)))))))
                          (when (instance? JCTree$JCSwitchExpression swtch)
                            (.statBegin code (TreeInfo/endPos swtch))))))))))
          (.endScopes code limit)))))

  (method ^:static qsort2 ^void [^int/1 keys ^int/1 values ^int lo ^int hi]
    (let [^:mutable i lo
          ^:mutable j hi
          pivot (aget keys (unchecked-divide-int (unchecked-add-int i j) 2))]
      (loop []
        (while (< (aget keys i) pivot) (set! i (unchecked-inc-int i)))
        (while (< pivot (aget keys j)) (set! j (unchecked-dec-int j)))
        (when (<= i j)
          (let [temp1 (aget keys i)]
            (aset keys i (aget keys j))
            (aset keys j temp1)
            (let [temp2 (aget values i)]
              (aset values i (aget values j))
              (aset values j temp2)
              (set! i (unchecked-inc-int i))
              (set! j (unchecked-dec-int j)))))
        (when (<= i j) (recur)))
      (when (< lo j) (Gen/qsort2 keys values lo j))
      (when (< i hi) (Gen/qsort2 keys values i hi))))

  (method ^:public visitSynchronized ^void [this ^JCTree$JCSynchronized tree]
    (let [limit (.-nextreg code)
          lockVar (.makeTemp this (.-objectType syms))]
      (Assert/check (.isStatementStart code))
      (.duplicate (.load (.genExpr this (.-lock tree) (.-type (.-lock tree)))))
      (.store lockVar)
      (.emitop0 code ByteCodes/monitorenter)
      (.lock (.-state code) (.-reg lockVar))
      (let [^{:tag (Env GenContext)} syncEnv (.dup env tree (GenContext.))]
        (set! (.-finalize (cast GenContext (.-info syncEnv)))
              (anon GenFinalizer []
                (method gen ^void [this]
                  (.genLast this)
                  (Assert/check (== (unchecked-remainder-int
                                      (.length (.-gaps (cast GenContext (.-info syncEnv))))
                                      2)
                                    0))
                  (.append (.-gaps (cast GenContext (.-info syncEnv))) (.curCP code)))

                (method genLast ^void [this]
                  (when (.isAlive code)
                    (.load lockVar)
                    (.emitop0 code ByteCodes/monitorexit)
                    (.unlock (.-state code) (.-reg lockVar))))))
        (set! (.-gaps (cast GenContext (.-info syncEnv))) (ListBuffer.))
        (.genTry this (.-body tree) (List/nil) syncEnv)
        (.endScopes code limit))))

  (method ^:public visitTry ^void [this ^:final ^JCTree$JCTry tree]
    (let [^{:tag (Env GenContext)} tryEnv (.dup env tree (GenContext.))
          ^{:tag (Env GenContext)} oldEnv env]
      (set! (.-finalize (cast GenContext (.-info tryEnv)))
            (anon GenFinalizer []
              (method gen ^void [this]
                (Assert/check (== (unchecked-remainder-int
                                    (.length (.-gaps (cast GenContext (.-info tryEnv))))
                                    2)
                                  0))
                (.append (.-gaps (cast GenContext (.-info tryEnv))) (.curCP code))
                (.genLast this))

              (method genLast ^void [this]
                (when (some? (.-finalizer tree))
                  (.genStat Gen/this (.-finalizer tree) oldEnv CRTFlags/CRT_BLOCK)))

              (method hasFinalizer ^boolean [this] (some? (.-finalizer tree)))

              (method afterBody ^void [this]
                (when (and (some? (.-finalizer tree))
                           (not (== (bit-and (.-flags (.-finalizer tree)) Flags/BODY_ONLY_FINALIZE)
                                    0)))
                  (set! (.-finalize (cast GenContext (.-info tryEnv))) nil)))))
      (set! (.-gaps (cast GenContext (.-info tryEnv))) (ListBuffer.))
      (.genTry this (.-body tree) (.-catchers tree) tryEnv)))

  (method genTry ^void [this ^JCTree body ^{:tag (List JCTree$JCCatch)} catchers
                        ^{:tag (Env GenContext)} env]
    (let [limit (.-nextreg code)
          startpc (.curCP code)
          stateTry (.dup (.-state code))]
      (.genStat this body env CRTFlags/CRT_BLOCK)
      (let [endpc (.curCP code)
            ^{:tag (List Integer)} gaps (.toList (.-gaps (cast GenContext (.-info env))))]
        (.statBegin code (TreeInfo/endPos body))
        (.genFinalizer this env)
        (.statBegin code (TreeInfo/endPos (.-tree env)))
        (let [^:mutable ^Code$Chain exitChain nil
              actualTry (.hasTag (.-tree env) JCTree$Tag/TRY)]
          (if (and (== startpc endpc) actualTry)
              (set! exitChain (.branch code ByteCodes/dontgoto))
              (set! exitChain (.branch code ByteCodes/goto_)))
          (.endFinalizerGap this env)
          (.afterBody (.-finalize (cast GenContext (.-info env))))
          (let [hasFinalizer (and (some? (.-finalize (cast GenContext (.-info env))))
                                  (.hasFinalizer (.-finalize (cast GenContext (.-info env)))))]
            (when-not (== startpc endpc)
              (loop [^{:tag (List JCTree$JCCatch)} l catchers]
                (when (.nonEmpty l)
                  (.entryPoint code
                               stateTry
                               (.-type (.-sym (.-param (cast JCTree$JCCatch (.-head l))))))
                  (.genCatch this (cast JCTree$JCCatch (.-head l)) env startpc endpc gaps)
                  (.genFinalizer this env)
                  (when (or hasFinalizer (.nonEmpty (.-tail l)))
                    (.statBegin code (TreeInfo/endPos (.-tree env)))
                    (set! exitChain (Code/mergeChains exitChain (.branch code ByteCodes/goto_))))
                  (.endFinalizerGap this env)
                  (recur (.-tail l)))))
            (when (and hasFinalizer (or (not (== startpc endpc)) (not actualTry)))
              (.newRegSegment code)
              (let [catchallpc (.entryPoint code stateTry (.-throwableType syms))
                    ^:mutable startseg startpc]
                (while (.nonEmpty (.-gaps (cast GenContext (.-info env))))
                  (let [endseg (.intValue (cast Integer
                                                (.next (.-gaps (cast GenContext (.-info env))))))]
                    (.registerCatch this (.pos body) startseg endseg catchallpc 0)
                    (set!
                      startseg
                      (.intValue (cast Integer (.next (.-gaps (cast GenContext (.-info env)))))))))
                (.statBegin code
                            (TreeInfo/finalizerPos (.-tree env) TreeInfo$PosKind/FIRST_STAT_POS))
                (.markStatBegin code)
                (let [^Items$Item excVar (.makeTemp this (.-throwableType syms))]
                  (.store excVar)
                  (.genFinalizer this env)
                  (.resolvePending code)
                  (.statBegin code (TreeInfo/finalizerPos (.-tree env) TreeInfo$PosKind/END_POS))
                  (.markStatBegin code)
                  (.load excVar)
                  (.registerCatch this
                                  (.pos body)
                                  startseg
                                  (.intValue (cast
                                               Integer
                                               (.next (.-gaps (cast GenContext (.-info env))))))
                                  catchallpc
                                  0)
                  (.emitop0 code ByteCodes/athrow)
                  (.markDead code)
                  (when (some? (.-cont (cast GenContext (.-info env))))
                    (.resolve code (.-cont (cast GenContext (.-info env))))
                    (.statBegin
                      code
                      (TreeInfo/finalizerPos (.-tree env) TreeInfo$PosKind/FIRST_STAT_POS))
                    (.markStatBegin code)
                    (let [retVar (.makeTemp this (.-throwableType syms))]
                      (.store retVar)
                      (.genLast (.-finalize (cast GenContext (.-info env))))
                      (.emitop1w code ByteCodes/ret (.-reg retVar))
                      (.markDead code))))))
            (.resolve code exitChain)
            (.endScopes code limit))))))

  (method genCatch ^void [this ^JCTree$JCCatch tree ^{:tag (Env GenContext)} env
                          ^:mutable ^int startpc ^int endpc ^:mutable ^{:tag (List Integer)} gaps]
    (when-not (== startpc endpc)
      (let [^{:tag (List (Pair (List Attribute$TypeCompound) JCTree$JCExpression))} catchTypeExprs
              (.catchTypesWithAnnotations this tree)]
        (while (.nonEmpty gaps)
          (for-each [^{:tag (Pair (List Attribute$TypeCompound) JCTree$JCExpression)} subCatch1
                       catchTypeExprs]
            (let [subCatch (cast JCTree$JCExpression (.-snd subCatch1))
                  catchType (.makeRef this (.pos tree) (.-type subCatch))
                  end (.intValue (cast Integer (.-head gaps)))]
              (.registerCatch this (.pos tree) startpc end (.curCP code) catchType)
              (for-each [^Attribute$TypeCompound tc (cast List (.-fst subCatch1))]
                (.setCatchInfo (.-position tc) catchType startpc))))
          (set! gaps (.-tail gaps))
          (set! startpc (.intValue (cast Integer (.-head gaps))))
          (set! gaps (.-tail gaps)))
        (when (< startpc endpc)
          (for-each [^{:tag (Pair (List Attribute$TypeCompound) JCTree$JCExpression)} subCatch1
                       catchTypeExprs]
            (let [subCatch (cast JCTree$JCExpression (.-snd subCatch1))
                  catchType (.makeRef this (.pos tree) (.-type subCatch))]
              (.registerCatch this (.pos tree) startpc endpc (.curCP code) catchType)
              (for-each [^Attribute$TypeCompound tc (cast List (.-fst subCatch1))]
                (.setCatchInfo (.-position tc) catchType startpc)))))
        (.genCatchBlock this tree env))))

  (method genPatternMatchingCatch ^void [this ^JCTree$JCCatch tree ^{:tag (Env GenContext)} env
                                         ^{:tag (List int/1)} ranges]
    (for-each [^int/1 range ranges]
      (let [subCatch (.-vartype (.-param tree))
            catchType (.makeRef this (.pos tree) (.-type subCatch))]
        (.registerCatch this (.pos tree) (aget range 0) (aget range 1) (.curCP code) catchType)))
    (.genCatchBlock this tree env))

  (method genCatchBlock ^void [this ^JCTree$JCCatch tree ^{:tag (Env GenContext)} env]
    (let [exparam (.-sym (.-param tree))]
      (.statBegin code (.-pos tree))
      (.markStatBegin code)
      (let [limit (.-nextreg code)]
        (.newLocal code exparam)
        (.store (.makeLocalItem items exparam))
        (.statBegin code (TreeInfo/firstStatPos (.-body tree)))
        (.genStat this (.-body tree) env CRTFlags/CRT_BLOCK)
        (.endScopes code limit)
        (.statBegin code (TreeInfo/endPos (.-body tree))))))

  (method catchTypesWithAnnotations ^{:tag (List (Pair (List Attribute$TypeCompound) JCTree$JCExpression))} [this
                                                                                                             ^JCTree$JCCatch tree]
    (if (TreeInfo/isMultiCatch tree)
        (.catchTypesWithAnnotationsFromMulticatch
          this
          (cast JCTree$JCTypeUnion (.-vartype (.-param tree)))
          (.getRawTypeAttributes (.-sym (.-param tree))))
        (List/of (Pair. (.getRawTypeAttributes (.-sym (.-param tree))) (.-vartype (.-param tree))))))

  (method catchTypesWithAnnotationsFromMulticatch ^{:tag (List (Pair (List Attribute$TypeCompound) JCTree$JCExpression))} [this
                                                                                                                           ^JCTree$JCTypeUnion tree
                                                                                                                           ^{:tag (List Attribute$TypeCompound)} first]
    (let [^:mutable ^{:tag (List JCTree$JCExpression)} alts (.-alternatives tree)
          ^:mutable ^{:tag (List (Pair (List Attribute$TypeCompound) JCTree$JCExpression))} res
            (List/of (Pair. first (cast JCTree$JCExpression (.-head alts))))]
      (set! alts (.-tail alts))
      (while (and (some? alts) (some? (.-head alts)))
        (let [alt (cast JCTree$JCExpression (.-head alts))]
          (if-instance [^JCTree$JCAnnotatedType annotatedType alt]
            (set! res
                  (.prepend res
                            (Pair. (.fromAnnotations annotate (.-annotations annotatedType)) alt)))
            (set! res (.prepend res (Pair. (List/nil) alt))))
          (set! alts (.-tail alts))))
      (.reverse res)))

  (method registerCatch ^void [this ^JCDiagnostic$DiagnosticPosition pos ^int startpc ^int endpc
                               ^int handler_pc ^int catch_type]
    (let [startpc1 (unchecked-char startpc)
          endpc1 (unchecked-char endpc)
          handler_pc1 (unchecked-char handler_pc)]
      (if (and (and (== startpc1 startpc) (== endpc1 endpc)) (== handler_pc1 handler_pc))
          (.addCatch code startpc1 endpc1 handler_pc1 (unchecked-char catch_type))
          (do
            (.error log pos CompilerProperties$Errors/LimitCodeTooLargeForTryStmt)
            (set! nerrs (unchecked-inc-int nerrs))))))

  (method ^:public visitIf ^void [this ^JCTree$JCIf tree]
    (let [limit (.-nextreg code)
          ^:mutable ^Code$Chain thenExit nil]
      (Assert/check (.isStatementStart code))
      (let [c (.genCond this (TreeInfo/skipParens (.-cond tree)) CRTFlags/CRT_FLOW_CONTROLLER)
            elseChain (.jumpFalse c)]
        (Assert/check (.isStatementStart code))
        (when-not (.isFalse c)
          (.resolve code (.-trueJumps c))
          (.genStat this
                    (.-thenpart tree)
                    env
                    (bit-or-int CRTFlags/CRT_STATEMENT CRTFlags/CRT_FLOW_TARGET))
          (set! thenExit (.branch code ByteCodes/goto_)))
        (when (some? elseChain)
          (.resolve code elseChain)
          (when (some? (.-elsepart tree))
            (.genStat this
                      (.-elsepart tree)
                      env
                      (bit-or-int CRTFlags/CRT_STATEMENT CRTFlags/CRT_FLOW_TARGET))))
        (.resolve code thenExit)
        (.endScopes code limit)
        (Assert/check (.isStatementStart code)))))

  (method ^:public visitExec ^void [this ^JCTree$JCExpressionStatement tree]
    (let [e (.-expr tree)]
      (switch (.getTag e)
        POSTINC (.setTag (cast JCTree$JCUnary e) JCTree$Tag/PREINC)
        POSTDEC (.setTag (cast JCTree$JCUnary e) JCTree$Tag/PREDEC))
      (Assert/check (.isStatementStart code))
      (.drop (.genExpr this (.-expr tree) (.-type (.-expr tree))))
      (Assert/check (.isStatementStart code))))

  (method ^:public visitBreak ^void [this ^JCTree$JCBreak tree]
    (Assert/check (.isStatementStart code))
    (let [^{:tag (Env GenContext)} targetEnv (.unwindBreak this (.-target tree))]
      (.addExit (cast GenContext (.-info targetEnv)) (.branch code ByteCodes/goto_))
      (.endFinalizerGaps this env targetEnv)))

  (method ^:public visitYield ^void [this ^JCTree$JCYield tree]
    (Assert/check (.isStatementStart code))
    (let [^:mutable ^{:tag (Env GenContext)} targetEnv nil]
      (if inCondSwitchExpression
          (let [value (.genCond this (.-value tree) CRTFlags/CRT_FLOW_TARGET)
                ^:mutable falseJumps (.jumpFalse value)]
            (.resolve code (.-trueJumps value))
            (let [^{:tag (Env GenContext)} localEnv (.unwindBreak this (.-target tree))]
              (.reloadStackBeforeSwitchExpr this)
              (let [trueJumps (.branch code ByteCodes/goto_)]
                (.endFinalizerGaps this env localEnv)
                (.resolve code falseJumps)
                (set! targetEnv (.unwindBreak this (.-target tree)))
                (.reloadStackBeforeSwitchExpr this)
                (set! falseJumps (.branch code ByteCodes/goto_))
                (if (nil? switchExpressionTrueChain)
                    (set! switchExpressionTrueChain trueJumps)
                    (set! switchExpressionTrueChain
                          (Code/mergeChains switchExpressionTrueChain trueJumps)))
                (if (nil? switchExpressionFalseChain)
                    (set! switchExpressionFalseChain falseJumps)
                    (set! switchExpressionFalseChain
                          (Code/mergeChains switchExpressionFalseChain falseJumps))))))
          (do
            (.load (.genExpr this (.-value tree) pt))
            (when (some? switchResult) (.store switchResult))
            (set! targetEnv (.unwindBreak this (.-target tree)))
            (when (.isAlive code)
              (.reloadStackBeforeSwitchExpr this)
              (when (some? switchResult) (.load switchResult))
              (.addExit (cast GenContext (.-info targetEnv)) (.branch code ByteCodes/goto_))
              (.markDead code))))
      (.endFinalizerGaps this env targetEnv)))

  (method ^:private unwindBreak ^{:tag (Env GenContext)} [this ^JCTree target]
    (let [tmpPos (.-pendingStatPos code)
          ^{:tag (Env GenContext)} targetEnv (.unwind this target env)]
      (set! (.-pendingStatPos code) tmpPos)
      targetEnv))

  (method ^:private reloadStackBeforeSwitchExpr ^void [this]
    (for-each [^Items$LocalItem li stackBeforeSwitchExpression] (.load li)))

  (method ^:public visitContinue ^void [this ^JCTree$JCContinue tree]
    (let [tmpPos (.-pendingStatPos code)
          ^{:tag (Env GenContext)} targetEnv (.unwind this (.-target tree) env)]
      (set! (.-pendingStatPos code) tmpPos)
      (Assert/check (.isStatementStart code))
      (.addCont (cast GenContext (.-info targetEnv)) (.branch code ByteCodes/goto_))
      (.endFinalizerGaps this env targetEnv)))

  (method ^:public visitReturn ^void [this ^JCTree$JCReturn tree]
    (let [limit (.-nextreg code)
          ^:mutable ^{:tag (Env GenContext)} targetEnv nil
          tmpPos (.-pendingStatPos code)]
      (if (some? (.-expr tree))
          (do
            (Assert/check (.isStatementStart code))
            (let [^:mutable r (.load (.genExpr this (.-expr tree) pt))]
              (when (.hasFinally this (.-enclMethod env) env)
                (set! r (.makeTemp this pt))
                (.store r))
              (set! targetEnv (.unwind this (.-enclMethod env) env))
              (set! (.-pendingStatPos code) tmpPos)
              (.load r)
              (.emitop0 code
                        (unchecked-add-int ByteCodes/ireturn (Code/truncate (Code/typecode pt))))))
          (do
            (set! targetEnv (.unwind this (.-enclMethod env) env))
            (set! (.-pendingStatPos code) tmpPos)
            (.emitop0 code ByteCodes/return_)))
      (.endFinalizerGaps this env targetEnv)
      (.endScopes code limit)))

  (method ^:public visitThrow ^void [this ^JCTree$JCThrow tree]
    (Assert/check (.isStatementStart code))
    (.load (.genExpr this (.-expr tree) (.-type (.-expr tree))))
    (.emitop0 code ByteCodes/athrow)
    (Assert/check (.isStatementStart code)))

  (method ^:public visitApply ^void [this ^JCTree$JCMethodInvocation tree]
    (.setTypeAnnotationPositions this (.-pos tree))
    (let [m (.genExpr this (.-meth tree) methodType)
          msym (cast Symbol$MethodSymbol (TreeInfo/symbol (.-meth tree)))]
      (.genArgs this (.-args tree) (.getParameterTypes (.externalType msym types)))
      (when-not (.isDynamic msym) (.statBegin code (.-pos tree)))
      (arbace.core/cond (.contains (.invocations patternMatchingCatchConfiguration) tree)
                        (let [start (.curCP code)]
                          (set! result (.invoke m))
                          (.add (.ranges patternMatchingCatchConfiguration)
                                (new int/1 [start (.curCP code)])))
                        (and (.isConstructor msym) (TreeInfo/isConstructorCall tree))
                        (do
                          (.generatePatternMatchingCatch this env)
                          (set! result (.invoke m))
                          (set! patternMatchingCatchConfiguration
                                (.restart patternMatchingCatchConfiguration (.dup (.-state code)))))
                        :else
                        (set! result (.invoke m)))))

  (method ^:public visitConditional ^void [this ^JCTree$JCConditional tree]
    (let [^:mutable ^Code$Chain thenExit nil]
      (.statBegin code (.-pos (.-cond tree)))
      (let [c (.genCond this (.-cond tree) CRTFlags/CRT_FLOW_CONTROLLER)
            elseChain (.jumpFalse c)]
        (when-not (.isFalse c)
          (.resolve code (.-trueJumps c))
          (let [^int startpc (if genCrt (.curCP code) 0)]
            (.statBegin code (.-pos (.-truepart tree)))
            (.load (.genExpr this (.-truepart tree) pt))
            (when genCrt
              (.put (.-crt code) (.-truepart tree) CRTFlags/CRT_FLOW_TARGET startpc (.curCP code)))
            (set! thenExit (.branch code ByteCodes/goto_))))
        (when (some? elseChain)
          (.resolve code elseChain)
          (let [^int startpc (if genCrt (.curCP code) 0)]
            (.statBegin code (.-pos (.-falsepart tree)))
            (.load (.genExpr this (.-falsepart tree) pt))
            (when genCrt
              (.put (.-crt code) (.-falsepart tree) CRTFlags/CRT_FLOW_TARGET startpc (.curCP code)))))
        (.resolve code thenExit)
        (set! result (.makeStackItem items pt)))))

  (method ^:private setTypeAnnotationPositions ^void [this ^int treePos]
    (let [meth (.-meth code)
          initOrClinit (or (identical? (.getKind (.-meth code)) ElementKind/CONSTRUCTOR)
                           (identical? (.getKind (.-meth code)) ElementKind/STATIC_INIT))]
      (for-each [^Attribute$TypeCompound ta (.getRawTypeAttributes meth)]
        (when (.hasUnknownPosition ta) (.tryFixPosition ta))
        (when (.matchesPos (.-position ta) treePos) (.updatePosOffset (.-position ta) (.-cp code))))
      (when-not (not initOrClinit)
        (for-each [^Attribute$TypeCompound ta (.getRawTypeAttributes (.-owner meth))]
          (when (.hasUnknownPosition ta) (.tryFixPosition ta))
          (when (.matchesPos (.-position ta) treePos)
            (.updatePosOffset (.-position ta) (.-cp code))))
        (let [clazz (.enclClass meth)]
          (for-each [^Symbol s (FilteredMemberList. (.members clazz))]
            (when-not (not (.isField (.getKind s)))
              (for-each [^Attribute$TypeCompound ta (.getRawTypeAttributes s)]
                (when (.hasUnknownPosition ta) (.tryFixPosition ta))
                (when (.matchesPos (.-position ta) treePos)
                  (.updatePosOffset (.-position ta) (.-cp code))))))))))

  (method ^:public visitNewClass ^void [this ^JCTree$JCNewClass tree]
    (Assert/check (and (nil? (.-encl tree)) (nil? (.-def tree))))
    (.setTypeAnnotationPositions this (.-pos tree))
    (.emitop2 code
              ByteCodes/new_
              (.checkDimension this (.pos tree) (.-type tree))
              (method-ref ToIntBiFunction [PoolWriter Type] PoolWriter/.putClass))
    (.emitop0 code ByteCodes/dup)
    (.genArgs this (.-args tree) (.getParameterTypes (.externalType (.-constructor tree) types)))
    (.invoke (.makeMemberItem items (.-constructor tree) true))
    (set! result (.makeStackItem items (.-type tree))))

  (method ^:public visitNewArray ^void [this ^JCTree$JCNewArray tree]
    (.setTypeAnnotationPositions this (.-pos tree))
    (if (some? (.-elems tree))
        (let [elemtype (.elemtype types (.-type tree))]
          (.loadIntConst this (.length (.-elems tree)))
          (let [arr (.makeNewArray this (.pos tree) (.-type tree) 1)
                ^:mutable ^int i 0]
            (loop [^{:tag (List JCTree$JCExpression)} l (.-elems tree)]
              (when (.nonEmpty l)
                (.duplicate arr)
                (.loadIntConst this i)
                (set! i (unchecked-inc-int i))
                (.load (.genExpr this (cast JCTree (.-head l)) elemtype))
                (.store (.makeIndexedItem items elemtype))
                (recur (.-tail l))))
            (set! result arr)))
        (do
          (loop [^{:tag (List JCTree$JCExpression)} l (.-dims tree)]
            (when (.nonEmpty l)
              (.load (.genExpr this (cast JCTree (.-head l)) (.-intType syms)))
              (recur (.-tail l))))
          (set! result (.makeNewArray this (.pos tree) (.-type tree) (.length (.-dims tree)))))))

  (method makeNewArray ^Items$Item [this ^JCDiagnostic$DiagnosticPosition pos ^Type type ^int ndims]
    (let [elemtype (.elemtype types type)]
      (when (> (.dimensions types type) ClassFile/MAX_DIMENSIONS)
        (.error log pos CompilerProperties$Errors/LimitDimensions)
        (set! nerrs (unchecked-inc-int nerrs)))
      (let [elemcode (Code/arraycode elemtype)]
        (arbace.core/cond (or (== elemcode 0) (and (== elemcode 1) (== ndims 1)))
                          (.emitAnewarray code (.makeRef this pos elemtype) type)
                          (== elemcode 1)
                          (.emitMultianewarray code ndims (.makeRef this pos type) type)
                          :else
                          (.emitNewarray code elemcode type))
        (.makeStackItem items type))))

  (method ^:public visitParens ^void [this ^JCTree$JCParens tree]
    (set! result (.genExpr this (.-expr tree) (.-type (.-expr tree)))))

  (method ^:public visitAssign ^void [this ^JCTree$JCAssign tree]
    (let [l (.genExpr this (.-lhs tree) (.-type (.-lhs tree)))]
      (.load (.genExpr this (.-rhs tree) (.-type (.-lhs tree))))
      (when (.hasTag (.-type (.-rhs tree)) TypeTag/BOT)
        (.forceStackTop (.-state code) (.-type (.-lhs tree))))
      (set! result (.makeAssignItem items l))))

  (method ^:public visitAssignop ^void [this ^JCTree$JCAssignOp tree]
    (let [operator (.-operator tree)
          ^:mutable ^Items$Item l nil]
      (if (== (.-opcode operator) ByteCodes/string_add)
          (set! l (.makeConcat concat tree))
          (do
            (set! l (.genExpr this (.-lhs tree) (.-type (.-lhs tree))))
            (when (or (.hasTag tree JCTree$Tag/PLUS_ASG) (.hasTag tree JCTree$Tag/MINUS_ASG))
              (when-instance [^Items$LocalItem localItem l]
                (when (.isSubRangeOf (.getTag (.-type (.-lhs tree))) TypeTag/INT)
                  (when (.isSubRangeOf (.getTag (.-type (.-rhs tree))) TypeTag/INT)
                    (when (some? (.constValue (.-type (.-rhs tree))))
                      (let [^:mutable ival (.intValue
                                             (cast Number (.constValue (.-type (.-rhs tree)))))]
                        (when (.hasTag tree JCTree$Tag/MINUS_ASG)
                          (set! ival (unchecked-negate-int ival)))
                        (.incr localItem ival)
                        (set! result l)
                        (return)))))))
            (.duplicate l)
            (.load (.coerce l (cast Type (.-head (.getParameterTypes (.-type operator))))))
            (.coerce (.completeBinop this (.-lhs tree) (.-rhs tree) operator) (.-type (.-lhs tree)))))
      (set! result (.makeAssignItem items l))))

  (method ^:public visitUnary ^void [this ^JCTree$JCUnary tree]
    (let [operator (.-operator tree)]
      (if (.hasTag tree JCTree$Tag/NOT)
          (let [od (.genCond this (.-arg tree) false)] (set! result (.negate od)))
          (let [od (.genExpr this
                             (.-arg tree)
                             (cast Type (.-head (.getParameterTypes (.-type operator)))))]
            (switch (.getTag tree)
              POS (set! result (.load od))
              NEG (do (set! result (.load od)) (.emitop0 code (.-opcode operator)))
              COMPL
                (do
                  (set! result (.load od))
                  (.emitMinusOne this (.-typecode od))
                  (.emitop0 code (.-opcode operator)))
              (PREINC PREDEC)
                (do
                  (.duplicate od)
                  (if-instance [^Items$LocalItem localItem od]
                    (if (or (== (.-opcode operator) ByteCodes/iadd)
                            (== (.-opcode operator) ByteCodes/isub))
                        (do
                          (.incr localItem (if (.hasTag tree JCTree$Tag/PREINC) 1 -1))
                          (set! result od))
                        (do
                          (.load od)
                          (.emitop0 code (Gen/one (.-typecode od)))
                          (.emitop0 code (.-opcode operator))
                          (when (and (not (== (.-typecode od) ByteCodes/INTcode))
                                     (== (Code/truncate (.-typecode od)) ByteCodes/INTcode))
                            (.emitop0 code
                                      (unchecked-subtract-int
                                        (unchecked-add-int ByteCodes/int2byte (.-typecode od))
                                        ByteCodes/BYTEcode)))
                          (set! result (.makeAssignItem items od))))
                    (do
                      (.load od)
                      (.emitop0 code (Gen/one (.-typecode od)))
                      (.emitop0 code (.-opcode operator))
                      (when (and (not (== (.-typecode od) ByteCodes/INTcode))
                                 (== (Code/truncate (.-typecode od)) ByteCodes/INTcode))
                        (.emitop0 code
                                  (unchecked-subtract-int
                                    (unchecked-add-int ByteCodes/int2byte (.-typecode od))
                                    ByteCodes/BYTEcode)))
                      (set! result (.makeAssignItem items od)))))
              (POSTINC POSTDEC)
                (do
                  (.duplicate od)
                  (if-instance [^Items$LocalItem localItem od]
                    (if (or (== (.-opcode operator) ByteCodes/iadd)
                            (== (.-opcode operator) ByteCodes/isub))
                        (let [res (.load od)]
                          (.incr localItem (if (.hasTag tree JCTree$Tag/POSTINC) 1 -1))
                          (set! result res))
                        (let [res (.load od)]
                          (.stash od (.-typecode od))
                          (.emitop0 code (Gen/one (.-typecode od)))
                          (.emitop0 code (.-opcode operator))
                          (when (and (not (== (.-typecode od) ByteCodes/INTcode))
                                     (== (Code/truncate (.-typecode od)) ByteCodes/INTcode))
                            (.emitop0 code
                                      (unchecked-subtract-int
                                        (unchecked-add-int ByteCodes/int2byte (.-typecode od))
                                        ByteCodes/BYTEcode)))
                          (.store od)
                          (set! result res)))
                    (let [res (.load od)]
                      (.stash od (.-typecode od))
                      (.emitop0 code (Gen/one (.-typecode od)))
                      (.emitop0 code (.-opcode operator))
                      (when (and (not (== (.-typecode od) ByteCodes/INTcode))
                                 (== (Code/truncate (.-typecode od)) ByteCodes/INTcode))
                        (.emitop0 code
                                  (unchecked-subtract-int
                                    (unchecked-add-int ByteCodes/int2byte (.-typecode od))
                                    ByteCodes/BYTEcode)))
                      (.store od)
                      (set! result res))))
              NULLCHK
                (do
                  (set! result (.load od))
                  (.emitop0 code ByteCodes/dup)
                  (.genNullCheck this tree))
              (Assert/error))))))

  (method ^:private genNullCheck ^void [this ^JCTree tree]
    (.statBegin code (.-pos tree))
    (.callMethod this
                 (.pos tree)
                 (.-objectsType syms)
                 (.-requireNonNull names)
                 (List/of (.-objectType syms))
                 true)
    (.emitop0 code ByteCodes/pop))

  (method ^:public visitBinary ^void [this ^JCTree$JCBinary tree]
    (let [operator (.-operator tree)]
      (if (== (.-opcode operator) ByteCodes/string_add)
          (set! result (.makeConcat concat tree))
          (arbace.core/cond
            (.hasTag tree JCTree$Tag/AND)
            (let [lcond (.genCond this (.-lhs tree) CRTFlags/CRT_FLOW_CONTROLLER)]
              (if (not (.isFalse lcond))
                  (let [falseJumps (.jumpFalse lcond)]
                    (.resolve code (.-trueJumps lcond))
                    (let [rcond (.genCond this (.-rhs tree) CRTFlags/CRT_FLOW_TARGET)]
                      (set! result
                            (.makeCondItem items
                                           (.-opcode rcond)
                                           (.-trueJumps rcond)
                                           (Code/mergeChains falseJumps (.-falseJumps rcond))))))
                  (set! result lcond)))
            (.hasTag tree JCTree$Tag/OR)
            (let [lcond (.genCond this (.-lhs tree) CRTFlags/CRT_FLOW_CONTROLLER)]
              (if (not (.isTrue lcond))
                  (let [trueJumps (.jumpTrue lcond)]
                    (.resolve code (.-falseJumps lcond))
                    (let [rcond (.genCond this (.-rhs tree) CRTFlags/CRT_FLOW_TARGET)]
                      (set! result
                            (.makeCondItem items
                                           (.-opcode rcond)
                                           (Code/mergeChains trueJumps (.-trueJumps rcond))
                                           (.-falseJumps rcond)))))
                  (set! result lcond)))
            :else
            (let [od (.genExpr this
                               (.-lhs tree)
                               (cast Type (.-head (.getParameterTypes (.-type operator)))))]
              (.load od)
              (set! result (.completeBinop this (.-lhs tree) (.-rhs tree) operator)))))))

  (method completeBinop ^Items$Item [this ^JCTree lhs ^JCTree rhs ^Symbol$OperatorSymbol operator]
    (let [optype (cast Type$MethodType (.-type operator))
          ^:mutable opcode (.-opcode operator)]
      (arbace.core/cond
        (and (>= opcode ByteCodes/if_icmpeq) (<= opcode ByteCodes/if_icmple))
        (if-instance [^Number number (.constValue (.-type rhs))]
          (arbace.core/cond (== (.intValue number) 0)
                            (set! opcode
                                  (unchecked-add-int
                                    opcode
                                    (unchecked-subtract-int ByteCodes/ifeq ByteCodes/if_icmpeq)))
                            (and (and (>= opcode ByteCodes/if_acmpeq)
                                      (<= opcode ByteCodes/if_acmpne))
                                 (TreeInfo/isNull rhs))
                            (set! opcode
                                  (unchecked-add-int
                                    opcode
                                    (unchecked-subtract-int
                                      ByteCodes/if_acmp_null
                                      ByteCodes/if_acmpeq)))
                            :else
                            (let [^:mutable rtype (cast
                                                    Type
                                                    (.-head
                                                      (.-tail
                                                        (.getParameterTypes
                                                          (.erasure operator types)))))]
                              (when (and (>= opcode ByteCodes/ishll) (<= opcode ByteCodes/lushrl))
                                (set! opcode
                                      (unchecked-add-int
                                        opcode
                                        (unchecked-subtract-int ByteCodes/ishl ByteCodes/ishll)))
                                (set! rtype (.-intType syms)))
                              (.load (.genExpr this rhs rtype))
                              (when (>= opcode (bit-shift-left-int 1 ByteCodes/preShift))
                                (.emitop0 code (bit-shift-right-int opcode ByteCodes/preShift))
                                (set! opcode (bit-and-int opcode 0xFF)))))
          (if (and (and (>= opcode ByteCodes/if_acmpeq) (<= opcode ByteCodes/if_acmpne))
                   (TreeInfo/isNull rhs))
              (set! opcode
                    (unchecked-add-int opcode
                                       (unchecked-subtract-int
                                         ByteCodes/if_acmp_null
                                         ByteCodes/if_acmpeq)))
              (let [^:mutable rtype (cast
                                      Type
                                      (.-head (.-tail
                                                (.getParameterTypes (.erasure operator types)))))]
                (when (and (>= opcode ByteCodes/ishll) (<= opcode ByteCodes/lushrl))
                  (set! opcode
                        (unchecked-add-int opcode
                                           (unchecked-subtract-int ByteCodes/ishl ByteCodes/ishll)))
                  (set! rtype (.-intType syms)))
                (.load (.genExpr this rhs rtype))
                (when (>= opcode (bit-shift-left-int 1 ByteCodes/preShift))
                  (.emitop0 code (bit-shift-right-int opcode ByteCodes/preShift))
                  (set! opcode (bit-and-int opcode 0xFF))))))
        (and (and (>= opcode ByteCodes/if_acmpeq) (<= opcode ByteCodes/if_acmpne))
             (TreeInfo/isNull rhs))
        (set! opcode
              (unchecked-add-int
                opcode
                (unchecked-subtract-int ByteCodes/if_acmp_null ByteCodes/if_acmpeq)))
        :else
        (let [^:mutable rtype (cast
                                Type
                                (.-head (.-tail (.getParameterTypes (.erasure operator types)))))]
          (when (and (>= opcode ByteCodes/ishll) (<= opcode ByteCodes/lushrl))
            (set!
              opcode
              (unchecked-add-int opcode (unchecked-subtract-int ByteCodes/ishl ByteCodes/ishll)))
            (set! rtype (.-intType syms)))
          (.load (.genExpr this rhs rtype))
          (when (>= opcode (bit-shift-left-int 1 ByteCodes/preShift))
            (.emitop0 code (bit-shift-right-int opcode ByteCodes/preShift))
            (set! opcode (bit-and-int opcode 0xFF)))))
      (if (or (or (and (>= opcode ByteCodes/ifeq) (<= opcode ByteCodes/if_acmpne))
                  (== opcode ByteCodes/if_acmp_null))
              (== opcode ByteCodes/if_acmp_nonnull))
          (.makeCondItem items opcode)
          (do (.emitop0 code opcode) (.makeStackItem items (.-restype optype))))))

  (method ^:public visitTypeCast ^void [this ^JCTree$JCTypeCast tree]
    (set! result (.load (.genExpr this (.-expr tree) (.-type (.-clazz tree)))))
    (.setTypeAnnotationPositions this (.-pos tree))
    (when (and (and (not (.isPrimitive (.-type (.-clazz tree))))
                    (not (.isSameType types (.-type (.-expr tree)) (.-type (.-clazz tree)))))
               (nil? (.asSuper types (.-type (.-expr tree)) (.-tsym (.-type (.-clazz tree))))))
      (.emitop2 code
                ByteCodes/checkcast
                (.checkDimension this (.pos tree) (.-type (.-clazz tree)))
                (method-ref ToIntBiFunction [PoolWriter Type] PoolWriter/.putClass))))

  (method ^:public visitWildcard ^void [this ^JCTree$JCWildcard tree]
    (throw (AssertionError. (.getName (.getClass this)))))

  (method ^:public visitTypeTest ^void [this ^JCTree$JCInstanceOf tree]
    (.load (.genExpr this (.-expr tree) (.-type (.-expr tree))))
    (.setTypeAnnotationPositions this (.-pos tree))
    (.emitop2 code ByteCodes/instanceof_ (.makeRef this (.pos tree) (.-type (.-pattern tree))))
    (set! result (.makeStackItem items (.-booleanType syms))))

  (method ^:public visitIndexed ^void [this ^JCTree$JCArrayAccess tree]
    (.load (.genExpr this (.-indexed tree) (.-type (.-indexed tree))))
    (.load (.genExpr this (.-index tree) (.-intType syms)))
    (set! result (.makeIndexedItem items (.-type tree))))

  (method ^:public visitIdent ^void [this ^JCTree$JCIdent tree]
    (let [^:mutable sym (.-sym tree)]
      (arbace.core/cond
        (or (identical? (.-name tree) (.-_this names)) (identical? (.-name tree) (.-_super names)))
        (let [^:mutable ^Items$Item res (if (identical? (.-name tree) (.-_this names))
                                            (.makeThisItem items)
                                            (.makeSuperItem items))]
          (when (identical? (.-kind sym) Kinds$Kind/MTH)
            (.load res)
            (set! res (.makeMemberItem items sym true)))
          (set! result res))
        (or (.isInvokeDynamic this sym) (.isConstantDynamic this sym))
        (do
          (when (.isConstantDynamic this sym) (.setTypeAnnotationPositions this (.-pos tree)))
          (set! result (.makeDynamicItem items sym)))
        :else
        (arbace.core/cond
          (and (identical? (.-kind sym) Kinds$Kind/VAR)
               (or (identical? (.-kind (.-owner sym)) Kinds$Kind/MTH)
                   (identical? (.-kind (.-owner sym)) Kinds$Kind/VAR)))
          (set! result (.makeLocalItem items (cast Symbol$VarSymbol sym)))
          (not (== (bit-and (.flags sym) Flags/STATIC) 0))
          (do
            (when-not (.isAccessSuper this (.-enclMethod env))
              (set! sym (.binaryQualifier this sym (.-type (.-enclClass env)))))
            (set! result (.makeStaticItem items sym)))
          :else
          (do
            (.load (.makeThisItem items))
            (set! sym (.binaryQualifier this sym (.-type (.-enclClass env))))
            (set! result (.makeMemberItem items sym (.nonVirtualForPrivateAccess this sym))))))))

  (method ^:private nonVirtualForPrivateAccess ^boolean [this ^Symbol sym]
    (let [useVirtual (and (.hasVirtualPrivateInvoke target) (not disableVirtualizedPrivateInvoke))]
      (and (not useVirtual) (not (== (bit-and (.flags sym) Flags/PRIVATE) 0)))))

  (method ^:public visitSelect ^void [this ^JCTree$JCFieldAccess tree]
    (let [^:mutable sym (.-sym tree)]
      (if (identical? (.-name tree) (.-_class names))
          (do
            (.emitLdc code
                      (cast PoolConstant$LoadableConstant
                            (.checkDimension this (.pos tree) (.-type (.-selected tree)))))
            (set! result (.makeStackItem items pt)))
          (let [ssym (TreeInfo/symbol (.-selected tree))
                selectSuper (and (some? ssym)
                                 (or (identical? (.-kind ssym) Kinds$Kind/TYP)
                                     (identical? (.-name ssym) (.-_super names))))
                accessSuper (.isAccessSuper this (.-enclMethod env))
                ^:mutable ^Items$Item base (if selectSuper
                                               (.makeSuperItem items)
                                               (.genExpr
                                                 this
                                                 (.-selected tree)
                                                 (.-type (.-selected tree))))]
            (arbace.core/cond
              (and (identical? (.-kind sym) Kinds$Kind/VAR)
                   (some? (.getConstValue (cast Symbol$VarSymbol sym))))
              (do
                (if (not (== (bit-and (.flags sym) Flags/STATIC) 0))
                    (do
                      (when (and (not selectSuper)
                                 (or (nil? ssym) (not (identical? (.-kind ssym) Kinds$Kind/TYP))))
                        (set! base (.load base)))
                      (.drop base))
                    (do (.load base) (.genNullCheck this (.-selected tree))))
                (set! result
                      (.makeImmediateItem items
                                          (.-type sym)
                                          (.getConstValue (cast Symbol$VarSymbol sym)))))
              (.isInvokeDynamic this sym)
              (set! result (.makeDynamicItem items sym))
              :else
              (do
                (set! sym (.binaryQualifier this sym (.-type (.-selected tree))))
                (if (not (== (bit-and (.flags sym) Flags/STATIC) 0))
                    (do
                      (when (and (not selectSuper)
                                 (or (nil? ssym) (not (identical? (.-kind ssym) Kinds$Kind/TYP))))
                        (set! base (.load base)))
                      (.drop base)
                      (set! result (.makeStaticItem items sym)))
                    (do
                      (.load base)
                      (if (identical? sym (.-lengthVar syms))
                          (do
                            (.emitop0 code ByteCodes/arraylength)
                            (set! result (.makeStackItem items (.-intType syms))))
                          (set! result
                                (.makeMemberItem
                                  items
                                  sym
                                  (or (or (.nonVirtualForPrivateAccess this sym) selectSuper)
                                      accessSuper))))))))))))

  (method ^:public isInvokeDynamic ^boolean [this ^Symbol sym]
    (and (identical? (.-kind sym) Kinds$Kind/MTH) (.isDynamic (cast Symbol$MethodSymbol sym))))

  (method ^:public visitLiteral ^void [this ^JCTree$JCLiteral tree]
    (if (.hasTag (.-type tree) TypeTag/BOT)
        (do
          (.emitop0 code ByteCodes/aconst_null)
          (set! result (.makeStackItem items (.-type tree))))
        (set! result (.makeImmediateItem items (.-type tree) (.-value tree)))))

  (method ^:public visitLetExpr ^void [this ^JCTree$LetExpr tree]
    (.resolvePending code)
    (let [limit (.-nextreg code)
          prevLetExprStart (.setLetExprStackPos code (.-stacksize (.-state code)))]
      (try (.genStats this (.-defs tree) env) (finally (.setLetExprStackPos code prevLetExprStart)))
      (set! result (.load (.genExpr this (.-expr tree) (.-type (.-expr tree)))))
      (.endScopes code limit)))

  (method ^:private generateReferencesToPrunedTree ^void [this ^Symbol$ClassSymbol classSymbol]
    (let [^{:tag (List JCTree)} prunedInfo (cast List (.get (.-prunedTree lower) classSymbol))]
      (when (some? prunedInfo)
        (for-each [^JCTree prunedTree prunedInfo] (.accept prunedTree classReferenceVisitor)))))

  (method ^:public genClass ^boolean [this ^{:tag (Env AttrContext)} env ^JCTree$JCClassDecl cdef]
    (try
      (set! attrEnv env)
      (let [c (.-sym cdef)]
        (set! (.-toplevel this) (.-toplevel env))
        (set! (.-endPosTable this) (.-endPositions toplevel))
        (set! (.-defs cdef) (.normalizeDefs this (.-defs cdef) c))
        (.generateReferencesToPrunedTree this c)
        (let [^{:tag (Env GenContext)} localEnv (Env. cdef (GenContext.))]
          (set! (.-toplevel localEnv) (.-toplevel env))
          (set! (.-enclClass localEnv) cdef)
          (loop [^{:tag (List JCTree)} l (.-defs cdef)]
            (when (.nonEmpty l) (.genDef this (cast JCTree (.-head l)) localEnv) (recur (.-tail l))))
          (when (> (.size poolWriter) PoolWriter/MAX_ENTRIES)
            (.error log (.pos cdef) CompilerProperties$Errors/LimitPool)
            (set! nerrs (unchecked-inc-int nerrs)))
          (when-not (== nerrs 0)
            (loop [^{:tag (List JCTree)} l (.-defs cdef)]
              (if (.nonEmpty l)
                  (if (.hasTag (cast JCTree (.-head l)) JCTree$Tag/METHODDEF)
                      (do
                        (set! (.-code (.-sym (cast JCTree$JCMethodDecl (.-head l)))) nil)
                        (recur (.-tail l)))
                      (recur (.-tail l)))
                  nil)))
          (set! (.-defs cdef) (List/nil))
          (== nerrs 0)))
      (finally
        (set! attrEnv nil)
        (set! (.-env this) nil)
        (set! toplevel nil)
        (set! endPosTable nil)
        (set! nerrs 0)
        (.clear qualifiedSymbolCache))))

  (defclass ^:abstract GenFinalizer
    (method ^:abstract gen ^void [this])

    (method ^:abstract genLast ^void [this])

    (method hasFinalizer ^boolean [this] true)

    (method afterBody ^void [this]))

  (defclass ^:final GenContext
    (field ^:final ^int limit)

    (field ^Code$Chain exit nil)

    (field ^Code$Chain cont nil)

    (field ^GenFinalizer finalize nil)

    (field ^boolean isSwitch false)

    (field ^{:tag (ListBuffer Integer)} gaps nil)

    (constructor [this]
      (let [code (.-code Gen/this)] (set! (.-limit this) (if (nil? code) 0 (.-nextreg code)))))

    (method addExit ^void [this ^Code$Chain c]
      (when (some? c) (.excludeFrom (.-defined (.-state c)) limit))
      (set! exit (Code/mergeChains c exit)))

    (method addCont ^void [this ^Code$Chain c]
      (when (some? c) (.excludeFrom (.-defined (.-state c)) limit))
      (set! cont (Code/mergeChains c cont))))

  (defclass ^:record PatternMatchingCatchConfiguration [^{:tag (Set JCTree$JCMethodInvocation)} invocations
                                                        ^{:tag (ListBuffer int/1)} ranges
                                                        ^JCTree$JCCatch handler
                                                        ^Code$State startState]
    (method ^:public restart ^PatternMatchingCatchConfiguration [this ^Code$State newState]
      (PatternMatchingCatchConfiguration. (.invocations this)
                                          (ListBuffer.)
                                          (.handler this)
                                          newState))))

  (method ^:public genCond ^Items$CondItem [this ^JCTree _tree ^boolean markBranches]
    (let [inner_tree (TreeInfo/skipParens _tree)]
      (if (.hasTag inner_tree JCTree$Tag/CONDEXPR)
          (let [tree (cast JCTree$JCConditional inner_tree)
                cond (.genCond this (.-cond tree) CRTFlags/CRT_FLOW_CONTROLLER)]
            (arbace.core/cond (.isTrue cond)
                              (do
                                (.resolve code (.-trueJumps cond))
                                (let [result (.genCond
                                               this
                                               (.-truepart tree)
                                               CRTFlags/CRT_FLOW_TARGET)]
                                  (when markBranches (set! (.-tree result) (.-truepart tree)))
                                  result))
                              (.isFalse cond)
                              (do
                                (.resolve code (.-falseJumps cond))
                                (let [result (.genCond
                                               this
                                               (.-falsepart tree)
                                               CRTFlags/CRT_FLOW_TARGET)]
                                  (when markBranches (set! (.-tree result) (.-falsepart tree)))
                                  result))
                              :else
                              (let [secondJumps (.jumpFalse cond)]
                                (.resolve code (.-trueJumps cond))
                                (let [first (.genCond
                                              this
                                              (.-truepart tree)
                                              CRTFlags/CRT_FLOW_TARGET)]
                                  (when markBranches (set! (.-tree first) (.-truepart tree)))
                                  (let [falseJumps (.jumpFalse first)]
                                    (.resolve code (.-trueJumps first))
                                    (let [trueJumps (.branch code ByteCodes/goto_)]
                                      (.resolve code secondJumps)
                                      (let [second (.genCond
                                                     this
                                                     (.-falsepart tree)
                                                     CRTFlags/CRT_FLOW_TARGET)
                                            result (.makeCondItem
                                                     items
                                                     (.-opcode second)
                                                     (Code/mergeChains
                                                       trueJumps
                                                       (.-trueJumps second))
                                                     (Code/mergeChains
                                                       falseJumps
                                                       (.-falseJumps second)))]
                                        (when markBranches
                                          (set! (.-tree result) (.-falsepart tree)))
                                        result)))))))
          (arbace.core/cond
            (.hasTag inner_tree JCTree$Tag/SWITCH_EXPRESSION)
            (do
              (.resolvePending code)
              (let [prevInCondSwitchExpression inCondSwitchExpression
                    prevSwitchExpressionTrueChain switchExpressionTrueChain
                    prevSwitchExpressionFalseChain switchExpressionFalseChain]
                (try
                  (set! inCondSwitchExpression true)
                  (set! switchExpressionTrueChain nil)
                  (set! switchExpressionFalseChain nil)
                  (try
                    (.doHandleSwitchExpression this (cast JCTree$JCSwitchExpression inner_tree))
                    (catch Symbol$CompletionFailure ex
                      (.completionError chk (.pos _tree) ex)
                      (set! (.-stacksize (.-state code)) 1)))
                  (let [result (.makeCondItem items
                                              ByteCodes/goto_
                                              switchExpressionTrueChain
                                              switchExpressionFalseChain)]
                    (when markBranches (set! (.-tree result) _tree))
                    result)
                  (finally
                    (set! inCondSwitchExpression prevInCondSwitchExpression)
                    (set! switchExpressionTrueChain prevSwitchExpressionTrueChain)
                    (set! switchExpressionFalseChain prevSwitchExpressionFalseChain)))))

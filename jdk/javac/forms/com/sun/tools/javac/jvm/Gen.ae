              (.resolvePending code)
              (let [tree (cast JCTree$LetExpr inner_tree)
                    limit (.-nextreg code)
                    prevLetExprStart (.setLetExprStackPos code (.-stacksize (.-state code)))]
                (try
                  (.genStats this (.-defs tree) env)
                  (finally (.setLetExprStackPos code prevLetExprStart)))
                (let [result (.genCond this (.-expr tree) markBranches)]
                  (.endScopes code limit)
                  (.undefineVariablesInChain this (.-falseJumps result) limit)
                  (.undefineVariablesInChain this (.-trueJumps result) limit)
                  result)))
            :else
            (let [result (.mkCond (.genExpr this _tree (.-booleanType syms)))]

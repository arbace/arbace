                                              (CompilerProperties$Errors/BadValueForOption
                                                option
                                                arg)))))
      (method ^:public getPattern ^Pattern [this]
        (Pattern/compile "([^/]+)/([^=]+)=(,*[^,].*)")))
    (ADD_OPENS ["--add-opens" nil nil OptionKind/HIDDEN OptionGroup/BASIC])

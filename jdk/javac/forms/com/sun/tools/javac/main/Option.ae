                         helper
                         (CompilerProperties$Errors/BadValueForOption option arg))))))
        (.process super helper option arg)))
    (AT ["@" "opt.arg.file" "opt.AT" OptionKind/STANDARD OptionGroup/INFO ArgKind/ADJACENT]
        (method ^:public process ^void [this ^OptionHelper helper ^String option]
          (throw (AssertionError. "the @ flag should be caught by CommandLine."))))
    (SOURCEFILE ["sourcefile" nil OptionKind/HIDDEN OptionGroup/INFO]
                (method ^:public matches ^boolean [this ^String s]
                  (if (.endsWith s ".java")
                      true
                      (let [sep (.indexOf s \/)]
                        (if (not (== sep -1))
                            (and (SourceVersion/isName (.substring s 0 sep))
                                 (SourceVersion/isName (.substring s (unchecked-add-int sep 1))))
                            (SourceVersion/isName s)))))
                (method ^:public process :throws [InvalidValueException] ^void [this
                                                                                ^OptionHelper helper
                                                                                ^String option]
                  (if (.endsWith option ".java")
                      (try
                        (let [p (Paths/get option (new String/1 []))]
                          (when-not (Files/exists p)
                            (throw (.newInvalidValueException
                                     helper
                                     (CompilerProperties$Errors/FileNotFound (.toString p)))))
                          (when-not (Files/isRegularFile p)
                            (throw (.newInvalidValueException
                                     helper
                                     (CompilerProperties$Errors/FileNotFile p))))
                          (.addFile helper p))
                        (catch InvalidPathException ex
                          (throw (.newInvalidValueException
                                   helper
                                   (CompilerProperties$Errors/InvalidPath option)))))
                      (.addClassName helper option))))
    (MULTIRELEASE ["--multi-release" "opt.arg.multi-release" "opt.multi-release" OptionKind/HIDDEN
                   OptionGroup/FILEMANAGER])
    (INHERIT_RUNTIME_ENVIRONMENT
      ["--inherit-runtime-environment" "opt.inherit_runtime_environment" OptionKind/HIDDEN
       OptionGroup/BASIC]
      (method ^:public process :throws [InvalidValueException] ^void [this ^OptionHelper helper
                                                                      ^String option]
        (let [runtimeArgs (VM/getRuntimeArguments)]
          (for-each [^String arg runtimeArgs]
            (for-each [^Option o (.getSupportedRuntimeOptions this)]
              (when (.matches o arg)
                (switch o
                  ADD_MODULES
                    (let [eq (.indexOf arg \=)]
                      (Assert/check (> eq 0)
                                    (lambda Supplier ^String []
                                      (java-str "invalid runtime option:" arg)))
                      (let [mods (cast String
                                       (.collect
                                         (.filter
                                           (Arrays/stream
                                             (.split (.substring arg (unchecked-add-int eq 1)) ","))
                                           (lambda Predicate ^boolean [^String s]
                                             (and
                                               (not (.isEmpty s))
                                               (not (.equals s "ALL-DEFAULT")))))
                                         (Collectors/joining ",")))]
                        (when-not (.isEmpty mods)
                          (let [updatedArg (java-str
                                             (.substring arg 0 (unchecked-add-int eq 1))
                                             mods)]
                            (.handleOption o helper updatedArg (Collections/emptyIterator))))))
                  (.handleOption o helper arg (Collections/emptyIterator)))
                (break))))))
      (method ^:private getSupportedRuntimeOptions ^Option/1 [this]
        (let [supportedRuntimeOptions (new Option/1
                                           [ADD_EXPORTS ADD_MODULES LIMIT_MODULES MODULE_PATH
                                            UPGRADE_MODULE_PATH PATCH_MODULE])]
          supportedRuntimeOptions))))

  (field ^:public ^:static ^:final ^String LINT_CUSTOM_ALL "all")

  (field ^:public ^:static ^:final ^String LINT_CUSTOM_NONE "none")

  (defclass ^:public ^:static InvalidValueException
    :extends Exception

    (field ^:private ^:static ^:final ^long serialVersionUID -1)

    (constructor ^:public [this ^String msg] (super. msg))

    (constructor ^:public [this ^String msg ^Throwable cause]
      (super. msg cause)))

  (defclass ^:public ^:enum ArgKind
    (constants NONE REQUIRED ADJACENT))

  (defclass ^:public ^:enum OptionKind
    (constants STANDARD EXTENDED HIDDEN))

  (defclass ^:enum OptionGroup
    (constants BASIC FILEMANAGER INFO OPERAND))

  (defclass ^:enum ChoiceKind
    (constants ONEOF ANYOF))

  (defclass ^:enum HiddenGroup
    (constants (DIAGS ["diags"]) (DEBUG ["debug"]) (SHOULDSTOP ["should-stop"]))

    (field ^:final ^String text)

    (constructor [this ^String text] (set! (.-text this) text))

    (method ^:public process :throws [InvalidValueException] ^void [this ^OptionHelper helper
                                                                    ^String option ^String arg]
      (let [subOptions (.split arg ";")]
        (for-each [^:mutable ^String subOption subOptions]
          (set! subOption (java-str text "." (.trim subOption)))
          (.process XD helper subOption subOption)))))

  (field ^:public ^:final ^String primaryName)

  (field ^:public ^:final ^String/1 names)

  (field ^:protected ^:final ^String argsNameKey)

  (field ^:protected ^:final ^String descrKey)

  (field ^:private ^:final ^OptionKind kind)

  (field ^:private ^:final ^OptionGroup group)

  (field ^:private ^:final ^ArgKind argKind)

  (field ^:private ^:final ^ChoiceKind choiceKind)

  (field ^:private ^:final ^{:tag (Set String)} choices)

  (method ^:public ^:static lookup ^Option [^String arg]
    (Option/lookup arg (EnumSet/allOf Option)))

  (method ^:public ^:static lookup ^Option [^String arg ^{:tag (Set Option)} options]
    (for-each [^Option option options] (when (.matches option arg) (return option)))
    nil)

  (method ^:private ^:static showHelp ^void [^Log log ^OptionKind kind]
    (let [^{:tag (Comparator Option)} comp (anon (Comparator Option) []
                                             (field ^:final ^Collator collator
                                               (Collator/getInstance Locale/US))

                                             (initializer (.setStrength collator Collator/PRIMARY))

                                             (method ^:public compare ^int [this ^Option o1
                                                                            ^Option o2]
                                               (.compare
                                                 collator
                                                 (.-primaryName o1)
                                                 (.-primaryName o2))))]
      (.forEach (.sorted (.filter (.stream (Option/getJavaCompilerOptions))
                                  (lambda Predicate ^boolean [^Option o]
                                    (identical? (.-kind o) kind)))
                         comp)
                (lambda Consumer ^void [^Option o] (.help o log)))))

  (constructor [this ^String text ^String descrKey ^OptionKind kind ^OptionGroup group]
    (this. text nil descrKey kind group nil nil ArgKind/NONE))

  (constructor [this ^String text ^String descrKey ^OptionKind kind ^OptionGroup group
                ^ArgKind argKind]
    (this. text nil descrKey kind group nil nil argKind))

  (constructor [this ^String text ^String argsNameKey ^String descrKey ^OptionKind kind
                ^OptionGroup group]
    (this. text argsNameKey descrKey kind group nil nil ArgKind/REQUIRED))

  (constructor [this ^String text ^String argsNameKey ^String descrKey ^OptionKind kind
                ^OptionGroup group ^ArgKind ak]
    (this. text argsNameKey descrKey kind group nil nil ak))

  (constructor [this ^String text ^String argsNameKey ^String descrKey ^OptionKind kind
                ^OptionGroup group ^ChoiceKind choiceKind ^{:tag (Set String)} choices]
    (this. text argsNameKey descrKey kind group choiceKind choices ArgKind/REQUIRED))

  (constructor [this ^String text ^String descrKey ^OptionKind kind ^OptionGroup group
                ^ChoiceKind choiceKind & ^String/1 choices]
    (this. text
           nil
           descrKey
           kind
           group
           choiceKind
           (LinkedHashSet. (Arrays/asList choices))
           ArgKind/REQUIRED))

  (constructor ^:private [this ^String text ^String argsNameKey ^String descrKey ^OptionKind kind
                          ^OptionGroup group ^ChoiceKind choiceKind ^{:tag (Set String)} choices
                          ^ArgKind argKind]
    (set! (.-names this) (.split (.trim text) "\\s+"))
    (Assert/check (>= (alength names) 1))
    (set! (.-primaryName this) (aget names 0))
    (set! (.-argsNameKey this) argsNameKey)
    (set! (.-descrKey this) descrKey)
    (set! (.-kind this) kind)
    (set! (.-group this) group)
    (set! (.-choiceKind this) choiceKind)
    (set! (.-choices this) choices)
    (set! (.-argKind this) argKind))

  (method ^:public getPrimaryName ^String [this] primaryName)

  (method ^:public getKind ^OptionKind [this] kind)

  (method ^:public getCustom ^Option [this]
    (Option/valueOf (java-str (.name this) "_CUSTOM")))

  (method ^:public getLintCustom ^Option [this]
    (if (or (identical? this XLINT) (identical? this WERROR))
        (.getCustom this)
        (throw (IllegalArgumentException.))))

  (method ^:public isInBasicOptionGroup ^boolean [this]
    (identical? group OptionGroup/BASIC))

  (method ^:public getArgKind ^ArgKind [this] argKind)

  (method ^:public hasArg ^boolean [this]
    (not (identical? argKind ArgKind/NONE)))

  (method ^:public hasSeparateArg ^boolean [this]
    (and (and (identical? (.getArgKind this) ArgKind/REQUIRED) (not (.endsWith primaryName ":")))
         (not (.endsWith primaryName "="))))

  (method ^:public matches ^boolean [this ^String option]
    (for-each [^String name names] (when (.matches this option name) (return true)))
    false)

  (method ^:private matches ^boolean [this ^String option ^String name]
    (if (.startsWith name "--")
        (or (.equals option name) (and (.hasArg this) (.startsWith option (java-str name "="))))
        (let [hasSuffix (or (or (identical? argKind ArgKind/ADJACENT) (.endsWith name ":"))
                            (.endsWith name "="))]
          (cond
            (not hasSuffix) (.equals option name)
            (not (.startsWith option name)) false
            :else
              (do
                (when (some? choices)
                  (let [arg (.substring option (.length name))]
                    (if (identical? choiceKind ChoiceKind/ONEOF)
                        (return (.contains choices arg))
                        (for-each [^String a (.split arg ",+")]
                          (when-not (.contains choices a) (return false))))))
                true)))))

  (method ^:public handleOption :throws [InvalidValueException] ^void [this ^OptionHelper helper
                                                                       ^String arg
                                                                       ^{:tag (Iterator String)} rest]
    (.initialize helper)
    (if (.hasArg this)
        (let [^:mutable ^String option nil
              ^:mutable ^String operand nil
              sep (Option/findSeparator arg)]
          (cond
            (identical? (.getArgKind this) ArgKind/ADJACENT)
              (do (set! option primaryName) (set! operand (.substring arg (.length primaryName))))
            (> sep 0)
              (do
                (set! option (.substring arg 0 sep))
                (set! operand (.substring arg (unchecked-add-int sep 1))))
            :else
              (do
                (when-not (.hasNext rest)
                  (throw (.newInvalidValueException
                           helper
                           (CompilerProperties$Errors/ReqArg (.-primaryName this)))))
                (set! option arg)
                (set! operand (cast String (.next rest)))))
          (.process this helper option operand))
        (when-not (and (or (or (or (or (identical? this HELP) (identical? this X))
                                   (identical? this HELP_LINT))
                               (identical? this VERSION))
                           (identical? this FULLVERSION))
                       (some? (.get helper this)))
          (.process this helper arg))))

  (method ^:public process :throws [InvalidValueException] ^void [this ^OptionHelper helper
                                                                  ^String option]
    (if (identical? argKind ArgKind/NONE)
        (.process this helper primaryName option)
        (let [sep (Option/findSeparator option)]
          (.process this helper primaryName (.substring option (unchecked-add-int sep 1))))))

  (method ^:public process :throws [InvalidValueException] ^void [this ^OptionHelper helper
                                                                  ^String option ^String arg]
    (.initialize helper)
    (when (some? choices)
      (if (identical? choiceKind ChoiceKind/ONEOF)
          (do
            (for-each [^String s choices] (.remove helper (java-str primaryName s)))
            (let [opt (java-str primaryName arg)]
              (.put helper opt opt)
              (let [nm (.substring primaryName 0 (unchecked-subtract-int (.length primaryName) 1))]
                (.put helper nm arg))))
          (for-each [^String a (.split arg ",+")]
            (let [opt (java-str primaryName a)] (.put helper opt opt)))))
    (.put helper primaryName arg)
    (when (identical? group OptionGroup/FILEMANAGER) (.handleFileManagerOption helper this arg)))

  (method ^:public getPattern ^Pattern [this]
    (throw (UnsupportedOperationException.)))

  (method ^:private ^:static findSeparator ^int [^String word]
    (loop [^int i 0]
      (when (< i (.length word))
        (switch (.charAt word i) (\: \=) (return i) (recur (unchecked-inc-int i)))))
    -1)

  (field ^:private ^:static ^:final ^String SMALL_INDENT "  ")

  (field ^:private ^:static ^:final ^String LARGE_INDENT "        ")

  (field ^:private ^:static ^:final ^int DEFAULT_SYNOPSIS_WIDTH 28)

  (field ^:private ^:static ^:final ^int DEFAULT_MAX_LINE_LENGTH 80)

  (field ^:private ^:static ^:final ^String COMPACT_FORMAT
    (java-str (java-str (java-str SMALL_INDENT "%-") DEFAULT_SYNOPSIS_WIDTH) "s %s"))

  (method ^:protected help ^void [this ^Log log]
    (.help this log (.localize log Log$PrefixKind/JAVAC descrKey (new Object/1 []))))

  (method ^:protected help ^void [this ^Log log ^String descr]
    (let [synopses (cast String
                         (.collect (.map (Arrays/stream names)
                                         (lambda Function ^String [^String s]
                                           (.helpSynopsis this s log)))
                                   (Collectors/joining ", ")))]
      (if (and (and (< (.length synopses) DEFAULT_SYNOPSIS_WIDTH) (not (.contains descr "\n")))
               (<= (unchecked-add-int
                     (unchecked-add-int
                       (unchecked-add-int (.length SMALL_INDENT) DEFAULT_SYNOPSIS_WIDTH)
                       1)
                     (.length descr))
                   DEFAULT_MAX_LINE_LENGTH))
          (.printRawLines log
                          Log$WriterKind/STDOUT
                          (String/format COMPACT_FORMAT (new Object/1 [synopses descr])))
          (do
            (if (<= (.length synopses) DEFAULT_MAX_LINE_LENGTH)
                (.printRawLines log Log$WriterKind/STDOUT (java-str SMALL_INDENT synopses))
                (for-each [^String name names]
                  (.printRawLines log
                                  Log$WriterKind/STDOUT
                                  (java-str SMALL_INDENT (.helpSynopsis this name log)))))
            (.printRawLines log
                            Log$WriterKind/STDOUT
                            (java-str LARGE_INDENT
                                      (.replace descr "\n" (java-str "\n" LARGE_INDENT))))))))

  (method ^:private ^:static formatAbbreviatedList ^String [^{:tag (Collection String)} values]
    (let [^{:tag (java.util.List String)} list (if (instance? java.util.List values)
                                                   (cast java.util.List values)
                                                   ^java.util.List (ArrayList. values))
          size (.size list)]
      (cond
        (== size 0) ""
        (<= size 6) (String/join ", " list)
        :else
          (let [sj (StringJoiner. ", ")]
            (loop [^int i 0]
              (when (< i 3)
                (.add sj (cast CharSequence (.get list i)))
                (recur (unchecked-inc-int i))))
            (.add sj "...")
            (loop [^int i (unchecked-subtract-int size 3)]
              (when (< i size)
                (.add sj (cast CharSequence (.get list i)))
                (recur (unchecked-inc-int i))))
            (.toString sj)))))

  (method ^:private helpSynopsis ^String [this ^String name ^Log log]
    (let [sb (StringBuilder.)]
      (.append sb name)
      (if (nil? argsNameKey)
          (when (some? choices)
            (when-not (.endsWith name ":") (.append sb " "))
            (let [^:mutable sep "{"]
              (for-each [^String choice choices]
                (.append sb sep)
                (.append sb choice)
                (set! sep ","))
              (.append sb "}")))
          (do
            (when (and (not (.matches name ".*[=:]$")) (not (identical? argKind ArgKind/ADJACENT)))
              (.append sb " "))
            (.append sb (.localize log Log$PrefixKind/JAVAC argsNameKey (new Object/1 [])))))
      (.toString sb)))

  (defclass ^:public ^:enum PkgInfo
    (constants ALWAYS LEGACY NONEMPTY)

    (method ^:public ^:static get ^PkgInfo [^Options options]
      (let [v (.get options XPKGINFO)]
        (if (nil? v) PkgInfo/LEGACY (PkgInfo/valueOf (StringUtils/toUpperCase v))))))

  (method ^:private ^:static getXLintChoices ^{:tag (Set String)} []
    (let [^{:tag (Set String)} choices (LinkedHashSet.)]
      (.add choices LINT_CUSTOM_ALL)
      (.forEach (.flatMap (.stream (Lint$LintCategory/options))
                          (lambda Function ^Stream [^String ident]
                            (Stream/of (new String/1 [ident (java-str "-" ident)]))))
                (method-ref Consumer [String] choices Set/.add))
      (.add choices LINT_CUSTOM_NONE)
      choices))

  (method ^:static getJavaCompilerOptions ^{:tag (Set Option)} []
    (EnumSet/allOf Option))

  (method ^:public ^:static getJavacFileManagerOptions ^{:tag (Set Option)} []
    (Option/getOptions OptionGroup/FILEMANAGER))

  (method ^:public ^:static getJavacToolOptions ^{:tag (Set Option)} []
    (Option/getOptions OptionGroup/BASIC))

  (method ^:private ^:static getOptions ^{:tag (Set Option)} [^OptionGroup group]
    (cast
      Set
      (.collect (.filter (Arrays/stream (Option/values))
                         (lambda Predicate ^boolean [^Option o] (identical? (.-group o) group)))
                (Collectors/toCollection (lambda Supplier ^EnumSet [] (EnumSet/noneOf Option)))))))

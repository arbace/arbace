           (method ^:public process :throws [InvalidValueException] ^void [this ^OptionHelper helper
                                                                           ^String option
                                                                           ^String arg]
             (.process HiddenGroup/DEBUG helper option arg)))
    (SHOULDSTOP ["--should-stop" nil OptionKind/HIDDEN OptionGroup/BASIC ArgKind/REQUIRED]
                (method ^:public process :throws [InvalidValueException] ^void [this
                                                                                ^OptionHelper helper
                                                                                ^String option
                                                                                ^String arg]

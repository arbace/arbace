    (DIAGS ["--diags" nil OptionKind/HIDDEN OptionGroup/BASIC ArgKind/REQUIRED]
           (method ^:public process :throws [InvalidValueException] ^void [this ^OptionHelper helper
                                                                           ^String option
                                                                           ^String arg]
             (.process HiddenGroup/DIAGS helper option arg)))
    (XD ["-XD" nil OptionKind/HIDDEN OptionGroup/BASIC]
        (method ^:public matches ^boolean [this ^String s]
          (.startsWith s (.-primaryName this)))
        (method ^:public process ^void [this ^OptionHelper helper ^String option]
          (.process this helper option (.substring option (.length (.-primaryName this)))))
        (method ^:public process ^void [this ^OptionHelper helper ^String option ^String arg]
          (let [eq (.indexOf arg \=)
                ^String key (if (< eq 0) arg (.substring arg 0 eq))
                ^String value (if (< eq 0) arg (.substring arg (unchecked-add-int eq 1)))]
            (.put helper key value))))
    (ADD_EXPORTS
      ["--add-exports" "opt.arg.addExports" "opt.addExports" OptionKind/EXTENDED OptionGroup/BASIC]
      (method ^:public process :throws [InvalidValueException] ^void [this ^OptionHelper helper
                                                                      ^String option ^String arg]
        (cond
          (.isEmpty arg)
            (throw (.newInvalidValueException helper
                                              (CompilerProperties$Errors/NoValueForOption option)))
          (.matches (.matcher (.getPattern this) arg))

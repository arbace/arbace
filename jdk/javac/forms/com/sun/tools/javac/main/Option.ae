                              helper
                              (CompilerProperties$Errors/BadValueForOption option arg)))))
               (method ^:public getPattern ^Pattern [this]
                 (Pattern/compile "([^=]+)=(,*[^,].*)")))
    (MODULE ["--module -m" "opt.arg.m" "opt.m" OptionKind/STANDARD OptionGroup/BASIC])
    (ADD_MODULES
      ["--add-modules" "opt.arg.addmods" "opt.addmods" OptionKind/STANDARD OptionGroup/BASIC]
      (method ^:public process :throws [InvalidValueException] ^void [this ^OptionHelper helper
                                                                      ^String option ^String arg]
        (cond
          (.isEmpty arg)
            (throw (.newInvalidValueException helper
                                              (CompilerProperties$Errors/NoValueForOption option)))
          (.matches (.matcher (.getPattern this) arg))
            (let [prev (.get helper ADD_MODULES)]
              (.put helper
                    (.-primaryName ADD_MODULES)
                    ^String (if (nil? prev) arg (java-str prev \, arg))))
          :else

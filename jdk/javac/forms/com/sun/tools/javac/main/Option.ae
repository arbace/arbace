                                              (CompilerProperties$Errors/BadValueForOption
                                                option
                                                arg)))))
      (method ^:public getPattern ^Pattern [this]
        (Pattern/compile ",*[^,].*")))
    (MODULE_VERSION
      ["--module-version" "opt.arg.module.version" "opt.module.version" OptionKind/STANDARD
       OptionGroup/BASIC]
      (method ^:public process :throws [InvalidValueException] ^void [this ^OptionHelper helper
                                                                      ^String option ^String arg]
        (if (.isEmpty arg)
            (throw (.newInvalidValueException helper
                                              (CompilerProperties$Errors/NoValueForOption option)))

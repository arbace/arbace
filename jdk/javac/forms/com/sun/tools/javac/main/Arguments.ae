                  (.handleOption option helper arg argIter)
                  (catch Option$InvalidValueException e (.error this e) (return false)))
                (when-not (and (some? fm) (.handleOption fm arg argIter))
                  (.reportDiag this (CompilerProperties$Errors/InvalidFlag arg))
                  (return false))))))
      true))


  (method ^:private releaseNote ^JCDiagnostic$Fragment [this ^Source source ^String targetString]
    (cond
      (<= (.compareTo source Source/JDK8) 0)
        (if (some? targetString)
            (CompilerProperties$Fragments/SourceNoBootclasspathWithTarget
              (.-name source)
              targetString)
            (CompilerProperties$Fragments/SourceNoBootclasspath (.-name source)))
      (some? targetString)
        (CompilerProperties$Fragments/SourceNoSystemModulesPathWithTarget
          (.-name source)
          targetString)
      :else (CompilerProperties$Fragments/SourceNoSystemModulesPath (.-name source))))

  (method ^:private validateAddExports ^void [this ^SourceVersion sv]
    (let [addExports (.get options Option/ADD_EXPORTS)]
      (when (some? addExports)
        (let [p (.getPattern Option/ADD_EXPORTS)]
          (for-each [^String e (.split addExports "\u0000")]
            (let [m (.matcher p e)]
              (when (.matches m)
                (let [sourceModuleName (.group m 1)]
                  (when-not (SourceVersion/isName sourceModuleName sv)
                    (.warning log
                              (CompilerProperties$Warnings/BadNameForOption
                                Option/ADD_EXPORTS
                                sourceModuleName)))
                  (let [sourcePackageName (.group m 2)]
                    (when-not (SourceVersion/isName sourcePackageName sv)
                      (.warning log
                                (CompilerProperties$Warnings/BadNameForOption
                                  Option/ADD_EXPORTS
                                  sourcePackageName)))
                    (let [targetNames (.group m 3)]
                      (for-each [^String targetName (.split targetNames ",")]
                        (switch targetName
                          ("" "ALL-UNNAMED") nil
                          (when-not (SourceVersion/isName targetName sv)
                            (.warning log
                                      (CompilerProperties$Warnings/BadNameForOption
                                        Option/ADD_EXPORTS
                                        targetName)))))))))))))))

  (method ^:private validateAddReads ^void [this ^SourceVersion sv]
    (let [addReads (.get options Option/ADD_READS)]
      (when (some? addReads)
        (let [p (.getPattern Option/ADD_READS)]
          (for-each [^String e (.split addReads "\u0000")]
            (let [m (.matcher p e)]
              (when (.matches m)
                (let [sourceName (.group m 1)]
                  (when-not (SourceVersion/isName sourceName sv)
                    (.warning log
                              (CompilerProperties$Warnings/BadNameForOption
                                Option/ADD_READS
                                sourceName)))
                  (let [targetNames (.group m 2)]
                    (for-each [^String targetName (.split targetNames "," -1)]
                      (switch targetName
                        ("" "ALL-UNNAMED") nil
                        (when-not (SourceVersion/isName targetName sv)
                          (.warning log
                                    (CompilerProperties$Warnings/BadNameForOption
                                      Option/ADD_READS
                                      targetName))))))))))))))

  (method ^:private validateAddModules ^void [this ^SourceVersion sv]
    (let [addModules (.get options Option/ADD_MODULES)]
      (when (some? addModules)
        (for-each [^String moduleName (.split addModules ",")]
          (switch moduleName
            ("" "ALL-SYSTEM" "ALL-MODULE-PATH") nil
            (when-not (SourceVersion/isName moduleName sv)
              (.error log
                      (CompilerProperties$Errors/BadNameForOption Option/ADD_MODULES moduleName))))))))

  (method ^:private validateLimitModules ^void [this ^SourceVersion sv]
    (let [limitModules (.get options Option/LIMIT_MODULES)]
      (when (some? limitModules)
        (for-each [^String moduleName (.split limitModules ",")]
          (switch moduleName
            "" nil
            (when-not (SourceVersion/isName moduleName sv)
              (.error log
                      (CompilerProperties$Errors/BadNameForOption Option/LIMIT_MODULES moduleName))))))))

  (method ^:private validateDefaultModuleForCreatedFiles ^void [this ^SourceVersion sv]
    (let [moduleName (.get options Option/DEFAULT_MODULE_FOR_CREATED_FILES)]
      (when (some? moduleName)
        (when-not (SourceVersion/isName moduleName sv)
          (.error log
                  (CompilerProperties$Errors/BadNameForOption
                    Option/DEFAULT_MODULE_FOR_CREATED_FILES
                    moduleName))))))

  (method ^:public isEmpty ^boolean [this]
    (and (and (or (nil? files) (.isEmpty files)) (or (nil? fileObjects) (.isEmpty fileObjects)))
         (or (nil? classNames) (.isEmpty classNames))))

  (method ^:public allowEmpty ^void [this]
    (set! (.-emptyAllowed this) true))

  (method ^:public getDeferredFileManagerOptions ^{:tag (Map Option String)} [this]
    deferredFileManagerOptions)

  (method ^:public getPluginOpts ^{:tag (Set (List String))} [this]
    (let [plugins (.get options Option/PLUGIN)]
      (if (nil? plugins)
          (Collections/emptySet)
          (let [^{:tag (Set (List String))} pluginOpts (LinkedHashSet.)]
            (for-each [^String plugin (.split plugins "\\x00")]
              (.add pluginOpts (List/from (.split plugin "\\s+"))))
            (Collections/unmodifiableSet pluginOpts)))))

  (method ^:public getDocLintOpts ^{:tag (List String)} [this]
    (let [xdoclint (.get options Option/XDOCLINT)
          xdoclintCustom (.get options Option/XDOCLINT_CUSTOM)]
      (if (and (nil? xdoclint) (nil? xdoclintCustom))
          (List/nil)
          (let [^{:tag (Set String)} doclintOpts (LinkedHashSet.)]
            (when (some? xdoclint) (.add doclintOpts DocLint/XMSGS_OPTION))
            (when (some? xdoclintCustom)
              (for-each [^String s (.split xdoclintCustom "\\s+")]
                (when-not (.isEmpty s) (.add doclintOpts (java-str DocLint/XMSGS_CUSTOM_PREFIX s)))))
            (if (.equals doclintOpts
                         (Collections/singleton (java-str DocLint/XMSGS_CUSTOM_PREFIX "none")))
                (List/nil)
                (let [checkPackages (.get options Option/XDOCLINT_PACKAGE)]
                  (when (some? checkPackages)
                    (.add doclintOpts (java-str DocLint/XCHECK_PACKAGE checkPackages)))
                  (List/from (cast String/1
                                   (.toArray doclintOpts (new String/1 (.size doclintOpts)))))))))))

  (method ^:private checkDirectory ^boolean [this ^Option option]
    (let [value (.get options option)]
      (if (nil? value)
          true
          (let [file (Paths/get value (new String/1 []))]
            (if (and (Files/exists file) (not (Files/isDirectory file)))
                (do (.reportDiag this (CompilerProperties$Errors/FileNotDirectory value)) false)
                true)))))

  (defclass ^:private ^:interface ErrorReporter
    (method report ^void [this ^Option o]))

  (method checkOptionAllowed ^void [this ^boolean allowed ^ErrorReporter r & ^Option/1 opts]
    (when-not allowed
      (.forEach (.filter (Stream/of opts) (method-ref Predicate [Option] options Options/.isSet))
                (method-ref Consumer [Option] r ErrorReporter/.report))))

  (method reportDiag ^void [this ^JCDiagnostic$DiagnosticInfo diag]
    (set! errors true)
    (switch errorMode
      ILLEGAL_ARGUMENT
        (let [msg (.localize log diag)]
          (throw (PropagatedException. (IllegalArgumentException. msg))))
      ILLEGAL_STATE
        (let [msg (.localize log diag)] (throw (PropagatedException. (IllegalStateException. msg))))
      LOG (.report this diag)))

  (method error ^void [this ^Option$InvalidValueException f]
    (let [msg (.getMessage f)]
      (set! errors true)
      (switch errorMode
        ILLEGAL_ARGUMENT
          (throw (PropagatedException. (IllegalArgumentException. msg (.getCause f))))
        ILLEGAL_STATE (throw (PropagatedException. (IllegalStateException. msg (.getCause f))))
        LOG (.printRawLines log msg))))

  (method ^:private report ^void [this ^JCDiagnostic$DiagnosticInfo diag]
    (if-instance [^JCDiagnostic$Error errorDiag diag]
      (.error log errorDiag)
      (when-instance [^JCDiagnostic$Warning warningDiag diag] (.warning log warningDiag))))

  (method ^:private getFileManager ^JavaFileManager [this]
    (when (nil? fileManager)
      (set! fileManager (cast JavaFileManager (.get context JavaFileManager))))
    fileManager)

  (method toList :type-params [T] ^{:tag (ListBuffer T)} [this
                                                          ^{:tag (Iterable (? extends T))} items]
    (let [^{:tag (ListBuffer T)} list (ListBuffer.)]
      (when (some? items) (for-each [item items] (.add list item)))
      list))

  (method toSet :type-params [T] ^{:tag (Set T)} [this ^{:tag (Iterable (? extends T))} items]
    (let [^{:tag (Set T)} set (LinkedHashSet.)]
      (when (some? items) (for-each [item items] (.add set item)))
      set)))

                                         (lambda ErrorReporter ^void [^Option option]
                                           (.reportDiag
                                             this
                                             (CompilerProperties$Errors/OptionNotAllowedWithTarget
                                               option
                                               t)))
                                         Option/MODULE_SOURCE_PATH
                                         Option/UPGRADE_MODULE_PATH
                                         Option/SYSTEM
                                         Option/MODULE_PATH
                                         Option/ADD_MODULES
                                         Option/ADD_EXPORTS
                                         Option/ADD_OPENS
                                         Option/ADD_READS
                                         Option/LIMIT_MODULES

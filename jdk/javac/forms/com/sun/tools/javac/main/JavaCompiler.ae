      (try
        (let [t (.parse this filename (.readSource this filename))]
          (when (some? (.-endPositions t)) (.setEndPosTable log filename (.-endPositions t)))
          t)
        (finally (.useSource log prev)))))

  (method ^:public resolveBinaryNameOrIdent ^Symbol [this ^String name]
    (let [^:mutable ^Symbol$ModuleSymbol msym nil
          ^:mutable ^String typeName nil
          sep (.indexOf name \/)]
      (cond
        (== sep -1) (do (set! msym (.getDefaultModule modules)) (set! typeName name))
        (.allowedInSource Source$Feature/MODULES source)
          (let [modName (.fromString names (.substring name 0 sep))]
            (set! msym (.findModule moduleFinder modName))
            (set! typeName (.substring name (unchecked-add-int sep 1))))
        :else
          (do
            (.error log (CompilerProperties$Errors/InvalidModuleSpecifier name))
            (return silentFail)))
      (.resolveBinaryNameOrIdent this msym typeName)))

  (method ^:public resolveBinaryNameOrIdent ^Symbol [this ^Symbol$ModuleSymbol msym ^String name]

      (catch Symbol$CompletionFailure ignore (.resolveIdent this msym name))))

  (method ^:public resolveIdent ^Symbol [this ^Symbol$ModuleSymbol msym ^String name]
    (if (.equals name "")
        (.-errSymbol syms)
        (let [prev (.useSource log nil)]
          (try
            (let [^:mutable ^JCTree$JCExpression tree nil]
              (for-each [^String s (.split name "\\." -1)]
                (when-not (SourceVersion/isIdentifier s) (return (.-errSymbol syms)))
                (set! tree
                      (if (nil? tree)
                          ^JCTree$JCExpression (.Ident make (.fromString names s))
                          ^JCTree$JCExpression (.Select make tree (.fromString names s)))))
              (let [toplevel (.TopLevel make (List/nil))]
                (set! (.-modle toplevel) msym)
                (set! (.-packge toplevel) (.-unnamedPackage msym))
                (.attribIdent attr tree toplevel)))
            (finally (.useSource log prev))))))

  (method genCode :throws [IOException] ^JavaFileObject [this ^{:tag (Env AttrContext)} env
                                                         ^JCTree$JCClassDecl cdef]
    (try
      (when (and (.genClass gen env cdef) (== (.errorCount this) 0))
        (return (.writeClass writer (.-sym cdef))))
      (catch ClassWriter$PoolOverflow ex
        (.error log (.pos cdef) CompilerProperties$Errors/LimitPool))
      (catch ClassWriter$StringOverflow ex
        (.error log
                (.pos cdef)
                (CompilerProperties$Errors/LimitStringOverflow (.substring (.-value ex) 0 20))))
      (catch Symbol$CompletionFailure ex (.completionError chk (.pos cdef) ex)))
    nil)

  (method printSource :throws [IOException] ^JavaFileObject [this ^{:tag (Env AttrContext)} env
                                                             ^JCTree$JCClassDecl cdef]
    (let [outFile (.getJavaFileForOutput fileManager
                                         StandardLocation/CLASS_OUTPUT
                                         (.toString (.-flatname (.-sym cdef)))
                                         JavaFileObject$Kind/SOURCE
                                         nil)]
      (if (.contains inputFiles outFile)

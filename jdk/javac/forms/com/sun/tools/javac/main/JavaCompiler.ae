  (method ^:private parse ^JCTree$JCCompilationUnit [this ^JavaFileObject filename
                                                     ^CharSequence content ^boolean silent]
    (let [msec (JavaCompiler/now)
          ^:mutable tree (.TopLevel make (List/nil))]
      (.startParsingFile lintMapper filename)
      (when (some? content)
        (when verbose (.printVerbose log "parsing.started" filename))
        (when (and (not (.isEmpty taskListener)) (not silent))
          (let [e (TaskEvent. TaskEvent$Kind/PARSE filename)]
            (.started taskListener e)
            (set! keepComments true)
            (set! genEndPos true)))
        (let [^Parser parser (.newParser parserFactory
                                         content
                                         (.keepComments this)
                                         genEndPos
                                         lineDebugInfo
                                         (.isNameCompatible
                                           filename
                                           "module-info"
                                           JavaFileObject$Kind/SOURCE))]
          (set! tree (.parseCompilationUnit parser))
          (when verbose
            (.printVerbose log "parsing.done" (Long/toString (JavaCompiler/elapsed msec))))))
      (set! (.-sourcefile tree) filename)
      (.finishParsingFile lintMapper tree)
      (when (and (and (some? content) (not (.isEmpty taskListener))) (not silent))
        (let [e (TaskEvent. TaskEvent$Kind/PARSE tree)] (.finished taskListener e)))
      tree))


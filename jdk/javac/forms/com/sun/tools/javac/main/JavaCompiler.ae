            (.error log
                    (.pos cdef)
                    (CompilerProperties$Errors/SourceCantOverwriteInputFile outFile))
            nil)
          (do
            (with-resources [out (BufferedWriter. (.openWriter outFile))]
              (.printUnit (Pretty. out true) (.-toplevel env) cdef)
              (when verbose (.printVerbose log "wrote.file" (.getName outFile))))
            outFile))))

  (method ^:private readSourceFile :throws [Symbol$CompletionFailure] ^void [this
                                                                             ^Symbol$ClassSymbol c]
    (.readSourceFile this nil c))

  (method ^:public readSourceFile :throws [Symbol$CompletionFailure] ^void [this
                                                                            ^:mutable ^JCTree$JCCompilationUnit tree
                                                                            ^Symbol$ClassSymbol c]
    (when (identical? completionFailureName (.-fullname c))
      (throw (Symbol$CompletionFailure.
               c
               (lambda Supplier ^JCDiagnostic []
                 (.fragment diagFactory CompilerProperties$Fragments/UserSelectedCompletionFailure))
               dcfh)))
    (let [filename (.-classfile c)
          prev (.useSource log filename)]
      (when (nil? tree)
        (try
          (set! tree (.parse this filename (.getCharContent filename false)))
          (catch IOException e
            (.error log
                    (CompilerProperties$Errors/ErrorReadingFile
                      filename
                      (JavacFileManager/getMessage e)))
            (set! tree (.TopLevel make (List/nil))))
          (finally (.useSource log prev))))
      (when-not (.isEmpty taskListener)
        (let [e (TaskEvent. TaskEvent$Kind/ENTER tree)] (.started taskListener e)))
      (when-not (.enter modules (List/of tree) c)
        (throw (Symbol$CompletionFailure. c
                                          (lambda Supplier ^JCDiagnostic []
                                            (.fragment
                                              diags
                                              CompilerProperties$Fragments/CantResolveModules))
                                          dcfh)))
      (.complete enter (List/of tree) c)
      (when-not (.isEmpty taskListener)
        (let [e (TaskEvent. TaskEvent$Kind/ENTER tree)] (.finished taskListener e)))
      (when (nil? (.getEnv enter c))
        (let [isPkgInfo (.isNameCompatible (.-sourcefile tree)
                                           "package-info"
                                           JavaFileObject$Kind/SOURCE)
              isModuleInfo (.isNameCompatible (.-sourcefile tree)
                                              "module-info"
                                              JavaFileObject$Kind/SOURCE)]
          (cond
            isModuleInfo
              (when (nil? (.getEnv enter (.-modle tree)))
                (let [diag (.fragment diagFactory
                                      CompilerProperties$Fragments/FileDoesNotContainModule)]
                  (throw (ClassFinder$BadClassFile. c filename diag diagFactory dcfh))))
            isPkgInfo
              (when (nil? (.getEnv enter (.-packge tree)))
                (let [diag (.fragment diagFactory
                                      (CompilerProperties$Fragments/FileDoesNotContainPackage
                                        (.location c)))]
                  (throw (ClassFinder$BadClassFile. c filename diag diagFactory dcfh))))
            :else
              (let [diag (.fragment diagFactory
                                    (CompilerProperties$Fragments/FileDoesntContainClass
                                      (.getQualifiedName c)))]
                (throw (ClassFinder$BadClassFile. c filename diag diagFactory dcfh))))))
      (set! implicitSourceFilesRead true)))

  (field ^:private ^boolean hasBeenUsed false)

  (field ^:private ^long start_msec 0)

  (field ^:public ^long elapsed_msec 0)

  (method ^:public compile :throws [Throwable] ^void [this
                                                      ^{:tag (List JavaFileObject)} sourceFileObject]
    (.compile this sourceFileObject (List/nil) nil (List/nil)))

  (method ^:public compile ^void [this ^{:tag (Collection JavaFileObject)} sourceFileObjects
                                  ^{:tag (Collection String)} classnames
                                  ^{:tag (Iterable (? extends Processor))} processors
                                  ^{:tag (Collection String)} addModules]
    (when-not (.isEmpty taskListener)
      (.started taskListener (TaskEvent. TaskEvent$Kind/COMPILATION)))
    (when hasBeenUsed (.checkReusable this))
    (set! hasBeenUsed true)
    (set! start_msec (JavaCompiler/now))
    (try
      (.initProcessAnnotations this processors sourceFileObjects classnames)
      (for-each [^String className classnames]
        (let [sep (.indexOf className \/)]
          (when-not (== sep -1) (.addExtraAddModules modules (.substring className 0 sep)))))
      (for-each [^String moduleName addModules] (.addExtraAddModules modules moduleName))
      (.processAnnotations this
                           (.enterTrees this
                                        (.stopIfError
                                          this
                                          CompileStates$CompileState/ENTER
                                          (.initModules
                                            this
                                            (.stopIfError
                                              this
                                              CompileStates$CompileState/ENTER
                                              (.parseFiles this sourceFileObjects)))))
                           classnames)
      (when (and (.isEmpty taskListener)
                 (identical? implicitSourcePolicy ImplicitSourcePolicy/NONE))
        (.retainFiles todo inputFiles))
      (when-not (.isAfter CompileStates$CompileState/ATTR shouldStopPolicyIfNoError)
        (switch compilePolicy
          SIMPLE (.generate this (.desugar this (.warn this (.flow this (.attribute this todo)))))
          BY_FILE
            (let [^{:tag (Queue (Queue (Env AttrContext)))} q (.groupByFile todo)]
              (while (and (not (.isEmpty q))
                          (not (.shouldStop this CompileStates$CompileState/ATTR)))
                (.generate this
                           (.desugar
                             this
                             (.warn this (.flow this (.attribute this (cast Queue (.remove q)))))))))
          BY_TODO
            (while (not (.isEmpty todo))
              (.generate
                this
                (.desugar this
                          (.warn this (.flow this (.attribute this (cast Env (.remove todo))))))))
          (Assert/error "unknown compile policy")))
      (catch Abort ex
        (when devVerbose (.printStackTrace ex System/err))
        (.reportDeferredDiagnosticAndClearHandler this))
      (finally
        (when verbose
          (set! elapsed_msec (JavaCompiler/elapsed start_msec))
          (.printVerbose log "total" (Long/toString elapsed_msec)))
        (.reportDeferredDiagnostics this)
        (when-not (.hasDiagnosticListener log)
          (.printCount this "error" (.errorCount this))
          (.printCount this "warn" (.warningCount this))
          (.printSuppressedCount this
                                 (.errorCount this)
                                 (.-nsuppressederrors log)
                                 "count.error.recompile")
          (.printSuppressedCount this
                                 (.warningCount this)
                                 (.-nsuppressedwarns log)
                                 "count.warn.recompile"))
        (when-not (.isEmpty taskListener)
          (.finished taskListener (TaskEvent. TaskEvent$Kind/COMPILATION)))
        (.close this)
        (when (some? procEnvImpl) (.close procEnvImpl)))))


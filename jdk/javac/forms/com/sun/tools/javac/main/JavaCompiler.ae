    (if (and (not force) (.shouldStop this CompileStates$CompileState/PARSE))
        (List/nil)
        (let [^{:tag (ListBuffer JCTree$JCCompilationUnit)} trees (ListBuffer.)
              ^{:tag (Set JavaFileObject)} filesSoFar (HashSet.)]
          (for-each [^JavaFileObject fileObject fileObjects]
            (when-not (.contains filesSoFar fileObject)
              (.add filesSoFar fileObject)
              (.append trees (.parse this fileObject))))
          (.toList trees))))

  (method ^:public continueAfterProcessAnnotations ^boolean [this]
    (not (.shouldStop this CompileStates$CompileState/ATTR)))

  (method ^:public initModules ^{:tag (List JCTree$JCCompilationUnit)} [this
                                                                        ^{:tag (List JCTree$JCCompilationUnit)} roots]
    (.initModules modules roots)
    (when (.isEmpty roots) (.enterDone this))
    roots)

  (method ^:public enterTrees ^{:tag (List JCTree$JCCompilationUnit)} [this
                                                                       ^{:tag (List JCTree$JCCompilationUnit)} roots]
    (when-not (.isEmpty taskListener)
      (for-each [^JCTree$JCCompilationUnit unit roots]
        (let [e (TaskEvent. TaskEvent$Kind/ENTER unit)] (.started taskListener e))))
    (.main enter roots)
    (.enterDone this)
    (when-not (.isEmpty taskListener)
      (for-each [^JCTree$JCCompilationUnit unit roots]
        (let [e (TaskEvent. TaskEvent$Kind/ENTER unit)] (.finished taskListener e))))
    (when sourceOutput
      (let [^{:tag (ListBuffer JCTree$JCClassDecl)} cdefs (ListBuffer.)]
        (for-each [^JCTree$JCCompilationUnit unit roots]
          (loop [^{:tag (List JCTree)} defs (.-defs unit)]
            (when (.nonEmpty defs)
              (if-instance [^JCTree$JCClassDecl classDecl (.-head defs)]
                (do (.append cdefs classDecl) (recur (.-tail defs)))
                (recur (.-tail defs))))))
        (set! rootClasses (.toList cdefs))))
    (for-each [^JCTree$JCCompilationUnit unit roots] (.add inputFiles (.-sourcefile unit)))
    roots)

  (field ^boolean processAnnotations false)

  (field ^Log$DeferredDiagnosticHandler deferredDiagnosticHandler)

  (field ^:private ^JavacProcessingEnvironment procEnvImpl nil)

  (method ^:public initProcessAnnotations ^void [this
                                                 ^{:tag (Iterable (? extends Processor))} processors
                                                 ^{:tag (Collection (? extends JavaFileObject))} initialFiles
                                                 ^{:tag (Collection String)} initialClassNames]
    (when (and (some? processors) (.hasNext (.iterator processors)))
      (set! explicitAnnotationProcessingRequested true))
    (cond
      (.isSet options Option/PROC "none") (set! processAnnotations false)
      (nil? procEnvImpl)
        (do
          (set! procEnvImpl (JavacProcessingEnvironment/instance context))
          (.setProcessors procEnvImpl processors)
          (set! processAnnotations
                (and (.atLeastOneProcessor procEnvImpl)
                     (.explicitAnnotationProcessingRequested this)))
          (when processAnnotations
            (.put options "parameters" "parameters")
            (set! (.-saveParameterNames reader) true)
            (set! keepComments true)
            (set! genEndPos true)
            (when-not (.isEmpty taskListener)
              (.started taskListener (TaskEvent. TaskEvent$Kind/ANNOTATION_PROCESSING)))
            (set! deferredDiagnosticHandler (.new log Log$DeferredDiagnosticHandler))
            (.setInitialState (.getFiler procEnvImpl) initialFiles initialClassNames)))
      :else (.close procEnvImpl)))

  (method ^:public processAnnotations ^void [this ^{:tag (List JCTree$JCCompilationUnit)} roots]
    (.processAnnotations this roots (List/nil)))

  (method ^:public processAnnotations ^void [this ^{:tag (List JCTree$JCCompilationUnit)} roots
                                             ^{:tag (Collection String)} classnames]
    (when (.shouldStop this CompileStates$CompileState/PROCESS)
      (when processAnnotations (.reportDeferredDiagnosticAndClearHandler this) (return)))
    (if (not processAnnotations)
        (do
          (when (.isSet options Option/PROC "only")
            (.warning log CompilerProperties$Warnings/ProcProcOnlyRequestedNoProcs)
            (.clear todo))
          (when-not (.isEmpty classnames)
            (.error log
                    (CompilerProperties$Errors/ProcNoExplicitAnnotationProcessingRequested
                      classnames)))
          (Assert/checkNull deferredDiagnosticHandler))
        (do
          (Assert/checkNonNull deferredDiagnosticHandler)
          (try
            (let [^:mutable ^{:tag (List Symbol$ClassSymbol)} classSymbols (List/nil)
                  ^:mutable ^{:tag (List Symbol$PackageSymbol)} pckSymbols (List/nil)]
              (when-not (.isEmpty classnames)
                (if (not (.explicitAnnotationProcessingRequested this))
                    (do
                      (.error log
                              (CompilerProperties$Errors/ProcNoExplicitAnnotationProcessingRequested
                                classnames))
                      (.reportDeferredDiagnosticAndClearHandler this)
                      (return))
                    (let [^:mutable errors false]
                      (for-each [^String nameStr classnames]
                        (let [sym (.resolveBinaryNameOrIdent this nameStr)]
                          (if (or (or (nil? sym)
                                      (and (identical? (.-kind sym) Kinds$Kind/PCK)
                                           (not processPcks)))
                                  (identical? (.-kind sym) Kinds$Kind/ABSENT_TYP))
                              (do
                                (when-not (identical? sym silentFail)
                                  (.error log (CompilerProperties$Errors/ProcCantFindClass nameStr)))
                                (set! errors true))
                              (try
                                (when (identical? (.-kind sym) Kinds$Kind/PCK) (.complete sym))
                                (if (.exists sym)
                                    (if (identical? (.-kind sym) Kinds$Kind/PCK)
                                        (set! pckSymbols
                                              (.prepend pckSymbols (cast Symbol$PackageSymbol sym)))
                                        (set! classSymbols
                                              (.prepend classSymbols (cast Symbol$ClassSymbol sym))))
                                    (do
                                      (Assert/check (identical? (.-kind sym) Kinds$Kind/PCK))
                                      (.warning log
                                                (CompilerProperties$Warnings/ProcPackageDoesNotExist
                                                  nameStr))
                                      (set! pckSymbols
                                            (.prepend pckSymbols (cast Symbol$PackageSymbol sym)))))
                                (catch Symbol$CompletionFailure e
                                  (.error log (CompilerProperties$Errors/ProcCantFindClass nameStr))
                                  (set! errors true))))))
                      (when errors (.reportDeferredDiagnosticAndClearHandler this) (return)))))
              (try
                (set! annotationProcessingOccurred
                      (.doProcessing procEnvImpl
                                     roots
                                     classSymbols
                                     pckSymbols
                                     deferredDiagnosticHandler))
                (finally (.close procEnvImpl))))
            (catch Symbol$CompletionFailure ex
              (.error log (CompilerProperties$Errors/CantAccess (.-sym ex) (.getDetailValue ex)))
              (.reportDeferredDiagnosticAndClearHandler this))))))

  (method ^:private unrecoverableError ^boolean [this]
    (when (some? deferredDiagnosticHandler)
      (for-each [^JCDiagnostic d (.getDiagnostics deferredDiagnosticHandler)]
        (when (and (identical? (.getKind d) Diagnostic$Kind/ERROR)
                   (not (.isFlagSet d JCDiagnostic$DiagnosticFlag/RECOVERABLE)))
          (return true))))
    false)

  (method explicitAnnotationProcessingRequested ^boolean [this]
    (or explicitAnnotationProcessingRequested
        (JavaCompiler/explicitAnnotationProcessingRequested options fileManager)))

  (method ^:static explicitAnnotationProcessingRequested ^boolean [^Options options
                                                                   ^JavaFileManager fileManager]
    (or (or (or (or (or (or (or (.isSet options Option/PROCESSOR)
                                (.isSet options Option/PROCESSOR_PATH))
                            (.isSet options Option/PROCESSOR_MODULE_PATH))
                        (.isSet options Option/PROC "only"))
                    (.isSet options Option/PROC "full"))
                (.isSet options Option/A))
            (.isSet options Option/XPRINT))
        (.hasLocation fileManager StandardLocation/ANNOTATION_PROCESSOR_PATH)))

  (method ^:public setDeferredDiagnosticHandler ^void [this
                                                       ^Log$DeferredDiagnosticHandler deferredDiagnosticHandler]
    (set! (.-deferredDiagnosticHandler this) deferredDiagnosticHandler))

  (method ^:public attribute ^{:tag (Queue (Env AttrContext))} [this
                                                                ^{:tag (Queue (Env AttrContext))} envs]
    (let [^{:tag (ListBuffer (Env AttrContext))} results (ListBuffer.)]
      (while (not (.isEmpty envs)) (.append results (.attribute this (cast Env (.remove envs)))))
      (.stopIfError this CompileStates$CompileState/ATTR results)))

  (method ^:public attribute ^{:tag (Env AttrContext)} [this ^{:tag (Env AttrContext)} env]
    (if (.isDone compileStates env CompileStates$CompileState/ATTR)
        env
        (do
          (when verboseCompilePolicy
            (.printNote this (java-str "[attribute " (.-sym (.-enclClass env)) "]")))
          (when verbose (.printVerbose log "checking.attribution" (.-sym (.-enclClass env))))
          (when-not (.isEmpty taskListener)
            (let [e (.newAnalyzeTaskEvent this env)] (.started taskListener e)))
          (let [prev (.useSource log
                                 ^JavaFileObject (if (some?
                                                       (.-sourcefile (.-sym (.-enclClass env))))
                                                     (.-sourcefile (.-sym (.-enclClass env)))
                                                     (.-sourcefile (.-toplevel env))))]
            (try
              (.attrib attr env)
              (when (and (> (.errorCount this) 0)
                         (not (.shouldStop this CompileStates$CompileState/ATTR)))
                (.postAttr attr (.-tree env)))
              (.put compileStates env CompileStates$CompileState/ATTR)
              (finally (.useSource log prev)))
            env))))

  (method ^:public flow ^{:tag (Queue (Env AttrContext))} [this
                                                           ^{:tag (Queue (Env AttrContext))} envs]
    (let [^{:tag (ListBuffer (Env AttrContext))} results (ListBuffer.)]
      (for-each [^{:tag (Env AttrContext)} env envs] (.flow this env results))
      (.stopIfError this CompileStates$CompileState/FLOW results)))

  (method ^:public flow ^{:tag (Queue (Env AttrContext))} [this ^{:tag (Env AttrContext)} env]
    (let [^{:tag (ListBuffer (Env AttrContext))} results (ListBuffer.)]
      (.flow this env results)
      (.stopIfError this CompileStates$CompileState/FLOW results)))

  (method ^:protected flow ^void [this ^{:tag (Env AttrContext)} env
                                  ^{:tag (Queue (Env AttrContext))} results]
    (if (.isDone compileStates env CompileStates$CompileState/FLOW)
        (.add results env)
        (try
          (when-not (.shouldStop this CompileStates$CompileState/FLOW)
            (when verboseCompilePolicy
              (.printNote this (java-str "[flow " (.-sym (.-enclClass env)) "]")))
            (let [prev (.useSource log
                                   ^JavaFileObject (if (some?
                                                         (.-sourcefile (.-sym (.-enclClass env))))
                                                       (.-sourcefile (.-sym (.-enclClass env)))
                                                       (.-sourcefile (.-toplevel env))))]
              (try
                (.at make Position/FIRSTPOS)
                (let [localMake (.forToplevel make (.-toplevel env))]
                  (.analyzeTree flow env localMake)
                  (.put compileStates env CompileStates$CompileState/FLOW)
                  (when-not (.shouldStop this CompileStates$CompileState/FLOW)
                    (.flush analyzer env)
                    (.add results env)))
                (finally (.useSource log prev)))))
          (finally
            (when-not (.isEmpty taskListener)
              (let [e (.newAnalyzeTaskEvent this env)] (.finished taskListener e)))))))

  (method ^:public warn ^{:tag (Queue (Env AttrContext))} [this
                                                           ^{:tag (Queue (Env AttrContext))} envs]
    (let [^{:tag (ListBuffer (Env AttrContext))} results (ListBuffer.)]
      (for-each [^{:tag (Env AttrContext)} env envs] (.warn this env results))
      (.stopIfError this CompileStates$CompileState/WARN results)))

  (method ^:public warn ^{:tag (Queue (Env AttrContext))} [this ^{:tag (Env AttrContext)} env]
    (let [^{:tag (ListBuffer (Env AttrContext))} results (ListBuffer.)]
      (.warn this env results)
      (.stopIfError this CompileStates$CompileState/WARN results)))

  (method ^:protected warn ^void [this ^{:tag (Env AttrContext)} env
                                  ^{:tag (Queue (Env AttrContext))} results]
    (if (.isDone compileStates env CompileStates$CompileState/WARN)
        (.add results env)
        (when-not (.shouldStop this CompileStates$CompileState/WARN)
          (when verboseCompilePolicy
            (.printNote this (java-str "[warn " (.-sym (.-enclClass env)) "]")))
          (let [prev (.useSource log
                                 ^JavaFileObject (if (some?
                                                       (.-sourcefile (.-sym (.-enclClass env))))
                                                     (.-sourcefile (.-sym (.-enclClass env)))
                                                     (.-sourcefile (.-toplevel env))))]
            (try
              (.analyzeTree warningAnalyzer env)
              (.put compileStates env CompileStates$CompileState/WARN)
              (.add results env)
              (finally (.useSource log prev)))))))

  (method ^:private newAnalyzeTaskEvent ^TaskEvent [this ^{:tag (Env AttrContext)} env]
    (let [toplevel (.-toplevel env)
          ^:mutable ^Symbol$ClassSymbol sym nil]
      (if (identical? (.-sym (.-enclClass env)) (.-predefClass syms))
          (cond
            (TreeInfo/isModuleInfo toplevel) (set! sym (.-module_info (.-modle toplevel)))
            (TreeInfo/isPackageInfo toplevel) (set! sym (.-package_info (.-packge toplevel)))
            :else (throw (IllegalStateException. "unknown env.toplevel")))
          (set! sym (.-sym (.-enclClass env))))
      (TaskEvent. TaskEvent$Kind/ANALYZE toplevel sym)))

  (method ^:public desugar ^{:tag (Queue (Pair (Env AttrContext) JCTree$JCClassDecl))} [this
                                                                                        ^{:tag (Queue (Env AttrContext))} envs]
    (let [^{:tag (ListBuffer (Pair (Env AttrContext) JCTree$JCClassDecl))} results (ListBuffer.)]
      (for-each [^{:tag (Env AttrContext)} env envs] (.desugar this env results))
      (.stopIfError this CompileStates$CompileState/FLOW results)))

  (field ^{:tag (HashMap (Env AttrContext) (Queue (Pair (Env AttrContext) JCTree$JCClassDecl)))} desugaredEnvs
    (HashMap.))

  (method ^:protected desugar ^void [this ^:final ^{:tag (Env AttrContext)} env
                                     ^{:tag (Queue (Pair (Env AttrContext) JCTree$JCClassDecl))} results]
    (when-not (.shouldStop this CompileStates$CompileState/TRANSTYPES)
      (when-not (and (identical? implicitSourcePolicy ImplicitSourcePolicy/NONE)
                     (not (.contains inputFiles (.-sourcefile (.-toplevel env)))))
        (when-not (and (not (.-multiModuleMode modules))
                       (not (identical? (.-modle (.-toplevel env)) (.getDefaultModule modules))))
          (if (.isDone compileStates env CompileStates$CompileState/LOWER)
              (.addAll results (cast Collection (.get desugaredEnvs env)))
              (do
                (when-not (.isDone compileStates env CompileStates$CompileState/WARN)
                  (.warn this env))
                (letclass [(ScanNested
                             :extends TreeScanner

                             (field ^{:tag (Set (Env AttrContext))} dependencies (LinkedHashSet.))

                             (field ^:protected ^boolean hasLambdas)

                             (field ^:protected ^boolean hasPatterns)

                             (method ^:public visitClassDef ^void [this ^JCTree$JCClassDecl node]
                               (let [^:mutable st (.supertype types (.-type (.-sym node)))
                                     ^:mutable envForSuperTypeFound false]
                                 (while (and (not envForSuperTypeFound) (.hasTag st TypeTag/CLASS))
                                   (let [c (.outermostClass (.-tsym st))
                                         ^{:tag (Env AttrContext)} stEnv (.getEnv enter c)]
                                     (when (and (some? stEnv) (not (identical? env stEnv)))
                                       (when (.add dependencies stEnv)
                                         (let [prevHasLambdas hasLambdas
                                               prevHasPatterns hasPatterns]
                                           (try
                                             (.scan this (.-tree stEnv))
                                             (finally
                                               (set! hasLambdas prevHasLambdas)
                                               (set! hasPatterns prevHasPatterns)))))
                                       (set! envForSuperTypeFound true))
                                     (set! st (.supertype types st))))
                                 (.visitClassDef super node)))

                             (method ^:public visitLambda ^void [this ^JCTree$JCLambda tree]
                               (set! hasLambdas true)
                               (.visitLambda super tree))

                             (method ^:public visitReference ^void [this
                                                                    ^JCTree$JCMemberReference tree]
                               (set! hasLambdas true)
                               (.visitReference super tree))

                             (method ^:public visitBindingPattern ^void [this
                                                                         ^JCTree$JCBindingPattern tree]
                               (set! hasPatterns true)
                               (.visitBindingPattern super tree))

                             (method ^:public visitTypeTest ^void [this ^JCTree$JCInstanceOf tree]
                               (when (.isPrimitive (.-type (.-pattern tree)))
                                 (set! hasPatterns true))
                               (.visitTypeTest super tree))

                             (method ^:public visitRecordPattern ^void [this
                                                                        ^JCTree$JCRecordPattern that]
                               (set! hasPatterns true)
                               (.visitRecordPattern super that))

                             (method ^:public visitSwitch ^void [this ^JCTree$JCSwitch tree]
                               (set!
                                 hasPatterns
                                 (let [a-1 hasPatterns b-2 (.-patternSwitch tree)] (or a-1 b-2)))
                               (.visitSwitch super tree))

                             (method ^:public visitSwitchExpression ^void [this
                                                                           ^JCTree$JCSwitchExpression tree]
                               (set!
                                 hasPatterns
                                 (let [a-3 hasPatterns b-4 (.-patternSwitch tree)] (or a-3 b-4)))
                               (.visitSwitchExpression super tree)))]
                  (let [scanner (ScanNested.)]
                    (.scan scanner (.-tree env))
                    (for-each [^{:tag (Env AttrContext)} dep (.-dependencies scanner)]
                      (when-not (.isDone compileStates dep CompileStates$CompileState/WARN)
                        (.put desugaredEnvs
                              dep
                              (.desugar this (.warn this (.flow this (.attribute this dep)))))))
                    (when-not (.shouldStop this CompileStates$CompileState/TRANSTYPES)
                      (when verboseCompilePolicy
                        (.printNote this (java-str "[desugar " (.-sym (.-enclClass env)) "]")))
                      (let [prev (.useSource log
                                             ^JavaFileObject (if (some?
                                                                   (.-sourcefile
                                                                     (.-sym (.-enclClass env))))
                                                                 (.-sourcefile
                                                                   (.-sym (.-enclClass env)))
                                                                 (.-sourcefile (.-toplevel env))))]
                        (try
                          (let [untranslated (.-tree env)]
                            (.at make Position/FIRSTPOS)
                            (let [localMake (.forToplevel make (.-toplevel env))]
                              (if (or (.hasTag (.-tree env) JCTree$Tag/PACKAGEDEF)
                                      (.hasTag (.-tree env) JCTree$Tag/MODULEDEF))
                                  (when-not sourceOutput
                                    (when (.shouldStop this CompileStates$CompileState/LOWER)
                                      (return))
                                    (let [^{:tag (List JCTree)} def (.translateTopLevelClass
                                                                      lower
                                                                      env
                                                                      (.-tree env)
                                                                      localMake)]
                                      (when (some? (.-head def))
                                        (Assert/check (.isEmpty (.-tail def)))
                                        (.add results
                                              (Pair. env (cast JCTree$JCClassDecl (.-head def)))))))
                                  (when-not (.shouldStop this CompileStates$CompileState/TRANSTYPES)
                                    (set! (.-tree env)
                                          (.translateTopLevelClass
                                            transTypes
                                            (.-tree env)
                                            localMake))
                                    (.put compileStates env CompileStates$CompileState/TRANSTYPES)
                                    (when-not (.shouldStop
                                                this
                                                CompileStates$CompileState/TRANSPATTERNS)
                                      (when (.-hasPatterns scanner)
                                        (set! (.-tree env)
                                              (.translateTopLevelClass
                                                (TransPatterns/instance context)
                                                env
                                                (.-tree env)
                                                localMake)))
                                      (.put compileStates
                                            env
                                            CompileStates$CompileState/TRANSPATTERNS)
                                      (when-not (.shouldStop this CompileStates$CompileState/LOWER)
                                        (if sourceOutput
                                            (let [cdef (cast JCTree$JCClassDecl (.-tree env))]
                                              (when-instance [^JCTree$JCClassDecl classDecl
                                                                untranslated]
                                                (when (.contains rootClasses classDecl)
                                                  (.add results (Pair. env cdef)))))
                                            (let [^{:tag (List JCTree)} cdefs
                                                    (.translateTopLevelClass
                                                      lower
                                                      env
                                                      (.-tree env)
                                                      localMake)]
                                              (.put
                                                compileStates
                                                env
                                                CompileStates$CompileState/LOWER)
                                              (when-not (.shouldStop
                                                          this
                                                          CompileStates$CompileState/LOWER)
                                                (when (.-hasLambdas scanner)
                                                  (when (.shouldStop
                                                          this
                                                          CompileStates$CompileState/UNLAMBDA)
                                                    (return))
                                                  (for-each [^JCTree def cdefs]
                                                    (.translateTopLevelClass
                                                      (LambdaToMethod/instance context)
                                                      env
                                                      def
                                                      localMake))
                                                  (.put
                                                    compileStates
                                                    env
                                                    CompileStates$CompileState/UNLAMBDA))
                                                (loop [^{:tag (List JCTree)} l cdefs]
                                                  (when (.nonEmpty l)
                                                    (let [cdef (cast JCTree$JCClassDecl (.-head l))]
                                                      (.add results (Pair. env cdef))
                                                      (recur (.-tail l))))))))))))))
                          (finally (.useSource log prev)))))))))))))

  (method ^:public generate ^void [this
                                   ^{:tag (Queue (Pair (Env AttrContext) JCTree$JCClassDecl))} queue]
    (.generate this queue nil))

  (method ^:public generate ^void [this
                                   ^{:tag (Queue (Pair (Env AttrContext) JCTree$JCClassDecl))} queue
                                   ^{:tag (Queue JavaFileObject)} results]
    (when-not (.shouldStop this CompileStates$CompileState/GENERATE)
      (for-each [^{:tag (Pair (Env AttrContext) JCTree$JCClassDecl)} x queue]
        (let [^{:tag (Env AttrContext)} env (cast Env (.-fst x))
              cdef (cast JCTree$JCClassDecl (.-snd x))]
          (when verboseCompilePolicy
            (.printNote this
                        (java-str "[generate "
                                  (if sourceOutput " source" "code")
                                  " "
                                  (.-sym cdef)
                                  "]")))
          (when-not (.isEmpty taskListener)
            (let [e (TaskEvent. TaskEvent$Kind/GENERATE (.-toplevel env) (.-sym cdef))]
              (.started taskListener e)))
          (let [prev (.useSource log
                                 ^JavaFileObject (if (some?
                                                       (.-sourcefile (.-sym (.-enclClass env))))
                                                     (.-sourcefile (.-sym (.-enclClass env)))
                                                     (.-sourcefile (.-toplevel env))))]
            (try
              (let [^:mutable ^JavaFileObject file nil]
                (if sourceOutput
                    (set! file (.printSource this env cdef))
                    (do
                      (when (and (.hasLocation fileManager StandardLocation/NATIVE_HEADER_OUTPUT)
                                 (.needsHeader jniWriter (.-sym cdef)))
                        (.write jniWriter (.-sym cdef)))
                      (set! file (.genCode this env cdef))))
                (when (and (some? results) (some? file)) (.add results file)))
              (catch [IOException
                      UncheckedIOException
                      FileSystemNotFoundException
                      InvalidPathException
                      ReadOnlyFileSystemException] ex
                (.error log
                        (.pos cdef)
                        (CompilerProperties$Errors/ClassCantWrite (.-sym cdef) (.getMessage ex)))
                (return))
              (finally (.useSource log prev)))
            (when-not (.isEmpty taskListener)
              (let [e (TaskEvent. TaskEvent$Kind/GENERATE (.-toplevel env) (.-sym cdef))]
                (.finished taskListener e))))))))

  (method groupByFile ^{:tag (Map JCTree$JCCompilationUnit (Queue (Env AttrContext)))} [this
                                                                                        ^{:tag (Queue (Env AttrContext))} envs]
    (let [^{:tag (Map JCTree$JCCompilationUnit (Queue (Env AttrContext)))} map (LinkedHashMap.)]
      (for-each [^{:tag (Env AttrContext)} env envs]
        (let [^:mutable ^{:tag (Queue (Env AttrContext))} sublist (cast
                                                                    Queue
                                                                    (.get map (.-toplevel env)))]
          (when (nil? sublist) (set! sublist (ListBuffer.)) (.put map (.-toplevel env) sublist))
          (.add sublist env)))
      map))

  (method removeMethodBodies ^JCTree$JCClassDecl [this ^JCTree$JCClassDecl cdef]
    (let [isInterface (not (== (bit-and (.-flags (.-mods cdef)) Flags/INTERFACE) 0))]
      (letclass [(MethodBodyRemover
                   :extends TreeTranslator

                   (method ^:public visitMethodDef ^void [this ^JCTree$JCMethodDecl tree]
                     (let [o-5 (.-mods tree)]
                       (set! (.-flags o-5) (bit-and (.-flags o-5) (bit-not-int Flags/SYNCHRONIZED))))
                     (for-each [^JCTree$JCVariableDecl vd (.-params tree)]
                       (let [o-6 (.-mods vd)]
                         (set! (.-flags o-6) (bit-and (.-flags o-6) (bit-not-int Flags/FINAL)))))
                     (set! (.-body tree) nil)
                     (.visitMethodDef super tree))

                   (method ^:public visitVarDef ^void [this ^JCTree$JCVariableDecl tree]
                     (when (and (some? (.-init tree)) (nil? (.constValue (.-type (.-init tree)))))
                       (set! (.-init tree) nil))
                     (.visitVarDef super tree))

                   (method ^:public visitClassDef ^void [this ^JCTree$JCClassDecl tree]
                     (let [^{:tag (ListBuffer JCTree)} newdefs (ListBuffer.)]
                       (loop [^{:tag (List JCTree)} it (.-defs tree)]
                         (when (some? (.-tail it))
                           (let [t (cast JCTree (.-head it))]
                             (switch (.getTag t)
                               CLASSDEF
                                 (do
                                   (when (or (or
                                               isInterface
                                               (not
                                                 (==
                                                   (bit-and
                                                     (.-flags (.-mods (cast JCTree$JCClassDecl t)))
                                                     (bit-or-int Flags/PROTECTED Flags/PUBLIC))
                                                   0)))
                                             (and
                                               (==
                                                 (bit-and
                                                   (.-flags (.-mods (cast JCTree$JCClassDecl t)))
                                                   Flags/PRIVATE)
                                                 0)
                                               (identical?
                                                 (.getQualifiedName
                                                   (.packge (.-sym (cast JCTree$JCClassDecl t))))
                                                 (.-java_lang names))))
                                     (.append newdefs t))
                                   (recur (.-tail it)))
                               METHODDEF
                                 (do
                                   (when (or (or
                                               (or
                                                 isInterface
                                                 (not
                                                   (==
                                                     (bit-and
                                                       (.-flags
                                                         (.-mods (cast JCTree$JCMethodDecl t)))
                                                       (bit-or-int Flags/PROTECTED Flags/PUBLIC))
                                                     0)))
                                               (identical?
                                                 (.-name (.-sym (cast JCTree$JCMethodDecl t)))
                                                 (.-init names)))
                                             (and
                                               (==
                                                 (bit-and
                                                   (.-flags (.-mods (cast JCTree$JCMethodDecl t)))
                                                   Flags/PRIVATE)
                                                 0)
                                               (identical?
                                                 (.getQualifiedName
                                                   (.packge (.-sym (cast JCTree$JCMethodDecl t))))
                                                 (.-java_lang names))))
                                     (.append newdefs t))
                                   (recur (.-tail it)))
                               VARDEF
                                 (do
                                   (when (or (or
                                               isInterface
                                               (not
                                                 (==
                                                   (bit-and
                                                     (.-flags
                                                       (.-mods (cast JCTree$JCVariableDecl t)))
                                                     (bit-or-int Flags/PROTECTED Flags/PUBLIC))
                                                   0)))
                                             (and
                                               (==
                                                 (bit-and
                                                   (.-flags (.-mods (cast JCTree$JCVariableDecl t)))
                                                   Flags/PRIVATE)
                                                 0)
                                               (identical?
                                                 (.getQualifiedName
                                                   (.packge (.-sym (cast JCTree$JCVariableDecl t))))
                                                 (.-java_lang names))))
                                     (.append newdefs t))
                                   (recur (.-tail it)))
                               (recur (.-tail it))))))
                       (set! (.-defs tree) (.toList newdefs))
                       (.visitClassDef super tree))))]
        (let [r (MethodBodyRemover.)] (cast JCTree$JCClassDecl (.translate r cdef))))))

  (method ^:public reportDeferredDiagnostics ^void [this]
    (when (and (and (and (== (.errorCount this) 0) annotationProcessingOccurred)
                    implicitSourceFilesRead)
               (identical? implicitSourcePolicy ImplicitSourcePolicy/UNSET))
      (if (.explicitAnnotationProcessingRequested this)
          (.warning log CompilerProperties$Warnings/ProcUseImplicit)
          (.warning log CompilerProperties$Warnings/ProcUseProcOrImplicit)))
    (.reportOutstandingWarnings log)
    (.reportOutstandingNotes log)
    (when (.-compressedOutput log) (.note log CompilerProperties$Notes/CompressedDiags)))

  (method ^:public enterDone ^void [this]
    (set! enterDone true)
    (.enterDone annotate))

  (method ^:public isEnterDone ^boolean [this] enterDone)

  (method ^:private readModuleName ^Name [this ^JavaFileObject fo]
    (.parseAndGetName this
                      fo
                      (lambda Function ^Name [^JCTree$JCCompilationUnit t]
                        (let [md (.getModuleDecl t)]
                          (when (some? md) (TreeInfo/fullName (.getName md)))))))

  (method ^:private findPackageInFile ^Name [this ^JavaFileObject fo]
    (.parseAndGetName this
                      fo
                      (lambda Function ^Name [^JCTree$JCCompilationUnit t]
                        (when (some? (.getPackage t))
                          (TreeInfo/fullName (.getPackageName (.getPackage t)))))))

  (method ^:private parseAndGetName ^Name [this ^JavaFileObject fo
                                           ^{:tag (Function JCTree$JCCompilationUnit Name)} tree2Name]
    (let [^Log$DiagnosticHandler dh (.new log Log$DiscardDiagnosticHandler)
          prevSource (.useSource log fo)]
      (try
        (let [t (.parse this fo (.getCharContent fo false) true)] (cast Name (.apply tree2Name t)))
        (catch IOException e nil)
        (finally (.popDiagnosticHandler log dh) (.useSource log prevSource)))))

  (method ^:public reportDeferredDiagnosticAndClearHandler ^void [this]
    (when (some? deferredDiagnosticHandler)
      (let [^{:tag (ToIntFunction JCDiagnostic)} diagValue
              (lambda ToIntFunction ^int [^JCDiagnostic d]
                (if (.isFlagSet d JCDiagnostic$DiagnosticFlag/RECOVERABLE) 1 0))
            ^{:tag (Comparator JCDiagnostic)} compareDiags (lambda Comparator ^int [^JCDiagnostic d1
                                                                                    ^JCDiagnostic d2]
                                                             (unchecked-subtract-int
                                                               (.applyAsInt diagValue d1)
                                                               (.applyAsInt diagValue d2)))]
        (.reportDeferredDiagnostics deferredDiagnosticHandler compareDiags)
        (.popDiagnosticHandler log deferredDiagnosticHandler)
        (set! deferredDiagnosticHandler nil))))

  (method ^:public close ^void [this]
    (set! rootClasses nil)
    (set! finder nil)
    (set! reader nil)
    (set! make nil)
    (set! writer nil)
    (set! enter nil)
    (when (some? todo) (.clear todo))
    (set! todo nil)
    (set! parserFactory nil)
    (set! syms nil)
    (set! source nil)
    (set! attr nil)
    (set! chk nil)
    (set! gen nil)
    (set! lintMapper nil)
    (set! flow nil)
    (set! transTypes nil)
    (set! lower nil)
    (set! annotate nil)
    (set! types nil)
    (.flush log)
    (try
      (.flush fileManager)
      (catch IOException e (throw (Abort. e)))
      (finally
        (when (some? names) (.dispose names))
        (set! names nil)
        (let [^:mutable ^FatalError fatalError nil]
          (for-each [^Closeable c closeables]
            (try
              (.close c)
              (catch IOException e
                (if (nil? fatalError)
                    (let [msg (.fragment diagFactory CompilerProperties$Fragments/FatalErrCantClose)]
                      (set! fatalError (FatalError. msg e)))
                    (.addSuppressed fatalError e)))))
          (when (some? fatalError) (throw fatalError))
          (set! closeables (List/nil))))))

  (method ^:protected printNote ^void [this ^String lines]
    (.printRawLines log Log$WriterKind/NOTICE lines))

  (method ^:public printCount ^void [this ^String kind ^int count]
    (when-not (== count 0)
      (let [^String key (if (== count 1)
                            (java-str "count." kind)
                            (java-str "count." kind ".plural"))]
        (.printLines log Log$WriterKind/ERROR key (new Object/1 [(String/valueOf count)]))
        (.flush log Log$WriterKind/ERROR))))

  (method ^:private printSuppressedCount ^void [this ^int shown ^int suppressed ^String diagKey]
    (when (> suppressed 0)
      (let [total (unchecked-add-int shown suppressed)]
        (.printLines log
                     Log$WriterKind/ERROR
                     diagKey
                     (new Object/1 [(String/valueOf shown) (String/valueOf total)]))
        (.flush log Log$WriterKind/ERROR))))

  (method ^:private ^:static now ^long [] (System/currentTimeMillis))

  (method ^:private ^:static elapsed ^long [^long then]
    (unchecked-subtract (JavaCompiler/now) then))

  (method ^:public newRound ^void [this]
    (.clear inputFiles)
    (.clear todo))

  (defclass ^:public ^:interface InitialFileParserIntf
    (method ^:public parse ^{:tag (List JCTree$JCCompilationUnit)} [this
                                                                    ^{:tag (Iterable JavaFileObject)} files]))

  (defclass ^:public ^:static InitialFileParser
    :implements [InitialFileParserIntf]

    (field ^:public ^:static ^:final ^{:tag (Context$Key InitialFileParserIntf)} initialParserKey
      (Context$Key.))

    (method ^:public ^:static instance ^InitialFileParserIntf [^Context context]
      (let [^:mutable instance (cast InitialFileParserIntf (.get context initialParserKey))]
        (when (nil? instance) (set! instance (InitialFileParser. context)))
        instance))

    (field ^:private ^:final ^JavaCompiler compiler)

    (constructor ^:private [this ^Context context]
      (.put context initialParserKey this)
      (set! (.-compiler this) (JavaCompiler/instance context)))

    (method ^:public parse ^{:tag (List JCTree$JCCompilationUnit)} [this
                                                                    ^{:tag (Iterable JavaFileObject)} fileObjects]
      (.parseFiles compiler fileObjects false))))

                                                                                      (cast
                                                                                        JCTree$JCNewArray
                                                                                        tree))]
                             (for-each [^Attribute value (.-values array)]
                               (let [match (.matchAttributeToTree
                                             JavacElements/this
                                             findme
                                             value
                                             (cast JCTree (.-head elems)))]
                                 (when (some? match) (set! result match) (return))
                                 (set! elems (.-tail elems)))))
                         (== (alength (.-values array)) 1)
                           (set! result
                                 (.matchAttributeToTree
                                   JavacElements/this
                                   findme
                                   (aget (.-values array) 0)
                                   tree))))


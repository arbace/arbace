                     (method ^:public visitError ^void [this ^Attribute$Error e]))]
          (let [vis (Vis.)] (.accept attr vis) (.-result vis)))))

  (method ^:private scanForAssign ^JCTree$JCExpression [this ^:final ^Symbol$MethodSymbol sym
                                                        ^:final ^JCTree tree]
    (letclass [(TS
                 :extends TreeScanner

                 (field ^JCTree$JCExpression result nil)

                 (method ^:public scan ^void [this ^JCTree t]
                   (when (and (some? t) (nil? result)) (.accept t this)))

                 (method ^:public visitAnnotation ^void [this ^JCTree$JCAnnotation t]
                   (when (identical? t tree) (.scan this (.-args t))))

                 (method ^:public visitAssign ^void [this ^JCTree$JCAssign t]
                   (when (.hasTag (.-lhs t) JCTree$Tag/IDENT)
                     (let [ident (cast JCTree$JCIdent (.-lhs t))]
                       (when (identical? (.-sym ident) sym) (set! result (.-rhs t)))))))]
      (let [scanner (TS.)] (.accept tree scanner) (.-result scanner))))

  (method ^:public getTree ^JCTree [this ^Element e]
    (let [^{:tag (Pair JCTree ?)} treeTop (.getTreeAndTopLevel this e)]
      (when (some? treeTop) (cast JCTree (.-fst treeTop)))))


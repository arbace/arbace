    (cast String
          (.getDocCommentItem this
                              e
                              (lambda BiFunction ^String [^DocCommentTable docCommentTable
                                                          ^JCTree tree]
                                (.getCommentText docCommentTable tree)))))

  (method ^:public getDocCommentKind ^Elements$DocCommentKind [this ^Element e]
    (cast Elements$DocCommentKind
          (.getDocCommentItem
            this
            e
            (lambda BiFunction ^Elements$DocCommentKind [^DocCommentTable docCommentTable
                                                         ^JCTree tree]
              (.getCommentKind docCommentTable tree)))))

  (method ^:private getDocCommentItem :type-params [R] ^R [this ^Element e
                                                           ^{:tag (BiFunction DocCommentTable JCTree R)} f]
    (let [^{:tag (Pair JCTree JCTree$JCCompilationUnit)} treeTop (.getTreeAndTopLevel this e)]
      (when (some? treeTop)
        (let [tree (cast JCTree (.-fst treeTop))
              toplevel (cast JCTree$JCCompilationUnit (.-snd treeTop))]
          (when (some? (.-docComments toplevel)) (.apply f (.-docComments toplevel) tree))))))

  (method ^:public getPackageOf ^PackageElement [this ^Element e]
    (let [sym (cast Symbol (JavacElements/cast Symbol e))]
      (when-not (or (identical? (.-kind sym) Kinds$Kind/MDL)
                    (identical? (.-kind (.-owner sym)) Kinds$Kind/MDL))
        ^PackageElement (.packge sym))))

  (method ^:public getModuleOf ^ModuleElement [this ^Element e]
    (let [sym (cast Symbol (JavacElements/cast Symbol e))]
      (when-not (identical? (.getDefaultModule modules) (.-noModule syms))
        (cond
          (identical? (.-kind sym) Kinds$Kind/MDL) (cast ModuleElement e)
          (identical? (.-kind (.-owner sym)) Kinds$Kind/MDL) (cast ModuleElement (.-owner sym))
          :else ^ModuleElement (.-modle (.packge sym))))))

  (method ^:public isDeprecated ^boolean [this ^Element e]
    (let [sym (cast Symbol (JavacElements/cast Symbol e))] (.apiComplete sym) (.isDeprecated sym)))

  (method ^:public getOrigin ^Elements$Origin [this ^Element e]
    (let [sym (cast Symbol (JavacElements/cast Symbol e))]
      (cond
        (not (== (bit-and (.flags sym) Flags/GENERATEDCONSTR) 0)) Elements$Origin/MANDATED
        (not (== (bit-and (.flags sym) Flags/MANDATED) 0)) Elements$Origin/MANDATED
        :else Elements$Origin/EXPLICIT)))

  (method ^:public getOrigin ^Elements$Origin [this ^AnnotatedConstruct c ^AnnotationMirror a]
    (let [ac (cast Attribute$Compound (JavacElements/cast Attribute$Compound a))]
      (if (.isSynthesized ac) Elements$Origin/MANDATED Elements$Origin/EXPLICIT)))

  (method ^:public getOrigin ^Elements$Origin [this ^ModuleElement m
                                               ^ModuleElement$Directive directive]
    (switch (.getKind directive)
      REQUIRES
        (let [rd (cast Directive$RequiresDirective
                       (JavacElements/cast Directive$RequiresDirective directive))]
          (when (.contains (.-flags rd) Directive$RequiresFlag/MANDATED)
            (return Elements$Origin/MANDATED))
          (when (.contains (.-flags rd) Directive$RequiresFlag/SYNTHETIC)
            (return Elements$Origin/SYNTHETIC))
          (return Elements$Origin/EXPLICIT))
      EXPORTS
        (let [ed (cast Directive$ExportsDirective
                       (JavacElements/cast Directive$ExportsDirective directive))]
          (when (.contains (.-flags ed) Directive$ExportsFlag/MANDATED)
            (return Elements$Origin/MANDATED))
          (when (.contains (.-flags ed) Directive$ExportsFlag/SYNTHETIC)
            (return Elements$Origin/SYNTHETIC))
          (return Elements$Origin/EXPLICIT))
      OPENS
        (let [od (cast Directive$OpensDirective
                       (JavacElements/cast Directive$OpensDirective directive))]
          (when (.contains (.-flags od) Directive$OpensFlag/MANDATED)
            (return Elements$Origin/MANDATED))
          (when (.contains (.-flags od) Directive$OpensFlag/SYNTHETIC)
            (return Elements$Origin/SYNTHETIC))
          (return Elements$Origin/EXPLICIT)))
    Elements$Origin/EXPLICIT)

  (method ^:public getBinaryName ^Name [this ^TypeElement type]
    (.flatName (cast Symbol$TypeSymbol (JavacElements/cast Symbol$TypeSymbol type))))

  (method ^:public getElementValuesWithDefaults ^{:tag (Map Symbol$MethodSymbol Attribute)} [this
                                                                                             ^AnnotationMirror a]
    (let [anno (cast Attribute$Compound (JavacElements/cast Attribute$Compound a))
          annotype (.getAnnotationType a)
          ^{:tag (Map Symbol$MethodSymbol Attribute)} valmap (.getElementValues anno)]
      (for-each [^ExecutableElement ex (ElementFilter/methodsIn
                                         (.getEnclosedElements (.asElement annotype)))]
        (let [meth (cast Symbol$MethodSymbol ex)
              defaultValue (.getDefaultValue meth)]
          (when (and (some? defaultValue) (not (.containsKey valmap meth)))
            (.put valmap meth defaultValue))))
      valmap))

  (method ^:public getAllMembers ^FilteredMemberList [this ^TypeElement element]
    (let [sym (cast Symbol (JavacElements/cast Symbol element))
          scope (.dupUnshared (.members sym))
          ^{:tag (List Type)} closure (.closure types (.asType sym))]
      (for-each [^Type t closure] (.addMembers this scope t))
      (FilteredMemberList. scope)))

  (method ^:private addMembers ^void [this ^Scope$WriteableScope scope ^Type type]
    (label :members
      (for-each [^Symbol e (.getSymbols (.members (.asElement type)) Scope$LookupKind/NON_RECURSIVE)]
        (for-each [^Symbol overrider (.getSymbolsByName scope (.getSimpleName e))]
          (when (and (identical? (.-kind overrider) (.-kind e))
                     (== (bit-and (.flags overrider) Flags/SYNTHETIC) 0))
            (when (and (identical? (.getKind overrider) ElementKind/METHOD)
                       (.overrides this
                                   (cast ExecutableElement overrider)
                                   (cast ExecutableElement e)
                                   (cast TypeElement (.asElement type))))
              (continue :members))))
        (let [derived (not (identical? (.getEnclosingElement e) (.-owner scope)))
              kind (.getKind e)
              initializer (or (or (identical? kind ElementKind/CONSTRUCTOR)
                                  (identical? kind ElementKind/INSTANCE_INIT))
                              (identical? kind ElementKind/STATIC_INIT))]
          (when (or (not derived) (and (not initializer) (.isInheritedIn e (.-owner scope) types)))
            (.enter scope e))))))

  (method ^:public getOutermostTypeElement ^TypeElement [this ^Element e]
    (let [sym (cast Symbol (JavacElements/cast Symbol e))] (.outermostClass sym)))

  (method ^:public getAllAnnotationMirrors ^{:tag (List Attribute$Compound)} [this ^Element e]
    (let [^:mutable sym (cast Symbol (JavacElements/cast Symbol e))
          ^:mutable ^{:tag (List Attribute$Compound)} annos (.getAnnotationMirrors sym)]
      (while (identical? (.getKind sym) ElementKind/CLASS)
        (let [sup (.getSuperclass (cast Symbol$ClassSymbol sym))]
          (when (or (or (not (.hasTag sup TypeTag/CLASS)) (.isErroneous sup))
                    (identical? (.-tsym sup) (.-tsym (.-objectType syms))))
            (break))
          (set! sym (.-tsym sup))
          (let [^{:tag (List Attribute$Compound)} oldAnnos annos
                ^{:tag (List Attribute$Compound)} newAnnos (.getAnnotationMirrors sym)]
            (for-each [^Attribute$Compound anno newAnnos]
              (when (and (.isInherited this (.-type anno))
                         (not (JavacElements/containsAnnoOfType oldAnnos (.-type anno))))
                (set! annos (.prepend annos anno)))))))
      annos))

  (method ^:private isInherited ^boolean [this ^Type annotype]
    (some? (.attribute (.-tsym annotype) (.-tsym (.-inheritedType syms)))))

  (method ^:private ^:static containsAnnoOfType ^boolean [^{:tag (List Attribute$Compound)} annos
                                                          ^Type type]
    (for-each [^Attribute$Compound anno annos]
      (when (identical? (.-tsym (.-type anno)) (.-tsym type)) (return true)))
    false)

  (method ^:public hides ^boolean [this ^Element hiderEl ^Element hideeEl]
    (let [hider (cast Symbol (JavacElements/cast Symbol hiderEl))
          hidee (cast Symbol (JavacElements/cast Symbol hideeEl))]
      (if (or (or (identical? hider hidee) (not (identical? (.-kind hider) (.-kind hidee))))
              (not (identical? (.-name hider) (.-name hidee))))
          false
          (do
            (when (identical? (.-kind hider) Kinds$Kind/MTH)
              (when (or (not (.isStatic hider))
                        (not (.isSubSignature types (.-type hider) (.-type hidee))))
                (return false)))
            (let [hiderClass (.enclClass (.-owner hider))
                  hideeClass (.enclClass (.-owner hidee))]
              (if (or (or (nil? hiderClass) (nil? hideeClass))
                      (not (.isSubClass hiderClass hideeClass types)))
                  false
                  (.isAccessibleIn hidee hiderClass types)))))))

  (method ^:public overrides ^boolean [this ^ExecutableElement riderEl ^ExecutableElement rideeEl
                                       ^TypeElement typeEl]
    (let [rider (cast Symbol$MethodSymbol (JavacElements/cast Symbol$MethodSymbol riderEl))
          ridee (cast Symbol$MethodSymbol (JavacElements/cast Symbol$MethodSymbol rideeEl))
          origin (cast Symbol$ClassSymbol (JavacElements/cast Symbol$ClassSymbol typeEl))]
      (and (and (and (and (identical? (.-name rider) (.-name ridee)) (not (identical? rider ridee)))
                     (not (.isStatic rider)))
                (.isMemberOf ridee origin types))
           (.overrides rider ridee origin types false))))

  (method ^:public getConstantExpression ^String [this value]
    (Constants/format value))

  (method ^:public printElements ^void [this ^Writer w & ^Element/1 elements]
    (for-each [^Element element elements]
      (.flush (cast PrintingProcessor$PrintingElementVisitor
                    (.visit (PrintingProcessor$PrintingElementVisitor. w this) element)))))

  (method ^:public getName ^Name [this ^CharSequence cs]
    (.fromString names (.toString cs)))

  (method ^:public isFunctionalInterface ^boolean [this ^TypeElement element]
    (if (not (identical? (.getKind element) ElementKind/INTERFACE))
        false
        (let [tsym (cast Symbol$TypeSymbol (JavacElements/cast Symbol$TypeSymbol element))]
          (.isFunctionalInterface types tsym))))

  (method ^:public isAutomaticModule ^boolean [this ^ModuleElement module]
    (let [msym (cast Symbol$ModuleSymbol module)]
      (not (== (bit-and (.flags msym) Flags/AUTOMATIC_MODULE) 0))))

  (method ^:public getEnumConstantBody ^TypeElement [this ^VariableElement enumConstant]
    (if (identical? (.getKind enumConstant) ElementKind/ENUM_CONSTANT)
        (let [enumBodyTree (.getTreeAlt this enumConstant)
              enclosingEnumTree (.getTreeAlt this (.getEnclosingElement enumConstant))]
          (when-instance [^JCTree$JCVariableDecl decl enumBodyTree]
            (when-instance [^JCTree$JCClassDecl clazz enclosingEnumTree]
              (when-instance [^JCTree$JCNewClass nc (.-init decl)]
                (when (some? (.-def nc))
                  (when-not (== (bit-and (.-flags_field (.-sym clazz)) Flags/UNATTRIBUTED) 0)
                    (.attribClass attr (.pos clazz) (.-sym clazz)))
                  (.-sym (.-def nc)))))))
        (throw (IllegalArgumentException. "Argument not an enum constant"))))

  (method ^:private getTreeAlt ^JCTree [this ^Element e]
    (let [sym (cast Symbol (JavacElements/cast Symbol e))
          ^{:tag (Env AttrContext)} enterEnv (.getEnterEnv this sym)]
      (when (some? enterEnv) (let [tree (TreeInfo/declarationFor sym (.-tree enterEnv))] tree))))

  (method ^:public isCompactConstructor ^boolean [this ^ExecutableElement e]
    (not (== (bit-and (.flags (cast Symbol$MethodSymbol e)) Flags/COMPACT_RECORD_CONSTRUCTOR) 0)))

  (method ^:public isCanonicalConstructor ^boolean [this ^ExecutableElement e]
    (not (== (bit-and (.flags (cast Symbol$MethodSymbol e)) Flags/RECORD) 0)))

  (method ^:public getFileObjectOf ^JavaFileObject [this ^Element e]
    (let [sym (cast Symbol e)]
      (label :switch
        (switch (.-kind sym)
          PCK
            (let [psym (cast Symbol$PackageSymbol sym)]
              (when (nil? (.-package_info psym)) (break :switch nil))
              (.-classfile (.-package_info psym)))
          MDL
            (let [msym (cast Symbol$ModuleSymbol sym)]
              (when (nil? (.-module_info msym)) (break :switch nil))
              (.-classfile (.-module_info msym)))
          TYP (.-classfile (cast Symbol$ClassSymbol sym))
          ERR nil
          (.-classfile (.enclClass sym))))))

  (method ^:private getTreeAndTopLevel ^{:tag (Pair JCTree JCTree$JCCompilationUnit)} [this
                                                                                       ^Element e]
    (let [sym (cast Symbol (JavacElements/cast Symbol e))]
      (when (identical? (.-kind sym) Kinds$Kind/PCK)
        (let [^Symbol$TypeSymbol pkgInfo (.-package_info (cast Symbol$PackageSymbol sym))]
          (when (some? pkgInfo) (.complete pkgInfo))))
      (let [^{:tag (Env AttrContext)} enterEnv (.getEnterEnv this sym)]
        (when (some? enterEnv)
          (let [tree (TreeInfo/declarationFor sym (.-tree enterEnv))]
            (when-not (or (nil? tree) (nil? (.-toplevel enterEnv)))
              (Pair. tree (.-toplevel enterEnv))))))))

  (method ^:public getTreeAndTopLevel ^{:tag (Pair JCTree JCTree$JCCompilationUnit)} [this
                                                                                      ^Element e
                                                                                      ^AnnotationMirror a
                                                                                      ^AnnotationValue v]
    (when (some? e)
      (let [^{:tag (Pair JCTree JCTree$JCCompilationUnit)} elemTreeTop (.getTreeAndTopLevel this e)]
        (when (some? elemTreeTop)
          (if (nil? a)
              elemTreeTop
              (let [annoTree (.matchAnnoToTree this a e (cast JCTree (.-fst elemTreeTop)))]
                (cond
                  (nil? annoTree) elemTreeTop
                  (nil? v) (Pair. annoTree (cast JCTree$JCCompilationUnit (.-snd elemTreeTop)))
                  :else
                    (let [valueTree (.matchAttributeToTree
                                      this
                                      (cast Attribute (JavacElements/cast Attribute v))
                                      (cast Attribute (JavacElements/cast Attribute a))
                                      annoTree)]
                      (if (nil? valueTree)
                          (Pair. annoTree (cast JCTree$JCCompilationUnit (.-snd elemTreeTop)))
                          (Pair. valueTree (cast JCTree$JCCompilationUnit (.-snd elemTreeTop))))))))))))

  (method ^:private getEnterEnv ^{:tag (Env AttrContext)} [this ^Symbol sym]
    (let [^:mutable ^Symbol$TypeSymbol ts nil]
      (switch (.-kind sym)
        PCK (set! ts (cast Symbol$PackageSymbol sym))
        MDL (set! ts (cast Symbol$ModuleSymbol sym))
        (set! ts (.enclClass sym)))
      (when (some? ts) (.getEnv enter ts))))

  (method ^:private ensureEntered ^void [this ^String methodName]
    (when (some? javacTaskImpl) (.ensureEntered javacTaskImpl))
    (when-not (.isEnterDone javaCompiler)
      (throw (IllegalStateException.
               (java-str "Cannot use Elements."
                         methodName
                         " before the TaskEvent.Kind.ENTER finished event.")))))

  (method ^:private ^:static cast :type-params [T] ^T [^{:tag (Class T)} clazz o]
    (when-not (.isInstance clazz o) (throw (IllegalArgumentException. (.toString o))))
    (.cast clazz o))

  (method ^:public newRound ^void [this] (.clear resultCache)))

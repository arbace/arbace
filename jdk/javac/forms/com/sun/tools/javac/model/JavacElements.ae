        (.nameToSymbol this (.-noModule syms) nameStr clazz)
        (cast
          Symbol
          (.orElse
            (cast
              Optional
              (.computeIfAbsent
                resultCache
                (Pair/of methodName nameStr)
                (lambda Function ^Optional [^Pair p]
                  (let [^{:tag (Set S)} found (LinkedHashSet.)
                        ^{:tag (Set Symbol$ModuleSymbol)} allModules (HashSet.
                                                                       (.allModules modules))]
                    (.removeAll allModules (.getRootModules modules))
                    (for-each [^{:tag (Set Symbol$ModuleSymbol)} modules (Arrays/asList
                                                                           (new
                                                                             Set/1
                                                                             [(.getRootModules
                                                                                modules)
                                                                              allModules]))]
                      (for-each [^Symbol$ModuleSymbol msym modules]
                        (let [^S sym (.nameToSymbol this msym nameStr clazz)]
                          (when (some? sym)
                            (cond
                              (identical? clazz Symbol$ClassSymbol) (.add found sym)
                              (identical? clazz Symbol$PackageSymbol)
                                (when (or (not (.isEmpty (.members sym)))
                                          (some? (.-package_info (cast Symbol$PackageSymbol sym))))
                                  (.add found sym))))))
                      (if (== (.size found) 1)
                          (return (Optional/of (cast Symbol (.next (.iterator found)))))
                          (when (> (.size found) 1)
                            (when (.add alreadyWarnedDuplicates (java-str methodName ":" nameStr))
                              (let [moduleNames (cast
                                                  String
                                                  (.collect
                                                    (.map
                                                      (.map
                                                        (.stream found)
                                                        (lambda Function ^Symbol$ModuleSymbol [^Symbol s]
                                                          (.-modle (.packge s))))
                                                      (lambda Function ^String [^Symbol$ModuleSymbol m]
                                                        (.toString m)))
                                                    (Collectors/joining ", ")))]
                                (.note log
                                       (CompilerProperties$Notes/MultipleElements
                                         methodName
                                         nameStr
                                         moduleNames))))
                            (return (Optional/empty)))))
                    (Optional/empty)))))
            nil))))

  (method ^:private nameToSymbol :type-params [(S extends Symbol)] ^S [this
                                                                       ^Symbol$ModuleSymbol module
                                                                       ^String nameStr
                                                                       ^{:tag (Class S)} clazz]

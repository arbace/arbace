                     (.equals name (.getQualifiedName sym)))
            (return (cast Symbol (.cast clazz sym)))))
        nil
        (catch Symbol$CompletionFailure cf (.handleAPICompletionFailure (.-dcfh cf) cf) nil))))

  (method ^:private matchAnnoToTree ^JCTree [this ^AnnotationMirror findme ^Element e ^JCTree tree]

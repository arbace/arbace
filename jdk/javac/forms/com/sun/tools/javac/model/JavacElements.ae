                   :extends JCTree$Visitor

                   (field ^{:tag (List JCTree$JCAnnotation)} result nil)

                   (method ^:public visitModuleDef ^void [this ^JCTree$JCModuleDecl tree]
                     (set! result (.-annotations (.-mods tree))))

                   (method ^:public visitPackageDef ^void [this ^JCTree$JCPackageDecl tree]
                     (set! result (.-annotations tree)))

                   (method ^:public visitClassDef ^void [this ^JCTree$JCClassDecl tree]
                     (set! result (.-annotations (.-mods tree))))

                   (method ^:public visitMethodDef ^void [this ^JCTree$JCMethodDecl tree]
                     (set! result (.-annotations (.-mods tree))))

                   (method ^:public visitVarDef ^void [this ^JCTree$JCVariableDecl tree]
                     (set! result (.-annotations (.-mods tree))))

                   (method ^:public visitTypeParameter ^void [this ^JCTree$JCTypeParameter tree]
                     (set! result (.-annotations tree))))]
        (let [vis (Vis.)]
          (.accept tree vis)
          (when (some? (.-result vis))
            (let [^{:tag (List Attribute$Compound)} annos (.getAnnotationMirrors sym)]
              (.matchAnnoToTree this
                                (cast Attribute$Compound
                                      (JavacElements/cast Attribute$Compound findme))
                                annos
                                (.-result vis))))))))

  (method ^:private matchAnnoToTree ^JCTree [this ^Attribute$Compound findme
                                             ^{:tag (List Attribute$Compound)} annos
                                             ^{:tag (List JCTree$JCAnnotation)} trees]
    (for-each [^Attribute$Compound anno annos]
      (for-each [^JCTree$JCAnnotation tree trees]
        (when-not (not (identical? (.-tsym (.-type tree)) (.-tsym (.-type anno))))
          (let [match (.matchAttributeToTree this findme anno tree)]
            (when (some? match) (return match))))))
    nil)

  (method ^:private matchAttributeToTree ^JCTree [this ^:final ^Attribute findme
                                                  ^:final ^Attribute attr ^:final ^JCTree tree]
    (if (identical? attr findme)
        tree
        (letclass [(Vis
                     :implements [Attribute$Visitor]

                     (field ^JCTree result nil)

                     (method ^:public visitConstant ^void [this ^Attribute$Constant value])

                     (method ^:public visitClass ^void [this ^Attribute$Class clazz])

                     (method ^:public visitCompound ^void [this ^Attribute$Compound anno]
                       (for-each [^{:tag (Pair Symbol$MethodSymbol Attribute)} pair (.-values anno)]
                         (let [expr (.scanForAssign
                                      JavacElements/this
                                      (cast Symbol$MethodSymbol (.-fst pair))
                                      tree)]
                           (when (some? expr)
                             (let [match (.matchAttributeToTree
                                           JavacElements/this
                                           findme
                                           (cast Attribute (.-snd pair))
                                           expr)]
                               (when (some? match) (set! result match) (return)))))))


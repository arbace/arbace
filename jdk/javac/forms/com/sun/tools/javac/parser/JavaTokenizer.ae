      deprecatedFlag)

    (method trimEndOfComment ^UnicodeReader [this ^UnicodeReader line]
      (let [pos (.position line)
            ^:mutable allWhitespace true]
        (while (.isAvailable line)
          (let [endPos (.position line)]
            (if (and (not (== (.skip line \*) 0)) (.is line \/))
                (return (.lineReader line (if allWhitespace endPos pos) endPos))
                (do (set! allWhitespace (and allWhitespace (.isWhitespace line))) (.next line)))))
        (.reset line pos)
        line))

    (method trimJavadocComment ^UnicodeReader [this ^:mutable ^UnicodeReader line]
      (set! line (.trimEndOfComment this line))
      (let [pos (.position line)]
        (.skipWhitespace line)
        (if (not (.isAvailable line))
            line
            (do (when (== (.skip line \*) 0) (.reset line pos)) line))))

    (method getJavadocLineCommentIndent ^int [this]
      (let [^:mutable result Integer/MAX_VALUE
            fullReader (.lineReader this
                                    (.position this)
                                    (unchecked-add-int (.position this) (.length this)))]
        (while (.isAvailable fullReader)
          (let [line (.lineReader fullReader)]
            (.skipWhitespace line)
            (.accept line "///")
            (let [pos (.position line)]
              (.skipWhitespace line)
              (when (.isAvailable line)
                (set! result (Integer/min result (unchecked-subtract-int (.position line) pos)))))))
        (if (== result Integer/MAX_VALUE) 0 result)))

    (method trimJavadocLineComment ^UnicodeReader [this ^UnicodeReader line ^int indent]
      (.skipWhitespace line)
      (.accept line "///")
      (loop [^int i 0]
        (when (and (.isAvailable line) (< i indent)) (.next line) (recur (unchecked-inc-int i))))
      line)

    (method ^:protected putLine ^void [this ^UnicodeReader line])

    (method ^:protected scanDocComment ^void [this]
      (when-not scanned
        (set! deprecatedFlag false)
        (set! scanned true)
        (let [^:mutable ^Tokens$Comment$CommentStyle style nil
              ^:mutable ^int indent 0
              start (.position this)]
          (cond
            (.accept this "/**")
              (do
                (set! style Tokens$Comment$CommentStyle/JAVADOC_BLOCK)
                (when (and (not (== (.skip this \*) 0)) (.is this \/)) (return))
                (.skipWhitespace this)
                (when (.isEOLN this) (.accept this \return) (.accept this \newline)))
            (.accept this "///")
              (do
                (set! style Tokens$Comment$CommentStyle/JAVADOC_LINE)
                (.reset this start)
                (set! indent (.getJavadocLineCommentIndent this)))
            :else (return))
          (while (.isAvailable this)
            (let [^:mutable line (.lineReader this)]
              (set! line
                    (if (identical? style Tokens$Comment$CommentStyle/JAVADOC_LINE)
                        (.trimJavadocLineComment this line indent)
                        (.trimJavadocComment this line)))
              (when (identical? cs Tokens$Comment$CommentStyle/JAVADOC_BLOCK)
                (let [pos (.position line)]
                  (.skipWhitespace line)
                  (when (and (.accept line "@deprecated")
                             (or (or (or (not (.isAvailable line)) (.isWhitespace line))
                                     (.isEOLN line))
                                 (== (.get line) LayoutCharacters/EOI)))
                    (set! deprecatedFlag true))
                  (.reset line pos)))
              (.putLine this line))))))))

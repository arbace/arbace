              (let [^{:tag (ListBuffer DCTree)} v (ListBuffer.)]
                (.nextChar this)
                (.skipWhitespace this)
                (if (or (== ch \') (== ch \"))
                    (do
                      (set! newline false)
                      (set! vkind
                            (if (== ch \')
                                AttributeTree$ValueKind/SINGLE
                                AttributeTree$ValueKind/DOUBLE))
                      (let [quote ch]
                        (.nextChar this)
                        (set! textStart bp)
                        (while (and (< bp buflen) (not (== ch quote))) (.attrValueChar this v))
                        (.addPendingText this v (unchecked-subtract-int bp 1) DocTree$Kind/TEXT)
                        (.nextChar this)))
                    (do
                      (set! vkind AttributeTree$ValueKind/UNQUOTED)
                      (set! textStart bp)
                      (while (and (< bp buflen) (not (.isUnquotedAttrValueTerminator this ch)))
                        (.attrValueChar this v))
                      (.addPendingText this v (unchecked-subtract-int bp 1) DocTree$Kind/TEXT)))
                (.skipWhitespace this)
                (set! value (.toList v))))
            (let [attr (.newAttributeTree (.at m namePos) name vkind value)] (.add attrs attr)))))
      (.toList attrs)))

  (method normalizePreContent ^{:tag (ListBuffer DCTree)} [this ^{:tag (ListBuffer DCTree)} trees]
    (if (or (identical? textKind DocTree$Kind/MARKDOWN) isHtmlFile)
        trees
        (letclass [(^:enum State
                     (constants BEFORE_CODE AFTER_CODE SUCCEEDED FAILED))
                   (Context
                     (field ^State state State/BEFORE_CODE)

                     (method unexpectedTree ^void [this]
                       (when-not (identical? state State/SUCCEEDED) (set! state State/FAILED))))]
          (let [visitor (anon (SimpleDocTreeVisitor DCTree Context) []
                          (method ^:public visitText ^DCTree [this ^TextTree text ^Context cx]
                            (when-not (and (identical? (.-state cx) State/BEFORE_CODE)
                                           (.matches (.getBody text) "[ \t]+"))
                              (if (and (identical? (.-state cx) State/AFTER_CODE)
                                       (.startsWith (.getBody text) "\n"))
                                  (do
                                    (set! (.-state cx) State/SUCCEEDED)
                                    (.newTextTree
                                      (.at m
                                           (unchecked-add-int (.-pos (cast DCTree$DCText text)) 1))
                                      (.substring (.getBody text) 1)))
                                  (do (.unexpectedTree cx) (cast DCTree text)))))

                          (method ^:public visitLiteral ^DCTree [this ^LiteralTree literal
                                                                 ^Context cx]
                            (if (and (identical? (.-state cx) State/BEFORE_CODE)
                                     (.startsWith (.getBody (.getBody literal)) "\n"))
                                (do
                                  (set! (.-state cx) State/SUCCEEDED)
                                  (let [oldBody (cast DCTree$DCText (.getBody literal))
                                        newBody (.newTextTree
                                                  (.at m (unchecked-add-int (.-pos oldBody) 1))
                                                  (.substring (.getBody oldBody) 1))]
                                    (.at m (.-pos (cast DCTree literal)))
                                    (if (identical? (.getKind literal) DocTree$Kind/CODE)
                                        ^DCTree (.newCodeTree m newBody)
                                        ^DCTree (.newLiteralTree m newBody))))
                                (do (.unexpectedTree cx) (cast DCTree literal))))

                          (method ^:public visitStartElement ^DCTree [this ^StartElementTree node
                                                                      ^Context cx]
                            (if (and (identical? (.-state cx) State/BEFORE_CODE)
                                     (.equalsIgnoreCase (.toString (.getName node)) "code"))
                                (set! (.-state cx) State/AFTER_CODE)
                                (.unexpectedTree cx))
                            (cast DCTree node))

                          (method ^:protected defaultAction ^DCTree [this ^DocTree node ^Context cx]
                            (.unexpectedTree cx)
                            (cast DCTree node)))
                cx (Context.)
                normalized (ListBuffer.)]
            (for-each [^DCTree tree trees]
              (let [visited (cast DCTree (.visit visitor tree cx))]
                (when (some? visited) (.add normalized visited))
                (when (identical? (.-state cx) State/FAILED) (return trees))))
            (if (identical? (.-state cx) State/SUCCEEDED) normalized trees)))))

  (method ^:protected attrValueChar ^void [this ^{:tag (ListBuffer DCTree)} list]
    (switch ch \& (.entity this list) \{ (.inlineTag this list) (.nextChar this)))

  (method ^:protected addPendingText ^void [this ^{:tag (ListBuffer DCTree)} list ^int textEnd]
    (.addPendingText this list textEnd textKind))

  (method ^:protected addPendingText ^void [this ^{:tag (ListBuffer DCTree)} list ^int textEnd
                                            ^DocTree$Kind kind]
    (when-not (== textStart -1)
      (when (<= textStart textEnd)
        (switch kind
          TEXT
            (.add list
                  (.newTextTree (.at m textStart)
                                (.newString this textStart (unchecked-add-int textEnd 1))))
          MARKDOWN
            (.add list
                  (.newRawTextTree (.at m textStart)
                                   DocTree$Kind/MARKDOWN
                                   (.newString this textStart (unchecked-add-int textEnd 1))))
          (throw (IllegalArgumentException. (.toString kind)))))
      (set! textStart -1)))

  (method ^:protected erroneous ^DCTree$DCErroneous [this ^String code ^int pos]
    (.erroneous this code pos Position/NOPOS))

  (method ^:protected erroneous ^DCTree$DCErroneous [this ^String code ^int pos ^:mutable ^int pref]

                               (when (some? html) (return (.newSeeTree (.at m pos) html))))
                           \@ (when newline (throw (ParseException. "dc.no.content")))
                           LayoutCharacters/EOI
                             (when (== bp (unchecked-subtract-int (alength buf) 1))
                               (throw (ParseException. "dc.no.content")))
                           (when (or (.isJavaIdentifierStart DocCommentParser/this ch) (== ch \#))
                             (let [ref (.reference
                                         DocCommentParser/this
                                         ReferenceParser$Mode/MEMBER_OPTIONAL)
                                   ^{:tag (List DCTree)} description (.blockContent
                                                                       DocCommentParser/this)]
                               (return (.newSeeTree (.at m pos) (.prepend description ref))))))
                         (throw (ParseException. "dc.unexpected.content"))))
                     (anon TagParser [DocCommentParser$TagParser$Kind/BLOCK
                                      DocTree$Kind/SERIAL_DATA]
                       (method ^:public parse ^DCTree [this ^int pos]
                         (let [^{:tag (List DCTree)} description (.blockContent
                                                                   DocCommentParser/this)]
                           (.newSerialDataTree (.at m pos) description))))
                     (anon TagParser [DocCommentParser$TagParser$Kind/BLOCK
                                      DocTree$Kind/SERIAL_FIELD]
                       (method ^:public parse :throws [ParseException] ^DCTree [this ^int pos]
                         (.skipWhitespace DocCommentParser/this)
                         (let [name (.identifier DocCommentParser/this)]
                           (.skipWhitespace DocCommentParser/this)
                           (let [type (.reference
                                        DocCommentParser/this
                                        ReferenceParser$Mode/MEMBER_DISALLOWED)
                                 ^:mutable ^{:tag (List DCTree)} description nil]
                             (when (.isWhitespace DocCommentParser/this ch)
                               (.skipWhitespace DocCommentParser/this)
                               (set! description (.blockContent DocCommentParser/this)))
                             (.newSerialFieldTree (.at m pos) name type description)))))
                     (anon TagParser [DocCommentParser$TagParser$Kind/BLOCK DocTree$Kind/SERIAL]
                       (method ^:public parse ^DCTree [this ^int pos]
                         (let [^{:tag (List DCTree)} description (.blockContent
                                                                   DocCommentParser/this)]
                           (.newSerialTree (.at m pos) description))))
                     (anon TagParser [DocCommentParser$TagParser$Kind/BLOCK DocTree$Kind/SINCE]
                       (method ^:public parse ^DCTree [this ^int pos]
                         (let [^{:tag (List DCTree)} description (.blockContent
                                                                   DocCommentParser/this)]
                           (.newSinceTree (.at m pos) description))))
                     (anon TagParser [DocCommentParser$TagParser$Kind/INLINE DocTree$Kind/SNIPPET]
                       (method parse :throws [ParseException] ^DCTree [this ^int pos]
                         (.skipWhitespace DocCommentParser/this)
                         (let [^{:tag (List DCTree)} attributes (.tagAttrs this)]
                           (cond
                             (== ch \})
                               (do
                                 (.nextChar DocCommentParser/this)
                                 (.newSnippetTree (.at m pos) attributes nil))
                             (== ch \:)
                               (do
                                 (set! newline false)
                                 (.nextChar DocCommentParser/this)
                                 (while (and (< bp buflen)
                                             (.isHorizontalWhitespace DocCommentParser/this ch))
                                   (.nextChar DocCommentParser/this))
                                 (when-not newline
                                   (when (>= bp (unchecked-subtract-int (alength buf) 1))
                                     (throw (ParseException. "dc.no.content")))
                                   (throw (ParseException. "dc.unexpected.content")))
                                 (.nextChar DocCommentParser/this)
                                 (let [text (.inlineText
                                              DocCommentParser/this
                                              WhitespaceRetentionPolicy/RETAIN_ALL)]
                                   (.nextChar DocCommentParser/this)
                                   (.newSnippetTree (.at m pos) attributes text)))
                             (>= bp (unchecked-subtract-int (alength buf) 1))
                               (throw (ParseException. "dc.no.content"))
                             :else (throw (ParseException. "dc.unexpected.content")))))

                       (method ^:private tagAttrs ^{:tag (List DCTree)} [this]
                         (let [^{:tag (ListBuffer DCTree)} attrs (ListBuffer.)]
                           (.skipWhitespace DocCommentParser/this)
                           (while (and (< bp buflen) (.isIdentifierStart DocCommentParser/this ch))
                             (let [namePos bp
                                   name (.readAttributeName DocCommentParser/this)]
                               (.skipWhitespace DocCommentParser/this)
                               (let [^:mutable ^{:tag (List DCTree)} value nil
                                     ^:mutable vkind AttributeTree$ValueKind/EMPTY]
                                 (when (== ch \=)
                                   (let [^{:tag (ListBuffer DCTree)} v (ListBuffer.)]
                                     (.nextChar DocCommentParser/this)
                                     (.skipWhitespace DocCommentParser/this)
                                     (if (or (== ch \') (== ch \"))
                                         (do
                                           (set! newline false)
                                           (set!
                                             vkind
                                             (if (== ch \')
                                                 AttributeTree$ValueKind/SINGLE
                                                 AttributeTree$ValueKind/DOUBLE))
                                           (let [quote ch]
                                             (.nextChar DocCommentParser/this)
                                             (set! textStart bp)
                                             (while (and (< bp buflen) (not (== ch quote)))
                                               (.nextChar DocCommentParser/this))
                                             (.addPendingText
                                               DocCommentParser/this
                                               v
                                               (unchecked-subtract-int bp 1)
                                               DocTree$Kind/TEXT)
                                             (.nextChar DocCommentParser/this)))
                                         (do
                                           (set! vkind AttributeTree$ValueKind/UNQUOTED)
                                           (set! textStart bp)
                                           (while (and
                                                    (< bp buflen)
                                                    (and
                                                      (and (not (== ch \})) (not (== ch \:)))
                                                      (not
                                                        (.isUnquotedAttrValueTerminator
                                                          DocCommentParser/this
                                                          ch))))
                                             (.nextChar DocCommentParser/this))
                                           (.addPendingText
                                             DocCommentParser/this
                                             v
                                             (unchecked-subtract-int bp 1)
                                             DocTree$Kind/TEXT)))
                                     (.skipWhitespace DocCommentParser/this)
                                     (set! value (.toList v))))
                                 (let [attr (.newAttributeTree (.at m namePos) name vkind value)]
                                   (.add attrs attr)))))
                           (.toList attrs))))
                     (anon TagParser [DocCommentParser$TagParser$Kind/BLOCK DocTree$Kind/SPEC]
                       (method ^:public parse :throws [ParseException] ^DCTree [this ^int pos]
                         (.skipWhitespace DocCommentParser/this)
                         (let [url (.inlineWord DocCommentParser/this)]
                           (when (or (nil? url) (.isBlank url))
                             (throw (ParseException. "dc.no.url")))
                           (.skipWhitespace DocCommentParser/this)
                           (let [^{:tag (List DCTree)} title (.blockContent DocCommentParser/this)]
                             (when (or (.isEmpty title) (DCTree/isBlank title))
                               (throw (ParseException. "dc.no.title")))
                             (.newSpecTree (.at m pos) url title)))))
                     (anon TagParser [DocCommentParser$TagParser$Kind/INLINE DocTree$Kind/SUMMARY]
                       (method ^:public parse ^DCTree [this ^int pos]
                         (let [^{:tag (List DCTree)} summary (.inlineContent DocCommentParser/this)]
                           (.newSummaryTree (.at m pos) summary))))
                     (anon TagParser [DocCommentParser$TagParser$Kind/INLINE
                                      DocTree$Kind/SYSTEM_PROPERTY]
                       (method ^:public parse :throws [ParseException] ^DCTree [this ^int pos]
                         (.skipWhitespace DocCommentParser/this)
                         (when (== ch \}) (throw (ParseException. "dc.no.content")))
                         (let [propertyName (.readSystemPropertyName DocCommentParser/this)]
                           (when (nil? propertyName) (throw (ParseException. "dc.no.content")))
                           (.skipWhitespace DocCommentParser/this)
                           (if (not (== ch \}))
                               (do
                                 (.nextChar DocCommentParser/this)
                                 (throw (ParseException. "dc.unexpected.content")))
                               (do
                                 (.nextChar DocCommentParser/this)
                                 (.newSystemPropertyTree (.at m pos) propertyName))))))
                     (anon TagParser [DocCommentParser$TagParser$Kind/BLOCK DocTree$Kind/THROWS]
                       (method ^:public parse :throws [ParseException] ^DCTree [this ^int pos]
                         (.skipWhitespace DocCommentParser/this)
                         (let [ref (.reference DocCommentParser/this
                                               ReferenceParser$Mode/MEMBER_DISALLOWED)
                               ^{:tag (List DCTree)} description (.blockContent
                                                                   DocCommentParser/this)]
                           (.newThrowsTree (.at m pos) ref description))))
                     (anon TagParser [DocCommentParser$TagParser$Kind/BLOCK DocTree$Kind/USES]
                       (method ^:public parse :throws [ParseException] ^DCTree [this ^int pos]
                         (.skipWhitespace DocCommentParser/this)
                         (let [ref (.reference DocCommentParser/this
                                               ReferenceParser$Mode/MEMBER_DISALLOWED)
                               ^{:tag (List DCTree)} description (.blockContent
                                                                   DocCommentParser/this)]
                           (.newUsesTree (.at m pos) ref description))))
                     (anon TagParser [DocCommentParser$TagParser$Kind/INLINE DocTree$Kind/VALUE]
                       (method ^:public parse :throws [ParseException] ^DCTree [this ^int pos]
                         (.skipWhitespace DocCommentParser/this)
                         (let [^:mutable ^DCTree$DCText format nil]
                           (switch ch
                             \%
                               (do
                                 (set! format (.inlineWord DocCommentParser/this))
                                 (.skipWhitespace DocCommentParser/this))
                             \"
                               (do
                                 (set! format (.quotedString DocCommentParser/this))
                                 (.skipWhitespace DocCommentParser/this))
                             (set! format nil))
                           (let [ref (.reference
                                       DocCommentParser/this
                                       ReferenceParser$Mode/MEMBER_REQUIRED)]
                             (.skipWhitespace DocCommentParser/this)
                             (if (== ch \})
                                 (do
                                   (.nextChar DocCommentParser/this)
                                   (if (nil? format)
                                       ^DCTree (.newValueTree (.at m pos) ref)
                                       ^DCTree (.newValueTree (.at m pos) format ref)))
                                 (do
                                   (.nextChar DocCommentParser/this)
                                   (throw (ParseException. "dc.unexpected.content"))))))))
                     (anon TagParser [DocCommentParser$TagParser$Kind/BLOCK DocTree$Kind/VERSION]
                       (method ^:public parse ^DCTree [this ^int pos]
                         (let [^{:tag (List DCTree)} description (.blockContent
                                                                   DocCommentParser/this)]
                           (.newVersionTree (.at m pos) description))))])
          ^{:tag (Map Name TagParser)} tagParsers (HashMap.)]
      (for-each [^TagParser p parsers]
        (.put tagParsers (.fromString names (.-tagName (.getTreeKind p))) p))
      tagParsers)))

  (method ^:protected ident ^Name [this ^boolean allowClass ^boolean asVariable]
    (if (identical? (.-kind token) Tokens$TokenKind/IDENTIFIER)
        (let [name (.name token)] (.nextToken this) name)
        (arbace.core/cond
          (identical? (.-kind token) Tokens$TokenKind/ASSERT)
          (do
            (.error log
                    JCDiagnostic$DiagnosticFlag/SYNTAX
                    (.-pos token)
                    CompilerProperties$Errors/AssertAsIdentifier)
            (.nextToken this)
            (.-error names))
          (identical? (.-kind token) Tokens$TokenKind/ENUM)
          (do
            (.error log
                    JCDiagnostic$DiagnosticFlag/SYNTAX
                    (.-pos token)
                    CompilerProperties$Errors/EnumAsIdentifier)
            (.nextToken this)
            (.-error names))
          :else
          (arbace.core/cond
            (identical? (.-kind token) Tokens$TokenKind/THIS)
            (if allowThisIdent
                (let [name (.name token)] (.nextToken this) name)
                (do
                  (.error log
                          JCDiagnostic$DiagnosticFlag/SYNTAX
                          (.-pos token)
                          CompilerProperties$Errors/ThisAsIdentifier)
                  (.nextToken this)
                  (.-error names)))
            (identical? (.-kind token) Tokens$TokenKind/UNDERSCORE)
            (do
              (if (.allowedInSource Source$Feature/UNDERSCORE_IDENTIFIER source)
                  (.warning log (.-pos token) CompilerProperties$Warnings/UnderscoreAsIdentifier)
                  (arbace.core/cond
                    asVariable
                    (do
                      (.checkSourceLevel this Source$Feature/UNNAMED_VARIABLES)
                      (when (.peekToken this Tokens$TokenKind/LBRACKET)
                        (.error log
                                JCDiagnostic$DiagnosticFlag/SYNTAX
                                (.-pos token)
                                CompilerProperties$Errors/UseOfUnderscoreNotAllowedWithBrackets)))
                    (.allowedInSource Source$Feature/UNNAMED_VARIABLES source)
                    (.error log
                            JCDiagnostic$DiagnosticFlag/SYNTAX
                            (.-pos token)
                            CompilerProperties$Errors/UseOfUnderscoreNotAllowedNonVariable)
                    :else
                    (.error log
                            JCDiagnostic$DiagnosticFlag/SYNTAX
                            (.-pos token)
                            CompilerProperties$Errors/UnderscoreAsIdentifier)))
              (let [name (.name token)] (.nextToken this) name))
            :else
            (do
              (.accept this Tokens$TokenKind/IDENTIFIER)
              (if (and allowClass (identical? (.-kind token) Tokens$TokenKind/CLASS))
                  (do (.nextToken this) (.-_class names))
                  (.-error names)))))))

  (method ^:public qualident ^JCTree$JCExpression [this ^boolean allowAnnos]
    (let [^:mutable t (cast JCTree$JCExpression
                            (.toP this (.Ident (.at F (.-pos token)) (.ident this))))]
      (while (identical? (.-kind token) Tokens$TokenKind/DOT)
        (let [pos (.-pos token)]
          (.nextToken this)
          (let [^:mutable ^{:tag (List JCTree$JCAnnotation)} tyannos nil]
            (when allowAnnos (set! tyannos (.typeAnnotationsOpt this)))
            (set! t (cast JCTree$JCExpression (.toP this (.Select (.at F pos) t (.ident this)))))
            (when (and (some? tyannos) (.nonEmpty tyannos))
              (set! t
                    (cast JCTree$JCExpression
                          (.toP this
                                (.AnnotatedType
                                  (.at F (.-pos (cast JCTree$JCAnnotation (.-head tyannos))))
                                  tyannos
                                  t))))))))
      t))


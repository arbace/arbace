                PROTECTED
                STATIC
                TRANSIENT
                NATIVE
                VOLATILE
                SYNCHRONIZED
                STRICTFP
                LT
                BYTE
                SHORT
                CHAR
                INT
                LONG
                FLOAT
                DOUBLE
                BOOLEAN
                VOID)
          (when stopAtMemberDecl (return))
        (UNDERSCORE IDENTIFIER) (when stopAtIdentifier (return))
        (CASE DEFAULT
              IF
              FOR
              WHILE
              DO
              TRY
              SWITCH
              RETURN
              THROW
              BREAK
              CONTINUE
              ELSE
              FINALLY
              CATCH
              THIS
              SUPER
              NEW)

  (method ^:private saveDanglingDocComments ^void [this ^Tokens$Comment dc]
    (let [recentComments (.getDocComments S)]
      (switch (.size recentComments)
        0 (return)
        1 (when (identical? (.peek recentComments) dc) (.remove recentComments) (return)))
      (let [lb (ListBuffer.)]
        (while (not (.isEmpty recentComments))
          (let [c (cast Tokens$Comment (.remove recentComments))]
            (when-not (identical? c dc) (.add lb c))))
        (.put danglingComments dc (.toList lb)))))


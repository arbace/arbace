  (method literal ^JCTree$JCExpression [this ^Name prefix ^int pos]
    (let [^:mutable ^JCTree$JCExpression t errorTree]
      (switch (.-kind token)
        INTLITERAL
          (try
            (set! t
                  (.Literal (.at F pos)
                            TypeTag/INT
                            (Convert/string2int (.strval this prefix) (.radix token))))
            (catch NumberFormatException ex (.reportIntegralLiteralError this prefix pos)))
        LONGLITERAL
          (try
            (set! t
                  (.Literal (.at F pos)
                            TypeTag/LONG
                            (Long/valueOf
                              (Convert/string2long (.strval this prefix) (.radix token)))))
            (catch NumberFormatException ex (.reportIntegralLiteralError this prefix pos)))
        FLOATLITERAL
          (let [^String proper (if (== (.radix token) 16)
                                   (java-str "0x" (.stringVal token))
                                   (.stringVal token))
                ^:mutable ^Float n nil]
            (try
              (set! n (Float/valueOf proper))
              (catch NumberFormatException ex (set! n Float/NaN)))
            (arbace.core/cond (and (== (.floatValue n) (float 0.0)) (not (.isZero this proper)))
                              (.error log
                                      JCDiagnostic$DiagnosticFlag/SYNTAX
                                      (.-pos token)
                                      CompilerProperties$Errors/FpNumberTooSmall)
                              (== (.floatValue n) Float/POSITIVE_INFINITY)
                              (.error log
                                      JCDiagnostic$DiagnosticFlag/SYNTAX
                                      (.-pos token)
                                      CompilerProperties$Errors/FpNumberTooLarge)
                              :else
                              (set! t (.Literal (.at F pos) TypeTag/FLOAT n))))
        DOUBLELITERAL
          (let [^String proper (if (== (.radix token) 16)
                                   (java-str "0x" (.stringVal token))
                                   (.stringVal token))
                ^:mutable ^Double n nil]
            (try
              (set! n (Double/valueOf proper))
              (catch NumberFormatException ex (set! n Double/NaN)))
            (arbace.core/cond (and (== (.doubleValue n) 0.0) (not (.isZero this proper)))
                              (.error log
                                      JCDiagnostic$DiagnosticFlag/SYNTAX
                                      (.-pos token)
                                      CompilerProperties$Errors/FpNumberTooSmall)
                              (== (.doubleValue n) Double/POSITIVE_INFINITY)
                              (.error log
                                      JCDiagnostic$DiagnosticFlag/SYNTAX
                                      (.-pos token)
                                      CompilerProperties$Errors/FpNumberTooLarge)
                              :else
                              (set! t (.Literal (.at F pos) TypeTag/DOUBLE n))))
        CHARLITERAL
          (set! t
                (.Literal (.at F pos)
                          TypeTag/CHAR
                          (unchecked-add-int (.charAt (.stringVal token) 0) 0)))
        STRINGLITERAL (set! t (.Literal (.at F pos) TypeTag/CLASS (.stringVal token)))
        (TRUE FALSE)
          (set! t
                (.Literal (.at F pos)
                          TypeTag/BOOLEAN
                          (Integer/valueOf
                            (if (identical? (.-kind token) Tokens$TokenKind/TRUE) 1 0))))
        NULL (set! t (.Literal (.at F pos) TypeTag/BOT nil))
        (Assert/error))
      (when (identical? t errorTree) (set! t (.Erroneous (.at F pos))))
      (.storeEnd this t (.-endPos token))
      (.nextToken this)
      t))

  (method isZero ^boolean [this ^String s]
    (let [cs (.toCharArray s)
          ^int base (if (and (> (alength cs) 1) (== (Character/toLowerCase (aget cs 1)) \x)) 16 10)
          ^:mutable ^int i (if (== base 16) 2 0)]
      (while (and (< i (alength cs)) (or (== (aget cs i) \0) (== (aget cs i) \.)))
        (set! i (unchecked-inc-int i)))
      (not (and (< i (alength cs)) (> (Character/digit (aget cs i) base) 0)))))

  (method strval ^String [this ^Name prefix]
    (let [s (.stringVal token)] (if (.isEmpty prefix) s (java-str prefix s))))

  (method reportIntegralLiteralError ^void [this ^Name prefix ^int pos]
    (let [radix (.radix token)]
      (when (or (== radix 2) (== radix 8))
        (let [value (.strval this prefix)
              cs (.toCharArray value)]
          (loop [^int i 0]
            (when (< i (alength cs))
              (let [c (aget cs i)
                    d (Character/digit c radix)]
                (if (== d -1)
                    (let [^JCDiagnostic$Error err (if (== radix 2)
                                                      CompilerProperties$Errors/IllegalDigitInBinaryLiteral
                                                      CompilerProperties$Errors/IllegalDigitInOctalLiteral)]
                      (.error log
                              JCDiagnostic$DiagnosticFlag/SYNTAX
                              (unchecked-add-int (.-pos token) i)
                              err)
                      (return))
                    (recur (unchecked-inc-int i))))))))
      (.error log
              JCDiagnostic$DiagnosticFlag/SYNTAX
              (.-pos token)
              (CompilerProperties$Errors/IntNumberTooLarge (.strval this prefix)))))

  (method ^:public parseExpression ^JCTree$JCExpression [this]
    (.term this EXPR))

  (method ^:public parsePattern ^JCTree$JCPattern [this ^int pos ^:mutable ^JCTree$JCModifiers mods
                                                   ^JCTree$JCExpression parsedType ^boolean allowVar
                                                   ^boolean checkGuard]
    (let [^:mutable ^JCTree$JCPattern pattern nil]
      (set! mods (if (some? mods) mods (.optFinal this 0)))
      (let [^:mutable ^JCTree$JCExpression e nil]
        (if (and (identical? (.-kind token) Tokens$TokenKind/UNDERSCORE) (nil? parsedType))
            (do
              (.nextToken this)
              (.checkSourceLevel this Source$Feature/UNNAMED_VARIABLES)
              (set! pattern (cast JCTree$JCPattern (.toP this (.AnyPattern (.at F (.-pos token)))))))
            (let [^:mutable varTypePos Position/NOPOS]
              (if (nil? parsedType)
                  (let [var (and (identical? (.-kind token) Tokens$TokenKind/IDENTIFIER)
                                 (identical? (.name token) (.-var names)))]
                    (set! e (.unannotatedType this allowVar (bit-or-int TYPE NOLAMBDA)))
                    (when var (set! varTypePos (.-pos e)) (set! e nil)))
                  (set! e parsedType))
              (if (identical? (.-kind token) Tokens$TokenKind/LPAREN)
                  (do
                    (.checkSourceLevel this Source$Feature/RECORD_PATTERNS)
                    (let [^{:tag (ListBuffer JCTree$JCPattern)} nested (ListBuffer.)]
                      (if (not (.peekToken this Tokens$TokenKind/RPAREN))
                          (loop []
                            (.nextToken this)
                            (let [nestedPattern (.parsePattern
                                                  this
                                                  (.-pos token)
                                                  nil
                                                  nil
                                                  true
                                                  false)]
                              (.append nested nestedPattern))
                            (when (identical? (.-kind token) Tokens$TokenKind/COMMA) (recur)))
                          (.nextToken this))
                      (.accept this Tokens$TokenKind/RPAREN)
                      (set! pattern
                            (cast JCTree$JCPattern
                                  (.toP this (.RecordPattern (.at F pos) e (.toList nested)))))
                      (when (.nonEmpty (.-annotations mods))
                        (.error log
                                (.pos (cast JCTree$JCAnnotation (.-head (.-annotations mods))))
                                CompilerProperties$Errors/RecordPatternsAnnotationsNotAllowed))
                      (.checkNoMods this pos (bit-and (.-flags mods) Flags/FINAL))
                      (.scan
                        (anon TreeScanner []
                          (method ^:public visitAnnotatedType ^void [this
                                                                     ^JCTree$JCAnnotatedType tree]
                            (.error log
                                    (.pos tree)
                                    CompilerProperties$Errors/RecordPatternsAnnotationsNotAllowed)))
                        e)))
                  (let [varPos (.-pos token)
                        ^:mutable name (.identOrUnderscore this)]
                    (when (and (.allowedInSource Source$Feature/UNNAMED_VARIABLES source)
                               (identical? name (.-underscore names)))
                      (set! name (.-empty names)))
                    (let [var (cast
                                JCTree$JCVariableDecl
                                (.toP
                                  this
                                  (.VarDef
                                    (.at F varPos)
                                    mods
                                    name
                                    e
                                    nil
                                    ^JCTree$JCVariableDecl$DeclKind (if (not
                                                                          (==
                                                                            varTypePos
                                                                            Position/NOPOS))
                                                                        JCTree$JCVariableDecl$DeclKind/VAR
                                                                        JCTree$JCVariableDecl$DeclKind/EXPLICIT)
                                    varTypePos)))]
                      (when (nil? e)
                        (when (and (identical? (.-name var) (.-underscore names)) (not allowVar))
                          (.error log
                                  JCDiagnostic$DiagnosticFlag/SYNTAX
                                  varPos
                                  CompilerProperties$Errors/UseOfUnderscoreNotAllowed)))
                      (set! pattern
                            (cast JCTree$JCPattern (.toP this (.BindingPattern (.at F pos) var)))))))))
        pattern)))

  (method ^:public parseType ^JCTree$JCExpression [this]
    (.parseType this false))

  (method ^:public parseType ^JCTree$JCExpression [this ^boolean allowVar]
    (let [^{:tag (List JCTree$JCAnnotation)} annotations (.typeAnnotationsOpt this)]
      (.parseType this allowVar annotations)))

  (method ^:public parseType ^JCTree$JCExpression [this ^boolean allowVar
                                                   ^{:tag (List JCTree$JCAnnotation)} annotations]
    (let [^:mutable result (.unannotatedType this allowVar)]
      (when (.nonEmpty annotations)
        (set! result (.insertAnnotationsToMostInner this result annotations false)))
      result))

  (method ^:protected parseIntersectionType ^JCTree$JCExpression [this ^int pos
                                                                  ^JCTree$JCExpression firstType]
    (let [^:mutable t firstType
          pos1 pos
          ^:mutable ^{:tag (List JCTree$JCExpression)} targets (List/of t)]
      (while (identical? (.-kind token) Tokens$TokenKind/AMP)
        (.accept this Tokens$TokenKind/AMP)
        (set! targets (.prepend targets (.parseType this))))
      (when (> (.length targets) 1)
        (set! t
              (cast JCTree$JCExpression
                    (.toP this (.TypeIntersection (.at F pos1) (.reverse targets))))))
      t))

  (method ^:public unannotatedType ^JCTree$JCExpression [this ^boolean allowVar]
    (.unannotatedType this allowVar TYPE))

  (method ^:public unannotatedType ^JCTree$JCExpression [this ^boolean allowVar ^int newmode]
    (let [^:mutable result (.term this newmode)
          restrictedTypeName (.restrictedTypeName this result (not allowVar))]
      (when (and (some? restrictedTypeName)
                 (or (not allowVar) (not (identical? restrictedTypeName (.-var names)))))
        (.syntaxError this
                      (.-pos result)
                      (CompilerProperties$Errors/RestrictedTypeNotAllowedHere restrictedTypeName)))
      (when (== (bit-and-int lastmode TYPE) 0) (set! result (.Erroneous F (List/of result))))
      result))

  (method ^:protected term ^JCTree$JCExpression [this ^int newmode]
    (let [prevmode mode]
      (.setMode this newmode)
      (let [t (.term this)] (.setLastMode this mode) (.setMode this prevmode) t)))

  (method term ^JCTree$JCExpression [this]
    (let [t (.term1 this)]
      (if (and (.isMode this EXPR)
               (or (identical? (.-kind token) Tokens$TokenKind/EQ)
                   (and (<= (.compareTo Tokens$TokenKind/PLUSEQ (.-kind token)) 0)
                        (<= (.compareTo (.-kind token) Tokens$TokenKind/GTGTGTEQ) 0))))
          (.termRest this t)
          t)))

  (method termRest ^JCTree$JCExpression [this ^JCTree$JCExpression t]
    (switch (.-kind token)
      EQ
        (let [pos (.-pos token)]
          (.nextToken this)
          (.selectExprMode this)
          (let [t1 (.term this)] (cast JCTree$JCExpression (.toP this (.Assign (.at F pos) t t1)))))
      (PLUSEQ SUBEQ STAREQ SLASHEQ PERCENTEQ AMPEQ BAREQ CARETEQ LTLTEQ GTGTEQ GTGTGTEQ)
        (let [pos (.-pos token)
              tk (.-kind token)]
          (.nextToken this)
          (.selectExprMode this)
          (let [t1 (.term this)] (.Assignop (.at F pos) (JavacParser/optag tk) t t1)))
      t))

  (method term1 ^JCTree$JCExpression [this]
    (let [t (.term2 this)]
      (if (and (.isMode this EXPR) (identical? (.-kind token) Tokens$TokenKind/QUES))
          (do (.selectExprMode this) (.term1Rest this t))
          t)))

  (method term1Rest ^JCTree$JCExpression [this ^JCTree$JCExpression t]
    (if (identical? (.-kind token) Tokens$TokenKind/QUES)
        (let [pos (.-pos token)]
          (.nextToken this)
          (let [t1 (.term this)]
            (.accept this Tokens$TokenKind/COLON)
            (let [t2 (.term1 this)] (.Conditional (.at F pos) t t1 t2))))
        t))

  (method term2 ^JCTree$JCExpression [this]
    (let [t (.term3 this)]
      (if (and (.isMode this EXPR) (>= (JavacParser/prec (.-kind token)) TreeInfo/orPrec))
          (do (.selectExprMode this) (.term2Rest this t TreeInfo/orPrec))
          t)))

  (method term2Rest ^JCTree$JCExpression [this ^:mutable ^JCTree$JCExpression t ^int minprec]
    (let [odStack (.newOdStack this)
          opStack (.newOpStack this)
          ^:mutable ^int top 0]
      (aset odStack 0 t)
      (let [startPos (.-pos token)
            ^:mutable topOp Tokens/DUMMY]
        (while (>= (JavacParser/prec (.-kind token)) minprec)
          (aset opStack top topOp)
          (if (identical? (.-kind token) Tokens$TokenKind/INSTANCEOF)
              (let [pos (.-pos token)]
                (.nextToken this)
                (let [^:mutable ^JCTree pattern nil]
                  (if (identical? (.-kind token) Tokens$TokenKind/LPAREN)
                      (do
                        (.checkSourceLevel this (.-pos token) Source$Feature/PATTERN_SWITCH)
                        (set! pattern (.parsePattern this (.-pos token) nil nil false false)))
                      (let [patternPos (.-pos token)
                            mods (.optFinal this 0)
                            typePos (.-pos token)
                            ^:mutable type (.unannotatedType this false)]
                        (if (identical? (.-kind token) Tokens$TokenKind/IDENTIFIER)
                            (do
                              (.checkSourceLevel
                                this
                                (.-pos token)
                                Source$Feature/PATTERN_MATCHING_IN_INSTANCEOF)
                              (set! pattern (.parsePattern this patternPos mods type false false)))
                            (arbace.core/cond
                              (identical? (.-kind token) Tokens$TokenKind/LPAREN)
                              (set! pattern (.parsePattern this patternPos mods type false false))
                              (identical? (.-kind token) Tokens$TokenKind/UNDERSCORE)
                              (do
                                (.checkSourceLevel
                                  this
                                  (.-pos token)
                                  Source$Feature/UNNAMED_VARIABLES)
                                (set! pattern (.parsePattern this patternPos mods type false false)))
                              :else
                              (do
                                (.checkNoMods this
                                              typePos
                                              (bit-and
                                                (.-flags mods)
                                                (bit-not-int Flags/DEPRECATED)))
                                (when (.nonEmpty (.-annotations mods))
                                  (let [^{:tag (List JCTree$JCAnnotation)} typeAnnos (.map
                                                                                       (.-annotations
                                                                                         mods)
                                                                                       (lambda Function ^JCTree$JCAnnotation [^JCTree$JCAnnotation decl]
                                                                                         (let [typeAnno
                                                                                                 (.TypeAnnotation
                                                                                                   (.at
                                                                                                     F
                                                                                                     (.-pos
                                                                                                       decl))
                                                                                                   (.-annotationType
                                                                                                     decl)
                                                                                                   (.-args
                                                                                                     decl))]
                                                                                           (.replaceTree
                                                                                             endPosTable
                                                                                             decl
                                                                                             typeAnno)
                                                                                           typeAnno)))]
                                    (set! type
                                          (.insertAnnotationsToMostInner this type typeAnnos false))))
                                (set! pattern type))))))
                  (aset odStack top (.TypeTest (.at F pos) (aget odStack top) pattern))))
              (do
                (set! topOp token)
                (.nextToken this)
                (set! top (unchecked-inc-int top))
                (aset odStack top (.term3 this))))
          (while (and (> top 0)
                      (>= (JavacParser/prec (.-kind topOp)) (JavacParser/prec (.-kind token))))
            (aset odStack
                  (unchecked-subtract-int top 1)
                  (.Binary (.at F (.-pos topOp))
                           (JavacParser/optag (.-kind topOp))
                           (aget odStack (unchecked-subtract-int top 1))
                           (aget odStack top)))
            (set! top (unchecked-dec-int top))
            (set! topOp (aget opStack top))))
        (Assert/check (== top 0))
        (set! t (aget odStack 0))
        (when (.hasTag t JCTree$Tag/PLUS) (set! t (.foldStrings this t)))
        (.add odStackSupply odStack)
        (.add opStackSupply opStack)
        t)))

  (method ^:protected foldStrings ^JCTree$JCExpression [this ^JCTree$JCExpression tree]
    (if (not allowStringFolding)
        tree
        (let [^{:tag (ListBuffer JCTree$JCExpression)} opStack (ListBuffer.)
              ^{:tag (ListBuffer JCTree$JCLiteral)} litBuf (ListBuffer.)
              ^:mutable needsFolding false
              ^:mutable curr tree]
          (while true
            (if (.hasTag curr JCTree$Tag/PLUS)
                (let [op (cast JCTree$JCBinary curr)]
                  (set! needsFolding
                        (let [a-2 needsFolding
                              b-3 (.foldIfNeeded this (.-rhs op) litBuf opStack false)]
                          (or a-2 b-3)))
                  (set! curr (.-lhs op)))
                (do
                  (set! needsFolding
                        (let [a-4 needsFolding
                              b-5 (.foldIfNeeded this curr litBuf opStack true)]
                          (or a-4 b-5)))
                  (break))))
          (if needsFolding
              (let [^{:tag (List JCTree$JCExpression)} ops (.toList opStack)
                    ^:mutable res (cast JCTree$JCExpression (.-head ops))]
                (for-each [^JCTree$JCExpression op (.-tail ops)]
                  (set! res
                        (.Binary (.at F (.getStartPosition op))
                                 (JavacParser/optag Tokens$TokenKind/PLUS)
                                 res
                                 op))
                  (.storeEnd this res (.getEndPos this op)))
                res)
              tree))))

  (method ^:private foldIfNeeded ^boolean [this ^JCTree$JCExpression tree
                                           ^{:tag (ListBuffer JCTree$JCLiteral)} litBuf
                                           ^{:tag (ListBuffer JCTree$JCExpression)} opStack
                                           ^boolean last]
    (let [str (.stringLiteral this tree)]
      (if (some? str)
          (do (.prepend litBuf str) (and last (.merge this litBuf opStack)))
          (let [res (.merge this litBuf opStack)] (.clear litBuf) (.prepend opStack tree) res))))

  (method merge ^boolean [this ^{:tag (ListBuffer JCTree$JCLiteral)} litBuf
                          ^{:tag (ListBuffer JCTree$JCExpression)} opStack]
    (arbace.core/cond
      (.isEmpty litBuf)
      false
      (== (.size litBuf) 1)
      (do (.prepend opStack (cast JCTree$JCExpression (.first litBuf))) false)
      :else
      (let [^JCTree$JCExpression t (.Literal (.at
                                               F
                                               (.getStartPosition
                                                 (cast JCTree$JCLiteral (.first litBuf))))
                                             TypeTag/CLASS
                                             (.collect
                                               (.map
                                                 (.stream litBuf)
                                                 (lambda Function ^String [^JCTree$JCLiteral lit]
                                                   (cast String (.getValue lit))))
                                               (Collectors/joining)))]
        (.storeEnd this t (.getEndPosition (cast JCTree$JCLiteral (.last litBuf)) endPosTable))
        (.prepend opStack t)
        true)))

  (method ^:private stringLiteral ^JCTree$JCLiteral [this ^JCTree tree]
    (when (.hasTag tree JCTree$Tag/LITERAL)
      (let [lit (cast JCTree$JCLiteral tree)]
        (when (identical? (.-typetag lit) TypeTag/CLASS) (return lit))))
    nil)

  (field ^{:tag (ArrayList JCTree$JCExpression/1)} odStackSupply (ArrayList.))

  (field ^{:tag (ArrayList Tokens$Token/1)} opStackSupply (ArrayList.))

  (method ^:private newOdStack ^JCTree$JCExpression/1 [this]
    (if (.isEmpty odStackSupply)
        (new JCTree$JCExpression/1 (unchecked-add-int infixPrecedenceLevels 1))
        (cast JCTree$JCExpression/1
              (.remove odStackSupply (unchecked-subtract-int (.size odStackSupply) 1)))))

  (method ^:private newOpStack ^Tokens$Token/1 [this]
    (if (.isEmpty opStackSupply)
        (new Tokens$Token/1 (unchecked-add-int infixPrecedenceLevels 1))
        (cast Tokens$Token/1
              (.remove opStackSupply (unchecked-subtract-int (.size opStackSupply) 1)))))

  (method ^:protected term3 ^JCTree$JCExpression [this]
    (let [^:mutable pos (.-pos token)
          ^:mutable ^JCTree$JCExpression t nil
          startMode mode
          ^:mutable ^{:tag (List JCTree$JCExpression)} typeArgs (.typeArgumentsOpt this EXPR)]
      (switch (.-kind token)
        QUES
          (if (and (and (.isMode this TYPE) (.isMode this TYPEARG)) (not (.isMode this NOPARAMS)))
              (do (.selectTypeMode this) (return (.typeArgument this)))
              (return (.illegal this)))
        (PLUSPLUS SUBSUB BANG TILDE PLUS SUB)
          (if (and (nil? typeArgs) (.isMode this EXPR))
              (let [tk (.-kind token)]
                (.nextToken this)
                (.selectExprMode this)
                (if (and (and (identical? tk Tokens$TokenKind/SUB)
                              (or (identical? (.-kind token) Tokens$TokenKind/INTLITERAL)
                                  (identical? (.-kind token) Tokens$TokenKind/LONGLITERAL)))
                         (== (.radix token) 10))
                    (do (.selectExprMode this) (set! t (.literal this (.-hyphen names) pos)))
                    (do
                      (set! t (.term3 this))
                      (return (.Unary (.at F pos) (JavacParser/unoptag tk) t)))))
              (return (.illegal this)))
        LPAREN
          (if (and (nil? typeArgs) (.isMode this EXPR))
              (let [pres (.analyzeParens this)]
                (switch pres
                  CAST
                    (do
                      (.accept this Tokens$TokenKind/LPAREN)
                      (.selectTypeMode this)
                      (set! t (.parseIntersectionType this pos (.parseType this)))
                      (.accept this Tokens$TokenKind/RPAREN)
                      (.selectExprMode this)
                      (let [t1 (.term3 this)] (return (.TypeCast (.at F pos) t t1))))
                  (IMPLICIT_LAMBDA EXPLICIT_LAMBDA)
                    (set! t
                          (.lambdaExpressionOrStatement
                            this
                            true
                            (identical? pres ParensResult/EXPLICIT_LAMBDA)
                            pos))
                  (do
                    (.accept this Tokens$TokenKind/LPAREN)
                    (.selectExprMode this)
                    (set! t
                          (.termRest this
                                     (.term1Rest
                                       this
                                       (.term2Rest this (.term3 this) TreeInfo/orPrec))))
                    (.accept this Tokens$TokenKind/RPAREN)
                    (set! t (cast JCTree$JCExpression (.toP this (.Parens (.at F pos) t)))))))
              (return (.illegal this)))
        THIS
          (if (.isMode this EXPR)
              (do
                (.selectExprMode this)
                (set! t (cast JCTree$JCExpression (.to this (.Ident (.at F pos) (.-_this names)))))
                (.nextToken this)
                (if (nil? typeArgs)
                    (set! t (.argumentsOpt this nil t))
                    (set! t (.arguments this typeArgs t)))
                (set! typeArgs nil))
              (return (.illegal this)))
        SUPER
          (if (.isMode this EXPR)
              (do
                (.selectExprMode this)
                (set! t (cast JCTree$JCExpression (.to this (.Ident (.at F pos) (.-_super names)))))
                (set! t (.superSuffix this typeArgs t))
                (set! typeArgs nil))
              (return (.illegal this)))
        (INTLITERAL LONGLITERAL
                    FLOATLITERAL
                    DOUBLELITERAL
                    CHARLITERAL
                    STRINGLITERAL
                    TRUE
                    FALSE
                    NULL)
          (if (and (nil? typeArgs) (.isMode this EXPR))
              (do (.selectExprMode this) (set! t (.literal this (.-empty names))))
              (return (.illegal this)))
        NEW
          (do
            (when (some? typeArgs) (return (.illegal this)))
            (if (.isMode this EXPR)
                (do
                  (.selectExprMode this)
                  (.nextToken this)
                  (when (identical? (.-kind token) Tokens$TokenKind/LT)
                    (set! typeArgs (.typeArguments this false)))
                  (set! t (.creator this pos typeArgs))
                  (set! typeArgs nil))
                (return (.illegal this))))
        MONKEYS_AT
          (let [^{:tag (List JCTree$JCAnnotation)} typeAnnos (.typeAnnotationsOpt this)]
            (when (.isEmpty typeAnnos)
              (throw (AssertionError. "Expected type annotations, but found none!")))
            (let [expr (.term3 this)]
              (if (not (.isMode this TYPE))
                  (switch (.getTag expr)
                    REFERENCE
                      (let [mref (cast JCTree$JCMemberReference expr)]
                        (if (TreeInfo/isType (.-expr mref) names)
                            (set!
                              (.-expr mref)
                              (.insertAnnotationsToMostInner this (.-expr mref) typeAnnos false))
                            (let [annotatedType (cast
                                                  JCTree$JCAnnotatedType
                                                  (.toP
                                                    this
                                                    (.AnnotatedType
                                                      (.at F pos)
                                                      typeAnnos
                                                      (.-expr mref))))
                                  termStart (.getStartPos this (.-expr mref))]
                              (set! (.-expr mref)
                                    (.syntaxError
                                      this
                                      termStart
                                      (List/of annotatedType)
                                      CompilerProperties$Errors/IllegalStartOfType))))
                        (set! (.-pos mref) (.getStartPos this (.-expr mref)))
                        (set! t mref))
                    SELECT
                      (let [sel (cast JCTree$JCFieldAccess expr)]
                        (if (not (identical? (.-name sel) (.-_class names)))
                            (return (.illegal this))
                            (do
                              (.error log
                                      (.-pos token)
                                      CompilerProperties$Errors/NoAnnotationsOnDotClass)
                              (return expr))))
                    (return (.illegal this (.-pos (cast JCTree$JCAnnotation (.-head typeAnnos))))))
                  (set! t (.insertAnnotationsToMostInner this expr typeAnnos false)))))
        (UNDERSCORE IDENTIFIER ASSERT ENUM)
          (do
            (when (some? typeArgs) (return (.illegal this)))
            (if (and (and (.isMode this EXPR) (not (.isMode this NOLAMBDA)))
                     (.peekToken this Tokens$TokenKind/ARROW))
                (set! t (.lambdaExpressionOrStatement this false false pos))
                (do
                  (set! t
                        (cast JCTree$JCExpression
                              (.toP this (.Ident (.at F (.-pos token)) (.ident this)))))
                  (while true
                    (set! pos (.-pos token))
                    (let [^{:tag (List JCTree$JCAnnotation)} annos (.typeAnnotationsOpt this)]
                      (when (and (and (not (.isEmpty annos))
                                      (not (identical? (.-kind token) Tokens$TokenKind/LBRACKET)))
                                 (not (identical? (.-kind token) Tokens$TokenKind/ELLIPSIS)))
                        (return (.illegal this (.-pos (cast JCTree$JCAnnotation (.-head annos))))))
                      (switch (.-kind token)
                        LBRACKET
                          (do
                            (.nextToken this)
                            (if (identical? (.-kind token) Tokens$TokenKind/RBRACKET)
                                (do
                                  (.nextToken this)
                                  (set! t (.bracketsOpt this t))
                                  (set! t
                                        (cast JCTree$JCExpression
                                              (.toP this (.TypeArray (.at F pos) t))))
                                  (when (.nonEmpty annos)
                                    (set! t
                                          (cast JCTree$JCExpression
                                                (.toP this (.AnnotatedType (.at F pos) annos t)))))
                                  (set! t (.bracketsSuffix this t)))
                                (do
                                  (when (.isMode this EXPR)
                                    (.selectExprMode this)
                                    (let [t1 (.term this)]
                                      (when-not (.isEmpty annos)
                                        (set! t
                                              (.illegal
                                                this
                                                (.-pos (cast JCTree$JCAnnotation (.-head annos))))))
                                      (set! t
                                            (cast
                                              JCTree$JCExpression
                                              (.to this (.Indexed (.at F pos) t t1))))))
                                  (.accept this Tokens$TokenKind/RBRACKET)))
                            (break))
                        LPAREN
                          (do
                            (when (.isMode this EXPR)
                              (.selectExprMode this)
                              (set! t (.arguments this typeArgs t))
                              (when-not (.isEmpty annos)
                                (set! t
                                      (.illegal this
                                                (.-pos (cast JCTree$JCAnnotation (.-head annos))))))
                              (set! typeArgs nil))
                            (break))
                        DOT
                          (do
                            (.nextToken this)
                            (when (and (identical? (.-kind token) Tokens$TokenKind/IDENTIFIER)
                                       (some? typeArgs))
                              (return (.illegal this)))
                            (let [prevmode mode]
                              (.setMode this (bit-and-int mode (bit-not-int NOPARAMS)))
                              (set! typeArgs (.typeArgumentsOpt this EXPR))
                              (.setMode this prevmode)
                              (when (.isMode this EXPR)
                                (switch (.-kind token)
                                  CLASS
                                    (do
                                      (when (some? typeArgs) (return (.illegal this)))
                                      (.selectExprMode this)
                                      (set! t
                                            (cast
                                              JCTree$JCExpression
                                              (.to this (.Select (.at F pos) t (.-_class names)))))
                                      (.nextToken this)
                                      (break))
                                  THIS
                                    (do
                                      (when (some? typeArgs) (return (.illegal this)))
                                      (.selectExprMode this)
                                      (set! t
                                            (cast
                                              JCTree$JCExpression
                                              (.to this (.Select (.at F pos) t (.-_this names)))))
                                      (.nextToken this)
                                      (break))
                                  SUPER
                                    (do
                                      (.selectExprMode this)
                                      (set! t
                                            (cast
                                              JCTree$JCExpression
                                              (.to this (.Select (.at F pos) t (.-_super names)))))
                                      (set! t (.superSuffix this typeArgs t))
                                      (set! typeArgs nil)
                                      (break))
                                  NEW
                                    (do
                                      (when (some? typeArgs) (return (.illegal this)))
                                      (.selectExprMode this)
                                      (let [pos1 (.-pos token)]
                                        (.nextToken this)
                                        (when (identical? (.-kind token) Tokens$TokenKind/LT)
                                          (set! typeArgs (.typeArguments this false)))
                                        (set! t (.innerCreator this pos1 typeArgs t))
                                        (set! typeArgs nil)
                                        (break)))))
                              (let [^:mutable ^{:tag (List JCTree$JCAnnotation)} tyannos nil]
                                (when (and (.isMode this TYPE)
                                           (identical? (.-kind token) Tokens$TokenKind/MONKEYS_AT))
                                  (set! tyannos (.typeAnnotationsOpt this)))
                                (set! t
                                      (cast JCTree$JCExpression
                                            (.toP this (.Select (.at F pos) t (.ident this)))))
                                (when (and (<= (.-pos token) (.-errorEndPos endPosTable))
                                           (identical? (.-kind token) Tokens$TokenKind/MONKEYS_AT))
                                  (when (some? typeArgs) (.illegal this))
                                  (return (cast JCTree$JCExpression (.toP this t))))
                                (when (and (some? tyannos) (.nonEmpty tyannos))
                                  (set! t
                                        (cast JCTree$JCExpression
                                              (.toP
                                                this
                                                (.AnnotatedType
                                                  (.at
                                                    F
                                                    (.-pos
                                                      (cast JCTree$JCAnnotation (.-head tyannos))))
                                                  tyannos
                                                  t))))))))
                        ELLIPSIS
                          (do
                            (arbace.core/cond (.-permitTypeAnnotationsPushBack this)
                                              (set! (.-typeAnnotationsPushedBack this) annos)
                                              (.nonEmpty annos)
                                              (.illegal
                                                this
                                                (.-pos (cast JCTree$JCAnnotation (.-head annos)))))
                            (break))
                        LT
                          (do
                            (when (and (not (.isMode this TYPE)) (.isUnboundMemberRef this))
                              (let [pos1 (.-pos token)]
                                (.accept this Tokens$TokenKind/LT)
                                (let [^{:tag (ListBuffer JCTree$JCExpression)} args (ListBuffer.)]
                                  (.append args (.typeArgument this))
                                  (while (identical? (.-kind token) Tokens$TokenKind/COMMA)
                                    (.nextToken this)
                                    (.append args (.typeArgument this)))
                                  (.accept this Tokens$TokenKind/GT)
                                  (set! t
                                        (cast
                                          JCTree$JCExpression
                                          (.toP this (.TypeApply (.at F pos1) t (.toList args)))))
                                  (while (identical? (.-kind token) Tokens$TokenKind/DOT)
                                    (.nextToken this)
                                    (.selectTypeMode this)
                                    (set! t
                                          (cast JCTree$JCExpression
                                                (.toP
                                                  this
                                                  (.Select (.at F (.-pos token)) t (.ident this)))))
                                    (set! t (.typeArgumentsOpt this t)))
                                  (set! t (.bracketsOpt this t))
                                  (when-not (identical? (.-kind token) Tokens$TokenKind/COLCOL)
                                    (set! t (.illegal this)))
                                  (.selectExprMode this)
                                  (return (.term3Rest this t typeArgs)))))
                            (break))
                        (break))))))
            (when (some? typeArgs) (.illegal this))
            (set! t (.typeArgumentsOpt this t)))
        (BYTE SHORT CHAR INT LONG FLOAT DOUBLE BOOLEAN)
          (do
            (when (some? typeArgs) (.illegal this))
            (set! t (.bracketsSuffix this (.bracketsOpt this (.basicType this)))))
        VOID
          (do
            (when (some? typeArgs) (.illegal this))
            (if (.isMode this EXPR)
                (do
                  (.nextToken this)
                  (if (identical? (.-kind token) Tokens$TokenKind/DOT)
                      (let [ti (cast JCTree$JCPrimitiveTypeTree
                                     (.toP this (.TypeIdent (.at F pos) TypeTag/VOID)))]
                        (set! t (.bracketsSuffix this ti)))
                      (return (.illegal this pos))))
                (let [ti (cast JCTree$JCPrimitiveTypeTree
                               (.to this (.TypeIdent (.at F pos) TypeTag/VOID)))]
                  (.nextToken this)
                  (return ti))))
        SWITCH
          (do
            (.checkSourceLevel this Source$Feature/SWITCH_EXPRESSION)
            (set! allowYieldStatement true)
            (let [switchPos (.-pos token)]
              (.nextToken this)
              (let [selector (.parExpression this)]
                (.accept this Tokens$TokenKind/LBRACE)
                (let [^{:tag (ListBuffer JCTree$JCCase)} cases (ListBuffer.)]
                  (while true
                    (set! pos (.-pos token))
                    (switch (.-kind token)
                      (CASE DEFAULT) (.appendList cases (.switchExpressionStatementGroup this))
                      (RBRACE EOF)
                        (let [e (cast JCTree$JCSwitchExpression
                                      (.to this
                                           (.SwitchExpression
                                             (.at F switchPos)
                                             selector
                                             (.toList cases))))]
                          (set! (.-bracePos e) (.-pos token))
                          (.accept this Tokens$TokenKind/RBRACE)
                          (return e))
                      (do
                        (.nextToken this)
                        (.syntaxError this
                                      pos
                                      (CompilerProperties$Errors/Expected3
                                        Tokens$TokenKind/CASE
                                        Tokens$TokenKind/DEFAULT
                                        Tokens$TokenKind/RBRACE)))))))))
        (do
          (when (and (some? typeArgs) (not (== (bit-and-int startMode TYPE) 0)))
            (return (.TypeApply (.at F pos) (.Erroneous F) typeArgs)))
          (return (.illegal this))))
      (.term3Rest this t typeArgs)))

  (method ^:private switchExpressionStatementGroup ^{:tag (List JCTree$JCCase)} [this]
    (let [^{:tag (ListBuffer JCTree$JCCase)} caseExprs (ListBuffer.)
          casePos (.-pos token)
          ^{:tag (ListBuffer JCTree$JCCaseLabel)} pats (ListBuffer.)]
      (if (identical? (.-kind token) Tokens$TokenKind/DEFAULT)
          (do
            (.nextToken this)
            (.append pats (cast JCTree$JCCaseLabel (.toP this (.DefaultCaseLabel (.at F casePos))))))
          (do
            (.accept this Tokens$TokenKind/CASE)
            (let [^:mutable allowDefault false]
              (while true
                (let [label (.parseCaseLabel this allowDefault)]
                  (.append pats label)
                  (when-not (identical? (.-kind token) Tokens$TokenKind/COMMA) (break))
                  (.checkSourceLevel this Source$Feature/SWITCH_MULTIPLE_CASE_LABELS)
                  (.nextToken this)
                  (set! allowDefault (TreeInfo/isNullCaseLabel label)))))))
      (let [guard (.parseGuard this (cast JCTree$JCCaseLabel (.last pats)))
            ^:mutable ^{:tag (List JCTree$JCStatement)} stats nil
            ^:mutable ^JCTree body nil
            ^:mutable ^CaseTree$CaseKind kind nil]
        (switch (.-kind token)
          ARROW
            (do
              (.checkSourceLevel this Source$Feature/SWITCH_RULE)
              (.nextToken this)
              (if (or (identical? (.-kind token) Tokens$TokenKind/THROW)
                      (identical? (.-kind token) Tokens$TokenKind/LBRACE))
                  (do
                    (set! stats (List/of (.parseStatement this)))
                    (set! body (cast JCTree (.-head stats)))
                    (set! kind JCTree$JCCase/RULE))
                  (let [value (.parseExpression this)]
                    (set! stats
                          (List/of
                            (cast JCTree$JCStatement (.to this (.Yield (.at F value) value)))))
                    (set! body value)
                    (set! kind JCTree$JCCase/RULE)
                    (.accept this Tokens$TokenKind/SEMI))))
          (do
            (.accept this
                     Tokens$TokenKind/COLON
                     (lambda Function ^JCDiagnostic$Error [^Tokens$TokenKind tk]
                       (CompilerProperties$Errors/Expected2
                         Tokens$TokenKind/COLON
                         Tokens$TokenKind/ARROW)))
            (set! stats (.blockStatements this))
            (set! kind JCTree$JCCase/STATEMENT)))
        (.append caseExprs
                 (cast JCTree$JCCase
                       (.toP this (.Case (.at F casePos) kind (.toList pats) guard stats body))))
        (.toList caseExprs))))

  (method term3Rest ^JCTree$JCExpression [this ^:mutable ^JCTree$JCExpression t
                                          ^:mutable ^{:tag (List JCTree$JCExpression)} typeArgs]
    (when (some? typeArgs) (.illegal this))
    (while true
      (let [pos1 (.-pos token)
            ^{:tag (List JCTree$JCAnnotation)} annos (.typeAnnotationsOpt this)]
        (if (identical? (.-kind token) Tokens$TokenKind/LBRACKET)
            (do
              (.nextToken this)
              (when (.isMode this TYPE)
                (let [prevmode mode]
                  (.selectTypeMode this)
                  (when (identical? (.-kind token) Tokens$TokenKind/RBRACKET)
                    (.nextToken this)
                    (set! t (.bracketsOpt this t))
                    (set! t (cast JCTree$JCExpression (.toP this (.TypeArray (.at F pos1) t))))
                    (when (identical? (.-kind token) Tokens$TokenKind/COLCOL)
                      (.selectExprMode this)
                      (continue))
                    (when (.nonEmpty annos)
                      (set! t
                            (cast JCTree$JCExpression
                                  (.toP this (.AnnotatedType (.at F pos1) annos t)))))
                    (return t))
                  (.setMode this prevmode)))
              (when (.isMode this EXPR)
                (.selectExprMode this)
                (let [t1 (.term this)]
                  (set! t (cast JCTree$JCExpression (.to this (.Indexed (.at F pos1) t t1))))))
              (.accept this Tokens$TokenKind/RBRACKET))
            (arbace.core/cond
              (identical? (.-kind token) Tokens$TokenKind/DOT)
              (do
                (.nextToken this)
                (set! typeArgs (.typeArgumentsOpt this EXPR))
                (arbace.core/cond
                  (and (identical? (.-kind token) Tokens$TokenKind/SUPER) (.isMode this EXPR))
                  (do
                    (.selectExprMode this)
                    (set! t
                          (cast JCTree$JCExpression
                                (.to this (.Select (.at F pos1) t (.-_super names)))))
                    (.nextToken this)
                    (set! t (.arguments this typeArgs t))
                    (set! typeArgs nil))
                  (and (identical? (.-kind token) Tokens$TokenKind/NEW) (.isMode this EXPR))
                  (do
                    (when (some? typeArgs) (return (.illegal this)))
                    (.selectExprMode this)
                    (let [pos2 (.-pos token)]
                      (.nextToken this)
                      (when (identical? (.-kind token) Tokens$TokenKind/LT)
                        (set! typeArgs (.typeArguments this false)))
                      (set! t (.innerCreator this pos2 typeArgs t))
                      (set! typeArgs nil)))
                  :else
                  (let [^:mutable ^{:tag (List JCTree$JCAnnotation)} tyannos nil]
                    (when (and (.isMode this TYPE)
                               (identical? (.-kind token) Tokens$TokenKind/MONKEYS_AT))
                      (set! tyannos (.typeAnnotationsOpt this)))
                    (set! t
                          (cast JCTree$JCExpression
                                (.toP this (.Select (.at F pos1) t (.ident this true)))))
                    (when (and (<= (.-pos token) (.-errorEndPos endPosTable))
                               (identical? (.-kind token) Tokens$TokenKind/MONKEYS_AT))
                      (break))
                    (when (and (some? tyannos) (.nonEmpty tyannos))
                      (set! t
                            (cast JCTree$JCExpression
                                  (.toP this
                                        (.AnnotatedType
                                          (.at F
                                               (.-pos (cast JCTree$JCAnnotation (.-head tyannos))))
                                          tyannos
                                          t)))))
                    (set! t (.argumentsOpt this typeArgs (.typeArgumentsOpt this t)))
                    (set! typeArgs nil))))
              (and (.isMode this EXPR) (identical? (.-kind token) Tokens$TokenKind/COLCOL))
              (do
                (.selectExprMode this)
                (when (some? typeArgs) (return (.illegal this)))
                (.accept this Tokens$TokenKind/COLCOL)
                (set! t (.memberReferenceSuffix this pos1 t)))
              :else
              (do
                (when-not (.isEmpty annos)
                  (if permitTypeAnnotationsPushBack
                      (set! typeAnnotationsPushedBack annos)
                      (return (.illegal this (.-pos (cast JCTree$JCAnnotation (.-head annos)))))))
                (break))))))
    (while (and (or (identical? (.-kind token) Tokens$TokenKind/PLUSPLUS)
                    (identical? (.-kind token) Tokens$TokenKind/SUBSUB))
                (.isMode this EXPR))
      (.selectExprMode this)
      (set! t
            (cast JCTree$JCExpression
                  (.to this
                       (.Unary (.at F (.-pos token))
                               ^JCTree$Tag (if (identical? (.-kind token) Tokens$TokenKind/PLUSPLUS)
                                               JCTree$Tag/POSTINC
                                               JCTree$Tag/POSTDEC)
                               t))))
      (.nextToken this))
    (cast JCTree$JCExpression (.toP this t)))

  (method isUnboundMemberRef ^boolean [this]
    (let [^:mutable ^int pos 0
          ^:mutable ^int depth 0]
      (label :outer
        (loop [t (.token S pos)]
          (switch (.-kind t)
            (IDENTIFIER UNDERSCORE
                        QUES
                        EXTENDS
                        SUPER
                        DOT
                        RBRACKET
                        LBRACKET
                        COMMA
                        BYTE
                        SHORT
                        INT
                        LONG
                        FLOAT
                        DOUBLE
                        BOOLEAN
                        CHAR
                        MONKEYS_AT)
              (recur (.token S (set! pos (unchecked-inc-int pos))))
            LPAREN
              (let [^:mutable ^int nesting 0]
                (while true
                  (let [tk2 (.-kind (.token S pos))]
                    (switch tk2
                      EOF (return false)
                      LPAREN (set! nesting (unchecked-inc-int nesting))
                      RPAREN
                        (do
                          (set! nesting (unchecked-dec-int nesting))
                          (when (== nesting 0)
                            (continue :outer (.token S (set! pos (unchecked-inc-int pos))))))))
                  (set! pos (unchecked-inc-int pos))))
            LT
              (do
                (set! depth (unchecked-inc-int depth))
                (recur (.token S (set! pos (unchecked-inc-int pos)))))
            GTGTGT
              (do
                (set! depth (unchecked-dec-int depth))
                (set! depth (unchecked-dec-int depth))
                (set! depth (unchecked-dec-int depth))
                (when (== depth 0)
                  (let [nextKind (.-kind (.token S (unchecked-add-int pos 1)))]
                    (return (or (or (identical? nextKind Tokens$TokenKind/DOT)
                                    (identical? nextKind Tokens$TokenKind/LBRACKET))
                                (identical? nextKind Tokens$TokenKind/COLCOL)))))
                (recur (.token S (set! pos (unchecked-inc-int pos)))))
            GTGT
              (do
                (set! depth (unchecked-dec-int depth))
                (set! depth (unchecked-dec-int depth))
                (when (== depth 0)
                  (let [nextKind (.-kind (.token S (unchecked-add-int pos 1)))]
                    (return (or (or (identical? nextKind Tokens$TokenKind/DOT)
                                    (identical? nextKind Tokens$TokenKind/LBRACKET))
                                (identical? nextKind Tokens$TokenKind/COLCOL)))))
                (recur (.token S (set! pos (unchecked-inc-int pos)))))
            GT
              (do
                (set! depth (unchecked-dec-int depth))
                (when (== depth 0)
                  (let [nextKind (.-kind (.token S (unchecked-add-int pos 1)))]
                    (return (or (or (identical? nextKind Tokens$TokenKind/DOT)
                                    (identical? nextKind Tokens$TokenKind/LBRACKET))
                                (identical? nextKind Tokens$TokenKind/COLCOL)))))
                (recur (.token S (set! pos (unchecked-inc-int pos)))))
            (return false))))))

  (method analyzeParens ^ParensResult [this]
    (let [^:mutable ^int depth 0
          ^:mutable type false
          ^:mutable defaultResult ParensResult/PARENS
          ^:mutable ^int lookahead 0]
      (while true
        (let [tk (.-kind (.token S lookahead))]
          (switch tk
            COMMA (set! type true)
            (EXTENDS SUPER DOT AMP) nil
            QUES
              (when (or (.peekToken this lookahead Tokens$TokenKind/EXTENDS)
                        (.peekToken this lookahead Tokens$TokenKind/SUPER))
                (set! type true))
            (BYTE SHORT INT LONG FLOAT DOUBLE BOOLEAN CHAR VOID)
              (arbace.core/cond (.peekToken this lookahead Tokens$TokenKind/RPAREN)
                                (return ParensResult/CAST)
                                (.peekToken this lookahead LAX_IDENTIFIER)
                                (return ParensResult/EXPLICIT_LAMBDA))
            LPAREN
              (arbace.core/cond (not (== lookahead 0))
                                (return ParensResult/PARENS)
                                (.peekToken this lookahead Tokens$TokenKind/RPAREN)
                                (return ParensResult/EXPLICIT_LAMBDA))
            RPAREN
              (do
                (when type (return ParensResult/CAST))
                (switch (.-kind (.token S (unchecked-add-int lookahead 1)))
                  (BANG TILDE
                        LPAREN
                        THIS
                        SUPER
                        INTLITERAL
                        LONGLITERAL
                        FLOATLITERAL
                        DOUBLELITERAL
                        CHARLITERAL
                        STRINGLITERAL
                        STRINGFRAGMENT
                        TRUE
                        FALSE
                        NULL
                        NEW
                        IDENTIFIER
                        ASSERT
                        ENUM
                        UNDERSCORE
                        SWITCH
                        BYTE
                        SHORT
                        CHAR
                        INT
                        LONG
                        FLOAT
                        DOUBLE
                        BOOLEAN
                        VOID)
                    (return ParensResult/CAST)
                  (return defaultResult)))
            (UNDERSCORE ASSERT ENUM IDENTIFIER)
              (do
                (if (.peekToken this lookahead LAX_IDENTIFIER)
                    (return ParensResult/EXPLICIT_LAMBDA)
                    (arbace.core/cond
                      (.peekToken this lookahead Tokens$TokenKind/RPAREN Tokens$TokenKind/ARROW)
                      (return (if (not (.isMode this NOLAMBDA))
                                  ParensResult/IMPLICIT_LAMBDA
                                  ParensResult/PARENS))
                      (and (== depth 0) (.peekToken this lookahead Tokens$TokenKind/COMMA))
                      (set! defaultResult ParensResult/IMPLICIT_LAMBDA)))
                (set! type false))
            (FINAL ELLIPSIS) (return ParensResult/EXPLICIT_LAMBDA)
            MONKEYS_AT (do (set! type true) (set! lookahead (.skipAnnotation this lookahead)))
            LBRACKET
              (if (.peekToken this lookahead Tokens$TokenKind/RBRACKET LAX_IDENTIFIER)
                  (return ParensResult/EXPLICIT_LAMBDA)
                  (arbace.core/cond
                    (or (.peekToken this
                                    lookahead
                                    Tokens$TokenKind/RBRACKET
                                    Tokens$TokenKind/RPAREN)
                        (.peekToken this lookahead Tokens$TokenKind/RBRACKET Tokens$TokenKind/AMP))
                    (return ParensResult/CAST)
                    (.peekToken this lookahead Tokens$TokenKind/RBRACKET)
                    (do (set! type true) (set! lookahead (unchecked-inc-int lookahead)))
                    :else
                    (return ParensResult/PARENS)))
            LT (set! depth (unchecked-inc-int depth))
            GTGTGT
              (do
                (set! depth (unchecked-dec-int depth))
                (set! depth (unchecked-dec-int depth))
                (set! depth (unchecked-dec-int depth))
                (arbace.core/cond (== depth 0)
                                  (do
                                    (arbace.core/cond
                                      (or (.peekToken this lookahead Tokens$TokenKind/RPAREN)
                                          (.peekToken this lookahead Tokens$TokenKind/AMP))
                                      (return ParensResult/CAST)
                                      (or (or (.peekToken
                                                this
                                                lookahead
                                                LAX_IDENTIFIER
                                                Tokens$TokenKind/COMMA)
                                              (.peekToken
                                                this
                                                lookahead
                                                LAX_IDENTIFIER
                                                Tokens$TokenKind/RPAREN
                                                Tokens$TokenKind/ARROW))
                                          (.peekToken this lookahead Tokens$TokenKind/ELLIPSIS))
                                      (return ParensResult/EXPLICIT_LAMBDA))
                                    (set! type true))
                                  (< depth 0)
                                  (return ParensResult/PARENS)))
            GTGT
              (do
                (set! depth (unchecked-dec-int depth))
                (set! depth (unchecked-dec-int depth))
                (arbace.core/cond (== depth 0)
                                  (do
                                    (arbace.core/cond
                                      (or (.peekToken this lookahead Tokens$TokenKind/RPAREN)
                                          (.peekToken this lookahead Tokens$TokenKind/AMP))
                                      (return ParensResult/CAST)
                                      (or (or (.peekToken
                                                this
                                                lookahead
                                                LAX_IDENTIFIER
                                                Tokens$TokenKind/COMMA)
                                              (.peekToken
                                                this
                                                lookahead
                                                LAX_IDENTIFIER
                                                Tokens$TokenKind/RPAREN
                                                Tokens$TokenKind/ARROW))
                                          (.peekToken this lookahead Tokens$TokenKind/ELLIPSIS))
                                      (return ParensResult/EXPLICIT_LAMBDA))
                                    (set! type true))
                                  (< depth 0)
                                  (return ParensResult/PARENS)))
            GT
              (do
                (set! depth (unchecked-dec-int depth))
                (arbace.core/cond (== depth 0)
                                  (do
                                    (arbace.core/cond
                                      (or (.peekToken this lookahead Tokens$TokenKind/RPAREN)
                                          (.peekToken this lookahead Tokens$TokenKind/AMP))
                                      (return ParensResult/CAST)
                                      (or (or (.peekToken
                                                this
                                                lookahead
                                                LAX_IDENTIFIER
                                                Tokens$TokenKind/COMMA)
                                              (.peekToken
                                                this
                                                lookahead
                                                LAX_IDENTIFIER
                                                Tokens$TokenKind/RPAREN
                                                Tokens$TokenKind/ARROW))
                                          (.peekToken this lookahead Tokens$TokenKind/ELLIPSIS))
                                      (return ParensResult/EXPLICIT_LAMBDA))
                                    (set! type true))
                                  (< depth 0)
                                  (return ParensResult/PARENS)))
            (return defaultResult)))
        (set! lookahead (unchecked-inc-int lookahead)))))

  (method ^:private skipAnnotation ^int [this ^:mutable ^int lookahead]
    (set! lookahead (unchecked-add-int lookahead 1))
    (while (.peekToken this lookahead Tokens$TokenKind/DOT)
      (set! lookahead (unchecked-add-int lookahead 2)))
    (when (.peekToken this lookahead Tokens$TokenKind/LPAREN)
      (set! lookahead (unchecked-inc-int lookahead))
      (let [^:mutable ^int nesting 0]
        (while true
          (let [tk2 (.-kind (.token S lookahead))]
            (switch tk2
              EOF (return lookahead)
              LPAREN (set! nesting (unchecked-inc-int nesting))
              RPAREN
                (do
                  (set! nesting (unchecked-dec-int nesting))
                  (when (== nesting 0) (return lookahead)))))
          (set! lookahead (unchecked-inc-int lookahead)))))
    lookahead)

  (field ^:protected ^{:tag (Predicate Tokens$TokenKind)} LAX_IDENTIFIER
    (lambda Predicate ^boolean [^Tokens$TokenKind t]
      (or (or (or (identical? t Tokens$TokenKind/IDENTIFIER)
                  (identical? t Tokens$TokenKind/UNDERSCORE))
              (identical? t Tokens$TokenKind/ASSERT))
          (identical? t Tokens$TokenKind/ENUM))))

  (defclass ^:enum ParensResult
    (constants CAST EXPLICIT_LAMBDA IMPLICIT_LAMBDA PARENS))

  (method lambdaExpressionOrStatement ^JCTree$JCExpression [this ^boolean hasParens
                                                            ^boolean explicitParams ^int pos]
    (let [^{:tag (List JCTree$JCVariableDecl)} params (if explicitParams
                                                          (.formalParameters this true false)
                                                          (.implicitParameters this hasParens))]
      (when explicitParams
        (let [lambdaClassifier (LambdaClassifier.)]
          (for-each [^JCTree$JCVariableDecl param params]
            (let [^:mutable ^Name restrictedTypeName nil]
              (when (and (and (some? (.-vartype param))
                              (some? (set! restrictedTypeName
                                           (.restrictedTypeName this (.-vartype param) false))))
                         (.hasTag (.-vartype param) JCTree$Tag/TYPEARRAY))
                (.error
                  log
                  JCDiagnostic$DiagnosticFlag/SYNTAX
                  (.-pos param)
                  ^JCDiagnostic$Error (if (.allowedInSource
                                            Source$Feature/VAR_SYNTAX_IMPLICIT_LAMBDAS
                                            source)
                                          (CompilerProperties$Errors/RestrictedTypeNotAllowedArray
                                            restrictedTypeName)
                                          (CompilerProperties$Errors/RestrictedTypeNotAllowedHere
                                            restrictedTypeName))))
              (.addParameter lambdaClassifier param)
              (when (identical? (.result lambdaClassifier) LambdaParameterKind/ERROR) (break))))
          (when (some? (.-diagFragment lambdaClassifier))
            (.error log
                    JCDiagnostic$DiagnosticFlag/SYNTAX
                    pos
                    (CompilerProperties$Errors/InvalidLambdaParameterDeclaration
                      (.-diagFragment lambdaClassifier))))
          (for-each [^JCTree$JCVariableDecl param params]
            (when (and (some? (.-vartype param))
                       (some? (.restrictedTypeName this (.-vartype param) true)))
              (.checkSourceLevel this (.-pos param) Source$Feature/VAR_SYNTAX_IMPLICIT_LAMBDAS)
              (set! (.-declKind param) JCTree$JCVariableDecl$DeclKind/VAR)
              (set! (.-typePos param) (TreeInfo/getStartPos (.-vartype param)))
              (set! (.-vartype param) nil)))))
      (.lambdaExpressionOrStatementRest this params pos)))

  (defclass ^:enum LambdaParameterKind
    (constants (VAR [0]) (EXPLICIT [1]) (IMPLICIT [2]) (ERROR [-1]))

    (field ^:private ^:final ^int index)

    (constructor [this ^int index] (set! (.-index this) index)))

  (field ^:private ^:static ^:final ^JCDiagnostic$Fragment/2 decisionTable
    (new JCDiagnostic$Fragment/2
         [[nil
           CompilerProperties$Fragments/VarAndExplicitNotAllowed
           CompilerProperties$Fragments/VarAndImplicitNotAllowed]
          [CompilerProperties$Fragments/VarAndExplicitNotAllowed
           nil
           CompilerProperties$Fragments/ImplicitAndExplicitNotAllowed]
          [CompilerProperties$Fragments/VarAndImplicitNotAllowed
           CompilerProperties$Fragments/ImplicitAndExplicitNotAllowed
           nil]]))

  (defclass LambdaClassifier
    (field ^LambdaParameterKind kind)

    (field ^JCDiagnostic$Fragment diagFragment)

    (method addParameter ^void [this ^JCTree$JCVariableDecl param]
      (Assert/check (some? (.-vartype param)))
      (arbace.core/cond (identical? (.-name param) (.-error names))
                        (.reduce this LambdaParameterKind/IMPLICIT)
                        (some? (.restrictedTypeName JavacParser/this (.-vartype param) false))
                        (.reduce this LambdaParameterKind/VAR)
                        :else
                        (.reduce this LambdaParameterKind/EXPLICIT)))

    (method ^:private reduce ^void [this ^LambdaParameterKind newKind]
      (arbace.core/cond
        (nil? kind)
        (set! kind newKind)
        (and (not (identical? kind newKind)) (not (identical? kind LambdaParameterKind/ERROR)))
        (let [currentKind kind]
          (set! kind LambdaParameterKind/ERROR)
          (let [varIndex (or (== (.-index currentKind) (.-index LambdaParameterKind/VAR))
                             (== (.-index newKind) (.-index LambdaParameterKind/VAR)))]
            (set! diagFragment
                  (when (or (.allowedInSource Source$Feature/VAR_SYNTAX_IMPLICIT_LAMBDAS source)
                            (not varIndex))
                    (aget decisionTable (.-index currentKind) (.-index newKind))))))))

    (method result ^LambdaParameterKind [this] kind))

  (method lambdaExpressionOrStatementRest ^JCTree$JCExpression [this
                                                                ^{:tag (List JCTree$JCVariableDecl)} args
                                                                ^int pos]
    (.accept this Tokens$TokenKind/ARROW)
    (if (identical? (.-kind token) Tokens$TokenKind/LBRACE)
        (.lambdaStatement this args pos (.-pos token))
        (.lambdaExpression this args pos)))

  (method lambdaStatement ^JCTree$JCExpression [this ^{:tag (List JCTree$JCVariableDecl)} args
                                                ^int pos ^int pos2]
    (let [block (.block this pos2 0)]
      (cast JCTree$JCExpression (.toP this (.Lambda (.at F pos) args block)))))

  (method lambdaExpression ^JCTree$JCExpression [this ^{:tag (List JCTree$JCVariableDecl)} args
                                                 ^int pos]
    (let [^JCTree expr (.parseExpression this)]
      (cast JCTree$JCExpression (.toP this (.Lambda (.at F pos) args expr)))))

  (method superSuffix ^JCTree$JCExpression [this
                                            ^:mutable ^{:tag (List JCTree$JCExpression)} typeArgs
                                            ^:mutable ^JCTree$JCExpression t]
    (.nextToken this)
    (arbace.core/cond (or (identical? (.-kind token) Tokens$TokenKind/LPAREN) (some? typeArgs))
                      (set! t (.arguments this typeArgs t))
                      (identical? (.-kind token) Tokens$TokenKind/COLCOL)
                      (do
                        (when (some? typeArgs) (return (.illegal this)))
                        (set! t (.memberReferenceSuffix this t)))
                      :else
                      (let [pos (.-pos token)]
                        (.accept this Tokens$TokenKind/DOT)
                        (set! typeArgs
                              (when (identical? (.-kind token) Tokens$TokenKind/LT)
                                (.typeArguments this false)))
                        (set! t
                              (cast JCTree$JCExpression
                                    (.toP this (.Select (.at F pos) t (.ident this)))))
                        (set! t (.argumentsOpt this typeArgs t))))
    t)

  (method basicType ^JCTree$JCPrimitiveTypeTree [this]
    (let [t (cast
              JCTree$JCPrimitiveTypeTree
              (.to this (.TypeIdent (.at F (.-pos token)) (JavacParser/typetag (.-kind token)))))]
      (.nextToken this)
      t))

  (method argumentsOpt ^JCTree$JCExpression [this ^{:tag (List JCTree$JCExpression)} typeArgs
                                             ^JCTree$JCExpression t]
    (if (or (and (.isMode this EXPR) (identical? (.-kind token) Tokens$TokenKind/LPAREN))
            (some? typeArgs))
        (do (.selectExprMode this) (.arguments this typeArgs t))
        t))

  (method arguments ^{:tag (List JCTree$JCExpression)} [this]
    (let [^{:tag (ListBuffer JCTree$JCExpression)} args (ListBuffer.)]
      (if (identical? (.-kind token) Tokens$TokenKind/LPAREN)
          (do
            (.nextToken this)
            (when-not (identical? (.-kind token) Tokens$TokenKind/RPAREN)
              (.append args (.parseExpression this))
              (while (identical? (.-kind token) Tokens$TokenKind/COMMA)
                (.nextToken this)
                (.append args (.parseExpression this))))
            (.accept this
                     Tokens$TokenKind/RPAREN
                     (lambda Function ^JCDiagnostic$Error [^Tokens$TokenKind tk]
                       (CompilerProperties$Errors/Expected2
                         Tokens$TokenKind/RPAREN
                         Tokens$TokenKind/COMMA))))
          (.syntaxError this
                        (.-pos token)
                        (CompilerProperties$Errors/Expected Tokens$TokenKind/LPAREN)))
      (.toList args)))

  (method arguments ^JCTree$JCExpression [this ^{:tag (List JCTree$JCExpression)} typeArgs
                                          ^JCTree$JCExpression t]
    (let [pos (.-pos token)
          ^{:tag (List JCTree$JCExpression)} args (.arguments this)
          ^:mutable ^JCTree$JCExpression mi (.Apply (.at F pos) typeArgs t args)]
      (when (and (.hasTag t JCTree$Tag/IDENT)
                 (.isInvalidUnqualifiedMethodIdentifier
                   this
                   (.-pos (cast JCTree$JCIdent t))
                   (.-name (cast JCTree$JCIdent t))))
        (.error log JCDiagnostic$DiagnosticFlag/SYNTAX t CompilerProperties$Errors/InvalidYield)
        (set! mi (.Erroneous F (List/of mi))))
      (cast JCTree$JCExpression (.toP this mi))))

  (method isInvalidUnqualifiedMethodIdentifier ^boolean [this ^int pos ^Name name]
    (when (identical? name (.-yield names))
      (if allowYieldStatement
          (return true)
          (.warning log pos CompilerProperties$Warnings/InvalidYield)))
    false)

  (method typeArgumentsOpt ^JCTree$JCExpression [this ^JCTree$JCExpression t]
    (if (and (and (identical? (.-kind token) Tokens$TokenKind/LT) (.isMode this TYPE))
             (not (.isMode this NOPARAMS)))
        (do (.selectTypeMode this) (.typeArguments this t false))
        t))

  (method typeArgumentsOpt ^{:tag (List JCTree$JCExpression)} [this]
    (.typeArgumentsOpt this TYPE))

  (method typeArgumentsOpt ^{:tag (List JCTree$JCExpression)} [this ^int useMode]
    (when (identical? (.-kind token) Tokens$TokenKind/LT)
      (when (or (not (.isMode this useMode)) (.isMode this NOPARAMS)) (.illegal this))
      (.setMode this useMode)
      (.typeArguments this false)))

  (method typeArguments ^{:tag (List JCTree$JCExpression)} [this ^boolean diamondAllowed]
    (if (identical? (.-kind token) Tokens$TokenKind/LT)
        (do
          (.nextToken this)
          (if (and (identical? (.-kind token) Tokens$TokenKind/GT) diamondAllowed)
              (do (.setMode this (bit-or-int mode DIAMOND)) (.nextToken this) (List/nil))
              (let [^{:tag (ListBuffer JCTree$JCExpression)} args (ListBuffer.)]
                (.append args
                         ^JCTree$JCExpression (if (not (.isMode this EXPR))
                                                  (.typeArgument this)
                                                  (.parseType this)))
                (while (identical? (.-kind token) Tokens$TokenKind/COMMA)
                  (.nextToken this)
                  (.append args
                           ^JCTree$JCExpression (if (not (.isMode this EXPR))
                                                    (.typeArgument this)
                                                    (.parseType this))))
                (switch (.-kind token)
                  (GTGTGTEQ GTGTEQ GTEQ GTGTGT GTGT) (set! token (.split S))
                  GT (.nextToken this)
                  (.append args
                           (.syntaxError this
                                         (.-pos token)
                                         (CompilerProperties$Errors/Expected2
                                           Tokens$TokenKind/GT
                                           Tokens$TokenKind/COMMA))))
                (.toList args))))
        (List/of (.syntaxError this
                               (.-pos token)
                               (CompilerProperties$Errors/Expected Tokens$TokenKind/LT)))))

  (method typeArgument ^JCTree$JCExpression [this]
    (let [^{:tag (List JCTree$JCAnnotation)} annotations (.typeAnnotationsOpt this)]
      (if (not (identical? (.-kind token) Tokens$TokenKind/QUES))
          (.parseType this false annotations)
          (let [pos (.-pos token)]
            (.nextToken this)
            (let [^:mutable ^JCTree$JCExpression result nil]
              (if (identical? (.-kind token) Tokens$TokenKind/EXTENDS)
                  (let [t (cast JCTree$TypeBoundKind
                                (.to this (.TypeBoundKind (.at F pos) BoundKind/EXTENDS)))]
                    (.nextToken this)
                    (let [bound (.parseType this)] (set! result (.Wildcard (.at F pos) t bound))))
                  (arbace.core/cond (identical? (.-kind token) Tokens$TokenKind/SUPER)
                                    (let [t (cast
                                              JCTree$TypeBoundKind
                                              (.to
                                                this
                                                (.TypeBoundKind (.at F pos) BoundKind/SUPER)))]
                                      (.nextToken this)
                                      (let [bound (.parseType this)]
                                        (set! result (.Wildcard (.at F pos) t bound))))
                                    (.test LAX_IDENTIFIER (.-kind token))
                                    (let [t (.TypeBoundKind
                                              (.at F Position/NOPOS)
                                              BoundKind/UNBOUND)
                                          wc (cast
                                               JCTree$JCExpression
                                               (.toP this (.Wildcard (.at F pos) t nil)))
                                          id (cast
                                               JCTree$JCIdent
                                               (.toP
                                                 this
                                                 (.Ident (.at F (.-pos token)) (.ident this))))
                                          err (.Erroneous (.at F pos) (List/of wc id))]
                                      (.reportSyntaxError
                                        this
                                        err
                                        (CompilerProperties$Errors/Expected3
                                          Tokens$TokenKind/GT
                                          Tokens$TokenKind/EXTENDS
                                          Tokens$TokenKind/SUPER))
                                      (set! result err))
                                    :else
                                    (let [t (cast
                                              JCTree$TypeBoundKind
                                              (.toP
                                                this
                                                (.TypeBoundKind (.at F pos) BoundKind/UNBOUND)))]
                                      (set! result
                                            (cast
                                              JCTree$JCExpression
                                              (.toP this (.Wildcard (.at F pos) t nil)))))))
              (when-not (.isEmpty annotations)
                (set! result
                      (cast JCTree$JCExpression
                            (.toP this
                                  (.AnnotatedType
                                    (.at F (.-pos (cast JCTree$JCAnnotation (.-head annotations))))
                                    annotations
                                    result)))))
              result)))))

  (method typeArguments ^JCTree$JCTypeApply [this ^JCTree$JCExpression t ^boolean diamondAllowed]
    (let [pos (.-pos token)
          ^{:tag (List JCTree$JCExpression)} args (.typeArguments this diamondAllowed)]
      (cast JCTree$JCTypeApply (.toP this (.TypeApply (.at F pos) t args)))))

  (method ^:private bracketsOpt ^JCTree$JCExpression [this ^:mutable ^JCTree$JCExpression t
                                                      ^{:tag (List JCTree$JCAnnotation)} annotations]
    (let [^{:tag (List JCTree$JCAnnotation)} nextLevelAnnotations (.typeAnnotationsOpt this)]
      (if (identical? (.-kind token) Tokens$TokenKind/LBRACKET)
          (let [pos (.-pos token)]
            (.nextToken this)
            (set! t (.bracketsOptCont this t pos nextLevelAnnotations)))
          (when-not (.isEmpty nextLevelAnnotations)
            (if permitTypeAnnotationsPushBack
                (set! (.-typeAnnotationsPushedBack this) nextLevelAnnotations)
                (return (.illegal this
                                  (.-pos (cast JCTree$JCAnnotation (.-head nextLevelAnnotations))))))))
      (when-not (.isEmpty annotations)
        (set! t
              (cast JCTree$JCExpression
                    (.toP this (.AnnotatedType (.at F (.-pos token)) annotations t)))))
      t))

  (method ^:private bracketsOpt ^JCTree$JCExpression [this ^JCTree$JCExpression t]
    (.bracketsOpt this t (List/nil)))

  (method ^:private bracketsOptCont ^JCTree$JCExpression [this ^:mutable ^JCTree$JCExpression t
                                                          ^int pos
                                                          ^{:tag (List JCTree$JCAnnotation)} annotations]
    (.accept this Tokens$TokenKind/RBRACKET)
    (set! t (.bracketsOpt this t))
    (set! t (cast JCTree$JCExpression (.toP this (.TypeArray (.at F pos) t))))
    (when (.nonEmpty annotations)
      (set! t (cast JCTree$JCExpression (.toP this (.AnnotatedType (.at F pos) annotations t)))))
    t)

  (method bracketsSuffix ^JCTree$JCExpression [this ^:mutable ^JCTree$JCExpression t]
    (arbace.core/cond
      (and (.isMode this EXPR) (identical? (.-kind token) Tokens$TokenKind/DOT))
      (do
        (.selectExprMode this)
        (let [pos (.-pos token)]
          (.nextToken this)
          (.accept this Tokens$TokenKind/CLASS)
          (if (== (.-pos token) (.-errorEndPos endPosTable))
              (let [^:mutable ^Name name nil]
                (if (.test LAX_IDENTIFIER (.-kind token))
                    (do (set! name (.name token)) (.nextToken this))
                    (set! name (.-error names)))
                (set! t (.Erroneous (.at F pos) (List/of (.toP this (.Select (.at F pos) t name))))))
              (let [tag (.getTag t)]
                (when (or (and (identical? tag JCTree$Tag/TYPEARRAY)
                               (TreeInfo/containsTypeAnnotation t))
                          (identical? tag JCTree$Tag/ANNOTATED_TYPE))
                  (.syntaxError this
                                (.-pos token)
                                CompilerProperties$Errors/NoAnnotationsOnDotClass))
                (set! t
                      (cast JCTree$JCExpression
                            (.toP this (.Select (.at F pos) t (.-_class names)))))))))
      (.isMode this TYPE)
      (when-not (identical? (.-kind token) Tokens$TokenKind/COLCOL) (.selectTypeMode this))
      :else
      (when-not (identical? (.-kind token) Tokens$TokenKind/COLCOL)
        (.syntaxError this (.-pos token) CompilerProperties$Errors/DotClassExpected)))
    t)

  (method memberReferenceSuffix ^JCTree$JCExpression [this ^JCTree$JCExpression t]
    (let [pos1 (.-pos token)]
      (.accept this Tokens$TokenKind/COLCOL)
      (.memberReferenceSuffix this pos1 t)))

  (method memberReferenceSuffix ^JCTree$JCExpression [this ^int pos1 ^JCTree$JCExpression t]
    (.selectExprMode this)
    (let [^:mutable ^{:tag (List JCTree$JCExpression)} typeArgs nil]
      (when (identical? (.-kind token) Tokens$TokenKind/LT)
        (set! typeArgs (.typeArguments this false)))
      (let [^:mutable ^Name refName nil
            ^:mutable ^MemberReferenceTree$ReferenceMode refMode nil]
        (if (identical? (.-kind token) Tokens$TokenKind/NEW)
            (do
              (set! refMode MemberReferenceTree$ReferenceMode/NEW)
              (set! refName (.-init names))
              (.nextToken this))
            (do
              (set! refMode MemberReferenceTree$ReferenceMode/INVOKE)
              (set! refName (.ident this))))
        (cast JCTree$JCExpression
              (.toP this (.Reference (.at F (.getStartPosition t)) refMode refName t typeArgs))))))

  (method creator ^JCTree$JCExpression [this ^int newpos ^{:tag (List JCTree$JCExpression)} typeArgs]
    (let [^{:tag (List JCTree$JCAnnotation)} newAnnotations (.typeAnnotationsOpt this)]
      (switch (.-kind token)
        (BYTE SHORT CHAR INT LONG FLOAT DOUBLE BOOLEAN)
          (when (nil? typeArgs)
            (if (.isEmpty newAnnotations)
                (return (.arrayCreatorRest this newpos (.basicType this)))
                (return (.arrayCreatorRest this
                                           newpos
                                           (cast
                                             JCTree$JCExpression
                                             (.toP
                                               this
                                               (.AnnotatedType
                                                 (.at
                                                   F
                                                   (.-pos
                                                     (cast
                                                       JCTree$JCAnnotation
                                                       (.-head newAnnotations))))
                                                 newAnnotations
                                                 (.basicType this))))))))
        nil)
      (let [^:mutable t (.qualident this true)
            prevmode mode]
        (.selectTypeMode this)
        (let [^:mutable diamondFound false
              ^:mutable ^int lastTypeargsPos -1]
          (when (identical? (.-kind token) Tokens$TokenKind/LT)
            (set! lastTypeargsPos (.-pos token))
            (set! t (.typeArguments this t true))
            (set! diamondFound (.isMode this DIAMOND)))
          (while (identical? (.-kind token) Tokens$TokenKind/DOT)
            (when diamondFound (.illegal this))
            (let [pos (.-pos token)]
              (.nextToken this)
              (let [^{:tag (List JCTree$JCAnnotation)} tyannos (.typeAnnotationsOpt this)]
                (set! t
                      (cast JCTree$JCExpression (.toP this (.Select (.at F pos) t (.ident this)))))
                (when (and (some? tyannos) (.nonEmpty tyannos))
                  (set! t
                        (cast JCTree$JCExpression
                              (.toP this
                                    (.AnnotatedType
                                      (.at F (.-pos (cast JCTree$JCAnnotation (.-head tyannos))))
                                      tyannos
                                      t)))))
                (when (identical? (.-kind token) Tokens$TokenKind/LT)
                  (set! lastTypeargsPos (.-pos token))
                  (set! t (.typeArguments this t true))
                  (set! diamondFound (.isMode this DIAMOND))))))
          (.setMode this prevmode)
          (arbace.core/cond
            (or (identical? (.-kind token) Tokens$TokenKind/LBRACKET)
                (identical? (.-kind token) Tokens$TokenKind/MONKEYS_AT))
            (do
              (when (.nonEmpty newAnnotations)
                (set! t (.insertAnnotationsToMostInner this t newAnnotations false)))
              (let [e (.arrayCreatorRest this newpos t)]
                (arbace.core/cond
                  diamondFound
                  (do
                    (.reportSyntaxError this
                                        lastTypeargsPos
                                        CompilerProperties$Errors/CannotCreateArrayWithDiamond)
                    (cast JCTree$JCExpression (.toP this (.Erroneous (.at F newpos) (List/of e)))))
                  (some? typeArgs)
                  (let [^:mutable pos newpos]
                    (when (and (not (.isEmpty typeArgs))
                               (not (== (.-pos (cast JCTree$JCExpression (.-head typeArgs)))
                                        Position/NOPOS)))
                      (set! pos (.-pos (cast JCTree$JCExpression (.-head typeArgs)))))
                    (.setErrorEndPos this (.-endPos (.prevToken S)))
                    (let [err (.Erroneous (.at F pos) (.prepend typeArgs e))]
                      (.reportSyntaxError
                        this
                        err
                        CompilerProperties$Errors/CannotCreateArrayWithTypeArguments)
                      (cast JCTree$JCExpression (.toP this err))))
                  :else
                  e)))
            (identical? (.-kind token) Tokens$TokenKind/LPAREN)
            (do
              (when (.nonEmpty newAnnotations)
                (set! t (.insertAnnotationsToMostInner this t newAnnotations false)))
              (.classCreatorRest this newpos nil typeArgs t))
            :else
            (do
              (.setErrorEndPos this (.-pos token))
              (.reportSyntaxError this
                                  (.-pos token)
                                  (CompilerProperties$Errors/Expected2
                                    Tokens$TokenKind/LPAREN
                                    Tokens$TokenKind/LBRACKET))
              (set! t
                    (cast JCTree$JCExpression
                          (.toP this (.NewClass (.at F newpos) nil typeArgs t (List/nil) nil))))
              (cast JCTree$JCExpression (.toP this (.Erroneous (.at F newpos) (List/of t))))))))))

  (method innerCreator ^JCTree$JCExpression [this ^int newpos
                                             ^{:tag (List JCTree$JCExpression)} typeArgs
                                             ^JCTree$JCExpression encl]
    (let [^{:tag (List JCTree$JCAnnotation)} newAnnotations (.typeAnnotationsOpt this)
          ^:mutable t (cast JCTree$JCExpression
                            (.toP this (.Ident (.at F (.-pos token)) (.ident this))))]
      (when (.nonEmpty newAnnotations)
        (set! t
              (cast JCTree$JCExpression
                    (.toP this
                          (.AnnotatedType
                            (.at F (.-pos (cast JCTree$JCAnnotation (.-head newAnnotations))))
                            newAnnotations
                            t)))))
      (when (identical? (.-kind token) Tokens$TokenKind/LT)
        (let [prevmode mode] (set! t (.typeArguments this t true)) (.setMode this prevmode)))
      (.classCreatorRest this newpos encl typeArgs t)))

  (method arrayCreatorRest ^JCTree$JCExpression [this ^int newpos
                                                 ^:mutable ^JCTree$JCExpression elemtype]
    (let [^{:tag (List JCTree$JCAnnotation)} annos (.typeAnnotationsOpt this)]
      (.accept this Tokens$TokenKind/LBRACKET)
      (if (identical? (.-kind token) Tokens$TokenKind/RBRACKET)
          (do
            (.accept this Tokens$TokenKind/RBRACKET)
            (set! elemtype (.bracketsOpt this elemtype annos))
            (if (identical? (.-kind token) Tokens$TokenKind/LBRACE)
                (let [na (cast JCTree$JCNewArray (.arrayInitializer this newpos elemtype))]
                  (when (.nonEmpty annos)
                    (let [annotated (cast JCTree$JCAnnotatedType elemtype)]
                      (java-assert (identical? (.-annotations annotated) annos))
                      (set! (.-annotations na) (.-annotations annotated))
                      (set! (.-elemtype na) (.-underlyingType annotated))))
                  na)
                (let [t (cast JCTree$JCExpression
                              (.toP this (.NewArray (.at F newpos) elemtype (List/nil) nil)))]
                  (.syntaxError this
                                (.-pos token)
                                (List/of t)
                                CompilerProperties$Errors/ArrayDimensionMissing))))
          (let [^{:tag (ListBuffer JCTree$JCExpression)} dims (ListBuffer.)
                ^{:tag (ListBuffer (List JCTree$JCAnnotation))} dimAnnotations (ListBuffer.)]
            (.append dimAnnotations annos)
            (.append dims (.parseExpression this))
            (.accept this Tokens$TokenKind/RBRACKET)
            (while (or (identical? (.-kind token) Tokens$TokenKind/LBRACKET)
                       (identical? (.-kind token) Tokens$TokenKind/MONKEYS_AT))
              (let [^{:tag (List JCTree$JCAnnotation)} maybeDimAnnos (.typeAnnotationsOpt this)
                    pos (.-pos token)]
                (.nextToken this)
                (if (identical? (.-kind token) Tokens$TokenKind/RBRACKET)
                    (set! elemtype (.bracketsOptCont this elemtype pos maybeDimAnnos))
                    (do
                      (.append dimAnnotations maybeDimAnnos)
                      (.append dims (.parseExpression this))
                      (.accept this Tokens$TokenKind/RBRACKET)))))
            (let [^:mutable ^{:tag (List JCTree$JCExpression)} elems nil
                  errpos (.-pos token)]
              (when (identical? (.-kind token) Tokens$TokenKind/LBRACE)
                (set! elems (.arrayInitializerElements this newpos elemtype)))
              (let [na (cast JCTree$JCNewArray
                             (.toP this (.NewArray (.at F newpos) elemtype (.toList dims) elems)))]
                (set! (.-dimAnnotations na) (.toList dimAnnotations))
                (if (some? elems)
                    (.syntaxError
                      this
                      errpos
                      (List/of na)
                      CompilerProperties$Errors/IllegalArrayCreationBothDimensionAndInitialization)
                    na)))))))

  (method classCreatorRest ^JCTree$JCNewClass [this ^int newpos ^JCTree$JCExpression encl
                                               ^{:tag (List JCTree$JCExpression)} typeArgs
                                               ^JCTree$JCExpression t]
    (let [^{:tag (List JCTree$JCExpression)} args (.arguments this)
          ^:mutable ^JCTree$JCClassDecl body nil]
      (when (identical? (.-kind token) Tokens$TokenKind/LBRACE)
        (.ignoreDanglingComments this)
        (let [pos (.-pos token)
              ^{:tag (List JCTree)} defs (.classInterfaceOrRecordBody
                                           this
                                           (.-empty names)
                                           false
                                           false)
              mods (.Modifiers (.at F Position/NOPOS) 0)]
          (set! body
                (cast JCTree$JCClassDecl (.toP this (.AnonymousClassDef (.at F pos) mods defs))))))
      (cast JCTree$JCNewClass (.toP this (.NewClass (.at F newpos) encl typeArgs t args body)))))

  (method arrayInitializer ^JCTree$JCExpression [this ^int newpos ^JCTree$JCExpression t]
    (let [^{:tag (List JCTree$JCExpression)} elems (.arrayInitializerElements this newpos t)]
      (cast JCTree$JCExpression (.toP this (.NewArray (.at F newpos) t (List/nil) elems)))))

  (method arrayInitializerElements ^{:tag (List JCTree$JCExpression)} [this ^int newpos
                                                                       ^JCTree$JCExpression t]
    (.accept this Tokens$TokenKind/LBRACE)
    (let [^{:tag (ListBuffer JCTree$JCExpression)} elems (ListBuffer.)]
      (if (identical? (.-kind token) Tokens$TokenKind/COMMA)
          (.nextToken this)
          (when-not (identical? (.-kind token) Tokens$TokenKind/RBRACE)
            (.append elems (.variableInitializer this))
            (while (identical? (.-kind token) Tokens$TokenKind/COMMA)
              (.nextToken this)
              (when (identical? (.-kind token) Tokens$TokenKind/RBRACE) (break))
              (.append elems (.variableInitializer this)))))
      (.accept this Tokens$TokenKind/RBRACE)
      (.toList elems)))

  (method ^:public variableInitializer ^JCTree$JCExpression [this]
    (if (identical? (.-kind token) Tokens$TokenKind/LBRACE)
        (.arrayInitializer this (.-pos token) nil)
        (.parseExpression this)))

  (method parExpression ^JCTree$JCExpression [this]
    (let [pos (.-pos token)]
      (.accept this Tokens$TokenKind/LPAREN)
      (let [t (.parseExpression this)]
        (.accept this Tokens$TokenKind/RPAREN)
        (cast JCTree$JCExpression (.toP this (.Parens (.at F pos) t))))))

  (method block ^JCTree$JCBlock [this ^int pos ^long flags]
    (.accept this Tokens$TokenKind/LBRACE)
    (.ignoreDanglingComments this)
    (let [^{:tag (List JCTree$JCStatement)} stats (.blockStatements this)
          t (.Block (.at F pos) flags stats)]
      (while (or (identical? (.-kind token) Tokens$TokenKind/CASE)
                 (identical? (.-kind token) Tokens$TokenKind/DEFAULT))
        (.syntaxError this (.-pos token) (CompilerProperties$Errors/Orphaned (.-kind token)))
        (.switchBlockStatementGroups this))
      (set! (.-bracePos t) (.-pos token))
      (.accept this Tokens$TokenKind/RBRACE)
      (cast JCTree$JCBlock (.toP this t))))

  (method ^:public block ^JCTree$JCBlock [this]
    (.block this (.-pos token) 0))

  (method blockStatements ^{:tag (List JCTree$JCStatement)} [this]
    (let [^:mutable ^int lastErrPos -1
          ^{:tag (ListBuffer JCTree$JCStatement)} stats (ListBuffer.)]
      (while true
        (let [^{:tag (List JCTree$JCStatement)} stat (.blockStatement this)]
          (.ignoreDanglingComments this)
          (if (.isEmpty stat)
              (return (.toList stats))
              (do
                (when (== (.-pos token) lastErrPos) (return (.toList stats)))
                (when (<= (.-pos token) (.-errorEndPos endPosTable))
                  (.skip this false true true true)
                  (set! lastErrPos (.-pos token)))
                (.addAll stats stat)))))))

  (method parseStatementAsBlock ^JCTree$JCStatement [this]
    (let [pos (.-pos token)
          ^{:tag (List JCTree$JCStatement)} stats (.blockStatement this)]
      (if (.isEmpty stats)
          (let [e (.syntaxError this pos CompilerProperties$Errors/IllegalStartOfStmt)]
            (cast JCTree$JCStatement (.toP this (.Exec (.at F pos) e))))
          (let [first (cast JCTree$JCStatement (.-head stats))
                ^:mutable ^JCDiagnostic$Error error nil]
            (switch (.getTag first)
              CLASSDEF (set! error CompilerProperties$Errors/ClassNotAllowed)
              VARDEF (set! error CompilerProperties$Errors/VariableNotAllowed))
            (if (some? error)
                (do
                  (.error log JCDiagnostic$DiagnosticFlag/SYNTAX first error)
                  (let [^{:tag (List JCTree$JCBlock)} blist (List/of
                                                              (.Block (.at F (.-pos first)) 0 stats))]
                    (cast JCTree$JCStatement
                          (.toP this (.Exec (.at F pos) (.Erroneous (.at F (.-pos first)) blist))))))
                first)))))

  (method blockStatement ^{:tag (List JCTree$JCStatement)} [this]
    (let [^:mutable ^Tokens$Comment dc nil
          ^:mutable pos (.-pos token)]
      (switch (.-kind token)
        (RBRACE CASE DEFAULT EOF) (return (List/nil))
        (LBRACE IF
                FOR
                WHILE
                DO
                TRY
                SWITCH
                SYNCHRONIZED
                RETURN
                THROW
                BREAK
                CONTINUE
                SEMI
                ELSE
                FINALLY
                CATCH
                ASSERT)
          (return (List/of (.parseSimpleStatement this)))
        (MONKEYS_AT FINAL)
          (do
            (set! dc (.docComment token))
            (let [mods (.modifiersOpt this)]
              (if (.isDeclaration this)
                  (return (List/of (.classOrRecordOrInterfaceOrEnumDeclaration this mods dc)))
                  (let [t (.parseType this true)]
                    (return (.localVariableDeclarations this mods t dc))))))
        (ABSTRACT STRICTFP)
          (do
            (set! dc (.docComment token))
            (let [mods (.modifiersOpt this)]
              (return (List/of (.classOrRecordOrInterfaceOrEnumDeclaration this mods dc)))))
        (INTERFACE CLASS)
          (do
            (set! dc (.docComment token))
            (return (List/of (.classOrRecordOrInterfaceOrEnumDeclaration
                               this
                               (.modifiersOpt this)
                               dc))))
        ENUM
          (do
            (when-not allowRecords
              (.error log
                      JCDiagnostic$DiagnosticFlag/SYNTAX
                      (.-pos token)
                      CompilerProperties$Errors/LocalEnum))
            (set! dc (.docComment token))
            (return (List/of (.classOrRecordOrInterfaceOrEnumDeclaration
                               this
                               (.modifiersOpt this)
                               dc))))
        IDENTIFIER
          (arbace.core/cond (and (identical? (.name token) (.-yield names)) allowYieldStatement)
                            (let [next (.token S 1)
                                  ^:mutable ^boolean isYieldStatement false]
                              (switch (.-kind next)
                                (PLUS SUB
                                      STRINGLITERAL
                                      CHARLITERAL
                                      STRINGFRAGMENT
                                      INTLITERAL
                                      LONGLITERAL
                                      FLOATLITERAL
                                      DOUBLELITERAL
                                      NULL
                                      IDENTIFIER
                                      UNDERSCORE
                                      TRUE
                                      FALSE
                                      NEW
                                      SWITCH
                                      THIS
                                      SUPER
                                      BYTE
                                      CHAR
                                      SHORT
                                      INT
                                      LONG
                                      FLOAT
                                      DOUBLE
                                      VOID
                                      BOOLEAN)
                                  (set! isYieldStatement true)
                                (PLUSPLUS SUBSUB)
                                  (set! isYieldStatement
                                        (not (identical?
                                               (.-kind (.token S 2))
                                               Tokens$TokenKind/SEMI)))
                                (BANG TILDE)
                                  (set! isYieldStatement
                                        (not (identical?
                                               (.-kind (.token S 1))
                                               Tokens$TokenKind/SEMI)))
                                LPAREN
                                  (let [^:mutable ^int lookahead 2
                                        ^:mutable ^int balance 1
                                        ^:mutable hasComma false
                                        ^:mutable inTypeArgs false
                                        ^:mutable ^Tokens$Token l nil]
                                    (while (and (not
                                                  (identical?
                                                    (.-kind (set! l (.token S lookahead)))
                                                    Tokens$TokenKind/EOF))
                                                (not (== balance 0)))
                                      (switch (.-kind l)
                                        LPAREN (set! balance (unchecked-inc-int balance))
                                        RPAREN (set! balance (unchecked-dec-int balance))
                                        COMMA
                                          (when (and (== balance 1) (not inTypeArgs))
                                            (set! hasComma true))
                                        LT (set! inTypeArgs true)
                                        GT (set! inTypeArgs false))
                                      (set! lookahead (unchecked-inc-int lookahead)))
                                    (set! isYieldStatement
                                          (or (and (not hasComma) (not (== lookahead 3)))
                                              (identical? (.-kind l) Tokens$TokenKind/ARROW))))
                                SEMI (set! isYieldStatement true)
                                (set! isYieldStatement false))
                              (when isYieldStatement
                                (.nextToken this)
                                (let [t (.term this EXPR)]
                                  (.accept this Tokens$TokenKind/SEMI)
                                  (return (List/of
                                            (cast
                                              JCTree$JCStatement
                                              (.toP this (.Yield (.at F pos) t))))))))
                            (.isNonSealedClassStart this true)
                            (do
                              (.error
                                log
                                (.-pos token)
                                CompilerProperties$Errors/SealedOrNonSealedLocalClassesNotAllowed)
                              (.nextToken this)
                              (.nextToken this)
                              (.nextToken this)
                              (return (List/of (.classOrRecordOrInterfaceOrEnumDeclaration
                                                 this
                                                 (.modifiersOpt this)
                                                 (.docComment token)))))
                            :else
                            (when (.isSealedClassStart this true)
                              (.checkSourceLevel this Source$Feature/SEALED_CLASSES)
                              (.error
                                log
                                (.-pos token)
                                CompilerProperties$Errors/SealedOrNonSealedLocalClassesNotAllowed)
                              (.nextToken this)
                              (return (List/of (.classOrRecordOrInterfaceOrEnumDeclaration
                                                 this
                                                 (.modifiersOpt this)
                                                 (.docComment token)))))))
      (set! dc (.docComment token))
      (if (and (.isRecordStart this) allowRecords)
          (List/of (.recordDeclaration this (.Modifiers (.at F pos) 0) dc))
          (let [prevToken token
                ^:mutable t (.term this (bit-or-int EXPR TYPE))]
            (arbace.core/cond
              (and (identical? (.-kind token) Tokens$TokenKind/COLON) (.hasTag t JCTree$Tag/IDENT))
              (do
                (.nextToken this)
                (let [stat (.parseStatementAsBlock this)]
                  (List/of (.Labelled (.at F pos) (.name prevToken) stat))))
              (and (.wasTypeMode this) (.test LAX_IDENTIFIER (.-kind token)))
              (do
                (set! pos (.-pos token))
                (let [mods (.Modifiers (.at F Position/NOPOS) 0)]
                  (.at F pos)
                  (.localVariableDeclarations this mods t dc)))
              :else
              (do
                (set! t (.checkExprStat this t))
                (.accept this Tokens$TokenKind/SEMI)
                (let [expr (cast JCTree$JCExpressionStatement (.toP this (.Exec (.at F pos) t)))]
                  (List/of expr))))))))

  (method ^:private localVariableDeclarations ^{:tag (List JCTree$JCStatement)} [this
                                                                                 ^JCTree$JCModifiers mods
                                                                                 ^JCTree$JCExpression type
                                                                                 ^Tokens$Comment dc]
    (when (some? dc) (.saveDanglingDocComments this dc))
    (let [^{:tag (ListBuffer JCTree$JCStatement)} stats (.variableDeclarators
                                                          this
                                                          mods
                                                          type
                                                          (ListBuffer.)
                                                          true)]
      (.accept this Tokens$TokenKind/SEMI)
      (.storeEnd this (cast JCTree$JCStatement (.last stats)) (.-endPos (.prevToken S)))
      (.toList stats)))

  (method ^:public parseSimpleStatement ^JCTree$JCStatement [this]
    (.ignoreDanglingComments this)
    (let [pos (.-pos token)]
      (switch (.-kind token)
        LBRACE (.block this)
        IF
          (do
            (.nextToken this)
            (let [cond (.parExpression this)
                  thenpart (.parseStatementAsBlock this)
                  ^:mutable ^JCTree$JCStatement elsepart nil]
              (when (identical? (.-kind token) Tokens$TokenKind/ELSE)
                (.nextToken this)
                (set! elsepart (.parseStatementAsBlock this)))
              (.If (.at F pos) cond thenpart elsepart)))
        FOR
          (do
            (.nextToken this)
            (.accept this Tokens$TokenKind/LPAREN)
            (let [^{:tag (List JCTree$JCStatement)} inits (if (identical?
                                                                (.-kind token)
                                                                Tokens$TokenKind/SEMI)
                                                              (List/nil)
                                                              (.forInit this))]
              (if (and (and (and (== (.length inits) 1)
                                 (.hasTag (cast JCTree$JCStatement (.-head inits))
                                          JCTree$Tag/VARDEF))
                            (nil? (.-init (cast JCTree$JCVariableDecl (.-head inits)))))
                       (identical? (.-kind token) Tokens$TokenKind/COLON))
                  (let [var (cast JCTree$JCVariableDecl (.-head inits))]
                    (.accept this Tokens$TokenKind/COLON)
                    (let [expr (.parseExpression this)]
                      (.accept this Tokens$TokenKind/RPAREN)
                      (let [body (.parseStatementAsBlock this)]
                        (.ForeachLoop (.at F pos) var expr body))))
                  (do
                    (.accept this Tokens$TokenKind/SEMI)
                    (let [^JCTree$JCExpression cond (when-not (identical?
                                                                (.-kind token)
                                                                Tokens$TokenKind/SEMI)
                                                      (.parseExpression this))]
                      (.accept this Tokens$TokenKind/SEMI)
                      (let [^{:tag (List JCTree$JCExpressionStatement)} steps (if (identical?
                                                                                    (.-kind token)
                                                                                    Tokens$TokenKind/RPAREN)
                                                                                  (List/nil)
                                                                                  (.forUpdate this))]
                        (.accept this Tokens$TokenKind/RPAREN)
                        (let [body (.parseStatementAsBlock this)]
                          (.ForLoop (.at F pos) inits cond steps body))))))))
        WHILE
          (do
            (.nextToken this)
            (let [cond (.parExpression this)
                  body (.parseStatementAsBlock this)]
              (.WhileLoop (.at F pos) cond body)))
        DO
          (do
            (.nextToken this)
            (let [body (.parseStatementAsBlock this)]
              (.accept this Tokens$TokenKind/WHILE)
              (let [cond (.parExpression this)]
                (.accept this Tokens$TokenKind/SEMI)
                (let [t (cast JCTree$JCDoWhileLoop (.toP this (.DoLoop (.at F pos) body cond)))] t))))
        TRY
          (do
            (.nextToken this)
            (let [^:mutable ^{:tag (List JCTree)} resources (List/nil)]
              (when (identical? (.-kind token) Tokens$TokenKind/LPAREN)
                (.nextToken this)
                (set! resources (.resources this))
                (.accept this Tokens$TokenKind/RPAREN))
              (let [body (.block this)
                    ^{:tag (ListBuffer JCTree$JCCatch)} catchers (ListBuffer.)
                    ^:mutable ^JCTree$JCBlock finalizer nil]
                (arbace.core/cond
                  (or (identical? (.-kind token) Tokens$TokenKind/CATCH)
                      (identical? (.-kind token) Tokens$TokenKind/FINALLY))
                  (do
                    (while (identical? (.-kind token) Tokens$TokenKind/CATCH)
                      (.append catchers (.catchClause this)))
                    (when (identical? (.-kind token) Tokens$TokenKind/FINALLY)
                      (.nextToken this)
                      (set! finalizer (.block this))))
                  (.isEmpty resources)
                  (.error log
                          JCDiagnostic$DiagnosticFlag/SYNTAX
                          pos
                          CompilerProperties$Errors/TryWithoutCatchFinallyOrResourceDecls))
                (.Try (.at F pos) resources body (.toList catchers) finalizer))))
        SWITCH
          (do
            (.nextToken this)
            (let [selector (.parExpression this)]
              (.accept this Tokens$TokenKind/LBRACE)
              (let [^{:tag (List JCTree$JCCase)} cases (.switchBlockStatementGroups this)
                    t (cast JCTree$JCSwitch (.to this (.Switch (.at F pos) selector cases)))]
                (set! (.-bracePos t) (.-endPos token))
                (.accept this Tokens$TokenKind/RBRACE)
                t)))
        SYNCHRONIZED
          (do
            (.nextToken this)
            (let [lock (.parExpression this)
                  body (.block this)]
              (.Synchronized (.at F pos) lock body)))
        RETURN
          (do
            (.nextToken this)
            (let [^JCTree$JCExpression result (when-not (identical?
                                                          (.-kind token)
                                                          Tokens$TokenKind/SEMI)
                                                (.parseExpression this))]
              (.accept this Tokens$TokenKind/SEMI)
              (let [t (cast JCTree$JCReturn (.toP this (.Return (.at F pos) result)))] t)))
        THROW
          (do
            (.nextToken this)
            (let [exc (.parseExpression this)]
              (.accept this Tokens$TokenKind/SEMI)
              (let [t (cast JCTree$JCThrow (.toP this (.Throw (.at F pos) exc)))] t)))
        BREAK
          (do
            (.nextToken this)
            (let [^Name label (when (.test LAX_IDENTIFIER (.-kind token)) (.ident this))]
              (.accept this Tokens$TokenKind/SEMI)
              (let [t (cast JCTree$JCBreak (.toP this (.Break (.at F pos) label)))] t)))
        CONTINUE
          (do
            (.nextToken this)
            (let [^Name label (when (.test LAX_IDENTIFIER (.-kind token)) (.ident this))]
              (.accept this Tokens$TokenKind/SEMI)
              (let [t (cast JCTree$JCContinue (.toP this (.Continue (.at F pos) label)))] t)))
        SEMI (do (.nextToken this) (cast JCTree$JCStatement (.toP this (.Skip (.at F pos)))))
        ELSE
          (let [elsePos (.-pos token)]
            (.nextToken this)
            (.doRecover this
                        elsePos
                        BasicErrorRecoveryAction/BLOCK_STMT
                        CompilerProperties$Errors/ElseWithoutIf))
        FINALLY
          (let [finallyPos (.-pos token)]
            (.nextToken this)
            (.doRecover this
                        finallyPos
                        BasicErrorRecoveryAction/BLOCK_STMT
                        CompilerProperties$Errors/FinallyWithoutTry))
        CATCH
          (.doRecover this
                      (.-pos token)
                      BasicErrorRecoveryAction/CATCH_CLAUSE
                      CompilerProperties$Errors/CatchWithoutTry)
        ASSERT
          (do
            (.nextToken this)
            (let [assertion (.parseExpression this)
                  ^:mutable ^JCTree$JCExpression message nil]
              (when (identical? (.-kind token) Tokens$TokenKind/COLON)
                (.nextToken this)
                (set! message (.parseExpression this)))
              (.accept this Tokens$TokenKind/SEMI)
              (let [t (cast JCTree$JCAssert (.toP this (.Assert (.at F pos) assertion message)))] t)))
        (do (Assert/error) nil))))

  (method ^:public parseStatement ^JCTree$JCStatement [this]
    (.parseStatementAsBlock this))

  (method ^:private doRecover ^JCTree$JCStatement [this ^int startPos ^ErrorRecoveryAction action
                                                   ^JCDiagnostic$Error errorKey]
    (let [errPos (.errPos S)
          stm (.doRecover action this)]
      (.errPos S errPos)
      (cast JCTree$JCStatement
            (.toP this (.Exec F (.syntaxError this startPos (List/of stm) errorKey))))))

  (method ^:protected catchClause ^JCTree$JCCatch [this]
    (let [pos (.-pos token)]
      (.accept this Tokens$TokenKind/CATCH)
      (.accept this Tokens$TokenKind/LPAREN)
      (let [mods (.optFinal this Flags/PARAMETER)
            ^{:tag (List JCTree$JCExpression)} catchTypes (.catchTypes this)
            ^JCTree$JCExpression paramType (if (> (.size catchTypes) 1)
                                               (cast
                                                 JCTree$JCExpression
                                                 (.toP
                                                   this
                                                   (.TypeUnion
                                                     (.at
                                                       F
                                                       (.getStartPosition
                                                         (cast
                                                           JCTree$JCExpression
                                                           (.-head catchTypes))))
                                                     catchTypes)))
                                               (cast JCTree$JCExpression (.-head catchTypes)))
            formal (.variableDeclaratorId this mods paramType true false false)]
        (.accept this Tokens$TokenKind/RPAREN)
        (let [body (.block this)] (.Catch (.at F pos) formal body)))))

  (method catchTypes ^{:tag (List JCTree$JCExpression)} [this]
    (let [^{:tag (ListBuffer JCTree$JCExpression)} catchTypes (ListBuffer.)]
      (.add catchTypes (.parseType this))
      (while (identical? (.-kind token) Tokens$TokenKind/BAR)
        (.nextToken this)
        (.add catchTypes (.parseType this)))
      (.toList catchTypes)))

  (method switchBlockStatementGroups ^{:tag (List JCTree$JCCase)} [this]
    (let [^{:tag (ListBuffer JCTree$JCCase)} cases (ListBuffer.)]
      (while true
        (let [pos (.-pos token)]
          (switch (.-kind token)
            (CASE DEFAULT) (.appendList cases (.switchBlockStatementGroup this))
            (RBRACE EOF) (return (.toList cases))
            (do
              (.nextToken this)
              (.syntaxError this
                            pos
                            (CompilerProperties$Errors/Expected3
                              Tokens$TokenKind/CASE
                              Tokens$TokenKind/DEFAULT
                              Tokens$TokenKind/RBRACE))))))))

  (method ^:protected switchBlockStatementGroup ^{:tag (List JCTree$JCCase)} [this]
    (let [pos (.-pos token)
          ^:mutable ^{:tag (List JCTree$JCStatement)} stats nil
          ^:mutable ^JCTree$JCCase c nil
          ^{:tag (ListBuffer JCTree$JCCase)} cases (ListBuffer.)]
      (switch (.-kind token)
        CASE
          (do
            (.nextToken this)
            (let [^{:tag (ListBuffer JCTree$JCCaseLabel)} pats (ListBuffer.)
                  ^:mutable allowDefault false]
              (while true
                (let [label (.parseCaseLabel this allowDefault)]
                  (.append pats label)
                  (when-not (identical? (.-kind token) Tokens$TokenKind/COMMA) (break))
                  (.nextToken this)
                  (.checkSourceLevel this Source$Feature/SWITCH_MULTIPLE_CASE_LABELS)
                  (set! allowDefault (TreeInfo/isNullCaseLabel label))))
              (let [guard (.parseGuard this (cast JCTree$JCCaseLabel (.last pats)))
                    ^:mutable ^CaseTree$CaseKind caseKind nil
                    ^:mutable ^JCTree body nil]
                (if (identical? (.-kind token) Tokens$TokenKind/ARROW)
                    (do
                      (.checkSourceLevel this Source$Feature/SWITCH_RULE)
                      (.accept this Tokens$TokenKind/ARROW)
                      (set! caseKind JCTree$JCCase/RULE)
                      (let [statement (.parseStatementAsBlock this)]
                        (when (and (and (not (.hasTag statement JCTree$Tag/EXEC))
                                        (not (.hasTag statement JCTree$Tag/BLOCK)))
                                   (not (.hasTag statement JCTree$Tag/THROW)))
                          (.error log
                                  (.pos statement)
                                  CompilerProperties$Errors/SwitchCaseUnexpectedStatement))
                        (set! stats (List/of statement))
                        (set! body (cast JCTree (.-head stats)))))
                    (do
                      (.accept this
                               Tokens$TokenKind/COLON
                               (lambda Function ^JCDiagnostic$Error [^Tokens$TokenKind tk]
                                 (CompilerProperties$Errors/Expected2
                                   Tokens$TokenKind/COLON
                                   Tokens$TokenKind/ARROW)))
                      (set! caseKind JCTree$JCCase/STATEMENT)
                      (set! stats (.blockStatements this))))
                (set! c (.Case (.at F pos) caseKind (.toList pats) guard stats body))
                (when (.isEmpty stats) (.storeEnd this c (.-endPos (.prevToken S))))
                (return (.toList (.append cases c))))))
        DEFAULT
          (do
            (.nextToken this)
            (let [defaultPattern (cast JCTree$JCCaseLabel
                                       (.toP this (.DefaultCaseLabel (.at F pos))))
                  guard (.parseGuard this defaultPattern)
                  ^:mutable ^CaseTree$CaseKind caseKind nil
                  ^:mutable ^JCTree body nil]
              (if (identical? (.-kind token) Tokens$TokenKind/ARROW)
                  (do
                    (.checkSourceLevel this Source$Feature/SWITCH_RULE)
                    (.accept this Tokens$TokenKind/ARROW)
                    (set! caseKind JCTree$JCCase/RULE)
                    (let [statement (.parseStatementAsBlock this)]
                      (when (and (and (not (.hasTag statement JCTree$Tag/EXEC))
                                      (not (.hasTag statement JCTree$Tag/BLOCK)))
                                 (not (.hasTag statement JCTree$Tag/THROW)))
                        (.error log
                                (.pos statement)
                                CompilerProperties$Errors/SwitchCaseUnexpectedStatement))
                      (set! stats (List/of statement))
                      (set! body (cast JCTree (.-head stats)))))
                  (do
                    (.accept this
                             Tokens$TokenKind/COLON
                             (lambda Function ^JCDiagnostic$Error [^Tokens$TokenKind tk]
                               (CompilerProperties$Errors/Expected2
                                 Tokens$TokenKind/COLON
                                 Tokens$TokenKind/ARROW)))
                    (set! caseKind JCTree$JCCase/STATEMENT)
                    (set! stats (.blockStatements this))))
              (set! c (.Case (.at F pos) caseKind (List/of defaultPattern) guard stats body))
              (when (.isEmpty stats) (.storeEnd this c (.-endPos (.prevToken S))))
              (return (.toList (.append cases c))))))
      (throw (AssertionError. "should not reach here"))))

  (method ^:private parseCaseLabel ^JCTree$JCCaseLabel [this ^boolean allowDefault]
    (let [patternPos (.-pos token)
          ^:mutable ^JCTree$JCCaseLabel label nil]
      (if (identical? (.-kind token) Tokens$TokenKind/DEFAULT)
          (do
            (.checkSourceLevel this (.-pos token) Source$Feature/PATTERN_SWITCH)
            (when-not allowDefault
              (.reportSyntaxError this
                                  (JCDiagnostic$SimpleDiagnosticPosition. (.-pos token))
                                  CompilerProperties$Errors/DefaultLabelNotAllowed))
            (.nextToken this)
            (set! label
                  (cast JCTree$JCCaseLabel (.toP this (.DefaultCaseLabel (.at F patternPos)))))
            label)
          (let [mods (.optFinal this 0)
                pattern (or (or (not (== (.-flags mods) 0)) (.nonEmpty (.-annotations mods)))
                            (identical? (.analyzePattern this 0) PatternResult/PATTERN))]
            (if pattern
                (do
                  (.checkSourceLevel this (.-pos token) Source$Feature/PATTERN_SWITCH)
                  (let [p (.parsePattern this patternPos mods nil false true)]
                    (cast JCTree$JCCaseLabel (.toP this (.PatternCaseLabel (.at F patternPos) p)))))
                (let [expr (.term this (bit-or-int EXPR NOLAMBDA))]
                  (cast JCTree$JCCaseLabel (.toP this (.ConstantCaseLabel (.at F patternPos) expr)))))))))

  (method ^:private parseGuard ^JCTree$JCExpression [this ^JCTree$JCCaseLabel label]
    (let [^:mutable ^JCTree$JCExpression guard nil]
      (when (and (identical? (.-kind token) Tokens$TokenKind/IDENTIFIER)
                 (identical? (.name token) (.-when names)))
        (let [pos (.-pos token)]
          (.nextToken this)
          (set! guard (.term this (bit-or-int EXPR NOLAMBDA)))
          (when-not (instance? JCTree$JCPatternCaseLabel label)
            (set! guard
                  (.syntaxError this pos (List/of guard) CompilerProperties$Errors/GuardNotAllowed)))))
      guard))

  (method analyzePattern ^PatternResult [this ^:mutable ^int lookahead]
    (let [^:mutable ^int typeDepth 0
          ^:mutable ^int parenDepth 0
          ^:mutable pendingResult PatternResult/EXPRESSION]
      (while true
        (let [token (.-kind (.token S lookahead))]
          (switch token
            (BYTE SHORT INT LONG FLOAT DOUBLE BOOLEAN CHAR VOID ASSERT ENUM IDENTIFIER)
              (arbace.core/cond (and (== typeDepth 0) (.peekToken this lookahead LAX_IDENTIFIER))
                                (if (== parenDepth 0)
                                    (return PatternResult/PATTERN)
                                    (set! pendingResult PatternResult/PATTERN))
                                (and (and (== typeDepth 0) (== parenDepth 0))
                                     (.peekToken
                                       this
                                       lookahead
                                       (lambda Predicate ^boolean [^Tokens$TokenKind tk]
                                         (or (identical? tk Tokens$TokenKind/ARROW)
                                             (identical? tk Tokens$TokenKind/COMMA)))))
                                (return PatternResult/EXPRESSION))
            UNDERSCORE
              (arbace.core/cond
                (and (== typeDepth 0)
                     (.peekToken this
                                 lookahead
                                 (lambda Predicate ^boolean [^Tokens$TokenKind tk]
                                   (or (identical? tk Tokens$TokenKind/RPAREN)
                                       (identical? tk Tokens$TokenKind/COMMA)))))
                (return PatternResult/PATTERN)
                (and (== typeDepth 0) (.peekToken this lookahead LAX_IDENTIFIER))
                (if (== parenDepth 0)
                    (return PatternResult/PATTERN)
                    (set! pendingResult PatternResult/PATTERN)))
            (DOT QUES EXTENDS SUPER COMMA) nil
            LT (set! typeDepth (unchecked-inc-int typeDepth))
            GTGTGT
              (do
                (set! typeDepth (unchecked-dec-int typeDepth))
                (set! typeDepth (unchecked-dec-int typeDepth))
                (set! typeDepth (unchecked-dec-int typeDepth))
                (arbace.core/cond
                  (and (== typeDepth 0) (not (.peekToken this lookahead Tokens$TokenKind/DOT)))
                  (return (if (or (.peekToken this lookahead LAX_IDENTIFIER)
                                  (.peekToken this
                                              lookahead
                                              (lambda Predicate ^boolean [^Tokens$TokenKind tk]
                                                (identical? tk Tokens$TokenKind/LPAREN))))
                              PatternResult/PATTERN
                              PatternResult/EXPRESSION))
                  (< typeDepth 0)
                  (return PatternResult/EXPRESSION)))
            GTGT
              (do
                (set! typeDepth (unchecked-dec-int typeDepth))
                (set! typeDepth (unchecked-dec-int typeDepth))
                (arbace.core/cond
                  (and (== typeDepth 0) (not (.peekToken this lookahead Tokens$TokenKind/DOT)))
                  (return (if (or (.peekToken this lookahead LAX_IDENTIFIER)
                                  (.peekToken this
                                              lookahead
                                              (lambda Predicate ^boolean [^Tokens$TokenKind tk]
                                                (identical? tk Tokens$TokenKind/LPAREN))))
                              PatternResult/PATTERN
                              PatternResult/EXPRESSION))
                  (< typeDepth 0)
                  (return PatternResult/EXPRESSION)))
            GT
              (do
                (set! typeDepth (unchecked-dec-int typeDepth))
                (arbace.core/cond
                  (and (== typeDepth 0) (not (.peekToken this lookahead Tokens$TokenKind/DOT)))
                  (return (if (or (.peekToken this lookahead LAX_IDENTIFIER)
                                  (.peekToken this
                                              lookahead
                                              (lambda Predicate ^boolean [^Tokens$TokenKind tk]
                                                (identical? tk Tokens$TokenKind/LPAREN))))
                              PatternResult/PATTERN
                              PatternResult/EXPRESSION))
                  (< typeDepth 0)
                  (return PatternResult/EXPRESSION)))
            MONKEYS_AT (set! lookahead (.skipAnnotation this lookahead))
            LBRACKET
              (arbace.core/cond (.peekToken this lookahead Tokens$TokenKind/RBRACKET LAX_IDENTIFIER)
                                (return PatternResult/PATTERN)
                                (.peekToken this lookahead Tokens$TokenKind/RBRACKET)
                                (set! lookahead (unchecked-inc-int lookahead))
                                :else
                                (return pendingResult))
            LPAREN
              (do
                (when (identical? (.-kind (.token S (unchecked-add-int lookahead 1)))
                                  Tokens$TokenKind/RPAREN)
                  (return (if (and (not (== parenDepth 0))
                                   (identical? (.-kind (.token S (unchecked-add-int lookahead 2)))
                                               Tokens$TokenKind/ARROW))
                              PatternResult/EXPRESSION
                              PatternResult/PATTERN)))
                (set! parenDepth (unchecked-inc-int parenDepth)))
            RPAREN
              (do
                (set! parenDepth (unchecked-dec-int parenDepth))
                (when (and (and (and (== parenDepth 0) (== typeDepth 0))
                                (.peekToken this lookahead Tokens$TokenKind/IDENTIFIER))
                           (identical? (.name (.token S (unchecked-add-int lookahead 1)))
                                       (.-when names)))
                  (return PatternResult/PATTERN)))
            ARROW (return (if (> parenDepth 0) PatternResult/EXPRESSION pendingResult))
            FINAL (do (when (> parenDepth 0) (return PatternResult/PATTERN)) (return pendingResult))
            (return pendingResult))
          (set! lookahead (unchecked-inc-int lookahead))))))

  (defclass ^:private ^:enum PatternResult
    (constants EXPRESSION PATTERN))

  (method moreStatementExpressions :type-params [(T
                                                   extends
                                                   (ListBuffer
                                                     (? super JCTree$JCExpressionStatement)))] ^T [this
                                                                                                   ^:mutable ^int pos
                                                                                                   ^JCTree$JCExpression first
                                                                                                   ^T stats]
    (.append stats (.toP this (.Exec (.at F pos) (.checkExprStat this first))))
    (while (identical? (.-kind token) Tokens$TokenKind/COMMA)
      (.nextToken this)
      (set! pos (.-pos token))
      (let [t (.parseExpression this)]
        (.append stats (.toP this (.Exec (.at F pos) (.checkExprStat this t))))))
    stats)

  (method forInit ^{:tag (List JCTree$JCStatement)} [this]
    (let [^{:tag (ListBuffer JCTree$JCStatement)} stats (ListBuffer.)
          pos (.-pos token)]
      (if (or (identical? (.-kind token) Tokens$TokenKind/FINAL)
              (identical? (.-kind token) Tokens$TokenKind/MONKEYS_AT))
          (.toList (.variableDeclarators this (.optFinal this 0) (.parseType this true) stats true))
          (let [t (.term this (bit-or-int EXPR TYPE))]
            (arbace.core/cond (and (.wasTypeMode this) (.test LAX_IDENTIFIER (.-kind token)))
                              (.toList
                                (.variableDeclarators this (.modifiersOpt this) t stats true))
                              (and (.wasTypeMode this)
                                   (identical? (.-kind token) Tokens$TokenKind/COLON))
                              (do
                                (.error log
                                        JCDiagnostic$DiagnosticFlag/SYNTAX
                                        pos
                                        (CompilerProperties$Errors/BadInitializer "for-loop"))
                                (List/of ^JCTree$JCStatement (.VarDef
                                                               (.at F pos)
                                                               (.modifiersOpt this)
                                                               (.-error names)
                                                               t
                                                               nil)))
                              :else
                              (.toList (.moreStatementExpressions this pos t stats)))))))

  (method forUpdate ^{:tag (List JCTree$JCExpressionStatement)} [this]
    (.toList (.moreStatementExpressions this (.-pos token) (.parseExpression this) (ListBuffer.))))

  (method ^:protected annotationsOpt ^{:tag (List JCTree$JCAnnotation)} [this ^JCTree$Tag kind]
    (if (not (identical? (.-kind token) Tokens$TokenKind/MONKEYS_AT))
        (List/nil)
        (let [^{:tag (ListBuffer JCTree$JCAnnotation)} buf (ListBuffer.)
              prevmode mode]
          (while (identical? (.-kind token) Tokens$TokenKind/MONKEYS_AT)
            (let [pos (.-pos token)] (.nextToken this) (.append buf (.annotation this pos kind))))
          (.setLastMode this mode)
          (.setMode this prevmode)
          (let [^{:tag (List JCTree$JCAnnotation)} annotations (.toList buf)] annotations))))

  (method typeAnnotationsOpt ^{:tag (List JCTree$JCAnnotation)} [this]
    (let [^{:tag (List JCTree$JCAnnotation)} annotations (.annotationsOpt
                                                           this
                                                           JCTree$Tag/TYPE_ANNOTATION)]
      annotations))

  (method ^:protected modifiersOpt ^JCTree$JCModifiers [this]
    (.modifiersOpt this nil))

  (method ^:protected modifiersOpt ^JCTree$JCModifiers [this ^JCTree$JCModifiers partial]
    (let [^:mutable ^long flags 0
          ^{:tag (ListBuffer JCTree$JCAnnotation)} annotations (ListBuffer.)
          ^:mutable ^int pos 0]
      (if (nil? partial)
          (do (set! flags 0) (set! pos (.-pos token)))
          (do
            (set! flags (.-flags partial))
            (.appendList annotations (.-annotations partial))
            (set! pos (.-pos partial))))
      (when (.deprecatedFlag token) (set! flags (bit-or flags Flags/DEPRECATED)))
      (let [^:mutable ^int lastPos 0]
        (while true
          (let [^:mutable ^long flag 0]
            (switch (.-kind token)
              PRIVATE (set! flag Flags/PRIVATE)
              PROTECTED (set! flag Flags/PROTECTED)
              PUBLIC (set! flag Flags/PUBLIC)
              STATIC (set! flag Flags/STATIC)
              TRANSIENT (set! flag Flags/TRANSIENT)
              FINAL (set! flag Flags/FINAL)
              ABSTRACT (set! flag Flags/ABSTRACT)
              NATIVE (set! flag Flags/NATIVE)
              VOLATILE (set! flag Flags/VOLATILE)
              SYNCHRONIZED (set! flag Flags/SYNCHRONIZED)
              STRICTFP (set! flag Flags/STRICTFP)
              MONKEYS_AT (set! flag Flags/ANNOTATION)
              DEFAULT (set! flag Flags/DEFAULT)
              ERROR (do (set! flag 0) (.nextToken this))
              IDENTIFIER
                (arbace.core/cond (.isNonSealedClassStart this false)
                                  (do
                                    (set! flag Flags/NON_SEALED)
                                    (.nextToken this)
                                    (.nextToken this))
                                  (.isSealedClassStart this false)
                                  (do
                                    (.checkSourceLevel this Source$Feature/SEALED_CLASSES)
                                    (set! flag Flags/SEALED))
                                  :else
                                  (break))
              (break))
            (when-not (== (bit-and flags flag) 0)
              (.error log
                      JCDiagnostic$DiagnosticFlag/SYNTAX
                      (.-pos token)
                      CompilerProperties$Errors/RepeatedModifier))
            (set! lastPos (.-pos token))
            (.nextToken this)
            (when (== flag Flags/ANNOTATION)
              (when-not (identical? (.-kind token) Tokens$TokenKind/INTERFACE)
                (let [ann (.annotation this lastPos JCTree$Tag/ANNOTATION)]
                  (when (and (== flags 0) (.isEmpty annotations)) (set! pos (.-pos ann)))
                  (.append annotations ann)
                  (set! flag 0))))
            (set! flags (bit-or flags flag))))
        (switch (.-kind token)
          ENUM (set! flags (bit-or flags Flags/ENUM))
          INTERFACE (set! flags (bit-or flags Flags/INTERFACE))
          nil)
        (when (and (== (bit-and flags (bit-or Flags/ModifierFlags Flags/ANNOTATION)) 0)
                   (.isEmpty annotations))
          (set! pos Position/NOPOS))
        (let [mods (.Modifiers (.at F pos) flags (.toList annotations))]
          (when-not (== pos Position/NOPOS) (.storeEnd this mods (.-endPos (.prevToken S))))
          mods))))

  (method annotation ^JCTree$JCAnnotation [this ^int pos ^JCTree$Tag kind]
    (let [^JCTree ident (.qualident this false)
          ^{:tag (List JCTree$JCExpression)} fieldValues (.annotationFieldValuesOpt this)
          ^:mutable ^JCTree$JCAnnotation ann nil]
      (arbace.core/cond (identical? kind JCTree$Tag/ANNOTATION)
                        (set! ann (.Annotation (.at F pos) ident fieldValues))
                        (identical? kind JCTree$Tag/TYPE_ANNOTATION)
                        (set! ann (.TypeAnnotation (.at F pos) ident fieldValues))
                        :else
                        (throw (AssertionError. (java-str "Unhandled annotation kind: " kind))))
      (cast JCTree$JCAnnotation (.toP this ann))))

  (method annotationFieldValuesOpt ^{:tag (List JCTree$JCExpression)} [this]
    (if (identical? (.-kind token) Tokens$TokenKind/LPAREN)
        (.annotationFieldValues this)
        (List/nil)))

  (method annotationFieldValues ^{:tag (List JCTree$JCExpression)} [this]
    (.accept this Tokens$TokenKind/LPAREN)
    (let [^{:tag (ListBuffer JCTree$JCExpression)} buf (ListBuffer.)]
      (when-not (identical? (.-kind token) Tokens$TokenKind/RPAREN)
        (.append buf (.annotationFieldValue this))
        (while (identical? (.-kind token) Tokens$TokenKind/COMMA)
          (.nextToken this)
          (.append buf (.annotationFieldValue this))))
      (.accept this Tokens$TokenKind/RPAREN)
      (.toList buf)))

  (method annotationFieldValue ^JCTree$JCExpression [this]
    (if (.test LAX_IDENTIFIER (.-kind token))
        (do
          (.selectExprMode this)
          (let [t1 (.term1 this)]
            (if (and (.hasTag t1 JCTree$Tag/IDENT) (identical? (.-kind token) Tokens$TokenKind/EQ))
                (let [pos (.-pos token)]
                  (.accept this Tokens$TokenKind/EQ)
                  (let [v (.annotationValue this)]
                    (cast JCTree$JCExpression (.toP this (.Assign (.at F pos) t1 v)))))
                t1)))
        (.annotationValue this)))

  (method annotationValue ^JCTree$JCExpression [this]
    (let [^:mutable ^int pos 0]
      (switch (.-kind token)
        MONKEYS_AT
          (do
            (set! pos (.-pos token))
            (.nextToken this)
            (.annotation this pos JCTree$Tag/ANNOTATION))
        LBRACE
          (do
            (set! pos (.-pos token))
            (.accept this Tokens$TokenKind/LBRACE)
            (let [^{:tag (ListBuffer JCTree$JCExpression)} buf (ListBuffer.)]
              (if (identical? (.-kind token) Tokens$TokenKind/COMMA)
                  (.nextToken this)
                  (when-not (identical? (.-kind token) Tokens$TokenKind/RBRACE)
                    (.append buf (.annotationValue this))
                    (while (identical? (.-kind token) Tokens$TokenKind/COMMA)
                      (.nextToken this)
                      (when (identical? (.-kind token) Tokens$TokenKind/RBRACE) (break))
                      (.append buf (.annotationValue this)))))
              (.accept this
                       Tokens$TokenKind/RBRACE
                       (lambda Function ^JCDiagnostic$Error [^Tokens$TokenKind tk]
                         CompilerProperties$Errors/AnnotationMissingElementValue))
              (cast JCTree$JCExpression
                    (.toP this (.NewArray (.at F pos) nil (List/nil) (.toList buf))))))
        (do (.selectExprMode this) (.term1 this)))))

  (method ^:public variableDeclarators :type-params [(T
                                                       extends
                                                       (ListBuffer (? super JCTree$JCVariableDecl)))] ^T [this
                                                                                                          ^JCTree$JCModifiers mods
                                                                                                          ^JCTree$JCExpression type
                                                                                                          ^T vdefs
                                                                                                          ^boolean localDecl]
    (.variableDeclaratorsRest this
                              (.-pos token)
                              mods
                              type
                              (.identOrUnderscore this)
                              false
                              nil
                              vdefs
                              localDecl))

  (method ^:protected variableDeclaratorsRest :type-params [(T
                                                              extends
                                                              (ListBuffer
                                                                (? super JCTree$JCVariableDecl)))] ^T [this
                                                                                                       ^int pos
                                                                                                       ^JCTree$JCModifiers mods
                                                                                                       ^JCTree$JCExpression type
                                                                                                       ^Name name
                                                                                                       ^boolean reqInit
                                                                                                       ^Tokens$Comment dc
                                                                                                       ^T vdefs
                                                                                                       ^boolean localDecl]
    (let [head (.variableDeclaratorRest this pos mods type name reqInit dc localDecl false)]
      (.append vdefs head)
      (while (identical? (.-kind token) Tokens$TokenKind/COMMA)
        (.storeEnd this (cast JCTree (.last vdefs)) (.-endPos token))
        (.nextToken this)
        (.append vdefs (.variableDeclarator this mods type reqInit dc localDecl)))
      vdefs))

  (method variableDeclarator ^JCTree$JCVariableDecl [this ^JCTree$JCModifiers mods
                                                     ^JCTree$JCExpression type ^boolean reqInit
                                                     ^Tokens$Comment dc ^boolean localDecl]
    (.variableDeclaratorRest this
                             (.-pos token)
                             mods
                             type
                             (.identOrUnderscore this)
                             reqInit
                             dc
                             localDecl
                             true))

  (method variableDeclaratorRest ^JCTree$JCVariableDecl [this ^int pos ^JCTree$JCModifiers mods
                                                         ^:mutable ^JCTree$JCExpression type
                                                         ^:mutable ^Name name ^boolean reqInit
                                                         ^Tokens$Comment dc ^boolean localDecl
                                                         ^boolean compound]
    (let [^:mutable declaredUsingVar false
          ^:mutable ^JCTree$JCExpression init nil]
      (set! type (.bracketsOpt this type))
      (when (and (.allowedInSource Source$Feature/UNNAMED_VARIABLES source)
                 (identical? name (.-underscore names)))
        (when-not localDecl
          (.error log
                  JCDiagnostic$DiagnosticFlag/SYNTAX
                  pos
                  CompilerProperties$Errors/UseOfUnderscoreNotAllowed))
        (set! name (.-empty names)))
      (.saveDanglingDocComments this dc)
      (arbace.core/cond (identical? (.-kind token) Tokens$TokenKind/EQ)
                        (do (.nextToken this) (set! init (.variableInitializer this)))
                        reqInit
                        (.syntaxError this
                                      (.-pos token)
                                      (CompilerProperties$Errors/Expected Tokens$TokenKind/EQ)))
      (when (and (and (and (and (.allowedInSource Source$Feature/UNNAMED_VARIABLES source)
                                (identical? name (.-empty names)))
                           localDecl)
                      (nil? init))
                 (not (identical? (.-kind token) Tokens$TokenKind/COLON)))
        (.syntaxError this (.-pos token) (CompilerProperties$Errors/Expected Tokens$TokenKind/EQ)))
      (let [^:mutable varTypePos Position/NOPOS
            elemType (TreeInfo/innermostType type true)]
        (when (.hasTag elemType JCTree$Tag/IDENT)
          (let [typeName (.-name (cast JCTree$JCIdent elemType))]
            (when (some? (.restrictedTypeNameStartingAtSource
                           this
                           typeName
                           pos
                           (and (not compound) localDecl)))
              (arbace.core/cond
                (not (identical? typeName (.-var names)))
                (.reportSyntaxError this
                                    (.-pos elemType)
                                    (CompilerProperties$Errors/RestrictedTypeNotAllowedHere
                                      typeName))
                (and (.hasTag type JCTree$Tag/TYPEARRAY) (not compound))
                (.reportSyntaxError this
                                    (.-pos elemType)
                                    (CompilerProperties$Errors/RestrictedTypeNotAllowedArray
                                      typeName))
                :else
                (do
                  (set! declaredUsingVar true)
                  (set! varTypePos (.-pos elemType))
                  (when compound
                    (.reportSyntaxError this
                                        (.-pos elemType)
                                        (CompilerProperties$Errors/RestrictedTypeNotAllowedCompound
                                          typeName)))
                  (set! type nil))))))
        (let [result (cast
                       JCTree$JCVariableDecl
                       (.toP
                         this
                         (.VarDef
                           (.at F pos)
                           mods
                           name
                           type
                           init
                           ^JCTree$JCVariableDecl$DeclKind (if declaredUsingVar
                                                               JCTree$JCVariableDecl$DeclKind/VAR
                                                               JCTree$JCVariableDecl$DeclKind/EXPLICIT)
                           varTypePos)))]
          (cast JCTree$JCVariableDecl (.attach this result dc))))))

  (method restrictedTypeName ^Name [this ^JCTree$JCExpression e ^boolean shouldWarn]
    (switch (.getTag e)
      IDENT
        (when (some? (.restrictedTypeNameStartingAtSource
                       this
                       (.-name (cast JCTree$JCIdent e))
                       (.-pos e)
                       shouldWarn))
          (.-name (cast JCTree$JCIdent e)))
      TYPEARRAY (.restrictedTypeName this (.-elemtype (cast JCTree$JCArrayTypeTree e)) shouldWarn)
      nil))

  (method restrictedTypeNameStartingAtSource ^Source [this ^Name name ^int pos ^boolean shouldWarn]
    (when (identical? name (.-var names))
      (arbace.core/cond (.allowedInSource Source$Feature/LOCAL_VARIABLE_TYPE_INFERENCE source)
                        (return Source/JDK10)
                        shouldWarn
                        (.warning log
                                  pos
                                  (CompilerProperties$Warnings/RestrictedTypeNotAllowed
                                    name
                                    Source/JDK10))))
    (when (identical? name (.-yield names))
      (arbace.core/cond allowYieldStatement
                        (return Source/JDK14)
                        shouldWarn
                        (.warning log
                                  pos
                                  (CompilerProperties$Warnings/RestrictedTypeNotAllowed
                                    name
                                    Source/JDK14))))
    (when (identical? name (.-record names))
      (arbace.core/cond allowRecords
                        (return Source/JDK14)
                        shouldWarn
                        (.warning log
                                  pos
                                  (CompilerProperties$Warnings/RestrictedTypeNotAllowedPreview
                                    name
                                    Source/JDK14))))
    (when (identical? name (.-sealed names))
      (arbace.core/cond allowSealedTypes
                        (return Source/JDK15)
                        shouldWarn
                        (.warning log
                                  pos
                                  (CompilerProperties$Warnings/RestrictedTypeNotAllowedPreview
                                    name
                                    Source/JDK15))))
    (when (identical? name (.-permits names))
      (arbace.core/cond allowSealedTypes
                        (return Source/JDK15)
                        shouldWarn
                        (.warning log
                                  pos
                                  (CompilerProperties$Warnings/RestrictedTypeNotAllowedPreview
                                    name
                                    Source/JDK15))))
    nil)

  (method variableDeclaratorId ^JCTree$JCVariableDecl [this ^JCTree$JCModifiers mods
                                                       ^:mutable ^JCTree$JCExpression type
                                                       ^boolean catchParameter
                                                       ^boolean lambdaParameter
                                                       ^boolean recordComponent]
    (let [pos (.-pos token)
          ^:mutable ^Name name nil]
      (if (or (or (or (or allowThisIdent (not lambdaParameter))
                      (.test LAX_IDENTIFIER (.-kind token)))
                  (not (== (.-flags mods) Flags/PARAMETER)))
              (.nonEmpty (.-annotations mods)))
          (let [^JCTree$JCExpression pn (if (and
                                              (identical?
                                                (.-kind token)
                                                Tokens$TokenKind/UNDERSCORE)
                                              (or catchParameter lambdaParameter))
                                            (cast
                                              JCTree$JCExpression
                                              (.toP
                                                this
                                                (.Ident
                                                  (.at F (.-pos token))
                                                  (.identOrUnderscore this))))
                                            (.qualident this false))]
            (arbace.core/cond
              (and (.hasTag pn JCTree$Tag/IDENT)
                   (not (identical? (.-name (cast JCTree$JCIdent pn)) (.-_this names))))
              (set! name (.-name (cast JCTree$JCIdent pn)))
              (and lambdaParameter (nil? type))
              (do
                (set! type pn)
                (set! name (.-empty names))
                (.reportSyntaxError
                  this
                  pos
                  (CompilerProperties$Errors/Expected Tokens$TokenKind/IDENTIFIER)))
              :else
              (do
                (when allowThisIdent
                  (when-not (== (bit-and (.-flags mods) Flags/VARARGS) 0)
                    (.error log (.-pos token) CompilerProperties$Errors/VarargsAndReceiver))
                  (when (identical? (.-kind token) Tokens$TokenKind/LBRACKET)
                    (.error log (.-pos token) CompilerProperties$Errors/ArrayAndReceiver))
                  (when (and (.hasTag pn JCTree$Tag/SELECT)
                             (not (identical? (.-name (cast JCTree$JCFieldAccess pn))
                                              (.-_this names))))
                    (.error log (.-pos token) CompilerProperties$Errors/WrongReceiver)))
                (return (cast JCTree$JCVariableDecl
                              (.toP this (.ReceiverVarDef (.at F pos) mods pn type)))))))
          (set! name (.-error names)))
      (when (and (not (== (bit-and (.-flags mods) Flags/VARARGS) 0))
                 (identical? (.-kind token) Tokens$TokenKind/LBRACKET))
        (.error log (.-pos token) CompilerProperties$Errors/VarargsAndOldArraySyntax))
      (when (and recordComponent (identical? (.-kind token) Tokens$TokenKind/LBRACKET))
        (.error log (.-pos token) CompilerProperties$Errors/RecordComponentAndOldArraySyntax))
      (set! type (.bracketsOpt this type))
      (when (and (.allowedInSource Source$Feature/UNNAMED_VARIABLES source)
                 (identical? name (.-underscore names)))
        (set! name (.-empty names)))
      (let [declaredUsingVar (and (and (some? type) (.hasTag type JCTree$Tag/IDENT))
                                  (identical? (.-name (cast JCTree$JCIdent type)) (.-var names)))
            ^JCTree$JCVariableDecl$DeclKind declKind (arbace.core/cond
                                                       declaredUsingVar
                                                       JCTree$JCVariableDecl$DeclKind/VAR
                                                       (some? type)
                                                       JCTree$JCVariableDecl$DeclKind/EXPLICIT
                                                       :else
                                                       JCTree$JCVariableDecl$DeclKind/IMPLICIT)
            ^int typePos (if (some? type) (.-pos type) pos)]
        (cast JCTree$JCVariableDecl
              (.toP this (.VarDef (.at F pos) mods name type nil declKind typePos))))))

  (method resources ^{:tag (List JCTree)} [this]
    (let [^{:tag (ListBuffer JCTree)} defs (ListBuffer.)]
      (.append defs (.resource this))
      (while (identical? (.-kind token) Tokens$TokenKind/SEMI)
        (.storeEnd this (cast JCTree (.last defs)) (.-endPos token))
        (let [semiColonPos (.-pos token)]
          (.nextToken this)
          (when (identical? (.-kind token) Tokens$TokenKind/RPAREN) (break))
          (.append defs (.resource this))))
      (.toList defs)))

  (method ^:protected resource ^JCTree [this]
    (if (or (identical? (.-kind token) Tokens$TokenKind/FINAL)
            (identical? (.-kind token) Tokens$TokenKind/MONKEYS_AT))
        (let [mods (.optFinal this 0)
              t (.parseType this true)]
          (.variableDeclaratorRest this
                                   (.-pos token)
                                   mods
                                   t
                                   (.identOrUnderscore this)
                                   true
                                   nil
                                   true
                                   false))
        (let [t (.term this (bit-or-int EXPR TYPE))]
          (if (and (.wasTypeMode this) (.test LAX_IDENTIFIER (.-kind token)))
              (let [mods (.Modifiers F 0)]
                (.variableDeclaratorRest this
                                         (.-pos token)
                                         mods
                                         t
                                         (.identOrUnderscore this)
                                         true
                                         nil
                                         true
                                         false))
              (do
                (.checkSourceLevel this
                                   Source$Feature/EFFECTIVELY_FINAL_VARIABLES_IN_TRY_WITH_RESOURCES)
                (when (and (not (.hasTag t JCTree$Tag/IDENT)) (not (.hasTag t JCTree$Tag/SELECT)))
                  (.error log (.pos t) CompilerProperties$Errors/TryWithResourcesExprNeedsVar))
                t)))))

  (method ^:public parseCompilationUnit ^JCTree$JCCompilationUnit [this]
    (let [firstToken token
          ^:mutable ^JCTree$JCModifiers mods nil
          ^:mutable consumedToplevelDoc false
          ^:mutable seenImport false
          ^:mutable seenPackage false
          ^{:tag (ListBuffer JCTree)} defs (ListBuffer.)]
      (when (identical? (.-kind token) Tokens$TokenKind/MONKEYS_AT)
        (set! mods (.modifiersOpt this)))
      (when (identical? (.-kind token) Tokens$TokenKind/PACKAGE)
        (let [packagePos (.-pos token)
              ^:mutable ^{:tag (List JCTree$JCAnnotation)} annotations (List/nil)]
          (set! seenPackage true)
          (when (some? mods)
            (.checkNoMods this (bit-and (.-flags mods) (bit-not-int Flags/DEPRECATED)))
            (set! annotations (.-annotations mods))
            (set! mods nil))
          (.nextToken this)
          (let [pid (.qualident this false)]
            (.accept this Tokens$TokenKind/SEMI)
            (let [pd (cast JCTree$JCPackageDecl
                           (.toP this (.PackageDecl (.at F packagePos) annotations pid)))]
              (.attach this pd (.docComment firstToken))
              (set! consumedToplevelDoc true)
              (.append defs pd)
              (.updateUnexpectedTopLevelDefinitionStartError this true)))))
      (let [^:mutable firstTypeDecl true
            ^:mutable isImplicitClass false]
        (label :OUTER
          (while (not (identical? (.-kind token) Tokens$TokenKind/EOF))
            (when (<= (.-pos token) (.-errorEndPos endPosTable))
              (.skip this firstTypeDecl false false false)
              (when (identical? (.-kind token) Tokens$TokenKind/EOF) (break)))
            (let [^{:tag (ListBuffer JCTree)} semiList (ListBuffer.)]
              (while (and (and firstTypeDecl (nil? mods))
                          (identical? (.-kind token) Tokens$TokenKind/SEMI))
                (let [pos (.-pos token)]
                  (.nextToken this)
                  (.append semiList (.toP this (.Skip (.at F pos))))
                  (when (identical? (.-kind token) Tokens$TokenKind/EOF) (break :OUTER))))
              (if (and (and firstTypeDecl (nil? mods))
                       (identical? (.-kind token) Tokens$TokenKind/IMPORT))
                  (do
                    (when-not (.isEmpty semiList)
                      (if (>= (.compareTo source Source/JDK21) 0)
                          (.reportSyntaxError this
                                              (.-pos (cast JCTree (.first semiList)))
                                              CompilerProperties$Errors/ExtraneousSemicolon)
                          (.warning log
                                    (.-pos (cast JCTree (.first semiList)))
                                    CompilerProperties$Warnings/ExtraneousSemicolon)))
                    (set! seenImport true)
                    (.append defs (.importDeclaration this)))
                  (let [^:mutable docComment (.docComment token)]
                    (when (and (and firstTypeDecl (not seenImport)) (not seenPackage))
                      (set! docComment (.docComment firstToken))
                      (set! consumedToplevelDoc true))
                    (when (or (some? mods) (not (identical? (.-kind token) Tokens$TokenKind/SEMI)))
                      (set! mods (.modifiersOpt this mods)))
                    (when (and firstTypeDecl
                               (identical? (.-kind token) Tokens$TokenKind/IDENTIFIER))
                      (when-not (.isEmpty semiList)
                        (if (>= (.compareTo source Source/JDK21) 0)
                            (.reportSyntaxError this
                                                (.-pos (cast JCTree (.first semiList)))
                                                CompilerProperties$Errors/ExtraneousSemicolon)
                            (.warning log
                                      (.-pos (cast JCTree (.first semiList)))
                                      CompilerProperties$Warnings/ExtraneousSemicolon)))
                      (let [^:mutable kind ModuleTree$ModuleKind/STRONG]
                        (when (identical? (.name token) (.-open names))
                          (set! kind ModuleTree$ModuleKind/OPEN)
                          (.nextToken this))
                        (if (and (identical? (.-kind token) Tokens$TokenKind/IDENTIFIER)
                                 (identical? (.name token) (.-module names)))
                            (do
                              (when (some? mods)
                                (.checkNoMods this
                                              (bit-and
                                                (.-flags mods)
                                                (bit-not-int Flags/DEPRECATED))))
                              (.append defs (.moduleDecl this mods kind docComment))
                              (set! consumedToplevelDoc true)
                              (break))
                            (when-not (identical? kind ModuleTree$ModuleKind/STRONG)
                              (.reportSyntaxError
                                this
                                (.-pos token)
                                CompilerProperties$Errors/ExpectedModule)))))
                    (.appendList defs (.toList semiList))
                    (let [^:mutable isTopLevelMethodOrField false]
                      (when-not (.isDeclaration this true)
                        (let [finalMods mods
                              ^JavacParser speculative (VirtualParser. this)
                              ^{:tag (List JCTree)} speculativeResult
                                (.topLevelMethodOrFieldDeclaration speculative finalMods nil)]
                          (when (or (.hasTag (cast JCTree (.-head speculativeResult))
                                             JCTree$Tag/METHODDEF)
                                    (.hasTag (cast JCTree (.-head speculativeResult))
                                             JCTree$Tag/VARDEF))
                            (set! isTopLevelMethodOrField true))))
                      (arbace.core/cond
                        isTopLevelMethodOrField
                        (do
                          (.checkSourceLevel this (.-pos token) Source$Feature/IMPLICIT_CLASSES)
                          (.appendList defs
                                       (.topLevelMethodOrFieldDeclaration this mods docComment))
                          (set! isImplicitClass true))
                        (.isDefiniteStatementStartToken this)
                        (let [startPos (.-pos token)
                              ^{:tag (List JCTree$JCStatement)} statements (.blockStatement this)]
                          (.append defs
                                   (.syntaxError
                                     this
                                     startPos
                                     statements
                                     CompilerProperties$Errors/StatementNotExpected
                                     true)))
                        :else
                        (let [^:mutable def (.typeDeclaration this mods docComment)]
                          (when-instance [^JCTree$JCExpressionStatement statement def]
                            (set! def (.-expr statement)))
                          (.append defs def)))
                      (set! mods nil)
                      (set! firstTypeDecl false)))))))
        (let [^{:tag (List JCTree)} topLevelDefs (if isImplicitClass
                                                     (.constructImplicitClass
                                                       this
                                                       (.toList defs)
                                                       (.-endPos (.prevToken S)))
                                                     (.toList defs))
              toplevel (.TopLevel (.at F (.-pos firstToken)) topLevelDefs)]
          (when-not consumedToplevelDoc (.attach this toplevel (.docComment firstToken)))
          (when (.isEmpty defs) (.storeEnd this toplevel (.-endPos (.prevToken S))))
          (when keepDocComments (set! (.-docComments toplevel) docComments))
          (when keepLineMap (set! (.-lineMap toplevel) (.getLineMap S)))
          (set! (.-endPositions toplevel) (.-endPosTable this))
          toplevel))))

  (method ^:private constructImplicitClass ^{:tag (List JCTree)} [this
                                                                  ^{:tag (List JCTree)} origDefs
                                                                  ^int endPos]
    (let [^{:tag (ListBuffer JCTree)} topDefs (ListBuffer.)
          ^{:tag (ListBuffer JCTree)} defs (ListBuffer.)]
      (for-each [^JCTree def origDefs]
        (arbace.core/cond (.hasTag def JCTree$Tag/PACKAGEDEF)
                          (.error
                            log
                            (.pos def)
                            CompilerProperties$Errors/ImplicitClassShouldNotHavePackageDeclaration)
                          (or (.hasTag def JCTree$Tag/IMPORT) (.hasTag def JCTree$Tag/MODULEIMPORT))
                          (.append topDefs def)
                          :else
                          (when-not (.hasTag def JCTree$Tag/SKIP) (.append defs def))))
      (let [primaryPos (.getStartPos this (cast JCTree (.first defs)))
            ^:mutable simplename (PathFileObject/getSimpleName (.currentSourceFile log))]
        (when (.endsWith simplename ".java")
          (set! simplename
                (.substring simplename
                            0
                            (unchecked-subtract-int (.length simplename) (.length ".java")))))
        (when (or (not (SourceVersion/isIdentifier simplename))
                  (SourceVersion/isKeyword simplename))
          (.error log primaryPos (CompilerProperties$Errors/BadFileName simplename)))
        (let [name (.fromString names simplename)
              implicitMods (.Modifiers (.at F Position/NOPOS)
                                       (bit-or-int Flags/FINAL Flags/IMPLICIT_CLASS)
                                       (List/nil))
              implicit (.ClassDef (.at F primaryPos)
                                  implicitMods
                                  name
                                  (List/nil)
                                  nil
                                  (List/nil)
                                  (List/nil)
                                  (.toList defs))]
          (.storeEnd this implicit endPos)
          (.append topDefs implicit)
          (.toList topDefs)))))

  (method moduleDecl ^JCTree$JCModuleDecl [this ^JCTree$JCModifiers mods ^ModuleTree$ModuleKind kind
                                           ^Tokens$Comment dc]
    (let [pos (.-pos token)]
      (.checkSourceLevel this Source$Feature/MODULES)
      (.nextToken this)
      (let [name (.qualident this false)
            ^:mutable ^{:tag (List JCTree$JCDirective)} directives nil]
        (.accept this Tokens$TokenKind/LBRACE)
        (set! directives (.moduleDirectiveList this))
        (.accept this Tokens$TokenKind/RBRACE)
        (let [endPos (.-endPos (.prevToken S))]
          (.accept this Tokens$TokenKind/EOF)
          (let [result (.ModuleDef (.at F pos) mods kind name directives)]
            (.storeEnd this result endPos)
            (cast JCTree$JCModuleDecl (.attach this result dc)))))))

  (method moduleDirectiveList ^{:tag (List JCTree$JCDirective)} [this]
    (let [^{:tag (ListBuffer JCTree$JCDirective)} defs (ListBuffer.)]
      (while (identical? (.-kind token) Tokens$TokenKind/IDENTIFIER)
        (let [pos (.-pos token)]
          (arbace.core/cond (identical? (.name token) (.-requires names))
                            (do
                              (.nextToken this)
                              (let [^:mutable isTransitive false
                                    ^:mutable isStaticPhase false]
                                (while true
                                  (switch (.-kind token)
                                    IDENTIFIER
                                      (if (identical? (.name token) (.-transitive names))
                                          (let [t1 (.token S 1)]
                                            (when (or
                                                    (identical? (.-kind t1) Tokens$TokenKind/SEMI)
                                                    (identical? (.-kind t1) Tokens$TokenKind/DOT))
                                              (break))
                                            (when isTransitive
                                              (.error
                                                log
                                                JCDiagnostic$DiagnosticFlag/SYNTAX
                                                (.-pos token)
                                                CompilerProperties$Errors/RepeatedModifier))
                                            (set! isTransitive true))
                                          (break))
                                    STATIC
                                      (do
                                        (when isStaticPhase
                                          (.error
                                            log
                                            JCDiagnostic$DiagnosticFlag/SYNTAX
                                            (.-pos token)
                                            CompilerProperties$Errors/RepeatedModifier))
                                        (set! isStaticPhase true))
                                    (break))
                                  (.nextToken this))
                                (let [moduleName (.qualident this false)]
                                  (.accept this Tokens$TokenKind/SEMI)
                                  (.append defs
                                           (cast
                                             JCTree$JCDirective
                                             (.toP
                                               this
                                               (.Requires
                                                 (.at F pos)
                                                 isTransitive
                                                 isStaticPhase
                                                 moduleName)))))))
                            (or (identical? (.name token) (.-exports names))
                                (identical? (.name token) (.-opens names)))
                            (let [exports (identical? (.name token) (.-exports names))]
                              (.nextToken this)
                              (let [pkgName (.qualident this false)
                                    ^:mutable ^{:tag (List JCTree$JCExpression)} moduleNames nil]
                                (when (and (identical? (.-kind token) Tokens$TokenKind/IDENTIFIER)
                                           (identical? (.name token) (.-to names)))
                                  (.nextToken this)
                                  (set! moduleNames (.qualidentList this false)))
                                (.accept this Tokens$TokenKind/SEMI)
                                (let [^JCTree$JCDirective d (if exports
                                                                (.Exports
                                                                  (.at F pos)
                                                                  pkgName
                                                                  moduleNames)
                                                                (.Opens
                                                                  (.at F pos)
                                                                  pkgName
                                                                  moduleNames))]
                                  (.append defs (cast JCTree$JCDirective (.toP this d))))))
                            :else
                            (arbace.core/cond
                              (identical? (.name token) (.-provides names))
                              (do
                                (.nextToken this)
                                (let [serviceName (.qualident this false)
                                      ^:mutable ^{:tag (List JCTree$JCExpression)} implNames nil]
                                  (if (and (identical? (.-kind token) Tokens$TokenKind/IDENTIFIER)
                                           (identical? (.name token) (.-with names)))
                                      (do
                                        (.nextToken this)
                                        (set! implNames (.qualidentList this false)))
                                      (do
                                        (.error log
                                                JCDiagnostic$DiagnosticFlag/SYNTAX
                                                (.-pos token)
                                                (CompilerProperties$Errors/ExpectedStr
                                                  (java-str "'" (.-with names) "'")))
                                        (set! implNames (List/nil))))
                                  (.accept this Tokens$TokenKind/SEMI)
                                  (.append defs
                                           (cast
                                             JCTree$JCDirective
                                             (.toP
                                               this
                                               (.Provides (.at F pos) serviceName implNames))))))
                              (identical? (.name token) (.-uses names))
                              (do
                                (.nextToken this)
                                (let [service (.qualident this false)]
                                  (.accept this Tokens$TokenKind/SEMI)
                                  (.append defs
                                           (cast
                                             JCTree$JCDirective
                                             (.toP this (.Uses (.at F pos) service))))))
                              :else
                              (do
                                (.setErrorEndPos this pos)
                                (.reportSyntaxError
                                  this
                                  pos
                                  CompilerProperties$Errors/InvalidModuleDirective)
                                (break))))))
      (.toList defs)))

  (method ^:protected importDeclaration ^JCTree [this]
    (let [pos (.-pos token)]
      (.nextToken this)
      (let [^:mutable importStatic false]
        (if (identical? (.-kind token) Tokens$TokenKind/STATIC)
            (do (set! importStatic true) (.nextToken this))
            (when (and (and (identical? (.-kind token) Tokens$TokenKind/IDENTIFIER)
                            (identical? (.name token) (.-module names)))
                       (.peekToken this Tokens$TokenKind/IDENTIFIER))
              (.checkSourceLevel this Source$Feature/MODULE_IMPORTS)
              (.nextToken this)
              (let [moduleName (.qualident this false)]
                (.accept this Tokens$TokenKind/SEMI)
                (return (.toP this (.ModuleImport (.at F pos) moduleName))))))
        (let [^:mutable pid (cast JCTree$JCExpression
                                  (.toP this (.Ident (.at F (.-pos token)) (.ident this))))]
          (loop []
            (let [pos1 (.-pos token)]
              (.accept this Tokens$TokenKind/DOT)
              (if (identical? (.-kind token) Tokens$TokenKind/STAR)
                  (do
                    (set! pid
                          (cast JCTree$JCExpression
                                (.to this (.Select (.at F pos1) pid (.-asterisk names)))))
                    (.nextToken this)
                    (break))
                  (set! pid
                        (cast JCTree$JCExpression
                              (.toP this (.Select (.at F pos1) pid (.ident this)))))))
            (when (identical? (.-kind token) Tokens$TokenKind/DOT) (recur)))
          (.accept this Tokens$TokenKind/SEMI)
          (.toP this (.Import (.at F pos) (cast JCTree$JCFieldAccess pid) importStatic))))))

  (method typeDeclaration ^JCTree [this ^JCTree$JCModifiers mods ^Tokens$Comment docComment]
    (let [pos (.-pos token)]
      (if (and (nil? mods) (identical? (.-kind token) Tokens$TokenKind/SEMI))
          (do (.nextToken this) (.toP this (.Skip (.at F pos))))
          (.classOrRecordOrInterfaceOrEnumDeclaration this (.modifiersOpt this mods) docComment))))

  (method ^:protected classOrRecordOrInterfaceOrEnumDeclaration ^JCTree$JCStatement [this
                                                                                     ^JCTree$JCModifiers mods
                                                                                     ^Tokens$Comment dc]
    (arbace.core/cond (identical? (.-kind token) Tokens$TokenKind/CLASS)
                      (.classDeclaration this mods dc)
                      (.isRecordStart this)
                      (.recordDeclaration this mods dc)
                      :else
                      (arbace.core/cond (identical? (.-kind token) Tokens$TokenKind/INTERFACE)
                                        (.interfaceDeclaration this mods dc)
                                        (identical? (.-kind token) Tokens$TokenKind/ENUM)
                                        (.enumDeclaration this mods dc)
                                        :else
                                        (let [pos (.-pos token)
                                              ^:mutable ^{:tag (List JCTree)} errs nil]
                                          (if (.test LAX_IDENTIFIER (.-kind token))
                                              (do
                                                (set!
                                                  errs
                                                  (List/of
                                                    mods
                                                    (.toP this (.Ident (.at F pos) (.ident this)))))
                                                (.setErrorEndPos this (.-pos token)))
                                              (set! errs (List/of mods)))
                                          (cast JCTree$JCStatement
                                                (.toP
                                                  this
                                                  (.Exec
                                                    F
                                                    (.syntaxError
                                                      this
                                                      pos
                                                      errs
                                                      unexpectedTopLevelDefinitionStartError))))))))

  (method ^:protected classDeclaration ^JCTree$JCClassDecl [this ^JCTree$JCModifiers mods
                                                            ^Tokens$Comment dc]
    (let [pos (.-pos token)]
      (.accept this Tokens$TokenKind/CLASS)
      (let [name (.typeName this)
            ^{:tag (List JCTree$JCTypeParameter)} typarams (.typeParametersOpt this)
            ^:mutable ^JCTree$JCExpression extending nil]
        (when (identical? (.-kind token) Tokens$TokenKind/EXTENDS)
          (.nextToken this)
          (set! extending (.parseType this)))
        (let [^:mutable ^{:tag (List JCTree$JCExpression)} implementing (List/nil)]
          (when (identical? (.-kind token) Tokens$TokenKind/IMPLEMENTS)
            (.nextToken this)
            (set! implementing (.typeList this)))
          (let [^{:tag (List JCTree$JCExpression)} permitting (.permitsClause this mods "class")]
            (.saveDanglingDocComments this dc)
            (let [^{:tag (List JCTree)} defs (.classInterfaceOrRecordBody this name false false)
                  result (cast JCTree$JCClassDecl
                               (.toP this
                                     (.ClassDef (.at F pos)
                                                mods
                                                name
                                                typarams
                                                extending
                                                implementing
                                                permitting
                                                defs)))]
              (cast JCTree$JCClassDecl (.attach this result dc))))))))

  (method ^:protected recordDeclaration ^JCTree$JCClassDecl [this ^JCTree$JCModifiers mods
                                                             ^Tokens$Comment dc]
    (let [pos (.-pos token)]
      (.nextToken this)
      (set! (.-flags mods) (bit-or (.-flags mods) Flags/RECORD))
      (let [name (.typeName this)
            ^{:tag (List JCTree$JCTypeParameter)} typarams (.typeParametersOpt this)
            ^{:tag (List JCTree$JCVariableDecl)} headerFields (.formalParameters this false true)
            ^:mutable ^{:tag (List JCTree$JCExpression)} implementing (List/nil)]
        (when (identical? (.-kind token) Tokens$TokenKind/IMPLEMENTS)
          (.nextToken this)
          (set! implementing (.typeList this)))
        (.saveDanglingDocComments this dc)
        (let [^:mutable ^{:tag (List JCTree)} defs (.classInterfaceOrRecordBody
                                                     this
                                                     name
                                                     false
                                                     true)
              ^{:tag (java.util.List JCTree$JCVariableDecl)} fields (ArrayList.)]
          (for-each [^JCTree$JCVariableDecl field headerFields] (.add fields field))
          (for-each [^JCTree def defs]
            (when (.hasTag def JCTree$Tag/METHODDEF)
              (let [methDef (cast JCTree$JCMethodDecl def)]
                (when (and (and (identical? (.-name methDef) (.-init names))
                                (.isEmpty (.-params methDef)))
                           (not (== (bit-and (.-flags (.-mods methDef))
                                             Flags/COMPACT_RECORD_CONSTRUCTOR)
                                    0)))
                  (let [^{:tag (ListBuffer JCTree$JCVariableDecl)} tmpParams (ListBuffer.)]
                    (for-each [^JCTree$JCVariableDecl param headerFields]
                      (.add tmpParams
                            (.VarDef (.at F param)
                                     (.Modifiers
                                       F
                                       (bit-or (bit-or
                                                 (bit-or Flags/PARAMETER Flags/GENERATED_MEMBER)
                                                 Flags/MANDATED)
                                               (bit-and (.-flags (.-mods param)) Flags/VARARGS))
                                       (.-annotations (.-mods param)))
                                     (.-name param)
                                     (.-vartype param)
                                     nil)))
                    (set! (.-params methDef) (.toList tmpParams)))))))
          (loop [^int i (unchecked-subtract-int (.size fields) 1)]
            (when (>= i 0)
              (let [field (cast JCTree$JCVariableDecl (.get fields i))]
                (set! defs (.prepend defs field))
                (recur (unchecked-dec-int i)))))
          (let [result (cast
                         JCTree$JCClassDecl
                         (.toP this
                               (.ClassDef (.at F pos) mods name typarams nil implementing defs)))]
            (cast JCTree$JCClassDecl (.attach this result dc)))))))

  (method typeName ^Name [this]
    (let [pos (.-pos token)
          name (.ident this)
          source (.restrictedTypeNameStartingAtSource this name pos true)]
      (when (some? source)
        (.reportSyntaxError this
                            pos
                            (CompilerProperties$Errors/RestrictedTypeNotAllowed name source)))
      name))

  (method ^:protected interfaceDeclaration ^JCTree$JCClassDecl [this ^JCTree$JCModifiers mods
                                                                ^Tokens$Comment dc]
    (let [pos (.-pos token)]
      (.accept this Tokens$TokenKind/INTERFACE)
      (let [name (.typeName this)
            ^{:tag (List JCTree$JCTypeParameter)} typarams (.typeParametersOpt this)
            ^:mutable ^{:tag (List JCTree$JCExpression)} extending (List/nil)]
        (when (identical? (.-kind token) Tokens$TokenKind/EXTENDS)
          (.nextToken this)
          (set! extending (.typeList this)))
        (let [^{:tag (List JCTree$JCExpression)} permitting (.permitsClause this mods "interface")]
          (.saveDanglingDocComments this dc)
          (let [^:mutable ^{:tag (List JCTree)} defs nil]
            (set! defs (.classInterfaceOrRecordBody this name true false))
            (let [result (cast JCTree$JCClassDecl
                               (.toP this
                                     (.ClassDef (.at F pos)
                                                mods
                                                name
                                                typarams
                                                nil
                                                extending
                                                permitting
                                                defs)))]
              (cast JCTree$JCClassDecl (.attach this result dc))))))))

  (method permitsClause ^{:tag (List JCTree$JCExpression)} [this ^JCTree$JCModifiers mods
                                                            ^String classOrInterface]
    (if (and (and allowSealedTypes (identical? (.-kind token) Tokens$TokenKind/IDENTIFIER))
             (identical? (.name token) (.-permits names)))
        (do
          (.checkSourceLevel this Source$Feature/SEALED_CLASSES)
          (when (== (bit-and (.-flags mods) Flags/SEALED) 0)
            (.error log
                    (.-pos token)
                    (CompilerProperties$Errors/InvalidPermitsClause
                      (CompilerProperties$Fragments/ClassIsNotSealed classOrInterface))))
          (.nextToken this)
          (.qualidentList this false))
        (List/nil)))

  (method ^:protected enumDeclaration ^JCTree$JCClassDecl [this ^JCTree$JCModifiers mods
                                                           ^Tokens$Comment dc]
    (let [pos (.-pos token)]
      (.accept this Tokens$TokenKind/ENUM)
      (let [name (.typeName this)
            typeNamePos (.-pos token)
            ^{:tag (List JCTree$JCTypeParameter)} typarams (.typeParametersOpt this true)]
        (when (or (nil? typarams) (not (.isEmpty typarams)))
          (let [^int errorPosition (if (nil? typarams)
                                       typeNamePos
                                       (.-pos (cast JCTree$JCTypeParameter (.-head typarams))))]
            (.error log
                    JCDiagnostic$DiagnosticFlag/SYNTAX
                    errorPosition
                    CompilerProperties$Errors/EnumCantBeGeneric)))
        (let [^:mutable ^{:tag (List JCTree$JCExpression)} implementing (List/nil)]
          (when (identical? (.-kind token) Tokens$TokenKind/IMPLEMENTS)
            (.nextToken this)
            (set! implementing (.typeList this)))
          (.saveDanglingDocComments this dc)
          (let [^{:tag (List JCTree)} defs (.enumBody this name)]
            (set! (.-flags mods) (bit-or (.-flags mods) Flags/ENUM))
            (let [result (cast JCTree$JCClassDecl
                               (.toP this
                                     (.ClassDef (.at F pos)
                                                mods
                                                name
                                                (List/nil)
                                                nil
                                                implementing
                                                defs)))]
              (cast JCTree$JCClassDecl (.attach this result dc))))))))

  (method enumBody ^{:tag (List JCTree)} [this ^Name enumName]
    (.accept this Tokens$TokenKind/LBRACE)
    (let [^{:tag (ListBuffer JCTree)} defs (ListBuffer.)
          ^:mutable wasSemi false
          ^:mutable hasStructuralErrors false
          ^:mutable wasError false]
      (when (identical? (.-kind token) Tokens$TokenKind/COMMA)
        (.nextToken this)
        (if (identical? (.-kind token) Tokens$TokenKind/SEMI)
            (do (set! wasSemi true) (.nextToken this))
            (when-not (identical? (.-kind token) Tokens$TokenKind/RBRACE)
              (.reportSyntaxError this
                                  (.-endPos (.prevToken S))
                                  (CompilerProperties$Errors/Expected2
                                    Tokens$TokenKind/RBRACE
                                    Tokens$TokenKind/SEMI))
              (set! wasError true))))
      (while (and (not (identical? (.-kind token) Tokens$TokenKind/RBRACE))
                  (not (identical? (.-kind token) Tokens$TokenKind/EOF)))
        (when (identical? (.-kind token) Tokens$TokenKind/SEMI)
          (.accept this Tokens$TokenKind/SEMI)
          (set! wasSemi true)
          (when (or (identical? (.-kind token) Tokens$TokenKind/RBRACE)
                    (identical? (.-kind token) Tokens$TokenKind/EOF))
            (break)))
        (let [^:mutable memberType (.estimateEnumeratorOrMember this enumName)]
          (when (identical? memberType EnumeratorEstimate/UNKNOWN)
            (set! memberType (if wasSemi EnumeratorEstimate/MEMBER EnumeratorEstimate/ENUMERATOR)))
          (if (identical? memberType EnumeratorEstimate/ENUMERATOR)
              (do
                (set! wasError false)
                (when (and wasSemi (not hasStructuralErrors))
                  (.reportSyntaxError this
                                      (.-pos token)
                                      CompilerProperties$Errors/EnumConstantNotExpected)
                  (set! hasStructuralErrors true))
                (.append defs (.enumeratorDeclaration this enumName))
                (arbace.core/cond (<= (.-pos token) (.-errorEndPos endPosTable))
                                  (.skip this false true true false)
                                  (and (and (not
                                              (identical? (.-kind token) Tokens$TokenKind/RBRACE))
                                            (not (identical? (.-kind token) Tokens$TokenKind/SEMI)))
                                       (not (identical? (.-kind token) Tokens$TokenKind/EOF)))
                                  (if (identical? (.-kind token) Tokens$TokenKind/COMMA)
                                      (.nextToken this)
                                      (do
                                        (.setErrorEndPos this (.-pos token))
                                        (.reportSyntaxError
                                          this
                                          (.-endPos (.prevToken S))
                                          (CompilerProperties$Errors/Expected3
                                            Tokens$TokenKind/COMMA
                                            Tokens$TokenKind/RBRACE
                                            Tokens$TokenKind/SEMI))
                                        (set! wasError true)))))
              (do
                (when (and (and (not wasSemi) (not hasStructuralErrors)) (not wasError))
                  (.reportSyntaxError this
                                      (.-pos token)
                                      CompilerProperties$Errors/EnumConstantExpected)
                  (set! hasStructuralErrors true))
                (set! wasError false)
                (.appendList defs
                             (.classOrInterfaceOrRecordBodyDeclaration
                               this
                               nil
                               enumName
                               false
                               false))
                (when (<= (.-pos token) (.-errorEndPos endPosTable))
                  (.skip this false true true false))))))
      (.accept this Tokens$TokenKind/RBRACE)
      (.toList defs)))

  (method ^:private estimateEnumeratorOrMember ^EnumeratorEstimate [this ^Name enumName]
    (let [ident (or (identical? (.-kind token) Tokens$TokenKind/IDENTIFIER)
                    (identical? (.-kind token) Tokens$TokenKind/UNDERSCORE))]
      (when (and (and ident (not (identical? (.name token) enumName)))
                 (or (not allowRecords) (not (.isRecordStart this))))
        (let [next (.token S 1)]
          (switch (.-kind next) (LPAREN LBRACE COMMA SEMI) (return EnumeratorEstimate/ENUMERATOR))))
      (switch (.-kind token)
        IDENTIFIER
          (if (and allowRecords (.isRecordStart this))
              EnumeratorEstimate/MEMBER
              EnumeratorEstimate/UNKNOWN)
        (MONKEYS_AT LT UNDERSCORE) EnumeratorEstimate/UNKNOWN
        EnumeratorEstimate/MEMBER)))

  (defclass ^:private ^:enum EnumeratorEstimate
    (constants ENUMERATOR MEMBER UNKNOWN))

  (method enumeratorDeclaration ^JCTree [this ^Name enumName]
    (let [dc (.docComment token)
          ^:mutable flags (bit-or-int (bit-or-int
                                        (bit-or-int Flags/PUBLIC Flags/STATIC)
                                        Flags/FINAL)
                                      Flags/ENUM)]
      (when (.deprecatedFlag token) (set! flags (bit-or-int flags Flags/DEPRECATED)))
      (let [pos (.-pos token)
            ^{:tag (List JCTree$JCAnnotation)} annotations (.annotationsOpt
                                                             this
                                                             JCTree$Tag/ANNOTATION)
            mods (.Modifiers (.at F (if (.isEmpty annotations) Position/NOPOS pos))
                             flags
                             annotations)
            ^{:tag (List JCTree$JCExpression)} typeArgs (.typeArgumentsOpt this)
            identPos (.-pos token)
            name (.ident this)
            ^:mutable createPos (.-pos token)]
        (.saveDanglingDocComments this dc)
        (let [^{:tag (List JCTree$JCExpression)} args (if (identical?
                                                            (.-kind token)
                                                            Tokens$TokenKind/LPAREN)
                                                          (.arguments this)
                                                          (List/nil))
              ^:mutable ^JCTree$JCClassDecl body nil]
          (when (identical? (.-kind token) Tokens$TokenKind/LBRACE)
            (let [mods1 (.Modifiers (.at F Position/NOPOS) Flags/ENUM)
                  ^{:tag (List JCTree)} defs (.classInterfaceOrRecordBody
                                               this
                                               (.-empty names)
                                               false
                                               false)]
              (set! body
                    (cast JCTree$JCClassDecl
                          (.toP this (.AnonymousClassDef (.at F identPos) mods1 defs))))))
          (when (and (.isEmpty args) (nil? body)) (set! createPos identPos))
          (let [^:mutable ident (.Ident (.at F identPos) enumName)
                create (.NewClass (.at F createPos) nil typeArgs ident args body)]
            (when-not (== createPos identPos) (.storeEnd this create (.-endPos (.prevToken S))))
            (set! ident (.Ident (.at F identPos) enumName))
            (let [result (.toP this (.VarDef (.at F pos) mods name ident create))]
              (.attach this result dc)))))))

  (method typeList ^{:tag (List JCTree$JCExpression)} [this]
    (let [^{:tag (ListBuffer JCTree$JCExpression)} ts (ListBuffer.)]
      (.append ts (.parseType this))
      (while (identical? (.-kind token) Tokens$TokenKind/COMMA)
        (.nextToken this)
        (.append ts (.parseType this)))
      (.toList ts)))

  (method classInterfaceOrRecordBody ^{:tag (List JCTree)} [this ^Name className
                                                            ^boolean isInterface ^boolean isRecord]
    (.accept this Tokens$TokenKind/LBRACE)
    (when (<= (.-pos token) (.-errorEndPos endPosTable))
      (.skip this false true false false)
      (if (identical? (.-kind token) Tokens$TokenKind/LBRACE) (.nextToken this) (return (List/nil))))
    (let [^{:tag (ListBuffer JCTree)} defs (ListBuffer.)]
      (while (and (not (identical? (.-kind token) Tokens$TokenKind/RBRACE))
                  (not (identical? (.-kind token) Tokens$TokenKind/EOF)))
        (.appendList defs
                     (.classOrInterfaceOrRecordBodyDeclaration
                       this
                       nil
                       className
                       isInterface
                       isRecord))
        (when (<= (.-pos token) (.-errorEndPos endPosTable)) (.skip this false true true false)))
      (.accept this Tokens$TokenKind/RBRACE)
      (.toList defs)))

  (method ^:protected classOrInterfaceOrRecordBodyDeclaration ^{:tag (List JCTree)} [this
                                                                                     ^:mutable ^JCTree$JCModifiers mods
                                                                                     ^Name className
                                                                                     ^boolean isInterface
                                                                                     ^boolean isRecord]
    (if (identical? (.-kind token) Tokens$TokenKind/SEMI)
        (do (.nextToken this) (List/nil))
        (let [dc (.docComment token)
              pos (.-pos token)]
          (set! mods (.modifiersOpt this mods))
          (if (.isDeclaration this)
              (List/of (.classOrRecordOrInterfaceOrEnumDeclaration this mods dc))
              (arbace.core/cond
                (and (and (identical? (.-kind token) Tokens$TokenKind/LBRACE)
                          (== (bit-and (bit-and (.-flags mods) Flags/StandardFlags)
                                       (bit-not-int Flags/STATIC))
                              0))
                     (.isEmpty (.-annotations mods)))
                (do
                  (arbace.core/cond
                    isInterface
                    (.error log
                            JCDiagnostic$DiagnosticFlag/SYNTAX
                            (.-pos token)
                            CompilerProperties$Errors/InitializerNotAllowed)
                    (and isRecord (== (bit-and (.-flags mods) Flags/STATIC) 0))
                    (.error log
                            JCDiagnostic$DiagnosticFlag/SYNTAX
                            (.-pos token)
                            CompilerProperties$Errors/InstanceInitializerNotAllowedInRecords))
                  (.ignoreDanglingComments this)
                  (List/of (.block this pos (.-flags mods))))
                (.isDefiniteStatementStartToken this)
                (let [startPos (.-pos token)
                      ^{:tag (List JCTree$JCStatement)} statements (.blockStatement this)]
                  (List/of (.syntaxError this
                                         startPos
                                         statements
                                         CompilerProperties$Errors/StatementNotExpected)))
                :else
                (.constructorOrMethodOrFieldDeclaration this mods className isInterface isRecord dc))))))

  (method ^:private constructorOrMethodOrFieldDeclaration ^{:tag (List JCTree)} [this
                                                                                 ^JCTree$JCModifiers mods
                                                                                 ^Name className
                                                                                 ^boolean isInterface
                                                                                 ^boolean isRecord
                                                                                 ^Tokens$Comment dc]
    (let [^:mutable ^int pos 0]
      (set! pos (.-pos token))
      (let [^{:tag (List JCTree$JCTypeParameter)} typarams (.typeParametersOpt this)]
        (when (and (.nonEmpty typarams) (== (.-pos mods) Position/NOPOS))
          (set! (.-pos mods) pos)
          (.storeEnd this mods pos))
        (let [^{:tag (List JCTree$JCAnnotation)} annosAfterParams (.annotationsOpt
                                                                    this
                                                                    JCTree$Tag/ANNOTATION)]
          (when (.nonEmpty annosAfterParams)
            (set! (.-annotations mods) (.appendList (.-annotations mods) annosAfterParams))
            (when (== (.-pos mods) Position/NOPOS)
              (set! (.-pos mods) (.-pos (cast JCTree$JCAnnotation (.-head (.-annotations mods)))))))
          (let [tk token]
            (set! pos (.-pos token))
            (let [^:mutable ^JCTree$JCExpression type nil
                  isVoid (identical? (.-kind token) Tokens$TokenKind/VOID)]
              (if isVoid
                  (do
                    (set! type
                          (cast JCTree$JCExpression
                                (.to this (.TypeIdent (.at F pos) TypeTag/VOID))))
                    (.nextToken this))
                  (set! type (.unannotatedType this false)))
              (arbace.core/cond
                (and (or (and (identical? (.-kind token) Tokens$TokenKind/LPAREN) (not isInterface))
                         (and isRecord (identical? (.-kind token) Tokens$TokenKind/LBRACE)))
                     (.hasTag type JCTree$Tag/IDENT))
                (do
                  (arbace.core/cond (or isInterface (not (identical? (.name tk) className)))
                                    (.error log
                                            JCDiagnostic$DiagnosticFlag/SYNTAX
                                            pos
                                            CompilerProperties$Errors/InvalidMethDeclRetTypeReq)
                                    (.nonEmpty annosAfterParams)
                                    (.illegal
                                      this
                                      (.-pos (cast JCTree$JCAnnotation (.-head annosAfterParams)))))
                  (when (and isRecord (identical? (.-kind token) Tokens$TokenKind/LBRACE))
                    (set! (.-flags mods) (bit-or (.-flags mods) Flags/COMPACT_RECORD_CONSTRUCTOR)))
                  (List/of (.methodDeclaratorRest
                             this
                             pos
                             mods
                             nil
                             (.-init names)
                             typarams
                             isInterface
                             true
                             isRecord
                             dc)))
                (and (and isRecord (.hasTag type JCTree$Tag/IDENT))
                     (identical? (.-kind token) Tokens$TokenKind/THROWS))
                (do
                  (.error
                    log
                    JCDiagnostic$DiagnosticFlag/SYNTAX
                    (.-pos token)
                    (CompilerProperties$Errors/InvalidCanonicalConstructorInRecord
                      CompilerProperties$Fragments/Compact
                      className
                      (CompilerProperties$Fragments/ThrowsClauseNotAllowedForCanonicalConstructor
                        CompilerProperties$Fragments/Compact)))
                  (.skip this false true false false)
                  (List/of (.methodDeclaratorRest
                             this
                             pos
                             mods
                             nil
                             (.-init names)
                             typarams
                             isInterface
                             true
                             isRecord
                             dc)))
                :else
                (do
                  (set! pos (.-pos token))
                  (let [name (.ident this)]
                    (arbace.core/cond
                      (identical? (.-kind token) Tokens$TokenKind/LPAREN)
                      (List/of (.methodDeclaratorRest
                                 this
                                 pos
                                 mods
                                 type
                                 name
                                 typarams
                                 isInterface
                                 isVoid
                                 false
                                 dc))
                      (and (not isVoid) (.isEmpty typarams))
                      (if (or (not isRecord)
                              (and isRecord (not (== (bit-and (.-flags mods) Flags/STATIC) 0))))
                          (let [^{:tag (List JCTree)} defs (.toList
                                                             (.variableDeclaratorsRest
                                                               this
                                                               pos
                                                               mods
                                                               type
                                                               name
                                                               isInterface
                                                               dc
                                                               (ListBuffer.)
                                                               false))]
                            (.accept this Tokens$TokenKind/SEMI)
                            (.storeEnd this (cast JCTree (.last defs)) (.-endPos (.prevToken S)))
                            defs)
                          (let [errPos pos]
                            (.toList (.variableDeclaratorsRest
                                       this
                                       pos
                                       mods
                                       type
                                       name
                                       isInterface
                                       dc
                                       (ListBuffer.)
                                       false))
                            (.accept this Tokens$TokenKind/SEMI)
                            (List/of (.syntaxError
                                       this
                                       errPos
                                       nil
                                       CompilerProperties$Errors/RecordCannotDeclareInstanceFields))))
                      :else
                      (do
                        (set! pos (.-pos token))
                        (let [^:mutable ^{:tag (List JCTree)} err nil]
                          (if (or isVoid (.nonEmpty typarams))
                              (let [m (cast JCTree$JCMethodDecl
                                            (.toP
                                              this
                                              (.MethodDef
                                                (.at F pos)
                                                mods
                                                name
                                                type
                                                typarams
                                                (List/nil)
                                                (List/nil)
                                                nil
                                                nil)))]
                                (.attach this m dc)
                                (set! err (List/of m)))
                              (set! err (List/nil)))
                          (List/of (.syntaxError
                                     this
                                     (.-pos token)
                                     err
                                     (CompilerProperties$Errors/Expected Tokens$TokenKind/LPAREN)))))))))))))))

  (method ^:private topLevelMethodOrFieldDeclaration :throws [AssertionError] ^{:tag (List JCTree)} [this
                                                                                                     ^JCTree$JCModifiers mods
                                                                                                     ^:mutable ^Tokens$Comment dc]
    (let [^:mutable pos (.-pos token)]
      (set! dc (if (nil? dc) (.docComment token) dc))
      (let [^{:tag (List JCTree$JCTypeParameter)} typarams (.typeParametersOpt this)]
        (when (and (.nonEmpty typarams) (== (.-pos mods) Position/NOPOS))
          (set! (.-pos mods) pos)
          (.storeEnd this mods pos))
        (let [^{:tag (List JCTree$JCAnnotation)} annosAfterParams (.annotationsOpt
                                                                    this
                                                                    JCTree$Tag/ANNOTATION)]
          (when (.nonEmpty annosAfterParams)
            (set! (.-annotations mods) (.appendList (.-annotations mods) annosAfterParams))
            (when (== (.-pos mods) Position/NOPOS)
              (set! (.-pos mods) (.-pos (cast JCTree$JCAnnotation (.-head (.-annotations mods)))))))
          (set! pos (.-pos token))
          (let [^:mutable ^JCTree$JCExpression type nil
                isVoid (identical? (.-kind token) Tokens$TokenKind/VOID)]
            (if isVoid
                (do
                  (set! type
                        (cast JCTree$JCExpression (.to this (.TypeIdent (.at F pos) TypeTag/VOID))))
                  (.nextToken this))
                (set! type (.unannotatedType this false)))
            (if (identical? (.-kind token) Tokens$TokenKind/IDENTIFIER)
                (do
                  (set! pos (.-pos token))
                  (let [name (.ident this)]
                    (when (identical? (.-kind token) Tokens$TokenKind/LPAREN)
                      (return (List/of (.methodDeclaratorRest
                                         this
                                         pos
                                         mods
                                         type
                                         name
                                         typarams
                                         false
                                         isVoid
                                         false
                                         dc))))
                    (when (and (and (not isVoid) (.isEmpty typarams))
                               (or (or (identical? (.-kind token) Tokens$TokenKind/EQ)
                                       (identical? (.-kind token) Tokens$TokenKind/SEMI))
                                   (identical? (.-kind token) Tokens$TokenKind/COMMA)))
                      (let [^{:tag (List JCTree)} defs (.toList
                                                         (.variableDeclaratorsRest
                                                           this
                                                           pos
                                                           mods
                                                           type
                                                           name
                                                           false
                                                           dc
                                                           (ListBuffer.)
                                                           false))]
                        (.accept this Tokens$TokenKind/SEMI)
                        (.storeEnd this (cast JCTree (.last defs)) (.-endPos (.prevToken S)))
                        (return defs)))))
                (when (and (identical? (.-kind token) Tokens$TokenKind/LPAREN)
                           (.hasTag type JCTree$Tag/IDENT))
                  (.error log
                          JCDiagnostic$DiagnosticFlag/SYNTAX
                          pos
                          CompilerProperties$Errors/InvalidMethDeclRetTypeReq)
                  (return (List/of (.methodDeclaratorRest
                                     this
                                     pos
                                     mods
                                     nil
                                     (.-init names)
                                     typarams
                                     false
                                     true
                                     false
                                     dc)))))
            (List/of (.Erroneous F)))))))

  (method ^:protected isDeclaration ^boolean [this]
    (.isDeclaration this allowRecords))

  (method ^:private isDeclaration ^boolean [this ^boolean allowRecords]
    (or (or (or (identical? (.-kind token) Tokens$TokenKind/CLASS)
                (identical? (.-kind token) Tokens$TokenKind/INTERFACE))
            (identical? (.-kind token) Tokens$TokenKind/ENUM))
        (and (.isRecordStart this) allowRecords)))

  (method ^:private isDefiniteStatementStartToken ^boolean [this]
    (switch (.-kind token)
      (IF WHILE DO SWITCH RETURN TRY FOR ASSERT BREAK CONTINUE THROW) true
      false))

  (method ^:protected isRecordStart ^boolean [this]
    (if (and (and (identical? (.-kind token) Tokens$TokenKind/IDENTIFIER)
                  (identical? (.name token) (.-record names)))
             (.peekToken this Tokens$TokenKind/IDENTIFIER))
        (do (.checkSourceLevel this Source$Feature/RECORDS) true)
        false))

  (method ^:protected isNonSealedClassStart ^boolean [this ^boolean local]
    (if (.isNonSealedIdentifier this token 0)
        (let [next (.token S 3)] (.allowedAfterSealedOrNonSealed this next local true))
        false))

  (method ^:protected isNonSealedIdentifier ^boolean [this ^Tokens$Token someToken
                                                      ^int lookAheadOffset]
    (when (and (identical? (.name someToken) (.-non names))
               (.peekToken this lookAheadOffset Tokens$TokenKind/SUB Tokens$TokenKind/IDENTIFIER))
      (let [tokenSub (.token S (unchecked-add-int lookAheadOffset 1))
            tokenSealed (.token S (unchecked-add-int lookAheadOffset 2))]
        (when (and (and (== (.-endPos someToken) (.-pos tokenSub))
                        (== (.-endPos tokenSub) (.-pos tokenSealed)))
                   (identical? (.name tokenSealed) (.-sealed names)))
          (.checkSourceLevel this Source$Feature/SEALED_CLASSES)
          (return true))))
    false)

  (method ^:protected isSealedClassStart ^boolean [this ^boolean local]
    (when (identical? (.name token) (.-sealed names))
      (let [next (.token S 1)]
        (when (.allowedAfterSealedOrNonSealed this next local false)
          (.checkSourceLevel this Source$Feature/SEALED_CLASSES)
          (return true))))
    false)

  (method ^:private allowedAfterSealedOrNonSealed ^boolean [this ^Tokens$Token next ^boolean local
                                                            ^boolean currentIsNonSealed]
    (if local
        (switch (.-kind next)
          MONKEYS_AT
            (let [afterNext (.token S 2)]
              (or (not (identical? (.-kind afterNext) Tokens$TokenKind/INTERFACE))
                  currentIsNonSealed))
          (ABSTRACT FINAL STRICTFP CLASS INTERFACE ENUM) true
          false)
        (switch (.-kind next)
          MONKEYS_AT
            (let [afterNext (.token S 2)]
              (or (not (identical? (.-kind afterNext) Tokens$TokenKind/INTERFACE))
                  currentIsNonSealed))
          (PUBLIC PROTECTED PRIVATE ABSTRACT STATIC FINAL STRICTFP CLASS INTERFACE ENUM) true
          IDENTIFIER
            (or (.isNonSealedIdentifier this next (if currentIsNonSealed 3 1))
                (identical? (.name next) (.-sealed names)))
          false)))

  (method ^:protected methodDeclaratorRest ^JCTree [this ^int pos ^JCTree$JCModifiers mods
                                                    ^:mutable ^JCTree$JCExpression type ^Name name
                                                    ^{:tag (List JCTree$JCTypeParameter)} typarams
                                                    ^boolean isInterface ^boolean isVoid
                                                    ^boolean isRecord ^Tokens$Comment dc]
    (when isInterface
      (when-not (== (bit-and (.-flags mods) Flags/PRIVATE) 0)
        (.checkSourceLevel this Source$Feature/PRIVATE_INTERFACE_METHODS)))
    (let [prevReceiverParam (.-receiverParam this)]
      (try
        (set! (.-receiverParam this) nil)
        (let [^:mutable ^{:tag (List JCTree$JCVariableDecl)} params (List/nil)
              ^:mutable ^{:tag (List JCTree$JCExpression)} thrown (List/nil)
              ^:mutable ^boolean unclosedParameterList false]
          (if (or (or (not isRecord) (not (identical? name (.-init names))))
                  (identical? (.-kind token) Tokens$TokenKind/LPAREN))
              (do
                (set! params (.formalParameters this))
                (set! unclosedParameterList (== (.-pos token) (.-errorEndPos endPosTable)))
                (when-not isVoid (set! type (.bracketsOpt this type)))
                (when (identical? (.-kind token) Tokens$TokenKind/THROWS)
                  (.nextToken this)
                  (set! thrown (.qualidentList this true))))
              (set! unclosedParameterList false))
          (.saveDanglingDocComments this dc)
          (let [^:mutable ^JCTree$JCBlock body nil
                ^:mutable ^JCTree$JCExpression defaultValue nil]
            (if (identical? (.-kind token) Tokens$TokenKind/LBRACE)
                (do (set! body (.block this)) (set! defaultValue nil))
                (do
                  (if (identical? (.-kind token) Tokens$TokenKind/DEFAULT)
                      (do
                        (.accept this Tokens$TokenKind/DEFAULT)
                        (set! defaultValue (.annotationValue this))
                        (.accept this Tokens$TokenKind/SEMI))
                      (do
                        (set! defaultValue nil)
                        (.accept this
                                 Tokens$TokenKind/SEMI
                                 (lambda Function ^JCDiagnostic$Error [^Tokens$TokenKind tk]
                                   (CompilerProperties$Errors/Expected2
                                     Tokens$TokenKind/LBRACE
                                     Tokens$TokenKind/SEMI)))))
                  (when (<= (.-pos token) (.-errorEndPos endPosTable))
                    (let [parseAsBlock (.openingBraceMissing this unclosedParameterList)]
                      (when parseAsBlock (set! body (.block this)))))))
            (let [result (cast JCTree$JCMethodDecl
                               (.toP this
                                     (.MethodDef
                                       (.at F pos)
                                       mods
                                       name
                                       type
                                       typarams
                                       receiverParam
                                       params
                                       thrown
                                       body
                                       defaultValue)))]
              (.attach this result dc))))
        (finally (set! (.-receiverParam this) prevReceiverParam)))))

  (method ^:private openingBraceMissing ^boolean [this ^boolean unclosedParameterList]
    (.skip this false true (not unclosedParameterList) (not unclosedParameterList))
    (arbace.core/cond (identical? (.-kind token) Tokens$TokenKind/LBRACE)
                      true
                      unclosedParameterList
                      false
                      :else
                      (switch (.-kind token)
                        (CASE DEFAULT
                              IF
                              FOR
                              WHILE
                              DO
                              TRY
                              SWITCH
                              RETURN
                              THROW
                              BREAK
                              CONTINUE
                              ELSE
                              FINALLY
                              CATCH
                              THIS
                              SUPER
                              NEW)
                          true
                        RBRACE
                          (let [^:mutable ^int braceBalance 1
                                virtualScanner (VirtualParser$VirtualScanner. S)]
                            (.nextToken virtualScanner)
                            (while (not (identical?
                                          (.-kind (.token virtualScanner))
                                          Tokens$TokenKind/EOF))
                              (switch (.-kind (.token virtualScanner))
                                LBRACE (set! braceBalance (unchecked-inc-int braceBalance))
                                RBRACE (set! braceBalance (unchecked-dec-int braceBalance)))
                              (.nextToken virtualScanner))
                            (== braceBalance 0))
                        (let [^JavacParser speculative (VirtualParser. this)
                              speculativeResult (.block speculative)]
                          (if (not (.isEmpty (.-stats speculativeResult)))
                              (let [last (cast JCTree$JCStatement
                                               (.last (.-stats speculativeResult)))]
                                (or (not (.allMatch
                                           (.stream (.-stats speculativeResult))
                                           (lambda Predicate ^boolean [^JCTree$JCStatement s]
                                             (or
                                               (or
                                                 (or
                                                   (.hasTag s JCTree$Tag/VARDEF)
                                                   (.hasTag s JCTree$Tag/CLASSDEF))
                                                 (.hasTag s JCTree$Tag/BLOCK))
                                               (identical? s last)))))
                                    (not (if-instance [^JCTree$JCExpressionStatement exprStatement
                                                         last]
                                           (.hasTag (.-expr exprStatement) JCTree$Tag/ERRONEOUS)
                                           false))))
                              false)))))

  (method qualidentList ^{:tag (List JCTree$JCExpression)} [this ^boolean allowAnnos]
    (let [^{:tag (ListBuffer JCTree$JCExpression)} ts (ListBuffer.)
          ^:mutable ^{:tag (List JCTree$JCAnnotation)} typeAnnos (if allowAnnos
                                                                     (.typeAnnotationsOpt this)
                                                                     (List/nil))
          ^:mutable qi (.qualident this allowAnnos)]
      (if (not (.isEmpty typeAnnos))
          (let [at (.insertAnnotationsToMostInner this qi typeAnnos false)] (.append ts at))
          (.append ts qi))
      (while (identical? (.-kind token) Tokens$TokenKind/COMMA)
        (.nextToken this)
        (set! typeAnnos (if allowAnnos (.typeAnnotationsOpt this) (List/nil)))
        (set! qi (.qualident this allowAnnos))
        (if (not (.isEmpty typeAnnos))
            (let [at (.insertAnnotationsToMostInner this qi typeAnnos false)] (.append ts at))
            (.append ts qi)))
      (.toList ts)))

  (method ^:protected typeParametersOpt ^{:tag (List JCTree$JCTypeParameter)} [this]
    (.typeParametersOpt this false))

  (method ^:protected typeParametersOpt ^{:tag (List JCTree$JCTypeParameter)} [this
                                                                               ^boolean parseEmpty]
    (if (identical? (.-kind token) Tokens$TokenKind/LT)
        (let [^{:tag (ListBuffer JCTree$JCTypeParameter)} typarams (ListBuffer.)]
          (.nextToken this)
          (if (and parseEmpty (identical? (.-kind token) Tokens$TokenKind/GT))
              (do (.accept this Tokens$TokenKind/GT) nil)
              (do
                (.append typarams (.typeParameter this))
                (while (identical? (.-kind token) Tokens$TokenKind/COMMA)
                  (.nextToken this)
                  (.append typarams (.typeParameter this)))
                (.accept this Tokens$TokenKind/GT)
                (.toList typarams))))
        (List/nil)))

  (method typeParameter ^JCTree$JCTypeParameter [this]
    (let [pos (.-pos token)
          ^{:tag (List JCTree$JCAnnotation)} annos (.typeAnnotationsOpt this)
          name (.typeName this)
          ^{:tag (ListBuffer JCTree$JCExpression)} bounds (ListBuffer.)]
      (when (identical? (.-kind token) Tokens$TokenKind/EXTENDS)
        (.nextToken this)
        (.append bounds (.parseType this))
        (while (identical? (.-kind token) Tokens$TokenKind/AMP)
          (.nextToken this)
          (.append bounds (.parseType this))))
      (cast JCTree$JCTypeParameter
            (.toP this (.TypeParameter (.at F pos) name (.toList bounds) annos)))))

  (method formalParameters ^{:tag (List JCTree$JCVariableDecl)} [this]
    (.formalParameters this false false))

  (method formalParameters ^{:tag (List JCTree$JCVariableDecl)} [this ^boolean lambdaParameters
                                                                 ^boolean recordComponents]
    (let [^{:tag (ListBuffer JCTree$JCVariableDecl)} params (ListBuffer.)
          ^:mutable ^JCTree$JCVariableDecl lastParam nil]
      (.accept this Tokens$TokenKind/LPAREN)
      (when-not (identical? (.-kind token) Tokens$TokenKind/RPAREN)
        (set! (.-allowThisIdent this) (and (not lambdaParameters) (not recordComponents)))
        (set! lastParam (.formalParameter this lambdaParameters recordComponents))
        (if (some? (.-nameexpr lastParam))
            (set! (.-receiverParam this) lastParam)
            (.append params lastParam))
        (set! (.-allowThisIdent this) false)
        (while (identical? (.-kind token) Tokens$TokenKind/COMMA)
          (when-not (== (bit-and (.-flags (.-mods lastParam)) Flags/VARARGS) 0)
            (.error log
                    JCDiagnostic$DiagnosticFlag/SYNTAX
                    lastParam
                    CompilerProperties$Errors/VarargsMustBeLast))
          (.nextToken this)
          (.append params
                   (set! lastParam (.formalParameter this lambdaParameters recordComponents)))))
      (if (identical? (.-kind token) Tokens$TokenKind/RPAREN)
          (.nextToken this)
          (do
            (.setErrorEndPos this (.-pos token))
            (.reportSyntaxError this
                                (.-endPos (.prevToken S))
                                (CompilerProperties$Errors/Expected3
                                  Tokens$TokenKind/COMMA
                                  Tokens$TokenKind/RPAREN
                                  Tokens$TokenKind/LBRACKET))))
      (.toList params)))

  (method implicitParameters ^{:tag (List JCTree$JCVariableDecl)} [this ^boolean hasParens]
    (when hasParens (.accept this Tokens$TokenKind/LPAREN))
    (let [^{:tag (ListBuffer JCTree$JCVariableDecl)} params (ListBuffer.)]
      (when (and (not (identical? (.-kind token) Tokens$TokenKind/RPAREN))
                 (not (identical? (.-kind token) Tokens$TokenKind/ARROW)))
        (.append params (.implicitParameter this))
        (while (identical? (.-kind token) Tokens$TokenKind/COMMA)
          (.nextToken this)
          (.append params (.implicitParameter this))))
      (when hasParens (.accept this Tokens$TokenKind/RPAREN))
      (.toList params)))

  (method optFinal ^JCTree$JCModifiers [this ^long flags]
    (let [mods (.modifiersOpt this)]
      (.checkNoMods
        this
        (bit-and (.-flags mods) (bit-not-int (bit-or-int Flags/FINAL Flags/DEPRECATED))))
      (set! (.-flags mods) (bit-or (.-flags mods) flags))
      mods))

  (method ^:private insertAnnotationsToMostInner ^JCTree$JCExpression [this
                                                                       ^JCTree$JCExpression type
                                                                       ^{:tag (List JCTree$JCAnnotation)} annos
                                                                       ^boolean createNewLevel]
    (let [^:mutable origEndPos (.getEndPos this type)
          ^:mutable mostInnerType type
          ^:mutable ^JCTree$JCArrayTypeTree mostInnerArrayType nil]
      (while (.hasTag (TreeInfo/typeIn mostInnerType) JCTree$Tag/TYPEARRAY)
        (set! mostInnerArrayType (cast JCTree$JCArrayTypeTree (TreeInfo/typeIn mostInnerType)))
        (set! mostInnerType (.-elemtype mostInnerArrayType)))
      (when createNewLevel
        (set!
          mostInnerType
          (cast JCTree$JCExpression (.to this (.TypeArray (.at F (.-pos token)) mostInnerType))))
        (set! origEndPos (.getEndPos this mostInnerType)))
      (let [^:mutable mostInnerTypeToReturn mostInnerType]
        (when (.nonEmpty annos)
          (let [^:mutable lastToModify mostInnerType]
            (while (or (.hasTag (TreeInfo/typeIn mostInnerType) JCTree$Tag/SELECT)
                       (.hasTag (TreeInfo/typeIn mostInnerType) JCTree$Tag/TYPEAPPLY))
              (while (.hasTag (TreeInfo/typeIn mostInnerType) JCTree$Tag/SELECT)
                (set! lastToModify mostInnerType)
                (set! mostInnerType
                      (.getExpression (cast JCTree$JCFieldAccess (TreeInfo/typeIn mostInnerType)))))
              (while (.hasTag (TreeInfo/typeIn mostInnerType) JCTree$Tag/TYPEAPPLY)
                (set! lastToModify mostInnerType)
                (set! mostInnerType
                      (.-clazz (cast JCTree$JCTypeApply (TreeInfo/typeIn mostInnerType))))))
            (set! mostInnerType
                  (.AnnotatedType (.at F (.-pos (cast JCTree$JCAnnotation (.-head annos))))
                                  annos
                                  mostInnerType))
            (arbace.core/cond (.hasTag (TreeInfo/typeIn lastToModify) JCTree$Tag/TYPEAPPLY)
                              (set! (.-clazz (cast
                                               JCTree$JCTypeApply
                                               (TreeInfo/typeIn lastToModify)))
                                    mostInnerType)
                              (.hasTag (TreeInfo/typeIn lastToModify) JCTree$Tag/SELECT)
                              (set! (.-selected (cast
                                                  JCTree$JCFieldAccess
                                                  (TreeInfo/typeIn lastToModify)))
                                    mostInnerType)
                              :else
                              (set! mostInnerTypeToReturn mostInnerType))))
        (if (nil? mostInnerArrayType)
            mostInnerTypeToReturn
            (do
              (set! (.-elemtype mostInnerArrayType) mostInnerTypeToReturn)
              (cast JCTree$JCExpression (.storeEnd this type origEndPos)))))))

  (method ^:protected formalParameter ^JCTree$JCVariableDecl [this ^boolean lambdaParameter
                                                              ^boolean recordComponent]
    (let [^JCTree$JCModifiers mods (if (not recordComponent)
                                       (.optFinal this Flags/PARAMETER)
                                       (.modifiersOpt this))]
      (when (and recordComponent (not (== (.-flags mods) 0)))
        (.error log (.-pos mods) CompilerProperties$Errors/RecordCantDeclareFieldModifiers))
      (when recordComponent
        (set! (.-flags mods)
              (bit-or (.-flags mods)
                      (bit-or (bit-or (bit-or Flags/RECORD Flags/FINAL) Flags/PRIVATE)
                              Flags/GENERATED_MEMBER))))
      (set! (.-permitTypeAnnotationsPushBack this) true)
      (let [^:mutable type (.parseType this lambdaParameter)]
        (set! (.-permitTypeAnnotationsPushBack this) false)
        (if (identical? (.-kind token) Tokens$TokenKind/ELLIPSIS)
            (let [^{:tag (List JCTree$JCAnnotation)} varargsAnnos typeAnnotationsPushedBack]
              (set! typeAnnotationsPushedBack (List/nil))
              (set! (.-flags mods) (bit-or (.-flags mods) Flags/VARARGS))
              (set! type (.insertAnnotationsToMostInner this type varargsAnnos true))
              (.nextToken this))
            (do
              (when (.nonEmpty typeAnnotationsPushedBack)
                (.reportSyntaxError this
                                    (.-pos (cast
                                             JCTree$JCAnnotation
                                             (.-head typeAnnotationsPushedBack)))
                                    CompilerProperties$Errors/IllegalStartOfType))
              (set! typeAnnotationsPushedBack (List/nil))))
        (.variableDeclaratorId this mods type false lambdaParameter recordComponent))))

  (method ^:protected implicitParameter ^JCTree$JCVariableDecl [this]
    (let [mods (.Modifiers (.at F (.-pos token)) Flags/PARAMETER)]
      (.variableDeclaratorId this mods nil false true false)))

  (method ^:protected checkExprStat ^JCTree$JCExpression [this ^JCTree$JCExpression t]
    (if (not (TreeInfo/isExpressionStatement t))
        (let [^JCTree$JCExpression ret (.Erroneous (.at F (.-pos t)) (List/of t))]
          (.error log JCDiagnostic$DiagnosticFlag/SYNTAX ret CompilerProperties$Errors/NotStmt)
          ret)
        t))

  (method ^:static prec ^int [^Tokens$TokenKind token]
    (let [oc (JavacParser/optag token)]
      (if (not (identical? oc JCTree$Tag/NO_TAG)) (TreeInfo/opPrec oc) -1)))

  (method ^:static earlier ^int [^int pos1 ^int pos2]
    (if (== pos1 Position/NOPOS)
        pos2
        (arbace.core/cond (== pos2 Position/NOPOS) pos1 (< pos1 pos2) pos1 :else pos2)))

  (method ^:static optag ^JCTree$Tag [^Tokens$TokenKind token]
    (switch token
      BARBAR JCTree$Tag/OR
      AMPAMP JCTree$Tag/AND
      BAR JCTree$Tag/BITOR
      BAREQ JCTree$Tag/BITOR_ASG
      CARET JCTree$Tag/BITXOR
      CARETEQ JCTree$Tag/BITXOR_ASG
      AMP JCTree$Tag/BITAND
      AMPEQ JCTree$Tag/BITAND_ASG
      EQEQ JCTree$Tag/EQ
      BANGEQ JCTree$Tag/NE
      LT JCTree$Tag/LT
      GT JCTree$Tag/GT
      LTEQ JCTree$Tag/LE
      GTEQ JCTree$Tag/GE
      LTLT JCTree$Tag/SL
      LTLTEQ JCTree$Tag/SL_ASG
      GTGT JCTree$Tag/SR
      GTGTEQ JCTree$Tag/SR_ASG
      GTGTGT JCTree$Tag/USR
      GTGTGTEQ JCTree$Tag/USR_ASG
      PLUS JCTree$Tag/PLUS
      PLUSEQ JCTree$Tag/PLUS_ASG
      SUB JCTree$Tag/MINUS
      SUBEQ JCTree$Tag/MINUS_ASG
      STAR JCTree$Tag/MUL
      STAREQ JCTree$Tag/MUL_ASG
      SLASH JCTree$Tag/DIV
      SLASHEQ JCTree$Tag/DIV_ASG
      PERCENT JCTree$Tag/MOD
      PERCENTEQ JCTree$Tag/MOD_ASG
      INSTANCEOF JCTree$Tag/TYPETEST
      JCTree$Tag/NO_TAG))

  (method ^:static unoptag ^JCTree$Tag [^Tokens$TokenKind token]
    (switch token
      PLUS JCTree$Tag/POS
      SUB JCTree$Tag/NEG
      BANG JCTree$Tag/NOT
      TILDE JCTree$Tag/COMPL
      PLUSPLUS JCTree$Tag/PREINC
      SUBSUB JCTree$Tag/PREDEC
      JCTree$Tag/NO_TAG))

  (method ^:static typetag ^TypeTag [^Tokens$TokenKind token]
    (switch token
      BYTE TypeTag/BYTE
      CHAR TypeTag/CHAR
      SHORT TypeTag/SHORT
      INT TypeTag/INT
      LONG TypeTag/LONG
      FLOAT TypeTag/FLOAT
      DOUBLE TypeTag/DOUBLE
      BOOLEAN TypeTag/BOOLEAN
      TypeTag/NONE))

  (method checkSourceLevel ^void [this ^Source$Feature feature]
    (.checkSourceLevel this (.-pos token) feature))

  (method ^:protected checkSourceLevel ^void [this ^int pos ^Source$Feature feature]
    (if (and (.isPreview preview feature) (not (.isEnabled preview)))
        (.error log pos (.disabledError preview feature))
        (arbace.core/cond (not (.allowedInSource feature source))
                          (.error log pos (.error feature (.-name source)))
                          (.isPreview preview feature)
                          (.warnPreview preview pos feature))))

  (method ^:private updateUnexpectedTopLevelDefinitionStartError ^void [this ^boolean hasPackageDecl]
    (if parseModuleInfo
        (set! unexpectedTopLevelDefinitionStartError CompilerProperties$Errors/ExpectedModuleOrOpen)
        (arbace.core/cond
          (and (.allowedInSource Source$Feature/IMPLICIT_CLASSES source) (not hasPackageDecl))
          (set! unexpectedTopLevelDefinitionStartError
                CompilerProperties$Errors/ClassMethodOrFieldExpected)
          allowRecords
          (set! unexpectedTopLevelDefinitionStartError
                (CompilerProperties$Errors/Expected4
                  Tokens$TokenKind/CLASS
                  Tokens$TokenKind/INTERFACE
                  Tokens$TokenKind/ENUM
                  "record"))
          :else
          (set! unexpectedTopLevelDefinitionStartError
                (CompilerProperties$Errors/Expected3
                  Tokens$TokenKind/CLASS
                  Tokens$TokenKind/INTERFACE
                  Tokens$TokenKind/ENUM)))))

  (defclass ^:protected ^:static SimpleEndPosTable
    :extends AbstractEndPosTable

    (field ^:private ^:final ^IntHashTable endPosMap (IntHashTable.))

    (method ^:public storeEnd :type-params [(T extends JCTree)] ^T [this ^T tree ^int endpos]
      (.put endPosMap tree (Math/max endpos (.-errorEndPos this)))
      tree)

    (method ^:public getEndPos ^int [this ^JCTree tree]
      (let [value (.get endPosMap tree)] (if (== value -1) Position/NOPOS value)))

    (method ^:public replaceTree ^int [this ^JCTree oldTree ^JCTree newTree]
      (let [pos (.remove endPosMap oldTree)]
        (when (and (not (== pos -1)) (some? newTree)) (.storeEnd this newTree pos))
        pos)))

  (defclass ^:protected ^:static MinimalEndPosTable
    :extends SimpleEndPosTable

    (method ^:public storeEnd :type-params [(T extends JCTree)] ^T [this ^T tree ^int endpos]
      (switch (.getTag tree) (MODULEDEF PACKAGEDEF CLASSDEF METHODDEF VARDEF) nil (return tree))
      (.storeEnd super tree endpos)))

  (defclass ^:protected ^:abstract ^:static AbstractEndPosTable
    :implements [EndPosTable]

    (field ^:public ^int errorEndPos Position/NOPOS)

    (method ^:public setErrorEndPos ^void [this ^int errPos]
      (when (> errPos errorEndPos) (set! errorEndPos errPos)))))

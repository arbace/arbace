            (.scanStat this (.-body tree))
            (set! (.-canCompleteNormally tree) (not (identical? alive Liveness/DEAD)))
            (finally (set! (.-pendingExits this) prevPending) (set! alive prevAlive))))))

    (method ^:public visitModuleDef ^void [this ^JCTree$JCModuleDecl tree])

    (method ^:public analyzeTree ^void [this ^{:tag (Env AttrContext)} env ^TreeMaker make]
      (.analyzeTree this env (.-tree env) make))

    (method ^:public analyzeTree ^void [this ^{:tag (Env AttrContext)} env ^JCTree tree
                                        ^TreeMaker make]
      (try
        (set! attrEnv env)
        (set! (.-make Flow/this) make)
        (set! (.-pendingExits this) (ListBuffer.))
        (set! alive Liveness/ALIVE)
        (.scan this tree)
        (finally (set! (.-pendingExits this) nil) (set! (.-make Flow/this) nil)))))

  (defclass FlowAnalyzer
    :extends BaseAnalyzer

    (field ^{:tag (HashMap Symbol (List Type))} preciseRethrowTypes)

    (field ^JCTree$JCClassDecl classDef)

    (field ^{:tag (List Type)} thrown)

    (field ^{:tag (List Type)} caught)

    (defclass ThrownPendingExit
      :extends Flow$BaseAnalyzer$PendingExit

      (field ^Type thrown)

      (constructor [this ^JCTree tree ^Type thrown]
        (super. tree)
        (set! (.-thrown this) thrown)))

    (method markDead ^void [this])

    (method errorUncaught ^void [this]
      (loop [exit (cast Flow$BaseAnalyzer$PendingExit (.next (.-pendingExits this)))]
        (when (some? exit)
          (if-instance [^ThrownPendingExit thrownExit exit]
            (cond
              (and (some? classDef) (== (.-pos classDef) (.-pos (.-tree exit))))
                (do
                  (.error log
                          (.pos (.-tree exit))
                          (CompilerProperties$Errors/UnreportedExceptionDefaultConstructor
                            (.-thrown thrownExit)))
                  (recur (cast Flow$BaseAnalyzer$PendingExit (.next (.-pendingExits this)))))
              (and (.hasTag (.-tree exit) JCTree$Tag/VARDEF)
                   (.isResourceVariable (.-sym (cast JCTree$JCVariableDecl (.-tree exit)))))
                (do
                  (.error log
                          (.pos (.-tree exit))
                          (CompilerProperties$Errors/UnreportedExceptionImplicitClose
                            (.-thrown thrownExit)
                            (.-name (.-sym (cast JCTree$JCVariableDecl (.-tree exit))))))
                  (recur (cast Flow$BaseAnalyzer$PendingExit (.next (.-pendingExits this)))))
              :else
                (do
                  (.error log
                          (.pos (.-tree exit))
                          (CompilerProperties$Errors/UnreportedExceptionNeedToCatchOrThrow
                            (.-thrown thrownExit)))
                  (recur (cast Flow$BaseAnalyzer$PendingExit (.next (.-pendingExits this))))))
            (do
              (Assert/check (.hasErrorOn log (.pos (.-tree exit))))
              (recur (cast Flow$BaseAnalyzer$PendingExit (.next (.-pendingExits this)))))))))

    (method markThrown ^void [this ^JCTree tree ^Type exc]
      (when-not (.isUnchecked chk (.pos tree) exc)
        (when-not (.isHandled chk exc caught)
          (.append (.-pendingExits this) (ThrownPendingExit. tree exc)))
        (set! thrown (.incl chk exc thrown))))

    (method ^:public visitClassDef ^void [this ^JCTree$JCClassDecl tree]
      (when (some? (.-sym tree))
        (let [classDefPrev classDef
              ^:mutable ^{:tag (List Type)} thrownPrev thrown
              ^{:tag (List Type)} caughtPrev caught
              ^{:tag (ListBuffer Flow$BaseAnalyzer$PendingExit)} pendingExitsPrev (.-pendingExits
                                                                                    this)
              anonymousClass (identical? (.-name tree) (.-empty names))]
          (set! (.-pendingExits this) (ListBuffer.))
          (when-not anonymousClass (set! caught (List/nil)))
          (set! classDef tree)
          (set! thrown (List/nil))
          (try
            (loop [^{:tag (List JCTree)} l (.-defs tree)]
              (if (.nonEmpty l)
                  (if (.hasTag (cast JCTree (.-head l)) JCTree$Tag/CLASSDEF)
                      (do (.scan this (cast JCTree (.-head l))) (recur (.-tail l)))
                      (recur (.-tail l)))
                  nil))
            (.forEachInitializer this
                                 tree
                                 true
                                 (lambda Consumer ^void [^JCTree def]
                                   (.scan this def)
                                   (.errorUncaught this)))
            (when anonymousClass
              (loop [^{:tag (List JCTree)} l (.-defs tree)]
                (if (.nonEmpty l)
                    (if (TreeInfo/isConstructor (cast JCTree (.-head l)))
                        (let [mdef (cast JCTree$JCMethodDecl (.-head l))]
                          (.scan this mdef)
                          (set! (.-thrown mdef) (.Types make thrown))
                          (set! (.-type (.-sym mdef))
                                (.createMethodTypeWithThrown types (.-type (.-sym mdef)) thrown))
                          (recur (.-tail l)))
                        (recur (.-tail l)))
                    nil))
              (set! thrownPrev (.union chk thrown thrownPrev)))
            (loop [^{:tag (List JCTree)} l (.-defs tree)]
              (when (.nonEmpty l)
                (cond
                  (and anonymousClass (TreeInfo/isConstructor (cast JCTree (.-head l))))
                    (recur (.-tail l))
                  (.hasTag (cast JCTree (.-head l)) JCTree$Tag/METHODDEF)
                    (do
                      (.scan this (cast JCTree (.-head l)))
                      (.errorUncaught this)
                      (recur (.-tail l)))
                  :else (recur (.-tail l)))))
            (set! thrown thrownPrev)
            (finally
              (set! (.-pendingExits this) pendingExitsPrev)
              (set! caught caughtPrev)
              (set! classDef classDefPrev))))))

    (method ^:public visitMethodDef ^void [this ^JCTree$JCMethodDecl tree]
      (when (some? (.-body tree))
        (let [^{:tag (List Type)} caughtPrev caught
              ^{:tag (List Type)} mthrown (.getThrownTypes (.-type (.-sym tree)))]
          (Assert/check (.isEmpty (.-pendingExits this)))
          (try
            (loop [^{:tag (List JCTree$JCVariableDecl)} l (.-params tree)]
              (when (.nonEmpty l)
                (let [def (cast JCTree$JCVariableDecl (.-head l))]
                  (.scan this def)
                  (recur (.-tail l)))))
            (if (TreeInfo/hasConstructorCall tree (.-_super names))
                (set! caught (.union chk caught mthrown))
                (when-not (== (bit-and (.flags (.-sym tree)) (bit-or-int Flags/BLOCK Flags/STATIC))
                              Flags/BLOCK)
                  (set! caught mthrown)))
            (.scan this (.-body tree))
            (let [^:mutable ^{:tag (List Flow$BaseAnalyzer$PendingExit)} exits (.toList
                                                                                 (.-pendingExits
                                                                                   this))]
              (set! (.-pendingExits this) (ListBuffer.))
              (while (.nonEmpty exits)
                (let [exit (cast Flow$BaseAnalyzer$PendingExit (.-head exits))]
                  (set! exits (.-tail exits))
                  (if (not (instance? ThrownPendingExit exit))
                      (Assert/check (or (.hasTag (.-tree exit) JCTree$Tag/RETURN)
                                        (.hasErrorOn log (.pos (.-tree exit)))))
                      (.append (.-pendingExits this) exit)))))
            (finally (set! caught caughtPrev))))))

    (method ^:public visitVarDef ^void [this ^JCTree$JCVariableDecl tree]
      (.scan this (.-init tree)))

    (method ^:public visitBlock ^void [this ^JCTree$JCBlock tree]
      (.scan this (.-stats tree)))

    (method ^:public visitDoLoop ^void [this ^JCTree$JCDoWhileLoop tree]
      (let [^{:tag (ListBuffer Flow$BaseAnalyzer$PendingExit)} prevPendingExits (.-pendingExits
                                                                                  this)]
        (set! (.-pendingExits this) (ListBuffer.))
        (.scan this (.-body tree))
        (.resolveContinues this tree)
        (.scan this (.-cond tree))
        (.resolveBreaks this tree prevPendingExits)))

    (method ^:public visitWhileLoop ^void [this ^JCTree$JCWhileLoop tree]
      (let [^{:tag (ListBuffer Flow$BaseAnalyzer$PendingExit)} prevPendingExits (.-pendingExits
                                                                                  this)]
        (set! (.-pendingExits this) (ListBuffer.))
        (.scan this (.-cond tree))
        (.scan this (.-body tree))
        (.resolveContinues this tree)
        (.resolveBreaks this tree prevPendingExits)))

    (method ^:public visitForLoop ^void [this ^JCTree$JCForLoop tree]
      (let [^{:tag (ListBuffer Flow$BaseAnalyzer$PendingExit)} prevPendingExits (.-pendingExits
                                                                                  this)]
        (.scan this (.-init tree))
        (set! (.-pendingExits this) (ListBuffer.))
        (when (some? (.-cond tree)) (.scan this (.-cond tree)))
        (.scan this (.-body tree))
        (.resolveContinues this tree)
        (.scan this (.-step tree))
        (.resolveBreaks this tree prevPendingExits)))

    (method ^:public visitForeachLoop ^void [this ^JCTree$JCEnhancedForLoop tree]
      (.visitVarDef this (.-var tree))
      (let [^{:tag (ListBuffer Flow$BaseAnalyzer$PendingExit)} prevPendingExits (.-pendingExits
                                                                                  this)]
        (.scan this (.-expr tree))
        (set! (.-pendingExits this) (ListBuffer.))
        (.scan this (.-body tree))
        (.resolveContinues this tree)
        (.resolveBreaks this tree prevPendingExits)))

    (method ^:public visitLabelled ^void [this ^JCTree$JCLabeledStatement tree]
      (let [^{:tag (ListBuffer Flow$BaseAnalyzer$PendingExit)} prevPendingExits (.-pendingExits
                                                                                  this)]
        (set! (.-pendingExits this) (ListBuffer.))
        (.scan this (.-body tree))
        (.resolveBreaks this tree prevPendingExits)))

    (method ^:public visitSwitch ^void [this ^JCTree$JCSwitch tree]
      (.handleSwitch this tree (.-selector tree) (.-cases tree)))

    (method ^:public visitSwitchExpression ^void [this ^JCTree$JCSwitchExpression tree]
      (.handleSwitch this tree (.-selector tree) (.-cases tree)))

    (method ^:private handleSwitch ^void [this ^JCTree tree ^JCTree$JCExpression selector
                                          ^{:tag (List JCTree$JCCase)} cases]
      (let [^{:tag (ListBuffer Flow$BaseAnalyzer$PendingExit)} prevPendingExits (.-pendingExits
                                                                                  this)]
        (set! (.-pendingExits this) (ListBuffer.))
        (.scan this selector)
        (loop [^{:tag (List JCTree$JCCase)} l cases]
          (when (.nonEmpty l)
            (let [c (cast JCTree$JCCase (.-head l))]
              (.scan this (.-labels c))
              (.scan this (.-stats c))
              (recur (.-tail l)))))
        (if (.hasTag tree JCTree$Tag/SWITCH_EXPRESSION)
            (.resolveYields this tree prevPendingExits)
            (.resolveBreaks this tree prevPendingExits))))

    (method ^:public visitTry ^void [this ^JCTree$JCTry tree]
      (let [^{:tag (List Type)} caughtPrev caught
            ^{:tag (List Type)} thrownPrev thrown]
        (set! thrown (List/nil))
        (loop [^{:tag (List JCTree$JCCatch)} l (.-catchers tree)]
          (when (.nonEmpty l)
            (let [^{:tag (List JCTree$JCExpression)} subClauses (if (TreeInfo/isMultiCatch
                                                                      (cast
                                                                        JCTree$JCCatch
                                                                        (.-head l)))
                                                                    (.-alternatives
                                                                      (cast
                                                                        JCTree$JCTypeUnion
                                                                        (.-vartype
                                                                          (.-param
                                                                            (cast
                                                                              JCTree$JCCatch
                                                                              (.-head l))))))
                                                                    (List/of
                                                                      (.-vartype
                                                                        (.-param
                                                                          (cast
                                                                            JCTree$JCCatch
                                                                            (.-head l))))))]
              (for-each [^JCTree$JCExpression ct subClauses]
                (set! caught (.incl chk (.-type ct) caught)))
              (recur (.-tail l)))))
        (let [^{:tag (ListBuffer Flow$BaseAnalyzer$PendingExit)} prevPendingExits (.-pendingExits
                                                                                    this)]
          (set! (.-pendingExits this) (ListBuffer.))
          (for-each [^JCTree resource (.-resources tree)]
            (if-instance [^JCTree$JCVariableDecl variableDecl resource]
              (.visitVarDef this variableDecl)
              (if-instance [^JCTree$JCExpression expression resource]
                (.scan this expression)
                (throw (AssertionError. tree)))))
          (for-each [^JCTree resource (.-resources tree)]
            (let [^{:tag (List Type)} closeableSupertypes (if (.isCompound (.-type resource))
                                                              (.prepend
                                                                (.interfaces
                                                                  types
                                                                  (.-type resource))
                                                                (.supertype types (.-type resource)))
                                                              (List/of (.-type resource)))]
              (for-each [^Type sup closeableSupertypes]
                (when (some? (.asSuper types sup (.-tsym (.-autoCloseableType syms))))
                  (let [closeMethod (.resolveQualifiedMethod
                                      rs
                                      tree
                                      attrEnv
                                      (.skipTypeVars types sup false)
                                      (.-close names)
                                      (List/nil)
                                      (List/nil))
                        mt (.memberType types (.-type resource) closeMethod)]
                    (when (identical? (.-kind closeMethod) Kinds$Kind/MTH)
                      (for-each [^Type t (.getThrownTypes mt)] (.markThrown this resource t))))))))
          (.scan this (.-body tree))
          (let [^{:tag (List Type)} thrownInTry (.union
                                                  chk
                                                  thrown
                                                  (List/of
                                                    (.-runtimeExceptionType syms)
                                                    (.-errorType syms)))]
            (set! thrown thrownPrev)
            (set! caught caughtPrev)
            (let [^:mutable ^{:tag (List Type)} caughtInTry (List/nil)]
              (loop [^{:tag (List JCTree$JCCatch)} l (.-catchers tree)]
                (when (.nonEmpty l)
                  (let [param (.-param (cast JCTree$JCCatch (.-head l)))
                        ^{:tag (List JCTree$JCExpression)} subClauses (if (TreeInfo/isMultiCatch
                                                                            (cast
                                                                              JCTree$JCCatch
                                                                              (.-head l)))
                                                                          (.-alternatives
                                                                            (cast
                                                                              JCTree$JCTypeUnion
                                                                              (.-vartype
                                                                                (.-param
                                                                                  (cast
                                                                                    JCTree$JCCatch
                                                                                    (.-head l))))))
                                                                          (List/of
                                                                            (.-vartype
                                                                              (.-param
                                                                                (cast
                                                                                  JCTree$JCCatch
                                                                                  (.-head l))))))
                        ^:mutable ^{:tag (List Type)} ctypes (List/nil)
                        ^{:tag (List Type)} rethrownTypes (.diff chk thrownInTry caughtInTry)]
                    (for-each [^JCTree$JCExpression ct subClauses]
                      (let [exc (.-type ct)]
                        (when-not (identical? exc (.-unknownType syms))
                          (set! ctypes (.append ctypes exc))
                          (when-not (.isSameType types exc (.-objectType syms))
                            (let [^JCDiagnostic$DiagnosticPosition pos (if (> (.size subClauses) 1)
                                                                           (.pos ct)
                                                                           (.pos
                                                                             (cast
                                                                               JCTree$JCCatch
                                                                               (.-head l))))]
                              (.checkCaughtType this pos exc thrownInTry caughtInTry)
                              (set! caughtInTry (.incl chk exc caughtInTry)))))))
                    (.scan this param)
                    (.put preciseRethrowTypes (.-sym param) (.intersect chk ctypes rethrownTypes))
                    (.scan this (.-body (cast JCTree$JCCatch (.-head l))))
                    (.remove preciseRethrowTypes (.-sym param))
                    (recur (.-tail l)))))
              (if (some? (.-finalizer tree))
                  (let [^{:tag (List Type)} savedThrown thrown]
                    (set! thrown (List/nil))
                    (let [^{:tag (ListBuffer Flow$BaseAnalyzer$PendingExit)} exits (.-pendingExits
                                                                                     this)]
                      (set! (.-pendingExits this) prevPendingExits)
                      (.scan this (.-finalizer tree))
                      (if (not (.-finallyCanCompleteNormally tree))
                          (set! thrown (.union chk thrown thrownPrev))
                          (do
                            (set! thrown (.union chk thrown (.diff chk thrownInTry caughtInTry)))
                            (set! thrown (.union chk thrown savedThrown))
                            (while (.nonEmpty exits)
                              (.append (.-pendingExits this)
                                       (cast Flow$BaseAnalyzer$PendingExit (.next exits))))))))
                  (do
                    (set! thrown (.union chk thrown (.diff chk thrownInTry caughtInTry)))
                    (let [^{:tag (ListBuffer Flow$BaseAnalyzer$PendingExit)} exits (.-pendingExits
                                                                                     this)]
                      (set! (.-pendingExits this) prevPendingExits)
                      (while (.nonEmpty exits)
                        (.append (.-pendingExits this)
                                 (cast Flow$BaseAnalyzer$PendingExit (.next exits))))))))))))

    (method ^:public visitIf ^void [this ^JCTree$JCIf tree]
      (.scan this (.-cond tree))
      (.scan this (.-thenpart tree))
      (when (some? (.-elsepart tree)) (.scan this (.-elsepart tree))))

    (method checkCaughtType ^void [this ^JCDiagnostic$DiagnosticPosition pos ^Type exc
                                   ^{:tag (List Type)} thrownInTry ^{:tag (List Type)} caughtInTry]
      (cond
        (.subset chk exc caughtInTry)
          (.error log pos (CompilerProperties$Errors/ExceptAlreadyCaught exc))
        (and (and (not (.isUnchecked chk pos exc)) (not (.isExceptionOrThrowable this exc)))
             (not (.intersects chk exc thrownInTry)))
          (.error log pos (CompilerProperties$Errors/ExceptNeverThrownInTry exc))
        :else
          (let [^{:tag (List Type)} catchableThrownTypes (.intersect chk (List/of exc) thrownInTry)]
            (when (and (.isEmpty (.diff chk catchableThrownTypes caughtInTry))
                       (not (.isExceptionOrThrowable this exc)))
              (let [^JCDiagnostic$Warning key (if (== (.length catchableThrownTypes) 1)
                                                  (CompilerProperties$Warnings/UnreachableCatch
                                                    catchableThrownTypes)
                                                  (CompilerProperties$Warnings/UnreachableCatch1
                                                    catchableThrownTypes))]
                (.warning log pos key))))))

    (method ^:private isExceptionOrThrowable ^boolean [this ^Type exc]
      (or (identical? (.-tsym exc) (.-tsym (.-throwableType syms)))
          (identical? (.-tsym exc) (.-tsym (.-exceptionType syms)))))

    (method ^:public visitBreak ^void [this ^JCTree$JCBreak tree]
      (.recordExit this (Flow$BaseAnalyzer$PendingExit. tree)))

    (method ^:public visitYield ^void [this ^JCTree$JCYield tree]
      (.scan this (.-value tree))
      (.recordExit this (Flow$BaseAnalyzer$PendingExit. tree)))

    (method ^:public visitContinue ^void [this ^JCTree$JCContinue tree]
      (.recordExit this (Flow$BaseAnalyzer$PendingExit. tree)))

    (method ^:public visitReturn ^void [this ^JCTree$JCReturn tree]
      (.scan this (.-expr tree))
      (.recordExit this (Flow$BaseAnalyzer$PendingExit. tree)))

    (method ^:public visitThrow ^void [this ^JCTree$JCThrow tree]
      (.scan this (.-expr tree))
      (let [sym (TreeInfo/symbol (.-expr tree))]
        (if (and (and (and (some? sym) (identical? (.-kind sym) Kinds$Kind/VAR))
                      (not (== (bit-and (.flags sym) (bit-or Flags/FINAL Flags/EFFECTIVELY_FINAL))
                               0)))
                 (some? (.get preciseRethrowTypes sym)))
            (for-each [^Type t (cast List (.get preciseRethrowTypes sym))]
              (.markThrown this tree t))
            (.markThrown this tree (.-type (.-expr tree))))
        (.markDead this)))

    (method ^:public visitApply ^void [this ^JCTree$JCMethodInvocation tree]
      (.scan this (.-meth tree))
      (.scan this (.-args tree))
      (loop [^{:tag (List Type)} l (.getThrownTypes (.-type (.-meth tree)))]
        (when (.nonEmpty l) (.markThrown this tree (cast Type (.-head l))) (recur (.-tail l))))
      (when (identical? (TreeInfo/name (.-meth tree)) (.-_super names))
        (.forEachInitializer this
                             classDef
                             false
                             (lambda Consumer ^void [^JCTree def]
                               (.scan this def)
                               (.errorUncaught this)))))

    (method ^:public visitNewClass ^void [this ^JCTree$JCNewClass tree]
      (.scan this (.-encl tree))
      (.scan this (.-args tree))
      (loop [^{:tag (List Type)} l (.getThrownTypes (.-constructorType tree))]
        (when (.nonEmpty l) (.markThrown this tree (cast Type (.-head l))) (recur (.-tail l))))
      (let [^{:tag (List Type)} caughtPrev caught]
        (try
          (when (some? (.-def tree))
            (loop [^{:tag (List Type)} l (.getThrownTypes (.-type (.-constructor tree)))]
              (when (.nonEmpty l)
                (set! caught (.incl chk (cast Type (.-head l)) caught))
                (recur (.-tail l)))))
          (.scan this (.-def tree))
          (finally (set! caught caughtPrev)))))

    (method ^:public visitLambda ^void [this ^JCTree$JCLambda tree]
      (when-not (and (some? (.-type tree)) (.isErroneous (.-type tree)))
        (let [^{:tag (List Type)} prevCaught caught
              ^{:tag (List Type)} prevThrown thrown
              ^{:tag (ListBuffer Flow$BaseAnalyzer$PendingExit)} prevPending (.-pendingExits this)]
          (try
            (set! (.-pendingExits this) (ListBuffer.))
            (set! caught (.getThrownTypes (.getDescriptorType tree types)))
            (set! thrown (List/nil))
            (.scan this (.-body tree))
            (let [^:mutable ^{:tag (List Flow$BaseAnalyzer$PendingExit)} exits (.toList
                                                                                 (.-pendingExits
                                                                                   this))]
              (set! (.-pendingExits this) (ListBuffer.))
              (while (.nonEmpty exits)
                (let [exit (cast Flow$BaseAnalyzer$PendingExit (.-head exits))]
                  (set! exits (.-tail exits))
                  (if (not (instance? ThrownPendingExit exit))
                      (Assert/check (or (.hasTag (.-tree exit) JCTree$Tag/RETURN)
                                        (.hasErrorOn log (.pos (.-tree exit)))))
                      (.append (.-pendingExits this) exit))))
              (.errorUncaught this))
            (finally
              (set! (.-pendingExits this) prevPending)
              (set! caught prevCaught)
              (set! thrown prevThrown))))))

    (method ^:public visitModuleDef ^void [this ^JCTree$JCModuleDecl tree])

    (method ^:public analyzeTree ^void [this ^{:tag (Env AttrContext)} env ^TreeMaker make]
      (.analyzeTree this env (.-tree env) make))

    (method ^:public analyzeTree ^void [this ^{:tag (Env AttrContext)} env ^JCTree tree
                                        ^TreeMaker make]
      (try
        (set! attrEnv env)
        (set! (.-make Flow/this) make)
        (set! (.-pendingExits this) (ListBuffer.))
        (set! preciseRethrowTypes (HashMap.))
        (set! (.-thrown this) (set! (.-caught this) nil))
        (set! (.-classDef this) nil)
        (.scan this tree)
        (finally
          (set! (.-pendingExits this) nil)
          (set! (.-make Flow/this) nil)
          (set! (.-thrown this) (set! (.-caught this) nil))
          (set! (.-classDef this) nil)))))

  (defclass LambdaAliveAnalyzer
    :extends AliveAnalyzer

    (field ^boolean inLambda)

    (method ^:public visitReturn ^void [this ^JCTree$JCReturn tree]
      (.recordExit this (Flow$BaseAnalyzer$PendingExit. tree)))

    (method ^:public visitLambda ^void [this ^JCTree$JCLambda tree]
      (when-not (or inLambda
                    (identical? (.getBodyKind tree) LambdaExpressionTree$BodyKind/EXPRESSION))
        (set! inLambda true)
        (try (.visitLambda super tree) (finally (set! inLambda false)))))

    (method ^:public visitClassDef ^void [this ^JCTree$JCClassDecl tree]))

  (defclass SnippetAliveAnalyzer
    :extends AliveAnalyzer

    (method ^:public visitClassDef ^void [this ^JCTree$JCClassDecl tree])

    (method ^:public visitLambda ^void [this ^JCTree$JCLambda tree])

    (method ^:public isAlive ^boolean [this]
      (not (identical? (.-alive super) Liveness/DEAD))))

  (defclass SnippetBreakToAnalyzer
    :extends AliveAnalyzer

    (field ^:private ^:final ^JCTree breakTo)

    (field ^:private ^boolean breaksTo)

    (constructor ^:public [this ^JCTree breakTo]
      (set! (.-breakTo this) breakTo))

    (method ^:public visitBreak ^void [this ^JCTree$JCBreak tree]
      (set! breaksTo
            (let [a-3 breaksTo
                  b-4 (and (identical? breakTo (.-target tree))
                           (identical? (.-alive super) Liveness/ALIVE))]
              (or a-3 b-4))))

    (method ^:public breaksTo ^boolean [this] breaksTo))

  (defclass LambdaAssignAnalyzer
    :extends AssignAnalyzer

    (field ^Scope$WriteableScope enclosedSymbols)

    (field ^boolean inLambda)

    (constructor [this ^{:tag (Env AttrContext)} env]
      (set! enclosedSymbols (Scope$WriteableScope/create (.-sym (.-enclClass env)))))

    (method ^:public visitLambda ^void [this ^JCTree$JCLambda tree]
      (when-not inLambda
        (set! inLambda true)
        (try (.visitLambda super tree) (finally (set! inLambda false)))))

    (method ^:public visitVarDef ^void [this ^JCTree$JCVariableDecl tree]
      (.enter enclosedSymbols (.-sym tree))
      (.visitVarDef super tree))

    (method ^:protected trackable ^boolean [this ^Symbol$VarSymbol sym]
      (and (.includes enclosedSymbols sym) (identical? (.-kind (.-owner sym)) Kinds$Kind/MTH)))

    (method ^:public visitClassDef ^void [this ^JCTree$JCClassDecl tree]))

  (defclass LambdaFlowAnalyzer
    :extends FlowAnalyzer

    (field ^{:tag (List Type)} inferredThrownTypes)

    (field ^boolean inLambda)

    (method ^:public visitLambda ^void [this ^JCTree$JCLambda tree]
      (when-not (or (and (some? (.-type tree)) (.isErroneous (.-type tree))) inLambda)
        (let [^{:tag (List Type)} prevCaught (.-caught this)
              ^{:tag (List Type)} prevThrown (.-thrown this)
              ^{:tag (ListBuffer Flow$BaseAnalyzer$PendingExit)} prevPending (.-pendingExits this)]
          (set! inLambda true)
          (try
            (set! (.-pendingExits this) (ListBuffer.))
            (set! (.-caught this) (List/of (.-throwableType syms)))
            (set! (.-thrown this) (List/nil))
            (.scan this (.-body tree))
            (set! inferredThrownTypes (.-thrown this))
            (finally
              (set! (.-pendingExits this) prevPending)
              (set! (.-caught this) prevCaught)
              (set! (.-thrown this) prevThrown)
              (set! inLambda false))))))

    (method ^:public visitClassDef ^void [this ^JCTree$JCClassDecl tree]))

  (defclass ^:public AssignAnalyzer
    :extends BaseAnalyzer

    (field ^:final ^Bits inits)

    (field ^:final ^Bits uninits)

    (field ^:final ^Bits uninitsTry)

    (field ^:final ^Bits initsWhenTrue)

    (field ^:final ^Bits initsWhenFalse)

    (field ^:final ^Bits uninitsWhenTrue)

    (field ^:final ^Bits uninitsWhenFalse)

    (field ^:protected ^JCTree$JCVariableDecl/1 vardecls)

    (field ^JCTree$JCClassDecl classDef)

    (field ^int firstadr)

    (field ^:protected ^int nextadr)

    (field ^:protected ^int returnadr)

    (field ^Scope$WriteableScope unrefdResources)

    (field ^FlowKind flowKind FlowKind/NORMAL)

    (field ^int startPos)

    (defclass ^:public AssignPendingExit
      :extends Flow$BaseAnalyzer$PendingExit

      (field ^:final ^Bits inits)

      (field ^:final ^Bits uninits)

      (field ^:final ^Bits exit_inits (Bits. true))

      (field ^:final ^Bits exit_uninits (Bits. true))

      (constructor ^:public [this ^JCTree tree ^:final ^Bits inits ^:final ^Bits uninits]
        (super. tree)
        (set! (.-inits this) inits)
        (set! (.-uninits this) uninits)
        (.assign (.-exit_inits this) inits)
        (.assign (.-exit_uninits this) uninits))

      (method ^:public resolveJump ^void [this]
        (.andSet inits exit_inits)
        (.andSet uninits exit_uninits)))

    (constructor ^:public [this]
      (set! (.-inits this) (Bits.))
      (set! uninits (Bits.))
      (set! uninitsTry (Bits.))
      (set! initsWhenTrue (Bits. true))
      (set! initsWhenFalse (Bits. true))
      (set! uninitsWhenTrue (Bits. true))
      (set! uninitsWhenFalse (Bits. true)))

    (field ^:private ^boolean isConstructor)

    (method ^:protected markDead ^void [this]
      (.inclRange inits returnadr nextadr)
      (.inclRange uninits returnadr nextadr))

    (method ^:protected trackable ^boolean [this ^Symbol$VarSymbol sym]
      (and (>= (.-pos sym) startPos)
           (or (or (identical? (.-kind (.-owner sym)) Kinds$Kind/MTH)
                   (identical? (.-kind (.-owner sym)) Kinds$Kind/VAR))
               (.isFinalUninitializedField this sym))))

    (method isFinalUninitializedField ^boolean [this ^Symbol$VarSymbol sym]
      (and (identical? (.-kind (.-owner sym)) Kinds$Kind/TYP)
           (and (== (bit-and (.flags sym)
                             (bit-or (bit-or-int Flags/FINAL Flags/HASINIT) Flags/PARAMETER))
                    Flags/FINAL)
                (.isEnclosedBy (.-sym classDef) (cast Symbol$ClassSymbol (.-owner sym))))))

    (method newVar ^void [this ^JCTree$JCVariableDecl varDecl]
      (let [sym (.-sym varDecl)]
        (set! vardecls (cast JCTree$JCVariableDecl/1 (ArrayUtils/ensureCapacity vardecls nextadr)))
        (when (== (bit-and (.flags sym) Flags/FINAL) 0)
          (set! (.-flags_field sym) (bit-or (.-flags_field sym) Flags/EFFECTIVELY_FINAL)))
        (set! (.-adr sym) nextadr)
        (aset vardecls nextadr varDecl)
        (.excl inits nextadr)
        (.incl uninits nextadr)
        (set! nextadr (unchecked-inc-int nextadr))))

    (method letInit ^void [this ^JCDiagnostic$DiagnosticPosition pos ^Symbol$VarSymbol sym]
      (if (and (>= (.-adr sym) firstadr) (.trackable this sym))
          (do
            (if (not (== (bit-and (.flags sym) Flags/EFFECTIVELY_FINAL) 0))
                (if (not (.isMember uninits (.-adr sym)))
                    (set! (.-flags_field sym)
                          (bit-and (.-flags_field sym) (bit-not Flags/EFFECTIVELY_FINAL)))
                    (.uninit this sym))
                (when-not (== (bit-and (.flags sym) Flags/FINAL) 0)
                  (cond
                    (not (== (bit-and (.flags sym) Flags/PARAMETER) 0))
                      (if (not (== (bit-and (.flags sym) Flags/UNION) 0))
                          (.error log
                                  pos
                                  (CompilerProperties$Errors/MulticatchParameterMayNotBeAssigned
                                    sym))
                          (.error log
                                  pos
                                  (CompilerProperties$Errors/FinalParameterMayNotBeAssigned sym)))
                    (not (.isMember uninits (.-adr sym)))
                      (.error log pos (.errorKey diags (.-errKey flowKind) sym))
                    :else (.uninit this sym))))
            (.incl inits (.-adr sym)))
          (when-not (== (bit-and (.flags sym) Flags/FINAL) 0)
            (.error log pos (CompilerProperties$Errors/VarMightAlreadyBeAssigned sym)))))

    (method uninit ^void [this ^Symbol$VarSymbol sym]
      (if (not (.isMember inits (.-adr sym)))
          (do (.excl uninits (.-adr sym)) (.excl uninitsTry (.-adr sym)))
          (.excl uninits (.-adr sym))))

    (method letInit ^void [this ^:mutable ^JCTree tree]
      (set! tree (TreeInfo/skipParens tree))
      (when (or (.hasTag tree JCTree$Tag/IDENT) (.hasTag tree JCTree$Tag/SELECT))
        (let [sym (TreeInfo/symbol tree)]
          (when (identical? (.-kind sym) Kinds$Kind/VAR)
            (.letInit this (.pos tree) (cast Symbol$VarSymbol sym))))))

    (method checkInit ^void [this ^JCDiagnostic$DiagnosticPosition pos ^Symbol$VarSymbol sym]
      (.checkInit this pos sym (CompilerProperties$Errors/VarMightNotHaveBeenInitialized sym)))

    (method checkInit ^void [this ^JCDiagnostic$DiagnosticPosition pos ^Symbol$VarSymbol sym
                             ^JCDiagnostic$Error errkey]
      (when (and (and (and (or (>= (.-adr sym) firstadr)
                               (not (identical? (.-kind (.-owner sym)) Kinds$Kind/TYP)))
                           (.trackable this sym))
                      (not (.isMember inits (.-adr sym))))
                 (== (bit-and (.-flags_field sym) Flags/CLASH) 0))
        (.error log pos errkey)
        (.incl inits (.-adr sym))))

    (method ^:private resetBits ^void [this & ^Bits/1 bits]
      (for-each [^Bits b bits] (.reset b)))

    (method split ^void [this ^boolean setToNull]
      (.assign initsWhenFalse inits)
      (.assign uninitsWhenFalse uninits)
      (.assign initsWhenTrue inits)
      (.assign uninitsWhenTrue uninits)
      (when setToNull (.resetBits this inits uninits)))

    (method ^:protected merge ^void [this]
      (.assign inits (.andSet initsWhenFalse initsWhenTrue))
      (.assign uninits (.andSet uninitsWhenFalse uninitsWhenTrue)))

    (method scanExpr ^void [this ^JCTree tree]
      (when (some? tree) (.scan this tree) (when (.isReset inits) (.merge this))))

    (method scanExprs ^void [this ^{:tag (List (? extends JCTree$JCExpression))} trees]
      (when (some? trees)
        (loop [^{:tag (List (? extends JCTree$JCExpression))} l trees]
          (when (.nonEmpty l) (.scanExpr this (cast JCTree (.-head l))) (recur (.-tail l))))))

    (method scanPattern ^void [this ^JCTree tree] (.scan this tree))

    (method scanCond ^void [this ^JCTree tree]
      (cond
        (.isFalse (.-type tree))
          (do
            (when (.isReset inits) (.merge this))
            (.assign initsWhenTrue inits)
            (.inclRange initsWhenTrue firstadr nextadr)
            (.assign uninitsWhenTrue uninits)
            (.inclRange uninitsWhenTrue firstadr nextadr)
            (.assign initsWhenFalse inits)
            (.assign uninitsWhenFalse uninits))
        (.isTrue (.-type tree))
          (do
            (when (.isReset inits) (.merge this))
            (.assign initsWhenFalse inits)
            (.inclRange initsWhenFalse firstadr nextadr)
            (.assign uninitsWhenFalse uninits)
            (.inclRange uninitsWhenFalse firstadr nextadr)
            (.assign initsWhenTrue inits)
            (.assign uninitsWhenTrue uninits))
        :else
          (do
            (.scan this tree)
            (when-not (.isReset inits)
              (.split this (not (identical? (.-type tree) (.-unknownType syms)))))))
      (when-not (identical? (.-type tree) (.-unknownType syms)) (.resetBits this inits uninits)))

    (method ^:public visitClassDef ^void [this ^JCTree$JCClassDecl tree]
      (when (some? (.-sym tree))
        (let [classDefPrev classDef
              firstadrPrev firstadr
              nextadrPrev nextadr
              ^{:tag (ListBuffer Flow$BaseAnalyzer$PendingExit)} pendingExitsPrev (.-pendingExits
                                                                                    this)]
          (set! (.-pendingExits this) (ListBuffer.))
          (when-not (identical? (.-name tree) (.-empty names)) (set! firstadr nextadr))
          (set! classDef tree)
          (try
            (loop [^{:tag (List JCTree)} l (.-defs tree)]
              (if (.nonEmpty l)
                  (if (.hasTag (cast JCTree (.-head l)) JCTree$Tag/VARDEF)
                      (let [def (cast JCTree$JCVariableDecl (.-head l))]
                        (if (not (== (bit-and (.-flags (.-mods def)) Flags/STATIC) 0))
                            (let [sym (.-sym def)]
                              (if (.trackable this sym)
                                  (do (.newVar this def) (recur (.-tail l)))
                                  (recur (.-tail l))))
                            (recur (.-tail l))))
                      (recur (.-tail l)))
                  nil))
            (.forEachInitializer this
                                 tree
                                 true
                                 (lambda Consumer ^void [^JCTree def]
                                   (.scan this def)
                                   (.clearPendingExits this false)))
            (loop [^int i firstadr]
              (when (< i nextadr)
                (let [vardecl (aget vardecls i)
                      var (.-sym vardecl)]
                  (if (and (identical? (.-owner var) (.-sym classDef)) (.isStatic var))
                      (do
                        (.checkInit this (TreeInfo/diagnosticPositionFor var vardecl) var)
                        (recur (unchecked-inc-int i)))
                      (recur (unchecked-inc-int i))))))
            (loop [^{:tag (List JCTree)} l (.-defs tree)]
              (if (.nonEmpty l)
                  (if (.hasTag (cast JCTree (.-head l)) JCTree$Tag/VARDEF)
                      (let [def (cast JCTree$JCVariableDecl (.-head l))]
                        (if (== (bit-and (.-flags (.-mods def)) Flags/STATIC) 0)
                            (let [sym (.-sym def)]
                              (if (.trackable this sym)
                                  (do (.newVar this def) (recur (.-tail l)))
                                  (recur (.-tail l))))
                            (recur (.-tail l))))
                      (recur (.-tail l)))
                  nil))
            (loop [^{:tag (List JCTree)} l (.-defs tree)]
              (if (.nonEmpty l)
                  (if (.hasTag (cast JCTree (.-head l)) JCTree$Tag/METHODDEF)
                      (do (.scan this (cast JCTree (.-head l))) (recur (.-tail l)))
                      (recur (.-tail l)))
                  nil))
            (loop [^{:tag (List JCTree)} l (.-defs tree)]
              (if (.nonEmpty l)
                  (if (.hasTag (cast JCTree (.-head l)) JCTree$Tag/CLASSDEF)
                      (do (.scan this (cast JCTree (.-head l))) (recur (.-tail l)))
                      (recur (.-tail l)))
                  nil))
            (finally
              (set! (.-pendingExits this) pendingExitsPrev)
              (set! nextadr nextadrPrev)
              (set! firstadr firstadrPrev)
              (set! classDef classDefPrev))))))

    (method ^:public visitMethodDef ^void [this ^JCTree$JCMethodDecl tree]
      (when (some? (.-body tree))
        (when-not (not (== (bit-and (.flags (.-sym tree)) Flags/SYNTHETIC) 0))
          (let [initsPrev (Bits. inits)
                uninitsPrev (Bits. uninits)
                nextadrPrev nextadr
                firstadrPrev firstadr
                returnadrPrev returnadr]
            (Assert/check (.isEmpty (.-pendingExits this)))
            (let [isConstructorPrev isConstructor]
              (try
                (set! isConstructor (TreeInfo/isConstructor tree))
                (when-not isConstructor (set! firstadr nextadr))
                (loop [^{:tag (List JCTree$JCVariableDecl)} l (.-params tree)]
                  (when (.nonEmpty l)
                    (let [def (cast JCTree$JCVariableDecl (.-head l))]
                      (.scan this def)
                      (Assert/check (not (== (bit-and (.flags (.-sym def)) Flags/PARAMETER) 0))
                                    "Method parameter without PARAMETER flag")
                      (.initParam this def)
                      (recur (.-tail l)))))
                (.scan this (.-body tree))
                (let [isCompactOrGeneratedRecordConstructor (or
                                                              (not
                                                                (==
                                                                  (bit-and
                                                                    (.flags (.-sym tree))
                                                                    Flags/COMPACT_RECORD_CONSTRUCTOR)
                                                                  0))
                                                              (==
                                                                (bit-and
                                                                  (.flags (.-sym tree))
                                                                  (bit-or
                                                                    Flags/GENERATEDCONSTR
                                                                    Flags/RECORD))
                                                                (bit-or
                                                                  Flags/GENERATEDCONSTR
                                                                  Flags/RECORD)))]
                  (when isConstructor
                    (let [isSynthesized (not (==
                                               (bit-and (.flags (.-sym tree)) Flags/GENERATEDCONSTR)
                                               0))]
                      (loop [^int i firstadr]
                        (when (< i nextadr)
                          (let [vardecl (aget vardecls i)
                                var (.-sym vardecl)]
                            (if (and (identical? (.-owner var) (.-sym classDef))
                                     (not (.isStatic var)))
                                (cond
                                  (and isSynthesized (not isCompactOrGeneratedRecordConstructor))
                                    (do
                                      (.checkInit
                                        this
                                        (TreeInfo/diagnosticPositionFor var vardecl)
                                        var
                                        (CompilerProperties$Errors/VarNotInitializedInDefaultConstructor
                                          var))
                                      (recur (unchecked-inc-int i)))
                                  isCompactOrGeneratedRecordConstructor
                                    (let [isInstanceRecordField (and
                                                                  (and
                                                                    (.isRecord (.enclClass var))
                                                                    (not
                                                                      (==
                                                                        (bit-and
                                                                          (.-flags_field var)
                                                                          (bit-or
                                                                            (bit-or-int
                                                                              (bit-or-int
                                                                                Flags/PRIVATE
                                                                                Flags/FINAL)
                                                                              Flags/GENERATED_MEMBER)
                                                                            Flags/RECORD))
                                                                        0)))
                                                                  (identical?
                                                                    (.-kind (.-owner var))
                                                                    Kinds$Kind/TYP))]
                                      (if isInstanceRecordField
                                          (let [notInitialized (not (.isMember inits (.-adr var)))]
                                            (if (and
                                                  (and
                                                    notInitialized
                                                    (.isMember uninits (.-adr var)))
                                                  (.-completesNormally tree))
                                                (do
                                                  (set!
                                                    (.-flags_field var)
                                                    (bit-or
                                                      (.-flags_field var)
                                                      Flags/UNINITIALIZED_FIELD))
                                                  (recur (unchecked-inc-int i)))
                                                (do
                                                  (.checkInit
                                                    this
                                                    (TreeInfo/diagEndPos (.-body tree))
                                                    var)
                                                  (recur (unchecked-inc-int i)))))
                                          (do
                                            (.checkInit
                                              this
                                              (TreeInfo/diagnosticPositionFor var vardecl)
                                              var)
                                            (recur (unchecked-inc-int i)))))
                                  :else
                                    (do
                                      (.checkInit this (TreeInfo/diagEndPos (.-body tree)) var)
                                      (recur (unchecked-inc-int i))))
                                (recur (unchecked-inc-int i))))))))
                  (.clearPendingExits this true))
                (finally
                  (.assign inits initsPrev)
                  (.assign uninits uninitsPrev)
                  (set! nextadr nextadrPrev)
                  (set! firstadr firstadrPrev)
                  (set! returnadr returnadrPrev)
                  (set! isConstructor isConstructorPrev))))))))

    (method ^:private clearPendingExits ^void [this ^boolean inMethod]
      (let [^:mutable ^{:tag (List Flow$BaseAnalyzer$PendingExit)} exits (.toList
                                                                           (.-pendingExits this))]
        (set! (.-pendingExits this) (ListBuffer.))
        (while (.nonEmpty exits)
          (let [exit (cast Flow$BaseAnalyzer$PendingExit (.-head exits))]
            (set! exits (.-tail exits))
            (Assert/check (or (and inMethod (.hasTag (.-tree exit) JCTree$Tag/RETURN))
                              (.hasErrorOn log (.pos (.-tree exit))))
                          (.-tree exit))
            (when (and inMethod isConstructor)
              (Assert/check (instance? AssignPendingExit exit))
              (.assign inits (.-exit_inits (cast AssignPendingExit exit)))
              (loop [^int i firstadr]
                (when (< i nextadr)
                  (.checkInit this (.pos (.-tree exit)) (.-sym (aget vardecls i)))
                  (recur (unchecked-inc-int i)))))))))

    (method ^:protected initParam ^void [this ^JCTree$JCVariableDecl def]
      (.incl inits (.-adr (.-sym def)))
      (.excl uninits (.-adr (.-sym def))))

    (method ^:public visitVarDef ^void [this ^JCTree$JCVariableDecl tree]
      (let [track (.trackable this (.-sym tree))]
        (when (and track
                   (or (identical? (.-kind (.-owner (.-sym tree))) Kinds$Kind/MTH)
                       (identical? (.-kind (.-owner (.-sym tree))) Kinds$Kind/VAR)))
          (.newVar this tree))
        (when (some? (.-init tree))
          (.scanExpr this (.-init tree))
          (when track (.letInit this (.pos tree) (.-sym tree))))))

    (method ^:public visitBlock ^void [this ^JCTree$JCBlock tree]
      (let [nextadrPrev nextadr] (.scan this (.-stats tree)) (set! nextadr nextadrPrev)))

    (method ^:public visitDoLoop ^void [this ^JCTree$JCDoWhileLoop tree]
      (let [^{:tag (ListBuffer Flow$BaseAnalyzer$PendingExit)} prevPendingExits (.-pendingExits
                                                                                  this)
            prevFlowKind flowKind]
        (set! flowKind FlowKind/NORMAL)
        (let [initsSkip (Bits. true)
              uninitsSkip (Bits. true)]
          (set! (.-pendingExits this) (ListBuffer.))
          (let [prevErrors (.-nerrors log)]
            (loop []
              (let [uninitsEntry (Bits. uninits)]
                (.excludeFrom uninitsEntry nextadr)
                (.scan this (.-body tree))
                (.resolveContinues this tree)
                (.scanCond this (.-cond tree))
                (when-not (.isFinal flowKind)
                  (.assign initsSkip initsWhenFalse)
                  (.assign uninitsSkip uninitsWhenFalse))
                (when (or (or (not (== (.-nerrors log) prevErrors)) (.isFinal flowKind))
                          (== (.nextBit (.diffSet (Bits. uninitsEntry) uninitsWhenTrue) firstadr)
                              -1))
                  (break))
                (.assign inits initsWhenTrue)
                (.assign uninits (.andSet uninitsEntry uninitsWhenTrue))
                (set! flowKind FlowKind/SPECULATIVE_LOOP))
              (when true (recur)))
            (set! flowKind prevFlowKind)
            (.assign inits initsSkip)
            (.assign uninits uninitsSkip)
            (.resolveBreaks this tree prevPendingExits)))))

    (method ^:public visitWhileLoop ^void [this ^JCTree$JCWhileLoop tree]
      (let [^{:tag (ListBuffer Flow$BaseAnalyzer$PendingExit)} prevPendingExits (.-pendingExits
                                                                                  this)
            prevFlowKind flowKind]
        (set! flowKind FlowKind/NORMAL)
        (let [initsSkip (Bits. true)
              uninitsSkip (Bits. true)]
          (set! (.-pendingExits this) (ListBuffer.))
          (let [prevErrors (.-nerrors log)
                uninitsEntry (Bits. uninits)]
            (.excludeFrom uninitsEntry nextadr)
            (loop []
              (.scanCond this (.-cond tree))
              (when-not (.isFinal flowKind)
                (.assign initsSkip initsWhenFalse)
                (.assign uninitsSkip uninitsWhenFalse))
              (.assign inits initsWhenTrue)
              (.assign uninits uninitsWhenTrue)
              (.scan this (.-body tree))
              (.resolveContinues this tree)
              (when (or (or (not (== (.-nerrors log) prevErrors)) (.isFinal flowKind))
                        (== (.nextBit (.diffSet (Bits. uninitsEntry) uninits) firstadr) -1))
                (break))
              (.assign uninits (.andSet uninitsEntry uninits))
              (set! flowKind FlowKind/SPECULATIVE_LOOP)
              (when true (recur)))
            (set! flowKind prevFlowKind)
            (.assign inits initsSkip)
            (.assign uninits uninitsSkip)
            (.resolveBreaks this tree prevPendingExits)))))

    (method ^:public visitForLoop ^void [this ^JCTree$JCForLoop tree]
      (let [^{:tag (ListBuffer Flow$BaseAnalyzer$PendingExit)} prevPendingExits (.-pendingExits
                                                                                  this)
            prevFlowKind flowKind]
        (set! flowKind FlowKind/NORMAL)
        (let [nextadrPrev nextadr]
          (.scan this (.-init tree))
          (let [initsSkip (Bits. true)
                uninitsSkip (Bits. true)]
            (set! (.-pendingExits this) (ListBuffer.))
            (let [prevErrors (.-nerrors log)]
              (loop []
                (let [uninitsEntry (Bits. uninits)]
                  (.excludeFrom uninitsEntry nextadr)
                  (if (some? (.-cond tree))
                      (do
                        (.scanCond this (.-cond tree))
                        (when-not (.isFinal flowKind)
                          (.assign initsSkip initsWhenFalse)
                          (.assign uninitsSkip uninitsWhenFalse))
                        (.assign inits initsWhenTrue)
                        (.assign uninits uninitsWhenTrue))
                      (when-not (.isFinal flowKind)
                        (.assign initsSkip inits)
                        (.inclRange initsSkip firstadr nextadr)
                        (.assign uninitsSkip uninits)
                        (.inclRange uninitsSkip firstadr nextadr)))
                  (.scan this (.-body tree))
                  (.resolveContinues this tree)
                  (.scan this (.-step tree))
                  (when (or (or (not (== (.-nerrors log) prevErrors)) (.isFinal flowKind))
                            (== (.nextBit (.diffSet (Bits. uninitsEntry) uninits) firstadr) -1))
                    (break))
                  (.assign uninits (.andSet uninitsEntry uninits))
                  (set! flowKind FlowKind/SPECULATIVE_LOOP))
                (when true (recur)))
              (set! flowKind prevFlowKind)
              (.assign inits initsSkip)
              (.assign uninits uninitsSkip)
              (.resolveBreaks this tree prevPendingExits)
              (set! nextadr nextadrPrev))))))

    (method ^:public visitForeachLoop ^void [this ^JCTree$JCEnhancedForLoop tree]
      (.visitVarDef this (.-var tree))
      (let [^{:tag (ListBuffer Flow$BaseAnalyzer$PendingExit)} prevPendingExits (.-pendingExits
                                                                                  this)
            prevFlowKind flowKind]
        (set! flowKind FlowKind/NORMAL)
        (let [nextadrPrev nextadr]
          (.scan this (.-expr tree))
          (let [initsStart (Bits. inits)
                uninitsStart (Bits. uninits)]
            (.letInit this (.pos tree) (.-sym (.-var tree)))
            (set! (.-pendingExits this) (ListBuffer.))
            (let [prevErrors (.-nerrors log)]
              (loop []
                (let [uninitsEntry (Bits. uninits)]
                  (.excludeFrom uninitsEntry nextadr)
                  (.scan this (.-body tree))
                  (.resolveContinues this tree)
                  (when (or (or (not (== (.-nerrors log) prevErrors)) (.isFinal flowKind))
                            (== (.nextBit (.diffSet (Bits. uninitsEntry) uninits) firstadr) -1))
                    (break))
                  (.assign uninits (.andSet uninitsEntry uninits))
                  (set! flowKind FlowKind/SPECULATIVE_LOOP))
                (when true (recur)))
              (set! flowKind prevFlowKind)
              (.assign inits initsStart)
              (.assign uninits (.andSet uninitsStart uninits))
              (.resolveBreaks this tree prevPendingExits)
              (set! nextadr nextadrPrev))))))

    (method ^:public visitLabelled ^void [this ^JCTree$JCLabeledStatement tree]
      (let [^{:tag (ListBuffer Flow$BaseAnalyzer$PendingExit)} prevPendingExits (.-pendingExits
                                                                                  this)]
        (set! (.-pendingExits this) (ListBuffer.))
        (.scan this (.-body tree))
        (.resolveBreaks this tree prevPendingExits)))

    (method ^:public visitSwitch ^void [this ^JCTree$JCSwitch tree]
      (.handleSwitch this tree (.-selector tree) (.-cases tree) (.-isExhaustive tree)))

    (method ^:public visitSwitchExpression ^void [this ^JCTree$JCSwitchExpression tree]
      (.handleSwitch this tree (.-selector tree) (.-cases tree) (.-isExhaustive tree)))

    (method ^:private handleSwitch ^void [this ^JCTree tree ^JCTree$JCExpression selector
                                          ^{:tag (List JCTree$JCCase)} cases ^boolean isExhaustive]
      (let [^{:tag (ListBuffer Flow$BaseAnalyzer$PendingExit)} prevPendingExits (.-pendingExits
                                                                                  this)]
        (set! (.-pendingExits this) (ListBuffer.))
        (let [nextadrPrev nextadr]
          (.scanExpr this selector)
          (let [initsSwitch (Bits. inits)
                uninitsSwitch (Bits. uninits)]
            (loop [^{:tag (List JCTree$JCCase)} l cases]
              (when (.nonEmpty l)
                (.assign inits initsSwitch)
                (.assign uninits (.andSet uninits uninitsSwitch))
                (let [c (cast JCTree$JCCase (.-head l))]
                  (for-each [^JCTree$JCCaseLabel pat (.-labels c)] (.scanPattern this pat))
                  (.scan this (.-guard c))
                  (when (.isReset inits)
                    (.assign inits initsWhenTrue)
                    (.assign uninits uninitsWhenTrue))
                  (.scan this (.-stats c))
                  (when (and (.-completesNormally c) (identical? (.-caseKind c) JCTree$JCCase/RULE))
                    (.scanSyntheticBreak this make tree))
                  (.addVars this (.-stats c) initsSwitch uninitsSwitch)
                  (recur (.-tail l)))))
            (when-not isExhaustive
              (if (.hasTag tree JCTree$Tag/SWITCH_EXPRESSION)
                  (.markDead this)
                  (when (and (.hasTag tree JCTree$Tag/SWITCH)
                             (not (TreeInfo/expectedExhaustive (cast JCTree$JCSwitch tree))))
                    (.assign inits initsSwitch)
                    (.assign uninits (.andSet uninits uninitsSwitch)))))
            (if (.hasTag tree JCTree$Tag/SWITCH_EXPRESSION)
                (.resolveYields this tree prevPendingExits)
                (.resolveBreaks this tree prevPendingExits))
            (set! nextadr nextadrPrev)))))

    (method ^:private addVars ^void [this ^:mutable ^{:tag (List JCTree$JCStatement)} stats
                                     ^:final ^Bits inits ^:final ^Bits uninits]
      (while (.nonEmpty stats)
        (let [stat (cast JCTree (.-head stats))]
          (when (.hasTag stat JCTree$Tag/VARDEF)
            (let [adr (.-adr (.-sym (cast JCTree$JCVariableDecl stat)))]
              (.excl inits adr)
              (.incl uninits adr))))
        (set! stats (.-tail stats))))

    (method ^:public visitTry ^void [this ^JCTree$JCTry tree]
      (let [^{:tag (ListBuffer JCTree$JCVariableDecl)} resourceVarDecls (ListBuffer.)
            uninitsTryPrev (Bits. uninitsTry)
            ^{:tag (ListBuffer Flow$BaseAnalyzer$PendingExit)} prevPendingExits (.-pendingExits
                                                                                  this)]
        (set! (.-pendingExits this) (ListBuffer.))
        (let [initsTry (Bits. inits)]
          (.assign uninitsTry uninits)
          (for-each [^JCTree resource (.-resources tree)]
            (if-instance [^JCTree$JCVariableDecl variableDecl resource]
              (do
                (.visitVarDef this variableDecl)
                (.enter unrefdResources (.-sym variableDecl))
                (.append resourceVarDecls variableDecl))
              (if-instance [^JCTree$JCExpression expression resource]
                (.scanExpr this expression)
                (throw (AssertionError. tree)))))
          (.scan this (.-body tree))
          (.andSet uninitsTry uninits)
          (let [initsEnd (Bits. inits)
                uninitsEnd (Bits. uninits)
                nextadrCatch nextadr]
            (when-not (.isEmpty resourceVarDecls)
              (for-each [^JCTree$JCVariableDecl resVar resourceVarDecls]
                (when (and (.includes unrefdResources (.-sym resVar))
                           (not (.isUnnamedVariable (.-sym resVar))))
                  (.warning log
                            (.pos resVar)
                            (CompilerProperties$LintWarnings/TryResourceNotReferenced
                              (.-sym resVar)))
                  (.remove unrefdResources (.-sym resVar)))))
            (let [initsCatchPrev (Bits. initsTry)
                  uninitsCatchPrev (Bits. uninitsTry)]
              (loop [^{:tag (List JCTree$JCCatch)} l (.-catchers tree)]
                (when (.nonEmpty l)
                  (let [param (.-param (cast JCTree$JCCatch (.-head l)))]
                    (.assign inits initsCatchPrev)
                    (.assign uninits uninitsCatchPrev)
                    (.scan this param)
                    (.initParam this param)
                    (.scan this (.-body (cast JCTree$JCCatch (.-head l))))
                    (.andSet initsEnd inits)
                    (.andSet uninitsEnd uninits)
                    (set! nextadr nextadrCatch)
                    (recur (.-tail l)))))
              (if (some? (.-finalizer tree))
                  (do
                    (.assign inits initsTry)
                    (.assign uninits uninitsTry)
                    (let [^{:tag (ListBuffer Flow$BaseAnalyzer$PendingExit)} exits (.-pendingExits
                                                                                     this)]
                      (set! (.-pendingExits this) prevPendingExits)
                      (.scan this (.-finalizer tree))
                      (when-not (not (.-finallyCanCompleteNormally tree))
                        (.andSet uninits uninitsEnd)
                        (while (.nonEmpty exits)
                          (let [exit (cast Flow$BaseAnalyzer$PendingExit (.next exits))]
                            (when-instance [^AssignPendingExit assignPendingExit exit]
                              (.orSet (.-exit_inits assignPendingExit) inits)
                              (.andSet (.-exit_uninits assignPendingExit) uninits))
                            (.append (.-pendingExits this) exit)))
                        (.orSet inits initsEnd))))
                  (do
                    (.assign inits initsEnd)
                    (.assign uninits uninitsEnd)
                    (let [^{:tag (ListBuffer Flow$BaseAnalyzer$PendingExit)} exits (.-pendingExits
                                                                                     this)]
                      (set! (.-pendingExits this) prevPendingExits)
                      (while (.nonEmpty exits)
                        (.append (.-pendingExits this)
                                 (cast Flow$BaseAnalyzer$PendingExit (.next exits)))))))
              (.andSet (.andSet uninitsTry uninitsTryPrev) uninits))))))

    (method ^:public visitConditional ^void [this ^JCTree$JCConditional tree]
      (.scanCond this (.-cond tree))
      (let [initsBeforeElse (Bits. initsWhenFalse)
            uninitsBeforeElse (Bits. uninitsWhenFalse)]
        (.assign inits initsWhenTrue)
        (.assign uninits uninitsWhenTrue)
        (if (and (.hasTag (.-type (.-truepart tree)) TypeTag/BOOLEAN)
                 (.hasTag (.-type (.-falsepart tree)) TypeTag/BOOLEAN))
            (do
              (.scanCond this (.-truepart tree))
              (let [initsAfterThenWhenTrue (Bits. initsWhenTrue)
                    initsAfterThenWhenFalse (Bits. initsWhenFalse)
                    uninitsAfterThenWhenTrue (Bits. uninitsWhenTrue)
                    uninitsAfterThenWhenFalse (Bits. uninitsWhenFalse)]
                (.assign inits initsBeforeElse)
                (.assign uninits uninitsBeforeElse)
                (.scanCond this (.-falsepart tree))
                (.andSet initsWhenTrue initsAfterThenWhenTrue)
                (.andSet initsWhenFalse initsAfterThenWhenFalse)
                (.andSet uninitsWhenTrue uninitsAfterThenWhenTrue)
                (.andSet uninitsWhenFalse uninitsAfterThenWhenFalse)))
            (do
              (.scanExpr this (.-truepart tree))
              (let [initsAfterThen (Bits. inits)
                    uninitsAfterThen (Bits. uninits)]
                (.assign inits initsBeforeElse)
                (.assign uninits uninitsBeforeElse)
                (.scanExpr this (.-falsepart tree))
                (.andSet inits initsAfterThen)
                (.andSet uninits uninitsAfterThen))))))

    (method ^:public visitIf ^void [this ^JCTree$JCIf tree]
      (.scanCond this (.-cond tree))
      (let [initsBeforeElse (Bits. initsWhenFalse)
            uninitsBeforeElse (Bits. uninitsWhenFalse)]
        (.assign inits initsWhenTrue)
        (.assign uninits uninitsWhenTrue)
        (.scan this (.-thenpart tree))
        (if (some? (.-elsepart tree))
            (let [initsAfterThen (Bits. inits)
                  uninitsAfterThen (Bits. uninits)]
              (.assign inits initsBeforeElse)
              (.assign uninits uninitsBeforeElse)
              (.scan this (.-elsepart tree))
              (.andSet inits initsAfterThen)
              (.andSet uninits uninitsAfterThen))
            (do (.andSet inits initsBeforeElse) (.andSet uninits uninitsBeforeElse)))))

    (method ^:public visitBreak ^void [this ^JCTree$JCBreak tree]
      (.recordExit this (AssignPendingExit. tree inits uninits)))

    (method ^:public visitYield ^void [this ^JCTree$JCYield tree]
      (let [expr (cast JCTree$JCSwitchExpression (.-target tree))]
        (if (and (some? expr) (.hasTag (.-type expr) TypeTag/BOOLEAN))
            (do
              (.scanCond this (.-value tree))
              (let [initsAfterBreakWhenTrue (Bits. initsWhenTrue)
                    initsAfterBreakWhenFalse (Bits. initsWhenFalse)
                    uninitsAfterBreakWhenTrue (Bits. uninitsWhenTrue)
                    uninitsAfterBreakWhenFalse (Bits. uninitsWhenFalse)
                    ^Flow$BaseAnalyzer$PendingExit exit (anon Flow$BaseAnalyzer$PendingExit [tree]
                                                          (method resolveJump ^void [this]
                                                            (when-not (.isReset inits)
                                                              (.split AssignAnalyzer/this true))
                                                            (.andSet
                                                              initsWhenTrue
                                                              initsAfterBreakWhenTrue)
                                                            (.andSet
                                                              initsWhenFalse
                                                              initsAfterBreakWhenFalse)
                                                            (.andSet
                                                              uninitsWhenTrue
                                                              uninitsAfterBreakWhenTrue)
                                                            (.andSet
                                                              uninitsWhenFalse
                                                              uninitsAfterBreakWhenFalse)))]
                (.merge this)
                (.recordExit this exit)))
            (do
              (.scanExpr this (.-value tree))
              (.recordExit this (AssignPendingExit. tree inits uninits))))))

    (method ^:public visitContinue ^void [this ^JCTree$JCContinue tree]
      (.recordExit this (AssignPendingExit. tree inits uninits)))

    (method ^:public visitReturn ^void [this ^JCTree$JCReturn tree]
      (.scanExpr this (.-expr tree))
      (.recordExit this (AssignPendingExit. tree inits uninits)))

    (method ^:public visitThrow ^void [this ^JCTree$JCThrow tree]
      (.scanExpr this (.-expr tree))
      (.markDead this))

    (method ^:public visitApply ^void [this ^JCTree$JCMethodInvocation tree]
      (.scanExpr this (.-meth tree))
      (.scanExprs this (.-args tree))
      (when isConstructor
        (let [name (TreeInfo/name (.-meth tree))]
          (cond
            (identical? name (.-_super names))
              (.forEachInitializer this
                                   classDef
                                   false
                                   (lambda Consumer ^void [^JCTree def]
                                     (.scan this def)
                                     (.clearPendingExits this false)))
            (identical? name (.-_this names))
              (loop [^int address firstadr]
                (when (< address nextadr)
                  (let [sym (.-sym (aget vardecls address))]
                    (if (and (.isFinalUninitializedField this sym) (not (.isStatic sym)))
                        (do (.letInit this (.pos tree) sym) (recur (unchecked-inc-int address)))
                        (recur (unchecked-inc-int address))))))))))

    (method ^:public visitNewClass ^void [this ^JCTree$JCNewClass tree]
      (.scanExpr this (.-encl tree))
      (.scanExprs this (.-args tree))
      (.scan this (.-def tree)))

    (method ^:public visitLambda ^void [this ^JCTree$JCLambda tree]
      (let [prevUninits (Bits. uninits)
            prevUninitsTry (Bits. uninitsTry)
            prevInits (Bits. inits)
            returnadrPrev returnadr
            nextadrPrev nextadr
            ^{:tag (ListBuffer Flow$BaseAnalyzer$PendingExit)} prevPending (.-pendingExits this)]
        (try
          (.excludeFrom uninits firstadr)
          (set! returnadr nextadr)
          (set! (.-pendingExits this) (ListBuffer.))
          (loop [^{:tag (List JCTree$JCVariableDecl)} l (.-params tree)]
            (when (.nonEmpty l)
              (let [def (cast JCTree$JCVariableDecl (.-head l))]
                (.scan this def)
                (.incl inits (.-adr (.-sym def)))
                (.excl uninits (.-adr (.-sym def)))
                (recur (.-tail l)))))
          (if (identical? (.getBodyKind tree) LambdaExpressionTree$BodyKind/EXPRESSION)
              (.scanExpr this (.-body tree))
              (.scan this (.-body tree)))
          (finally
            (set! returnadr returnadrPrev)
            (.assign uninits prevUninits)
            (.assign uninitsTry prevUninitsTry)
            (.assign inits prevInits)
            (set! (.-pendingExits this) prevPending)
            (set! nextadr nextadrPrev)))))

    (method ^:public visitNewArray ^void [this ^JCTree$JCNewArray tree]
      (.scanExprs this (.-dims tree))
      (.scanExprs this (.-elems tree)))

    (method ^:public visitAssert ^void [this ^JCTree$JCAssert tree]
      (let [initsExit (Bits. inits)
            uninitsExit (Bits. uninits)]
        (.scanCond this (.-cond tree))
        (.andSet uninitsExit uninitsWhenTrue)
        (when (some? (.-detail tree))
          (.assign inits initsWhenFalse)
          (.assign uninits uninitsWhenFalse)
          (.scanExpr this (.-detail tree)))
        (.assign inits initsExit)
        (.assign uninits uninitsExit)))

    (method ^:public visitAssign ^void [this ^JCTree$JCAssign tree]
      (when-not (TreeInfo/isIdentOrThisDotIdent (.-lhs tree)) (.scanExpr this (.-lhs tree)))
      (.scanExpr this (.-rhs tree))
      (.letInit this (.-lhs tree)))

    (method ^:public visitSelect ^void [this ^JCTree$JCFieldAccess tree]
      (.visitSelect super tree)
      (when (and (TreeInfo/isThisQualifier (.-selected tree))
                 (identical? (.-kind (.-sym tree)) Kinds$Kind/VAR))
        (.checkInit this (.pos tree) (cast Symbol$VarSymbol (.-sym tree)))))

    (method ^:public visitAssignop ^void [this ^JCTree$JCAssignOp tree]
      (.scanExpr this (.-lhs tree))
      (.scanExpr this (.-rhs tree))
      (.letInit this (.-lhs tree)))

    (method ^:public visitUnary ^void [this ^JCTree$JCUnary tree]
      (switch (.getTag tree)
        NOT
          (do
            (.scanCond this (.-arg tree))
            (let [t (Bits. initsWhenFalse)]
              (.assign initsWhenFalse initsWhenTrue)
              (.assign initsWhenTrue t)
              (.assign t uninitsWhenFalse)
              (.assign uninitsWhenFalse uninitsWhenTrue)
              (.assign uninitsWhenTrue t)))
        (PREINC POSTINC PREDEC POSTDEC)
          (do (.scanExpr this (.-arg tree)) (.letInit this (.-arg tree)))
        (.scanExpr this (.-arg tree))))

    (method ^:public visitBinary ^void [this ^JCTree$JCBinary tree]
      (switch (.getTag tree)
        AND
          (do
            (.scanCond this (.-lhs tree))
            (let [initsWhenFalseLeft (Bits. initsWhenFalse)
                  uninitsWhenFalseLeft (Bits. uninitsWhenFalse)]
              (.assign inits initsWhenTrue)
              (.assign uninits uninitsWhenTrue)
              (.scanCond this (.-rhs tree))
              (.andSet initsWhenFalse initsWhenFalseLeft)
              (.andSet uninitsWhenFalse uninitsWhenFalseLeft)))
        OR
          (do
            (.scanCond this (.-lhs tree))
            (let [initsWhenTrueLeft (Bits. initsWhenTrue)
                  uninitsWhenTrueLeft (Bits. uninitsWhenTrue)]
              (.assign inits initsWhenFalse)
              (.assign uninits uninitsWhenFalse)
              (.scanCond this (.-rhs tree))
              (.andSet initsWhenTrue initsWhenTrueLeft)
              (.andSet uninitsWhenTrue uninitsWhenTrueLeft)))
        (do (.scanExpr this (.-lhs tree)) (.scanExpr this (.-rhs tree)))))

    (method ^:public visitIdent ^void [this ^JCTree$JCIdent tree]
      (when (identical? (.-kind (.-sym tree)) Kinds$Kind/VAR)
        (.checkInit this (.pos tree) (cast Symbol$VarSymbol (.-sym tree)))
        (.referenced this (.-sym tree))))

    (method ^:public visitTypeTest ^void [this ^JCTree$JCInstanceOf tree]
      (.scanExpr this (.-expr tree))
      (.scan this (.-pattern tree)))

    (method ^:public visitBindingPattern ^void [this ^JCTree$JCBindingPattern tree]
      (.scan this (.-var tree))
      (.initParam this (.-var tree)))

    (method referenced ^void [this ^Symbol sym]
      (.remove unrefdResources sym))

    (method ^:public visitAnnotatedType ^void [this ^JCTree$JCAnnotatedType tree]
      (.accept (.-underlyingType tree) this))

    (method ^:public visitModuleDef ^void [this ^JCTree$JCModuleDecl tree])

    (method ^:public analyzeTree ^void [this ^{:tag (Env ?)} env ^TreeMaker make]
      (.analyzeTree this env (.-tree env) make))

    (method ^:public analyzeTree ^void [this ^{:tag (Env ?)} env ^JCTree tree ^TreeMaker make]
      (try
        (set! startPos (.getStartPosition (.pos tree)))
        (if (nil? vardecls)
            (set! vardecls (new JCTree$JCVariableDecl/1 32))
            (loop [^int i 0]
              (when (< i (alength vardecls)) (aset vardecls i nil) (recur (unchecked-inc-int i)))))
        (set! firstadr 0)
        (set! nextadr 0)
        (set! (.-make Flow/this) make)
        (set! (.-pendingExits this) (ListBuffer.))
        (set! (.-classDef this) nil)
        (set! unrefdResources (Scope$WriteableScope/create (.-sym (.-enclClass env))))
        (.scan this tree)
        (finally
          (set! startPos -1)
          (.resetBits this
                      inits
                      uninits
                      uninitsTry
                      initsWhenTrue
                      initsWhenFalse
                      uninitsWhenTrue
                      uninitsWhenFalse)
          (when (some? vardecls)
            (loop [^int i 0]
              (when (< i (alength vardecls)) (aset vardecls i nil) (recur (unchecked-inc-int i)))))
          (set! firstadr 0)
          (set! nextadr 0)
          (set! (.-make Flow/this) nil)
          (set! (.-pendingExits this) nil)
          (set! (.-classDef this) nil)
          (set! unrefdResources nil)))))

  (defclass CaptureAnalyzer
    :extends BaseAnalyzer

    (field ^JCTree currentTree)

    (field ^Scope$WriteableScope declaredInsideGuard)

    (method markDead ^void [this])

    (method checkEffectivelyFinal ^void [this ^JCDiagnostic$DiagnosticPosition pos
                                         ^Symbol$VarSymbol sym]
      (when (and (and (some? currentTree) (identical? (.-kind (.-owner sym)) Kinds$Kind/MTH))
                 (< (.-pos sym) (.getCurrentTreeStartPosition this)))
        (switch (.getTag currentTree)
          (CLASSDEF CASE LAMBDA)
            (when (== (bit-and (.flags sym) (bit-or Flags/EFFECTIVELY_FINAL Flags/FINAL)) 0)
              (.reportEffectivelyFinalError this pos sym)))))

    (method getCurrentTreeStartPosition ^int [this]
      (if-instance [^JCTree$JCCase cse currentTree]
        (.getStartPosition (.-guard cse))
        (.getStartPosition currentTree)))

    (method letInit ^void [this ^:mutable ^JCTree tree]
      (set! tree (TreeInfo/skipParens tree))
      (when (or (.hasTag tree JCTree$Tag/IDENT) (.hasTag tree JCTree$Tag/SELECT))
        (let [sym (TreeInfo/symbol tree)]
          (when (some? currentTree)
            (switch (.getTag currentTree)
              (CLASSDEF LAMBDA)
                (when (and (and (identical? (.-kind sym) Kinds$Kind/VAR)
                                (identical? (.-kind (.-owner sym)) Kinds$Kind/MTH))
                           (< (.-pos (cast Symbol$VarSymbol sym)) (.getStartPosition currentTree)))
                  (.reportEffectivelyFinalError this tree sym))
              CASE
                (when-not (.includes declaredInsideGuard sym)
                  (.error log
                          (.pos tree)
                          (CompilerProperties$Errors/CannotAssignNotDeclaredGuard sym))))))))

    (method reportEffectivelyFinalError ^void [this ^JCDiagnostic$DiagnosticPosition pos ^Symbol sym]
      (let [^JCDiagnostic$Fragment subKey (switch (.getTag currentTree)
                                            LAMBDA CompilerProperties$Fragments/Lambda
                                            CASE CompilerProperties$Fragments/Guard
                                            CLASSDEF CompilerProperties$Fragments/InnerCls
                                            (throw
                                              (AssertionError.
                                                (java-str
                                                  "Unexpected tree kind: "
                                                  (.getTag currentTree)))))]
        (.error log
                pos
                (CompilerProperties$Errors/CantRefNonEffectivelyFinalVar
                  sym
                  (.fragment diags subKey)))))

    (method ^:public visitClassDef ^void [this ^JCTree$JCClassDecl tree]
      (let [prevTree currentTree]
        (try
          (set! currentTree (when (.isDirectlyOrIndirectlyLocal (.-sym tree)) ^JCTree tree))
          (.visitClassDef super tree)
          (finally (set! currentTree prevTree)))))

    (method ^:public visitLambda ^void [this ^JCTree$JCLambda tree]
      (let [prevTree currentTree]
        (try
          (set! currentTree tree)
          (.visitLambda super tree)
          (finally (set! currentTree prevTree)))))

    (method ^:public visitBindingPattern ^void [this ^JCTree$JCBindingPattern tree]
      (.scan this (.-var tree)))

    (method ^:public visitCase ^void [this ^JCTree$JCCase tree]
      (.scan this (.-labels tree))
      (when (some? (.-guard tree))
        (let [prevTree currentTree
              prevDeclaredInsideGuard declaredInsideGuard]
          (try
            (set! currentTree tree)
            (set! declaredInsideGuard (Scope$WriteableScope/create (.-sym (.-enclClass attrEnv))))
            (.scan this (.-guard tree))
            (finally (set! currentTree prevTree) (set! declaredInsideGuard prevDeclaredInsideGuard)))))
      (.scan this (.-stats tree)))

    (method ^:public visitRecordPattern ^void [this ^JCTree$JCRecordPattern tree]
      (.scan this (.-deconstructor tree))
      (.scan this (.-nested tree)))

    (method ^:public visitIdent ^void [this ^JCTree$JCIdent tree]
      (when (identical? (.-kind (.-sym tree)) Kinds$Kind/VAR)
        (.checkEffectivelyFinal this tree (cast Symbol$VarSymbol (.-sym tree)))))

    (method ^:public visitAssign ^void [this ^JCTree$JCAssign tree]
      (let [^JCTree lhs (TreeInfo/skipParens (.-lhs tree))]
        (when-not (instance? JCTree$JCIdent lhs) (.scan this lhs))
        (.scan this (.-rhs tree))
        (.letInit this lhs)))

    (method ^:public visitAssignop ^void [this ^JCTree$JCAssignOp tree]
      (.scan this (.-lhs tree))
      (.scan this (.-rhs tree))
      (.letInit this (.-lhs tree)))

    (method ^:public visitUnary ^void [this ^JCTree$JCUnary tree]
      (switch (.getTag tree)
        (PREINC POSTINC PREDEC POSTDEC) (do (.scan this (.-arg tree)) (.letInit this (.-arg tree)))
        (.scan this (.-arg tree))))

    (method ^:public visitTry ^void [this ^JCTree$JCTry tree]
      (for-each [^JCTree resource (.-resources tree)]
        (when-not (.hasTag resource JCTree$Tag/VARDEF)
          (let [var (TreeInfo/symbol resource)]
            (when (and (some? var)
                       (== (bit-and (.flags var) (bit-or Flags/FINAL Flags/EFFECTIVELY_FINAL)) 0))
              (.error log
                      (.pos resource)
                      (CompilerProperties$Errors/TryWithResourcesExprEffectivelyFinalVar var))))))
      (.visitTry super tree))

    (method ^:public visitVarDef ^void [this ^JCTree$JCVariableDecl tree]
      (when (some? declaredInsideGuard) (.enter declaredInsideGuard (.-sym tree)))
      (.visitVarDef super tree))

    (method ^:public visitYield ^void [this ^JCTree$JCYield tree]
      (.scan this (.-value tree)))

    (method ^:public visitModuleDef ^void [this ^JCTree$JCModuleDecl tree])

    (method ^:public analyzeTree ^void [this ^{:tag (Env AttrContext)} env ^TreeMaker make]
      (.analyzeTree this env (.-tree env) make))

    (method ^:public analyzeTree ^void [this ^{:tag (Env AttrContext)} env ^JCTree tree
                                        ^TreeMaker make]
      (try
        (set! attrEnv env)
        (set! (.-make Flow/this) make)
        (set! (.-pendingExits this) (ListBuffer.))
        (.scan this tree)
        (finally (set! (.-pendingExits this) nil) (set! (.-make Flow/this) nil)))))

  (defclass ^:enum Liveness
    (constants
      (ALIVE []
             (method ^:public or ^Liveness [this ^Liveness other] this)
             (method ^:public and ^Liveness [this ^Liveness other] other))
      (DEAD []
            (method ^:public or ^Liveness [this ^Liveness other] other)
            (method ^:public and ^Liveness [this ^Liveness other] this))
      (RECOVERY []
                (method ^:public or ^Liveness [this ^Liveness other]
                  (if (identical? other ALIVE) ALIVE this))
                (method ^:public and ^Liveness [this ^Liveness other]
                  (if (identical? other DEAD) DEAD this))))

    (method ^:public ^:abstract or ^Liveness [this ^Liveness other])

    (method ^:public ^:abstract and ^Liveness [this ^Liveness other])

    (method ^:public or ^Liveness [this ^boolean value]
      (.or this (Liveness/from value)))

    (method ^:public and ^Liveness [this ^boolean value]
      (.and this (Liveness/from value)))

    (method ^:public ^:static from ^Liveness [^boolean value]
      (if value ALIVE DEAD))))

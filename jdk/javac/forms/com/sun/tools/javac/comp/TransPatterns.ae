                          (.fixupContinue this tree c index i)
                          (let [^{:tag (ListBuffer JCTree$JCCaseLabel)} translatedLabels
                                  (ListBuffer.)
                                ^{:tag (List JCTree$JCCaseLabel)} labels (.-labels c)
                                ^:mutable defaultAdded false]
                            (loop [^int j 0]
                              (when (and (< j (.size labels)) (not defaultAdded))
                                (let [p (cast JCTree$JCCaseLabel (.get labels j))]
                                  (cond
                                    (.hasTag p JCTree$Tag/DEFAULTCASELABEL)
                                      (do
                                        (.add translatedLabels p)
                                        (set! hasDefault true)
                                        (recur (unchecked-inc-int j)))
                                    (and (and (and hasUnconditionalPattern (not hasDefault))
                                              (identical? c lastCase))
                                         (.hasTag p JCTree$Tag/PATTERNCASELABEL))
                                      (do
                                        (.add translatedLabels (.DefaultCaseLabel make))
                                        (set! defaultAdded true)
                                        (recur (unchecked-inc-int j)))
                                    :else
                                      (let [^int value (if (TreeInfo/isNullCaseLabel p)
                                                           -1
                                                           (let [old-6 i]
                                                             (set! i (unchecked-inc-int i))
                                                             old-6))]
                                        (.add translatedLabels
                                              (.ConstantCaseLabel make (.Literal make value)))
                                        (recur (unchecked-inc-int j)))))))
                            (set! (.-labels c) (.toList translatedLabels))
                            (set! previousCompletesNormally
                                  (and (identical? (.-caseKind c) CaseTree$CaseKind/STATEMENT)
                                       (.-completesNormally c)))))))
                    (if (.hasTag tree JCTree$Tag/SWITCH)
                        (do
                          (set! (.-selector (cast JCTree$JCSwitch tree)) selector)
                          (set! (.-cases (cast JCTree$JCSwitch tree)) cases)
                          (set! (.-wasEnumSelector (cast JCTree$JCSwitch tree)) enumSelector)
                          (.append statements (cast JCTree$JCSwitch tree))
                          (set! (.-result this) (.Block make 0 (.toList statements))))
                        (do
                          (set! (.-selector (cast JCTree$JCSwitchExpression tree)) selector)
                          (set! (.-cases (cast JCTree$JCSwitchExpression tree)) cases)
                          (set! (.-wasEnumSelector (cast JCTree$JCSwitchExpression tree))
                                enumSelector)
                          (let [r (cast JCTree$LetExpr
                                        (.setType
                                          (.LetExpr
                                            make
                                            (.toList statements)
                                            (cast JCTree$JCSwitchExpression tree))
                                          (.-type tree)))]
                            (set! (.-needsCond r) true)
                            (set! (.-result this) r))))))))))
      (.hasTag tree JCTree$Tag/SWITCH) (.visitSwitch super (cast JCTree$JCSwitch tree))
      :else (.visitSwitchExpression super (cast JCTree$JCSwitchExpression tree))))

  (method ^:private ^:static patchCompletingNormallyCases ^void [^:mutable ^{:tag (List JCTree$JCCase)} cases]
    (while (.nonEmpty cases)
      (let [currentCase (cast JCTree$JCCase (.-head cases))]
        (when (and (and (and (identical? (.-caseKind currentCase) CaseTree$CaseKind/STATEMENT)
                             (.-completesNormally currentCase))
                        (.nonEmpty (.-tail cases)))
                   (or (some? (.-guard (cast JCTree$JCCase (.-head (.-tail cases)))))
                       (.anyMatch (.stream (.-labels (cast JCTree$JCCase (.-head (.-tail cases)))))
                                  (lambda Predicate ^boolean [^JCTree$JCCaseLabel cl]
                                    (if-instance [^JCTree$JCPatternCaseLabel p cl]
                                      (some? (.-syntheticGuard p))
                                      false)))))
          (let [^{:tag (ListBuffer JCTree$JCStatement)} newStatements (ListBuffer.)
                ^:mutable ^{:tag (List JCTree$JCCase)} copyFrom cases]
            (while (.nonEmpty copyFrom)
              (.appendList newStatements (.-stats (cast JCTree$JCCase (.-head copyFrom))))
              (when-not (.-completesNormally (cast JCTree$JCCase (.-head copyFrom))) (break))
              (set! copyFrom (.-tail copyFrom)))
            (set! (.-stats currentCase) (.toList newStatements))
            (set! (.-completesNormally currentCase) false)))
        (set! cases (.-tail cases)))))

  (method ^:private fixupContinue ^void [this ^JCTree switchTree ^JCTree$JCCase c
                                         ^Symbol$VarSymbol indexVariable ^int currentCaseIndex]
    (.scan (anon TreeScanner []
             (method ^:public visitCase ^void [this ^JCTree$JCCase c]
               (when (== (.size (.-stats c)) 1)
                 (when-instance [^JCTree$JCContinue cont (.-head (.-stats c))]
                   (when (identical? (.-target cont) switchTree)
                     (let [setIndex (.Exec make
                                           (.setType
                                             (.Assign
                                               make
                                               (.Ident make indexVariable)
                                               (.makeLit
                                                 TransPatterns/this
                                                 (.-intType syms)
                                                 (unchecked-add-int currentCaseIndex 1)))
                                             (.-intType syms)))]
                       (set! (.-stats c) (.prepend (.-stats c) setIndex))))))))
           (.-stats c)))

  (method appendBreakIfNeeded ^void [this ^JCTree switchTree ^{:tag (List JCTree$JCCase)} cases
                                     ^JCTree$JCCase c]
    (when (or (identical? (.-caseKind c) CaseTree$CaseKind/RULE)
              (and (identical? (.last cases) c) (.-completesNormally c)))
      (let [^JCTree pos (if (.nonEmpty (.-stats c)) (cast JCTree (.last (.-stats c))) ^JCTree c)
            brk (.Break (.at make (TreeInfo/endPos pos)) nil)]
        (set! (.-target brk) switchTree)
        (set! (.-stats c) (.append (.-stats c) brk)))))

  (method ^:private makePrimitive ^Symbol$DynamicVarSymbol [this
                                                            ^JCDiagnostic$DiagnosticPosition pos
                                                            ^Type primitiveType]
    (Assert/checkNonNull currentClass)
    (let [^{:tag (List Type)} bsm_staticArgs (List/of
                                               (.-methodHandleLookupType syms)
                                               (.-stringType syms)
                                               (Type$ClassType.
                                                 (.getEnclosingType (.-classType syms))
                                                 (List/of (.-constantBootstrapsType syms))
                                                 (.-tsym (.-classType syms))))
          bootstrapName (.fromString names "primitiveClass")
          bsm (.resolveInternalMethod rs
                                      pos
                                      env
                                      (.-constantBootstrapsType syms)
                                      bootstrapName
                                      bsm_staticArgs
                                      (List/nil))
          primitiveGenerator (PrimitiveGenerator.)]
      (.assembleSig primitiveGenerator primitiveType)
      (Symbol$DynamicVarSymbol. (.fromString names (.toString (.-sb primitiveGenerator)))
                                (.-noSymbol syms)
                                (Symbol$MethodHandleSymbol. bsm)
                                (.-classType syms)
                                (new PoolConstant$LoadableConstant/1 []))))

  (method ^:private makeBooleanConstant ^Symbol$DynamicVarSymbol [this
                                                                  ^JCDiagnostic$DiagnosticPosition pos
                                                                  ^int constant]
    (Assert/checkNonNull currentClass)
    (let [^{:tag (List Type)} bsm_staticArgs (List/of
                                               (.-methodHandleLookupType syms)
                                               (.-stringType syms)
                                               (Type$ClassType.
                                                 (.getEnclosingType (.-classType syms))
                                                 (List/of (.-constantBootstrapsType syms))
                                                 (.-tsym (.-classType syms))))
          bootstrapName (.fromString names "getStaticFinal")
          bsm (.resolveInternalMethod rs
                                      pos
                                      env
                                      (.-constantBootstrapsType syms)
                                      bootstrapName
                                      bsm_staticArgs
                                      (List/nil))]
      (Symbol$DynamicVarSymbol.
        ^Name (if (== constant 0) (.fromString names "FALSE") (.fromString names "TRUE"))
        (.-noSymbol syms)
        (Symbol$MethodHandleSymbol. bsm)
        (.boxedTypeOrType types (.-booleanType syms))
        (new PoolConstant$LoadableConstant/1 []))))

  (defclass ^:private PrimitiveGenerator
    :extends Types$SignatureGenerator

    (field ^StringBuilder sb (StringBuilder.))

    (constructor [this] (.super types))

    (method ^:protected append ^void [this ^char ch] (.append sb ch))

    (method ^:protected append ^void [this ^byte/1 ba]
      (.append sb (String. ba)))

    (method ^:protected append ^void [this ^Name name]
      (.append sb (.toString name)))

    (method ^:public toString ^String [this] (.toString sb)))

  (method makeApply ^JCTree$JCMethodInvocation [this ^JCTree$JCExpression selector ^Name name
                                                ^{:tag (List JCTree$JCExpression)} args]
    (let [method (.resolveInternalMethod rs
                                         (.pos currentClassTree)
                                         env
                                         (.-type selector)
                                         name
                                         (TreeInfo/types args)
                                         (List/nil))
          tree (.setType (.App make (.Select make selector method) args)
                         (.erasure types (.getReturnType method)))]
      tree))

  (method makeNewClass ^JCTree$JCNewClass [this ^Type ctype ^{:tag (List JCTree$JCExpression)} args]
    (let [tree (.NewClass make nil nil (.QualIdent make (.-tsym ctype)) args nil)]
      (set! (.-constructor tree)
            (.resolveConstructor rs
                                 (.pos currentClassTree)
                                 (.-env this)
                                 ctype
                                 (TreeInfo/types args)
                                 (List/nil)))
      (set! (.-type tree) ctype)
      tree))

  (method ^:private processCases ^{:tag (List JCTree$JCCase)} [this ^JCTree currentSwitch
                                                               ^{:tag (List JCTree$JCCase)} inputCases]
    (letclass [(^:interface AccummulatorResolver
                 (method ^:public resolve ^void [this ^Symbol$VarSymbol commonBinding
                                                 ^JCTree$JCExpression commonNestedExpression
                                                 ^Symbol$VarSymbol commonNestedBinding]))]
      (let [^{:tag (ListBuffer JCTree$JCCase)} accummulator (ListBuffer.)
            ^{:tag (ListBuffer JCTree$JCCase)} result (ListBuffer.)
            resolveAccummulator (lambda AccummulatorResolver ^void [^Symbol$VarSymbol commonBinding
                                                                    ^JCTree$JCExpression commonNestedExpression
                                                                    ^Symbol$VarSymbol commonNestedBinding]
                                  (let [^:mutable hasUnconditional false]
                                    (if (> (.size accummulator) 1)
                                        (do
                                          (Assert/check
                                            (and
                                              (and
                                                (some? commonBinding)
                                                (some? commonNestedExpression))
                                              (some? commonNestedBinding))
                                            (lambda Supplier ^String []
                                              (java-str
                                                "commonBinding: "
                                                commonBinding
                                                "commonNestedExpression: "
                                                commonNestedExpression
                                                "commonNestedBinding: "
                                                commonNestedBinding)))
                                          (let [^{:tag (ListBuffer JCTree$JCCase)} nestedCases
                                                  (ListBuffer.)
                                                ^:mutable hasGuard false]
                                            (loop [^{:tag (List JCTree$JCCase)} accList (.toList
                                                                                          accummulator)]
                                              (when (.nonEmpty accList)
                                                (let [accummulated (cast
                                                                     JCTree$JCCase
                                                                     (.-head accList))
                                                      accummulatedFirstLabel (cast
                                                                               JCTree$JCPatternCaseLabel
                                                                               (.-head
                                                                                 (.-labels
                                                                                   accummulated)))
                                                      accummulatedPattern (cast
                                                                            JCTree$JCBindingPattern
                                                                            (.-pat
                                                                              accummulatedFirstLabel))
                                                      accummulatedBinding (.-sym
                                                                            (.-var
                                                                              accummulatedPattern))
                                                      ^TreeScanner replaceNested (ReplaceVar.
                                                                                   (Map/of
                                                                                     accummulatedBinding
                                                                                     commonBinding))]
                                                  (.scan replaceNested accummulated)
                                                  (let [^:mutable ^JCTree$JCExpression newGuard nil
                                                        ^:mutable ^JCTree$JCInstanceOf instanceofCheck
                                                          nil]
                                                    (if-instance [^JCTree$JCBinary binOp
                                                                    (.-syntheticGuard
                                                                      accummulatedFirstLabel)]
                                                      (do
                                                        (set! newGuard (.-rhs binOp))
                                                        (set!
                                                          instanceofCheck
                                                          (cast JCTree$JCInstanceOf (.-lhs binOp))))
                                                      (do
                                                        (set! newGuard nil)
                                                        (set!
                                                          instanceofCheck
                                                          (cast
                                                            JCTree$JCInstanceOf
                                                            (.-syntheticGuard
                                                              accummulatedFirstLabel)))))
                                                    (let [binding (cast
                                                                    JCTree$JCBindingPattern
                                                                    (.-pattern instanceofCheck))]
                                                      (set!
                                                        hasUnconditional
                                                        (and
                                                          (if (not
                                                                (.isPrimitive
                                                                  (.erasure types (.-type binding))))
                                                              (.-allowNull instanceofCheck)
                                                              (.isUnconditionallyExactTypeBased
                                                                types
                                                                (.-type commonNestedExpression)
                                                                (.erasure types (.-type binding))))
                                                          (.isEmpty (.-tail accList))))
                                                      (let [^:mutable ^{:tag (List JCTree$JCCaseLabel)} newLabel
                                                              nil
                                                            jcPatternCaseLabelWithGuard
                                                              (.PatternCaseLabel make binding)]
                                                        (set!
                                                          (.-syntheticGuard
                                                            jcPatternCaseLabelWithGuard)
                                                          newGuard)
                                                        (if hasUnconditional
                                                            (set!
                                                              newLabel
                                                              (List/of
                                                                (.ConstantCaseLabel
                                                                  make
                                                                  (.makeNull this))
                                                                jcPatternCaseLabelWithGuard))
                                                            (set!
                                                              newLabel
                                                              (List/of jcPatternCaseLabelWithGuard)))
                                                        (.add
                                                          nestedCases
                                                          (.Case
                                                            make
                                                            CaseTree$CaseKind/STATEMENT
                                                            newLabel
                                                            (.-guard accummulated)
                                                            (.-stats accummulated)
                                                            nil))
                                                        (set!
                                                          hasGuard
                                                          (or
                                                            (some? newGuard)
                                                            (some? (.-guard accummulated))))
                                                        (recur (.-tail accList))))))))
                                            (when (or hasGuard (not hasUnconditional))
                                              (let [continueSwitch (.Continue make nil)]
                                                (set! (.-target continueSwitch) currentSwitch)
                                                (.add
                                                  nestedCases
                                                  (.Case
                                                    make
                                                    CaseTree$CaseKind/STATEMENT
                                                    ^List (if hasUnconditional
                                                              (List/of (.DefaultCaseLabel make))
                                                              (List/of
                                                                (.ConstantCaseLabel
                                                                  make
                                                                  (.makeNull this))
                                                                (.DefaultCaseLabel make)))
                                                    nil
                                                    (List/of continueSwitch)
                                                    nil))))
                                            (let [newSwitch (.Switch
                                                              make
                                                              commonNestedExpression
                                                              (.toList nestedCases))]
                                              (set! (.-patternSwitch newSwitch) true)
                                              (set!
                                                (.-hasUnconditionalPattern newSwitch)
                                                hasUnconditional)
                                              (let [leadingTest (cast
                                                                  JCTree$JCPatternCaseLabel
                                                                  (.-head
                                                                    (.-labels
                                                                      (cast
                                                                        JCTree$JCCase
                                                                        (.first accummulator)))))]
                                                (set! (.-syntheticGuard leadingTest) nil)
                                                (.add
                                                  result
                                                  (.Case
                                                    make
                                                    CaseTree$CaseKind/STATEMENT
                                                    (List/of leadingTest)
                                                    nil
                                                    (List/of newSwitch)
                                                    nil))))))
                                        (.addAll result accummulator))
                                    (.clear accummulator)))
            ^:mutable ^Symbol$VarSymbol commonBinding nil
            ^:mutable ^JCTree$JCExpression commonNestedExpression nil
            ^:mutable ^Symbol$VarSymbol commonNestedBinding nil
            ^:mutable previousNullable false
            ^:mutable previousCompletesNormally false]
        (loop [^{:tag (List JCTree$JCCase)} c inputCases]
          (when (.nonEmpty c)
            (let [^:mutable ^Symbol$VarSymbol currentBinding nil
                  ^:mutable currentNullable false
                  currentCompletesNormally (.-completesNormally (cast JCTree$JCCase (.-head c)))
                  ^:mutable ^JCTree$JCExpression currentNestedExpression nil
                  ^:mutable ^Symbol$VarSymbol currentNestedBinding nil]
              (when (== (.size (.-labels (cast JCTree$JCCase (.-head c)))) 1)
                (when-instance [^JCTree$JCPatternCaseLabel patternLabel (.-head
                                                                          (.-labels
                                                                            (cast
                                                                              JCTree$JCCase
                                                                              (.-head c))))]
                  (if-instance [^JCTree$JCBinary binOp (.-syntheticGuard patternLabel)]
                    (if-instance [^JCTree$JCInstanceOf instanceofCheck (.-lhs binOp)]
                      (if-instance [^JCTree$JCBindingPattern binding (.-pattern instanceofCheck)]
                        (do
                          (set! currentBinding
                                (.-sym (.-var (cast JCTree$JCBindingPattern (.-pat patternLabel)))))
                          (set! currentNullable (.-allowNull instanceofCheck))
                          (set! currentNestedExpression (.-expr instanceofCheck))
                          (set! currentNestedBinding (.-sym (.-var binding))))
                        (when-instance [^JCTree$JCInstanceOf instanceofCheck (.-syntheticGuard
                                                                               patternLabel)]
                          (when-instance [^JCTree$JCBindingPattern binding (.-pattern
                                                                             instanceofCheck)]
                            (set! currentBinding
                                  (.-sym
                                    (.-var (cast JCTree$JCBindingPattern (.-pat patternLabel)))))
                            (set! currentNullable (.-allowNull instanceofCheck))
                            (set! currentNestedExpression (.-expr instanceofCheck))
                            (set! currentNestedBinding (.-sym (.-var binding))))))
                      (when-instance [^JCTree$JCInstanceOf instanceofCheck (.-syntheticGuard
                                                                             patternLabel)]
                        (when-instance [^JCTree$JCBindingPattern binding (.-pattern instanceofCheck)]
                          (set! currentBinding
                                (.-sym (.-var (cast JCTree$JCBindingPattern (.-pat patternLabel)))))
                          (set! currentNullable (.-allowNull instanceofCheck))
                          (set! currentNestedExpression (.-expr instanceofCheck))
                          (set! currentNestedBinding (.-sym (.-var binding))))))
                    (when-instance [^JCTree$JCInstanceOf instanceofCheck (.-syntheticGuard
                                                                           patternLabel)]
                      (when-instance [^JCTree$JCBindingPattern binding (.-pattern instanceofCheck)]
                        (set! currentBinding
                              (.-sym (.-var (cast JCTree$JCBindingPattern (.-pat patternLabel)))))
                        (set! currentNullable (.-allowNull instanceofCheck))
                        (set! currentNestedExpression (.-expr instanceofCheck))
                        (set! currentNestedBinding (.-sym (.-var binding))))))))
              (cond
                (nil? commonBinding)
                  (if (some? currentBinding)
                      (do
                        (set! commonBinding currentBinding)
                        (set! commonNestedExpression currentNestedExpression)
                        (set! commonNestedBinding currentNestedBinding)
                        (.add accummulator (cast JCTree$JCCase (.-head c))))
                      (.add result (cast JCTree$JCCase (.-head c))))
                (and (and (and (and (and (and (and
                                                (some? currentBinding)
                                                (identical?
                                                  (.-tsym (.-type commonBinding))
                                                  (.-tsym (.-type currentBinding))))
                                              (=
                                                (.isUnnamedVariable commonBinding)
                                                (.isUnnamedVariable currentBinding)))
                                         (not previousNullable))
                                    (not currentNullable))
                               (not previousCompletesNormally))
                          (not currentCompletesNormally))
                     (.scan (TreeDiffer. types (List/of commonBinding) (List/of currentBinding))
                            commonNestedExpression
                            currentNestedExpression))
                  (.add accummulator (cast JCTree$JCCase (.-head c)))
                :else
                  (do
                    (.resolve resolveAccummulator
                              commonBinding
                              commonNestedExpression
                              commonNestedBinding)
                    (if (some? currentBinding)
                        (.add accummulator (cast JCTree$JCCase (.-head c)))
                        (.add result (cast JCTree$JCCase (.-head c))))
                    (set! commonBinding currentBinding)
                    (set! commonNestedExpression currentNestedExpression)
                    (set! commonNestedBinding currentNestedBinding)))
              (set! previousNullable currentNullable)
              (set! previousCompletesNormally currentCompletesNormally)
              (recur (.-tail c)))))
        (.resolve resolveAccummulator commonBinding commonNestedExpression commonNestedBinding)
        (.toList result))))

  (method ^:private principalType ^Type [this ^JCTree p]
    (.erasure types (TreeInfo/primaryPatternType p)))

  (method ^:private toLoadableConstant ^PoolConstant$LoadableConstant [this ^JCTree$JCCaseLabel l
                                                                       ^Type selector]
    (cond
      (.hasTag l JCTree$Tag/PATTERNCASELABEL)
        (let [^:mutable principalType (.principalType
                                        this
                                        (.-pat (cast JCTree$JCPatternCaseLabel l)))]
          (when (.switchBootstrapOnlyAllowsReferenceTypesAsCaseLabels target)
            (set! principalType (.boxedTypeOrType types principalType)))
          (if (.isReference principalType)
              (if (.isSubtype types selector principalType)
                  (cast PoolConstant$LoadableConstant selector)
                  (cast PoolConstant$LoadableConstant principalType))
              (.makePrimitive this (.pos l) principalType)))
      (and (.hasTag l JCTree$Tag/CONSTANTCASELABEL) (not (TreeInfo/isNullCaseLabel l)))
        (let [expr (.-expr (cast JCTree$JCConstantCaseLabel l))
              sym (TreeInfo/symbol expr)]
          (if (and (and (some? sym) (.isEnum sym)) (identical? (.-kind sym) Kinds$Kind/VAR))
              (if (.isEnum (.-tsym selector))
                  (PoolConstant$LoadableConstant/String (.toString (.getSimpleName sym)))
                  (.createEnumDesc this
                                   (.pos l)
                                   (cast Symbol$ClassSymbol (.-owner sym))
                                   (.getSimpleName sym)))
              (do
                (Assert/checkNonNull (.constValue (.-type expr)))
                (switch (.getTag (.-type expr))
                  BOOLEAN
                    (.makeBooleanConstant this (.pos l) (cast Integer (.constValue (.-type expr))))
                  (BYTE CHAR SHORT INT)
                    (PoolConstant$LoadableConstant/Int (cast Integer (.constValue (.-type expr))))
                  LONG (PoolConstant$LoadableConstant/Long (cast Long (.constValue (.-type expr))))
                  FLOAT
                    (PoolConstant$LoadableConstant/Float (cast Float (.constValue (.-type expr))))
                  DOUBLE
                    (PoolConstant$LoadableConstant/Double (cast Double (.constValue (.-type expr))))
                  CLASS
                    (PoolConstant$LoadableConstant/String (cast String (.constValue (.-type expr))))
                  (throw (AssertionError.))))))))

  (method ^:private createEnumDesc ^PoolConstant$LoadableConstant [this
                                                                   ^JCDiagnostic$DiagnosticPosition pos
                                                                   ^Symbol$ClassSymbol enumClass
                                                                   ^Name constant]
    (let [classDesc (.resolveInternalMethod rs
                                            pos
                                            env
                                            (.-classDescType syms)
                                            (.-of names)
                                            (List/of (.-stringType syms))
                                            (List/nil))
          enumDesc (.resolveInternalMethod rs
                                           pos
                                           env
                                           (.-enumDescType syms)
                                           (.-of names)
                                           (List/of (.-classDescType syms) (.-stringType syms))
                                           (List/nil))]
      (.invokeMethodWrapper this
                            pos
                            (.asHandle enumDesc)
                            (.invokeMethodWrapper
                              this
                              pos
                              (.asHandle classDesc)
                              (PoolConstant$LoadableConstant/String
                                (.toString (.-flatname enumClass))))
                            (PoolConstant$LoadableConstant/String (.toString constant)))))

  (method ^:private invokeMethodWrapper ^PoolConstant$LoadableConstant [this
                                                                        ^JCDiagnostic$DiagnosticPosition pos
                                                                        ^Symbol$MethodHandleSymbol toCall
                                                                        &
                                                                        ^PoolConstant$LoadableConstant/1 params]
    (let [^{:tag (List Type)} bsm_staticArgs (List/of
                                               (.-methodHandleLookupType syms)
                                               (.-stringType syms)
                                               (Type$ClassType.
                                                 (.getEnclosingType (.-classType syms))
                                                 (List/of (.-botType syms))
                                                 (.-tsym (.-classType syms)))
                                               (new
                                                 Type/1
                                                 [(.-methodHandleType syms)
                                                  (.makeArrayType types (.-objectType syms))]))
          bsm (.resolveInternalMethod rs
                                      pos
                                      env
                                      (.-constantBootstrapsType syms)
                                      (.-invoke names)
                                      bsm_staticArgs
                                      (List/nil))
          actualParams (new PoolConstant$LoadableConstant/1 (unchecked-add-int (alength params) 1))]
      (aset actualParams 0 toCall)
      (System/arraycopy params 0 actualParams 1 (alength params))
      (Symbol$DynamicVarSymbol. (.-name bsm)
                                (.-owner bsm)
                                (.asHandle bsm)
                                (.getReturnType toCall)
                                actualParams)))

  (method ^:public visitBinary ^void [this ^JCTree$JCBinary tree]
    (set! bindingContext (BasicBindingContext.))
    (try
      (.visitBinary super tree)
      (set! (.-result this) (.decorateExpression bindingContext tree))
      (finally (.pop bindingContext))))

  (method ^:public visitConditional ^void [this ^JCTree$JCConditional tree]
    (set! bindingContext (BasicBindingContext.))
    (try
      (.visitConditional super tree)
      (set! (.-result this) (.decorateExpression bindingContext tree))
      (finally (.pop bindingContext))))

  (method ^:public visitIf ^void [this ^JCTree$JCIf tree]
    (set! bindingContext (BasicBindingContext.))
    (try
      (.visitIf super tree)
      (set! (.-result this) (.decorateStatement bindingContext tree))
      (finally (.pop bindingContext))))

  (method ^:public visitForLoop ^void [this ^JCTree$JCForLoop tree]
    (set! bindingContext (BasicBindingContext.))
    (try
      (.visitForLoop super tree)
      (set! (.-result this) (.decorateStatement bindingContext tree))
      (finally (.pop bindingContext))))

  (method ^:public visitWhileLoop ^void [this ^JCTree$JCWhileLoop tree]
    (set! bindingContext (BasicBindingContext.))
    (try
      (.visitWhileLoop super tree)
      (set! (.-result this) (.decorateStatement bindingContext tree))
      (finally (.pop bindingContext))))

  (method ^:public visitDoLoop ^void [this ^JCTree$JCDoWhileLoop tree]
    (set! bindingContext (BasicBindingContext.))
    (try
      (.visitDoLoop super tree)
      (set! (.-result this) (.decorateStatement bindingContext tree))
      (finally (.pop bindingContext))))

  (method ^:public visitMethodDef ^void [this ^JCTree$JCMethodDecl tree]
    (let [prevMethodSym currentMethodSym
          prevVariableIndex variableIndex
          ^{:tag (Set JCTree$JCMethodInvocation)} prevDeconstructorCalls deconstructorCalls]
      (try
        (set! currentMethodSym (.-sym tree))
        (set! variableIndex 0)
        (set! deconstructorCalls nil)
        (.visitMethodDef super tree)
        (.preparePatternMatchingCatchIfNeeded this (.-body tree))
        (finally
          (set! variableIndex prevVariableIndex)
          (set! currentMethodSym prevMethodSym)
          (set! deconstructorCalls prevDeconstructorCalls)))))

  (method ^:public visitIdent ^void [this ^JCTree$JCIdent tree]
    (let [^:mutable ^Symbol$VarSymbol bindingVar nil]
      (when-not (== (bit-and (.flags (.-sym tree)) Flags/MATCH_BINDING) 0)
        (set! bindingVar (.getBindingFor bindingContext (cast Symbol$BindingSymbol (.-sym tree)))))
      (if (nil? bindingVar)
          (.visitIdent super tree)
          (set! (.-result this)
                (.setType (.Ident (.at make (.-pos tree)) bindingVar) (.erasure bindingVar types))))))

  (method ^:public visitBlock ^void [this ^JCTree$JCBlock tree]
    (let [^{:tag (ListBuffer JCTree$JCStatement)} statements (ListBuffer.)]
      (set! bindingContext
            (anon BindingDeclarationFenceBindingContext []
              (method tryPrepend ^boolean [this ^Symbol$BindingSymbol binding
                                           ^JCTree$JCVariableDecl var]
                (.put (.-hoistedVarMap this) binding (.-sym var))
                (.append statements var)
                true)))
      (let [oldMethodSym currentMethodSym
            prevVariableIndex variableIndex]
        (try
          (let [isInit (nil? currentMethodSym)
                ^{:tag (Set JCTree$JCMethodInvocation)} prevDeconstructorCalls deconstructorCalls]
            (try
              (when isInit
                (set! currentMethodSym
                      (Symbol$MethodSymbol. (bit-or (.-flags tree) Flags/BLOCK)
                                            (.-empty names)
                                            nil
                                            currentClass))
                (set! variableIndex 0)
                (set! deconstructorCalls nil))
              (loop [^{:tag (List JCTree$JCStatement)} l (.-stats tree)]
                (when (.nonEmpty l)
                  (.append statements
                           (cast JCTree$JCStatement
                                 (.translate this (cast JCTree$JCStatement (.-head l)))))
                  (recur (.-tail l))))
              (when isInit (.preparePatternMatchingCatchIfNeeded this tree))
              (finally (when isInit (set! deconstructorCalls prevDeconstructorCalls))))
            (set! (.-stats tree) (.toList statements))
            (set! (.-result this) tree))
          (finally
            (set! variableIndex prevVariableIndex)
            (set! currentMethodSym oldMethodSym)
            (.pop bindingContext))))))

  (method ^:public visitLambda ^void [this ^JCTree$JCLambda tree]
    (let [prevContent bindingContext
          prevVariableIndex variableIndex]
      (try
        (set! bindingContext (BindingDeclarationFenceBindingContext.))
        (set! variableIndex 0)
        (set! (.-params tree) (.translate this (.-params tree)))
        (let [^{:tag (Set JCTree$JCMethodInvocation)} prevDeconstructorCalls deconstructorCalls]
          (try
            (set! deconstructorCalls nil)
            (set! (.-body tree) (.translate this (.-body tree)))
            (when (some? deconstructorCalls)
              (when-instance [^JCTree$JCExpression value (.-body tree)]
                (if (.hasTag (.-type value) TypeTag/VOID)
                    (set! (.-body tree) (.Block make 0 (List/of (.Exec make value))))
                    (set! (.-body tree) (.Block make 0 (List/of (.Return make value))))))
              (if-instance [^JCTree$JCBlock block (.-body tree)]
                (.preparePatternMatchingCatchIfNeeded this block)
                (throw (Assert/error (java-str "Unexpected lambda body type: "
                                               (.getKind (.-body tree)))))))
            (finally (set! deconstructorCalls prevDeconstructorCalls)))
          (set! (.-result this) tree))
        (finally (set! variableIndex prevVariableIndex) (set! bindingContext prevContent)))))

  (method ^:public visitClassDef ^void [this ^JCTree$JCClassDecl tree]
    (let [prevCurrentClass currentClass
          prevCurrentClassTree currentClassTree
          ^{:tag (ListBuffer JCTree)} prevPendingMethods pendingMethods
          prevMethodSym currentMethodSym
          ^{:tag (Map Symbol$RecordComponent Symbol$MethodSymbol)} prevAccessor2Proxy
            component2Proxy]
      (try
        (set! currentClass (.-sym tree))
        (set! currentClassTree tree)
        (set! pendingMethods (ListBuffer.))
        (set! currentMethodSym nil)
        (set! component2Proxy (HashMap.))
        (.visitClassDef super tree)
        (set! (.-defs tree) (.prependList (.-defs tree) (.toList pendingMethods)))
        (finally
          (set! currentClass prevCurrentClass)
          (set! currentClassTree prevCurrentClassTree)
          (set! pendingMethods prevPendingMethods)
          (set! currentMethodSym prevMethodSym)
          (set! component2Proxy prevAccessor2Proxy)))))

  (method ^:public visitVarDef ^void [this ^JCTree$JCVariableDecl tree]
    (let [prevMethodSym currentMethodSym
          prevVariableIndex variableIndex]
      (try
        (set! (.-mods tree) (cast JCTree$JCModifiers (.translate this (.-mods tree))))
        (set! (.-vartype tree) (cast JCTree$JCExpression (.translate this (.-vartype tree))))
        (when (nil? currentMethodSym)
          (set! currentMethodSym
                (Symbol$MethodSymbol.
                  (bit-or (bit-and (.-flags (.-mods tree)) Flags/STATIC) Flags/BLOCK)
                  (.-empty names)
                  nil
                  currentClass))
          (set! variableIndex 0))
        (when (some? (.-init tree))
          (set! (.-init tree) (cast JCTree$JCExpression (.translate this (.-init tree)))))
        (set! (.-result this) tree)
        (finally (set! variableIndex prevVariableIndex) (set! currentMethodSym prevMethodSym)))))

  (method ^:public visitTry ^void [this ^JCTree$JCTry tree]
    (set! (.-resources tree) (.translate this (.-resources tree)))
    (let [^{:tag (Set JCTree$JCMethodInvocation)} prevDeconstructorCalls deconstructorCalls]
      (try
        (set! deconstructorCalls nil)
        (set! (.-body tree) (cast JCTree$JCBlock (.translate this (.-body tree))))
        (.preparePatternMatchingCatchIfNeeded this (.-body tree))
        (finally (set! deconstructorCalls prevDeconstructorCalls)))
      (set! (.-catchers tree) (.translateCatchers this (.-catchers tree)))
      (set! (.-finalizer tree) (cast JCTree$JCBlock (.translate this (.-finalizer tree))))
      (set! (.-result this) tree)))

  (method ^:private preparePatternMatchingCatchIfNeeded ^void [this ^JCTree$JCBlock tree]
    (when (some? deconstructorCalls)
      (let [ctch (Symbol$VarSymbol. Flags/SYNTHETIC
                                    (.fromString
                                      names
                                      (java-str "catch"
                                                (let [old-7 variableIndex]
                                                  (set!
                                                    variableIndex
                                                    (unchecked-inc-int variableIndex))
                                                  old-7)
                                                (.syntheticNameChar target)))
                                    (.-throwableType syms)
                                    currentMethodSym)
            patternMatchingCatch (.Catch make
                                         (.VarDef make ctch nil)
                                         (.Block
                                           make
                                           0
                                           (List/of
                                             (.Throw
                                               make
                                               (.makeNewClass
                                                 this
                                                 (.-matchExceptionType syms)
                                                 (List/of
                                                   (.makeApply
                                                     this
                                                     (.Ident make ctch)
                                                     (.-toString names)
                                                     (List/nil))
                                                   (.Ident make ctch)))))))]
        (set! (.-patternMatchingCatch tree)
              (JCTree$JCBlock$PatternMatchingCatch. patternMatchingCatch deconstructorCalls))
        (set! deconstructorCalls nil))))

  (method ^:public translateTopLevelClass ^JCTree [this ^{:tag (Env AttrContext)} env ^JCTree cdef
                                                   ^TreeMaker make]
    (try
      (set! (.-make this) make)
      (set! (.-env this) env)
      (.translate this cdef)
      (finally (set! (.-make this) nil) (set! (.-env this) nil)))
    cdef)

  (method makeTypeTest ^JCTree$JCInstanceOf [this ^JCTree$JCExpression lhs ^JCTree$JCExpression type]
    (let [tree (.TypeTest make lhs type)] (set! (.-type tree) (.-booleanType syms)) tree))

  (method makeBinary ^JCTree$JCBinary [this ^JCTree$Tag optag ^JCTree$JCExpression lhs
                                       ^JCTree$JCExpression rhs]
    (let [tree (.Binary make optag lhs rhs)]
      (set! (.-operator tree) (.resolveBinary operators tree optag (.-type lhs) (.-type rhs)))
      (set! (.-type tree) (.getReturnType (.-type (.-operator tree))))
      tree))

  (method makeUnary ^JCTree$JCUnary [this ^JCTree$Tag optag ^JCTree$JCExpression arg]
    (let [tree (.Unary make optag arg)]
      (set! (.-operator tree) (.resolveUnary operators tree optag (.-type arg)))
      (set! (.-type tree) (.getReturnType (.-type (.-operator tree))))
      tree))

  (method convert ^JCTree$JCExpression [this ^JCTree$JCExpression expr ^Type target]
    (if (.isSubtype types (.-type expr) target)
        expr
        (let [^JCTree$JCExpression result (.TypeCast
                                            (.at make (.pos expr))
                                            (.Type make target)
                                            expr)]
          (set! (.-type result) target)
          result)))

  (method mergeConditions ^JCTree$JCExpression [this ^JCTree$JCExpression left
                                                ^JCTree$JCExpression right]
    (if-instance [^:mutable ^JCTree$JCBinary lastBinary left]
      (do
        (loop []
          (when-instance [^JCTree$JCBinary nextBinary (.-rhs lastBinary)]
            (set! lastBinary nextBinary)
            (recur)))
        (set! (.-rhs lastBinary) (.makeBinary this JCTree$Tag/AND (.-rhs lastBinary) right))
        left)
      (.makeBinary this JCTree$Tag/AND left right)))

  (defclass ^:abstract BindingContext
    (method ^:abstract bindingDeclared ^Symbol$VarSymbol [this ^Symbol$BindingSymbol varSymbol])

    (method ^:abstract getBindingFor ^Symbol$VarSymbol [this ^Symbol$BindingSymbol varSymbol])

    (method ^:abstract bindingVars ^{:tag (List JCTree$JCStatement)} [this ^int diagPos])

    (method ^:abstract decorateStatement ^JCTree$JCStatement [this ^JCTree$JCStatement stat])

    (method ^:abstract decorateExpression ^JCTree$JCExpression [this ^JCTree$JCExpression expr])

    (method ^:abstract pop ^BindingContext [this])

    (method ^:abstract tryPrepend ^boolean [this ^Symbol$BindingSymbol binding
                                            ^JCTree$JCVariableDecl var]))

  (defclass BasicBindingContext
    :extends BindingContext

    (field ^{:tag (Map Symbol$BindingSymbol Symbol$VarSymbol)} hoistedVarMap)

    (field ^BindingContext parent)

    (constructor ^:public [this]
      (set! (.-parent this) bindingContext)
      (set! (.-hoistedVarMap this) (LinkedHashMap.)))

    (method bindingDeclared ^Symbol$VarSymbol [this ^Symbol$BindingSymbol varSymbol]
      (let [^:mutable res (.bindingDeclared parent varSymbol)]
        (when (nil? res)
          (set! res
                (Symbol$VarSymbol. (bit-and (.flags varSymbol) (bit-not Flags/MATCH_BINDING))
                                   (.-name varSymbol)
                                   (.-type varSymbol)
                                   currentMethodSym))
          (.setTypeAttributes res (.getRawTypeAttributes varSymbol))
          (.put hoistedVarMap varSymbol res))
        res))

    (method getBindingFor ^Symbol$VarSymbol [this ^Symbol$BindingSymbol varSymbol]
      (let [res (.getBindingFor parent varSymbol)]
        (if (some? res)
            res
            (cast Symbol$VarSymbol
                  (.orElse (.map (.findFirst (.filter
                                               (.stream (.entrySet hoistedVarMap))
                                               (lambda Predicate ^boolean [^Map$Entry e]
                                                 (.isAliasFor
                                                   (cast Symbol$BindingSymbol (.getKey e))
                                                   varSymbol))))
                                 (lambda Function ^Symbol$VarSymbol [^Map$Entry e]
                                   (cast Symbol$VarSymbol (.getValue e))))
                           nil)))))

    (method bindingVars ^{:tag (List JCTree$JCStatement)} [this ^int diagPos]
      (if (.isEmpty hoistedVarMap)
          (List/nil)
          (let [^{:tag (ListBuffer JCTree$JCStatement)} stats (ListBuffer.)]
            (for-each [^{:tag (Map$Entry Symbol$BindingSymbol Symbol$VarSymbol)} e (.entrySet
                                                                                     hoistedVarMap)]
              (let [decl (.makeHoistedVarDecl this diagPos (cast Symbol$VarSymbol (.getValue e)))]
                (when (and (not (.isUnnamedVariable (cast Symbol$VarSymbol (.getValue e))))
                           (or (not (.isPreserved (cast Symbol$BindingSymbol (.getKey e))))
                               (not (.tryPrepend
                                      parent
                                      (cast Symbol$BindingSymbol (.getKey e))
                                      decl))))
                  (.add stats decl))))
            (.toList stats))))

    (method decorateStatement ^JCTree$JCStatement [this ^:mutable ^JCTree$JCStatement stat]
      (let [^{:tag (List JCTree$JCStatement)} stats (.bindingVars this (.-pos stat))]
        (when (.nonEmpty stats) (set! stat (.Block (.at make (.-pos stat)) 0 (.append stats stat))))
        stat))

    (method decorateExpression ^JCTree$JCExpression [this ^:mutable ^JCTree$JCExpression expr]
      (for-each [^Symbol$VarSymbol vsym (.values hoistedVarMap)]
        (set! expr
              (.setType (.LetExpr (.at make (.-pos expr))
                                  (.makeHoistedVarDecl this (.-pos expr) vsym)
                                  expr)
                        (.-type expr))))
      expr)

    (method pop ^BindingContext [this] (set! bindingContext parent))

    (method tryPrepend ^boolean [this ^Symbol$BindingSymbol binding ^JCTree$JCVariableDecl var]
      false)

    (method ^:private makeHoistedVarDecl ^JCTree$JCVariableDecl [this ^int pos
                                                                 ^Symbol$VarSymbol varSymbol]
      (.VarDef (.at make pos) varSymbol nil)))

  (defclass ^:private BindingDeclarationFenceBindingContext
    :extends BasicBindingContext

    (method bindingDeclared ^Symbol$VarSymbol [this ^Symbol$BindingSymbol varSymbol]
      nil))

  (method makeLit ^JCTree$JCExpression [this ^Type type value]
    (.setType (.Literal make (.getTag type) value) (.constType type value)))

  (method makeNull ^JCTree$JCExpression [this]
    (.makeLit this (.-botType syms) nil))

  (defclass ^:private ReplaceVar
    :extends TreeScanner

    (field ^:private ^:final ^{:tag (Map Symbol Symbol)} fromTo)

    (constructor ^:public [this ^{:tag (Map Symbol Symbol)} fromTo]
      (set! (.-fromTo this) fromTo))

    (method ^:public visitIdent ^void [this ^JCTree$JCIdent tree]
      (set! (.-sym tree) (cast Symbol (.getOrDefault fromTo (.-sym tree) (.-sym tree))))
      (.visitIdent super tree))

    (method ^:public visitPatternCaseLabel ^void [this ^JCTree$JCPatternCaseLabel tree]
      (.visitPatternCaseLabel super tree)
      (.scan this (.-syntheticGuard tree)))))

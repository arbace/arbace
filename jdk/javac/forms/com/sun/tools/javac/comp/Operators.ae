  (method lookupBinaryOp ^Symbol$OperatorSymbol [this
                                                 ^{:tag (Predicate Symbol$OperatorSymbol)} applicabilityTest]
    (cast Symbol$OperatorSymbol
          (.get (.findFirst
                  (.filter
                    (.distinct
                      (.map (.flatMap (.stream (.values binaryOperators))
                                      (method-ref Function ^Stream [List] List/.stream))
                            (lambda Function ^Symbol$OperatorSymbol [^BinaryOperatorHelper helper]
                              (.doLookup helper applicabilityTest))))
                    (lambda Predicate ^boolean [^Symbol$OperatorSymbol sym]
                      (not (identical? sym noOpSymbol))))))))

  (method ^:private ^:final ^{SafeVarargs true} initOperators :type-params [(O
                                                                              extends
                                                                              OperatorHelper)] ^void [this
                                                                                                      ^{:tag (Map Name (List O))} opsMap
                                                                                                      &
                                                                                                      ^O/1 ops]
    (for-each [^O o ops]
      (let [opName (.-name o)
            ^{:tag (List O)} helpers (cast List (.getOrDefault opsMap opName (List/nil)))]
        (.put opsMap opName (.prepend helpers o)))))

  (method ^:private initOperatorNames ^void [this]
    (.setOperatorName this JCTree$Tag/POS "+")
    (.setOperatorName this JCTree$Tag/NEG "-")
    (.setOperatorName this JCTree$Tag/NOT "!")
    (.setOperatorName this JCTree$Tag/COMPL "~")
    (.setOperatorName this JCTree$Tag/PREINC "++")
    (.setOperatorName this JCTree$Tag/PREDEC "--")
    (.setOperatorName this JCTree$Tag/POSTINC "++")
    (.setOperatorName this JCTree$Tag/POSTDEC "--")
    (.setOperatorName this JCTree$Tag/NULLCHK "<*nullchk*>")
    (.setOperatorName this JCTree$Tag/OR "||")
    (.setOperatorName this JCTree$Tag/AND "&&")
    (.setOperatorName this JCTree$Tag/EQ "==")
    (.setOperatorName this JCTree$Tag/NE "!=")
    (.setOperatorName this JCTree$Tag/LT "<")
    (.setOperatorName this JCTree$Tag/GT ">")
    (.setOperatorName this JCTree$Tag/LE "<=")
    (.setOperatorName this JCTree$Tag/GE ">=")
    (.setOperatorName this JCTree$Tag/BITOR "|")
    (.setOperatorName this JCTree$Tag/BITXOR "^")
    (.setOperatorName this JCTree$Tag/BITAND "&")
    (.setOperatorName this JCTree$Tag/SL "<<")
    (.setOperatorName this JCTree$Tag/SR ">>")
    (.setOperatorName this JCTree$Tag/USR ">>>")
    (.setOperatorName this JCTree$Tag/PLUS "+")
    (.setOperatorName this JCTree$Tag/MINUS (.-hyphen names))
    (.setOperatorName this JCTree$Tag/MUL (.-asterisk names))
    (.setOperatorName this JCTree$Tag/DIV (.-slash names))
    (.setOperatorName this JCTree$Tag/MOD "%"))

  (method ^:private setOperatorName ^void [this ^JCTree$Tag tag ^String name]
    (.setOperatorName this tag (.fromString names name)))

  (method ^:private setOperatorName ^void [this ^JCTree$Tag tag ^Name name]
    (aset opname (.operatorIndex tag) name)))

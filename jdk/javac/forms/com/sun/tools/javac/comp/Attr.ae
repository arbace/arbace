  (method ^:public attribType ^Type [this ^JCTree tree ^{:tag (Env AttrContext)} env]
    (let [result (.attribType this tree env Type/noType)] result))

  (method attribType ^Type [this ^JCTree tree ^{:tag (Env AttrContext)} env ^Type pt]
    (let [result (.attribTree this tree env (ResultInfo. Kinds$KindSelector/TYP pt))] result))

  (method ^:public attribStat ^Type [this ^JCTree tree ^{:tag (Env AttrContext)} env]
    (let [^{:tag (Env AttrContext)} analyzeEnv (.copyEnvIfNeeded analyzer tree env)
          result (.attribTree this tree env statInfo)]
      (.analyzeIfNeeded analyzer tree analyzeEnv)
      (.doRecovery attrRecover)
      result))

  (method attribExprs ^{:tag (List Type)} [this ^{:tag (List JCTree$JCExpression)} trees
                                           ^{:tag (Env AttrContext)} env ^Type pt]
    (let [^{:tag (ListBuffer Type)} ts (ListBuffer.)]
      (loop [^{:tag (List JCTree$JCExpression)} l trees]
        (when (.nonEmpty l)
          (.append ts (.attribExpr this (cast JCTree (.-head l)) env pt))
          (recur (.-tail l))))
      (.toList ts)))

  (method attribStats :type-params [(T extends JCTree)] ^void [this ^{:tag (List T)} trees
                                                               ^{:tag (Env AttrContext)} env]
    (loop [^{:tag (List T)} l trees]
      (when (.nonEmpty l) (.attribStat this (cast JCTree (.-head l)) env) (recur (.-tail l)))))

  (method attribArgs ^Kinds$KindSelector [this ^Kinds$KindSelector initialKind
                                          ^{:tag (List JCTree$JCExpression)} trees
                                          ^{:tag (Env AttrContext)} env
                                          ^{:tag (ListBuffer Type)} argtypes]
    (let [^:mutable kind initialKind]
      (for-each [^JCTree$JCExpression arg trees]
        (let [argtype (.checkNonVoid chk arg (.attribTree this arg env methodAttrInfo))]
          (when (.hasTag argtype TypeTag/DEFERRED)
            (set! kind (Kinds$KindSelector/of Kinds$KindSelector/POLY kind)))
          (.append argtypes argtype)))
      kind))

  (method attribAnyTypes ^{:tag (List Type)} [this ^{:tag (List JCTree$JCExpression)} trees
                                              ^{:tag (Env AttrContext)} env]
    (let [^{:tag (ListBuffer Type)} argtypes (ListBuffer.)]
      (loop [^{:tag (List JCTree$JCExpression)} l trees]
        (when (.nonEmpty l)
          (.append argtypes (.attribType this (cast JCTree (.-head l)) env))
          (recur (.-tail l))))
      (.toList argtypes)))

  (method attribTypes ^{:tag (List Type)} [this ^{:tag (List JCTree$JCExpression)} trees
                                           ^{:tag (Env AttrContext)} env]
    (let [^{:tag (List Type)} types (.attribAnyTypes this trees env)]
      (.checkRefTypes chk trees types)))

  (method attribTypeVariables ^void [this ^{:tag (List JCTree$JCTypeParameter)} typarams
                                     ^{:tag (Env AttrContext)} env ^boolean checkCyclic]
    (for-each [^JCTree$JCTypeParameter tvar typarams]
      (let [a (cast Type$TypeVar (.-type tvar))]
        (let [o-3 (.-tsym a)]
          (set! (.-flags_field o-3) (bit-or (.-flags_field o-3) Flags/UNATTRIBUTED)))
        (.setUpperBound a Type/noType)
        (if (not (.isEmpty (.-bounds tvar)))
            (let [^:mutable ^{:tag (List Type)} bounds (List/of
                                                         (.attribType
                                                           this
                                                           (cast JCTree (.-head (.-bounds tvar)))
                                                           env))]
              (for-each [^JCTree$JCExpression bound (.-tail (.-bounds tvar))]
                (set! bounds (.prepend bounds (.attribType this bound env))))
              (.setBounds types a (.reverse bounds)))
            (.setBounds types a (List/of (.-objectType syms))))
        (let [o-4 (.-tsym a)]
          (set! (.-flags_field o-4) (bit-and (.-flags_field o-4) (bit-not-int Flags/UNATTRIBUTED))))))
    (when checkCyclic
      (for-each [^JCTree$JCTypeParameter tvar typarams]
        (.checkNonCyclic chk (.pos tvar) (cast Type$TypeVar (.-type tvar))))))

  (method attribAnnotationTypes ^void [this ^{:tag (List JCTree$JCAnnotation)} annotations
                                       ^{:tag (Env AttrContext)} env]
    (loop [^{:tag (List JCTree$JCAnnotation)} al annotations]
      (when (.nonEmpty al)
        (let [a (cast JCTree$JCAnnotation (.-head al))]
          (.attribType this (.-annotationType a) env)
          (recur (.-tail al))))))

  (method ^:public attribLazyConstantValue [this ^{:tag (Env AttrContext)} env
                                            ^{:tag (Env AttrContext)} enclosingEnv
                                            ^JCTree$JCVariableDecl variable ^:mutable ^Type type]
    (let [prevSource (.useSource log (.-sourcefile (.-toplevel env)))]
      (try
        (.doQueueScanTreeAndTypeAnnotateForVarInit this variable enclosingEnv)
        (let [itype (.attribExpr this (.-init variable) env type)]
          (when (.isImplicitlyTyped variable)
            (set! type
                  (set! (.-type variable)
                        (set! (.-type (.-sym variable))
                              (.checkLocalVarType chk variable itype (.-name variable))))))
          (when (some? (.constValue itype)) (.constValue (.coerce this itype type))))
        (finally (.useSource log prevSource)))))

  (method attribBase ^Type [this ^JCTree tree ^{:tag (Env AttrContext)} env ^boolean classExpected
                            ^boolean interfaceExpected ^boolean checkExtensible]
    (let [^Type t (if (some? (.-type tree)) (.-type tree) (.attribType this tree env))]
      (try
        (.checkBase this t tree env classExpected interfaceExpected checkExtensible)
        (catch Symbol$CompletionFailure ex (.completionError chk (.pos tree) ex) t))))

  (method checkBase ^Type [this ^:mutable ^Type t ^JCTree tree ^{:tag (Env AttrContext)} env
                           ^boolean classExpected ^boolean interfaceExpected
                           ^boolean checkExtensible]
    (let [^JCDiagnostic$DiagnosticPosition pos (if (.hasTag tree JCTree$Tag/TYPEAPPLY)
                                                   (.pos (.-clazz (cast JCTree$JCTypeApply tree)))
                                                   (.pos tree))]
      (cond
        (.isAnonymous (.-tsym t))
          (do
            (.error log pos CompilerProperties$Errors/CantInheritFromAnon)
            (.createErrorType types t))
        (.isErroneous t) t
        :else
          (do
            (if (and (and (.hasTag t TypeTag/TYPEVAR) (not classExpected)) (not interfaceExpected))
                (when (nil? (.getUpperBound t))
                  (.error log pos CompilerProperties$Errors/IllegalForwardRef)
                  (return (.createErrorType types t)))
                (set! t (.checkClassType chk pos t checkExtensible)))
            (cond
              (and interfaceExpected (== (bit-and (.flags (.-tsym t)) Flags/INTERFACE) 0))
                (do
                  (.error log pos CompilerProperties$Errors/IntfExpectedHere)
                  (.createErrorType types t))
              (and (and checkExtensible classExpected)
                   (not (== (bit-and (.flags (.-tsym t)) Flags/INTERFACE) 0)))
                (do
                  (.error log pos CompilerProperties$Errors/NoIntfExpectedHere)
                  (.createErrorType types t))
              :else
                (do
                  (when (and checkExtensible (not (== (bit-and (.flags (.-tsym t)) Flags/FINAL) 0)))
                    (.error log pos (CompilerProperties$Errors/CantInheritFromFinal (.-tsym t))))
                  (.checkNonCyclic chk pos t)
                  t))))))

  (method attribIdentAsEnumType ^Type [this ^{:tag (Env AttrContext)} env ^JCTree$JCIdent id]
    (Assert/check (not (== (bit-and (.flags (.-sym (.-enclClass env))) Flags/ENUM) 0)))
    (set! (.-type id) (.-type (.enclClass (.-owner (.-scope (cast AttrContext (.-info env)))))))
    (set! (.-sym id) (.enclClass (.-owner (.-scope (cast AttrContext (.-info env))))))
    (.-type id))

  (method ^:public visitClassDef ^void [this ^JCTree$JCClassDecl tree]
    (let [^{:tag (Optional ArgumentAttr$LocalCacheContext)} localCacheContext (Optional/ofNullable
                                                                                ^ArgumentAttr$LocalCacheContext (when (.-isSpeculative
                                                                                                                        (.-attributionMode
                                                                                                                          (cast
                                                                                                                            AttrContext
                                                                                                                            (.-info
                                                                                                                              env))))
                                                                                                                  (.withLocalCacheContext
                                                                                                                    argumentAttr)))
          ctorProloguePrev (.-ctorPrologue (cast AttrContext (.-info env)))]
      (try
        (cond
          (.matches (.-kind (.-owner (.-scope (cast AttrContext (.-info env)))))
                    Kinds$KindSelector/VAL_MTH)
            (.classEnter enter tree env)
          (and (.hasTag (.-tree env) JCTree$Tag/NEWCLASS) (TreeInfo/isInAnnotation env tree))
            (.classEnter enter tree env))
        (let [c (.-sym tree)]
          (if (nil? c)
              (set! result nil)
              (do
                (.complete c)
                (when ctorProloguePrev
                  (set! (.-flags_field c) (bit-or (.-flags_field c) Flags/NOOUTERTHIS)))
                (.attribClass this (.pos tree) c)
                (set! result (set! (.-type tree) (.-type c))))))
        (finally
          (.ifPresent localCacheContext
                      (method-ref Consumer
                                  [ArgumentAttr$LocalCacheContext]
                                  ArgumentAttr$LocalCacheContext/.leave))
          (set! (.-ctorPrologue (cast AttrContext (.-info env))) ctorProloguePrev)))))

  (method ^:public visitMethodDef ^void [this ^JCTree$JCMethodDecl tree]
    (let [m (.-sym tree)
          isDefaultMethod (not (== (bit-and (.flags m) Flags/DEFAULT) 0))
          lint (.augment (.-lint (cast AttrContext (.-info env))) m)
          prevLint (.setLint chk lint)
          ctorProloguePrev (.-ctorPrologue (cast AttrContext (.-info env)))]
      (Assert/check (not (.-ctorPrologue (cast AttrContext (.-info env)))))
      (let [prevMethod (.setMethod chk m)]
        (try
          (.checkDeprecatedAnnotation chk (.pos tree) m)
          (let [^{:tag (Env AttrContext)} localEnv (.methodEnv memberEnter tree env)]
            (set! (.-lint (cast AttrContext (.-info localEnv))) lint)
            (.attribStats this (.-typarams tree) localEnv)
            (if (.isStatic m)
                (.checkHideClashes chk (.pos tree) (.-type (.-enclClass env)) m)
                (.checkOverrideClashes chk (.pos tree) (.-type (.-enclClass env)) m))
            (.checkOverride chk env tree m)
            (when (and isDefaultMethod (.overridesObjectMethod types (.enclClass m) m))
              (.error log
                      tree
                      (CompilerProperties$Errors/DefaultOverridesObjectMember
                        (.-name m)
                        (Kinds/kindName (.location m))
                        (.location m))))
            (loop [^{:tag (List JCTree$JCTypeParameter)} l (.-typarams tree)]
              (when (.nonEmpty l)
                (.enterIfAbsent (.-scope (cast AttrContext (.-info localEnv)))
                                (.-tsym (.-type (cast JCTree$JCTypeParameter (.-head l)))))
                (recur (.-tail l))))
            (let [owner (.-sym (.-enclClass env))]
              (when (and (not (== (bit-and (.flags owner) Flags/ANNOTATION) 0))
                         (or (.nonEmpty (.-params tree)) (some? (.-recvparam tree))))
                (.error log
                        ^JCDiagnostic$DiagnosticPosition (if (.nonEmpty (.-params tree))
                                                             (.pos
                                                               (cast
                                                                 JCTree$JCVariableDecl
                                                                 (.-head (.-params tree))))
                                                             (.pos (.-recvparam tree)))
                        CompilerProperties$Errors/IntfAnnotationMembersCantHaveParams))
              (loop [^{:tag (List JCTree$JCVariableDecl)} l (.-params tree)]
                (when (.nonEmpty l)
                  (.attribStat this (cast JCTree (.-head l)) localEnv)
                  (recur (.-tail l))))
              (.checkVarargsMethodDecl chk localEnv tree)
              (.validate chk (.-typarams tree) localEnv)
              (when (and (some? (.-restype tree))
                         (not (.hasTag (.-type (.-restype tree)) TypeTag/VOID)))
                (.validate chk (.-restype tree) localEnv))
              (.checkRequiresIdentity chk tree (.-lint (cast AttrContext (.-info env))))
              (when (some? (.-recvparam tree))
                (let [^{:tag (Env AttrContext)} newEnv (.methodEnv memberEnter tree env)]
                  (.attribType this (.-recvparam tree) newEnv)
                  (.validate chk (.-recvparam tree) newEnv)))
              (let [isConstructor (TreeInfo/isConstructor tree)]
                (when (and (.isRecord (.-sym (.-enclClass env)))
                           (identical? (.-kind (.-owner (.-sym tree))) Kinds$Kind/TYP))
                  (let [^{:tag (Optional (? extends Symbol$RecordComponent))} recordComponent
                          (.findFirst (.filter
                                        (.stream (.getRecordComponents (.-sym (.-enclClass env))))
                                        (lambda Predicate ^boolean [^Symbol$RecordComponent rc]
                                          (and (identical? (.-accessor rc) (.-sym tree))
                                               (==
                                                 (bit-and
                                                   (.-flags_field (.-accessor rc))
                                                   Flags/GENERATED_MEMBER)
                                                 0)))))]
                    (when (.isPresent recordComponent)
                      (when-not (.isPublic (.-sym tree))
                        (.error log
                                tree
                                (CompilerProperties$Errors/InvalidAccessorMethodInRecord
                                  (.-sym (.-enclClass env))
                                  CompilerProperties$Fragments/MethodMustBePublic)))
                      (when-not (.isSameType
                                  types
                                  (.getReturnType (.-type (.-sym tree)))
                                  (.-type (cast Symbol$RecordComponent (.get recordComponent))))
                        (.error log
                                tree
                                (CompilerProperties$Errors/InvalidAccessorMethodInRecord
                                  (.-sym (.-enclClass env))
                                  (CompilerProperties$Fragments/AccessorReturnTypeDoesntMatch
                                    (.-sym tree)
                                    (cast Symbol (.get recordComponent))))))
                      (when (and (some? (.-thrown (.asMethodType (.-type (.-sym tree)))))
                                 (not (.isEmpty (.-thrown (.asMethodType (.-type (.-sym tree)))))))
                        (.error log
                                tree
                                (CompilerProperties$Errors/InvalidAccessorMethodInRecord
                                  (.-sym (.-enclClass env))
                                  CompilerProperties$Fragments/AccessorMethodCantThrowException)))
                      (when-not (.isEmpty (.-typarams tree))
                        (.error log
                                tree
                                (CompilerProperties$Errors/InvalidAccessorMethodInRecord
                                  (.-sym (.-enclClass env))
                                  CompilerProperties$Fragments/AccessorMethodMustNotBeGeneric)))
                      (when (.isStatic (.-sym tree))
                        (.error log
                                tree
                                (CompilerProperties$Errors/InvalidAccessorMethodInRecord
                                  (.-sym (.-enclClass env))
                                  CompilerProperties$Fragments/AccessorMethodMustNotBeStatic))))
                    (when isConstructor
                      (if (== (bit-and (.-flags_field (.-sym tree)) Flags/RECORD) 0)
                          (when-not (TreeInfo/hasConstructorCall tree (.-_this names))
                            (.error
                              log
                              tree
                              (CompilerProperties$Errors/NonCanonicalConstructorInvokeAnotherConstructor
                                (.-sym (.-enclClass env)))))
                          (do
                            (when (== (bit-and (.-flags_field (.-sym tree)) Flags/GENERATEDCONSTR)
                                      0)
                              (when (> (Check/protection (.flags m))
                                       (Check/protection (.flags (.-sym (.-enclClass env)))))
                                (.error
                                  log
                                  tree
                                  ^JCDiagnostic$Error (if (==
                                                            (bit-and
                                                              (.flags (.-sym (.-enclClass env)))
                                                              Flags/AccessFlags)
                                                            0)
                                                          (CompilerProperties$Errors/InvalidCanonicalConstructorInRecord
                                                            CompilerProperties$Fragments/Canonical
                                                            (.-name (.-sym (.-enclClass env)))
                                                            (CompilerProperties$Fragments/CanonicalMustNotHaveStrongerAccess
                                                              "package"))
                                                          (CompilerProperties$Errors/InvalidCanonicalConstructorInRecord
                                                            CompilerProperties$Fragments/Canonical
                                                            (.-name (.-sym (.-enclClass env)))
                                                            (CompilerProperties$Fragments/CanonicalMustNotHaveStrongerAccess
                                                              (Flags/asFlagSet
                                                                (bit-and
                                                                  (.flags (.-sym (.-enclClass env)))
                                                                  Flags/AccessFlags)))))))
                              (when (TreeInfo/hasAnyConstructorCall tree)
                                (.error
                                  log
                                  tree
                                  (CompilerProperties$Errors/InvalidCanonicalConstructorInRecord
                                    CompilerProperties$Fragments/Canonical
                                    (.-name (.-sym (.-enclClass env)))
                                    CompilerProperties$Fragments/CanonicalMustNotContainExplicitConstructorInvocation))))
                            (when-not (.isEmpty (.-typarams tree))
                              (.error
                                log
                                tree
                                (CompilerProperties$Errors/InvalidCanonicalConstructorInRecord
                                  CompilerProperties$Fragments/Canonical
                                  (.-name (.-sym (.-enclClass env)))
                                  CompilerProperties$Fragments/CanonicalMustNotDeclareTypeVariables)))
                            (let [^:mutable ^{:tag (List (? extends Symbol$RecordComponent))} recordComponents
                                    (.getRecordComponents (.-sym (.-enclClass env)))
                                  ^:mutable ^{:tag (List Type)} recordFieldTypes (.map
                                                                                   (TreeInfo/recordFields
                                                                                     (.-enclClass
                                                                                       env))
                                                                                   (lambda Function ^Type [^JCTree$JCVariableDecl vd]
                                                                                     (.-type
                                                                                       (.-sym vd))))]
                              (for-each [^JCTree$JCVariableDecl param (.-params tree)]
                                (let [paramIsVarArgs (not
                                                       (==
                                                         (bit-and
                                                           (.-flags_field (.-sym param))
                                                           Flags/VARARGS)
                                                         0))]
                                  (when (or (not
                                              (.isSameType
                                                types
                                                (.-type param)
                                                (cast Type (.-head recordFieldTypes))))
                                            (not
                                              (=
                                                (.isVarargs
                                                  (cast
                                                    Symbol$RecordComponent
                                                    (.-head recordComponents)))
                                                paramIsVarArgs)))
                                    (.error
                                      log
                                      param
                                      (CompilerProperties$Errors/InvalidCanonicalConstructorInRecord
                                        CompilerProperties$Fragments/Canonical
                                        (.-name (.-sym (.-enclClass env)))
                                        CompilerProperties$Fragments/TypeMustBeIdenticalToCorrespondingRecordComponentType)))
                                  (set! recordComponents (.-tail recordComponents))
                                  (set! recordFieldTypes (.-tail recordFieldTypes))))))))))
                (when-not (== (bit-and (.flags owner) Flags/ANNOTATION) 0)
                  (when (.nonEmpty (.-thrown tree))
                    (.error log
                            (.pos (cast JCTree$JCExpression (.-head (.-thrown tree))))
                            CompilerProperties$Errors/ThrowsNotAllowedInIntfAnnotation))
                  (when (.nonEmpty (.-typarams tree))
                    (.error log
                            (.pos (cast JCTree$JCTypeParameter (.-head (.-typarams tree))))
                            CompilerProperties$Errors/IntfAnnotationMembersCantHaveTypeParams))
                  (.validateAnnotationType chk (.-restype tree))
                  (.validateAnnotationMethod chk (.pos tree) m))
                (loop [^{:tag (List JCTree$JCExpression)} l (.-thrown tree)]
                  (when (.nonEmpty l)
                    (.checkType chk
                                (.pos (cast JCTree$JCExpression (.-head l)))
                                (.-type (cast JCTree$JCExpression (.-head l)))
                                (.-throwableType syms))
                    (recur (.-tail l))))
                (if (nil? (.-body tree))
                    (do
                      (when (some? (.-defaultValue tree))
                        (when (== (bit-and (.flags owner) Flags/ANNOTATION) 0)
                          (.error log
                                  (.pos tree)
                                  CompilerProperties$Errors/DefaultAllowedInIntfAnnotationMember)))
                      (when (or isDefaultMethod
                                (== (bit-and (.flags (.-sym tree))
                                             (bit-or-int Flags/ABSTRACT Flags/NATIVE))
                                    0))
                        (.error log
                                (.pos tree)
                                (CompilerProperties$Errors/MissingMethBodyOrDeclAbstract
                                  (.-sym tree)
                                  owner))))
                    (do
                      (if (== (bit-and (.flags (.-sym tree))
                                       (bit-or (bit-or Flags/ABSTRACT Flags/DEFAULT) Flags/PRIVATE))
                              Flags/ABSTRACT)
                          (if (not (== (bit-and (.flags owner) Flags/INTERFACE) 0))
                              (.error log
                                      (.pos (.-body tree))
                                      CompilerProperties$Errors/IntfMethCantHaveBody)
                              (.error log
                                      (.pos tree)
                                      CompilerProperties$Errors/AbstractMethCantHaveBody))
                          (when-not (== (bit-and (.-flags (.-mods tree)) Flags/NATIVE) 0)
                            (.error log
                                    (.pos tree)
                                    CompilerProperties$Errors/NativeMethCantHaveBody)))
                      (when (and isConstructor
                                 (not (identical? (.-type owner) (.-objectType syms))))
                        (cond
                          (not (TreeInfo/hasAnyConstructorCall tree))
                            (let [^JCTree$JCStatement supCall (.Exec
                                                                (.at make (.-pos (.-body tree)))
                                                                (.Apply
                                                                  make
                                                                  (List/nil)
                                                                  (.Ident make (.-_super names))
                                                                  (.Idents make (List/nil))))]
                              (set! (.-stats (.-body tree))
                                    (.prepend (.-stats (.-body tree)) supCall)))
                          (and (and (not (== (bit-and (.flags (.-sym (.-enclClass env))) Flags/ENUM)
                                             0))
                                    (== (bit-and (.-flags (.-mods tree)) Flags/GENERATEDCONSTR) 0))
                               (TreeInfo/hasConstructorCall tree (.-_super names)))
                            (.error log
                                    (.pos
                                      (cast JCTree$JCStatement (.-head (.-stats (.-body tree)))))
                                    (CompilerProperties$Errors/CallToSuperNotAllowedInEnumCtor
                                      (.-sym (.-enclClass env)))))
                        (when (and (.isRecord (.-sym (.-enclClass env)))
                                   (not (== (bit-and (.-flags_field (.-sym tree)) Flags/RECORD) 0)))
                          (let [^{:tag (List Name)} recordComponentNames (.map
                                                                           (TreeInfo/recordFields
                                                                             (.-enclClass env))
                                                                           (lambda Function ^Name [^JCTree$JCVariableDecl vd]
                                                                             (.-name (.-sym vd))))
                                ^{:tag (List Name)} initParamNames (.map
                                                                     (.-params (.-sym tree))
                                                                     (lambda Function ^Name [^Symbol$VarSymbol p]
                                                                       (.-name p)))]
                            (when-not (.equals initParamNames recordComponentNames)
                              (.error log
                                      tree
                                      (CompilerProperties$Errors/InvalidCanonicalConstructorInRecord
                                        CompilerProperties$Fragments/Canonical
                                        (.-name (.-sym (.-enclClass env)))
                                        CompilerProperties$Fragments/CanonicalWithNameMismatch)))
                            (when (and (some? (.-thrown (.asMethodType (.-type (.-sym tree)))))
                                       (not (.isEmpty
                                              (.-thrown (.asMethodType (.-type (.-sym tree)))))))
                              (.error
                                log
                                tree
                                (CompilerProperties$Errors/InvalidCanonicalConstructorInRecord
                                  ^JCDiagnostic$Fragment (if (TreeInfo/isCompactConstructor tree)
                                                             CompilerProperties$Fragments/Compact
                                                             CompilerProperties$Fragments/Canonical)
                                  (.-name (.-sym (.-enclClass env)))
                                  (CompilerProperties$Fragments/ThrowsClauseNotAllowedForCanonicalConstructor
                                    ^JCDiagnostic$Fragment (if (TreeInfo/isCompactConstructor tree)
                                                               CompilerProperties$Fragments/Compact
                                                               CompilerProperties$Fragments/Canonical))))))))
                      (.queueScanTreeAndTypeAnnotate annotate (.-body tree) localEnv m)
                      (.flush annotate)
                      (set! (.-ctorPrologue (cast AttrContext (.-info localEnv)))
                            (and isConstructor
                                 (not (identical? (.-type owner) (.-objectType syms)))))
                      (.attribStat this (.-body tree) localEnv)))
                (.leave (.-scope (cast AttrContext (.-info localEnv))))
                (set! result (set! (.-type tree) (.-type m))))))
          (finally
            (.setLint chk prevLint)
            (.setMethod chk prevMethod)
            (set! (.-ctorPrologue (cast AttrContext (.-info env))) ctorProloguePrev))))))

  (method ^:public visitVarDef ^void [this ^JCTree$JCVariableDecl tree]
    (if (or
          (identical? (.-kind (.-owner (.-scope (cast AttrContext (.-info env))))) Kinds$Kind/MTH)
          (identical? (.-kind (.-owner (.-scope (cast AttrContext (.-info env))))) Kinds$Kind/VAR))
        (if (some? (.-sym tree))
            (.enter (.-scope (cast AttrContext (.-info env))) (.-sym tree))
            (do
              (when (and (.isImplicitlyTyped tree)
                         (== (bit-and (.-flags (.getModifiers tree)) Flags/PARAMETER) 0))
                (if (nil? (.-init tree))
                    (do
                      (.error log
                              tree
                              (CompilerProperties$Errors/CantInferLocalVarType
                                (.-name tree)
                                CompilerProperties$Fragments/LocalMissingInit))
                      (set! (.-vartype tree) (.Erroneous (.at make (.pos tree)))))
                    (let [msg (.canInferLocalVarType this tree)]
                      (when (some? msg)
                        (.error log
                                tree
                                (CompilerProperties$Errors/CantInferLocalVarType (.-name tree) msg))
                        (set! (.-vartype tree) (.Erroneous (.at make (.pos tree))))))))
              (try
                (.blockAnnotations annotate)
                (.memberEnter memberEnter tree env)
                (finally (.unblockAnnotations annotate)))))
        (.doQueueScanTreeAndTypeAnnotateForVarInit this tree env))
    (let [v (.-sym tree)
          lint (.augment (.-lint (cast AttrContext (.-info env))) v)
          prevLint (.setLint chk lint)
          isImplicitLambdaParameter (and (and (.hasTag (.-tree env) JCTree$Tag/LAMBDA)
                                              (identical?
                                                (.-paramKind (cast JCTree$JCLambda (.-tree env)))
                                                JCTree$JCLambda$ParameterKind/IMPLICIT))
                                         (not
                                           (== (bit-and (.flags (.-sym tree)) Flags/PARAMETER) 0)))]
      (.validate chk
                 (.-vartype tree)
                 env
                 (and (not isImplicitLambdaParameter) (not (.isImplicitlyTyped tree))))
      (try
        (.getConstValue v)
        (.checkDeprecatedAnnotation chk (.pos tree) v)
        (when (some? (.-init tree))
          (when (or (== (bit-and (.-flags_field v) Flags/FINAL) 0)
                    (not (.needsLazyConstValue memberEnter (.-init tree))))
            (let [^{:tag (Env AttrContext)} initEnv (.initEnv memberEnter tree env)]
              (set! (.-lint (cast AttrContext (.-info initEnv))) lint)
              (set! (.-enclVar (cast AttrContext (.-info initEnv))) v)
              (.attribExpr this (.-init tree) initEnv (.-type v))
              (when (.isImplicitlyTyped tree)
                (set! (.-type v) (.checkLocalVarType chk tree (.-type (.-init tree)) (.-name tree))))))
          (when (.isImplicitlyTyped tree) (.setSyntheticVariableType this tree (.-type v))))
        (set! result (set! (.-type tree) (.-type v)))
        (when (and (and (.isRecord (.-sym (.-enclClass env)))
                        (identical? (.-kind (.-owner (.-sym tree))) Kinds$Kind/TYP))
                   (not (.isStatic v)))
          (when (.isNonArgsMethodInObject this (.-name v))
            (.error log tree (CompilerProperties$Errors/IllegalRecordComponentName v))))
        (.checkRequiresIdentity chk tree (.-lint (cast AttrContext (.-info env))))
        (finally (.setLint chk prevLint)))))

  (method ^:private doQueueScanTreeAndTypeAnnotateForVarInit ^void [this ^JCTree$JCVariableDecl tree
                                                                    ^{:tag (Env AttrContext)} env]
    (when (and (and (and (some? (.-init tree))
                         (== (bit-and (.-flags (.-mods tree))
                                      Flags/FIELD_INIT_TYPE_ANNOTATIONS_QUEUED)
                             0))
                    (not (identical? (.-kind (.-owner (.-scope (cast AttrContext (.-info env)))))
                                     Kinds$Kind/MTH)))
               (not (identical? (.-kind (.-owner (.-scope (cast AttrContext (.-info env)))))
                                Kinds$Kind/VAR)))
      (let [o-5 (.-mods tree)]
        (set! (.-flags o-5) (bit-or (.-flags o-5) Flags/FIELD_INIT_TYPE_ANNOTATIONS_QUEUED)))
      (.queueScanTreeAndTypeAnnotate annotate (.-init tree) env (.-sym tree))
      (.flush annotate)))

  (method ^:private isNonArgsMethodInObject ^boolean [this ^Name name]
    (for-each [^Symbol s (.getSymbolsByName (.members (.-tsym (.-objectType syms)))
                                            name
                                            (lambda Predicate ^boolean [^Symbol s]
                                              (identical? (.-kind s) Kinds$Kind/MTH)))]
      (when (.isEmpty (.getParameterTypes (.-type s))) (return true)))
    false)

  (method canInferLocalVarType ^JCDiagnostic$Fragment [this ^JCTree$JCVariableDecl tree]
    (let [lis (LocalInitScanner.)] (.scan lis (.-init tree)) (.-badInferenceMsg lis)))

  (defclass ^:static LocalInitScanner
    :extends TreeScanner

    (field ^JCDiagnostic$Fragment badInferenceMsg nil)

    (field ^boolean needsTarget true)

    (method ^:public visitNewArray ^void [this ^JCTree$JCNewArray tree]
      (when (and (nil? (.-elemtype tree)) needsTarget)
        (set! badInferenceMsg CompilerProperties$Fragments/LocalArrayMissingTarget)))

    (method ^:public visitLambda ^void [this ^JCTree$JCLambda tree]
      (when needsTarget
        (set! badInferenceMsg CompilerProperties$Fragments/LocalLambdaMissingTarget)))

    (method ^:public visitTypeCast ^void [this ^JCTree$JCTypeCast tree]
      (let [prevNeedsTarget needsTarget]
        (try
          (set! needsTarget false)
          (.visitTypeCast super tree)
          (finally (set! needsTarget prevNeedsTarget)))))

    (method ^:public visitReference ^void [this ^JCTree$JCMemberReference tree]
      (when needsTarget (set! badInferenceMsg CompilerProperties$Fragments/LocalMrefMissingTarget)))

    (method ^:public visitNewClass ^void [this ^JCTree$JCNewClass tree]
      (let [prevNeedsTarget needsTarget]
        (try
          (set! needsTarget false)
          (.visitNewClass super tree)
          (finally (set! needsTarget prevNeedsTarget)))))

    (method ^:public visitApply ^void [this ^JCTree$JCMethodInvocation tree]
      (let [prevNeedsTarget needsTarget]
        (try
          (set! needsTarget false)
          (.visitApply super tree)
          (finally (set! needsTarget prevNeedsTarget))))))

  (method ^:public visitSkip ^void [this ^JCTree$JCSkip tree]
    (set! result nil))

  (method ^:public visitBlock ^void [this ^JCTree$JCBlock tree]
    (if (or
          (identical? (.-kind (.-owner (.-scope (cast AttrContext (.-info env))))) Kinds$Kind/TYP)
          (identical? (.-kind (.-owner (.-scope (cast AttrContext (.-info env))))) Kinds$Kind/ERR))
        (let [^Symbol fakeOwner (Symbol$MethodSymbol.
                                  (bit-or (bit-or (.-flags tree) Flags/BLOCK)
                                          (bit-and
                                            (.flags
                                              (.-owner (.-scope (cast AttrContext (.-info env)))))
                                            Flags/STRICTFP))
                                  (.-empty names)
                                  initBlockType
                                  (.-owner (.-scope (cast AttrContext (.-info env)))))
              ^{:tag (Env AttrContext)} localEnv (.dup
                                                   env
                                                   tree
                                                   (.dup
                                                     (cast AttrContext (.-info env))
                                                     (.dupUnshared
                                                       (.-scope (cast AttrContext (.-info env)))
                                                       fakeOwner)))]
          (when-not (== (bit-and (.-flags tree) Flags/STATIC) 0)
            (let [o-6 (cast AttrContext (.-info localEnv))]
              (set! (.-staticLevel o-6) (unchecked-inc-int (.-staticLevel o-6)))))
          (.queueScanTreeAndTypeAnnotate annotate
                                         tree
                                         localEnv
                                         (.-owner (.-scope (cast AttrContext (.-info localEnv)))))
          (.flush annotate)
          (.attribStats this (.-stats tree) localEnv)
          (let [cs (cast Symbol$ClassSymbol (.-owner (.-scope (cast AttrContext (.-info env)))))
                ^{:tag (List Attribute$TypeCompound)} tas (.getRawTypeAttributes
                                                            (.-owner
                                                              (.-scope
                                                                (cast AttrContext (.-info localEnv)))))]
            (if (not (== (bit-and (.-flags tree) Flags/STATIC) 0))
                (.appendClassInitTypeAttributes cs tas)
                (.appendInitTypeAttributes cs tas))))
        (let [^{:tag (Env AttrContext)} localEnv (.dup
                                                   env
                                                   tree
                                                   (.dup
                                                     (cast AttrContext (.-info env))
                                                     (.dup
                                                       (.-scope (cast AttrContext (.-info env))))))]
          (try
            (.attribStats this (.-stats tree) localEnv)
            (finally (.leave (.-scope (cast AttrContext (.-info localEnv))))))))
    (set! result nil))

  (method ^:public visitDoLoop ^void [this ^JCTree$JCDoWhileLoop tree]
    (.attribStat this (.-body tree) (.dup env tree))
    (.attribExpr this (.-cond tree) env (.-booleanType syms))
    (.handleLoopConditionBindings this matchBindings tree (.-body tree))
    (set! result nil))

  (method ^:public visitWhileLoop ^void [this ^JCTree$JCWhileLoop tree]
    (.attribExpr this (.-cond tree) env (.-booleanType syms))
    (let [condBindings matchBindings
          ^{:tag (Env AttrContext)} whileEnv (.bindingEnv
                                               this
                                               env
                                               (.-bindingsWhenTrue condBindings))]
      (try
        (.attribStat this (.-body tree) (.dup whileEnv tree))
        (finally (.leave (.-scope (cast AttrContext (.-info whileEnv))))))
      (.handleLoopConditionBindings this condBindings tree (.-body tree))
      (set! result nil)))

  (method ^:public visitForLoop ^void [this ^JCTree$JCForLoop tree]
    (let [^{:tag (Env AttrContext)} loopEnv (.dup
                                              env
                                              (.-tree env)
                                              (.dup
                                                (cast AttrContext (.-info env))
                                                (.dup (.-scope (cast AttrContext (.-info env))))))
          ^:mutable condBindings MatchBindingsComputer/EMPTY]
      (try
        (.attribStats this (.-init tree) loopEnv)
        (when (some? (.-cond tree))
          (.attribExpr this (.-cond tree) loopEnv (.-booleanType syms))
          (set! condBindings matchBindings))
        (let [^{:tag (Env AttrContext)} bodyEnv (.bindingEnv
                                                  this
                                                  loopEnv
                                                  (.-bindingsWhenTrue condBindings))]
          (try
            (set! (.-tree bodyEnv) tree)
            (.attribStats this (.-step tree) bodyEnv)
            (.attribStat this (.-body tree) bodyEnv)
            (finally (.leave (.-scope (cast AttrContext (.-info bodyEnv))))))
          (set! result nil))
        (finally (.leave (.-scope (cast AttrContext (.-info loopEnv))))))
      (.handleLoopConditionBindings this condBindings tree (.-body tree))))

  (method ^:private handleLoopConditionBindings ^void [this
                                                       ^MatchBindingsComputer$MatchBindings condBindings
                                                       ^JCTree$JCStatement loop
                                                       ^JCTree$JCStatement loopBody]
    (when (and (.nonEmpty (.-bindingsWhenFalse condBindings))
               (not (.breaksTo this env loop loopBody)))
      (.addBindings2Scope this loop (.-bindingsWhenFalse condBindings))))

  (method ^:private breaksTo ^boolean [this ^{:tag (Env AttrContext)} env ^JCTree loop ^JCTree body]
    (.preFlow this body)
    (.breaksToTree flow env loop body make))

  (method ^:private addBindings2Scope ^void [this ^:mutable ^JCTree$JCStatement introducingStatement
                                             ^{:tag (List Symbol$BindingSymbol)} bindings]
    (when-not (.isEmpty bindings)
      (let [^:mutable searchEnv env]
        (loop []
          (when-instance [^JCTree$JCLabeledStatement labeled (.-tree searchEnv)]
            (when (identical? (.-body labeled) introducingStatement)
              (when (.breaksTo this env labeled (.-body labeled)) (return))
              (set! searchEnv (.-next searchEnv))
              (set! introducingStatement labeled)
              (recur))))
        (.forEach bindings
                  (method-ref Consumer
                              [Symbol$BindingSymbol]
                              (.-scope (cast AttrContext (.-info env)))
                              Scope$WriteableScope/.enter))
        (.forEach
          bindings
          (method-ref Consumer [Symbol$BindingSymbol] Symbol$BindingSymbol/.preserveBinding)))))

  (method ^:public visitForeachLoop ^void [this ^JCTree$JCEnhancedForLoop tree]
    (let [^{:tag (Env AttrContext)} loopEnv (.dup
                                              env
                                              (.-tree env)
                                              (.dup
                                                (cast AttrContext (.-info env))
                                                (.dup (.-scope (cast AttrContext (.-info env))))))]
      (try
        (let [exprType (.cvarUpperBound types (.attribExpr this (.-expr tree) loopEnv))]
          (.checkNonVoid chk (.pos tree) exprType)
          (let [^:mutable elemtype (.elemtype types exprType)]
            (when (nil? elemtype)
              (let [base (.asSuper types exprType (.-tsym (.-iterableType syms)))]
                (if (nil? base)
                    (do
                      (.error log
                              (.pos (.-expr tree))
                              (CompilerProperties$Errors/ForeachNotApplicableToType
                                exprType
                                CompilerProperties$Fragments/TypeReqArrayOrIterable))
                      (set! elemtype (.createErrorType types exprType)))
                    (let [^{:tag (List Type)} iterableParams (.allparams base)]
                      (set! elemtype
                            (if (.isEmpty iterableParams)
                                (.-objectType syms)
                                (.wildUpperBound types (cast Type (.-head iterableParams)))))
                      (let [^Symbol iterSymbol (.resolveInternalMethod
                                                 rs
                                                 (.pos tree)
                                                 loopEnv
                                                 (.skipTypeVars types exprType false)
                                                 (.-iterator names)
                                                 (List/nil)
                                                 (List/nil))]
                        (when (nil? (.asSuper types
                                              (.getReturnType (.-type iterSymbol))
                                              (.-tsym (.-iteratorType syms))))
                          (.error log
                                  (.pos tree)
                                  (CompilerProperties$Errors/ForeachNotApplicableToType
                                    exprType
                                    CompilerProperties$Fragments/TypeReqArrayOrIterable))))))))
            (when (.isImplicitlyTyped (.-var tree))
              (let [inferredType (.checkLocalVarType
                                   chk
                                   (.-var tree)
                                   elemtype
                                   (.-name (.-var tree)))]
                (.setSyntheticVariableType this (.-var tree) inferredType)))
            (.attribStat this (.-var tree) loopEnv)
            (.checkType chk (.pos (.-expr tree)) elemtype (.-type (.-sym (.-var tree))))
            (set! (.-tree loopEnv) tree)
            (.attribStat this (.-body tree) loopEnv)
            (set! result nil)))
        (finally (.leave (.-scope (cast AttrContext (.-info loopEnv))))))))

  (method ^:public visitLabelled ^void [this ^JCTree$JCLabeledStatement tree]
    (let [^:mutable ^{:tag (Env AttrContext)} env1 env]
      (while (and (some? env1) (not (.hasTag (.-tree env1) JCTree$Tag/CLASSDEF)))
        (when (and (.hasTag (.-tree env1) JCTree$Tag/LABELLED)
                   (identical? (.-label (cast JCTree$JCLabeledStatement (.-tree env1)))
                               (.-label tree)))
          (.error log (.pos tree) (CompilerProperties$Errors/LabelAlreadyInUse (.-label tree)))
          (break))
        (set! env1 (.-next env1)))
      (.attribStat this (.-body tree) (.dup env tree))
      (set! result nil)))

  (method ^:public visitSwitch ^void [this ^JCTree$JCSwitch tree]
    (.handleSwitch this
                   tree
                   (.-selector tree)
                   (.-cases tree)
                   (lambda BiConsumer ^void [^JCTree$JCCase c ^Env caseEnv]
                     (.attribStats this (.-stats c) caseEnv)))
    (set! result nil))

  (method ^:public visitSwitchExpression ^void [this ^JCTree$JCSwitchExpression tree]
    (let [^:mutable wrongContext false]
      (set! (.-polyKind tree)
            (if (and (and (.hasTag (.pt this) TypeTag/NONE)
                          (not (identical? (.pt this) Type/recoveryType)))
                     (not (identical? (.pt this) Infer/anyPoly)))
                JCTree$JCPolyExpression$PolyKind/STANDALONE
                JCTree$JCPolyExpression$PolyKind/POLY))
      (when (and (identical? (.-polyKind tree) JCTree$JCPolyExpression$PolyKind/POLY)
                 (.hasTag (.-pt resultInfo) TypeTag/VOID))
        (.report (.-checkContext resultInfo)
                 tree
                 (.fragment diags CompilerProperties$Fragments/SwitchExpressionTargetCantBeVoid))
        (set! resultInfo recoveryInfo)
        (set! wrongContext true))
      (let [^ResultInfo condInfo (if (identical?
                                       (.-polyKind tree)
                                       JCTree$JCPolyExpression$PolyKind/STANDALONE)
                                     unknownExprInfo
                                     (.dup resultInfo
                                           (.switchExpressionContext
                                             this
                                             (.-checkContext resultInfo))))
            ^{:tag (ListBuffer JCDiagnostic$DiagnosticPosition)} caseTypePositions (ListBuffer.)
            ^{:tag (ListBuffer Type)} caseTypes (ListBuffer.)]
        (.handleSwitch this
                       tree
                       (.-selector tree)
                       (.-cases tree)
                       (lambda BiConsumer ^void [^JCTree$JCCase c ^Env caseEnv]
                         (set! (.-yieldResult (cast AttrContext (.-info caseEnv))) condInfo)
                         (.attribStats this (.-stats c) caseEnv)
                         (.scan (anon TreeScanner []
                                  (method ^:public visitYield ^void [this ^JCTree$JCYield brk]
                                    (when (identical? (.-target brk) tree)
                                      (.append caseTypePositions
                                               ^JCDiagnostic$DiagnosticPosition (if (some?
                                                                                      (.-value brk))
                                                                                    (.pos
                                                                                      (.-value brk))
                                                                                    (.pos brk)))
                                      (.append caseTypes
                                               ^Type (if (some? (.-value brk))
                                                         (.-type (.-value brk))
                                                         (.-errType syms))))
                                    (.visitYield super brk))

                                  (method ^:public visitClassDef ^void [this
                                                                        ^JCTree$JCClassDecl tree])

                                  (method ^:public visitLambda ^void [this ^JCTree$JCLambda tree]))
                                (.-stats c))))
        (cond
          (.isEmpty (.-cases tree))
            (.error log (.pos tree) CompilerProperties$Errors/SwitchExpressionEmpty)
          (.isEmpty caseTypes)
            (.error log (.pos tree) CompilerProperties$Errors/SwitchExpressionNoResultExpressions))
        (let [^Type owntype (if (identical? (.-polyKind tree)
                                            JCTree$JCPolyExpression$PolyKind/STANDALONE)
                                (.condType this (.toList caseTypePositions) (.toList caseTypes))
                                (.pt this))]
          (set! result
                (set! (.-type tree)
                      (if wrongContext
                          (.createErrorType types (.pt this))
                          (.check this tree owntype Kinds$KindSelector/VAL resultInfo))))))))

  (method switchExpressionContext ^Check$CheckContext [this ^Check$CheckContext checkContext]
    (anon Check$NestedCheckContext [checkContext]
      (method ^:public report ^void [this ^JCDiagnostic$DiagnosticPosition pos ^JCDiagnostic details]
        (.report (.-enclosingContext this)
                 pos
                 (.fragment diags
                            (CompilerProperties$Fragments/IncompatibleTypeInSwitchExpression
                              details))))))

  (method ^:private handleSwitch ^void [this ^JCTree switchTree ^JCTree$JCExpression selector
                                        ^{:tag (List JCTree$JCCase)} cases
                                        ^{:tag (BiConsumer JCTree$JCCase (Env AttrContext))} attribCase]
    (let [seltype (.attribExpr this selector env)
          seltypeUnboxed (.unboxedTypeOrType types seltype)
          ^{:tag (Env AttrContext)} switchEnv (.dup
                                                env
                                                switchTree
                                                (.dup
                                                  (cast AttrContext (.-info env))
                                                  (.dup (.-scope (cast AttrContext (.-info env))))))]
      (try
        (let [enumSwitch (not (== (bit-and (.flags (.-tsym seltype)) Flags/ENUM) 0))
              stringSwitch (.isSameType types seltype (.-stringType syms))
              booleanSwitch (.isSameType types seltypeUnboxed (.-booleanType syms))
              errorEnumSwitch (TreeInfo/isErrorEnumSwitch selector cases)
              intSwitch (.isAssignable types seltype (.-intType syms))
              ^:mutable ^boolean patternSwitch false]
          (when (and (.isPrimitive seltype) (not intSwitch))
            (.checkSourceLevel preview (.pos selector) Source$Feature/PRIMITIVE_PATTERNS)
            (set! patternSwitch true))
          (if (and (and (and (not enumSwitch) (not stringSwitch)) (not errorEnumSwitch))
                   (not intSwitch))
              (do
                (.checkSourceLevel preview (.pos selector) Source$Feature/PATTERN_SWITCH)
                (set! patternSwitch true))
              (set! patternSwitch
                    (.anyMatch (.flatMap (.stream cases)
                                         (lambda Function ^Stream [^JCTree$JCCase c]
                                           (.stream (.-labels c))))
                               (lambda Predicate ^boolean [^JCTree$JCCaseLabel l]
                                 (or (.hasTag l JCTree$Tag/PATTERNCASELABEL)
                                     (TreeInfo/isNullCaseLabel l))))))
          (let [^{:tag (Set Object)} constants (HashSet.)
                ^:mutable hasDefault false
                ^:mutable hasUnconditionalPattern false
                ^:mutable lastPatternErroneous false
                ^:mutable hasNullPattern false
                ^:mutable ^CaseTree$CaseKind caseKind nil
                ^:mutable wasError false
                ^:mutable ^JCTree$JCCaseLabel unconditionalCaseLabel nil]
            (loop [^{:tag (List JCTree$JCCase)} l cases]
              (when (.nonEmpty l)
                (let [c (cast JCTree$JCCase (.-head l))]
                  (if (nil? caseKind)
                      (set! caseKind (.-caseKind c))
                      (when (and (not (identical? caseKind (.-caseKind c))) (not wasError))
                        (.error log (.pos c) CompilerProperties$Errors/SwitchMixingCaseTypes)
                        (set! wasError true)))
                  (let [^:mutable ^MatchBindingsComputer$MatchBindings currentBindings nil
                        ^:mutable ^MatchBindingsComputer$MatchBindings guardBindings nil]
                    (loop [^{:tag (List JCTree$JCCaseLabel)} labels (.-labels c)]
                      (when (.nonEmpty labels)
                        (let [label (cast JCTree$JCCaseLabel (.-head labels))]
                          (if-instance [^JCTree$JCConstantCaseLabel constLabel label]
                            (let [expr (.-expr constLabel)]
                              (cond
                                (TreeInfo/isNull expr)
                                  (do
                                    (.checkSourceLevel preview (.pos expr) Source$Feature/CASE_NULL)
                                    (when hasNullPattern
                                      (.error log
                                              (.pos label)
                                              CompilerProperties$Errors/DuplicateCaseLabel))
                                    (set! hasNullPattern true)
                                    (.attribExpr this expr switchEnv seltype)
                                    (set! matchBindings
                                          (MatchBindingsComputer$MatchBindings.
                                            (.-bindingsWhenTrue matchBindings)
                                            (.-bindingsWhenFalse matchBindings)
                                            true)))
                                enumSwitch
                                  (let [sym (.enumConstant this expr seltype)]
                                    (if (nil? sym)
                                        (if allowPatternSwitch
                                            (do
                                              (.attribTree
                                                this
                                                expr
                                                switchEnv
                                                (.caseLabelResultInfo this seltype))
                                              (let [enumSym (TreeInfo/symbol expr)]
                                                (if (or
                                                      (or (nil? enumSym) (not (.isEnum enumSym)))
                                                      (not
                                                        (identical? (.-kind enumSym) Kinds$Kind/VAR)))
                                                    (.error
                                                      log
                                                      (.pos expr)
                                                      CompilerProperties$Errors/EnumLabelMustBeEnumConstant)
                                                    (when-not (.add constants enumSym)
                                                      (.error
                                                        log
                                                        (.pos label)
                                                        CompilerProperties$Errors/DuplicateCaseLabel)))))
                                            (.error
                                              log
                                              (.pos expr)
                                              CompilerProperties$Errors/EnumLabelMustBeUnqualifiedEnum))
                                        (when-not (.add constants sym)
                                          (.error
                                            log
                                            (.pos label)
                                            CompilerProperties$Errors/DuplicateCaseLabel))))
                                errorEnumSwitch
                                  (let [prevResolveHelper (.-basicLogResolveHelper rs)]
                                    (try
                                      (set! (.-basicLogResolveHelper rs)
                                            (.-silentLogResolveHelper rs))
                                      (.attribExpr this expr switchEnv seltype)
                                      (finally
                                        (set! (.-basicLogResolveHelper rs) prevResolveHelper))))
                                :else
                                  (let [pattype (.attribTree
                                                  this
                                                  expr
                                                  switchEnv
                                                  (.caseLabelResultInfo this seltype))]
                                    (when-not (.hasTag pattype TypeTag/ERROR)
                                      (if (nil? (.constValue pattype))
                                          (let [s (TreeInfo/symbol expr)]
                                            (cond
                                              (and (some? s) (identical? (.-kind s) Kinds$Kind/TYP))
                                                (.error
                                                  log
                                                  (.pos expr)
                                                  CompilerProperties$Errors/PatternExpected)
                                              (or (nil? s) (not (.isEnum s)))
                                                (.error
                                                  log
                                                  (.pos expr)
                                                  ^JCDiagnostic$Error (cond
                                                                        stringSwitch
                                                                          CompilerProperties$Errors/StringConstReq
                                                                        intSwitch
                                                                          CompilerProperties$Errors/ConstExprReq
                                                                        :else
                                                                          CompilerProperties$Errors/PatternOrEnumReq))
                                              :else
                                                (when-not (.add constants s)
                                                  (.error
                                                    log
                                                    (.pos label)
                                                    CompilerProperties$Errors/DuplicateCaseLabel))))
                                          (let [isLongFloatDoubleOrBooleanConstant (or
                                                                                     (.isInSuperClassesOf
                                                                                       (.getTag
                                                                                         pattype)
                                                                                       TypeTag/LONG)
                                                                                     (.equals
                                                                                       (.getTag
                                                                                         pattype)
                                                                                       TypeTag/BOOLEAN))]
                                            (when isLongFloatDoubleOrBooleanConstant
                                              (.checkSourceLevel
                                                preview
                                                (.pos label)
                                                Source$Feature/PRIMITIVE_PATTERNS))
                                            (if (and
                                                  (and (not stringSwitch) (not intSwitch))
                                                  (not
                                                    (and
                                                      isLongFloatDoubleOrBooleanConstant
                                                      (.isSameType types seltypeUnboxed pattype))))
                                                (.error
                                                  log
                                                  (.pos label)
                                                  (CompilerProperties$Errors/ConstantLabelNotCompatible
                                                    pattype
                                                    seltype))
                                                (when-not (.add constants (.constValue pattype))
                                                  (.error
                                                    log
                                                    (.pos c)
                                                    CompilerProperties$Errors/DuplicateCaseLabel)))))))))
                            (if-instance [^JCTree$JCDefaultCaseLabel def label]
                              (do
                                (cond
                                  hasDefault
                                    (.error log
                                            (.pos label)
                                            CompilerProperties$Errors/DuplicateDefaultLabel)
                                  hasUnconditionalPattern
                                    (.error
                                      log
                                      (.pos label)
                                      CompilerProperties$Errors/UnconditionalPatternAndDefault)
                                  (and booleanSwitch
                                       (.containsAll
                                         constants
                                         (Set/of (Integer/valueOf 0) (Integer/valueOf 1))))
                                    (.error log
                                            (.pos label)
                                            CompilerProperties$Errors/DefaultAndBothBooleanValues))
                                (set! hasDefault true)
                                (set! matchBindings MatchBindingsComputer/EMPTY))
                              (if-instance [^JCTree$JCPatternCaseLabel patternlabel label]
                                (let [pat (.-pat patternlabel)]
                                  (.attribExpr this pat switchEnv seltype)
                                  (let [^:mutable primaryType (TreeInfo/primaryPatternType pat)]
                                    (if (.isPrimitive primaryType)
                                        (.checkSourceLevel
                                          preview
                                          (.pos pat)
                                          Source$Feature/PRIMITIVE_PATTERNS)
                                        (when-not (.hasTag primaryType TypeTag/TYPEVAR)
                                          (set! primaryType
                                                (.checkClassOrArrayType chk (.pos pat) primaryType))))
                                    (.checkCastablePattern this (.pos pat) seltype primaryType)
                                    (let [patternType (.erasure types primaryType)
                                          guard (.-guard c)]
                                      (when (and (nil? guardBindings) (some? guard))
                                        (let [afterPattern matchBindings
                                              ^{:tag (Env AttrContext)} bodyEnv (.bindingEnv
                                                                                  this
                                                                                  switchEnv
                                                                                  (.-bindingsWhenTrue
                                                                                    matchBindings))]
                                          (try
                                            (.attribExpr this guard bodyEnv (.-booleanType syms))
                                            (finally
                                              (.leave (.-scope (cast AttrContext (.-info bodyEnv))))))
                                          (set! guardBindings matchBindings)
                                          (set! matchBindings afterPattern)
                                          (when (TreeInfo/isBooleanWithValue guard 0)
                                            (.error
                                              log
                                              (.pos guard)
                                              CompilerProperties$Errors/GuardHasConstantExpressionFalse))))
                                      (let [unguarded (and
                                                        (TreeInfo/unguardedCase c)
                                                        (not (.hasTag pat JCTree$Tag/RECORDPATTERN)))
                                            unconditional (and
                                                            (and
                                                              unguarded
                                                              (not (.isErroneous patternType)))
                                                            (.isUnconditionallyExactTypeBased
                                                              types
                                                              seltype
                                                              patternType))]
                                        (when unconditional
                                          (cond
                                            hasUnconditionalPattern
                                              (.error
                                                log
                                                (.pos pat)
                                                CompilerProperties$Errors/DuplicateUnconditionalPattern)
                                            hasDefault
                                              (.error
                                                log
                                                (.pos pat)
                                                CompilerProperties$Errors/UnconditionalPatternAndDefault)
                                            (and
                                              booleanSwitch
                                              (.containsAll
                                                constants
                                                (Set/of (Integer/valueOf 0) (Integer/valueOf 1))))
                                              (.error
                                                log
                                                (.pos pat)
                                                CompilerProperties$Errors/UnconditionalPatternAndBothBooleanValues))
                                          (set! hasUnconditionalPattern true)
                                          (set! unconditionalCaseLabel label))
                                        (set! lastPatternErroneous (.isErroneous patternType))))))
                                (Assert/error))))
                          (set! currentBindings
                                (.switchCase matchBindingsComputer
                                             label
                                             currentBindings
                                             matchBindings))
                          (recur (.-tail labels)))))
                    (when (some? guardBindings)
                      (set! currentBindings
                            (.caseGuard matchBindingsComputer c currentBindings guardBindings)))
                    (let [^{:tag (Env AttrContext)} caseEnv (.bindingEnv
                                                              this
                                                              switchEnv
                                                              c
                                                              (.-bindingsWhenTrue currentBindings))]
                      (try
                        (.accept attribCase c caseEnv)
                        (finally (.leave (.-scope (cast AttrContext (.-info caseEnv))))))
                      (Attr/addVars (.-stats c) (.-scope (cast AttrContext (.-info switchEnv))))
                      (.preFlow this c)
                      (set! (.-completesNormally c) (.aliveAfter flow caseEnv c make))
                      (recur (.-tail l)))))))
            (when patternSwitch
              (.checkSwitchCaseStructure chk cases)
              (.checkSwitchCaseLabelDominated chk unconditionalCaseLabel cases))
            (cond
              (.hasTag switchTree JCTree$Tag/SWITCH)
                (do
                  (set! (.-hasUnconditionalPattern (cast JCTree$JCSwitch switchTree))
                        (or (or hasDefault hasUnconditionalPattern) lastPatternErroneous))
                  (set! (.-patternSwitch (cast JCTree$JCSwitch switchTree)) patternSwitch))
              (.hasTag switchTree JCTree$Tag/SWITCH_EXPRESSION)
                (do
                  (set! (.-hasUnconditionalPattern (cast JCTree$JCSwitchExpression switchTree))
                        (or (or hasDefault hasUnconditionalPattern) lastPatternErroneous))
                  (set! (.-patternSwitch (cast JCTree$JCSwitchExpression switchTree)) patternSwitch))
              :else (Assert/error (.name (.getTag switchTree))))))
        (finally (.leave (.-scope (cast AttrContext (.-info switchEnv))))))))

  (method ^:private caseLabelResultInfo ^ResultInfo [this ^Type seltype]
    (ResultInfo. Kinds$KindSelector/VAL_TYP
                 ^Type (if (not (.hasTag seltype TypeTag/ERROR)) seltype Type/noType)))

  (method ^:private ^:static addVars ^void [^:mutable ^{:tag (List JCTree$JCStatement)} stats
                                            ^Scope$WriteableScope switchScope]
    (while (.nonEmpty stats)
      (let [stat (cast JCTree (.-head stats))]
        (when (.hasTag stat JCTree$Tag/VARDEF)
          (.enter switchScope (.-sym (cast JCTree$JCVariableDecl stat)))))
      (set! stats (.-tail stats))))

  (method ^:private enumConstant ^Symbol [this ^JCTree tree ^Type enumType]
    (when (.hasTag tree JCTree$Tag/IDENT)
      (let [ident (cast JCTree$JCIdent tree)
            name (.-name ident)]
        (for-each [^Symbol sym (.getSymbolsByName (.members (.-tsym enumType)) name)]
          (when (identical? (.-kind sym) Kinds$Kind/VAR)
            (let [s (set! (.-sym ident) sym)]
              (.getConstValue (cast Symbol$VarSymbol s))
              (set! (.-type ident) (.-type s))
              (return (when-not (== (bit-and (.-flags_field s) Flags/ENUM) 0) s)))))))
    nil)

  (method ^:public visitSynchronized ^void [this ^JCTree$JCSynchronized tree]
    (.checkRefType chk (.pos tree) (.attribExpr this (.-lock tree) env))
    (when (and (some? (.-type (.-lock tree))) (.isValueBased (.-type (.-lock tree))))
      (.warning log
                (.pos tree)
                CompilerProperties$LintWarnings/AttemptToSynchronizeOnInstanceOfValueBasedClass))
    (.attribStat this (.-body tree) env)
    (set! result nil))

  (method ^:public visitTry ^void [this ^JCTree$JCTry tree]
    (let [^{:tag (Env AttrContext)} localEnv (.dup
                                               env
                                               tree
                                               (.dup
                                                 (cast AttrContext (.-info env))
                                                 (.dup (.-scope (cast AttrContext (.-info env))))))]
      (try
        (let [isTryWithResource (.nonEmpty (.-resources tree))
              ^{:tag (Env AttrContext)} tryEnv (if isTryWithResource
                                                   (.dup
                                                     env
                                                     tree
                                                     (.dup
                                                       (cast AttrContext (.-info localEnv))
                                                       (.dup
                                                         (.-scope
                                                           (cast AttrContext (.-info localEnv))))))
                                                   localEnv)]
          (try
            (for-each [^JCTree resource (.-resources tree)]
              (let [^Check$CheckContext twrContext (anon Check$NestedCheckContext [(.-checkContext
                                                                                     resultInfo)]
                                                     (method ^:public report ^void [this
                                                                                    ^JCDiagnostic$DiagnosticPosition pos
                                                                                    ^JCDiagnostic details]
                                                       (.report
                                                         (.-basicHandler chk)
                                                         pos
                                                         (.fragment
                                                           diags
                                                           (CompilerProperties$Fragments/TryNotApplicableToType
                                                             details)))))
                    twrResult (ResultInfo. Kinds$KindSelector/VAR
                                           (.-autoCloseableType syms)
                                           twrContext)]
                (if (.hasTag resource JCTree$Tag/VARDEF)
                    (do
                      (.attribStat this resource tryEnv)
                      (.check twrResult resource (.-type resource))
                      (.checkAutoCloseable this localEnv resource true)
                      (let [var (.-sym (cast JCTree$JCVariableDecl resource))]
                        (set! (.-flags_field var) (bit-or (.-flags_field var) Flags/FINAL))
                        (.setData var ElementKind/RESOURCE_VARIABLE)))
                    (.attribTree this resource tryEnv twrResult))))
            (.attribStat this (.-body tree) tryEnv)
            (finally (when isTryWithResource (.leave (.-scope (cast AttrContext (.-info tryEnv)))))))
          (loop [^{:tag (List JCTree$JCCatch)} l (.-catchers tree)]
            (when (.nonEmpty l)
              (let [c (cast JCTree$JCCatch (.-head l))
                    ^{:tag (Env AttrContext)} catchEnv (.dup
                                                         localEnv
                                                         c
                                                         (.dup
                                                           (cast AttrContext (.-info localEnv))
                                                           (.dup
                                                             (.-scope
                                                               (cast AttrContext (.-info localEnv))))))]
                (try
                  (let [ctype (.attribStat this (.-param c) catchEnv)]
                    (when (TreeInfo/isMultiCatch c)
                      (let [o-7 (.-sym (.-param c))]
                        (set! (.-flags_field o-7)
                              (bit-or (.-flags_field o-7) (bit-or Flags/FINAL Flags/UNION)))))
                    (when (identical? (.-kind (.-sym (.-param c))) Kinds$Kind/VAR)
                      (.setData (.-sym (.-param c)) ElementKind/EXCEPTION_PARAMETER))
                    (.checkType chk
                                (.pos (.-vartype (.-param c)))
                                (.checkClassType chk (.pos (.-vartype (.-param c))) ctype)
                                (.-throwableType syms))
                    (.attribStat this (.-body c) catchEnv))
                  (finally (.leave (.-scope (cast AttrContext (.-info catchEnv))))))
                (recur (.-tail l)))))
          (when (some? (.-finalizer tree)) (.attribStat this (.-finalizer tree) localEnv))
          (set! result nil))
        (finally (.leave (.-scope (cast AttrContext (.-info localEnv))))))))

  (method checkAutoCloseable ^void [this ^{:tag (Env AttrContext)} env ^JCTree tree ^boolean useSite]
    (let [pos (.pos tree)
          resource (.-type tree)]
      (when (and (and (not (.isErroneous resource))
                      (some? (.asSuper types resource (.-tsym (.-autoCloseableType syms)))))
                 (not (.isSameType types resource (.-autoCloseableType syms))))
        (let [^:mutable ^Symbol close (.-noSymbol syms)
              ^Log$DiagnosticHandler discardHandler (.new log Log$DiscardDiagnosticHandler)]
          (try
            (set! close
                  (.resolveQualifiedMethod rs
                                           pos
                                           env
                                           (.skipTypeVars types resource false)
                                           (.-close names)
                                           (List/nil)
                                           (List/nil)))
            (finally (.popDiagnosticHandler log discardHandler)))
          (when (and (and (and (identical? (.-kind close) Kinds$Kind/MTH)
                               (or useSite
                                   (not (identical?
                                          (.-owner close)
                                          (.-tsym (.-autoCloseableType syms))))))
                          (.binaryOverrides (cast Symbol$MethodSymbol close)
                                            (.-autoCloseableClose syms)
                                            (.-tsym resource)
                                            types))
                     (.isHandled chk
                                 (.-interruptedExceptionType syms)
                                 (.getThrownTypes (.memberType types resource close))))
            (if (and (not useSite) (identical? (.-owner close) (.-tsym resource)))
                (.warning log
                          (TreeInfo/diagnosticPositionFor close tree)
                          (CompilerProperties$LintWarnings/TryResourceCanThrowInterruptedExc
                            resource))
                (.warning
                  log
                  pos
                  (CompilerProperties$LintWarnings/TryResourceThrowsInterruptedExc resource))))))))

  (method ^:public visitConditional ^void [this ^JCTree$JCConditional tree]
    (let [condtype (.attribExpr this (.-cond tree) env (.-booleanType syms))
          condBindings matchBindings]
      (set! (.-polyKind tree)
            (if (or (and (and (.hasTag (.pt this) TypeTag/NONE)
                              (not (identical? (.pt this) Type/recoveryType)))
                         (not (identical? (.pt this) Infer/anyPoly)))
                    (.isBooleanOrNumeric this env tree))
                JCTree$JCPolyExpression$PolyKind/STANDALONE
                JCTree$JCPolyExpression$PolyKind/POLY))
      (if (and (identical? (.-polyKind tree) JCTree$JCPolyExpression$PolyKind/POLY)
               (.hasTag (.-pt resultInfo) TypeTag/VOID))
          (do
            (.report (.-checkContext resultInfo)
                     tree
                     (.fragment diags CompilerProperties$Fragments/ConditionalTargetCantBeVoid))
            (set! result (set! (.-type tree) (.createErrorType types (.-pt resultInfo)))))
          (let [^ResultInfo condInfo (if (identical?
                                           (.-polyKind tree)
                                           JCTree$JCPolyExpression$PolyKind/STANDALONE)
                                         unknownExprInfo
                                         (.dup resultInfo
                                               (.conditionalContext
                                                 this
                                                 (.-checkContext resultInfo))))
                ^:mutable ^Type truetype nil
                ^{:tag (Env AttrContext)} trueEnv (.bindingEnv
                                                    this
                                                    env
                                                    (.-bindingsWhenTrue condBindings))]
            (try
              (set! truetype (.attribTree this (.-truepart tree) trueEnv condInfo))
              (finally (.leave (.-scope (cast AttrContext (.-info trueEnv))))))
            (let [trueBindings matchBindings
                  ^:mutable ^Type falsetype nil
                  ^{:tag (Env AttrContext)} falseEnv (.bindingEnv
                                                       this
                                                       env
                                                       (.-bindingsWhenFalse condBindings))]
              (try
                (set! falsetype (.attribTree this (.-falsepart tree) falseEnv condInfo))
                (finally (.leave (.-scope (cast AttrContext (.-info falseEnv))))))
              (let [falseBindings matchBindings
                    ^:mutable ^Type owntype (if (identical?
                                                  (.-polyKind tree)
                                                  JCTree$JCPolyExpression$PolyKind/STANDALONE)
                                                (.condType
                                                  this
                                                  (List/of
                                                    (.pos (.-truepart tree))
                                                    (.pos (.-falsepart tree)))
                                                  (List/of truetype falsetype))
                                                (.pt this))]
                (when (and (and (and (some? (.constValue condtype)) (some? (.constValue truetype)))
                                (some? (.constValue falsetype)))
                           (not (.hasTag owntype TypeTag/NONE)))
                  (set! owntype
                        (.coerce cfolder ^Type (if (.isTrue condtype) truetype falsetype) owntype)))
                (set! result (.check this tree owntype Kinds$KindSelector/VAL resultInfo))
                (set! matchBindings
                      (.conditional matchBindingsComputer
                                    tree
                                    condBindings
                                    trueBindings
                                    falseBindings))))))))

  (method ^:private isBooleanOrNumeric ^boolean [this ^{:tag (Env AttrContext)} env
                                                 ^JCTree$JCExpression tree]
    (switch (.getTag tree)
      LITERAL
        (or (or (.isSubRangeOf (.-typetag (cast JCTree$JCLiteral tree)) TypeTag/DOUBLE)
                (identical? (.-typetag (cast JCTree$JCLiteral tree)) TypeTag/BOOLEAN))
            (identical? (.-typetag (cast JCTree$JCLiteral tree)) TypeTag/BOT))
      (LAMBDA REFERENCE) false
      PARENS (.isBooleanOrNumeric this env (.-expr (cast JCTree$JCParens tree)))
      CONDEXPR
        (let [condTree (cast JCTree$JCConditional tree)]
          (and (.isBooleanOrNumeric this env (.-truepart condTree))
               (.isBooleanOrNumeric this env (.-falsepart condTree))))
      APPLY
        (let [speculativeMethodTree (cast JCTree$JCMethodInvocation
                                          (.attribSpeculative
                                            deferredAttr
                                            tree
                                            env
                                            unknownExprInfo
                                            (.withLocalCacheContext argumentAttr)))
              msym (TreeInfo/symbol (.-meth speculativeMethodTree))
              ^Type receiverType (if (.hasTag (.-meth speculativeMethodTree) JCTree$Tag/IDENT)
                                     (.-type (.-enclClass env))
                                     (.-type (.-selected
                                               (cast
                                                 JCTree$JCFieldAccess
                                                 (.-meth speculativeMethodTree)))))
              owntype (.getReturnType (.memberType types receiverType msym))]
          (.primitiveOrBoxed this owntype))
      NEWCLASS
        (let [className (cast
                          JCTree$JCExpression
                          (.translate removeClassParams (.-clazz (cast JCTree$JCNewClass tree))))
              speculativeNewClassTree (cast JCTree$JCExpression
                                            (.attribSpeculative
                                              deferredAttr
                                              className
                                              env
                                              unknownTypeInfo
                                              (.withLocalCacheContext argumentAttr)))]
          (.primitiveOrBoxed this (.-type speculativeNewClassTree)))
      (let [speculativeType (.-type (.attribSpeculative
                                      deferredAttr
                                      tree
                                      env
                                      unknownExprInfo
                                      (.withLocalCacheContext argumentAttr)))]
        (.primitiveOrBoxed this speculativeType))))

  (method primitiveOrBoxed ^boolean [this ^Type t]
    (and (and (not (.hasTag t TypeTag/TYPEVAR)) (not (.isErroneous t)))
         (.isPrimitive (.unboxedTypeOrType types t))))

  (field ^TreeTranslator removeClassParams
    (anon TreeTranslator []
      (method ^:public visitTypeApply ^void [this ^JCTree$JCTypeApply tree]
        (set! (.-result this) (.translate this (.-clazz tree))))))

  (method conditionalContext ^Check$CheckContext [this ^Check$CheckContext checkContext]
    (anon Check$NestedCheckContext [checkContext]
      (method ^:public report ^void [this ^JCDiagnostic$DiagnosticPosition pos ^JCDiagnostic details]
        (.report (.-enclosingContext this)
                 pos
                 (.fragment diags
                            (CompilerProperties$Fragments/IncompatibleTypeInConditional details))))))

  (method condType ^Type [this ^{:tag (List JCDiagnostic$DiagnosticPosition)} positions
                          ^:mutable ^{:tag (List Type)} condTypes]
    (if (.isEmpty condTypes)
        (.-objectType syms)
        (let [first (cast Type (.-head condTypes))]
          (if (.allMatch (.stream (.-tail condTypes))
                         (lambda Predicate ^boolean [^Type t] (.isSameType types first t)))
              (.baseType first)
              (let [^{:tag (List Type)} unboxedTypes (cast
                                                       List
                                                       (.collect
                                                         (.map
                                                           (.stream condTypes)
                                                           (lambda Function ^Type [^Type t]
                                                             (if (.isPrimitive t)
                                                                 t
                                                                 (.unboxedType types t))))
                                                         (List/collector)))]
                (when (.allMatch (.stream unboxedTypes)
                                 (lambda Predicate ^boolean [^Type t] (.isPrimitive t)))
                  (for-each [^Type type unboxedTypes]
                    (when-not (not (.isStrictSubRangeOf (.getTag type) TypeTag/INT))
                      (when (.allMatch
                              (.filter (.stream unboxedTypes)
                                       (lambda Predicate ^boolean [^Type t]
                                         (not (identical? t type))))
                              (lambda Predicate ^boolean [^Type t]
                                (and (.hasTag t TypeTag/INT) (.isAssignable types t type))))
                        (return (.baseType type)))))
                  (for-each [^TypeTag tag primitiveTags]
                    (let [candidate (aget (.-typeOfTag syms) (.ordinal tag))]
                      (when (.allMatch (.stream unboxedTypes)
                                       (lambda Predicate ^boolean [^Type t]
                                         (.isSubtype types t candidate)))
                        (return candidate)))))
                (set! condTypes
                      (cast List
                            (.collect (.map
                                        (.stream condTypes)
                                        (lambda Function ^Type [^Type t]
                                          (if (.isPrimitive t) (.-type (.boxedClass types t)) t)))
                                      (List/collector))))
                (for-each [^Type type condTypes]
                  (when (.allMatch (.filter (.stream condTypes)
                                            (lambda Predicate ^boolean [^Type t]
                                              (not (identical? t type))))
                                   (lambda Predicate ^boolean [^Type t]
                                     (.isAssignable types t type)))
                    (return (.baseType type))))
                (let [^{:tag (Iterator JCDiagnostic$DiagnosticPosition)} posIt (.iterator positions)]
                  (set! condTypes
                        (cast List
                              (.collect (.map (.stream condTypes)
                                              (lambda Function ^Type [^Type t]
                                                (.checkNonVoid
                                                  chk
                                                  (cast
                                                    JCDiagnostic$DiagnosticPosition
                                                    (.next posIt))
                                                  t)))
                                        (List/collector))))
                  (.lub types
                        (cast List
                              (.collect (.filter
                                          (.map (.stream condTypes)
                                                (lambda Function ^Type [^Type t] (.baseType t)))
                                          (lambda Predicate ^boolean [^Type t]
                                            (not (.hasTag t TypeTag/BOT))))
                                        (List/collector))))))))))

  (field ^:static ^:final ^TypeTag/1 primitiveTags
    (new TypeTag/1
         [TypeTag/BYTE
          TypeTag/CHAR
          TypeTag/SHORT
          TypeTag/INT
          TypeTag/LONG
          TypeTag/FLOAT
          TypeTag/DOUBLE
          TypeTag/BOOLEAN]))

  (method bindingEnv ^{:tag (Env AttrContext)} [this ^{:tag (Env AttrContext)} env
                                                ^{:tag (List Symbol$BindingSymbol)} bindings]
    (.bindingEnv this env (.-tree env) bindings))

  (method bindingEnv ^{:tag (Env AttrContext)} [this ^{:tag (Env AttrContext)} env ^JCTree newTree
                                                ^{:tag (List Symbol$BindingSymbol)} bindings]
    (let [^{:tag (Env AttrContext)} env1 (.dup env
                                               newTree
                                               (.dup
                                                 (cast AttrContext (.-info env))
                                                 (.dup (.-scope (cast AttrContext (.-info env))))))]
      (.forEach bindings
                (method-ref Consumer
                            [Symbol$BindingSymbol]
                            (.-scope (cast AttrContext (.-info env1)))
                            Scope$WriteableScope/.enter))
      env1))

  (method ^:public visitIf ^void [this ^JCTree$JCIf tree]
    (.attribExpr this (.-cond tree) env (.-booleanType syms))
    (let [condBindings matchBindings
          ^{:tag (Env AttrContext)} thenEnv (.bindingEnv this env (.-bindingsWhenTrue condBindings))]
      (try
        (.attribStat this (.-thenpart tree) thenEnv)
        (finally (.leave (.-scope (cast AttrContext (.-info thenEnv))))))
      (.preFlow this (.-thenpart tree))
      (let [aliveAfterThen (.aliveAfter flow env (.-thenpart tree) make)
            ^:mutable ^boolean aliveAfterElse false]
        (if (some? (.-elsepart tree))
            (let [^{:tag (Env AttrContext)} elseEnv (.bindingEnv
                                                      this
                                                      env
                                                      (.-bindingsWhenFalse condBindings))]
              (try
                (.attribStat this (.-elsepart tree) elseEnv)
                (finally (.leave (.-scope (cast AttrContext (.-info elseEnv))))))
              (.preFlow this (.-elsepart tree))
              (set! aliveAfterElse (.aliveAfter flow env (.-elsepart tree) make)))
            (set! aliveAfterElse true))
        (.checkEmptyIf chk tree)
        (let [^:mutable ^{:tag (List Symbol$BindingSymbol)} afterIfBindings (List/nil)]
          (cond
            (and aliveAfterThen (not aliveAfterElse))
              (set! afterIfBindings (.-bindingsWhenTrue condBindings))
            (and aliveAfterElse (not aliveAfterThen))
              (set! afterIfBindings (.-bindingsWhenFalse condBindings)))
          (.addBindings2Scope this tree afterIfBindings)
          (set! result nil)))))

  (method preFlow ^void [this ^JCTree tree]
    (.doRecovery attrRecover)
    (.scan (anon PostAttrAnalyzer []
             (method ^:public scan ^void [this ^JCTree tree]
               (when-not (or (nil? tree)
                             (and (some? (.-type tree)) (identical? (.-type tree) Type/stuckType)))
                 (.scan super tree)))

             (method ^:public visitClassDef ^void [this ^JCTree$JCClassDecl that]
               (when (some? (.-sym that)) (.visitClassDef super that)))

             (method ^:public visitLambda ^void [this ^JCTree$JCLambda that]
               (when (some? (.-type that)) (.visitLambda super that))))
           tree))

  (method ^:public visitExec ^void [this ^JCTree$JCExpressionStatement tree]
    (let [^{:tag (Env AttrContext)} localEnv (.dup env tree)]
      (.attribExpr this (.-expr tree) localEnv)
      (set! result nil)))

  (method ^:public visitBreak ^void [this ^JCTree$JCBreak tree]
    (set! (.-target tree) (.findJumpTarget this (.pos tree) (.getTag tree) (.-label tree) env))
    (set! result nil))

  (method ^:public visitYield ^void [this ^JCTree$JCYield tree]
    (if (some? (.-yieldResult (cast AttrContext (.-info env))))
        (do
          (.attribTree this (.-value tree) env (.-yieldResult (cast AttrContext (.-info env))))
          (set! (.-target tree)
                (.findJumpTarget this (.pos tree) (.getTag tree) (.-empty names) env)))
        (do
          (.error log
                  (.pos tree)
                  ^JCDiagnostic$Error (if (.hasTag (.-value tree) JCTree$Tag/PARENS)
                                          CompilerProperties$Errors/NoSwitchExpressionQualify
                                          CompilerProperties$Errors/NoSwitchExpression))
          (.attribTree this (.-value tree) env unknownExprInfo)))
    (set! result nil))

  (method ^:public visitContinue ^void [this ^JCTree$JCContinue tree]
    (set! (.-target tree) (.findJumpTarget this (.pos tree) (.getTag tree) (.-label tree) env))
    (set! result nil))

  (method ^:private findJumpTarget ^JCTree [this ^JCDiagnostic$DiagnosticPosition pos
                                            ^JCTree$Tag tag ^Name label
                                            ^{:tag (Env AttrContext)} env]
    (let [^{:tag (Pair JCTree JCDiagnostic$Error)} jumpTarget (.findJumpTargetNoError
                                                                this
                                                                tag
                                                                label
                                                                env)]
      (when (some? (.-snd jumpTarget))
        (.error log pos (cast JCDiagnostic$Error (.-snd jumpTarget))))
      (cast JCTree (.-fst jumpTarget))))

  (method ^:private findJumpTargetNoError ^{:tag (Pair JCTree JCDiagnostic$Error)} [this
                                                                                    ^JCTree$Tag tag
                                                                                    ^Name label
                                                                                    ^{:tag (Env AttrContext)} env]
    (let [^:mutable ^{:tag (Env AttrContext)} env1 env
          ^:mutable ^JCDiagnostic$Error pendingError nil]
      (while (some? env1)
        (switch (.getTag (.-tree env1))
          LABELLED
            (let [labelled (cast JCTree$JCLabeledStatement (.-tree env1))]
              (when (identical? label (.-label labelled))
                (if (identical? tag JCTree$Tag/CONTINUE)
                    (do
                      (when (and (and (and (not (.hasTag (.-body labelled) JCTree$Tag/DOLOOP))
                                           (not (.hasTag (.-body labelled) JCTree$Tag/WHILELOOP)))
                                      (not (.hasTag (.-body labelled) JCTree$Tag/FORLOOP)))
                                 (not (.hasTag (.-body labelled) JCTree$Tag/FOREACHLOOP)))
                        (set! pendingError (CompilerProperties$Errors/NotLoopLabel label)))
                      (return (Pair/of (TreeInfo/referencedStatement labelled) pendingError)))
                    (return (Pair/of labelled pendingError)))))
          (DOLOOP WHILELOOP FORLOOP FOREACHLOOP)
            (when (nil? label) (return (Pair/of (.-tree env1) pendingError)))
          SWITCH
            (when (and (nil? label) (identical? tag JCTree$Tag/BREAK))
              (return (Pair/of (.-tree env1) nil)))
          SWITCH_EXPRESSION
            (cond
              (identical? tag JCTree$Tag/YIELD) (return (Pair/of (.-tree env1) nil))
              (identical? tag JCTree$Tag/BREAK)
                (set! pendingError CompilerProperties$Errors/BreakOutsideSwitchExpression)
              :else (set! pendingError CompilerProperties$Errors/ContinueOutsideSwitchExpression))
          (LAMBDA METHODDEF CLASSDEF) (break)
          nil)
        (set! env1 (.-next env1)))
      (cond
        (some? label) (Pair/of nil (CompilerProperties$Errors/UndefLabel label))
        (some? pendingError) (Pair/of nil pendingError)
        (identical? tag JCTree$Tag/CONTINUE) (Pair/of nil CompilerProperties$Errors/ContOutsideLoop)
        :else (Pair/of nil CompilerProperties$Errors/BreakOutsideSwitchLoop))))

  (method ^:public visitReturn ^void [this ^JCTree$JCReturn tree]
    (cond
      (nil? (.-returnResult (cast AttrContext (.-info env))))
        (.error log (.pos tree) CompilerProperties$Errors/RetOutsideMeth)
      (some? (.-yieldResult (cast AttrContext (.-info env))))
        (do
          (.error log (.pos tree) CompilerProperties$Errors/ReturnOutsideSwitchExpression)
          (when (some? (.-expr tree))
            (.attribExpr this
                         (.-expr tree)
                         env
                         (.-pt (.-yieldResult (cast AttrContext (.-info env)))))))
      (and (and (not (.-isLambda (cast AttrContext (.-info env)))) (some? (.-enclMethod env)))
           (TreeInfo/isCompactConstructor (.-enclMethod env)))
        (.error log
                (.-enclMethod env)
                (CompilerProperties$Errors/InvalidCanonicalConstructorInRecord
                  CompilerProperties$Fragments/Compact
                  (.-name (.-sym (.-enclMethod env)))
                  CompilerProperties$Fragments/CanonicalCantHaveReturnStatement))
      (some? (.-expr tree))
        (do
          (when (.hasTag (.-pt (.-returnResult (cast AttrContext (.-info env)))) TypeTag/VOID)
            (.report (.-checkContext (.-returnResult (cast AttrContext (.-info env))))
                     (.pos (.-expr tree))
                     (.fragment diags CompilerProperties$Fragments/UnexpectedRetVal)))
          (.attribTree this (.-expr tree) env (.-returnResult (cast AttrContext (.-info env)))))
      (and (not (.hasTag (.-pt (.-returnResult (cast AttrContext (.-info env)))) TypeTag/VOID))
           (not (.hasTag (.-pt (.-returnResult (cast AttrContext (.-info env)))) TypeTag/NONE)))
        (.report (.-checkContext (.-returnResult (cast AttrContext (.-info env))))
                 (.pos tree)
                 (.fragment diags
                            (CompilerProperties$Fragments/MissingRetVal
                              (.-pt (.-returnResult (cast AttrContext (.-info env))))))))
    (set! result nil))

  (method ^:public visitThrow ^void [this ^JCTree$JCThrow tree]
    (let [owntype (.attribExpr this (.-expr tree) env Type/noType)]
      (.checkType chk tree owntype (.-throwableType syms))
      (set! result nil)))

  (method ^:public visitAssert ^void [this ^JCTree$JCAssert tree]
    (.attribExpr this (.-cond tree) env (.-booleanType syms))
    (when (some? (.-detail tree))
      (.checkNonVoid chk (.pos (.-detail tree)) (.attribExpr this (.-detail tree) env)))
    (set! result nil))

  (method ^:public visitApply ^void [this ^JCTree$JCMethodInvocation tree]
    (let [^{:tag (Env AttrContext)} localEnv (.dup env tree (.dup (cast AttrContext (.-info env))))
          ^:mutable ^{:tag (List Type)} argtypes nil
          ^:mutable ^{:tag (List Type)} typeargtypes nil
          methName (TreeInfo/name (.-meth tree))
          isConstructorCall (or (identical? methName (.-_this names))
                                (identical? methName (.-_super names)))
          ^{:tag (ListBuffer Type)} argtypesBuf (ListBuffer.)]
      (if isConstructorCall
          (let [kind (.attribArgs this Kinds$KindSelector/MTH (.-args tree) localEnv argtypesBuf)]
            (set! argtypes (.toList argtypesBuf))
            (set! typeargtypes (.attribTypes this (.-typeargs tree) localEnv))
            (set! (.-ctorPrologue (cast AttrContext (.-info env))) false)
            (let [^:mutable site (.-type (.-sym (.-enclClass env)))]
              (when (identical? methName (.-_super names))
                (if (identical? site (.-objectType syms))
                    (do
                      (.error log
                              (.pos (.-meth tree))
                              (CompilerProperties$Errors/NoSuperclass site))
                      (set! site (.createErrorType types (.-objectType syms))))
                    (set! site (.supertype types site))))
              (cond
                (.hasTag site TypeTag/CLASS)
                  (let [^:mutable encl (.getEnclosingType site)]
                    (while (and (some? encl) (.hasTag encl TypeTag/TYPEVAR))
                      (set! encl (.getUpperBound encl)))
                    (if (.hasTag encl TypeTag/CLASS)
                        (when (.hasTag (.-meth tree) JCTree$Tag/SELECT)
                          (let [^JCTree qualifier (.-selected
                                                    (cast JCTree$JCFieldAccess (.-meth tree)))]
                            (.checkRefType chk
                                           (.pos qualifier)
                                           (.attribExpr this qualifier localEnv encl))))
                        (when (.hasTag (.-meth tree) JCTree$Tag/SELECT)
                          (.error log
                                  (.pos (.-meth tree))
                                  (CompilerProperties$Errors/IllegalQualNotIcls (.-tsym site)))
                          (.attribExpr this
                                       (.-selected (cast JCTree$JCFieldAccess (.-meth tree)))
                                       localEnv
                                       site)))
                    (when (.hasTag (.-meth tree) JCTree$Tag/IDENT)
                      (.checkNewInnerClass this (.pos (.-meth tree)) localEnv site true))
                    (when (identical? (.-tsym site) (.-enumSym syms))
                      (set! argtypes
                            (.prepend (.prepend argtypes (.-intType syms)) (.-stringType syms))))
                    (let [selectSuperPrev (.-selectSuper (cast AttrContext (.-info localEnv)))]
                      (set! (.-selectSuper (cast AttrContext (.-info localEnv))) true)
                      (set! (.-pendingResolutionPhase (cast AttrContext (.-info localEnv))) nil)
                      (let [sym (.resolveConstructor
                                  rs
                                  (.pos (.-meth tree))
                                  localEnv
                                  site
                                  argtypes
                                  typeargtypes)]
                        (set! (.-selectSuper (cast AttrContext (.-info localEnv))) selectSuperPrev)
                        (TreeInfo/setSymbol (.-meth tree) sym)
                        (let [mpt (.newMethodTemplate this (.-pt resultInfo) argtypes typeargtypes)]
                          (.checkId this (.-meth tree) site sym localEnv (ResultInfo. kind mpt))))))
                (and (.hasTag site TypeTag/ERROR) (.hasTag (.-meth tree) JCTree$Tag/SELECT))
                  (.attribExpr this
                               (.-selected (cast JCTree$JCFieldAccess (.-meth tree)))
                               localEnv
                               site))
              (set! result (set! (.-type tree) (.-voidType syms)))))
          (let [kind (.attribArgs this Kinds$KindSelector/VAL (.-args tree) localEnv argtypesBuf)]
            (set! argtypes (.toList argtypesBuf))
            (set! typeargtypes (.attribAnyTypes this (.-typeargs tree) localEnv))
            (let [mpt (.newMethodTemplate this (.-pt resultInfo) argtypes typeargtypes)]
              (set! (.-pendingResolutionPhase (cast AttrContext (.-info localEnv))) nil)
              (let [mtype (.attribTree this
                                       (.-meth tree)
                                       localEnv
                                       (ResultInfo. kind mpt (.-checkContext resultInfo)))
                    ^:mutable restype (.getReturnType mtype)]
                (when (.hasTag restype TypeTag/WILDCARD) (throw (AssertionError. mtype)))
                (let [^Type qualifier (if (.hasTag (.-meth tree) JCTree$Tag/SELECT)
                                          (.-type
                                            (.-selected (cast JCTree$JCFieldAccess (.-meth tree))))
                                          (.-type (.-sym (.-enclClass env))))
                      msym (TreeInfo/symbol (.-meth tree))]
                  (set! restype
                        (.adjustMethodReturnType this msym qualifier methName argtypes restype))
                  (.checkRefTypes chk (.-typeargs tree) typeargtypes)
                  (let [capturedRes (.cachedCapture
                                      (.inferenceContext (.-checkContext resultInfo))
                                      tree
                                      restype
                                      true)]
                    (set! result (.check this tree capturedRes Kinds$KindSelector/VAL resultInfo))))))))
      (.checkRequiresIdentity chk tree (.-lint (cast AttrContext (.-info env))))
      (.validate chk (.-typeargs tree) localEnv)))

  (method adjustMethodReturnType ^Type [this ^Symbol msym ^Type qualifierType ^Name methodName
                                        ^{:tag (List Type)} argtypes ^Type restype]
    (cond
      (and (and (and (some? msym)
                     (or (identical? (.-owner msym) (.-tsym (.-objectType syms)))
                         (.isInterface (.-owner msym))))
                (identical? methodName (.-getClass names)))
           (.isEmpty argtypes))
        (Type$ClassType. (.getEnclosingType restype)
                         (List/of (Type$WildcardType.
                                    (.erasure types (.baseType qualifierType))
                                    BoundKind/EXTENDS
                                    (.-boundClass syms)))
                         (.-tsym restype)
                         (.getMetadata restype))
      (and (and (and (some? msym) (identical? (.-owner msym) (.-arrayClass syms)))
                (identical? methodName (.-clone names)))
           (.isArray types qualifierType))
        qualifierType
      :else restype))

  (method newMethodTemplate ^Type [this ^Type restype ^{:tag (List Type)} argtypes
                                   ^{:tag (List Type)} typeargtypes]
    (let [mt (Type$MethodType. argtypes restype (List/nil) (.-methodClass syms))]
      (if (nil? typeargtypes) ^Type mt ^Type (Type$ForAll. typeargtypes mt))))

  (method ^:public visitNewClass ^void [this ^:final ^JCTree$JCNewClass tree]
    (let [^:mutable owntype (.createErrorType types (.-type tree))
          ^{:tag (Env AttrContext)} localEnv (.dup env tree (.dup (cast AttrContext (.-info env))))
          cdef (.-def tree)
          ^:mutable clazz (.-clazz tree)
          ^:mutable ^JCTree$JCExpression clazzid nil
          ^:mutable ^JCTree$JCAnnotatedType annoclazzid nil]
      (set! annoclazzid nil)
      (cond
        (.hasTag clazz JCTree$Tag/TYPEAPPLY)
          (do
            (set! clazzid (.-clazz (cast JCTree$JCTypeApply clazz)))
            (when (.hasTag clazzid JCTree$Tag/ANNOTATED_TYPE)
              (set! annoclazzid (cast JCTree$JCAnnotatedType clazzid))
              (set! clazzid (.-underlyingType annoclazzid))))
        (.hasTag clazz JCTree$Tag/ANNOTATED_TYPE)
          (do
            (set! annoclazzid (cast JCTree$JCAnnotatedType clazz))
            (set! clazzid (.-underlyingType annoclazzid)))
        :else (set! clazzid clazz))
      (let [^:mutable clazzid1 clazzid]
        (when (some? (.-encl tree))
          (let [encltype (.checkRefType chk
                                        (.pos (.-encl tree))
                                        (.attribExpr this (.-encl tree) env))]
            (set! clazzid1
                  (.Select (.at make (.-pos clazz))
                           (.Type make encltype)
                           (.-name (cast JCTree$JCIdent clazzid))))
            (let [endPosTable (.-endPositions (.-toplevel (.-env this)))]
              (.storeEnd endPosTable clazzid1 (.getEndPosition clazzid endPosTable))
              (cond
                (.hasTag clazz JCTree$Tag/ANNOTATED_TYPE)
                  (let [annoType (cast JCTree$JCAnnotatedType clazz)
                        ^{:tag (List JCTree$JCAnnotation)} annos (.-annotations annoType)]
                    (when (.hasTag (.-underlyingType annoType) JCTree$Tag/TYPEAPPLY)
                      (set! clazzid1
                            (.TypeApply (.at make (.-pos tree))
                                        clazzid1
                                        (.-arguments (cast JCTree$JCTypeApply clazz)))))
                    (set! clazzid1 (.AnnotatedType (.at make (.-pos tree)) annos clazzid1)))
                (.hasTag clazz JCTree$Tag/TYPEAPPLY)
                  (set! clazzid1
                        (.TypeApply (.at make (.-pos tree))
                                    clazzid1
                                    (.-arguments (cast JCTree$JCTypeApply clazz)))))
              (set! clazz clazzid1))))
        (let [^:mutable ^Type clazztype (if (TreeInfo/isEnumInit (.-tree env))
                                            (.attribIdentAsEnumType
                                              this
                                              env
                                              (cast JCTree$JCIdent clazz))
                                            (.attribType this clazz env))]
          (set! clazztype (.checkDiamond chk tree clazztype))
          (.validate chk clazz localEnv)
          (if (some? (.-encl tree))
              (do
                (set! (.-type (.-clazz tree)) clazztype)
                (TreeInfo/setSymbol clazzid (TreeInfo/symbol clazzid1))
                (set! (.-type clazzid) (.-type (.-sym (cast JCTree$JCIdent clazzid))))
                (when (some? annoclazzid) (set! (.-type annoclazzid) (.-type clazzid)))
                (when-not (.isErroneous clazztype)
                  (cond
                    (and (some? cdef) (.isInterface (.-tsym clazztype)))
                      (.error log
                              (.pos (.-encl tree))
                              CompilerProperties$Errors/AnonClassImplIntfNoQualForNew)
                    (.isStatic (.-tsym clazztype))
                      (.error log
                              (.pos (.-encl tree))
                              (CompilerProperties$Errors/QualifiedNewOfStaticClass
                                (.-tsym clazztype))))))
              (.checkNewInnerClass this (.pos tree) env clazztype false))
          (let [^{:tag (ListBuffer Type)} argtypesBuf (ListBuffer.)
                pkind (.attribArgs this Kinds$KindSelector/VAL (.-args tree) localEnv argtypesBuf)
                ^:mutable ^{:tag (List Type)} argtypes (.toList argtypesBuf)
                ^:mutable ^{:tag (List Type)} typeargtypes (.attribTypes
                                                             this
                                                             (.-typeargs tree)
                                                             localEnv)]
            (when (or (.hasTag clazztype TypeTag/CLASS) (.hasTag clazztype TypeTag/ERROR))
              (when (and (not (== (bit-and (.-flags_field (.-tsym clazztype)) Flags/ENUM) 0))
                         (or (or (not (.hasTag (.-tree env) JCTree$Tag/VARDEF))
                                 (== (bit-and (.-flags
                                                (.-mods (cast JCTree$JCVariableDecl (.-tree env))))
                                              Flags/ENUM)
                                     0))
                             (not (identical? (.-init (cast JCTree$JCVariableDecl (.-tree env)))
                                              tree))))
                (.error log (.pos tree) CompilerProperties$Errors/EnumCantBeInstantiated))
              (let [isSpeculativeDiamondInferenceRound (and
                                                         (TreeInfo/isDiamond tree)
                                                         (identical?
                                                           (.-mode
                                                             (.deferredAttrContext
                                                               (.-checkContext resultInfo)))
                                                           DeferredAttr$AttrMode/SPECULATIVE))
                    ^:mutable skipNonDiamondPath false]
                (if (and (and (and (nil? cdef) (not (.classDeclRemoved tree)))
                              (not isSpeculativeDiamondInferenceRound))
                         (not (== (bit-and (.flags (.-tsym clazztype))
                                           (bit-or-int Flags/ABSTRACT Flags/INTERFACE))
                                  0)))
                    (do
                      (.error log
                              (.pos tree)
                              (CompilerProperties$Errors/AbstractCantBeInstantiated
                                (.-tsym clazztype)))
                      (set! skipNonDiamondPath true))
                    (when (and (some? cdef) (.isInterface (.-tsym clazztype)))
                      (when-not (.isEmpty argtypes)
                        (.error log
                                (.pos (cast JCTree$JCExpression (.-head (.-args tree))))
                                CompilerProperties$Errors/AnonClassImplIntfNoArgs))
                      (when-not (.isEmpty typeargtypes)
                        (.error log
                                (.pos (cast JCTree$JCExpression (.-head (.-typeargs tree))))
                                CompilerProperties$Errors/AnonClassImplIntfNoTypeargs))
                      (set! argtypes (List/nil))
                      (set! typeargtypes (List/nil))
                      (set! skipNonDiamondPath true)))
                (if (TreeInfo/isDiamond tree)
                    (let [site (Type$ClassType. (.getEnclosingType clazztype)
                                                (.getTypeArguments (.-type (.-tsym clazztype)))
                                                (.-tsym clazztype)
                                                (.getMetadata clazztype))
                          ^{:tag (Env AttrContext)} diamondEnv (.dup localEnv tree)]
                      (set! (.-selectSuper (cast AttrContext (.-info diamondEnv)))
                            (or (some? cdef) (.classDeclRemoved tree)))
                      (set! (.-pendingResolutionPhase (cast AttrContext (.-info diamondEnv))) nil)
                      (let [constructor (.resolveDiamond
                                          rs
                                          (.pos tree)
                                          diamondEnv
                                          site
                                          argtypes
                                          typeargtypes)]
                        (set! (.-constructor tree) (.baseSymbol constructor))
                        (let [csym (.-tsym clazztype)
                              diamondResult (ResultInfo.
                                              pkind
                                              (.newMethodTemplate
                                                this
                                                (.-pt resultInfo)
                                                argtypes
                                                typeargtypes)
                                              (.diamondContext
                                                this
                                                tree
                                                csym
                                                (.-checkContext resultInfo))
                                              CheckMode/NO_TREE_UPDATE)
                              ^:mutable constructorType (set!
                                                          (.-constructorType tree)
                                                          (.createErrorType types clazztype))]
                          (set! constructorType
                                (.checkId this tree site constructor diamondEnv diamondResult))
                          (set! (.-type (.-clazz tree)) (.createErrorType types clazztype))
                          (when-not (.isErroneous constructorType)
                            (set! (.-type (.-clazz tree))
                                  (set! (.-type clazz) (.getReturnType constructorType)))
                            (set! (.-constructorType tree)
                                  (.createMethodTypeWithReturn
                                    types
                                    constructorType
                                    (.-voidType syms))))
                          (set! clazztype
                                (.checkClassType chk (.-clazz tree) (.-type (.-clazz tree)) true)))))
                    (when-not skipNonDiamondPath
                      (let [^{:tag (Env AttrContext)} rsEnv (.dup localEnv tree)]
                        (set! (.-selectSuper (cast AttrContext (.-info rsEnv))) (some? cdef))
                        (set! (.-pendingResolutionPhase (cast AttrContext (.-info rsEnv))) nil)
                        (set! (.-constructor tree)
                              (.resolveConstructor
                                rs
                                (.pos tree)
                                rsEnv
                                clazztype
                                argtypes
                                typeargtypes))
                        (when (nil? cdef)
                          (set! (.-constructorType tree)
                                (.checkId this
                                          tree
                                          clazztype
                                          (.-constructor tree)
                                          rsEnv
                                          (ResultInfo.
                                            pkind
                                            (.newMethodTemplate
                                              this
                                              (.-voidType syms)
                                              argtypes
                                              typeargtypes)
                                            CheckMode/NO_TREE_UPDATE)))
                          (when (.lastResolveVarargs (cast AttrContext (.-info rsEnv)))
                            (Assert/check (or (.isErroneous (.-constructorType tree))
                                              (some? (.-varargsElement tree)))))))))
                (.checkRequiresIdentity chk tree (.-lint (cast AttrContext (.-info env))))
                (when (some? cdef)
                  (.visitAnonymousClassDefinition
                    this
                    tree
                    clazz
                    clazztype
                    cdef
                    localEnv
                    argtypes
                    typeargtypes
                    pkind)
                  (return))
                (when (and (some? (.-constructor tree))
                           (identical? (.-kind (.-constructor tree)) Kinds$Kind/MTH))
                  (set! owntype clazztype))))
            (set! result (.check this tree owntype Kinds$KindSelector/VAL resultInfo))
            (let [inferenceContext (.inferenceContext (.-checkContext resultInfo))]
              (when (and (some? (.-constructorType tree))
                         (.free inferenceContext (.-constructorType tree)))
                (.addFreeTypeListener
                  inferenceContext
                  (List/of (.-constructorType tree))
                  (lambda Infer$FreeTypeListener ^void [^InferenceContext instantiatedContext]
                    (set! (.-constructorType tree)
                          (.asInstType instantiatedContext (.-constructorType tree))))))
              (.validate chk (.-typeargs tree) localEnv)))))))

  (method ^:private visitAnonymousClassDefinition ^void [this ^JCTree$JCNewClass tree
                                                         ^JCTree$JCExpression clazz
                                                         ^:mutable ^Type clazztype
                                                         ^JCTree$JCClassDecl cdef
                                                         ^{:tag (Env AttrContext)} localEnv
                                                         ^{:tag (List Type)} argtypes
                                                         ^{:tag (List Type)} typeargtypes
                                                         ^Kinds$KindSelector pkind]
    (let [inferenceContext (.inferenceContext (.-checkContext resultInfo))
          enclType (.getEnclosingType clazztype)]
      (when (and (and (some? enclType) (.hasTag enclType TypeTag/CLASS))
                 (not (.checkDenotable chk (cast Type$ClassType enclType))))
        (.error log
                (.-encl tree)
                (CompilerProperties$Errors/EnclosingClassTypeNonDenotable enclType)))
      (let [isDiamond (TreeInfo/isDiamond tree)]
        (if (and isDiamond
                 (or (and (some? (.-constructorType tree))
                          (.free inferenceContext (.-constructorType tree)))
                     (and (some? (.-type (.-clazz tree)))
                          (.free inferenceContext (.-type (.-clazz tree))))))
            (let [resultInfoForClassDefinition (.-resultInfo this)
                  ^{:tag (Env AttrContext)} dupLocalEnv (.copyEnv this localEnv)]
              (.addFreeTypeListener
                inferenceContext
                (List/of (.-constructorType tree) (.-type (.-clazz tree)))
                (lambda Infer$FreeTypeListener ^void [^InferenceContext instantiatedContext]
                  (set! (.-constructorType tree)
                        (.asInstType instantiatedContext (.-constructorType tree)))
                  (set! (.-type (.-clazz tree))
                        (set! (.-type clazz) (.asInstType instantiatedContext (.-type clazz))))
                  (let [prevResult (.-resultInfo this)]
                    (try
                      (set! (.-resultInfo this) resultInfoForClassDefinition)
                      (.visitAnonymousClassDefinition
                        this
                        tree
                        clazz
                        (.-type clazz)
                        cdef
                        dupLocalEnv
                        argtypes
                        typeargtypes
                        pkind)
                      (finally (set! (.-resultInfo this) prevResult)))))))
            (do
              (when (and isDiamond (.hasTag clazztype TypeTag/CLASS))
                (let [^{:tag (List Type)} invalidDiamondArgs (.checkDiamondDenotable
                                                               chk
                                                               (cast Type$ClassType clazztype))]
                  (when (and (not (.isErroneous clazztype)) (.nonEmpty invalidDiamondArgs))
                    (let [fragment (CompilerProperties$Fragments/Diamond (.-tsym clazztype))]
                      (.error
                        log
                        (.pos (.-clazz tree))
                        (CompilerProperties$Errors/CantApplyDiamond1
                          fragment
                          ^JCDiagnostic$Fragment (if (> (.size invalidDiamondArgs) 1)
                                                     (CompilerProperties$Fragments/DiamondInvalidArgs
                                                       invalidDiamondArgs
                                                       fragment)
                                                     (CompilerProperties$Fragments/DiamondInvalidArg
                                                       invalidDiamondArgs
                                                       fragment))))))
                  (for-each [^Type t (.getTypeArguments clazztype)] (.checkAccessibleType rs env t))))
              (let [implementing (or (.isInterface (.-tsym clazztype))
                                     (and (and
                                            (.isErroneous clazztype)
                                            (not
                                              (.hasTag (.getOriginalType clazztype) TypeTag/NONE)))
                                          (.isInterface (.-tsym (.getOriginalType clazztype)))))]
                (if implementing
                    (set! (.-implementing cdef) (List/of clazz))
                    (set! (.-extending cdef) clazz))
                (when (and (identical? (.-mode (.deferredAttrContext (.-checkContext resultInfo)))
                                       DeferredAttr$AttrMode/CHECK)
                           (.isSerializable rs clazztype))
                  (set! (.-isSerializable (cast AttrContext (.-info localEnv))) true))
                (.attribStat this cdef localEnv)
                (let [^:mutable ^{:tag (List Type)} finalargtypes (if (and
                                                                        (some? (.-encl tree))
                                                                        (not
                                                                          (.isInterface
                                                                            (.-tsym clazztype))))
                                                                      (.prepend
                                                                        argtypes
                                                                        (.-type (.-encl tree)))
                                                                      argtypes)]
                  (when (and isDiamond (.contains pkind Kinds$KindSelector/POLY))
                    (set! finalargtypes (.map finalargtypes (.-deferredCopier deferredAttr))))
                  (set! clazztype
                        (if (.hasTag clazztype TypeTag/ERROR)
                            (.createErrorType types (.-type (.-sym cdef)))
                            (.-type (.-sym cdef))))
                  (let [sym (set! (.-constructor tree)
                                  (.resolveConstructor
                                    rs
                                    (.pos tree)
                                    localEnv
                                    clazztype
                                    finalargtypes
                                    typeargtypes))]
                    (Assert/check (not (.isResolutionError (.-kind sym))))
                    (set! (.-constructor tree) sym)
                    (set! (.-constructorType tree)
                          (.checkId this
                                    tree
                                    clazztype
                                    (.-constructor tree)
                                    localEnv
                                    (ResultInfo.
                                      pkind
                                      (.newMethodTemplate
                                        this
                                        (.-voidType syms)
                                        finalargtypes
                                        typeargtypes)
                                      CheckMode/NO_TREE_UPDATE))))))))
        (let [^Type owntype (if (and (some? (.-constructor tree))
                                     (identical? (.-kind (.-constructor tree)) Kinds$Kind/MTH))
                                clazztype
                                (.createErrorType types (.-type tree)))]
          (set! result
                (.check this
                        tree
                        owntype
                        Kinds$KindSelector/VAL
                        (.dup resultInfo CheckMode/NO_INFERENCE_HOOK)))
          (.validate chk (.-typeargs tree) localEnv)))))

  (method diamondContext ^Check$CheckContext [this ^JCTree$JCNewClass clazz ^Symbol$TypeSymbol tsym
                                              ^Check$CheckContext checkContext]
    (anon Check$NestedCheckContext [checkContext]
      (method ^:public report ^void [this ^JCDiagnostic$DiagnosticPosition _unused
                                     ^JCDiagnostic details]
        (.report (.-enclosingContext this)
                 (.-clazz clazz)
                 (.fragment diags
                            (CompilerProperties$Fragments/CantApplyDiamond1
                              (CompilerProperties$Fragments/Diamond tsym)
                              details))))))

  (method checkNewInnerClass ^void [this ^JCDiagnostic$DiagnosticPosition pos
                                    ^{:tag (Env AttrContext)} env ^Type type ^boolean isSuper]
    (let [isLocal (or (identical? (.-kind (.-owner (.-tsym type))) Kinds$Kind/VAR)
                      (identical? (.-kind (.-owner (.-tsym type))) Kinds$Kind/MTH))]
      (when-not (or (or (not (== (bit-and (.flags (.-tsym type))
                                          (bit-or
                                            (bit-or-int Flags/INTERFACE Flags/ENUM)
                                            Flags/RECORD))
                                 0))
                        (and (not isLocal) (not (.isInner (.-tsym type)))))
                    (and isSuper (.isAnonymous (.-sym (.-enclClass env)))))
        (let [^Symbol res (if isLocal
                              (.findLocalClassOwner rs env (.-tsym type))
                              (.findSelfContaining
                                rs
                                pos
                                env
                                (.-tsym (.getEnclosingType type))
                                isSuper))]
          (if (.exists res)
              (.accessBase rs res pos (.-type (.-sym (.-enclClass env))) (.-_this names) true)
              (.error log pos (CompilerProperties$Errors/EnclClassRequired (.-tsym type))))))))

  (method ^:public makeNullCheck ^JCTree$JCExpression [this ^JCTree$JCExpression arg]
    (if (identical? (.getTag arg) JCTree$Tag/NEWCLASS)
        arg
        (let [name (TreeInfo/name arg)]
          (if (or (identical? name (.-_this names)) (identical? name (.-_super names)))
              arg
              (let [optag JCTree$Tag/NULLCHK
                    tree (.Unary (.at make (.-pos arg)) optag arg)]
                (set! (.-operator tree) (.resolveUnary operators arg optag (.-type arg)))
                (set! (.-type tree) (.-type arg))
                tree)))))

  (method ^:public visitNewArray ^void [this ^JCTree$JCNewArray tree]
    (let [^:mutable owntype (.createErrorType types (.-type tree))
          ^{:tag (Env AttrContext)} localEnv (.dup env tree)
          ^:mutable ^Type elemtype nil]
      (cond
        (some? (.-elemtype tree))
          (do
            (set! elemtype (.attribType this (.-elemtype tree) localEnv))
            (.validate chk (.-elemtype tree) localEnv)
            (set! owntype elemtype)
            (loop [^{:tag (List JCTree$JCExpression)} l (.-dims tree)]
              (when (.nonEmpty l)
                (.attribExpr this (cast JCTree (.-head l)) localEnv (.-intType syms))
                (set! owntype (Type$ArrayType. owntype (.-arrayClass syms)))
                (recur (.-tail l)))))
        (.hasTag (.pt this) TypeTag/ARRAY) (set! elemtype (.elemtype types (.pt this)))
        :else
          (do
            (when (and (not (.hasTag (.pt this) TypeTag/ERROR))
                       (or
                         (nil? (.-enclVar (cast AttrContext (.-info env))))
                         (not (.isErroneous (.-type (.-enclVar (cast AttrContext (.-info env))))))))
              (.error log
                      (.pos tree)
                      (CompilerProperties$Errors/IllegalInitializerForType (.pt this))))
            (set! elemtype (.createErrorType types (.pt this)))))
      (when (some? (.-elems tree))
        (.attribExprs this (.-elems tree) localEnv elemtype)
        (set! owntype (Type$ArrayType. elemtype (.-arrayClass syms))))
      (when-not (.isReifiable types elemtype)
        (.error log (.pos tree) CompilerProperties$Errors/GenericArrayCreation))
      (set! result (.check this tree owntype Kinds$KindSelector/VAL resultInfo))))

  (method ^:public visitLambda ^void [this ^:final ^JCTree$JCLambda that]
    (let [^:mutable wrongContext false]
      (when (or (.isErroneous (.pt this))
                (and (.hasTag (.pt this) TypeTag/NONE)
                     (not (identical? (.pt this) Type/recoveryType))))
        (when (and (.hasTag (.pt this) TypeTag/NONE)
                   (or (nil? (.-enclVar (cast AttrContext (.-info env))))
                       (not (.isErroneous (.-type (.-enclVar (cast AttrContext (.-info env))))))))
          (.error log (.pos that) CompilerProperties$Errors/UnexpectedLambda))
        (set! resultInfo recoveryInfo)
        (set! wrongContext true))
      (let [^{:tag (Env AttrContext)} localEnv (.lambdaEnv this that env)
            ^:mutable needsRecovery (identical?
                                      (.-mode (.deferredAttrContext (.-checkContext resultInfo)))
                                      DeferredAttr$AttrMode/CHECK)]
        (try
          (when (and needsRecovery (.isSerializable rs (.pt this)))
            (set! (.-isSerializable (cast AttrContext (.-info localEnv))) true)
            (set! (.-isSerializableLambda (cast AttrContext (.-info localEnv))) true))
          (let [^:mutable ^{:tag (List Type)} explicitParamTypes nil]
            (when (identical? (.-paramKind that) JCTree$JCLambda$ParameterKind/EXPLICIT)
              (.attribStats this (.-params that) localEnv)
              (set! explicitParamTypes (TreeInfo/types (.-params that))))
            (let [targetInfo (.getTargetInfo this that resultInfo explicitParamTypes)
                  currentTarget (.-target targetInfo)
                  lambdaType (.-descriptor targetInfo)]
              (if (.isErroneous currentTarget)
                  (set! result (set! (.-type that) currentTarget))
                  (do
                    (.setFunctionalInfo this
                                        localEnv
                                        that
                                        (.pt this)
                                        lambdaType
                                        currentTarget
                                        (.-checkContext resultInfo))
                    (if (.hasTag lambdaType TypeTag/FORALL)
                        (let [msg (CompilerProperties$Fragments/InvalidGenericLambdaTarget
                                    lambdaType
                                    (Kinds/kindName (.-tsym currentTarget))
                                    (.-tsym currentTarget))]
                          (.report (.-checkContext resultInfo) that (.fragment diags msg))
                          (set! result (set! (.-type that) (.createErrorType types (.pt this)))))
                        (do
                          (when (identical? (.-paramKind that)
                                            JCTree$JCLambda$ParameterKind/IMPLICIT)
                            (let [^:mutable ^{:tag (List Type)} actuals (.getParameterTypes
                                                                          lambdaType)
                                  ^:mutable ^{:tag (List JCTree$JCVariableDecl)} params (.-params
                                                                                          that)
                                  ^:mutable arityMismatch false]
                              (while (.nonEmpty params)
                                (when (.isEmpty actuals) (set! arityMismatch true))
                                (let [^Type argType (if arityMismatch
                                                        (.-errType syms)
                                                        (cast Type (.-head actuals)))]
                                  (when (.isImplicitlyTyped
                                          (cast JCTree$JCVariableDecl (.-head params)))
                                    (.setSyntheticVariableType
                                      this
                                      (cast JCTree$JCVariableDecl (.-head params))
                                      argType))
                                  (set! (.-sym (cast JCTree$JCVariableDecl (.-head params))) nil)
                                  (set! actuals (if (.isEmpty actuals) actuals (.-tail actuals)))
                                  (set! params (.-tail params))))
                              (.attribStats this (.-params that) localEnv)
                              (when arityMismatch
                                (.report
                                  (.-checkContext resultInfo)
                                  that
                                  (.fragment
                                    diags
                                    CompilerProperties$Fragments/IncompatibleArgTypesInLambda))
                                (set! result
                                      (set! (.-type that) (.createErrorType types currentTarget)))
                                (return))))
                          (set! needsRecovery false)
                          (let [bodyResultInfo (set!
                                                 (.-returnResult
                                                   (cast AttrContext (.-info localEnv)))
                                                 (.lambdaBodyResult this that lambdaType resultInfo))]
                            (if (identical? (.getBodyKind that)
                                            LambdaExpressionTree$BodyKind/EXPRESSION)
                                (.attribTree this (.getBody that) localEnv bodyResultInfo)
                                (let [body (cast JCTree$JCBlock (.-body that))]
                                  (when (and (identical? body breakTree)
                                             (identical?
                                               (.-mode
                                                 (.deferredAttrContext (.-checkContext resultInfo)))
                                               DeferredAttr$AttrMode/CHECK))
                                    (.breakTreeFound this (.copyEnv this localEnv)))
                                  (.attribStats this (.-stats body) localEnv)))
                            (set!
                              result
                              (.check this that currentTarget Kinds$KindSelector/VAL resultInfo))
                            (let [isSpeculativeRound (identical?
                                                       (.-mode
                                                         (.deferredAttrContext
                                                           (.-checkContext resultInfo)))
                                                       DeferredAttr$AttrMode/SPECULATIVE)]
                              (.preFlow this that)
                              (.analyzeLambda flow env that make isSpeculativeRound)
                              (set! (.-type that) currentTarget)
                              (.checkLambdaCompatible
                                this
                                that
                                lambdaType
                                (.-checkContext resultInfo))
                              (when-not isSpeculativeRound
                                (when (.free (.inferenceContext (.-checkContext resultInfo))
                                             (.getThrownTypes lambdaType))
                                  (let [^{:tag (List Type)} inferredThrownTypes
                                          (.analyzeLambdaThrownTypes flow env that make)]
                                    (when-not (.checkExConstraints
                                                this
                                                inferredThrownTypes
                                                (.getThrownTypes lambdaType)
                                                (.inferenceContext (.-checkContext resultInfo)))
                                      (.error
                                        log
                                        that
                                        (CompilerProperties$Errors/IncompatibleThrownTypesInMref
                                          (.getThrownTypes lambdaType))))))
                                (.checkAccessibleTypes
                                  this
                                  that
                                  localEnv
                                  (.inferenceContext (.-checkContext resultInfo))
                                  (new Type/1 [lambdaType currentTarget])))
                              (set! result
                                    (if wrongContext
                                        (set! (.-type that) (.createErrorType types (.pt this)))
                                        (.check this
                                                that
                                                currentTarget
                                                Kinds$KindSelector/VAL
                                                resultInfo)))))))))))
          (catch Types$FunctionDescriptorLookupError ex
            (let [cause (.getDiagnostic ex)]
              (.report (.-checkContext resultInfo) that cause)
              (set! result (set! (.-type that) (.createErrorType types (.pt this))))))
          (catch Symbol$CompletionFailure cf (.completionError chk (.pos that) cf))
          (catch Throwable t (set! needsRecovery false) (throw t))
          (finally
            (.leave (.-scope (cast AttrContext (.-info localEnv))))
            (when needsRecovery
              (let [prevResult result]
                (try
                  (.attribTree this that env recoveryInfo)
                  (finally (when (identical? result Type/recoveryType) (set! result prevResult)))))))))))

  (defclass TargetInfo
    (field ^Type target)

    (field ^Type descriptor)

    (constructor ^:public [this ^Type target ^Type descriptor]
      (set! (.-target this) target)
      (set! (.-descriptor this) descriptor)))

  (method getTargetInfo ^TargetInfo [this ^JCTree$JCPolyExpression that ^ResultInfo resultInfo
                                     ^{:tag (List Type)} explicitParamTypes]
    (let [^:mutable ^Type lambdaType nil
          ^:mutable currentTarget (.-pt resultInfo)]
      (if (not (identical? (.-pt resultInfo) Type/recoveryType))
          (do
            (set! currentTarget (cast Type (.visit targetChecker currentTarget that)))
            (if (not (.isIntersection currentTarget))
                (do
                  (when (some? explicitParamTypes)
                    (set! currentTarget
                          (.instantiateFunctionalInterface
                            infer
                            that
                            currentTarget
                            explicitParamTypes
                            (.-checkContext resultInfo))))
                  (set! currentTarget (.removeWildcards types currentTarget))
                  (set! lambdaType (.findDescriptorType types currentTarget)))
                (let [ict (cast Type$IntersectionClassType currentTarget)
                      ^{:tag (ListBuffer Type)} components (ListBuffer.)]
                  (for-each [^:mutable ^Type bound (.getExplicitComponents ict)]
                    (when (some? explicitParamTypes)
                      (try
                        (set! bound
                              (.instantiateFunctionalInterface
                                infer
                                that
                                bound
                                explicitParamTypes
                                (.-checkContext resultInfo)))
                        (catch Types$FunctionDescriptorLookupError t)))
                    (when (and (not (identical? (.-tsym bound) (.-tsym (.-objectType syms))))
                               (or (not (.isInterface bound))
                                   (not (== (bit-and (.flags (.-tsym bound)) Flags/ANNOTATION) 0))))
                      (.reportIntersectionError this that "not.an.intf.component" bound))
                    (set! bound (.removeWildcards types bound))
                    (.add components bound))
                  (set! currentTarget (.makeIntersectionType types (.toList components)))
                  (let [o-8 (.-tsym currentTarget)]
                    (set! (.-flags_field o-8) (bit-or (.-flags_field o-8) Flags/INTERFACE)))
                  (set! lambdaType (.findDescriptorType types currentTarget)))))
          (do
            (set! currentTarget Type/recoveryType)
            (set! lambdaType (.fallbackDescriptorType this that))))
      (when (and (.hasTag that JCTree$Tag/LAMBDA) (.hasTag lambdaType TypeTag/FORALL))
        (let [msg (CompilerProperties$Fragments/InvalidGenericLambdaTarget
                    lambdaType
                    (Kinds/kindName (.-tsym currentTarget))
                    (.-tsym currentTarget))]
          (.report (.-checkContext resultInfo) that (.fragment diags msg))
          (set! currentTarget (.createErrorType types (.pt this)))))
      (TargetInfo. currentTarget lambdaType)))

  (method ^:private reportIntersectionError ^void [this ^JCDiagnostic$DiagnosticPosition pos
                                                   ^String key & ^Object/1 args]
    (.report (.-checkContext resultInfo)
             pos
             (.fragment diags
                        (CompilerProperties$Fragments/BadIntersectionTargetForFunctionalExpr
                          (.fragment diags key args)))))

  (method preFlow ^void [this ^JCTree$JCLambda tree]
    (.doRecovery attrRecover)
    (.scan (anon PostAttrAnalyzer []
             (method ^:public scan ^void [this ^JCTree tree]
               (when-not (or (nil? tree)
                             (and (some? (.-type tree)) (identical? (.-type tree) Type/stuckType)))
                 (.scan super tree)))

             (method ^:public visitClassDef ^void [this ^JCTree$JCClassDecl that])

             (method ^:public visitLambda ^void [this ^JCTree$JCLambda that]))
           (.-body tree)))

  (field ^{:tag (Types$MapVisitor JCDiagnostic$DiagnosticPosition)} targetChecker
    (anon (Types$MapVisitor JCDiagnostic$DiagnosticPosition) []
      (method ^:public visitClassType ^Type [this ^Type$ClassType t
                                             ^JCDiagnostic$DiagnosticPosition pos]
        (if (.isIntersection t)
            (.visitIntersectionClassType this (cast Type$IntersectionClassType t) pos)
            ^Type t))

      (method ^:public visitIntersectionClassType ^Type [this ^Type$IntersectionClassType ict
                                                         ^JCDiagnostic$DiagnosticPosition pos]
        (.findDescriptorSymbol types (.makeNotionalInterface this ict pos))
        ict)

      (method ^:private makeNotionalInterface ^Symbol$TypeSymbol [this
                                                                  ^Type$IntersectionClassType ict
                                                                  ^JCDiagnostic$DiagnosticPosition pos]
        (let [^{:tag (ListBuffer Type)} targs (ListBuffer.)
              ^{:tag (ListBuffer Type)} supertypes (ListBuffer.)]
          (for-each [^Type i (.-interfaces_field ict)]
            (when (.isParameterized i) (.appendList targs (.allparams (.-type (.-tsym i)))))
            (.append supertypes (.-type (.-tsym i))))
          (let [notionalIntf (.makeIntersectionType types (.toList supertypes))]
            (set! (.-allparams_field notionalIntf) (.toList targs))
            (let [o-9 (.-tsym notionalIntf)]
              (set! (.-flags_field o-9) (bit-or (.-flags_field o-9) Flags/INTERFACE)))
            (.-tsym notionalIntf))))))

  (method ^:private fallbackDescriptorType ^Type [this ^JCTree$JCExpression tree]
    (switch (.getTag tree)
      LAMBDA
        (let [lambda (cast JCTree$JCLambda tree)
              ^:mutable ^{:tag (List Type)} argtypes (List/nil)]
          (for-each [^JCTree$JCVariableDecl param (.-params lambda)]
            (set! argtypes
                  (if (and (some? (.-vartype param)) (some? (.-type (.-vartype param))))
                      (.append argtypes (.-type (.-vartype param)))
                      (.append argtypes (.-errType syms)))))
          (return (Type$MethodType. argtypes
                                    Type/recoveryType
                                    (List/of (.-throwableType syms))
                                    (.-methodClass syms))))
      REFERENCE
        (return (Type$MethodType. (List/nil)
                                  Type/recoveryType
                                  (List/of (.-throwableType syms))
                                  (.-methodClass syms)))
      (Assert/error "Cannot get here!"))
    nil)

  (method ^:private checkAccessibleTypes ^void [this ^:final ^JCDiagnostic$DiagnosticPosition pos
                                                ^:final ^{:tag (Env AttrContext)} env
                                                ^:final ^InferenceContext inferenceContext &
                                                ^:final ^Type/1 ts]
    (.checkAccessibleTypes this pos env inferenceContext (List/from ts)))

  (method ^:private checkAccessibleTypes ^void [this ^:final ^JCDiagnostic$DiagnosticPosition pos
                                                ^:final ^{:tag (Env AttrContext)} env
                                                ^:final ^InferenceContext inferenceContext
                                                ^:final ^{:tag (List Type)} ts]
    (if (.free inferenceContext ts)
        (.addFreeTypeListener inferenceContext
                              ts
                              (lambda Infer$FreeTypeListener ^void [^InferenceContext solvedContext]
                                (.checkAccessibleTypes
                                  this
                                  pos
                                  env
                                  solvedContext
                                  (.asInstTypes solvedContext ts))))
        (for-each [^Type t ts] (.checkAccessibleType rs env t))))

  (defclass FunctionalReturnContext
    :extends Check$NestedCheckContext

    (constructor [this ^Check$CheckContext enclosingContext]
      (super. enclosingContext))

    (method ^:public compatible ^boolean [this ^Type found ^Type req ^Warner warn]
      (.compatible (.-basicHandler chk)
                   (.asUndetVar (.inferenceContext this) found)
                   (.asUndetVar (.inferenceContext this) req)
                   warn))

    (method ^:public report ^void [this ^JCDiagnostic$DiagnosticPosition pos ^JCDiagnostic details]
      (.report (.-enclosingContext this)
               pos
               (.fragment diags (CompilerProperties$Fragments/IncompatibleRetTypeInLambda details)))))

  (defclass ExpressionLambdaReturnContext
    :extends FunctionalReturnContext

    (field ^JCTree$JCExpression expr)

    (field ^boolean expStmtExpected)

    (constructor [this ^JCTree$JCExpression expr ^Check$CheckContext enclosingContext]
      (super. enclosingContext)
      (set! (.-expr this) expr))

    (method ^:public report ^void [this ^JCDiagnostic$DiagnosticPosition pos ^JCDiagnostic details]
      (if expStmtExpected
          (.report (.-enclosingContext this)
                   pos
                   (.fragment diags CompilerProperties$Fragments/StatExprExpected))
          (.report super pos details)))

    (method ^:public compatible ^boolean [this ^Type found ^Type req ^Warner warn]
      (if (.hasTag req TypeTag/VOID)
          (do (set! expStmtExpected true) (TreeInfo/isExpressionStatement expr))
          (.compatible super found req warn))))

  (method lambdaBodyResult ^ResultInfo [this ^JCTree$JCLambda that ^Type descriptor
                                        ^ResultInfo resultInfo]
    (let [^FunctionalReturnContext funcContext (if (identical?
                                                     (.getBodyKind that)
                                                     LambdaExpressionTree$BodyKind/EXPRESSION)
                                                   ^FunctionalReturnContext (ExpressionLambdaReturnContext.
                                                                              (cast
                                                                                JCTree$JCExpression
                                                                                (.getBody that))
                                                                              (.-checkContext
                                                                                resultInfo))
                                                   (FunctionalReturnContext.
                                                     (.-checkContext resultInfo)))]
      (if (identical? (.getReturnType descriptor) Type/recoveryType)
          recoveryInfo
          (ResultInfo. Kinds$KindSelector/VAL (.getReturnType descriptor) funcContext))))

  (method checkLambdaCompatible ^void [this ^JCTree$JCLambda tree ^Type descriptor
                                       ^Check$CheckContext checkContext]
    (let [returnType (.asUndetVar (.inferenceContext checkContext) (.getReturnType descriptor))]
      (when (and (and (and (identical? (.getBodyKind tree) LambdaExpressionTree$BodyKind/STATEMENT)
                           (.-canCompleteNormally tree))
                      (not (.hasTag returnType TypeTag/VOID)))
                 (not (identical? returnType Type/recoveryType)))
        (let [msg (CompilerProperties$Fragments/IncompatibleRetTypeInLambda
                    (CompilerProperties$Fragments/MissingRetVal returnType))]
          (.report checkContext tree (.fragment diags msg))))
      (let [^{:tag (List Type)} argTypes (.asUndetVars
                                           (.inferenceContext checkContext)
                                           (.getParameterTypes descriptor))]
        (when-not (.isSameTypes types argTypes (TreeInfo/types (.-params tree)))
          (.report checkContext
                   tree
                   (.fragment diags CompilerProperties$Fragments/IncompatibleArgTypesInLambda))))))

  (method ^:public lambdaEnv ^{:tag (Env AttrContext)} [this ^JCTree$JCLambda that
                                                        ^{:tag (Env AttrContext)} env]
    (let [^:mutable ^{:tag (Env AttrContext)} lambdaEnv nil
          owner (.-owner (.-scope (cast AttrContext (.-info env))))]
      (if (and (identical? (.-kind owner) Kinds$Kind/VAR)
               (identical? (.-kind (.-owner owner)) Kinds$Kind/TYP))
          (let [enclClass (.enclClass owner)
                ^Name initName (if (.isStatic owner) (.-clinit names) (.-init names))
                initSym (Symbol$MethodSymbol.
                          (bit-or-int (bit-or-int
                                        (bit-or-int
                                          Flags/BLOCK
                                          (if (.isStatic owner) Flags/STATIC 0))
                                        Flags/SYNTHETIC)
                                      Flags/PRIVATE)
                          initName
                          initBlockType
                          enclClass)]
            (set! (.-params initSym) (List/nil))
            (set! lambdaEnv
                  (.dup env
                        that
                        (.dup (cast AttrContext (.-info env))
                              (.dupUnshared (.-scope (cast AttrContext (.-info env))) initSym)))))
          (set! lambdaEnv
                (.dup env
                      that
                      (.dup (cast AttrContext (.-info env))
                            (.dup (.-scope (cast AttrContext (.-info env))))))))
      (set! (.-yieldResult (cast AttrContext (.-info lambdaEnv))) nil)
      (set! (.-isLambda (cast AttrContext (.-info lambdaEnv))) true)
      lambdaEnv))

  (method ^:public visitReference ^void [this ^:final ^JCTree$JCMemberReference that]
    (if (or (.isErroneous (.pt this))
            (and (.hasTag (.pt this) TypeTag/NONE) (not (identical? (.pt this) Type/recoveryType))))
        (do
          (when (and (.hasTag (.pt this) TypeTag/NONE)
                     (or (nil? (.-enclVar (cast AttrContext (.-info env))))
                         (not (.isErroneous (.-type (.-enclVar (cast AttrContext (.-info env))))))))
            (.error log (.pos that) CompilerProperties$Errors/UnexpectedMref))
          (set! result (set! (.-type that) (.createErrorType types (.pt this)))))
        (let [^{:tag (Env AttrContext)} localEnv (.dup env that)]
          (try
            (let [^:mutable exprType (.attribTree
                                       this
                                       (.-expr that)
                                       env
                                       (.memberReferenceQualifierResult this that))]
              (when (identical? (.getMode that) MemberReferenceTree$ReferenceMode/NEW)
                (set! exprType (.checkConstructorRefType chk (.-expr that) exprType))
                (when (and (and (not (.isErroneous exprType)) (.isRaw exprType))
                           (some? (.-typeargs that)))
                  (.error log
                          (.pos (.-expr that))
                          (CompilerProperties$Errors/InvalidMref
                            (Kinds/kindName (.getMode that))
                            CompilerProperties$Fragments/MrefInferAndExplicitParams))
                  (set! exprType (.createErrorType types exprType))))
              (if (.isErroneous exprType)
                  (set! result (set! (.-type that) exprType))
                  (do
                    (if (TreeInfo/isStaticSelector (.-expr that) names)
                        (.validate chk (.-expr that) env false)
                        (let [lhsSym (TreeInfo/symbol (.-expr that))]
                          (set! (.-selectSuper (cast AttrContext (.-info localEnv)))
                                (and (some? lhsSym) (identical? (.-name lhsSym) (.-_super names))))))
                    (let [^:mutable ^{:tag (List Type)} typeargtypes (List/nil)]
                      (when (some? (.-typeargs that))
                        (set! typeargtypes (.attribTypes this (.-typeargs that) localEnv)))
                      (let [isTargetSerializable (and
                                                   (identical?
                                                     (.-mode
                                                       (.deferredAttrContext
                                                         (.-checkContext resultInfo)))
                                                     DeferredAttr$AttrMode/CHECK)
                                                   (.isSerializable rs (.pt this)))
                            targetInfo (.getTargetInfo this that resultInfo nil)
                            currentTarget (.-target targetInfo)
                            desc (.-descriptor targetInfo)]
                        (.setFunctionalInfo this
                                            localEnv
                                            that
                                            (.pt this)
                                            desc
                                            currentTarget
                                            (.-checkContext resultInfo))
                        (let [^{:tag (List Type)} argtypes (.getParameterTypes desc)
                              ^:mutable referenceCheck (.-resolveMethodCheck rs)]
                          (when (.free (.inferenceContext (.-checkContext resultInfo)) argtypes)
                            (set! referenceCheck
                                  (.new rs
                                        Resolve$MethodReferenceCheck
                                        (.inferenceContext (.-checkContext resultInfo)))))
                          (let [^:mutable ^{:tag (Pair Symbol Resolve$ReferenceLookupHelper)} refResult
                                  nil
                                ^{:tag (List Type)} saved_undet (.save
                                                                  (.inferenceContext
                                                                    (.-checkContext resultInfo)))]
                            (try
                              (set! refResult
                                    (.resolveMemberReference
                                      rs
                                      localEnv
                                      that
                                      (.-type (.-expr that))
                                      (.-name that)
                                      argtypes
                                      typeargtypes
                                      (.-descriptor targetInfo)
                                      referenceCheck
                                      (.inferenceContext (.-checkContext resultInfo))
                                      (.-basicReferenceChooser rs)))
                              (finally
                                (.rollback (.inferenceContext (.-checkContext resultInfo))
                                           saved_undet)))
                            (let [refSym (cast Symbol (.-fst refResult))
                                  lookupHelper (cast
                                                 Resolve$ReferenceLookupHelper
                                                 (.-snd refResult))]
                              (if (not (identical? (.-kind refSym) Kinds$Kind/MTH))
                                  (let [^:mutable ^boolean targetError false]
                                    (switch (.-kind refSym)
                                      ABSENT_MTH (set! targetError false)
                                      (WRONG_MTH WRONG_MTHS AMBIGUOUS HIDDEN STATICERR)
                                        (set! targetError true)
                                      (do
                                        (Assert/error
                                          (java-str "unexpected result kind " (.-kind refSym)))
                                        (set! targetError false)))
                                    (let [detailsDiag (.getDiagnostic
                                                        (cast
                                                          Resolve$ResolveError
                                                          (.baseSymbol refSym))
                                                        JCDiagnostic$DiagnosticType/FRAGMENT
                                                        that
                                                        (.-tsym exprType)
                                                        exprType
                                                        (.-name that)
                                                        argtypes
                                                        typeargtypes)
                                          diag (.create
                                                 diags
                                                 (.currentSource log)
                                                 that
                                                 ^JCDiagnostic$DiagnosticInfo (if targetError
                                                                                  ^JCDiagnostic$DiagnosticInfo (CompilerProperties$Fragments/InvalidMref
                                                                                                                 (Kinds/kindName
                                                                                                                   (.getMode
                                                                                                                     that))
                                                                                                                 detailsDiag)
                                                                                  ^JCDiagnostic$DiagnosticInfo (CompilerProperties$Errors/InvalidMref
                                                                                                                 (Kinds/kindName
                                                                                                                   (.getMode
                                                                                                                     that))
                                                                                                                 detailsDiag)))]
                                      (if (and targetError
                                               (identical? currentTarget Type/recoveryType))
                                          (set! result (set! (.-type that) currentTarget))
                                          (do
                                            (if targetError
                                                (.report (.-checkContext resultInfo) that diag)
                                                (.report log diag))
                                            (set!
                                              result
                                              (set!
                                                (.-type that)
                                                (.createErrorType types currentTarget)))))))
                                  (do
                                    (set! (.-sym that)
                                          (if (.isConstructor refSym) (.baseSymbol refSym) refSym))
                                    (set! (.-kind that) (.referenceKind lookupHelper (.-sym that)))
                                    (set! (.-ownerAccessible that)
                                          (.isAccessible rs localEnv (.enclClass (.-sym that))))
                                    (if (identical? (.getReturnType desc) Type/recoveryType)
                                        (set! result (set! (.-type that) currentTarget))
                                        (do
                                          (when (and
                                                  (not
                                                    (.-isSpeculative
                                                      (.-attributionMode
                                                        (cast AttrContext (.-info env)))))
                                                  (identical?
                                                    (.getMode that)
                                                    MemberReferenceTree$ReferenceMode/NEW))
                                            (.checkNewInnerClass
                                              this
                                              (.pos that)
                                              env
                                              exprType
                                              false))
                                          (when (identical?
                                                  (.-mode
                                                    (.deferredAttrContext
                                                      (.-checkContext resultInfo)))
                                                  DeferredAttr$AttrMode/CHECK)
                                            (when (and
                                                    (and
                                                      (and
                                                        (identical?
                                                          (.getMode that)
                                                          MemberReferenceTree$ReferenceMode/INVOKE)
                                                        (TreeInfo/isStaticSelector
                                                          (.-expr that)
                                                          names))
                                                      (.isUnbound (.-kind that)))
                                                    (.isRaw (.-site lookupHelper)))
                                              (.checkRaw chk (.-expr that) localEnv))
                                            (when (and
                                                    (and
                                                      (.isStatic (.-sym that))
                                                      (TreeInfo/isStaticSelector
                                                        (.-expr that)
                                                        names))
                                                    (.nonEmpty (.getTypeArguments exprType)))
                                              (.error
                                                log
                                                (.pos (.-expr that))
                                                (CompilerProperties$Errors/InvalidMref
                                                  (Kinds/kindName (.getMode that))
                                                  CompilerProperties$Fragments/StaticMrefWithTargs))
                                              (set!
                                                result
                                                (set!
                                                  (.-type that)
                                                  (.createErrorType types currentTarget)))
                                              (return))
                                            (when (and
                                                    (not (.isStatic refSym))
                                                    (identical?
                                                      (.-kind that)
                                                      JCTree$JCMemberReference$ReferenceKind/SUPER))
                                              (.checkNonAbstract rs (.pos that) (.-sym that)))
                                            (when isTargetSerializable
                                              (.checkAccessFromSerializableElement chk that true)))
                                          (let [checkInfo (.dup
                                                            resultInfo
                                                            (.newMethodTemplate
                                                              this
                                                              ^Type (if (.hasTag
                                                                          (.getReturnType desc)
                                                                          TypeTag/VOID)
                                                                        Type/noType
                                                                        (.getReturnType desc))
                                                              ^List (if (.isUnbound (.-kind that))
                                                                        (.-tail argtypes)
                                                                        argtypes)
                                                              typeargtypes)
                                                            (FunctionalReturnContext.
                                                              (.-checkContext resultInfo))
                                                            CheckMode/NO_TREE_UPDATE)
                                                ^:mutable refType (.checkId
                                                                    this
                                                                    that
                                                                    (.-site lookupHelper)
                                                                    refSym
                                                                    localEnv
                                                                    checkInfo)]
                                            (when (and
                                                    (.isUnbound (.-kind that))
                                                    (.free
                                                      (.inferenceContext
                                                        (.-checkContext resultInfo))
                                                      (cast Type (.-head argtypes))))
                                              (when-not (.isSubtype
                                                          types
                                                          (.asUndetVar
                                                            (.inferenceContext
                                                              (.-checkContext resultInfo))
                                                            (cast Type (.-head argtypes)))
                                                          exprType)
                                                (Assert/error "Can't get here")))
                                            (when-not (.isErroneous refType)
                                              (set!
                                                refType
                                                (.createMethodTypeWithReturn
                                                  types
                                                  refType
                                                  (.adjustMethodReturnType
                                                    this
                                                    refSym
                                                    (.-site lookupHelper)
                                                    (.-name that)
                                                    (.getParameterTypes (.-pt checkInfo))
                                                    (.getReturnType refType)))))
                                            (let [isSpeculativeRound (identical?
                                                                       (.-mode
                                                                         (.deferredAttrContext
                                                                           (.-checkContext
                                                                             resultInfo)))
                                                                       DeferredAttr$AttrMode/SPECULATIVE)]
                                              (set! (.-type that) currentTarget)
                                              (.checkReferenceCompatible
                                                this
                                                that
                                                desc
                                                refType
                                                (.-checkContext resultInfo)
                                                isSpeculativeRound)
                                              (when-not isSpeculativeRound
                                                (.checkAccessibleTypes
                                                  this
                                                  that
                                                  localEnv
                                                  (.inferenceContext (.-checkContext resultInfo))
                                                  (new Type/1 [desc currentTarget])))
                                              (.checkRequiresIdentity
                                                chk
                                                that
                                                (.-lint (cast AttrContext (.-info localEnv))))
                                              (set!
                                                result
                                                (.check
                                                  this
                                                  that
                                                  currentTarget
                                                  Kinds$KindSelector/VAL
                                                  resultInfo))))))))))))))))
            (catch Types$FunctionDescriptorLookupError ex
              (let [cause (.getDiagnostic ex)]
                (.report (.-checkContext resultInfo) that cause)
                (set! result (set! (.-type that) (.createErrorType types (.pt this))))))))))

  (method memberReferenceQualifierResult ^ResultInfo [this ^JCTree$JCMemberReference tree]
    (ResultInfo. ^Kinds$KindSelector (if (identical?
                                           (.getMode tree)
                                           MemberReferenceTree$ReferenceMode/INVOKE)
                                         Kinds$KindSelector/VAL_TYP
                                         Kinds$KindSelector/TYP)
                 Type/noType))

  (method checkReferenceCompatible ^void [this ^JCTree$JCMemberReference tree ^Type descriptor
                                          ^Type refType ^Check$CheckContext checkContext
                                          ^boolean speculativeAttr]
    (let [inferenceContext (.inferenceContext checkContext)
          returnType (.asUndetVar inferenceContext (.getReturnType descriptor))
          ^:mutable ^Type resType nil]
      (switch (.getMode tree)
        NEW
          (if (not (.isRaw (.-type (.-expr tree))))
              (set! resType (.-type (.-expr tree)))
              (set! resType (.getReturnType refType)))
        (set! resType (.getReturnType refType)))
      (let [^:mutable incompatibleReturnType resType]
        (when (.hasTag returnType TypeTag/VOID) (set! incompatibleReturnType nil))
        (when (and (not (.hasTag returnType TypeTag/VOID)) (not (.hasTag resType TypeTag/VOID)))
          (let [^Type capturedResType (if captureMRefReturnType (.capture types resType) resType)]
            (when (or (.isErroneous resType)
                      (.compatible (FunctionalReturnContext. checkContext)
                                   capturedResType
                                   returnType
                                   (.checkWarner checkContext tree capturedResType returnType)))
              (set! incompatibleReturnType nil))))
        (cond
          (some? incompatibleReturnType)
            (let [msg (CompilerProperties$Fragments/IncompatibleRetTypeInMref
                        (CompilerProperties$Fragments/InconvertibleTypes
                          resType
                          (.getReturnType descriptor)))]
              (.report checkContext tree (.fragment diags msg)))
          (.free inferenceContext refType)
            (.addFreeTypeListener
              inferenceContext
              (List/of refType)
              (lambda Infer$FreeTypeListener ^void [^InferenceContext instantiatedContext]
                (set! (.-referentType tree) (.asInstType instantiatedContext refType))))
          :else (set! (.-referentType tree) refType))
        (when-not speculativeAttr
          (when-not (.checkExConstraints this
                                         (.getThrownTypes refType)
                                         (.getThrownTypes descriptor)
                                         inferenceContext)
            (.error log
                    tree
                    (CompilerProperties$Errors/IncompatibleThrownTypesInMref
                      (.getThrownTypes refType))))))))

  (method checkExConstraints ^boolean [this ^{:tag (List Type)} thrownByFuncExpr
                                       ^{:tag (List Type)} thrownAtFuncType
                                       ^InferenceContext inferenceContext]
    (let [^{:tag (List Type)} nonProperList (cast
                                              List
                                              (.collect
                                                (.filter
                                                  (.stream thrownAtFuncType)
                                                  (lambda Predicate ^boolean [^Type e]
                                                    (.free inferenceContext e)))
                                                (List/collector)))
          ^{:tag (List Type)} properList (.diff thrownAtFuncType nonProperList)
          ^{:tag (List Type)} checkedList (cast List
                                                (.collect
                                                  (.filter
                                                    (.stream thrownByFuncExpr)
                                                    (lambda Predicate ^boolean [^Type e]
                                                      (.isChecked chk e)))
                                                  (List/collector)))
          ^{:tag (ListBuffer Type)} uncaughtByProperTypes (ListBuffer.)]
      (for-each [^Type checked checkedList]
        (let [^:mutable isSubtype false]
          (for-each [^Type proper properList]
            (when (.isSubtype types checked proper) (set! isSubtype true) (break)))
          (when-not isSubtype (.add uncaughtByProperTypes checked))))
      (if (and (.isEmpty nonProperList) (not (.isEmpty uncaughtByProperTypes)))
          false
          (let [^{:tag (List Type)} nonProperAsUndet (.asUndetVars inferenceContext nonProperList)]
            (.forEach uncaughtByProperTypes
                      (lambda Consumer ^void [^Type checkedEx]
                        (.forEach nonProperAsUndet
                                  (lambda Consumer ^void [^Type nonProper]
                                    (.isSubtype types checkedEx nonProper)))))
            (.forEach (.filter (.stream nonProperAsUndet)
                               (lambda Predicate ^boolean [^Type t] (.hasTag t TypeTag/UNDETVAR)))
                      (lambda Consumer ^void [^Type t] (.setThrow (cast Type$UndetVar t))))
            true))))

  (method ^:private setFunctionalInfo ^void [this ^:final ^{:tag (Env AttrContext)} env
                                             ^:final ^JCTree$JCFunctionalExpression fExpr
                                             ^:final ^Type pt ^:final ^Type descriptorType
                                             ^:final ^Type primaryTarget
                                             ^:final ^Check$CheckContext checkContext]
    (if (.free (.inferenceContext checkContext) descriptorType)
        (.addFreeTypeListener
          (.inferenceContext checkContext)
          (List/of pt descriptorType)
          (lambda Infer$FreeTypeListener ^void [^InferenceContext inferenceContext]
            (.setFunctionalInfo this
                                env
                                fExpr
                                pt
                                (.asInstType inferenceContext descriptorType)
                                (.asInstType inferenceContext primaryTarget)
                                checkContext)))
        (do
          (set! (.-owner fExpr) (.-owner (.-scope (cast AttrContext (.-info env)))))
          (when (.hasTag pt TypeTag/CLASS) (set! (.-target fExpr) primaryTarget))
          (when (and (identical? (.-mode (.deferredAttrContext checkContext))
                                 DeferredAttr$AttrMode/CHECK)
                     (not (identical? pt Type/recoveryType)))
            (try
              (let [csym (.makeFunctionalInterfaceClass
                           types
                           env
                           (.-empty names)
                           (.-target fExpr)
                           Flags/ABSTRACT)]
                (when (some? csym)
                  (.checkImplementations chk (.-tree env) csym csym)
                  (try
                    (set! (.-flags_field csym) (bit-or (.-flags_field csym) Flags/INTERFACE))
                    (.findDescriptorType types (.-type csym))
                    (catch Types$FunctionDescriptorLookupError err
                      (.report (.-checkContext resultInfo)
                               fExpr
                               (.fragment diags
                                          (CompilerProperties$Fragments/NoSuitableFunctionalIntfInst
                                            (.-target fExpr))))))))
              (catch Types$FunctionDescriptorLookupError ex
                (let [cause (.getDiagnostic ex)]
                  (.report (.-checkContext resultInfo) (.-tree env) cause))))))))

  (method ^:public visitParens ^void [this ^JCTree$JCParens tree]
    (let [owntype (.attribTree this (.-expr tree) env resultInfo)]
      (set! result (.check this tree owntype (.pkind this) resultInfo))
      (let [sym (TreeInfo/symbol tree)]
        (when (and (and (some? sym) (.matches (.-kind sym) Kinds$KindSelector/TYP_PCK))
                   (not (identical? (.-kind sym) Kinds$Kind/ERR)))
          (.error log (.pos tree) CompilerProperties$Errors/IllegalParenthesizedExpression)))))

  (method ^:public visitAssign ^void [this ^JCTree$JCAssign tree]
    (let [owntype (.attribTree this (.-lhs tree) (.dup env tree) varAssignmentInfo)
          capturedType (.capture this owntype)]
      (.attribExpr this (.-rhs tree) env owntype)
      (set! result (.check this tree capturedType Kinds$KindSelector/VAL resultInfo))))

  (method ^:public visitAssignop ^void [this ^JCTree$JCAssignOp tree]
    (let [owntype (.attribTree this (.-lhs tree) env varAssignmentInfo)
          operand (.attribExpr this (.-rhs tree) env)
          ^Symbol operator (set! (.-operator tree)
                                 (.resolveBinary
                                   operators
                                   tree
                                   (.noAssignOp (.getTag tree))
                                   owntype
                                   operand))]
      (when (and (and (not (identical? operator (.-noOpSymbol operators)))
                      (not (.isErroneous owntype)))
                 (not (.isErroneous operand)))
        (.checkDivZero chk (.pos (.-rhs tree)) operator operand)
        (.checkCastable chk (.pos (.-rhs tree)) (.getReturnType (.-type operator)) owntype)
        (.checkLossOfPrecision chk (.pos (.-rhs tree)) operand owntype)
        (.checkOutOfRangeShift chk (.pos (.-rhs tree)) operator operand))
      (set! result (.check this tree owntype Kinds$KindSelector/VAL resultInfo))))

  (method ^:public visitUnary ^void [this ^JCTree$JCUnary tree]
    (let [^Type argtype (if (.isIncOrDecUnaryOp (.getTag tree))
                            (.attribTree this (.-arg tree) env varAssignmentInfo)
                            (.checkNonVoid chk
                                           (.pos (.-arg tree))
                                           (.attribExpr this (.-arg tree) env)))
          operator (set! (.-operator tree) (.resolveUnary operators tree (.getTag tree) argtype))
          ^:mutable owntype (.createErrorType types (.-type tree))]
      (when (and (not (identical? operator (.-noOpSymbol operators))) (not (.isErroneous argtype)))
        (set! owntype
              (if (.isIncOrDecUnaryOp (.getTag tree))
                  (.-type (.-arg tree))
                  (.getReturnType (.-type operator))))
        (let [opc (.-opcode operator)]
          (when (some? (.constValue argtype))
            (let [ctype (.fold1 cfolder opc argtype)]
              (when (some? ctype) (set! owntype (.coerce cfolder ctype owntype)))))))
      (set! result (.check this tree owntype Kinds$KindSelector/VAL resultInfo))
      (set! matchBindings (.unary matchBindingsComputer tree matchBindings))))

  (method ^:public visitBinary ^void [this ^JCTree$JCBinary tree]
    (let [left (.checkNonVoid chk (.pos (.-lhs tree)) (.attribExpr this (.-lhs tree) env))
          lhsBindings matchBindings
          ^:mutable ^{:tag (List Symbol$BindingSymbol)} propagatedBindings nil]
      (switch (.getTag tree)
        AND (set! propagatedBindings (.-bindingsWhenTrue lhsBindings))
        OR (set! propagatedBindings (.-bindingsWhenFalse lhsBindings))
        (set! propagatedBindings (List/nil)))
      (let [^{:tag (Env AttrContext)} rhsEnv (.bindingEnv this env propagatedBindings)
            ^:mutable ^Type right nil]
        (try
          (set! right
                (.checkNonVoid chk (.pos (.-rhs tree)) (.attribExpr this (.-rhs tree) rhsEnv)))
          (finally (.leave (.-scope (cast AttrContext (.-info rhsEnv))))))
        (set! matchBindings (.binary matchBindingsComputer tree lhsBindings matchBindings))
        (let [operator (set! (.-operator tree)
                             (.resolveBinary operators tree (.getTag tree) left right))
              ^:mutable owntype (.createErrorType types (.-type tree))]
          (when (and (and (not (identical? operator (.-noOpSymbol operators)))
                          (not (.isErroneous left)))
                     (not (.isErroneous right)))
            (set! owntype (.getReturnType (.-type operator)))
            (let [opc (.-opcode operator)]
              (when (and (some? (.constValue left)) (some? (.constValue right)))
                (let [ctype (.fold2 cfolder opc left right)]
                  (when (some? ctype) (set! owntype (.coerce cfolder ctype owntype)))))
              (when (or (== opc ByteCodes/if_acmpeq) (== opc ByteCodes/if_acmpne))
                (when-not (.isCastable types left right (Warner. (.pos tree)))
                  (.error log (.pos tree) (CompilerProperties$Errors/IncomparableTypes left right))))
              (.checkDivZero chk (.pos (.-rhs tree)) operator right)
              (.checkOutOfRangeShift chk (.pos (.-rhs tree)) operator right)))
          (set! result (.check this tree owntype Kinds$KindSelector/VAL resultInfo))))))

  (method ^:public visitTypeCast ^void [this ^:final ^JCTree$JCTypeCast tree]
    (let [clazztype (.attribType this (.-clazz tree) env)]
      (.validate chk (.-clazz tree) env false)
      (.checkRequiresIdentity chk tree (.-lint (cast AttrContext (.-info env))))
      (let [^{:tag (Env AttrContext)} localEnv (.dup env tree)
            ^:mutable ^ResultInfo castInfo nil
            expr (TreeInfo/skipParens (.-expr tree))
            isPoly (or (.hasTag expr JCTree$Tag/LAMBDA) (.hasTag expr JCTree$Tag/REFERENCE))]
        (if isPoly
            (set! castInfo
                  (ResultInfo. Kinds$KindSelector/VAL
                               clazztype
                               (anon Check$NestedCheckContext [(.-checkContext resultInfo)]
                                 (method ^:public compatible ^boolean [this ^Type found ^Type req
                                                                       ^Warner warn]
                                   (.isCastable types found req warn)))))
            (set! castInfo unknownExprInfo))
        (let [exprtype (.attribTree this (.-expr tree) localEnv castInfo)
              ^:mutable ^Type owntype (if isPoly
                                          clazztype
                                          (.checkCastable
                                            chk
                                            (.pos (.-expr tree))
                                            exprtype
                                            clazztype))]
          (when (some? (.constValue exprtype)) (set! owntype (.coerce cfolder exprtype owntype)))
          (set! result (.check this tree (.capture this owntype) Kinds$KindSelector/VAL resultInfo))
          (when-not isPoly (.checkRedundantCast chk localEnv tree))))))

  (method ^:public visitTypeTest ^void [this ^JCTree$JCInstanceOf tree]
    (let [^:mutable exprtype (.attribExpr this (.-expr tree) env)]
      (if (.isPrimitive exprtype)
          (.checkSourceLevel preview (.pos (.-expr tree)) Source$Feature/PRIMITIVE_PATTERNS)
          (set! exprtype (.checkNullOrRefType chk (.pos (.-expr tree)) exprtype)))
      (let [^:mutable ^Type clazztype nil
            ^:mutable ^JCTree typeTree nil]
        (if (or (identical? (.getTag (.-pattern tree)) JCTree$Tag/BINDINGPATTERN)
                (identical? (.getTag (.-pattern tree)) JCTree$Tag/RECORDPATTERN))
            (do
              (.attribExpr this (.-pattern tree) env exprtype)
              (set! clazztype (.-type (.-pattern tree)))
              (when (and (and (and (.isSubtype types exprtype clazztype)
                                   (not (.isErroneous exprtype)))
                              (not (.isErroneous clazztype)))
                         (not (identical? (.getTag (.-pattern tree)) JCTree$Tag/RECORDPATTERN)))
                (when-not allowUnconditionalPatternsInstanceOf
                  (.error log
                          (.pos tree)
                          (.error Source$Feature/UNCONDITIONAL_PATTERN_IN_INSTANCEOF
                                  (.-sourceName this)))))
              (set! typeTree
                    (TreeInfo/primaryPatternTypeTree (cast JCTree$JCPattern (.-pattern tree)))))
            (do
              (set! clazztype (.attribType this (.-pattern tree) env))
              (set! typeTree (.-pattern tree))
              (.validate chk typeTree env false)))
        (if (.isPrimitive clazztype)
            (.checkSourceLevel preview (.pos (.-pattern tree)) Source$Feature/PRIMITIVE_PATTERNS)
            (do
              (when-not (.hasTag clazztype TypeTag/TYPEVAR)
                (set! clazztype (.checkClassOrArrayType chk (.pos typeTree) clazztype)))
              (when (and (not (.isErroneous clazztype)) (not (.isReifiable types clazztype)))
                (let [^:mutable valid false]
                  (if allowReifiableTypesInInstanceof
                      (set! valid
                            (.checkCastablePattern this (.pos (.-expr tree)) exprtype clazztype))
                      (do
                        (.error log
                                (.pos tree)
                                (.error Source$Feature/REIFIABLE_TYPES_INSTANCEOF
                                        (.-sourceName this)))
                        (set! allowReifiableTypesInInstanceof true)))
                  (when-not valid (set! clazztype (.createErrorType types clazztype)))))))
        (.checkCastable chk (.pos (.-expr tree)) exprtype clazztype)
        (set! result (.check this tree (.-booleanType syms) Kinds$KindSelector/VAL resultInfo)))))

  (method ^:private checkCastablePattern ^boolean [this ^JCDiagnostic$DiagnosticPosition pos
                                                   ^Type exprType ^Type pattType]
    (let [warner (Warner.)]
      (cond
        (or (.isErroneous exprType) (.isErroneous pattType)) false
        (not (.isCastable types exprType pattType warner))
          (do
            (.report
              (.-basicHandler chk)
              pos
              (.fragment diags (CompilerProperties$Fragments/InconvertibleTypes exprType pattType)))
            false)
        (and (or (.isPrimitive exprType) (.isPrimitive pattType))
             (or (or (not (.isPrimitive exprType)) (not (.isPrimitive pattType)))
                 (not (.isSameType types exprType pattType))))
          (do (.checkSourceLevel preview pos Source$Feature/PRIMITIVE_PATTERNS) true)
        (.hasLint warner Lint$LintCategory/UNCHECKED)
          (do
            (.error log
                    pos
                    (CompilerProperties$Errors/InstanceofReifiableNotSafe exprType pattType))
            false)
        :else true)))

  (method ^:public visitAnyPattern ^void [this ^JCTree$JCAnyPattern tree]
    (set! result (set! (.-type tree) (.-pt resultInfo))))

  (method ^:public visitBindingPattern ^void [this ^JCTree$JCBindingPattern tree]
    (let [^Type type (if (some? (.-vartype (.-var tree)))
                         (.attribType this (.-vartype (.-var tree)) env)
                         (.-pt resultInfo))]
      (set! (.-type tree) (set! (.-type (.-var tree)) type))
      (let [v (Symbol$BindingSymbol. (.-flags (.-mods (.-var tree)))
                                     (.-name (.-var tree))
                                     type
                                     (.-owner (.-scope (cast AttrContext (.-info env)))))]
        (set! (.-pos v) (.-pos tree))
        (set! (.-sym (.-var tree)) v)
        (when (.checkUnique chk (.pos (.-var tree)) v (.-scope (cast AttrContext (.-info env))))
          (.checkTransparentVar chk (.pos (.-var tree)) v (.-scope (cast AttrContext (.-info env)))))
        (.validate chk (.-vartype (.-var tree)) env true)
        (when (.isImplicitlyTyped (.-var tree))
          (.setSyntheticVariableType this
                                     (.-var tree)
                                     ^Type (if (identical? type Type/noType) (.-errType syms) type)))
        (.annotateLater annotate (.-annotations (.-mods (.-var tree))) env v)
        (when-not (.isImplicitlyTyped (.-var tree))
          (.queueScanTreeAndTypeAnnotate annotate (.-vartype (.-var tree)) env v))
        (.flush annotate)
        (set! result (.-type tree))
        (if (.isUnnamedVariable v)
            (set! matchBindings MatchBindingsComputer/EMPTY)
            (set! matchBindings (MatchBindingsComputer$MatchBindings. (List/of v) (List/nil))))
        (.checkRequiresIdentity chk tree (.-lint (cast AttrContext (.-info env)))))))

  (method ^:public visitRecordPattern ^void [this ^JCTree$JCRecordPattern tree]
    (let [^:mutable ^Type site nil]
      (if (nil? (.-deconstructor tree))
          (do
            (.error log (.pos tree) CompilerProperties$Errors/DeconstructionPatternVarNotAllowed)
            (set! (.-record tree) (.-errSymbol syms))
            (set! site (set! (.-type tree) (.createErrorType types (.-type (.-record tree))))))
          (let [^:mutable type (.attribType this (.-deconstructor tree) env)]
            (when (and (.isRaw type) (.nonEmpty (.getTypeParameters (.-tsym type))))
              (let [inferred (.instantiatePatternType infer (.-pt resultInfo) (.-tsym type))]
                (if (nil? inferred)
                    (.error log (.pos tree) CompilerProperties$Errors/PatternTypeCannotInfer)
                    (set! type inferred))))
            (set! (.-type tree) (set! (.-type (.-deconstructor tree)) type))
            (set! site (.capture types (.-type tree)))))
      (let [^:mutable ^{:tag (List Type)} expectedRecordTypes nil]
        (if (and (identical? (.-kind (.-tsym site)) Kinds$Kind/TYP)
                 (.isRecord (cast Symbol$ClassSymbol (.-tsym site))))
            (let [record (cast Symbol$ClassSymbol (.-tsym site))]
              (set! expectedRecordTypes
                    (cast List
                          (.collect (.map (.map
                                            (.stream (.getRecordComponents record))
                                            (let [site site]
                                              (lambda Function ^Type [^Symbol$RecordComponent rc]
                                                (.memberType types site rc))))
                                          (lambda Function ^Type [^Type t]
                                            (.baseType (.upward types t (.captures types t)))))
                                    (List/collector))))
              (set! (.-record tree) record))
            (do
              (.error log
                      (.pos tree)
                      (CompilerProperties$Errors/DeconstructionPatternOnlyRecords (.-tsym site)))
              (set! expectedRecordTypes
                    (cast List
                          (.collect (.limit (Stream/generate
                                              (lambda Supplier ^Type []
                                                (.createErrorType types (.-type tree))))
                                            (.size (.-nested tree)))
                                    (List/collector))))
              (set! (.-record tree) (.-errSymbol syms))))
        (let [^{:tag (ListBuffer Symbol$BindingSymbol)} outBindings (ListBuffer.)
              ^:mutable ^{:tag (List Type)} recordTypes expectedRecordTypes
              ^:mutable ^{:tag (List JCTree$JCPattern)} nestedPatterns (.-nested tree)
              ^{:tag (Env AttrContext)} localEnv (.dup
                                                   env
                                                   tree
                                                   (.dup
                                                     (cast AttrContext (.-info env))
                                                     (.dup
                                                       (.-scope (cast AttrContext (.-info env))))))]
          (try
            (while (and (.nonEmpty recordTypes) (.nonEmpty nestedPatterns))
              (.attribExpr this
                           (cast JCTree (.-head nestedPatterns))
                           localEnv
                           (cast Type (.-head recordTypes)))
              (.checkCastablePattern this
                                     (.pos (cast JCTree$JCPattern (.-head nestedPatterns)))
                                     (cast Type (.-head recordTypes))
                                     (.-type (cast JCTree$JCPattern (.-head nestedPatterns))))
              (.addAll outBindings (.-bindingsWhenTrue matchBindings))
              (.forEach (.-bindingsWhenTrue matchBindings)
                        (method-ref Consumer
                                    [Symbol$BindingSymbol]
                                    (.-scope (cast AttrContext (.-info localEnv)))
                                    Scope$WriteableScope/.enter))
              (set! nestedPatterns (.-tail nestedPatterns))
              (set! recordTypes (.-tail recordTypes)))
            (when (or (.nonEmpty recordTypes) (.nonEmpty nestedPatterns))
              (while (.nonEmpty nestedPatterns)
                (.attribExpr this (cast JCTree (.-head nestedPatterns)) localEnv Type/noType)
                (set! nestedPatterns (.-tail nestedPatterns)))
              (let [^{:tag (List Type)} nestedTypes (cast
                                                      List
                                                      (.collect
                                                        (.map
                                                          (.stream (.-nested tree))
                                                          (lambda Function ^Type [^JCTree$JCPattern p]
                                                            (.-type p)))
                                                        (List/collector)))]
                (.error log
                        (.pos tree)
                        (CompilerProperties$Errors/IncorrectNumberOfNestedPatterns
                          expectedRecordTypes
                          nestedTypes))))
            (finally (.leave (.-scope (cast AttrContext (.-info localEnv))))))
          (.validate chk (.-deconstructor tree) env true)
          (set! result (.-type tree))
          (set! matchBindings
                (MatchBindingsComputer$MatchBindings. (.toList outBindings) (List/nil)))))))

  (method ^:public visitIndexed ^void [this ^JCTree$JCArrayAccess tree]
    (let [^:mutable owntype (.createErrorType types (.-type tree))
          atype (.attribExpr this (.-indexed tree) env)]
      (.attribExpr this (.-index tree) env (.-intType syms))
      (if (.isArray types atype)
          (set! owntype (.elemtype types atype))
          (when-not (.hasTag atype TypeTag/ERROR)
            (.error log (.pos tree) (CompilerProperties$Errors/ArrayReqButFound atype))))
      (when-not (.contains (.pkind this) Kinds$KindSelector/VAL)
        (set! owntype (.capture this owntype)))
      (set! result (.check this tree owntype Kinds$KindSelector/VAR resultInfo))))

  (method ^:public visitIdent ^void [this ^JCTree$JCIdent tree]
    (let [^:mutable ^Symbol sym nil]
      (cond
        (or (.hasTag (.pt this) TypeTag/METHOD) (.hasTag (.pt this) TypeTag/FORALL))
          (do
            (set! (.-pendingResolutionPhase (cast AttrContext (.-info env))) nil)
            (set! sym
                  (.resolveMethod rs
                                  (.pos tree)
                                  env
                                  (.-name tree)
                                  (.getParameterTypes (.pt this))
                                  (.getTypeArguments (.pt this)))))
        (and (some? (.-sym tree)) (not (identical? (.-kind (.-sym tree)) Kinds$Kind/VAR)))
          (set! sym (.-sym tree))
        :else (set! sym (.resolveIdent rs (.pos tree) env (.-name tree) (.pkind this))))
      (set! (.-sym tree) sym)
      (let [^:mutable ^{:tag (Env AttrContext)} symEnv env]
        (when (and (and (and (and (not (identical?
                                         (.-kind (.-owner (.-sym (.-enclClass env))))
                                         Kinds$Kind/PCK))
                                  (.matches (.-kind sym) Kinds$KindSelector/VAL_MTH))
                             (identical? (.-kind (.-owner sym)) Kinds$Kind/TYP))
                        (not (identical? (.-name tree) (.-_this names))))
                   (not (identical? (.-name tree) (.-_super names))))
          (while (and (some? (.-outer symEnv))
                      (not (.isMemberOf sym (.-sym (.-enclClass symEnv)) types)))
            (set! symEnv (.-outer symEnv))))
        (when (identical? (.-kind sym) Kinds$Kind/VAR)
          (let [v (cast Symbol$VarSymbol sym)]
            (.checkInit this tree env v false)
            (when (.subset Kinds$KindSelector/ASG (.pkind this))
              (.checkAssignable this (.pos tree) v nil env))))
        (let [^:mutable ^{:tag (Env AttrContext)} env1 env]
          (when (and (and (and (not (identical? (.-kind sym) Kinds$Kind/ERR))
                               (not (identical? (.-kind sym) Kinds$Kind/TYP)))
                          (some? (.-owner sym)))
                     (not (identical? (.-owner sym) (.-sym (.-enclClass env1)))))
            (while (and (some? (.-outer env1))
                        (not (.isAccessible rs env (.-type (.-sym (.-enclClass env1))) sym)))
              (set! env1 (.-outer env1))))
          (when (.-isSerializable (cast AttrContext (.-info env)))
            (.checkAccessFromSerializableElement
              chk
              tree
              (.-isSerializableLambda (cast AttrContext (.-info env)))))
          (set! result (.checkId this tree (.-type (.-sym (.-enclClass env1))) sym env resultInfo))))))

  (method ^:public visitSelect ^void [this ^JCTree$JCFieldAccess tree]
    (let [^:mutable skind Kinds$KindSelector/NIL]
      (if (or (or (identical? (.-name tree) (.-_this names))
                  (identical? (.-name tree) (.-_super names)))
              (identical? (.-name tree) (.-_class names)))
          (set! skind Kinds$KindSelector/TYP)
          (do
            (when (.contains (.pkind this) Kinds$KindSelector/PCK)
              (set! skind (Kinds$KindSelector/of skind Kinds$KindSelector/PCK)))
            (when (.contains (.pkind this) Kinds$KindSelector/TYP)
              (set! skind
                    (Kinds$KindSelector/of skind Kinds$KindSelector/TYP Kinds$KindSelector/PCK)))
            (when (.contains (.pkind this) Kinds$KindSelector/VAL_MTH)
              (set! skind
                    (Kinds$KindSelector/of skind Kinds$KindSelector/VAL Kinds$KindSelector/TYP)))))
      (let [^:mutable site (.attribTree this (.-selected tree) env (ResultInfo. skind Type/noType))]
        (when-not (.contains (.pkind this) Kinds$KindSelector/TYP_PCK)
          (set! site (.capture this site)))
        (when (identical? skind Kinds$KindSelector/TYP)
          (let [^:mutable elt site]
            (while (.hasTag elt TypeTag/ARRAY) (set! elt (.-elemtype (cast Type$ArrayType elt))))
            (when (.hasTag elt TypeTag/TYPEVAR)
              (.error log (.pos tree) CompilerProperties$Errors/TypeVarCantBeDeref)
              (set! result
                    (set! (.-type tree) (.createErrorType types (.-name tree) (.-tsym site) site)))
              (set! (.-sym tree) (.-tsym (.-type tree)))
              (return))))
        (let [sitesym (TreeInfo/symbol (.-selected tree))
              selectSuperPrev (.-selectSuper (cast AttrContext (.-info env)))]
          (set! (.-selectSuper (cast AttrContext (.-info env)))
                (and (some? sitesym) (identical? (.-name sitesym) (.-_super names))))
          (set! (.-pendingResolutionPhase (cast AttrContext (.-info env))) nil)
          (let [^:mutable sym (.selectSym this tree sitesym site env resultInfo)]
            (when (and (and (identical? (.-kind sym) Kinds$Kind/VAR)
                            (not (identical? (.-name sym) (.-_super names))))
                       (some? (.-defaultSuperCallSite (cast AttrContext (.-info env)))))
              (.error log
                      (.pos (.-selected tree))
                      (CompilerProperties$Errors/NotEnclClass (.-tsym site)))
              (set! sym (.-errSymbol syms)))
            (when (and (and (.exists sym) (not (Attr/isType sym)))
                       (.contains (.pkind this) Kinds$KindSelector/TYP_PCK))
              (set! site (.capture this site))
              (set! sym (.selectSym this tree sitesym site env resultInfo)))
            (let [varArgs (.lastResolveVarargs (cast AttrContext (.-info env)))]
              (set! (.-sym tree) sym)
              (when (and (and (.hasTag site TypeTag/TYPEVAR) (not (Attr/isType sym)))
                         (not (identical? (.-kind sym) Kinds$Kind/ERR)))
                (set! site (.skipTypeVars types site true)))
              (when (identical? (.-kind sym) Kinds$Kind/VAR)
                (let [v (cast Symbol$VarSymbol sym)]
                  (.checkInit this tree env v true)
                  (when (.subset Kinds$KindSelector/ASG (.pkind this))
                    (.checkAssignable this (.pos tree) v (.-selected tree) env))))
              (when (and (and (and (and (and (some? sitesym)
                                             (identical? (.-kind sitesym) Kinds$Kind/VAR))
                                        (.isResourceVariable (cast Symbol$VarSymbol sitesym)))
                                   (identical? (.-kind sym) Kinds$Kind/MTH))
                              (.equals (.-name sym) (.-close names)))
                         (.overrides sym
                                     (.-autoCloseableClose syms)
                                     (.-tsym (.-type sitesym))
                                     types
                                     true))
                (.warning log tree CompilerProperties$LintWarnings/TryExplicitCloseCall))
              (when (and (Attr/isType sym)
                         (or (nil? sitesym)
                             (not (.matches (.-kind sitesym) Kinds$KindSelector/TYP_PCK))))
                (set! (.-type tree)
                      (.check this
                              (.-selected tree)
                              (.pt this)
                              ^Kinds$KindSelector (if (nil? sitesym)
                                                      Kinds$KindSelector/VAL
                                                      (.toSelector (.-kind sitesym)))
                              (ResultInfo. Kinds$KindSelector/TYP_PCK (.pt this)))))
              (cond
                (Attr/isType sitesym)
                  (when (and (not (identical? (.-name sym) (.-_this names)))
                             (not (identical? (.-name sym) (.-_super names))))
                    (when (and (and (== (bit-and (.flags sym) Flags/STATIC) 0)
                                    (not (identical? (.-name sym) (.-_super names))))
                               (or (identical? (.-kind sym) Kinds$Kind/VAR)
                                   (identical? (.-kind sym) Kinds$Kind/MTH)))
                      (.accessBase rs
                                   (.new rs Resolve$StaticError sym)
                                   (.pos tree)
                                   site
                                   (.-name sym)
                                   true)))
                (and (and (not (identical? (.-kind sym) Kinds$Kind/ERR))
                          (not (== (bit-and (.flags sym) Flags/STATIC) 0)))
                     (not (identical? (.-name sym) (.-_class names))))
                  (if (not (.isAnonymous (.-owner sym)))
                      (.warning log
                                tree
                                (CompilerProperties$LintWarnings/StaticNotQualifiedByType
                                  (.kindName (.-kind sym))
                                  (.-owner sym)))
                      (.warning log
                                tree
                                (CompilerProperties$LintWarnings/StaticNotQualifiedByType2
                                  (.kindName (.-kind sym))))))
              (when (and (.-selectSuper (cast AttrContext (.-info env)))
                         (== (bit-and (.flags sym) Flags/STATIC) 0))
                (.checkNonAbstract rs (.pos tree) sym)
                (when (.isRaw site)
                  (let [site1 (.asSuper types (.-type (.-sym (.-enclClass env))) (.-tsym site))]
                    (when (some? site1) (set! site site1)))))
              (when (.-isSerializable (cast AttrContext (.-info env)))
                (.checkAccessFromSerializableElement
                  chk
                  tree
                  (.-isSerializableLambda (cast AttrContext (.-info env)))))
              (set! (.-selectSuper (cast AttrContext (.-info env))) selectSuperPrev)
              (set! result (.checkId this tree site sym env resultInfo))))))))

  (method ^:private selectSym ^Symbol [this ^JCTree$JCFieldAccess tree ^Symbol location ^Type site
                                       ^{:tag (Env AttrContext)} env ^ResultInfo resultInfo]
    (let [pos (.pos tree)
          name (.-name tree)]
      (switch (.getTag site)
        PACKAGE
          (.accessBase rs
                       (.findIdentInPackage rs pos env (.-tsym site) name (.-pkind resultInfo))
                       pos
                       location
                       site
                       name
                       true)
        (ARRAY CLASS)
          (cond
            (or (.hasTag (.-pt resultInfo) TypeTag/METHOD)
                (.hasTag (.-pt resultInfo) TypeTag/FORALL))
              (.resolveQualifiedMethod rs
                                       pos
                                       env
                                       location
                                       site
                                       name
                                       (.getParameterTypes (.-pt resultInfo))
                                       (.getTypeArguments (.-pt resultInfo)))
            (or (identical? name (.-_this names)) (identical? name (.-_super names)))
              (.resolveSelf rs pos env (.-tsym site) tree)
            (identical? name (.-_class names)) (.getClassField syms site types)
            :else
              (let [^:mutable sym (.findIdentInType rs pos env site name (.-pkind resultInfo))]
                (set! sym (.accessBase rs sym pos location site name true))
                sym))
        WILDCARD (throw (AssertionError. tree))
        TYPEVAR
          (let [^Symbol sym (when (some? (.getUpperBound site))
                              (.selectSym this
                                          tree
                                          location
                                          (.capture this (.getUpperBound site))
                                          env
                                          resultInfo))]
            (if (nil? sym)
                (do
                  (.error log pos CompilerProperties$Errors/TypeVarCantBeDeref)
                  (.-errSymbol syms))
                (let [^Symbol sym2 (cond
                                     (.isPrivate sym) (.new rs Resolve$AccessError env site sym)
                                     (and (and (.isInterface (.-owner sym))
                                               (identical? (.-kind sym) Kinds$Kind/MTH))
                                          (not (== (bit-and (.flags sym) Flags/STATIC) 0)))
                                       (.new rs Resolve$SymbolNotFoundError Kinds$Kind/ABSENT_MTH)
                                     :else sym)]
                  (.accessBase rs sym2 pos location site name true)
                  sym)))
        ERROR (.-tsym (.createErrorType types name (.-tsym site) site))
        (if (identical? name (.-_class names))
            (.getClassField syms site types)
            (do (.error log pos (CompilerProperties$Errors/CantDeref site)) (.-errSymbol syms))))))

  (method checkId ^Type [this ^JCTree tree ^Type site ^Symbol sym ^{:tag (Env AttrContext)} env
                         ^ResultInfo resultInfo]
    (if (or (.hasTag (.-pt resultInfo) TypeTag/FORALL) (.hasTag (.-pt resultInfo) TypeTag/METHOD))
        (.checkMethodIdInternal this tree site sym env resultInfo)
        (.checkIdInternal this tree site sym (.-pt resultInfo) env resultInfo)))

  (method checkMethodIdInternal ^Type [this ^JCTree tree ^Type site ^Symbol sym
                                       ^{:tag (Env AttrContext)} env ^ResultInfo resultInfo]
    (if (.contains (.-pkind resultInfo) Kinds$KindSelector/POLY)
        (.recoverMethodInvocation attrRecover tree site sym env resultInfo)
        (.checkIdInternal this tree site sym (.-pt resultInfo) env resultInfo)))

  (method checkIdInternal ^Type [this ^JCTree tree ^Type site ^Symbol sym ^Type pt
                                 ^{:tag (Env AttrContext)} env ^ResultInfo resultInfo]
    (let [^:mutable ^Type owntype nil]
      (switch (.-kind sym)
        TYP
          (do
            (set! owntype (.-type sym))
            (when (.hasTag owntype TypeTag/CLASS)
              (.checkForBadAuxiliaryClassAccess chk (.pos tree) env (cast Symbol$ClassSymbol sym))
              (let [ownOuter (.getEnclosingType owntype)]
                (cond
                  (.nonEmpty (.getTypeArguments (.-type (.-tsym owntype))))
                    (set! owntype (.erasure types owntype))
                  (and (or (.hasTag ownOuter TypeTag/CLASS) (.hasTag ownOuter TypeTag/TYPEVAR))
                       (not (identical? site ownOuter)))
                    (let [^:mutable normOuter (.asEnclosingSuper types site (.-tsym ownOuter))]
                      (when (nil? normOuter) (set! normOuter (.erasure types ownOuter)))
                      (when-not (identical? normOuter ownOuter)
                        (set! owntype
                              (Type$ClassType. normOuter
                                               (List/nil)
                                               (.-tsym owntype)
                                               (.getMetadata owntype)))))))))
        VAR
          (let [v (cast Symbol$VarSymbol sym)]
            (when (and (some? (.-enclVar (cast AttrContext (.-info env))))
                       (.hasTag (.-type v) TypeTag/NONE))
              (.error log
                      (TreeInfo/positionFor v (.-enclClass env))
                      (CompilerProperties$Errors/CantInferLocalVarType
                        (.-name v)
                        CompilerProperties$Fragments/LocalSelfRef))
              (return (set! (.-type tree) (set! (.-type v) (.createErrorType types (.-type v))))))
            (when (and (and (and (.subset Kinds$KindSelector/ASG (.pkind this))
                                 (identical? (.-kind (.-owner v)) Kinds$Kind/TYP))
                            (== (bit-and (.flags v) Flags/STATIC) 0))
                       (or (.hasTag site TypeTag/CLASS) (.hasTag site TypeTag/TYPEVAR)))
              (let [s (.asOuterSuper types site (.-owner v))]
                (when (and (and (some? s) (.isRaw s))
                           (not (.isSameType types (.-type v) (.erasure v types))))
                  (.warnUnchecked chk
                                  (.pos tree)
                                  (CompilerProperties$LintWarnings/UncheckedAssignToVar v s)))))
            (set! owntype
                  (if (and (and (identical? (.-kind (.-owner sym)) Kinds$Kind/TYP)
                                (not (identical? (.-name sym) (.-_this names))))
                           (not (identical? (.-name sym) (.-_super names))))
                      (.memberType types site sym)
                      (.-type sym)))
            (when (and (some? (.getConstValue v)) (.isStaticReference this tree))
              (set! owntype (.constType owntype (.getConstValue v))))
            (when (identical? (.-pkind resultInfo) Kinds$KindSelector/VAL)
              (set! owntype (.capture this owntype))))
        MTH
          (do
            (set! owntype
                  (.checkMethod this
                                site
                                sym
                                (ResultInfo. (.-pkind resultInfo)
                                             (.getReturnType (.-pt resultInfo))
                                             (.-checkContext resultInfo)
                                             (.-checkMode resultInfo))
                                env
                                (TreeInfo/args (.-tree env))
                                (.getParameterTypes (.-pt resultInfo))
                                (.getTypeArguments (.-pt resultInfo))))
            (.checkRestricted chk (.pos tree) sym))
        (PCK ERR) (set! owntype (.-type sym))
        (throw (AssertionError. (java-str "unexpected kind: " (.-kind sym) " in tree " tree))))
      (when (or (not (identical? (.-name sym) (.-init names))) (.hasTag tree JCTree$Tag/REFERENCE))
        (.checkDeprecated chk (.pos tree) (.-owner (.-scope (cast AttrContext (.-info env)))) sym)
        (.checkSunAPI chk (.pos tree) sym)
        (.checkProfile chk (.pos tree) sym)
        (.checkPreview chk (.pos tree) (.-owner (.-scope (cast AttrContext (.-info env)))) site sym))
      (when (.isErroneous pt) (set! owntype (.createErrorType types owntype)))
      (.check this tree owntype (.toSelector (.-kind sym)) resultInfo)))

  (method ^:private checkInit ^void [this ^JCTree tree ^{:tag (Env AttrContext)} env
                                     ^Symbol$VarSymbol v ^boolean onlyWarning]
    (let [^{:tag (Env AttrContext)} initEnv (.enclosingInitEnv this env)]
      (when (and (and (and (and (and (some? initEnv)
                                     (or (identical?
                                           (.-enclVar (cast AttrContext (.-info initEnv)))
                                           v)
                                         (> (.-pos v) (.-pos tree))))
                                (identical? (.-kind (.-owner v)) Kinds$Kind/TYP))
                           (identical? (.-owner v)
                                       (.enclClass
                                         (.-owner (.-scope (cast AttrContext (.-info env)))))))
                      (= (not (== (bit-and (.flags v) Flags/STATIC) 0)) (Resolve/isStatic env)))
                 (or (not (.hasTag (.-tree env) JCTree$Tag/ASSIGN))
                     (not (identical? (TreeInfo/skipParens
                                        (.-lhs (cast JCTree$JCAssign (.-tree env))))
                                      tree))))
        (cond
          (or (not onlyWarning) (.isStaticEnumField this v))
            (let [^JCDiagnostic$Error errkey (if (identical?
                                                   (.-enclVar (cast AttrContext (.-info initEnv)))
                                                   v)
                                                 CompilerProperties$Errors/IllegalSelfRef
                                                 CompilerProperties$Errors/IllegalForwardRef)]
              (.error log (.pos tree) errkey))
          useBeforeDeclarationWarning
            (let [^JCDiagnostic$Warning warnkey (if (identical?
                                                      (.-enclVar
                                                        (cast AttrContext (.-info initEnv)))
                                                      v)
                                                    (CompilerProperties$Warnings/SelfRef v)
                                                    (CompilerProperties$Warnings/ForwardRef v))]
              (.warning log (.pos tree) warnkey))))
      (.getConstValue v)
      (.checkEnumInitializer this tree env v)))

  (method enclosingInitEnv ^{:tag (Env AttrContext)} [this ^:mutable ^{:tag (Env AttrContext)} env]
    (while true
      (switch (.getTag (.-tree env))
        VARDEF
          (let [vdecl (cast JCTree$JCVariableDecl (.-tree env))]
            (when (identical? (.-kind (.-owner (.-sym vdecl))) Kinds$Kind/TYP) (return env)))
        BLOCK (when (.hasTag (.-tree (.-next env)) JCTree$Tag/CLASSDEF) (return env))
        (METHODDEF CLASSDEF TOPLEVEL) (return nil))
      (Assert/checkNonNull (.-next env))
      (set! env (.-next env))))

  (method ^:private checkEnumInitializer ^void [this ^JCTree tree ^{:tag (Env AttrContext)} env
                                                ^Symbol$VarSymbol v]
    (when (.isStaticEnumField this v)
      (let [enclClass (.enclClass (.-owner (.-scope (cast AttrContext (.-info env)))))]
        (when-not (or (nil? enclClass) (nil? (.-owner enclClass)))
          (when-not (and (not (identical? (.-owner v) enclClass))
                         (not (.isSubtype types (.-type enclClass) (.-type (.-owner v)))))
            (when-not (not (Resolve/isInitializer env))
              (.error log (.pos tree) CompilerProperties$Errors/IllegalEnumStaticRef)))))))

  (method ^:private isStaticEnumField ^boolean [this ^Symbol$VarSymbol v]
    (and (and (and (Flags/isEnum (.-owner v)) (Flags/isStatic v)) (not (Flags/isConstant v)))
         (not (identical? (.-name v) (.-_class names)))))

  (method ^:public checkMethod ^Type [this ^Type site ^:final ^Symbol sym ^ResultInfo resultInfo
                                      ^{:tag (Env AttrContext)} env
                                      ^:final ^{:tag (List JCTree$JCExpression)} argtrees
                                      ^:mutable ^{:tag (List Type)} argtypes
                                      ^{:tag (List Type)} typeargtypes]
    (when (and (== (bit-and (.flags sym) Flags/STATIC) 0)
               (or (.hasTag site TypeTag/CLASS) (.hasTag site TypeTag/TYPEVAR)))
      (let [s (.asOuterSuper types site (.-owner sym))]
        (when (and (and (some? s) (.isRaw s))
                   (not (.isSameTypes types
                                      (.getParameterTypes (.-type sym))
                                      (.getParameterTypes (.erasure sym types)))))
          (.warnUnchecked chk
                          (.pos (.-tree env))
                          (CompilerProperties$LintWarnings/UncheckedCallMbrOfRawType sym s)))))
    (when (some? (.-defaultSuperCallSite (cast AttrContext (.-info env))))
      (for-each [^Type sup (.prepend (.interfaces types (.-type (.-enclClass env)))
                                     (.supertype types (.-type (.-enclClass env))))]
        (when-not (or (not (.isSubClass (.-tsym sup) (.enclClass sym) types))
                      (.isSameType types
                                   sup
                                   (.-defaultSuperCallSite (cast AttrContext (.-info env)))))
          (let [^{:tag (List Symbol$MethodSymbol)} icand_sup (.interfaceCandidates
                                                               types
                                                               sup
                                                               (cast Symbol$MethodSymbol sym))]
            (when (and (and (.nonEmpty icand_sup) (not (identical? (.-head icand_sup) sym)))
                       (.overrides (cast Symbol$MethodSymbol (.-head icand_sup))
                                   sym
                                   (.enclClass (cast Symbol$MethodSymbol (.-head icand_sup)))
                                   types
                                   true))
              (.error log
                      (.pos (.-tree env))
                      (CompilerProperties$Errors/IllegalDefaultSuperCall
                        (.-defaultSuperCallSite (cast AttrContext (.-info env)))
                        (CompilerProperties$Fragments/OverriddenDefault sym sup)))
              (break)))))
      (set! (.-defaultSuperCallSite (cast AttrContext (.-info env))) nil))
    (when (and (and (.isStatic sym) (.isInterface site)) (.hasTag (.-tree env) JCTree$Tag/APPLY))
      (let [app (cast JCTree$JCMethodInvocation (.-tree env))]
        (when (and (.hasTag (.-meth app) JCTree$Tag/SELECT)
                   (not (TreeInfo/isStaticSelector
                          (.-selected (cast JCTree$JCFieldAccess (.-meth app)))
                          names)))
          (.error log
                  (.pos (.-tree env))
                  (CompilerProperties$Errors/IllegalStaticIntfMethCall site)))))
    (let [noteWarner (Warner.)]
      (try
        (let [^:mutable owntype (.checkMethod rs
                                              env
                                              site
                                              sym
                                              resultInfo
                                              argtypes
                                              typeargtypes
                                              noteWarner)
              ^{:tag (DeferredAttr$DeferredTypeMap Void)} checkDeferredMap (.new
                                                                             deferredAttr
                                                                             DeferredAttr$DeferredTypeMap
                                                                             DeferredAttr$AttrMode/CHECK
                                                                             sym
                                                                             (.-pendingResolutionPhase
                                                                               (cast
                                                                                 AttrContext
                                                                                 (.-info env))))]
          (set! argtypes (.map argtypes checkDeferredMap))
          (when (.hasNonSilentLint noteWarner Lint$LintCategory/UNCHECKED)
            (.warnUnchecked chk
                            (.pos (.-tree env))
                            (CompilerProperties$LintWarnings/UncheckedMethInvocationApplied
                              (Kinds/kindName sym)
                              (.-name sym)
                              (.methodArguments rs (.getParameterTypes (.-type sym)))
                              (.methodArguments rs (.map argtypes checkDeferredMap))
                              (Kinds/kindName (.location sym))
                              (.location sym)))
            (when (or (or (not (identical? (.-pt resultInfo) Infer/anyPoly))
                          (not (.hasTag owntype TypeTag/METHOD)))
                      (not (.isPartial owntype)))
              (set! owntype
                    (Type$MethodType. (.getParameterTypes owntype)
                                      (.erasure types (.getReturnType owntype))
                                      (.erasure types (.getThrownTypes owntype))
                                      (.-methodClass syms)))))
          (let [^JCTree$JCPolyExpression$PolyKind pkind (if (and
                                                              (.hasTag (.-type sym) TypeTag/FORALL)
                                                              (.containsAny
                                                                (.getReturnType (.-type sym))
                                                                (.-tvars
                                                                  (cast Type$ForAll (.-type sym)))))
                                                            JCTree$JCPolyExpression$PolyKind/POLY
                                                            JCTree$JCPolyExpression$PolyKind/STANDALONE)]
            (TreeInfo/setPolyKind (.-tree env) pkind)
            (if (identical? (.-pt resultInfo) Infer/anyPoly)
                owntype
                (.checkMethod chk
                              owntype
                              sym
                              env
                              argtrees
                              argtypes
                              (.lastResolveVarargs (cast AttrContext (.-info env)))
                              (.inferenceContext (.-checkContext resultInfo))))))
        (catch Infer$InferenceException ex
          (.report (.-checkContext resultInfo) (.pos (.-tree env)) (.getDiagnostic ex))
          (.createErrorType types site))
        (catch Resolve$InapplicableMethodException ex
          (let [diag (.getDiagnostic ex)
                ^Resolve$InapplicableSymbolError errSym
                  (anon Resolve$InapplicableSymbolError [nil] :outer rs
                    (method ^:protected errCandidate ^{:tag (Pair Symbol JCDiagnostic)} [this]
                      (Pair. sym diag)))
                ^{:tag (List Type)} argtypes2 (.map
                                                argtypes
                                                (.new
                                                  rs
                                                  Resolve$ResolveDeferredRecoveryMap
                                                  DeferredAttr$AttrMode/CHECK
                                                  sym
                                                  (.-pendingResolutionPhase
                                                    (cast AttrContext (.-info env)))))
                errDiag (.getDiagnostic errSym
                                        JCDiagnostic$DiagnosticType/ERROR
                                        (.-tree env)
                                        sym
                                        site
                                        (.-name sym)
                                        argtypes2
                                        typeargtypes)]
            (.report log errDiag)
            (.createErrorType types site))))))

  (method ^:public visitLiteral ^void [this ^JCTree$JCLiteral tree]
    (set! result
          (.check this
                  tree
                  (.constType (.litType this (.-typetag tree)) (.-value tree))
                  Kinds$KindSelector/VAL
                  resultInfo)))

  (method litType ^Type [this ^TypeTag tag]
    (if (identical? tag TypeTag/CLASS) (.-stringType syms) (aget (.-typeOfTag syms) (.ordinal tag))))

  (method ^:public visitTypeIdent ^void [this ^JCTree$JCPrimitiveTypeTree tree]
    (set! result
          (.check this
                  tree
                  (aget (.-typeOfTag syms) (.ordinal (.-typetag tree)))
                  Kinds$KindSelector/TYP
                  resultInfo)))

  (method ^:public visitTypeArray ^void [this ^JCTree$JCArrayTypeTree tree]
    (let [etype (.attribType this (.-elemtype tree) env)
          ^Type type (Type$ArrayType. etype (.-arrayClass syms))]
      (set! result (.check this tree type Kinds$KindSelector/TYP resultInfo))))

  (method ^:public visitTypeApply ^void [this ^JCTree$JCTypeApply tree]
    (let [^:mutable owntype (.createErrorType types (.-type tree))
          clazztype (.checkClassType chk
                                     (.pos (.-clazz tree))
                                     (.attribType this (.-clazz tree) env))
          ^:mutable ^{:tag (List Type)} actuals (.attribTypes this (.-arguments tree) env)]
      (cond
        (.hasTag clazztype TypeTag/CLASS)
          (let [^{:tag (List Type)} formals (.getTypeArguments (.-type (.-tsym clazztype)))]
            (when (.isEmpty actuals) (set! actuals formals))
            (if (== (.length actuals) (.length formals))
                (let [^:mutable ^{:tag (List Type)} a actuals
                      ^:mutable ^{:tag (List Type)} f formals]
                  (while (.nonEmpty a)
                    (set! (.-head a) (.withTypeVar (cast Type (.-head a)) (cast Type (.-head f))))
                    (set! a (.-tail a))
                    (set! f (.-tail f)))
                  (let [^:mutable clazzOuter (.getEnclosingType clazztype)]
                    (when (.hasTag clazzOuter TypeTag/CLASS)
                      (let [^:mutable ^Type site nil
                            clazz (TreeInfo/typeIn (.-clazz tree))]
                        (cond
                          (.hasTag clazz JCTree$Tag/IDENT)
                            (set! site (.-type (.-sym (.-enclClass env))))
                          (.hasTag clazz JCTree$Tag/SELECT)
                            (set! site (.-type (.-selected (cast JCTree$JCFieldAccess clazz))))
                          :else (throw (AssertionError. (java-str "" tree))))
                        (when (and (.hasTag clazzOuter TypeTag/CLASS)
                                   (not (identical? site clazzOuter)))
                          (when (or (.hasTag site TypeTag/CLASS) (.hasTag site TypeTag/TYPEVAR))
                            (set! site (.asEnclosingSuper types site (.-tsym clazzOuter))))
                          (when (nil? site) (set! site (.erasure types clazzOuter)))
                          (set! clazzOuter site))))
                    (set! owntype
                          (Type$ClassType. clazzOuter
                                           actuals
                                           (.-tsym clazztype)
                                           (.getMetadata clazztype)))))
                (do
                  (if (not (== (.length formals) 0))
                      (.error log
                              (.pos tree)
                              (CompilerProperties$Errors/WrongNumberTypeArgs
                                (Integer/toString (.length formals))))
                      (.error log
                              (.pos tree)
                              (CompilerProperties$Errors/TypeDoesntTakeParams (.-tsym clazztype))))
                  (set! owntype (.createErrorType types (.-type tree))))))
        (.hasTag clazztype TypeTag/ERROR)
          (let [parameterizedErroneous (Type$ErrorType.
                                         (.getOriginalType clazztype)
                                         (.-tsym clazztype)
                                         (.getMetadata clazztype))]
            (set! (.-typarams_field parameterizedErroneous) actuals)
            (set! owntype parameterizedErroneous)))
      (set! result (.check this tree owntype Kinds$KindSelector/TYP resultInfo))))

  (method ^:public visitTypeUnion ^void [this ^JCTree$JCTypeUnion tree]
    (let [^{:tag (ListBuffer Type)} multicatchTypes (ListBuffer.)
          ^:mutable ^{:tag (ListBuffer Type)} all_multicatchTypes nil]
      (for-each [^JCTree$JCExpression typeTree (.-alternatives tree)]
        (let [^:mutable ctype (.attribType this typeTree env)]
          (set! ctype
                (.checkType chk
                            (.pos typeTree)
                            (.checkClassType chk (.pos typeTree) ctype)
                            (.-throwableType syms)))
          (if (not (.isErroneous ctype))
              (do
                (when (.intersects chk ctype (.toList multicatchTypes))
                  (for-each [^Type t multicatchTypes]
                    (let [sub (.isSubtype types ctype t)
                          sup (.isSubtype types t ctype)]
                      (when (or sub sup)
                        (let [^Type a (if sub ctype t)
                              ^Type b (if sub t ctype)]
                          (.error log
                                  (.pos typeTree)
                                  (CompilerProperties$Errors/MulticatchTypesMustBeDisjoint a b)))))))
                (.append multicatchTypes ctype)
                (when (some? all_multicatchTypes) (.append all_multicatchTypes ctype)))
              (do
                (when (nil? all_multicatchTypes)
                  (set! all_multicatchTypes (ListBuffer.))
                  (.appendList all_multicatchTypes multicatchTypes))
                (.append all_multicatchTypes ctype)))))
      (let [^:mutable t (.check this
                                tree
                                (.lub types (.toList multicatchTypes))
                                Kinds$KindSelector/TYP
                                (.dup resultInfo CheckMode/NO_TREE_UPDATE))]
        (when (.hasTag t TypeTag/CLASS)
          (let [^{:tag (List Type)} alternatives (.toList
                                                   (if (nil? all_multicatchTypes)
                                                       multicatchTypes
                                                       all_multicatchTypes))]
            (set! t (Type$UnionClassType. (cast Type$ClassType t) alternatives))))
        (set! (.-type tree) (set! result t)))))

  (method ^:public visitTypeIntersection ^void [this ^JCTree$JCTypeIntersection tree]
    (.attribTypes this (.-bounds tree) env)
    (set! (.-type tree) (set! result (.checkIntersection this tree (.-bounds tree)))))

  (method ^:public visitTypeParameter ^void [this ^JCTree$JCTypeParameter tree]
    (let [typeVar (cast Type$TypeVar (.-type tree))]
      (when (and (some? (.-annotations tree)) (.nonEmpty (.-annotations tree)))
        (.annotateTypeParameterSecondStage annotate tree (.-annotations tree)))
      (when-not (.isErroneous (.getUpperBound typeVar))
        (.setUpperBound typeVar (.checkIntersection this tree (.-bounds tree))))))

  (method checkIntersection ^Type [this ^JCTree tree
                                   ^:mutable ^{:tag (List JCTree$JCExpression)} bounds]
    (let [^{:tag (Set Symbol)} boundSet (HashSet.)]
      (when (.nonEmpty bounds)
        (set! (.-type (cast JCTree$JCExpression (.-head bounds)))
              (.checkBase this
                          (.-type (cast JCTree$JCExpression (.-head bounds)))
                          (cast JCTree (.-head bounds))
                          env
                          false
                          false
                          false))
        (.add boundSet
              (.-tsym (.erasure types (.-type (cast JCTree$JCExpression (.-head bounds))))))
        (cond
          (.isErroneous (.-type (cast JCTree$JCExpression (.-head bounds))))
            (return (.-type (cast JCTree$JCExpression (.-head bounds))))
          (.hasTag (.-type (cast JCTree$JCExpression (.-head bounds))) TypeTag/TYPEVAR)
            (when (.nonEmpty (.-tail bounds))
              (.error log
                      (.pos (cast JCTree$JCExpression (.-head (.-tail bounds))))
                      CompilerProperties$Errors/TypeVarMayNotBeFollowedByOtherBounds)
              (return (.-type (cast JCTree$JCExpression (.-head bounds)))))
          :else
            (for-each [^JCTree$JCExpression bound (.-tail bounds)]
              (set! (.-type bound) (.checkBase this (.-type bound) bound env false true false))
              (cond
                (.isErroneous (.-type bound)) (set! bounds (List/of bound))
                (.hasTag (.-type bound) TypeTag/CLASS)
                  (.checkNotRepeated chk (.pos bound) (.erasure types (.-type bound)) boundSet)))))
      (cond
        (== (.length bounds) 0) (.-objectType syms)
        (== (.length bounds) 1) (.-type (cast JCTree$JCExpression (.-head bounds)))
        :else
          (let [^Type owntype (.makeIntersectionType types (TreeInfo/types bounds))
                ^:mutable ^JCTree$JCExpression extending nil
                ^:mutable ^{:tag (List JCTree$JCExpression)} implementing nil]
            (if (not (.isInterface (.-type (cast JCTree$JCExpression (.-head bounds)))))
                (do
                  (set! extending (cast JCTree$JCExpression (.-head bounds)))
                  (set! implementing (.-tail bounds)))
                (do (set! extending nil) (set! implementing bounds)))
            (let [cd (.ClassDef (.at make tree)
                                (.Modifiers make (bit-or-int Flags/PUBLIC Flags/ABSTRACT))
                                (.-empty names)
                                (List/nil)
                                extending
                                implementing
                                (List/nil))
                  c (cast Symbol$ClassSymbol (.-tsym owntype))]
              (Assert/check (not (== (bit-and (.flags c) Flags/COMPOUND) 0)))
              (set! (.-sym cd) c)
              (set! (.-sourcefile c) (.-sourcefile (.-toplevel env)))
              (set! (.-flags_field c) (bit-or (.-flags_field c) Flags/UNATTRIBUTED))
              (let [^{:tag (Env AttrContext)} cenv (.classEnv enter cd env)]
                (.put typeEnvs c cenv)
                (.attribClass this c)
                owntype))))))

  (method ^:public visitWildcard ^void [this ^JCTree$JCWildcard tree]
    (let [^Type type (if (identical? (.-kind (.-kind tree)) BoundKind/UNBOUND)
                         (.-objectType syms)
                         (.attribType this (.-inner tree) env))]
      (set! result
            (.check this
                    tree
                    (Type$WildcardType. (.checkRefType chk (.pos tree) type)
                                        (.-kind (.-kind tree))
                                        (.-boundClass syms))
                    Kinds$KindSelector/TYP
                    resultInfo))))

  (method ^:public visitAnnotation ^void [this ^JCTree$JCAnnotation tree]
    (Assert/error "should be handled in annotate"))

  (method ^:public visitModifiers ^void [this ^JCTree$JCModifiers tree]
    (Assert/check (identical? (.-pkind resultInfo) Kinds$KindSelector/ERR))
    (.attribAnnotationTypes this (.-annotations tree) env))

  (method ^:public visitAnnotatedType ^void [this ^JCTree$JCAnnotatedType tree]
    (.attribAnnotationTypes this (.-annotations tree) env)
    (let [underlyingType (.attribType this (.-underlyingType tree) env)
          annotatedType (.preannotatedType underlyingType)]
      (.annotateTypeSecondStage annotate tree (.-annotations tree) annotatedType)
      (set! result (set! (.-type tree) annotatedType))))

  (method ^:public visitErroneous ^void [this ^JCTree$JCErroneous tree]
    (when (some? (.-errs tree))
      (let [^:mutable newScope (.-scope (cast AttrContext (.-info env)))]
        (when (instance? JCTree$JCClassDecl (.-tree env))
          (let [^Symbol fakeOwner (Symbol$MethodSymbol.
                                    Flags/BLOCK
                                    (.-empty names)
                                    nil
                                    (.-owner (.-scope (cast AttrContext (.-info env)))))]
            (set! newScope (.dupUnshared newScope fakeOwner))))
        (let [^{:tag (Env AttrContext)} errEnv (.dup
                                                 env
                                                 (.-tree env)
                                                 (.dup (cast AttrContext (.-info env)) newScope))]
          (set! (.-returnResult (cast AttrContext (.-info errEnv))) unknownExprInfo)
          (for-each [^JCTree err (.-errs tree)]
            (.attribTree this err errEnv (ResultInfo. Kinds$KindSelector/ERR (.pt this)))))))
    (set! result (set! (.-type tree) (.-errType syms))))

  (method ^:public visitTree ^void [this ^JCTree tree]
    (throw (AssertionError.)))

  (method ^:public attrib ^void [this ^{:tag (Env AttrContext)} env]
    (switch (.getTag (.-tree env))
      MODULEDEF
        (.attribModule this (.pos (.-tree env)) (.-sym (cast JCTree$JCModuleDecl (.-tree env))))
      PACKAGEDEF
        (.attribPackage this
                        (.pos (.-tree env))
                        (.-packge (cast JCTree$JCPackageDecl (.-tree env))))
      (.attribClass this (.pos (.-tree env)) (.-sym (.-enclClass env))))
    (.flush annotate)
    (.calculateLints lintMapper
                     (.-sourcefile (.-toplevel env))
                     (.-tree env)
                     (.-endPositions (.-toplevel env))))

  (method ^:public attribPackage ^void [this ^JCDiagnostic$DiagnosticPosition pos
                                        ^Symbol$PackageSymbol p]
    (try
      (.flush annotate)
      (.attribPackage this p)
      (catch Symbol$CompletionFailure ex (.completionError chk pos ex))))

  (method attribPackage ^void [this ^Symbol$PackageSymbol p]
    (.attribWithLint this
                     p
                     (lambda Consumer ^void [^Env env]
                       (.checkDeprecatedAnnotation
                         chk
                         (.pos (.-pid (cast JCTree$JCPackageDecl (.-tree env))))
                         p))))

  (method ^:public attribModule ^void [this ^JCDiagnostic$DiagnosticPosition pos
                                       ^Symbol$ModuleSymbol m]
    (try
      (.flush annotate)
      (.attribModule this m)
      (catch Symbol$CompletionFailure ex (.completionError chk pos ex))))

  (method attribModule ^void [this ^Symbol$ModuleSymbol m]
    (.attribWithLint this m (lambda Consumer ^void [^Env env] (.attribStat this (.-tree env) env))))

  (method ^:private attribWithLint ^void [this ^Symbol$TypeSymbol sym
                                          ^{:tag (Consumer (Env AttrContext))} attrib]
    (let [^{:tag (Env AttrContext)} env (.get typeEnvs sym)
          ^:mutable ^{:tag (Env AttrContext)} lintEnv env]
      (while (nil? (.-lint (cast AttrContext (.-info lintEnv)))) (set! lintEnv (.-next lintEnv)))
      (let [lint (.augment (.-lint (cast AttrContext (.-info lintEnv))) sym)
            prevLint (.setLint chk lint)
            prev (.useSource log (.-sourcefile (.-toplevel env)))]
        (try (.accept attrib env) (finally (.useSource log prev) (.setLint chk prevLint))))))

  (method ^:public attribClass ^void [this ^JCDiagnostic$DiagnosticPosition pos
                                      ^Symbol$ClassSymbol c]
    (try
      (.flush annotate)
      (.attribClass this c)
      (catch Symbol$CompletionFailure ex (.completionError chk pos ex))))

  (method attribClass :throws [Symbol$CompletionFailure] ^void [this ^Symbol$ClassSymbol c]
    (when-not (.hasTag (.-type c) TypeTag/ERROR)
      (.checkNonCyclic chk nil (.-type c))
      (let [st (.supertype types (.-type c))]
        (when (and (== (bit-and (.-flags_field c) Flags/COMPOUND) 0)
                   (== (bit-and (.-flags_field c) Flags/SUPER_OWNER_ATTRIBUTED) 0))
          (when (.hasTag st TypeTag/CLASS)
            (.attribClass this (cast Symbol$ClassSymbol (.-tsym st))))
          (when (and (identical? (.-kind (.-owner c)) Kinds$Kind/TYP)
                     (.hasTag (.-type (.-owner c)) TypeTag/CLASS))
            (.attribClass this (cast Symbol$ClassSymbol (.-owner c))))
          (set! (.-flags_field c) (bit-or (.-flags_field c) Flags/SUPER_OWNER_ATTRIBUTED)))
        (when-not (== (bit-and (.-flags_field c) Flags/UNATTRIBUTED) 0)
          (set! (.-flags_field c) (bit-and (.-flags_field c) (bit-not-int Flags/UNATTRIBUTED)))
          (let [^{:tag (Env AttrContext)} env (.get typeEnvs c)
                ^:mutable ^{:tag (Env AttrContext)} lintEnv env]
            (while (nil? (.-lint (cast AttrContext (.-info lintEnv))))
              (set! lintEnv (.-next lintEnv)))
            (set! (.-lint (cast AttrContext (.-info env)))
                  (.augment (.-lint (cast AttrContext (.-info lintEnv))) c))
            (let [prevLint (.setLint chk (.-lint (cast AttrContext (.-info env))))
                  prev (.useSource log (.-sourcefile c))
                  prevReturnRes (.-returnResult (cast AttrContext (.-info env)))]
              (try
                (when (and (and (and (.isSealed c) (not (.isEnum c)))
                                (not (.-isPermittedExplicit c)))
                           (.isEmpty (.getPermittedSubclasses c)))
                  (.error log
                          (TreeInfo/diagnosticPositionFor c (.-tree env))
                          CompilerProperties$Errors/SealedClassMustHaveSubclasses))
                (when (.isSealed c)
                  (let [^{:tag (Set Symbol)} permittedTypes (HashSet.)
                        sealedInUnnamed (or (identical?
                                              (.-modle (.packge c))
                                              (.-unnamedModule syms))
                                            (identical? (.-modle (.packge c)) (.-noModule syms)))]
                    (for-each [^Type subType (.getPermittedSubclasses c)]
                      (when-not (.isErroneous subType)
                        (let [^:mutable isTypeVar false]
                          (when (identical? (.getTag subType) TypeTag/TYPEVAR)
                            (set! isTypeVar true)
                            (.error log
                                    (TreeInfo/diagnosticPositionFor (.-tsym subType) (.-tree env))
                                    (CompilerProperties$Errors/InvalidPermitsClause
                                      (CompilerProperties$Fragments/IsATypeVariable subType))))
                          (when (and (.isAnonymous (.-tsym subType)) (not (.isEnum c)))
                            (.error log
                                    (TreeInfo/diagnosticPositionFor (.-tsym subType) (.-tree env))
                                    (CompilerProperties$Errors/LocalClassesCantExtendSealed
                                      CompilerProperties$Fragments/Anonymous)))
                          (if (.contains permittedTypes (.-tsym subType))
                              (let [pos (cast
                                          JCDiagnostic$DiagnosticPosition
                                          (.get
                                            (cast
                                              List
                                              (.collect
                                                (.limit
                                                  (.filter
                                                    (.stream (.-permitting (.-enclClass env)))
                                                    (lambda Predicate ^boolean [^JCTree$JCExpression permittedExpr]
                                                      (some?
                                                        (TreeInfo/diagnosticPositionFor
                                                          (.-tsym subType)
                                                          permittedExpr
                                                          true))))
                                                  2)
                                                (List/collector)))
                                            1))]
                                (.error log
                                        pos
                                        (CompilerProperties$Errors/InvalidPermitsClause
                                          (CompilerProperties$Fragments/IsDuplicated subType))))
                              (.add permittedTypes (.-tsym subType)))
                          (if sealedInUnnamed
                              (when-not (identical? (.packge (.-tsym subType)) (.packge c))
                                (.error
                                  log
                                  (TreeInfo/diagnosticPositionFor (.-tsym subType) (.-tree env))
                                  (CompilerProperties$Errors/ClassInUnnamedModuleCantExtendSealedInDiffPackage
                                    c)))
                              (when-not (identical?
                                          (.-modle (.packge (.-tsym subType)))
                                          (.-modle (.packge c)))
                                (.error
                                  log
                                  (TreeInfo/diagnosticPositionFor (.-tsym subType) (.-tree env))
                                  (CompilerProperties$Errors/ClassInModuleCantExtendSealedInDiffModule
                                    c
                                    (.-modle (.packge c))))))
                          (if (or (identical? (.-tsym subType) (.-tsym (.-type c)))
                                  (.isSuperType types subType (.-type c)))
                              (.error
                                log
                                (TreeInfo/diagnosticPositionFor
                                  (.-tsym subType)
                                  (.-permitting (cast JCTree$JCClassDecl (.-tree env))))
                                (CompilerProperties$Errors/InvalidPermitsClause
                                  ^JCDiagnostic$Fragment (if (identical?
                                                               (.-tsym subType)
                                                               (.-tsym (.-type c)))
                                                             CompilerProperties$Fragments/MustNotBeSameClass
                                                             (CompilerProperties$Fragments/MustNotBeSupertype
                                                               subType))))
                              (when-not isTypeVar
                                (let [thisIsASuper (.anyMatch
                                                     (.stream (.directSupertypes types subType))
                                                     (lambda Predicate ^boolean [^Type d]
                                                       (identical? (.-tsym d) c)))]
                                  (when-not thisIsASuper
                                    (if (.isInterface c)
                                        (.error
                                          log
                                          (TreeInfo/diagnosticPositionFor
                                            (.-tsym subType)
                                            (.-tree env))
                                          (CompilerProperties$Errors/InvalidPermitsClause
                                            (CompilerProperties$Fragments/DoesntImplementSealed
                                              (Kinds/kindName (.-tsym subType))
                                              subType)))
                                        (.error log
                                                (TreeInfo/diagnosticPositionFor
                                                  (.-tsym subType)
                                                  (.-tree env))
                                                (CompilerProperties$Errors/InvalidPermitsClause
                                                  (CompilerProperties$Fragments/DoesntExtendSealed
                                                    subType)))))))))))))
                (let [^{:tag (List Symbol$ClassSymbol)} sealedSupers (cast
                                                                       List
                                                                       (.collect
                                                                         (.map
                                                                           (.filter
                                                                             (.stream
                                                                               (.directSupertypes
                                                                                 types
                                                                                 (.-type c)))
                                                                             (lambda Predicate ^boolean [^Type s]
                                                                               (.isSealed
                                                                                 (.-tsym s))))
                                                                           (lambda Function ^Symbol$ClassSymbol [^Type s]
                                                                             (cast
                                                                               Symbol$ClassSymbol
                                                                               (.-tsym s))))
                                                                         (List/collector)))]
                  (if (.isEmpty sealedSupers)
                      (when-not (== (bit-and (.-flags_field c) Flags/NON_SEALED) 0)
                        (let [^:mutable hasErrorSuper false]
                          (set! hasErrorSuper
                                (let [a-10 hasErrorSuper
                                      b-11 (.anyMatch
                                             (.stream (.directSupertypes types (.-type c)))
                                             (lambda Predicate ^boolean [^Type s]
                                               (identical? (.-kind (.-tsym s)) Kinds$Kind/ERR)))]
                                  (or a-10 b-11)))
                          (let [ct (cast Type$ClassType (.-type c))]
                            (set! hasErrorSuper
                                  (let [a-12 hasErrorSuper
                                        b-13 (and
                                               (not (.isCompound ct))
                                               (not
                                                 (identical?
                                                   (.-interfaces_field ct)
                                                   (.-all_interfaces_field ct))))]
                                    (or a-12 b-13)))
                            (when-not hasErrorSuper
                              (.error log
                                      (TreeInfo/diagnosticPositionFor c (.-tree env))
                                      (CompilerProperties$Errors/NonSealedWithNoSealedSupertype c))))))
                      (do
                        (when (and (.isDirectlyOrIndirectlyLocal c) (not (.isEnum c)))
                          (.error
                            log
                            (TreeInfo/diagnosticPositionFor c (.-tree env))
                            (CompilerProperties$Errors/LocalClassesCantExtendSealed
                              ^JCDiagnostic$Fragment (if (.isAnonymous c)
                                                         CompilerProperties$Fragments/Anonymous
                                                         CompilerProperties$Fragments/Local))))
                        (when-not (.isCompound (.-type c))
                          (for-each [^Symbol$ClassSymbol supertypeSym sealedSupers]
                            (when-not (.isPermittedSubclass supertypeSym (.-tsym (.-type c)))
                              (.error
                                log
                                (TreeInfo/diagnosticPositionFor (.-tsym (.-type c)) (.-tree env))
                                (CompilerProperties$Errors/CantInheritFromSealed supertypeSym))))
                          (when (and (and (not (.isNonSealed c)) (not (.isFinal c)))
                                     (not (.isSealed c)))
                            (.error
                              log
                              (TreeInfo/diagnosticPositionFor c (.-tree env))
                              ^JCDiagnostic$Error (if (.isInterface c)
                                                      CompilerProperties$Errors/NonSealedOrSealedExpected
                                                      CompilerProperties$Errors/NonSealedSealedOrFinalExpected))))))
                  (set! (.-returnResult (cast AttrContext (.-info env))) nil)
                  (when (and (identical? (.-tsym st) (.-enumSym syms))
                             (== (bit-and (.-flags_field c) (bit-or-int Flags/ENUM Flags/COMPOUND))
                                 0))
                    (.error log (.pos (.-tree env)) CompilerProperties$Errors/EnumNoSubclassing))
                  (when (and (and (some? (.-tsym st))
                                  (not (== (bit-and (.-flags_field (.-tsym st)) Flags/ENUM) 0)))
                             (== (bit-and (.-flags_field c) (bit-or-int Flags/ENUM Flags/COMPOUND))
                                 0))
                    (.error log
                            (.pos (.-tree env))
                            CompilerProperties$Errors/EnumTypesNotExtensible))
                  (when (.isSerializable rs (.-type c))
                    (set! (.-isSerializable (cast AttrContext (.-info env))) true))
                  (.attribClassBody this env c)
                  (.checkDeprecatedAnnotation chk (.pos (.-tree env)) c)
                  (.checkClassOverrideEqualsAndHashIfNeeded chk (.pos (.-tree env)) c)
                  (.checkFunctionalInterface chk (cast JCTree$JCClassDecl (.-tree env)) c)
                  (.checkLeaksNotAccessible chk env (cast JCTree$JCClassDecl (.-tree env)))
                  (when (.isImplicit c) (.checkHasMain chk (.pos (.-tree env)) c)))
                (finally
                  (set! (.-returnResult (cast AttrContext (.-info env))) prevReturnRes)
                  (.useSource log prev)
                  (.setLint chk prevLint)))))))))

  (method ^:public visitImport ^void [this ^JCTree$JCImport tree])

  (method ^:public visitModuleDef ^void [this ^JCTree$JCModuleDecl tree]
    (.completeUsesProvides (.-sym tree))
    (let [msym (.-sym tree)
          lint (set! (.-lint (cast AttrContext (.-info (.-outer env))))
                     (.augment (.-lint (cast AttrContext (.-info (.-outer env)))) msym))
          prevLint (.setLint chk lint)]
      (try
        (.checkModuleName chk tree)
        (.checkDeprecatedAnnotation chk tree msym)
        (finally (.setLint chk prevLint)))))

  (method ^:private attribClassBody ^void [this ^{:tag (Env AttrContext)} env ^Symbol$ClassSymbol c]
    (let [tree (cast JCTree$JCClassDecl (.-tree env))]
      (Assert/check (identical? c (.-sym tree)))
      (.attribStats this (.-typarams tree) env)
      (when-not (.isAnonymous c)
        (.validate chk (.-typarams tree) env)
        (.validate chk (.-extending tree) env)
        (.validate chk (.-implementing tree) env))
      (.checkRequiresIdentity chk tree (.-lint (cast AttrContext (.-info env))))
      (.markAbstractIfNeeded c types)
      (when (== (bit-and (.flags c) (bit-or-int Flags/ABSTRACT Flags/INTERFACE)) 0)
        (.checkAllDefined chk (.pos tree) c))
      (if (not (== (bit-and (.flags c) Flags/ANNOTATION) 0))
          (do
            (when (.nonEmpty (.-implementing tree))
              (.error log
                      (.pos (cast JCTree$JCExpression (.-head (.-implementing tree))))
                      CompilerProperties$Errors/CantExtendIntfAnnotation))
            (when (.nonEmpty (.-typarams tree))
              (.error log
                      (.pos (cast JCTree$JCTypeParameter (.-head (.-typarams tree))))
                      (CompilerProperties$Errors/IntfAnnotationCantHaveTypeParams c)))
            (let [repeatable (.getRepeatable (.getAnnotationTypeMetadata c))]
              (when (some? repeatable)
                (let [cbPos (.getDiagnosticPosition this tree (.-type repeatable))]
                  (Assert/checkNonNull cbPos)
                  (.validateRepeatable chk c repeatable cbPos)))))
          (do
            (.checkCompatibleSupertypes chk (.pos tree) (.-type c))
            (.checkDefaultMethodClashes chk (.pos tree) (.-type c))
            (.checkPotentiallyAmbiguousOverloads chk tree (.-type c))))
      (.checkClassBounds chk (.pos tree) (.-type c))
      (set! (.-type tree) (.-type c))
      (loop [^{:tag (List JCTree$JCTypeParameter)} l (.-typarams tree)]
        (when (.nonEmpty l)
          (Assert/checkNonNull
            (.findFirst (.-scope (cast AttrContext (.-info env)))
                        (.-name (cast JCTree$JCTypeParameter (.-head l)))))
          (recur (.-tail l))))
      (when (and (not (.isEmpty (.allparams (.-type c))))
                 (.isSubtype types (.-type c) (.-throwableType syms)))
        (.error log (.pos (.-extending tree)) CompilerProperties$Errors/GenericThrowable))
      (.checkImplementations chk tree)
      (.checkAutoCloseable this env tree false)
      (loop [^{:tag (List JCTree)} l (.-defs tree)]
        (when (.nonEmpty l)
          (.attribStat this (cast JCTree (.-head l)) env)
          (if (and (and (and (not allowRecords)
                             (not (identical? (.-kind (.-owner c)) Kinds$Kind/PCK)))
                        (or (== (bit-and (.flags c) Flags/STATIC) 0)
                            (identical? (.-name c) (.-empty names))))
                   (not (== (bit-and (TreeInfo/flags (cast JCTree (.-head l)))
                                     (bit-or-int Flags/STATIC Flags/INTERFACE))
                            0)))
              (let [^:mutable ^Symbol$VarSymbol sym nil]
                (when (.hasTag (cast JCTree (.-head l)) JCTree$Tag/VARDEF)
                  (set! sym (.-sym (cast JCTree$JCVariableDecl (.-head l)))))
                (if (or (or (nil? sym) (not (identical? (.-kind sym) Kinds$Kind/VAR)))
                        (nil? (.getConstValue sym)))
                    (do
                      (.error log
                              (.pos (cast JCTree (.-head l)))
                              (CompilerProperties$Errors/IclsCantHaveStaticDecl c))
                      (recur (.-tail l)))
                    (recur (.-tail l))))
              (recur (.-tail l)))))
      (.checkSuperInitCalls chk tree)
      (.checkCyclicConstructors chk tree)
      (.checkNonCyclicElements chk tree)
      (when (and (and (.isEnabled (.-lint (cast AttrContext (.-info env))) Lint$LintCategory/SERIAL)
                      (.isSerializable rs (.-type c)))
                 (not (.isAnonymous c)))
        (.checkSerialStructure chk tree c))
      (.organizeTypeAnnotationsBodies typeAnnotations tree)
      (.validateTypeAnnotations this tree false)))

  (method ^:private getDiagnosticPosition ^JCDiagnostic$DiagnosticPosition [this
                                                                            ^JCTree$JCClassDecl tree
                                                                            ^Type t]
    (loop [^{:tag (List JCTree$JCAnnotation)} al (.-annotations (.-mods tree))]
      (if (not (.isEmpty al))
          (if (.isSameType types
                           (.-type (.-annotationType (cast JCTree$JCAnnotation (.-head al))))
                           t)
              (return (.pos (cast JCTree$JCAnnotation (.-head al))))
              (recur (.-tail al)))
          nil))
    nil)

  (method ^:private capture ^Type [this ^Type type] (.capture types type))

  (method ^:private setSyntheticVariableType ^void [this ^JCTree$JCVariableDecl tree ^Type type]
    (cond
      (.isErroneous type) (set! (.-vartype tree) (.Erroneous (.at make (.pos tree))))
      (.declaredUsingVar tree)
        (do
          (Assert/check (not (== (.-typePos tree) Position/NOPOS)))
          (set! (.-vartype tree) (.Type (.at make (.-typePos tree)) type)))
      :else (set! (.-vartype tree) (.Type (.at make (.pos tree)) type))))

  (method ^:public validateTypeAnnotations ^void [this ^JCTree tree ^boolean sigOnly]
    (.accept tree (TypeAnnotationsValidator. sigOnly)))

  (defclass ^:private ^:final TypeAnnotationsValidator
    :extends TreeScanner

    (field ^:private ^:final ^boolean sigOnly)

    (constructor ^:public [this ^boolean sigOnly]
      (set! (.-sigOnly this) sigOnly))

    (method ^:public visitAnnotation ^void [this ^JCTree$JCAnnotation tree]
      (.validateTypeAnnotation chk tree nil false)
      (.visitAnnotation super tree))

    (method ^:public visitAnnotatedType ^void [this ^JCTree$JCAnnotatedType tree]
      (when-not (.isErroneous (.-type (.-underlyingType tree))) (.visitAnnotatedType super tree)))

    (method ^:public visitTypeParameter ^void [this ^JCTree$JCTypeParameter tree]
      (.validateTypeAnnotations chk (.-annotations tree) (.-tsym (.-type tree)) true)
      (.scan this (.-bounds tree)))

    (method ^:public visitMethodDef ^void [this ^JCTree$JCMethodDecl tree]
      (when (and (some? (.-recvparam tree))
                 (not (.isErroneous (.-type (.-vartype (.-recvparam tree))))))
        (.checkForDeclarationAnnotations this
                                         (.-annotations (.-mods (.-recvparam tree)))
                                         (.-sym (.-recvparam tree))))
      (when (and (some? (.-restype tree)) (some? (.-type (.-restype tree))))
        (.validateAnnotatedType this (.-restype tree) (.-type (.-restype tree))))
      (if sigOnly
          (do
            (.scan this (.-mods tree))
            (.scan this (.-restype tree))
            (.scan this (.-typarams tree))
            (.scan this (.-recvparam tree))
            (.scan this (.-params tree))
            (.scan this (.-thrown tree)))
          (do (.scan this (.-defaultValue tree)) (.scan this (.-body tree)))))

    (method ^:public visitVarDef ^void [this ^:final ^JCTree$JCVariableDecl tree]
      (when (and (and (some? (.-sym tree)) (some? (.-type (.-sym tree))))
                 (not (.isImplicitlyTyped tree)))
        (.validateAnnotatedType this (.-vartype tree) (.-type (.-sym tree))))
      (.scan this (.-mods tree))
      (.scan this (.-vartype tree))
      (when-not sigOnly (.scan this (.-init tree))))

    (method ^:public visitTypeCast ^void [this ^JCTree$JCTypeCast tree]
      (when (and (some? (.-clazz tree)) (some? (.-type (.-clazz tree))))
        (.validateAnnotatedType this (.-clazz tree) (.-type (.-clazz tree))))
      (.visitTypeCast super tree))

    (method ^:public visitTypeTest ^void [this ^JCTree$JCInstanceOf tree]
      (when (and (and (some? (.-pattern tree)) (not (instance? JCTree$JCPattern (.-pattern tree))))
                 (some? (.-type (.-pattern tree))))
        (.validateAnnotatedType this (.-pattern tree) (.-type (.-pattern tree))))
      (.visitTypeTest super tree))

    (method ^:public visitNewClass ^void [this ^JCTree$JCNewClass tree]
      (when (and (some? (.-clazz tree)) (some? (.-type (.-clazz tree))))
        (when (.hasTag (.-clazz tree) JCTree$Tag/ANNOTATED_TYPE)
          (.checkForDeclarationAnnotations this
                                           (.-annotations
                                             (cast JCTree$JCAnnotatedType (.-clazz tree)))
                                           (.-tsym (.-type (.-clazz tree)))))
        (when (some? (.-def tree))
          (.checkForDeclarationAnnotations this
                                           (.-annotations (.-mods (.-def tree)))
                                           (.-tsym (.-type (.-clazz tree)))))
        (.validateAnnotatedType this (.-clazz tree) (.-type (.-clazz tree))))
      (.visitNewClass super tree))

    (method ^:public visitNewArray ^void [this ^JCTree$JCNewArray tree]
      (when (and (some? (.-elemtype tree)) (some? (.-type (.-elemtype tree))))
        (when (.hasTag (.-elemtype tree) JCTree$Tag/ANNOTATED_TYPE)
          (.checkForDeclarationAnnotations this
                                           (.-annotations
                                             (cast JCTree$JCAnnotatedType (.-elemtype tree)))
                                           (.-tsym (.-type (.-elemtype tree)))))
        (.validateAnnotatedType this (.-elemtype tree) (.-type (.-elemtype tree))))
      (.visitNewArray super tree))

    (method ^:public visitClassDef ^void [this ^JCTree$JCClassDecl tree]
      (when sigOnly
        (.scan this (.-mods tree))
        (.scan this (.-typarams tree))
        (.scan this (.-extending tree))
        (.scan this (.-implementing tree)))
      (for-each [^JCTree member (.-defs tree)]
        (when-not (.hasTag member JCTree$Tag/CLASSDEF) (.scan this member))))

    (method ^:public visitBlock ^void [this ^JCTree$JCBlock tree]
      (when-not sigOnly (.scan this (.-stats tree))))

    (method ^:private validateAnnotatedType ^void [this ^:final ^JCTree errtree ^:final ^Type type]
      (when-not (.isPrimitiveOrVoid type)
        (let [^:mutable enclTr errtree
              ^:mutable enclTy type
              ^:mutable repeat true]
          (while repeat
            (when (.hasTag enclTr JCTree$Tag/TYPEAPPLY)
              (let [^{:tag (List Type)} tyargs (.getTypeArguments enclTy)
                    ^{:tag (List JCTree$JCExpression)} trargs (.getTypeArguments
                                                                (cast JCTree$JCTypeApply enclTr))]
                (when (> (.length trargs) 0)
                  (when (== (.length tyargs) (.length trargs))
                    (loop [^int i 0]
                      (when (< i (.length tyargs))
                        (.validateAnnotatedType this
                                                (cast JCTree (.get trargs i))
                                                (cast Type (.get tyargs i)))
                        (recur (unchecked-inc-int i))))))
                (set! enclTr (.-clazz (cast JCTree$JCTypeApply enclTr)))))
            (cond
              (.hasTag enclTr JCTree$Tag/SELECT)
                (do
                  (set! enclTr (.getExpression (cast JCTree$JCFieldAccess enclTr)))
                  (when (and (some? enclTy) (not (.hasTag enclTy TypeTag/NONE)))
                    (set! enclTy (.getEnclosingType enclTy))))
              (.hasTag enclTr JCTree$Tag/ANNOTATED_TYPE)
                (let [at (cast JCTree$JCAnnotatedType enclTr)]
                  (when (or (nil? enclTy) (.hasTag enclTy TypeTag/NONE))
                    (let [^{:tag (ListBuffer Attribute$TypeCompound)} onlyTypeAnnotationsBuf
                            (ListBuffer.)]
                      (for-each [^JCTree$JCAnnotation an (.getAnnotations at)]
                        (when (.isTypeAnnotation chk an false)
                          (.add onlyTypeAnnotationsBuf
                                (cast Attribute$TypeCompound (.-attribute an)))))
                      (let [^{:tag (List Attribute$TypeCompound)} onlyTypeAnnotations (.toList
                                                                                        onlyTypeAnnotationsBuf)]
                        (when-not (.isEmpty onlyTypeAnnotations)
                          (let [^JCDiagnostic$Fragment annotationFragment (if (==
                                                                                (.size
                                                                                  onlyTypeAnnotations)
                                                                                1)
                                                                              (CompilerProperties$Fragments/TypeAnnotation1
                                                                                (cast
                                                                                  Attribute$Compound
                                                                                  (.-head
                                                                                    onlyTypeAnnotations)))
                                                                              (CompilerProperties$Fragments/TypeAnnotation
                                                                                onlyTypeAnnotations))
                                annotatedType (JCDiagnostic$AnnotatedType.
                                                (.annotatedType
                                                  (.stripMetadata type)
                                                  onlyTypeAnnotations))]
                            (.error log
                                    (.pos (.-underlyingType at))
                                    (CompilerProperties$Errors/TypeAnnotationInadmissible
                                      annotationFragment
                                      (.-owner (.-tsym type))
                                      annotatedType))))
                        (set! repeat false))))
                  (set! enclTr (.-underlyingType at)))
              (.hasTag enclTr JCTree$Tag/IDENT) (set! repeat false)
              (.hasTag enclTr JCTree$Tag/WILDCARD)
                (let [wc (cast JCTree$JCWildcard enclTr)]
                  (when (or (identical? (.getKind wc) Tree$Kind/EXTENDS_WILDCARD)
                            (identical? (.getKind wc) Tree$Kind/SUPER_WILDCARD))
                    (.validateAnnotatedType this (.getBound wc) (.-type (.getBound wc))))
                  (set! repeat false))
              (.hasTag enclTr JCTree$Tag/TYPEARRAY)
                (let [art (cast JCTree$JCArrayTypeTree enclTr)]
                  (.validateAnnotatedType this (.getType art) (.-type (.-elemtype art)))
                  (set! repeat false))
              (.hasTag enclTr JCTree$Tag/TYPEUNION)
                (let [ut (cast JCTree$JCTypeUnion enclTr)]
                  (for-each [^JCTree t (.getTypeAlternatives ut)]
                    (.validateAnnotatedType this t (.-type t)))
                  (set! repeat false))
              (.hasTag enclTr JCTree$Tag/TYPEINTERSECTION)
                (let [it (cast JCTree$JCTypeIntersection enclTr)]
                  (for-each [^JCTree t (.getBounds it)] (.validateAnnotatedType this t (.-type t)))
                  (set! repeat false))
              (or (identical? (.getKind enclTr) Tree$Kind/PRIMITIVE_TYPE)
                  (identical? (.getKind enclTr) Tree$Kind/ERRONEOUS))
                (set! repeat false)
              :else
                (Assert/error (java-str "Unexpected tree: "
                                        enclTr
                                        " with kind: "
                                        (.getKind enclTr)
                                        " within: "
                                        errtree
                                        " with kind: "
                                        (.getKind errtree))))))))

    (method ^:private checkForDeclarationAnnotations ^void [this
                                                            ^{:tag (List (? extends JCTree$JCAnnotation))} annotations
                                                            ^Symbol sym]
      (for-each [^JCTree$JCAnnotation ai annotations]
        (when (and (not (.isErroneous (.-type ai)))
                   (identical? (.annotationTargetType typeAnnotations ai (.-attribute ai) sym)
                               TypeAnnotations$AnnotationType/DECLARATION))
          (.error log
                  (.pos ai)
                  (CompilerProperties$Errors/AnnotationTypeNotApplicableToType (.-type ai)))))))

  (method ^:public postAttr ^void [this ^JCTree tree]
    (.scan (PostAttrAnalyzer.) tree))

  (defclass PostAttrAnalyzer
    :extends TreeScanner

    (method ^:private initTypeIfNeeded ^void [this ^JCTree that]
      (when (nil? (.-type that))
        (if (.hasTag that JCTree$Tag/METHODDEF)
            (set! (.-type that) (.dummyMethodType this (cast JCTree$JCMethodDecl that)))
            (set! (.-type that) (.-unknownType syms)))))

    (method ^:private dummyMethodType ^Type [this ^JCTree$JCMethodDecl md]
      (let [^:mutable restype (.-unknownType syms)]
        (when (and (and (some? md) (some? (.-restype md)))
                   (.hasTag (.-restype md) JCTree$Tag/TYPEIDENT))
          (let [prim (cast JCTree$JCPrimitiveTypeTree (.-restype md))]
            (when (identical? (.-typetag prim) TypeTag/VOID) (set! restype (.-voidType syms)))))
        (Type$MethodType. (List/nil) restype (List/nil) (.-methodClass syms))))

    (method ^:private dummyMethodType ^Type [this]
      (.dummyMethodType this nil))

    (method ^:public scan ^void [this ^JCTree tree]
      (when (some? tree)
        (when (instance? JCTree$JCExpression tree) (.initTypeIfNeeded this tree))
        (.scan super tree)))

    (method ^:public visitIdent ^void [this ^JCTree$JCIdent that]
      (when (nil? (.-sym that)) (set! (.-sym that) (.-unknownSymbol syms))))

    (method ^:public visitSelect ^void [this ^JCTree$JCFieldAccess that]
      (when (nil? (.-sym that)) (set! (.-sym that) (.-unknownSymbol syms)))
      (.visitSelect super that))

    (method ^:public visitClassDef ^void [this ^JCTree$JCClassDecl that]
      (.initTypeIfNeeded this that)
      (when (nil? (.-sym that))
        (set! (.-sym that) (Symbol$ClassSymbol. 0 (.-name that) (.-type that) (.-noSymbol syms))))
      (.visitClassDef super that))

    (method ^:public visitMethodDef ^void [this ^JCTree$JCMethodDecl that]
      (.initTypeIfNeeded this that)
      (when (nil? (.-sym that))
        (set! (.-sym that) (Symbol$MethodSymbol. 0 (.-name that) (.-type that) (.-noSymbol syms))))
      (.visitMethodDef super that))

    (method ^:public visitVarDef ^void [this ^JCTree$JCVariableDecl that]
      (.initTypeIfNeeded this that)
      (when (nil? (.-sym that))
        (set! (.-sym that) (Symbol$VarSymbol. 0 (.-name that) (.-type that) (.-noSymbol syms)))
        (set! (.-adr (.-sym that)) 0))
      (when (nil? (.-vartype that)) (set! (.-vartype that) (.Erroneous (.at make Position/NOPOS))))
      (.visitVarDef super that))

    (method ^:public visitBindingPattern ^void [this ^JCTree$JCBindingPattern that]
      (.initTypeIfNeeded this that)
      (.initTypeIfNeeded this (.-var that))
      (when (nil? (.-sym (.-var that)))
        (set! (.-sym (.-var that))
              (Symbol$BindingSymbol. 0
                                     (.-name (.-var that))
                                     (.-type (.-var that))
                                     (.-noSymbol syms)))
        (set! (.-adr (.-sym (.-var that))) 0))
      (.visitBindingPattern super that))

    (method ^:public visitRecordPattern ^void [this ^JCTree$JCRecordPattern that]
      (.initTypeIfNeeded this that)
      (when (nil? (.-record that))
        (set! (.-record that)
              (Symbol$ClassSymbol. 0
                                   (TreeInfo/name (.-deconstructor that))
                                   (.-type that)
                                   (.-noSymbol syms))))
      (when (nil? (.-fullComponentTypes that)) (set! (.-fullComponentTypes that) (List/nil)))
      (.visitRecordPattern super that))

    (method ^:public visitNewClass ^void [this ^JCTree$JCNewClass that]
      (when (nil? (.-constructor that))
        (set! (.-constructor that)
              (Symbol$MethodSymbol. 0 (.-init names) (.dummyMethodType this) (.-noSymbol syms))))
      (when (nil? (.-constructorType that)) (set! (.-constructorType that) (.-unknownType syms)))
      (.visitNewClass super that))

    (method ^:public visitAssignop ^void [this ^JCTree$JCAssignOp that]
      (when (nil? (.-operator that))
        (set! (.-operator that)
              (Symbol$OperatorSymbol. (.-empty names) (.dummyMethodType this) -1 (.-noSymbol syms))))
      (.visitAssignop super that))

    (method ^:public visitBinary ^void [this ^JCTree$JCBinary that]
      (when (nil? (.-operator that))
        (set! (.-operator that)
              (Symbol$OperatorSymbol. (.-empty names) (.dummyMethodType this) -1 (.-noSymbol syms))))
      (.visitBinary super that))

    (method ^:public visitUnary ^void [this ^JCTree$JCUnary that]
      (when (nil? (.-operator that))
        (set! (.-operator that)
              (Symbol$OperatorSymbol. (.-empty names) (.dummyMethodType this) -1 (.-noSymbol syms))))
      (.visitUnary super that))

    (method ^:public visitReference ^void [this ^JCTree$JCMemberReference that]
      (.visitReference super that)
      (when (nil? (.-sym that))
        (set! (.-sym that)
              (Symbol$MethodSymbol. 0 (.-empty names) (.dummyMethodType this) (.-noSymbol syms))))))

  (method ^:public setPackageSymbols ^void [this ^JCTree$JCExpression pid ^Symbol pkg]
    (.scan (anon TreeScanner []
             (field ^Symbol packge pkg)

             (method ^:public visitIdent ^void [this ^JCTree$JCIdent that]
               (set! (.-sym that) packge))

             (method ^:public visitSelect ^void [this ^JCTree$JCFieldAccess that]
               (set! (.-sym that) packge)
               (set! packge (.-owner packge))
               (.visitSelect super that)))
           pid)))

      (when result (.put equiv (.-sym tree) (.-sym that)))))

  (method ^:public visitWhileLoop ^void [this ^JCTree$JCWhileLoop tree]
    (let [that (cast JCTree$JCWhileLoop parameter)]
      (set! result
            (and (.scan this (.-cond tree) (.-cond that)) (.scan this (.-body tree) (.-body that))))))

  (method ^:public visitWildcard ^void [this ^JCTree$JCWildcard tree]
    (let [that (cast JCTree$JCWildcard parameter)]
      (set! result
            (and (.scan this (.-kind tree) (.-kind that))
                 (.scan this (.-inner tree) (.-inner that)))))))

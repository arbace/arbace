        (set! (.-type select) (.-referentType tree))
        (let [^JCTree$JCExpression apply (.setType
                                           (.Apply make (List/nil) select (.toList args))
                                           (.getReturnType (.-referentType tree)))]
          (TreeInfo/setVarargsElement apply (.-varargsElement tree))
          apply)))

    (method ^:private expressionNew ^JCTree$JCExpression [this]
      (if (identical? (.-kind tree) JCTree$JCMemberReference$ReferenceKind/ARRAY_CTOR)
          (let [newArr (.NewArray make
                                  (.Type make
                                         (.elemtype types (.-type (.getQualifierExpression tree))))
                                  (List/of (.Ident
                                             make
                                             (cast JCTree$JCVariableDecl (.first params))))
                                  nil)]
            (set! (.-type newArr) (.-type (.getQualifierExpression tree)))
            newArr)
          (let [newClass (.NewClass make
                                    nil
                                    (List/nil)
                                    (.Type make (.-type (.getQualifierExpression tree)))
                                    (.toList args)
                                    nil)]
            (set! (.-constructor newClass) (.-sym tree))
            (set! (.-constructorType newClass) (.erasure (.-sym tree) types))
            (set! (.-type newClass) (.-type (.getQualifierExpression tree)))
            (TreeInfo/setVarargsElement newClass (.-varargsElement tree))
            newClass)))

    (method ^:private addParameter ^Symbol$VarSymbol [this ^String name ^Type p ^boolean genArg]
      (let [vsym (Symbol$VarSymbol. (bit-or Flags/PARAMETER Flags/SYNTHETIC)
                                    (.fromString names name)
                                    p
                                    owner)]
        (set! (.-pos vsym) (.-pos tree))
        (.append params (.VarDef make vsym nil))
        (when genArg (.append args (.Ident make vsym)))
        vsym)))

  (method ^:public visitSwitch ^void [this ^JCTree$JCSwitch tree]
    (set! (.-selector tree)
          (cast JCTree$JCExpression
                (.translate this (.-selector tree) (.erasure this (.-type (.-selector tree))))))
    (set! (.-cases tree) (.translateCases this (.-cases tree)))
    (set! (.-result this) tree))

  (method ^:public visitCase ^void [this ^JCTree$JCCase tree]
    (set! (.-labels tree) (.translate this (.-labels tree) nil))
    (set! (.-guard tree)
          (cast JCTree$JCExpression (.translate this (.-guard tree) (.-booleanType syms))))
    (set! (.-stats tree) (.translate this (.-stats tree)))
    (set! (.-result this) tree))

  (method ^:public visitAnyPattern ^void [this ^JCTree$JCAnyPattern tree]
    (set! (.-result this) tree))

  (method ^:public visitBindingPattern ^void [this ^JCTree$JCBindingPattern tree]
    (set! (.-var tree) (cast JCTree$JCVariableDecl (.translate this (.-var tree) nil)))
    (set! (.-result this) tree))

  (method ^:public visitConstantCaseLabel ^void [this ^JCTree$JCConstantCaseLabel tree]
    (set! (.-expr tree) (cast JCTree$JCExpression (.translate this (.-expr tree) nil)))
    (set! (.-result this) tree))

  (method ^:public visitPatternCaseLabel ^void [this ^JCTree$JCPatternCaseLabel tree]
    (set! (.-pat tree) (cast JCTree$JCPattern (.translate this (.-pat tree) nil)))
    (set! (.-result this) tree))

  (method ^:public visitSwitchExpression ^void [this ^JCTree$JCSwitchExpression tree]
    (set! (.-selector tree)
          (cast JCTree$JCExpression
                (.translate this (.-selector tree) (.erasure this (.-type (.-selector tree))))))
    (set! (.-cases tree) (.translate this (.-cases tree) (.erasure this (.-type tree))))
    (set! (.-type tree) (.erasure this (.-type tree)))
    (set! (.-result this) (.retype this tree (.-type tree) pt)))

  (method ^:public visitRecordPattern ^void [this ^JCTree$JCRecordPattern tree]
    (set! (.-fullComponentTypes tree)
          (.map (.getRecordComponents (.-record tree))
                (lambda Function ^Type [^Symbol$RecordComponent rc]
                  (.memberType types (.-type tree) rc))))
    (set! (.-deconstructor tree)
          (cast JCTree$JCExpression (.translate this (.-deconstructor tree) nil)))
    (set! (.-nested tree) (.translate this (.-nested tree) nil))
    (set! (.-result this) tree))

  (method ^:public visitSynchronized ^void [this ^JCTree$JCSynchronized tree]
    (set! (.-lock tree)
          (cast JCTree$JCExpression
                (.translate this (.-lock tree) (.erasure this (.-type (.-lock tree))))))
    (set! (.-body tree) (cast JCTree$JCBlock (.translate this (.-body tree))))
    (set! (.-result this) tree))

  (method ^:public visitTry ^void [this ^JCTree$JCTry tree]
    (set! (.-resources tree) (.translate this (.-resources tree) (.-autoCloseableType syms)))
    (set! (.-body tree) (cast JCTree$JCBlock (.translate this (.-body tree))))
    (set! (.-catchers tree) (.translateCatchers this (.-catchers tree)))
    (set! (.-finalizer tree) (cast JCTree$JCBlock (.translate this (.-finalizer tree))))
    (set! (.-result this) tree))

  (method ^:public visitConditional ^void [this ^JCTree$JCConditional tree]
    (set! (.-cond tree)
          (cast JCTree$JCExpression (.translate this (.-cond tree) (.-booleanType syms))))
    (set! (.-truepart tree)
          (cast JCTree$JCExpression
                (.translate this (.-truepart tree) (.erasure this (.-type tree)))))
    (set! (.-falsepart tree)
          (cast JCTree$JCExpression
                (.translate this (.-falsepart tree) (.erasure this (.-type tree)))))
    (set! (.-type tree) (.erasure this (.-type tree)))
    (set! (.-result this) (.retype this tree (.-type tree) pt)))

  (method ^:public visitIf ^void [this ^JCTree$JCIf tree]
    (set! (.-cond tree)
          (cast JCTree$JCExpression (.translate this (.-cond tree) (.-booleanType syms))))
    (set! (.-thenpart tree) (cast JCTree$JCStatement (.translate this (.-thenpart tree))))
    (set! (.-elsepart tree) (cast JCTree$JCStatement (.translate this (.-elsepart tree))))
    (set! (.-result this) tree))

  (method ^:public visitExec ^void [this ^JCTree$JCExpressionStatement tree]
    (set! (.-expr tree) (cast JCTree$JCExpression (.translate this (.-expr tree) nil)))
    (set! (.-result this) tree))

  (method ^:public visitReturn ^void [this ^JCTree$JCReturn tree]
    (when-not (.hasTag returnType TypeTag/VOID)
      (set! (.-expr tree) (cast JCTree$JCExpression (.translate this (.-expr tree) returnType))))
    (set! (.-result this) tree))

  (method ^:public visitBreak ^void [this ^JCTree$JCBreak tree]
    (set! (.-result this) tree))

  (method ^:public visitYield ^void [this ^JCTree$JCYield tree]
    (set! (.-value tree)
          (cast JCTree$JCExpression
                (.translate this (.-value tree) (.erasure this (.-type (.-value tree))))))
    (set! (.-type (.-value tree)) (.erasure this (.-type (.-value tree))))
    (set! (.-value tree) (.retype this (.-value tree) (.-type (.-value tree)) pt))
    (set! (.-result this) tree))

  (method ^:public visitThrow ^void [this ^JCTree$JCThrow tree]
    (set! (.-expr tree)
          (cast JCTree$JCExpression
                (.translate this (.-expr tree) (.erasure this (.-type (.-expr tree))))))
    (set! (.-result this) tree))

  (method ^:public visitAssert ^void [this ^JCTree$JCAssert tree]
    (set! (.-cond tree)
          (cast JCTree$JCExpression (.translate this (.-cond tree) (.-booleanType syms))))
    (when (some? (.-detail tree))
      (set! (.-detail tree)
            (cast JCTree$JCExpression
                  (.translate this (.-detail tree) (.erasure this (.-type (.-detail tree)))))))
    (set! (.-result this) tree))

  (method ^:public visitApply ^void [this ^JCTree$JCMethodInvocation tree]
    (set! (.-meth tree) (cast JCTree$JCExpression (.translate this (.-meth tree) nil)))
    (let [meth (TreeInfo/symbol (.-meth tree))
          mt (.erasure meth types)
          useInstantiatedPtArgs (not (.isSignaturePolymorphic
                                       types
                                       (cast Symbol$MethodSymbol (.baseSymbol meth))))
          ^:mutable ^{:tag (List Type)} argtypes (if useInstantiatedPtArgs
                                                     (.getParameterTypes (.-type (.-meth tree)))
                                                     (.getParameterTypes mt))]
      (when (and (identical? (.-name meth) (.-init names))
                 (identical? (.-owner meth) (.-enumSym syms)))
        (set! argtypes (.-tail (.-tail argtypes))))
      (if (some? (.-varargsElement tree))
          (set! (.-varargsElement tree) (.erasure types (.-varargsElement tree)))
          (when-not (== (.length (.-args tree)) (.length argtypes))
            (Assert/error (String/format
                            "Incorrect number of arguments; expected %d, found %d"
                            (new Object/1 [(.length (.-args tree)) (.length argtypes)])))))
      (set! (.-args tree) (.translateArgs this (.-args tree) argtypes (.-varargsElement tree)))
      (set! (.-type tree) (.erasure types (.-type tree)))
      (set! (.-result this) (.retype this tree (.getReturnType mt) pt))))

  (method ^:public visitNewClass ^void [this ^JCTree$JCNewClass tree]
    (when (some? (.-encl tree))
      (if (nil? (.-def tree))
          (set! (.-encl tree)
                (cast JCTree$JCExpression
                      (.translate this (.-encl tree) (.erasure this (.-type (.-encl tree))))))
          (do
            (set! (.-args tree) (.prepend (.-args tree) (.makeNullCheck attr (.-encl tree))))
            (set! (.-encl tree) nil))))
    (let [^Type erasedConstructorType (when (some? (.-constructorType tree))
                                        (.erasure this (.-constructorType tree)))
          ^{:tag (List Type)} argtypes (if (some? erasedConstructorType)
                                           (.getParameterTypes erasedConstructorType)
                                           (.getParameterTypes
                                             (.erasure (.-constructor tree) types)))]
      (set! (.-clazz tree) (cast JCTree$JCExpression (.translate this (.-clazz tree) nil)))
      (when (some? (.-varargsElement tree))
        (set! (.-varargsElement tree) (.erasure types (.-varargsElement tree))))
      (set! (.-args tree) (.translateArgs this (.-args tree) argtypes (.-varargsElement tree)))
      (set! (.-def tree) (cast JCTree$JCClassDecl (.translate this (.-def tree) nil)))
      (when (some? erasedConstructorType) (set! (.-constructorType tree) erasedConstructorType))
      (set! (.-type tree) (.erasure this (.-type tree)))
      (set! (.-result this) tree)))

  (method ^:public visitNewArray ^void [this ^JCTree$JCNewArray tree]
    (set! (.-elemtype tree) (cast JCTree$JCExpression (.translate this (.-elemtype tree) nil)))
    (.translate this (.-dims tree) (.-intType syms))
    (if (some? (.-type tree))
        (do
          (set! (.-elems tree)
                (.translate this (.-elems tree) (.erasure this (.elemtype types (.-type tree)))))
          (set! (.-type tree) (.erasure this (.-type tree))))
        (set! (.-elems tree) (.translate this (.-elems tree) nil)))
    (set! (.-result this) tree))

  (method ^:public visitParens ^void [this ^JCTree$JCParens tree]
    (set! (.-expr tree) (cast JCTree$JCExpression (.translate this (.-expr tree) pt)))
    (set! (.-type tree) (.erasure this (.-type (.-expr tree))))
    (set! (.-result this) tree))

  (method ^:public visitAssign ^void [this ^JCTree$JCAssign tree]
    (set! (.-lhs tree) (cast JCTree$JCExpression (.translate this (.-lhs tree) nil)))
    (set! (.-rhs tree)
          (cast JCTree$JCExpression
                (.translate this (.-rhs tree) (.erasure this (.-type (.-lhs tree))))))
    (set! (.-type tree) (.erasure this (.-type (.-lhs tree))))
    (set! (.-result this) (.retype this tree (.-type tree) pt)))

  (method ^:public visitAssignop ^void [this ^JCTree$JCAssignOp tree]
    (set! (.-lhs tree) (cast JCTree$JCExpression (.translate this (.-lhs tree) nil)))
    (set! (.-rhs tree)
          (cast JCTree$JCExpression
                (.translate
                  this
                  (.-rhs tree)
                  (cast Type (.-head (.-tail (.getParameterTypes (.-type (.-operator tree)))))))))
    (set! (.-type tree) (.erasure this (.-type tree)))
    (set! (.-result this) tree))

  (method ^:public visitUnary ^void [this ^JCTree$JCUnary tree]
    (set!
      (.-arg tree)
      (cast JCTree$JCExpression
            (.translate this
                        (.-arg tree)
                        ^Type (if (identical? (.getTag tree) JCTree$Tag/NULLCHK)
                                  (.-type tree)
                                  (cast Type
                                        (.-head (.getParameterTypes (.-type (.-operator tree)))))))))
    (set! (.-result this) tree))

  (method ^:public visitBinary ^void [this ^JCTree$JCBinary tree]
    (set! (.-lhs tree)
          (cast JCTree$JCExpression
                (.translate this
                            (.-lhs tree)
                            (cast Type (.-head (.getParameterTypes (.-type (.-operator tree))))))))
    (set! (.-rhs tree)
          (cast JCTree$JCExpression
                (.translate
                  this
                  (.-rhs tree)
                  (cast Type (.-head (.-tail (.getParameterTypes (.-type (.-operator tree)))))))))
    (set! (.-result this) tree))

  (method ^:public visitAnnotatedType ^void [this ^JCTree$JCAnnotatedType tree]
    (let [^{:tag (List Attribute$TypeCompound)} mirrors (.fromAnnotations
                                                          annotate
                                                          (.-annotations tree))]
      (set! (.-underlyingType tree)
            (cast JCTree$JCExpression (.translate this (.-underlyingType tree))))
      (set! (.-type tree) (.annotatedType (.-type (.-underlyingType tree)) mirrors))
      (set! (.-result this) tree)))

  (method ^:public visitTypeCast ^void [this ^JCTree$JCTypeCast tree]
    (set! (.-clazz tree) (.translate this (.-clazz tree) nil))
    (let [originalTarget (.-type tree)]
      (set! (.-type tree) (.erasure this (.-type tree)))
      (let [newExpression (cast JCTree$JCExpression (.translate this (.-expr tree) (.-type tree)))]
        (when-not (identical? newExpression (.-expr tree))
          (let [^JCTree$JCTypeCast typeCast (when (.hasTag newExpression JCTree$Tag/TYPECAST)
                                              (cast JCTree$JCTypeCast newExpression))]
            (set! (.-expr tree)
                  (if (and (some? typeCast) (.isSameType types (.-type typeCast) (.-type tree)))
                      (.-expr typeCast)
                      newExpression))))
        (when (.isIntersection originalTarget)
          (let [ict (cast Type$IntersectionClassType originalTarget)]
            (for-each [^Type c (.getExplicitComponents ict)]
              (let [ec (.erasure this c)]
                (when (and (not (.isSameType types ec (.-type tree)))
                           (not (.isSameType types ec pt)))
                  (set! (.-expr tree) (.coerce this (.-expr tree) ec)))))))
        (set! (.-result this) (.retype this tree (.-type tree) pt)))))

  (method ^:public visitTypeTest ^void [this ^JCTree$JCInstanceOf tree]
    (set! (.-pattern tree) (.translate this (.-pattern tree) nil))
    (if (.isPrimitive (.-type (.-pattern tree)))
        (do
          (set! (.-erasedExprOriginalType tree) (.erasure this (.-type (.-expr tree))))
          (set! (.-expr tree) (cast JCTree$JCExpression (.translate this (.-expr tree) nil))))
        (set! (.-expr tree) (cast JCTree$JCExpression (.translate this (.-expr tree) nil))))
    (set! (.-result this) tree))

  (method ^:public visitIndexed ^void [this ^JCTree$JCArrayAccess tree]
    (set! (.-indexed tree)
          (cast JCTree$JCExpression
                (.translate this (.-indexed tree) (.erasure this (.-type (.-indexed tree))))))
    (set! (.-index tree)
          (cast JCTree$JCExpression (.translate this (.-index tree) (.-intType syms))))
    (set! (.-result this) (.retype this tree (.elemtype types (.-type (.-indexed tree))) pt)))

  (method ^:public visitAnnotation ^void [this ^JCTree$JCAnnotation tree]
    (set! (.-result this) tree))

  (method ^:public visitIdent ^void [this ^JCTree$JCIdent tree]
    (let [et (.erasure (.-sym tree) types)]
      (cond
        (and (identical? (.-kind (.-sym tree)) Kinds$Kind/TYP)
             (.hasTag (.-type (.-sym tree)) TypeTag/TYPEVAR))
          (set! (.-result this) (.Type (.at make (.-pos tree)) et))
        (some? (.constValue (.-type tree))) (set! (.-result this) tree)
        (identical? (.-kind (.-sym tree)) Kinds$Kind/VAR)
          (set! (.-result this) (.retype this tree et pt))
        :else (do (set! (.-type tree) (.erasure this (.-type tree))) (set! (.-result this) tree)))))

  (method ^:public visitSelect ^void [this ^JCTree$JCFieldAccess tree]
    (let [t (.skipTypeVars types (.-type (.-selected tree)) false)]
      (if (.isCompound t)
          (set! (.-selected tree)
                (.coerce this
                         (cast JCTree$JCExpression
                               (.translate this
                                           (.-selected tree)
                                           (.erasure this (.-type (.-selected tree)))))
                         (.erasure this (.-type (.-owner (.-sym tree))))))
          (set! (.-selected tree)
                (cast JCTree$JCExpression (.translate this (.-selected tree) (.erasure this t)))))
      (cond
        (some? (.constValue (.-type tree))) (set! (.-result this) tree)
        (identical? (.-kind (.-sym tree)) Kinds$Kind/VAR)
          (set! (.-result this) (.retype this tree (.erasure (.-sym tree) types) pt))
        :else (do (set! (.-type tree) (.erasure this (.-type tree))) (set! (.-result this) tree)))))

  (method ^:public visitTypeArray ^void [this ^JCTree$JCArrayTypeTree tree]
    (set! (.-elemtype tree) (cast JCTree$JCExpression (.translate this (.-elemtype tree) nil)))
    (set! (.-type tree) (.erasure this (.-type tree)))
    (set! (.-result this) tree))

  (method ^:public visitTypeApply ^void [this ^JCTree$JCTypeApply tree]
    (let [clazz (.translate this (.-clazz tree) nil)] (set! (.-result this) clazz)))

  (method ^:public visitTypeIntersection ^void [this ^JCTree$JCTypeIntersection tree]
    (set! (.-result this) (.translate this (cast JCTree$JCExpression (.-head (.-bounds tree))) nil)))

  (method ^:private erasure ^Type [this ^Type t] (.erasure types t))

  (field ^:private ^{:tag (Env AttrContext)} env)

  (field ^:private ^:static ^:final ^String statePreviousToFlowAssertMsg
    "The current compile state [%s] of class %s is previous to WARN")

  (method translateClass ^void [this ^Symbol$ClassSymbol c]
    (let [st (.supertype types (.-type c))]
      (when (.hasTag st TypeTag/CLASS) (.translateClass this (cast Symbol$ClassSymbol (.-tsym st))))
      (let [^{:tag (Env AttrContext)} myEnv (.getEnv enter c)]
        (when-not (or (nil? myEnv) (not (== (bit-and (.-flags_field c) Flags/TYPE_TRANSLATED) 0)))
          (set! (.-flags_field c) (bit-or (.-flags_field c) Flags/TYPE_TRANSLATED))
          (let [envHasCompState (some? (.get compileStates myEnv))]
            (when (and (not envHasCompState) (identical? (.outermostClass c) c))
              (Assert/error (java-str "No info for outermost class: " (.-sym (.-enclClass myEnv)))))
            (when (and envHasCompState
                       (.isAfter CompileStates$CompileState/WARN
                                 (cast CompileStates$CompileState (.get compileStates myEnv))))
              (Assert/error (String/format statePreviousToFlowAssertMsg
                                           (new Object/1
                                                [(.get compileStates myEnv)
                                                 (.-sym (.-enclClass myEnv))]))))
            (let [^{:tag (Env AttrContext)} oldEnv env]
              (try
                (set! env myEnv)
                (let [savedMake make
                      savedPt pt]
                  (set! make (.forToplevel make (.-toplevel env)))
                  (set! pt nil)
                  (try
                    (let [tree (cast JCTree$JCClassDecl (.-tree env))]
                      (set! (.-typarams tree) (List/nil))
                      (.visitClassDef super tree)
                      (.at make (.-pos tree))
                      (let [^{:tag (ListBuffer JCTree)} bridges (ListBuffer.)]
                        (.addBridges this (.pos tree) c bridges)
                        (set! (.-defs tree) (.prependList (.toList bridges) (.-defs tree)))
                        (set! (.-type tree) (.erasure this (.-type tree)))))
                    (finally (set! make savedMake) (set! pt savedPt))))
                (finally (set! env oldEnv)))))))))

  (method ^:public translateTopLevelClass ^JCTree [this ^JCTree cdef ^TreeMaker make]
    (set! (.-make this) make)
    (set! pt nil)
    (.translate this cdef nil)))

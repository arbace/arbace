  (defclass ReachabilityVisitor
    :extends (Types$UnaryVisitor Void)

    (field ^{:tag (Set Type)} equiv (LinkedHashSet.))

    (field ^{:tag (Set Type)} min (LinkedHashSet.))

    (field ^{:tag (Map Type (Set Type))} minMap (LinkedHashMap.))

    (method scan ^void [this ^{:tag (List Type)} roots]
      (.forEach roots (method-ref Consumer [Type] this ReachabilityVisitor/.visit)))

    (method ^:public visitType ^Void [this ^Type t ^Void _unused] nil)

    (method ^:public visitUndetVar ^Void [this ^Type$UndetVar t ^Void _unused]
      (when (.add min (.-qtype t))
        (let [^{:tag (Set Type)} deps (cast Set
                                            (.getOrDefault
                                              minMap
                                              (.-qtype t)
                                              (LinkedHashSet. (Collections/singleton (.-qtype t)))))]
          (for-each [^Type$UndetVar$InferenceBound boundKind (Type$UndetVar$InferenceBound/values)]
            (for-each [^Type b (.getBounds t boundKind)]
              (let [undet (.asUndetVar InferenceContext/this b)]
                (cond
                  (not (.hasTag undet TypeTag/UNDETVAR)) (.visit this undet)
                  (.isEquiv this t b boundKind) (do (.add deps b) (.add equiv b))
                  :else (.visit this undet)))))
          (.put minMap (.-qtype t) deps)))
      nil)

    (method ^:public visitWildcardType ^Void [this ^Type$WildcardType t ^Void _unused]
      (cast Void (.visit this (.-type t))))

    (method ^:public visitTypeVar ^Void [this ^Type$TypeVar t ^Void aVoid]
      (let [undet (.asUndetVar InferenceContext/this t)]
        (when (.hasTag undet TypeTag/UNDETVAR) (.visitUndetVar this (cast Type$UndetVar undet) nil))
        nil))

    (method ^:public visitArrayType ^Void [this ^Type$ArrayType t ^Void _unused]
      (cast Void (.visit this (.-elemtype t))))

    (method ^:public visitClassType ^Void [this ^Type$ClassType t ^Void _unused]
      (.visit this (.getEnclosingType t))
      (for-each [^Type targ (.getTypeArguments t)] (.visit this targ))
      nil)

    (method isEquiv ^boolean [this ^Type$UndetVar from ^Type t
                              ^Type$UndetVar$InferenceBound boundKind]
      (let [uv (cast Type$UndetVar (.asUndetVar InferenceContext/this t))]
        (for-each [^Type$UndetVar$InferenceBound ib (Type$UndetVar$InferenceBound/values)]
          (let [^:mutable ^{:tag (List Type)} b1 (.getBounds from ib)]
            (when (identical? ib boundKind) (set! b1 (.diff b1 (List/of t))))
            (let [^:mutable ^{:tag (List Type)} b2 (.getBounds uv ib)]
              (when (identical? ib (.complement boundKind))
                (set! b2 (.diff b2 (List/of (.-qtype from)))))
              (when (or (not (.containsAll b1 b2)) (not (.containsAll b2 b1))) (return false)))))
        true)))

  (method ^:private solve ^void [this ^Infer$GraphStrategy ss ^Warner warn]
    (let [s (.new infer Infer$GraphSolver this warn)] (.solve s ss)))

  (method ^:public solve ^void [this ^Warner warn]
    (.solve this
            (anon Infer$LeafSolver [] :outer infer
              (method ^:public done ^boolean [this]
                (.isEmpty (.restvars InferenceContext/this))))
            warn))

  (method ^:public solve ^void [this ^:final ^{:tag (List Type)} vars ^Warner warn]
    (.solve this
            (anon Infer$BestLeafSolver [vars] :outer infer
              (method ^:public done ^boolean [this]
                (not (.free InferenceContext/this (.asInstTypes InferenceContext/this vars)))))
            warn))

  (method ^:public solveAny ^void [this ^{:tag (List Type)} varsToSolve ^Warner warn]
    (.solve this
            (anon Infer$BestLeafSolver [(.intersect varsToSolve (.restvars this))] :outer infer
              (method ^:public done ^boolean [this]
                (.nonEmpty (.intersect (.instvars InferenceContext/this) (.-varsToSolve this)))))
            warn))

  (method solveBasic ^{:tag (List Type)} [this ^{:tag (List Type)} varsToSolve
                                          ^{:tag (EnumSet Infer$InferenceStep)} steps]
    (let [^{:tag (ListBuffer Type)} solvedVars (ListBuffer.)]
      (for-each [^Type t (.intersect varsToSolve (.restvars this))]
        (let [uv (cast Type$UndetVar (.asUndetVar this t))]
          (for-each [^Infer$InferenceStep step steps]
            (when (.accepts step uv this)
              (.setInst uv (.solve step uv this))
              (.add solvedVars (.-qtype uv))
              (break)))))
      (.toList solvedVars)))


  (method ^:private checkSourceLocation ^void [this ^JCTree$JCCompilationUnit tree
                                               ^Symbol$ModuleSymbol msym]
    (try
      (let [fo (.-sourcefile tree)]
        (when (.contains fileManager (.-sourceLocation msym) fo) (return))
        (when (and (some? (.-patchLocation msym)) (.contains fileManager (.-patchLocation msym) fo))
          (return))
        (cond
          (.hasLocation fileManager StandardLocation/SOURCE_OUTPUT)
            (when (.contains fileManager StandardLocation/SOURCE_OUTPUT fo) (return))
          (.contains fileManager StandardLocation/CLASS_OUTPUT fo) (return)))
      (catch IOException e (throw (Error. e))))
    (let [prev (.useSource log (.-sourcefile tree))]
      (try
        (.error log (.pos tree) CompilerProperties$Errors/FileSbOnSourceOrPatchPathForModule)
        (finally (.useSource log prev)))))

  (method ^:private singleModuleOverride ^String [this ^{:tag (List JCTree$JCCompilationUnit)} trees]
    (when-not (not (.hasLocation fileManager StandardLocation/PATCH_MODULE_PATH))
      (let [^{:tag (Set String)} override (LinkedHashSet.)]
        (for-each [^JCTree$JCCompilationUnit tree trees]
          (let [fo (.-sourcefile tree)]
            (try
              (let [loc (.getLocationForModule fileManager StandardLocation/PATCH_MODULE_PATH fo)]
                (when (some? loc) (.add override (.inferModuleName fileManager loc))))
              (catch IOException ex (throw (Error. ex))))))
        (switch (.size override)
          0 nil
          1 (cast String (.next (.iterator override)))
          (do (.error log (CompilerProperties$Errors/TooManyPatchedModules override)) nil)))))

  (method ^:private getModuleLocation :throws [IOException] ^JavaFileManager$Location [this
                                                                                       ^JCTree$JCCompilationUnit tree]
    (let [fo (.-sourcefile tree)
          ^:mutable loc (.getLocationForModule fileManager StandardLocation/MODULE_SOURCE_PATH fo)]
      (when (nil? loc)
        (let [^JavaFileManager$Location sourceOutput (if (.hasLocation
                                                           fileManager
                                                           StandardLocation/SOURCE_OUTPUT)
                                                         StandardLocation/SOURCE_OUTPUT
                                                         StandardLocation/CLASS_OUTPUT)]
          (set! loc (.getLocationForModule fileManager sourceOutput fo))))
      loc))

  (method ^:private checkNoAllModulePath ^void [this]
    (when (and (some? addModsOpt)
               (.contains (Arrays/asList (.split addModsOpt ",")) ALL_MODULE_PATH))
      (.error log CompilerProperties$Errors/AddmodsAllModulePathInvalid)))

  (field ^:private ^:final ^Symbol$Completer mainCompleter
    (anon Symbol$Completer []
      (method ^:public complete :throws [Symbol$CompletionFailure] ^void [this ^Symbol sym]
        (let [msym (.findModule moduleFinder (cast Symbol$ModuleSymbol sym))]
          (cond
            (identical? (.-kind msym) Kinds$Kind/ERR) (.initErrModule this msym)
            (not (== (bit-and (.-flags_field msym) Flags/AUTOMATIC_MODULE) 0))
              (.setupAutomaticModule Modules/this msym)
            :else
              (try
                (.complete (.-module_info msym))
                (catch Symbol$CompletionFailure cf
                  (set! (.-kind msym) Kinds$Kind/ERR)
                  (.initErrModule this msym)
                  (.completeModule Modules/this msym)
                  (throw cf))))
          (when (or (nil? (.-classfile (.-module_info msym)))
                    (identical? (.getKind (.-classfile (.-module_info msym)))
                                JavaFileObject$Kind/CLASS))
            (.completeModule Modules/this msym))))

      (method ^:private initErrModule ^void [this ^Symbol$ModuleSymbol msym]
        (set! (.-directives msym) (List/nil))
        (set! (.-exports msym) (List/nil))
        (set! (.-provides msym) (List/nil))
        (set! (.-requires msym) (List/nil))
        (set! (.-uses msym) (List/nil)))

      (method ^:public toString ^String [this] "mainCompleter")))

  (method ^:private setupAutomaticModule :throws [Symbol$CompletionFailure] ^void [this
                                                                                   ^Symbol$ModuleSymbol msym]
    (try
      (let [^{:tag (ListBuffer Directive)} directives (ListBuffer.)
            ^{:tag (ListBuffer Directive$ExportsDirective)} exports (ListBuffer.)
            ^{:tag (Set String)} seenPackages (HashSet.)]
        (for-each [^JavaFileObject clazz (.list fileManager
                                                (.-classLocation msym)
                                                ""
                                                (EnumSet/of JavaFileObject$Kind/CLASS)
                                                true)]
          (let [binName (.inferBinaryName fileManager (.-classLocation msym) clazz)
                ^String pack (if (not (== (.lastIndexOf binName \.) -1))
                                 (.substring binName 0 (.lastIndexOf binName \.))
                                 "")]
            (when (.add seenPackages pack)
              (let [d (Directive$ExportsDirective.
                        (.enterPackage syms msym (.fromString names pack))
                        nil)]
                (.add directives d)
                (.add exports d)))))
        (set! (.-exports msym) (.toList exports))
        (set! (.-provides msym) (List/nil))
        (set! (.-requires msym) (List/nil))
        (set! (.-uses msym) (List/nil))
        (set! (.-directives msym) (.toList directives)))
      (catch IOException ex (throw (IllegalStateException. ex)))))

  (method ^:private completeAutomaticModule :throws [Symbol$CompletionFailure] ^void [this
                                                                                      ^Symbol$ModuleSymbol msym]
    (let [^{:tag (ListBuffer Directive)} directives (ListBuffer.)]
      (.addAll directives (.-directives msym))
      (let [^{:tag (ListBuffer Directive$RequiresDirective)} requires (ListBuffer.)]
        (for-each [^Symbol$ModuleSymbol ms (.allModules this)]
          (when-not (or (identical? ms (.-unnamedModule syms)) (identical? ms msym))
            (let [^{:tag (Set Directive$RequiresFlag)} flags (if (not
                                                                   (==
                                                                     (bit-and
                                                                       (.-flags_field ms)
                                                                       Flags/AUTOMATIC_MODULE)
                                                                     0))
                                                                 ^Set (EnumSet/of
                                                                        Directive$RequiresFlag/TRANSITIVE)
                                                                 ^Set (EnumSet/noneOf
                                                                        Directive$RequiresFlag))
                  d (Directive$RequiresDirective. ms flags)]
              (.add directives d)
              (.add requires d))))
        (let [requiresUnnamed (Directive$RequiresDirective. (.-unnamedModule syms))]
          (.add directives requiresUnnamed)
          (.add requires requiresUnnamed)
          (set! (.-requires msym) (.toList requires))
          (set! (.-directives msym) (.toList directives))))))

  (method ^:private getSourceCompleter ^Symbol$Completer [this ^JCTree$JCCompilationUnit tree]
    (anon Symbol$Completer []
      (method ^:public complete :throws [Symbol$CompletionFailure] ^void [this ^Symbol sym]
        (let [msym (cast Symbol$ModuleSymbol sym)]
          (set! (.-flags_field msym) (bit-or (.-flags_field msym) Flags/UNATTRIBUTED))
          (let [v (ModuleVisitor.)
                prev (.useSource log (.-sourcefile tree))
                moduleDecl (.getModuleDecl tree)]
            (try
              (.accept moduleDecl v)
              (.completeModule Modules/this msym)
              (.checkCyclicDependencies Modules/this moduleDecl)
              (finally
                (.useSource log prev)
                (set! (.-flags_field msym)
                      (bit-and (.-flags_field msym) (bit-not-int Flags/UNATTRIBUTED))))))))

      (method ^:public toString ^String [this]
        (java-str "SourceCompleter: " (.getName (.-sourcefile tree))))))

  (method ^:public isRootModule ^boolean [this ^Symbol$ModuleSymbol module]
    (Assert/checkNonNull rootModules)
    (.contains rootModules module))

  (method ^:public getRootModules ^{:tag (Set Symbol$ModuleSymbol)} [this]
    (Assert/checkNonNull rootModules)
    rootModules)

  (defclass ModuleVisitor
    :extends JCTree$Visitor

    (field ^:private ^Symbol$ModuleSymbol sym)

    (field ^:private ^:final ^{:tag (Set Symbol$ModuleSymbol)} allRequires (HashSet.))

    (field ^:private ^:final ^{:tag (Map Symbol$PackageSymbol (List Directive$ExportsDirective))} allExports
      (HashMap.))

    (field ^:private ^:final ^{:tag (Map Symbol$PackageSymbol (List Directive$OpensDirective))} allOpens
      (HashMap.))

    (method ^:public visitModuleDef ^void [this ^JCTree$JCModuleDecl tree]
      (set! sym (cast Symbol$ModuleSymbol (Assert/checkNonNull (.-sym tree))))
      (when (identical? (.getModuleType tree) ModuleTree$ModuleKind/OPEN)
        (.add (.-flags sym) Symbol$ModuleFlags/OPEN))
      (set! (.-flags_field sym)
            (bit-or (.-flags_field sym) (bit-and (.-flags (.-mods tree)) Flags/DEPRECATED)))
      (set! (.-requires sym) (List/nil))
      (set! (.-exports sym) (List/nil))
      (set! (.-opens sym) (List/nil))
      (.forEach (.-directives tree)
                (lambda Consumer ^void [^JCTree$JCDirective t] (.accept t this)))
      (set! (.-requires sym) (.reverse (.-requires sym)))
      (set! (.-exports sym) (.reverse (.-exports sym)))
      (set! (.-opens sym) (.reverse (.-opens sym)))
      (.ensureJavaBase this))

    (method ^:public visitRequires ^void [this ^JCTree$JCRequires tree]
      (let [msym (.lookupModule this (.-moduleName tree))]
        (cond
          (not (identical? (.-kind msym) Kinds$Kind/MDL))
            (do
              (.error log
                      (.pos (.-moduleName tree))
                      (CompilerProperties$Errors/ModuleNotFound msym))
              (.add warnedMissing msym))
          (.contains allRequires msym)
            (.error log
                    (.pos (.-moduleName tree))
                    (CompilerProperties$Errors/DuplicateRequires msym))
          :else
            (do
              (.add allRequires msym)
              (let [^{:tag (Set Directive$RequiresFlag)} flags (EnumSet/noneOf
                                                                 Directive$RequiresFlag)]
                (when (.-isTransitive tree)
                  (when (and (identical? msym (.-java_base syms))
                             (not (.participatesInPreview preview syms sym)))
                    (when (>= (.compareTo source Source/JDK10) 0)
                      (.checkSourceLevel preview (.pos tree) Source$Feature/JAVA_BASE_TRANSITIVE)))
                  (.add flags Directive$RequiresFlag/TRANSITIVE))
                (when (.-isStaticPhase tree)
                  (if (and (identical? msym (.-java_base syms))
                           (>= (.compareTo source Source/JDK10) 0))
                      (.error log
                              (.pos tree)
                              (CompilerProperties$Errors/ModNotAllowedHere
                                (EnumSet/of FlagsEnum/STATIC)))
                      (.add flags Directive$RequiresFlag/STATIC_PHASE)))
                (let [d (Directive$RequiresDirective. msym flags)]
                  (set! (.-directive tree) d)
                  (set! (.-requires sym) (.prepend (.-requires sym) d))))))))

    (method ^:public visitExports ^void [this ^JCTree$JCExports tree]
      (let [name (TreeInfo/fullName (.-qualid tree))
            packge (.enterPackage syms sym name)]
        (.setPackageSymbols attr (.-qualid tree) packge)
        (let [^{:tag (List Directive$ExportsDirective)} exportsForPackage (cast
                                                                            List
                                                                            (.computeIfAbsent
                                                                              allExports
                                                                              packge
                                                                              (lambda Function ^List [^Symbol$PackageSymbol p]
                                                                                (List/nil))))]
          (for-each [^Directive$ExportsDirective d exportsForPackage]
            (.reportExportsConflict this tree packge))
          (let [^:mutable ^{:tag (List Symbol$ModuleSymbol)} toModules nil]
            (when (some? (.-moduleNames tree))
              (let [^{:tag (Set Symbol$ModuleSymbol)} to (LinkedHashSet.)]
                (for-each [^JCTree$JCExpression n (.-moduleNames tree)]
                  (let [msym (.lookupModule this n)]
                    (.checkModuleExists chk (.pos n) msym)
                    (for-each [^Directive$ExportsDirective d exportsForPackage]
                      (.checkDuplicateExportsToModule this n msym d))
                    (when-not (.add to msym) (.reportExportsConflictToModule this n msym))))
                (set! toModules (List/from to))))
            (when (or (nil? toModules) (not (.isEmpty toModules)))
              (let [^{:tag (Set Directive$ExportsFlag)} flags (EnumSet/noneOf Directive$ExportsFlag)
                    d (Directive$ExportsDirective. packge toModules flags)]
                (set! (.-exports sym) (.prepend (.-exports sym) d))
                (set! (.-directive tree) d)
                (.put allExports packge (.prepend exportsForPackage d))))))))

    (method ^:private reportExportsConflict ^void [this ^JCTree$JCExports tree
                                                   ^Symbol$PackageSymbol packge]
      (.error log (.pos (.-qualid tree)) (CompilerProperties$Errors/ConflictingExports packge)))

    (method ^:private checkDuplicateExportsToModule ^void [this ^JCTree$JCExpression name
                                                           ^Symbol$ModuleSymbol msym
                                                           ^Directive$ExportsDirective d]
      (when (some? (.-modules d))
        (for-each [^Symbol$ModuleSymbol other (.-modules d)]
          (when (identical? msym other) (.reportExportsConflictToModule this name msym)))))

    (method ^:private reportExportsConflictToModule ^void [this ^JCTree$JCExpression name
                                                           ^Symbol$ModuleSymbol msym]
      (.error log (.pos name) (CompilerProperties$Errors/ConflictingExportsToModule msym)))

    (method ^:public visitOpens ^void [this ^JCTree$JCOpens tree]
      (let [name (TreeInfo/fullName (.-qualid tree))
            packge (.enterPackage syms sym name)]
        (.setPackageSymbols attr (.-qualid tree) packge)
        (when (.contains (.-flags sym) Symbol$ModuleFlags/OPEN)
          (.error log (.pos tree) CompilerProperties$Errors/NoOpensUnlessStrong))
        (let [^{:tag (List Directive$OpensDirective)} opensForPackage (cast
                                                                        List
                                                                        (.computeIfAbsent
                                                                          allOpens
                                                                          packge
                                                                          (lambda Function ^List [^Symbol$PackageSymbol p]
                                                                            (List/nil))))]
          (for-each [^Directive$OpensDirective d opensForPackage]
            (.reportOpensConflict this tree packge))
          (let [^:mutable ^{:tag (List Symbol$ModuleSymbol)} toModules nil]
            (when (some? (.-moduleNames tree))
              (let [^{:tag (Set Symbol$ModuleSymbol)} to (LinkedHashSet.)]
                (for-each [^JCTree$JCExpression n (.-moduleNames tree)]
                  (let [msym (.lookupModule this n)]
                    (.checkModuleExists chk (.pos n) msym)
                    (for-each [^Directive$OpensDirective d opensForPackage]
                      (.checkDuplicateOpensToModule this n msym d))
                    (when-not (.add to msym) (.reportOpensConflictToModule this n msym))))
                (set! toModules (List/from to))))
            (when (or (nil? toModules) (not (.isEmpty toModules)))
              (let [^{:tag (Set Directive$OpensFlag)} flags (EnumSet/noneOf Directive$OpensFlag)
                    d (Directive$OpensDirective. packge toModules flags)]
                (set! (.-opens sym) (.prepend (.-opens sym) d))
                (set! (.-directive tree) d)
                (.put allOpens packge (.prepend opensForPackage d))))))))

    (method ^:private reportOpensConflict ^void [this ^JCTree$JCOpens tree
                                                 ^Symbol$PackageSymbol packge]
      (.error log (.pos (.-qualid tree)) (CompilerProperties$Errors/ConflictingOpens packge)))

    (method ^:private checkDuplicateOpensToModule ^void [this ^JCTree$JCExpression name
                                                         ^Symbol$ModuleSymbol msym
                                                         ^Directive$OpensDirective d]
      (when (some? (.-modules d))
        (for-each [^Symbol$ModuleSymbol other (.-modules d)]
          (when (identical? msym other) (.reportOpensConflictToModule this name msym)))))

    (method ^:private reportOpensConflictToModule ^void [this ^JCTree$JCExpression name
                                                         ^Symbol$ModuleSymbol msym]
      (.error log (.pos name) (CompilerProperties$Errors/ConflictingOpensToModule msym)))

    (method ^:public visitProvides ^void [this ^JCTree$JCProvides tree])

    (method ^:public visitUses ^void [this ^JCTree$JCUses tree])

    (method ^:private ensureJavaBase ^void [this]
      (when-not (identical? (.-name sym) (.-java_base names))
        (for-each [^Directive$RequiresDirective d (.-requires sym)]
          (when (identical? (.-name (.-module d)) (.-java_base names)) (return)))
        (let [java_base (.enterModule syms (.-java_base names))
              d (Directive$RequiresDirective. java_base
                                              (EnumSet/of Directive$RequiresFlag/MANDATED))]
          (set! (.-requires sym) (.prepend (.-requires sym) d)))))

    (method ^:private lookupModule ^Symbol$ModuleSymbol [this ^JCTree$JCExpression moduleName]
      (let [name (TreeInfo/fullName moduleName)
            msym (.findModule moduleFinder name)]
        (TreeInfo/setSymbol moduleName msym)
        msym)))

  (method ^:public getUsesProvidesCompleter ^Symbol$Completer [this]
    (lambda Symbol$Completer ^void [^Symbol sym]
      (let [msym (cast Symbol$ModuleSymbol sym)]
        (.complete msym)
        (let [^{:tag (Env AttrContext)} env (.get typeEnvs msym)
              v (UsesProvidesVisitor. msym env)
              prev (.useSource log (.-sourcefile (.-toplevel env)))
              decl (.getModuleDecl (.-toplevel env))]
          (try (.accept decl v) (finally (.useSource log prev)))))))

  (defclass UsesProvidesVisitor
    :extends JCTree$Visitor

    (field ^:private ^:final ^Symbol$ModuleSymbol msym)

    (field ^:private ^:final ^{:tag (Env AttrContext)} env)

    (field ^:private ^:final ^{:tag (Set Symbol$ClassSymbol)} allUses (HashSet.))

    (field ^:private ^:final ^{:tag (Map Symbol$ClassSymbol (Set Symbol$ClassSymbol))} allProvides
      (HashMap.))

    (constructor ^:public [this ^Symbol$ModuleSymbol msym ^{:tag (Env AttrContext)} env]
      (set! (.-msym this) msym)
      (set! (.-env this) env))

    (method ^:public visitModuleDef ^void [this ^JCTree$JCModuleDecl tree]
      (set! (.-directives msym) (List/nil))
      (set! (.-provides msym) (List/nil))
      (set! (.-uses msym) (List/nil))
      (.forEach (.-directives tree)
                (lambda Consumer ^void [^JCTree$JCDirective t] (.accept t this)))
      (set! (.-directives msym) (.reverse (.-directives msym)))
      (set! (.-provides msym) (.reverse (.-provides msym)))
      (set! (.-uses msym) (.reverse (.-uses msym)))
      (when (and (.nonEmpty (.-requires msym))
                 (.contains (.-flags (cast Directive$RequiresDirective (.-head (.-requires msym))))
                            Directive$RequiresFlag/MANDATED))
        (set! (.-directives msym)
              (.prepend (.-directives msym) (cast Directive (.-head (.-requires msym))))))
      (set! (.-directives msym)
            (.appendList (.-directives msym)
                         (List/from (cast Iterable
                                          (.getOrDefault addReads msym (Collections/emptySet))))))
      (.checkForCorrectness this))

    (method ^:public visitExports ^void [this ^JCTree$JCExports tree]
      (let [^{:tag (Iterable Symbol)} packageContent (.getSymbols
                                                       (.members (.-packge (.-directive tree))))
            ^:mutable ^{:tag (List JavaFileObject)} filesToCheck (List/nil)
            ^:mutable packageNotEmpty false]
        (for-each [^Symbol sym packageContent]
          (when-not (not (identical? (.-kind sym) Kinds$Kind/TYP))
            (let [csym (cast Symbol$ClassSymbol sym)]
              (when (or (.isTerminal (.-completer sym))
                        (identical? (.getKind (.-classfile csym)) JavaFileObject$Kind/CLASS))
                (set! packageNotEmpty true)
                (set! filesToCheck (List/nil))
                (break))
              (when (identical? (.getKind (.-classfile csym)) JavaFileObject$Kind/SOURCE)
                (set! filesToCheck (.prepend filesToCheck (.-classfile csym)))))))
        (for-each [^JavaFileObject jfo filesToCheck]
          (when (identical? (.findPackageNameOf findPackageInFile jfo)
                            (.-fullname (.-packge (.-directive tree))))
            (set! packageNotEmpty true)
            (break)))
        (when-not packageNotEmpty
          (.error log
                  (.pos (.-qualid tree))
                  (CompilerProperties$Errors/PackageEmptyOrNotFound (.-packge (.-directive tree)))))
        (set! (.-directives msym) (.prepend (.-directives msym) (.-directive tree)))))

    (method ^:public visitOpens ^void [this ^JCTree$JCOpens tree]
      (.checkPackageExistsForOpens chk (.-qualid tree) (.-packge (.-directive tree)))
      (set! (.-directives msym) (.prepend (.-directives msym) (.-directive tree))))

    (method noArgsConstructor ^Symbol$MethodSymbol [this ^Symbol$ClassSymbol tsym]
      (for-each [^Symbol sym (.getSymbolsByName (.members tsym) (.-init names))]
        (let [mSym (cast Symbol$MethodSymbol sym)] (when (.isEmpty (.params mSym)) (return mSym))))
      nil)

    (method factoryMethod ^Symbol$MethodSymbol [this ^Symbol$ClassSymbol tsym]
      (for-each [^Symbol sym (.getSymbolsByName (.members tsym)
                                                (.-provider names)
                                                (lambda Predicate ^boolean [^Symbol sym]
                                                  (identical? (.-kind sym) Kinds$Kind/MTH)))]
        (let [mSym (cast Symbol$MethodSymbol sym)]
          (when (and (and (.isStatic mSym) (not (== (bit-and (.flags mSym) Flags/PUBLIC) 0)))
                     (.isEmpty (.params mSym)))
            (return mSym))))
      nil)

    (field ^{:tag (Map Directive$ProvidesDirective JCTree$JCProvides)} directiveToTreeMap
      (HashMap.))

    (method ^:public visitProvides ^void [this ^JCTree$JCProvides tree]
      (let [st (.attribType attr (.-serviceName tree) env (.-objectType syms))
            service (cast Symbol$ClassSymbol (.-tsym st))]
        (when (.containsKey allProvides service)
          (.error log
                  (.pos (.-serviceName tree))
                  (CompilerProperties$Errors/RepeatedProvidesForService service)))
        (let [^{:tag (ListBuffer Symbol$ClassSymbol)} impls (ListBuffer.)]
          (for-each [^JCTree$JCExpression implName (.-implNames tree)]
            (let [^:mutable ^Type it nil
                  prevVisitingServiceImplementation (.-visitingServiceImplementation
                                                      (cast AttrContext (.-info env)))]
              (try
                (set! (.-visitingServiceImplementation (cast AttrContext (.-info env))) true)
                (set! it (.attribType attr implName env (.-objectType syms)))
                (finally
                  (set! (.-visitingServiceImplementation (cast AttrContext (.-info env)))
                        prevVisitingServiceImplementation)))
              (when-not (not (.hasTag it TypeTag/CLASS))
                (let [impl (cast Symbol$ClassSymbol (.-tsym it))]
                  (when (== (bit-and (.-flags_field impl) Flags/PUBLIC) 0)
                    (.error log
                            (.pos implName)
                            (CompilerProperties$Errors/NotDefPublic impl (.location impl))))
                  (let [factory (.factoryMethod this impl)]
                    (cond
                      (some? factory)
                        (let [returnType (.getReturnType (.-type factory))]
                          (when-not (.isSubtype types returnType st)
                            (.error
                              log
                              (.pos implName)
                              CompilerProperties$Errors/ServiceImplementationProviderReturnMustBeSubtypeOfServiceInterface)))
                      (not (.isSubtype types it st))
                        (.error
                          log
                          (.pos implName)
                          CompilerProperties$Errors/ServiceImplementationMustBeSubtypeOfServiceInterface)
                      (not (== (bit-and (.flags impl) Flags/ABSTRACT) 0))
                        (.error log
                                (.pos implName)
                                (CompilerProperties$Errors/ServiceImplementationIsAbstract impl))
                      (.isInner impl)
                        (.error log
                                (.pos implName)
                                (CompilerProperties$Errors/ServiceImplementationIsInner impl))
                      :else
                        (let [constr (.noArgsConstructor this impl)]
                          (cond
                            (nil? constr)
                              (.error
                                log
                                (.pos implName)
                                (CompilerProperties$Errors/ServiceImplementationDoesntHaveANoArgsConstructor
                                  impl))
                            (== (bit-and (.flags constr) Flags/PUBLIC) 0)
                              (.error
                                log
                                (.pos implName)
                                (CompilerProperties$Errors/ServiceImplementationNoArgsConstructorNotPublic
                                  impl)))))
                    (when (.hasTag it TypeTag/CLASS)
                      (if (.add (cast Set
                                      (.computeIfAbsent
                                        allProvides
                                        service
                                        (lambda Function ^Set [^Symbol$ClassSymbol s] (HashSet.))))
                                impl)
                          (.append impls impl)
                          (.error log
                                  (.pos implName)
                                  (CompilerProperties$Errors/DuplicateProvides service impl)))))))))
          (when (and (.hasTag st TypeTag/CLASS) (not (.isEmpty impls)))
            (let [d (Directive$ProvidesDirective. service (.toList impls))]
              (set! (.-provides msym) (.prepend (.-provides msym) d))
              (set! (.-directives msym) (.prepend (.-directives msym) d))
              (.put directiveToTreeMap d tree))))))

    (method ^:public visitRequires ^void [this ^JCTree$JCRequires tree]
      (when (and (some? (.-directive tree))
                 (.contains (.allModules Modules/this) (.-module (.-directive tree))))
        (.checkDeprecated chk (.pos (.-moduleName tree)) msym (.-module (.-directive tree)))
        (.checkPreview chk (.pos (.-moduleName tree)) msym (.-module (.-directive tree)))
        (.checkModuleRequires chk (.pos (.-moduleName tree)) (.-directive tree))
        (set! (.-directives msym) (.prepend (.-directives msym) (.-directive tree)))))

    (method ^:public visitUses ^void [this ^JCTree$JCUses tree]
      (let [st (.attribType attr (.-qualid tree) env (.-objectType syms))
            sym (TreeInfo/symbol (.-qualid tree))]
        (cond
          (not (== (bit-and (.flags sym) Flags/ENUM) 0))
            (.error log
                    (.pos (.-qualid tree))
                    (CompilerProperties$Errors/ServiceDefinitionIsEnum (.-tsym st)))
          (.hasTag st TypeTag/CLASS)
            (let [service (cast Symbol$ClassSymbol (.-tsym st))]
              (if (.add allUses service)
                  (let [d (Directive$UsesDirective. service)]
                    (set! (.-uses msym) (.prepend (.-uses msym) d))
                    (set! (.-directives msym) (.prepend (.-directives msym) d)))
                  (.error log (.pos tree) (CompilerProperties$Errors/DuplicateUses service)))))))

    (method ^:private checkForCorrectness ^void [this]
      (for-each [^Directive$ProvidesDirective provides (.-provides msym)]
        (let [tree (cast JCTree$JCProvides (.get directiveToTreeMap provides))]
          (for-each [^Symbol$ClassSymbol impl (.-impls provides)]
            (let [implementationDefiningPackage (.packge impl)]
              (when-not (identical? (.-modle implementationDefiningPackage) msym)
                (.error log
                        (.pos tree)
                        (CompilerProperties$Errors/ServiceImplementationNotInRightModule
                          (.-modle implementationDefiningPackage))))
              (let [interfaceDeclaringPackage (.packge (.-service provides))
                    isInterfaceDeclaredInCurrentModule (identical?
                                                         (.-modle interfaceDeclaringPackage)
                                                         msym)
                    isInterfaceExportedFromAReadableModule (identical?
                                                             (.get
                                                               (.-visiblePackages msym)
                                                               (.-fullname
                                                                 interfaceDeclaringPackage))
                                                             interfaceDeclaringPackage)]
                (when (and isInterfaceDeclaredInCurrentModule
                           (not isInterfaceExportedFromAReadableModule))
                  (let [^:mutable warn true]
                    (for-each [^Directive$ExportsDirective export (.-exports msym)]
                      (when (identical? interfaceDeclaringPackage (.-packge export))
                        (set! warn false)
                        (break)))
                    (when warn
                      (for-each [^Directive$UsesDirective uses (.-uses msym)]
                        (when (identical? (.-service provides) (.-service uses))
                          (set! warn false)
                          (break))))
                    (when warn
                      (.warning log
                                (.pos tree)
                                (CompilerProperties$Warnings/ServiceProvidedButNotExportedOrUsed
                                  (.-service provides)))))))))))))

  (field ^:private ^{:tag (Set Symbol$ModuleSymbol)} allModules)

  (method ^:public allModules ^{:tag (Set Symbol$ModuleSymbol)} [this]
    (Assert/checkNonNull allModules)
    allModules)

  (method ^:private setupAllModules ^void [this]
    (Assert/checkNonNull rootModules)
    (Assert/checkNull allModules)
    (.complete (.-java_base syms))
    (let [^:mutable ^{:tag (Set Symbol$ModuleSymbol)} observable nil]
      (if (and (nil? limitModsOpt) (.isEmpty extraLimitMods))
          (set! observable nil)
          (let [^{:tag (Set Symbol$ModuleSymbol)} limitMods (HashSet.)]
            (when (some? limitModsOpt)
              (for-each [^String limit (.split limitModsOpt ",")]
                (when-not (not (.isValidName this limit))
                  (.add limitMods (.enterModule syms (.fromString names limit))))))
            (for-each [^String limit extraLimitMods]
              (.add limitMods (.enterModule syms (.fromString names limit))))
            (set! observable (.computeTransitiveClosure this limitMods rootModules nil))
            (.addAll observable rootModules)
            (for-each [^Symbol$ModuleSymbol msym limitMods]
              (when-not (.contains observable msym)
                (.warning log
                          (CompilerProperties$LintWarnings/ModuleForOptionNotFound
                            Option/LIMIT_MODULES
                            msym))))))
      (let [^{:tag (Predicate Symbol$ModuleSymbol)} observablePred (let [observable observable]
                                                                     (lambda Predicate ^boolean [^Symbol$ModuleSymbol sym]
                                                                       (if (nil? observable)
                                                                           (not
                                                                             (identical?
                                                                               (.-kind
                                                                                 (.findModule
                                                                                   moduleFinder
                                                                                   sym))
                                                                               Kinds$Kind/ERR))
                                                                           (.contains
                                                                             observable
                                                                             sym))))
            ^{:tag (Predicate Symbol$ModuleSymbol)} systemModulePred
              (lambda Predicate ^boolean [^Symbol$ModuleSymbol sym]
                (not (== (bit-and (.flags sym) Flags/SYSTEM_MODULE) 0)))
            ^{:tag (Set Symbol$ModuleSymbol)} enabledRoot (LinkedHashSet.)]
        (when (.contains rootModules (.-unnamedModule syms))
          (let [^:mutable ^{:tag (Predicate Symbol$ModuleSymbol)} jdkModulePred nil]
            (if (.allApiModulesAreRoots target)
                (set! jdkModulePred
                      (lambda Predicate ^boolean [^Symbol$ModuleSymbol sym]
                        (.complete sym)
                        (.anyMatch (.stream (.-exports sym))
                                   (lambda Predicate ^boolean [^Directive$ExportsDirective e]
                                     (nil? (.-modules e))))))
                (let [javaSE (.getModule syms java_se)]
                  (if (and (some? javaSE) (or (nil? observable) (.contains observable javaSE)))
                      (do
                        (set! jdkModulePred
                              (lambda Predicate ^boolean [^Symbol$ModuleSymbol sym]
                                (.complete sym)
                                (and (not (.startsWith (.-name sym) java_))
                                     (.anyMatch
                                       (.stream (.-exports sym))
                                       (lambda Predicate ^boolean [^Directive$ExportsDirective e]
                                         (nil? (.-modules e)))))))
                        (.add enabledRoot javaSE))
                      (set! jdkModulePred
                            (lambda Predicate ^boolean [^Symbol$ModuleSymbol sym] true)))))
            (let [^{:tag (Predicate Symbol$ModuleSymbol)} noIncubatorPred
                    (lambda Predicate ^boolean [^Symbol$ModuleSymbol sym]
                      (.complete sym)
                      (not (.contains (.-resolutionFlags sym)
                                      Symbol$ModuleResolutionFlags/DO_NOT_RESOLVE_BY_DEFAULT)))]
              (for-each [^Symbol$ModuleSymbol sym (HashSet. (.getAllModules syms))]
                (try
                  (when (and (and (and (.test systemModulePred sym) (.test observablePred sym))
                                  (.test jdkModulePred sym))
                             (.test noIncubatorPred sym))
                    (.add enabledRoot sym))
                  (catch Symbol$CompletionFailure ex (.completionError chk nil ex)))))))
        (.addAll enabledRoot rootModules)
        (when (or (some? addModsOpt) (not (.isEmpty extraAddMods)))
          (let [^{:tag (Set String)} fullAddMods (HashSet.)]
            (.addAll fullAddMods extraAddMods)
            (when (some? addModsOpt) (.addAll fullAddMods (Arrays/asList (.split addModsOpt ","))))
            (for-each [^String added fullAddMods]
              (let [^:mutable ^{:tag (Stream Symbol$ModuleSymbol)} modules nil]
                (switch added
                  ALL_SYSTEM
                    (set! modules
                          (.filter (.stream (HashSet. (.getAllModules syms)))
                                   (.and systemModulePred observablePred)))
                  ALL_MODULE_PATH
                    (set! modules
                          (.filter (.stream (HashSet. (.getAllModules syms)))
                                   (.and (.negate systemModulePred) observablePred)))
                  (do
                    (when-not (.isValidName this added) (continue))
                    (set! modules (Stream/of (.enterModule syms (.fromString names added))))))
                (.forEach modules
                          (let [observable observable]
                            (lambda Consumer ^void [^Symbol$ModuleSymbol sym]
                              (.add enabledRoot sym)
                              (when (some? observable) (.add observable sym)))))))))
        (let [^{:tag (Set Symbol$ModuleSymbol)} result (.computeTransitiveClosure
                                                         this
                                                         enabledRoot
                                                         rootModules
                                                         observable)]
          (.add result (.-unnamedModule syms))
          (let [hasAutomatic (.anyMatch (.stream result) IS_AUTOMATIC)]
            (when hasAutomatic
              (.forEach (.filter (.stream (.getAllModules syms)) IS_AUTOMATIC)
                        (method-ref Consumer [Symbol$ModuleSymbol] result Set/.add)))
            (when (.isEnabled lint Lint$LintCategory/INCUBATING)
              (let [incubatingModules (cast
                                        String
                                        (.collect
                                          (.filterAlreadyWarnedIncubatorModules
                                            this
                                            (.map
                                              (.filter
                                                (.stream result)
                                                (lambda Predicate ^boolean [^Symbol$ModuleSymbol msym]
                                                  (.contains
                                                    (.-resolutionFlags msym)
                                                    Symbol$ModuleResolutionFlags/WARN_INCUBATING)))
                                              (lambda Function ^String [^Symbol$ModuleSymbol msym]
                                                (.toString (.-name msym)))))
                                          (Collectors/joining ",")))]
                (when-not (.isEmpty incubatingModules)
                  (.warning log
                            (CompilerProperties$LintWarnings/IncubatingModules incubatingModules)))))
            (set! allModules result)
            (when (some? moduleVersionOpt)
              (let [version (.fromString names moduleVersionOpt)]
                (.forEach rootModules
                          (lambda Consumer ^void [^Symbol$ModuleSymbol m]
                            (set! (.-version m) version))))))))))

  (method ^:private filterAlreadyWarnedIncubatorModules ^{:tag (Stream String)} [this
                                                                                 ^{:tag (Stream String)} incubatingModules]
    (if (not sourceLauncher)
        incubatingModules
        (let [^{:tag (Set String)} bootModules (cast
                                                 Set
                                                 (.collect
                                                   (.map
                                                     (.stream (.modules (ModuleLayer/boot)))
                                                     (method-ref
                                                       Function
                                                       ^String [Module]
                                                       Module/.getName))
                                                   (Collectors/toSet)))]
          (.filter
            incubatingModules
            (lambda Predicate ^boolean [^String module] (not (.contains bootModules module)))))))

  (field ^:private ^:static ^:final ^{:tag (Predicate Symbol$ModuleSymbol)} IS_AUTOMATIC
    (lambda Predicate ^boolean [^Symbol$ModuleSymbol m]
      (not (== (bit-and (.-flags_field m) Flags/AUTOMATIC_MODULE) 0))))

  (method ^:public isInModuleGraph ^boolean [this ^Symbol$ModuleSymbol msym]
    (or (nil? allModules) (.contains allModules msym)))

  (method ^:private computeTransitiveClosure ^{:tag (Set Symbol$ModuleSymbol)} [this
                                                                                ^{:tag (Set (? extends Symbol$ModuleSymbol))} base
                                                                                ^{:tag (Set (? extends Symbol$ModuleSymbol))} rootModules
                                                                                ^{:tag (Set Symbol$ModuleSymbol)} observable]
    (let [^:mutable ^{:tag (List Symbol$ModuleSymbol)} primaryTodo (List/nil)
          ^:mutable ^{:tag (List Symbol$ModuleSymbol)} secondaryTodo (List/nil)]
      (for-each [^Symbol$ModuleSymbol ms base]
        (if (.contains rootModules ms)
            (set! primaryTodo (.prepend primaryTodo ms))
            (set! secondaryTodo (.prepend secondaryTodo ms))))
      (let [^{:tag (Set Symbol$ModuleSymbol)} result (LinkedHashSet.)]
        (.add result (.-java_base syms))
        (while (or (.nonEmpty primaryTodo) (.nonEmpty secondaryTodo))
          (try
            (let [^:mutable ^Symbol$ModuleSymbol current nil
                  ^:mutable ^boolean isPrimaryTodo false]
              (if (.nonEmpty primaryTodo)
                  (do
                    (set! current (cast Symbol$ModuleSymbol (.-head primaryTodo)))
                    (set! primaryTodo (.-tail primaryTodo))
                    (set! isPrimaryTodo true))
                  (do
                    (set! current (cast Symbol$ModuleSymbol (.-head secondaryTodo)))
                    (set! secondaryTodo (.-tail secondaryTodo))
                    (set! isPrimaryTodo false)))
              (when-not (and (some? observable) (not (.contains observable current)))
                (when-not (or (or (not (.add result current))
                                  (identical? current (.-unnamedModule syms)))
                              (not (== (bit-and (.-flags_field current) Flags/AUTOMATIC_MODULE) 0)))
                  (.complete current)
                  (when (and (and (identical? (.-kind current) Kinds$Kind/ERR)
                                  (or isPrimaryTodo (.contains base current)))
                             (.add warnedMissing current))
                    (.error log (CompilerProperties$Errors/ModuleNotFound current)))
                  (for-each [^Directive$RequiresDirective rd (.-requires current)]
                    (when-not (identical? (.-module rd) (.-java_base syms))
                      (if (or (and (.isTransitive rd) isPrimaryTodo)
                              (.contains rootModules current))
                          (set! primaryTodo (.prepend primaryTodo (.-module rd)))
                          (set! secondaryTodo (.prepend secondaryTodo (.-module rd)))))))))
            (catch Symbol$CompletionFailure ex (.completionError chk nil ex))))
        result)))

  (method ^:public getObservableModule ^Symbol$ModuleSymbol [this ^Name name]
    (let [mod (.getModule syms name)] (when (.contains (.allModules this) mod) mod)))

  (method ^:private getUnnamedModuleCompleter ^Symbol$Completer [this]
    (.findAllModules moduleFinder)
    (anon Symbol$Completer []
      (method ^:public complete :throws [Symbol$CompletionFailure] ^void [this ^Symbol sym]
        (if inInitModules
            (set! (.-completer sym) this)
            (let [msym (cast Symbol$ModuleSymbol sym)
                  ^{:tag (Set Symbol$ModuleSymbol)} allModules (HashSet. (.allModules Modules/this))]
              (.remove allModules (.-unnamedModule syms))
              (for-each [^Symbol$ModuleSymbol m allModules] (.complete m))
              (.initVisiblePackages Modules/this msym allModules))))

      (method ^:public toString ^String [this] "unnamedModule Completer")))

  (field ^:private ^:final ^{:tag (Map Symbol$ModuleSymbol (Set Symbol$ModuleSymbol))} requiresTransitiveCache
    (HashMap.))

  (method ^:private completeModule ^void [this ^Symbol$ModuleSymbol msym]
    (if inInitModules
        (set! (.-completer msym)
              (lambda Symbol$Completer ^void [^Symbol sym] (.completeModule this msym)))
        (do
          (when-not (== (bit-and (.-flags_field msym) Flags/AUTOMATIC_MODULE) 0)
            (.completeAutomaticModule this msym))
          (Assert/checkNonNull (.-requires msym))
          (.initAddReads this)
          (set! (.-requires msym)
                (.appendList
                  (.-requires msym)
                  (List/from (cast Iterable (.getOrDefault addReads msym (Collections/emptySet))))))
          (let [^:mutable ^{:tag (List Directive$RequiresDirective)} requires (.-requires msym)]
            (while (.nonEmpty requires)
              (when-not (.contains (.allModules this)
                                   (.-module (cast Directive$RequiresDirective (.-head requires))))
                (let [^{:tag (Env AttrContext)} env (.get typeEnvs msym)]
                  (if (some? env)
                      (let [origSource (.useSource log (.-sourcefile (.-toplevel env)))]
                        (try
                          (.error
                            log
                            (.-tree env)
                            (CompilerProperties$Errors/ModuleNotFound
                              (.-module (cast Directive$RequiresDirective (.-head requires)))))
                          (finally (.useSource log origSource))))
                      (Assert/check (== (bit-and (.flags msym) Flags/AUTOMATIC_MODULE) 0)))
                  (set! (.-requires msym)
                        (List/filter (.-requires msym)
                                     (cast Directive$RequiresDirective (.-head requires))))))
              (set! requires (.-tail requires)))
            (let [^{:tag (Set Symbol$ModuleSymbol)} readable (LinkedHashSet.)
                  ^{:tag (Set Symbol$ModuleSymbol)} requiresTransitive (HashSet.)]
              (for-each [^Directive$RequiresDirective d (.-requires msym)]
                (.complete (.-module d))
                (.add readable (.-module d))
                (let [^{:tag (Set Symbol$ModuleSymbol)} s (.retrieveRequiresTransitive
                                                            this
                                                            (.-module d))]
                  (Assert/checkNonNull s
                                       (lambda Supplier ^String []
                                         (java-str "no entry in cache for " (.-module d))))
                  (.addAll readable s)
                  (when (.contains (.-flags d) Directive$RequiresFlag/TRANSITIVE)
                    (.add requiresTransitive (.-module d))
                    (.addAll requiresTransitive s))))
              (.put requiresTransitiveCache msym requiresTransitive)
              (.initVisiblePackages this msym readable)
              (for-each [^Directive$ExportsDirective d (.-exports msym)]
                (when (some? (.-packge d)) (set! (.-modle (.-packge d)) msym))))))))

  (method ^:private retrieveRequiresTransitive ^{:tag (Set Symbol$ModuleSymbol)} [this
                                                                                  ^Symbol$ModuleSymbol msym]
    (let [^:mutable ^{:tag (Set Symbol$ModuleSymbol)} requiresTransitive (cast
                                                                           Set
                                                                           (.get
                                                                             requiresTransitiveCache
                                                                             msym))]
      (when (nil? requiresTransitive)
        (set! requiresTransitive (HashSet.))
        (let [^{:tag (Set Symbol$ModuleSymbol)} seen (HashSet.)
              ^:mutable ^{:tag (List Symbol$ModuleSymbol)} todo (List/of msym)]
          (while (.nonEmpty todo)
            (let [current (cast Symbol$ModuleSymbol (.-head todo))]
              (set! todo (.-tail todo))
              (when-not (not (.add seen current))
                (.add requiresTransitive current)
                (.complete current)
                (let [^:mutable ^{:tag (Iterable (? extends Directive$RequiresDirective))} requires
                        nil]
                  (if (not (identical? current (.-unnamedModule syms)))
                      (do
                        (Assert/checkNonNull (.-requires current)
                                             (lambda Supplier ^String []
                                               (java-str current ".requires == null; " msym)))
                        (set! requires (.-requires current))
                        (for-each [^Directive$RequiresDirective rd requires]
                          (when (.isTransitive rd) (set! todo (.prepend todo (.-module rd))))))
                      (for-each [^Symbol$ModuleSymbol mod (.allModules this)]
                        (set! todo (.prepend todo mod))))))))
          (.remove requiresTransitive msym)))
      requiresTransitive))

  (method ^:private initVisiblePackages ^void [this ^Symbol$ModuleSymbol msym
                                               ^{:tag (Collection Symbol$ModuleSymbol)} readable]
    (.initAddExports this)
    (set! (.-visiblePackages msym) (LinkedHashMap.))
    (set! (.-readModules msym) (HashSet. readable))
    (let [^{:tag (Map Name Symbol$ModuleSymbol)} seen (HashMap.)]
      (for-each [^Symbol$ModuleSymbol rm readable]
        (when-not (identical? rm (.-unnamedModule syms))
          (.addVisiblePackages this msym seen rm (.-exports rm))))
      (.forEach addExports
                (lambda BiConsumer ^void [^Symbol$ModuleSymbol exportsFrom ^Set exports]
                  (when (.contains (.-readModules msym) exportsFrom)
                    (.addVisiblePackages this msym seen exportsFrom exports))))
      (.add (.-readModules msym) msym)))

  (method ^:private addVisiblePackages ^void [this ^Symbol$ModuleSymbol msym
                                              ^{:tag (Map Name Symbol$ModuleSymbol)} seenPackages
                                              ^Symbol$ModuleSymbol exportsFrom
                                              ^{:tag (Collection Directive$ExportsDirective)} exports]
    (for-each [^Directive$ExportsDirective d exports]
      (when (or (nil? (.-modules d)) (.contains (.-modules d) msym))
        (let [packageName (.-fullname (.-packge d))
              previousModule (cast Symbol$ModuleSymbol (.get seenPackages packageName))]
          (if (and (some? previousModule) (not (identical? previousModule exportsFrom)))
              (let [^{:tag (Env AttrContext)} env (.get typeEnvs msym)
                    ^JavaFileObject origSource (when (some? env)
                                                 (.useSource log (.-sourcefile (.-toplevel env))))
                    ^JCDiagnostic$DiagnosticPosition pos (when (some? env) (.pos (.-tree env)))]
                (try
                  (if (.isUnnamed msym)
                      (.error log
                              pos
                              (CompilerProperties$Errors/PackageClashFromRequiresInUnnamed
                                packageName
                                previousModule
                                exportsFrom))
                      (.error log
                              pos
                              (CompilerProperties$Errors/PackageClashFromRequires
                                msym
                                packageName
                                previousModule
                                exportsFrom)))
                  (finally (when (some? env) (.useSource log origSource)))))
              (do
                (.put seenPackages packageName exportsFrom)
                (.put (.-visiblePackages msym) (.-fullname (.-packge d)) (.-packge d))))))))

  (method ^:private initAddExports ^void [this]
    (when-not (some? addExports)
      (set! addExports (LinkedHashMap.))
      (let [^{:tag (Set Symbol$ModuleSymbol)} unknownModules (HashSet.)]
        (when (some? addExportsOpt)
          (let [ep (Pattern/compile "([^/]+)/([^=]+)=(.*)")]
            (for-each [^String s (.split addExportsOpt "\u0000+")]
              (when-not (.isEmpty s)
                (let [em (.matcher ep s)]
                  (when-not (not (.matches em))
                    (let [moduleName (.group em 1)
                          packageName (.group em 2)
                          targetNames (.group em 3)]
                      (when-not (not (.isValidName this moduleName))
                        (let [msym (.enterModule syms (.fromString names moduleName))]
                          (when-not (not (.isKnownModule this msym unknownModules))
                            (when-not (not (.isValidName this packageName))
                              (if (and (not allowAccessIntoSystem)
                                       (not (== (bit-and (.flags msym) Flags/SYSTEM_MODULE) 0)))
                                  (.error log
                                          (CompilerProperties$Errors/AddExportsWithRelease msym))
                                  (let [p (.enterPackage syms msym (.fromString names packageName))]
                                    (set! (.-modle p) msym)
                                    (let [^:mutable ^{:tag (List Symbol$ModuleSymbol)} targetModules
                                            (List/nil)]
                                      (for-each [^String toModule (.split targetNames "[ ,]+")]
                                        (let [^:mutable ^Symbol$ModuleSymbol m nil]
                                          (if (.equals toModule "ALL-UNNAMED")
                                              (set! m (.-unnamedModule syms))
                                              (do
                                                (when-not (.isValidName this toModule) (continue))
                                                (set!
                                                  m
                                                  (.enterModule syms (.fromString names toModule)))
                                                (when-not (.isKnownModule this m unknownModules)
                                                  (continue))))
                                          (set! targetModules (.prepend targetModules m))))
                                      (let [^{:tag (Set Directive$ExportsDirective)} extra (cast
                                                                                             Set
                                                                                             (.computeIfAbsent
                                                                                               addExports
                                                                                               msym
                                                                                               (lambda Function ^Set [^Symbol$ModuleSymbol _x]
                                                                                                 (LinkedHashSet.))))
                                            d (Directive$ExportsDirective. p targetModules)]
                                        (.add extra d)))))))))))))))))))

  (method ^:private isKnownModule ^boolean [this ^Symbol$ModuleSymbol msym
                                            ^{:tag (Set Symbol$ModuleSymbol)} unknownModules]
    (if (.contains allModules msym)
        true
        (do
          (when-not (.contains unknownModules msym)
            (.warning log
                      (CompilerProperties$LintWarnings/ModuleForOptionNotFound
                        Option/ADD_EXPORTS
                        msym))
            (.add unknownModules msym))
          false)))

  (method ^:private initAddReads ^void [this]
    (when-not (some? addReads)
      (set! addReads (LinkedHashMap.))
      (when (some? addReadsOpt)
        (let [rp (Pattern/compile "([^=]+)=(.*)")]
          (for-each [^String s (.split addReadsOpt "\u0000+")]
            (when-not (.isEmpty s)
              (let [rm (.matcher rp s)]
                (when-not (not (.matches rm))
                  (let [sourceName (.group rm 1)
                        targetNames (.group rm 2)]
                    (when-not (not (.isValidName this sourceName))
                      (let [msym (.enterModule syms (.fromString names sourceName))]
                        (cond
                          (not (.contains allModules msym))
                            (.warning log
                                      (CompilerProperties$LintWarnings/ModuleForOptionNotFound
                                        Option/ADD_READS
                                        msym))
                          (and (not allowAccessIntoSystem)
                               (not (== (bit-and (.flags msym) Flags/SYSTEM_MODULE) 0)))
                            (.error log (CompilerProperties$Errors/AddReadsWithRelease msym))
                          :else
                            (for-each [^String targetName (.split targetNames "[ ,]+" -1)]
                              (let [^:mutable ^Symbol$ModuleSymbol targetModule nil]
                                (if (.equals targetName "ALL-UNNAMED")
                                    (set! targetModule (.-unnamedModule syms))
                                    (do
                                      (when-not (.isValidName this targetName) (continue))
                                      (set! targetModule
                                            (.enterModule syms (.fromString names targetName)))
                                      (when-not (.contains allModules targetModule)
                                        (.warning
                                          log
                                          (CompilerProperties$LintWarnings/ModuleForOptionNotFound
                                            Option/ADD_READS
                                            targetModule))
                                        (continue))))
                                (.add (cast Set
                                            (.computeIfAbsent
                                              addReads
                                              msym
                                              (lambda Function ^Set [^Symbol$ModuleSymbol m]
                                                (HashSet.))))
                                      (Directive$RequiresDirective.
                                        targetModule
                                        (EnumSet/of Directive$RequiresFlag/EXTRA)))))))))))))))))

  (method ^:private checkCyclicDependencies ^void [this ^JCTree$JCModuleDecl mod]
    (for-each [^JCTree$JCDirective d (.-directives mod)]
      (let [^:mutable ^JCTree$JCRequires rd nil]
        (when-not (or (not (.hasTag d JCTree$Tag/REQUIRES))
                      (nil? (.-directive (set! rd (cast JCTree$JCRequires d)))))
          (let [^{:tag (Set Symbol$ModuleSymbol)} nonSyntheticDeps (HashSet.)
                ^:mutable ^{:tag (List Symbol$ModuleSymbol)} queue (List/of
                                                                     (.-module (.-directive rd)))]
            (while (.nonEmpty queue)
              (let [current (cast Symbol$ModuleSymbol (.-head queue))]
                (set! queue (.-tail queue))
                (when-not (not (.add nonSyntheticDeps current))
                  (.complete current)
                  (when-not (not (== (bit-and (.flags current) Flags/AUTOMATIC_MODULE) 0))
                    (Assert/checkNonNull (.-requires current)
                                         (method-ref
                                           Supplier
                                           ^String []
                                           current
                                           Symbol$ModuleSymbol/.toString))
                    (for-each [^Directive$RequiresDirective dep (.-requires current)]
                      (when-not (.contains (.-flags dep) Directive$RequiresFlag/EXTRA)
                        (set! queue (.prepend queue (.-module dep)))))))))
            (when (.contains nonSyntheticDeps (.-sym mod))
              (.error log
                      (.pos (.-moduleName rd))
                      (CompilerProperties$Errors/CyclicRequires (.-module (.-directive rd))))))))))

  (method ^:private isValidName ^boolean [this ^CharSequence name]
    (SourceVersion/isName name (Source/toSourceVersion source)))

  (method ^:private toString ^String [this ^Symbol$ModuleSymbol msym]
    (java-str (.-name msym)
              "[kind:"
              (.-kind msym)
              ";locn:"
              (.toString this (.-sourceLocation msym))
              ","
              (.toString this (.-classLocation msym))
              ";info:"
              (.toString this (.-sourcefile (.-module_info msym)))
              ","
              (.toString this (.-classfile (.-module_info msym)))
              ","
              (.-completer (.-module_info msym))
              "]"))

  (method toString ^String [this ^JavaFileManager$Location locn]
    (if (nil? locn) "--" (.getName locn)))

  (method toString ^String [this ^JavaFileObject fo]
    (if (nil? fo) "--" (.getName fo)))

  (method ^:public newRound ^void [this]
    (set! allModules nil)
    (set! rootModules nil)
    (set! defaultModule nil)
    (.clear warnedMissing))

  (defclass ^:public ^:interface PackageNameFinder
    (method ^:public findPackageNameOf ^Name [this ^JavaFileObject jfo])))

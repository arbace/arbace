                                 (List/nil)
                                 (.-methodClass syms))
          eqsym (.resolveQualifiedMethod rs
                                         nil
                                         attrEnv
                                         (.-objectType syms)
                                         (.-equals names)
                                         (List/of (.-objectType syms))
                                         (List/nil))
          eqtest (.Apply make
                         (List/nil)
                         (.setType (.Select make (.deserGetter this func (.-stringType syms)) eqsym)
                                   eqmt)
                         (List/of (.Literal make lit)))]
      (.setType eqtest (.-booleanType syms))
      (let [compound (.Binary make JCTree$Tag/AND prev eqtest)]
        (set! (.-operator compound)
              (.resolveBinary operators
                              compound
                              JCTree$Tag/AND
                              (.-booleanType syms)
                              (.-booleanType syms)))
        (.setType compound (.-booleanType syms))
        compound)))

  (method ^:private deserGetter ^JCTree$JCExpression [this ^String func ^Type type]
    (.deserGetter this func type (List/nil) (List/nil)))

  (method ^:private deserGetter ^JCTree$JCExpression [this ^String func ^Type type
                                                      ^{:tag (List Type)} argTypes
                                                      ^{:tag (List JCTree$JCExpression)} args]
    (let [getmt (Type$MethodType. argTypes type (List/nil) (.-methodClass syms))
          getsym (.resolveQualifiedMethod rs
                                          nil
                                          attrEnv
                                          (.-serializedLambdaType syms)
                                          (.fromString names func)
                                          argTypes
                                          (List/nil))]
      (.setType (.Apply make
                        (List/nil)
                        (.setType (.Select make
                                           (.setType
                                             (.Ident make (.-deserParamSym kInfo))
                                             (.-serializedLambdaType syms))
                                           getsym)
                                  getmt)
                        args)
                type)))

  (method ^:private makePrivateSyntheticMethod ^Symbol$MethodSymbol [this ^long flags ^Name name
                                                                     ^Type type ^Symbol owner]
    (Symbol$MethodSymbol. (bit-or (bit-or flags Flags/SYNTHETIC) Flags/PRIVATE) name type owner))

  (method ^:private typeToMethodType ^Type$MethodType [this ^Type mt]
    (let [type (.erasure types mt)]
      (Type$MethodType. (.getParameterTypes type)
                        (.getReturnType type)
                        (.getThrownTypes type)
                        (.-methodClass syms))))

  (method ^:private makeMetafactoryIndyCall ^JCTree$JCExpression [this
                                                                  ^JCTree$JCFunctionalExpression tree
                                                                  ^Symbol$MethodHandleSymbol refSym
                                                                  ^Symbol$MethodSymbol nonDedupedRefSym
                                                                  ^{:tag (List JCTree$JCExpression)} indy_args]
    (let [samSym (cast Symbol$MethodSymbol (.findDescriptorSymbol types (.-tsym (.-target tree))))
          ^:mutable ^{:tag (List PoolConstant$LoadableConstant)} staticArgs (List/of
                                                                              (.typeToMethodType
                                                                                this
                                                                                (.-type samSym))
                                                                              (.asHandle refSym)
                                                                              (.typeToMethodType
                                                                                this
                                                                                (.getDescriptorType
                                                                                  tree
                                                                                  types)))
          ^{:tag (ListBuffer Type)} indy_args_types (ListBuffer.)]
      (for-each [^JCTree$JCExpression arg indy_args] (.append indy_args_types (.-type arg)))
      (let [indyType (Type$MethodType. (.toList indy_args_types)
                                       (.-type tree)
                                       (List/nil)
                                       (.-methodClass syms))
            ^{:tag (List Symbol)} bridges (.bridges this tree)
            isSerializable (.isSerializable this tree)
            needsAltMetafactory (or (or (.isIntersection (.-target tree)) isSerializable)
                                    (> (.length bridges) 1))]
        (.dumpStats this tree needsAltMetafactory nonDedupedRefSym)
        (let [^Name metafactoryName (if needsAltMetafactory
                                        (.-altMetafactory names)
                                        (.-metafactory names))]
          (when needsAltMetafactory
            (let [^{:tag (ListBuffer Type)} markers (ListBuffer.)
                  ^{:tag (List Type)} targets (if (.isIntersection (.-target tree))
                                                  (.directSupertypes types (.-target tree))
                                                  (List/nil))]
              (for-each [^:mutable ^Type t targets]
                (set! t (.erasure types t))
                (when (and (and (not (identical? (.-tsym t) (.-tsym (.-serializableType syms))))
                                (not (identical? (.-tsym t) (.-tsym (.-type tree)))))
                           (not (identical? (.-tsym t) (.-tsym (.-objectType syms)))))
                  (.append markers t)))
              (let [^:mutable ^int flags (if isSerializable FLAG_SERIALIZABLE 0)
                    hasMarkers (.nonEmpty markers)
                    hasBridges (.nonEmpty bridges)]
                (when hasMarkers (set! flags (bit-or-int flags FLAG_MARKERS)))
                (when hasBridges (set! flags (bit-or-int flags FLAG_BRIDGES)))
                (set! staticArgs (.append staticArgs (PoolConstant$LoadableConstant/Int flags)))
                (when hasMarkers
                  (set! staticArgs
                        (.append staticArgs (PoolConstant$LoadableConstant/Int (.length markers))))
                  (set!
                    staticArgs
                    (.appendList staticArgs
                                 (List/convert PoolConstant$LoadableConstant (.toList markers)))))
                (when hasBridges
                  (set! staticArgs
                        (.append staticArgs
                                 (PoolConstant$LoadableConstant/Int
                                   (unchecked-subtract-int (.length bridges) 1))))
                  (for-each [^Symbol s bridges]
                    (let [s_erasure (.erasure s types)]
                      (when-not (.isSameType types s_erasure (.erasure samSym types))
                        (set! staticArgs
                              (.append staticArgs (cast Type$MethodType (.erasure s types))))))))
                (when isSerializable
                  (let [prevPos (.-pos make)]
                    (try
                      (.at make (.-clazz kInfo))
                      (.addDeserializationCase this
                                               refSym
                                               (.-type tree)
                                               samSym
                                               tree
                                               staticArgs
                                               indyType)
                      (finally (.at make prevPos))))))))
          (.makeIndyCall this
                         tree
                         (.-lambdaMetafactory syms)
                         metafactoryName
                         staticArgs
                         indyType
                         indy_args
                         (.-name samSym))))))

  (method ^:private makeIndyCall ^JCTree$JCExpression [this ^JCDiagnostic$DiagnosticPosition pos
                                                       ^Type site ^Name bsmName
                                                       ^{:tag (List PoolConstant$LoadableConstant)} staticArgs
                                                       ^Type$MethodType indyType
                                                       ^{:tag (List JCTree$JCExpression)} indyArgs
                                                       ^Name methName]
    (let [prevPos (.-pos make)]
      (try
        (.at make pos)
        (let [^{:tag (List Type)} bsm_staticArgs (.appendList
                                                   (List/of
                                                     (.-methodHandleLookupType syms)
                                                     (.-stringType syms)
                                                     (.-methodTypeType syms))
                                                   (.map
                                                     staticArgs
                                                     (method-ref
                                                       Function
                                                       ^Type [PoolConstant$LoadableConstant]
                                                       types
                                                       Types/.constantType)))
              bsm (.resolveInternalMethod rs pos attrEnv site bsmName bsm_staticArgs (List/nil))
              dynSym (Symbol$DynamicMethodSymbol.
                       methName
                       (.-noSymbol syms)
                       (.asHandle bsm)
                       indyType
                       (cast PoolConstant$LoadableConstant/1
                             (.toArray staticArgs
                                       (new PoolConstant$LoadableConstant/1 (.length staticArgs)))))
              qualifier (.Select make (.QualIdent make (.-tsym site)) bsmName)
              existing (cast Symbol$DynamicMethodSymbol
                             (.putIfAbsent (.-dynMethSyms kInfo) (.poolKey dynSym types) dynSym))]
          (set! (.-sym qualifier) (if (some? existing) ^Symbol existing ^Symbol dynSym))
          (set! (.-type qualifier) (.getReturnType indyType))
          (let [proxyCall (.Apply make (List/nil) qualifier indyArgs)]
            (set! (.-type proxyCall) (.getReturnType indyType))
            proxyCall))
        (finally (.at make prevPos)))))

  (method bridges ^{:tag (List Symbol)} [this ^JCTree$JCFunctionalExpression tree]
    (let [csym (.makeFunctionalInterfaceClass types
                                              attrEnv
                                              (.-empty names)
                                              (.-target tree)
                                              (bit-or-int Flags/ABSTRACT Flags/INTERFACE))]
      (.functionalInterfaceBridges types csym)))

  (method isSerializable ^boolean [this ^JCTree$JCFunctionalExpression tree]
    (if forceSerializable
        true
        (some? (.asSuper types (.-target tree) (.-tsym (.-serializableType syms))))))

  (method dumpStats ^void [this ^JCTree$JCFunctionalExpression tree ^boolean needsAltMetafactory
                           ^Symbol sym]
    (when dumpLambdaToMethodStats
      (if-instance [^JCTree$JCLambda lambda tree]
        (.note log
               tree
               (.noteKey diags
                         ^String (if (.-wasMethodReference lambda) "mref.stat.1" "lambda.stat")
                         needsAltMetafactory
                         sym))
        (when (instance? JCTree$JCMemberReference tree)
          (.note log tree (CompilerProperties$Notes/MrefStat needsAltMetafactory nil))))))

  (defclass LambdaTranslationContext
    (field ^:final ^JCTree$JCFunctionalExpression tree)

    (field ^:final ^{:tag (Map Symbol$VarSymbol Symbol$VarSymbol)} lambdaProxies (HashMap.))

    (field ^:final ^{:tag (List Symbol$VarSymbol)} capturedVars)

    (field ^:final ^Symbol$MethodSymbol translatedSym)

    (field ^:final ^{:tag (List JCTree$JCVariableDecl)} syntheticParams)

    (constructor [this ^JCTree$JCLambda tree]
      (set! (.-tree this) tree)
      (let [owner (.-owner tree)]
        (if (identical? (.-kind owner) Kinds$Kind/MTH)
            (let [originalOwner (cast Symbol$MethodSymbol (.clone owner (.-owner owner)))]
              (set! (.-translatedSym this)
                    (anon Symbol$MethodSymbol [0 nil nil (.enclClass owner)]
                      (method ^:public originalEnclosingMethod ^Symbol$MethodSymbol [this]
                        originalOwner))))
            (set! (.-translatedSym this)
                  (.makePrivateSyntheticMethod LambdaToMethod/this 0 nil nil (.enclClass owner))))
        (let [^{:tag (ListBuffer JCTree$JCVariableDecl)} params (ListBuffer.)
              ^{:tag (ListBuffer Symbol$VarSymbol)} parameterSymbols (ListBuffer.)
              captureScanner (LambdaCaptureScanner. tree)]
          (set! capturedVars (.analyzeCaptures captureScanner))
          (for-each [^Symbol$VarSymbol captured capturedVars]
            (let [trans (.addSymbol this captured LambdaSymbolKind/CAPTURED_VAR)]
              (.append params (.VarDef make trans nil))
              (.add parameterSymbols trans)))
          (for-each [^JCTree$JCVariableDecl param (.-params tree)]
            (let [trans (.addSymbol this (.-sym param) LambdaSymbolKind/PARAM)]
              (.append params (.VarDef make trans nil))
              (.add parameterSymbols trans)))
          (set! syntheticParams (.toList params))
          (.completeLambdaMethodSymbol this owner (.-capturesThis captureScanner))
          (set! (.-params translatedSym) (.toList parameterSymbols)))))

    (method completeLambdaMethodSymbol ^void [this ^Symbol owner ^boolean thisReferenced]
      (let [inInterface (.isInterface (.enclClass owner))
            ^Name name (if (.isSerializable LambdaToMethod/this tree)
                           (.serializedLambdaName this owner)
                           (.lambdaName this owner))
            type (.createMethodTypeWithParameters
                   types
                   (.generatedLambdaSig this)
                   (TreeInfo/types syntheticParams))
            flags (bit-or (bit-or (bit-or (bit-or
                                            (bit-or Flags/SYNTHETIC Flags/LAMBDA_METHOD)
                                            (bit-and (.-flags_field owner) Flags/STRICTFP))
                                          (bit-and (.-flags_field (.-owner owner)) Flags/STRICTFP))
                                  Flags/PRIVATE)
                          (if thisReferenced (if inInterface Flags/DEFAULT 0) (long Flags/STATIC)))]
        (set! (.-type translatedSym) type)
        (set! (.-name translatedSym) name)
        (set! (.-flags_field translatedSym) flags)))

    (method ^:private serializedLambdaDisambiguation ^String [this ^Symbol owner]
      (let [buf (StringBuilder.)]
        (Assert/check (or (some? (.-type owner)) (some? lambdaContext)))
        (when (some? (.-type owner))
          (.append buf (.typeSig LambdaToMethod/this (.-type owner) true))
          (.append buf ":"))
        (.append buf (.flatName (.-owner (.findDescriptorSymbol types (.-tsym (.-type tree))))))
        (.append buf " ")
        (when (some? pendingVar) (.append buf (.flatName pendingVar)) (.append buf "="))
        (for-each [^Symbol fv capturedVars]
          (when-not (identical? fv owner)
            (.append buf (.typeSig LambdaToMethod/this (.-type fv) true))
            (.append buf " ")
            (.append buf (.flatName fv))
            (.append buf ",")))
        (.toString buf)))

    (method ^:private lambdaName ^Name [this ^Symbol owner]
      (let [buf (StringBuilder.)]
        (.append buf (.-lambda names))
        (.append buf (.syntheticMethodNameComponent this owner))
        (.append buf "$")
        (.append buf (.syntheticNameIndex kInfo buf 0))
        (.fromString names (.toString buf))))

    (method syntheticMethodNameComponent ^String [this ^Symbol owner]
      (let [ownerFlags (.flags owner)]
        (cond
          (not (== (bit-and ownerFlags Flags/BLOCK) 0))
            (if (not (== (bit-and ownerFlags Flags/STATIC) 0)) "static" "new")
          (.isConstructor owner) "new"
          :else (.toString (.-name owner)))))

    (method ^:private serializedLambdaName ^Name [this ^Symbol owner]
      (let [buf (StringBuilder.)]
        (.append buf (.-lambda names))
        (.append buf (.syntheticMethodNameComponent this owner))
        (.append buf \$)
        (let [disam (.serializedLambdaDisambiguation this owner)]
          (.append buf (Integer/toHexString (.hashCode disam)))
          (.append buf \$)
          (.append buf (.syntheticNameIndex kInfo buf 1))
          (let [result (.toString buf)] (.fromString names result)))))

    (method translate ^Symbol$VarSymbol [this ^:final ^Symbol$VarSymbol sym ^LambdaSymbolKind skind]
      (let [^:mutable ^Symbol$VarSymbol ret nil
            ^:mutable propagateAnnos true]
        (switch skind
          CAPTURED_VAR
            (let [^Name name (if (not (== (bit-and (.flags sym) Flags/LOCAL_CAPTURE_FIELD) 0))
                                 (.-name (.baseSymbol sym))
                                 (.-name sym))]
              (set! ret
                    (Symbol$VarSymbol.
                      (bit-or (bit-or-int Flags/SYNTHETIC Flags/FINAL) Flags/PARAMETER)
                      name
                      (.erasure types (.-type sym))
                      translatedSym))
              (set! propagateAnnos false))
          LOCAL_VAR
            (do
              (set! ret
                    (Symbol$VarSymbol. (bit-and (.flags sym) Flags/FINAL)
                                       (.-name sym)
                                       (.-type sym)
                                       translatedSym))
              (set! (.-pos ret) (.-pos sym))
              (when (.isExceptionParameter sym) (.setData ret ElementKind/EXCEPTION_PARAMETER)))
          PARAM
            (do
              (set! ret
                    (Symbol$VarSymbol. (bit-or (bit-and (.flags sym) Flags/FINAL) Flags/PARAMETER)
                                       (.-name sym)
                                       (.erasure types (.-type sym))
                                       translatedSym))
              (set! (.-pos ret) (.-pos sym)))
          (do (Assert/error (.name skind)) (throw (AssertionError.))))
        (when (and (not (identical? ret sym)) propagateAnnos)
          (.setDeclarationAttributes ret (.getRawAttributes sym))
          (.setTypeAttributes ret (.getRawTypeAttributes sym)))
        ret))

    (method addLocal ^Symbol$VarSymbol [this ^Symbol$VarSymbol sym]
      (.addSymbol this sym LambdaSymbolKind/LOCAL_VAR))

    (method ^:private addSymbol ^Symbol$VarSymbol [this ^Symbol$VarSymbol sym
                                                   ^LambdaSymbolKind skind]
      (cast Symbol$VarSymbol
            (.computeIfAbsent lambdaProxies
                              sym
                              (lambda Function ^Symbol$VarSymbol [^Symbol$VarSymbol s]
                                (.translate this s skind)))))

    (method translate ^JCTree [this ^JCTree$JCIdent lambdaIdent]
      (let [tSym (cast Symbol (.get lambdaProxies (.-sym lambdaIdent)))]
        (when (some? tSym) ^JCTree (.setType (.Ident make tSym) (.-type lambdaIdent)))))

    (method generatedLambdaSig ^Type [this]
      (.erasure types (.getDescriptorType tree types)))

    (defclass LambdaCaptureScanner
      :extends CaptureScanner

      (field ^boolean capturesThis)

      (field ^{:tag (Set Symbol$ClassSymbol)} seenClasses (HashSet.))

      (constructor [this ^JCTree$JCLambda ownerTree] (super. ownerTree))

      (method ^:public visitClassDef ^void [this ^JCTree$JCClassDecl tree]
        (.add seenClasses (.-sym tree))
        (.visitClassDef super tree))

      (method ^:public visitIdent ^void [this ^JCTree$JCIdent tree]
        (if (and (and (and (not (.isStatic (.-sym tree)))
                           (identical? (.-kind (.-owner (.-sym tree))) Kinds$Kind/TYP))
                      (or (identical? (.-kind (.-sym tree)) Kinds$Kind/VAR)
                          (identical? (.-kind (.-sym tree)) Kinds$Kind/MTH)))
                 (not (.contains seenClasses (.-owner (.-sym tree)))))
            (if (not (== (bit-and (.flags (.-sym tree)) Flags/LOCAL_CAPTURE_FIELD) 0))
                (.addFreeVar this (cast Symbol$VarSymbol (.-sym tree)))
                (set! capturesThis true))
            (.visitIdent super tree)))

      (method ^:public visitSelect ^void [this ^JCTree$JCFieldAccess tree]
        (when (and (and (identical? (.-kind (.-sym tree)) Kinds$Kind/VAR)
                        (or (identical? (.-name (.-sym tree)) (.-_this names))
                            (identical? (.-name (.-sym tree)) (.-_super names))))
                   (not (.contains seenClasses (.-tsym (.-type (.-sym tree))))))
          (set! capturesThis true))
        (.visitSelect super tree))

      (method ^:public visitAnnotation ^void [this ^JCTree$JCAnnotation tree]))

    (defclass ^:enum LambdaSymbolKind
      (constants PARAM LOCAL_VAR CAPTURED_VAR)))

  (method ^:private typeSig ^String [this ^Type type]
    (.typeSig this type false))

  (method ^:private typeSig ^String [this ^Type type ^boolean allowIllegalSignature]
    (try
      (let [sg (L2MSignatureGenerator. allowIllegalSignature)]
        (.assembleSig sg type)
        (.toString sg))
      (catch Types$SignatureGenerator$InvalidSignatureException ex
        (let [^Symbol c (.-sym (.-enclClass attrEnv))]
          (.error log
                  (CompilerProperties$Errors/CannotGenerateClass
                    c
                    (CompilerProperties$Fragments/IllegalSignature c (.type ex))))
          "<ERRONEOUS>"))))

  (method ^:private classSig ^String [this ^Type type]
    (try
      (let [sg (L2MSignatureGenerator. false)] (.assembleClassSig sg type) (.toString sg))
      (catch Types$SignatureGenerator$InvalidSignatureException ex
        (let [^Symbol c (.-sym (.-enclClass attrEnv))]
          (.error log
                  (CompilerProperties$Errors/CannotGenerateClass
                    c
                    (CompilerProperties$Fragments/IllegalSignature c (.type ex))))
          "<ERRONEOUS>"))))

  (defclass ^:private L2MSignatureGenerator
    :extends Types$SignatureGenerator

    (field ^StringBuilder sb (StringBuilder.))

    (field ^boolean allowIllegalSignatures)

    (constructor [this ^boolean allowIllegalSignatures]
      (.super types)
      (set! (.-allowIllegalSignatures this) allowIllegalSignatures))

    (method ^:protected reportIllegalSignature ^void [this ^Type t]
      (when-not allowIllegalSignatures (.reportIllegalSignature super t)))

    (method ^:protected append ^void [this ^char ch] (.append sb ch))

    (method ^:protected append ^void [this ^byte/1 ba]
      (let [^:mutable ^Name name nil]
        (try
          (set! name (.fromUtf names ba))
          (catch InvalidUtfException e (throw (AssertionError. e))))
        (.append sb (.toString name))))

    (method ^:protected append ^void [this ^Name name]
      (.append sb (.toString name)))

    (method ^:public toString ^String [this] (.toString sb))))

  (defclass UniquePos
    (field ^int pos)

    (field ^DiagnosticSource source)

    (constructor [this ^JCTree tree]
      (set! (.-pos this) (.-pos tree))
      (set! (.-source this) (.currentSource log)))

    (method ^:public hashCode ^int [this]
      (bit-shift-left-int pos (unchecked-add-int 16 (.hashCode source))))

    (method ^:public equals ^boolean [this obj]
      (if-instance [^UniquePos uniquePos obj]
        (if (== pos (.-pos uniquePos)) (identical? source (.-source uniquePos)) false)
        false))

    (method ^:public toString ^String [this]
      (java-str (.getName (.getFile source)) " @ " (.getLineNumber source pos)))))

              (do
                (Assert/check (not (.insideOverloadPhase deferredAttrContext))
                              "attribution shouldn't be happening here")
                (let [instResultInfo (.dup resultInfo
                                           (.asInstType
                                             (.-inferenceContext deferredAttrContext)
                                             (.-pt resultInfo)))]
                  (.check dt instResultInfo dummyStuckPolicy)
                  true)))
        (throw (AssertionError. "Bad mode"))))

    (defclass StructuralStuckChecker
      :extends TreeScanner

      (field ^Attr$ResultInfo resultInfo)

      (field ^InferenceContext inferenceContext)

      (field ^{:tag (Env AttrContext)} env)

      (method ^:public check ^void [this ^DeferredType dt ^Attr$ResultInfo resultInfo
                                    ^DeferredAttrContext deferredAttrContext]
        (set! (.-resultInfo this) resultInfo)
        (set! (.-inferenceContext this) (.-inferenceContext deferredAttrContext))
        (set! (.-env this) (.-env dt))
        (.accept (.-tree dt) this)
        (.put (.-speculativeCache dt) stuckTree resultInfo))

      (method ^:public visitLambda ^void [this ^JCTree$JCLambda tree]
        (let [checkContext (.-checkContext resultInfo)
              pt (.-pt resultInfo)]
          (when-not (.contains (.-inferencevars inferenceContext) pt)
            (let [^:mutable ^Type descriptorType nil]
              (try
                (set! descriptorType (.findDescriptorType types pt))
                (catch Types$FunctionDescriptorLookupError ex
                  (.report checkContext nil (.getDiagnostic ex))))
              (when-not (== (.length (.getParameterTypes descriptorType)) (.length (.-params tree)))
                (.report
                  checkContext
                  tree
                  (.fragment diags CompilerProperties$Fragments/IncompatibleArgTypesInLambda)))
              (let [currentReturnType (.getReturnType descriptorType)
                    returnTypeIsVoid (.hasTag currentReturnType TypeTag/VOID)]
                (if (identical? (.getBodyKind tree) LambdaExpressionTree$BodyKind/EXPRESSION)
                    (let [isExpressionCompatible (or
                                                   (not returnTypeIsVoid)
                                                   (TreeInfo/isExpressionStatement
                                                     (cast JCTree$JCExpression (.getBody tree))))]
                      (when-not isExpressionCompatible
                        (.report
                          (.-checkContext resultInfo)
                          (.pos tree)
                          (.fragment diags
                                     (CompilerProperties$Fragments/IncompatibleRetTypeInLambda
                                       (CompilerProperties$Fragments/MissingRetVal
                                         currentReturnType))))))
                    (let [lambdaBodyChecker (LambdaBodyStructChecker.)]
                      (.accept (.-body tree) lambdaBodyChecker)
                      (let [isVoidCompatible (.-isVoidCompatible lambdaBodyChecker)]
                        (if returnTypeIsVoid
                            (when-not isVoidCompatible
                              (.report (.-checkContext resultInfo)
                                       (.pos tree)
                                       (.fragment
                                         diags
                                         CompilerProperties$Fragments/UnexpectedRetVal)))
                            (let [isValueCompatible (and
                                                      (.-isPotentiallyValueCompatible
                                                        lambdaBodyChecker)
                                                      (not
                                                        (.canLambdaBodyCompleteNormally this tree)))]
                              (when (and (not isValueCompatible) (not isVoidCompatible))
                                (.error
                                  log
                                  (.pos (.-body tree))
                                  CompilerProperties$Errors/LambdaBodyNeitherValueNorVoidCompatible))
                              (when-not isValueCompatible
                                (.report (.-checkContext resultInfo)
                                         (.pos tree)
                                         (.fragment
                                           diags
                                           (CompilerProperties$Fragments/IncompatibleRetTypeInLambda
                                             (CompilerProperties$Fragments/MissingRetVal
                                               currentReturnType)))))))))))))))

      (method canLambdaBodyCompleteNormally ^boolean [this ^JCTree$JCLambda tree]
        (let [^{:tag (List JCTree$JCVariableDecl)} oldParams (.-params tree)
              localCacheContext (.withLocalCacheContext argumentAttr)]
          (try
            (set! (.-params tree)
                  (cast List
                        (.collect
                          (.map (.stream (.-params tree))
                                (lambda Function ^JCTree$JCVariableDecl [^JCTree$JCVariableDecl vd]
                                  (.VarDef make (.-mods vd) (.-name vd) (.Erroneous make) nil)))
                          (List/collector))))
            (.-canCompleteNormally
              (.attribSpeculativeLambda DeferredAttr/this tree env (.-unknownExprInfo attr)))
            (finally (.leave localCacheContext) (set! (.-params tree) oldParams)))))

      (method ^:public visitNewClass ^void [this ^JCTree$JCNewClass tree])

      (method ^:public visitApply ^void [this ^JCTree$JCMethodInvocation tree])

      (method ^:public visitConditional ^void [this ^JCTree$JCConditional tree]
        (.scan this (.-truepart tree))
        (.scan this (.-falsepart tree)))

      (method ^:public visitSwitchExpression ^void [this ^JCTree$JCSwitchExpression tree]
        (.scan this (.-cases tree)))

      (method ^:public visitReference ^void [this ^JCTree$JCMemberReference tree]
        (Assert/checkNonNull (.getOverloadKind tree))
        (let [checkContext (.-checkContext resultInfo)
              pt (.-pt resultInfo)]
          (when-not (.contains (.-inferencevars inferenceContext) pt)
            (let [^:mutable ^Type descriptor nil]
              (try
                (set! descriptor (.findDescriptorType types pt))
                (catch Types$FunctionDescriptorLookupError ex
                  (.report checkContext nil (.getDiagnostic ex))))
              (let [^{:tag (Env AttrContext)} localEnv (.dup env tree)
                    ^:mutable ^JCTree$JCExpression exprTree nil]
                (set! exprTree
                      (cast JCTree$JCExpression
                            (.attribSpeculative DeferredAttr/this
                                                (.getQualifierExpression tree)
                                                localEnv
                                                (.memberReferenceQualifierResult attr tree)
                                                (.withLocalCacheContext argumentAttr))))
                (let [^{:tag (ListBuffer Type)} argtypes (ListBuffer.)]
                  (for-each [^Type t (.getParameterTypes descriptor)]
                    (.append argtypes Type/noType))
                  (let [mref2 (cast JCTree$JCMemberReference (.copy (TreeCopier. make) tree))]
                    (set! (.-expr mref2) exprTree)
                    (let [lookupSym (cast Symbol
                                          (.-fst
                                            (.resolveMemberReference
                                              rs
                                              localEnv
                                              mref2
                                              (.-type exprTree)
                                              (.-name tree)
                                              (.toList argtypes)
                                              (List/nil)
                                              descriptor
                                              (.-arityMethodCheck rs)
                                              inferenceContext
                                              (.-structuralReferenceChooser rs))))]
                      (switch (.-kind lookupSym)
                        (WRONG_MTH WRONG_MTHS)
                          (.report checkContext
                                   tree
                                   (.fragment
                                     diags
                                     CompilerProperties$Fragments/IncompatibleArgTypesInMref))
                        (ABSENT_MTH STATICERR)
                          (.report checkContext
                                   tree
                                   (.getDiagnostic
                                     (cast Resolve$ResolveError lookupSym)
                                     JCDiagnostic$DiagnosticType/FRAGMENT
                                     tree
                                     (.-tsym (.-type exprTree))
                                     (.-type exprTree)
                                     (.-name tree)
                                     (.toList argtypes)
                                     (List/nil)))))))))))))

    (defclass LambdaBodyStructChecker
      :extends TreeScanner

      (field ^boolean isVoidCompatible true)

      (field ^boolean isPotentiallyValueCompatible true)

      (method ^:public visitClassDef ^void [this ^JCTree$JCClassDecl tree])

      (method ^:public visitLambda ^void [this ^JCTree$JCLambda tree])

      (method ^:public visitNewClass ^void [this ^JCTree$JCNewClass tree])

      (method ^:public visitReturn ^void [this ^JCTree$JCReturn tree]
        (if (some? (.-expr tree))
            (set! isVoidCompatible false)
            (set! isPotentiallyValueCompatible false)))))

  (field ^:final ^DeferredAttrContext emptyDeferredAttrContext)

  (defclass DeferredTypeMap
    :extends (Type$StructuralTypeMapping T)
    :type-params [T]

    (field ^DeferredAttrContext deferredAttrContext)

    (constructor ^:protected [this ^AttrMode mode ^Symbol msym ^Resolve$MethodResolutionPhase phase]
      (set! (.-deferredAttrContext this)
            (DeferredAttrContext. mode
                                  msym
                                  phase
                                  (.-emptyContext infer)
                                  emptyDeferredAttrContext
                                  (.-noWarnings types))))

    (method ^:public visitType ^Type [this ^Type t ^T p]
      (if (not (.hasTag t TypeTag/DEFERRED))
          (.visitType super t p)
          (let [dt (cast DeferredType t)] (.typeOf this dt p))))

    (method ^:protected typeOf ^Type [this ^DeferredType dt ^T p]
      (switch (.-mode deferredAttrContext)
        CHECK (return (if (nil? (.-type (.-tree dt))) Type/noType (.-type (.-tree dt))))
        SPECULATIVE
          (return (.speculativeType dt (.-msym deferredAttrContext) (.-phase deferredAttrContext))))
      (Assert/error)
      nil))

  (defclass ^:public RecoveryDeferredTypeMap
    :extends (DeferredTypeMap Type)

    (constructor ^:public [this ^AttrMode mode ^Symbol msym ^Resolve$MethodResolutionPhase phase]
      (super. mode
              msym
              ^Resolve$MethodResolutionPhase (if (some? phase)
                                                 phase
                                                 Resolve$MethodResolutionPhase/BOX)))

    (method ^:protected typeOf ^Type [this ^DeferredType dt ^Type pt]
      (let [owntype (.typeOf super dt pt)]
        (if (identical? owntype Type/noType) (.recover this dt pt) owntype)))

    (method ^:public visitMethodType ^Type [this ^Type$MethodType t ^Type pt]
      (when (and (.hasTag t TypeTag/METHOD)
                 (identical? (.-mode (.-deferredAttrContext this)) AttrMode/CHECK))
        (let [^:mutable mtype (.-type (.-msym (.-deferredAttrContext this)))]
          (set! mtype
                (when (.hasTag mtype TypeTag/ERROR) (.getOriginalType (cast Type$ErrorType mtype))))
          (when (and (some? mtype) (.hasTag mtype TypeTag/METHOD))
            (let [^{:tag (List Type)} argtypes1 (.map
                                                  this
                                                  (.getParameterTypes t)
                                                  (.getParameterTypes mtype))
                  restype1 (cast Type (.visit this (.getReturnType t) (.getReturnType mtype)))
                  ^{:tag (List Type)} thrown1 (.map
                                                this
                                                (.getThrownTypes t)
                                                (.getThrownTypes mtype))]
              (if (and (and (identical? argtypes1 (.getParameterTypes t))
                            (identical? restype1 (.getReturnType t)))
                       (identical? thrown1 (.getThrownTypes t)))
                  (return t)
                  (return (Type$MethodType. argtypes1 restype1 thrown1 (.-tsym t))))))))
      (.visitMethodType super t pt))

    (method ^:private recover ^Type [this ^DeferredType dt ^Type pt]
      (let [isLambdaOrMemberRef (or (.hasTag (.-tree dt) JCTree$Tag/REFERENCE)
                                    (.hasTag (.-tree dt) JCTree$Tag/LAMBDA))
            needsRecoveryType (if (nil? pt)
                                  true
                                  (if-instance [^{:tag (ArgumentAttr$ArgumentType ?)} at dt]
                                    (if (.allMatch
                                          (.stream (.values (.-speculativeTypes at)))
                                          (lambda Predicate ^boolean [^Type type]
                                            (.hasTag type TypeTag/ERROR)))
                                        true
                                        (and isLambdaOrMemberRef
                                             (not (.isFunctionalInterface types pt))))
                                    (and isLambdaOrMemberRef
                                         (not (.isFunctionalInterface types pt)))))
            ^Type ptRecovery (if needsRecoveryType Type/recoveryType pt)]
        (.check dt
                (anon Attr$RecoveryInfo [(.-deferredAttrContext this) ptRecovery] :outer attr
                  (method ^:protected check ^Type [this ^JCDiagnostic$DiagnosticPosition pos
                                                   ^Type found]
                    (.checkNonVoid chk pos (.check super pos found)))))
        (.visit super dt)))

    (method ^:private map ^{:tag (List Type)} [this ^{:tag (List Type)} ts ^{:tag (List Type)} pts]
      (when (.nonEmpty ts)
        (let [^{:tag (List Type)} tail1 (.map this
                                              (.-tail ts)
                                              ^List (when (some? pts) (.-tail pts)))
              t (cast Type
                      (.visit this
                              (cast Type (.-head ts))
                              ^Type (when (and (some? pts) (.nonEmpty pts))
                                      (cast Type (.-head pts)))))]
          (when (or (not (identical? tail1 (.-tail ts))) (not (identical? t (.-head ts))))
            (return (.prepend tail1 t)))))
      ts))

  (defclass ^:abstract ^:static FilterScanner
    :extends TreeScanner

    (field ^:final ^{:tag (Predicate JCTree)} treeFilter)

    (constructor [this ^:final ^{:tag (Set JCTree$Tag)} validTags]
      (set! (.-treeFilter this)
            (lambda Predicate ^boolean [^JCTree t] (.contains validTags (.getTag t)))))

    (method ^:public scan ^void [this ^JCTree tree]
      (when (some? tree) (if (.test treeFilter tree) (.scan super tree) (.skip this tree))))

    (method skip ^void [this ^JCTree tree]))

  (defclass ^:static PolyScanner
    :extends FilterScanner

    (constructor [this]
      (super. (EnumSet/of JCTree$Tag/CONDEXPR
                          JCTree$Tag/PARENS
                          JCTree$Tag/LAMBDA
                          JCTree$Tag/REFERENCE
                          JCTree$Tag/SWITCH_EXPRESSION))))

  (defclass ^:static LambdaReturnScanner
    :extends FilterScanner

    (constructor [this]
      (super. (EnumSet/of JCTree$Tag/BLOCK
                          (new JCTree$Tag/1
                               [JCTree$Tag/CASE
                                JCTree$Tag/CATCH
                                JCTree$Tag/DOLOOP
                                JCTree$Tag/FOREACHLOOP
                                JCTree$Tag/FORLOOP
                                JCTree$Tag/IF
                                JCTree$Tag/RETURN
                                JCTree$Tag/SYNCHRONIZED
                                JCTree$Tag/SWITCH
                                JCTree$Tag/TRY
                                JCTree$Tag/WHILELOOP])))))

  (defclass ^:static SwitchExpressionScanner
    :extends FilterScanner

    (constructor [this]
      (super. (EnumSet/of JCTree$Tag/BLOCK
                          (new JCTree$Tag/1
                               [JCTree$Tag/CASE
                                JCTree$Tag/CATCH
                                JCTree$Tag/DOLOOP
                                JCTree$Tag/FOREACHLOOP
                                JCTree$Tag/FORLOOP
                                JCTree$Tag/IF
                                JCTree$Tag/SYNCHRONIZED
                                JCTree$Tag/SWITCH
                                JCTree$Tag/TRY
                                JCTree$Tag/WHILELOOP
                                JCTree$Tag/YIELD])))))

  (defclass CheckStuckPolicy
    :extends PolyScanner
    :implements [DeferredStuckPolicy Infer$FreeTypeListener]

    (field ^Type pt)

    (field ^InferenceContext inferenceContext)

    (field ^{:tag (Set Type)} stuckVars (LinkedHashSet.))

    (field ^{:tag (Set Type)} depVars (LinkedHashSet.))

    (method ^:public isStuck ^boolean [this] (not (.isEmpty stuckVars)))

    (method ^:public stuckVars ^{:tag (Set Type)} [this] stuckVars)

    (method ^:public depVars ^{:tag (Set Type)} [this] depVars)

    (constructor ^:public [this ^Attr$ResultInfo resultInfo ^DeferredType dt]
      (set! (.-pt this) (.-pt resultInfo))
      (set! (.-inferenceContext this) (.inferenceContext (.-checkContext resultInfo)))
      (.scan this (.-tree dt))
      (when-not (.isEmpty stuckVars)
        (.addFreeTypeListener (.inferenceContext (.-checkContext resultInfo))
                              (List/from stuckVars)
                              this)))

    (method ^:public typesInferred ^void [this ^InferenceContext inferenceContext]
      (.clear stuckVars))

    (method ^:public visitLambda ^void [this ^JCTree$JCLambda tree]
      (when (.contains (.inferenceVars inferenceContext) pt) (.add stuckVars pt))
      (when-not (not (.isFunctionalInterface types pt))
        (let [descType (.findDescriptorType types pt)
              ^{:tag (List Type)} freeArgVars (.freeVarsIn
                                                inferenceContext
                                                (.getParameterTypes descType))]
          (when (and (identical? (.-paramKind tree) JCTree$JCLambda$ParameterKind/IMPLICIT)
                     (.nonEmpty freeArgVars))
            (.addAll stuckVars freeArgVars)
            (.addAll depVars (.freeVarsIn inferenceContext (.getReturnType descType)))
            (.addAll depVars (.freeVarsIn inferenceContext (.getThrownTypes descType))))
          (.scanLambdaBody this tree (.getReturnType descType)))))

    (method ^:public visitReference ^void [this ^JCTree$JCMemberReference tree]
      (.scan this (.-expr tree))
      (if (.contains (.inferenceVars inferenceContext) pt)
          (.add stuckVars pt)
          (when-not (not (.isFunctionalInterface types pt))
            (let [descType (.findDescriptorType types pt)
                  ^{:tag (List Type)} freeArgVars (.freeVarsIn
                                                    inferenceContext
                                                    (.getParameterTypes descType))]
              (when (and (.nonEmpty freeArgVars)
                         (not (identical? (.getOverloadKind tree)
                                          JCTree$JCMemberReference$OverloadKind/UNOVERLOADED)))
                (.addAll stuckVars freeArgVars)
                (.addAll depVars (.freeVarsIn inferenceContext (.getReturnType descType)))
                (.addAll depVars (.freeVarsIn inferenceContext (.getThrownTypes descType))))))))

    (method scanLambdaBody ^void [this ^JCTree$JCLambda lambda ^:final ^Type pt]
      (if (identical? (.getBodyKind lambda) LambdaExpressionTree$BodyKind/EXPRESSION)
          (let [prevPt (.-pt this)]
            (try
              (set! (.-pt this) pt)
              (.scan this (.-body lambda))
              (finally (set! (.-pt this) prevPt))))
          (let [^LambdaReturnScanner lambdaScanner (anon LambdaReturnScanner []
                                                     (method ^:public visitReturn ^void [this
                                                                                         ^JCTree$JCReturn tree]
                                                       (when (some? (.-expr tree))
                                                         (let [prevPt (.-pt CheckStuckPolicy/this)]
                                                           (try
                                                             (set! (.-pt CheckStuckPolicy/this) pt)
                                                             (.scan
                                                               CheckStuckPolicy/this
                                                               (.-expr tree))
                                                             (finally
                                                               (set!
                                                                 (.-pt CheckStuckPolicy/this)
                                                                 prevPt)))))))]
            (.scan lambdaScanner (.-body lambda)))))

    (method ^:public visitSwitchExpression ^void [this ^JCTree$JCSwitchExpression expr]
      (let [^SwitchExpressionScanner switchScanner (anon SwitchExpressionScanner []
                                                     (method ^:public visitYield ^void [this
                                                                                        ^JCTree$JCYield tree]
                                                       (let [prevPt (.-pt CheckStuckPolicy/this)]
                                                         (try
                                                           (set! (.-pt CheckStuckPolicy/this) pt)
                                                           (.scan
                                                             CheckStuckPolicy/this
                                                             (.-value tree))
                                                           (finally
                                                             (set!
                                                               (.-pt CheckStuckPolicy/this)
                                                               prevPt))))))]
        (.scan switchScanner (.-cases expr)))))

  (defclass OverloadStuckPolicy
    :extends CheckStuckPolicy
    :implements [DeferredStuckPolicy]

    (field ^boolean stuck)

    (method ^:public isStuck ^boolean [this] (or (.isStuck super) stuck))

    (constructor ^:public [this ^Attr$ResultInfo resultInfo ^DeferredType dt]
      (super. resultInfo dt))

    (method ^:public visitLambda ^void [this ^JCTree$JCLambda tree]
      (.visitLambda super tree)
      (when (identical? (.-paramKind tree) JCTree$JCLambda$ParameterKind/IMPLICIT)
        (set! stuck true)))

    (method ^:public visitReference ^void [this ^JCTree$JCMemberReference tree]
      (.visitReference super tree)
      (when-not (identical? (.getOverloadKind tree)
                            JCTree$JCMemberReference$OverloadKind/UNOVERLOADED)
        (set! stuck true))))

  (defclass ^:enum AttributionMode
    (constants
      (FULL [false true])
      (ATTRIB_TO_TREE [true true])
      (ANALYZER [true false])
      (SPECULATIVE [true false]))

    (constructor [this ^boolean isSpeculative ^boolean recover]
      (set! (.-isSpeculative this) isSpeculative)
      (set! (.-recover this) recover))

    (method isSpeculative ^boolean [this] isSpeculative)

    (method recover ^boolean [this] recover)

    (field ^:final ^boolean isSpeculative)

    (field ^:final ^boolean recover)))

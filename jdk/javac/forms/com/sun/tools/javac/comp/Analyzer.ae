  (defclass DiamondInitializer
    :extends (StatementAnalyzer JCTree$JCNewClass JCTree$JCNewClass)

    (constructor [this] (super. AnalyzerMode/DIAMOND JCTree$Tag/NEWCLASS))

    (method match ^boolean [this ^JCTree$JCNewClass tree]
      (and (and (.hasTag (.-clazz tree) JCTree$Tag/TYPEAPPLY) (not (TreeInfo/isDiamond tree)))
           (or (nil? (.-def tree)) allowDiamondWithAnonymousClassCreation)))

    (method rewrite ^{:tag (List JCTree$JCNewClass)} [this ^JCTree$JCNewClass oldTree]
      (if (and (.hasTag (.-clazz oldTree) JCTree$Tag/TYPEAPPLY)
               (not (.isErroneous (.-type oldTree))))
          (let [nc (cast JCTree$JCNewClass (.copy copier oldTree))]
            (set! (.-arguments (cast JCTree$JCTypeApply (.-clazz nc))) (List/nil))
            (List/of nc))
          (List/of oldTree)))

    (method process ^void [this ^JCTree$JCNewClass oldTree ^JCTree$JCNewClass newTree
                           ^boolean hasErrors]
      (when-not hasErrors
        (let [^:mutable ^{:tag (List Type)} inferredArgs nil
              ^:mutable ^{:tag (List Type)} explicitArgs nil]
          (if (some? (.-def oldTree))
              (do
                (set! inferredArgs
                      (if (.nonEmpty (.-implementing (.-def newTree)))
                          (.getTypeArguments
                            (.-type (cast JCTree$JCExpression
                                          (.get (.-implementing (.-def newTree)) 0))))
                          (.getTypeArguments (.-type (.-extending (.-def newTree))))))
                (set! explicitArgs
                      (if (.nonEmpty (.-implementing (.-def oldTree)))
                          (.getTypeArguments
                            (.-type (cast JCTree$JCExpression
                                          (.get (.-implementing (.-def oldTree)) 0))))
                          (.getTypeArguments (.-type (.-extending (.-def oldTree)))))))
              (do
                (set! inferredArgs (.getTypeArguments (.-type newTree)))
                (set! explicitArgs (.getTypeArguments (.-type oldTree)))))
          (for-each [^Type t inferredArgs]
            (when-not (.isSameType types t (cast Type (.-head explicitArgs))) (return))
            (set! explicitArgs (.-tail explicitArgs)))
          (.warning log (.-clazz oldTree) CompilerProperties$Warnings/DiamondRedundantArgs)))))

  (defclass LambdaAnalyzer
    :extends (StatementAnalyzer JCTree$JCNewClass JCTree$JCLambda)

    (constructor [this] (super. AnalyzerMode/LAMBDA JCTree$Tag/NEWCLASS))

    (method match ^boolean [this ^JCTree$JCNewClass tree]
      (let [clazztype (.-type (.-clazz tree))]
        (and (and (and (some? (.-def tree)) (.hasTag clazztype TypeTag/CLASS))
                  (.isFunctionalInterface types (.-tsym clazztype)))
             (== (.length (.decls this (.-def tree))) 1))))


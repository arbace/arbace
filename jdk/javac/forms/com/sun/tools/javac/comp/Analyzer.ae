                      Attr$ResultInfo
                      (.-pkind (.-returnResult (cast AttrContext (.-info analyzeEnv))))
                      (.-pt (.-returnResult (cast AttrContext (.-info analyzeEnv)))))))
        analyzeEnv)))

  (method analyzeIfNeeded ^void [this ^JCTree tree ^{:tag (Env AttrContext)} env]

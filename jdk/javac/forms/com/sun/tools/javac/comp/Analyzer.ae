      (.scan statementScanner)
      (when-not (.isEmpty (.-rewritings statementScanner))
        (for-each [^RewritingContext rewriting (.-rewritings statementScanner)]
          (.queue deferredAnalysisHelper rewriting)))))

  (defclass ^:interface DeferredAnalysisHelper
    (method queue ^void [this ^RewritingContext rewriting])

    (method flush ^void [this ^{:tag (Env AttrContext)} flushEnv]))

  (field ^DeferredAnalysisHelper flushDeferredHelper
    (anon DeferredAnalysisHelper []
      (method ^:public queue ^void [this ^RewritingContext rewriting])

      (method ^:public flush ^void [this ^{:tag (Env AttrContext)} flushEnv])))

  (field ^DeferredAnalysisHelper queueDeferredHelper
    (anon DeferredAnalysisHelper []
      (field ^{:tag (Map Symbol$ClassSymbol (Queue RewritingContext))} Q (HashMap.))

      (method ^:public queue ^void [this ^RewritingContext rewriting]
        (let [^{:tag (Queue RewritingContext)} s (cast
                                                   Queue
                                                   (.computeIfAbsent
                                                     Q
                                                     (.outermostClass
                                                       (.-sym (.-enclClass (.-env rewriting))))
                                                     (lambda Function ^Queue [^Symbol$ClassSymbol k]
                                                       (ArrayDeque.))))]
          (.add s rewriting)))

      (method ^:public flush ^void [this ^{:tag (Env AttrContext)} flushEnv]
        (when-not (.isEmpty Q)
          (let [prevHelper deferredAnalysisHelper]
            (try
              (set! deferredAnalysisHelper flushDeferredHelper)
              (let [^{:tag (Queue RewritingContext)} rewritings (cast
                                                                  Queue
                                                                  (.get
                                                                    Q
                                                                    (.outermostClass
                                                                      (.-sym (.-enclClass flushEnv)))))]
                (while (and (some? rewritings) (not (.isEmpty rewritings)))
                  (.doAnalysis Analyzer/this (cast RewritingContext (.remove rewritings)))))
              (finally (set! deferredAnalysisHelper prevHelper))))))))

  (field ^DeferredAnalysisHelper deferredAnalysisHelper queueDeferredHelper)

  (method doAnalysis ^void [this ^RewritingContext rewriting]
    (let [prevSource (.currentSource log)
          localCacheContext (.withLocalCacheContext argumentAttr)]
      (try
        (.useSource log (.getSourceFile (.-toplevel (.-env rewriting))))
        (let [^:mutable treeToAnalyze (cast JCTree$JCStatement (.-originalTree rewriting))
              ^:mutable ^JCTree wrappedTree nil]
          (when (identical? (.-kind (.-owner
                                      (.-scope (cast AttrContext (.-info (.-env rewriting))))))
                            Kinds$Kind/TYP)
            (set! treeToAnalyze
                  (.Block (.at make Position/NOPOS)
                          Flags/SYNTHETIC
                          (List/of (cast JCTree$JCStatement (.-originalTree rewriting)))))
            (set! wrappedTree (.-originalTree rewriting)))
          (.attribSpeculative deferredAttr
                              treeToAnalyze
                              (.-env rewriting)
                              (.-statInfo attr)
                              (TreeRewriter. rewriting wrappedTree)
                              (lambda Supplier ^Log$DiagnosticHandler [] (.diagHandler rewriting))
                              DeferredAttr$AttributionMode/ANALYZER
                              (.withLocalCacheContext argumentAttr))
          (.process (.-analyzer rewriting)
                    (.-oldTree rewriting)
                    (.-replacement rewriting)
                    (.-erroneous rewriting)))
        (catch Throwable ex
          (Assert/error (java-str "Analyzer error when processing: "
                                  (.-originalTree rewriting)
                                  ":"
                                  (.toString ex)
                                  "\n"
                                  (cast String
                                        (.collect
                                          (.map (Arrays/stream (.getStackTrace ex))
                                                (lambda Function ^String [^StackTraceElement se]
                                                  (.toString se)))
                                          (Collectors/joining "\n"))))))
        (finally (.useSource log (.getFile prevSource)) (.leave localCacheContext)))))

  (method ^:public flush ^void [this ^{:tag (Env AttrContext)} flushEnv]
    (.flush deferredAnalysisHelper flushEnv))

  (defclass StatementScanner
    :extends TreeScanner

    (field ^{:tag (ListBuffer RewritingContext)} rewritings (ListBuffer.))

    (field ^JCTree originalTree)

    (field ^{:tag (Env AttrContext)} env)

    (constructor [this ^JCTree originalTree ^{:tag (Env AttrContext)} env]
      (set! (.-originalTree this) originalTree)
      (set! (.-env this) (.copyEnv attr env)))

    (method ^:public scan ^void [this] (.scan this originalTree))

    (method ^:public scan ^void [this ^JCTree tree]
      (when (some? tree)
        (for-each [^{:tag (StatementAnalyzer JCTree JCTree)} analyzer analyzers]
          (when (and (and (.isEnabled analyzer) (.hasTag tree (.-tag analyzer)))
                     (.match analyzer tree))
            (for-each [^JCTree t (.rewrite analyzer tree)]
              (.add rewritings (RewritingContext. originalTree tree t analyzer env)))
            (break))))
      (.scan super tree))

    (method ^:public visitClassDef ^void [this ^JCTree$JCClassDecl tree])

    (method ^:public visitMethodDef ^void [this ^JCTree$JCMethodDecl tree])

    (method ^:public visitBlock ^void [this ^JCTree$JCBlock tree])

    (method ^:public visitLambda ^void [this ^JCTree$JCLambda tree])

    (method ^:public visitSwitch ^void [this ^JCTree$JCSwitch tree]
      (.scan this (.getExpression tree)))

    (method ^:public visitForLoop ^void [this ^JCTree$JCForLoop tree]
      (.scan this (.getCondition tree))
      (.scan this (.getUpdate tree)))

    (method ^:public visitTry ^void [this ^JCTree$JCTry tree]
      (.scan this (.getBlock tree))
      (.scan this (.getCatches tree))
      (.scan this (.getFinallyBlock tree)))

    (method ^:public visitForeachLoop ^void [this ^JCTree$JCEnhancedForLoop tree]
      (.scan this (.getExpression tree)))

    (method ^:public visitWhileLoop ^void [this ^JCTree$JCWhileLoop tree]
      (.scan this (.getCondition tree)))

    (method ^:public visitDoLoop ^void [this ^JCTree$JCDoWhileLoop tree]
      (.scan this (.getCondition tree)))

    (method ^:public visitIf ^void [this ^JCTree$JCIf tree]
      (.scan this (.getCondition tree))))

  (defclass RewritingContext
    (field ^JCTree originalTree)

    (field ^JCTree oldTree)

    (field ^JCTree replacement)

    (field ^boolean erroneous)

    (field ^{:tag (Env AttrContext)} env)

    (field ^{:tag (StatementAnalyzer JCTree JCTree)} analyzer)

    (constructor [this ^JCTree originalTree ^JCTree oldTree ^JCTree replacement
                  ^{:tag (StatementAnalyzer JCTree JCTree)} analyzer ^{:tag (Env AttrContext)} env]
      (set! (.-originalTree this) originalTree)
      (set! (.-oldTree this) oldTree)
      (set! (.-replacement this) replacement)
      (set! (.-analyzer this) analyzer)
      (set! (.-env this) (.copyEnv attr env))
      (when (.hasTag originalTree JCTree$Tag/VARDEF)
        (.remove (.-scope (cast AttrContext (.-info (.-env this))))
                 (.-sym (cast JCTree$JCVariableDecl originalTree)))))

    (method diagHandler ^Log$DeferredDiagnosticHandler [this]
      (.new log
            Log$DeferredDiagnosticHandler
            (lambda Predicate ^boolean [^JCDiagnostic d]
              (when (identical? (.getType d) JCDiagnostic$DiagnosticType/ERROR)
                (set! erroneous true))
              true)
            false)))

  (defclass AnalyzerCopier
    :extends (TreeCopier Void)

    (constructor ^:public [this] (super. make))

    (method ^:public visitLambdaExpression ^JCTree [this ^LambdaExpressionTree node ^Void _unused]
      (let [oldLambda (cast JCTree$JCLambda node)
            newLambda (cast JCTree$JCLambda (.visitLambdaExpression super node _unused))]
        (when (identical? (.-paramKind oldLambda) JCTree$JCLambda$ParameterKind/IMPLICIT)
          (set! (.-paramKind newLambda) JCTree$JCLambda$ParameterKind/IMPLICIT)
          (.forEach (.-params newLambda)
                    (lambda Consumer ^void [^JCTree$JCVariableDecl p] (set! (.-vartype p) nil))))
        newLambda))

    (method ^:public visitNewClass ^JCTree [this ^NewClassTree node ^Void aVoid]
      (let [oldNewClazz (cast JCTree$JCNewClass node)
            newNewClazz (cast JCTree$JCNewClass (.visitNewClass super node aVoid))]
        (when (and (not (.isEmpty (.-args oldNewClazz)))
                   (.hasTag (cast JCTree$JCExpression (.-head (.-args oldNewClazz)))
                            JCTree$Tag/NULLCHK))
          (set! (.-encl newNewClazz) (.-arg (cast JCTree$JCUnary (.-head (.-args newNewClazz)))))
          (set! (.-args newNewClazz) (.-tail (.-args newNewClazz))))
        newNewClazz)))

  (defclass TreeRewriter
    :extends AnalyzerCopier

    (field ^RewritingContext rewriting)

    (field ^JCTree wrappedTree)

    (constructor [this ^RewritingContext rewriting ^JCTree wrappedTree]
      (set! (.-rewriting this) rewriting)
      (set! (.-wrappedTree this) wrappedTree))

    (method ^:public copy :type-params [(Z extends JCTree)] ^Z [this ^Z tree ^Void _unused]
      (let [^:mutable ^Z newTree (.copy super tree nil)]
        (when (and (some? tree) (identical? tree (.-oldTree rewriting)))
          (Assert/checkNonNull (.-replacement rewriting))
          (set! newTree (.-replacement rewriting)))
        newTree))

    (method ^:public visitVariable ^JCTree [this ^VariableTree node ^Void p]
      (let [result (.visitVariable super node p)]
        (when (identical? node wrappedTree)
          (let [o-1 (.-mods (cast JCTree$JCVariableDecl result))]
            (set! (.-flags o-1) (bit-and (.-flags o-1) Flags/FINAL))))
        result))))

                (when (== (bit-and (.-flags (.getModifiers md)) Flags/GENERATEDCONSTR) 0)
                  (.add decls md)))
              (.add decls t)))
        (.toList decls)))

    (method rewrite ^{:tag (List JCTree$JCLambda)} [this ^JCTree$JCNewClass oldTree]
      (let [md (cast JCTree$JCMethodDecl
                     (.copy copier (cast JCTree (.-head (.decls this (.-def oldTree))))))
            ^{:tag (List JCTree$JCVariableDecl)} params (.-params md)
            body (.-body md)
            newTree (.Lambda (.at make oldTree) params body)]
        (List/of newTree)))

    (method process ^void [this ^JCTree$JCNewClass oldTree ^JCTree$JCLambda newTree
                           ^boolean hasErrors]
      (when-not hasErrors
        (.warning log (.-def oldTree) CompilerProperties$Warnings/PotentialLambdaFound))))


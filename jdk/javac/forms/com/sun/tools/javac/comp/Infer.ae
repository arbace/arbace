  (method generateReturnConstraints ^Type [this ^JCTree tree ^Attr$ResultInfo resultInfo
                                           ^Type$MethodType mt ^InferenceContext inferenceContext]
    (let [rsInfoInfContext (.inferenceContext (.-checkContext resultInfo))
          ^:mutable from (.getReturnType mt)]
      (when (and (.containsAny (.getReturnType mt) (.-inferencevars inferenceContext))
                 (not (identical? rsInfoInfContext emptyContext)))
        (set! from (.capture types from))
        (for-each [^Type t (.getTypeArguments from)]
          (when (and (.hasTag t TypeTag/TYPEVAR) (.isCaptured (cast Type$TypeVar t)))
            (.addVar inferenceContext (cast Type$TypeVar t)))))
      (let [^:mutable qtype (.asUndetVar inferenceContext from)
            ^:mutable to (.-pt resultInfo)]
        (cond
          (.hasTag qtype TypeTag/VOID) (set! to (.-voidType syms))
          (.hasTag to TypeTag/NONE) (set! to (if (.isPrimitive from) from (.-objectType syms)))
          (.hasTag qtype TypeTag/UNDETVAR)

                    JCDiagnostic$DiagnosticFlag/SOURCE_LEVEL
                    (.pos (.-clazz tree))
                    (CompilerProperties$Errors/CantApplyDiamond1
                      t
                      (.fragment Source$Feature/DIAMOND_WITH_ANONYMOUS_CLASS_CREATION
                                 (.-name source)))))

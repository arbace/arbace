                          (CompilerProperties$Fragments/DiamondNonGeneric t)))
                (.createErrorType types t))
            (and (some? (.-typeargs tree)) (.nonEmpty (.-typeargs tree)))
              (do
                (.error log
                        (.pos (.-clazz tree))
                        (CompilerProperties$Errors/CantApplyDiamond1
                          t
                          (CompilerProperties$Fragments/DiamondAndExplicitParams t)))
                (.createErrorType types t))
            :else t))))

  (method checkDiamondDenotable ^{:tag (List Type)} [this ^Type$ClassType t]
    (let [^{:tag (ListBuffer Type)} buf (ListBuffer.)]
      (for-each [^Type arg (.allparams t)] (when-not (.checkDenotable this arg) (.append buf arg)))
      (.toList buf)))

  (method ^:public checkDenotable ^boolean [this ^Type t]
    (.booleanValue (cast Boolean (.visit denotableChecker t nil))))

  (field ^:private ^:static ^:final ^{:tag (Types$SimpleVisitor Boolean Void)} denotableChecker
    (anon (Types$SimpleVisitor Boolean Void) []
      (method ^:public visitType ^Boolean [this ^Type t ^Void s] true)

      (method ^:public visitClassType ^Boolean [this ^Type$ClassType t ^Void s]
        (if (or (.isUnion t) (.isIntersection t))
            false
            (do
              (for-each [^Type targ (.allparams t)]
                (when-not (.booleanValue (cast Boolean (.visit this targ s))) (return false)))
              true)))

      (method ^:public visitTypeVar ^Boolean [this ^Type$TypeVar t ^Void s]
        (== (bit-and (.flags (.-tsym t)) Flags/SYNTHETIC) 0))

      (method ^:public visitCapturedType ^Boolean [this ^Type$CapturedType t ^Void s]
        false)

      (method ^:public visitArrayType ^Boolean [this ^Type$ArrayType t ^Void s]
        (cast Boolean (.visit this (.-elemtype t) s)))

      (method ^:public visitWildcardType ^Boolean [this ^Type$WildcardType t ^Void s]
        (cast Boolean (.visit this (.-type t) s)))))

  (method checkVarargsMethodDecl ^void [this ^{:tag (Env AttrContext)} env ^JCTree$JCMethodDecl tree]
    (let [m (.-sym tree)
          hasTrustMeAnno (some? (.attribute m (.-tsym (.-trustMeType syms))))
          ^:mutable ^Type varargElemType nil]
      (when (.isVarArgs m)
        (set! varargElemType
              (.elemtype types (.-type (cast JCTree$JCVariableDecl (.last (.-params tree)))))))
      (cond
        (and hasTrustMeAnno (not (.isTrustMeAllowedOnMethod this m)))
          (if (some? varargElemType)
              (let [^JCDiagnostic msg (if (.allowedInSource
                                            Source$Feature/PRIVATE_SAFE_VARARGS
                                            source)
                                          (.fragment
                                            diags
                                            (CompilerProperties$Fragments/VarargsTrustmeOnVirtualVarargs
                                              m))
                                          (.fragment
                                            diags
                                            (CompilerProperties$Fragments/VarargsTrustmeOnVirtualVarargsFinalOnly
                                              m)))]
                (.error log
                        tree
                        (CompilerProperties$Errors/VarargsInvalidTrustmeAnno
                          (.-tsym (.-trustMeType syms))
                          msg)))
              (.error log
                      tree
                      (CompilerProperties$Errors/VarargsInvalidTrustmeAnno
                        (.-tsym (.-trustMeType syms))
                        (CompilerProperties$Fragments/VarargsTrustmeOnNonVarargsMeth m))))
        (and (and hasTrustMeAnno (some? varargElemType)) (.isReifiable types varargElemType))
          (.warning log
                    (.pos tree)
                    (CompilerProperties$LintWarnings/VarargsRedundantTrustmeAnno
                      (.-tsym (.-trustMeType syms))
                      (.fragment diags
                                 (CompilerProperties$Fragments/VarargsTrustmeOnReifiableVarargs
                                   varargElemType))))
        (and (and (not hasTrustMeAnno) (some? varargElemType))
             (not (.isReifiable types varargElemType)))
          (.warnUnchecked this
                          (.pos (cast JCTree$JCVariableDecl (.-head (.-params tree))))
                          (CompilerProperties$LintWarnings/UncheckedVarargsNonReifiableType
                            varargElemType)))))

  (method ^:private isTrustMeAllowedOnMethod ^boolean [this ^Symbol s]
    (and (not (== (bit-and (.flags s) Flags/VARARGS) 0))
         (or (.isConstructor s)
             (not (== (bit-and (.flags s)
                               (bit-or-int (bit-or-int Flags/STATIC Flags/FINAL)
                                           (if (.allowedInSource
                                                 Source$Feature/PRIVATE_SAFE_VARARGS
                                                 source)
                                               Flags/PRIVATE
                                               0)))
                      0)))))

  (method checkLocalVarType ^Type [this ^JCDiagnostic$DiagnosticPosition pos ^Type t ^Name name]
    (cond
      (.hasTag t TypeTag/BOT)
        (do
          (.error log
                  pos
                  (CompilerProperties$Errors/CantInferLocalVarType
                    name
                    CompilerProperties$Fragments/LocalCantInferNull))
          (.createErrorType types t))
      (.hasTag t TypeTag/VOID)
        (do
          (.error log
                  pos
                  (CompilerProperties$Errors/CantInferLocalVarType
                    name
                    CompilerProperties$Fragments/LocalCantInferVoid))
          (.createErrorType types t))
      :else (.baseType (.upward types t (.captures types t)))))

  (method checkMethod ^Type [this ^:final ^Type mtype ^:final ^Symbol sym
                             ^:final ^{:tag (Env AttrContext)} env
                             ^:final ^{:tag (List JCTree$JCExpression)} argtrees
                             ^:final ^{:tag (List Type)} argtypes ^:final ^boolean useVarargs
                             ^InferenceContext inferenceContext]
    (if (.free inferenceContext mtype)
        (do
          (.addFreeTypeListener
            inferenceContext
            (List/of mtype)
            (lambda Infer$FreeTypeListener ^void [^InferenceContext solvedContext]
              (.checkMethod this
                            (.asInstType solvedContext mtype)
                            sym
                            env
                            argtrees
                            argtypes
                            useVarargs
                            solvedContext)))
          mtype)
        (let [owntype mtype
              ^:mutable ^{:tag (List Type)} formals (.getParameterTypes owntype)
              ^:mutable ^{:tag (List Type)} nonInferred (.getParameterTypes (.-type sym))]
          (when-not (== (.length nonInferred) (.length formals)) (set! nonInferred formals))
          (let [^Type last (when useVarargs (cast Type (.last formals)))]
            (when (and (identical? (.-name sym) (.-init names))
                       (identical? (.-owner sym) (.-enumSym syms)))
              (set! formals (.-tail (.-tail formals)))
              (set! nonInferred (.-tail (.-tail nonInferred))))
            (when-not (== (bit-and (.flags sym) Flags/ANONCONSTR_BASED) 0)
              (set! formals (.-tail formals))
              (set! nonInferred (.-tail nonInferred)))
            (let [^:mutable ^{:tag (List JCTree$JCExpression)} args argtrees]
              (when (some? args)
                (while (not (identical? (.-head formals) last))
                  (let [arg (cast JCTree (.-head args))
                        warn (.convertWarner this
                                             (.pos arg)
                                             (.-type arg)
                                             (cast Type (.-head nonInferred)))]
                    (.assertConvertible this arg (.-type arg) (cast Type (.-head formals)) warn)
                    (set! args (.-tail args))
                    (set! formals (.-tail formals))
                    (set! nonInferred (.-tail nonInferred))))
                (cond
                  useVarargs
                    (let [varArg (.elemtype types last)]
                      (while (some? (.-tail args))
                        (let [arg (cast JCTree (.-head args))
                              warn (.convertWarner this (.pos arg) (.-type arg) varArg)]
                          (.assertConvertible this arg (.-type arg) varArg warn)
                          (set! args (.-tail args)))))
                  (== (bit-and (.flags sym) (bit-or Flags/VARARGS Flags/SIGNATURE_POLYMORPHIC))
                      Flags/VARARGS)
                    (let [varParam (cast Type (.last (.getParameterTypes owntype)))
                          lastArg (cast Type (.last argtypes))]
                      (when (and (.isSubtypeUnchecked types lastArg (.elemtype types varParam))
                                 (not (.isSameType
                                        types
                                        (.erasure types varParam)
                                        (.erasure types lastArg))))
                        (.warning log
                                  (.pos (cast JCTree$JCExpression (.last argtrees)))
                                  (CompilerProperties$Warnings/InexactNonVarargsCall
                                    (.elemtype types varParam)
                                    varParam))))))
              (when useVarargs
                (let [argtype (cast Type (.last (.getParameterTypes owntype)))]
                  (when (and (not (.isReifiable types argtype))
                             (or (nil? (.attribute (.baseSymbol sym) (.-tsym (.-trustMeType syms))))
                                 (not (.isTrustMeAllowedOnMethod this sym))))
                    (.warnUnchecked this
                                    (.pos (.-tree env))
                                    (CompilerProperties$LintWarnings/UncheckedGenericArrayCreation
                                      argtype)))
                  (TreeInfo/setVarargsElement (.-tree env) (.elemtype types argtype))))
              owntype)))))

  (method ^:private assertConvertible ^void [this ^JCTree tree ^Type actual ^Type formal
                                             ^Warner warn]
    (when-not (.isConvertible types actual formal warn)
      (when (and (and (.isCompound formal) (.isSubtype types actual (.supertype types formal)))
                 (.isSubtypeUnchecked types actual (.interfaces types formal) warn))
        nil)))

  (method ^:public checkValidGenericType ^boolean [this ^Type t]
    (nil? (.firstIncompatibleTypeArg this t)))

  (method ^:private firstIncompatibleTypeArg ^Type [this ^Type type]
    (let [^{:tag (List Type)} formals (.allparams (.-type (.-tsym type)))
          ^{:tag (List Type)} actuals (.allparams type)
          ^:mutable ^{:tag (List Type)} args (.getTypeArguments type)
          ^:mutable ^{:tag (List Type)} forms (.getTypeArguments (.-type (.-tsym type)))
          ^{:tag (ListBuffer Type)} bounds_buf (ListBuffer.)]
      (while (and (.nonEmpty args) (.nonEmpty forms))
        (.append bounds_buf
                 (.subst types (.getUpperBound (cast Type (.-head forms))) formals actuals))
        (set! args (.-tail args))
        (set! forms (.-tail forms)))
      (set! args (.getTypeArguments type))
      (let [^:mutable ^{:tag (List Type)} tvars_cap (.substBounds
                                                      types
                                                      formals
                                                      formals
                                                      (.allparams (.capture types type)))]
        (while (and (.nonEmpty args) (.nonEmpty tvars_cap))
          (.withTypeVar (cast Type (.-head args)) (cast Type$TypeVar (.-head tvars_cap)))
          (set! args (.-tail args))
          (set! tvars_cap (.-tail tvars_cap)))
        (set! args (.getTypeArguments type))
        (let [^:mutable ^{:tag (List Type)} bounds (.toList bounds_buf)]
          (while (and (.nonEmpty args) (.nonEmpty bounds))
            (let [actual (cast Type (.-head args))]
              (when (and (and (not (.isTypeArgErroneous this actual))
                              (not (.isErroneous (cast Type (.-head bounds)))))
                         (not (.checkExtends this actual (cast Type (.-head bounds)))))
                (return (cast Type (.-head args))))
              (set! args (.-tail args))
              (set! bounds (.-tail bounds))))
          (set! args (.getTypeArguments type))
          (set! bounds (.toList bounds_buf))
          (for-each [^Type arg (.getTypeArguments (.capture types type))]
            (when (and (and (and (.hasTag arg TypeTag/TYPEVAR) (.isErroneous (.getUpperBound arg)))
                            (not (.isErroneous (cast Type (.-head bounds)))))
                       (not (.isTypeArgErroneous this (cast Type (.-head args)))))
              (return (cast Type (.-head args))))
            (set! bounds (.-tail bounds))
            (set! args (.-tail args)))
          nil))))

  (method isTypeArgErroneous ^boolean [this ^Type t]
    (.booleanValue (cast Boolean (.visit isTypeArgErroneous t))))

  (field ^{:tag (Types$UnaryVisitor Boolean)} isTypeArgErroneous
    (anon (Types$UnaryVisitor Boolean) []
      (method ^:public visitType ^Boolean [this ^Type t ^Void s]
        (.isErroneous t))

      (method ^:public visitTypeVar ^Boolean [this ^Type$TypeVar t ^Void s]
        (cast Boolean (.visit this (.getUpperBound t))))

      (method ^:public visitCapturedType ^Boolean [this ^Type$CapturedType t ^Void s]
        (or (.booleanValue (cast Boolean (.visit this (.getUpperBound t))))
            (.booleanValue (cast Boolean (.visit this (.getLowerBound t))))))

      (method ^:public visitWildcardType ^Boolean [this ^Type$WildcardType t ^Void s]
        (cast Boolean (.visit this (.-type t))))))

  (method checkFlags ^long [this ^long flags ^Symbol sym ^JCTree tree]
    (let [pos (.pos tree)
          ^:mutable ^long mask 0
          ^:mutable implicit 0]
      (switch (.-kind sym)
        VAR
          (cond
            (TreeInfo/isReceiverParam tree) (set! mask Flags/ReceiverParamFlags)
            (not (identical? (.-kind (.-owner sym)) Kinds$Kind/TYP)) (set! mask Flags/LocalVarFlags)
            (not (== (bit-and (.-flags_field (.-owner sym)) Flags/INTERFACE) 0))
              (set! mask (set! implicit Flags/InterfaceVarFlags))
            :else (set! mask Flags/VarFlags))
        MTH
          (do
            (cond
              (identical? (.-name sym) (.-init names))
                (if (not (== (bit-and (.-flags_field (.-owner sym)) Flags/ENUM) 0))
                    (do (set! implicit Flags/PRIVATE) (set! mask Flags/PRIVATE))
                    (set! mask Flags/ConstructorFlags))
              (not (== (bit-and (.-flags_field (.-owner sym)) Flags/INTERFACE) 0))
                (cond
                  (not (== (bit-and (.-flags_field (.-owner sym)) Flags/ANNOTATION) 0))
                    (do
                      (set! mask Flags/AnnotationTypeElementMask)
                      (set! implicit (bit-or-int Flags/PUBLIC Flags/ABSTRACT)))
                  (not (== (bit-and flags
                                    (bit-or (bit-or Flags/DEFAULT Flags/STATIC) Flags/PRIVATE))
                           0))
                    (do
                      (set! mask Flags/InterfaceMethodMask)
                      (set! implicit (if (not (== (bit-and flags Flags/PRIVATE) 0)) 0 Flags/PUBLIC))
                      (when-not (== (bit-and flags Flags/DEFAULT) 0)
                        (set! implicit (bit-or implicit Flags/ABSTRACT))))
                  :else (set! mask (set! implicit Flags/InterfaceMethodFlags)))
              (not (== (bit-and (.-flags_field (.-owner sym)) Flags/RECORD) 0))
                (set! mask Flags/RecordMethodFlags)
              :else (set! mask Flags/MethodFlags))
            (when-not (== (bit-and flags Flags/STRICTFP) 0)
              (.warning log (.pos tree) CompilerProperties$LintWarnings/Strictfp))
            (when (or (== (bit-and (bit-or flags implicit) Flags/ABSTRACT) 0)
                      (not (== (bit-and flags Flags/DEFAULT) 0)))
              (set! implicit
                    (bit-or implicit (bit-and (.-flags_field (.-owner sym)) Flags/STRICTFP)))))
        TYP
          (do
            (cond
              (or (.matches (.-kind (.-owner sym)) Kinds$KindSelector/VAL_MTH)
                  (and (.isDirectlyOrIndirectlyLocal sym)
                       (not (== (bit-and flags Flags/ANNOTATION) 0))))
                (let [implicitlyStatic (and (not (.isAnonymous sym))
                                            (or (or
                                                  (not (== (bit-and flags Flags/RECORD) 0))
                                                  (not (== (bit-and flags Flags/ENUM) 0)))
                                                (not (== (bit-and flags Flags/INTERFACE) 0))))
                      staticOrImplicitlyStatic (or
                                                 (not (== (bit-and flags Flags/STATIC) 0))
                                                 implicitlyStatic)]
                  (set! mask
                        (if (and (and staticOrImplicitlyStatic allowRecords)
                                 (== (bit-and flags Flags/ANNOTATION) 0))
                            Flags/StaticLocalFlags
                            Flags/LocalClassFlags))
                  (set! implicit (if implicitlyStatic (long Flags/STATIC) implicit)))
              (identical? (.-kind (.-owner sym)) Kinds$Kind/TYP)
                (do
                  (set! mask
                        (if (and (and (not (== (bit-and flags Flags/STATIC) 0)) allowRecords)
                                 (== (bit-and flags Flags/ANNOTATION) 0))
                            Flags/ExtendedMemberStaticClassFlags
                            Flags/ExtendedMemberClassFlags))
                  (cond
                    (or (identical? (.-kind (.-owner (.-owner sym))) Kinds$Kind/PCK)
                        (not (== (bit-and (.-flags_field (.-owner sym)) Flags/STATIC) 0)))
                      (set! mask (bit-or mask Flags/STATIC))
                    (and (not allowRecords)
                         (or (not (== (bit-and flags Flags/ENUM) 0))
                             (not (== (bit-and flags Flags/RECORD) 0))))
                      (.error log
                              pos
                              CompilerProperties$Errors/StaticDeclarationNotAllowedInInnerClasses))
                  (when-not (== (bit-and flags
                                         (bit-or
                                           (bit-or-int Flags/INTERFACE Flags/ENUM)
                                           Flags/RECORD))
                                0)
                    (set! implicit Flags/STATIC)))
              :else (set! mask Flags/ExtendedClassFlags))
            (when-not (== (bit-and flags Flags/INTERFACE) 0)
              (set! implicit (bit-or implicit Flags/ABSTRACT)))
            (when-not (== (bit-and flags Flags/ENUM) 0)
              (set! mask
                    (bit-and mask
                             (bit-not (bit-or (bit-or
                                                (bit-or-int Flags/ABSTRACT Flags/FINAL)
                                                Flags/SEALED)
                                              Flags/NON_SEALED))))
              (set! implicit (bit-or implicit (.implicitEnumFinalFlag this tree))))
            (when-not (== (bit-and flags Flags/RECORD) 0)
              (set! mask (bit-and mask (bit-not-int Flags/ABSTRACT)))
              (set! implicit (bit-or implicit Flags/FINAL)))
            (when-not (== (bit-and flags Flags/STRICTFP) 0)
              (.warning log (.pos tree) CompilerProperties$LintWarnings/Strictfp))
            (set! implicit (bit-or implicit (bit-and (.-flags_field (.-owner sym)) Flags/STRICTFP))))
        (throw (AssertionError.)))
      (let [illegal (bit-and (bit-and flags Flags/ExtendedStandardFlags) (bit-not mask))]
        (cond
          (not (== illegal 0))
            (if (not (== (bit-and illegal Flags/INTERFACE) 0))
                (do
                  (.error
                    log
                    pos
                    ^JCDiagnostic$Error (if (not (== (bit-and flags Flags/ANNOTATION) 0))
                                            CompilerProperties$Errors/AnnotationDeclNotAllowedHere
                                            CompilerProperties$Errors/IntfNotAllowedHere))
                  (set! mask (bit-or mask Flags/INTERFACE)))
                (.error log
                        pos
                        (CompilerProperties$Errors/ModNotAllowedHere (Flags/asFlagSet illegal))))
          (and (and (and (and (and (and (and (and
                                               (and
                                                 (or
                                                   (identical? (.-kind sym) Kinds$Kind/TYP)
                                                   (.checkDisjoint
                                                     this
                                                     pos
                                                     flags
                                                     Flags/ABSTRACT
                                                     (bit-or
                                                       (bit-or-int Flags/PRIVATE Flags/STATIC)
                                                       Flags/DEFAULT)))
                                                 (.checkDisjoint
                                                   this
                                                   pos
                                                   flags
                                                   (bit-or-int Flags/STATIC Flags/PRIVATE)
                                                   Flags/DEFAULT))
                                               (.checkDisjoint
                                                 this
                                                 pos
                                                 flags
                                                 (bit-or-int Flags/ABSTRACT Flags/INTERFACE)
                                                 (bit-or-int
                                                   (bit-or-int Flags/FINAL Flags/NATIVE)
                                                   Flags/SYNCHRONIZED)))
                                             (.checkDisjoint
                                               this
                                               pos
                                               flags
                                               Flags/PUBLIC
                                               (bit-or-int Flags/PRIVATE Flags/PROTECTED)))
                                        (.checkDisjoint
                                          this
                                          pos
                                          flags
                                          Flags/PRIVATE
                                          (bit-or-int Flags/PUBLIC Flags/PROTECTED)))
                                   (.checkDisjoint this pos flags Flags/FINAL Flags/VOLATILE))
                              (or (identical? (.-kind sym) Kinds$Kind/TYP)
                                  (.checkDisjoint
                                    this
                                    pos
                                    flags
                                    (bit-or-int Flags/ABSTRACT Flags/NATIVE)
                                    Flags/STRICTFP)))
                         (.checkDisjoint this
                                         pos
                                         flags
                                         Flags/FINAL
                                         (bit-or Flags/SEALED Flags/NON_SEALED)))
                    (.checkDisjoint this
                                    pos
                                    flags
                                    Flags/SEALED
                                    (bit-or Flags/FINAL Flags/NON_SEALED)))
               (.checkDisjoint this pos flags Flags/SEALED Flags/ANNOTATION))
            nil)
        (bit-or (bit-and flags (bit-or mask (bit-not Flags/ExtendedStandardFlags))) implicit))))

  (method ^:private implicitEnumFinalFlag ^long [this ^JCTree tree]
    (if (not (.hasTag tree JCTree$Tag/CLASSDEF))
        0
        (letclass [(SpecialTreeVisitor
                     :extends JCTree$Visitor

                     (field ^boolean specialized)

                     (constructor [this] (set! (.-specialized this) false))

                     (method ^:public visitTree ^void [this ^JCTree tree])

                     (method ^:public visitVarDef ^void [this ^JCTree$JCVariableDecl tree]
                       (when-not (== (bit-and (.-flags (.-mods tree)) Flags/ENUM) 0)
                         (when-instance [^JCTree$JCNewClass newClass (.-init tree)]
                           (when (some? (.-def newClass)) (set! specialized true))))))]
          (let [sts (SpecialTreeVisitor.)
                cdef (cast JCTree$JCClassDecl tree)]
            (for-each [^JCTree defs (.-defs cdef)]
              (.accept defs sts)
              (when (.-specialized sts) (return (if allowSealed Flags/SEALED 0))))
            Flags/FINAL))))

  (method validate ^void [this ^JCTree tree ^{:tag (Env AttrContext)} env]
    (.validate this tree env true))

  (method validate ^void [this ^JCTree tree ^{:tag (Env AttrContext)} env ^boolean checkRaw]
    (.validateTree (Validator. env) tree checkRaw true))

  (method validate ^void [this ^{:tag (List (? extends JCTree))} trees ^{:tag (Env AttrContext)} env]
    (loop [^{:tag (List (? extends JCTree))} l trees]
      (when (.nonEmpty l) (.validate this (cast JCTree (.-head l)) env) (recur (.-tail l)))))

  (defclass Validator
    :extends JCTree$Visitor

    (field ^boolean checkRaw)

    (field ^boolean isOuter)

    (field ^{:tag (Env AttrContext)} env)

    (constructor [this ^{:tag (Env AttrContext)} env]
      (set! (.-env this) env))

    (method ^:public visitTypeArray ^void [this ^JCTree$JCArrayTypeTree tree]
      (.validateTree this (.-elemtype tree) checkRaw isOuter))

    (method ^:public visitTypeApply ^void [this ^JCTree$JCTypeApply tree]
      (when (.hasTag (.-type tree) TypeTag/CLASS)
        (let [^:mutable ^{:tag (List JCTree$JCExpression)} args (.-arguments tree)
              ^:mutable ^{:tag (List Type)} forms (.getTypeArguments
                                                    (.-type (.-tsym (.-type tree))))
              incompatibleArg (.firstIncompatibleTypeArg Check/this (.-type tree))]
          (when (some? incompatibleArg)
            (for-each [^JCTree arg (.-arguments tree)]
              (when (identical? (.-type arg) incompatibleArg)
                (.error log
                        arg
                        (CompilerProperties$Errors/NotWithinBounds
                          incompatibleArg
                          (cast Type (.-head forms)))))
              (set! forms (.-tail forms))))
          (set! forms (.getTypeArguments (.-type (.-tsym (.-type tree)))))
          (let [is_java_lang_Class (identical? (.flatName (.-tsym (.-type tree)))
                                               (.-java_lang_Class names))]
            (while (and (.nonEmpty args) (.nonEmpty forms))
              (.validateTree this
                             (cast JCTree (.-head args))
                             (not (and isOuter is_java_lang_Class))
                             false)
              (set! args (.-tail args))
              (set! forms (.-tail forms)))
            (when (.isRaw (.getEnclosingType (.-type tree)))
              (.error log (.pos tree) CompilerProperties$Errors/ImproperlyFormedTypeInnerRawParam))
            (when (.hasTag (.-clazz tree) JCTree$Tag/SELECT)
              (.visitSelectInternal this (cast JCTree$JCFieldAccess (.-clazz tree))))))))

    (method ^:public visitTypeParameter ^void [this ^JCTree$JCTypeParameter tree]
      (.validateTrees this (.-bounds tree) true isOuter)
      (.checkClassBounds Check/this (.pos tree) (.-type tree)))

    (method ^:public visitWildcard ^void [this ^JCTree$JCWildcard tree]
      (when (some? (.-inner tree)) (.validateTree this (.-inner tree) true isOuter)))

    (method ^:public visitSelect ^void [this ^JCTree$JCFieldAccess tree]
      (when (.hasTag (.-type tree) TypeTag/CLASS)
        (.visitSelectInternal this tree)
        (when (and (.isParameterized (.-type (.-selected tree)))
                   (.nonEmpty (.getTypeArguments (.-type (.-tsym (.-type tree))))))
          (.error log (.pos tree) CompilerProperties$Errors/ImproperlyFormedTypeParamMissing))))

    (method ^:public visitSelectInternal ^void [this ^JCTree$JCFieldAccess tree]
      (if (and (.isStatic (.-tsym (.-type tree))) (.isParameterized (.-type (.-selected tree))))
          (.error log (.pos tree) CompilerProperties$Errors/CantSelectStaticClassFromParamType)
          (.accept (.-selected tree) this)))

    (method ^:public visitAnnotatedType ^void [this ^JCTree$JCAnnotatedType tree]
      (.accept (.-underlyingType tree) this))

    (method ^:public visitTypeIdent ^void [this ^JCTree$JCPrimitiveTypeTree that]
      (when (.hasTag (.-type that) TypeTag/VOID)
        (.error log (.pos that) CompilerProperties$Errors/VoidNotAllowedHere))
      (.visitTypeIdent super that))

    (method ^:public visitTree ^void [this ^JCTree tree])

    (method ^:public validateTree ^void [this ^JCTree tree ^boolean checkRaw ^boolean isOuter]
      (when (some? tree)
        (let [prevCheckRaw (.-checkRaw this)]
          (set! (.-checkRaw this) checkRaw)
          (set! (.-isOuter this) isOuter)
          (try
            (.accept tree this)
            (when checkRaw (.checkRaw Check/this tree env))
            (catch Symbol$CompletionFailure ex (.completionError Check/this (.pos tree) ex))
            (finally (set! (.-checkRaw this) prevCheckRaw))))))

    (method ^:public validateTrees ^void [this ^{:tag (List (? extends JCTree))} trees
                                          ^boolean checkRaw ^boolean isOuter]
      (loop [^{:tag (List (? extends JCTree))} l trees]
        (when (.nonEmpty l)
          (.validateTree this (cast JCTree (.-head l)) checkRaw isOuter)
          (recur (.-tail l))))))

  (method checkRaw ^void [this ^JCTree tree ^{:tag (Env AttrContext)} env]
    (when (and (and (and (.hasTag (.-type tree) TypeTag/CLASS) (not (TreeInfo/isDiamond tree)))
                    (not (.withinAnonConstr this env)))
               (.isRaw (.-type tree)))
      (.warning log
                (.pos tree)
                (CompilerProperties$LintWarnings/RawClassUse
                  (.-type tree)
                  (.-type (.-tsym (.-type tree)))))))

  (method ^:private withinAnonConstr ^boolean [this ^{:tag (Env AttrContext)} env]
    (and (and (.isEmpty (.-name (.-enclClass env))) (some? (.-enclMethod env)))
         (identical? (.-name (.-enclMethod env)) (.-init names))))

  (method subset ^boolean [this ^Type t ^{:tag (List Type)} ts]
    (loop [^{:tag (List Type)} l ts]
      (if (.nonEmpty l)
          (if (.isSubtype types t (cast Type (.-head l))) (return true) (recur (.-tail l)))
          nil))
    false)

  (method intersects ^boolean [this ^Type t ^{:tag (List Type)} ts]
    (loop [^{:tag (List Type)} l ts]
      (if (.nonEmpty l)
          (if (or (.isSubtype types t (cast Type (.-head l)))
                  (.isSubtype types (cast Type (.-head l)) t))
              (return true)
              (recur (.-tail l)))
          nil))
    false)

  (method incl ^{:tag (List Type)} [this ^Type t ^{:tag (List Type)} ts]
    (if (.subset this t ts) ts (.prepend (.excl this t ts) t)))

  (method excl ^{:tag (List Type)} [this ^Type t ^{:tag (List Type)} ts]
    (if (.isEmpty ts)
        ts
        (let [^{:tag (List Type)} ts1 (.excl this t (.-tail ts))]
          (cond
            (.isSubtype types (cast Type (.-head ts)) t) ts1
            (identical? ts1 (.-tail ts)) ts
            :else (.prepend ts1 (cast Type (.-head ts)))))))

  (method union ^{:tag (List Type)} [this ^{:tag (List Type)} ts1 ^{:tag (List Type)} ts2]
    (let [^:mutable ^{:tag (List Type)} ts ts1]
      (loop [^{:tag (List Type)} l ts2]
        (when (.nonEmpty l) (set! ts (.incl this (cast Type (.-head l)) ts)) (recur (.-tail l))))
      ts))

  (method diff ^{:tag (List Type)} [this ^{:tag (List Type)} ts1 ^{:tag (List Type)} ts2]
    (let [^:mutable ^{:tag (List Type)} ts ts1]
      (loop [^{:tag (List Type)} l ts2]
        (when (.nonEmpty l) (set! ts (.excl this (cast Type (.-head l)) ts)) (recur (.-tail l))))
      ts))

  (method ^:public intersect ^{:tag (List Type)} [this ^{:tag (List Type)} ts1
                                                  ^{:tag (List Type)} ts2]
    (let [^:mutable ^{:tag (List Type)} ts (List/nil)]
      (loop [^{:tag (List Type)} l ts1]
        (if (.nonEmpty l)
            (if (.subset this (cast Type (.-head l)) ts2)
                (do (set! ts (.incl this (cast Type (.-head l)) ts)) (recur (.-tail l)))
                (recur (.-tail l)))
            nil))
      (loop [^{:tag (List Type)} l ts2]
        (if (.nonEmpty l)
            (if (.subset this (cast Type (.-head l)) ts1)
                (do (set! ts (.incl this (cast Type (.-head l)) ts)) (recur (.-tail l)))
                (recur (.-tail l)))
            nil))
      ts))

  (method isUnchecked ^boolean [this ^Symbol$ClassSymbol exc]
    (or (or (identical? (.-kind exc) Kinds$Kind/ERR)
            (.isSubClass exc (.-tsym (.-errorType syms)) types))
        (.isSubClass exc (.-tsym (.-runtimeExceptionType syms)) types)))

  (method isUnchecked ^boolean [this ^Type exc]
    (cond
      (.hasTag exc TypeTag/TYPEVAR) (.isUnchecked this (.supertype types exc))
      (.hasTag exc TypeTag/CLASS) (.isUnchecked this (cast Symbol$ClassSymbol (.-tsym exc)))
      :else (.hasTag exc TypeTag/BOT)))

  (method isChecked ^boolean [this ^Type exc]
    (not (.isUnchecked this exc)))

  (method isUnchecked ^boolean [this ^JCDiagnostic$DiagnosticPosition pos ^Type exc]
    (try
      (.isUnchecked this exc)
      (catch Symbol$CompletionFailure ex (.completionError this pos ex) true)))

  (method isHandled ^boolean [this ^Type exc ^{:tag (List Type)} handled]
    (or (.isUnchecked this exc) (.subset this exc handled)))

  (method unhandled ^{:tag (List Type)} [this ^{:tag (List Type)} thrown ^{:tag (List Type)} handled]
    (let [^:mutable ^{:tag (List Type)} unhandled (List/nil)]
      (loop [^{:tag (List Type)} l thrown]
        (if (.nonEmpty l)
            (if (not (.isHandled this (cast Type (.-head l)) handled))
                (do (set! unhandled (.prepend unhandled (cast Type (.-head l)))) (recur (.-tail l)))
                (recur (.-tail l)))
            nil))
      unhandled))

  (method ^:static protection ^int [^long flags]
    (switch (unchecked-short (bit-and flags Flags/AccessFlags))
      Flags/PRIVATE 3
      Flags/PROTECTED 1
      0 2
      0))

  (method cannotOverride ^JCDiagnostic$Fragment [this ^Symbol$MethodSymbol m
                                                 ^Symbol$MethodSymbol other]
    (let [mloc (.location m)
          oloc (.location other)]
      (cond
        (== (bit-and (.flags (.-owner other)) Flags/INTERFACE) 0)
          (CompilerProperties$Fragments/CantOverride m mloc other oloc)
        (== (bit-and (.flags (.-owner m)) Flags/INTERFACE) 0)
          (CompilerProperties$Fragments/CantImplement m mloc other oloc)
        :else (CompilerProperties$Fragments/ClashesWith m mloc other oloc))))

  (method uncheckedOverrides ^JCDiagnostic$Fragment [this ^Symbol$MethodSymbol m
                                                     ^Symbol$MethodSymbol other]
    (let [mloc (.location m)
          oloc (.location other)]
      (cond
        (== (bit-and (.flags (.-owner other)) Flags/INTERFACE) 0)
          (CompilerProperties$Fragments/UncheckedOverride m mloc other oloc)
        (== (bit-and (.flags (.-owner m)) Flags/INTERFACE) 0)
          (CompilerProperties$Fragments/UncheckedImplement m mloc other oloc)
        :else (CompilerProperties$Fragments/UncheckedClashWith m mloc other oloc))))

  (method varargsOverrides ^JCDiagnostic$Fragment [this ^Symbol$MethodSymbol m
                                                   ^Symbol$MethodSymbol other]
    (let [mloc (.location m)
          oloc (.location other)]
      (cond
        (== (bit-and (.flags (.-owner other)) Flags/INTERFACE) 0)
          (CompilerProperties$Fragments/VarargsOverride m mloc other oloc)
        (== (bit-and (.flags (.-owner m)) Flags/INTERFACE) 0)
          (CompilerProperties$Fragments/VarargsImplement m mloc other oloc)
        :else (CompilerProperties$Fragments/VarargsClashWith m mloc other oloc))))

  (method checkOverride ^void [this ^JCTree tree ^Symbol$MethodSymbol m ^Symbol$MethodSymbol other
                               ^Symbol$ClassSymbol origin]
    (when-not (or (not (== (bit-and (.flags m) (bit-or Flags/SYNTHETIC Flags/BRIDGE)) 0))
                  (not (== (bit-and (.flags other) Flags/SYNTHETIC) 0)))
      (cond
        (and (not (== (bit-and (.flags m) Flags/STATIC) 0))
             (== (bit-and (.flags other) Flags/STATIC) 0))
          (do
            (.error log
                    (TreeInfo/diagnosticPositionFor m tree)
                    (CompilerProperties$Errors/OverrideStatic (.cannotOverride this m other)))
            (set! (.-flags_field m) (bit-or (.-flags_field m) Flags/BAD_OVERRIDE)))
        (or (not (== (bit-and (.flags other) Flags/FINAL) 0))
            (and (== (bit-and (.flags m) Flags/STATIC) 0)
                 (not (== (bit-and (.flags other) Flags/STATIC) 0))))
          (do
            (.error log
                    (TreeInfo/diagnosticPositionFor m tree)
                    (CompilerProperties$Errors/OverrideMeth
                      (.cannotOverride this m other)
                      (Flags/asFlagSet
                        (bit-and (.flags other) (bit-or-int Flags/FINAL Flags/STATIC)))))
            (set! (.-flags_field m) (bit-or (.-flags_field m) Flags/BAD_OVERRIDE)))
        :else
          (when-not (not (== (bit-and (.flags (.-owner m)) Flags/ANNOTATION) 0))
            (if (> (Check/protection (.flags m)) (Check/protection (.flags other)))
                (do
                  (.error log
                          (TreeInfo/diagnosticPositionFor m tree)
                          ^JCDiagnostic$Error (if (== (bit-and (.flags other) Flags/AccessFlags) 0)
                                                  (CompilerProperties$Errors/OverrideWeakerAccess
                                                    (.cannotOverride this m other)
                                                    "package")
                                                  (CompilerProperties$Errors/OverrideWeakerAccess
                                                    (.cannotOverride this m other)
                                                    (Flags/asFlagSet
                                                      (bit-and (.flags other) Flags/AccessFlags)))))
                  (set! (.-flags_field m) (bit-or (.-flags_field m) Flags/BAD_OVERRIDE)))
                (do
                  (when (.shouldCheckPreview this m other origin)
                    (.checkPreview this
                                   (TreeInfo/diagnosticPositionFor m tree)
                                   m
                                   (.-type origin)
                                   other))
                  (let [mt (.memberType types (.-type origin) m)
                        ot (.memberType types (.-type origin) other)
                        ^{:tag (List Type)} mtvars (.getTypeArguments mt)
                        ^{:tag (List Type)} otvars (.getTypeArguments ot)
                        mtres (.getReturnType mt)
                        otres (.subst types (.getReturnType ot) otvars mtvars)]
                    (.clear overrideWarner)
                    (let [resultTypesOK (.returnTypeSubstitutable types mt ot otres overrideWarner)]
                      (if (not resultTypesOK)
                          (if (and (not (== (bit-and (.flags m) Flags/STATIC) 0))
                                   (not (== (bit-and (.flags other) Flags/STATIC) 0)))
                              (do
                                (.error log
                                        (TreeInfo/diagnosticPositionFor m tree)
                                        (CompilerProperties$Errors/OverrideIncompatibleRet
                                          (CompilerProperties$Fragments/CantHide
                                            m
                                            (.location m)
                                            other
                                            (.location other))
                                          mtres
                                          otres))
                                (set! (.-flags_field m)
                                      (bit-or (.-flags_field m) Flags/BAD_OVERRIDE)))
                              (do
                                (.error log
                                        (TreeInfo/diagnosticPositionFor m tree)
                                        (CompilerProperties$Errors/OverrideIncompatibleRet
                                          (.cannotOverride this m other)
                                          mtres
                                          otres))
                                (set! (.-flags_field m)
                                      (bit-or (.-flags_field m) Flags/BAD_OVERRIDE))))
                          (do
                            (when (.hasNonSilentLint overrideWarner Lint$LintCategory/UNCHECKED)
                              (.warnUnchecked this
                                              (TreeInfo/diagnosticPositionFor m tree)
                                              (CompilerProperties$LintWarnings/OverrideUncheckedRet
                                                (.uncheckedOverrides this m other)
                                                mtres
                                                otres)))
                            (let [^{:tag (List Type)} otthrown (.subst
                                                                 types
                                                                 (.getThrownTypes ot)
                                                                 otvars
                                                                 mtvars)
                                  ^{:tag (List Type)} unhandledErased (.unhandled
                                                                        this
                                                                        (.getThrownTypes mt)
                                                                        (.erasure types otthrown))
                                  ^{:tag (List Type)} unhandledUnerased (.unhandled
                                                                          this
                                                                          (.getThrownTypes mt)
                                                                          otthrown)]
                              (cond
                                (.nonEmpty unhandledErased)
                                  (do
                                    (.error log
                                            (TreeInfo/diagnosticPositionFor m tree)
                                            (CompilerProperties$Errors/OverrideMethDoesntThrow
                                              (.cannotOverride this m other)
                                              (cast Type (.-head unhandledUnerased))))
                                    (set! (.-flags_field m)
                                          (bit-or (.-flags_field m) Flags/BAD_OVERRIDE)))
                                (.nonEmpty unhandledUnerased)
                                  (.warnUnchecked
                                    this
                                    (TreeInfo/diagnosticPositionFor m tree)
                                    (CompilerProperties$LintWarnings/OverrideUncheckedThrown
                                      (.cannotOverride this m other)
                                      (cast Type (.-head unhandledUnerased))))
                                :else
                                  (do
                                    (when-not (==
                                                (bit-and
                                                  (bit-xor (.flags m) (.flags other))
                                                  Flags/VARARGS)
                                                0)
                                      (.warning
                                        log
                                        (TreeInfo/diagnosticPositionFor m tree)
                                        ^JCDiagnostic$Warning (if (not
                                                                    (==
                                                                      (bit-and
                                                                        (.flags m)
                                                                        Flags/VARARGS)
                                                                      0))
                                                                  ^JCDiagnostic$Warning (CompilerProperties$LintWarnings/OverrideVarargsMissing
                                                                                          (.varargsOverrides
                                                                                            this
                                                                                            m
                                                                                            other))
                                                                  ^JCDiagnostic$Warning (CompilerProperties$LintWarnings/OverrideVarargsExtra
                                                                                          (.varargsOverrides
                                                                                            this
                                                                                            m
                                                                                            other)))))
                                    (when-not (== (bit-and (.flags other) Flags/BRIDGE) 0)
                                      (.warning log
                                                (TreeInfo/diagnosticPositionFor m tree)
                                                (CompilerProperties$Warnings/OverrideBridge
                                                  (.uncheckedOverrides this m other))))
                                    (when-not (.isDeprecatedOverrideIgnorable this other origin)
                                      (.checkDeprecated
                                        this
                                        (lambda Supplier ^JCDiagnostic$DiagnosticPosition []
                                          (TreeInfo/diagnosticPositionFor m tree))
                                        m
                                        other)))))))))))))))

  (method ^:private shouldCheckPreview ^boolean [this ^Symbol$MethodSymbol m
                                                 ^Symbol$MethodSymbol other
                                                 ^Symbol$ClassSymbol origin]
    (if (or (not (identical? (.-owner m) origin))
            (and (== (bit-and (.flags other) Flags/PREVIEW_API) 0)
                 (== (bit-and (.flags (.-owner other)) Flags/PREVIEW_API) 0)))
        false
        (do
          (for-each [^Symbol s (.getSymbolsByName
                                 (.membersClosure types (.-type origin) false)
                                 (.-name m))]
            (when (and (not (identical? m s)) (.overrides m s origin types false))
              (return (identical? s other))))
          false)))

  (method ^:private isDeprecatedOverrideIgnorable ^boolean [this ^Symbol$MethodSymbol m
                                                            ^Symbol$ClassSymbol origin]
    (let [mc (.enclClass m)
          st (.supertype types (.-type origin))]
      (if (not (.hasTag st TypeTag/CLASS))
          true
          (let [stimpl (.implementation m (cast Symbol$ClassSymbol (.-tsym st)) types false)]
            (if (and (some? mc) (not (== (bit-and (.flags mc) Flags/INTERFACE) 0)))
                (let [^{:tag (List Type)} intfs (.interfaces types (.-type origin))]
                  (if (.contains intfs (.-type mc)) false (some? stimpl)))
                (not (identical? stimpl m)))))))

  (field ^Warner overrideWarner (Warner.))

  (method ^:public checkCompatibleConcretes ^void [this ^JCDiagnostic$DiagnosticPosition pos
                                                   ^Type site]
    (let [sup (.supertype types site)]
      (when-not (not (.hasTag sup TypeTag/CLASS))
        (loop [t1 sup]
          (when (and (.hasTag t1 TypeTag/CLASS) (.isParameterized (.-type (.-tsym t1))))
            (for-each [^Symbol s1 (.getSymbols (.members (.-tsym t1))
                                               Scope$LookupKind/NON_RECURSIVE)]
              (when-not (or (or (or (not (identical? (.-kind s1) Kinds$Kind/MTH))
                                    (not (== (bit-and
                                               (.flags s1)
                                               (bit-or
                                                 (bit-or-int Flags/STATIC Flags/SYNTHETIC)
                                                 Flags/BRIDGE))
                                             0)))
                                (not (.isInheritedIn s1 (.-tsym site) types)))
                            (not (identical? (.implementation
                                               (cast Symbol$MethodSymbol s1)
                                               (.-tsym site)
                                               types
                                               true)
                                             s1)))
                (let [st1 (.memberType types t1 s1)
                      s1ArgsLength (.length (.getParameterTypes st1))]
                  (when-not (identical? st1 (.-type s1))
                    (loop [t2 sup]
                      (when (.hasTag t2 TypeTag/CLASS)
                        (for-each [^Symbol s2 (.getSymbolsByName (.members (.-tsym t2)) (.-name s1))]
                          (when-not (or (or (or (or
                                                  (or
                                                    (identical? s2 s1)
                                                    (not (identical? (.-kind s2) Kinds$Kind/MTH)))
                                                  (not
                                                    (==
                                                      (bit-and
                                                        (.flags s2)
                                                        (bit-or
                                                          (bit-or-int Flags/STATIC Flags/SYNTHETIC)
                                                          Flags/BRIDGE))
                                                      0)))
                                                (not
                                                  (==
                                                    (.length (.getParameterTypes (.-type s2)))
                                                    s1ArgsLength)))
                                            (not (.isInheritedIn s2 (.-tsym site) types)))
                                        (not (identical?
                                               (.implementation
                                                 (cast Symbol$MethodSymbol s2)
                                                 (.-tsym site)
                                                 types
                                                 true)
                                               s2)))
                            (let [st2 (.memberType types t2 s2)]
                              (when (.overrideEquivalent types st1 st2)
                                (.error log
                                        pos
                                        (CompilerProperties$Errors/ConcreteInheritanceConflict
                                          s1
                                          t1
                                          s2
                                          t2
                                          sup))))))
                        (recur (.supertype types t2))))))))
            (recur (.supertype types t1)))))))

  (method ^:public checkCompatibleAbstracts ^boolean [this ^JCDiagnostic$DiagnosticPosition pos
                                                      ^:mutable ^Type t1 ^:mutable ^Type t2
                                                      ^Type site]
    (when-not (== (bit-and (.flags (.-tsym site)) Flags/COMPOUND) 0)
      (set! t1 (.capture types t1))
      (set! t2 (.capture types t2)))
    (nil? (.firstIncompatibility this pos t1 t2 site)))

  (method ^:private firstIncompatibility ^Symbol [this ^JCDiagnostic$DiagnosticPosition pos ^Type t1
                                                  ^Type t2 ^Type site]
    (let [^{:tag (Map Symbol$TypeSymbol Type)} interfaces1 (HashMap.)]
      (.closure this t1 interfaces1)
      (let [^:mutable ^{:tag (Map Symbol$TypeSymbol Type)} interfaces2 nil]
        (if (identical? t1 t2)
            (set! interfaces2 interfaces1)
            (.closure this t2 interfaces1 (set! interfaces2 (HashMap.))))
        (for-each [^Type t3 (.values interfaces1)]
          (for-each [^Type t4 (.values interfaces2)]
            (let [s (.firstDirectIncompatibility this pos t3 t4 site)] (when (some? s) (return s)))))
        nil)))

  (method ^:private closure ^void [this ^Type t ^{:tag (Map Symbol$TypeSymbol Type)} typeMap]
    (when-not (not (.hasTag t TypeTag/CLASS))
      (when (nil? (.put typeMap (.-tsym t) t))
        (.closure this (.supertype types t) typeMap)
        (for-each [^Type i (.interfaces types t)] (.closure this i typeMap)))))

  (method ^:private closure ^void [this ^Type t ^{:tag (Map Symbol$TypeSymbol Type)} typesSkip
                                   ^{:tag (Map Symbol$TypeSymbol Type)} typeMap]
    (when-not (not (.hasTag t TypeTag/CLASS))
      (when-not (some? (.get typesSkip (.-tsym t)))
        (when (nil? (.put typeMap (.-tsym t) t))
          (.closure this (.supertype types t) typesSkip typeMap)
          (for-each [^Type i (.interfaces types t)] (.closure this i typesSkip typeMap))))))

  (method ^:private firstDirectIncompatibility ^Symbol [this ^JCDiagnostic$DiagnosticPosition pos
                                                        ^Type t1 ^Type t2 ^Type site]
    (for-each [^Symbol s1 (.getSymbols (.members (.-tsym t1)) Scope$LookupKind/NON_RECURSIVE)]
      (let [^:mutable ^Type st1 nil]
        (when-not (or (or (not (identical? (.-kind s1) Kinds$Kind/MTH))
                          (not (.isInheritedIn s1 (.-tsym site) types)))
                      (not (== (bit-and (.flags s1) Flags/SYNTHETIC) 0)))
          (let [^Symbol impl (.implementation (cast Symbol$MethodSymbol s1)
                                              (.-tsym site)
                                              types
                                              false)]
            (when-not (and (some? impl) (== (bit-and (.flags impl) Flags/ABSTRACT) 0))
              (for-each [^Symbol s2 (.getSymbolsByName (.members (.-tsym t2)) (.-name s1))]
                (when-not (identical? s1 s2)
                  (when-not (or (or (not (identical? (.-kind s2) Kinds$Kind/MTH))
                                    (not (.isInheritedIn s2 (.-tsym site) types)))
                                (not (== (bit-and (.flags s2) Flags/SYNTHETIC) 0)))
                    (when (nil? st1) (set! st1 (.memberType types t1 s1)))
                    (let [st2 (.memberType types t2 s2)]
                      (if (.overrideEquivalent types st1 st2)
                          (let [^{:tag (List Type)} tvars1 (.getTypeArguments st1)
                                ^{:tag (List Type)} tvars2 (.getTypeArguments st2)
                                rt1 (.getReturnType st1)
                                rt2 (.subst types (.getReturnType st2) tvars2 tvars1)
                                compat (or (or (.isSameType types rt1 rt2)
                                               (and
                                                 (and
                                                   (not (.isPrimitiveOrVoid rt1))
                                                   (not (.isPrimitiveOrVoid rt2)))
                                                 (or
                                                   (.covariantReturnType
                                                     types
                                                     rt1
                                                     rt2
                                                     (.-noWarnings types))
                                                   (.covariantReturnType
                                                     types
                                                     rt2
                                                     rt1
                                                     (.-noWarnings types)))))
                                           (.checkCommonOverriderIn this s1 s2 site))]
                            (when-not compat
                              (if (.isSameType types t1 t2)
                                  (.error log
                                          pos
                                          (CompilerProperties$Errors/IncompatibleDiffRetSameType
                                            t1
                                            (.-name s2)
                                            (.getParameterTypes (.memberType types t2 s2))))
                                  (.error log
                                          pos
                                          (CompilerProperties$Errors/TypesIncompatible
                                            t1
                                            t2
                                            (CompilerProperties$Fragments/IncompatibleDiffRet
                                              (.-name s2)
                                              (.getParameterTypes (.memberType types t2 s2))))))
                              (return s2)))
                          (when (and (.checkNameClash
                                       this
                                       (cast Symbol$ClassSymbol (.-tsym site))
                                       s1
                                       s2)
                                     (not (.checkCommonOverriderIn this s1 s2 site)))
                            (.error log
                                    pos
                                    (CompilerProperties$Errors/NameClashSameErasureNoOverride
                                      (.-name s1)
                                      (.getParameterTypes
                                        (.asMethodType (.memberType types site s1)))
                                      (.location s1)
                                      (.-name s2)
                                      (.getParameterTypes
                                        (.asMethodType (.memberType types site s2)))
                                      (.location s2)))
                            (return s2))))))))))))
    nil)

  (method checkCommonOverriderIn ^boolean [this ^Symbol s1 ^Symbol s2 ^Type site]
    (let [^{:tag (Map Symbol$TypeSymbol Type)} supertypes (HashMap.)
          st1 (.memberType types site s1)
          st2 (.memberType types site s2)]
      (.closure this site supertypes)
      (for-each [^Type t (.values supertypes)]
        (for-each [^Symbol s3 (.getSymbolsByName (.members (.-tsym t)) (.-name s1))]
          (when-not (or (or (or (identical? s3 s1) (identical? s3 s2))
                            (not (identical? (.-kind s3) Kinds$Kind/MTH)))
                        (not (== (bit-and (.flags s3) (bit-or Flags/BRIDGE Flags/SYNTHETIC)) 0)))
            (let [st3 (.memberType types site s3)]
              (when (and (and (and (.overrideEquivalent types st3 st1)
                                   (.overrideEquivalent types st3 st2))
                              (.returnTypeSubstitutable types st3 st1))
                         (.returnTypeSubstitutable types st3 st2))
                (return true))))))
      false))

  (method checkOverride ^void [this ^{:tag (Env AttrContext)} env ^JCTree$JCMethodDecl tree
                               ^Symbol$MethodSymbol m]
    (let [origin (cast Symbol$ClassSymbol (.-owner m))]
      (when (and (not (== (bit-and (.flags origin) Flags/ENUM) 0))
                 (.equals (.-finalize names) (.-name m)))
        (when (.overrides m (.-enumFinalFinalize syms) origin types false)
          (.error log (.pos tree) CompilerProperties$Errors/EnumNoFinalize)
          (return)))
      (when (and allowRecords (.isRecord origin))
        (let [^{:tag (Optional (? extends Symbol$RecordComponent))} recordComponent (.findFirst
                                                                                      (.filter
                                                                                        (.stream
                                                                                          (.getRecordComponents
                                                                                            origin))
                                                                                        (lambda Predicate ^boolean [^Symbol$RecordComponent rc]
                                                                                          (and
                                                                                            (identical?
                                                                                              (.-accessor
                                                                                                rc)
                                                                                              (.-sym
                                                                                                tree))
                                                                                            (==
                                                                                              (bit-and
                                                                                                (.-flags_field
                                                                                                  (.-accessor
                                                                                                    rc))
                                                                                                Flags/GENERATED_MEMBER)
                                                                                              0)))))]
          (when (.isPresent recordComponent) (return))))
      (loop [t (.-type origin)]
        (when (.hasTag t TypeTag/CLASS)
          (when-not (identical? t (.-type origin)) (.checkOverride this tree t origin m))
          (for-each [^Type t2 (.interfaces types t)] (.checkOverride this tree t2 origin m))
          (recur (.supertype types t))))
      (let [explicitOverride (some? (.attribute m (.-tsym (.-overrideType syms))))
            mustOverride (or explicitOverride
                             (and (and (.-isAnonymousDiamond (cast AttrContext (.-info env)))
                                       (not (.isConstructor m)))
                                  (not (.isPrivate m))))]
        (when (and mustOverride (not (.isOverrider this m)))
          (let [^:mutable pos (.pos tree)]
            (for-each [^JCTree$JCAnnotation a (.-annotations (.getModifiers tree))]
              (when (identical? (.-tsym (.-type (.-annotationType a)))
                                (.-tsym (.-overrideType syms)))
                (set! pos (.pos a))
                (break)))
            (.error
              log
              pos
              ^JCDiagnostic$Error (if explicitOverride
                                      (if (.isStatic m)
                                          (CompilerProperties$Errors/StaticMethodsCannotBeAnnotatedWithOverride
                                            m
                                            (.enclClass m))
                                          (CompilerProperties$Errors/MethodDoesNotOverrideSuperclass
                                            m
                                            (.enclClass m)))
                                      (CompilerProperties$Errors/AnonymousDiamondMethodDoesNotOverrideSuperclass
                                        CompilerProperties$Fragments/DiamondAnonymousMethodsImplicitlyOverride))))))))

  (method checkOverride ^void [this ^JCTree tree ^Type site ^Symbol$ClassSymbol origin
                               ^Symbol$MethodSymbol m]
    (let [c (.-tsym site)]
      (for-each [^Symbol sym (.getSymbolsByName (.members c) (.-name m))]
        (when (.overrides m sym origin types false)
          (when (== (bit-and (.flags sym) Flags/ABSTRACT) 0)
            (.checkOverride this tree m (cast Symbol$MethodSymbol sym) origin))))))

  (field ^:private ^{:tag (Predicate Symbol)} equalsHasCodeFilter
    (lambda Predicate ^boolean [^Symbol s]
      (and (.test Symbol$MethodSymbol/implementation_filter s)
           (== (bit-and (.flags s) Flags/BAD_OVERRIDE) 0))))

  (method ^:public checkClassOverrideEqualsAndHashIfNeeded ^void [this
                                                                  ^JCDiagnostic$DiagnosticPosition pos
                                                                  ^Symbol$ClassSymbol someClass]
    (when-not (or (or (or (or (identical? someClass
                                          (cast Symbol$ClassSymbol (.-tsym (.-objectType syms))))
                              (.isInterface someClass))
                          (.isEnum someClass))
                      (not (== (bit-and (.flags someClass) Flags/ANNOTATION) 0)))
                  (not (== (bit-and (.flags someClass) Flags/ABSTRACT) 0)))
      (when (.isAnonymous someClass)
        (let [^{:tag (List Type)} interfaces (.interfaces types (.-type someClass))]
          (when (and (and (some? interfaces) (not (.isEmpty interfaces)))
                     (identical? (.-tsym (cast Type (.-head interfaces)))
                                 (.-tsym (.-comparatorType syms))))
            (return))))
      (.checkClassOverrideEqualsAndHash this pos someClass)))

  (method ^:private checkClassOverrideEqualsAndHash ^void [this ^JCDiagnostic$DiagnosticPosition pos
                                                           ^Symbol$ClassSymbol someClass]
    (when (.isEnabled lint Lint$LintCategory/OVERRIDES)
      (let [equalsAtObject (cast Symbol$MethodSymbol
                                 (.findFirst (.members (.-tsym (.-objectType syms)))
                                             (.-equals names)))
            hashCodeAtObject (cast Symbol$MethodSymbol
                                   (.findFirst (.members (.-tsym (.-objectType syms)))
                                               (.-hashCode names)))
            equalsImpl (.implementation types equalsAtObject someClass false equalsHasCodeFilter)
            overridesEquals (and (some? equalsImpl) (identical? (.-owner equalsImpl) someClass))
            overridesHashCode (not (identical? (.implementation
                                                 types
                                                 hashCodeAtObject
                                                 someClass
                                                 false
                                                 equalsHasCodeFilter)
                                               hashCodeAtObject))]
        (when (and overridesEquals (not overridesHashCode))
          (.warning log
                    pos
                    (CompilerProperties$LintWarnings/OverrideEqualsButNotHashcode someClass))))))

  (method ^:public checkHasMain ^void [this ^JCDiagnostic$DiagnosticPosition pos
                                       ^Symbol$ClassSymbol c]
    (let [^:mutable found false]
      (for-each [^Symbol sym (.getSymbolsByName (.members c) (.-main names))]
        (when (and (identical? (.-kind sym) Kinds$Kind/MTH)
                   (== (bit-and (.flags sym) Flags/PRIVATE) 0))
          (let [meth (cast Symbol$MethodSymbol sym)]
            (when-not (not (.isSameType types (.getReturnType meth) (.-voidType syms)))
              (when (.isEmpty (.-params meth)) (set! found true) (break))
              (when-not (not (== (.size (.-params meth)) 1))
                (when-not (not (.isSameType types
                                            (.-type
                                              (cast Symbol$VarSymbol (.-head (.-params meth))))
                                            (.makeArrayType types (.-stringType syms))))
                  (set! found true)
                  (break)))))))
      (when-not found (.error log pos CompilerProperties$Errors/ImplicitClassDoesNotHaveMainMethod))))

  (method ^:public checkModuleName ^void [this ^JCTree$JCModuleDecl tree]
    (let [moduleName (.-name (.-sym tree))]
      (Assert/checkNonNull moduleName)
      (when (.isEnabled lint Lint$LintCategory/MODULE)
        (let [^:mutable qualId (.-qualId tree)]
          (while (some? qualId)
            (let [^:mutable ^Name componentName nil
                  ^:mutable ^JCDiagnostic$DiagnosticPosition pos nil]
              (switch (.getTag qualId)
                SELECT
                  (let [selectNode (cast JCTree$JCFieldAccess qualId)]
                    (set! componentName (.-name selectNode))
                    (set! pos (.pos selectNode))
                    (set! qualId (.-selected selectNode)))
                IDENT
                  (do
                    (set! componentName (.-name (cast JCTree$JCIdent qualId)))
                    (set! pos (.pos qualId))
                    (set! qualId nil))
                (throw (AssertionError.
                         (java-str "Unexpected qualified identifier: " (.toString qualId)))))
              (when (some? componentName)
                (let [moduleNameComponentString (.toString componentName)
                      nameLength (.length moduleNameComponentString)]
                  (when (and (> nameLength 0)
                             (Character/isDigit
                               (.charAt moduleNameComponentString
                                        (unchecked-subtract-int nameLength 1))))
                    (.warning log
                              pos
                              (CompilerProperties$LintWarnings/PoorChoiceForModuleName
                                componentName)))))))))))

  (method ^:private checkNameClash ^boolean [this ^Symbol$ClassSymbol origin ^Symbol s1 ^Symbol s2]
    (let [cf (ClashFilter. (.-type origin))]
      (and (and (.test cf s1) (.test cf s2))
           (.hasSameArgs types (.erasure s1 types) (.erasure s2 types)))))

  (method checkAllDefined ^void [this ^JCDiagnostic$DiagnosticPosition pos ^Symbol$ClassSymbol c]
    (let [undef (.firstUnimplementedAbstract types c)]
      (when (some? undef)
        (let [undef1 (Symbol$MethodSymbol. (.flags undef)
                                           (.-name undef)
                                           (.memberType types (.-type c) undef)
                                           (.-owner undef))]
          (.error log
                  pos
                  (CompilerProperties$Errors/DoesNotOverrideAbstract c undef1 (.location undef1)))))))

  (method checkNonCyclicDecl ^void [this ^JCTree$JCClassDecl tree]
    (let [cc (CycleChecker.)]
      (.scan cc tree)
      (when (and (not (.-errorFound cc)) (not (.-partialCheck cc)))
        (let [o-1 (.-sym tree)]
          (set! (.-flags_field o-1) (bit-or (.-flags_field o-1) Flags/ACYCLIC))))))

  (defclass CycleChecker
    :extends TreeScanner

    (field ^{:tag (Set Symbol)} seenClasses (HashSet.))

    (field ^boolean errorFound false)

    (field ^boolean partialCheck false)

    (method ^:private checkSymbol ^void [this ^JCDiagnostic$DiagnosticPosition pos ^Symbol sym]
      (cond
        (and (some? sym) (identical? (.-kind sym) Kinds$Kind/TYP))
          (let [^{:tag (Env AttrContext)} classEnv (.getEnv enter (cast Symbol$TypeSymbol sym))]
            (cond
              (some? classEnv)
                (let [prevSource (.currentSource log)]
                  (try
                    (.useSource log (.-sourcefile (.-toplevel classEnv)))
                    (.scan this (.-tree classEnv))
                    (finally (.useSource log (.getFile prevSource)))))
              (identical? (.-kind sym) Kinds$Kind/TYP) (.checkClass this pos sym (List/nil))))
        (or (nil? sym) (not (identical? (.-kind sym) Kinds$Kind/PCK))) (set! partialCheck true)))

    (method ^:public visitSelect ^void [this ^JCTree$JCFieldAccess tree]
      (.visitSelect super tree)
      (.checkSymbol this (.pos tree) (.-sym tree)))

    (method ^:public visitIdent ^void [this ^JCTree$JCIdent tree]
      (.checkSymbol this (.pos tree) (.-sym tree)))

    (method ^:public visitTypeApply ^void [this ^JCTree$JCTypeApply tree]
      (.scan this (.-clazz tree)))

    (method ^:public visitTypeArray ^void [this ^JCTree$JCArrayTypeTree tree]
      (.scan this (.-elemtype tree)))

    (method ^:public visitClassDef ^void [this ^JCTree$JCClassDecl tree]
      (let [^:mutable ^{:tag (List JCTree)} supertypes (List/nil)]
        (when (some? (.getExtendsClause tree))
          (set! supertypes (.prepend supertypes (.getExtendsClause tree))))
        (when (some? (.getImplementsClause tree))
          (for-each [^JCTree intf (.getImplementsClause tree)]
            (set! supertypes (.prepend supertypes intf))))
        (.checkClass this (.pos tree) (.-sym tree) supertypes)))

    (method checkClass ^void [this ^JCDiagnostic$DiagnosticPosition pos ^Symbol c
                              ^{:tag (List JCTree)} supertypes]
      (when-not (not (== (bit-and (.-flags_field c) Flags/ACYCLIC) 0))
        (if (.contains seenClasses c)
            (do
              (set! errorFound true)
              (.error log pos (CompilerProperties$Errors/CyclicInheritance c))
              (.forEach (.map (.filter (.filter (.stream seenClasses)
                                                (lambda Predicate ^boolean [^Symbol s]
                                                  (not (.isErroneous (.-type s)))))
                                       (method-ref
                                         Predicate
                                         [Symbol]
                                         Symbol$ClassSymbol
                                         Class/.isInstance))
                              (method-ref Function
                                          ^Symbol$ClassSymbol [Symbol]
                                          Symbol$ClassSymbol
                                          Class/.cast))
                        (method-ref Consumer [Symbol$ClassSymbol] Check/this Check/.handleCyclic)))
            (when-not (.isErroneous (.-type c))
              (try
                (.add seenClasses c)
                (when (.hasTag (.-type c) TypeTag/CLASS)
                  (if (.nonEmpty supertypes)
                      (.scan this supertypes)
                      (let [ct (cast Type$ClassType (.-type c))]
                        (when (or (nil? (.-supertype_field ct)) (nil? (.-interfaces_field ct)))
                          (set! partialCheck true)
                          (return))
                        (.checkSymbol this pos (.-tsym (.-supertype_field ct)))
                        (for-each [^Type intf (.-interfaces_field ct)]
                          (.checkSymbol this pos (.-tsym intf)))))
                  (when (identical? (.-kind (.-owner c)) Kinds$Kind/TYP)
                    (.checkSymbol this pos (.-owner c))))
                (finally (.remove seenClasses c))))))))

  (method checkNonCyclic ^void [this ^JCDiagnostic$DiagnosticPosition pos ^Type t]
    (.checkNonCyclicInternal this pos t))

  (method checkNonCyclic ^void [this ^JCDiagnostic$DiagnosticPosition pos ^Type$TypeVar t]
    (.checkNonCyclic1 this pos t (List/nil)))

  (method ^:private checkNonCyclic1 ^void [this ^JCDiagnostic$DiagnosticPosition pos ^Type t
                                           ^:mutable ^{:tag (List Type$TypeVar)} seen]
    (let [^:mutable ^Type$TypeVar tv nil]
      (when-not (and (.hasTag t TypeTag/TYPEVAR)
                     (not (== (bit-and (.flags (.-tsym t)) Flags/UNATTRIBUTED) 0)))
        (if (.contains seen t)
            (do
              (set! tv (cast Type$TypeVar t))
              (.setUpperBound tv (.createErrorType types t))
              (.error log pos (CompilerProperties$Errors/CyclicInheritance t)))
            (when (.hasTag t TypeTag/TYPEVAR)
              (set! tv (cast Type$TypeVar t))
              (set! seen (.prepend seen tv))
              (for-each [^Type b (.getBounds types tv)] (.checkNonCyclic1 this pos b seen)))))))

  (method ^:private checkNonCyclicInternal ^boolean [this ^JCDiagnostic$DiagnosticPosition pos
                                                     ^Type t]
    (let [^:mutable complete true
          ^Symbol c (.-tsym t)]
      (if (not (== (bit-and (.-flags_field c) Flags/ACYCLIC) 0))
          true
          (do
            (if (not (== (bit-and (.-flags_field c) Flags/LOCKED) 0))
                (do
                  (.error log pos (CompilerProperties$Errors/CyclicInheritance c))
                  (.handleCyclic this (cast Symbol$ClassSymbol c)))
                (when-not (.isErroneous (.-type c))
                  (try
                    (set! (.-flags_field c) (bit-or (.-flags_field c) Flags/LOCKED))
                    (when (.hasTag (.-type c) TypeTag/CLASS)
                      (let [clazz (cast Type$ClassType (.-type c))]
                        (when (some? (.-interfaces_field clazz))
                          (loop [^{:tag (List Type)} l (.-interfaces_field clazz)]
                            (when (.nonEmpty l)
                              (set! complete
                                    (let [a-2 complete
                                          b-3 (.checkNonCyclicInternal
                                                this
                                                pos
                                                (cast Type (.-head l)))]
                                      (and a-2 b-3)))
                              (recur (.-tail l)))))
                        (when (some? (.-supertype_field clazz))
                          (let [st (.-supertype_field clazz)]
                            (when (and (some? st) (.hasTag st TypeTag/CLASS))
                              (set! complete
                                    (let [a-4 complete
                                          b-5 (.checkNonCyclicInternal this pos st)]
                                      (and a-4 b-5))))))
                        (when (identical? (.-kind (.-owner c)) Kinds$Kind/TYP)
                          (set! complete
                                (let [a-6 complete
                                      b-7 (.checkNonCyclicInternal this pos (.-type (.-owner c)))]
                                  (and a-6 b-7))))))
                    (finally
                      (set! (.-flags_field c)
                            (bit-and (.-flags_field c) (bit-not-int Flags/LOCKED)))))))
            (when complete
              (set! complete
                    (and (== (bit-and (.-flags_field c) Flags/UNATTRIBUTED) 0) (.isCompleted c))))
            (when complete (set! (.-flags_field c) (bit-or (.-flags_field c) Flags/ACYCLIC)))
            complete))))

  (method ^:private handleCyclic ^void [this ^Symbol$ClassSymbol c]
    (loop [^{:tag (List Type)} l (.interfaces types (.-type c))]
      (when (.nonEmpty l)
        (set! (.-head l)
              (.createErrorType types
                                (cast Symbol$ClassSymbol (.-tsym (cast Type (.-head l))))
                                Type/noType))
        (recur (.-tail l))))
    (let [st (.supertype types (.-type c))]
      (when (.hasTag st TypeTag/CLASS)
        (set! (.-supertype_field (cast Type$ClassType (.-type c)))
              (.createErrorType types (cast Symbol$ClassSymbol (.-tsym st)) Type/noType)))
      (set! (.-type c) (.createErrorType types c (.-type c)))
      (set! (.-flags_field c) (bit-or (.-flags_field c) Flags/ACYCLIC))))

  (method checkImplementations ^void [this ^JCTree$JCClassDecl tree]
    (.checkImplementations this tree (.-sym tree) (.-sym tree)))

  (method checkImplementations ^void [this ^JCTree tree ^Symbol$ClassSymbol origin
                                      ^Symbol$ClassSymbol ic]
    (loop [^{:tag (List Type)} l (.closure types (.-type ic))]
      (when (.nonEmpty l)
        (let [lc (cast Symbol$ClassSymbol (.-tsym (cast Type (.-head l))))]
          (if (not (== (bit-and (.flags lc) Flags/ABSTRACT) 0))
              (do
                (for-each [^Symbol sym (.getSymbols (.members lc) Scope$LookupKind/NON_RECURSIVE)]
                  (when (and (identical? (.-kind sym) Kinds$Kind/MTH)
                             (== (bit-and (.flags sym) (bit-or-int Flags/STATIC Flags/ABSTRACT))
                                 Flags/ABSTRACT))
                    (let [absmeth (cast Symbol$MethodSymbol sym)
                          implmeth (.implementation absmeth origin types false)]
                      (when (and (and (some? implmeth) (not (identical? implmeth absmeth)))
                                 (== (bit-and (.flags (.-owner implmeth)) Flags/INTERFACE)
                                     (bit-and (.flags origin) Flags/INTERFACE)))
                        (.checkOverride this tree implmeth absmeth origin)))))
                (recur (.-tail l)))
              (recur (.-tail l)))))))

  (method checkCompatibleSupertypes ^void [this ^JCDiagnostic$DiagnosticPosition pos ^Type c]
    (let [^:mutable ^{:tag (List Type)} supertypes (.interfaces types c)
          supertype (.supertype types c)]
      (when (and (.hasTag supertype TypeTag/CLASS)
                 (not (== (bit-and (.flags (.-tsym supertype)) Flags/ABSTRACT) 0)))
        (set! supertypes (.prepend supertypes supertype)))
      (loop [^{:tag (List Type)} l supertypes]
        (when (.nonEmpty l)
          (when (and (not (.isEmpty (.getTypeArguments (cast Type (.-head l)))))
                     (not (.checkCompatibleAbstracts
                            this
                            pos
                            (cast Type (.-head l))
                            (cast Type (.-head l))
                            c)))
            (return))
          (loop [^{:tag (List Type)} m supertypes]
            (if (not (identical? m l))
                (if (not (.checkCompatibleAbstracts
                           this
                           pos
                           (cast Type (.-head l))
                           (cast Type (.-head m))
                           c))
                    (return)
                    (recur (.-tail m)))
                nil))
          (recur (.-tail l))))
      (.checkCompatibleConcretes this pos c)))

  (method checkOverrideClashes ^void [this ^JCDiagnostic$DiagnosticPosition pos ^Type site
                                      ^Symbol$MethodSymbol sym]
    (let [cf (ClashFilter. site)
          ^{:tag (ArrayList Symbol)} symbolsByName (ArrayList.)]
      (.forEach (.getSymbolsByName (.membersClosure types site false) (.-name sym) cf)
                (method-ref Consumer [Symbol] symbolsByName ArrayList/.add))
      (for-each [^Symbol m1 symbolsByName]
        (when-not (not (.overrides sym m1 (.-tsym site) types false))
          (for-each [^Symbol m2 symbolsByName]
            (when-not (identical? m2 m1)
              (when (and (not (.isSubSignature types (.-type sym) (.memberType types site m2)))
                         (.hasSameArgs types (.erasure m2 types) (.erasure m1 types)))
                (set! (.-flags_field sym) (bit-or (.-flags_field sym) Flags/CLASH))
                (if (identical? m1 sym)
                    (.error log
                            pos
                            (CompilerProperties$Errors/NameClashSameErasureNoOverride
                              (.-name m1)
                              (.getParameterTypes (.asMethodType (.memberType types site m1)))
                              (.location m1)
                              (.-name m2)
                              (.getParameterTypes (.asMethodType (.memberType types site m2)))
                              (.location m2)))
                    (let [ct (cast Type$ClassType site)
                          ^String kind (if (.isInterface ct) "interface" "class")]
                      (.error log
                              pos
                              (CompilerProperties$Errors/NameClashSameErasureNoOverride1
                                kind
                                (.-name (.-tsym ct))
                                (.-name m1)
                                (.getParameterTypes (.asMethodType (.memberType types site m1)))
                                (.location m1)
                                (.-name m2)
                                (.getParameterTypes (.asMethodType (.memberType types site m2)))
                                (.location m2)))))
                (return))))))))

  (method checkHideClashes ^void [this ^JCDiagnostic$DiagnosticPosition pos ^Type site
                                  ^Symbol$MethodSymbol sym]
    (let [cf (ClashFilter. site)]
      (for-each [^Symbol s (.getSymbolsByName (.membersClosure types site true) (.-name sym) cf)]
        (when-not (.isSubSignature types (.-type sym) (.memberType types site s))
          (when (.hasSameArgs types (.erasure s types) (.erasure sym types))
            (.error log
                    pos
                    (CompilerProperties$Errors/NameClashSameErasureNoHide
                      sym
                      (.location sym)
                      s
                      (.location s)))
            (return))))))

  (defclass ^:private ClashFilter
    :implements [(Predicate Symbol)]

    (field ^Type site)

    (constructor [this ^Type site] (set! (.-site this) site))

    (method shouldSkip ^boolean [this ^Symbol s]
      (and (not (== (bit-and (.flags s) Flags/CLASH) 0)) (identical? (.-owner s) (.-tsym site))))

    (method ^:public test ^boolean [this ^Symbol s]
      (and (and (and (and (identical? (.-kind s) Kinds$Kind/MTH)
                          (== (bit-and (.flags s) Flags/SYNTHETIC) 0))
                     (not (.shouldSkip this s)))
                (.isInheritedIn s (.-tsym site) types))
           (not (.isConstructor s)))))

  (method checkDefaultMethodClashes ^void [this ^JCDiagnostic$DiagnosticPosition pos ^Type site]
    (let [dcf (DefaultMethodClashFilter. site)]
      (for-each [^Symbol m (.getSymbols (.membersClosure types site false) dcf)]
        (Assert/check (identical? (.-kind m) Kinds$Kind/MTH))
        (let [^{:tag (List Symbol$MethodSymbol)} prov (.interfaceCandidates
                                                        types
                                                        site
                                                        (cast Symbol$MethodSymbol m))]
          (when (> (.size prov) 1)
            (let [^:mutable ^{:tag (ListBuffer Symbol)} abstracts (ListBuffer.)
                  ^:mutable ^{:tag (ListBuffer Symbol)} defaults (ListBuffer.)]
              (for-each [^Symbol$MethodSymbol provSym prov]
                (if (not (== (bit-and (.flags provSym) Flags/DEFAULT) 0))
                    (set! defaults (.append defaults provSym))
                    (when-not (== (bit-and (.flags provSym) Flags/ABSTRACT) 0)
                      (set! abstracts (.append abstracts provSym))))
                (when (and (.nonEmpty defaults)
                           (>= (unchecked-add-int (.size defaults) (.size abstracts)) 2))
                  (let [^:mutable ^JCDiagnostic$Fragment diagKey nil
                        s1 (cast Symbol (.first defaults))
                        ^:mutable ^Symbol s2 nil]
                    (if (> (.size defaults) 1)
                        (do
                          (set! s2 (cast Symbol (.-head (.-tail (.toList defaults)))))
                          (set! diagKey
                                (CompilerProperties$Fragments/IncompatibleUnrelatedDefaults
                                  (Kinds/kindName (.-tsym site))
                                  site
                                  (.-name m)
                                  (.getParameterTypes (.memberType types site m))
                                  (.location s1)
                                  (.location s2))))
                        (do
                          (set! s2 (cast Symbol (.first abstracts)))
                          (set! diagKey
                                (CompilerProperties$Fragments/IncompatibleAbstractDefault
                                  (Kinds/kindName (.-tsym site))
                                  site
                                  (.-name m)
                                  (.getParameterTypes (.memberType types site m))
                                  (.location s1)
                                  (.location s2)))))
                    (.error log
                            pos
                            (CompilerProperties$Errors/TypesIncompatible
                              (.-type (.location s1))
                              (.-type (.location s2))
                              diagKey))
                    (break))))))))))

  (defclass ^:private DefaultMethodClashFilter
    :implements [(Predicate Symbol)]

    (field ^Type site)

    (constructor [this ^Type site] (set! (.-site this) site))

    (method ^:public test ^boolean [this ^Symbol s]
      (and (and (and (identical? (.-kind s) Kinds$Kind/MTH)
                     (not (== (bit-and (.flags s) Flags/DEFAULT) 0)))
                (.isInheritedIn s (.-tsym site) types))
           (not (.isConstructor s)))))

  (method checkPotentiallyAmbiguousOverloads ^void [this ^JCTree$JCClassDecl tree ^Type site]
    (when-not (not (.isEnabled lint Lint$LintCategory/OVERLOADS))
      (let [^{:tag (List (java.util.List Symbol$MethodSymbol))} methodGroups (.methodsGroupedByName
                                                                               this
                                                                               site
                                                                               (PotentiallyAmbiguousFilter.
                                                                                 site)
                                                                               (method-ref
                                                                                 Supplier
                                                                                 ^java.util.List []
                                                                                 ArrayList/new))
            ^{:tag (BiPredicate Symbol$MethodSymbol Symbol$MethodSymbol)} responsible
              (.buildResponsiblePredicate this site methodGroups)]
        (.forEach methodGroups
                  (lambda Consumer ^void [^java.util.List list]
                    (.removePreempted this
                                      list
                                      (lambda BiPredicate ^boolean [^Symbol$MethodSymbol m1
                                                                    ^Symbol$MethodSymbol m2]
                                        (.overrides m1 m2 (.-tsym site) types false)))))
        (.forEach methodGroups
                  (lambda Consumer ^void [^java.util.List list]
                    (.removeIf list
                               (lambda Predicate ^boolean [^Symbol$MethodSymbol m]
                                 (and (identical? (.-owner m) (.-tsym site))
                                      (not (.isEnabled
                                             (.augment lint m)
                                             Lint$LintCategory/OVERLOADS)))))))
        (.forEach
          methodGroups
          (lambda Consumer ^void [^java.util.List list]
            (.compareAndRemove
              this
              list
              (lambda ToIntBiFunction ^int [^Symbol$MethodSymbol m1 ^Symbol$MethodSymbol m2]
                (if (or (not (.potentiallyAmbiguousOverload this site m1 m2))
                        (not (.test responsible m1 m2)))
                    0
                    (let [^JCDiagnostic$DiagnosticPosition pos (cond
                                                                 (identical?
                                                                   (.-owner m1)
                                                                   (.-tsym site))
                                                                   (TreeInfo/diagnosticPositionFor
                                                                     m1
                                                                     tree)
                                                                 (identical?
                                                                   (.-owner m2)
                                                                   (.-tsym site))
                                                                   (TreeInfo/diagnosticPositionFor
                                                                     m2
                                                                     tree)
                                                                 :else (.pos tree))]
                      (.warning log
                                pos
                                (CompilerProperties$LintWarnings/PotentiallyAmbiguousOverload
                                  (.asMemberOf m1 site types)
                                  (.location m1)
                                  (.asMemberOf m2 site types)
                                  (.location m2)))
                      (bit-or-int FIRST SECOND))))))))))

  (method buildResponsiblePredicate ^{:tag (BiPredicate Symbol$MethodSymbol Symbol$MethodSymbol)} [this
                                                                                                   ^Type site
                                                                                                   ^{:tag (List (? extends (Collection Symbol$MethodSymbol)))} methodGroups]
    (let [^{:tag (BiPredicate Symbol$MethodSymbol Symbol$MethodSymbol)} overrides
            (lambda BiPredicate ^boolean [^Symbol$MethodSymbol m1 ^Symbol$MethodSymbol m2]
              (.overrides m1 m2 (.-tsym site) types false))
          ^{:tag (HashMap Symbol$MethodSymbol (ArrayList Symbol$MethodSymbol))} overriddenMethodsMap
            (HashMap.)]
      (.forEach
        methodGroups
        (lambda Consumer ^void [^Collection list]
          (for-each [^Symbol$MethodSymbol m list]
            (when-not (not (identical? (.-owner m) (.-tsym site)))
              (let [^{:tag (ArrayList Symbol$MethodSymbol)} overriddenMethods (cast
                                                                                ArrayList
                                                                                (.collect
                                                                                  (.filter
                                                                                    (.stream list)
                                                                                    (lambda Predicate ^boolean [^Symbol$MethodSymbol m2]
                                                                                      (and
                                                                                        (not
                                                                                          (identical?
                                                                                            m2
                                                                                            m))
                                                                                        (.test
                                                                                          overrides
                                                                                          m
                                                                                          m2))))
                                                                                  (Collectors/toCollection
                                                                                    (method-ref
                                                                                      Supplier
                                                                                      ^ArrayList []
                                                                                      ArrayList/new))))]
                (.removePreempted this overriddenMethods overrides)
                (.put overriddenMethodsMap m overriddenMethods))))))
      (lambda BiPredicate ^boolean [^Symbol$MethodSymbol m1 ^Symbol$MethodSymbol m2]
        (let [^{:tag (java.util.List Symbol$MethodSymbol)} overriddenMethods1 (cast
                                                                                java.util.List
                                                                                (.get
                                                                                  overriddenMethodsMap
                                                                                  m1))
              ^{:tag (java.util.List Symbol$MethodSymbol)} overriddenMethods2 (cast
                                                                                java.util.List
                                                                                (.get
                                                                                  overriddenMethodsMap
                                                                                  m2))]
          (cond
            (and (some? overriddenMethods1) (.isEmpty overriddenMethods1)) true
            (and (some? overriddenMethods2) (.isEmpty overriddenMethods2)) true
            :else
              (let [^{:tag (java.util.List Symbol$MethodSymbol)} supertypeMethods1 (if (some?
                                                                                         overriddenMethods1)
                                                                                       overriddenMethods1
                                                                                       (Collections/singletonList
                                                                                         m1))
                    ^{:tag (java.util.List Symbol$MethodSymbol)} supertypeMethods2 (if (some?
                                                                                         overriddenMethods2)
                                                                                       overriddenMethods2
                                                                                       (Collections/singletonList
                                                                                         m2))]
                (.noneMatch (.map (.filter (.stream (.directSupertypes types site))
                                           (lambda Predicate ^boolean [^Type stype]
                                             (not (identical? stype (.-objectType syms)))))
                                  (lambda Function ^Type [^Type stype] (.-type (.-tsym stype))))
                            (lambda Predicate ^boolean [^Type stype]
                              (for-each [^Symbol$MethodSymbol sm1 supertypeMethods1]
                                (when-not (not (.isSubtype
                                                 types
                                                 (.erasure types stype)
                                                 (.erasure types (.-type (.-owner sm1)))))
                                  (for-each [^Symbol$MethodSymbol sm2 supertypeMethods2]
                                    (when-not (not
                                                (.isSubtype
                                                  types
                                                  (.erasure types stype)
                                                  (.erasure types (.-type (.-owner sm2)))))
                                      (when (.potentiallyAmbiguousOverload this stype sm1 sm2)
                                        (return true))))))
                              false))))))))

  (method methodsGroupedByName :type-params [(C extends (Collection Symbol$MethodSymbol))] ^{:tag (List C)} [this
                                                                                                             ^Type site
                                                                                                             ^{:tag (Predicate Symbol)} filter
                                                                                                             ^{:tag (Supplier (? extends C))} groupMaker]
    (let [^{:tag (Iterable Symbol)} symbols (.getSymbols
                                              (.membersClosure types site false)
                                              filter
                                              Scope$LookupKind/RECURSIVE)]
      (cast List
            (.collect (.map (.sorted (.stream
                                       (.entrySet
                                         (cast Map
                                               (.collect
                                                 (.map
                                                   (StreamSupport/stream
                                                     (.spliterator symbols)
                                                     false)
                                                   (method-ref
                                                     Function
                                                     ^Symbol$MethodSymbol [Symbol]
                                                     Symbol$MethodSymbol
                                                     Class/.cast))
                                                 (Collectors/groupingBy
                                                   (lambda Function ^Name [^Symbol$MethodSymbol m]
                                                     (.-name m))
                                                   (Collectors/toCollection groupMaker))))))
                                     (Comparator/comparing
                                       (lambda Function ^String [^Map$Entry e]
                                         (.toString (cast Name (.getKey e))))))
                            (method-ref Function ^Collection [Map$Entry] Map$Entry/.getValue))
                      (List/collector)))))

  (method compareAndRemove :type-params [T] ^void [this ^{:tag (java.util.List T)} list
                                                   ^{:tag (ToIntBiFunction (? super T) (? super T))} comparer]
    (let [^:mutable ^int index1 0]
      (while (< index1 (unchecked-subtract-int (.size list) 1))
        (let [^T item1 (.get list index1)
              ^:mutable index2 (unchecked-add-int index1 1)]
          (while (< index2 (.size list))
            (let [^T item2 (.get list index2)
                  flags (.applyAsInt comparer item1 item2)]
              (when-not (== (bit-and-int flags SECOND) 0)
                (.remove list index2)
                (set! index2 (unchecked-dec-int index2)))
              (when-not (== (bit-and-int flags FIRST) 0)
                (.remove list index1)
                (set! index1 (unchecked-dec-int index1))
                (break)))
            (set! index2 (unchecked-inc-int index2))))
        (set! index1 (unchecked-inc-int index1)))))

  (method removePreempted :type-params [T] ^void [this ^{:tag (java.util.List T)} list
                                                  ^{:tag (BiPredicate (? super T) (? super T))} preempts]
    (.compareAndRemove this
                       list
                       (lambda ToIntBiFunction ^int [item1 item2]
                         (let [^:mutable ^int flags 0]
                           (when (.test preempts item1 item2)
                             (set! flags (bit-or-int flags SECOND)))
                           (when (.test preempts item2 item1) (set! flags (bit-or-int flags FIRST)))
                           flags))))

  (defclass PotentiallyAmbiguousFilter
    :extends ClashFilter

    (constructor [this ^Type site] (super. site))

    (method shouldSkip ^boolean [this ^Symbol s]
      (or (identical? (.-tsym (.-type (.-owner s))) (.-tsym (.-objectType syms)))
          (.shouldSkip super s))))

  (method potentiallyAmbiguousOverload ^boolean [this ^Type site ^Symbol$MethodSymbol msym1
                                                 ^Symbol$MethodSymbol msym2]
    (Assert/check (identical? (.-name msym1) (.-name msym2)))
    (if (identical? msym1 msym2)
        false
        (let [mt1 (.memberType types site msym1)
              ^:mutable mt2 (.memberType types site msym2)]
          (when (and (and (.hasTag mt1 TypeTag/FORALL) (.hasTag mt2 TypeTag/FORALL))
                     (.hasSameBounds types (cast Type$ForAll mt1) (cast Type$ForAll mt2)))
            (set! mt2
                  (.subst types
                          mt2
                          (.-tvars (cast Type$ForAll mt2))
                          (.-tvars (cast Type$ForAll mt1)))))
          (let [maxLength (Math/max (.length (.getParameterTypes mt1))
                                    (.length (.getParameterTypes mt2)))
                ^:mutable ^{:tag (List Type)} args1 (.adjustArgs
                                                      rs
                                                      (.getParameterTypes mt1)
                                                      msym1
                                                      maxLength
                                                      true)
                ^:mutable ^{:tag (List Type)} args2 (.adjustArgs
                                                      rs
                                                      (.getParameterTypes mt2)
                                                      msym2
                                                      maxLength
                                                      true)]
            (if (not (== (.length args1) (.length args2)))
                false
                (let [^:mutable potentiallyAmbiguous false]
                  (while (and (.nonEmpty args1) (.nonEmpty args2))
                    (let [s (cast Type (.-head args1))
                          t (cast Type (.-head args2))]
                      (when (and (not (.isSubtype types t s)) (not (.isSubtype types s t)))
                        (if (and (and (and (.isFunctionalInterface types s)
                                           (.isFunctionalInterface types t))
                                      (> (.length
                                           (.getParameterTypes (.findDescriptorType types s)))
                                         0))
                                 (== (.length (.getParameterTypes (.findDescriptorType types s)))
                                     (.length (.getParameterTypes (.findDescriptorType types t)))))
                            (set! potentiallyAmbiguous true)
                            (return false)))
                      (set! args1 (.-tail args1))
                      (set! args2 (.-tail args2))))
                  potentiallyAmbiguous))))))

  (method checkAccessFromSerializableElement ^void [this ^:final ^JCTree tree ^boolean isLambda]
    (when (or warnOnAnyAccessToMembers isLambda)
      (.checkAccessFromSerializableElementInner this tree isLambda)))

  (method ^:private checkAccessFromSerializableElementInner ^void [this ^:final ^JCTree tree
                                                                   ^boolean isLambda]
    (let [sym (TreeInfo/symbol tree)]
      (when-not (not (.matches (.-kind sym) Kinds$KindSelector/VAL_MTH))
        (when (identical? (.-kind sym) Kinds$Kind/VAR)
          (when (or (or (or (not (== (bit-and (.flags sym) Flags/PARAMETER) 0))
                            (.isDirectlyOrIndirectlyLocal sym))
                        (identical? (.-name sym) (.-_this names)))
                    (identical? (.-name sym) (.-_super names)))
            (return)))
        (when (and (not (.isSubtype types (.-type (.-owner sym)) (.-serializableType syms)))
                   (.isEffectivelyNonPublic this sym))
          (let [^JCDiagnostic$DiagnosticFlag flag (when warnOnAnyAccessToMembers
                                                    JCDiagnostic$DiagnosticFlag/DEFAULT_ENABLED)]
            (if isLambda
                (when (.belongsToRestrictedPackage this sym)
                  (.warning log
                            flag
                            (.pos tree)
                            (CompilerProperties$LintWarnings/AccessToMemberFromSerializableLambda
                              sym)))
                (.warning log
                          flag
                          (.pos tree)
                          (CompilerProperties$LintWarnings/AccessToMemberFromSerializableElement
                            sym))))))))

  (method ^:private isEffectivelyNonPublic ^boolean [this ^:mutable ^Symbol sym]
    (if (identical? (.packge sym) (.-rootPackage syms))
        false
        (do
          (while (not (identical? (.-kind sym) Kinds$Kind/PCK))
            (when (== (bit-and (.flags sym) Flags/PUBLIC) 0) (return true))
            (set! sym (.-owner sym)))
          false)))

  (method ^:private belongsToRestrictedPackage ^boolean [this ^Symbol sym]
    (let [fullName (.toString (.-fullname (.packge sym)))]
      (or (or (or (.startsWith fullName "java.") (.startsWith fullName "javax."))
              (.startsWith fullName "sun."))
          (.contains fullName ".internal."))))

  (method checkClassBounds ^void [this ^JCDiagnostic$DiagnosticPosition pos ^Type type]
    (.checkClassBounds this pos (HashMap.) type))

  (method checkClassBounds ^void [this ^JCDiagnostic$DiagnosticPosition pos
                                  ^{:tag (Map Symbol$TypeSymbol Type)} seensofar ^Type type]
    (when-not (.isErroneous type)
      (loop [^{:tag (List Type)} l (.interfaces types type)]
        (when (.nonEmpty l)
          (let [it (cast Type (.-head l))]
            (if (and (.hasTag type TypeTag/CLASS) (not (.hasTag it TypeTag/CLASS)))
                (recur (.-tail l))
                (let [oldit (cast Type (.put seensofar (.-tsym it) it))]
                  (when (some? oldit)
                    (let [^{:tag (List Type)} oldparams (.allparams oldit)
                          ^{:tag (List Type)} newparams (.allparams it)]
                      (when-not (.containsTypeEquivalent types oldparams newparams)
                        (.error log
                                pos
                                (CompilerProperties$Errors/CantInheritDiffArg
                                  (.-tsym it)
                                  (Type/toString oldparams)
                                  (Type/toString newparams))))))
                  (.checkClassBounds this pos seensofar it)
                  (recur (.-tail l)))))))
      (let [st (.supertype types type)]
        (when-not (and (.hasTag type TypeTag/CLASS) (not (.hasTag st TypeTag/CLASS)))
          (when-not (identical? st Type/noType) (.checkClassBounds this pos seensofar st))))))

  (method checkNotRepeated ^void [this ^JCDiagnostic$DiagnosticPosition pos ^Type it
                                  ^{:tag (Set Symbol)} its]
    (if (.contains its (.-tsym it))
        (.error log pos CompilerProperties$Errors/RepeatedInterface)
        (.add its (.-tsym it))))

  (method validateAnnotationTree ^void [this ^JCTree tree]
    (letclass [(AnnotationValidator
                 :extends TreeScanner

                 (method ^:public visitAnnotation ^void [this ^JCTree$JCAnnotation tree]
                   (when (and (not (.isErroneous (.-type tree)))
                              (.isAnnotationType (.-tsym (.-type tree))))
                     (.visitAnnotation super tree)
                     (.validateAnnotation Check/this tree))))]
      (.accept tree (AnnotationValidator.))))

  (method validateAnnotationType ^void [this ^JCTree restype]
    (when (some? restype) (.validateAnnotationType this (.pos restype) (.-type restype))))

  (method validateAnnotationType ^void [this ^JCDiagnostic$DiagnosticPosition pos ^Type type]
    (when-not (.isPrimitive type)
      (when-not (.isSameType types type (.-stringType syms))
        (when-not (not (== (bit-and (.flags (.-tsym type)) Flags/ENUM) 0))
          (when-not (not (== (bit-and (.flags (.-tsym type)) Flags/ANNOTATION) 0))
            (when-not (identical? (.-tsym (.cvarLowerBound types type)) (.-tsym (.-classType syms)))
              (if (and (.isArray types type) (not (.isArray types (.elemtype types type))))
                  (.validateAnnotationType this pos (.elemtype types type))
                  (.error log pos CompilerProperties$Errors/InvalidAnnotationMemberType))))))))

  (method validateAnnotationMethod ^void [this ^JCDiagnostic$DiagnosticPosition pos
                                          ^Symbol$MethodSymbol m]
    (loop [sup (.-annotationType syms)]
      (when (.hasTag sup TypeTag/CLASS)
        (let [^Scope s (.members (.-tsym sup))]
          (for-each [^Symbol sym (.getSymbolsByName s (.-name m))]
            (when (and (and (identical? (.-kind sym) Kinds$Kind/MTH)
                            (not (== (bit-and (.flags sym)
                                              (bit-or-int Flags/PUBLIC Flags/PROTECTED))
                                     0)))
                       (.overrideEquivalent types (.-type m) (.-type sym)))
              (.error log pos (CompilerProperties$Errors/IntfAnnotationMemberClash sym sup))))
          (recur (.supertype types sup))))))

  (method ^:public validateAnnotations ^void [this ^{:tag (List JCTree$JCAnnotation)} annotations
                                              ^JCTree declarationTree ^Symbol s]
    (for-each [^JCTree$JCAnnotation a annotations] (.validateAnnotation this a declarationTree s)))

  (method ^:public validateTypeAnnotations ^void [this
                                                  ^{:tag (List JCTree$JCAnnotation)} annotations
                                                  ^Symbol s ^boolean isTypeParameter]
    (for-each [^JCTree$JCAnnotation a annotations]
      (.validateTypeAnnotation this a s isTypeParameter)))

  (method ^:private validateAnnotation ^void [this ^JCTree$JCAnnotation a ^JCTree declarationTree
                                              ^Symbol s]
    (.validateAnnotationTree this a)
    (let [isRecordMember (or (not (== (bit-and (.-flags_field s) Flags/RECORD) 0))
                             (and (some? (.enclClass s)) (.isRecord (.enclClass s))))
          isRecordField (and (and (not (== (bit-and (.-flags_field s) Flags/RECORD) 0))
                                  (.hasTag declarationTree JCTree$Tag/VARDEF))
                             (identical? (.-kind (.-owner s)) Kinds$Kind/TYP))]
      (when isRecordField
        (let [targets (.getTargetNames this a)
              ^:mutable appliesToRecords false]
          (for-each [^Name target targets]
            (set! appliesToRecords
                  (or (or (or (or (identical? target (.-FIELD names))
                                  (identical? target (.-PARAMETER names)))
                              (identical? target (.-METHOD names)))
                          (identical? target (.-TYPE_USE names)))
                      (identical? target (.-RECORD_COMPONENT names))))
            (when appliesToRecords (break)))
          (if (not appliesToRecords)
              (.error log (.pos a) CompilerProperties$Errors/AnnotationTypeNotApplicable)
              (let [recordClass (cast Symbol$ClassSymbol (.-owner s))
                    rc (.getRecordComponent recordClass (cast Symbol$VarSymbol s))
                    metadata (.getMetadata rc)]
                (when (or (nil? metadata) (.isEmpty metadata))
                  (.appendAttributes rc
                                     (cast
                                       List
                                       (.collect
                                         (.filter
                                           (.stream (.getRawAttributes s))
                                           (lambda Predicate ^boolean [^Attribute$Compound anno]
                                             (.anyMatch
                                               (Arrays/stream
                                                 (.getTargetNames this (.-tsym (.-type anno))))
                                               (lambda Predicate ^boolean [^Name name]
                                                 (identical? name (.-RECORD_COMPONENT names))))))
                                         (List/collector))))
                  (let [fieldAST (cast JCTree$JCVariableDecl declarationTree)]
                    (for-each [^JCTree$JCAnnotation fieldAnnot (.-annotations (.-mods fieldAST))]
                      (for-each [^JCTree$JCAnnotation rcAnnot (.-annotations
                                                                (.-mods (.declarationFor rc)))]
                        (when (== (.-pos rcAnnot) (.-pos fieldAnnot))
                          (.setType rcAnnot (.-type fieldAnnot))
                          (break))))))))))
      (when (.isAnnotationType (.-tsym (.-type a)))
        (let [^{:tag (Optional (Set Name))} applicableTargetsOp (.getApplicableTargets this a s)]
          (when-not (.isEmpty applicableTargetsOp)
            (let [^{:tag (Set Name)} applicableTargets (cast Set (.get applicableTargetsOp))
                  notApplicableOrIsTypeUseOnly (or
                                                 (.isEmpty applicableTargets)
                                                 (and
                                                   (== (.size applicableTargets) 1)
                                                   (.contains applicableTargets (.-TYPE_USE names))))
                  isCompGeneratedRecordElement (and
                                                 isRecordMember
                                                 (not
                                                   (==
                                                     (bit-and
                                                       (.-flags_field s)
                                                       Flags/GENERATED_MEMBER)
                                                     0)))
                  isCompRecordElementWithNonApplicableDeclAnno (and
                                                                 isCompGeneratedRecordElement
                                                                 notApplicableOrIsTypeUseOnly)]
              (when (or (.isEmpty applicableTargets) isCompRecordElementWithNonApplicableDeclAnno)
                (if isCompRecordElementWithNonApplicableDeclAnno
                    (let [modifiers (TreeInfo/getModifiers declarationTree)]
                      (when (and (some? modifiers) (.isEmpty applicableTargets))
                        (let [^{:tag (ListBuffer JCTree$JCAnnotation)} newAnnotations (ListBuffer.)]
                          (for-each [^JCTree$JCAnnotation anno (.-annotations modifiers)]
                            (when-not (identical? anno a) (.add newAnnotations anno)))
                          (set! (.-annotations modifiers) (.toList newAnnotations))))
                      (.removeDeclarationMetadata (.getMetadata s) (.-attribute a)))
                    (.error log (.pos a) CompilerProperties$Errors/AnnotationTypeNotApplicable)))
              (when (and (and (and isCompGeneratedRecordElement (not isRecordField))
                              (identical? (.-tsym (.-type a)) (.-tsym (.-trustMeType syms))))
                         (.hasTag declarationTree JCTree$Tag/METHODDEF))
                (.error log
                        (.pos a)
                        (CompilerProperties$Errors/VarargsInvalidTrustmeAnno
                          (.-tsym (.-trustMeType syms))
                          (CompilerProperties$Fragments/VarargsTrustmeOnNonVarargsAccessor s))))))))
      (when (identical? (.-tsym (.-type (.-annotationType a)))
                        (.-tsym (.-functionalInterfaceType syms)))
        (cond
          (not (identical? (.-kind s) Kinds$Kind/TYP))
            (.error log (.pos a) CompilerProperties$Errors/BadFunctionalIntfAnno)
          (or (not (.isInterface s)) (not (== (bit-and (.flags s) Flags/ANNOTATION) 0)))
            (.error log
                    (.pos a)
                    (CompilerProperties$Errors/BadFunctionalIntfAnno1
                      (CompilerProperties$Fragments/NotAFunctionalIntf s)))))))

  (method ^:public validateTypeAnnotation ^void [this ^JCTree$JCAnnotation a ^Symbol s
                                                 ^boolean isTypeParameter]
    (Assert/checkNonNull (.-type a))
    (when (some? s) (.getApplicableTargets this a s))
    (.validateAnnotationTree this a)
    (when (and (and (.hasTag a JCTree$Tag/TYPE_ANNOTATION)
                    (not (.isErroneous (.-type (.-annotationType a)))))
               (not (.isTypeAnnotation this a isTypeParameter)))
      (.error log (.pos a) (CompilerProperties$Errors/AnnotationTypeNotApplicableToType (.-type a)))))

  (method ^:public validateRepeatable ^void [this ^Symbol$TypeSymbol s
                                             ^Attribute$Compound repeatable
                                             ^JCDiagnostic$DiagnosticPosition pos]
    (Assert/check (.isSameType types (.-type repeatable) (.-repeatableType syms)))
    (let [^:mutable ^Type t nil
          ^{:tag (List (Pair Symbol$MethodSymbol Attribute))} l (.-values repeatable)]
      (when-not (.isEmpty l)
        (Assert/check (identical? (.-name (cast Symbol$MethodSymbol (.-fst (cast Pair (.-head l)))))
                                  (.-value names)))
        (when (instance? Attribute$Class (.-snd (cast Pair (.-head l))))
          (set! t (.getValue (cast Attribute$Class (.-snd (cast Pair (.-head l))))))))
      (when (some? t)
        (.validateValue this (.-tsym t) s pos)
        (.validateRetention this (.-tsym t) s pos)
        (.validateDocumented this (.-tsym t) s pos)
        (.validateInherited this (.-tsym t) s pos)
        (.validateTarget this (.-tsym t) s pos)
        (.validateDefault this (.-tsym t) pos))))

  (method ^:private validateValue ^void [this ^Symbol$TypeSymbol container
                                         ^Symbol$TypeSymbol contained
                                         ^JCDiagnostic$DiagnosticPosition pos]
    (let [sym (.findFirst (.members container) (.-value names))]
      (if (and (some? sym) (identical? (.-kind sym) Kinds$Kind/MTH))
          (let [m (cast Symbol$MethodSymbol sym)
                ret (.getReturnType m)]
            (when-not (and (.hasTag ret TypeTag/ARRAY)
                           (.isSameType types
                                        (.-elemtype (cast Type$ArrayType ret))
                                        (.-type contained)))
              (.error log
                      pos
                      (CompilerProperties$Errors/InvalidRepeatableAnnotationValueReturn
                        container
                        ret
                        (.makeArrayType types (.-type contained))))))
          (.error log pos (CompilerProperties$Errors/InvalidRepeatableAnnotationNoValue container)))))

  (method ^:private validateRetention ^void [this ^Symbol$TypeSymbol container
                                             ^Symbol$TypeSymbol contained
                                             ^JCDiagnostic$DiagnosticPosition pos]
    (let [containerRetention (.getRetention types container)
          containedRetention (.getRetention types contained)
          ^:mutable error false]
      (switch containedRetention
        RUNTIME
          (when-not (identical? containerRetention Attribute$RetentionPolicy/RUNTIME)
            (set! error true))
        CLASS
          (when (identical? containerRetention Attribute$RetentionPolicy/SOURCE) (set! error true)))
      (when error
        (.error log
                pos
                (CompilerProperties$Errors/InvalidRepeatableAnnotationRetention
                  container
                  (.name containerRetention)
                  contained
                  (.name containedRetention))))))

  (method ^:private validateDocumented ^void [this ^Symbol container ^Symbol contained
                                              ^JCDiagnostic$DiagnosticPosition pos]
    (when (some? (.attribute contained (.-tsym (.-documentedType syms))))
      (when (nil? (.attribute container (.-tsym (.-documentedType syms))))
        (.error log
                pos
                (CompilerProperties$Errors/InvalidRepeatableAnnotationNotDocumented
                  container
                  contained)))))

  (method ^:private validateInherited ^void [this ^Symbol container ^Symbol contained
                                             ^JCDiagnostic$DiagnosticPosition pos]
    (when (some? (.attribute contained (.-tsym (.-inheritedType syms))))
      (when (nil? (.attribute container (.-tsym (.-inheritedType syms))))
        (.error log
                pos
                (CompilerProperties$Errors/InvalidRepeatableAnnotationNotInherited
                  container
                  contained)))))

  (method ^:private validateTarget ^void [this ^Symbol$TypeSymbol container
                                          ^Symbol$TypeSymbol contained
                                          ^JCDiagnostic$DiagnosticPosition pos]
    (let [^:mutable ^{:tag (Set Name)} containerTargets nil
          containerTarget (.getAttributeTargetAttribute this container)]
      (if (nil? containerTarget)
          (set! containerTargets (.getDefaultTargetSet this))
          (do
            (set! containerTargets (HashSet.))
            (for-each [^Attribute app (.-values containerTarget)]
              (when-instance [^Attribute$Enum attributeEnum app]
                (.add containerTargets (.-name (.-value attributeEnum)))))))
      (let [^:mutable ^{:tag (Set Name)} containedTargets nil
            containedTarget (.getAttributeTargetAttribute this contained)]
        (if (nil? containedTarget)
            (set! containedTargets (.getDefaultTargetSet this))
            (do
              (set! containedTargets (HashSet.))
              (for-each [^Attribute app (.-values containedTarget)]
                (when-instance [^Attribute$Enum attributeEnum app]
                  (.add containedTargets (.-name (.-value attributeEnum)))))))
        (when-not (.isTargetSubsetOf this containerTargets containedTargets)
          (.error log
                  pos
                  (CompilerProperties$Errors/InvalidRepeatableAnnotationIncompatibleTarget
                    container
                    contained))))))

  (method ^:private getDefaultTargetSet ^{:tag (Set Name)} [this]
    (when (nil? defaultTargets) (set! defaultTargets (Set/of (.defaultTargetMetaInfo this))))
    defaultTargets)

  (field ^:private ^{:tag (Set Name)} defaultTargets)

  (method ^:private isTargetSubsetOf ^boolean [this ^{:tag (Set Name)} s ^{:tag (Set Name)} t]
    (for-each [^Name n2 s]
      (let [^:mutable currentElementOk false]
        (for-each [^Name n1 t]
          (cond
            (identical? n1 n2) (do (set! currentElementOk true) (break))
            (and (identical? n1 (.-TYPE names)) (identical? n2 (.-ANNOTATION_TYPE names)))
              (do (set! currentElementOk true) (break))
            :else
              (when (and (identical? n1 (.-TYPE_USE names))
                         (or (or (identical? n2 (.-TYPE names))
                                 (identical? n2 (.-ANNOTATION_TYPE names)))
                             (identical? n2 (.-TYPE_PARAMETER names))))
                (set! currentElementOk true)
                (break))))
        (when-not currentElementOk (return false))))
    true)

  (method ^:private validateDefault ^void [this ^Symbol container
                                           ^JCDiagnostic$DiagnosticPosition pos]
    (let [^Scope scope (.members container)]
      (for-each [^Symbol elm (.getSymbols scope)]
        (when (and (and (not (identical? (.-name elm) (.-value names)))
                        (identical? (.-kind elm) Kinds$Kind/MTH))
                   (nil? (.-defaultValue (cast Symbol$MethodSymbol elm))))
          (.error log
                  pos
                  (CompilerProperties$Errors/InvalidRepeatableAnnotationElemNondefault
                    container
                    elm))))))

  (method isOverrider ^boolean [this ^Symbol s]
    (if (or (not (identical? (.-kind s) Kinds$Kind/MTH)) (.isStatic s))
        false
        (let [m (cast Symbol$MethodSymbol s)
              owner (cast Symbol$TypeSymbol (.-owner m))]
          (for-each [^Type sup (.closure types (.-type owner))]
            (when-not (identical? sup (.-type owner))
              (let [^Scope scope (.members (.-tsym sup))]
                (for-each [^Symbol sym (.getSymbolsByName scope (.-name m))]
                  (when (and (not (.isStatic sym)) (.overrides m sym owner types true))
                    (return true))))))
          false)))

  (method ^:protected isTypeAnnotation ^boolean [this ^JCTree$JCAnnotation a
                                                 ^boolean isTypeParameter]
    (let [^{:tag (List Attribute)} targets (.annotationTargets
                                             typeAnnotations
                                             (.-tsym (.-type (.-annotationType a))))]
      (if (nil? targets)
          (and (.allowedInSource Source$Feature/NO_TARGET_ANNOTATION_APPLICABILITY source)
               isTypeParameter)
          (.anyMatch (.stream targets)
                     (lambda Predicate ^boolean [^Attribute attr]
                       (.isTypeAnnotation this attr isTypeParameter))))))

  (method isTypeAnnotation ^boolean [this ^Attribute a ^boolean isTypeParameter]
    (let [e (cast Attribute$Enum a)]
      (or (identical? (.-name (.-value e)) (.-TYPE_USE names))
          (and isTypeParameter (identical? (.-name (.-value e)) (.-TYPE_PARAMETER names))))))

  (method getTargetNames ^Name/1 [this ^JCTree$JCAnnotation a]
    (.getTargetNames this (.-tsym (.-type (.-annotationType a)))))

  (method ^:public getTargetNames ^Name/1 [this ^Symbol$TypeSymbol annoSym]
    (let [arr (.getAttributeTargetAttribute this annoSym)
          ^:mutable ^Name/1 targets nil]
      (if (nil? arr)
          (set! targets (.defaultTargetMetaInfo this))
          (do
            (set! targets (new Name/1 (alength (.-values arr))))
            (loop [^int i 0]
              (when (< i (alength (.-values arr)))
                (let [app (aget (.-values arr) i)]
                  (if-instance [^Attribute$Enum attributeEnum app]
                    (do
                      (aset targets i (.-name (.-value attributeEnum)))
                      (recur (unchecked-inc-int i)))
                    (return (new Name/1 0))))))))
      targets))

  (method annotationApplicable ^boolean [this ^JCTree$JCAnnotation a ^Symbol s]
    (let [^{:tag (Optional (Set Name))} targets (.getApplicableTargets this a s)]
      (or (.isEmpty targets) (and (.isPresent targets) (not (.isEmpty (cast Set (.get targets))))))))

  (method getApplicableTargets ^{:tag (Optional (Set Name))} [this ^JCTree$JCAnnotation a ^Symbol s]
    (let [arr (.getAttributeTargetAttribute this (.-tsym (.-type (.-annotationType a))))
          ^:mutable ^Name/1 targets nil
          ^{:tag (Set Name)} applicableTargets (HashSet.)]
      (if (nil? arr)
          (set! targets (.defaultTargetMetaInfo this))
          (do
            (set! targets (new Name/1 (alength (.-values arr))))
            (loop [^int i 0]
              (when (< i (alength (.-values arr)))
                (let [app (aget (.-values arr) i)]
                  (if-instance [^Attribute$Enum attributeEnum app]
                    (do
                      (aset targets i (.-name (.-value attributeEnum)))
                      (recur (unchecked-inc-int i)))
                    (return (Optional/empty))))))))
      (for-each [^Name target targets]
        (cond
          (identical? target (.-TYPE names))
            (when (identical? (.-kind s) Kinds$Kind/TYP) (.add applicableTargets (.-TYPE names)))
          (identical? target (.-FIELD names))
            (when (and (identical? (.-kind s) Kinds$Kind/VAR)
                       (not (identical? (.-kind (.-owner s)) Kinds$Kind/MTH)))
              (.add applicableTargets (.-FIELD names)))
          (identical? target (.-RECORD_COMPONENT names))
            (when (identical? (.getKind s) ElementKind/RECORD_COMPONENT)
              (.add applicableTargets (.-RECORD_COMPONENT names)))
          (identical? target (.-METHOD names))
            (when (and (identical? (.-kind s) Kinds$Kind/MTH) (not (.isConstructor s)))
              (.add applicableTargets (.-METHOD names)))
          (identical? target (.-PARAMETER names))
            (when (and (identical? (.-kind s) Kinds$Kind/VAR)
                       (and (identical? (.-kind (.-owner s)) Kinds$Kind/MTH)
                            (not (== (bit-and (.flags s) Flags/PARAMETER) 0))))
              (.add applicableTargets (.-PARAMETER names)))
          (identical? target (.-CONSTRUCTOR names))
            (when (and (identical? (.-kind s) Kinds$Kind/MTH) (.isConstructor s))
              (.add applicableTargets (.-CONSTRUCTOR names)))
          (identical? target (.-LOCAL_VARIABLE names))
            (when (and (and (identical? (.-kind s) Kinds$Kind/VAR)
                            (identical? (.-kind (.-owner s)) Kinds$Kind/MTH))
                       (== (bit-and (.flags s) Flags/PARAMETER) 0))
              (.add applicableTargets (.-LOCAL_VARIABLE names)))
          (identical? target (.-ANNOTATION_TYPE names))
            (when (and (identical? (.-kind s) Kinds$Kind/TYP)
                       (not (== (bit-and (.flags s) Flags/ANNOTATION) 0)))
              (.add applicableTargets (.-ANNOTATION_TYPE names)))
          (identical? target (.-PACKAGE names))
            (when (identical? (.-kind s) Kinds$Kind/PCK) (.add applicableTargets (.-PACKAGE names)))
          (identical? target (.-TYPE_USE names))
            (when-not (and (and (identical? (.-kind s) Kinds$Kind/VAR)
                                (identical? (.-kind (.-owner s)) Kinds$Kind/MTH))
                           (.hasTag (.-type s) TypeTag/NONE))
              (when (or (or (or (identical? (.-kind s) Kinds$Kind/TYP)
                                (identical? (.-kind s) Kinds$Kind/VAR))
                            (and (and (identical? (.-kind s) Kinds$Kind/MTH)
                                      (not (.isConstructor s)))
                                 (not (.hasTag (.getReturnType (.-type s)) TypeTag/VOID))))
                        (and (identical? (.-kind s) Kinds$Kind/MTH) (.isConstructor s)))
                (.add applicableTargets (.-TYPE_USE names))))
          (identical? target (.-TYPE_PARAMETER names))
            (when (and (identical? (.-kind s) Kinds$Kind/TYP) (.hasTag (.-type s) TypeTag/TYPEVAR))
              (.add applicableTargets (.-TYPE_PARAMETER names)))
          (identical? target (.-MODULE names))
            (when (identical? (.-kind s) Kinds$Kind/MDL) (.add applicableTargets (.-MODULE names)))
          :else
            (do
              (.error log
                      a
                      (CompilerProperties$Errors/AnnotationUnrecognizedAttributeName
                        (.-type a)
                        target))
              (return (Optional/empty)))))
      (Optional/of applicableTargets)))

  (method getAttributeTargetAttribute ^Attribute$Array [this ^Symbol$TypeSymbol s]
    (let [atTarget (.getTarget (.getAnnotationTypeMetadata s))]
      (when (some? atTarget)
        (let [atValue (.member atTarget (.-value names))]
          (when-instance [^Attribute$Array attributeArray atValue] attributeArray)))))

  (field ^:private ^Name/1 dfltTargetMeta)

  (method ^:private defaultTargetMetaInfo ^Name/1 [this]
    (when (nil? dfltTargetMeta)
      (let [^{:tag (ArrayList Name)} defaultTargets (ArrayList.)]
        (.add defaultTargets (.-PACKAGE names))
        (.add defaultTargets (.-TYPE names))
        (.add defaultTargets (.-FIELD names))
        (.add defaultTargets (.-METHOD names))
        (.add defaultTargets (.-CONSTRUCTOR names))
        (.add defaultTargets (.-ANNOTATION_TYPE names))
        (.add defaultTargets (.-LOCAL_VARIABLE names))
        (.add defaultTargets (.-PARAMETER names))
        (when allowRecords (.add defaultTargets (.-RECORD_COMPONENT names)))
        (when allowModules (.add defaultTargets (.-MODULE names)))
        (set! dfltTargetMeta (cast Name/1 (.toArray defaultTargets (new Name/1 0))))))
    dfltTargetMeta)

  (method ^:public validateAnnotationDeferErrors ^boolean [this ^JCTree$JCAnnotation a]
    (let [^:mutable res false
          ^Log$DiagnosticHandler diagHandler (.new log Log$DiscardDiagnosticHandler)]
      (try
        (set! res (.validateAnnotation this a))
        (finally (.popDiagnosticHandler log diagHandler)))
      res))

  (method ^:private validateAnnotation ^boolean [this ^JCTree$JCAnnotation a]
    (let [^:mutable isValid true
          metadata (.getAnnotationTypeMetadata (.-tsym (.-type (.-annotationType a))))
          ^{:tag (Set Symbol$MethodSymbol)} elements (.getAnnotationElements metadata)]
      (for-each [^JCTree arg (.-args a)]
        (when-not (not (.hasTag arg JCTree$Tag/ASSIGN))
          (let [assign (cast JCTree$JCAssign arg)
                m (TreeInfo/symbol (.-lhs assign))]
            (when-not (or (nil? m) (.isErroneous (.-type m)))
              (when-not (.remove elements m)
                (set! isValid false)
                (.error log
                        (.pos (.-lhs assign))
                        (CompilerProperties$Errors/DuplicateAnnotationMemberValue
                          (.-name m)
                          (.-type a))))))))
      (let [^:mutable ^{:tag (List Name)} missingDefaults (List/nil)
            ^{:tag (Set Symbol$MethodSymbol)} membersWithDefault (.getAnnotationElementsWithDefault
                                                                   metadata)]
        (for-each [^Symbol$MethodSymbol m elements]
          (when-not (.isErroneous (.-type m))
            (when-not (.contains membersWithDefault m)
              (set! missingDefaults (.append missingDefaults (.-name m))))))
        (set! missingDefaults (.reverse missingDefaults))
        (when (.nonEmpty missingDefaults)
          (set! isValid false)
          (let [^JCDiagnostic$Error errorKey (if (> (.size missingDefaults) 1)
                                                 (CompilerProperties$Errors/AnnotationMissingDefaultValue1
                                                   (.-type a)
                                                   missingDefaults)
                                                 (CompilerProperties$Errors/AnnotationMissingDefaultValue
                                                   (.-type a)
                                                   missingDefaults))]
            (.error log (.pos a) errorKey)))
        (and isValid (.validateTargetAnnotationValue this a)))))

  (method validateTargetAnnotationValue ^boolean [this ^JCTree$JCAnnotation a]
    (if (or (not (identical? (.-tsym (.-type (.-annotationType a)))
                             (.-tsym (.-annotationTargetType syms))))
            (nil? (.-tail (.-args a))))
        true
        (let [^:mutable isValid true]
          (if (not (.hasTag (cast JCTree$JCExpression (.-head (.-args a))) JCTree$Tag/ASSIGN))
              false
              (let [assign (cast JCTree$JCAssign (.-head (.-args a)))
                    m (TreeInfo/symbol (.-lhs assign))]
                (if (not (identical? (.-name m) (.-value names)))
                    false
                    (let [^JCTree rhs (.-rhs assign)]
                      (if (not (.hasTag rhs JCTree$Tag/NEWARRAY))
                          false
                          (let [na (cast JCTree$JCNewArray rhs)
                                ^{:tag (Set Symbol)} targets (HashSet.)]
                            (for-each [^JCTree elem (.-elems na)]
                              (when-not (.add targets (TreeInfo/symbol elem))
                                (set! isValid false)
                                (.error log
                                        (.pos elem)
                                        CompilerProperties$Errors/RepeatedAnnotationTarget)))
                            isValid)))))))))

  (method checkDeprecatedAnnotation ^void [this ^JCDiagnostic$DiagnosticPosition pos ^Symbol s]
    (when (and (and (and (and (.isEnabled lint Lint$LintCategory/DEP_ANN)
                              (.isDeprecatableViaAnnotation s))
                         (not (== (bit-and (.flags s) Flags/DEPRECATED) 0)))
                    (not (.isErroneous (.-deprecatedType syms))))
               (nil? (.attribute s (.-tsym (.-deprecatedType syms)))))
      (.warning log pos CompilerProperties$LintWarnings/MissingDeprecatedAnnotation))
    (when (and (.isEnabled lint Lint$LintCategory/DEPRECATION)
               (not (.isDeprecatableViaAnnotation s)))
      (when (and (not (.isErroneous (.-deprecatedType syms)))
                 (some? (.attribute s (.-tsym (.-deprecatedType syms)))))
        (.warning log
                  pos
                  (CompilerProperties$LintWarnings/DeprecatedAnnotationHasNoEffect
                    (Kinds/kindName s))))))

  (method checkDeprecated ^void [this ^:final ^JCDiagnostic$DiagnosticPosition pos
                                 ^:final ^Symbol other ^:final ^Symbol s]
    (.checkDeprecated this (lambda Supplier ^JCDiagnostic$DiagnosticPosition [] pos) other s))

  (method checkDeprecated ^void [this ^{:tag (Supplier JCDiagnostic$DiagnosticPosition)} pos
                                 ^:final ^Symbol other ^:final ^Symbol s]
    (when (and (and (and (not importSuppression)
                         (or (.isDeprecatedForRemoval s)
                             (and (.isDeprecated s) (not (.isDeprecated other)))))
                    (or (not (identical? (.outermostClass s) (.outermostClass other)))
                        (nil? (.outermostClass s))))
               (not (identical? (.-kind s) Kinds$Kind/PCK)))
      (.warnDeprecated this (cast JCDiagnostic$DiagnosticPosition (.get pos)) s)))

  (method checkSunAPI ^void [this ^:final ^JCDiagnostic$DiagnosticPosition pos ^:final ^Symbol s]
    (when-not (== (bit-and (.flags s) Flags/PROPRIETARY) 0)
      (.warning log pos (CompilerProperties$Warnings/SunProprietary s))))

  (method checkProfile ^void [this ^:final ^JCDiagnostic$DiagnosticPosition pos ^:final ^Symbol s]
    (when (and (not (identical? profile Profile/DEFAULT))
               (not (== (bit-and (.flags s) Flags/NOT_IN_PROFILE) 0)))
      (.error log pos (CompilerProperties$Errors/NotInProfile s profile))))

  (method checkPreview ^void [this ^JCDiagnostic$DiagnosticPosition pos ^Symbol other ^Symbol s]
    (.checkPreview this pos other Type/noType s))

  (method checkPreview ^void [this ^JCDiagnostic$DiagnosticPosition pos ^Symbol other ^Type site
                              ^Symbol s]
    (let [^:mutable ^boolean sIsPreview false
          ^:mutable ^Symbol previewSymbol nil]
      (cond
        (not (== (bit-and (.flags s) Flags/PREVIEW_API) 0))
          (do (set! sIsPreview true) (set! previewSymbol s))
        (and (and (and (or (identical? (.-kind s) Kinds$Kind/MTH)
                           (identical? (.-kind s) Kinds$Kind/VAR))
                       (some? (.-tsym site)))
                  (== (bit-and (.flags (.-tsym site)) Flags/PREVIEW_API) 0))
             (not (== (bit-and (.flags (.-owner s)) Flags/PREVIEW_API) 0)))
          (do (set! sIsPreview true) (set! previewSymbol (.-owner s)))
        :else (do (set! sIsPreview false) (set! previewSymbol nil)))
      (when (and (and sIsPreview (not (.participatesInPreview preview syms other s)))
                 (not disablePreviewCheck))
        (if (== (bit-and (.flags previewSymbol) Flags/PREVIEW_REFLECTIVE) 0)
            (if (not (.isEnabled preview))
                (.error log pos (CompilerProperties$Errors/IsPreview s))
                (do
                  (.markUsesPreview preview pos)
                  (.warnPreviewAPI this pos (CompilerProperties$LintWarnings/IsPreview s))))
            (.warnPreviewAPI this pos (CompilerProperties$LintWarnings/IsPreviewReflective s))))
      (when (.declaredUsingPreviewFeature preview s)
        (when (.isEnabled preview)
          (.markUsesPreview preview pos)
          (.warnPreviewAPI this
                           pos
                           (CompilerProperties$LintWarnings/DeclaredUsingPreview
                             (Kinds/kindName s)
                             s))))))

  (method checkRestricted ^void [this ^JCDiagnostic$DiagnosticPosition pos ^Symbol s]
    (when (and (identical? (.-kind s) Kinds$Kind/MTH)
               (not (== (bit-and (.flags s) Flags/RESTRICTED) 0)))
      (.warning log pos (CompilerProperties$LintWarnings/RestrictedMethod (.enclClass s) s))))

  (method checkNonCyclicElements ^void [this ^JCTree$JCClassDecl tree]
    (when-not (== (bit-and (.-flags_field (.-sym tree)) Flags/ANNOTATION) 0)
      (Assert/check (== (bit-and (.-flags_field (.-sym tree)) Flags/LOCKED) 0))
      (try
        (let [o-8 (.-sym tree)]
          (set! (.-flags_field o-8) (bit-or (.-flags_field o-8) Flags/LOCKED)))
        (for-each [^JCTree def (.-defs tree)]
          (when-not (not (.hasTag def JCTree$Tag/METHODDEF))
            (let [meth (cast JCTree$JCMethodDecl def)]
              (.checkAnnotationResType this (.pos meth) (.-type (.-restype meth))))))
        (finally
          (let [o-9 (.-sym tree)]
            (set! (.-flags_field o-9) (bit-and (.-flags_field o-9) (bit-not-int Flags/LOCKED))))
          (let [o-10 (.-sym tree)]
            (set! (.-flags_field o-10) (bit-or (.-flags_field o-10) Flags/ACYCLIC_ANN)))))))

  (method checkNonCyclicElementsInternal ^void [this ^JCDiagnostic$DiagnosticPosition pos
                                                ^Symbol$TypeSymbol tsym]
    (when-not (not (== (bit-and (.-flags_field tsym) Flags/ACYCLIC_ANN) 0))
      (if (not (== (bit-and (.-flags_field tsym) Flags/LOCKED) 0))
          (.error log pos (CompilerProperties$Errors/CyclicAnnotationElement tsym))
          (try
            (set! (.-flags_field tsym) (bit-or (.-flags_field tsym) Flags/LOCKED))
            (for-each [^Symbol s (.getSymbols (.members tsym) Scope$LookupKind/NON_RECURSIVE)]
              (when-not (not (identical? (.-kind s) Kinds$Kind/MTH))
                (.checkAnnotationResType this
                                         pos
                                         (.getReturnType (.-type (cast Symbol$MethodSymbol s))))))
            (finally
              (set! (.-flags_field tsym) (bit-and (.-flags_field tsym) (bit-not-int Flags/LOCKED)))
              (set! (.-flags_field tsym) (bit-or (.-flags_field tsym) Flags/ACYCLIC_ANN)))))))

  (method checkAnnotationResType ^void [this ^JCDiagnostic$DiagnosticPosition pos ^Type type]
    (switch (.getTag type)
      CLASS
        (when-not (== (bit-and (.flags (.-tsym type)) Flags/ANNOTATION) 0)
          (.checkNonCyclicElementsInternal this pos (.-tsym type)))
      ARRAY (.checkAnnotationResType this pos (.elemtype types type))
      nil))

  (method checkCyclicConstructors ^void [this ^JCTree$JCClassDecl tree]
    (let [^{:tag (Map Symbol Symbol)} callMap (LinkedHashMap.)]
      (loop [^{:tag (List JCTree)} l (.-defs tree)]
        (if (.nonEmpty l)
            (if (not (TreeInfo/isConstructor (cast JCTree (.-head l))))
                (recur (.-tail l))
                (let [meth (cast JCTree$JCMethodDecl (.-head l))
                      app (TreeInfo/findConstructorCall meth)]
                  (if (and (some? app) (identical? (TreeInfo/name (.-meth app)) (.-_this names)))
                      (do
                        (.put callMap (.-sym meth) (TreeInfo/symbol (.-meth app)))
                        (recur (.-tail l)))
                      (do
                        (let [o-11 (.-sym meth)]
                          (set! (.-flags_field o-11) (bit-or (.-flags_field o-11) Flags/ACYCLIC)))
                        (recur (.-tail l))))))
            nil))
      (let [^:mutable ctors (new Symbol/1 0)]
        (set! ctors (cast Symbol/1 (.toArray (.keySet callMap) ctors)))
        (for-each [^Symbol caller ctors] (.checkCyclicConstructor this tree caller callMap)))))

  (method ^:private checkCyclicConstructor ^void [this ^JCTree$JCClassDecl tree ^Symbol ctor
                                                  ^{:tag (Map Symbol Symbol)} callMap]
    (when (and (some? ctor) (== (bit-and (.-flags_field ctor) Flags/ACYCLIC) 0))
      (if (not (== (bit-and (.-flags_field ctor) Flags/LOCKED) 0))
          (.error log
                  (TreeInfo/diagnosticPositionFor
                    ctor
                    tree
                    false
                    (lambda Predicate ^boolean [^JCTree t] (.hasTag t JCTree$Tag/IDENT)))
                  CompilerProperties$Errors/RecursiveCtorInvocation)
          (do
            (set! (.-flags_field ctor) (bit-or (.-flags_field ctor) Flags/LOCKED))
            (.checkCyclicConstructor this tree (cast Symbol (.remove callMap ctor)) callMap)
            (set! (.-flags_field ctor) (bit-and (.-flags_field ctor) (bit-not-int Flags/LOCKED)))))
      (set! (.-flags_field ctor) (bit-or (.-flags_field ctor) Flags/ACYCLIC))))

  (method checkSuperInitCalls ^void [this ^JCTree$JCClassDecl tree]
    (.check (SuperThisChecker.) tree))

  (defclass ^:private SuperThisChecker
    :extends TreeScanner

    (field ^:private ^:static ^:final ^int MATCH_SCAN_DEPTH 3)

    (field ^:private ^boolean constructor)

    (field ^:private ^boolean firstStatement)

    (field ^:private ^JCTree$JCReturn earlyReturn)

    (field ^:private ^Name initCall)

    (field ^:private ^int scanDepth)

    (method ^:public check ^void [this ^JCTree$JCClassDecl classDef]
      (.scan this (.-defs classDef)))

    (method ^:public visitMethodDef ^void [this ^JCTree$JCMethodDecl tree]
      (Assert/check (not constructor))
      (Assert/check (nil? earlyReturn))
      (Assert/check (nil? initCall))
      (Assert/check (== scanDepth 1))
      (set! constructor (TreeInfo/isConstructor tree))
      (try
        (when (some? (.-body tree))
          (set! firstStatement true)
          (loop [^{:tag (List JCTree$JCStatement)} l (.-stats (.-body tree))]
            (when (.nonEmpty l)
              (.scan this (cast JCTree (.-head l)))
              (set! firstStatement false)
              (recur (.-tail l)))))
        (when (and (and constructor (some? earlyReturn)) (some? initCall))
          (.error log
                  (.pos earlyReturn)
                  CompilerProperties$Errors/ReturnBeforeSuperclassInitialized))
        (finally
          (set! firstStatement false)
          (set! constructor false)
          (set! earlyReturn nil)
          (set! initCall nil))))

    (method ^:public scan ^void [this ^JCTree tree]
      (set! scanDepth (unchecked-inc-int scanDepth))
      (try (.scan super tree) (finally (set! scanDepth (unchecked-dec-int scanDepth)))))

    (method ^:public visitApply ^void [this ^JCTree$JCMethodInvocation apply]
      (loop []
        (let [methodName (TreeInfo/name (.-meth apply))]
          (when (and (not (identical? methodName (.-_super names)))
                     (not (identical? methodName (.-_this names))))
            (break))
          (when-not constructor
            (.error log (.pos apply) CompilerProperties$Errors/CallMustOnlyAppearInCtor)
            (break))
          (when-not (== scanDepth MATCH_SCAN_DEPTH)
            (.error log (.pos apply) CompilerProperties$Errors/CtorCallsNotAllowedHere)
            (break))
          (when (some? initCall)
            (.error log (.pos apply) CompilerProperties$Errors/RedundantSuperclassInit)
            (break))
          (when-not firstStatement
            (.checkSourceLevel preview (.pos apply) Source$Feature/FLEXIBLE_CONSTRUCTORS))
          (set! initCall methodName))
        (when false (recur)))
      (.visitApply super apply))

    (method ^:public visitReturn ^void [this ^JCTree$JCReturn tree]
      (when (and (and constructor (nil? initCall)) (nil? earlyReturn)) (set! earlyReturn tree))
      (.visitReturn super tree))

    (method ^:public visitClassDef ^void [this ^JCTree$JCClassDecl tree])

    (method ^:public visitLambda ^void [this ^JCTree$JCLambda tree]
      (let [constructorPrev constructor
            firstStatementPrev firstStatement
            earlyReturnPrev earlyReturn
            initCallPrev initCall
            scanDepthPrev scanDepth]
        (set! constructor false)
        (set! firstStatement false)
        (set! earlyReturn nil)
        (set! initCall nil)
        (set! scanDepth 0)
        (try
          (.visitLambda super tree)
          (finally
            (set! constructor constructorPrev)
            (set! firstStatement firstStatementPrev)
            (set! earlyReturn earlyReturnPrev)
            (set! initCall initCallPrev)
            (set! scanDepth scanDepthPrev))))))

  (method checkDivZero ^void [this ^:final ^JCDiagnostic$DiagnosticPosition pos ^Symbol operator
                              ^Type operand]
    (when (and (and (some? (.constValue operand)) (.isSubRangeOf (.getTag operand) TypeTag/LONG))
               (== (.longValue (cast Number (.constValue operand))) 0))
      (let [opc (.-opcode (cast Symbol$OperatorSymbol operator))]
        (when (or (or (or (== opc ByteCodes/idiv) (== opc ByteCodes/imod)) (== opc ByteCodes/ldiv))
                  (== opc ByteCodes/lmod))
          (.warning log pos CompilerProperties$LintWarnings/DivZero)))))

  (method checkOutOfRangeShift ^void [this ^:final ^JCDiagnostic$DiagnosticPosition pos
                                      ^Symbol operator ^Type operand]
    (when-instance [^Number shiftAmount (.constValue operand)]
      (let [^:mutable ^Type targetType nil
            ^:mutable ^int maximumShift 0]
        (switch (.-opcode (cast Symbol$OperatorSymbol operator))
          (ByteCodes/ishl ByteCodes/ishr
                          ByteCodes/iushr
                          ByteCodes/ishll
                          ByteCodes/ishrl
                          ByteCodes/iushrl)
            (do (set! targetType (.-intType syms)) (set! maximumShift 0x1f))
          (ByteCodes/lshl ByteCodes/lshr
                          ByteCodes/lushr
                          ByteCodes/lshll
                          ByteCodes/lshrl
                          ByteCodes/lushrl)
            (do (set! targetType (.-longType syms)) (set! maximumShift 0x3f))
          (return))
        (let [specifiedShift (.longValue shiftAmount)]
          (when (or (> specifiedShift maximumShift)
                    (< specifiedShift (unchecked-negate-int maximumShift)))
            (let [actualShift (bit-and-int (unchecked-int specifiedShift)
                                           (unchecked-subtract-int maximumShift 1))]
              (.warning log
                        pos
                        (CompilerProperties$LintWarnings/BitShiftOutOfRange
                          targetType
                          specifiedShift
                          actualShift))))))))

  (method checkLossOfPrecision ^void [this ^:final ^JCDiagnostic$DiagnosticPosition pos ^Type found
                                      ^Type req]
    (when (and (and (.isNumeric found) (.isNumeric req)) (not (.isAssignable types found req)))
      (.warning log pos (CompilerProperties$LintWarnings/PossibleLossOfPrecision found req))))

  (method checkEmptyIf ^void [this ^JCTree$JCIf tree]
    (when (and (.hasTag (.-thenpart tree) JCTree$Tag/SKIP) (nil? (.-elsepart tree)))
      (.warning log (.pos (.-thenpart tree)) CompilerProperties$LintWarnings/EmptyIf)))

  (method checkUnique ^boolean [this ^JCDiagnostic$DiagnosticPosition pos ^Symbol sym ^Scope s]
    (cond
      (.isErroneous (.-type sym)) true
      (identical? (.-name (.-owner sym)) (.-any names)) false
      :else
        (do
          (for-each [^Symbol byName (.getSymbolsByName
                                      s
                                      (.-name sym)
                                      Scope$LookupKind/NON_RECURSIVE)]
            (when (and (and (and (and (not (identical? sym byName))
                                      (== (bit-and (.flags byName) Flags/CLASH) 0))
                                 (identical? (.-kind sym) (.-kind byName)))
                            (not (identical? (.-name sym) (.-error names))))
                       (or (or (not (identical? (.-kind sym) Kinds$Kind/MTH))
                               (.hasSameArgs types (.-type sym) (.-type byName)))
                           (.hasSameArgs types
                                         (.erasure types (.-type sym))
                                         (.erasure types (.-type byName)))))
              (cond
                (not (== (bit-and (.flags sym) Flags/VARARGS)
                         (bit-and (.flags byName) Flags/VARARGS)))
                  (do
                    (set! (.-flags_field sym) (bit-or (.-flags_field sym) Flags/CLASH))
                    (.varargsDuplicateError this pos sym byName)
                    (return true))
                (and (identical? (.-kind sym) Kinds$Kind/MTH)
                     (not (.hasSameArgs types (.-type sym) (.-type byName) false)))
                  (do
                    (.duplicateErasureError this pos sym byName)
                    (set! (.-flags_field sym) (bit-or (.-flags_field sym) Flags/CLASH))
                    (return true))
                (and (and (not (== (bit-and (.flags sym) Flags/MATCH_BINDING) 0))
                          (not (== (bit-and (.flags byName) Flags/MATCH_BINDING) 0)))
                     (== (bit-and (.flags byName) Flags/MATCH_BINDING_TO_OUTER) 0))
                  (do
                    (when-not (.isErroneous (.-type sym))
                      (.error log pos CompilerProperties$Errors/MatchBindingExists)
                      (set! (.-flags_field sym) (bit-or (.-flags_field sym) Flags/CLASH)))
                    (return false))
                :else (do (.duplicateError this pos byName) (return false)))))
          true)))

  (method duplicateErasureError ^void [this ^JCDiagnostic$DiagnosticPosition pos ^Symbol sym1
                                       ^Symbol sym2]
    (when (and (not (.isErroneous (.-type sym1))) (not (.isErroneous (.-type sym2))))
      (.error log pos (CompilerProperties$Errors/NameClashSameErasure sym1 sym2))))

  (method checkImportsUnique ^void [this ^JCTree$JCCompilationUnit toplevel]
    (let [ordinallyImportedSoFar (Scope$WriteableScope/create (.-packge toplevel))
          staticallyImportedSoFar (Scope$WriteableScope/create (.-packge toplevel))
          topLevelScope (.-toplevelScope toplevel)]
      (for-each [^JCTree def (.-defs toplevel)]
        (when-not (not (.hasTag def JCTree$Tag/IMPORT))
          (let [imp (cast JCTree$JCImport def)]
            (when (some? (.-importScope imp))
              (for-each [^Symbol sym (.getSymbols
                                       (.-importScope imp)
                                       (lambda Predicate ^boolean [^Symbol sym]
                                         (identical? (.-kind sym) Kinds$Kind/TYP)))]
                (if (.isStatic imp)
                    (do
                      (.checkUniqueImport this
                                          (.pos imp)
                                          ordinallyImportedSoFar
                                          staticallyImportedSoFar
                                          topLevelScope
                                          sym
                                          true)
                      (.enter staticallyImportedSoFar sym))
                    (do
                      (.checkUniqueImport this
                                          (.pos imp)
                                          ordinallyImportedSoFar
                                          staticallyImportedSoFar
                                          topLevelScope
                                          sym
                                          false)
                      (.enter ordinallyImportedSoFar sym))))
              (set! (.-importScope imp) nil)))))))

  (method ^:private checkUniqueImport ^boolean [this ^JCDiagnostic$DiagnosticPosition pos
                                                ^Scope ordinallyImportedSoFar
                                                ^Scope staticallyImportedSoFar ^Scope topLevelScope
                                                ^Symbol sym ^boolean staticImport]
    (let [^{:tag (Predicate Symbol)} duplicates (lambda Predicate ^boolean [^Symbol candidate]
                                                  (and
                                                    (not (identical? candidate sym))
                                                    (not (.isErroneous (.-type candidate)))))
          ordinaryClashing (.findFirst ordinallyImportedSoFar (.-name sym) duplicates)
          ^:mutable ^Symbol staticClashing nil]
      (when (and (nil? ordinaryClashing) (not staticImport))
        (set! staticClashing (.findFirst staticallyImportedSoFar (.-name sym) duplicates)))
      (if (or (some? ordinaryClashing) (some? staticClashing))
          (do
            (if (some? ordinaryClashing)
                (.error log
                        pos
                        (CompilerProperties$Errors/AlreadyDefinedSingleImport ordinaryClashing))
                (.error log
                        pos
                        (CompilerProperties$Errors/AlreadyDefinedStaticSingleImport staticClashing)))
            false)
          (let [clashing (.findFirst topLevelScope (.-name sym) duplicates)]
            (if (some? clashing)
                (do
                  (.error log pos (CompilerProperties$Errors/AlreadyDefinedThisUnit clashing))
                  false)
                true)))))

  (method ^:public checkCanonical ^void [this ^JCTree tree]
    (when-not (.isCanonical this tree)
      (.error log
              (.pos tree)
              (CompilerProperties$Errors/ImportRequiresCanonical (TreeInfo/symbol tree)))))

  (method ^:private isCanonical ^boolean [this ^:mutable ^JCTree tree]
    (while (.hasTag tree JCTree$Tag/SELECT)
      (let [s (cast JCTree$JCFieldAccess tree)]
        (when-not (identical? (.getQualifiedName (.-owner (.-sym s)))
                              (.getQualifiedName (TreeInfo/symbol (.-selected s))))
          (return false))
        (set! tree (.-selected s))))
    true)

  (method checkForBadAuxiliaryClassAccess ^void [this ^JCDiagnostic$DiagnosticPosition pos
                                                 ^{:tag (Env AttrContext)} env ^Symbol$ClassSymbol c]
    (when (and (and (not (== (bit-and (.flags c) Flags/AUXILIARY) 0)) (.isAccessible rs env c))
               (not (.isSameFile fileManager (.-sourcefile c) (.-sourcefile (.-toplevel env)))))
      (.warning log
                pos
                (CompilerProperties$LintWarnings/AuxiliaryClassAccessedFromOutsideOfItsSourceFile
                  c
                  (.-sourcefile c)))))

  (method checkDefaultConstructor ^void [this ^Symbol$ClassSymbol c
                                         ^JCDiagnostic$DiagnosticPosition pos]
    (when (and (and (and (and (.isEnabled lint Lint$LintCategory/MISSING_EXPLICIT_CTOR)
                              (== (bit-and (.flags c) (bit-or Flags/ENUM Flags/RECORD)) 0))
                         (not (.isAnonymous c)))
                    (not (== (bit-and (.flags c) (bit-or-int Flags/PUBLIC Flags/PROTECTED)) 0)))
               (.allowedInSource Source$Feature/MODULES source))
      (let [nestingKind (.getNestingKind c)]
        (switch nestingKind
          (ANONYMOUS LOCAL) (return)
          TOP_LEVEL nil
          MEMBER
            (let [^:mutable owner (.-owner c)]
              (while (and (some? owner) (identical? (.-kind owner) Kinds$Kind/TYP))
                (when (== (bit-and (.flags owner) (bit-or-int Flags/PUBLIC Flags/PROTECTED)) 0)
                  (return))
                (set! owner (.-owner owner)))))
        (let [pkg (.packge c)]
          (when-not (.isUnnamed pkg)
            (let [modle (.-modle pkg)]
              (for-each [^Directive$ExportsDirective exportDir (.-exports modle)]
                (when (.equals (.-packge exportDir) pkg)
                  (if (or (nil? (.-modules exportDir)) (.isEmpty (.-modules exportDir)))
                      (.warning log
                                pos
                                (CompilerProperties$LintWarnings/MissingExplicitCtor c pkg modle))
                      (return))))))))))

  (defclass ^:private ConversionWarner
    :extends Warner

    (field ^:final ^String uncheckedKey)

    (field ^:final ^Type found)

    (field ^:final ^Type expected)

    (constructor ^:public [this ^JCDiagnostic$DiagnosticPosition pos ^String uncheckedKey
                           ^Type found ^Type expected]
      (super. pos)
      (set! (.-uncheckedKey this) uncheckedKey)
      (set! (.-found this) found)
      (set! (.-expected this) expected))

    (method ^:public warn ^void [this ^Lint$LintCategory lint]
      (let [warned (.-warned this)]
        (.warn super lint)
        (when-not warned
          (switch lint
            UNCHECKED
              (.warnUnchecked Check/this
                              (.pos this)
                              (CompilerProperties$LintWarnings/ProbFoundReq
                                (.fragment diags uncheckedKey (new Object/1 []))
                                found
                                expected))
            VARARGS
              (when (and (and (and (some? method)
                                   (some? (.attribute method (.-tsym (.-trustMeType syms)))))
                              (.isTrustMeAllowedOnMethod Check/this method))
                         (not (.isReifiable
                                types
                                (cast Type (.last (.getParameterTypes (.-type method)))))))
                (.warning log
                          (.pos this)
                          (CompilerProperties$LintWarnings/VarargsUnsafeUseVarargsParam
                            (cast Symbol (.last (.-params method))))))
            (throw (AssertionError. (java-str "Unexpected lint: " lint))))))))

  (method ^:public castWarner ^Warner [this ^JCDiagnostic$DiagnosticPosition pos ^Type found
                                       ^Type expected]
    (ConversionWarner. pos "unchecked.cast.to.type" found expected))

  (method ^:public convertWarner ^Warner [this ^JCDiagnostic$DiagnosticPosition pos ^Type found
                                          ^Type expected]
    (ConversionWarner. pos "unchecked.assign" found expected))

  (method ^:public checkFunctionalInterface ^void [this ^JCTree$JCClassDecl tree
                                                   ^Symbol$ClassSymbol cs]
    (let [functionalType (.attribute cs (.-tsym (.-functionalInterfaceType syms)))]
      (when (some? functionalType)
        (try
          (.findDescriptorSymbol types ^Symbol$TypeSymbol cs)
          (catch Types$FunctionDescriptorLookupError ex
            (let [^:mutable pos (.pos tree)]
              (for-each [^JCTree$JCAnnotation a (.-annotations (.getModifiers tree))]
                (when (identical? (.-tsym (.-type (.-annotationType a)))
                                  (.-tsym (.-functionalInterfaceType syms)))
                  (set! pos (.pos a))
                  (break)))
              (.error log
                      pos
                      (CompilerProperties$Errors/BadFunctionalIntfAnno1 (.getDiagnostic ex)))))))))

  (method ^:public checkImportsResolvable ^void [this ^:final ^JCTree$JCCompilationUnit toplevel]
    (for-each [^JCTree$JCImportBase impBase (.getImports toplevel)]
      (when-instance [^JCTree$JCImport imp impBase]
        (when-not (or (not (.-staticImport imp)) (not (.hasTag (.-qualid imp) JCTree$Tag/SELECT)))
          (let [select (.-qualid imp)
                ^:mutable ^Symbol origin nil]
            (when-not (or (or (identical? (.-name select) (.-asterisk names))
                              (nil? (set! origin (TreeInfo/symbol (.-selected select)))))
                          (not (identical? (.-kind origin) Kinds$Kind/TYP)))
              (let [site (cast Symbol$TypeSymbol (TreeInfo/symbol (.-selected select)))]
                (when-not (.checkTypeContainsImportableElement
                            this
                            site
                            site
                            (.-packge toplevel)
                            (.-name select)
                            (HashSet.))
                  (.error log
                          (.pos imp)
                          (CompilerProperties$Errors/CantResolveLocation
                            Kinds$KindName/STATIC
                            (.-name select)
                            nil
                            nil
                            (CompilerProperties$Fragments/Location (Kinds/kindName site) site nil)))))))))))

  (method ^:public checkImportedPackagesObservable ^void [this
                                                          ^:final ^JCTree$JCCompilationUnit toplevel]
    (for-each [^JCTree$JCImportBase impBase (.getImports toplevel)]
      (when-instance [^JCTree$JCImport imp impBase]
        (when-not (.-staticImport imp)
          (when (identical? (TreeInfo/name (.-qualid imp)) (.-asterisk names))
            (let [tsym (.-tsym (.-type (.-selected (.-qualid imp))))]
              (when (and (and (identical? (.-kind tsym) Kinds$Kind/PCK) (.isEmpty (.members tsym)))
                         (not (and (.allowedInSource
                                     Source$Feature/IMPORT_ON_DEMAND_OBSERVABLE_PACKAGES
                                     source)
                                   (.exists tsym))))
                (.error log
                        JCDiagnostic$DiagnosticFlag/RESOLVE_ERROR
                        (.pos (.-selected (.-qualid imp)))
                        (CompilerProperties$Errors/DoesntExist tsym)))))))))

  (method ^:private checkTypeContainsImportableElement ^boolean [this ^Symbol$TypeSymbol tsym
                                                                 ^Symbol$TypeSymbol origin
                                                                 ^Symbol$PackageSymbol packge
                                                                 ^Name name
                                                                 ^{:tag (Set Symbol)} processed]
    (cond
      (or (nil? tsym) (not (.add processed tsym))) false
      (.checkTypeContainsImportableElement this
                                           (.-tsym (.supertype types (.-type tsym)))
                                           origin
                                           packge
                                           name
                                           processed)
        true
      :else
        (do
          (for-each [^Type t (.interfaces types (.-type tsym))]
            (when (.checkTypeContainsImportableElement this (.-tsym t) origin packge name processed)
              (return true)))
          (for-each [^Symbol sym (.getSymbolsByName (.members tsym) name)]
            (when (and (and (.isStatic sym) (.importAccessible this sym packge))
                       (.isMemberOf sym origin types))
              (return true)))
          false)))

  (method ^:public importAccessible ^boolean [this ^Symbol sym ^Symbol$PackageSymbol packge]
    (try
      (let [flags (unchecked-int (bit-and (.flags sym) Flags/AccessFlags))]
        (switch flags
          Flags/PRIVATE false
          (0 Flags/PROTECTED) (identical? (.packge sym) packge)
          true))
      (catch ClassFinder$BadClassFile err (throw err))
      (catch Symbol$CompletionFailure ex false)))

  (method ^:public checkLeaksNotAccessible ^void [this ^{:tag (Env AttrContext)} env
                                                  ^JCTree$JCClassDecl check]
    (let [toplevel (.-toplevel env)]
      (when-not (or (or (identical? (.-modle toplevel) (.-unnamedModule syms))
                        (identical? (.-modle toplevel) (.-noModule syms)))
                    (not (== (bit-and (.flags (.-sym check)) Flags/COMPOUND) 0)))
        (let [currentExport (.findExport this (.-packge toplevel))]
          (when-not (or (nil? currentExport) (some? (.-modules currentExport)))
            (.scan (anon TreeScanner []
                     (field ^Lint lint (.-lint (cast AttrContext (.-info env))))

                     (field ^boolean inSuperType)

                     (method ^:public visitBlock ^void [this ^JCTree$JCBlock tree])

                     (method ^:public visitMethodDef ^void [this ^JCTree$JCMethodDecl tree]
                       (when-not (not (.isAPISymbol Check/this (.-sym tree)))
                         (let [prevLint lint]
                           (try
                             (set! lint (.augment lint (.-sym tree)))
                             (when (.isEnabled lint Lint$LintCategory/EXPORTS)
                               (.visitMethodDef super tree))
                             (finally (set! lint prevLint))))))

                     (method ^:public visitVarDef ^void [this ^JCTree$JCVariableDecl tree]
                       (when-not (and (not (.isAPISymbol Check/this (.-sym tree)))
                                      (not (identical?
                                             (.-kind (.-owner (.-sym tree)))
                                             Kinds$Kind/MTH)))
                         (let [prevLint lint]
                           (try
                             (set! lint (.augment lint (.-sym tree)))
                             (when (.isEnabled lint Lint$LintCategory/EXPORTS)
                               (.scan this (.-mods tree))
                               (.scan this (.-vartype tree)))
                             (finally (set! lint prevLint))))))

                     (method ^:public visitClassDef ^void [this ^JCTree$JCClassDecl tree]
                       (when-not (not (identical? tree check))
                         (when-not (not (.isAPISymbol Check/this (.-sym tree)))
                           (let [prevLint lint]
                             (try
                               (set! lint (.augment lint (.-sym tree)))
                               (when (.isEnabled lint Lint$LintCategory/EXPORTS)
                                 (.scan this (.-mods tree))
                                 (.scan this (.-typarams tree))
                                 (try
                                   (set! inSuperType true)
                                   (.scan this (.-extending tree))
                                   (.scan this (.-implementing tree))
                                   (finally (set! inSuperType false)))
                                 (.scan this (.-defs tree)))
                               (finally (set! lint prevLint)))))))

                     (method ^:public visitTypeApply ^void [this ^JCTree$JCTypeApply tree]
                       (.scan this (.-clazz tree))
                       (let [oldInSuperType inSuperType]
                         (try
                           (set! inSuperType false)
                           (.scan this (.-arguments tree))
                           (finally (set! inSuperType oldInSuperType)))))

                     (method ^:public visitIdent ^void [this ^JCTree$JCIdent tree]
                       (let [sym (TreeInfo/symbol tree)]
                         (when (and (identical? (.-kind sym) Kinds$Kind/TYP)
                                    (not (.hasTag (.-type sym) TypeTag/TYPEVAR)))
                           (.checkVisible Check/this
                                          (.pos tree)
                                          sym
                                          (.-packge toplevel)
                                          inSuperType))))

                     (method ^:public visitSelect ^void [this ^JCTree$JCFieldAccess tree]
                       (let [sym (TreeInfo/symbol tree)
                             sitesym (TreeInfo/symbol (.-selected tree))]
                         (if (and (identical? (.-kind sym) Kinds$Kind/TYP)
                                  (identical? (.-kind sitesym) Kinds$Kind/PCK))
                             (.checkVisible Check/this
                                            (.pos tree)
                                            sym
                                            (.-packge toplevel)
                                            inSuperType)
                             (.visitSelect super tree))))

                     (method ^:public visitAnnotation ^void [this ^JCTree$JCAnnotation tree]
                       (when (some?
                               (.getAnnotation (.-tsym (.-type (.-attribute tree))) Documented))
                         (.visitAnnotation super tree))))
                   check))))))

  (method ^:private findExport ^Directive$ExportsDirective [this ^Symbol$PackageSymbol pack]
    (for-each [^Directive$ExportsDirective d (.-exports (.-modle pack))]
      (when (identical? (.-packge d) pack) (return d)))
    nil)

  (method ^:private isAPISymbol ^boolean [this ^:mutable ^Symbol sym]
    (while (not (identical? (.-kind sym) Kinds$Kind/PCK))
      (when (and (== (bit-and (.flags sym) Flags/PUBLIC) 0)
                 (== (bit-and (.flags sym) Flags/PROTECTED) 0))
        (return false))
      (set! sym (.-owner sym)))
    true)

  (method ^:private checkVisible ^void [this ^JCDiagnostic$DiagnosticPosition pos ^Symbol what
                                        ^Symbol$PackageSymbol inPackage ^boolean inSuperType]
    (if (and (not (.isAPISymbol this what)) (not inSuperType))
        (.warning log
                  pos
                  (CompilerProperties$LintWarnings/LeaksNotAccessible
                    (Kinds/kindName what)
                    what
                    (.-modle (.packge what))))
        (let [whatPackage (.packge what)
              whatExport (.findExport this whatPackage)
              inExport (.findExport this inPackage)]
          (if (nil? whatExport)
              (.warning log
                        pos
                        (CompilerProperties$LintWarnings/LeaksNotAccessibleUnexported
                          (Kinds/kindName what)
                          what
                          (.-modle (.packge what))))
              (do
                (when (some? (.-modules whatExport))
                  (when (or (nil? (.-modules inExport))
                            (not (.containsAll (.-modules whatExport) (.-modules inExport))))
                    (.warning log
                              pos
                              (CompilerProperties$LintWarnings/LeaksNotAccessibleUnexportedQualified
                                (Kinds/kindName what)
                                what
                                (.-modle (.packge what))))))
                (when (and (not (identical? (.-modle whatPackage) (.-modle inPackage)))
                           (not (identical? (.-modle whatPackage) (.-java_base syms))))
                  (let [^:mutable ^{:tag (List Symbol$ModuleSymbol)} todo (List/of
                                                                            (.-modle inPackage))]
                    (while (.nonEmpty todo)
                      (let [current (cast Symbol$ModuleSymbol (.-head todo))]
                        (set! todo (.-tail todo))
                        (when (identical? current (.-modle whatPackage)) (return))
                        (when-not (not (== (bit-and (.flags current) Flags/AUTOMATIC_MODULE) 0))
                          (for-each [^Directive$RequiresDirective req (.-requires current)]
                            (when (.isTransitive req) (set! todo (.prepend todo (.-module req))))))))
                    (.warning
                      log
                      pos
                      (CompilerProperties$LintWarnings/LeaksNotAccessibleNotRequiredTransitive
                        (Kinds/kindName what)
                        what
                        (.-modle (.packge what)))))))))))

  (method checkModuleExists ^void [this ^:final ^JCDiagnostic$DiagnosticPosition pos
                                   ^Symbol$ModuleSymbol msym]
    (when-not (identical? (.-kind msym) Kinds$Kind/MDL)
      (.warning log pos (CompilerProperties$LintWarnings/ModuleNotFound msym))))

  (method checkPackageExistsForOpens ^void [this ^:final ^JCDiagnostic$DiagnosticPosition pos
                                            ^Symbol$PackageSymbol packge]
    (when (and (.isEmpty (.members packge)) (== (bit-and (.flags packge) Flags/HAS_RESOURCE) 0))
      (.warning log pos (CompilerProperties$LintWarnings/PackageEmptyOrNotFound packge))))

  (method checkModuleRequires ^void [this ^:final ^JCDiagnostic$DiagnosticPosition pos
                                     ^:final ^Directive$RequiresDirective rd]
    (when-not (== (bit-and (.flags (.-module rd)) Flags/AUTOMATIC_MODULE) 0)
      (if (.isTransitive rd)
          (.warning log pos CompilerProperties$LintWarnings/RequiresTransitiveAutomatic)
          (.warning log pos CompilerProperties$LintWarnings/RequiresAutomatic))))

  (method checkSwitchCaseStructure ^void [this ^{:tag (List JCTree$JCCase)} cases]
    (loop [^{:tag (List JCTree$JCCase)} l cases]
      (when (.nonEmpty l)
        (let [c (cast JCTree$JCCase (.-head l))]
          (if-instance [^JCTree$JCConstantCaseLabel constLabel (.-head (.-labels c))]
            (if (TreeInfo/isNull (.-expr constLabel))
                (if (.nonEmpty (.-tail (.-labels c)))
                    (if-instance [^JCTree$JCDefaultCaseLabel defLabel (.-head (.-tail (.-labels c)))]
                      (if (.nonEmpty (.-tail (.-tail (.-labels c))))
                          (do
                            (.error log
                                    (.pos (cast JCTree$JCCaseLabel
                                                (.-head (.-tail (.-tail (.-labels c))))))
                                    CompilerProperties$Errors/InvalidCaseLabelCombination)
                            (recur (.-tail l)))
                          (recur (.-tail l)))
                      (do
                        (.error log
                                (.pos (cast JCTree$JCCaseLabel (.-head (.-tail (.-labels c)))))
                                CompilerProperties$Errors/InvalidCaseLabelCombination)
                        (recur (.-tail l))))
                    (recur (.-tail l)))
                (do
                  (for-each [^JCTree$JCCaseLabel label (.-tail (.-labels c))]
                    (when (or (not (instance? JCTree$JCConstantCaseLabel label))
                              (TreeInfo/isNullCaseLabel label))
                      (.error log
                              (.pos label)
                              CompilerProperties$Errors/InvalidCaseLabelCombination)
                      (break)))
                  (recur (.-tail l))))
            (if (.nonEmpty (.-tail (.-labels c)))
                (let [patterCaseLabels (.map
                                         (.filter
                                           (.stream (.-labels c))
                                           (lambda Predicate ^boolean [^JCTree$JCCaseLabel ll]
                                             (instance? JCTree$JCPatternCaseLabel ll)))
                                         (lambda Function ^JCTree$JCPatternCaseLabel [^JCTree$JCCaseLabel cl]
                                           (cast JCTree$JCPatternCaseLabel cl)))
                      allUnderscore (.allMatch
                                      patterCaseLabels
                                      (lambda Predicate ^boolean [^JCTree$JCPatternCaseLabel pcl]
                                        (not (.hasBindings this (.getPattern pcl)))))]
                  (when-not allUnderscore
                    (.error log
                            (.pos (cast JCTree$JCCaseLabel (.-head (.-tail (.-labels c)))))
                            CompilerProperties$Errors/FlowsThroughFromPattern))
                  (let [allPatternCaseLabels (.allMatch
                                               (.stream (.-labels c))
                                               (lambda Predicate ^boolean [^JCTree$JCCaseLabel p]
                                                 (instance? JCTree$JCPatternCaseLabel p)))]
                    (when allPatternCaseLabels
                      (.checkSourceLevel preview
                                         (.pos (cast
                                                 JCTree$JCCaseLabel
                                                 (.-head (.-tail (.-labels c)))))
                                         Source$Feature/UNNAMED_VARIABLES))
                    (for-each [^JCTree$JCCaseLabel label (.-tail (.-labels c))]
                      (when (instance? JCTree$JCConstantCaseLabel label)
                        (.error log
                                (.pos label)
                                CompilerProperties$Errors/InvalidCaseLabelCombination)
                        (break)))
                    (recur (.-tail l))))
                (recur (.-tail l)))))))
    (let [isCaseStatementGroup (and (.nonEmpty cases)
                                    (identical? (.-caseKind (cast JCTree$JCCase (.-head cases)))
                                                CaseTree$CaseKind/STATEMENT))]
      (when isCaseStatementGroup
        (let [^:mutable previousCompletessNormally false]
          (loop [^{:tag (List JCTree$JCCase)} l cases]
            (when (.nonEmpty l)
              (let [c (cast JCTree$JCCase (.-head l))]
                (cond
                  (and previousCompletessNormally (.nonEmpty (.-stats c)))
                    (if-instance [^JCTree$JCPatternCaseLabel patternLabel (.-head (.-labels c))]
                      (cond
                        (or (.hasBindings this (.-pat patternLabel))
                            (.hasBindings this (.-guard c)))
                          (.error log
                                  (.pos (cast JCTree$JCCaseLabel (.-head (.-labels c))))
                                  CompilerProperties$Errors/FlowsThroughToPattern)
                        (.isEmpty (.-stats c))
                          (when-instance [^JCTree$JCPatternCaseLabel patternLabel (.-head
                                                                                    (.-labels c))]
                            (when (or (.hasBindings this (.-pat patternLabel))
                                      (.hasBindings this (.-guard c)))
                              (when (.hasStatements this (.-tail l))
                                (.error log
                                        (.pos (cast JCTree$JCCaseLabel (.-head (.-labels c))))
                                        CompilerProperties$Errors/FlowsThroughFromPattern)))))
                      (when (.isEmpty (.-stats c))
                        (when-instance [^JCTree$JCPatternCaseLabel patternLabel (.-head
                                                                                  (.-labels c))]
                          (when (or (.hasBindings this (.-pat patternLabel))
                                    (.hasBindings this (.-guard c)))
                            (when (.hasStatements this (.-tail l))
                              (.error log
                                      (.pos (cast JCTree$JCCaseLabel (.-head (.-labels c))))
                                      CompilerProperties$Errors/FlowsThroughFromPattern))))))
                  (.isEmpty (.-stats c))
                    (when-instance [^JCTree$JCPatternCaseLabel patternLabel (.-head (.-labels c))]
                      (when (or (.hasBindings this (.-pat patternLabel))
                                (.hasBindings this (.-guard c)))
                        (when (.hasStatements this (.-tail l))
                          (.error log
                                  (.pos (cast JCTree$JCCaseLabel (.-head (.-labels c))))
                                  CompilerProperties$Errors/FlowsThroughFromPattern)))))
                (set! previousCompletessNormally (.-completesNormally c))
                (recur (.-tail l)))))))))

  (method hasBindings ^boolean [this ^JCTree p]
    (let [bindings (new boolean/1 1)]
      (.scan (anon TreeScanner []
               (method ^:public visitBindingPattern ^void [this ^JCTree$JCBindingPattern tree]
                 (aset bindings
                       0
                       (let [a-12 (aget bindings 0)
                             b-13 (not (.isUnnamedVariable (.-sym (.-var tree))))]
                         (or a-12 b-13)))
                 (.visitBindingPattern super tree)))
             p)
      (aget bindings 0)))

  (method hasStatements ^boolean [this ^{:tag (List JCTree$JCCase)} cases]
    (loop [^{:tag (List JCTree$JCCase)} l cases]
      (if (.nonEmpty l)
          (if (.nonEmpty (.-stats (cast JCTree$JCCase (.-head l))))
              (return true)
              (recur (.-tail l)))
          nil))
    false)

  (method checkSwitchCaseLabelDominated ^void [this ^JCTree$JCCaseLabel unconditionalCaseLabel
                                               ^{:tag (List JCTree$JCCase)} cases]
    (let [^:mutable ^{:tag (List (Pair JCTree$JCCase JCTree$JCCaseLabel))} caseLabels (List/nil)
          ^:mutable seenDefault false
          ^:mutable seenDefaultLabel false
          ^:mutable warnDominatedByDefault false
          unconditionalFound false]
      (loop [^{:tag (List JCTree$JCCase)} l cases]
        (when (.nonEmpty l)
          (let [c (cast JCTree$JCCase (.-head l))]
            (for-each [^JCTree$JCCaseLabel label (.-labels c)]
              (cond
                (.hasTag label JCTree$Tag/DEFAULTCASELABEL)
                  (do
                    (set! seenDefault true)
                    (set! seenDefaultLabel
                          (let [a-14 seenDefaultLabel
                                b-15 (TreeInfo/isNullCaseLabel
                                       (cast JCTree$JCCaseLabel (.-head (.-labels c))))]
                            (or a-14 b-15))))
                (TreeInfo/isNullCaseLabel label)
                  (when seenDefault
                    (.error log (.pos label) CompilerProperties$Errors/PatternDominated))
                :else
                  (do
                    (when (and seenDefault (not warnDominatedByDefault))
                      (when (or (.hasTag label JCTree$Tag/PATTERNCASELABEL)
                                (and (instance? JCTree$JCConstantCaseLabel label) seenDefaultLabel))
                        (.error log (.pos label) CompilerProperties$Errors/PatternDominated)
                        (set! warnDominatedByDefault true)))
                    (let [currentType (.labelType this label)]
                      (for-each [^{:tag (Pair JCTree$JCCase JCTree$JCCaseLabel)} caseAndLabel
                                   caseLabels]
                        (let [testCase (cast JCTree$JCCase (.-fst caseAndLabel))
                              testCaseLabel (cast JCTree$JCCaseLabel (.-snd caseAndLabel))
                              testType (.labelType this testCaseLabel)]
                          (if (and (and allowPrimitivePatterns
                                        (identical? unconditionalCaseLabel testCaseLabel))
                                   (not (identical? unconditionalCaseLabel label)))
                              (.error log (.pos label) CompilerProperties$Errors/PatternDominated)
                              (let [^:mutable dominated false]
                                (when (and (not (.hasTag currentType TypeTag/ERROR))
                                           (not (.hasTag testType TypeTag/ERROR)))
                                  (if (and (.isUnconditionallyExactCombined
                                             types
                                             currentType
                                             testType)
                                           (instance? JCTree$JCConstantCaseLabel label))
                                      (set!
                                        dominated
                                        (and (not
                                               (instance? JCTree$JCConstantCaseLabel testCaseLabel))
                                             (TreeInfo/unguardedCase testCase)))
                                      (when-instance [^JCTree$JCPatternCaseLabel patternCL label]
                                        (when-instance [^JCTree$JCPatternCaseLabel testPatternCaseLabel
                                                          testCaseLabel]
                                          (when (or
                                                  (.equals testCase c)
                                                  (TreeInfo/unguardedCase testCase))
                                            (set!
                                              dominated
                                              (.patternDominated
                                                this
                                                (.-pat testPatternCaseLabel)
                                                (.-pat patternCL))))))))
                                (when dominated
                                  (.error log
                                          (.pos label)
                                          CompilerProperties$Errors/PatternDominated))))))
                      (set! caseLabels (.prepend caseLabels (Pair/of c label)))))))
            (recur (.-tail l)))))))

  (method ^:private labelType ^Type [this ^JCTree$JCCaseLabel label]
    (.erasure types
              ^Type (switch (.getTag label)
                      PATTERNCASELABEL (.-type (.-pat (cast JCTree$JCPatternCaseLabel label)))
                      CONSTANTCASELABEL (.-type (.-expr (cast JCTree$JCConstantCaseLabel label)))
                      (throw (Assert/error (java-str "Unexpected tree kind: " (.getTag label)))))))

  (method ^:private patternDominated ^boolean [this ^JCTree$JCPattern existingPattern
                                               ^JCTree$JCPattern currentPattern]
    (let [existingPatternType (.erasure types (.-type existingPattern))
          currentPatternType (.erasure types (.-type currentPattern))]
      (cond
        (not (.isUnconditionallyExactTypeBased types currentPatternType existingPatternType)) false
        (or (instance? JCTree$JCBindingPattern currentPattern)
            (instance? JCTree$JCAnyPattern currentPattern))
          (or (instance? JCTree$JCBindingPattern existingPattern)
              (instance? JCTree$JCAnyPattern existingPattern))
        :else
          (do
            (if-instance [^JCTree$JCRecordPattern currentRecordPattern currentPattern]
              (if (or (instance? JCTree$JCBindingPattern existingPattern)
                      (instance? JCTree$JCAnyPattern existingPattern))
                  (return true)
                  (if-instance [^JCTree$JCRecordPattern existingRecordPattern existingPattern]
                    (let [^:mutable ^{:tag (List JCTree$JCPattern)} existingNested (.-nested
                                                                                     existingRecordPattern)
                          ^:mutable ^{:tag (List JCTree$JCPattern)} currentNested (.-nested
                                                                                    currentRecordPattern)]
                      (when-not (== (.size existingNested) (.size currentNested)) (return false))
                      (while (.nonEmpty existingNested)
                        (when-not (.patternDominated
                                    this
                                    (cast JCTree$JCPattern (.-head existingNested))
                                    (cast JCTree$JCPattern (.-head currentNested)))
                          (return false))
                        (set! existingNested (.-tail existingNested))
                        (set! currentNested (.-tail currentNested)))
                      (return true))
                    (Assert/error (java-str "Unknown pattern: " (.getTag existingPattern)))))
              (Assert/error (java-str "Unknown pattern: " (.getTag currentPattern))))
            false))))

  (method isExternalizable ^boolean [this ^Type t]
    (try (.complete (.-externalizableType syms)) (catch Symbol$CompletionFailure e (return false)))
    (.isSubtype types t (.-externalizableType syms)))

  (method ^:public checkSerialStructure ^void [this ^JCTree$JCClassDecl tree ^Symbol$ClassSymbol c]
    (.visit (SerialTypeVisitor.) c tree))

  (defclass ^:private SerialTypeVisitor
    :extends (ElementKindVisitor14 Void JCTree$JCClassDecl)

    (constructor [this] (set! (.-lint this) (.-lint Check/this)))

    (field ^:private ^:static ^:final ^{:tag (Set String)} serialMethodNames
      (Set/of "writeObject" "writeReplace" "readObject" "readObjectNoData" "readResolve"))

    (field ^:private ^:static ^:final ^{:tag (Set String)} serialFieldNames
      (Set/of "serialVersionUID" "serialPersistentFields"))

    (field ^:private ^:final ^Type OSF_TYPE
      (Type$ArrayType. (.-objectStreamFieldType syms) (.-arrayClass syms)))

    (field ^Lint lint)

    (method ^:public defaultAction ^Void [this ^Element e ^JCTree$JCClassDecl p]
      (throw
        (IllegalArgumentException. (cast String (Objects/requireNonNullElse (.toString e) "")))))

    (method ^:public visitType ^Void [this ^TypeElement e ^JCTree$JCClassDecl p]
      (.runUnderLint this
                     e
                     p
                     (lambda BiConsumer ^void [^TypeElement symbol ^JCTree$JCClassDecl param]
                       (.visitType super symbol param)))
      nil)

    (method ^:public visitTypeAsClass ^Void [this ^TypeElement e ^JCTree$JCClassDecl p]
      (let [c (cast Symbol$ClassSymbol e)]
        (.checkCtorAccess this p c)
        (let [^:mutable ^Symbol$VarSymbol svuidSym nil]
          (for-each [^Symbol sym (.getSymbolsByName (.members c) (.-serialVersionUID names))]
            (when (identical? (.-kind sym) Kinds$Kind/VAR)
              (set! svuidSym (cast Symbol$VarSymbol sym))
              (break)))
          (when (nil? svuidSym)
            (.warning log (.pos p) (CompilerProperties$LintWarnings/MissingSVUID c)))
          (let [serialPersistentFieldsPresent (.hasNext
                                                (.iterator
                                                  (.getSymbolsByName
                                                    (.members c)
                                                    (.-serialPersistentFields names)
                                                    (lambda Predicate ^boolean [^Symbol sym]
                                                      (identical? (.-kind sym) Kinds$Kind/VAR)))))]
            (for-each [^Symbol el (.getEnclosedElements c)]
              (.runUnderLint
                this
                el
                p
                (lambda BiConsumer ^void [^Symbol enclosed ^JCTree$JCClassDecl tree]
                  (let [^:mutable ^String name nil]
                    (switch (.getKind enclosed)
                      FIELD
                        (do
                          (when-not serialPersistentFieldsPresent
                            (let [flags (.flags enclosed)]
                              (when (and (== (bit-and flags Flags/TRANSIENT) 0)
                                         (== (bit-and flags Flags/STATIC) 0))
                                (let [varType (.asType enclosed)]
                                  (cond
                                    (not (.canBeSerialized this varType))
                                      (.warning
                                        log
                                        (TreeInfo/diagnosticPositionFor enclosed tree)
                                        CompilerProperties$LintWarnings/NonSerializableInstanceField)
                                    (.hasTag varType TypeTag/ARRAY)
                                      (let [^:mutable arrayType (cast Type$ArrayType varType)
                                            ^:mutable elementType (.-elemtype arrayType)]
                                        (while (.hasTag elementType TypeTag/ARRAY)
                                          (set! arrayType (cast Type$ArrayType elementType))
                                          (set! elementType (.-elemtype arrayType)))
                                        (when-not (.canBeSerialized this elementType)
                                          (.warning
                                            log
                                            (TreeInfo/diagnosticPositionFor enclosed tree)
                                            (CompilerProperties$LintWarnings/NonSerializableInstanceFieldArray
                                              elementType)))))))))
                          (set! name (.toString (.getSimpleName enclosed)))
                          (when (.contains serialFieldNames name)
                            (let [field (cast Symbol$VarSymbol enclosed)]
                              (switch name
                                "serialVersionUID" (.checkSerialVersionUID this tree e field)
                                "serialPersistentFields"
                                  (.checkSerialPersistentFields this tree e field)
                                (throw (AssertionError.))))))
                      METHOD
                        (let [method (cast Symbol$MethodSymbol enclosed)]
                          (set! name (.toString (.getSimpleName method)))
                          (when (.contains serialMethodNames name)
                            (switch name
                              "writeObject" (.checkWriteObject this tree e method)
                              "writeReplace" (.checkWriteReplace this tree e method)
                              "readObject" (.checkReadObject this tree e method)
                              "readObjectNoData" (.checkReadObjectNoData this tree e method)
                              "readResolve" (.checkReadResolve this tree e method)
                              (throw (AssertionError.))))))))))
            nil))))

    (method canBeSerialized ^boolean [this ^Type type]
      (or (.isPrimitive type) (.isSerializable rs type)))

    (method ^:private checkCtorAccess ^void [this ^JCTree$JCClassDecl tree ^Symbol$ClassSymbol c]
      (if (.isExternalizable Check/this (.-type c))
          (do
            (for-each [^Symbol sym (.getEnclosedElements c)]
              (when (and (.isConstructor sym) (== (bit-and (.flags sym) Flags/PUBLIC) Flags/PUBLIC))
                (when (.isEmpty (.getParameters (cast Symbol$MethodSymbol sym))) (return))))
            (.warning log
                      (.pos tree)
                      CompilerProperties$LintWarnings/ExternalizableMissingPublicNoArgCtor))
          (let [^:mutable superClass (.getSuperclass c)]
            (while (.isSerializable rs superClass)
              (try
                (set! superClass
                      (cast Type
                            (.getSuperclass
                              (cast TypeElement (.asElement (cast DeclaredType superClass))))))
                (catch ClassCastException cce (return))))
            (try
              (let [supertype (cast Symbol$ClassSymbol (.asElement (cast DeclaredType superClass)))]
                (for-each [^Symbol sym (.getEnclosedElements supertype)]
                  (when (.isConstructor sym)
                    (let [ctor (cast Symbol$MethodSymbol sym)]
                      (when (.isEmpty (.getParameters ctor))
                        (when (or (== (bit-and (.flags ctor) Flags/PRIVATE) Flags/PRIVATE)
                                  (and (identical? (.getNestingKind supertype) NestingKind/MEMBER)
                                       (== (bit-and (.flags supertype) Flags/STATIC) 0)))
                          (.warning
                            log
                            (.pos tree)
                            (CompilerProperties$LintWarnings/SerializableMissingAccessNoArgCtor
                              (.getQualifiedName supertype)))))))))
              (catch ClassCastException cce (return))))))

    (method ^:private checkSerialVersionUID ^void [this ^JCTree$JCClassDecl tree ^Element e
                                                   ^Symbol$VarSymbol svuid]
      (when-not (== (bit-and (.flags svuid) (bit-or-int Flags/STATIC Flags/FINAL))
                    (bit-or-int Flags/STATIC Flags/FINAL))
        (.warning log
                  (TreeInfo/diagnosticPositionFor svuid tree)
                  (CompilerProperties$LintWarnings/ImproperSVUID (cast Symbol e))))
      (when-not (.hasTag (.-type svuid) TypeTag/LONG)
        (.warning log
                  (TreeInfo/diagnosticPositionFor svuid tree)
                  (CompilerProperties$LintWarnings/LongSVUID (cast Symbol e))))
      (when (nil? (.getConstValue svuid))
        (.warning log
                  (TreeInfo/diagnosticPositionFor svuid tree)
                  (CompilerProperties$LintWarnings/ConstantSVUID (cast Symbol e)))))

    (method ^:private checkSerialPersistentFields ^void [this ^JCTree$JCClassDecl tree ^Element e
                                                         ^Symbol$VarSymbol spf]
      (when-not (== (bit-and (.flags spf)
                             (bit-or-int (bit-or-int Flags/PRIVATE Flags/STATIC) Flags/FINAL))
                    (bit-or-int (bit-or-int Flags/PRIVATE Flags/STATIC) Flags/FINAL))
        (.warning log
                  (TreeInfo/diagnosticPositionFor spf tree)
                  CompilerProperties$LintWarnings/ImproperSPF))
      (when-not (.isSameType types (.-type spf) OSF_TYPE)
        (.warning log
                  (TreeInfo/diagnosticPositionFor spf tree)
                  CompilerProperties$LintWarnings/OSFArraySPF))
      (when (.isExternalizable Check/this (cast Type (.asType e)))
        (.warning log
                  (TreeInfo/diagnosticPositionFor spf tree)
                  CompilerProperties$LintWarnings/IneffectualSerialFieldExternalizable))
      (let [spfDecl (TreeInfo/declarationFor spf tree)]
        (when (and (some? spfDecl) (identical? (.getTag spfDecl) JCTree$Tag/VARDEF))
          (let [variableDef (cast JCTree$JCVariableDecl spfDecl)
                initExpr (.-init variableDef)]
            (when (and (some? initExpr) (TreeInfo/isNull initExpr))
              (.warning log (.pos initExpr) CompilerProperties$LintWarnings/SPFNullInit))))))

    (method ^:private checkWriteObject ^void [this ^JCTree$JCClassDecl tree ^Element e
                                              ^Symbol$MethodSymbol method]
      (.checkPrivateNonStaticMethod this tree method)
      (.checkReturnType this tree e method (.-voidType syms))
      (.checkOneArg this tree e method (.-objectOutputStreamType syms))
      (.checkExceptions this tree e method (.-ioExceptionType syms))
      (.checkExternalizable this tree e method))

    (method ^:private checkWriteReplace ^void [this ^JCTree$JCClassDecl tree ^Element e
                                               ^Symbol$MethodSymbol method]
      (.checkConcreteInstanceMethod this tree e method)
      (.checkReturnType this tree e method (.-objectType syms))
      (.checkNoArgs this tree e method)
      (.checkExceptions this tree e method (.-objectStreamExceptionType syms)))

    (method ^:private checkReadObject ^void [this ^JCTree$JCClassDecl tree ^Element e
                                             ^Symbol$MethodSymbol method]
      (.checkPrivateNonStaticMethod this tree method)
      (.checkReturnType this tree e method (.-voidType syms))
      (.checkOneArg this tree e method (.-objectInputStreamType syms))
      (.checkExceptions this
                        tree
                        e
                        method
                        (.-ioExceptionType syms)
                        (.-classNotFoundExceptionType syms))
      (.checkExternalizable this tree e method))

    (method ^:private checkReadObjectNoData ^void [this ^JCTree$JCClassDecl tree ^Element e
                                                   ^Symbol$MethodSymbol method]
      (.checkPrivateNonStaticMethod this tree method)
      (.checkReturnType this tree e method (.-voidType syms))
      (.checkNoArgs this tree e method)
      (.checkExceptions this tree e method (.-objectStreamExceptionType syms))
      (.checkExternalizable this tree e method))

    (method ^:private checkReadResolve ^void [this ^JCTree$JCClassDecl tree ^Element e
                                              ^Symbol$MethodSymbol method]
      (.checkConcreteInstanceMethod this tree e method)
      (.checkReturnType this tree e method (.-objectType syms))
      (.checkNoArgs this tree e method)
      (.checkExceptions this tree e method (.-objectStreamExceptionType syms)))

    (method ^:private checkWriteExternalRecord ^void [this ^JCTree$JCClassDecl tree ^Element e
                                                      ^Symbol$MethodSymbol method ^boolean isExtern]
      (.checkExternMethodRecord this tree e method (.-objectOutputType syms) isExtern))

    (method ^:private checkReadExternalRecord ^void [this ^JCTree$JCClassDecl tree ^Element e
                                                     ^Symbol$MethodSymbol method ^boolean isExtern]
      (.checkExternMethodRecord this tree e method (.-objectInputType syms) isExtern))

    (method ^:private checkExternMethodRecord ^void [this ^JCTree$JCClassDecl tree ^Element e
                                                     ^Symbol$MethodSymbol method ^Type argType
                                                     ^boolean isExtern]
      (when (and isExtern (.isExternMethod this tree e method argType))
        (.warning log
                  (TreeInfo/diagnosticPositionFor method tree)
                  (CompilerProperties$LintWarnings/IneffectualExternalizableMethodRecord
                    (.toString (.getSimpleName method))))))

    (method checkPrivateNonStaticMethod ^void [this ^JCTree$JCClassDecl tree
                                               ^Symbol$MethodSymbol method]
      (let [flags (.flags method)]
        (when (== (bit-and flags Flags/PRIVATE) 0)
          (.warning
            log
            (TreeInfo/diagnosticPositionFor method tree)
            (CompilerProperties$LintWarnings/SerialMethodNotPrivate (.getSimpleName method))))
        (when-not (== (bit-and flags Flags/STATIC) 0)
          (.warning log
                    (TreeInfo/diagnosticPositionFor method tree)
                    (CompilerProperties$LintWarnings/SerialMethodStatic (.getSimpleName method))))))

    (method ^:public visitTypeAsEnum ^Void [this ^TypeElement e ^JCTree$JCClassDecl p]
      (let [isExtern (.isExternalizable Check/this (cast Type (.asType e)))]
        (for-each [^Element el (.getEnclosedElements e)]
          (.runUnderLint this
                         el
                         p
                         (lambda BiConsumer ^void [^Element enclosed ^JCTree$JCClassDecl tree]
                           (let [name (.toString (.getSimpleName enclosed))]
                             (switch (.getKind enclosed)
                               FIELD
                                 (let [field (cast Symbol$VarSymbol enclosed)]
                                   (when (.contains serialFieldNames name)
                                     (.warning
                                       log
                                       (TreeInfo/diagnosticPositionFor field tree)
                                       (CompilerProperties$LintWarnings/IneffectualSerialFieldEnum
                                         name))))
                               METHOD
                                 (let [method (cast Symbol$MethodSymbol enclosed)]
                                   (when (.contains serialMethodNames name)
                                     (.warning
                                       log
                                       (TreeInfo/diagnosticPositionFor method tree)
                                       (CompilerProperties$LintWarnings/IneffectualSerialMethodEnum
                                         name)))
                                   (when isExtern
                                     (switch name
                                       "writeExternal" (.checkWriteExternalEnum this tree e method)
                                       "readExternal" (.checkReadExternalEnum this tree e method))))
                               ENUM_CONSTANT
                                 (let [field (cast Symbol$VarSymbol enclosed)
                                       decl (cast
                                              JCTree$JCVariableDecl
                                              (TreeInfo/declarationFor field p))]
                                   (when-instance [^JCTree$JCNewClass nc (.-init decl)]
                                     (when (some? (.-def nc))
                                       (let [enumConstantType (.-sym (.-def nc))]
                                         (.visitTypeAsEnum this enumConstantType p))))))))))
        nil))

    (method ^:private checkWriteExternalEnum ^void [this ^JCTree$JCClassDecl tree ^Element e
                                                    ^Symbol$MethodSymbol method]
      (.checkExternMethodEnum this tree e method (.-objectOutputType syms)))

    (method ^:private checkReadExternalEnum ^void [this ^JCTree$JCClassDecl tree ^Element e
                                                   ^Symbol$MethodSymbol method]
      (.checkExternMethodEnum this tree e method (.-objectInputType syms)))

    (method ^:private checkExternMethodEnum ^void [this ^JCTree$JCClassDecl tree ^Element e
                                                   ^Symbol$MethodSymbol method ^Type argType]
      (when (.isExternMethod this tree e method argType)
        (.warning log
                  (TreeInfo/diagnosticPositionFor method tree)
                  (CompilerProperties$LintWarnings/IneffectualExternMethodEnum
                    (.toString (.getSimpleName method))))))

    (method ^:private isExternMethod ^boolean [this ^JCTree$JCClassDecl tree ^Element e
                                               ^Symbol$MethodSymbol method ^Type argType]
      (let [flags (.flags method)
            rtype (.getReturnType method)]
        (and (and (and (not (== (bit-and flags Flags/PUBLIC) 0))
                       (== (bit-and flags Flags/STATIC) 0))
                  (.isSameType types (.-voidType syms) rtype))
             (.hasExactlyOneArgWithType this tree e method argType))))

    (method ^:public visitTypeAsInterface ^Void [this ^TypeElement e ^JCTree$JCClassDecl p]
      (for-each [^Element el (.getEnclosedElements e)]
        (.runUnderLint
          this
          el
          p
          (lambda BiConsumer ^void [^Element enclosed ^JCTree$JCClassDecl tree]
            (let [^:mutable ^String name nil]
              (switch (.getKind enclosed)
                FIELD
                  (let [field (cast Symbol$VarSymbol enclosed)]
                    (set! name (.toString (.getSimpleName field)))
                    (switch name
                      "serialPersistentFields"
                        (.warning log
                                  (TreeInfo/diagnosticPositionFor field tree)
                                  CompilerProperties$LintWarnings/IneffectualSerialFieldInterface)
                      "serialVersionUID" (.checkSerialVersionUID this tree e field)))
                METHOD
                  (let [method (cast Symbol$MethodSymbol enclosed)]
                    (set! name (.toString (.getSimpleName enclosed)))
                    (when (.contains serialMethodNames name)
                      (switch name
                        ("readObject" "readObjectNoData" "writeObject")
                          (.checkPrivateMethod this tree e method)
                        ("writeReplace" "readResolve") (.checkDefaultIneffective this tree e method)
                        (throw (AssertionError.))))))))))
      nil)

    (method ^:private checkPrivateMethod ^void [this ^JCTree$JCClassDecl tree ^Element e
                                                ^Symbol$MethodSymbol method]
      (when (== (bit-and (.flags method) Flags/PRIVATE) 0)
        (.warning log
                  (TreeInfo/diagnosticPositionFor method tree)
                  CompilerProperties$LintWarnings/NonPrivateMethodWeakerAccess)))

    (method ^:private checkDefaultIneffective ^void [this ^JCTree$JCClassDecl tree ^Element e
                                                     ^Symbol$MethodSymbol method]
      (when (== (bit-and (.flags method) Flags/DEFAULT) Flags/DEFAULT)
        (.warning log
                  (TreeInfo/diagnosticPositionFor method tree)
                  CompilerProperties$LintWarnings/DefaultIneffective)))

    (method ^:public visitTypeAsAnnotationType ^Void [this ^TypeElement e ^JCTree$JCClassDecl p]
      nil)

    (method ^:public visitTypeAsRecord ^Void [this ^TypeElement e ^JCTree$JCClassDecl p]
      (let [isExtern (.isExternalizable Check/this (cast Type (.asType e)))]
        (for-each [^Element el (.getEnclosedElements e)]
          (.runUnderLint
            this
            el
            p
            (lambda BiConsumer ^void [^Element enclosed ^JCTree$JCClassDecl tree]
              (let [name (.toString (.getSimpleName enclosed))]
                (switch (.getKind enclosed)
                  FIELD
                    (let [field (cast Symbol$VarSymbol enclosed)]
                      (switch name
                        "serialPersistentFields"
                          (.warning log
                                    (TreeInfo/diagnosticPositionFor field tree)
                                    CompilerProperties$LintWarnings/IneffectualSerialFieldRecord)
                        "serialVersionUID" (.checkSerialVersionUID this tree e field)))
                  METHOD
                    (let [method (cast Symbol$MethodSymbol enclosed)]
                      (switch name
                        "writeReplace" (.checkWriteReplace this tree e method)
                        "readResolve" (.checkReadResolve this tree e method)
                        "writeExternal" (.checkWriteExternalRecord this tree e method isExtern)
                        "readExternal" (.checkReadExternalRecord this tree e method isExtern)
                        (when (.contains serialMethodNames name)
                          (.warning log
                                    (TreeInfo/diagnosticPositionFor method tree)
                                    (CompilerProperties$LintWarnings/IneffectualSerialMethodRecord
                                      name))))))))))
        nil))

    (method checkConcreteInstanceMethod ^void [this ^JCTree$JCClassDecl tree ^Element enclosing
                                               ^Symbol$MethodSymbol method]
      (when-not (== (bit-and (.flags method) (bit-or-int Flags/STATIC Flags/ABSTRACT)) 0)
        (.warning log
                  (TreeInfo/diagnosticPositionFor method tree)
                  (CompilerProperties$LintWarnings/SerialConcreteInstanceMethod
                    (.getSimpleName method)))))

    (method ^:private checkReturnType ^void [this ^JCTree$JCClassDecl tree ^Element enclosing
                                             ^Symbol$MethodSymbol method ^Type expectedReturnType]
      (let [rtype (.getReturnType method)]
        (when-not (.isSameType types expectedReturnType rtype)
          (.warning log
                    (TreeInfo/diagnosticPositionFor method tree)
                    (CompilerProperties$LintWarnings/SerialMethodUnexpectedReturnType
                      (.getSimpleName method)
                      rtype
                      expectedReturnType)))))

    (method ^:private checkOneArg ^void [this ^JCTree$JCClassDecl tree ^Element enclosing
                                         ^Symbol$MethodSymbol method ^Type expectedType]
      (let [name (.toString (.getSimpleName method))
            parameters (.getParameters method)]
        (if (not (== (.size parameters) 1))
            (.warning log
                      (TreeInfo/diagnosticPositionFor method tree)
                      (CompilerProperties$LintWarnings/SerialMethodOneArg
                        (.getSimpleName method)
                        (.size parameters)))
            (let [parameterType (.asType (cast Symbol$VarSymbol (.get parameters 0)))]
              (when-not (.isSameType types parameterType expectedType)
                (.warning log
                          (TreeInfo/diagnosticPositionFor method tree)
                          (CompilerProperties$LintWarnings/SerialMethodParameterType
                            (.getSimpleName method)
                            expectedType
                            parameterType)))))))

    (method ^:private hasExactlyOneArgWithType ^boolean [this ^JCTree$JCClassDecl tree
                                                         ^Element enclosing
                                                         ^Symbol$MethodSymbol method
                                                         ^Type expectedType]
      (let [parameters (.getParameters method)]
        (and (== (.size parameters) 1)
             (.isSameType types (.asType (cast Symbol$VarSymbol (.get parameters 0))) expectedType))))

    (method ^:private checkNoArgs ^void [this ^JCTree$JCClassDecl tree ^Element enclosing
                                         ^Symbol$MethodSymbol method]
      (let [parameters (.getParameters method)]
        (when-not (.isEmpty parameters)
          (.warning log
                    (TreeInfo/diagnosticPositionFor (cast Symbol (.get parameters 0)) tree)
                    (CompilerProperties$LintWarnings/SerialMethodNoArgs (.getSimpleName method))))))

    (method ^:private checkExternalizable ^void [this ^JCTree$JCClassDecl tree ^Element enclosing
                                                 ^Symbol$MethodSymbol method]
      (when (.isExternalizable Check/this (cast Type (.asType enclosing)))
        (.warning log
                  (TreeInfo/diagnosticPositionFor method tree)
                  (CompilerProperties$LintWarnings/IneffectualSerialMethodExternalizable
                    (.getSimpleName method)))))

    (method ^:private checkExceptions ^void [this ^JCTree$JCClassDecl tree ^Element enclosing
                                             ^Symbol$MethodSymbol method &
                                             ^Type/1 declaredExceptions]
      (for-each [^Type thrownType (.getThrownTypes method)]
        (when-not (or (.isSubtype types thrownType (.-runtimeExceptionType syms))
                      (.isSubtype types thrownType (.-errorType syms)))
          (let [^:mutable declared false]
            (for-each [^Type declaredException declaredExceptions]
              (when (.isSubtype types thrownType declaredException) (set! declared true)))
            (when-not declared
              (.warning log
                        (TreeInfo/diagnosticPositionFor method tree)
                        (CompilerProperties$LintWarnings/SerialMethodUnexpectedException
                          (.getSimpleName method)
                          thrownType)))))))

    (method ^:private runUnderLint :type-params [(E extends Element)] ^Void [this ^E symbol
                                                                             ^JCTree$JCClassDecl p
                                                                             ^{:tag (BiConsumer E JCTree$JCClassDecl)} task]
      (let [prevLint lint]
        (try
          (set! lint (.augment lint (cast Symbol symbol)))
          (when (.isEnabled lint Lint$LintCategory/SERIAL) (.accept task symbol p))
          nil
          (finally (set! lint prevLint))))))

  (method checkRequiresIdentity ^void [this ^JCTree tree ^Lint lint]
    (switch tree
      [^JCTree$JCClassDecl classDecl]
        (let [st (.supertype types (.-type (.-sym classDecl)))]
          (when (and (and (some? st) (not (identical? (.-tsym st) (.-tsym (.-objectType syms)))))
                     (some? (.-extending classDecl)))
            (.checkIfIdentityIsExpected this (.pos (.-extending classDecl)) st lint))
          (for-each [^JCTree$JCExpression intrface (.-implementing classDecl)]
            (.checkIfIdentityIsExpected this (.pos intrface) (.-type intrface) lint))
          (for-each [^JCTree$JCTypeParameter tp (.-typarams classDecl)]
            (.checkIfIdentityIsExpected this (.pos tp) (.-type tp) lint)))
      [^JCTree$JCVariableDecl variableDecl]
        (when (or (and (some? (.-vartype variableDecl))
                       (== (bit-and (.-flags_field (.-sym variableDecl)) Flags/RECORD) 0))
                  (not (== (bit-and (.-flags_field (.-sym variableDecl))
                                    (bit-not (bit-or
                                               (bit-or Flags/PARAMETER Flags/RECORD)
                                               Flags/GENERATED_MEMBER)))
                           0)))
          (.checkIfIdentityIsExpected this
                                      (.pos (.-vartype variableDecl))
                                      (.-type (.-vartype variableDecl))
                                      lint))
      [^JCTree$JCTypeCast typeCast]
        (.checkIfIdentityIsExpected this (.pos (.-clazz typeCast)) (.-type (.-clazz typeCast)) lint)
      [^JCTree$JCBindingPattern bindingPattern]
        (when (some? (.-vartype (.-var bindingPattern)))
          (.checkIfIdentityIsExpected this
                                      (.pos (.-vartype (.-var bindingPattern)))
                                      (.-type (.-vartype (.-var bindingPattern)))
                                      lint))
      [^JCTree$JCMethodDecl methodDecl]
        (do
          (for-each [^JCTree$JCTypeParameter tp (.-typarams methodDecl)]
            (.checkIfIdentityIsExpected this (.pos tp) (.-type tp) lint))
          (when (and (some? (.-restype methodDecl))
                     (not (.hasTag (.-type (.-restype methodDecl)) TypeTag/VOID)))
            (.checkIfIdentityIsExpected this
                                        (.pos (.-restype methodDecl))
                                        (.-type (.-restype methodDecl))
                                        lint)))
      [^JCTree$JCMemberReference mref]
        (do
          (.checkIfIdentityIsExpected this (.pos (.-expr mref)) (.-target mref) lint)
          (.checkIfTypeParamsRequiresIdentity this
                                              (.getMetadata (.-sym mref))
                                              (.-typeargs mref)
                                              lint))
      [^JCTree$JCPolyExpression poly
       :when
       (or (instance? JCTree$JCNewClass poly) (instance? JCTree$JCMethodInvocation poly))]
        (do
          (when-instance [^JCTree$JCNewClass newClass poly]
            (.checkIfIdentityIsExpected this
                                        (.pos (.-clazz newClass))
                                        (.-type (.-clazz newClass))
                                        lint))
          (let [^:mutable ^{:tag (List JCTree$JCExpression)} argExps (if (instance?
                                                                           JCTree$JCNewClass
                                                                           poly)
                                                                         (.-args
                                                                           (cast
                                                                             JCTree$JCNewClass
                                                                             poly))
                                                                         (.-args
                                                                           (cast
                                                                             JCTree$JCMethodInvocation
                                                                             poly)))
                msym (TreeInfo/symbolFor poly)]
            (when (some? msym)
              (when-not (.isEmpty argExps)
                (when-instance [^Symbol$MethodSymbol ms msym]
                  (when (some? (.-params ms))
                    (let [^:mutable lastParam (cast Symbol$VarSymbol (.-head (.-params ms)))]
                      (for-each [^Symbol$VarSymbol param (.-params ms)]
                        (when (and (not (== (bit-and (.-flags_field param) Flags/REQUIRES_IDENTITY)
                                            0))
                                   (.isValueBased
                                     (.-type (cast JCTree$JCExpression (.-head argExps)))))
                          (.warning
                            log
                            (.pos (cast JCTree$JCExpression (.-head argExps)))
                            CompilerProperties$LintWarnings/AttemptToUseValueBasedWhereIdentityExpected))
                        (set! lastParam param)
                        (set! argExps (.-tail argExps)))
                      (while (and (and (some? argExps) (not (.isEmpty argExps))) (some? lastParam))
                        (when (and (not (== (bit-and
                                              (.-flags_field lastParam)
                                              Flags/REQUIRES_IDENTITY)
                                            0))
                                   (.isValueBased
                                     (.-type (cast JCTree$JCExpression (.-head argExps)))))
                          (.warning
                            log
                            (.pos (cast JCTree$JCExpression (.-head argExps)))
                            CompilerProperties$LintWarnings/AttemptToUseValueBasedWhereIdentityExpected))
                        (set! argExps (.-tail argExps)))))))
              (.checkIfTypeParamsRequiresIdentity
                this
                (.getMetadata msym)
                ^List (if (instance? JCTree$JCNewClass poly)
                          (.-typeargs (cast JCTree$JCNewClass poly))
                          (.-typeargs (cast JCTree$JCMethodInvocation poly)))
                lint))))
      (throw (AssertionError. (java-str "unexpected tree " tree)))))

  (method ^:private checkIfIdentityIsExpected ^boolean [this ^JCDiagnostic$DiagnosticPosition pos
                                                        ^Type t ^Lint lint]
    (when (and (and (some? t) (some? lint)) (.isEnabled lint Lint$LintCategory/IDENTITY))
      (let [requiresIdentityVisitor (RequiresIdentityVisitor.)]
        (.visit requiresIdentityVisitor t (HashSet.))
        (when (.-requiresWarning requiresIdentityVisitor)
          (.warning log
                    pos
                    CompilerProperties$LintWarnings/AttemptToUseValueBasedWhereIdentityExpected)
          (return true))))
    false)

  (defclass ^:private RequiresIdentityVisitor
    :extends (Types$SimpleVisitor Void (Set Type))

    (field ^boolean requiresWarning false)

    (method ^:public visitType ^Void [this ^Type t ^{:tag (Set Type)} seen]
      nil)

    (method ^:public visitWildcardType ^Void [this ^Type$WildcardType t ^{:tag (Set Type)} seen]
      (cast Void (.visit this (.-type t) seen)))

    (method ^:public visitTypeVar ^Void [this ^Type$TypeVar t ^{:tag (Set Type)} seen]
      (when (.add seen t) (.visit this (.getUpperBound t) seen))
      nil)

    (method ^:public visitCapturedType ^Void [this ^Type$CapturedType t ^{:tag (Set Type)} seen]
      (when (.add seen t)
        (.visit this (.getUpperBound t) seen)
        (.visit this (.getLowerBound t) seen))
      nil)

    (method ^:public visitArrayType ^Void [this ^Type$ArrayType t ^{:tag (Set Type)} seen]
      (cast Void (.visit this (.-elemtype t) seen)))

    (method ^:public visitClassType ^Void [this ^Type$ClassType t ^{:tag (Set Type)} seen]
      (when (and (some? t) (some? (.-tsym t)))
        (let [sm (.getMetadata (.-tsym t))]
          (when (and (some? sm) (not (.isEmpty (.getTypeArguments t))))
            (when (.isPresent (.findAny (.filter
                                          (.stream (.getTypeAttributes sm))
                                          (lambda Predicate ^boolean [^Attribute$TypeCompound ta]
                                            (and
                                              (and
                                                (.isRequiresIdentityAnnotation
                                                  Check/this
                                                  (.-tsym (.-type ta)))
                                                (some?
                                                  (.get
                                                    (.getTypeArguments t)
                                                    (.-parameter_index (.-position ta)))))
                                              (.isValueBased
                                                (cast
                                                  Type
                                                  (.get
                                                    (.getTypeArguments t)
                                                    (.-parameter_index (.-position ta))))))))))
              (set! requiresWarning true)
              (return nil)))))
      (.visit this (.getEnclosingType t) seen)
      (for-each [^Type targ (.getTypeArguments t)] (.visit this targ seen))
      nil))

  (method ^:private checkIfTypeParamsRequiresIdentity ^void [this ^SymbolMetadata sm
                                                             ^{:tag (List JCTree$JCExpression)} typeParamTrees
                                                             ^Lint lint]
    (when (and (some? typeParamTrees) (not (.isEmpty typeParamTrees)))
      (for-each [^JCTree$JCExpression targ typeParamTrees]
        (.checkIfIdentityIsExpected this (.pos targ) (.-type targ) lint))
      (when (some? sm)
        (.forEach (.filter (.stream (.getTypeAttributes sm))
                           (lambda Predicate ^boolean [^Attribute$TypeCompound ta]
                             (and (and (.isRequiresIdentityAnnotation this (.-tsym (.-type ta)))
                                       (some? (.-type
                                                (cast
                                                  JCTree$JCExpression
                                                  (.get
                                                    typeParamTrees
                                                    (.-parameter_index (.-position ta)))))))
                                  (.isValueBased
                                    (.-type (cast
                                              JCTree$JCExpression
                                              (.get
                                                typeParamTrees
                                                (.-parameter_index (.-position ta)))))))))
                  (lambda Consumer ^void [^Attribute$TypeCompound ta]
                    (.warning
                      log
                      (.pos (cast JCTree$JCExpression
                                  (.get typeParamTrees (.-parameter_index (.-position ta)))))
                      CompilerProperties$LintWarnings/AttemptToUseValueBasedWhereIdentityExpected))))))

  (method ^:private isRequiresIdentityAnnotation ^boolean [this ^Symbol$TypeSymbol annoType]
    (or
      (identical? annoType (.-tsym (.-requiresIdentityType syms)))
      (identical? (.flatName annoType) (.flatName (.-tsym (.-requiresIdentityInternalType syms)))))))

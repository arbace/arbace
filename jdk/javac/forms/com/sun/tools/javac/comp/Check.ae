                (.pos tree)
                (CompilerProperties$LintWarnings/RedundantCast (.-type (.-clazz tree))))))

  (method ^:private is292targetTypeCast ^boolean [this ^JCTree$JCTypeCast tree]
    (let [^:mutable is292targetTypeCast false
          expr (TreeInfo/skipParens (.-expr tree))]
      (when (.hasTag expr JCTree$Tag/APPLY)
        (let [apply (cast JCTree$JCMethodInvocation expr)
              sym (TreeInfo/symbol (.-meth apply))]
          (set! is292targetTypeCast
                (and (and (some? sym) (identical? (.-kind sym) Kinds$Kind/MTH))
                     (not (== (bit-and (.flags sym) Flags/HYPOTHETICAL) 0))))))
      is292targetTypeCast))

  (field ^:private ^:static ^:final ^boolean ignoreAnnotatedCasts true)

  (method ^:private checkExtends ^boolean [this ^:mutable ^Type a ^Type bound]
    (cond
      (.isUnbound a) true
      (not (.hasTag a TypeTag/WILDCARD))
        (do (set! a (.cvarUpperBound types a)) (.isSubtype types a bound))
      (.isExtendsBound a) (.isCastable types bound (.wildUpperBound types a) (.-noWarnings types))
      (.isSuperBound a) (not (.notSoftSubtype types (.wildLowerBound types a) bound))
      :else true))


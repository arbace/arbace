  (method checkType ^Type [this ^:final ^JCDiagnostic$DiagnosticPosition pos ^:final ^Type found
                           ^:final ^Type req ^:final ^CheckContext checkContext]
    (let [inferenceContext (.inferenceContext checkContext)]
      (when (or (.free inferenceContext req) (.free inferenceContext found))
        (.addFreeTypeListener inferenceContext
                              (List/of req found)
                              (lambda Infer$FreeTypeListener ^void [^InferenceContext solvedContext]
                                (.checkType this
                                            pos
                                            (.asInstType solvedContext found)
                                            (.asInstType solvedContext req)
                                            checkContext))))
      (cond
        (.hasTag req TypeTag/ERROR) req
        (.hasTag req TypeTag/NONE) found
        (.compatible checkContext found req (.checkWarner checkContext pos found req)) found
        (and (.isNumeric found) (.isNumeric req))
          (do
            (.report checkContext
                     pos
                     (.fragment diags
                                (CompilerProperties$Fragments/PossibleLossOfPrecision found req)))
            (.createErrorType types found))
        :else
          (do
            (.report checkContext
                     pos
                     (.fragment diags (CompilerProperties$Fragments/InconvertibleTypes found req)))
            (.createErrorType types found)))))


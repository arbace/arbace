          (.createErrorType types found))))

  (method ^:public checkRedundantCast ^void [this ^{:tag (Env AttrContext)} env
                                             ^:final ^JCTree$JCTypeCast tree]
    (when (and (and (and (not (.isErroneous (.-type tree)))
                         (.isSameType types (.-type (.-expr tree)) (.-type (.-clazz tree))))

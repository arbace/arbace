    (if (.hasTag t TypeTag/VOID)
        (do
          (.error log pos CompilerProperties$Errors/VoidNotAllowedHere)
          (.createErrorType types t))
        t))

  (method checkClassOrArrayType ^Type [this ^JCDiagnostic$DiagnosticPosition pos ^Type t]
    (if (and (and (not (.hasTag t TypeTag/CLASS)) (not (.hasTag t TypeTag/ARRAY)))
             (not (.hasTag t TypeTag/ERROR)))
        (.typeTagError this
                       pos
                       (.fragment diags CompilerProperties$Fragments/TypeReqClassArray)
                       (.asTypeParam this t))
        t))

  (method checkClassType ^Type [this ^JCDiagnostic$DiagnosticPosition pos ^Type t]
    (if (and (not (.hasTag t TypeTag/CLASS)) (not (.hasTag t TypeTag/ERROR)))
        (.typeTagError this
                       pos
                       (.fragment diags CompilerProperties$Fragments/TypeReqClass)
                       (.asTypeParam this t))
        t))

  (method ^:private asTypeParam [this ^Type t]
    (if (.hasTag t TypeTag/TYPEVAR)
        ^Object (.fragment diags (CompilerProperties$Fragments/TypeParameter t))
        ^Object t))

  (method checkConstructorRefType ^Type [this ^JCDiagnostic$DiagnosticPosition pos ^:mutable ^Type t]
    (set! t (.checkClassOrArrayType this pos t))
    (cond
      (.hasTag t TypeTag/CLASS)
        (cond
          (not (== (bit-and (.flags (.-tsym t)) (bit-or-int Flags/ABSTRACT Flags/INTERFACE)) 0))
            (do
              (.error log pos (CompilerProperties$Errors/AbstractCantBeInstantiated (.-tsym t)))
              (set! t (.createErrorType types t)))
          (not (== (bit-and (.flags (.-tsym t)) Flags/ENUM) 0))
            (do
              (.error log pos CompilerProperties$Errors/EnumCantBeInstantiated)
              (set! t (.createErrorType types t)))
          :else (set! t (.checkClassType this pos t true)))
      (.hasTag t TypeTag/ARRAY)
        (when-not (.isReifiable types (.-elemtype (cast Type$ArrayType t)))
          (.error log pos CompilerProperties$Errors/GenericArrayCreation)
          (set! t (.createErrorType types t))))
    t)

  (method checkClassType ^Type [this ^JCDiagnostic$DiagnosticPosition pos ^:mutable ^Type t
                                ^boolean noBounds]
    (set! t (.checkClassType this pos t))
    (when (and noBounds (.isParameterized t))
      (let [^:mutable ^{:tag (List Type)} args (.getTypeArguments t)]
        (while (.nonEmpty args)
          (when (.hasTag (cast Type (.-head args)) TypeTag/WILDCARD)
            (return (.typeTagError this
                                   pos
                                   (.fragment diags CompilerProperties$Fragments/TypeReqExact)
                                   (.-head args))))
          (set! args (.-tail args)))))
    t)

  (method checkRefType ^Type [this ^JCDiagnostic$DiagnosticPosition pos ^Type t]
    (if (.isReference t)
        t
        (.typeTagError this pos (.fragment diags CompilerProperties$Fragments/TypeReqRef) t)))

  (method checkRefTypes ^{:tag (List Type)} [this ^{:tag (List JCTree$JCExpression)} trees
                                             ^{:tag (List Type)} types]
    (let [^:mutable ^{:tag (List JCTree$JCExpression)} tl trees]
      (loop [^{:tag (List Type)} l types]
        (when (.nonEmpty l)
          (set! (.-head l)
                (.checkRefType this
                               (.pos (cast JCTree$JCExpression (.-head tl)))
                               (cast Type (.-head l))))
          (set! tl (.-tail tl))
          (recur (.-tail l))))
      types))

  (method checkNullOrRefType ^Type [this ^JCDiagnostic$DiagnosticPosition pos ^Type t]
    (if (or (.isReference t) (.hasTag t TypeTag/BOT))
        t
        (.typeTagError this pos (.fragment diags CompilerProperties$Fragments/TypeReqRef) t)))

  (method checkDisjoint ^boolean [this ^JCDiagnostic$DiagnosticPosition pos ^long flags ^long set1
                                  ^long set2]
    (if (and (not (== (bit-and flags set1) 0)) (not (== (bit-and flags set2) 0)))
        (do
          (.error log
                  pos
                  (CompilerProperties$Errors/IllegalCombinationOfModifiers
                    (Flags/asFlagSet (TreeInfo/firstFlag (bit-and flags set1)))
                    (Flags/asFlagSet (TreeInfo/firstFlag (bit-and flags set2)))))
          false)
        true))

  (method checkDiamond ^Type [this ^JCTree$JCNewClass tree ^Type t]
    (if (or (not (TreeInfo/isDiamond tree)) (.isErroneous t))
        (.checkClassType this (.pos (.-clazz tree)) t true)
        (do
          (when (and (some? (.-def tree))
                     (not (.allowedInSource Source$Feature/DIAMOND_WITH_ANONYMOUS_CLASS_CREATION
                                            source)))

                                            ^Symbol$ClassSymbol c]
    (.error log pos (CompilerProperties$Errors/DuplicateClass (.-fullname c))))

  (method ^:public visitTypeParameter ^void [this ^JCTree$JCTypeParameter tree]
    (let [^Type$TypeVar a (if (some? (.-type tree))
                              (cast Type$TypeVar (.-type tree))
                              (Type$TypeVar. (.-name tree)
                                             (.-owner (.-scope (cast AttrContext (.-info env))))
                                             (.-botType syms)))]

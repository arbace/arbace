              (.removeClass syms (.-modle (.-toplevel env)) (.-name tree))))
          (do
            (when (and (not (.isEmpty (.-name tree)))
                       (not (.checkUniqueClassName chk (.pos tree) (.-name tree) enclScope)))
              (set! result nil)
              (return))
            (if (identical? (.-kind owner) Kinds$Kind/TYP)

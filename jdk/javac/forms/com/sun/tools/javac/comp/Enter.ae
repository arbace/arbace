                  (set! c
                        (.enterClass syms
                                     (.-modle (.-toplevel env))
                                     (.-name tree)
                                     (cast Symbol$TypeSymbol owner)))
                  (when-not (identical? (.-owner c) owner)
                    (when-not (identical? (.-name c) (.-name tree))
                      (.error log
                              (.pos tree)
                              (CompilerProperties$Errors/SameBinaryName (.-name c) (.-name tree)))
                      (set! result

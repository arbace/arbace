                (if (not (== (bit-and (.-flags (.-mods tree)) Flags/ENUM) 0))
                    (set! topElement Kinds$KindName/ENUM)
                    (when-not (== (bit-and (.-flags (.-mods tree)) Flags/INTERFACE) 0)
                      (set! topElement Kinds$KindName/INTERFACE)))
                (.error log
                        (.pos tree)
                        (CompilerProperties$Errors/ClassPublicShouldBeInFile
                          topElement
                          (.-name tree)))))

  (method ^:public main ^void [this ^{:tag (List JCTree$JCCompilationUnit)} trees]
    (.complete this trees nil))

  (method ^:public complete ^void [this ^{:tag (List JCTree$JCCompilationUnit)} trees
                                   ^Symbol$ClassSymbol c]
    (.blockAnnotations annotate)
    (let [^{:tag (ListBuffer Symbol$ClassSymbol)} prevUncompleted uncompleted]
      (when (.-completionEnabled typeEnter) (set! uncompleted (ListBuffer.)))
      (try
        (let [^{:tag (List Symbol$ClassSymbol)} prevPendingCompleter pendingCompleter]
          (try
            (set! pendingCompleter (List/nil))
            (.classEnter this trees nil)
            (for-each [^Symbol$ClassSymbol sym pendingCompleter] (set! (.-completer sym) typeEnter))
            (finally (set! pendingCompleter prevPendingCompleter)))
          (when (.-completionEnabled typeEnter)
            (while (.nonEmpty uncompleted)
              (let [clazz (cast Symbol$ClassSymbol (.next uncompleted))]
                (if (or (or (nil? c) (identical? c clazz)) (nil? prevUncompleted))
                    (.complete clazz)
                    (.append prevUncompleted clazz))))
            (if (not (.modulesInitialized modules))
                (for-each [^JCTree$JCCompilationUnit cut trees]
                  (if (some? (.getModuleDecl cut))
                      (.append unfinishedModules cut)
                      (.ensureImportsChecked typeEnter (List/of cut))))
                (do
                  (.ensureImportsChecked typeEnter (.toList unfinishedModules))
                  (.clear unfinishedModules)
                  (.ensureImportsChecked typeEnter trees)))))
        (finally (set! uncompleted prevUncompleted) (.unblockAnnotations annotate)))))

  (method ^:public newRound ^void [this] (.clear typeEnvs))

  (method ^:public unenter ^void [this ^JCTree$JCCompilationUnit topLevel ^JCTree tree]
    (.scan (UnenterScanner. (.-modle topLevel)) tree))

  (defclass UnenterScanner
    :extends TreeScanner

    (field ^:private ^:final ^Symbol$ModuleSymbol msym)

    (constructor ^:public [this ^Symbol$ModuleSymbol msym]
      (set! (.-msym this) msym))

    (method ^:public visitClassDef ^void [this ^JCTree$JCClassDecl tree]
      (let [csym (.-sym tree)]
        (when (some? csym)
          (.remove typeEnvs csym)
          (.removeCompiled chk csym)
          (.clearLocalClassNameIndexes chk csym)
          (.removeClass syms msym (.-flatname csym))
          (.visitClassDef super tree))))))

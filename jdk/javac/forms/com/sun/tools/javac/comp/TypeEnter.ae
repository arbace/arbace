            (set! iface (.clearTypeParams this iface))
            (let [it (.attribBase attr iface baseEnv false true true)]
              (if (.hasTag it TypeTag/CLASS)
                  (do
                    (.append interfaces it)
                    (when (some? all_interfaces) (.append all_interfaces it)))
                  (do
                    (when (nil? all_interfaces)
                      (set! all_interfaces (.appendList (ListBuffer.) interfaces)))
                    (.append all_interfaces (.modelMissingTypes this baseEnv it iface true))))))
          (if (not (== (bit-and (.-flags_field sym) Flags/ANNOTATION) 0))
              (do
                (set! (.-interfaces_field ct) (List/of (.-annotationType syms)))
                (set! (.-all_interfaces_field ct) (.-interfaces_field ct)))
              (do
                (set! (.-interfaces_field ct) (.toList interfaces))
                (set! (.-all_interfaces_field ct)
                      (if (nil? all_interfaces) (.-interfaces_field ct) (.toList all_interfaces))))))))

    (method ^:protected clearTypeParams ^JCTree$JCExpression [this ^JCTree$JCExpression superType]
      superType))

  (defclass ^:private ^:final HierarchyPhase
    :extends AbstractHeaderPhase
    :implements [Symbol$Completer]

    (constructor ^:public [this]
      (super. Dependencies$CompletionCause/HIERARCHY_PHASE (HeaderPhase.)))

    (method ^:protected doCompleteEnvs ^void [this ^{:tag (List (Env AttrContext))} envs]
      (for-each [^{:tag (Env AttrContext)} env envs]
        (set! (.-completer (.-sym (.-enclClass env))) this))
      (for-each [^{:tag (Env AttrContext)} env envs] (.complete (.-sym (.-enclClass env)))))

    (method ^:protected runPhase ^void [this ^{:tag (Env AttrContext)} env]
      (let [tree (.-enclClass env)
            sym (.-sym tree)
            ct (cast Type$ClassType (.-type sym))
            ^{:tag (Env AttrContext)} baseEnv (.baseEnv this tree env)]
        (.attribSuperTypes this env baseEnv)
        (when (identical? (.-fullname sym) (.-java_lang_Object names))
          (if (some? (.-extending tree))
              (do
                (.checkNonCyclic chk (.pos (.-extending tree)) (.-supertype_field ct))
                (set! (.-supertype_field ct) Type/noType))
              (when (.nonEmpty (.-implementing tree))
                (.checkNonCyclic chk
                                 (.pos (cast JCTree$JCExpression (.-head (.-implementing tree))))
                                 (cast Type (.-head (.-interfaces_field ct))))
                (set! (.-interfaces_field ct) (List/nil)))))
        (.markDeprecated TypeEnter/this sym (.-annotations (.-mods tree)) baseEnv)
        (.checkNonCyclicDecl chk tree)))

    (method ^:protected clearTypeParams ^JCTree$JCExpression [this ^JCTree$JCExpression superType]
      (switch (.getTag superType) TYPEAPPLY (return (.-clazz (cast JCTree$JCTypeApply superType))))
      superType)

    (method ^:public complete :throws [Symbol$CompletionFailure] ^void [this ^Symbol sym]
      (Assert/check (or (instance? ImportsPhase topLevelPhase) (identical? topLevelPhase this)))
      (if (not (identical? topLevelPhase this))
          (set! (.-completer sym) this)
          (let [^{:tag (Env AttrContext)} env (.get typeEnvs (cast Symbol$ClassSymbol sym))]
            (.doCompleteEnvs super (List/of env))))))

  (defclass ^:private ^:final HeaderPhase
    :extends AbstractHeaderPhase

    (constructor ^:public [this]
      (super. Dependencies$CompletionCause/HEADER_PHASE (RecordPhase.)))

    (method ^:protected runPhase ^void [this ^{:tag (Env AttrContext)} env]
      (let [tree (.-enclClass env)
            sym (.-sym tree)
            ct (cast Type$ClassType (.-type sym))
            ^{:tag (Env AttrContext)} baseEnv (.baseEnv this tree env)]
        (when (some? (.-extending tree))
          (.queueScanTreeAndTypeAnnotate annotate (.-extending tree) baseEnv sym))
        (for-each [^JCTree$JCExpression impl (.-implementing tree)]
          (.queueScanTreeAndTypeAnnotate annotate impl baseEnv sym))
        (.flush annotate)
        (.attribSuperTypes this env baseEnv)
        (.fillPermits this tree baseEnv)
        (let [^{:tag (Set Symbol)} interfaceSet (HashSet.)]
          (for-each [^JCTree$JCExpression iface (.-implementing tree)]
            (let [it (.-type iface)]
              (when (.hasTag it TypeTag/CLASS)
                (.checkNotRepeated chk (.pos iface) (.erasure types it) interfaceSet))))
          (.annotateLater annotate (.-annotations (.-mods tree)) baseEnv sym)
          (.attribTypeVariables attr (.-typarams tree) baseEnv false)
          (for-each [^JCTree$JCTypeParameter tp (.-typarams tree)]
            (.queueScanTreeAndTypeAnnotate annotate tp baseEnv sym))
          (when (and (and (and checkClash (identical? (.-kind (.-owner sym)) Kinds$Kind/PCK))
                          (not (identical? (.-owner sym)
                                           (.-unnamedPackage (.-modle (.-toplevel env))))))
                     (.packageExists syms (.-modle (.-toplevel env)) (.-fullname sym)))
            (.error log
                    (.-pos tree)
                    (CompilerProperties$Errors/ClashWithPkgOfSameName (Kinds/kindName sym) sym)))
          (when (and (and (identical? (.-kind (.-owner sym)) Kinds$Kind/PCK)
                          (== (bit-and (.-flags_field sym) Flags/PUBLIC) 0))
                     (not (.isNameCompatible (.-sourcefile (.-toplevel env))
                                             (.toString (.-name sym))
                                             JavaFileObject$Kind/SOURCE)))
            (set! (.-flags_field sym) (bit-or (.-flags_field sym) Flags/AUXILIARY))))))

    (method ^:private fillPermits ^void [this ^JCTree$JCClassDecl tree
                                         ^{:tag (Env AttrContext)} baseEnv]
      (let [sym (.-sym tree)]
        (when (or (not (.isAnonymous sym)) (.isEnum sym))
          (for-each [^Type supertype (.directSupertypes types (.-type sym))]
            (when (identical? (.-kind (.-tsym supertype)) Kinds$Kind/TYP)
              (let [supClass (cast Symbol$ClassSymbol (.-tsym supertype))
                    ^{:tag (Env AttrContext)} supClassEnv (.getEnv enter supClass)]
                (when (and (and (and (.isSealed supClass) (not (.-isPermittedExplicit supClass)))
                                (some? supClassEnv))
                           (identical? (.-toplevel supClassEnv) (.-toplevel baseEnv)))
                  (.addPermittedSubclass supClass sym (.-pos tree)))))))
        (when (.-isPermittedExplicit sym)
          (let [^{:tag (ListBuffer Symbol)} permittedSubtypeSymbols (ListBuffer.)
                ^{:tag (List JCTree$JCExpression)} permittedTrees (.-permitting tree)
                isPermitsClause (.-isPermitsClause (cast AttrContext (.-info baseEnv)))]
            (try
              (set! (.-isPermitsClause (cast AttrContext (.-info baseEnv))) true)
              (for-each [^JCTree$JCExpression permitted permittedTrees]
                (let [pt (.attribBase attr permitted baseEnv false false false)]
                  (.append permittedSubtypeSymbols (.-tsym pt))))
              (.setPermittedSubclasses sym (.toList permittedSubtypeSymbols))
              (finally
                (set! (.-isPermitsClause (cast AttrContext (.-info baseEnv))) isPermitsClause))))))))

  (defclass ^:private ^:abstract AbstractMembersPhase
    :extends Phase

    (constructor ^:public [this ^Dependencies$CompletionCause completionCause ^Phase next]
      (super. completionCause next))

    (field ^:private ^boolean completing)

    (field ^:private ^{:tag (List (Env AttrContext))} todo (List/nil))

    (method ^:protected doCompleteEnvs ^void [this ^{:tag (List (Env AttrContext))} envs]
      (set! todo (.prependList todo envs))
      (when-not completing
        (let [prevCompleting completing]
          (set! completing true)
          (try
            (while (.nonEmpty todo)
              (let [^{:tag (Env AttrContext)} head (cast Env (.-head todo))]
                (set! todo (.-tail todo))
                (.doCompleteEnvs super (List/of head))))
            (finally (set! completing prevCompleting))))))

    (method enterThisAndSuper ^void [this ^Symbol$ClassSymbol sym ^{:tag (Env AttrContext)} env]
      (let [ct (cast Type$ClassType (.-type sym))
            thisSym (Symbol$VarSymbol. (bit-or-int Flags/FINAL Flags/HASINIT)
                                       (.-_this names)
                                       (.-type sym)
                                       sym)]
        (set! (.-pos thisSym) Position/FIRSTPOS)
        (.enter (.-scope (cast AttrContext (.-info env))) thisSym)
        (when (and (== (bit-and (.-flags_field sym) Flags/INTERFACE) 0)
                   (.hasTag (.-supertype_field ct) TypeTag/CLASS))
          (let [superSym (Symbol$VarSymbol. (bit-or-int Flags/FINAL Flags/HASINIT)
                                            (.-_super names)
                                            (.-supertype_field ct)
                                            sym)]
            (set! (.-pos superSym) Position/FIRSTPOS)
            (.enter (.-scope (cast AttrContext (.-info env))) superSym))))))

  (defclass ^:private ^:final RecordPhase
    :extends AbstractMembersPhase

    (constructor ^:public [this]
      (super. Dependencies$CompletionCause/RECORD_PHASE (MembersPhase.)))

    (method ^:protected runPhase ^void [this ^{:tag (Env AttrContext)} env]
      (let [tree (.-enclClass env)
            sym (.-sym tree)]
        (when-not (== (bit-and (.-flags_field sym) Flags/RECORD) 0)
          (let [^{:tag (List JCTree$JCVariableDecl)} fields (TreeInfo/recordFields tree)
                ^:mutable ^int fieldPos 0]
            (for-each [^JCTree$JCVariableDecl field fields]
              (let [rc (.getRecordComponentAt TypeEnter/this sym fieldPos)]
                (when (and (some? rc)
                           (not (== (.length (.getOriginalAnnos rc))
                                    (.length (.-annotations (.-mods field))))))
                  (let [^{:tag (TreeCopier JCTree)} tc (TreeCopier. (.at make (.-pos field)))]
                    (set! (.-annotations (.-mods field)) (.copy tc (.getOriginalAnnos rc)))))
                (.memberEnter memberEnter field env)
                (let [rcDecl (cast JCTree$JCVariableDecl
                                   (.copy (TreeCopier. (.at make (.-pos field))) field))]
                  (.createRecordComponent sym rc rcDecl (.-sym field))
                  (set! fieldPos (unchecked-inc-int fieldPos)))))
            (.enterThisAndSuper this sym env)
            (for-each [^JCTree def (.-defs tree)]
              (when (TreeInfo/isConstructor def) (.memberEnter memberEnter def env))))))))

  (method ^:private getRecordComponentAt ^Symbol$RecordComponent [this ^Symbol$ClassSymbol sym
                                                                  ^int componentPos]
    (let [^:mutable ^int i 0]
      (for-each [^Symbol$RecordComponent rc (.getRecordComponents sym)]
        (when (== i componentPos) (return rc))
        (set! i (unchecked-inc-int i)))
      nil))

  (defclass ^:private ^:final MembersPhase
    :extends AbstractMembersPhase

    (constructor ^:public [this]
      (super. Dependencies$CompletionCause/MEMBERS_PHASE nil))

    (method ^:protected runPhase ^void [this ^{:tag (Env AttrContext)} env]
      (let [tree (.-enclClass env)
            sym (.-sym tree)
            ct (cast Type$ClassType (.-type sym))
            ^:mutable ^JCTree defaultConstructor nil
            helper (.getDefaultConstructorHelper this env)]
        (when (some? helper)
          (.checkDefaultConstructor chk sym (.pos tree))
          (set! defaultConstructor
                (.defaultConstructor TypeEnter/this (.at make (.-pos tree)) helper))
          (set! (.-defs tree) (.prepend (.-defs tree) defaultConstructor)))
        (when-not (.isRecord sym) (.enterThisAndSuper this sym env))
        (when-not (.isEmpty (.-typarams tree))
          (for-each [^JCTree$JCTypeParameter tvar (.-typarams tree)]
            (.checkNonCyclic chk tvar (cast Type$TypeVar (.-type tvar)))))
        (.finishClass this tree defaultConstructor env)
        (.organizeTypeAnnotationsSignatures typeAnnotations
                                            env
                                            (cast JCTree$JCClassDecl (.-tree env)))
        (.validateTypeAnnotationsSignatures typeAnnotations
                                            env
                                            (cast JCTree$JCClassDecl (.-tree env)))))

    (method getDefaultConstructorHelper ^DefaultConstructorHelper [this
                                                                   ^{:tag (Env AttrContext)} env]
      (let [tree (.-enclClass env)
            sym (.-sym tree)
            ^:mutable ^DefaultConstructorHelper helper nil
            isClassWithoutInit (and (== (bit-and (.flags sym) Flags/INTERFACE) 0)
                                    (not (TreeInfo/hasConstructors (.-defs tree))))
            isRecord (.isRecord sym)]
        (when (and isClassWithoutInit (not isRecord))
          (set! helper (BasicConstructorHelper. sym))
          (when (.isEmpty (.-name sym))
            (let [nc (cast JCTree$JCNewClass (.-tree (.-next env)))]
              (when (some? (.-constructor nc))
                (if (not (identical? (.-kind (.-constructor nc)) Kinds$Kind/ERR))
                    (set! helper
                          (AnonClassConstructorHelper.
                            sym
                            (cast Symbol$MethodSymbol (.-constructor nc))
                            (.-encl nc)))
                    (set! helper nil))))))
        (when isRecord
          (let [^:mutable ^JCTree$JCMethodDecl canonicalInit nil]
            (when (or isClassWithoutInit
                      (nil? (set! canonicalInit
                                  (.getCanonicalConstructorDecl this (.-enclClass env)))))
              (set! helper (RecordConstructorHelper. sym (TreeInfo/recordFields tree))))
            (when (some? canonicalInit)
              (let [o-1 (.-sym canonicalInit)]
                (set! (.-flags_field o-1) (bit-or (.-flags_field o-1) Flags/RECORD))))))
        helper))

    (method finishClass ^void [this ^JCTree$JCClassDecl tree ^JCTree defaultConstructor
                               ^{:tag (Env AttrContext)} env]
      (when (and (and (not (== (bit-and (.-flags (.-mods tree)) Flags/ENUM) 0))
                      (not (.hasTag (.-type (.-sym tree)) TypeTag/ERROR)))
                 (== (bit-and (.flags (.-tsym (.supertype types (.-type (.-sym tree))))) Flags/ENUM)
                     0))
        (.addEnumMembers this tree env))
      (let [isRecord (not (== (bit-and (.-flags_field (.-sym tree)) Flags/RECORD) 0))
            ^:mutable ^{:tag (List JCTree)} alreadyEntered nil]
        (when isRecord
          (set! alreadyEntered (List/convert JCTree (TreeInfo/recordFields tree)))
          (set! alreadyEntered
                (.prependList alreadyEntered
                              (cast List
                                    (.collect (.filter
                                                (.stream (.-defs tree))
                                                (lambda Predicate ^boolean [^JCTree t]
                                                  (and
                                                    (TreeInfo/isConstructor t)
                                                    (not (identical? t defaultConstructor)))))
                                              (List/collector))))))
        (let [^{:tag (List JCTree)} defsToEnter (if isRecord
                                                    (.diff (.-defs tree) alreadyEntered)
                                                    (.-defs tree))]
          (.memberEnter memberEnter defsToEnter env)
          (when isRecord (.addRecordMembersIfNeeded this tree env))
          (when (.isAnnotationType (.-sym tree))
            (Assert/check (.isCompleted (.-sym tree)))
            (.setAnnotationTypeMetadata (.-sym tree)
                                        (Annotate$AnnotationTypeMetadata.
                                          (.-sym tree)
                                          (.annotationTypeSourceCompleter annotate)))))))

    (method ^:private addAccessor ^void [this ^JCTree$JCVariableDecl tree
                                         ^{:tag (Env AttrContext)} env]
      (let [implSym (.lookupMethod TypeEnter/this
                                   (.-sym (.-enclClass env))
                                   (.-name (.-sym tree))
                                   (List/nil))
            rec (.getRecordComponent (cast Symbol$ClassSymbol (.-owner (.-sym tree))) (.-sym tree))]
        (cond
          (or (nil? implSym) (not (== (bit-and (.-flags_field implSym) Flags/GENERATED_MEMBER) 0)))
            (let [^{:tag (TreeCopier JCTree)} tc (TreeCopier. (.at make (.-pos tree)))
                  ^{:tag (List JCTree$JCAnnotation)} originalAnnos (if (.isEmpty
                                                                         (.getOriginalAnnos rec))
                                                                       (.getOriginalAnnos rec)
                                                                       (.copy
                                                                         tc
                                                                         (.getOriginalAnnos rec)))
                  recordField (cast JCTree$JCVariableDecl
                                    (.get (.findAny
                                            (.filter
                                              (.stream
                                                (TreeInfo/recordFields
                                                  (cast JCTree$JCClassDecl (.-tree env))))
                                              (lambda Predicate ^boolean [^JCTree$JCVariableDecl rf]
                                                (identical? (.-name rf) (.-name tree)))))))
                  getter (.MethodDef (.at make (.-pos tree))
                                     (.Modifiers
                                       make
                                       (bit-or-int Flags/PUBLIC Flags/GENERATED_MEMBER)
                                       originalAnnos)
                                     (.-name (.-sym tree))
                                     (cast JCTree$JCExpression (.copy tc (.-vartype recordField)))
                                     (List/nil)
                                     (List/nil)
                                     (List/nil)
                                     nil
                                     nil)]
              (.memberEnter memberEnter getter env)
              (set! (.-accessor rec) (.-sym getter))
              (set! (.-accessorMeth rec) getter))
          (some? implSym) (set! (.-accessor rec) implSym))))

    (method ^:private addEnumMembers ^void [this ^JCTree$JCClassDecl tree
                                            ^{:tag (Env AttrContext)} env]
      (let [valuesType (.Type make (Type$ArrayType. (.-type (.-sym tree)) (.-arrayClass syms)))
            values (.MethodDef make
                               (.Modifiers make (bit-or-int Flags/PUBLIC Flags/STATIC))
                               (.-values names)
                               valuesType
                               (List/nil)
                               (List/nil)
                               (List/nil)
                               nil
                               nil)]
        (.memberEnter memberEnter values env)
        (let [valueOf (.MethodDef make
                                  (.Modifiers make (bit-or-int Flags/PUBLIC Flags/STATIC))
                                  (.-valueOf names)
                                  (.Type make (.-type (.-sym tree)))
                                  (List/nil)
                                  (List/of (.VarDef
                                             make
                                             (.Modifiers
                                               make
                                               (bit-or Flags/PARAMETER Flags/MANDATED))
                                             (.fromString names "name")
                                             (.Type make (.-stringType syms))
                                             nil))
                                  (List/nil)
                                  nil
                                  nil)]
          (.memberEnter memberEnter valueOf env))))

    (method getCanonicalConstructorDecl ^JCTree$JCMethodDecl [this ^JCTree$JCClassDecl tree]
      (let [^{:tag (List Type)} recordComponentErasedTypes (.erasure
                                                             types
                                                             (.map
                                                               (TreeInfo/recordFields tree)
                                                               (lambda Function ^Type [^JCTree$JCVariableDecl vd]
                                                                 (.-type (.-sym vd)))))
            ^:mutable ^JCTree$JCMethodDecl canonicalDecl nil]
        (for-each [^JCTree def (.-defs tree)]
          (when (TreeInfo/isConstructor def)
            (let [mdecl (cast JCTree$JCMethodDecl def)]
              (when (.isSameTypes types
                                  (.erasure types
                                            (cast
                                              List
                                              (.collect
                                                (.map
                                                  (.stream (.-params mdecl))
                                                  (lambda Function ^Type [^JCTree$JCVariableDecl v]
                                                    (.-type (.-sym v))))
                                                (List/collector))))
                                  recordComponentErasedTypes)
                (set! canonicalDecl mdecl)
                (break)))))
        canonicalDecl))

    (method ^:private addRecordMembersIfNeeded ^void [this ^JCTree$JCClassDecl tree
                                                      ^{:tag (Env AttrContext)} env]
      (when (nil? (.lookupMethod TypeEnter/this (.-sym tree) (.-toString names) (List/nil)))
        (let [toString (.MethodDef make
                                   (.Modifiers make
                                               (bit-or
                                                 (bit-or
                                                   (bit-or Flags/PUBLIC Flags/RECORD)
                                                   Flags/FINAL)
                                                 Flags/GENERATED_MEMBER))
                                   (.-toString names)
                                   (.Type make (.-stringType syms))
                                   (List/nil)
                                   (List/nil)
                                   (List/nil)
                                   nil
                                   nil)]
          (.memberEnter memberEnter toString env)))
      (when (nil? (.lookupMethod TypeEnter/this (.-sym tree) (.-hashCode names) (List/nil)))
        (let [hashCode (.MethodDef make
                                   (.Modifiers make
                                               (bit-or
                                                 (bit-or
                                                   (bit-or Flags/PUBLIC Flags/RECORD)
                                                   Flags/FINAL)
                                                 Flags/GENERATED_MEMBER))
                                   (.-hashCode names)
                                   (.Type make (.-intType syms))
                                   (List/nil)
                                   (List/nil)
                                   (List/nil)
                                   nil
                                   nil)]
          (.memberEnter memberEnter hashCode env)))
      (when (nil? (.lookupMethod TypeEnter/this
                                 (.-sym tree)
                                 (.-equals names)
                                 (List/of (.-objectType syms))))
        (let [equals (.MethodDef make
                                 (.Modifiers make
                                             (bit-or
                                               (bit-or
                                                 (bit-or Flags/PUBLIC Flags/RECORD)
                                                 Flags/FINAL)
                                               Flags/GENERATED_MEMBER))
                                 (.-equals names)
                                 (.Type make (.-booleanType syms))
                                 (List/nil)
                                 (List/of (.VarDef
                                            make
                                            (.Modifiers make Flags/PARAMETER)
                                            (.fromString names "o")
                                            (.Type make (.-objectType syms))
                                            nil))
                                 (List/nil)
                                 nil
                                 nil)]
          (.memberEnter memberEnter equals env)))
      (let [^{:tag (List JCTree$JCVariableDecl)} recordFields (TreeInfo/recordFields tree)]
        (for-each [^JCTree$JCVariableDecl field recordFields]
          (let [o-2 (.-mods field)]
            (set! (.-flags o-2) (bit-and (.-flags o-2) (bit-not Flags/VARARGS))))
          (let [o-3 (.-sym field)]
            (set! (.-flags_field o-3) (bit-and (.-flags_field o-3) (bit-not Flags/VARARGS)))))
        (.forEach (.filter (.stream recordFields)
                           (lambda Predicate ^boolean [^JCTree$JCVariableDecl vd]
                             (nil? (.lookupMethod
                                     TypeEnter/this
                                     (.-tsym (.-objectType syms))
                                     (.-name vd)
                                     (List/nil)))))
                  (lambda Consumer ^void [^JCTree$JCVariableDecl vd] (.addAccessor this vd env))))))

  (method ^:private lookupMethod ^Symbol$MethodSymbol [this ^Symbol$TypeSymbol tsym ^Name name
                                                       ^{:tag (List Type)} argtypes]
    (for-each [^Symbol s (.getSymbolsByName (.members tsym)
                                            name
                                            (lambda Predicate ^boolean [^Symbol s]
                                              (identical? (.-kind s) Kinds$Kind/MTH)))]
      (when (.isSameTypes types (.getParameterTypes (.-type s)) argtypes)
        (return (cast Symbol$MethodSymbol s))))
    nil)

  (defclass ^:interface DefaultConstructorHelper
    (method constructorType ^Type [this])

    (method constructorSymbol ^Symbol$MethodSymbol [this])

    (method enclosingType ^Type [this])

    (method owner ^Symbol$TypeSymbol [this])

    (method superArgs ^{:tag (List Name)} [this])

    (method ^:default finalAdjustment ^JCTree$JCMethodDecl [this ^JCTree$JCMethodDecl md]
      md))

  (defclass BasicConstructorHelper
    :implements [DefaultConstructorHelper]

    (field ^Symbol$TypeSymbol owner)

    (field ^Type constructorType)

    (field ^Symbol$MethodSymbol constructorSymbol)

    (constructor [this ^Symbol$TypeSymbol owner]
      (set! (.-owner this) owner))

    (method ^:public constructorType ^Type [this]
      (when (nil? constructorType)
        (set! constructorType
              (Type$MethodType. (List/nil) (.-voidType syms) (List/nil) (.-methodClass syms))))
      constructorType)

    (method ^:public constructorSymbol ^Symbol$MethodSymbol [this]
      (when (nil? constructorSymbol)
        (let [^long flags (if (and (not (== (bit-and (.flags (.owner this)) Flags/ENUM) 0))
                                   (identical? (.-tsym (.supertype types (.-type (.owner this))))
                                               (.-enumSym syms)))
                              (bit-or Flags/PRIVATE Flags/GENERATEDCONSTR)
                              (bit-or (bit-and (.flags (.owner this)) Flags/AccessFlags)
                                      Flags/GENERATEDCONSTR))]
          (set! constructorSymbol
                (Symbol$MethodSymbol. flags (.-init names) (.constructorType this) (.owner this)))))
      constructorSymbol)

    (method ^:public enclosingType ^Type [this] Type/noType)

    (method ^:public owner ^Symbol$TypeSymbol [this] owner)

    (method ^:public superArgs ^{:tag (List Name)} [this] (List/nil)))

  (defclass AnonClassConstructorHelper
    :extends BasicConstructorHelper

    (field ^Symbol$MethodSymbol constr)

    (field ^Type encl)

    (field ^boolean based false)

    (constructor [this ^Symbol$TypeSymbol owner ^Symbol$MethodSymbol constr
                  ^JCTree$JCExpression encl]
      (super. owner)
      (set! (.-constr this) constr)
      (set! (.-encl this) (if (some? encl) (.-type encl) Type/noType)))

    (method ^:public constructorType ^Type [this]
      (when (nil? (.-constructorType this))
        (let [^:mutable ctype (.memberType types (.-type (.-owner this)) constr)]
          (when-not (.hasTag (.enclosingType this) TypeTag/NONE)
            (set! ctype
                  (.createMethodTypeWithParameters
                    types
                    ctype
                    (.prepend (.getParameterTypes ctype) (.enclosingType this))))
            (set! based true))
          (set! (.-constructorType this) ctype)))
      (.-constructorType this))

    (method ^:public constructorSymbol ^Symbol$MethodSymbol [this]
      (let [csym (.constructorSymbol super)]
        (set! (.-flags_field csym)
              (bit-or (.-flags_field csym)
                      (bit-or Flags/ANONCONSTR (bit-and (.flags constr) Flags/VARARGS))))
        (set! (.-flags_field csym)
              (bit-or (.-flags_field csym) (if based Flags/ANONCONSTR_BASED 0)))
        (let [^:mutable ^{:tag (ListBuffer Symbol$VarSymbol)} params (ListBuffer.)
              ^:mutable ^{:tag (List Type)} argtypes (.getParameterTypes (.constructorType this))]
          (when-not (.hasTag (.enclosingType this) TypeTag/NONE)
            (set! argtypes (.-tail argtypes))
            (set! params
                  (.prepend params
                            (Symbol$VarSymbol. Flags/PARAMETER
                                               (.paramName make 0)
                                               (.enclosingType this)
                                               csym))))
          (when (some? (.-params constr))
            (for-each [^Symbol$VarSymbol p (.-params constr)]
              (.add params
                    (Symbol$VarSymbol. (bit-or Flags/PARAMETER (.flags p))
                                       (.-name p)
                                       (cast Type (.-head argtypes))
                                       csym))
              (set! argtypes (.-tail argtypes))))
          (set! (.-params csym) (.toList params))
          csym)))

    (method ^:public enclosingType ^Type [this] encl)

    (method ^:public superArgs ^{:tag (List Name)} [this]
      (let [^:mutable ^{:tag (List JCTree$JCVariableDecl)} params (.Params
                                                                    make
                                                                    (.constructorSymbol this))]
        (when-not (.hasTag (.enclosingType this) TypeTag/NONE) (set! params (.-tail params)))
        (.map params (lambda Function ^Name [^JCTree$JCVariableDecl vd] (.-name vd))))))

  (defclass RecordConstructorHelper
    :extends BasicConstructorHelper

    (field ^boolean lastIsVarargs)

    (field ^{:tag (List JCTree$JCVariableDecl)} recordFieldDecls)

    (constructor [this ^Symbol$ClassSymbol owner
                  ^{:tag (List JCTree$JCVariableDecl)} recordFieldDecls]
      (super. owner)
      (set! (.-recordFieldDecls this) recordFieldDecls)
      (set! (.-lastIsVarargs this)
            (.anyMatch (.stream (.getRecordComponents owner))
                       (lambda Predicate ^boolean [^Symbol$RecordComponent rc] (.isVarargs rc)))))

    (method ^:public constructorType ^Type [this]
      (when (nil? (.-constructorType this))
        (let [^{:tag (ListBuffer Type)} argtypes (ListBuffer.)
              lastField (cast JCTree$JCVariableDecl (.last recordFieldDecls))]
          (for-each [^JCTree$JCVariableDecl field recordFieldDecls]
            (.add argtypes
                  ^Type (if (and (identical? field lastField) lastIsVarargs)
                            (.elemtype types (.-type (.-sym field)))
                            (.-type (.-sym field)))))
          (set! (.-constructorType this)
                (Type$MethodType. (.toList argtypes)
                                  (.-voidType syms)
                                  (List/nil)
                                  (.-methodClass syms)))))
      (.-constructorType this))

    (method ^:public constructorSymbol ^Symbol$MethodSymbol [this]
      (let [csym (.constructorSymbol super)]
        (set! (.-flags_field csym) (bit-or (.-flags_field csym) Flags/GENERATEDCONSTR))
        (let [^{:tag (ListBuffer Symbol$VarSymbol)} params (ListBuffer.)
              lastField (cast JCTree$JCVariableDecl (.last recordFieldDecls))]
          (for-each [^JCTree$JCVariableDecl field recordFieldDecls]
            (.add params
                  (Symbol$VarSymbol.
                    (bit-or (bit-or (bit-or Flags/GENERATED_MEMBER Flags/PARAMETER) Flags/RECORD)
                            (if (and (identical? field lastField) lastIsVarargs) Flags/VARARGS 0))
                    (.-name field)
                    (.-type (.-sym field))
                    csym)))
          (set! (.-params csym) (.toList params))
          (set! (.-flags_field csym) (bit-or (.-flags_field csym) Flags/RECORD))
          csym)))

    (method ^:public finalAdjustment ^JCTree$JCMethodDecl [this ^JCTree$JCMethodDecl md]
      (let [^:mutable ^{:tag (List JCTree$JCVariableDecl)} tmpRecordFieldDecls recordFieldDecls]
        (for-each [^JCTree$JCVariableDecl arg (.-params md)]
          (let [rc (.getRecordComponent (cast Symbol$ClassSymbol (.-owner this)) (.-sym arg))
                ^{:tag (TreeCopier JCTree)} tc (TreeCopier. (.at make (.-pos arg)))]
            (set! (.-annotations (.-mods arg))
                  (if (.isEmpty (.getOriginalAnnos rc))
                      (List/nil)
                      (.copy tc (.getOriginalAnnos rc))))
            (set! (.-vartype arg)
                  (cast JCTree$JCExpression
                        (.copy
                          tc
                          (.-vartype (cast JCTree$JCVariableDecl (.-head tmpRecordFieldDecls))))))
            (set! tmpRecordFieldDecls (.-tail tmpRecordFieldDecls))))
        md)))

  (method defaultConstructor ^JCTree [this ^TreeMaker make ^DefaultConstructorHelper helper]
    (let [initType (.constructorType helper)
          initSym (.constructorSymbol helper)
          ^{:tag (ListBuffer JCTree$JCStatement)} stats (ListBuffer.)]
      (when-not (identical? (.-type (.owner helper)) (.-objectType syms))
        (let [^JCTree$JCExpression meth (if (not (.hasTag (.enclosingType helper) TypeTag/NONE))
                                            (.Select
                                              make
                                              (.Ident
                                                make
                                                (cast Symbol (.-head (.-params initSym))))
                                              (.-_super names))
                                            (.Ident make (.-_super names)))]
          (let [^{:tag (List JCTree$JCExpression)} typeargs (when (.nonEmpty
                                                                    (.getTypeArguments initType))
                                                              (.Types
                                                                make
                                                                (.getTypeArguments initType)))
                ^JCTree$JCStatement superCall (.Exec
                                                make
                                                (.Apply
                                                  make
                                                  typeargs
                                                  meth
                                                  (.map
                                                    (.superArgs helper)
                                                    (method-ref
                                                      Function
                                                      ^JCTree$JCExpression [Name]
                                                      make
                                                      TreeMaker/.Ident))))]
            (.add stats superCall))))
      (let [result (.MethodDef make initSym (.Block make 0 (.toList stats)))]
        (.finalAdjustment helper result))))

  (method ^:public markDeprecated ^void [this ^Symbol sym
                                         ^{:tag (List JCTree$JCAnnotation)} annotations
                                         ^{:tag (Env AttrContext)} env]
    (.attribAnnotationTypes attr annotations env)
    (.handleDeprecatedAnnotations this annotations sym))

  (method ^:private handleDeprecatedAnnotations ^void [this
                                                       ^{:tag (List JCTree$JCAnnotation)} annotations
                                                       ^Symbol sym]
    (loop [^{:tag (List JCTree$JCAnnotation)} al annotations]
      (when-not (.isEmpty al)
        (let [a (cast JCTree$JCAnnotation (.-head al))]
          (cond
            (identical? (.-type (.-annotationType a)) (.-deprecatedType syms))
              (do
                (set! (.-flags_field sym)
                      (bit-or (.-flags_field sym)
                              (bit-or Flags/DEPRECATED Flags/DEPRECATED_ANNOTATION)))
                (.setFlagIfAttributeTrue this a sym (.-forRemoval names) Flags/DEPRECATED_REMOVAL)
                (recur (.-tail al)))
            (identical? (.-type (.-annotationType a)) (.-previewFeatureType syms))
              (do
                (set! (.-flags_field sym) (bit-or (.-flags_field sym) Flags/PREVIEW_API))
                (.setFlagIfAttributeTrue this a sym (.-reflective names) Flags/PREVIEW_REFLECTIVE)
                (recur (.-tail al)))
            :else (recur (.-tail al)))))))

  (method ^:private setFlagIfAttributeTrue ^void [this ^JCTree$JCAnnotation a ^Symbol sym
                                                  ^Name attribute ^long flag]
    (.ifPresent (.findFirst (.filter (.map
                                       (.filter (.stream (.-args a))
                                                (lambda Predicate ^boolean [^JCTree$JCExpression e]
                                                  (.hasTag e JCTree$Tag/ASSIGN)))
                                       (lambda Function ^JCTree$JCAssign [^JCTree$JCExpression e]
                                         (cast JCTree$JCAssign e)))
                                     (lambda Predicate ^boolean [^JCTree$JCAssign assign]
                                       (identical? (TreeInfo/name (.-lhs assign)) attribute))))
                (lambda Consumer ^void [^JCTree$JCAssign assign]
                  (let [rhs (TreeInfo/skipParens (.-rhs assign))]
                    (when (and (.hasTag rhs JCTree$Tag/LITERAL)
                               (.equals Boolean/TRUE (.getValue (cast JCTree$JCLiteral rhs))))
                      (set! (.-flags_field sym) (bit-or (.-flags_field sym) flag))))))))

                      valueOf (.MethodDef make valueOfSym (.Block make 0 (List/of enum_ValueOf)))]
                  (set! (.-sym nameVal)
                        (.-sym (cast JCTree$JCVariableDecl (.-head (.-params valueOf)))))
                  (when debugLower

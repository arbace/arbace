                                           (.constValue (.-type (TreeInfo/skipParens expression))))]
                            (set! caseExpr (.Literal make (.get caseLabelToPosition name)))))
                        (.append lb
                                 (.Case make
                                        JCTree$JCCase/STATEMENT
                                        ^List (if (nil? caseExpr)
                                                  (List/of (.DefaultCaseLabel make))
                                                  (List/of (.ConstantCaseLabel make caseExpr)))
                                        nil
                                        (.-stats oneCase)
                                        nil))))
                    (if (.hasTag tree JCTree$Tag/SWITCH)
                        (let [switch2 (.Switch make (.Ident make dollar_tmp) (.toList lb))]
                          (.patchTargets this switch2 tree switch2)
                          (.append stmtList switch2)
                          (let [res (.Block make 0 (.toList stmtList))]
                            (set! (.-bracePos res) (TreeInfo/endPos tree))
                            res))
                        (let [switch2 (.SwitchExpression make (.Ident make dollar_tmp) (.toList lb))]
                          (.patchTargets this switch2 tree switch2)
                          (.setType switch2 (.-type tree))
                          (let [res (.LetExpr make (.toList stmtList) switch2)]
                            (set! (.-needsCond res) true)
                            (.setType res (.-type tree))
                            res)))))))))))

  (method ^:private visitBoxedPrimitiveSwitch ^JCTree [this ^JCTree tree
                                                       ^JCTree$JCExpression selector
                                                       ^{:tag (List JCTree$JCCase)} cases]
    (let [^:mutable ^JCTree$JCExpression newSelector nil]
      (if (.anyMatch (.stream cases)
                     (lambda Predicate ^boolean [^JCTree$JCCase c]
                       (TreeInfo/isNullCaseLabel (cast JCTree$JCCaseLabel (.-head (.-labels c))))))
          (let [^{:tag (Set Integer)} constants (LinkedHashSet.)
                ^:mutable ^JCTree$JCCase nullCase nil]
            (for-each [^JCTree$JCCase c cases]
              (if (TreeInfo/isNullCaseLabel (cast JCTree$JCCaseLabel (.-head (.-labels c))))
                  (set! nullCase c)
                  (when-not (.hasTag (cast JCTree$JCCaseLabel (.-head (.-labels c)))
                                     JCTree$Tag/DEFAULTCASELABEL)
                    (.add constants
                          (.intValue (cast Integer
                                           (.constValue
                                             (.-type
                                               (.-expr
                                                 (cast
                                                   JCTree$JCConstantCaseLabel
                                                   (.-head (.-labels c))))))))))))
            (Assert/checkNonNull nullCase)
            (let [^:mutable ^int nullValue (if (.isEmpty constants)
                                               0
                                               (.intValue
                                                 (cast Integer (.next (.iterator constants)))))]
              (while (.contains constants nullValue) (set! nullValue (unchecked-inc-int nullValue)))
              (.add constants nullValue)
              (set! (.-head (.-labels nullCase))
                    (.ConstantCaseLabel make (.makeLit this (.-intType syms) nullValue)))
              (let [^:mutable replacementValue nullValue]
                (while (.contains constants replacementValue)
                  (set! replacementValue (unchecked-inc-int replacementValue)))
                (let [dollar_s (Symbol$VarSymbol.
                                 (bit-or-int Flags/FINAL Flags/SYNTHETIC)
                                 (.fromString names
                                              (java-str
                                                "s"
                                                (let [old-18 variableIndex]
                                                  (set!
                                                    variableIndex
                                                    (unchecked-inc-int variableIndex))
                                                  old-18)
                                                (.syntheticNameChar (.-target this))))
                                 (.-type selector)
                                 currentMethodSym)
                      var (.setType (.VarDef (.at make (.pos tree)) dollar_s selector)
                                    (.-type dollar_s))
                      nullValueReplacement (.setType
                                             (.Conditional
                                               make
                                               (.makeBinary
                                                 this
                                                 JCTree$Tag/NE
                                                 (.unbox
                                                   this
                                                   (.Ident make dollar_s)
                                                   (.-intType syms))
                                                 (.makeLit this (.-intType syms) nullValue))
                                               (.unbox this (.Ident make dollar_s) (.-intType syms))
                                               (.makeLit this (.-intType syms) replacementValue))
                                             (.-intType syms))
                      nullCheck (.setType (.Conditional
                                            make
                                            (.makeBinary
                                              this
                                              JCTree$Tag/NE
                                              (.Ident make dollar_s)
                                              (.makeNull this))
                                            nullValueReplacement
                                            (.makeLit this (.-intType syms) nullValue))
                                          (.-intType syms))]
                  (set! newSelector
                        (.setType (.LetExpr make (List/of var) nullCheck) (.-intType syms)))))))
          (set! newSelector (.unbox this selector (.-intType syms))))
      (if (.hasTag tree JCTree$Tag/SWITCH)
          (set! (.-selector (cast JCTree$JCSwitch tree)) newSelector)
          (set! (.-selector (cast JCTree$JCSwitchExpression tree)) newSelector))
      tree))

  (method ^:public visitBreak ^void [this ^JCTree$JCBreak tree]
    (set! (.-result this) tree))

  (method ^:public visitYield ^void [this ^JCTree$JCYield tree]
    (set! (.-value tree) (.translate this (.-value tree) (.-type (.-target tree))))
    (set! (.-result this) tree))

  (method ^:public visitNewArray ^void [this ^JCTree$JCNewArray tree]
    (set! (.-elemtype tree) (cast JCTree$JCExpression (.translate this (.-elemtype tree))))
    (loop [^{:tag (List JCTree$JCExpression)} t (.-dims tree)]
      (if (some? (.-tail t))
          (if (some? (.-head t))
              (do
                (set! (.-head t)
                      (.translate this (cast JCTree$JCExpression (.-head t)) (.-intType syms)))
                (recur (.-tail t)))
              (recur (.-tail t)))
          nil))
    (set! (.-elems tree) (.translate this (.-elems tree) (.elemtype types (.-type tree))))
    (set! (.-result this) tree))

  (method ^:public visitSelect ^void [this ^JCTree$JCFieldAccess tree]
    (let [qualifiedSuperAccess (and (and (.hasTag (.-selected tree) JCTree$Tag/SELECT)
                                         (identical?
                                           (TreeInfo/name (.-selected tree))
                                           (.-_super names)))
                                    (not (.isDirectSuperInterface
                                           types
                                           (.-tsym
                                             (.-type
                                               (.-selected
                                                 (cast JCTree$JCFieldAccess (.-selected tree)))))
                                           currentClass)))]
      (set! (.-selected tree) (cast JCTree$JCExpression (.translate this (.-selected tree))))
      (if (and (identical? (.-name tree) (.-_class names))
               (.isPrimitiveOrVoid (.-type (.-selected tree))))
          (set! (.-result this) (.classOf this (.-selected tree)))
          (arbace.core/cond
            (and (identical? (.-name tree) (.-_super names))
                 (.isDirectSuperInterface types (.-tsym (.-type (.-selected tree))) currentClass))
            (let [supSym (.-tsym (.-type (.-selected tree)))]
              (Assert/checkNonNull (.asSuper types (.-type currentClass) supSym))
              (set! (.-result this) tree))
            (or (identical? (.-name tree) (.-_this names))
                (identical? (.-name tree) (.-_super names)))
            (set! (.-result this) (.makeThis this (.pos tree) (.-tsym (.-type (.-selected tree)))))
            :else
            (set! (.-result this) (.access this (.-sym tree) tree enclOp qualifiedSuperAccess))))))

  (method ^:public visitLetExpr ^void [this ^JCTree$LetExpr tree]
    (set! (.-defs tree) (.translate this (.-defs tree)))
    (set! (.-expr tree) (.translate this (.-expr tree) (.-type tree)))
    (set! (.-result this) tree))

  (method ^:public visitAnnotation ^void [this ^JCTree$JCAnnotation tree]
    (set! (.-result this) tree))

  (method ^:public visitTry ^void [this ^JCTree$JCTry tree]
    (if (.nonEmpty (.-resources tree))
        (set! (.-result this) (.makeTwrTry this tree))
        (let [hasBody (.nonEmpty (.getStatements (.-body tree)))
              hasCatchers (.nonEmpty (.-catchers tree))
              hasFinally (and (some? (.-finalizer tree))
                              (.nonEmpty (.getStatements (.-finalizer tree))))]
          (arbace.core/cond (and (not hasCatchers) (not hasFinally))
                            (set! (.-result this) (.translate this (.-body tree)))
                            (not hasBody)
                            (if hasFinally
                                (set! (.-result this) (.translate this (.-finalizer tree)))
                                (set! (.-result this) (.translate this (.-body tree))))
                            :else
                            (.visitTry super tree)))))

  (method ^:public translateTopLevelClass ^{:tag (List JCTree)} [this ^{:tag (Env AttrContext)} env
                                                                 ^JCTree cdef ^TreeMaker make]
    (let [^:mutable ^{:tag (ListBuffer JCTree)} translated nil]
      (try
        (set! attrEnv env)
        (set! (.-make this) make)
        (set! endPosTable (.-endPositions (.-toplevel env)))
        (set! currentClass nil)
        (set! currentRestype nil)
        (set! currentMethodDef nil)
        (set! outermostClassDef
              (when (.hasTag cdef JCTree$Tag/CLASSDEF) (cast JCTree$JCClassDecl cdef)))
        (set! outermostMemberDef nil)
        (set! (.-translated this) (ListBuffer.))
        (set! classdefs (HashMap.))
        (set! actualSymbols (HashMap.))
        (set! freevarCache (HashMap.))
        (set! proxies (HashMap.))
        (set! twrVars (Scope$WriteableScope/create (.-noSymbol syms)))
        (set! outerThisStack (List/nil))
        (set! accessNums (HashMap.))
        (set! accessSyms (HashMap.))
        (set! accessConstrs (HashMap.))
        (set! accessConstrTags (List/nil))
        (set! accessed (ListBuffer.))
        (.translate this cdef (cast JCTree$JCExpression nil))
        (loop [^{:tag (List Symbol)} l (.toList accessed)]
          (when (.nonEmpty l) (.makeAccessible this (cast Symbol (.-head l))) (recur (.-tail l))))
        (for-each [^EnumMapping map (.values enumSwitchMap)] (.translate map))
        (.checkConflicts this (.toList (.-translated this)))
        (.checkAccessConstructorTags this)
        (set! translated (.-translated this))
        (finally
          (set! attrEnv nil)
          (set! (.-make this) nil)
          (set! endPosTable nil)
          (set! currentClass nil)
          (set! currentRestype nil)
          (set! currentMethodDef nil)
          (set! outermostClassDef nil)
          (set! outermostMemberDef nil)
          (set! (.-translated this) nil)
          (set! classdefs nil)
          (set! actualSymbols nil)
          (set! freevarCache nil)
          (set! proxies nil)
          (set! outerThisStack nil)
          (set! accessNums nil)
          (set! accessSyms nil)
          (set! accessConstrs nil)
          (set! accessConstrTags nil)
          (set! accessed nil)
          (.clear enumSwitchMap)
          (set! assertionsDisabledClassCache nil)))
      (.toList translated)))

  (method ^:public translateMethod ^JCTree$JCMethodDecl [this ^{:tag (Env AttrContext)} env
                                                         ^JCTree$JCMethodDecl methodDecl
                                                         ^TreeMaker make]
    (try
      (set! (.-attrEnv this) env)
      (set! (.-make this) make)
      (set! (.-currentClass this) (.enclClass (.-sym methodDecl)))
      (set! proxies (HashMap.))
      (cast JCTree$JCMethodDecl (.translate this methodDecl))
      (finally
        (set! (.-attrEnv this) nil)
        (set! (.-make this) nil)
        (set! (.-currentClass this) nil)
        (set! (.-currentMethodSym this) nil)
        (set! (.-currentMethodDef this) nil)
        (set! (.-proxies this) nil)))))

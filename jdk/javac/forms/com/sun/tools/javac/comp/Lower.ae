  (field ^:private ^Symbol$MethodSymbol systemArraycopyMethod)

  (method ^:private useClone ^boolean [this]
    (try
      (some? (.findFirst (.members (.-tsym (.-objectType syms))) (.-clone names)))
      (catch Symbol$CompletionFailure e false)))

  (method ^:private syntheticName ^Name [this ^JCTree$JCClassDecl tree ^String baseName]
    (let [^:mutable valuesName (.fromString names (java-str (.syntheticNameChar target) baseName))]
      (while (some? (.findFirst (.members (.-sym tree)) valuesName))
        (set! valuesName (.fromString names (java-str valuesName "" (.syntheticNameChar target)))))
      valuesName))

  (method ^:private visitEnumConstantDef ^void [this ^JCTree$JCVariableDecl var ^int ordinal]
    (let [varDef (cast JCTree$JCNewClass (.-init var))]
      (set! (.-args varDef)
            (.prepend (.prepend (.-args varDef) (.makeLit this (.-intType syms) ordinal))
                      (.makeLit this (.-stringType syms) (.toString (.-name var)))))))

  (method ^:private recordVars ^{:tag (List Symbol$VarSymbol)} [this ^:mutable ^Type t]
    (let [^:mutable ^{:tag (List Symbol$VarSymbol)} vars (List/nil)]
      (while (not (.hasTag t TypeTag/NONE))
        (when (.hasTag t TypeTag/CLASS)
          (for-each [^Symbol s (.getSymbols (.members (.-tsym t))
                                            (lambda Predicate ^boolean [^Symbol s]
                                              (and
                                                (identical? (.-kind s) Kinds$Kind/VAR)
                                                (not (== (bit-and (.flags s) Flags/RECORD) 0)))))]
            (set! vars (.prepend vars (cast Symbol$VarSymbol s)))))
        (set! t (.supertype types t)))
      vars))

  (method ^:private visitRecordDef ^void [this ^JCTree$JCClassDecl tree]
    (.make_at this (.pos tree))
    (let [^{:tag (List Symbol$VarSymbol)} vars (.recordVars this (.-type tree))
          getterMethHandles (new Symbol$MethodHandleSymbol/1 (.size vars))
          ^:mutable ^int index 0]
      (for-each [^:mutable ^Symbol$VarSymbol var vars]
        (when-not (identical? (.-owner var) (.-sym tree))
          (set! var (Symbol$VarSymbol. (.-flags_field var) (.-name var) (.-type var) (.-sym tree))))
        (aset getterMethHandles index (.asMethodHandle var true))
        (set! index (unchecked-inc-int index)))
      (set! (.-defs tree) (.appendList (.-defs tree) (.generateMandatedAccessors this tree)))
      (set! (.-defs tree)
            (.appendList (.-defs tree)
                         (List/of (.generateRecordMethod
                                    this
                                    tree
                                    (.-toString names)
                                    vars
                                    getterMethHandles)
                                  (.generateRecordMethod
                                    this
                                    tree
                                    (.-hashCode names)
                                    vars
                                    getterMethHandles)
                                  (.generateRecordMethod
                                    this
                                    tree
                                    (.-equals names)
                                    vars
                                    getterMethHandles))))))

  (method generateRecordMethod ^JCTree [this ^JCTree$JCClassDecl tree ^Name name
                                        ^{:tag (List Symbol$VarSymbol)} vars
                                        ^Symbol$MethodHandleSymbol/1 getterMethHandles]
    (.make_at this (.pos tree))
    (let [isEquals (identical? name (.-equals names))
          msym (.lookupMethod this
                              (.pos tree)
                              name
                              (.-type (.-sym tree))
                              ^List (if isEquals (List/of (.-objectType syms)) (List/nil)))]
      (if (not (== (bit-and (.flags msym) Flags/RECORD) 0))
          (let [bootstrapName (.-bootstrap names)
                staticArgsValues (new PoolConstant$LoadableConstant/1
                                      (unchecked-add-int 2 (alength getterMethHandles)))]
            (aset staticArgsValues 0 (cast Type$ClassType (.-type (.-sym tree))))
            (let [concatNames (cast String
                                    (.collect (.map
                                                (.stream vars)
                                                (lambda Function ^Name [^Symbol$VarSymbol v]
                                                  (.-name v)))
                                              (Collectors/joining ";" "" "")))]
              (aset staticArgsValues 1 (PoolConstant$LoadableConstant/String concatNames))
              (let [^:mutable ^int index 2]
                (for-each [^Symbol$MethodHandleSymbol mho getterMethHandles]
                  (aset staticArgsValues index mho)
                  (set! index (unchecked-inc-int index)))
                (let [^{:tag (List Type)} staticArgTypes (List/of
                                                           (.-classType syms)
                                                           (.-stringType syms)
                                                           (Type$ArrayType.
                                                             (.-methodHandleType syms)
                                                             (.-arrayClass syms)))
                      qualifier (.makeIndyQualifier
                                  this
                                  (.-objectMethodsType syms)
                                  tree
                                  msym
                                  (.appendList (List/of
                                                 (.-methodHandleLookupType syms)
                                                 (.-stringType syms)
                                                 (.-typeDescriptorType syms))
                                               staticArgTypes)
                                  staticArgsValues
                                  bootstrapName
                                  name
                                  false)
                      _this (Symbol$VarSymbol. Flags/SYNTHETIC
                                               (.-_this names)
                                               (.-type (.-sym tree))
                                               (.-sym tree))
                      ^:mutable ^JCTree$JCMethodInvocation proxyCall nil]
                  (if (not isEquals)
                      (set! proxyCall
                            (.Apply make (List/nil) qualifier (List/of (.Ident make _this))))
                      (let [o (cast Symbol$VarSymbol (.-head (.-params msym)))]
                        (set! (.-adr o) 0)
                        (set! proxyCall
                              (.Apply make
                                      (List/nil)
                                      qualifier
                                      (List/of (.Ident make _this) (.Ident make o))))))
                  (set! (.-type proxyCall) (.-type qualifier))
                  (.MethodDef make msym (.Block make 0 (List/of (.Return make proxyCall))))))))
          (.Block make Flags/SYNTHETIC (List/nil)))))

  (method ^:private argsTypeSig ^String [this ^{:tag (List Type)} typeList]
    (let [sg (LowerSignatureGenerator.)] (.assembleSig sg typeList) (.toString sg)))

  (defclass ^:private LowerSignatureGenerator
    :extends Types$SignatureGenerator

    (field ^StringBuilder sb (StringBuilder.))

    (constructor [this] (.super types))

    (method ^:protected append ^void [this ^char ch] (.append sb ch))

    (method ^:protected append ^void [this ^byte/1 ba]
      (.append sb (String. ba)))

    (method ^:protected append ^void [this ^Name name]
      (.append sb (.toString name)))

    (method ^:public toString ^String [this] (.toString sb)))

  (method makeIndyQualifier ^JCTree$JCFieldAccess [this ^Type site ^JCTree$JCClassDecl tree
                                                   ^Symbol$MethodSymbol msym
                                                   ^{:tag (List Type)} staticArgTypes
                                                   ^PoolConstant$LoadableConstant/1 staticArgValues
                                                   ^Name bootstrapName ^Name argName
                                                   ^boolean isStatic]
    (let [bsm (.resolveInternalMethod rs
                                      (.pos tree)
                                      attrEnv
                                      site
                                      bootstrapName
                                      staticArgTypes
                                      (List/nil))
          ^:mutable indyType (.asMethodType (.-type msym))]
      (set! indyType
            (Type$MethodType.
              ^List (if isStatic (List/nil) (.prepend (.-argtypes indyType) (.-type (.-sym tree))))
              (.-restype indyType)
              (.-thrown indyType)
              (.-methodClass syms)))
      (let [dynSym (Symbol$DynamicMethodSymbol. argName
                                                (.-noSymbol syms)
                                                (.asHandle bsm)
                                                indyType
                                                staticArgValues)
            qualifier (.Select make (.QualIdent make (.-tsym site)) argName)]
        (set! (.-sym qualifier) dynSym)
        (set! (.-type qualifier) (.-restype (.asMethodType (.-type msym))))
        qualifier)))

  (method ^:public visitMethodDef ^void [this ^JCTree$JCMethodDecl tree]
    (when (and (identical? (.-name tree) (.-init names))
               (not (== (bit-and (.-flags_field currentClass) Flags/ENUM) 0)))
      (let [nameParam (.Param (.make_at this (.pos tree))
                              (.fromString names
                                           (java-str
                                             (.syntheticNameChar target)
                                             "enum"
                                             (.syntheticNameChar target)
                                             "name"))
                              (.-stringType syms)
                              (.-sym tree))]
        (let [o-4 (.-mods nameParam)] (set! (.-flags o-4) (bit-or (.-flags o-4) Flags/SYNTHETIC)))
        (let [o-5 (.-sym nameParam)]
          (set! (.-flags_field o-5) (bit-or (.-flags_field o-5) Flags/SYNTHETIC)))
        (let [ordParam (.Param make
                               (.fromString names
                                            (java-str
                                              (.syntheticNameChar target)
                                              "enum"
                                              (.syntheticNameChar target)
                                              "ordinal"))
                               (.-intType syms)
                               (.-sym tree))]
          (let [o-6 (.-mods ordParam)] (set! (.-flags o-6) (bit-or (.-flags o-6) Flags/SYNTHETIC)))
          (let [o-7 (.-sym ordParam)]
            (set! (.-flags_field o-7) (bit-or (.-flags_field o-7) Flags/SYNTHETIC)))
          (let [m (.-sym tree)]
            (set! (.-params tree) (.prepend (.prepend (.-params tree) ordParam) nameParam))
            (set! (.-extraParams m) (.prepend (.-extraParams m) (.-sym ordParam)))
            (set! (.-extraParams m) (.prepend (.-extraParams m) (.-sym nameParam)))
            (let [olderasure (.erasure m types)]
              (set! (.-erasure_field m)
                    (Type$MethodType.
                      (.prepend (.prepend (.getParameterTypes olderasure) (.-intType syms))
                                (.-stringType syms))
                      (.getReturnType olderasure)
                      (.getThrownTypes olderasure)
                      (.-methodClass syms))))))))
    (let [prevRestype currentRestype
          prevMethodDef currentMethodDef
          prevMethodSym currentMethodSym
          prevVariableIndex variableIndex]
      (try
        (set! currentRestype (.erasure types (.getReturnType (.-type tree))))
        (set! currentMethodDef tree)
        (set! currentMethodSym (.-sym tree))
        (set! variableIndex 0)
        (.visitMethodDefInternal this tree)
        (finally
          (set! currentRestype prevRestype)
          (set! currentMethodDef prevMethodDef)
          (set! currentMethodSym prevMethodSym)
          (set! variableIndex prevVariableIndex)))))

  (method ^:private visitMethodDefInternal ^void [this ^JCTree$JCMethodDecl tree]
    (if (and (and (identical? (.-name tree) (.-init names)) (not (.isStatic currentClass)))
             (or (.isInner currentClass) (.isDirectlyOrIndirectlyLocal currentClass)))
        (let [m (.-sym tree)
              ^{:tag (Map Symbol Symbol)} prevProxies proxies]
          (set! proxies (HashMap. proxies))
          (let [^{:tag (List Symbol$VarSymbol)} prevOuterThisStack outerThisStack
                ^{:tag (List Symbol$VarSymbol)} fvs (.freevars this currentClass)
                ^:mutable ^JCTree$JCVariableDecl otdef nil]
            (when (.hasOuterInstance currentClass) (set! otdef (.outerThisDef this (.-pos tree) m)))
            (let [^{:tag (List JCTree$JCVariableDecl)} fvdefs (.freevarDefs
                                                                this
                                                                (.-pos tree)
                                                                fvs
                                                                m
                                                                Flags/PARAMETER)]
              (set! (.-restype tree) (cast JCTree$JCExpression (.translate this (.-restype tree))))
              (set! (.-params tree) (.translateVarDefs this (.-params tree)))
              (set! (.-thrown tree) (.translate this (.-thrown tree)))
              (when (nil? (.-body tree)) (set! (.-result this) tree) (return))
              (set! (.-params tree) (.appendList (.-params tree) fvdefs))
              (when (.hasOuterInstance currentClass)
                (set! (.-params tree) (.prepend (.-params tree) otdef)))
              (let [invokesSuper (TreeInfo/hasConstructorCall tree (.-_super names))
                    ^:mutable ^{:tag (ListBuffer JCTree$JCStatement)} added (ListBuffer.)]
                (when (.nonEmpty fvs)
                  (let [^:mutable ^{:tag (List Type)} addedargtypes (List/nil)]
                    (loop [^{:tag (List Symbol$VarSymbol)} l fvs]
                      (when (.nonEmpty l)
                        (set! (.-capturedLocals m)
                              (.prepend (.-capturedLocals m)
                                        (cast Symbol$VarSymbol (.get proxies (.-head l)))))
                        (when invokesSuper
                          (set! added
                                (.prepend added
                                          (.initField
                                            this
                                            (.-pos (.-body tree))
                                            (cast Symbol (.get proxies (.-head l)))
                                            (cast Symbol (.get prevProxies (.-head l)))))))
                        (set! addedargtypes
                              (.prepend addedargtypes
                                        (.erasure (cast Symbol$VarSymbol (.-head l)) types)))
                        (recur (.-tail l))))
                    (let [olderasure (.erasure m types)]
                      (set! (.-erasure_field m)
                            (Type$MethodType.
                              (.appendList (.getParameterTypes olderasure) addedargtypes)
                              (.getReturnType olderasure)
                              (.getThrownTypes olderasure)
                              (.-methodClass syms))))))
                (set! (.-stats (.-body tree)) (.translate this (.-stats (.-body tree))))
                (when (.nonEmpty added)
                  (let [^{:tag (List JCTree$JCStatement)} initializers (.toList added)]
                    (TreeInfo/mapSuperCalls
                      (.-body tree)
                      (lambda Function ^JCTree$JCStatement [^JCTree$JCExpressionStatement supercall]
                        (.Block make 0 (.append initializers supercall))))))
                (set! proxies prevProxies)
                (set! outerThisStack prevOuterThisStack)))))
        (.visitMethodDef super tree))
    (when (and (identical? (.-name tree) (.-init names))
               (or (not (== (bit-and (.-flags_field (.-sym tree)) Flags/COMPACT_RECORD_CONSTRUCTOR)
                            0))
                   (== (bit-and (.-flags_field (.-sym tree))
                                (bit-or Flags/GENERATEDCONSTR Flags/RECORD))
                       (bit-or Flags/GENERATEDCONSTR Flags/RECORD))))
      (let [^{:tag (ListBuffer Symbol$VarSymbol)} fields (ListBuffer.)]
        (for-each [^Symbol sym (.getEnclosedElements currentClass)]
          (when (and (identical? (.-kind sym) Kinds$Kind/VAR)
                     (not (== (bit-and (.flags sym) Flags/RECORD) 0)))
            (.append fields (cast Symbol$VarSymbol sym))))
        (for-each [^Symbol$VarSymbol field fields]
          (when-not (== (bit-and (.-flags_field field) Flags/UNINITIALIZED_FIELD) 0)
            (let [param (.-sym (cast JCTree$JCVariableDecl
                                     (.get (.findFirst
                                             (.filter
                                               (.stream (.-params tree))
                                               (lambda Predicate ^boolean [^JCTree$JCVariableDecl p]
                                                 (identical? (.-name p) (.-name field))))))))]
              (.at make (.-pos tree))
              (set! (.-stats (.-body tree))
                    (.append (.-stats (.-body tree))
                             (.Exec make
                                    (.setType (.Assign
                                                make
                                                (.Select
                                                  make
                                                  (.This make (.erasure (.-owner field) types))
                                                  field)
                                                (.Ident make param))
                                              (.erasure field types)))))
              (set! (.-flags_field field)
                    (bit-and (.-flags_field field) (bit-not Flags/UNINITIALIZED_FIELD))))))))
    (set! (.-result this) tree))

  (method ^:public visitTypeCast ^void [this ^JCTree$JCTypeCast tree]
    (set! (.-clazz tree) (.translate this (.-clazz tree)))
    (if (not (= (.isPrimitive (.-type tree)) (.isPrimitive (.-type (.-expr tree)))))
        (set! (.-expr tree) (.translate this (.-expr tree) (.-type tree)))
        (set! (.-expr tree) (cast JCTree$JCExpression (.translate this (.-expr tree)))))
    (set! (.-result this) tree))

  (method ^:public visitTypeTest ^void [this ^JCTree$JCInstanceOf tree]
    (if (or (.isPrimitive (.-type (.-expr tree))) (.isPrimitive (.-type (.-pattern tree))))
        (let [^:mutable ^JCTree$JCStatement prefixStatement nil
              ^:mutable ^JCTree$JCExpression exactnessCheck nil
              instanceOfExpr (cast JCTree$JCExpression (.translate this (.-expr tree)))]
          (if (.isUnconditionallyExactTypeBased types
                                                (.-type (.-expr tree))
                                                (.-type (.-pattern tree)))
              (do
                (set! prefixStatement (.Exec make instanceOfExpr))
                (set! exactnessCheck
                      (.setType (.Literal make TypeTag/BOOLEAN (Integer/valueOf 1))
                                (.constType (.-booleanType syms) (Integer/valueOf 1)))))
              (arbace.core/cond (.isPrimitive (.-type (.-expr tree)))
                                (do
                                  (set! prefixStatement nil)
                                  (set! exactnessCheck
                                        (.getExactnessCheck this tree instanceOfExpr)))
                                (.isReference (.-type (.-expr tree)))
                                (if (.isUnconditionallyExactTypeBased
                                      types
                                      (.unboxedType types (.-type (.-expr tree)))
                                      (.-type (.-pattern tree)))
                                    (do
                                      (set! prefixStatement nil)
                                      (set! exactnessCheck
                                            (.makeBinary
                                              this
                                              JCTree$Tag/NE
                                              instanceOfExpr
                                              (.makeNull this))))
                                    (let [dollar_s (Symbol$VarSymbol.
                                                     (bit-or-int Flags/FINAL Flags/SYNTHETIC)
                                                     (.fromString
                                                       names
                                                       (java-str
                                                         "tmp"
                                                         (let [old-8 variableIndex]
                                                           (set!
                                                             variableIndex
                                                             (unchecked-inc-int variableIndex))
                                                           old-8)
                                                         (.syntheticNameChar (.-target this))))
                                                     (.erasure types (.-type (.-expr tree)))
                                                     currentMethodSym)]
                                      (set!
                                        prefixStatement
                                        (.VarDef (.at make (.pos tree)) dollar_s instanceOfExpr))
                                      (let [^JCTree$JCExpression nullCheck (.makeBinary
                                                                             this
                                                                             JCTree$Tag/NE
                                                                             (.Ident make dollar_s)
                                                                             (.makeNull this))]
                                        (if (.isPrimitive
                                              (.unboxedType types (.-type (.-expr tree))))
                                            (set!
                                              exactnessCheck
                                              (.makeBinary
                                                this
                                                JCTree$Tag/AND
                                                nullCheck
                                                (.getExactnessCheck
                                                  this
                                                  tree
                                                  (.boxIfNeeded
                                                    this
                                                    (.Ident make dollar_s)
                                                    (.unboxedType types (.-type (.-expr tree)))))))
                                            (set!
                                              exactnessCheck
                                              (.makeBinary
                                                this
                                                JCTree$Tag/AND
                                                nullCheck
                                                (.setType
                                                  (.TypeTest
                                                    (.at make (.pos tree))
                                                    (.Ident make dollar_s)
                                                    (.Type
                                                      make
                                                      (.-type
                                                        (.boxedClass
                                                          types
                                                          (.-type (.-pattern tree))))))
                                                  (.-booleanType syms))))))))
                                :else
                                (throw (Assert/error
                                         (java-str
                                           "Non primitive or reference type: "
                                           (.-type (.-expr tree)))))))
          (set! (.-result this)
                (.setType (if (nil? prefixStatement)
                              exactnessCheck
                              ^JCTree$JCExpression (.LetExpr
                                                     make
                                                     (List/of prefixStatement)
                                                     exactnessCheck))
                          (.-booleanType syms))))
        (do
          (set! (.-expr tree) (cast JCTree$JCExpression (.translate this (.-expr tree))))
          (set! (.-pattern tree) (.translate this (.-pattern tree)))
          (set! (.-result this) tree))))

  (defclass ^:record TypePairs [^Symbol$TypeSymbol from ^Symbol$TypeSymbol to]
    (method ^:public ^:static of ^TypePairs [^Symtab syms ^:mutable ^Type from ^Type to]
      (when (or (or (identical? from (.-byteType syms)) (identical? from (.-shortType syms)))
                (identical? from (.-charType syms)))
        (set! from (.-intType syms)))
      (TypePairs. from to))

    (constructor ^:public [this ^Type from ^Type to]
      (this. (.-tsym from) (.-tsym to)))

    (method ^:public ^:static initialize ^{:tag (HashMap TypePairs String)} [^Symtab syms]
      (let [^{:tag (HashMap TypePairs String)} typePairToName (HashMap.)]
        (.put typePairToName (TypePairs. (.-byteType syms) (.-charType syms)) "isIntToCharExact")
        (.put typePairToName (TypePairs. (.-shortType syms) (.-byteType syms)) "isIntToByteExact")
        (.put typePairToName (TypePairs. (.-shortType syms) (.-charType syms)) "isIntToCharExact")
        (.put typePairToName (TypePairs. (.-charType syms) (.-byteType syms)) "isIntToByteExact")
        (.put typePairToName (TypePairs. (.-charType syms) (.-shortType syms)) "isIntToShortExact")
        (.put typePairToName (TypePairs. (.-intType syms) (.-byteType syms)) "isIntToByteExact")
        (.put typePairToName (TypePairs. (.-intType syms) (.-shortType syms)) "isIntToShortExact")
        (.put typePairToName (TypePairs. (.-intType syms) (.-charType syms)) "isIntToCharExact")
        (.put typePairToName (TypePairs. (.-intType syms) (.-floatType syms)) "isIntToFloatExact")
        (.put typePairToName (TypePairs. (.-longType syms) (.-byteType syms)) "isLongToByteExact")
        (.put typePairToName (TypePairs. (.-longType syms) (.-shortType syms)) "isLongToShortExact")
        (.put typePairToName (TypePairs. (.-longType syms) (.-charType syms)) "isLongToCharExact")
        (.put typePairToName (TypePairs. (.-longType syms) (.-intType syms)) "isLongToIntExact")
        (.put typePairToName (TypePairs. (.-longType syms) (.-floatType syms)) "isLongToFloatExact")
        (.put typePairToName
              (TypePairs. (.-longType syms) (.-doubleType syms))
              "isLongToDoubleExact")
        (.put typePairToName (TypePairs. (.-floatType syms) (.-byteType syms)) "isFloatToByteExact")
        (.put typePairToName
              (TypePairs. (.-floatType syms) (.-shortType syms))
              "isFloatToShortExact")
        (.put typePairToName (TypePairs. (.-floatType syms) (.-charType syms)) "isFloatToCharExact")
        (.put typePairToName (TypePairs. (.-floatType syms) (.-intType syms)) "isFloatToIntExact")
        (.put typePairToName (TypePairs. (.-floatType syms) (.-longType syms)) "isFloatToLongExact")
        (.put typePairToName
              (TypePairs. (.-doubleType syms) (.-byteType syms))
              "isDoubleToByteExact")
        (.put typePairToName
              (TypePairs. (.-doubleType syms) (.-shortType syms))
              "isDoubleToShortExact")
        (.put typePairToName
              (TypePairs. (.-doubleType syms) (.-charType syms))
              "isDoubleToCharExact")
        (.put typePairToName (TypePairs. (.-doubleType syms) (.-intType syms)) "isDoubleToIntExact")
        (.put typePairToName
              (TypePairs. (.-doubleType syms) (.-longType syms))
              "isDoubleToLongExact")
        (.put typePairToName
              (TypePairs. (.-doubleType syms) (.-floatType syms))
              "isDoubleToFloatExact")
        typePairToName)))

  (method ^:private getExactnessCheck ^JCTree$JCExpression [this ^JCTree$JCInstanceOf tree
                                                            ^JCTree$JCExpression argument]
    (let [pair (TypePairs/of syms
                             (.unboxedTypeOrType types (.-type (.-expr tree)))
                             (.-type (.-pattern tree)))
          exactnessFunction (.fromString names (cast String (.get typePairToName pair)))
          ^Symbol ecsym (.lookupMethod this
                                       (.pos tree)
                                       exactnessFunction
                                       (.-exactConversionsSupportType syms)
                                       (List/of (.-type (.-from pair))))
          select (.Select make
                          (.QualIdent make (.-tsym (.-exactConversionsSupportType syms)))
                          exactnessFunction)]
      (set! (.-sym select) ecsym)
      (.setType select (.-booleanType syms))
      (let [^JCTree$JCExpression exactnessCheck (.Apply make (List/nil) select (List/of argument))]
        (.setType exactnessCheck (.-booleanType syms))
        exactnessCheck)))

  (method ^:public visitNewClass ^void [this ^JCTree$JCNewClass tree]
    (let [c (cast Symbol$ClassSymbol (.-owner (.-constructor tree)))
          isEnum (not (== (bit-and (.flags (.-owner (.-constructor tree))) Flags/ENUM) 0))
          ^:mutable ^{:tag (List Type)} argTypes (.getParameterTypes (.-type (.-constructor tree)))]
      (when isEnum
        (set! argTypes (.prepend (.prepend argTypes (.-intType syms)) (.-stringType syms))))
      (set! (.-args tree) (.boxArgs this argTypes (.-args tree) (.-varargsElement tree)))
      (set! (.-varargsElement tree) nil)
      (when (and (.isDirectlyOrIndirectlyLocal c) (not (.isStatic c)))
        (set! (.-args tree)
              (.appendList (.-args tree) (.loadFreevars this (.pos tree) (.freevars this c)))))
      (let [constructor (.accessConstructor this (.pos tree) (.-constructor tree))]
        (when-not (identical? constructor (.-constructor tree))
          (set! (.-args tree) (.append (.-args tree) (.makeNull this)))
          (set! (.-constructor tree) constructor))
        (when (.hasOuterInstance c)
          (let [^:mutable ^JCTree$JCExpression thisArg nil]
            (arbace.core/cond (some? (.-encl tree))
                              (do
                                (set! thisArg
                                      (.makeNullCheck
                                        attr
                                        (cast JCTree$JCExpression (.translate this (.-encl tree)))))
                                (set! (.-type thisArg) (.-type (.-encl tree))))
                              (.isDirectlyOrIndirectlyLocal c)
                              (set! thisArg
                                    (.makeThis this
                                               (.pos tree)
                                               (.innermostAccessibleEnclosingClass c)))
                              :else
                              (set! thisArg (.makeOwnerThis this (.pos tree) c false)))
            (set! (.-args tree) (.prepend (.-args tree) thisArg))))
        (set! (.-encl tree) nil)
        (if (some? (.-def tree))
            (do
              (.translate this (.-def tree))
              (set! (.-clazz tree)
                    (.access this
                             (.Ident (.make_at this (.pos (.-clazz tree))) (.-sym (.-def tree)))))
              (set! (.-def tree) nil))
            (set! (.-clazz tree) (.access this c (.-clazz tree) enclOp false)))
        (set! (.-result this) tree))))

  (method ^:private isTrue ^boolean [this ^JCTree exp]
    (if (.isTrue (.-type exp))
        true
        (let [b (.expValue this exp)] (if (nil? b) false (.booleanValue b)))))

  (method ^:private isFalse ^boolean [this ^JCTree exp]
    (if (.isFalse (.-type exp))
        true
        (let [b (.expValue this exp)] (if (nil? b) false (not (.booleanValue b))))))

  (method ^:private expValue ^Boolean [this ^:mutable ^JCTree exp]
    (while (.hasTag exp JCTree$Tag/PARENS) (set! exp (.-expr (cast JCTree$JCParens exp))))
    (let [^:mutable ^boolean eq false]
      (switch (.getTag exp) EQ (set! eq true) NE (set! eq false) (return nil))
      (let [b (cast JCTree$JCBinary exp)]
        (arbace.core/cond (.hasTag (.-type (.-lhs b)) TypeTag/BOT)
                          (.expValueIsNull this eq (.-rhs b))
                          (.hasTag (.-type (.-rhs b)) TypeTag/BOT)
                          (.expValueIsNull this eq (.-lhs b))))))

  (method ^:private expValueIsNull ^Boolean [this ^boolean eq ^JCTree t]
    (arbace.core/cond (.hasTag (.-type t) TypeTag/BOT)
                      (Boolean/valueOf eq)
                      (.hasTag t JCTree$Tag/LITERAL)
                      (Boolean/valueOf (not eq))))

  (method ^:public visitConditional ^void [this ^JCTree$JCConditional tree]
    (let [^JCTree cond (set! (.-cond tree) (.translate this (.-cond tree) (.-booleanType syms)))]
      (arbace.core/cond (and (.isTrue this cond) (.noClassDefIn this (.-falsepart tree)))
                        (do
                          (set! (.-result this)
                                (.convert this
                                          (.translate this (.-truepart tree) (.-type tree))
                                          (.-type tree)))
                          (.addPrunedInfo this cond))
                        (and (.isFalse this cond) (.noClassDefIn this (.-truepart tree)))
                        (do
                          (set! (.-result this)
                                (.convert this
                                          (.translate this (.-falsepart tree) (.-type tree))
                                          (.-type tree)))
                          (.addPrunedInfo this cond))
                        :else
                        (do
                          (set! (.-truepart tree) (.translate this (.-truepart tree) (.-type tree)))
                          (set! (.-falsepart tree)
                                (.translate this (.-falsepart tree) (.-type tree)))
                          (set! (.-result this) tree)))))

  (method ^:private convert ^JCTree$JCExpression [this ^JCTree$JCExpression tree ^Type pt]
    (if (or (identical? (.-type tree) pt) (.hasTag (.-type tree) TypeTag/BOT))
        tree
        (let [^JCTree$JCExpression result (.TypeCast
                                            (.make_at this (.pos tree))
                                            (.Type make pt)
                                            tree)]
          (set! (.-type result)
                (if (some? (.constValue (.-type tree))) (.coerce cfolder (.-type tree) pt) pt))
          result)))

  (method ^:public visitIf ^void [this ^JCTree$JCIf tree]
    (let [^JCTree cond (set! (.-cond tree) (.translate this (.-cond tree) (.-booleanType syms)))]
      (arbace.core/cond (and (.isTrue this cond) (.noClassDefIn this (.-elsepart tree)))
                        (do
                          (set! (.-result this) (.translate this (.-thenpart tree)))
                          (.addPrunedInfo this cond))
                        (and (.isFalse this cond) (.noClassDefIn this (.-thenpart tree)))
                        (do
                          (if (some? (.-elsepart tree))
                              (set! (.-result this) (.translate this (.-elsepart tree)))
                              (set! (.-result this) (.Skip make)))
                          (.addPrunedInfo this cond))
                        :else
                        (do
                          (set! (.-thenpart tree)
                                (cast JCTree$JCStatement (.translate this (.-thenpart tree))))
                          (set! (.-elsepart tree)
                                (cast JCTree$JCStatement (.translate this (.-elsepart tree))))
                          (set! (.-result this) tree)))))

  (method ^:public visitAssert ^void [this ^JCTree$JCAssert tree]
    (set! (.-cond tree) (.translate this (.-cond tree) (.-booleanType syms)))
    (if (not (.isTrue (.-type (.-cond tree))))
        (let [^:mutable cond (.assertFlagTest this (.pos tree))
              ^{:tag (List JCTree$JCExpression)} exnArgs (if (nil? (.-detail tree))
                                                             (List/nil)
                                                             (List/of
                                                               (cast
                                                                 JCTree$JCExpression
                                                                 (.translate this (.-detail tree)))))]
          (when-not (.isFalse (.-type (.-cond tree)))
            (set! cond
                  (.makeBinary this
                               JCTree$Tag/AND
                               cond
                               (.makeUnary this JCTree$Tag/NOT (.-cond tree)))))
          (set! (.-result this)
                (.If make
                     cond
                     (.Throw (.make_at this tree)
                             (.makeNewClass this (.-assertionErrorType syms) exnArgs))
                     nil)))
        (set! (.-result this) (.Skip make))))

  (method ^:public visitApply ^void [this ^JCTree$JCMethodInvocation tree]
    (let [meth (TreeInfo/symbol (.-meth tree))
          ^:mutable ^{:tag (List Type)} argtypes (.getParameterTypes (.-type meth))]
      (when (and (identical? (.-name meth) (.-init names))
                 (identical? (.-owner meth) (.-enumSym syms)))
        (set! argtypes (.-tail (.-tail argtypes))))
      (set! (.-args tree) (.boxArgs this argtypes (.-args tree) (.-varargsElement tree)))
      (set! (.-varargsElement tree) nil)
      (let [methName (TreeInfo/name (.-meth tree))]
        (if (identical? (.-name meth) (.-init names))
            (let [constructor (.accessConstructor this (.pos tree) meth)]
              (when-not (identical? constructor meth)
                (set! (.-args tree) (.append (.-args tree) (.makeNull this)))
                (TreeInfo/setSymbol (.-meth tree) constructor))
              (let [c (cast Symbol$ClassSymbol (.-owner constructor))]
                (when (and (.isDirectlyOrIndirectlyLocal c) (not (.isStatic c)))
                  (set! (.-args tree)
                        (.appendList (.-args tree)
                                     (.loadFreevars this (.pos tree) (.freevars this c)))))
                (when (or (not (== (bit-and (.-flags_field c) Flags/ENUM) 0))
                          (identical? (.getQualifiedName c) (.-java_lang_Enum names)))
                  (let [^:mutable ^{:tag (List JCTree$JCVariableDecl)} params (.-params
                                                                                currentMethodDef)]
                    (when (.hasOuterInstance (.-owner currentMethodSym))
                      (set! params (.-tail params)))
                    (set! (.-args tree)
                          (.prepend (.prepend (.-args tree)
                                              (.Ident
                                                (.make_at this (.pos tree))
                                                (.-sym
                                                  (cast
                                                    JCTree$JCVariableDecl
                                                    (.-head (.-tail params))))))
                                    (.Ident make
                                            (.-sym (cast JCTree$JCVariableDecl (.-head params))))))))
                (when (.hasOuterInstance c)
                  (let [^:mutable ^JCTree$JCExpression thisArg nil]
                    (if (.hasTag (.-meth tree) JCTree$Tag/SELECT)
                        (do
                          (set! thisArg
                                (.makeNullCheck attr
                                                (cast
                                                  JCTree$JCExpression
                                                  (.translate
                                                    this
                                                    (.-selected
                                                      (cast JCTree$JCFieldAccess (.-meth tree)))))))
                          (set! (.-meth tree) (.Ident make constructor))
                          (set! (.-name (cast JCTree$JCIdent (.-meth tree))) methName))
                        (arbace.core/cond
                          (or (.isDirectlyOrIndirectlyLocal c)
                              (identical? methName (.-_this names)))
                          (set! thisArg
                                (.makeThis this
                                           (.pos (.-meth tree))
                                           (.innermostAccessibleEnclosingClass c)))
                          (.isStatic currentClass)
                          (do
                            (.error log
                                    (.pos tree)
                                    (CompilerProperties$Errors/NoEnclInstanceOfTypeInScope
                                      (.-tsym (.getEnclosingType (.-type c)))))
                            (set! thisArg
                                  (.setType (.Literal make TypeTag/BOT nil) (.-botType syms))))
                          :else
                          (set! thisArg (.makeOwnerThisN this (.pos (.-meth tree)) c false))))
                    (set! (.-args tree) (.prepend (.-args tree) thisArg))))))
            (do
              (set! (.-meth tree) (cast JCTree$JCExpression (.translate this (.-meth tree))))
              (when (.hasTag (.-meth tree) JCTree$Tag/APPLY)
                (let [app (cast JCTree$JCMethodInvocation (.-meth tree))]
                  (set! (.-args app) (.prependList (.-args tree) (.-args app)))
                  (set! (.-result this) app)
                  (return)))))
        (when (.anyMatch (.stream (.-args tree))
                         (lambda Predicate ^boolean [^JCTree$JCExpression c] (nil? c)))
          (throw (AssertionError. (java-str "Whooops before: " tree))))
        (set! (.-result this) tree))))

  (method boxArgs ^{:tag (List JCTree$JCExpression)} [this ^:mutable ^{:tag (List Type)} parameters
                                                      ^{:tag (List JCTree$JCExpression)} _args
                                                      ^Type varargsElement]
    (let [^:mutable ^{:tag (List JCTree$JCExpression)} args _args]
      (if (.isEmpty parameters)
          args
          (let [^:mutable anyChanges false
                ^{:tag (ListBuffer JCTree$JCExpression)} result (ListBuffer.)]
            (while (.nonEmpty (.-tail parameters))
              (let [arg (.translate this
                                    (cast JCTree$JCExpression (.-head args))
                                    (cast Type (.-head parameters)))]
                (set!
                  anyChanges
                  (let [a-9 anyChanges b-10 (not (identical? arg (.-head args)))] (or a-9 b-10)))
                (.append result arg)
                (set! args (.-tail args))
                (set! parameters (.-tail parameters))))
            (let [parameter (cast Type (.-head parameters))]
              (if (some? varargsElement)
                  (do
                    (set! anyChanges true)
                    (let [^{:tag (ListBuffer JCTree$JCExpression)} elems (ListBuffer.)]
                      (while (.nonEmpty args)
                        (let [arg (.translate this
                                              (cast JCTree$JCExpression (.-head args))
                                              varargsElement)]
                          (.append elems arg)
                          (set! args (.-tail args))))
                      (let [boxedArgs (.NewArray
                                        make
                                        (.Type make varargsElement)
                                        (List/nil)
                                        (.toList elems))]
                        (set! (.-type boxedArgs)
                              (Type$ArrayType. varargsElement (.-arrayClass syms)))
                        (.append result boxedArgs))))
                  (do
                    (when-not (== (.length args) 1) (throw (AssertionError. args)))
                    (let [arg (.translate this (cast JCTree$JCExpression (.-head args)) parameter)]
                      (set! anyChanges
                            (let [a-11 anyChanges
                                  b-12 (not (identical? arg (.-head args)))]
                              (or a-11 b-12)))
                      (.append result arg)
                      (when-not anyChanges (return _args)))))
              (.toList result))))))

  (method boxIfNeeded :type-params [(T extends JCTree$JCExpression)] ^T [this ^:mutable ^T tree
                                                                         ^Type type]
    (Assert/check (not (.hasTag type TypeTag/VOID)))
    (if (.hasTag type TypeTag/NONE)
        tree
        (let [havePrimitive (.isPrimitive (.-type tree))]
          (if (= havePrimitive (.isPrimitive type))
              tree
              (do
                (if havePrimitive
                    (let [unboxedTarget (.unboxedType types type)]
                      (if (not (.hasTag unboxedTarget TypeTag/NONE))
                          (do
                            (when-not (.isSubtype types (.-type tree) unboxedTarget)
                              (set! (.-type tree)
                                    (.constType unboxedTarget (.constValue (.-type tree)))))
                            (return (.boxPrimitive this tree (.erasure types type))))
                          (set! tree (.boxPrimitive this tree))))
                    (set! tree (.unbox this tree type)))
                tree)))))

  (method boxPrimitive ^JCTree$JCExpression [this ^JCTree$JCExpression tree]
    (.boxPrimitive this tree (.-type (.boxedClass types (.-type tree)))))

  (method boxPrimitive ^JCTree$JCExpression [this ^JCTree$JCExpression tree ^Type box]
    (.make_at this (.pos tree))
    (let [^Symbol valueOfSym (.lookupMethod this
                                            (.pos tree)
                                            (.-valueOf names)
                                            box
                                            (.prepend (List/nil) (.-type tree)))]
      (.App make (.QualIdent make valueOfSym) (List/of tree))))

  (method unbox ^JCTree$JCExpression [this ^:mutable ^JCTree$JCExpression tree ^Type primitive]
    (let [^:mutable unboxedType (.unboxedType types (.-type tree))]
      (if (.hasTag unboxedType TypeTag/NONE)
          (do
            (set! unboxedType primitive)
            (when-not (.isPrimitive unboxedType) (throw (AssertionError. unboxedType)))
            (.make_at this (.pos tree))
            (set! tree (.TypeCast make (.-type (.boxedClass types unboxedType)) tree)))
          (when-not (.isSubtype types unboxedType primitive) (throw (AssertionError. tree))))
      (.make_at this (.pos tree))
      (let [^Symbol valueSym (.lookupMethod this
                                            (.pos tree)
                                            (.append (.-name (.-tsym unboxedType)) (.-Value names))
                                            (.-type tree)
                                            (List/nil))]
        (.App make (.Select make tree valueSym)))))

  (method ^:public visitParens ^void [this ^JCTree$JCParens tree]
    (let [expr (.translate this (.-expr tree))]
      (set! (.-result this) (if (identical? expr (.-expr tree)) ^JCTree tree expr))))

  (method ^:public visitIndexed ^void [this ^JCTree$JCArrayAccess tree]
    (set! (.-indexed tree) (cast JCTree$JCExpression (.translate this (.-indexed tree))))
    (set! (.-index tree) (.translate this (.-index tree) (.-intType syms)))
    (set! (.-result this) tree))

  (method ^:public visitAssign ^void [this ^JCTree$JCAssign tree]
    (set! (.-lhs tree) (cast JCTree$JCExpression (.translate this (.-lhs tree) tree)))
    (set! (.-rhs tree) (.translate this (.-rhs tree) (.-type (.-lhs tree))))
    (if (.hasTag (.-lhs tree) JCTree$Tag/APPLY)
        (let [app (cast JCTree$JCMethodInvocation (.-lhs tree))]
          (set! (.-args app) (.prependList (List/of (.-rhs tree)) (.-args app)))
          (set! (.-result this) app))
        (set! (.-result this) tree)))

  (method ^:public visitAssignop ^void [this ^:final ^JCTree$JCAssignOp tree]
    (let [boxingReq (and (not (.isPrimitive (.-type (.-lhs tree))))
                         (.isPrimitive (.getReturnType (.-type (.-operator tree)))))
          depScanner (AssignopDependencyScanner. tree)]
      (.scan depScanner (.-rhs tree))
      (if (or boxingReq (.-dependencyFound depScanner))
          (let [^JCTree newTree (.abstractLval
                                  this
                                  (.-lhs tree)
                                  (lambda TreeBuilder ^JCTree$JCExpression [^JCTree$JCExpression lhs]
                                    (let [newTag (.noAssignOp (.getTag tree))
                                          newOperator (.resolveBinary
                                                        operators
                                                        tree
                                                        newTag
                                                        (.-type tree)
                                                        (.-type (.-rhs tree)))
                                          ^:mutable expr (cast JCTree$JCExpression (.clone lhs))]
                                      (when-not (identical? (.-type expr) (.-type tree))
                                        (set! expr (.TypeCast make (.-type tree) expr)))
                                      (let [opResult (.Binary make newTag expr (.-rhs tree))]
                                        (set! (.-operator opResult) newOperator)
                                        (set! (.-type opResult)
                                              (.getReturnType (.-type newOperator)))
                                        (let [^JCTree$JCExpression newRhs (if boxingReq
                                                                              ^JCTree$JCExpression (.TypeCast
                                                                                                     make
                                                                                                     (.unboxedType
                                                                                                       types
                                                                                                       (.-type
                                                                                                         tree))
                                                                                                     opResult)
                                                                              ^JCTree$JCExpression opResult)]
                                          (.setType (.Assign make lhs newRhs) (.-type tree)))))))]
            (set! (.-result this) (.translate this newTree)))
          (do
            (set! (.-lhs tree) (cast JCTree$JCExpression (.translate this (.-lhs tree) tree)))
            (set! (.-rhs tree)
                  (.translate this
                              (.-rhs tree)
                              (cast Type
                                    (.-head
                                      (.-tail (.getParameterTypes (.-type (.-operator tree))))))))
            (if (.hasTag (.-lhs tree) JCTree$Tag/APPLY)
                (let [app (cast JCTree$JCMethodInvocation (.-lhs tree))
                      ^JCTree$JCExpression rhs (if (==
                                                     (.-opcode (.-operator tree))
                                                     ByteCodes/string_add)
                                                   (.makeString this (.-rhs tree))
                                                   (.-rhs tree))]
                  (set! (.-args app) (.prependList (List/of rhs) (.-args app)))
                  (set! (.-result this) app))
                (set! (.-result this) tree))))))

  (defclass AssignopDependencyScanner
    :extends TreeScanner

    (field ^Symbol sym)

    (field ^boolean dependencyFound false)

    (constructor [this ^JCTree$JCAssignOp tree]
      (set! (.-sym this) (TreeInfo/symbol (.-lhs tree))))

    (method ^:public scan ^void [this ^JCTree tree]
      (when (and (some? tree) (some? sym)) (.accept tree this)))

    (method ^:public visitAssignop ^void [this ^JCTree$JCAssignOp tree]
      (if (identical? (TreeInfo/symbol (.-lhs tree)) sym)
          (set! dependencyFound true)
          (.visitAssignop super tree)))

    (method ^:public visitUnary ^void [this ^JCTree$JCUnary tree]
      (if (identical? (TreeInfo/symbol (.-arg tree)) sym)
          (set! dependencyFound true)
          (.visitUnary super tree))))

  (method lowerBoxedPostop ^JCTree$JCExpression [this ^:final ^JCTree$JCUnary tree]
    (let [cast (.hasTag (TreeInfo/skipParens (.-arg tree)) JCTree$Tag/TYPECAST)]
      (.abstractLval
        this
        (.-arg tree)
        (lambda TreeBuilder ^JCTree$JCExpression [^JCTree$JCExpression tmp1]
          (.abstractRval
            this
            tmp1
            (.-type (.-arg tree))
            (lambda TreeBuilder ^JCTree$JCExpression [^JCTree$JCExpression tmp2]
              (let [^JCTree$Tag opcode (if (.hasTag tree JCTree$Tag/POSTINC)
                                           JCTree$Tag/PLUS_ASG
                                           JCTree$Tag/MINUS_ASG)
                    ^:mutable lhs (arbace.core/cast JCTree$JCExpression (.clone tmp1))]
                (set! lhs
                      (if cast ^JCTree$JCExpression (.TypeCast make (.-type (.-arg tree)) lhs) lhs))
                (let [^JCTree$JCExpression update (.makeAssignop
                                                    this
                                                    opcode
                                                    lhs
                                                    (.Literal make (Integer/valueOf 1)))]
                  (.makeComma this update tmp2)))))))))

  (method ^:public visitUnary ^void [this ^JCTree$JCUnary tree]
    (let [isUpdateOperator (.isIncOrDecUnaryOp (.getTag tree))]
      (when (and isUpdateOperator (not (.isPrimitive (.-type (.-arg tree)))))
        (switch (.getTag tree)
          (PREINC PREDEC)
            (let [^JCTree$Tag opcode (if (.hasTag tree JCTree$Tag/PREINC)
                                         JCTree$Tag/PLUS_ASG
                                         JCTree$Tag/MINUS_ASG)
                  newTree (.makeAssignop this
                                         opcode
                                         (.-arg tree)
                                         (.Literal make (Integer/valueOf 1)))]
              (set! (.-result this) (.translate this newTree (.-type tree)))
              (return))
          (POSTINC POSTDEC)
            (do
              (set! (.-result this) (.translate this (.lowerBoxedPostop this tree) (.-type tree)))
              (return)))
        (throw (AssertionError. tree)))
      (set! (.-arg tree)
            (.boxIfNeeded this

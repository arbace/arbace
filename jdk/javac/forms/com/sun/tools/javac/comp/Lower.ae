               (identical? tree
                           (TreeInfo/skipParens
                             (.getOperand (cast JCTree$JCOperatorExpression enclOp)
                                          JCTree$JCOperatorExpression$OperandPos/LEFT))))
          (.getAccessCode (.-operator (cast JCTree$JCOperatorExpression enclOp)) (.getTag enclOp))
          :else
          (.-code Symbol$OperatorSymbol$AccessCode/DEREF))))

  (method ^:private binaryAccessOperator ^Symbol$OperatorSymbol [this ^int acode ^JCTree$Tag tag]
    (.lookupBinaryOp operators
                     (lambda Predicate ^boolean [^Symbol$OperatorSymbol op]
                       (== (.getAccessCode op tag) acode))))

  (method ^:private ^:static treeTag ^JCTree$Tag [^Symbol$OperatorSymbol operator]
    (switch (.-opcode operator)
      (ByteCodes/ior ByteCodes/lor) JCTree$Tag/BITOR_ASG
      (ByteCodes/ixor ByteCodes/lxor) JCTree$Tag/BITXOR_ASG
      (ByteCodes/iand ByteCodes/land) JCTree$Tag/BITAND_ASG
      (ByteCodes/ishl ByteCodes/lshl ByteCodes/ishll ByteCodes/lshll) JCTree$Tag/SL_ASG
      (ByteCodes/ishr ByteCodes/lshr ByteCodes/ishrl ByteCodes/lshrl) JCTree$Tag/SR_ASG
      (ByteCodes/iushr ByteCodes/lushr ByteCodes/iushrl ByteCodes/lushrl) JCTree$Tag/USR_ASG
      (ByteCodes/iadd ByteCodes/ladd ByteCodes/fadd ByteCodes/dadd ByteCodes/string_add)
        JCTree$Tag/PLUS_ASG
      (ByteCodes/isub ByteCodes/lsub ByteCodes/fsub ByteCodes/dsub) JCTree$Tag/MINUS_ASG
      (ByteCodes/imul ByteCodes/lmul ByteCodes/fmul ByteCodes/dmul) JCTree$Tag/MUL_ASG
      (ByteCodes/idiv ByteCodes/ldiv ByteCodes/fdiv ByteCodes/ddiv) JCTree$Tag/DIV_ASG
      (ByteCodes/imod ByteCodes/lmod ByteCodes/fmod ByteCodes/dmod) JCTree$Tag/MOD_ASG
      (throw (AssertionError.))))

  (method accessName ^Name [this ^int anum ^int acode]
    (.fromString names
                 (java-str "access"
                           (.syntheticNameChar target)
                           anum
                           (unchecked-divide-int acode 10)
                           (unchecked-remainder-int acode 10))))

  (method accessSymbol ^Symbol$MethodSymbol [this ^Symbol sym ^JCTree tree ^JCTree enclOp
                                             ^boolean protAccess ^boolean refSuper]
    (let [^Symbol$ClassSymbol accOwner (if (and refSuper protAccess)
                                           (cast
                                             Symbol$ClassSymbol
                                             (.-tsym
                                               (.-type
                                                 (.-selected (cast JCTree$JCFieldAccess tree)))))
                                           (.accessClass this sym protAccess tree))
          ^:mutable vsym sym]
      (when-not (identical? (.-owner sym) accOwner)
        (set! vsym (.clone sym accOwner))
        (.put actualSymbols vsym sym))
      (let [^:mutable anum (cast Integer (.get accessNums vsym))]
        (when (nil? anum)
          (set! anum (.length accessed))
          (.put accessNums vsym anum)
          (.put accessSyms
                vsym
                (new Symbol$MethodSymbol/1 Symbol$OperatorSymbol$AccessCode/numberOfAccessCodes))
          (.append accessed vsym))
        (let [^:mutable ^int acode 0
              ^:mutable ^{:tag (List Type)} argtypes nil
              ^:mutable ^Type restype nil
              ^:mutable ^{:tag (List Type)} thrown nil]
          (switch (.-kind vsym)
            VAR
              (do
                (set! acode (Lower/accessCode tree enclOp))
                (arbace.core/cond
                  (>= acode (.-code Symbol$OperatorSymbol$AccessCode/FIRSTASGOP))
                  (let [operator (.binaryAccessOperator this acode (.getTag enclOp))]
                    (if (== (.-opcode operator) ByteCodes/string_add)
                        (set! argtypes (List/of (.-objectType syms)))
                        (set! argtypes (.-tail (.getParameterTypes (.-type operator))))))
                  (== acode (.-code Symbol$OperatorSymbol$AccessCode/ASSIGN))
                  (set! argtypes (List/of (.erasure vsym types)))
                  :else
                  (set! argtypes (List/nil)))
                (set! restype (.erasure vsym types))
                (set! thrown (List/nil)))
            MTH
              (do
                (set! acode (.-code Symbol$OperatorSymbol$AccessCode/DEREF))
                (set! argtypes (.getParameterTypes (.erasure vsym types)))
                (set! restype (.getReturnType (.erasure vsym types)))
                (set! thrown (.getThrownTypes (.-type vsym))))
            (throw (AssertionError.)))
          (when (and protAccess refSuper) (set! acode (unchecked-inc-int acode)))
          (when (== (bit-and (.flags vsym) Flags/STATIC) 0)
            (set! argtypes (.prepend argtypes (.erasure (.-owner vsym) types))))
          (let [accessors (cast Symbol$MethodSymbol/1 (.get accessSyms vsym))
                ^:mutable accessor (aget accessors acode)]
            (when (nil? accessor)
              (set! accessor
                    (Symbol$MethodSymbol.
                      (bit-or-int (bit-or-int Flags/STATIC Flags/SYNTHETIC)
                                  (if (.isInterface accOwner) Flags/PUBLIC 0))
                      (.accessName this (.intValue anum) acode)
                      (Type$MethodType. argtypes restype thrown (.-methodClass syms))
                      accOwner))
              (.enterSynthetic this (.pos tree) accessor (.members accOwner))
              (aset accessors acode accessor))
            accessor)))))

  (method accessBase ^JCTree$JCExpression [this ^JCDiagnostic$DiagnosticPosition pos ^Symbol sym]
    (if (not (== (bit-and (.flags sym) Flags/STATIC) 0))
        (.access this (.QualIdent (.at make (.getStartPosition pos)) (.-owner sym)))
        (.makeOwnerThis this pos sym true)))

  (method needsPrivateAccess ^boolean [this ^Symbol sym]
    (if (.hasNestmateAccess target)
        false
        (arbace.core/cond
          (or (== (bit-and (.flags sym) Flags/PRIVATE) 0) (identical? (.-owner sym) currentClass))
          false
          (and (identical? (.-name sym) (.-init names))
               (.isDirectlyOrIndirectlyLocal (.-owner sym)))
          (do
            (set! (.-flags_field sym) (bit-and (.-flags_field sym) (bit-not-int Flags/PRIVATE)))
            false)
          :else
          true)))

  (method needsProtectedAccess ^boolean [this ^Symbol sym ^JCTree tree]
    (arbace.core/cond disableProtectedAccessors
                      false
                      (or (or (== (bit-and (.flags sym) Flags/PROTECTED) 0)
                              (identical? (.-owner (.-owner sym)) (.-owner currentClass)))
                          (identical? (.packge sym) (.packge currentClass)))
                      false
                      :else
                      (arbace.core/cond (not (.isSubClass currentClass (.-owner sym) types))
                                        true
                                        (or (or (not (== (bit-and (.flags sym) Flags/STATIC) 0))
                                                (not (.hasTag tree JCTree$Tag/SELECT)))
                                            (identical?
                                              (TreeInfo/name
                                                (.-selected (cast JCTree$JCFieldAccess tree)))
                                              (.-_super names)))
                                        false
                                        :else
                                        (not (.isSubClass
                                               (.-tsym
                                                 (.-type
                                                   (.-selected (cast JCTree$JCFieldAccess tree))))
                                               currentClass
                                               types)))))

  (method accessClass ^Symbol$ClassSymbol [this ^Symbol sym ^boolean protAccess ^JCTree tree]
    (if protAccess
        (let [^:mutable ^Symbol qualifier nil
              ^:mutable c currentClass]
          (if (and (.hasTag tree JCTree$Tag/SELECT) (== (bit-and (.flags sym) Flags/STATIC) 0))
              (do
                (set! qualifier (.-tsym (.-type (.-selected (cast JCTree$JCFieldAccess tree)))))
                (while (not (.isSubClass qualifier c types)) (set! c (.enclClass (.-owner c))))
                c)
              (do
                (while (not (.isSubClass c (.-owner sym) types)) (set! c (.enclClass (.-owner c))))
                c)))
        (.enclClass (.-owner sym))))

  (method ^:private noClassDefIn ^boolean [this ^JCTree tree]
    (let [scanner (anon TreeScanner []
                    (field ^boolean noClassDef true)

                    (method ^:public visitClassDef ^void [this ^JCTree$JCClassDecl tree]
                      (set! noClassDef false)))]
      (.scan scanner tree)
      (.-noClassDef scanner)))

  (method ^:private addPrunedInfo ^void [this ^JCTree tree]
    (let [^:mutable ^{:tag (List JCTree)} infoList (cast List (.get prunedTree currentClass))]
      (set! infoList (if (nil? infoList) (List/of tree) (.prepend infoList tree)))
      (.put prunedTree currentClass infoList)))

  (method access ^JCTree$JCExpression [this ^:mutable ^Symbol sym
                                       ^:mutable ^JCTree$JCExpression tree
                                       ^JCTree$JCExpression enclOp ^boolean refSuper]
    (while (and (and (identical? (.-kind sym) Kinds$Kind/VAR)
                     (identical? (.-kind (.-owner sym)) Kinds$Kind/MTH))
                (not (identical? (.enclClass (.-owner sym)) currentClass)))
      (let [cv (.getConstValue (cast Symbol$VarSymbol sym))]
        (when (some? cv) (.at make (.-pos tree)) (return (.makeLit this (.-type sym) cv)))
        (set! sym (cast Symbol (.get proxies sym)))
        (Assert/check (and (some? sym) (not (== (bit-and (.-flags_field sym) Flags/FINAL) 0))))
        (set! tree (.Ident (.at make (.-pos tree)) sym))))
    (let [^:mutable ^JCTree$JCExpression base (when (.hasTag tree JCTree$Tag/SELECT)
                                                (.-selected (cast JCTree$JCFieldAccess tree)))]
      (switch (.-kind sym)
        TYP
          (when-not (identical? (.-kind (.-owner sym)) Kinds$Kind/PCK)
            (let [flatname (Convert/shortName (.flatName sym))]
              (while (and (and (some? base) (some? (TreeInfo/symbol base)))
                          (not (identical? (.-kind (TreeInfo/symbol base)) Kinds$Kind/PCK)))
                (set! base
                      (when (.hasTag base JCTree$Tag/SELECT)
                        (.-selected (cast JCTree$JCFieldAccess base)))))
              (arbace.core/cond (.hasTag tree JCTree$Tag/IDENT)
                                (set! (.-name (cast JCTree$JCIdent tree)) flatname)
                                (nil? base)
                                (do
                                  (set! tree (.Ident (.at make (.-pos tree)) sym))
                                  (set! (.-name (cast JCTree$JCIdent tree)) flatname))
                                :else
                                (do
                                  (set! (.-selected (cast JCTree$JCFieldAccess tree)) base)
                                  (set! (.-name (cast JCTree$JCFieldAccess tree)) flatname)))))
        (MTH VAR)
          (when (identical? (.-kind (.-owner sym)) Kinds$Kind/TYP)
            (let [protAccess (or (and refSuper (not (.needsPrivateAccess this sym)))
                                 (.needsProtectedAccess this sym tree))
                  accReq (or protAccess (.needsPrivateAccess this sym))
                  baseReq (and (and (nil? base)
                                    (not (identical? (.-owner sym) (.-predefClass syms))))
                               (not (.isMemberOf sym currentClass types)))]
              (when (or accReq baseReq)
                (.at make (.-pos tree))
                (when (identical? (.-kind sym) Kinds$Kind/VAR)
                  (let [cv (.getConstValue (cast Symbol$VarSymbol sym))]
                    (when (some? cv)
                      (.addPrunedInfo this tree)
                      (return (.makeLit this (.-type sym) cv)))))
                (arbace.core/cond
                  accReq
                  (let [^:mutable ^{:tag (List JCTree$JCExpression)} args (List/nil)]
                    (when (== (bit-and (.flags sym) Flags/STATIC) 0)
                      (when (nil? base) (set! base (.makeOwnerThis this (.pos tree) sym true)))
                      (set! args (.prepend args base))
                      (set! base nil))
                    (let [^Symbol access (.accessSymbol this sym tree enclOp protAccess refSuper)
                          ^JCTree$JCExpression receiver (.Select
                                                          make
                                                          ^JCTree$JCExpression (if (some? base)
                                                                                   base
                                                                                   (.QualIdent
                                                                                     make
                                                                                     (.-owner
                                                                                       access)))
                                                          access)]
                      (return (.App make receiver args))))
                  baseReq
                  (return (.setType (.Select (.at make (.-pos tree))
                                             (.accessBase this (.pos tree) sym)
                                             sym)
                                    (.-type tree))))))))
      tree))

  (method access ^JCTree$JCExpression [this ^JCTree$JCExpression tree]
    (let [sym (TreeInfo/symbol tree)] (if (nil? sym) tree (.access this sym tree nil false))))

  (method accessConstructor ^Symbol [this ^JCDiagnostic$DiagnosticPosition pos ^Symbol constr]
    (if (.needsPrivateAccess this constr)
        (let [accOwner (.enclClass (.-owner constr))
              ^:mutable aconstr (cast Symbol$MethodSymbol (.get accessConstrs constr))]
          (when (nil? aconstr)
            (let [^:mutable ^{:tag (List Type)} argtypes (.getParameterTypes (.-type constr))]
              (when-not (== (bit-and (.-flags_field accOwner) Flags/ENUM) 0)
                (set! argtypes (.prepend (.prepend argtypes (.-intType syms)) (.-stringType syms))))
              (set! aconstr
                    (Symbol$MethodSymbol. Flags/SYNTHETIC
                                          (.-init names)
                                          (Type$MethodType.
                                            (.append
                                              argtypes
                                              (.erasure (.accessConstructorTag this) types))
                                            (.getReturnType (.-type constr))
                                            (.getThrownTypes (.-type constr))
                                            (.-methodClass syms))
                                          accOwner))
              (.enterSynthetic this pos aconstr (.members accOwner))
              (.put accessConstrs constr aconstr)
              (.append accessed constr)))
          aconstr)
        constr))

  (method accessConstructorTag ^Symbol$ClassSymbol [this]
    (let [topClass (.outermostClass currentClass)
          topModle (.-modle (.packge topClass))]
      (loop [^int i 1]
        (let [flatname (.fromString names
                                    (java-str ""
                                              (.getQualifiedName topClass)
                                              (.syntheticNameChar target)
                                              i))
              ^:mutable ctag (.getCompiled chk topModle flatname)]
          (if (nil? ctag)
              (set! ctag
                    (.-sym
                      (.makeEmptyClass this (bit-or-int Flags/STATIC Flags/SYNTHETIC) topClass)))
              (when-not (.isAnonymous ctag) (continue (unchecked-inc-int i))))
          (set! accessConstrTags (.prepend accessConstrTags ctag))
          (return ctag)))))

  (method makeAccessible ^void [this ^Symbol sym]
    (let [cdef (.classDef this (.enclClass (.-owner sym)))]
      (when (nil? cdef) (Assert/error (java-str "class def not found: " sym " in " (.-owner sym))))
      (if (identical? (.-name sym) (.-init names))
          (set! (.-defs cdef)
                (.prepend (.-defs cdef)
                          (.accessConstructorDef
                            this
                            (.-pos cdef)
                            sym
                            (cast Symbol$MethodSymbol (.get accessConstrs sym)))))
          (let [accessors (cast Symbol$MethodSymbol/1 (.get accessSyms sym))]
            (loop [^int i 0]
              (if (< i Symbol$OperatorSymbol$AccessCode/numberOfAccessCodes)
                  (if (some? (aget accessors i))
                      (do
                        (set! (.-defs cdef)
                              (.prepend (.-defs cdef)
                                        (.accessDef this (.-pos cdef) sym (aget accessors i) i)))
                        (recur (unchecked-inc-int i)))
                      (recur (unchecked-inc-int i)))
                  nil))))))

  (method accessDef ^JCTree [this ^int pos ^Symbol vsym ^Symbol$MethodSymbol accessor ^int acode]
    (set! currentClass (.enclClass (.-owner vsym)))
    (.at make pos)
    (let [md (.MethodDef make accessor nil)
          ^:mutable sym (cast Symbol (.get actualSymbols vsym))]
      (when (nil? sym) (set! sym vsym))
      (let [^:mutable ^JCTree$JCExpression ref nil
            ^:mutable ^{:tag (List JCTree$JCExpression)} args nil]
        (if (not (== (bit-and (.flags sym) Flags/STATIC) 0))
            (do (set! ref (.Ident make sym)) (set! args (.Idents make (.-params md))))
            (let [site (.Ident make (cast JCTree$JCVariableDecl (.-head (.-params md))))]
              (when-not (== (unchecked-remainder-int acode 2) 0)
                (.setType site
                          (.erasure types (.supertype types (.-type (.enclClass (.-owner vsym)))))))
              (set! ref (.Select make site sym))
              (set! args (.Idents make (.-tail (.-params md))))))
        (let [^:mutable ^JCTree$JCStatement stat nil]
          (if (identical? (.-kind sym) Kinds$Kind/VAR)
              (let [acode1 (unchecked-subtract-int acode (bit-and-int acode 1))
                    ^:mutable ^JCTree$JCExpression expr nil
                    aCode (Symbol$OperatorSymbol$AccessCode/getFromCode acode1)]
                (switch aCode
                  DEREF (set! expr ref)
                  ASSIGN (set! expr (.Assign make ref (cast JCTree$JCExpression (.-head args))))
                  (PREINC POSTINC PREDEC POSTDEC) (set! expr (.makeUnary this (.-tag aCode) ref))
                  (do
                    (set! expr
                          (.Assignop make
                                     (Lower/treeTag
                                       (.binaryAccessOperator this acode1 JCTree$Tag/NO_TAG))
                                     ref
                                     (cast JCTree (.-head args))))
                    (set! (.-operator (cast JCTree$JCAssignOp expr))
                          (.binaryAccessOperator this acode1 JCTree$Tag/NO_TAG))))
                (set! stat (.Return make (.setType expr (.-type sym)))))
              (set! stat (.Call make (.App make ref args))))
          (set! (.-body md) (.Block make 0 (List/of stat)))
          (loop [^{:tag (List JCTree$JCVariableDecl)} l (.-params md)]
            (when (.nonEmpty l)
              (set! (.-vartype (cast JCTree$JCVariableDecl (.-head l)))
                    (.access this (.-vartype (cast JCTree$JCVariableDecl (.-head l)))))
              (recur (.-tail l))))
          (set! (.-restype md) (.access this (.-restype md)))
          (loop [^{:tag (List JCTree$JCExpression)} l (.-thrown md)]
            (when (.nonEmpty l)
              (set! (.-head l) (.access this (cast JCTree$JCExpression (.-head l))))
              (recur (.-tail l))))
          md))))

  (method accessConstructorDef ^JCTree [this ^int pos ^Symbol constr ^Symbol$MethodSymbol accessor]
    (.at make pos)
    (let [md (.MethodDef make accessor (.externalType accessor types) nil)
          callee (.Ident make (.-_this names))]
      (set! (.-sym callee) constr)
      (set! (.-type callee) (.-type constr))
      (set! (.-body md)
            (.Block make
                    0
                    (List/of (.Call make
                                    (.App make
                                          callee
                                          (.Idents
                                            make
                                            (.reverse (.-tail (.reverse (.-params md))))))))))
      md))

  (field ^{:tag (Map Symbol Symbol)} proxies)

  (field ^Scope$WriteableScope twrVars)

  (field ^{:tag (List Symbol$VarSymbol)} outerThisStack)

  (method proxyName ^Name [this ^Name name ^int index]
    (let [^:mutable proxyName (.fromString names (java-str "val" (.syntheticNameChar target) name))]
      (when (> index 0)
        (set! proxyName
              (.append proxyName
                       (.fromString names (java-str "" (.syntheticNameChar target) index)))))
      proxyName))

  (method freevarDefs ^{:tag (List JCTree$JCVariableDecl)} [this ^int pos
                                                            ^{:tag (List Symbol$VarSymbol)} freevars
                                                            ^Symbol owner]
    (.freevarDefs this pos freevars owner Flags/LOCAL_CAPTURE_FIELD))

  (method freevarDefs ^{:tag (List JCTree$JCVariableDecl)} [this ^int pos
                                                            ^{:tag (List Symbol$VarSymbol)} freevars
                                                            ^Symbol owner ^long additionalFlags]
    (let [flags (bit-or (bit-or-int Flags/FINAL Flags/SYNTHETIC) additionalFlags)
          ^:mutable ^{:tag (List JCTree$JCVariableDecl)} defs (List/nil)
          ^{:tag (Set Name)} proxyNames (HashSet.)]
      (loop [^{:tag (List Symbol$VarSymbol)} l freevars]
        (when (.nonEmpty l)
          (let [v (cast Symbol$VarSymbol (.-head l))
                ^:mutable ^int index 0
                ^:mutable ^Name proxyName nil]
            (loop []
              (set! proxyName (.proxyName this (.-name v) index))
              (set! index (unchecked-inc-int index))
              (when-not (.add proxyNames proxyName) (recur)))
            (let [^Symbol$VarSymbol proxy (anon Symbol$VarSymbol [flags
                                                                  proxyName
                                                                  (.erasure v types)
                                                                  owner]
                                            (method ^:public baseSymbol ^Symbol [this] v))]
              (.put proxies v proxy)
              (let [vd (.VarDef (.at make pos) proxy nil)]
                (set! (.-vartype vd) (.access this (.-vartype vd)))
                (set! defs (.prepend defs vd))
                (recur (.-tail l)))))))
      defs))

  (method outerThisName ^Name [this ^Type type ^Symbol owner]
    (let [^:mutable t (.getEnclosingType type)
          ^:mutable ^int nestingLevel 0]
      (while (.hasTag t TypeTag/CLASS)
        (set! t (.getEnclosingType t))
        (set! nestingLevel (unchecked-inc-int nestingLevel)))
      (let [^:mutable result (.fromString
                               names
                               (java-str "this" (.syntheticNameChar target) nestingLevel))]
        (while (and (identical? (.-kind owner) Kinds$Kind/TYP)
                    (some? (.findFirst (.members (cast Symbol$ClassSymbol owner)) result)))
          (set! result
                (.fromString names (java-str (.toString result) (.syntheticNameChar target)))))
        result)))

  (method ^:private makeOuterThisVarSymbol ^Symbol$VarSymbol [this ^Symbol owner ^long flags]
    (let [target (.erasure (.innermostAccessibleEnclosingClass owner) types)
          outerThis (Symbol$VarSymbol. (bit-or flags Flags/NOOUTERTHIS)
                                       (.outerThisName this target owner)
                                       target
                                       owner)]
      (set! outerThisStack (.prepend outerThisStack outerThis))
      outerThis))

  (method ^:private makeOuterThisVarDecl ^JCTree$JCVariableDecl [this ^int pos ^Symbol$VarSymbol sym]
    (let [vd (.VarDef (.at make pos) sym nil)]
      (set! (.-vartype vd) (.access this (.-vartype vd)))
      vd))

  (method outerThisDef ^JCTree$JCVariableDecl [this ^int pos ^Symbol$MethodSymbol owner]
    (let [c (.enclClass owner)
          isMandated (or (and (.isConstructor owner) (.isAnonymous owner))
                         (and (and (and (.isConstructor owner) (.isInner c)) (not (.isPrivate c)))
                              (not (.isStatic c))))
          flags (bit-or (bit-or-int Flags/FINAL (if isMandated Flags/MANDATED Flags/SYNTHETIC))
                        Flags/PARAMETER)
          outerThis (.makeOuterThisVarSymbol this owner flags)]
      (set! (.-extraParams owner) (.prepend (.-extraParams owner) outerThis))
      (.makeOuterThisVarDecl this pos outerThis)))

  (method outerThisDef ^JCTree$JCVariableDecl [this ^int pos ^Symbol$ClassSymbol owner]
    (let [outerThis (.makeOuterThisVarSymbol this owner (bit-or-int Flags/FINAL Flags/SYNTHETIC))]
      (.makeOuterThisVarDecl this pos outerThis)))

  (method loadFreevars ^{:tag (List JCTree$JCExpression)} [this ^JCDiagnostic$DiagnosticPosition pos
                                                           ^{:tag (List Symbol$VarSymbol)} freevars]
    (let [^:mutable ^{:tag (List JCTree$JCExpression)} args (List/nil)]
      (loop [^{:tag (List Symbol$VarSymbol)} l freevars]
        (when (.nonEmpty l)
          (set! args (.prepend args (.loadFreevar this pos (cast Symbol$VarSymbol (.-head l)))))
          (recur (.-tail l))))
      args))

  (method loadFreevar ^JCTree$JCExpression [this ^JCDiagnostic$DiagnosticPosition pos
                                            ^Symbol$VarSymbol v]
    (.access this v (.Ident (.at make pos) v) nil false))

  (method makeThis ^JCTree$JCExpression [this ^JCDiagnostic$DiagnosticPosition pos
                                         ^Symbol$TypeSymbol c]
    (if (identical? currentClass c)
        (.This (.at make pos) (.erasure c types))
        (.makeOuterThis this pos c)))

  (method makeTwrTry ^JCTree [this ^JCTree$JCTry tree]
    (.make_at this (.pos tree))
    (set! twrVars (.dup twrVars))
    (let [twrBlock (.makeTwrBlock this (.-resources tree) (.-body tree) 0)]
      (if (and (.isEmpty (.-catchers tree)) (nil? (.-finalizer tree)))
          (set! (.-result this) (.translate this twrBlock))
          (set! (.-result this)
                (.translate this (.Try make twrBlock (.-catchers tree) (.-finalizer tree)))))
      (set! twrVars (.leave twrVars))
      (.-result this)))

  (method ^:private makeTwrBlock ^JCTree$JCBlock [this ^{:tag (List JCTree)} resources
                                                  ^JCTree$JCBlock block ^int depth]
    (if (.isEmpty resources)
        block
        (let [^{:tag (ListBuffer JCTree$JCStatement)} stats (ListBuffer.)
              resource (cast JCTree (.-head resources))
              ^:mutable ^JCTree$JCExpression resourceUse nil
              ^:mutable ^boolean resourceNonNull false]
          (if-instance [^JCTree$JCVariableDecl variableDecl resource]
            (do
              (set! resourceUse (.setType (.Ident make (.-sym variableDecl)) (.-type resource)))
              (set! resourceNonNull
                    (and (some? (.-init variableDecl))
                         (.hasTag (TreeInfo/skipParens (.-init variableDecl)) JCTree$Tag/NEWCLASS)))
              (.add stats variableDecl))
            (do
              (Assert/check (instance? JCTree$JCExpression resource))
              (let [syntheticTwrVar (Symbol$VarSymbol.
                                      (bit-or-int Flags/SYNTHETIC Flags/FINAL)
                                      (.makeSyntheticName
                                        this
                                        (.fromString names (java-str "twrVar" depth))
                                        twrVars)
                                      ^Type (if (.hasTag (.-type resource) TypeTag/BOT)
                                                (.-autoCloseableType syms)
                                                (.-type resource))
                                      currentMethodSym)]
                (.enter twrVars syntheticTwrVar)
                (let [syntheticTwrVarDecl (.VarDef
                                            make
                                            syntheticTwrVar
                                            (cast JCTree$JCExpression resource))]
                  (set! resourceUse ^JCTree$JCExpression (.Ident make syntheticTwrVar))
                  (set! resourceNonNull false)
                  (.add stats syntheticTwrVarDecl)))))
          (let [oldPos (.-pos make)]
            (.at make (TreeInfo/endPos block))
            (let [^:mutable bodyCloseStatement (.makeResourceCloseInvocation this resourceUse)]
              (when-not resourceNonNull
                (set! bodyCloseStatement
                      (.If make (.makeNonNullCheck this resourceUse) bodyCloseStatement nil)))
              (let [finallyClause (.Block make
                                          Flags/BODY_ONLY_FINALIZE
                                          (List/of bodyCloseStatement))]
                (.at make oldPos)
                (let [primaryException (Symbol$VarSymbol.
                                         (bit-or-int Flags/FINAL Flags/SYNTHETIC)
                                         (.fromString
                                           names
                                           (java-str "t" (.syntheticNameChar target)))
                                         (.-throwableType syms)
                                         currentMethodSym)
                      primaryExceptionDecl (.VarDef make primaryException nil)
                      suppressedException (Symbol$VarSymbol.
                                            Flags/SYNTHETIC
                                            (.paramName make 2)
                                            (.-throwableType syms)
                                            currentMethodSym)
                      ^JCTree$JCStatement addSuppressedStatement (.Exec
                                                                   make
                                                                   (.makeCall
                                                                     this
                                                                     (.Ident make primaryException)
                                                                     (.-addSuppressed names)
                                                                     (List/of
                                                                       (.Ident
                                                                         make
                                                                         suppressedException))))
                      closeResourceTryBlock (.Block
                                              make
                                              0
                                              (List/of
                                                (.makeResourceCloseInvocation this resourceUse)))
                      catchSuppressedDecl (.VarDef make suppressedException nil)
                      catchSuppressedBlock (.Block make 0 (List/of addSuppressedStatement))
                      ^{:tag (List JCTree$JCCatch)} catchSuppressedClauses (List/of
                                                                             (.Catch
                                                                               make
                                                                               catchSuppressedDecl
                                                                               catchSuppressedBlock))
                      closeResourceTry (.Try make closeResourceTryBlock catchSuppressedClauses nil)]
                  (set! (.-finallyCanCompleteNormally closeResourceTry) true)
                  (let [^:mutable ^JCTree$JCStatement exceptionalCloseStatement closeResourceTry]
                    (when-not resourceNonNull
                      (set! exceptionalCloseStatement
                            (.If make
                                 (.makeNonNullCheck this resourceUse)
                                 exceptionalCloseStatement
                                 nil)))
                    (let [^JCTree$JCStatement exceptionalRethrow (.Throw
                                                                   make
                                                                   (.Ident make primaryException))
                          exceptionalCloseBlock (.Block
                                                  make
                                                  0
                                                  (List/of
                                                    exceptionalCloseStatement
                                                    exceptionalRethrow))
                          exceptionalCatchClause (.Catch
                                                   make
                                                   primaryExceptionDecl
                                                   exceptionalCloseBlock)
                          outerTry (.Try make
                                         (.makeTwrBlock
                                           this
                                           (.-tail resources)
                                           block
                                           (unchecked-add-int depth 1))
                                         (List/of exceptionalCatchClause)
                                         finallyClause)]
                      (set! (.-finallyCanCompleteNormally outerTry) true)
                      (.add stats outerTry)
                      (let [newBlock (.Block make 0 (.toList stats))] newBlock))))))))))

  (method ^:private makeResourceCloseInvocation ^JCTree$JCStatement [this
                                                                     ^:mutable ^JCTree$JCExpression resource]
    (when (nil? (.asSuper types (.-type resource) (.-tsym (.-autoCloseableType syms))))
      (set! resource (.convert this resource (.-autoCloseableType syms))))
    (let [^JCTree$JCExpression resourceClose (.makeCall this resource (.-close names) (List/nil))]
      (.Exec make resourceClose)))

  (method ^:private makeNonNullCheck ^JCTree$JCExpression [this ^JCTree$JCExpression expression]
    (.makeBinary this JCTree$Tag/NE expression (.makeNull this)))

  (method makeOuterThis ^JCTree$JCExpression [this ^JCDiagnostic$DiagnosticPosition pos
                                              ^Symbol$TypeSymbol c]
    (let [^:mutable ^{:tag (List Symbol$VarSymbol)} ots outerThisStack]
      (if (.isEmpty ots)
          (do
            (.error log pos (CompilerProperties$Errors/NoEnclInstanceOfTypeInScope c))
            (.makeNull this))
          (let [^:mutable ot (cast Symbol$VarSymbol (.-head ots))
                ^:mutable tree (.access this (.Ident (.at make pos) ot))]
            (set! (.-flags_field ot) (bit-and (.-flags_field ot) (bit-not-int Flags/NOOUTERTHIS)))
            (let [^:mutable otc (.-tsym (.-type ot))]
              (while (not (identical? otc c))
                (loop []
                  (set! ots (.-tail ots))
                  (when (.isEmpty ots)
                    (.error log pos (CompilerProperties$Errors/NoEnclInstanceOfTypeInScope c))
                    (Assert/error)
                    (return tree))
                  (set! ot (cast Symbol$VarSymbol (.-head ots)))
                  (when-not (identical? (.-owner ot) otc) (recur)))
                (when (and (not (identical? (.-kind (.-owner otc)) Kinds$Kind/PCK))
                           (not (.hasOuterInstance otc)))
                  (.error log pos (CompilerProperties$Errors/NoEnclInstanceOfTypeInScope c))
                  (Assert/error)
                  (return (.makeNull this)))
                (set! tree (.access this (.Select (.at make pos) tree ot)))
                (set! (.-flags_field ot)
                      (bit-and (.-flags_field ot) (bit-not-int Flags/NOOUTERTHIS)))
                (set! otc (.-tsym (.-type ot))))
              tree)))))

  (method makeOwnerThis ^JCTree$JCExpression [this ^JCDiagnostic$DiagnosticPosition pos ^Symbol sym
                                              ^boolean preciseMatch]
    (if (if preciseMatch
            (.isMemberOf sym currentClass types)
            (.isSubClass currentClass (.-owner sym) types))
        (.This (.at make pos) (.erasure currentClass types))
        (.makeOwnerThisN this pos sym preciseMatch)))

  (method makeOwnerThisN ^JCTree$JCExpression [this ^JCDiagnostic$DiagnosticPosition pos ^Symbol sym
                                               ^boolean preciseMatch]
    (let [c (.-owner sym)
          ^:mutable ^{:tag (List Symbol$VarSymbol)} ots outerThisStack]
      (if (.isEmpty ots)
          (do
            (.error log pos (CompilerProperties$Errors/NoEnclInstanceOfTypeInScope c))
            (.makeNull this))
          (let [^:mutable ot (cast Symbol$VarSymbol (.-head ots))
                ^:mutable tree (.access this (.Ident (.at make pos) ot))]
            (set! (.-flags_field ot) (bit-and (.-flags_field ot) (bit-not-int Flags/NOOUTERTHIS)))
            (let [^:mutable otc (.-tsym (.-type ot))]
              (while (not (if preciseMatch
                              (.isMemberOf sym otc types)
                              (.isSubClass otc (.-owner sym) types)))
                (loop []
                  (set! ots (.-tail ots))
                  (when (.isEmpty ots)
                    (.error log pos (CompilerProperties$Errors/NoEnclInstanceOfTypeInScope c))
                    (return tree))
                  (set! ot (cast Symbol$VarSymbol (.-head ots)))
                  (when-not (identical? (.-owner ot) otc) (recur)))
                (set! tree (.access this (.Select (.at make pos) tree ot)))
                (set! (.-flags_field ot)
                      (bit-and (.-flags_field ot) (bit-not-int Flags/NOOUTERTHIS)))
                (set! otc (.-tsym (.-type ot))))
              tree)))))

  (method initField ^JCTree$JCStatement [this ^int pos ^Symbol rhs ^Symbol lhs]
    (Assert/check (identical? (.-kind (.-owner rhs)) Kinds$Kind/MTH))
    (Assert/check (identical? (.-owner (.-owner rhs)) (.-owner lhs)))
    (.at make pos)
    (.Exec make
           (.setType (.Assign make
                              (.Select make (.This make (.erasure (.-owner lhs) types)) lhs)
                              (.Ident make rhs))
                     (.erasure lhs types))))

  (method initOuterThis ^JCTree$JCStatement [this ^int pos ^Symbol$VarSymbol rhs ^boolean stores]
    (Assert/check (identical? (.-kind (.-owner rhs)) Kinds$Kind/MTH))
    (Assert/check (or nullCheckOuterThis stores))
    (.at make pos)
    (let [^:mutable ^JCTree$JCExpression expression (.Ident make rhs)]
      (when nullCheckOuterThis (set! expression (.makeNullCheck attr expression)))
      (when stores
        (let [lhs (cast Symbol$VarSymbol (.-head outerThisStack))]
          (Assert/check (identical? (.-owner (.-owner rhs)) (.-owner lhs)))
          (set! expression
                (.setType (.Assign make
                                   (.Select make (.This make (.erasure (.-owner lhs) types)) lhs)
                                   expression)
                          (.erasure lhs types)))))
      (.Exec make expression)))

  (method ^:private outerCacheClass ^Symbol$ClassSymbol [this]
    (let [clazz (.-sym outermostClassDef)
          ^Scope s (.members clazz)]
      (for-each [^Symbol sym (.getSymbols s Scope$LookupKind/NON_RECURSIVE)]
        (when (and (and (identical? (.-kind sym) Kinds$Kind/TYP)
                        (identical? (.-name sym) (.-empty names)))
                   (== (bit-and (.flags sym) Flags/INTERFACE) 0))
          (return (cast Symbol$ClassSymbol sym))))
      (.-sym (.makeEmptyClass this (bit-or-int Flags/STATIC Flags/SYNTHETIC) clazz))))

  (method ^:private makeCall ^JCTree$JCMethodInvocation [this ^JCTree$JCExpression left ^Name name
                                                         ^{:tag (List JCTree$JCExpression)} args]
    (Assert/checkNonNull (.-type left))
    (let [^Symbol funcsym (.lookupMethod this make_pos name (.-type left) (TreeInfo/types args))]
      (.App make (.Select make left funcsym) args)))

  (method ^:private classOf ^JCTree$JCExpression [this ^JCTree clazz]
    (.classOfType this (.-type clazz) (.pos clazz)))

  (method ^:private classOfType ^JCTree$JCExpression [this ^Type type
                                                      ^JCDiagnostic$DiagnosticPosition pos]
    (switch (.getTag type)
      (BYTE SHORT CHAR INT LONG FLOAT DOUBLE BOOLEAN VOID)
        (let [c (.boxedClass types type)
              typeSym (.accessBase rs
                                   (.findIdentInType
                                     rs
                                     pos
                                     attrEnv
                                     (.-type c)
                                     (.-TYPE names)
                                     Kinds$KindSelector/VAR)
                                   pos
                                   (.-type c)
                                   (.-TYPE names)
                                   true)]
          (when (identical? (.-kind typeSym) Kinds$Kind/VAR)
            (.getConstValue (cast Symbol$VarSymbol typeSym)))
          (.QualIdent make typeSym))
      (CLASS ARRAY)
        (let [sym (Symbol$VarSymbol. (bit-or-int (bit-or-int Flags/STATIC Flags/PUBLIC) Flags/FINAL)
                                     (.-_class names)
                                     (.-classType syms)
                                     (.-tsym type))]
          (.Select (.make_at this pos) (.Type make type) sym))
      (throw (AssertionError.))))

  (field ^:private ^Symbol$ClassSymbol assertionsDisabledClassCache)

  (method ^:private assertionsDisabledClass ^Symbol$ClassSymbol [this]
    (if (some? assertionsDisabledClassCache)
        assertionsDisabledClassCache
        (do
          (set! assertionsDisabledClassCache
                (.-sym (.makeEmptyClass this
                                        (bit-or-int Flags/STATIC Flags/SYNTHETIC)
                                        (.-sym outermostClassDef))))
          assertionsDisabledClassCache)))

  (method ^:private assertFlagTest ^JCTree$JCExpression [this ^JCDiagnostic$DiagnosticPosition pos]
    (let [outermostClass (.-sym outermostClassDef)
          ^Symbol$ClassSymbol container (if (not (.isInterface currentClass))
                                            currentClass
                                            (.assertionsDisabledClass this))
          ^:mutable assertDisabledSym (cast Symbol$VarSymbol
                                            (.lookupSynthetic
                                              this
                                              dollarAssertionsDisabled
                                              (.members container)))]
      (when (nil? assertDisabledSym)
        (set! assertDisabledSym
              (Symbol$VarSymbol. (bit-or-int (bit-or-int Flags/STATIC Flags/FINAL) Flags/SYNTHETIC)
                                 dollarAssertionsDisabled
                                 (.-booleanType syms)
                                 container))
        (.enterSynthetic this pos assertDisabledSym (.members container))
        (let [^Symbol desiredAssertionStatusSym (.lookupMethod
                                                  this
                                                  pos
                                                  (.-desiredAssertionStatus names)
                                                  (.erasure types (.-classType syms))
                                                  (List/nil))
              containerDef (.classDef this container)]
          (.make_at this (.pos containerDef))
          (let [^JCTree$JCExpression notStatus (.makeUnary
                                                 this
                                                 JCTree$Tag/NOT
                                                 (.App
                                                   make
                                                   (.Select
                                                     make
                                                     (.classOfType
                                                       this
                                                       (.erasure types (.-type outermostClass))
                                                       (.pos containerDef))
                                                     desiredAssertionStatusSym)))
                assertDisabledDef (.VarDef make assertDisabledSym notStatus)]
            (set! (.-defs containerDef) (.prepend (.-defs containerDef) assertDisabledDef))
            (when (.isInterface currentClass)
              (let [currentClassDef (.classDef this currentClass)]
                (.make_at this (.pos currentClassDef))
                (let [^JCTree$JCStatement dummy (.If
                                                  make
                                                  (.QualIdent make assertDisabledSym)
                                                  (.Skip make)
                                                  nil)
                      clinit (.Block make Flags/STATIC (List/of dummy))]
                  (set! (.-defs currentClassDef) (.prepend (.-defs currentClassDef) clinit))))))))
      (.make_at this pos)
      (.makeUnary this JCTree$Tag/NOT (.Ident make assertDisabledSym))))

  (defclass ^:interface TreeBuilder
    (method build ^JCTree$JCExpression [this ^JCTree$JCExpression arg]))

  (method abstractRval ^JCTree$JCExpression [this ^:mutable ^JCTree$JCExpression rval ^Type type
                                             ^TreeBuilder builder]
    (set! rval (TreeInfo/skipParens rval))
    (switch (.getTag rval)
      LITERAL (return (.build builder rval))
      IDENT
        (let [id (cast JCTree$JCIdent rval)]
          (when (and (not (== (bit-and (.flags (.-sym id)) Flags/FINAL) 0))
                     (identical? (.-kind (.-owner (.-sym id))) Kinds$Kind/MTH))
            (return (.build builder rval)))))
    (let [name (TreeInfo/name rval)]
      (if (or (identical? name (.-_super names)) (identical? name (.-_this names)))
          (.build builder rval)
          (let [var (Symbol$VarSymbol. (bit-or-int Flags/FINAL Flags/SYNTHETIC)
                                       (.fromString
                                         names
                                         (java-str (.syntheticNameChar target) "" (.hashCode rval)))
                                       type
                                       currentMethodSym)]
            (set! rval (.convert this rval type))
            (let [def (.VarDef make var rval)
                  built (.build builder (.Ident make var))
                  ^JCTree$JCExpression res (.LetExpr make def built)]
              (set! (.-type res) (.-type built))
              res)))))

  (method abstractRval ^JCTree$JCExpression [this ^JCTree$JCExpression rval ^TreeBuilder builder]
    (.abstractRval this rval (.-type rval) builder))

  (method abstractLval ^JCTree$JCExpression [this ^:mutable ^JCTree$JCExpression lval
                                             ^:final ^TreeBuilder builder]
    (set! lval (TreeInfo/skipParens lval))
    (switch (.getTag lval)
      IDENT (return (.build builder lval))
      SELECT
        (let [s (cast JCTree$JCFieldAccess lval)
              lid (TreeInfo/symbol (.-selected s))]
          (when (and (some? lid) (identical? (.-kind lid) Kinds$Kind/TYP))
            (return (.build builder lval)))
          (return (.abstractRval
                    this
                    (.-selected s)
                    (lambda TreeBuilder ^JCTree$JCExpression [^JCTree$JCExpression selected]
                      (.build builder (.Select make selected (.-sym s)))))))
      INDEXED
        (let [i (cast JCTree$JCArrayAccess lval)]
          (return (.abstractRval
                    this
                    (.-indexed i)
                    (lambda TreeBuilder ^JCTree$JCExpression [^JCTree$JCExpression indexed]
                      (.abstractRval
                        this
                        (.-index i)
                        (.-intType syms)
                        (lambda TreeBuilder ^JCTree$JCExpression [^JCTree$JCExpression index]
                          (let [^JCTree$JCExpression newLval (.Indexed make indexed index)]
                            (.setType newLval (.-type i))
                            (.build builder newLval))))))))
      TYPECAST (return (.abstractLval this (.-expr (cast JCTree$JCTypeCast lval)) builder)))
    (throw (AssertionError. lval)))

  (method makeComma ^JCTree$JCExpression [this ^:final ^JCTree$JCExpression expr1
                                          ^:final ^JCTree$JCExpression expr2]
    (let [^JCTree$JCExpression res (.LetExpr make (List/of (.Exec make expr1)) expr2)]
      (set! (.-type res) (.-type expr2))
      res))

  (field ^:private ^JCTree$JCExpression enclOp)

  (method ^:public translate :type-params [(T extends JCTree)] ^T [this ^T tree]
    (when (some? tree)
      (.make_at this (.pos tree))
      (let [^T result (.translate super tree)]
        (when (and (some? endPosTable) (not (identical? result tree)))
          (.replaceTree endPosTable tree result))
        result)))

  (method ^:public translate :type-params [(T extends JCTree$JCExpression)] ^T [this ^T tree
                                                                                ^Type type]
    (when (some? tree) (.boxIfNeeded this (cast JCTree$JCExpression (.translate this tree)) type)))

  (method ^:public translate :type-params [(T extends JCTree)] ^T [this ^T tree
                                                                   ^JCTree$JCExpression enclOp]
    (let [prevEnclOp (.-enclOp this)]
      (set! (.-enclOp this) enclOp)
      (let [^T res (.translate this tree)] (set! (.-enclOp this) prevEnclOp) res)))

  (method ^:public translate :type-params [(T extends JCTree$JCExpression)] ^{:tag (List T)} [this
                                                                                              ^{:tag (List T)} trees
                                                                                              ^Type type]
    (when (some? trees)
      (loop [^{:tag (List T)} l trees]
        (when (.nonEmpty l)
          (set! (.-head l) (.translate this (cast JCTree$JCExpression (.-head l)) type))
          (recur (.-tail l))))
      trees))

  (method ^:public visitPackageDef ^void [this ^JCTree$JCPackageDecl tree]
    (when-not (not (.needPackageInfoClass this tree))
      (let [^:mutable ^long flags (bit-or-int Flags/ABSTRACT Flags/INTERFACE)]
        (set! flags (bit-or flags Flags/SYNTHETIC))
        (let [c (.-package_info (.-packge tree))]
          (.setAttributes c (.-packge tree))
          (set! (.-flags_field c) (bit-or (.-flags_field c) flags))
          (let [ctype (cast Type$ClassType (.-type c))]
            (set! (.-supertype_field ctype) (.-objectType syms))
            (set! (.-interfaces_field ctype) (List/nil))
            (.createInfoClass this (.-annotations tree) c))))))

  (method ^:private needPackageInfoClass ^boolean [this ^JCTree$JCPackageDecl pd]
    (switch pkginfoOpt
      ALWAYS (return true)
      LEGACY (return (.nonEmpty (.getAnnotations pd)))
      NONEMPTY
        (do
          (for-each [^Attribute$Compound a (.getDeclarationAttributes (.-packge pd))]
            (let [p (.getRetention types a)]
              (when-not (identical? p Attribute$RetentionPolicy/SOURCE) (return true))))
          (return false)))
    (throw (AssertionError.)))

  (method ^:public visitModuleDef ^void [this ^JCTree$JCModuleDecl tree]
    (let [msym (.-sym tree)
          c (.-module_info msym)]
      (.setAttributes c msym)
      (set! (.-flags_field c) (bit-or (.-flags_field c) Flags/MODULE))
      (.createInfoClass this (List/nil) (.-module_info (.-sym tree)))))

  (method ^:private createInfoClass ^void [this ^{:tag (List JCTree$JCAnnotation)} annots
                                           ^Symbol$ClassSymbol c]
    (let [^long flags (bit-or-int Flags/ABSTRACT Flags/INTERFACE)
          infoClass (.ClassDef make
                               (.Modifiers make flags annots)
                               (.-name c)
                               (List/nil)
                               nil
                               (List/nil)
                               (List/nil))]
      (set! (.-sym infoClass) c)
      (.append translated infoClass)))

  (method ^:public visitClassDef ^void [this ^JCTree$JCClassDecl tree]
    (let [^{:tag (Env AttrContext)} prevEnv attrEnv
          currentClassPrev currentClass
          currentMethodSymPrev currentMethodSym]
      (set! currentClass (.-sym tree))
      (set! currentMethodSym nil)
      (set! attrEnv (.remove typeEnvs currentClass))
      (when (nil? attrEnv) (set! attrEnv prevEnv))
      (.put classdefs currentClass tree)
      (let [^{:tag (Map Symbol Symbol)} prevProxies proxies]
        (set! proxies (HashMap. proxies))
        (let [^{:tag (List Symbol$VarSymbol)} prevOuterThisStack outerThisStack]
          (when (and (not (== (bit-and (.-flags (.-mods tree)) Flags/ENUM) 0))
                     (== (bit-and (.flags (.-tsym (.supertype types (.-type currentClass))))
                                  Flags/ENUM)
                         0))
            (.visitEnumDef this tree))
          (when-not (== (bit-and (.-flags (.-mods tree)) Flags/RECORD) 0)
            (.visitRecordDef this tree))
          (let [^:mutable ^JCTree$JCVariableDecl otdef nil]
            (when (.hasOuterInstance currentClass)
              (set! otdef (.outerThisDef this (.-pos tree) currentClass)))
            (let [^{:tag (List JCTree$JCVariableDecl)} fvdefs (.freevarDefs
                                                                this
                                                                (.-pos tree)
                                                                (.freevars this currentClass)
                                                                currentClass)]
              (set! (.-extending tree)
                    (cast JCTree$JCExpression (.translate this (.-extending tree))))
              (set! (.-implementing tree) (.translate this (.-implementing tree)))
              (when (.isDirectlyOrIndirectlyLocal currentClass)
                (let [encl (.enclClass (.-owner currentClass))]
                  (when (nil? (.-trans_local encl)) (set! (.-trans_local encl) (List/nil)))
                  (set! (.-trans_local encl) (.prepend (.-trans_local encl) currentClass))))
              (let [^:mutable ^{:tag (List JCTree)} seen (List/nil)]
                (while (not (identical? (.-defs tree) seen))
                  (let [^{:tag (List JCTree)} unseen (.-defs tree)]
                    (loop [^{:tag (List JCTree)} l unseen]
                      (when (and (.nonEmpty l) (not (identical? l seen)))
                        (let [outermostMemberDefPrev outermostMemberDef]
                          (when (nil? outermostMemberDefPrev)
                            (set! outermostMemberDef (cast JCTree (.-head l))))
                          (set! (.-head l) (.translate this (cast JCTree (.-head l))))
                          (set! outermostMemberDef outermostMemberDefPrev)
                          (recur (.-tail l)))))
                    (set! seen unseen)))
                (when-not (== (bit-and (.-flags (.-mods tree)) Flags/PROTECTED) 0)
                  (let [o-2 (.-mods tree)] (set! (.-flags o-2) (bit-or (.-flags o-2) Flags/PUBLIC))))
                (let [o-3 (.-mods tree)]
                  (set! (.-flags o-3) (bit-and (.-flags o-3) Flags/ClassFlags)))
                (set! (.-name tree) (Convert/shortName (.flatName currentClass)))
                (loop [^{:tag (List JCTree$JCVariableDecl)} l fvdefs]
                  (when (.nonEmpty l)
                    (set! (.-defs tree) (.prepend (.-defs tree) (cast JCTree (.-head l))))
                    (.enterSynthetic this
                                     (.pos tree)
                                     (.-sym (cast JCTree$JCVariableDecl (.-head l)))
                                     (.members currentClass))
                    (recur (.-tail l))))
                (label :emitOuter
                  (when (.hasOuterInstance currentClass)
                    (let [storesThis (.shouldEmitOuterThis this currentClass)]
                      (if storesThis
                          (do
                            (set! (.-defs tree) (.prepend (.-defs tree) otdef))
                            (.enterSynthetic this (.pos tree) (.-sym otdef) (.members currentClass)))
                          (when-not nullCheckOuterThis (break :emitOuter)))
                      (for-each [^JCTree def (.-defs tree)]
                        (when (TreeInfo/isConstructor def)
                          (let [mdef (cast JCTree$JCMethodDecl def)]
                            (when (TreeInfo/hasConstructorCall mdef (.-_super names))
                              (let [^{:tag (List JCTree$JCStatement)} initializer (List/of
                                                                                    (.initOuterThis
                                                                                      this
                                                                                      (.-pos
                                                                                        (.-body
                                                                                          mdef))
                                                                                      (.-sym
                                                                                        (cast
                                                                                          JCTree$JCVariableDecl
                                                                                          (.-head
                                                                                            (.-params
                                                                                              mdef))))
                                                                                      storesThis))]
                                (TreeInfo/mapSuperCalls
                                  (.-body mdef)
                                  (lambda Function ^JCTree$JCStatement [^JCTree$JCExpressionStatement supercall]
                                    (.Block make 0 (.append initializer supercall))))))))))))
                (set! proxies prevProxies)
                (set! outerThisStack prevOuterThisStack)
                (.append translated tree)
                (set! attrEnv prevEnv)
                (set! currentClass currentClassPrev)
                (set! currentMethodSym currentMethodSymPrev)
                (set! (.-result this)
                      (.Block (.make_at this (.pos tree)) Flags/SYNTHETIC (List/nil))))))))))

  (method ^:private shouldEmitOuterThis ^boolean [this ^Symbol$ClassSymbol sym]
    (if (not optimizeOuterThis)
        true
        (arbace.core/cond
          (== (bit-and (.-flags_field (cast Symbol$VarSymbol (.-head outerThisStack)))
                       Flags/NOOUTERTHIS)
              0)
          true
          (.isSerializable rs (.-type sym))
          true
          :else
          false)))

  (method generateMandatedAccessors ^{:tag (List JCTree)} [this ^JCTree$JCClassDecl tree]
    (let [^{:tag (List JCTree$JCVariableDecl)} fields (TreeInfo/recordFields tree)]
      (cast List
            (.collect (.map
                        (.filter (.stream (.getRecordComponents (.-sym tree)))
                                 (lambda Predicate ^boolean [^Symbol$RecordComponent rc]
                                   (not (== (bit-and
                                              (.flags (.-accessor rc))
                                              Flags/GENERATED_MEMBER)
                                            0))))
                        (lambda Function ^JCTree$JCMethodDecl [^Symbol$RecordComponent rc]
                          (let [field (cast
                                        JCTree$JCVariableDecl
                                        (.get
                                          (.findAny
                                            (.filter
                                              (.stream fields)
                                              (lambda Predicate ^boolean [^JCTree$JCVariableDecl f]
                                                (identical? (.-name f) (.-name rc)))))))]
                            (.make_at this (.pos tree))
                            (.MethodDef
                              make
                              (.-accessor rc)
                              (.Block make 0 (List/of (.Return make (.Ident make field))))))))
                      (List/collector)))))

  (method ^:private visitEnumDef ^void [this ^JCTree$JCClassDecl tree]
    (.make_at this (.pos tree))
    (when (nil? (.-extending tree))
      (set! (.-extending tree) (.Type make (.supertype types (.-type tree)))))
    (let [e_class (.setType (.classOfType this (.-type (.-sym tree)) (.pos tree))
                            (.erasure types (.-classType syms)))
          ^:mutable ^int nextOrdinal 0
          ^{:tag (ListBuffer JCTree$JCExpression)} values (ListBuffer.)
          ^{:tag (ListBuffer JCTree)} enumDefs (ListBuffer.)
          ^{:tag (ListBuffer JCTree)} otherDefs (ListBuffer.)]
      (loop [^{:tag (List JCTree)} defs (.-defs tree)]
        (if (.nonEmpty defs)
            (if (and (.hasTag (cast JCTree (.-head defs)) JCTree$Tag/VARDEF)
                     (not (== (bit-and (.-flags (.-mods (cast JCTree$JCVariableDecl (.-head defs))))
                                       Flags/ENUM)
                              0)))
                (let [var (cast JCTree$JCVariableDecl (.-head defs))]
                  (.visitEnumConstantDef this var nextOrdinal)
                  (set! nextOrdinal (unchecked-inc-int nextOrdinal))
                  (.append values (.QualIdent make (.-sym var)))
                  (.append enumDefs var)
                  (recur (.-tail defs)))
                (do (.append otherDefs (cast JCTree (.-head defs))) (recur (.-tail defs))))
            nil))
      (let [valuesName (.syntheticName this tree "VALUES")
            ^Type arrayType (Type$ArrayType. (.erasure types (.-type tree)) (.-arrayClass syms))
            valuesVar (Symbol$VarSymbol.
                        (bit-or-int (bit-or-int (bit-or-int Flags/PRIVATE Flags/FINAL) Flags/STATIC)
                                    Flags/SYNTHETIC)
                        valuesName
                        arrayType
                        (.-tsym (.-type tree)))
            newArray (.NewArray make
                                (.Type make (.erasure types (.-type tree)))
                                (List/nil)
                                (.toList values))]
        (set! (.-type newArray) arrayType)
        (let [valuesMethod (Symbol$MethodSymbol.
                             (bit-or-int (bit-or-int Flags/PRIVATE Flags/STATIC) Flags/SYNTHETIC)
                             (.syntheticName this tree "values")
                             (Type$MethodType. (List/nil)
                                               arrayType
                                               (List/nil)
                                               (.-tsym (.-type tree)))
                             (.-tsym (.-type tree)))]
          (.append enumDefs
                   (.MethodDef make valuesMethod (.Block make 0 (List/of (.Return make newArray)))))
          (.enter (.members (.-sym tree)) valuesMethod)
          (.append enumDefs (.VarDef make valuesVar (.App make (.QualIdent make valuesMethod))))
          (.enter (.members (.-sym tree)) valuesVar)
          (let [valuesSym (.lookupMethod this (.pos tree) (.-values names) (.-type tree) (List/nil))
                ^:mutable ^{:tag (List JCTree$JCStatement)} valuesBody nil]
            (if (.useClone this)
                (let [valuesResult (.TypeCast make
                                              (.getReturnType (.-type valuesSym))
                                              (.App
                                                make
                                                (.Select
                                                  make
                                                  (.Ident make valuesVar)
                                                  (.-arrayCloneMethod syms))))]
                  (set! valuesBody (List/of (.Return make valuesResult))))
                (let [resultName (.syntheticName this tree "result")
                      resultVar (Symbol$VarSymbol.
                                  (bit-or-int Flags/FINAL Flags/SYNTHETIC)
                                  resultName
                                  arrayType
                                  valuesSym)
                      resultArray (.NewArray make
                                             (.Type make (.erasure types (.-type tree)))
                                             (List/of
                                               (.Select
                                                 make
                                                 (.Ident make valuesVar)
                                                 (.-lengthVar syms)))
                                             nil)]
                  (set! (.-type resultArray) arrayType)
                  (let [decl (.VarDef make resultVar resultArray)]
                    (when (nil? systemArraycopyMethod)
                      (set! systemArraycopyMethod
                            (Symbol$MethodSymbol.
                              (bit-or-int Flags/PUBLIC Flags/STATIC)
                              (.fromString names "arraycopy")
                              (Type$MethodType.
                                (List/of (.-objectType syms)
                                         (.-intType syms)
                                         (.-objectType syms)
                                         (new Type/1 [(.-intType syms) (.-intType syms)]))
                                (.-voidType syms)
                                (List/nil)
                                (.-methodClass syms))
                              (.-tsym (.-systemType syms)))))
                    (let [^JCTree$JCStatement copy (.Exec
                                                     make
                                                     (.App
                                                       make
                                                       (.Select
                                                         make
                                                         (.Ident make (.-tsym (.-systemType syms)))
                                                         systemArraycopyMethod)
                                                       (List/of
                                                         (.Ident make valuesVar)
                                                         (.Literal make (Integer/valueOf 0))
                                                         (.Ident make resultVar)
                                                         (new
                                                           JCTree$JCExpression/1
                                                           [(.Literal make (Integer/valueOf 0))
                                                            (.Select
                                                              make
                                                              (.Ident make valuesVar)
                                                              (.-lengthVar syms))]))))
                          ^JCTree$JCStatement ret (.Return make (.Ident make resultVar))]
                      (set! valuesBody (List/of decl copy ret))))))
            (let [valuesDef (.MethodDef make valuesSym (.Block make 0 valuesBody))]
              (.append enumDefs valuesDef)
              (when debugLower
                (.println System/err (java-str (.-sym tree) ".valuesDef = " valuesDef)))
              (let [valueOfSym (.lookupMethod this
                                              (.pos tree)
                                              (.-valueOf names)
                                              (.-type (.-sym tree))
                                              (List/of (.-stringType syms)))]
                (Assert/check (not (== (bit-and (.flags valueOfSym) Flags/STATIC) 0)))
                (let [nameArgSym (cast Symbol$VarSymbol (.-head (.-params valueOfSym)))
                      nameVal (.Ident make nameArgSym)
                      ^JCTree$JCStatement enum_ValueOf (.Return
                                                         make
                                                         (.TypeCast
                                                           make
                                                           (.-type (.-sym tree))
                                                           (.makeCall
                                                             this

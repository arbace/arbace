              (when (.nonEmpty tl)
                (let [^{:tag (Pair Symbol$MethodSymbol Attribute)} p
                        (.attributeAnnotationNameValuePair
                          this
                          (cast JCTree$JCExpression (.-head tl))
                          (.-type a)
                          isError
                          env
                          elidedValue)]

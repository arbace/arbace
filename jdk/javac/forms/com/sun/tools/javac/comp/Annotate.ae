          ^:mutable ^{:tag (List JCTree$JCExpression)} elems (.-elems na)]
      (when (some? (.-elemtype na))
        (.error log (.pos (.-elemtype na)) CompilerProperties$Errors/NewNotAllowedInAnnotation)
        (when (nil? elems) (set! elems (List/nil))))
      (let [^{:tag (ListBuffer Attribute)} buf (ListBuffer.)]
        (loop [^{:tag (List JCTree$JCExpression)} l elems]
          (when (.nonEmpty l)
            (.append buf
                     (.attributeAnnotationValue this
                                                (.elemtype types expectedElementType)
                                                (cast JCTree$JCExpression (.-head l))
                                                env))
            (recur (.-tail l))))
        (set! (.-type na) expectedElementType)
        (Attribute$Array. expectedElementType
                          (cast Attribute/1 (.toArray buf (new Attribute/1 (.length buf))))))))

  (defclass ^:private AnnotationContext
    :type-params [(T extends Attribute$Compound)]

    (field ^:public ^:final ^{:tag (Env AttrContext)} env)

    (field ^:public ^:final ^{:tag (Map Symbol$TypeSymbol (ListBuffer T))} annotated)

    (field ^:public ^:final ^{:tag (Map T JCDiagnostic$DiagnosticPosition)} pos)

    (field ^:public ^:final ^boolean isTypeCompound)

    (constructor ^:public [this ^{:tag (Env AttrContext)} env
                           ^{:tag (Map Symbol$TypeSymbol (ListBuffer T))} annotated
                           ^{:tag (Map T JCDiagnostic$DiagnosticPosition)} pos
                           ^boolean isTypeCompound]
      (Assert/checkNonNull env)
      (Assert/checkNonNull annotated)
      (Assert/checkNonNull pos)
      (set! (.-env this) env)
      (set! (.-annotated this) annotated)
      (set! (.-pos this) pos)
      (set! (.-isTypeCompound this) isTypeCompound)))

  (method ^:private processRepeatedAnnotations :type-params [(T extends Attribute$Compound)] ^T [this
                                                                                                 ^{:tag (List T)} annotations
                                                                                                 ^{:tag (AnnotationContext T)} ctx
                                                                                                 ^Symbol on
                                                                                                 ^boolean isTypeParam]
    (let [^T firstOccurrence (cast Attribute$Compound (.-head annotations))
          ^:mutable ^{:tag (List Attribute)} repeated (List/nil)
          ^:mutable ^Type origAnnoType nil
          ^:mutable ^Type arrayOfOrigAnnoType nil
          ^:mutable ^Type targetContainerType nil
          ^:mutable ^Symbol$MethodSymbol containerValueSymbol nil]
      (Assert/check (and (not (.isEmpty annotations)) (not (.isEmpty (.-tail annotations)))))
      (let [^:mutable ^int count 0]
        (loop [^{:tag (List T)} al annotations]
          (when-not (.isEmpty al)
            (set! count (unchecked-inc-int count))
            (Assert/check (or (> count 1) (not (.isEmpty (.-tail al)))))
            (let [^T currentAnno (cast Attribute$Compound (.-head al))]
              (set! origAnnoType (.-type currentAnno))
              (when (nil? arrayOfOrigAnnoType)
                (set! arrayOfOrigAnnoType (.makeArrayType types origAnnoType)))
              (let [reportError (> count 1)
                    currentContainerType (.getContainingType
                                           this
                                           currentAnno
                                           (cast
                                             JCDiagnostic$DiagnosticPosition
                                             (.get (.-pos ctx) currentAnno))
                                           reportError)]
                (if (nil? currentContainerType)
                    (recur (.-tail al))
                    (do
                      (Assert/check (or (nil? targetContainerType)
                                        (identical? currentContainerType targetContainerType)))
                      (set! targetContainerType currentContainerType)
                      (set! containerValueSymbol
                            (.validateContainer this
                                                targetContainerType
                                                origAnnoType
                                                (cast
                                                  JCDiagnostic$DiagnosticPosition
                                                  (.get (.-pos ctx) currentAnno))))
                      (if (nil? containerValueSymbol)
                          (recur (.-tail al))
                          (do (set! repeated (.prepend repeated currentAnno)) (recur (.-tail al))))))))))
        (if (and (not (.isEmpty repeated)) (nil? targetContainerType))
            (do
              (.error log
                      (cast JCDiagnostic$DiagnosticPosition (.get (.-pos ctx) (.-head annotations)))
                      (CompilerProperties$Errors/DuplicateAnnotationInvalidRepeated origAnnoType))
              nil)
            (when-not (.isEmpty repeated)
              (set! repeated (.reverse repeated))
              (let [pos (cast JCDiagnostic$DiagnosticPosition (.get (.-pos ctx) firstOccurrence))
                    m (.at make pos)
                    ^{:tag (Pair Symbol$MethodSymbol Attribute)} p (Pair.
                                                                     containerValueSymbol
                                                                     (Attribute$Array.
                                                                       arrayOfOrigAnnoType
                                                                       repeated))]
                (if (.-isTypeCompound ctx)
                    (let [at (Attribute$TypeCompound.
                               targetContainerType
                               (List/of p)
                               (.-position (cast Attribute$TypeCompound (.-head annotations))))
                          annoTree (.TypeAnnotation m at)]
                      (when-not (.validateAnnotationDeferErrors chk annoTree)
                        (.error log
                                (.pos annoTree)
                                (CompilerProperties$Errors/DuplicateAnnotationInvalidRepeated
                                  origAnnoType)))
                      (when-not (.isTypeAnnotation chk annoTree isTypeParam)
                        (.error
                          log
                          pos
                          ^JCDiagnostic$Error (if isTypeParam
                                                  (CompilerProperties$Errors/InvalidRepeatableAnnotationNotApplicable
                                                    targetContainerType
                                                    on)
                                                  (CompilerProperties$Errors/InvalidRepeatableAnnotationNotApplicableInContext
                                                    targetContainerType))))
                      (.setSynthesized at true)
                      (let [^T x ^Attribute$Compound at] x))
                    (let [^:mutable c (Attribute$Compound. targetContainerType (List/of p))
                          annoTree (.Annotation m c)
                          isRecordMember (or (not (== (bit-and (.-flags_field on) Flags/RECORD) 0))
                                             (and
                                               (some? (.enclClass on))
                                               (.isRecord (.enclClass on))))]
                      (when (and (not (.annotationApplicable chk annoTree on))
                                 (or (not isRecordMember)
                                     (and
                                       isRecordMember
                                       (== (bit-and (.-flags_field on) Flags/GENERATED_MEMBER) 0))))
                        (.error log
                                (.pos annoTree)
                                (CompilerProperties$Errors/InvalidRepeatableAnnotationNotApplicable
                                  targetContainerType
                                  on)))
                      (when-not (.validateAnnotationDeferErrors chk annoTree)
                        (.error log
                                (.pos annoTree)
                                (CompilerProperties$Errors/DuplicateAnnotationInvalidRepeated
                                  origAnnoType)))
                      (set! c (.attributeAnnotation this annoTree targetContainerType (.-env ctx)))
                      (.setSynthesized c true)
                      (let [^T x c] x)))))))))

  (method ^:private getContainingType ^Type [this ^Attribute$Compound currentAnno
                                             ^JCDiagnostic$DiagnosticPosition pos
                                             ^boolean reportError]
    (let [origAnnoType (.-type currentAnno)
          origAnnoDecl (.-tsym origAnnoType)
          ca (.getRepeatable (.getAnnotationTypeMetadata origAnnoDecl))]
      (if (nil? ca)
          (do
            (when reportError
              (.error log
                      pos
                      (CompilerProperties$Errors/DuplicateAnnotationMissingContainer origAnnoType)))
            nil)
          (.filterSame this (.extractContainingType this ca pos origAnnoDecl) origAnnoType))))

  (method ^:private filterSame ^Type [this ^Type t ^Type s]
    (if (or (nil? t) (nil? s)) t (when-not (.isSameType types t s) t)))

  (method ^:private extractContainingType ^Type [this ^Attribute$Compound ca
                                                 ^JCDiagnostic$DiagnosticPosition pos
                                                 ^Symbol$TypeSymbol annoDecl]
    (if (.isEmpty (.-values ca))
        (do (.error log pos (CompilerProperties$Errors/InvalidRepeatableAnnotation annoDecl)) nil)
        (let [^{:tag (Pair Symbol$MethodSymbol Attribute)} p (cast Pair (.-head (.-values ca)))
              name (.-name (cast Symbol$MethodSymbol (.-fst p)))]
          (if (not (identical? name (.-value names)))
              (do
                (.error log pos (CompilerProperties$Errors/InvalidRepeatableAnnotation annoDecl))
                nil)
              (if-instance [^Attribute$Class attributeClass (.-snd p)]
                (.getValue attributeClass)
                (do
                  (.error log pos (CompilerProperties$Errors/InvalidRepeatableAnnotation annoDecl))
                  nil))))))

  (method ^:private validateContainer ^Symbol$MethodSymbol [this ^Type targetContainerType
                                                            ^Type originalAnnoType
                                                            ^JCDiagnostic$DiagnosticPosition pos]
    (let [^:mutable ^Symbol$MethodSymbol containerValueSymbol nil
          ^:mutable fatalError false
          ^:mutable ^Scope scope nil]
      (try
        (set! scope (.members (.-tsym targetContainerType)))
        (catch Symbol$CompletionFailure ex (.completionError chk pos ex) (return nil)))
      (let [^:mutable ^int nr_value_elems 0
            ^:mutable error false]
        (for-each [^Symbol elm (.getSymbolsByName scope (.-value names))]
          (set! nr_value_elems (unchecked-inc-int nr_value_elems))
          (if (and (== nr_value_elems 1) (identical? (.-kind elm) Kinds$Kind/MTH))
              (set! containerValueSymbol (cast Symbol$MethodSymbol elm))
              (set! error true)))
        (cond
          error
            (do
              (.error log
                      pos
                      (CompilerProperties$Errors/InvalidRepeatableAnnotationMultipleValues
                        targetContainerType
                        nr_value_elems))
              nil)
          (== nr_value_elems 0)
            (do
              (.error log
                      pos
                      (CompilerProperties$Errors/InvalidRepeatableAnnotationNoValue
                        targetContainerType))
              nil)
          :else
            (do
              (when-not (identical? (.-kind containerValueSymbol) Kinds$Kind/MTH)
                (.error log
                        pos
                        (CompilerProperties$Errors/InvalidRepeatableAnnotationInvalidValue
                          targetContainerType))
                (set! fatalError true))
              (let [valueRetType (.getReturnType (.-type containerValueSymbol))
                    ^Type expectedType (.makeArrayType types originalAnnoType)]
                (when-not (and (.isArray types valueRetType)
                               (.isSameType types expectedType valueRetType))
                  (.error log
                          pos
                          (CompilerProperties$Errors/InvalidRepeatableAnnotationValueReturn
                            targetContainerType
                            valueRetType
                            expectedType))
                  (set! fatalError true))
                (when-not fatalError containerValueSymbol)))))))

  (method ^:private makeContainerAnnotation :type-params [(T extends Attribute$Compound)] ^T [this
                                                                                              ^{:tag (List T)} toBeReplaced
                                                                                              ^{:tag (AnnotationContext T)} ctx
                                                                                              ^Symbol sym
                                                                                              ^boolean isTypeParam]
    (let [^T validRepeated (.processRepeatedAnnotations this toBeReplaced ctx sym isTypeParam)]
      (when (some? validRepeated)
        (let [^{:tag (ListBuffer T)} manualContainer (cast
                                                       ListBuffer
                                                       (.get
                                                         (.-annotated ctx)
                                                         (.-tsym (.-type validRepeated))))]
          (when (some? manualContainer)
            (.error
              log
              (cast JCDiagnostic$DiagnosticPosition (.get (.-pos ctx) (.first manualContainer)))
              (CompilerProperties$Errors/InvalidRepeatableAnnotationRepeatedAndContainerPresent
                (.-tsym (.-type (cast Attribute$Compound (.first manualContainer)))))))))
      validRepeated))

  (method ^:public enterTypeAnnotations ^void [this ^{:tag (List JCTree$JCAnnotation)} annotations
                                               ^{:tag (Env AttrContext)} env ^Symbol s
                                               ^boolean isTypeParam]
    (Assert/checkNonNull s "Symbol argument to actualEnterTypeAnnotations is nul/")
    (let [prev (.useSource log (.-sourcefile (.-toplevel env)))]
      (try (.annotateNow this s annotations env true isTypeParam) (finally (.useSource log prev)))))

  (method ^:public queueScanTreeAndTypeAnnotate ^void [this ^JCTree tree
                                                       ^{:tag (Env AttrContext)} env ^Symbol sym]
    (Assert/checkNonNull sym)
    (.normal this (lambda Runnable ^void [] (.accept tree (TypeAnnotate. env sym)))))

  (method ^:public annotateTypeSecondStage ^void [this ^JCTree tree
                                                  ^{:tag (List JCTree$JCAnnotation)} annotations
                                                  ^Type storeAt]
    (.typeAnnotation this
                     (lambda Runnable ^void []
                       (let [^{:tag (List Attribute$TypeCompound)} compounds (.fromAnnotations
                                                                               this
                                                                               annotations)]
                         (Assert/check (== (.size annotations) (.size compounds)))
                         (let [metadata (cast TypeMetadata$Annotations
                                              (.getMetadata storeAt TypeMetadata$Annotations))]
                           (Assert/checkNonNull metadata)
                           (Assert/check (.isEmpty (.annotationBuffer metadata)))
                           (.appendList (.annotationBuffer metadata) compounds))))))

  (method ^:public annotateTypeParameterSecondStage ^void [this ^JCTree tree
                                                           ^{:tag (List JCTree$JCAnnotation)} annotations]
    (.typeAnnotation this
                     (lambda Runnable ^void []
                       (let [^{:tag (List Attribute$TypeCompound)} compounds (.fromAnnotations
                                                                               this
                                                                               annotations)]
                         (Assert/check (== (.size annotations) (.size compounds)))))))

  (defclass ^:private TypeAnnotate
    :extends TreeScanner

    (field ^:private ^:final ^{:tag (Env AttrContext)} env)

    (field ^:private ^:final ^Symbol sym)

    (constructor ^:public [this ^{:tag (Env AttrContext)} env ^Symbol sym]
      (set! (.-env this) env)
      (set! (.-sym this) sym))

    (method ^:public visitAnnotatedType ^void [this ^JCTree$JCAnnotatedType tree]
      (.enterTypeAnnotations Annotate/this (.-annotations tree) env sym false)
      (.scan this (.-underlyingType tree)))

    (method ^:public visitTypeParameter ^void [this ^JCTree$JCTypeParameter tree]
      (.enterTypeAnnotations Annotate/this (.-annotations tree) env sym true)
      (.scan this (.-bounds tree)))

    (method ^:public visitNewArray ^void [this ^JCTree$JCNewArray tree]
      (.enterTypeAnnotations Annotate/this (.-annotations tree) env sym false)
      (for-each [^{:tag (List JCTree$JCAnnotation)} dimAnnos (.-dimAnnotations tree)]
        (.enterTypeAnnotations Annotate/this dimAnnos env sym false))
      (.scan this (.-elemtype tree))
      (.scan this (.-elems tree)))

    (method ^:public visitMethodDef ^void [this ^JCTree$JCMethodDecl tree]
      (.scan this (.-mods tree))
      (.scan this (.-restype tree))
      (.scan this (.-typarams tree))
      (.scan this (.-recvparam tree))
      (.scan this (.-params tree))
      (.scan this (.-thrown tree))
      (.scan this (.-defaultValue tree)))

    (method ^:public visitVarDef ^void [this ^JCTree$JCVariableDecl tree]
      (when (and (some? sym) (identical? (.-kind sym) Kinds$Kind/VAR))
        (.scan this (.-mods tree))
        (.scan this (.-vartype tree)))
      (.scan this (.-init tree)))

    (method ^:public visitBindingPattern ^void [this ^JCTree$JCBindingPattern tree])

    (method ^:public visitClassDef ^void [this ^JCTree$JCClassDecl tree])

    (method ^:public visitNewClass ^void [this ^JCTree$JCNewClass tree]
      (.scan this (.-encl tree))
      (.scan this (.-typeargs tree))
      (try
        (set! (.-isAnonymousNewClass (cast AttrContext (.-info env))) (some? (.-def tree)))
        (.scan this (.-clazz tree))
        (finally (set! (.-isAnonymousNewClass (cast AttrContext (.-info env))) false)))
      (.scan this (.-args tree)))

    (method ^:public visitErroneous ^void [this ^JCTree$JCErroneous tree]
      (when (some? (.-errs tree)) (for-each [^JCTree err (.-errs tree)] (.scan this err)))))

  (field ^:private ^AnnotationTypeCompleter theSourceCompleter
    (anon AnnotationTypeCompleter []
      (method ^:public complete :throws [Symbol$CompletionFailure] ^void [this
                                                                          ^Symbol$ClassSymbol sym]
        (let [^{:tag (Env AttrContext)} context (.get typeEnvs sym)]
          (.attributeAnnotationType Annotate/this context)))))

  (method ^:public annotationTypeSourceCompleter ^AnnotationTypeCompleter [this]
    theSourceCompleter)

  (method ^:private attributeAnnotationType ^void [this ^{:tag (Env AttrContext)} env]
    (Assert/check (.isAnnotationType (.-sym (cast JCTree$JCClassDecl (.-tree env))))
                  "Trying to annotation type complete a non-annotation type")
    (let [prev (.useSource log (.-sourcefile (.-toplevel env)))]
      (try
        (let [tree (cast JCTree$JCClassDecl (.-tree env))
              v (AnnotationTypeVisitor. attr chk syms typeEnvs)]
          (.scanAnnotationType v tree)
          (.setRepeatable (.getAnnotationTypeMetadata (.-sym tree)) (.-repeatable v))
          (.setTarget (.getAnnotationTypeMetadata (.-sym tree)) (.-target v)))
        (finally (.useSource log prev)))))

  (method ^:public unfinishedDefaultValue ^Attribute [this]
    theUnfinishedDefaultValue)

  (defclass ^:public ^:static ^:interface AnnotationTypeCompleter
    (method complete :throws [Symbol$CompletionFailure] ^void [this ^Symbol$ClassSymbol sym]))

  (defclass ^:public AnnotationTypeVisitor
    :extends TreeScanner

    (field ^:private ^{:tag (Env AttrContext)} env)

    (field ^:private ^:final ^Attr attr)

    (field ^:private ^:final ^Check check)

    (field ^:private ^:final ^Symtab tab)

    (field ^:private ^:final ^TypeEnvs typeEnvs)

    (field ^:private ^Attribute$Compound target)

    (field ^:private ^Attribute$Compound repeatable)

    (constructor ^:public [this ^Attr attr ^Check check ^Symtab tab ^TypeEnvs typeEnvs]
      (set! (.-attr this) attr)
      (set! (.-check this) check)
      (set! (.-tab this) tab)
      (set! (.-typeEnvs this) typeEnvs))

    (method ^:public getRepeatable ^Attribute$Compound [this] repeatable)

    (method ^:public getTarget ^Attribute$Compound [this] target)

    (method ^:public scanAnnotationType ^void [this ^JCTree$JCClassDecl decl]
      (.visitClassDef this decl))

    (method ^:public visitClassDef ^void [this ^JCTree$JCClassDecl tree]
      (let [^{:tag (Env AttrContext)} prevEnv env]
        (set! env (.get typeEnvs (.-sym tree)))
        (try (.scan this (.-mods tree)) (finally (set! env prevEnv)))))

    (method ^:public visitAnnotation ^void [this ^JCTree$JCAnnotation tree]
      (let [^:mutable t (.-type (.-annotationType tree))]
        (when (nil? t)
          (set! t (.attribType attr (.-annotationType tree) env))
          (set! (.-type (.-annotationType tree))
                (set! t (.checkType check (.pos (.-annotationType tree)) t (.-annotationType tab)))))
        (cond
          (identical? t (.-annotationTargetType tab))
            (set! target (.attributeAnnotation Annotate/this tree (.-annotationTargetType tab) env))
          (identical? t (.-repeatableType tab))
            (set! repeatable (.attributeAnnotation Annotate/this tree (.-repeatableType tab) env))))))

  (defclass ^:public ^:static AnnotationTypeMetadata
    (field ^:final ^Symbol$ClassSymbol metaDataFor)

    (field ^:private ^Attribute$Compound target)

    (field ^:private ^Attribute$Compound repeatable)

    (field ^:private ^AnnotationTypeCompleter annotationTypeCompleter)

    (constructor ^:public [this ^Symbol$ClassSymbol metaDataFor
                           ^AnnotationTypeCompleter annotationTypeCompleter]
      (set! (.-metaDataFor this) metaDataFor)
      (set! (.-annotationTypeCompleter this) annotationTypeCompleter))

    (method ^:private init ^void [this]
      (while (not (.isCompleted metaDataFor)) (.complete metaDataFor))
      (when (some? annotationTypeCompleter)
        (let [c annotationTypeCompleter]
          (set! annotationTypeCompleter nil)
          (.complete c metaDataFor))))

    (method ^:public complete ^void [this] (.init this))

    (method ^:public getRepeatable ^Attribute$Compound [this]
      (.init this)
      repeatable)

    (method ^:public setRepeatable ^void [this ^Attribute$Compound repeatable]
      (Assert/checkNull (.-repeatable this))
      (set! (.-repeatable this) repeatable))

    (method ^:public getTarget ^Attribute$Compound [this]
      (.init this)
      target)

    (method ^:public setTarget ^void [this ^Attribute$Compound target]
      (Assert/checkNull (.-target this))
      (set! (.-target this) target))

    (method ^:public getAnnotationElements ^{:tag (Set Symbol$MethodSymbol)} [this]
      (.init this)
      (let [^{:tag (Set Symbol$MethodSymbol)} members (LinkedHashSet.)
            s (.members metaDataFor)
            ^{:tag (Iterable Symbol)} ss (.getSymbols s Scope$LookupKind/NON_RECURSIVE)]
        (for-each [^Symbol sym ss]
          (when (and (and (identical? (.-kind sym) Kinds$Kind/MTH)
                          (not
                            (identical? (.-name sym) (.-clinit (.-names (.-table (.-name sym)))))))
                     (== (bit-and (.flags sym) Flags/SYNTHETIC) 0))
            (.add members (cast Symbol$MethodSymbol sym))))
        members))

    (method ^:public getAnnotationElementsWithDefault ^{:tag (Set Symbol$MethodSymbol)} [this]
      (.init this)
      (let [^{:tag (Set Symbol$MethodSymbol)} members (.getAnnotationElements this)
            ^{:tag (Set Symbol$MethodSymbol)} res (LinkedHashSet.)]
        (for-each [^Symbol$MethodSymbol m members] (when (some? (.-defaultValue m)) (.add res m)))
        res))

    (method ^:public toString ^String [this]
      (java-str "Annotation type for: " metaDataFor))

    (method ^:public isMetadataForAnnotationType ^boolean [this] true)

    (method ^:public ^:static notAnAnnotationType ^AnnotationTypeMetadata []
      NOT_AN_ANNOTATION_TYPE)

    (field ^:private ^:static ^:final ^AnnotationTypeMetadata NOT_AN_ANNOTATION_TYPE
      (anon AnnotationTypeMetadata [nil nil]
        (method ^:public complete ^void [this])

        (method ^:public toString ^String [this] "Not an annotation type")

        (method ^:public getAnnotationElements ^{:tag (Set Symbol$MethodSymbol)} [this]
          (LinkedHashSet. 0))

        (method ^:public getAnnotationElementsWithDefault ^{:tag (Set Symbol$MethodSymbol)} [this]
          (LinkedHashSet. 0))

        (method ^:public isMetadataForAnnotationType ^boolean [this] false)

        (method ^:public getTarget ^Attribute$Compound [this] nil)

        (method ^:public getRepeatable ^Attribute$Compound [this] nil))))

  (method ^:public newRound ^void [this] (set! blockCount 1))

  (method ^:public setQueues ^Queues [this ^Queues nue]
    (let [stored (Queues. q validateQ typesQ afterTypesQ)]
      (set! (.-q this) (.-q nue))
      (set! (.-typesQ this) (.-typesQ nue))
      (set! (.-afterTypesQ this) (.-afterTypesQ nue))
      (set! (.-validateQ this) (.-validateQ nue))
      stored))

  (defclass ^:static Queues
    (field ^:private ^:final ^{:tag (ListBuffer Runnable)} q)

    (field ^:private ^:final ^{:tag (ListBuffer Runnable)} validateQ)

    (field ^:private ^:final ^{:tag (ListBuffer Runnable)} typesQ)

    (field ^:private ^:final ^{:tag (ListBuffer Runnable)} afterTypesQ)

    (constructor ^:public [this]
      (this. (ListBuffer.) (ListBuffer.) (ListBuffer.) (ListBuffer.)))

    (constructor ^:public [this ^{:tag (ListBuffer Runnable)} q
                           ^{:tag (ListBuffer Runnable)} validateQ
                           ^{:tag (ListBuffer Runnable)} typesQ
                           ^{:tag (ListBuffer Runnable)} afterTypesQ]
      (set! (.-q this) q)
      (set! (.-validateQ this) validateQ)
      (set! (.-typesQ this) typesQ)
      (set! (.-afterTypesQ this) afterTypesQ))))

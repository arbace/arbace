              ^:mutable elidedValue false]
          (when (and (== (.length args) 1)
                     (not (.hasTag (cast JCTree$JCExpression (.-head args)) JCTree$Tag/ASSIGN)))
            (set! (.-head args)
                  (.Assign (.at make (.-pos (cast JCTree$JCExpression (.-head args))))
                           (.Ident make (.-value names))
                           (cast JCTree$JCExpression (.-head args))))
            (set! elidedValue true))
          (let [^{:tag (ListBuffer (Pair Symbol$MethodSymbol Attribute))} buf (ListBuffer.)]

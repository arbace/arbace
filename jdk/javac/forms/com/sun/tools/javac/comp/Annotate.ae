  (method ^:private attributeAnnotationValues ^{:tag (List (Pair Symbol$MethodSymbol Attribute))} [this
                                                                                                   ^JCTree$JCAnnotation a
                                                                                                   ^Type expected
                                                                                                   ^{:tag (Env AttrContext)} env]

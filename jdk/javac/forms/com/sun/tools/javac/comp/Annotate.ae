                      (.pos (.-elemtype na))
                      CompilerProperties$Errors/NewNotAllowedInAnnotation))
            (loop [^{:tag (List JCTree$JCExpression)} l (.-elems na)]
              (when (.nonEmpty l)
                (.attributeAnnotationValue this
                                           (.-errType syms)
                                           (cast JCTree$JCExpression (.-head l))
                                           env)
                (recur (.-tail l))))
            (Attribute$Error. (.-errType syms))))
      :else
        (do
          (when (.isAnnotationType (.-tsym expectedElementType))
            (if (.hasTag tree JCTree$Tag/ANNOTATION)
                (return (.attributeAnnotation this
                                              (cast JCTree$JCAnnotation tree)
                                              expectedElementType

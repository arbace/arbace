                (do
                  (.error log (.pos tree) CompilerProperties$Errors/AnnotationValueMustBeAnnotation)
                  (set! expectedElementType (.-errType syms)))))
          (if (.hasTag tree JCTree$Tag/ANNOTATION)
              (do
                (when-not (.isErroneous expectedElementType)
                  (.error log
                          (.pos tree)
                          (CompilerProperties$Errors/AnnotationNotValidForType expectedElementType)))
                (.attributeAnnotation this (cast JCTree$JCAnnotation tree) (.-errType syms) env)
                (Attribute$Error. (.-type (.-annotationType (cast JCTree$JCAnnotation tree)))))
              (let [^MemberEnter$InitTreeVisitor initTreeVisitor
                      (anon MemberEnter$InitTreeVisitor []
                        (method ^:public visitTypeIdent ^void [this ^JCTree$JCPrimitiveTypeTree that])

                        (method ^:public visitTypeArray ^void [this ^JCTree$JCArrayTypeTree that]))]
                (.accept tree initTreeVisitor)

                  (not (.-result initTreeVisitor))
                    (do
                      (.error log
                              (.pos tree)
                              CompilerProperties$Errors/ExpressionNotAllowableAsAnnotationValue)
                      (Attribute$Error. (.-errType syms)))
                  (or (.isPrimitive expectedElementType)
                      (and (.isSameType types expectedElementType (.-stringType syms))
                           (not (.hasTag expectedElementType TypeTag/ERROR))))

          (.-preferredTreeForDiagnostics (cast AttrContext (.-info env)))
          (.-tree env)))

    (method ^:abstract checkArg ^void [this ^JCDiagnostic$DiagnosticPosition pos ^boolean varargs
                                       ^Type actual ^Type formal
                                       ^DeferredAttr$DeferredAttrContext deferredAttrContext
                                       ^Warner warn])

    (method ^:protected reportMC ^void [this ^JCDiagnostic$DiagnosticPosition pos
                                        ^MethodCheckDiag diag ^InferenceContext inferenceContext &
                                        ^:mutable ^Object/1 args]
      (let [inferDiag (not (identical? inferenceContext (.-emptyContext infer)))]
        (when (and inferDiag (not (.equals (.-inferKey diag) (.-basicKey diag))))
          (let [args2 (new Object/1 (unchecked-add-int (alength args) 1))]

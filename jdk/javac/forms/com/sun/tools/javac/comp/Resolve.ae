                                          (.get (.-visiblePackages currModule) (.-fullname p))
                                          p))
                                    (identical? p (.-rootPackage syms)))
                                (and (identical? (.-modle p) (.-unnamedModule syms))
                                     (.contains (.-readModules currModule) (.-modle p)))))))
                  (set! isAccessible true))
            Flags/PROTECTED
              (set! isAccessible
                    (or (or (or (identical? (.-packge (.-toplevel env)) (.-owner c))
                                (identical? (.-packge (.-toplevel env)) (.packge c)))
                            (.isInnerSubClass this (.-sym (.-enclClass env)) (.-owner c)))
                        (.-allowProtectedAccess (cast AttrContext (.-info env)))))
            (set! isAccessible true))
          (if (or (= checkInner false) (identical? (.getEnclosingType (.-type c)) Type/noType))

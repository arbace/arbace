                                                 (method ^:public report ^void [this
                                                                                ^JCDiagnostic$DiagnosticPosition pos
                                                                                ^JCDiagnostic details]
                                                   (.reportMC
                                                     this1
                                                     pos
                                                     methodDiag
                                                     (.-inferenceContext
                                                       (.-deferredAttrContext this))
                                                     details)))]
          (MethodResultInfo. to checkContext)))

      (method ^:public mostSpecificCheck ^MethodCheck [this ^{:tag (List Type)} actuals]
        (MostSpecificCheck. actuals))

      (method ^:public toString ^String [this] "resolveMethodCheck")))


  (defclass ^:abstract AbstractMethodCheck
    :implements [MethodCheck]

    (method ^:public argumentsAcceptable ^void [this ^:final ^{:tag (Env AttrContext)} env
                                                ^DeferredAttr$DeferredAttrContext deferredAttrContext
                                                ^:mutable ^{:tag (List Type)} argtypes
                                                ^:mutable ^{:tag (List Type)} formals ^Warner warn]
      (let [useVarargs (.isVarargsRequired (.-phase deferredAttrContext))
            callTree (.treeForDiagnostics this env)
            ^:mutable ^{:tag (List JCTree$JCExpression)} trees (TreeInfo/args callTree)
            inferenceContext (.-inferenceContext deferredAttrContext)
            ^Type varargsFormal (when useVarargs (cast Type (.last formals)))]
        (when (and (nil? varargsFormal) (not (== (.size argtypes) (.size formals))))
          (.reportMC this callTree MethodCheckDiag/ARITY_MISMATCH inferenceContext))
        (while (and (.nonEmpty argtypes) (not (identical? (.-head formals) varargsFormal)))
          (let [^JCDiagnostic$DiagnosticPosition pos (when (some? trees)
                                                       (cast
                                                         JCDiagnostic$DiagnosticPosition
                                                         (.-head trees)))]
            (.checkArg this
                       pos
                       false
                       (cast Type (.-head argtypes))
                       (cast Type (.-head formals))
                       deferredAttrContext
                       warn)
            (set! argtypes (.-tail argtypes))
            (set! formals (.-tail formals))
            (set! trees (if (some? trees) (.-tail trees) trees))))
        (when-not (identical? (.-head formals) varargsFormal)
          (.reportMC this callTree MethodCheckDiag/ARITY_MISMATCH inferenceContext))
        (when useVarargs
          (let [elt (.elemtype types varargsFormal)]
            (while (.nonEmpty argtypes)
              (let [^JCDiagnostic$DiagnosticPosition pos (when (some? trees)
                                                           (cast
                                                             JCDiagnostic$DiagnosticPosition
                                                             (.-head trees)))]

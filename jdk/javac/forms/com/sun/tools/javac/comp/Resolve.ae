  (defclass MostSpecificCheck
    :implements [MethodCheck]

    (field ^{:tag (List Type)} actuals)

    (constructor [this ^{:tag (List Type)} actuals]
      (set! (.-actuals this) actuals))

    (method ^:public argumentsAcceptable ^void [this ^:final ^{:tag (Env AttrContext)} env
                                                ^DeferredAttr$DeferredAttrContext deferredAttrContext
                                                ^:mutable ^{:tag (List Type)} formals1
                                                ^:mutable ^{:tag (List Type)} formals2 ^Warner warn]
      (set! formals2
            (.adjustArgs Resolve/this
                         formals2
                         (.-msym deferredAttrContext)
                         (.length formals1)
                         (.isVarargsRequired (.-phase deferredAttrContext))))
      (while (.nonEmpty formals2)
        (let [mresult (.methodCheckResult this
                                          (cast Type (.-head formals2))
                                          deferredAttrContext
                                          warn
                                          (cast Type (.-head actuals)))]
          (.check mresult nil (cast Type (.-head formals1)))
          (set! formals1 (.-tail formals1))
          (set! formals2 (.-tail formals2))
          (set! actuals (if (.isEmpty actuals) actuals (.-tail actuals))))))

    (method methodCheckResult ^Attr$ResultInfo [this ^Type to
                                                ^DeferredAttr$DeferredAttrContext deferredAttrContext
                                                ^Warner rsWarner ^Type actual]
      (.new attr
            Attr$ResultInfo
            Kinds$KindSelector/VAL
            to
            (MostSpecificCheckContext. deferredAttrContext rsWarner actual)))

    (defclass MostSpecificCheckContext
      :extends MethodCheckContext

      (field ^Type actual)

      (constructor ^:public [this ^DeferredAttr$DeferredAttrContext deferredAttrContext
                             ^Warner rsWarner ^Type actual]
        (super. true deferredAttrContext rsWarner)
        (set! (.-actual this) actual))

      (method ^:public compatible ^boolean [this ^Type found ^Type req ^Warner warn]
        (when (and (.unrelatedFunctionalInterfaces this found req)
                   (and (some? actual) (identical? (.getTag actual) TypeTag/DEFERRED)))
          (let [dt (cast DeferredAttr$DeferredType actual)
                speculativeTree (.speculativeTree dt (.-deferredAttrContext this))]
            (when-not (identical? speculativeTree (.-stuckTree deferredAttr))
              (return (.functionalInterfaceMostSpecific this found req speculativeTree)))))
        (.compatibleBySubtyping this found req))

      (method ^:private compatibleBySubtyping ^boolean [this ^:mutable ^Type found ^Type req]
        (when (and (not (.-strict this)) (not (= (.isPrimitive found) (.isPrimitive req))))
          (set! found
                (if (.isPrimitive found)
                    (.-type (.boxedClass types found))
                    (.unboxedType types found))))
        (.isSubtypeNoCapture types
                             found
                             (.asUndetVar (.-inferenceContext (.-deferredAttrContext this)) req)))

      (method ^:private unrelatedFunctionalInterfaces ^boolean [this ^Type t ^Type s]
        (and (and (.isFunctionalInterface types (.-tsym t))
                  (.isFunctionalInterface types (.-tsym s)))
             (.unrelatedInterfaces this t s)))

      (method ^:private unrelatedInterfaces ^boolean [this ^Type t ^Type s]
        (cond
          (.isCompound t)
            (do
              (for-each [^Type ti (.interfaces types t)]
                (when-not (.unrelatedInterfaces this ti s) (return false)))
              true)
          (.isCompound s)
            (do
              (for-each [^Type si (.interfaces types s)]
                (when-not (.unrelatedInterfaces this t si) (return false)))
              true)
          :else (and (nil? (.asSuper types t (.-tsym s))) (nil? (.asSuper types s (.-tsym t))))))

      (method ^:private functionalInterfaceMostSpecific ^boolean [this ^Type t ^Type s ^JCTree tree]
        (let [^:mutable ^Type tDesc nil
              ^:mutable ^Type tDescNoCapture nil
              ^:mutable ^Type sDesc nil]
          (try
            (set! tDesc (.findDescriptorType types (.capture types t)))
            (set! tDescNoCapture (.findDescriptorType types t))
            (set! sDesc (.findDescriptorType types s))
            (catch Types$FunctionDescriptorLookupError ex (return false)))
          (let [^{:tag (List Type)} tTypeParams (.getTypeArguments tDesc)
                ^{:tag (List Type)} tTypeParamsNoCapture (.getTypeArguments tDescNoCapture)
                ^{:tag (List Type)} sTypeParams (.getTypeArguments sDesc)]
            (if (and (.hasTag tDesc TypeTag/FORALL)
                     (not (.hasSameBounds types
                                          (cast Type$ForAll tDesc)
                                          (cast Type$ForAll tDescNoCapture))))
                false
                (let [^:mutable ^{:tag (List Type)} tIter tTypeParams
                      ^:mutable ^{:tag (List Type)} sIter sTypeParams]
                  (while (and (.nonEmpty tIter) (.nonEmpty sIter))
                    (let [tBound (.getUpperBound (cast Type (.-head tIter)))
                          sBound (.subst types
                                         (.getUpperBound (cast Type (.-head sIter)))
                                         sTypeParams
                                         tTypeParams)]
                      (when (and (.containsAny tBound tTypeParams)
                                 (.free (.inferenceContext this) sBound))
                        (return false))
                      (when-not (.isSameType types
                                             tBound
                                             (.asUndetVar (.inferenceContext this) sBound))
                        (return false))
                      (set! tIter (.-tail tIter))
                      (set! sIter (.-tail sIter))))
                  (if (or (not (.isEmpty tIter)) (not (.isEmpty sIter)))
                      false
                      (let [^:mutable ^{:tag (List Type)} tParams (.getParameterTypes tDesc)
                            ^:mutable ^{:tag (List Type)} tParamsNoCapture (.getParameterTypes
                                                                             tDescNoCapture)
                            ^:mutable ^{:tag (List Type)} sParams (.getParameterTypes sDesc)]
                        (while (and (and (.nonEmpty tParams) (.nonEmpty tParamsNoCapture))
                                    (.nonEmpty sParams))
                          (let [tParam (cast Type (.-head tParams))
                                tParamNoCapture (.subst
                                                  types
                                                  (cast Type (.-head tParamsNoCapture))
                                                  tTypeParamsNoCapture
                                                  tTypeParams)
                                sParam (.subst types
                                               (cast Type (.-head sParams))
                                               sTypeParams
                                               tTypeParams)]
                            (when (and (.containsAny tParam tTypeParams)
                                       (.free (.inferenceContext this) sParam))
                              (return false))
                            (when-not (.isSubtype
                                        types
                                        (.asUndetVar (.inferenceContext this) sParam)
                                        tParam)
                              (return false))
                            (when-not (.isSameType
                                        types
                                        tParamNoCapture
                                        (.asUndetVar (.inferenceContext this) sParam))
                              (return false))
                            (set! tParams (.-tail tParams))
                            (set! tParamsNoCapture (.-tail tParamsNoCapture))
                            (set! sParams (.-tail sParams))))
                        (if (or (or (not (.isEmpty tParams)) (not (.isEmpty tParamsNoCapture)))
                                (not (.isEmpty sParams)))
                            false
                            (let [tRet (.getReturnType tDesc)
                                  sRet (.subst types (.getReturnType sDesc) sTypeParams tTypeParams)]
                              (if (and (.containsAny tRet tTypeParams)
                                       (.free (.inferenceContext this) sRet))
                                  false
                                  (let [msc (MostSpecificFunctionReturnChecker. tRet sRet)]
                                    (.scan msc tree)
                                    (.-result msc))))))))))))

      (defclass MostSpecificFunctionReturnChecker
        :extends DeferredAttr$PolyScanner

        (field ^:final ^Type tRet)

        (field ^:final ^Type sRet)

        (field ^boolean result)

        (constructor [this ^Type tRet ^Type sRet]
          (set! (.-tRet this) tRet)
          (set! (.-sRet this) sRet)
          (set! result true))

        (method skip ^void [this ^JCTree tree] (set! result false))

        (method ^:public visitConditional ^void [this ^JCTree$JCConditional tree]
          (.scan this (.asExpr this (.-truepart tree)))
          (.scan this (.asExpr this (.-falsepart tree))))

        (method ^:public visitReference ^void [this ^JCTree$JCMemberReference tree]
          (when-not (.hasTag sRet TypeTag/VOID)
            (cond
              (.hasTag tRet TypeTag/VOID) (set! result false)
              (not (= (.isPrimitive tRet) (.isPrimitive sRet)))
                (let [retValIsPrimitive (and (identical?
                                               (.-refPolyKind tree)
                                               JCTree$JCPolyExpression$PolyKind/STANDALONE)
                                             (.isPrimitive (.getReturnType (.-type (.-sym tree)))))]
                  (set! result
                        (let [a-1 result
                              b-2 (and (= retValIsPrimitive (.isPrimitive tRet))
                                       (not (= retValIsPrimitive (.isPrimitive sRet))))]
                          (and a-1 b-2))))
              :else
                (set! result
                      (let [a-3 result
                            b-4 (.compatibleBySubtyping MostSpecificCheckContext/this tRet sRet)]
                        (and a-3 b-4))))))

        (method ^:public visitParens ^void [this ^JCTree$JCParens tree]
          (.scan this (.asExpr this (.-expr tree))))

        (method ^:public visitLambda ^void [this ^JCTree$JCLambda tree]
          (when-not (.hasTag sRet TypeTag/VOID)
            (if (.hasTag tRet TypeTag/VOID)
                (set! result false)
                (let [^{:tag (List JCTree$JCExpression)} lambdaResults (.lambdaResults this tree)]
                  (cond
                    (and (not (.isEmpty lambdaResults))
                         (.unrelatedFunctionalInterfaces MostSpecificCheckContext/this tRet sRet))
                      (for-each [^JCTree$JCExpression expr lambdaResults]
                        (set! result
                              (let [a-5 result
                                    b-6 (.functionalInterfaceMostSpecific
                                          MostSpecificCheckContext/this
                                          tRet
                                          sRet
                                          expr)]
                                (and a-5 b-6))))
                    (and (not (.isEmpty lambdaResults))
                         (not (= (.isPrimitive tRet) (.isPrimitive sRet))))
                      (for-each [^JCTree$JCExpression expr lambdaResults]
                        (let [retValIsPrimitive (and
                                                  (.isStandalone expr)
                                                  (.isPrimitive (.-type expr)))]
                          (set! result
                                (let [a-7 result
                                      b-8 (and (= retValIsPrimitive (.isPrimitive tRet))
                                               (not (= retValIsPrimitive (.isPrimitive sRet))))]
                                  (and a-7 b-8)))))
                    :else
                      (set! result
                            (let [a-9 result
                                  b-10 (.compatibleBySubtyping
                                         MostSpecificCheckContext/this
                                         tRet
                                         sRet)]
                              (and a-9 b-10))))))))

        (method ^:private lambdaResults ^{:tag (List JCTree$JCExpression)} [this
                                                                            ^JCTree$JCLambda lambda]
          (if (identical? (.getBodyKind lambda) LambdaExpressionTree$BodyKind/EXPRESSION)
              (List/of (.asExpr this (cast JCTree$JCExpression (.-body lambda))))
              (let [^{:tag (ListBuffer JCTree$JCExpression)} buffer (ListBuffer.)
                    ^DeferredAttr$LambdaReturnScanner lambdaScanner
                      (anon DeferredAttr$LambdaReturnScanner []
                        (method ^:public visitReturn ^void [this ^JCTree$JCReturn tree]
                          (when (some? (.-expr tree))
                            (.append buffer
                                     (.asExpr MostSpecificFunctionReturnChecker/this (.-expr tree))))))]
                (.scan lambdaScanner (.-body lambda))
                (.toList buffer))))

        (method ^:private asExpr ^JCTree$JCExpression [this ^:mutable ^JCTree$JCExpression expr]
          (when (.hasTag (.-type expr) TypeTag/DEFERRED)
            (let [speculativeTree (.speculativeTree
                                    (cast DeferredAttr$DeferredType (.-type expr))
                                    (.-deferredAttrContext MostSpecificCheckContext/this))]
              (when-not (identical? speculativeTree (.-stuckTree deferredAttr))
                (set! expr (cast JCTree$JCExpression speculativeTree)))))
          expr)))

    (method ^:public mostSpecificCheck ^MethodCheck [this ^{:tag (List Type)} actuals]
      (Assert/error "Cannot get here!")
      nil))

  (defclass ^:public ^:static InapplicableMethodException
    :extends CompilerInternalException

    (field ^:private ^:static ^:final ^long serialVersionUID 0)

    (field ^:transient ^JCDiagnostic diagnostic)


        (if (.free inferenceContext t)
            (.addFreeTypeListener
              inferenceContext
              (List/of t)
              (lambda Infer$FreeTypeListener ^void [^InferenceContext solvedContext]
                (.varargsAccessible this env (.asInstType solvedContext t) solvedContext)))

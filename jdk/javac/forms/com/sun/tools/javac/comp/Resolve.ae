  (method rawInstantiate :throws [Infer$InferenceException] ^Type [this
                                                                   ^{:tag (Env AttrContext)} env
                                                                   ^Type site ^Symbol m
                                                                   ^Attr$ResultInfo resultInfo
                                                                   ^{:tag (List Type)} argtypes
                                                                   ^:mutable ^{:tag (List Type)} typeargtypes
                                                                   ^boolean allowBoxing
                                                                   ^boolean useVarargs ^Warner warn]
    (let [^:mutable mt (.memberType types site m)
          ^:mutable ^{:tag (List Type)} tvars (List/nil)]
      (when (nil? typeargtypes) (set! typeargtypes (List/nil)))
      (when-not (and (not (.hasTag mt TypeTag/FORALL)) (.nonEmpty typeargtypes))
        (cond
          (and (.hasTag mt TypeTag/FORALL) (.nonEmpty typeargtypes))
            (let [pmt (cast Type$ForAll mt)]
              (when-not (== (.length typeargtypes) (.length (.-tvars pmt)))
                (throw (InapplicableMethodException.
                         (.fragment diags
                                    (CompilerProperties$Fragments/WrongNumberTypeArgs
                                      (Integer/toString (.length (.-tvars pmt)))))
                         dumpStacktraceOnError)))
              (let [^:mutable ^{:tag (List Type)} formals (.-tvars pmt)
                    ^:mutable ^{:tag (List Type)} actuals typeargtypes]
                (while (and (.nonEmpty formals) (.nonEmpty actuals))
                  (let [^:mutable ^{:tag (List Type)} bounds (.subst
                                                               types
                                                               (.getBounds
                                                                 types
                                                                 (cast
                                                                   Type$TypeVar
                                                                   (.-head formals)))
                                                               (.-tvars pmt)
                                                               typeargtypes)]
                    (while (.nonEmpty bounds)
                      (when-not (.isSubtypeUnchecked
                                  types
                                  (cast Type (.-head actuals))
                                  (cast Type (.-head bounds))
                                  warn)
                        (throw (InapplicableMethodException.
                                 (.fragment
                                   diags
                                   (CompilerProperties$Fragments/ExplicitParamDoNotConformToBounds
                                     (cast Type (.-head actuals))
                                     bounds))
                                 dumpStacktraceOnError)))
                      (set! bounds (.-tail bounds)))
                    (set! formals (.-tail formals))
                    (set! actuals (.-tail actuals))))
                (set! mt (.subst types (.-qtype pmt) (.-tvars pmt) typeargtypes))))
          (.hasTag mt TypeTag/FORALL)
            (let [pmt (cast Type$ForAll mt)
                  ^{:tag (List Type)} tvars1 (.newInstances types (.-tvars pmt))]
              (set! tvars (.appendList tvars tvars1))
              (set! mt (.subst types (.-qtype pmt) (.-tvars pmt) tvars1)))))
      (let [^:mutable instNeeded (some? (.-tail tvars))]
        (loop [^{:tag (List Type)} l argtypes]
          (if (and (some? (.-tail l)) (not instNeeded))
              (if (.hasTag (cast Type (.-head l)) TypeTag/FORALL)
                  (do (set! instNeeded true) (recur (.-tail l)))
                  (recur (.-tail l)))
              nil))
        (if instNeeded
            (.instantiateMethod infer
                                env
                                tvars
                                (cast Type$MethodType mt)
                                resultInfo
                                (cast Symbol$MethodSymbol m)
                                argtypes
                                allowBoxing
                                useVarargs
                                currentResolutionContext
                                warn)
            (let [dc (.deferredAttrContext currentResolutionContext
                                           m
                                           (.-emptyContext infer)
                                           resultInfo
                                           warn)]
              (.argumentsAcceptable (.-methodCheck currentResolutionContext)
                                    env
                                    dc
                                    argtypes
                                    (.getParameterTypes mt)
                                    warn)
              (.complete dc)
              mt)))))

  (method checkMethod ^Type [this ^{:tag (Env AttrContext)} env ^Type site ^Symbol m
                             ^Attr$ResultInfo resultInfo ^{:tag (List Type)} argtypes
                             ^{:tag (List Type)} typeargtypes ^Warner warn]
    (let [prevContext currentResolutionContext]
      (try
        (set! currentResolutionContext (MethodResolutionContext.))
        (set! (.-attrMode currentResolutionContext)
              (if (identical? (.-pt resultInfo) Infer/anyPoly)
                  DeferredAttr$AttrMode/SPECULATIVE
                  DeferredAttr$AttrMode/CHECK))

  (method ^:private isInnerSubClass ^boolean [this ^:mutable ^Symbol$ClassSymbol c ^Symbol base]
    (while (and (some? c) (not (.isSubClass c base types))) (set! c (.enclClass (.-owner c))))
    (some? c))


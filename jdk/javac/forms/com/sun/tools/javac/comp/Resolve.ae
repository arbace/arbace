      (method ^:public argumentsAcceptable ^void [this ^:final ^{:tag (Env AttrContext)} env
                                                  ^DeferredAttr$DeferredAttrContext deferredAttrContext
                                                  ^{:tag (List Type)} argtypes
                                                  ^{:tag (List Type)} formals ^Warner warn]
        (.argumentsAcceptable super env deferredAttrContext argtypes formals warn)

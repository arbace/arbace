                (MethodReferenceCheck. (.inferenceContext (.-checkContext resultInfo)))))
        (let [step (set! (.-step currentResolutionContext)
                         (.-pendingResolutionPhase (cast AttrContext (.-info env))))]
          (.rawInstantiate this
                           env
                           site
                           m
                           resultInfo
                           argtypes
                           typeargtypes
                           (.isBoxingRequired step)
                           (.isVarargsRequired step)
                           warn))
        (finally (set! currentResolutionContext prevContext)))))


  (method isAccessible ^boolean [this ^{:tag (Env AttrContext)} env ^Type t ^boolean checkInner]
    (cond
      (.hasTag t TypeTag/ARRAY) (.isAccessible this env (.cvarUpperBound types (.elemtype types t)))
      (.isUnion t)
        (.allMatch (StreamSupport/stream
                     (.spliterator (.getAlternativeTypes (cast Type$UnionClassType t)))
                     false)
                   (lambda Predicate ^boolean [^Type alternative]
                     (.isAccessible this env (.-tsym alternative) checkInner)))
      :else (.isAccessible this env (.-tsym t) checkInner)))

  (method ^:public isAccessible ^boolean [this ^{:tag (Env AttrContext)} env ^Type site ^Symbol sym]
    (.isAccessible this env site sym false))

  (method ^:public isAccessible ^boolean [this ^{:tag (Env AttrContext)} env ^Type site ^Symbol sym
                                          ^boolean checkInner]
    (cond
      (and (identical? (.-name sym) (.-init names)) (not (identical? (.-owner sym) (.-tsym site))))
        false
      (and (some? (.-enclMethod env))
           (not (== (bit-and (.-flags (.-mods (.-enclMethod env))) Flags/ANONCONSTR) 0)))
        true
      (and (.-visitingServiceImplementation (cast AttrContext (.-info env)))
           (identical? (.-modle (.-toplevel env)) (.-modle (.packge sym))))
        true
      :else
        (switch (unchecked-short (bit-and (.flags sym) Flags/AccessFlags))
          Flags/PRIVATE
            (and (or (or (identical? (.-sym (.-enclClass env)) (.-owner sym))
                         (identical? (.outermostClass (.-sym (.-enclClass env)))
                                     (.outermostClass (.-owner sym))))
                     (.privateMemberInPermitsClauseIfAllowed this env sym))
                 (.isInheritedIn sym (.-tsym site) types))
          0
            (and (and (and (or (identical? (.-packge (.-toplevel env)) (.-owner (.-owner sym)))
                               (identical? (.-packge (.-toplevel env)) (.packge sym)))
                           (.isAccessible this env site checkInner))
                      (.isInheritedIn sym (.-tsym site) types))
                 (.notOverriddenIn this site sym))
          Flags/PROTECTED
            (and (and (or (or (or (identical? (.-packge (.-toplevel env)) (.-owner (.-owner sym)))
                                  (identical? (.-packge (.-toplevel env)) (.packge sym)))
                              (.isProtectedAccessible this sym (.-sym (.-enclClass env)) site))
                          (and (and (.-selectSuper (cast AttrContext (.-info env)))
                                    (== (bit-and (.flags sym) Flags/STATIC) 0))
                               (not (identical? (.-kind sym) Kinds$Kind/TYP))))
                      (.isAccessible this env site checkInner))
                 (.notOverriddenIn this site sym))
          (and (.isAccessible this env site checkInner) (.notOverriddenIn this site sym)))))

  (method ^:private privateMemberInPermitsClauseIfAllowed ^boolean [this
                                                                    ^{:tag (Env AttrContext)} env
                                                                    ^Symbol sym]

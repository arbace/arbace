      (set! (.-diagnostic this) diag))

    (method ^:public getDiagnostic ^JCDiagnostic [this] diagnostic))

  (method findField ^Symbol [this ^{:tag (Env AttrContext)} env ^Type site ^Name name
                             ^:mutable ^Symbol$TypeSymbol c]
    (while (.hasTag (.-type c) TypeTag/TYPEVAR) (set! c (.-tsym (.getUpperBound (.-type c)))))
    (let [^:mutable ^Symbol bestSoFar varNotFound
          ^:mutable ^Symbol sym nil]
      (for-each [^Symbol s (.getSymbolsByName (.members c) name)]
        (when (and (identical? (.-kind s) Kinds$Kind/VAR)
                   (== (bit-and (.-flags_field s) Flags/SYNTHETIC) 0))
          (return (if (.isAccessible this env site s) s ^Symbol (AccessError. env site s)))))
      (let [st (.supertype types (.-type c))]
        (when (and (some? st) (or (.hasTag st TypeTag/CLASS) (.hasTag st TypeTag/TYPEVAR)))
          (set! sym (.findField this env site name (.-tsym st)))
          (set! bestSoFar (Resolve/bestOf bestSoFar sym)))
        (loop [^{:tag (List Type)} l (.interfaces types (.-type c))]
          (when (and (not (identical? (.-kind bestSoFar) Kinds$Kind/AMBIGUOUS)) (.nonEmpty l))
            (set! sym (.findField this env site name (.-tsym (cast Type (.-head l)))))
            (if (and (and (.exists bestSoFar) (.exists sym))
                     (not (identical? (.-owner sym) (.-owner bestSoFar))))
                (do (set! bestSoFar (AmbiguityError. bestSoFar sym)) (recur (.-tail l)))
                (do (set! bestSoFar (Resolve/bestOf bestSoFar sym)) (recur (.-tail l))))))
        bestSoFar)))

  (method ^:public resolveInternalField ^Symbol$VarSymbol [this ^JCDiagnostic$DiagnosticPosition pos
                                                           ^{:tag (Env AttrContext)} env ^Type site
                                                           ^Name name]
    (let [sym (.findField this env site name (.-tsym site))]
      (if (identical? (.-kind sym) Kinds$Kind/VAR)
          (cast Symbol$VarSymbol sym)
          (throw (FatalError. (.fragment
                                diags
                                (CompilerProperties$Fragments/FatalErrCantLocateField name)))))))

  (method findVar ^Symbol [this ^JCDiagnostic$DiagnosticPosition pos ^{:tag (Env AttrContext)} env
                           ^Name name]
    (let [^:mutable ^Symbol bestSoFar varNotFound
          ^:mutable ^{:tag (Env AttrContext)} env1 env
          ^:mutable staticOnly false]
      (while (some? (.-outer env1))
        (let [^:mutable ^Symbol sym nil]
          (for-each [^Symbol s (.getSymbolsByName (.-scope (cast AttrContext (.-info env1))) name)]
            (when (and (identical? (.-kind s) Kinds$Kind/VAR)
                       (== (bit-and (.-flags_field s) Flags/SYNTHETIC) 0))
              (set! sym s)
              (when staticOnly (return (StaticError. sym)))
              (break)))
          (when (Resolve/isStatic env1) (set! staticOnly true))
          (when (nil? sym)
            (set! sym
                  (.findField this
                              env1
                              (.-type (.-sym (.-enclClass env1)))
                              name
                              (.-sym (.-enclClass env1)))))
          (if (.exists sym)
              (do
                (when (and (and (identical? (.-kind sym) Kinds$Kind/VAR)
                                (identical? (.-kind (.-owner sym)) Kinds$Kind/TYP))
                           (== (bit-and (.flags sym) Flags/STATIC) 0))
                  (when staticOnly (return (StaticError. sym)))
                  (when (and (.-ctorPrologue (cast AttrContext (.-info env1)))
                             (not (.isAllowedEarlyReference
                                    this
                                    pos
                                    env1
                                    (cast Symbol$VarSymbol sym))))
                    (return (RefBeforeCtorCalledError. sym))))
                (return sym))
              (set! bestSoFar (Resolve/bestOf bestSoFar sym)))
          (when-not (== (bit-and (.flags (.-sym (.-enclClass env1))) Flags/STATIC) 0)
            (set! staticOnly true))
          (set! env1 (.-outer env1))))
      (let [sym (.findField this env (.-type (.-predefClass syms)) name (.-predefClass syms))]
        (cond
          (.exists sym) sym
          (.exists bestSoFar) bestSoFar
          :else
            (let [^:mutable ^Symbol origin nil]
              (for-each [^Scope sc (new Scope/1
                                        [(.-namedImportScope (.-toplevel env))
                                         (.-starImportScope (.-toplevel env))])]
                (for-each [^Symbol currentSymbol (.getSymbolsByName sc name)]
                  (when-not (not (identical? (.-kind currentSymbol) Kinds$Kind/VAR))
                    (if (and (not (.isResolutionError (.-kind bestSoFar)))
                             (not (identical? (.-owner currentSymbol) (.-owner bestSoFar))))
                        (return (AmbiguityError. bestSoFar currentSymbol))
                        (when-not (.betterThan (.-kind bestSoFar) Kinds$Kind/VAR)
                          (set! origin (.-owner (.getOrigin sc currentSymbol)))
                          (set! bestSoFar
                                (if (.isAccessible this env (.-type origin) currentSymbol)
                                    currentSymbol
                                    ^Symbol (AccessError. env (.-type origin) currentSymbol)))))))
                (when (.exists bestSoFar) (break)))
              (if (and (identical? (.-kind bestSoFar) Kinds$Kind/VAR)
                       (not (identical? (.-type (.-owner bestSoFar)) (.-type origin))))
                  (.clone bestSoFar origin)
                  bestSoFar))))))

  (field ^Warner noteWarner (Warner.))

  (method selectBest ^Symbol [this ^{:tag (Env AttrContext)} env ^Type site
                              ^{:tag (List Type)} argtypes ^{:tag (List Type)} typeargtypes
                              ^Symbol sym ^:mutable ^Symbol bestSoFar ^boolean allowBoxing
                              ^boolean useVarargs]
    (cond
      (or (or (identical? (.-kind sym) Kinds$Kind/ERR)
              (and (not (identical? (.-tsym site) (.-owner sym)))
                   (not (.isInheritedIn sym (.-tsym site) types))))
          (not (.notOverriddenIn this site sym)))
        bestSoFar
      (and useVarargs (== (bit-and (.flags sym) Flags/VARARGS) 0))
        (if (.isResolutionError (.-kind bestSoFar))
            ^Symbol (BadVarargsMethod. (cast ResolveError (.baseSymbol bestSoFar)))
            bestSoFar)
      :else
        (do
          (Assert/check (not (.isResolutionError (.-kind sym))))
          (try
            (.clear (.-noWarnings types))
            (let [mt (.rawInstantiate this
                                      env
                                      site
                                      sym
                                      nil
                                      argtypes
                                      typeargtypes
                                      allowBoxing
                                      useVarargs
                                      (.-noWarnings types))]
              (.addApplicableCandidate currentResolutionContext sym mt))
            (catch InapplicableMethodException ex
              (.addInapplicableCandidate currentResolutionContext sym (.getDiagnostic ex))
              (switch (.-kind bestSoFar)
                ABSENT_MTH (return (InapplicableSymbolError. currentResolutionContext))
                HIDDEN
                  (do
                    (if-instance [^AccessError accessError bestSoFar]
                      (.addInapplicableCandidate
                        currentResolutionContext
                        (.-sym accessError)
                        (.getDiagnostic accessError
                                        JCDiagnostic$DiagnosticType/FRAGMENT
                                        nil
                                        nil
                                        site
                                        nil
                                        argtypes
                                        typeargtypes))
                      (return bestSoFar))
                    (set! bestSoFar (InapplicableSymbolsError. currentResolutionContext))
                    (return bestSoFar))
                WRONG_MTH
                  (do
                    (set! bestSoFar (InapplicableSymbolsError. currentResolutionContext))
                    (return bestSoFar))
                (return bestSoFar))))
          (cond
            (not (.isAccessible this env site sym))
              (let [curAccessError (AccessError. env site sym)
                    curDiagnostic (.getDiagnostic
                                    curAccessError
                                    JCDiagnostic$DiagnosticType/FRAGMENT
                                    nil
                                    nil
                                    site
                                    nil
                                    argtypes
                                    typeargtypes)]
                (cond
                  (identical? (.-kind bestSoFar) Kinds$Kind/ABSENT_MTH)
                    (set! bestSoFar curAccessError)
                  (identical? (.-kind bestSoFar) Kinds$Kind/WRONG_MTH)
                    (do
                      (.addInapplicableCandidate currentResolutionContext sym curDiagnostic)
                      (set! bestSoFar (InapplicableSymbolsError. currentResolutionContext)))
                  (identical? (.-kind bestSoFar) Kinds$Kind/WRONG_MTHS)
                    (.addInapplicableCandidate currentResolutionContext sym curDiagnostic)
                  (identical? (.-kind bestSoFar) Kinds$Kind/HIDDEN)
                    (when-instance [^AccessError accessError bestSoFar]
                      (.addInapplicableCandidate
                        currentResolutionContext
                        (.-sym accessError)
                        (.getDiagnostic accessError
                                        JCDiagnostic$DiagnosticType/FRAGMENT
                                        nil
                                        nil
                                        site
                                        nil
                                        argtypes
                                        typeargtypes))
                      (.addInapplicableCandidate currentResolutionContext sym curDiagnostic)
                      (set! bestSoFar (InapplicableSymbolsError. currentResolutionContext))))
                bestSoFar)
            (and (.isResolutionError (.-kind bestSoFar))
                 (not (identical? (.-kind bestSoFar) Kinds$Kind/AMBIGUOUS)))
              sym
            :else (.mostSpecific this argtypes sym bestSoFar env site useVarargs)))))

  (method mostSpecific ^Symbol [this ^{:tag (List Type)} argtypes ^Symbol m1 ^Symbol m2
                                ^{:tag (Env AttrContext)} env ^:final ^Type site ^boolean useVarargs]
    (switch (.-kind m2)
      MTH
        (if (identical? m1 m2)
            m1
            (let [m1SignatureMoreSpecific (.signatureMoreSpecific
                                            this
                                            argtypes
                                            env
                                            site
                                            m1
                                            m2
                                            useVarargs)
                  m2SignatureMoreSpecific (.signatureMoreSpecific
                                            this
                                            argtypes
                                            env
                                            site
                                            m2
                                            m1
                                            useVarargs)]
              (cond
                (and m1SignatureMoreSpecific m2SignatureMoreSpecific)
                  (let [mt1 (.memberType types site m1)
                        mt2 (.memberType types site m2)]
                    (cond
                      (not (.overrideEquivalent types mt1 mt2)) (.ambiguityError this m1 m2)
                      (not (== (bit-and (.flags m1) Flags/BRIDGE)
                               (bit-and (.flags m2) Flags/BRIDGE)))
                        (if (not (== (bit-and (.flags m1) Flags/BRIDGE) 0)) m2 m1)
                      (identical? (.baseSymbol m1) (.baseSymbol m2)) m1
                      :else
                        (let [m1Owner (cast Symbol$TypeSymbol (.-owner m1))
                              m2Owner (cast Symbol$TypeSymbol (.-owner m2))]
                          (when-not (identical? m1Owner m2Owner)
                            (when (and (and (some? (.asSuper types (.-type m1Owner) m2Owner))
                                            (or (==
                                                  (bit-and
                                                    (.-flags_field (.-owner m1))
                                                    Flags/INTERFACE)
                                                  0)
                                                (not
                                                  (==
                                                    (bit-and
                                                      (.-flags_field (.-owner m2))
                                                      Flags/INTERFACE)
                                                    0))))
                                       (.overrides m1 m2 m1Owner types false))
                              (return m1))
                            (when (and (and (some? (.asSuper types (.-type m2Owner) m1Owner))
                                            (or (==
                                                  (bit-and
                                                    (.-flags_field (.-owner m2))
                                                    Flags/INTERFACE)
                                                  0)
                                                (not
                                                  (==
                                                    (bit-and
                                                      (.-flags_field (.-owner m1))
                                                      Flags/INTERFACE)
                                                    0))))
                                       (.overrides m2 m1 m2Owner types false))
                              (return m2)))
                          (let [m1Abstract (not (== (bit-and (.flags m1) Flags/ABSTRACT) 0))
                                m2Abstract (not (== (bit-and (.flags m2) Flags/ABSTRACT) 0))]
                            (cond
                              (and m1Abstract (not m2Abstract)) m2
                              (and m2Abstract (not m1Abstract)) m1
                              :else (.ambiguityError this m1 m2))))))
                m1SignatureMoreSpecific m1
                m2SignatureMoreSpecific m2
                :else (.ambiguityError this m1 m2))))
      AMBIGUOUS
        (let [e (cast AmbiguityError (.baseSymbol m2))
              ^:mutable m1MoreSpecificThanAnyAmbiguous true
              ^:mutable allAmbiguousMoreSpecificThanM1 true]
          (for-each [^Symbol s (.-ambiguousSyms e)]
            (let [moreSpecific (.mostSpecific this argtypes m1 s env site useVarargs)]
              (set! m1MoreSpecificThanAnyAmbiguous
                    (let [a-11 m1MoreSpecificThanAnyAmbiguous
                          b-12 (identical? moreSpecific m1)]
                      (and a-11 b-12)))
              (set! allAmbiguousMoreSpecificThanM1
                    (let [a-13 allAmbiguousMoreSpecificThanM1
                          b-14 (identical? moreSpecific s)]
                      (and a-13 b-14)))))
          (if m1MoreSpecificThanAnyAmbiguous
              m1
              (do (when-not allAmbiguousMoreSpecificThanM1 (.addAmbiguousSymbol e m1)) e)))
      (throw (AssertionError.))))

  (method ^:private signatureMoreSpecific ^boolean [this ^{:tag (List Type)} actuals
                                                    ^{:tag (Env AttrContext)} env ^Type site
                                                    ^Symbol m1 ^Symbol m2 ^boolean useVarargs]
    (.clear noteWarner)
    (let [maxLength (Math/max (Math/max (.length (.getParameterTypes (.-type m1)))
                                        (.length actuals))
                              (.length (.getParameterTypes (.-type m2))))
          prevResolutionContext currentResolutionContext]
      (try
        (set! currentResolutionContext (MethodResolutionContext.))
        (set! (.-step currentResolutionContext) (.-step prevResolutionContext))
        (set! (.-methodCheck currentResolutionContext)
              (.mostSpecificCheck (.-methodCheck prevResolutionContext) actuals))
        (let [mst (.instantiate this
                                env
                                site
                                m2
                                nil
                                (.adjustArgs this
                                             (.cvarLowerBounds
                                               types
                                               (.getParameterTypes (.memberType types site m1)))
                                             m1
                                             maxLength
                                             useVarargs)
                                nil
                                false
                                useVarargs
                                noteWarner)]
          (and (some? mst) (not (.hasLint noteWarner Lint$LintCategory/UNCHECKED))))
        (finally (set! currentResolutionContext prevResolutionContext)))))

  (method adjustArgs ^{:tag (List Type)} [this ^{:tag (List Type)} args ^Symbol msym ^int length
                                          ^boolean allowVarargs]
    (if (and (not (== (bit-and (.flags msym) Flags/VARARGS) 0)) allowVarargs)
        (let [varargsElem (.elemtype types (cast Type (.last args)))]
          (when (nil? varargsElem) (Assert/error (java-str "Bad varargs = " (.last args) " " msym)))
          (let [^:mutable ^{:tag (List Type)} newArgs (.reverse
                                                        (.prepend
                                                          (.-tail (.reverse args))
                                                          varargsElem))]
            (while (< (.length newArgs) length)
              (set! newArgs (.append newArgs (cast Type (.last newArgs)))))
            newArgs))
        args))

  (method ambiguityError ^Symbol [this ^Symbol m1 ^Symbol m2]
    (if (not (== (bit-and (bit-or (.flags m1) (.flags m2)) Flags/CLASH) 0))
        (if (== (bit-and (.flags m1) Flags/CLASH) 0) m1 m2)
        (AmbiguityError. m1 m2)))

  (method findMethodInScope ^Symbol [this ^{:tag (Env AttrContext)} env ^Type site ^Name name
                                     ^{:tag (List Type)} argtypes ^{:tag (List Type)} typeargtypes
                                     ^Scope sc ^:mutable ^Symbol bestSoFar ^boolean allowBoxing
                                     ^boolean useVarargs ^boolean abstractok]
    (for-each [^Symbol s (.getSymbolsByName sc name (LookupFilter. abstractok))]
      (set! bestSoFar
            (.selectBest this env site argtypes typeargtypes s bestSoFar allowBoxing useVarargs)))
    bestSoFar)

  (defclass LookupFilter
    :implements [(Predicate Symbol)]

    (field ^boolean abstractOk)

    (constructor [this ^boolean abstractOk]
      (set! (.-abstractOk this) abstractOk))

    (method ^:public test ^boolean [this ^Symbol s]
      (let [flags (.flags s)]
        (and (and (identical? (.-kind s) Kinds$Kind/MTH) (== (bit-and flags Flags/SYNTHETIC) 0))
             (or (or abstractOk (not (== (bit-and flags Flags/DEFAULT) 0)))
                 (== (bit-and flags Flags/ABSTRACT) 0))))))

  (method findMethod ^Symbol [this ^{:tag (Env AttrContext)} env ^Type site ^Name name
                              ^{:tag (List Type)} argtypes ^{:tag (List Type)} typeargtypes
                              ^boolean allowBoxing ^boolean useVarargs]
    (let [^:mutable ^Symbol bestSoFar methodNotFound]
      (set! bestSoFar
            (.findMethod this
                         env
                         site
                         name
                         argtypes
                         typeargtypes
                         (.-type (.-tsym site))
                         bestSoFar
                         allowBoxing
                         useVarargs))
      (when (identical? (.-kind bestSoFar) Kinds$Kind/AMBIGUOUS)
        (let [a_err (cast AmbiguityError (.baseSymbol bestSoFar))]
          (set! bestSoFar (.mergeAbstracts a_err site))))
      bestSoFar))

  (method ^:private findMethod ^Symbol [this ^{:tag (Env AttrContext)} env ^Type site ^Name name
                                        ^{:tag (List Type)} argtypes
                                        ^{:tag (List Type)} typeargtypes ^Type intype
                                        ^:mutable ^Symbol bestSoFar ^boolean allowBoxing
                                        ^boolean useVarargs]
    (let [^{:tag (array (List Type))} itypes (new List/1 [(List/nil) (List/nil)])
          ^:mutable iphase InterfaceLookupPhase/ABSTRACT_OK
          isInterface (.isInterface (.-tsym site))]
      (for-each [^Symbol$TypeSymbol s (if isInterface
                                          ^Iterable (List/of (.-tsym intype))
                                          (.superclasses this intype))]
        (set! bestSoFar
              (.findMethodInScope this
                                  env
                                  site
                                  name
                                  argtypes
                                  typeargtypes
                                  (.members s)
                                  bestSoFar
                                  allowBoxing
                                  useVarargs
                                  true))
        (when (identical? name (.-init names)) (return bestSoFar))
        (set! iphase (when (some? iphase) (.update iphase s this)))
        (when (some? iphase)
          (for-each [^Type itype (.interfaces types (.-type s))]
            (aset itypes
                  (.ordinal iphase)
                  (.union types (.closure types itype) (aget itypes (.ordinal iphase)))))))
      (let [^Symbol concrete (if (and (.isValid (.-kind bestSoFar))
                                      (== (bit-and (.flags bestSoFar) Flags/ABSTRACT) 0))
                                 bestSoFar
                                 ^Symbol methodNotFound)]
        (for-each [^InterfaceLookupPhase iphase2 (InterfaceLookupPhase/values)]
          (for-each [^Type itype (aget itypes (.ordinal iphase2))]
            (when-not (not (.isInterface itype))
              (when-not (and (identical? iphase2 InterfaceLookupPhase/DEFAULT_OK)
                             (== (bit-and (.flags (.-tsym itype)) Flags/DEFAULT) 0))
                (set! bestSoFar
                      (.findMethodInScope this
                                          env
                                          site
                                          name
                                          argtypes
                                          typeargtypes
                                          (.members (.-tsym itype))
                                          bestSoFar
                                          allowBoxing
                                          useVarargs
                                          true))
                (when (and (and (and (not (identical? concrete bestSoFar))
                                     (.isValid (.-kind concrete)))
                                (.isValid (.-kind bestSoFar)))
                           (.isSubSignature types (.-type concrete) (.-type bestSoFar)))
                  (set! bestSoFar concrete))))))
        (when (and isInterface (.isResolutionError (.-kind bestSoFar)))
          (set! bestSoFar
                (.findMethodInScope this
                                    env
                                    site
                                    name
                                    argtypes
                                    typeargtypes
                                    (.members (.-tsym (.-objectType syms)))
                                    bestSoFar
                                    allowBoxing
                                    useVarargs
                                    true))
          (when (.isValid (.-kind bestSoFar))
            (let [baseSymbol bestSoFar]
              (set! bestSoFar
                    (anon Symbol$MethodSymbol [(.-flags_field bestSoFar)
                                               (.-name bestSoFar)
                                               (.-type bestSoFar)
                                               (.-tsym intype)]
                      (method ^:public baseSymbol ^Symbol [this] baseSymbol))))))
        bestSoFar)))

  (defclass ^:enum InterfaceLookupPhase
    (constants
      (ABSTRACT_OK []
                   (method update ^InterfaceLookupPhase [this ^Symbol s ^Resolve rs]
                     (if (not (== (bit-and (.flags s)
                                           (bit-or-int
                                             (bit-or-int Flags/ABSTRACT Flags/INTERFACE)
                                             Flags/ENUM))
                                  0))
                         this
                         DEFAULT_OK)))
      (DEFAULT_OK [] (method update ^InterfaceLookupPhase [this ^Symbol s ^Resolve rs] this)))

    (method ^:abstract update ^InterfaceLookupPhase [this ^Symbol s ^Resolve rs]))

  (method superclasses ^{:tag (Iterable Symbol$TypeSymbol)} [this ^:final ^Type intype]
    (lambda Iterable ^Iterator []
      (anon (Iterator Symbol$TypeSymbol) []
        (field ^{:tag (List Symbol$TypeSymbol)} seen (List/nil))

        (field ^Symbol$TypeSymbol currentSym (.symbolFor this intype))

        (field ^Symbol$TypeSymbol prevSym nil)

        (method ^:public hasNext ^boolean [this]
          (when (identical? currentSym (.-noSymbol syms))
            (set! currentSym (.symbolFor this (.supertype types (.-type prevSym)))))
          (some? currentSym))

        (method ^:public next ^Symbol$TypeSymbol [this]
          (set! prevSym currentSym)
          (set! currentSym (.-noSymbol syms))
          (Assert/check (or (some? prevSym) (not (identical? prevSym (.-noSymbol syms)))))
          prevSym)

        (method ^:public remove ^void [this]
          (throw (UnsupportedOperationException.)))

        (method symbolFor ^Symbol$TypeSymbol [this ^:mutable ^Type t]
          (when-not (and (not (.hasTag t TypeTag/CLASS)) (not (.hasTag t TypeTag/TYPEVAR)))
            (set! t (.skipTypeVars types t false))
            (when-not (.contains seen (.-tsym t)) (set! seen (.prepend seen (.-tsym t))) (.-tsym t)))))))

  (method findFun ^Symbol [this ^{:tag (Env AttrContext)} env ^Name name
                           ^{:tag (List Type)} argtypes ^{:tag (List Type)} typeargtypes
                           ^boolean allowBoxing ^boolean useVarargs]
    (let [^:mutable ^Symbol bestSoFar methodNotFound
          ^:mutable ^{:tag (Env AttrContext)} env1 env
          ^:mutable staticOnly false]
      (while (some? (.-outer env1))
        (when (Resolve/isStatic env1) (set! staticOnly true))
        (Assert/check (nil? (.-preferredTreeForDiagnostics (cast AttrContext (.-info env1)))))
        (set! (.-preferredTreeForDiagnostics (cast AttrContext (.-info env1))) (.-tree env))
        (try
          (let [sym (.findMethod this
                                 env1
                                 (.-type (.-sym (.-enclClass env1)))
                                 name
                                 argtypes
                                 typeargtypes
                                 allowBoxing
                                 useVarargs)]
            (if (.exists sym)
                (do
                  (when (and (and (identical? (.-kind sym) Kinds$Kind/MTH)
                                  (identical? (.-kind (.-owner sym)) Kinds$Kind/TYP))
                             (== (bit-and (.flags sym) Flags/STATIC) 0))
                    (when staticOnly (return (StaticError. sym)))
                    (when (and (.-ctorPrologue (cast AttrContext (.-info env1)))
                               (identical? env1 env))
                      (return (RefBeforeCtorCalledError. sym))))
                  (return sym))
                (set! bestSoFar (Resolve/bestOf bestSoFar sym))))
          (finally (set! (.-preferredTreeForDiagnostics (cast AttrContext (.-info env1))) nil)))
        (when-not (== (bit-and (.flags (.-sym (.-enclClass env1))) Flags/STATIC) 0)
          (set! staticOnly true))
        (set! env1 (.-outer env1)))
      (let [sym (.findMethod this
                             env
                             (.-type (.-predefClass syms))
                             name
                             argtypes
                             typeargtypes
                             allowBoxing
                             useVarargs)]
        (if (.exists sym)
            sym
            (do
              (for-each [^:mutable ^Symbol currentSym (.getSymbolsByName
                                                        (.-namedImportScope (.-toplevel env))
                                                        name)]
                (let [origin (.-owner (.getOrigin (.-namedImportScope (.-toplevel env)) currentSym))]
                  (when (identical? (.-kind currentSym) Kinds$Kind/MTH)
                    (when-not (identical? (.-type (.-owner currentSym)) (.-type origin))
                      (set! currentSym (.clone currentSym origin)))
                    (when-not (.isAccessible this env (.-type origin) currentSym)
                      (set! currentSym (AccessError. env (.-type origin) currentSym)))
                    (set! bestSoFar
                          (.selectBest this
                                       env
                                       (.-type origin)
                                       argtypes
                                       typeargtypes
                                       currentSym
                                       bestSoFar
                                       allowBoxing
                                       useVarargs)))))
              (if (.exists bestSoFar)
                  bestSoFar
                  (do
                    (for-each [^:mutable ^Symbol currentSym (.getSymbolsByName
                                                              (.-starImportScope (.-toplevel env))
                                                              name)]
                      (let [origin (.-owner (.getOrigin
                                              (.-starImportScope (.-toplevel env))
                                              currentSym))]
                        (when (identical? (.-kind currentSym) Kinds$Kind/MTH)
                          (when-not (identical? (.-type (.-owner currentSym)) (.-type origin))
                            (set! currentSym (.clone currentSym origin)))
                          (when-not (.isAccessible this env (.-type origin) currentSym)
                            (set! currentSym (AccessError. env (.-type origin) currentSym)))
                          (set! bestSoFar
                                (.selectBest this
                                             env
                                             (.-type origin)
                                             argtypes
                                             typeargtypes
                                             currentSym
                                             bestSoFar
                                             allowBoxing
                                             useVarargs)))))
                    bestSoFar)))))))

  (method loadClass ^Symbol [this ^{:tag (Env AttrContext)} env ^Name name
                             ^RecoveryLoadClass recoveryLoadClass]
    (try
      (let [c (.loadClass finder (.-modle (.-toplevel env)) name)]
        (if (.isAccessible this env c) ^Symbol c ^Symbol (AccessError. env nil c)))
      (catch ClassFinder$BadClassFile err (BadClassFileError. err))
      (catch Symbol$CompletionFailure ex
        (let [candidate (.loadClass recoveryLoadClass env name)]
          (if (some? candidate) candidate typeNotFound)))))

  (defclass ^:public ^:interface RecoveryLoadClass
    (method loadClass ^Symbol [this ^{:tag (Env AttrContext)} env ^Name name]))

  (field ^:private ^:final ^RecoveryLoadClass noRecovery
    (lambda RecoveryLoadClass ^Symbol [^Env env ^Name name] nil))

  (field ^:private ^:final ^RecoveryLoadClass doRecoveryLoadClass
    (anon RecoveryLoadClass []
      (method ^:public loadClass ^Symbol [this ^{:tag (Env AttrContext)} env ^Name name]
        (let [^{:tag (List Name)} candidates (Convert/classCandidates name)]
          (.lookupInvisibleSymbol Resolve/this
                                  env
                                  name
                                  (lambda Function ^Iterable [^Name n]
                                    (lambda Iterable ^Iterator []
                                      (Iterators/createCompoundIterator
                                        candidates
                                        (lambda Function ^Iterator [^Name c]
                                          (.iterator (.getClassesForName syms c))))))
                                  (lambda BiFunction ^Symbol$ClassSymbol [^Symbol$ModuleSymbol ms
                                                                          ^Name n]
                                    (for-each [^Name candidate candidates]
                                      (try
                                        (return (.loadClass finder ms candidate))
                                        (catch Symbol$CompletionFailure cf)))
                                    nil)
                                  (lambda Predicate ^boolean [^Symbol$ClassSymbol sym]
                                    (identical? (.-kind sym) Kinds$Kind/TYP))
                                  typeNotFound)))))

  (field ^:private ^:final ^RecoveryLoadClass namedImportScopeRecovery
    (lambda RecoveryLoadClass ^Symbol [^Env env ^Name name]
      (let [^Scope importScope (.-namedImportScope (.-toplevel env))
            existing (.findFirst importScope
                                 (Convert/shortName name)
                                 (lambda Predicate ^boolean [^Symbol sym]
                                   (and (identical? (.-kind sym) Kinds$Kind/TYP)
                                        (identical? (.flatName sym) name))))]
        (when (some? existing) (InvisibleSymbolError. env true existing)))))

  (field ^:private ^:final ^RecoveryLoadClass starImportScopeRecovery
    (.onDemandImportScopeRecovery this false))

  (field ^:private ^:final ^RecoveryLoadClass moduleImportScopeRecovery
    (.onDemandImportScopeRecovery this true))

  (method ^:private onDemandImportScopeRecovery ^RecoveryLoadClass [this ^boolean moduleImportScope]
    (lambda RecoveryLoadClass ^Symbol [^Env env ^Name name]
      (let [^Scope importScope (if moduleImportScope
                                   ^Scope (.-moduleImportScope (.-toplevel env))
                                   ^Scope (.-starImportScope (.-toplevel env)))
            ^:mutable existing (.findFirst importScope
                                           (Convert/shortName name)
                                           (lambda Predicate ^boolean [^Symbol sym]
                                             (and
                                               (identical? (.-kind sym) Kinds$Kind/TYP)
                                               (identical? (.flatName sym) name))))]
        (when (some? existing)
          (try
            (set! existing (.loadClass finder (.-modle (.packge existing)) name))
            (return (InvisibleSymbolError. env true existing))
            (catch Symbol$CompletionFailure cf)))
        nil)))

  (method lookupPackage ^Symbol [this ^{:tag (Env AttrContext)} env ^Name name]
    (let [pack (.lookupPackage syms (.-modle (.-toplevel env)) name)]
      (when (and allowModules (.isImportOnDemand this env name))
        (when (.isEmpty (.members pack))
          (return (.lookupInvisibleSymbol this
                                          env
                                          name
                                          (method-ref
                                            Function
                                            ^Iterable [Name]
                                            syms
                                            Symtab/.getPackagesForName)
                                          (method-ref
                                            BiFunction
                                            ^Symbol$PackageSymbol [Symbol$ModuleSymbol Name]
                                            syms
                                            Symtab/.enterPackage)
                                          (lambda Predicate ^boolean [^Symbol$PackageSymbol sym]
                                            (.complete sym)
                                            (not (.isEmpty (.members sym))))
                                          pack))))
      pack))

  (method ^:private isImportOnDemand ^boolean [this ^{:tag (Env AttrContext)} env ^Name name]
    (if (not (.hasTag (.-tree env) JCTree$Tag/IMPORT))
        false
        (let [^JCTree qualid (.-qualid (cast JCTree$JCImport (.-tree env)))]
          (cond
            (not (.hasTag qualid JCTree$Tag/SELECT)) false
            (not (identical? (TreeInfo/name qualid) (.-asterisk names))) false
            :else
              (identical? (TreeInfo/fullName (.-selected (cast JCTree$JCFieldAccess qualid))) name)))))

  (method ^:private lookupInvisibleSymbol :type-params [(S extends Symbol)] ^Symbol [this
                                                                                     ^{:tag (Env AttrContext)} env
                                                                                     ^Name name
                                                                                     ^{:tag (Function Name (Iterable S))} get
                                                                                     ^{:tag (BiFunction Symbol$ModuleSymbol Name S)} load
                                                                                     ^{:tag (Predicate S)} validate
                                                                                     ^Symbol defaultResult]
    (let [^{:tag (Iterable (? extends S))} candidates (cast Iterable (.apply get name))]
      (for-each [^S sym candidates]
        (when (.test validate sym) (return (.createInvisibleSymbolError this env sym))))
      (let [^{:tag (Set Symbol$ModuleSymbol)} recoverableModules (HashSet. (.getAllModules syms))]
        (.add recoverableModules (.-unnamedModule syms))
        (.remove recoverableModules (.-modle (.-toplevel env)))
        (for-each [^:mutable ^Symbol$ModuleSymbol ms recoverableModules]
          (when (nil? (.-sourceLocation ms))
            (when (nil? (.-classLocation ms)) (set! ms (.findModule moduleFinder ms)))
            (when-not (identical? (.-kind ms) Kinds$Kind/ERR)
              (let [^S sym (cast Symbol (.apply load ms name))]
                (when (and (some? sym) (.test validate sym))
                  (return (.createInvisibleSymbolError this env sym)))))))
        defaultResult)))

  (method ^:private createInvisibleSymbolError ^Symbol [this ^{:tag (Env AttrContext)} env
                                                        ^Symbol sym]
    (if (.symbolPackageVisible this env sym)
        (AccessError. env nil sym)
        (InvisibleSymbolError. env false sym)))

  (method ^:private symbolPackageVisible ^boolean [this ^{:tag (Env AttrContext)} env ^Symbol sym]
    (let [envMod (.-modle (.-toplevel env))
          symPack (.packge sym)]
      (or (identical? envMod (.-modle symPack))
          (.containsKey (.-visiblePackages envMod) (.-fullname symPack)))))

  (method findImmediateMemberType ^Symbol [this ^{:tag (Env AttrContext)} env ^Type site ^Name name
                                           ^Symbol$TypeSymbol c]
    (for-each [^Symbol sym (.getSymbolsByName (.members c) name)]
      (when (identical? (.-kind sym) Kinds$Kind/TYP)
        (return (if (.isAccessible this env site sym) sym ^Symbol (AccessError. env site sym)))))
    typeNotFound)

  (method findInheritedMemberType ^Symbol [this ^{:tag (Env AttrContext)} env ^Type site ^Name name
                                           ^Symbol$TypeSymbol c]
    (let [^:mutable ^Symbol bestSoFar typeNotFound
          ^:mutable ^Symbol sym nil
          st (.supertype types (.-type c))]
      (when (and (some? st) (.hasTag st TypeTag/CLASS))
        (set! sym (.findMemberType this env site name (.-tsym st)))
        (set! bestSoFar (Resolve/bestOf bestSoFar sym)))
      (loop [^{:tag (List Type)} l (.interfaces types (.-type c))]
        (when (and (not (identical? (.-kind bestSoFar) Kinds$Kind/AMBIGUOUS)) (.nonEmpty l))
          (set! sym (.findMemberType this env site name (.-tsym (cast Type (.-head l)))))
          (if (and (and (not (.isResolutionError (.-kind bestSoFar)))
                        (not (.isResolutionError (.-kind sym))))
                   (not (identical? (.-owner sym) (.-owner bestSoFar))))
              (do (set! bestSoFar (AmbiguityError. bestSoFar sym)) (recur (.-tail l)))
              (do (set! bestSoFar (Resolve/bestOf bestSoFar sym)) (recur (.-tail l))))))
      bestSoFar))

  (method findMemberType ^Symbol [this ^{:tag (Env AttrContext)} env ^Type site ^Name name
                                  ^Symbol$TypeSymbol c]
    (let [sym (.findImmediateMemberType this env site name c)]
      (if (not (identical? sym typeNotFound)) sym (.findInheritedMemberType this env site name c))))

  (method findGlobalType ^Symbol [this ^{:tag (Env AttrContext)} env ^Scope scope ^Name name
                                  ^RecoveryLoadClass recoveryLoadClass]
    (let [^:mutable ^Symbol bestSoFar typeNotFound]
      (for-each [^Symbol s (.getSymbolsByName scope name)]
        (let [sym (.loadClass this env (.flatName s) recoveryLoadClass)]
          (if (and (and (identical? (.-kind bestSoFar) Kinds$Kind/TYP)
                        (identical? (.-kind sym) Kinds$Kind/TYP))
                   (not (identical? bestSoFar sym)))
              (return (AmbiguityError. bestSoFar sym))
              (set! bestSoFar (Resolve/bestOf bestSoFar sym)))))
      bestSoFar))

  (method findTypeVar ^Symbol [this ^{:tag (Env AttrContext)} env ^Name name ^boolean staticOnly]
    (for-each [^Symbol sym (.getSymbolsByName (.-scope (cast AttrContext (.-info env))) name)]
      (when (identical? (.-kind sym) Kinds$Kind/TYP)
        (when (and (.hasTag (.-type sym) TypeTag/TYPEVAR)
                   (or staticOnly
                       (and (Resolve/isStatic env)
                            (identical? (.-kind (.-owner sym)) Kinds$Kind/TYP))))
          (return (StaticError. sym)))
        (return sym)))
    typeNotFound)

  (method findType ^Symbol [this ^{:tag (Env AttrContext)} env ^Name name]
    (if (identical? name (.-empty names))
        typeNotFound
        (let [^:mutable ^Symbol bestSoFar typeNotFound
              ^:mutable ^Symbol sym nil
              ^:mutable staticOnly false]
          (loop [^{:tag (Env AttrContext)} env1 env]
            (when (some? (.-outer env1))
              (let [tyvar (.findTypeVar this env1 name staticOnly)]
                (when (Resolve/isStatic env1) (set! staticOnly true))
                (set! sym
                      (.findImmediateMemberType this
                                                env1
                                                (.-type (.-sym (.-enclClass env1)))
                                                name
                                                (.-sym (.-enclClass env1))))
                (when-not (identical? tyvar typeNotFound)
                  (when (or (or (.-baseClause env) (identical? sym typeNotFound))
                            (and (and (identical? (.-kind tyvar) Kinds$Kind/TYP) (.exists tyvar))
                                 (identical? (.-kind (.-owner tyvar)) Kinds$Kind/MTH)))
                    (return tyvar)))
                (when (identical? sym typeNotFound)
                  (set! sym
                        (.findInheritedMemberType
                          this
                          env1
                          (.-type (.-sym (.-enclClass env1)))
                          name
                          (.-sym (.-enclClass env1)))))
                (cond
                  (and (and (and (and (and staticOnly (identical? (.-kind sym) Kinds$Kind/TYP))
                                      (.hasTag (.-type sym) TypeTag/CLASS))
                                 (.hasTag (.getEnclosingType (.-type sym)) TypeTag/CLASS))
                            (.isParameterized (.-type (.-sym (.-enclClass env1)))))
                       (.isParameterized (.getEnclosingType (.-type sym))))
                    (return (StaticError. sym))
                  (.exists sym) (return sym)
                  :else (set! bestSoFar (Resolve/bestOf bestSoFar sym)))
                (let [^JCTree$JCClassDecl encl (if (.-baseClause env1)
                                                   (cast JCTree$JCClassDecl (.-tree env1))
                                                   (.-enclClass env1))]
                  (if (not (== (bit-and (.flags (.-sym encl)) Flags/STATIC) 0))
                      (do (set! staticOnly true) (recur (.-outer env1)))
                      (recur (.-outer env1)))))))
          (when-not (.hasTag (.-tree env) JCTree$Tag/IMPORT)
            (set! sym
                  (.findGlobalType this
                                   env
                                   (.-namedImportScope (.-toplevel env))
                                   name
                                   namedImportScopeRecovery))
            (if (.exists sym) (return sym) (set! bestSoFar (Resolve/bestOf bestSoFar sym)))
            (set! sym (.findGlobalType this env (.-toplevelScope (.-toplevel env)) name noRecovery))
            (if (.exists sym) (return sym) (set! bestSoFar (Resolve/bestOf bestSoFar sym)))
            (set! sym
                  (.findGlobalType this env (.members (.-packge (.-toplevel env))) name noRecovery))
            (if (.exists sym) (return sym) (set! bestSoFar (Resolve/bestOf bestSoFar sym)))
            (set! sym
                  (.findGlobalType this
                                   env
                                   (.-starImportScope (.-toplevel env))
                                   name
                                   starImportScopeRecovery))
            (if (.exists sym) (return sym) (set! bestSoFar (Resolve/bestOf bestSoFar sym)))
            (set! sym
                  (.findGlobalType this
                                   env
                                   (.-moduleImportScope (.-toplevel env))
                                   name
                                   moduleImportScopeRecovery))
            (if (.exists sym) (return sym) (set! bestSoFar (Resolve/bestOf bestSoFar sym))))
          bestSoFar)))

  (method findIdent ^Symbol [this ^JCDiagnostic$DiagnosticPosition pos ^{:tag (Env AttrContext)} env
                             ^Name name ^Kinds$KindSelector kind]
    (try
      (.checkNonExistentType this
                             (.checkRestrictedType
                               this
                               pos
                               (.findIdentInternal this pos env name kind)
                               name))
      (catch ClassFinder$BadClassFile err (BadClassFileError. err))
      (catch Symbol$CompletionFailure cf (.completionError chk pos cf) typeNotFound)))

  (method findIdentInternal ^Symbol [this ^JCDiagnostic$DiagnosticPosition pos
                                     ^{:tag (Env AttrContext)} env ^Name name
                                     ^Kinds$KindSelector kind]
    (let [^:mutable ^Symbol bestSoFar typeNotFound
          ^:mutable ^Symbol sym nil]
      (when (.contains kind Kinds$KindSelector/VAL)
        (set! sym (.findVar this pos env name))
        (if (.exists sym) (return sym) (set! bestSoFar (Resolve/bestOf bestSoFar sym))))
      (when (.contains kind Kinds$KindSelector/TYP)
        (set! sym (.findType this env name))
        (if (.exists sym) (return sym) (set! bestSoFar (Resolve/bestOf bestSoFar sym))))
      (if (.contains kind Kinds$KindSelector/PCK) (.lookupPackage this env name) bestSoFar)))

  (method findIdentInPackage ^Symbol [this ^JCDiagnostic$DiagnosticPosition pos
                                      ^{:tag (Env AttrContext)} env ^Symbol$TypeSymbol pck
                                      ^Name name ^Kinds$KindSelector kind]
    (.checkNonExistentType this
                           (.checkRestrictedType
                             this
                             pos
                             (.findIdentInPackageInternal this env pck name kind)
                             name)))

  (method findIdentInPackageInternal ^Symbol [this ^{:tag (Env AttrContext)} env
                                              ^Symbol$TypeSymbol pck ^Name name
                                              ^Kinds$KindSelector kind]
    (let [fullname (Symbol$TypeSymbol/formFullName name pck)
          ^:mutable ^Symbol bestSoFar typeNotFound]
      (when (.contains kind Kinds$KindSelector/TYP)
        (let [^RecoveryLoadClass recoveryLoadClass (if (and
                                                         (and
                                                           (and
                                                             allowModules
                                                             (not
                                                               (.contains
                                                                 kind
                                                                 Kinds$KindSelector/PCK)))
                                                           (not (.exists pck)))
                                                         (not
                                                           (.-isSpeculative
                                                             (.-attributionMode
                                                               (cast AttrContext (.-info env))))))
                                                       doRecoveryLoadClass
                                                       noRecovery)
              sym (.loadClass this env fullname recoveryLoadClass)]
          (if (.exists sym)
              (when (identical? name (.-name sym)) (return sym))
              (set! bestSoFar (Resolve/bestOf bestSoFar sym)))))
      (if (.contains kind Kinds$KindSelector/PCK) (.lookupPackage this env fullname) bestSoFar)))

  (method findIdentInType ^Symbol [this ^JCDiagnostic$DiagnosticPosition pos
                                   ^{:tag (Env AttrContext)} env ^Type site ^Name name
                                   ^Kinds$KindSelector kind]
    (try
      (.checkNonExistentType this
                             (.checkRestrictedType
                               this
                               pos
                               (.findIdentInTypeInternal this env site name kind)
                               name))
      (catch ClassFinder$BadClassFile err (BadClassFileError. err))
      (catch Symbol$CompletionFailure cf (.completionError chk pos cf) typeNotFound)))

  (method ^:private checkNonExistentType ^Symbol [this ^Symbol symbol]
    (if-instance [^Symbol$ClassSymbol c symbol]
      (if (.isErroneous (.-type c)) (if (nil? (.-classfile c)) ^Symbol typeNotFound symbol) symbol)
      symbol))

  (method findIdentInTypeInternal ^Symbol [this ^{:tag (Env AttrContext)} env ^Type site ^Name name
                                           ^Kinds$KindSelector kind]
    (let [^:mutable ^Symbol bestSoFar typeNotFound
          ^:mutable ^Symbol sym nil]
      (when (.contains kind Kinds$KindSelector/VAL)
        (set! sym (.findField this env site name (.-tsym site)))
        (if (.exists sym) (return sym) (set! bestSoFar (Resolve/bestOf bestSoFar sym))))
      (when (.contains kind Kinds$KindSelector/TYP)
        (set! sym (.findMemberType this env site name (.-tsym site)))
        (if (.exists sym) (return sym) (set! bestSoFar (Resolve/bestOf bestSoFar sym))))
      bestSoFar))

  (method ^:private checkRestrictedType ^Symbol [this ^JCDiagnostic$DiagnosticPosition pos
                                                 ^:mutable ^Symbol bestSoFar ^Name name]
    (when (or (identical? (.-kind bestSoFar) Kinds$Kind/TYP)
              (identical? (.-kind bestSoFar) Kinds$Kind/ABSENT_TYP))
      (cond
        (and allowLocalVariableTypeInference (.equals name (.-var names)))
          (set! bestSoFar (BadRestrictedTypeError. (.-var names)))
        (.equals name (.-yield names))
          (cond
            allowYieldStatement (set! bestSoFar (BadRestrictedTypeError. (.-yield names)))
            (some? pos)
              (.warning log
                        pos
                        (CompilerProperties$Warnings/IllegalRefToRestrictedType (.-yield names))))))
    bestSoFar)

  (method accessInternal ^Symbol [this ^:mutable ^Symbol sym ^JCDiagnostic$DiagnosticPosition pos
                                  ^Symbol location ^Type site ^Name name ^boolean qualified
                                  ^:mutable ^{:tag (List Type)} argtypes
                                  ^{:tag (List Type)} typeargtypes
                                  ^LogResolveHelper logResolveHelper]
    (when (.isResolutionError (.-kind sym))
      (let [errSym (cast ResolveError (.baseSymbol sym))]
        (set! sym
              (.access errSym
                       name
                       ^Symbol$TypeSymbol (if qualified (.-tsym site) (.-noSymbol syms))))
        (set! argtypes (.getArgumentTypes logResolveHelper errSym sym name argtypes))
        (when (.resolveDiagnosticNeeded logResolveHelper site argtypes typeargtypes)
          (.logResolveError this errSym pos location site name argtypes typeargtypes))))
    sym)

  (method accessMethod ^Symbol [this ^Symbol sym ^JCDiagnostic$DiagnosticPosition pos
                                ^Symbol location ^Type site ^Name name ^boolean qualified
                                ^{:tag (List Type)} argtypes ^{:tag (List Type)} typeargtypes]
    (.accessInternal this
                     sym
                     pos
                     location
                     site
                     name
                     qualified
                     argtypes
                     typeargtypes
                     methodLogResolveHelper))

  (method accessMethod ^Symbol [this ^Symbol sym ^JCDiagnostic$DiagnosticPosition pos ^Type site
                                ^Name name ^boolean qualified ^{:tag (List Type)} argtypes
                                ^{:tag (List Type)} typeargtypes]
    (.accessMethod this sym pos (.-tsym site) site name qualified argtypes typeargtypes))

  (method accessBase ^Symbol [this ^Symbol sym ^JCDiagnostic$DiagnosticPosition pos ^Symbol location
                              ^Type site ^Name name ^boolean qualified]
    (.accessInternal this sym pos location site name qualified (List/nil) nil basicLogResolveHelper))

  (method accessBase ^Symbol [this ^Symbol sym ^JCDiagnostic$DiagnosticPosition pos ^Type site
                              ^Name name ^boolean qualified]
    (.accessBase this sym pos (.-tsym site) site name qualified))

  (defclass ^:interface LogResolveHelper
    (method resolveDiagnosticNeeded ^boolean [this ^Type site ^{:tag (List Type)} argtypes
                                              ^{:tag (List Type)} typeargtypes])

    (method getArgumentTypes ^{:tag (List Type)} [this ^ResolveError errSym ^Symbol accessedSym
                                                  ^Name name ^{:tag (List Type)} argtypes]))

  (field ^LogResolveHelper basicLogResolveHelper
    (anon LogResolveHelper []
      (method ^:public resolveDiagnosticNeeded ^boolean [this ^Type site
                                                         ^{:tag (List Type)} argtypes
                                                         ^{:tag (List Type)} typeargtypes]
        (not (.isErroneous site)))

      (method ^:public getArgumentTypes ^{:tag (List Type)} [this ^ResolveError errSym
                                                             ^Symbol accessedSym ^Name name
                                                             ^{:tag (List Type)} argtypes]
        argtypes)))

  (field ^LogResolveHelper silentLogResolveHelper
    (anon LogResolveHelper []
      (method ^:public resolveDiagnosticNeeded ^boolean [this ^Type site
                                                         ^{:tag (List Type)} argtypes
                                                         ^{:tag (List Type)} typeargtypes]
        false)

      (method ^:public getArgumentTypes ^{:tag (List Type)} [this ^ResolveError errSym
                                                             ^Symbol accessedSym ^Name name
                                                             ^{:tag (List Type)} argtypes]
        argtypes)))

  (field ^LogResolveHelper methodLogResolveHelper
    (anon LogResolveHelper []
      (method ^:public resolveDiagnosticNeeded ^boolean [this ^Type site
                                                         ^{:tag (List Type)} argtypes
                                                         ^{:tag (List Type)} typeargtypes]
        (and (and (not (.isErroneous site)) (not (Type/isErroneous argtypes)))
             (or (nil? typeargtypes) (not (Type/isErroneous typeargtypes)))))

      (method ^:public getArgumentTypes ^{:tag (List Type)} [this ^ResolveError errSym
                                                             ^Symbol accessedSym ^Name name
                                                             ^{:tag (List Type)} argtypes]
        (.map argtypes
              (ResolveDeferredRecoveryMap. DeferredAttr$AttrMode/SPECULATIVE
                                           accessedSym
                                           (.-step currentResolutionContext))))))

  (defclass ResolveDeferredRecoveryMap
    :extends DeferredAttr$RecoveryDeferredTypeMap

    (constructor ^:public [this ^DeferredAttr$AttrMode mode ^Symbol msym ^MethodResolutionPhase step]
      (.super deferredAttr mode msym step))

    (method ^:protected typeOf ^Type [this ^DeferredAttr$DeferredType dt ^Type pt]
      (let [res (.typeOf super dt pt)]
        (when-not (.isErroneous res)
          (switch (.getTag (TreeInfo/skipParens (.-tree dt)))
            (LAMBDA REFERENCE) (return dt)
            CONDEXPR (return (if (identical? res Type/recoveryType) ^Type dt res))))
        res)))

  (method checkNonAbstract ^void [this ^JCDiagnostic$DiagnosticPosition pos ^Symbol sym]
    (when (and (not (== (bit-and (.flags sym) Flags/ABSTRACT) 0))
               (== (bit-and (.flags sym) Flags/DEFAULT) 0))
      (.error log
              pos
              (CompilerProperties$Errors/AbstractCantBeAccessedDirectly
                (Kinds/kindName sym)
                sym
                (.location sym)))))

  (method resolveIdent ^Symbol [this ^JCDiagnostic$DiagnosticPosition pos
                                ^{:tag (Env AttrContext)} env ^Name name ^Kinds$KindSelector kind]
    (.accessBase this
                 (.findIdent this pos env name kind)
                 pos
                 (.-type (.-sym (.-enclClass env)))
                 name
                 false))

  (method resolveMethod ^Symbol [this ^JCDiagnostic$DiagnosticPosition pos
                                 ^{:tag (Env AttrContext)} env ^Name name
                                 ^{:tag (List Type)} argtypes ^{:tag (List Type)} typeargtypes]
    (.lookupMethod this
                   env
                   pos
                   (.-sym (.-enclClass env))
                   resolveMethodCheck
                   (anon BasicLookupHelper [name
                                            (.-type (.-sym (.-enclClass env)))
                                            argtypes
                                            typeargtypes]
                     (method lookup ^Symbol [this ^{:tag (Env AttrContext)} env
                                             ^MethodResolutionPhase phase]
                       (.findFun Resolve/this
                                 env
                                 (.-name this)
                                 (.-argtypes this)
                                 (.-typeargtypes this)
                                 (.isBoxingRequired phase)
                                 (.isVarargsRequired phase))))))

  (method resolveQualifiedMethod ^Symbol [this ^JCDiagnostic$DiagnosticPosition pos
                                          ^{:tag (Env AttrContext)} env ^Type site ^Name name
                                          ^{:tag (List Type)} argtypes
                                          ^{:tag (List Type)} typeargtypes]
    (.resolveQualifiedMethod this pos env (.-tsym site) site name argtypes typeargtypes))

  (method resolveQualifiedMethod ^Symbol [this ^JCDiagnostic$DiagnosticPosition pos
                                          ^{:tag (Env AttrContext)} env ^Symbol location ^Type site
                                          ^Name name ^{:tag (List Type)} argtypes
                                          ^{:tag (List Type)} typeargtypes]
    (try
      (.resolveQualifiedMethod this
                               (MethodResolutionContext.)
                               pos
                               env
                               location
                               site
                               name
                               argtypes
                               typeargtypes)
      (catch Symbol$CompletionFailure cf
        (.completionError chk pos cf)
        (.access methodNotFound name (.-tsym site)))))

  (method ^:private resolveQualifiedMethod ^Symbol [this ^MethodResolutionContext resolveContext
                                                    ^JCDiagnostic$DiagnosticPosition pos
                                                    ^{:tag (Env AttrContext)} env ^Symbol location
                                                    ^Type site ^Name name
                                                    ^{:tag (List Type)} argtypes
                                                    ^{:tag (List Type)} typeargtypes]
    (.lookupMethod this
                   env
                   pos
                   location
                   resolveContext
                   (anon BasicLookupHelper [name site argtypes typeargtypes]
                     (method lookup ^Symbol [this ^{:tag (Env AttrContext)} env
                                             ^MethodResolutionPhase phase]
                       (.findMethod Resolve/this
                                    env
                                    (.-site this)
                                    (.-name this)
                                    (.-argtypes this)
                                    (.-typeargtypes this)
                                    (.isBoxingRequired phase)
                                    (.isVarargsRequired phase)))

                     (method access ^Symbol [this ^{:tag (Env AttrContext)} env
                                             ^JCDiagnostic$DiagnosticPosition pos ^Symbol location
                                             ^:mutable ^Symbol sym]
                       (if (.isResolutionError (.-kind sym))
                           (set! sym (.access super env pos location sym))
                           (let [msym (cast Symbol$MethodSymbol sym)]
                             (when-not (== (bit-and (.flags msym) Flags/SIGNATURE_POLYMORPHIC) 0)
                               (set! (.-pendingResolutionPhase (cast AttrContext (.-info env)))
                                     MethodResolutionPhase/BASIC)
                               (return (.findPolymorphicSignatureInstance
                                         Resolve/this
                                         env
                                         sym
                                         (.-argtypes this))))))
                       sym))))

  (method findPolymorphicSignatureInstance ^Symbol [this ^{:tag (Env AttrContext)} env
                                                    ^:final ^Symbol spMethod
                                                    ^{:tag (List Type)} argtypes]
    (let [mtype (.instantiatePolymorphicSignatureInstance
                  infer
                  env
                  (cast Symbol$MethodSymbol spMethod)
                  currentResolutionContext
                  argtypes)]
      (.findPolymorphicSignatureInstance this spMethod mtype)))

  (method findPolymorphicSignatureInstance ^Symbol [this ^:final ^Symbol spMethod
                                                    ^:mutable ^Type mtype]
    (for-each [^Symbol sym (.getSymbolsByName polymorphicSignatureScope (.-name spMethod))]
      (when (and (.isSameType types mtype (.-type sym))
                 (identical? (.-owner spMethod) (.-owner sym)))
        (return sym)))
    (let [spReturnType (.getReturnType (.asType spMethod))]
      (when-not (.isSameType types spReturnType (.-objectType syms))
        (when-not (.isSameType types spReturnType (.getReturnType mtype))
          (set! mtype
                (Type$MethodType. (.getParameterTypes mtype)
                                  spReturnType
                                  (.getThrownTypes mtype)
                                  (.-methodClass syms)))))
      (let [flags (bit-or (bit-or Flags/ABSTRACT Flags/HYPOTHETICAL)
                          (bit-and (.flags spMethod) (bit-or-int Flags/AccessFlags Flags/STATIC)))
            ^Symbol msym (anon Symbol$MethodSymbol [flags
                                                    (.-name spMethod)
                                                    mtype
                                                    (.-owner spMethod)]
                           (method ^:public baseSymbol ^Symbol [this] spMethod))]
        (when-not (.isErroneous mtype) (.enter polymorphicSignatureScope msym))
        msym)))

  (method ^:public resolveInternalMethod ^Symbol$MethodSymbol [this
                                                               ^JCDiagnostic$DiagnosticPosition pos
                                                               ^{:tag (Env AttrContext)} env
                                                               ^Type site ^Name name
                                                               ^{:tag (List Type)} argtypes
                                                               ^{:tag (List Type)} typeargtypes]
    (let [resolveContext (MethodResolutionContext.)]
      (set! (.-internalResolution resolveContext) true)
      (let [sym (.resolveQualifiedMethod this
                                         resolveContext
                                         pos
                                         env
                                         (.-tsym site)
                                         site
                                         name
                                         argtypes
                                         typeargtypes)]
        (if (identical? (.-kind sym) Kinds$Kind/MTH)
            (cast Symbol$MethodSymbol sym)
            (throw (FatalError. (.fragment diags
                                           (CompilerProperties$Fragments/FatalErrCantLocateMeth
                                             name))))))))

  (method resolveConstructor ^Symbol [this ^JCDiagnostic$DiagnosticPosition pos
                                      ^{:tag (Env AttrContext)} env ^Type site
                                      ^{:tag (List Type)} argtypes ^{:tag (List Type)} typeargtypes]
    (.resolveConstructor this (MethodResolutionContext.) pos env site argtypes typeargtypes))

  (method ^:private resolveConstructor ^Symbol [this ^MethodResolutionContext resolveContext
                                                ^:final ^JCDiagnostic$DiagnosticPosition pos
                                                ^{:tag (Env AttrContext)} env ^Type site
                                                ^{:tag (List Type)} argtypes
                                                ^{:tag (List Type)} typeargtypes]
    (.lookupMethod this
                   env
                   pos
                   (.-tsym site)
                   resolveContext
                   (anon BasicLookupHelper [(.-init names) site argtypes typeargtypes]
                     (method lookup ^Symbol [this ^{:tag (Env AttrContext)} env
                                             ^MethodResolutionPhase phase]
                       (.findConstructor Resolve/this
                                         pos
                                         env
                                         (.-site this)
                                         (.-argtypes this)
                                         (.-typeargtypes this)
                                         (.isBoxingRequired phase)
                                         (.isVarargsRequired phase))))))

  (method ^:public resolveInternalConstructor ^Symbol$MethodSymbol [this
                                                                    ^JCDiagnostic$DiagnosticPosition pos
                                                                    ^{:tag (Env AttrContext)} env
                                                                    ^Type site
                                                                    ^{:tag (List Type)} argtypes
                                                                    ^{:tag (List Type)} typeargtypes]
    (let [resolveContext (MethodResolutionContext.)]
      (set! (.-internalResolution resolveContext) true)
      (let [sym (.resolveConstructor this resolveContext pos env site argtypes typeargtypes)]
        (if (identical? (.-kind sym) Kinds$Kind/MTH)
            (cast Symbol$MethodSymbol sym)
            (throw (FatalError. (.fragment diags
                                           (CompilerProperties$Fragments/FatalErrCantLocateCtor
                                             site))))))))

  (method findConstructor ^Symbol [this ^JCDiagnostic$DiagnosticPosition pos
                                   ^{:tag (Env AttrContext)} env ^Type site
                                   ^{:tag (List Type)} argtypes ^{:tag (List Type)} typeargtypes
                                   ^boolean allowBoxing ^boolean useVarargs]
    (let [sym (.findMethod this
                           env
                           site
                           (.-init names)
                           argtypes
                           typeargtypes
                           allowBoxing
                           useVarargs)]
      (.checkDeprecated chk pos (.-owner (.-scope (cast AttrContext (.-info env)))) sym)
      (.checkPreview chk pos (.-owner (.-scope (cast AttrContext (.-info env)))) sym)
      sym))

  (method resolveDiamond ^Symbol [this ^JCDiagnostic$DiagnosticPosition pos
                                  ^{:tag (Env AttrContext)} env ^Type site
                                  ^{:tag (List Type)} argtypes ^{:tag (List Type)} typeargtypes]
    (.lookupMethod this
                   env
                   pos
                   (.-tsym site)
                   resolveMethodCheck
                   (anon BasicLookupHelper [(.-init names) site argtypes typeargtypes]
                     (method lookup ^Symbol [this ^{:tag (Env AttrContext)} env
                                             ^MethodResolutionPhase phase]
                       (.findDiamond Resolve/this
                                     pos
                                     env
                                     (.-site this)
                                     (.-argtypes this)
                                     (.-typeargtypes this)
                                     (.isBoxingRequired phase)
                                     (.isVarargsRequired phase)))

                     (method access ^Symbol [this ^{:tag (Env AttrContext)} env
                                             ^JCDiagnostic$DiagnosticPosition pos ^Symbol location
                                             ^:mutable ^Symbol sym]
                       (when (.isResolutionError (.-kind sym))
                         (if (and (not (identical? (.-kind sym) Kinds$Kind/WRONG_MTH))
                                  (not (identical? (.-kind sym) Kinds$Kind/WRONG_MTHS)))
                             (set! sym (.access super env pos location sym))
                             (do
                               (set! sym (DiamondError. sym currentResolutionContext))
                               (set! sym
                                     (.accessMethod
                                       Resolve/this
                                       sym
                                       pos
                                       (.-site this)
                                       (.-init names)
                                       true
                                       (.-argtypes this)
                                       (.-typeargtypes this)))
                               (set! (.-pendingResolutionPhase (cast AttrContext (.-info env)))
                                     (.-step currentResolutionContext)))))
                       sym))))

  (method ^:private findDiamond ^Symbol [this ^JCDiagnostic$DiagnosticPosition pos
                                         ^{:tag (Env AttrContext)} env ^Type site
                                         ^{:tag (List Type)} argtypes
                                         ^{:tag (List Type)} typeargtypes ^boolean allowBoxing
                                         ^boolean useVarargs]
    (let [sym (.findDiamond this env site argtypes typeargtypes allowBoxing useVarargs)]
      (.checkDeprecated chk pos (.-owner (.-scope (cast AttrContext (.-info env)))) sym)
      (.checkPreview chk pos (.-owner (.-scope (cast AttrContext (.-info env)))) sym)
      sym))

  (method ^:private findDiamond ^Symbol [this ^{:tag (Env AttrContext)} env ^Type site
                                         ^{:tag (List Type)} argtypes
                                         ^{:tag (List Type)} typeargtypes ^boolean allowBoxing
                                         ^boolean useVarargs]
    (let [^:mutable ^Symbol bestSoFar methodNotFound
          ^Symbol$TypeSymbol tsym (if (.isInterface (.-tsym site))
                                      (.-tsym (.-objectType syms))
                                      (.-tsym site))]
      (for-each [^Symbol sym (.getSymbolsByName (.members tsym) (.-init names))]
        (when (and (identical? (.-kind sym) Kinds$Kind/MTH)
                   (== (bit-and (.-flags_field sym) Flags/SYNTHETIC) 0))
          (let [^{:tag (List Type)} oldParams (if (.hasTag (.-type sym) TypeTag/FORALL)
                                                  (.-tvars (cast Type$ForAll (.-type sym)))
                                                  (List/nil))
                ^Type constrType (Type$ForAll. (.appendList
                                                 (.getTypeArguments (.-type (.-tsym site)))
                                                 oldParams)
                                               (.createMethodTypeWithReturn
                                                 types
                                                 (.asMethodType (.-type sym))
                                                 site))
                ^Symbol$MethodSymbol newConstr (anon Symbol$MethodSymbol [(.flags sym)
                                                                          (.-init names)
                                                                          constrType
                                                                          (.-tsym site)]
                                                 (method ^:public baseSymbol ^Symbol [this] sym))]
            (set! bestSoFar
                  (.selectBest this
                               env
                               site
                               argtypes
                               typeargtypes
                               newConstr
                               bestSoFar
                               allowBoxing
                               useVarargs)))))
      bestSoFar))

  (method getMemberReference ^Symbol [this ^JCDiagnostic$DiagnosticPosition pos
                                      ^{:tag (Env AttrContext)} env
                                      ^JCTree$JCMemberReference referenceTree ^:mutable ^Type site
                                      ^Name name]
    (set! site (.capture types site))
    (let [lookupHelper (.makeReferenceLookupHelper
                         this
                         referenceTree
                         site
                         name
                         (List/nil)
                         nil
                         MethodResolutionPhase/VARARITY)
          ^{:tag (Env AttrContext)} newEnv (.dup
                                             env
                                             (.-tree env)
                                             (.dup (cast AttrContext (.-info env))))
          sym (.lookupMethod this
                             newEnv
                             (.pos (.-tree env))
                             (.-tsym site)
                             nilMethodCheck
                             lookupHelper)]
      (set! (.-pendingResolutionPhase (cast AttrContext (.-info env)))
            (.-pendingResolutionPhase (cast AttrContext (.-info newEnv))))
      sym))

  (method makeReferenceLookupHelper ^ReferenceLookupHelper [this
                                                            ^JCTree$JCMemberReference referenceTree
                                                            ^Type site ^Name name
                                                            ^{:tag (List Type)} argtypes
                                                            ^{:tag (List Type)} typeargtypes
                                                            ^MethodResolutionPhase maxPhase]
    (cond
      (not (.equals name (.-init names)))
        (MethodReferenceLookupHelper. referenceTree name site argtypes typeargtypes maxPhase)
      (.hasTag site TypeTag/ARRAY)
        (ArrayConstructorReferenceLookupHelper. referenceTree site argtypes typeargtypes maxPhase)
      :else (ConstructorReferenceLookupHelper. referenceTree site argtypes typeargtypes maxPhase)))

  (method resolveMemberReference ^{:tag (Pair Symbol ReferenceLookupHelper)} [this
                                                                              ^{:tag (Env AttrContext)} env
                                                                              ^JCTree$JCMemberReference referenceTree
                                                                              ^Type site ^Name name
                                                                              ^{:tag (List Type)} argtypes
                                                                              ^{:tag (List Type)} typeargtypes
                                                                              ^Type descriptor
                                                                              ^MethodCheck methodCheck
                                                                              ^InferenceContext inferenceContext
                                                                              ^ReferenceChooser referenceChooser]
    (let [boundLookupHelper (.makeReferenceLookupHelper
                              this
                              referenceTree
                              site
                              name
                              argtypes
                              typeargtypes
                              MethodResolutionPhase/VARARITY)
          ^{:tag (Env AttrContext)} boundEnv (.dup
                                               env
                                               (.-tree env)
                                               (.dup (cast AttrContext (.-info env))))
          boundSearchResolveContext (MethodResolutionContext.)]
      (set! (.-methodCheck boundSearchResolveContext) methodCheck)
      (let [boundSym (.lookupMethod this
                                    boundEnv
                                    (.pos (.-tree env))
                                    (.-tsym site)
                                    boundSearchResolveContext
                                    boundLookupHelper)
            isStaticSelector (TreeInfo/isStaticSelector (.-expr referenceTree) names)
            boundRes (ReferenceLookupResult. boundSym boundSearchResolveContext isStaticSelector)]
        (when dumpMethodReferenceSearchResults
          (.dumpMethodReferenceSearchResults this
                                             referenceTree
                                             boundSearchResolveContext
                                             boundSym
                                             true))
        (let [^:mutable ^Symbol unboundSym methodNotFound
              ^{:tag (Env AttrContext)} unboundEnv (.dup
                                                     env
                                                     (.-tree env)
                                                     (.dup (cast AttrContext (.-info env))))
              unboundLookupHelper (.unboundLookup boundLookupHelper inferenceContext)
              ^:mutable unboundRes referenceNotFound]
          (when (some? unboundLookupHelper)
            (let [unboundSearchResolveContext (MethodResolutionContext.)]
              (set! (.-methodCheck unboundSearchResolveContext) methodCheck)
              (set! unboundSym
                    (.lookupMethod this
                                   unboundEnv
                                   (.pos (.-tree env))
                                   (.-tsym site)
                                   unboundSearchResolveContext
                                   unboundLookupHelper))
              (set!
                unboundRes
                (ReferenceLookupResult. unboundSym unboundSearchResolveContext isStaticSelector))
              (when dumpMethodReferenceSearchResults
                (.dumpMethodReferenceSearchResults
                  this
                  referenceTree
                  unboundSearchResolveContext
                  unboundSym
                  false))))
          (let [^:mutable ^{:tag (Pair Symbol ReferenceLookupHelper)} res nil
                bestRes (.result referenceChooser boundRes unboundRes)]
            (set! res
                  (Pair. (.-sym bestRes)
                         ^ReferenceLookupHelper (if (identical? bestRes unboundRes)
                                                    unboundLookupHelper
                                                    boundLookupHelper)))
            (set! (.-pendingResolutionPhase (cast AttrContext (.-info env)))
                  (if (identical? bestRes unboundRes)
                      (.-pendingResolutionPhase (cast AttrContext (.-info unboundEnv)))
                      (.-pendingResolutionPhase (cast AttrContext (.-info boundEnv)))))
            (when-not (.isResolutionError (.-kind (cast Symbol (.-fst res))))
              (let [msym (cast Symbol$MethodSymbol (.-fst res))]
                (when-not (== (bit-and (.flags msym) Flags/SIGNATURE_POLYMORPHIC) 0)
                  (set! (.-pendingResolutionPhase (cast AttrContext (.-info env)))
                        MethodResolutionPhase/BASIC)
                  (set! res
                        (Pair. (.findPolymorphicSignatureInstance this msym descriptor)
                               (cast ReferenceLookupHelper (.-snd res)))))))
            res)))))

  (method ^:private dumpMethodReferenceSearchResults ^void [this
                                                            ^JCTree$JCMemberReference referenceTree
                                                            ^MethodResolutionContext resolutionContext
                                                            ^Symbol bestSoFar ^boolean bound]
    (let [^{:tag (ListBuffer JCDiagnostic)} subDiags (ListBuffer.)
          ^:mutable ^int pos 0
          ^:mutable ^int mostSpecificPos -1]
      (for-each [^Resolve$MethodResolutionContext$Candidate c (.-candidates resolutionContext)]
        (when-not (or (not (identical? (.-step resolutionContext) (.-step c)))
                      (not (.isApplicable c)))
          (let [^:mutable ^JCDiagnostic subDiag nil]
            (when (.hasTag (.-type (.-sym c)) TypeTag/FORALL)
              (set! subDiag
                    (.fragment diags (CompilerProperties$Fragments/PartialInstSig (.-mtype c)))))
            (let [^String key (if (nil? subDiag)
                                  "applicable.method.found.2"
                                  "applicable.method.found.3")]
              (.append subDiags
                       (.fragment diags
                                  key
                                  (new Object/1
                                       [pos
                                        (if (.isStatic (.-sym c))
                                            CompilerProperties$Fragments/Static
                                            CompilerProperties$Fragments/NonStatic)
                                        (.-sym c)
                                        subDiag])))
              (when (identical? (.-sym c) bestSoFar) (set! mostSpecificPos pos))
              (set! pos (unchecked-inc-int pos))))))
      (let [main (.note diags
                        (.currentSource log)
                        referenceTree
                        "method.ref.search.results.multi"
                        (new Object/1
                             [(if bound
                                  CompilerProperties$Fragments/Bound
                                  CompilerProperties$Fragments/Unbound)
                              (.toString referenceTree)
                              mostSpecificPos]))
            ^JCDiagnostic d (JCDiagnostic$MultilineDiagnostic. main (.toList subDiags))]
        (.report log d))))

  (defclass ^:static ReferenceLookupResult
    (defclass ^:enum StaticKind
      (constants STATIC NON_STATIC BOTH UNDEFINED)

      (method ^:static from ^StaticKind [^Symbol s]
        (if (.isStatic s) STATIC NON_STATIC))

      (method ^:static reduce ^StaticKind [^StaticKind sk1 ^StaticKind sk2]
        (cond
          (identical? sk1 UNDEFINED) sk2
          (identical? sk2 UNDEFINED) sk1
          (identical? sk1 sk2) sk1
          :else BOTH)))

    (field ^StaticKind staticKind)

    (field ^Symbol sym)

    (constructor [this ^Symbol sym ^MethodResolutionContext resolutionContext
                  ^boolean isStaticSelector]
      (this. sym (ReferenceLookupResult/staticKind sym resolutionContext isStaticSelector)))

    (constructor ^:private [this ^Symbol sym ^StaticKind staticKind]
      (set! (.-staticKind this) staticKind)
      (set! (.-sym this) sym))

    (method ^:private ^:static staticKind ^StaticKind [^Symbol sym
                                                       ^MethodResolutionContext resolutionContext
                                                       ^boolean isStaticSelector]
      (cond
        (and (identical? (.-kind sym) Kinds$Kind/MTH) (not isStaticSelector)) (StaticKind/from sym)
        (or (identical? (.-kind sym) Kinds$Kind/MTH) (identical? (.-kind sym) Kinds$Kind/AMBIGUOUS))
          (cast
            StaticKind
            (.orElse (.reduce
                       (.map
                         (.filter
                           (.stream (.-candidates resolutionContext))
                           (lambda Predicate ^boolean [^Resolve$MethodResolutionContext$Candidate c]
                             (and (.isApplicable c)
                                  (identical? (.-step c) (.-step resolutionContext)))))
                         (lambda Function ^StaticKind [^Resolve$MethodResolutionContext$Candidate c]
                           (StaticKind/from (.-sym c))))
                       (method-ref BinaryOperator
                                   ^StaticKind [StaticKind StaticKind]
                                   StaticKind/reduce))
                     StaticKind/UNDEFINED))
        :else StaticKind/UNDEFINED))

    (method isSuccess ^boolean [this]
      (not (identical? staticKind StaticKind/UNDEFINED)))

    (method hasKind ^boolean [this ^StaticKind sk]
      (identical? (.-staticKind this) sk))

    (method canIgnore ^boolean [this]
      (switch (.-kind sym)
        ABSENT_MTH true
        WRONG_MTH
          (let [errSym (cast InapplicableSymbolError (.baseSymbol sym))]
            (.matches (Resolve$MethodResolutionDiagHelper$Template.
                        (.regex MethodCheckDiag/ARITY_MISMATCH))
                      (.-snd (.errCandidate errSym))))
        WRONG_MTHS
          (let [errSyms (cast InapplicableSymbolsError (.baseSymbol sym))]
            (.isEmpty (.filterCandidates errSyms (.mapCandidates errSyms))))
        false))

    (method ^:static error ^ReferenceLookupResult [^Symbol sym]
      (ReferenceLookupResult. sym StaticKind/UNDEFINED)))

  (defclass ^:abstract ReferenceChooser
    (method result ^ReferenceLookupResult [this ^ReferenceLookupResult boundRes
                                           ^ReferenceLookupResult unboundRes]
      (if (not (identical? unboundRes referenceNotFound))
          (.unboundResult this boundRes unboundRes)
          (.boundResult this boundRes)))

    (method ^:abstract boundResult ^ReferenceLookupResult [this ^ReferenceLookupResult boundRes])

    (method ^:abstract unboundResult ^ReferenceLookupResult [this ^ReferenceLookupResult boundRes
                                                             ^ReferenceLookupResult unboundRes]))

  (field ^ReferenceChooser basicReferenceChooser
    (anon ReferenceChooser []
      (method boundResult ^ReferenceLookupResult [this ^ReferenceLookupResult boundRes]
        (if (or (not (.isSuccess boundRes))
                (.hasKind boundRes Resolve$ReferenceLookupResult$StaticKind/NON_STATIC))
            boundRes
            (ReferenceLookupResult/error (BadMethodReferenceError. (.-sym boundRes) false))))

      (method unboundResult ^ReferenceLookupResult [this ^ReferenceLookupResult boundRes
                                                    ^ReferenceLookupResult unboundRes]
        (cond
          (and (and (.isSuccess boundRes) (.isStatic (.-sym boundRes)))
               (or (not (.isSuccess unboundRes))
                   (.hasKind unboundRes Resolve$ReferenceLookupResult$StaticKind/STATIC)))
            boundRes
          (and (and (.isSuccess unboundRes) (not (.isStatic (.-sym unboundRes))))
               (or (not (.isSuccess boundRes))
                   (.hasKind boundRes Resolve$ReferenceLookupResult$StaticKind/NON_STATIC)))
            unboundRes
          (and (.isSuccess boundRes) (.isSuccess unboundRes))
            (ReferenceLookupResult/error
              (.ambiguityError Resolve/this (.-sym boundRes) (.-sym unboundRes)))
          (or (.isSuccess boundRes) (.isSuccess unboundRes))
            (ReferenceLookupResult/error
              (BadMethodReferenceError.
                ^Symbol (if (.isSuccess boundRes) (.-sym boundRes) (.-sym unboundRes))
                true))
          (and (.canIgnore boundRes) (not (.canIgnore unboundRes))) unboundRes
          :else boundRes))))

  (field ^ReferenceChooser structuralReferenceChooser
    (anon ReferenceChooser []
      (method boundResult ^ReferenceLookupResult [this ^ReferenceLookupResult boundRes]
        (if (or (not (.isSuccess boundRes))
                (not (.hasKind boundRes Resolve$ReferenceLookupResult$StaticKind/STATIC)))
            boundRes
            (ReferenceLookupResult/error (BadMethodReferenceError. (.-sym boundRes) false))))

      (method unboundResult ^ReferenceLookupResult [this ^ReferenceLookupResult boundRes
                                                    ^ReferenceLookupResult unboundRes]
        (cond
          (and (.isSuccess boundRes)
               (not (.hasKind boundRes Resolve$ReferenceLookupResult$StaticKind/NON_STATIC)))
            boundRes
          (and (.isSuccess unboundRes)
               (not (.hasKind unboundRes Resolve$ReferenceLookupResult$StaticKind/STATIC)))
            unboundRes
          (or (.isSuccess boundRes) (.isSuccess unboundRes))
            (ReferenceLookupResult/error
              (BadMethodReferenceError.
                ^Symbol (if (.isSuccess boundRes) (.-sym boundRes) (.-sym unboundRes))
                true))
          (and (.canIgnore boundRes) (not (.canIgnore unboundRes))) unboundRes
          :else boundRes))))

  (defclass ^:abstract LookupHelper
    (field ^Name name)

    (field ^Type site)

    (field ^{:tag (List Type)} argtypes)

    (field ^{:tag (List Type)} typeargtypes)

    (field ^MethodResolutionPhase maxPhase)

    (constructor [this ^Name name ^Type site ^{:tag (List Type)} argtypes
                  ^{:tag (List Type)} typeargtypes ^MethodResolutionPhase maxPhase]
      (set! (.-name this) name)
      (set! (.-site this) site)
      (set! (.-argtypes this) argtypes)
      (set! (.-typeargtypes this) typeargtypes)
      (set! (.-maxPhase this) maxPhase))

    (method ^:final shouldStop ^boolean [this ^Symbol sym ^MethodResolutionPhase phase]
      (or (or (or (> (.ordinal phase) (.ordinal maxPhase)) (not (.isResolutionError (.-kind sym))))
              (identical? (.-kind sym) Kinds$Kind/AMBIGUOUS))
          (identical? (.-kind sym) Kinds$Kind/STATICERR)))

    (method ^:abstract lookup ^Symbol [this ^{:tag (Env AttrContext)} env
                                       ^MethodResolutionPhase phase])

    (method debug ^void [this ^JCDiagnostic$DiagnosticPosition pos ^Symbol sym])

    (method ^:abstract access ^Symbol [this ^{:tag (Env AttrContext)} env
                                       ^JCDiagnostic$DiagnosticPosition pos ^Symbol location
                                       ^Symbol sym]))

  (defclass ^:abstract BasicLookupHelper
    :extends LookupHelper

    (constructor [this ^Name name ^Type site ^{:tag (List Type)} argtypes
                  ^{:tag (List Type)} typeargtypes]
      (this. name site argtypes typeargtypes MethodResolutionPhase/VARARITY))

    (constructor [this ^Name name ^Type site ^{:tag (List Type)} argtypes
                  ^{:tag (List Type)} typeargtypes ^MethodResolutionPhase maxPhase]
      (super. name site argtypes typeargtypes maxPhase))

    (method access ^Symbol [this ^{:tag (Env AttrContext)} env ^JCDiagnostic$DiagnosticPosition pos
                            ^Symbol location ^:mutable ^Symbol sym]
      (when (.isResolutionError (.-kind sym))
        (set! sym
              (.accessMethod Resolve/this
                             sym
                             pos
                             location
                             (.-site this)
                             (.-name this)
                             true
                             (.-argtypes this)
                             (.-typeargtypes this))))
      sym)

    (method debug ^void [this ^JCDiagnostic$DiagnosticPosition pos ^Symbol sym]
      (.reportVerboseResolutionDiagnostic Resolve/this
                                          pos
                                          (.-name this)
                                          (.-site this)
                                          (.-argtypes this)
                                          (.-typeargtypes this)
                                          sym)))

  (defclass ^:abstract ReferenceLookupHelper
    :extends LookupHelper

    (field ^JCTree$JCMemberReference referenceTree)

    (constructor [this ^JCTree$JCMemberReference referenceTree ^Name name ^Type site
                  ^{:tag (List Type)} argtypes ^{:tag (List Type)} typeargtypes
                  ^MethodResolutionPhase maxPhase]
      (super. name site argtypes typeargtypes maxPhase)
      (set! (.-referenceTree this) referenceTree))

    (method unboundLookup ^ReferenceLookupHelper [this ^InferenceContext inferenceContext]
      nil)

    (method ^:abstract referenceKind ^JCTree$JCMemberReference$ReferenceKind [this ^Symbol sym])

    (method access ^Symbol [this ^{:tag (Env AttrContext)} env ^JCDiagnostic$DiagnosticPosition pos
                            ^Symbol location ^Symbol sym]
      sym))

  (defclass MethodReferenceLookupHelper
    :extends ReferenceLookupHelper

    (field ^Type originalSite)

    (constructor [this ^JCTree$JCMemberReference referenceTree ^Name name ^Type site
                  ^{:tag (List Type)} argtypes ^{:tag (List Type)} typeargtypes
                  ^MethodResolutionPhase maxPhase]
      (super. referenceTree name (.skipTypeVars types site true) argtypes typeargtypes maxPhase)
      (set! (.-originalSite this) site))

    (method ^:final lookup ^Symbol [this ^{:tag (Env AttrContext)} env ^MethodResolutionPhase phase]
      (.findMethod Resolve/this
                   env
                   (.-site this)
                   (.-name this)
                   (.-argtypes this)
                   (.-typeargtypes this)
                   (.isBoxingRequired phase)
                   (.isVarargsRequired phase)))

    (method unboundLookup ^ReferenceLookupHelper [this ^InferenceContext inferenceContext]
      (if (TreeInfo/isStaticSelector (.-expr (.-referenceTree this)) names)
          (if (and (.nonEmpty (.-argtypes this))
                   (or (.hasTag (cast Type (.-head (.-argtypes this))) TypeTag/NONE)
                       (.isSubtypeUnchecked types
                                            (.asUndetVar
                                              inferenceContext
                                              (cast Type (.-head (.-argtypes this))))
                                            originalSite)))
              (UnboundMethodReferenceLookupHelper.
                (.-referenceTree this)
                (.-name this)
                originalSite
                (.-argtypes this)
                (.-typeargtypes this)
                (.-maxPhase this))
              (anon ReferenceLookupHelper [(.-referenceTree this)
                                           (.-name this)
                                           (.-site this)
                                           (.-argtypes this)
                                           (.-typeargtypes this)
                                           (.-maxPhase this)]
                (method unboundLookup ^ReferenceLookupHelper [this
                                                              ^InferenceContext inferenceContext]
                  this)

                (method lookup ^Symbol [this ^{:tag (Env AttrContext)} env
                                        ^MethodResolutionPhase phase]
                  methodNotFound)

                (method referenceKind ^JCTree$JCMemberReference$ReferenceKind [this ^Symbol sym]
                  (Assert/error)
                  nil)))
          (.unboundLookup super inferenceContext)))

    (method referenceKind ^JCTree$JCMemberReference$ReferenceKind [this ^Symbol sym]
      (if (.isStatic sym)
          JCTree$JCMemberReference$ReferenceKind/STATIC
          (let [selName (TreeInfo/name (.getQualifierExpression (.-referenceTree this)))]
            (if (and (some? selName) (identical? selName (.-_super names)))
                JCTree$JCMemberReference$ReferenceKind/SUPER
                JCTree$JCMemberReference$ReferenceKind/BOUND))))

    (method access ^Symbol [this ^{:tag (Env AttrContext)} env ^JCDiagnostic$DiagnosticPosition pos
                            ^Symbol location ^:mutable ^Symbol sym]
      (if (and (.hasTag originalSite TypeTag/TYPEVAR) (identical? (.-kind sym) Kinds$Kind/MTH))
          (do
            (set! sym
                  (if (not (== (bit-and (.flags sym) Flags/PRIVATE) 0))
                      ^Symbol (AccessError. env (.-site this) sym)
                      sym))
            (.accessBase Resolve/this sym pos location originalSite (.-name this) true))
          (.access super env pos location sym))))

  (defclass UnboundMethodReferenceLookupHelper
    :extends MethodReferenceLookupHelper

    (constructor [this ^JCTree$JCMemberReference referenceTree ^Name name ^Type site
                  ^{:tag (List Type)} argtypes ^{:tag (List Type)} typeargtypes
                  ^MethodResolutionPhase maxPhase]
      (super. referenceTree name site (.-tail argtypes) typeargtypes maxPhase)
      (when (and (.isRaw site) (not (.hasTag (cast Type (.-head argtypes)) TypeTag/NONE)))
        (let [asSuperSite (.asSuper types (cast Type (.-head argtypes)) (.-tsym site))]
          (set! (.-site this) (.skipTypeVars types asSuperSite true)))))

    (method unboundLookup ^ReferenceLookupHelper [this ^InferenceContext inferenceContext]
      this)

    (method referenceKind ^JCTree$JCMemberReference$ReferenceKind [this ^Symbol sym]
      JCTree$JCMemberReference$ReferenceKind/UNBOUND))

  (defclass ArrayConstructorReferenceLookupHelper
    :extends ReferenceLookupHelper

    (constructor [this ^JCTree$JCMemberReference referenceTree ^Type site
                  ^{:tag (List Type)} argtypes ^{:tag (List Type)} typeargtypes
                  ^MethodResolutionPhase maxPhase]
      (super. referenceTree (.-init names) site argtypes typeargtypes maxPhase))

    (method ^:protected lookup ^Symbol [this ^{:tag (Env AttrContext)} env
                                        ^MethodResolutionPhase phase]
      (let [sc (Scope$WriteableScope/create (.-arrayClass syms))
            arrayConstr (Symbol$MethodSymbol. Flags/PUBLIC (.-name this) nil (.-tsym (.-site this)))]
        (set! (.-type arrayConstr)
              (Type$MethodType. (List/of (.-intType syms))
                                (.-site this)
                                (List/nil)
                                (.-methodClass syms)))
        (.enter sc arrayConstr)
        (.findMethodInScope Resolve/this
                            env
                            (.-site this)
                            (.-name this)
                            (.-argtypes this)
                            (.-typeargtypes this)
                            sc
                            methodNotFound
                            (.isBoxingRequired phase)
                            (.isVarargsRequired phase)
                            false)))

    (method referenceKind ^JCTree$JCMemberReference$ReferenceKind [this ^Symbol sym]
      JCTree$JCMemberReference$ReferenceKind/ARRAY_CTOR))

  (defclass ConstructorReferenceLookupHelper
    :extends ReferenceLookupHelper

    (field ^boolean needsInference)

    (constructor [this ^JCTree$JCMemberReference referenceTree ^Type site
                  ^{:tag (List Type)} argtypes ^{:tag (List Type)} typeargtypes
                  ^MethodResolutionPhase maxPhase]
      (super. referenceTree (.-init names) site argtypes typeargtypes maxPhase)
      (when (.isRaw site)
        (set! (.-site this)
              (Type$ClassType. (.getEnclosingType site)
                               ^List (if (not (and
                                                (.isInner (.-tsym site))
                                                (.isRaw (.getEnclosingType site))))
                                         (.getTypeArguments (.-type (.-tsym site)))
                                         (List/nil))
                               (.-tsym site)
                               (.getMetadata site)))
        (set! needsInference true)))

    (method ^:protected lookup ^Symbol [this ^{:tag (Env AttrContext)} env
                                        ^MethodResolutionPhase phase]
      (if needsInference
          (.findDiamond Resolve/this
                        env
                        (.-site this)
                        (.-argtypes this)
                        (.-typeargtypes this)
                        (.isBoxingRequired phase)
                        (.isVarargsRequired phase))
          (.findMethod Resolve/this
                       env
                       (.-site this)
                       (.-name this)
                       (.-argtypes this)
                       (.-typeargtypes this)
                       (.isBoxingRequired phase)
                       (.isVarargsRequired phase))))

    (method referenceKind ^JCTree$JCMemberReference$ReferenceKind [this ^Symbol sym]
      (if (.hasTag (.getEnclosingType (.-site this)) TypeTag/NONE)
          JCTree$JCMemberReference$ReferenceKind/TOPLEVEL
          JCTree$JCMemberReference$ReferenceKind/IMPLICIT_INNER)))

  (method lookupMethod ^Symbol [this ^{:tag (Env AttrContext)} env
                                ^JCDiagnostic$DiagnosticPosition pos ^Symbol location
                                ^MethodCheck methodCheck ^LookupHelper lookupHelper]
    (let [resolveContext (MethodResolutionContext.)]
      (set! (.-methodCheck resolveContext) methodCheck)
      (.lookupMethod this env pos location resolveContext lookupHelper)))

  (method lookupMethod ^Symbol [this ^{:tag (Env AttrContext)} env
                                ^JCDiagnostic$DiagnosticPosition pos ^Symbol location
                                ^MethodResolutionContext resolveContext ^LookupHelper lookupHelper]
    (let [prevResolutionContext currentResolutionContext]
      (try
        (let [^:mutable ^Symbol bestSoFar methodNotFound]
          (set! currentResolutionContext resolveContext)
          (for-each [^MethodResolutionPhase phase methodResolutionSteps]
            (when (.shouldStop lookupHelper bestSoFar phase) (break))
            (let [prevPhase (.-step currentResolutionContext)
                  prevBest bestSoFar]
              (set! (.-step currentResolutionContext) phase)
              (let [sym (.lookup lookupHelper env phase)]
                (.debug lookupHelper pos sym)
                (set! bestSoFar (.mergeResults phase bestSoFar sym))
                (set! (.-pendingResolutionPhase (cast AttrContext (.-info env)))
                      (if (identical? prevBest bestSoFar) prevPhase phase)))))
          (.access lookupHelper env pos location bestSoFar))
        (finally (set! currentResolutionContext prevResolutionContext)))))

  (method findSelfContaining ^Symbol [this ^JCDiagnostic$DiagnosticPosition pos
                                      ^{:tag (Env AttrContext)} env ^Symbol$TypeSymbol c
                                      ^boolean isSuper]
    (let [^:mutable ^{:tag (Env AttrContext)} env1 (if isSuper (.-outer env) env)
          ^:mutable staticOnly false]
      (while (some? (.-outer env1))
        (when (Resolve/isStatic env1) (set! staticOnly true))
        (when (.isSubClass (.-sym (.-enclClass env1)) c types)
          (let [sym (.findFirst (.-scope (cast AttrContext (.-info env1))) (.-_this names))]
            (when (some? sym)
              (cond
                staticOnly (return (StaticError. sym))
                (and (.-ctorPrologue (cast AttrContext (.-info env1)))
                     (not (.isAllowedEarlyReference this pos env1 (cast Symbol$VarSymbol sym))))
                  (return (RefBeforeCtorCalledError. sym))
                :else (return sym)))))
        (when-not (== (bit-and (.flags (.-sym (.-enclClass env1))) Flags/STATIC) 0)
          (set! staticOnly true))
        (set! env1 (.-outer env1)))
      varNotFound))

  (method findLocalClassOwner ^Symbol [this ^{:tag (Env AttrContext)} env ^Symbol$TypeSymbol c]
    (let [owner (.-owner c)]
      (Assert/check (or (identical? (.-kind owner) Kinds$Kind/MTH)
                        (identical? (.-kind owner) Kinds$Kind/VAR)))
      (let [^:mutable ^{:tag (Env AttrContext)} env1 env
            ^:mutable staticOnly false]
        (while (some? (.-outer env1))
          (when (identical? (.-owner (.-scope (cast AttrContext (.-info env1)))) owner)
            (return (if staticOnly ^Symbol (BadLocalClassCreation. c) owner)))
          (when (Resolve/isStatic env1) (set! staticOnly true))
          (set! env1 (.-outer env1)))
        (if (identical? (.-kind owner) Kinds$Kind/MTH) ^Symbol methodNotFound ^Symbol varNotFound))))

  (method resolveSelf ^Symbol [this ^JCDiagnostic$DiagnosticPosition pos
                               ^{:tag (Env AttrContext)} env ^Symbol$TypeSymbol c
                               ^JCTree$JCFieldAccess tree]
    (let [name (.-name tree)]
      (Assert/check (or (identical? name (.-_this names)) (identical? name (.-_super names))))
      (let [^:mutable ^{:tag (Env AttrContext)} env1 env
            ^:mutable staticOnly false]
        (while (some? (.-outer env1))
          (when (Resolve/isStatic env1) (set! staticOnly true))
          (when (identical? (.-sym (.-enclClass env1)) c)
            (let [^:mutable sym (.findFirst (.-scope (cast AttrContext (.-info env1))) name)]
              (when (some? sym)
                (cond
                  staticOnly (set! sym (StaticError. sym))
                  (and (and (.-ctorPrologue (cast AttrContext (.-info env1)))
                            (not (.isReceiverParameter this env tree)))
                       (not (.isAllowedEarlyReference this pos env1 (cast Symbol$VarSymbol sym))))
                    (set! sym (RefBeforeCtorCalledError. sym)))
                (return (.accessBase this sym pos (.-type (.-sym (.-enclClass env))) name true)))))
          (when-not (== (bit-and (.flags (.-sym (.-enclClass env1))) Flags/STATIC) 0)
            (set! staticOnly true))
          (set! env1 (.-outer env1)))
        (when (and (and (and (.isInterface c) (identical? name (.-_super names)))
                        (not (Resolve/isStatic env)))
                   (.isDirectSuperInterface types c (.-sym (.-enclClass env))))
          (for-each [^Type t (.pruneInterfaces this (.-type (.-enclClass env)))]
            (when (identical? (.-tsym t) c)
              (when (.-ctorPrologue (cast AttrContext (.-info env)))
                (.error log pos (CompilerProperties$Errors/CantRefBeforeCtorCalled name)))
              (set! (.-defaultSuperCallSite (cast AttrContext (.-info env))) t)
              (return (Symbol$VarSymbol. 0
                                         (.-_super names)
                                         (.asSuper types (.-type (.-enclClass env)) c)
                                         (.-sym (.-enclClass env))))))
          (for-each [^Type i (.directSupertypes types (.-type (.-enclClass env)))]
            (when (and (.isSubClass (.-tsym i) c types) (not (identical? (.-tsym i) c)))
              (.error log
                      pos
                      (CompilerProperties$Errors/IllegalDefaultSuperCall
                        c
                        (CompilerProperties$Fragments/RedundantSupertype c i)))
              (return (.-errSymbol syms))))
          (Assert/error))
        (.error log pos (CompilerProperties$Errors/NotEnclClass c))
        (.-errSymbol syms))))

  (method ^:private pruneInterfaces ^{:tag (List Type)} [this ^Type t]
    (let [^{:tag (ListBuffer Type)} result (ListBuffer.)]
      (for-each [^Type t1 (.interfaces types t)]
        (let [^:mutable shouldAdd true]
          (for-each [^Type t2 (.directSupertypes types t)]
            (when (and (and (not (identical? t1 t2)) (not (.hasTag t2 TypeTag/ERROR)))
                       (.isSubtypeNoCapture types t2 t1))
              (set! shouldAdd false)))
          (when shouldAdd (.append result t1))))
      (.toList result)))

  (method ^:private isReceiverParameter ^boolean [this ^{:tag (Env AttrContext)} env
                                                  ^JCTree$JCFieldAccess tree]
    (if (not (identical? (.getTag (.-tree env)) JCTree$Tag/METHODDEF))
        false
        (let [method (cast JCTree$JCMethodDecl (.-tree env))]
          (and (some? (.-recvparam method)) (identical? tree (.-nameexpr (.-recvparam method)))))))

  (method ^:private isAllowedEarlyReference ^boolean [this ^JCDiagnostic$DiagnosticPosition pos
                                                      ^{:tag (Env AttrContext)} env
                                                      ^Symbol$VarSymbol v]
    (Assert/check (.-ctorPrologue (cast AttrContext (.-info env))))
    (Assert/check (== (bit-and (.-flags_field v) Flags/STATIC) 0))
    (if-instance [^JCTree$JCAssign assign (.-tree env)]
      (if (.-isLambda (cast AttrContext (.-info env)))
          false
          (let [lhs (TreeInfo/skipParens (.-lhs assign))
                ^:mutable ^JCTree$JCExpression base nil]
            (switch (.getTag lhs)
              IDENT (set! base nil)
              SELECT
                (let [select (cast JCTree$JCFieldAccess lhs)]
                  (set! base (.-selected select))
                  (when-not (TreeInfo/isExplicitThisReference
                              types
                              (cast Type$ClassType (.-type (.-enclClass env)))
                              base)
                    (return false)))
              (return false))
            (if (and (.isEarlyReference this env base v)
                     (not (identical? (.-owner v) (.-sym (.-enclClass env)))))
                false
                (do (.checkSourceLevel preview pos Source$Feature/FLEXIBLE_CONSTRUCTORS) true))))
      false))

  (method ^:public isEarlyReference ^boolean [this ^{:tag (Env AttrContext)} env ^JCTree base
                                              ^Symbol$VarSymbol v]
    (if (and (and (.-ctorPrologue (cast AttrContext (.-info env)))
                  (== (bit-and (.flags v) Flags/STATIC) 0))
             (.isMemberOf v (.-sym (.-enclClass env)) types))
        (if (some? base)
            (TreeInfo/isExplicitThisReference types
                                              (cast Type$ClassType (.-type (.-enclClass env)))
                                              base)
            true)
        false))

  (method ^:public logAccessErrorInternal ^void [this ^{:tag (Env AttrContext)} env ^JCTree tree
                                                 ^Type type]
    (let [error (AccessError. env (.-type (.-enclClass env)) (.-tsym type))]
      (.logResolveError this
                        error
                        (.pos tree)
                        (.-sym (.-enclClass env))
                        (.-type (.-enclClass env))
                        nil
                        nil
                        nil)))

  (method ^:private logResolveError ^void [this ^ResolveError error
                                           ^JCDiagnostic$DiagnosticPosition pos ^Symbol location
                                           ^Type site ^Name name ^{:tag (List Type)} argtypes
                                           ^{:tag (List Type)} typeargtypes]
    (let [d (.getDiagnostic error
                            JCDiagnostic$DiagnosticType/ERROR
                            pos
                            location
                            site
                            name
                            argtypes
                            typeargtypes)]
      (when (some? d) (.setFlag d JCDiagnostic$DiagnosticFlag/RESOLVE_ERROR) (.report log d))))

  (field ^:private ^:final ^Formattable$LocalizedString noArgs
    (Formattable$LocalizedString. "compiler.misc.no.args"))

  (method ^:public methodArguments [this ^{:tag (List Type)} argtypes]
    (if (or (nil? argtypes) (.isEmpty argtypes))
        noArgs
        (let [^{:tag (ListBuffer Object)} diagArgs (ListBuffer.)]
          (for-each [^Type t argtypes]
            (if (.hasTag t TypeTag/DEFERRED)
                (.append diagArgs (.-tree (cast DeferredAttr$DeferredType t)))
                (.append diagArgs t)))
          diagArgs)))

  (method isSerializable ^boolean [this ^Type t]
    (try (.complete (.-serializableType syms)) (catch Symbol$CompletionFailure e (return false)))
    (.isSubtype types t (.-serializableType syms)))

  (defclass ^:abstract ResolveError
    :extends Symbol

    (field ^:final ^String debugName)

    (constructor [this ^Kinds$Kind kind ^String debugName]
      (super. kind 0 nil nil nil)
      (set! (.-debugName this) debugName))

    (method ^:public accept :type-params [R P] ^R [this ^{:tag (ElementVisitor R P)} v ^P p]
      (throw (AssertionError.)))

    (method ^:public toString ^String [this] debugName)

    (method ^:public exists ^boolean [this] false)

    (method ^:public isStatic ^boolean [this] false)

    (method ^:protected access ^Symbol [this ^Name name ^Symbol$TypeSymbol location]
      (.-tsym (.createErrorType types name location (.-type (.-errSymbol syms)))))

    (method ^:abstract getDiagnostic ^JCDiagnostic [this ^JCDiagnostic$DiagnosticType dkind
                                                    ^JCDiagnostic$DiagnosticPosition pos
                                                    ^Symbol location ^Type site ^Name name
                                                    ^{:tag (List Type)} argtypes
                                                    ^{:tag (List Type)} typeargtypes]))

  (defclass ^:abstract InvalidSymbolError
    :extends ResolveError

    (field ^Symbol sym)

    (constructor [this ^Kinds$Kind kind ^Symbol sym ^String debugName]
      (super. kind debugName)
      (set! (.-sym this) sym))

    (method ^:public exists ^boolean [this] true)

    (method ^:public toString ^String [this]
      (java-str (.toString super) " wrongSym=" sym))

    (method ^:public access ^Symbol [this ^Name name ^Symbol$TypeSymbol location]
      (if (and (not (.isResolutionError (.-kind sym)))
               (.matches (.-kind sym) Kinds$KindSelector/TYP))
          (.-tsym (.createErrorType types name location (.-type sym)))
          sym)))

  (defclass BadRestrictedTypeError
    :extends ResolveError

    (field ^:private ^:final ^Name typeName)

    (constructor [this ^Name typeName]
      (super. Kinds$Kind/BAD_RESTRICTED_TYPE "bad var use")
      (set! (.-typeName this) typeName))

    (method getDiagnostic ^JCDiagnostic [this ^JCDiagnostic$DiagnosticType dkind
                                         ^JCDiagnostic$DiagnosticPosition pos ^Symbol location
                                         ^Type site ^Name name ^{:tag (List Type)} argtypes
                                         ^{:tag (List Type)} typeargtypes]
      (.create diags
               dkind
               (.currentSource log)
               pos
               "illegal.ref.to.restricted.type"
               (new Object/1 [typeName]))))

  (defclass SymbolNotFoundError
    :extends ResolveError

    (constructor [this ^Kinds$Kind kind]
      (this. kind "symbol not found error"))

    (constructor [this ^Kinds$Kind kind ^String debugName]
      (super. kind debugName))

    (method getDiagnostic ^JCDiagnostic [this ^JCDiagnostic$DiagnosticType dkind
                                         ^JCDiagnostic$DiagnosticPosition pos
                                         ^:mutable ^Symbol location ^Type site ^Name name
                                         ^:mutable ^{:tag (List Type)} argtypes
                                         ^:mutable ^{:tag (List Type)} typeargtypes]
      (set! argtypes (if (nil? argtypes) (List/nil) argtypes))
      (set! typeargtypes (if (nil? typeargtypes) (List/nil) typeargtypes))
      (when-not (identical? name (.-error names))
        (let [^:mutable hasLocation false]
          (when (nil? location) (set! location (.-tsym site)))
          (when-not (.isEmpty (.-name location))
            (when (and (and (identical? (.-kind location) Kinds$Kind/PCK)
                            (not (.exists (.-tsym site))))
                       (not (identical? (.-name location) (.-java names))))
              (return (.create diags
                               dkind
                               (.currentSource log)
                               pos
                               "doesnt.exist"
                               (new Object/1 [location]))))
            (set! hasLocation
                  (and (not (.equals (.-name location) (.-_this names)))
                       (not (.equals (.-name location) (.-_super names))))))
          (let [isConstructor (identical? name (.-init names))
                ^Kinds$KindName kindname (if isConstructor
                                             Kinds$KindName/CONSTRUCTOR
                                             (.absentKind (.-kind this)))
                ^Name idname (if isConstructor (.-name (.-tsym site)) name)
                errKey (.getErrorKey this kindname (.nonEmpty typeargtypes) hasLocation)]
            (if hasLocation
                (.create diags
                         dkind
                         (.currentSource log)
                         pos
                         errKey
                         (new Object/1
                              [kindname
                               idname
                               typeargtypes
                               (.args this argtypes)
                               (.getLocationDiag this location site)]))
                (.create diags
                         dkind
                         (.currentSource log)
                         pos
                         errKey
                         (new Object/1 [kindname idname typeargtypes (.args this argtypes)])))))))

    (method ^:private args [this ^{:tag (List Type)} args]
      (if (.isEmpty args) ^Object args (.methodArguments Resolve/this args)))

    (method ^:private getErrorKey ^String [this ^Kinds$KindName kindname ^boolean hasTypeArgs
                                           ^boolean hasLocation]
      (let [key "cant.resolve"
            ^:mutable ^String suffix (if hasLocation ".location" "")]
        (switch kindname
          (METHOD CONSTRUCTOR)
            (do
              (set! suffix (java-str suffix ".args"))
              (set! suffix (java-str suffix (if hasTypeArgs ".params" "")))))
        (java-str key suffix)))

    (method ^:private getLocationDiag ^JCDiagnostic [this ^Symbol location ^Type site]
      (if (identical? (.-kind location) Kinds$Kind/VAR)
          (.fragment diags
                     (CompilerProperties$Fragments/Location1
                       (Kinds/kindName location)
                       location
                       (.-type location)))
          (.fragment diags
                     (CompilerProperties$Fragments/Location (Kinds/typeKindName site) site nil)))))

  (defclass InapplicableSymbolError
    :extends ResolveError

    (field ^:protected ^MethodResolutionContext resolveContext)

    (constructor [this ^MethodResolutionContext context]
      (this. Kinds$Kind/WRONG_MTH "inapplicable symbol error" context))

    (constructor ^:protected [this ^Kinds$Kind kind ^String debugName
                              ^MethodResolutionContext context]
      (super. kind debugName)
      (set! (.-resolveContext this) context))

    (method ^:public toString ^String [this] (.toString super))

    (method ^:public exists ^boolean [this] true)

    (method getDiagnostic ^JCDiagnostic [this ^JCDiagnostic$DiagnosticType dkind
                                         ^JCDiagnostic$DiagnosticPosition pos ^Symbol location
                                         ^Type site ^Name name ^{:tag (List Type)} argtypes
                                         ^{:tag (List Type)} typeargtypes]
      (when-not (identical? name (.-error names))
        (let [^{:tag (Pair Symbol JCDiagnostic)} c (.errCandidate this)
              ws (.asMemberOf (cast Symbol (.-fst c)) site types)
              ^{:tag (UnaryOperator JCDiagnostic)} rewriter (when compactMethodDiags
                                                              (lambda UnaryOperator ^JCDiagnostic [^JCDiagnostic d]
                                                                (MethodResolutionDiagHelper/rewrite
                                                                  diags
                                                                  pos
                                                                  (.currentSource log)
                                                                  dkind
                                                                  (cast JCDiagnostic (.-snd c)))))]
          (switch (.getCode (cast JCDiagnostic (.-snd c)))
            ("compiler.misc.wrong.number.type.args"
              "compiler.misc.explicit.param.do.not.conform.to.bounds")
              (.create diags
                       dkind
                       (.currentSource log)
                       pos
                       "cant.apply.symbol.noargs"
                       rewriter
                       (new Object/1
                            [(Kinds/kindName ws)
                             (if (identical? (.-name ws) (.-init names))
                                 ^Object (.-name (.-owner ws))
                                 ^Object (.-name ws))
                             (Kinds/kindName (.-owner ws))
                             (.-type (.-owner ws))
                             (.-snd c)]))
            (if (and (identical? (.-owner ws) (.-arrayClass syms))
                     (identical? (.-name ws) (.-init names)))
                (.create diags
                         dkind
                         (.currentSource log)
                         pos
                         "cant.apply.array.ctor"
                         rewriter
                         (new Object/1
                              [(.methodArguments Resolve/this (.getParameterTypes (.-type ws)))
                               (.methodArguments Resolve/this argtypes)
                               (.-snd c)]))
                (.create diags
                         dkind
                         (.currentSource log)
                         pos
                         "cant.apply.symbol"
                         rewriter
                         (new Object/1
                              [(Kinds/kindName ws)
                               (if (identical? (.-name ws) (.-init names))
                                   ^Object (.-name (.-owner ws))
                                   ^Object (.-name ws))
                               (.methodArguments Resolve/this (.getParameterTypes (.-type ws)))
                               (.methodArguments Resolve/this argtypes)
                               (Kinds/kindName (.-owner ws))
                               (.-type (.-owner ws))
                               (.-snd c)])))))))

    (method ^:public access ^Symbol [this ^Name name ^Symbol$TypeSymbol location]
      (let [^{:tag (Pair Symbol JCDiagnostic)} cand (.errCandidate this)
            errSymbol (.-tsym (.createErrorType types
                                                name
                                                location
                                                ^Type (if (some? cand)
                                                          (.-type (cast Symbol (.-fst cand)))
                                                          (.-type (.-errSymbol syms)))))]
        (when (some? cand)
          (.wrongMethodSymbolCandidate attrRecover
                                       errSymbol
                                       (cast Symbol (.-fst cand))
                                       (cast JCDiagnostic (.-snd cand))))
        errSymbol))

    (method ^:protected errCandidate ^{:tag (Pair Symbol JCDiagnostic)} [this]
      (let [^:mutable ^Resolve$MethodResolutionContext$Candidate bestSoFar nil]
        (for-each [^Resolve$MethodResolutionContext$Candidate c (.-candidates resolveContext)]
          (when-not (.isApplicable c) (set! bestSoFar c)))
        (Assert/checkNonNull bestSoFar)
        (Pair. (.-sym bestSoFar) (.-details bestSoFar)))))

  (defclass InapplicableSymbolsError
    :extends InapplicableSymbolError

    (constructor [this ^MethodResolutionContext context]
      (super. Kinds$Kind/WRONG_MTHS "inapplicable symbols" context))

    (method getDiagnostic ^JCDiagnostic [this ^JCDiagnostic$DiagnosticType dkind
                                         ^JCDiagnostic$DiagnosticPosition pos ^Symbol location
                                         ^Type site ^Name name ^{:tag (List Type)} argtypes
                                         ^{:tag (List Type)} typeargtypes]
      (let [^{:tag (Map Symbol JCDiagnostic)} candidatesMap (.mapCandidates this)
            ^:mutable ^{:tag (Map Symbol JCDiagnostic)} filteredCandidates (if compactMethodDiags
                                                                               (.filterCandidates
                                                                                 this
                                                                                 candidatesMap)
                                                                               (.mapCandidates this))]
        (when (.isEmpty filteredCandidates) (set! filteredCandidates candidatesMap))
        (let [truncatedDiag (not (== (.size candidatesMap) (.size filteredCandidates)))]
          (cond
            (> (.size filteredCandidates) 1)
              (let [err (.create diags
                                 dkind
                                 nil
                                 ^Set (if truncatedDiag
                                          ^Set (EnumSet/of JCDiagnostic$DiagnosticFlag/COMPRESSED)
                                          ^Set (EnumSet/noneOf JCDiagnostic$DiagnosticFlag))
                                 (.currentSource log)
                                 pos
                                 "cant.apply.symbols"
                                 (new Object/1
                                      [(if (identical? name (.-init names))
                                           Kinds$KindName/CONSTRUCTOR
                                           ^Object (.absentKind (.-kind this)))
                                       (if (identical? name (.-init names))
                                           ^Object (.-name (.-tsym site))
                                           ^Object name)
                                       (.methodArguments Resolve/this argtypes)]))]
                (JCDiagnostic$MultilineDiagnostic.
                  err
                  (.candidateDetails this filteredCandidates site)))
            (== (.size filteredCandidates) 1)
              (let [^{:tag (Map$Entry Symbol JCDiagnostic)} _e (cast
                                                                 Map$Entry
                                                                 (.next
                                                                   (.iterator
                                                                     (.entrySet filteredCandidates))))
                    ^{:tag (Pair Symbol JCDiagnostic)} p (Pair.
                                                           (cast Symbol (.getKey _e))
                                                           (cast JCDiagnostic (.getValue _e)))
                    d (.getDiagnostic
                        (anon InapplicableSymbolError [(.-resolveContext this)]
                          (method ^:protected errCandidate ^{:tag (Pair Symbol JCDiagnostic)} [this]
                            p))
                        dkind
                        pos
                        location
                        site
                        name
                        argtypes
                        typeargtypes)]
                (when truncatedDiag (.setFlag d JCDiagnostic$DiagnosticFlag/COMPRESSED))
                d)
            :else
              (.getDiagnostic (SymbolNotFoundError. Kinds$Kind/ABSENT_MTH)
                              dkind
                              pos
                              location
                              site
                              name
                              argtypes
                              typeargtypes)))))

    (method ^:private mapCandidates ^{:tag (Map Symbol JCDiagnostic)} [this]
      (let [candidates (MostSpecificMap.)]
        (for-each [^Resolve$MethodResolutionContext$Candidate c (.-candidates
                                                                  (.-resolveContext this))]
          (when-not (.isApplicable c) (.put candidates c)))
        candidates))

    (defclass ^:private MostSpecificMap
      :extends (LinkedHashMap Symbol JCDiagnostic)

      (method ^:private put ^void [this ^Resolve$MethodResolutionContext$Candidate c]
        (let [^{:tag (ListBuffer Symbol)} overridden (ListBuffer.)]
          (for-each [^Symbol s (.keySet this)]
            (when-not (identical? s (.-sym c))
              (cond
                (.overrides (.-sym c) s (cast Symbol$TypeSymbol (.-owner s)) types false)
                  (.add overridden s)
                (.overrides s (.-sym c) (cast Symbol$TypeSymbol (.-owner (.-sym c))) types false)
                  (return))))
          (for-each [^Symbol s overridden] (.remove this s))
          (.put this (.-sym c) (.-details c)))))

    (method filterCandidates ^{:tag (Map Symbol JCDiagnostic)} [this
                                                                ^{:tag (Map Symbol JCDiagnostic)} candidatesMap]
      (let [^{:tag (Map Symbol JCDiagnostic)} candidates (LinkedHashMap.)]
        (for-each [^{:tag (Map$Entry Symbol JCDiagnostic)} _entry (.entrySet candidatesMap)]
          (let [d (cast JCDiagnostic (.getValue _entry))]
            (when-not (.matches (Resolve$MethodResolutionDiagHelper$Template.
                                  (.regex MethodCheckDiag/ARITY_MISMATCH))
                                d)
              (.put candidates (cast Symbol (.getKey _entry)) d))))
        candidates))

    (method ^:private candidateDetails ^{:tag (List JCDiagnostic)} [this
                                                                    ^{:tag (Map Symbol JCDiagnostic)} candidatesMap
                                                                    ^Type site]
      (let [^:mutable ^{:tag (List JCDiagnostic)} details (List/nil)]
        (for-each [^{:tag (Map$Entry Symbol JCDiagnostic)} _entry (.entrySet candidatesMap)]
          (let [sym (cast Symbol (.getKey _entry))
                detailDiag (.fragment diags
                                      (CompilerProperties$Fragments/InapplicableMethod
                                        (Kinds/kindName sym)
                                        (.location sym site types)
                                        (.asMemberOf sym site types)
                                        (cast JCDiagnostic (.getValue _entry))))]
            (set! details (.prepend details detailDiag))))
        details))

    (method ^:protected errCandidate ^{:tag (Pair Symbol JCDiagnostic)} [this]
      (let [^{:tag (Map Symbol JCDiagnostic)} candidatesMap (.mapCandidates this)
            ^{:tag (Map Symbol JCDiagnostic)} filteredCandidates (.filterCandidates
                                                                   this
                                                                   candidatesMap)]
        (when (== (.size filteredCandidates) 1)
          (Pair/of (cast Symbol (.next (.iterator (.keySet filteredCandidates))))
                   (cast JCDiagnostic (.next (.iterator (.values filteredCandidates)))))))))

  (defclass DiamondError
    :extends InapplicableSymbolError

    (field ^Symbol sym)

    (constructor ^:public [this ^Symbol sym ^MethodResolutionContext context]
      (super. (.-kind sym) "diamondError" context)
      (set! (.-sym this) sym))

    (method getDetails ^JCDiagnostic [this]
      (when (identical? (.-kind sym) Kinds$Kind/WRONG_MTH)
        (cast JCDiagnostic (.-snd (.errCandidate (cast InapplicableSymbolError (.baseSymbol sym)))))))

    (method getDiagnostic ^JCDiagnostic [this ^JCDiagnostic$DiagnosticType dkind
                                         ^JCDiagnostic$DiagnosticPosition pos ^Symbol location
                                         ^Type site ^Name name ^{:tag (List Type)} argtypes
                                         ^{:tag (List Type)} typeargtypes]
      (let [details (.getDetails this)]
        (when (and (some? details) compactMethodDiags)
          (let [simpleDiag (MethodResolutionDiagHelper/rewrite
                             diags
                             pos
                             (.currentSource log)
                             dkind
                             details)]
            (when (some? simpleDiag) (return simpleDiag))))
        (let [^String key (if (nil? details) "cant.apply.diamond" "cant.apply.diamond.1")]
          (.create diags
                   dkind
                   (.currentSource log)
                   pos
                   key
                   (new Object/1 [(CompilerProperties$Fragments/Diamond (.-tsym site)) details]))))))

  (defclass AccessError
    :extends InvalidSymbolError

    (field ^:private ^{:tag (Env AttrContext)} env)

    (field ^:private ^Type site)

    (constructor [this ^{:tag (Env AttrContext)} env ^Type site ^Symbol sym]
      (super. Kinds$Kind/HIDDEN sym "access error")
      (set! (.-env this) env)
      (set! (.-site this) site))

    (method ^:public exists ^boolean [this] false)

    (method getDiagnostic ^JCDiagnostic [this ^JCDiagnostic$DiagnosticType dkind
                                         ^JCDiagnostic$DiagnosticPosition pos ^Symbol location
                                         ^Type site ^Name name ^{:tag (List Type)} argtypes
                                         ^{:tag (List Type)} typeargtypes]
      (cond
        (and (identical? (.-name (.-sym this)) (.-init names))
             (not (identical? (.-owner (.-sym this)) (.-tsym site))))
          (.getDiagnostic (SymbolNotFoundError. Kinds$Kind/ABSENT_MTH)
                          dkind
                          pos
                          location
                          site
                          name
                          argtypes
                          typeargtypes)
        (or (not (== (bit-and (.flags (.-sym this)) Flags/PUBLIC) 0))
            (and (and (some? env) (some? (.-site this)))
                 (not (.isAccessible Resolve/this env (.-site this)))))
          (cond
            (identical? (.-kind (.-owner (.-sym this))) Kinds$Kind/PCK)
              (.create diags
                       dkind
                       (.currentSource log)
                       pos
                       "not.def.access.package.cant.access"
                       (new Object/1
                            [(.-sym this)
                             (.location (.-sym this))
                             (.inaccessiblePackageReason Resolve/this env (.packge (.-sym this)))]))
            (and (not (identical? (.packge (.-sym this)) (.-rootPackage syms)))
                 (not (.symbolPackageVisible Resolve/this env (.-sym this))))
              (.create diags
                       dkind
                       (.currentSource log)
                       pos
                       "not.def.access.class.intf.cant.access.reason"
                       (new Object/1
                            [(.-sym this)
                             (.location (.-sym this))
                             (.packge (.location (.-sym this)))
                             (.inaccessiblePackageReason Resolve/this env (.packge (.-sym this)))]))
            :else
              (.create diags
                       dkind
                       (.currentSource log)
                       pos
                       "not.def.access.class.intf.cant.access"
                       (new Object/1 [(.-sym this) (.location (.-sym this))])))
        (not (== (bit-and (.flags (.-sym this)) (bit-or-int Flags/PRIVATE Flags/PROTECTED)) 0))
          (.create diags
                   dkind
                   (.currentSource log)
                   pos
                   "report.access"
                   (new Object/1
                        [(.-sym this)
                         (Flags/asFlagSet
                           (bit-and (.flags (.-sym this))
                                    (bit-or-int Flags/PRIVATE Flags/PROTECTED)))
                         (.location (.-sym this))]))
        :else
          (.create diags
                   dkind
                   (.currentSource log)
                   pos
                   "not.def.public.cant.access"
                   (new Object/1 [(.-sym this) (.location (.-sym this))]))))

    (method ^:private toString ^String [this ^Type type]
      (let [sb (StringBuilder.)]
        (.append sb type)
        (when (some? type)
          (.append (.append sb "[tsym:") (.-tsym type))
          (when (some? (.-tsym type)) (.append (.append sb "packge:") (.packge (.-tsym type))))
          (.append sb "]"))
        (.toString sb))))

  (defclass InvisibleSymbolError
    :extends InvalidSymbolError

    (field ^:private ^:final ^{:tag (Env AttrContext)} env)

    (field ^:private ^:final ^boolean suppressError)

    (constructor [this ^{:tag (Env AttrContext)} env ^boolean suppressError ^Symbol sym]
      (super. Kinds$Kind/HIDDEN sym "invisible class error")
      (set! (.-env this) env)
      (set! (.-suppressError this) suppressError)
      (set! (.-name this) (.-name sym)))

    (method getDiagnostic ^JCDiagnostic [this ^JCDiagnostic$DiagnosticType dkind
                                         ^:mutable ^JCDiagnostic$DiagnosticPosition pos
                                         ^Symbol location ^Type site ^Name name
                                         ^{:tag (List Type)} argtypes
                                         ^{:tag (List Type)} typeargtypes]
      (when-not suppressError
        (if (identical? (.-kind (.-sym this)) Kinds$Kind/PCK)
            (let [details (.inaccessiblePackageReason Resolve/this env (.packge (.-sym this)))]
              (.create diags
                       dkind
                       (.currentSource log)
                       pos
                       "package.not.visible"
                       (new Object/1 [(.-sym this) details])))
            (let [details (.inaccessiblePackageReason Resolve/this env (.packge (.-sym this)))]
              (when (some? (.getTree pos))
                (let [^:mutable o (.-sym this)
                      ^:mutable tree (.getTree pos)]
                  (while (and (not (identical? (.-kind o) Kinds$Kind/PCK))
                              (.hasTag tree JCTree$Tag/SELECT))
                    (set! o (.-owner o))
                    (set! tree (.-selected (cast JCTree$JCFieldAccess tree))))
                  (when (identical? (.-kind o) Kinds$Kind/PCK)
                    (set! pos (.pos tree))
                    (return (.create diags
                                     dkind
                                     (.currentSource log)
                                     pos
                                     "package.not.visible"
                                     (new Object/1 [o details]))))))
              (.create diags
                       dkind
                       (.currentSource log)
                       pos
                       "not.def.access.package.cant.access"
                       (new Object/1 [(.-sym this) (.packge (.-sym this)) details])))))))

  (method inaccessiblePackageReason ^JCDiagnostic [this ^{:tag (Env AttrContext)} env
                                                   ^Symbol$PackageSymbol sym]
    (cond
      (not (.contains (.-readModules (.-modle (.-toplevel env))) (.-modle sym)))
        (if (not (identical? (.-modle sym) (.-unnamedModule syms)))
            (if (not (identical? (.-modle (.-toplevel env)) (.-unnamedModule syms)))
                (.fragment diags
                           (CompilerProperties$Fragments/NotDefAccessDoesNotRead
                             (.-modle (.-toplevel env))
                             sym
                             (.-modle sym)))
                (.fragment diags
                           (CompilerProperties$Fragments/NotDefAccessDoesNotReadFromUnnamed
                             sym
                             (.-modle sym))))
            (.fragment diags
                       (CompilerProperties$Fragments/NotDefAccessDoesNotReadUnnamed
                         sym
                         (.-modle (.-toplevel env)))))
      (.anyMatch (.stream (.-exports (.-modle (.packge sym))))
                 (lambda Predicate ^boolean [^Directive$ExportsDirective e]
                   (identical? (.-packge e) sym)))
        (if (not (identical? (.-modle (.-toplevel env)) (.-unnamedModule syms)))
            (.fragment diags
                       (CompilerProperties$Fragments/NotDefAccessNotExportedToModule
                         sym
                         (.-modle sym)
                         (.-modle (.-toplevel env))))
            (.fragment diags
                       (CompilerProperties$Fragments/NotDefAccessNotExportedToModuleFromUnnamed
                         sym
                         (.-modle sym))))
      (not (identical? (.-modle (.-toplevel env)) (.-unnamedModule syms)))
        (.fragment diags (CompilerProperties$Fragments/NotDefAccessNotExported sym (.-modle sym)))
      :else
        (.fragment diags
                   (CompilerProperties$Fragments/NotDefAccessNotExportedFromUnnamed
                     sym
                     (.-modle sym)))))

  (defclass StaticError
    :extends InvalidSymbolError

    (constructor [this ^Symbol sym] (this. sym "static error"))

    (constructor [this ^Symbol sym ^String debugName]
      (super. Kinds$Kind/STATICERR sym debugName))

    (method getDiagnostic ^JCDiagnostic [this ^JCDiagnostic$DiagnosticType dkind
                                         ^JCDiagnostic$DiagnosticPosition pos ^Symbol location
                                         ^Type site ^Name name ^{:tag (List Type)} argtypes
                                         ^{:tag (List Type)} typeargtypes]
      (let [^Symbol errSym (if (and (identical? (.-kind (.-sym this)) Kinds$Kind/TYP)
                                    (.hasTag (.-type (.-sym this)) TypeTag/CLASS))
                               ^Symbol (.-tsym (.erasure types (.-type (.-sym this))))
                               (.-sym this))]
        (.create diags
                 dkind
                 (.currentSource log)
                 pos
                 "non-static.cant.be.ref"
                 (new Object/1 [(Kinds/kindName (.-sym this)) errSym])))))

  (defclass BadLocalClassCreation
    :extends StaticError

    (constructor [this ^Symbol sym] (super. sym "bad local class creation"))

    (method getDiagnostic ^JCDiagnostic [this ^JCDiagnostic$DiagnosticType dkind
                                         ^JCDiagnostic$DiagnosticPosition pos ^Symbol location
                                         ^Type site ^Name name ^{:tag (List Type)} argtypes
                                         ^{:tag (List Type)} typeargtypes]
      (.create diags
               dkind
               (.currentSource log)
               pos
               "local.cant.be.inst.static"
               (new Object/1 [(Kinds/kindName (.-sym this)) (.-sym this)]))))

  (defclass RefBeforeCtorCalledError
    :extends StaticError

    (constructor [this ^Symbol sym] (super. sym "prologue error"))

    (method getDiagnostic ^JCDiagnostic [this ^JCDiagnostic$DiagnosticType dkind
                                         ^JCDiagnostic$DiagnosticPosition pos ^Symbol location
                                         ^Type site ^Name name ^{:tag (List Type)} argtypes
                                         ^{:tag (List Type)} typeargtypes]
      (let [^Symbol errSym (if (and (identical? (.-kind (.-sym this)) Kinds$Kind/TYP)
                                    (.hasTag (.-type (.-sym this)) TypeTag/CLASS))
                               ^Symbol (.-tsym (.erasure types (.-type (.-sym this))))
                               (.-sym this))]
        (.create diags
                 dkind
                 (.currentSource log)
                 pos
                 "cant.ref.before.ctor.called"
                 (new Object/1 [errSym])))))

  (defclass AmbiguityError
    :extends ResolveError

    (field ^{:tag (List Symbol)} ambiguousSyms (List/nil))

    (method ^:public exists ^boolean [this] true)

    (constructor [this ^Symbol sym1 ^Symbol sym2]
      (super. Kinds$Kind/AMBIGUOUS "ambiguity error")
      (set! ambiguousSyms (.appendList (.flatten this sym2) (.flatten this sym1))))

    (method ^:private flatten ^{:tag (List Symbol)} [this ^Symbol sym]
      (if (identical? (.-kind sym) Kinds$Kind/AMBIGUOUS)
          (.-ambiguousSyms (cast AmbiguityError (.baseSymbol sym)))
          (List/of sym)))

    (method addAmbiguousSymbol ^AmbiguityError [this ^Symbol s]
      (set! ambiguousSyms (.prepend ambiguousSyms s))
      this)

    (method getDiagnostic ^JCDiagnostic [this ^JCDiagnostic$DiagnosticType dkind
                                         ^JCDiagnostic$DiagnosticPosition pos ^Symbol location
                                         ^Type site ^Name name ^{:tag (List Type)} argtypes
                                         ^{:tag (List Type)} typeargtypes]
      (let [^{:tag (List Symbol)} diagSyms (.reverse ambiguousSyms)
            s1 (cast Symbol (.-head diagSyms))
            s2 (cast Symbol (.-head (.-tail diagSyms)))
            ^:mutable sname (.-name s1)]
        (when (identical? sname (.-init names)) (set! sname (.-name (.-owner s1))))
        (.create diags
                 dkind
                 (.currentSource log)
                 pos
                 "ref.ambiguous"
                 (new Object/1
                      [sname
                       (Kinds/kindName s1)
                       s1
                       (.location s1 site types)
                       (Kinds/kindName s2)
                       s2
                       (.location s2 site types)]))))

    (method mergeAbstracts ^Symbol [this ^Type site]
      (let [^{:tag (List Symbol)} ambiguousInOrder (.reverse ambiguousSyms)]
        (cast Symbol (.orElse (.mergeAbstracts types ambiguousInOrder site true) this))))

    (method ^:protected access ^Symbol [this ^Name name ^Symbol$TypeSymbol location]
      (let [firstAmbiguity (cast Symbol (.last ambiguousSyms))]
        (if (identical? (.-kind firstAmbiguity) Kinds$Kind/TYP)
            ^Symbol (.-tsym (.createErrorType types name location (.-type firstAmbiguity)))
            firstAmbiguity))))

  (defclass BadVarargsMethod
    :extends ResolveError

    (field ^ResolveError delegatedError)

    (constructor [this ^ResolveError delegatedError]
      (super. (.-kind delegatedError) "badVarargs")
      (set! (.-delegatedError this) delegatedError))

    (method ^:public baseSymbol ^Symbol [this] (.baseSymbol delegatedError))

    (method ^:protected access ^Symbol [this ^Name name ^Symbol$TypeSymbol location]
      (.access delegatedError name location))

    (method ^:public exists ^boolean [this] true)

    (method getDiagnostic ^JCDiagnostic [this ^JCDiagnostic$DiagnosticType dkind
                                         ^JCDiagnostic$DiagnosticPosition pos ^Symbol location
                                         ^Type site ^Name name ^{:tag (List Type)} argtypes
                                         ^{:tag (List Type)} typeargtypes]
      (.getDiagnostic delegatedError dkind pos location site name argtypes typeargtypes)))

  (defclass BadMethodReferenceError
    :extends StaticError

    (field ^boolean unboundLookup)

    (constructor ^:public [this ^Symbol sym ^boolean unboundLookup]
      (super. sym "bad method ref error")
      (set! (.-unboundLookup this) unboundLookup))

    (method getDiagnostic ^JCDiagnostic [this ^JCDiagnostic$DiagnosticType dkind
                                         ^JCDiagnostic$DiagnosticPosition pos ^Symbol location
                                         ^Type site ^Name name ^{:tag (List Type)} argtypes
                                         ^{:tag (List Type)} typeargtypes]
      (let [^String key (cond
                          (not unboundLookup) "bad.static.method.in.bound.lookup"
                          (.isStatic (.-sym this)) "bad.static.method.in.unbound.lookup"
                          :else "bad.instance.method.in.unbound.lookup")]
        (if (.isResolutionError (.-kind (.-sym this)))
            (.getDiagnostic (cast ResolveError (.-sym this))
                            dkind
                            pos
                            location
                            site
                            name
                            argtypes
                            typeargtypes)
            (.create diags
                     dkind
                     (.currentSource log)
                     pos
                     key
                     (new Object/1 [(Kinds/kindName (.-sym this)) (.-sym this)]))))))

  (defclass BadClassFileError
    :extends InvalidSymbolError

    (field ^:private ^:final ^Symbol$CompletionFailure ex)

    (constructor ^:public [this ^Symbol$CompletionFailure ex]
      (super. Kinds$Kind/HIDDEN (.-sym ex) "BadClassFileError")
      (set! (.-name this) (.-name (.-sym this)))
      (set! (.-ex this) ex))

    (method getDiagnostic ^JCDiagnostic [this ^JCDiagnostic$DiagnosticType dkind
                                         ^JCDiagnostic$DiagnosticPosition pos ^Symbol location
                                         ^Type site ^Name name ^{:tag (List Type)} argtypes
                                         ^{:tag (List Type)} typeargtypes]
      (let [d (.create diags
                       dkind
                       (.currentSource log)
                       pos
                       "cant.access"
                       (new Object/1 [(.-sym ex) (.getDetailValue ex)]))]
        (.setFlag d JCDiagnostic$DiagnosticFlag/NON_DEFERRABLE)
        d)))

  (defclass ^:static MethodResolutionDiagHelper
    (defclass ^:interface DiagnosticRewriter
      (method rewriteDiagnostic ^JCDiagnostic [this ^JCDiagnostic$Factory diags
                                               ^JCDiagnostic$DiagnosticPosition preferredPos
                                               ^DiagnosticSource preferredSource
                                               ^JCDiagnostic$DiagnosticType preferredKind
                                               ^JCDiagnostic d]))

    (defclass ^:static Template
      (field ^String regex)

      (field ^Template/1 subTemplates)

      (constructor [this ^String key & ^Template/1 subTemplates]
        (set! (.-regex this) key)
        (set! (.-subTemplates this) subTemplates))

      (method matches ^boolean [this o]
        (let [d (cast JCDiagnostic o)
              args (.getArgs d)]
          (if (or (not (.matches (.getCode d) regex))
                  (not (== (alength subTemplates) (alength (.getArgs d)))))
              false
              (do
                (loop [^int i 0]
                  (if (< i (alength args))
                      (if (not (.matches (aget subTemplates i) (aget args i)))
                          (return false)
                          (recur (unchecked-inc-int i)))
                      nil))
                true)))))

    (defclass ^:static ArgMismatchRewriter
      :implements [DiagnosticRewriter]

      (field ^int causeIndex)

      (constructor ^:public [this ^int causeIndex]
        (set! (.-causeIndex this) causeIndex))

      (method ^:public rewriteDiagnostic ^JCDiagnostic [this ^JCDiagnostic$Factory diags
                                                        ^JCDiagnostic$DiagnosticPosition preferredPos
                                                        ^DiagnosticSource preferredSource
                                                        ^JCDiagnostic$DiagnosticType preferredKind
                                                        ^JCDiagnostic d]
        (let [cause (cast JCDiagnostic (aget (.getArgs d) causeIndex))
              ^:mutable pos (.getDiagnosticPosition d)]
          (when (nil? pos) (set! pos preferredPos))
          (.create diags preferredKind preferredSource pos "prob.found.req" (new Object/1 [cause])))))

    (field ^:static ^:final ^Template skip
      (anon Template [""] (method matches ^boolean [this d] true)))

    (field ^:static ^:final ^Template argMismatchTemplate
      (Template. (.regex MethodCheckDiag/ARG_MISMATCH) skip))

    (field ^:static ^:final ^Template inferArgMismatchTemplate
      (anon Template [(.regex MethodCheckDiag/ARG_MISMATCH) skip skip]
        (method matches ^boolean [this o]
          (if (not (.matches super o))
              false
              (let [d (cast JCDiagnostic o)
                    ^{:tag (List Type)} tvars (cast List (aget (.getArgs d) 0))]
                (not (.containsAny this d tvars)))))

        (field ^{:tag (BiPredicate Object (List Type))} containsPredicate
          (lambda BiPredicate ^boolean [o ^List ts]
            (if-instance [^Type type o]
              (.containsAny type ts)
              (if-instance [^JCDiagnostic diagnostic o] (.containsAny this diagnostic ts) false))))

        (method containsAny ^boolean [this ^JCDiagnostic d ^{:tag (List Type)} ts]
          (.anyMatch (Stream/of (.getArgs d))
                     (lambda Predicate ^boolean [o] (.test containsPredicate o ts))))))

    (field ^:static ^:final ^{:tag (Map Template DiagnosticRewriter)} rewriters (LinkedHashMap.))

    (static-initializer
      (.put rewriters argMismatchTemplate (ArgMismatchRewriter. 0))
      (.put rewriters inferArgMismatchTemplate (ArgMismatchRewriter. 1)))

    (method ^:static rewrite ^JCDiagnostic [^JCDiagnostic$Factory diags
                                            ^JCDiagnostic$DiagnosticPosition pos
                                            ^DiagnosticSource source
                                            ^JCDiagnostic$DiagnosticType dkind ^JCDiagnostic d]
      (for-each [^{:tag (Map$Entry Template DiagnosticRewriter)} _entry (.entrySet rewriters)]
        (when (.matches (cast Template (.getKey _entry)) d)
          (let [simpleDiag (.rewriteDiagnostic (cast DiagnosticRewriter (.getValue _entry))
                                               diags
                                               pos
                                               source
                                               dkind
                                               d)]
            (.setFlag simpleDiag JCDiagnostic$DiagnosticFlag/COMPRESSED)
            (return simpleDiag))))
      nil))

  (defclass ^:enum MethodResolutionPhase
    (constants
      (BASIC [false false])
      (BOX [true false])
      (VARARITY [true true]
                (method ^:public mergeResults ^Symbol [this ^Symbol bestSoFar ^Symbol sym]
                  (Assert/check (and (.isResolutionError (.-kind bestSoFar))
                                     (not (identical? (.-kind bestSoFar) Kinds$Kind/AMBIGUOUS))))
                  (if (not (.isResolutionError (.-kind sym)))
                      sym
                      (switch (.-kind bestSoFar)
                        (WRONG_MTH WRONG_MTHS)
                          (switch (.-kind sym)
                            WRONG_MTH
                              (if (identical? (.-kind bestSoFar) Kinds$Kind/WRONG_MTHS)
                                  bestSoFar
                                  sym)
                            ABSENT_MTH bestSoFar
                            sym)
                        bestSoFar)))))

    (field ^:final ^boolean isBoxingRequired)

    (field ^:final ^boolean isVarargsRequired)

    (constructor [this ^boolean isBoxingRequired ^boolean isVarargsRequired]
      (set! (.-isBoxingRequired this) isBoxingRequired)
      (set! (.-isVarargsRequired this) isVarargsRequired))

    (method ^:public isBoxingRequired ^boolean [this] isBoxingRequired)

    (method ^:public isVarargsRequired ^boolean [this] isVarargsRequired)

    (method ^:public mergeResults ^Symbol [this ^Symbol prev ^Symbol sym]
      sym))

  (field ^:final ^{:tag (List MethodResolutionPhase)} methodResolutionSteps
    (List/of MethodResolutionPhase/BASIC MethodResolutionPhase/BOX MethodResolutionPhase/VARARITY))

  (defclass MethodResolutionContext
    (field ^:private ^{:tag (List Candidate)} candidates (List/nil))

    (field ^MethodResolutionPhase step nil)

    (field ^MethodCheck methodCheck resolveMethodCheck)

    (field ^:private ^boolean internalResolution false)

    (field ^:private ^DeferredAttr$AttrMode attrMode DeferredAttr$AttrMode/SPECULATIVE)

    (method addInapplicableCandidate ^void [this ^Symbol sym ^JCDiagnostic details]
      (let [c (Candidate. (.-step currentResolutionContext) sym details nil)]
        (set! candidates (.append candidates c))))

    (method addApplicableCandidate ^void [this ^Symbol sym ^Type mtype]
      (let [c (Candidate. (.-step currentResolutionContext) sym nil mtype)]
        (set! candidates (.append candidates c))))

    (method deferredAttrContext ^DeferredAttr$DeferredAttrContext [this ^Symbol sym
                                                                   ^InferenceContext inferenceContext
                                                                   ^Attr$ResultInfo pendingResult
                                                                   ^Warner warn]
      (let [^DeferredAttr$DeferredAttrContext parent (if (nil? pendingResult)
                                                         (.-emptyDeferredAttrContext deferredAttr)
                                                         (.deferredAttrContext
                                                           (.-checkContext pendingResult)))]
        (.new deferredAttr
              DeferredAttr$DeferredAttrContext
              attrMode
              sym
              step
              inferenceContext
              parent
              warn)))

    (defclass Candidate
      (field ^:final ^MethodResolutionPhase step)

      (field ^:final ^Symbol sym)

      (field ^:final ^JCDiagnostic details)

      (field ^:final ^Type mtype)

      (constructor ^:private [this ^MethodResolutionPhase step ^Symbol sym ^JCDiagnostic details
                              ^Type mtype]
        (set! (.-step this) step)
        (set! (.-sym this) sym)
        (set! (.-details this) details)
        (set! (.-mtype this) mtype))

      (method isApplicable ^boolean [this] (some? mtype)))

    (method attrMode ^DeferredAttr$AttrMode [this] attrMode)

    (method internal ^boolean [this] internalResolution))

  (field ^MethodResolutionContext currentResolutionContext nil))

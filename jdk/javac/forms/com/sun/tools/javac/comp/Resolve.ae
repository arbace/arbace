              (let [^Symbol location (.-sym (.-enclClass env))]
                (.reportMC this
                           (.-tree env)
                           MethodCheckDiag/INACCESSIBLE_VARARGS
                           inferenceContext
                           t
                           (Kinds/kindName location)
                           location)))))

      (method ^:private methodCheckResult ^Attr$ResultInfo [this1 ^:final ^boolean varargsCheck
                                                            ^Type to
                                                            ^:final ^DeferredAttr$DeferredAttrContext deferredAttrContext
                                                            ^Warner rsWarner]

            (do
              (when (.contains s "all") (set! res (EnumSet/allOf VerboseResolutionMode)))
              (let [^{:tag (Collection String)} args (Arrays/asList (.split s ","))]
                (for-each [^VerboseResolutionMode mode (VerboseResolutionMode/values)]
                  (cond
                    (.contains args (.-opt mode)) (.add res mode)
                    (.contains args (java-str "-" (.-opt mode))) (.remove res mode)))
                res))))))

  (method reportVerboseResolutionDiagnostic ^void [this ^JCDiagnostic$DiagnosticPosition dpos
                                                   ^Name name ^Type site

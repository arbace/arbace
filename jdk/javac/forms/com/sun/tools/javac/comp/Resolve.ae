    (anon AbstractMethodCheck []
      (method checkArg ^void [this ^JCDiagnostic$DiagnosticPosition pos ^boolean varargs
                              ^Type actual ^Type formal
                              ^DeferredAttr$DeferredAttrContext deferredAttrContext ^Warner warn]

  (method ^:private notOverriddenIn ^boolean [this ^Type site ^Symbol sym]
    (if (or (or (not (identical? (.-kind sym) Kinds$Kind/MTH)) (.isConstructor sym))
            (.isStatic sym))
        true
        (let [^Symbol s2 (.implementation (cast Symbol$MethodSymbol sym) (.-tsym site) types true)]
          (or
            (or (or (or (nil? s2) (identical? s2 sym)) (identical? (.-owner sym) (.-owner s2)))
                (and (.isInterface (.-owner sym))
                     (identical? (.-owner s2) (.-tsym (.-objectType syms)))))
            (not (.isSubSignature types (.memberType types site s2) (.memberType types site sym)))))))

  (method ^:private isProtectedAccessible ^boolean [this ^Symbol sym ^:mutable ^Symbol$ClassSymbol c
                                                    ^Type site]
    (let [^Type newSite (if (.hasTag site TypeTag/TYPEVAR) (.getUpperBound site) site)]
      (while (and (some? c)
                  (not (and (and (.isSubClass c (.-owner sym) types)
                                 (== (bit-and (.flags c) Flags/INTERFACE) 0))
                            (or (or (not (== (bit-and (.flags sym) Flags/STATIC) 0))
                                    (identical? (.-kind sym) Kinds$Kind/TYP))
                                (.isSubClass (.-tsym newSite) c types)))))
        (set! c (.enclClass (.-owner c))))
      (some? c)))


                     ^InapplicableMethodException (.error
                                                    infer
                                                    (.create
                                                      diags
                                                      JCDiagnostic$DiagnosticType/FRAGMENT
                                                      (.currentSource log)
                                                      pos
                                                      key
                                                      args))
                     ^InapplicableMethodException (.setMessage
                                                    (.getMethodCheckFailure this)
                                                    (.create
                                                      diags
                                                      JCDiagnostic$DiagnosticType/FRAGMENT
                                                      (.currentSource log)
                                                      pos
                                                      key
                                                      args)))))))


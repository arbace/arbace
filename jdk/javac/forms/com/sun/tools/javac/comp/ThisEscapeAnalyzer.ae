                    (.scan this (.-selector tree))
                    (.discardExprs refs depth)
                    (.scan this (.-cases tree)))))

  (method ^:public visitSwitchExpression ^void [this ^JCTree$JCSwitchExpression tree]
    (.visitScoped this
                  true
                  (lambda Runnable ^void []
                    (.scan this (.-selector tree))
                    (.discardExprs refs depth)
                    (let [^{:tag (RefSet ExprRef)} combinedRefs (RefSet/newEmpty)]
                      (loop [^{:tag (List JCTree$JCCase)} cases (.-cases tree)]
                        (when (.nonEmpty cases)
                          (.scan this (.-stats (cast JCTree$JCCase (.-head cases))))
                          (.forEach (.map (.remove refs YieldRef)
                                          (lambda Function ^ExprRef [^YieldRef ref]
                                            (ExprRef. depth ref)))
                                    (method-ref Consumer [ExprRef] combinedRefs RefSet/.add))
                          (.forEach (.removeExprs refs depth)
                                    (method-ref Consumer [ExprRef] combinedRefs RefSet/.add))
                          (recur (.-tail cases))))
                      (.addAll refs combinedRefs)))))

  (method ^:public visitCase ^void [this ^JCTree$JCCase tree]
    (.scan this (.-stats tree)))

  (method ^:public visitYield ^void [this ^JCTree$JCYield tree]
    (.scan this (.-value tree))
    (.replaceExprs refs depth (method-ref Function ^Ref [ExprRef] YieldRef/new)))

  (method ^:public visitLetExpr ^void [this ^JCTree$LetExpr tree]
    (.visitScoped this true (lambda Runnable ^void [] (.visitLetExpr super tree))))

  (method ^:public visitReturn ^void [this ^JCTree$JCReturn tree]
    (.scan this (.-expr tree))
    (.replaceExprs refs depth (method-ref Function ^Ref [ExprRef] ReturnRef/new)))

  (method ^:public visitLambda ^void [this ^JCTree$JCLambda lambda]
    (.visitDeferred this
                    (arbace.core/lambda Runnable
                                        ^void []
                                        (.visitScoped
                                          this
                                          true
                                          (arbace.core/lambda
                                            Runnable
                                            ^void []
                                            (.scan this (.-body lambda)))))))

  (method ^:public visitAssign ^void [this ^JCTree$JCAssign tree]
    (let [sym (cast Symbol$VarSymbol (TreeInfo/symbolFor (.-lhs tree)))]
      (.scan this (.-lhs tree))
      (.discardExprs refs depth)
      (.scan this (.-rhs tree))
      (if (.isParamOrVar this sym)
          (.replaceExprs refs depth (lambda Function ^Ref [^ExprRef ref] (VarRef. sym ref)))
          (.discardExprs refs depth))))

  (method ^:public visitIndexed ^void [this ^JCTree$JCArrayAccess tree]
    (.scan this (.-index tree))
    (.discardExprs refs depth)
    (.scan this (.-indexed tree))
    (.forEach (.flatMap (.map (.removeExprs refs depth)
                              (lambda Function ^Optional [^ExprRef ref]
                                (.toDirect ref (.-tsym (.-type tree)))))
                        (method-ref Function ^Stream [Optional] Optional/.stream))
              (method-ref Consumer [ExprRef] refs RefSet/.add)))

  (method ^:public visitSelect ^void [this ^JCTree$JCFieldAccess tree]
    (.scan this (.-selected tree))
    (let [^{:tag (Stream ExprRef)} methodRefs (.removeExprs refs depth)
          currentClassType (cast Type$ClassType (.-type (.-sym (.-declaringClass currentMethod))))]
      (cond
        (TreeInfo/isExplicitThisReference types currentClassType tree)
          (.forEach (.map (.find refs ThisRef)
                          (lambda Function ^ExprRef [^ThisRef ref] (ExprRef. depth ref)))
                    (method-ref Consumer [ExprRef] refs RefSet/.add))
        (.isExplicitOuterThisReference this types currentClassType tree)
          (.forEach (.flatMap (.map (.find refs ThisRef)
                                    (lambda Function ^Optional [^ThisRef ref]
                                      (.fromOuter ref depth)))
                              (method-ref Function ^Stream [Optional] Optional/.stream))
                    (method-ref Consumer [ExprRef] refs RefSet/.add))
        (and (identical? (.-kind (.-sym tree)) Kinds$Kind/MTH)
             (== (bit-and (.flags (.-sym tree)) Flags/STATIC) 0))
          (.forEach methodRefs (method-ref Consumer [ExprRef] refs RefSet/.add)))))

  (method ^:public visitReference ^void [this ^JCTree$JCMemberReference tree]
    (when-not (.isErroneous (.-type tree))
      (.scan this (.-expr tree))
      (let [^{:tag (RefSet ThisRef)} receiverRefs (RefSet/newEmpty)]
        (switch (.-kind tree)
          (UNBOUND STATIC TOPLEVEL ARRAY_CTOR) (do (.discardExprs refs depth) (return))
          (SUPER BOUND)
            (.forEach (.map (.removeExprs refs depth)
                            (method-ref Function ^ThisRef [ExprRef] ThisRef/new))
                      (method-ref Consumer [ThisRef] receiverRefs RefSet/.add))
          IMPLICIT_INNER
            (.forEach (.receiverRefsForConstructor this nil (.-tsym (.-type (.-expr tree))))
                      (method-ref Consumer [ThisRef] receiverRefs RefSet/.add))
          (throw (RuntimeException. "non-exhaustive?")))
        (.visitDeferred this
                        (lambda Runnable ^void []
                          (.invoke this
                                   tree
                                   (cast Symbol$MethodSymbol (.-sym tree))
                                   (List/nil)
                                   receiverRefs))))))

  (method ^:public visitIdent ^void [this ^JCTree$JCIdent tree]
    (cond
      (or (identical? (.-name tree) (.-_this names)) (identical? (.-name tree) (.-_super names)))
        (.forEach (.map (.find refs ThisRef)
                        (lambda Function ^ExprRef [^ThisRef ref] (ExprRef. depth ref)))
                  (method-ref Consumer [ExprRef] refs RefSet/.add))
      (.isParamOrVar this (.-sym tree))
        (let [sym (cast Symbol$VarSymbol (.-sym tree))]
          (.forEach (.map (.find refs
                                 VarRef
                                 (lambda Predicate ^boolean [^VarRef ref]
                                   (identical? (.-sym ref) sym)))
                          (lambda Function ^ExprRef [^VarRef ref] (ExprRef. depth ref)))
                    (method-ref Consumer [ExprRef] refs RefSet/.add)))
      (and (identical? (.-kind (.-sym tree)) Kinds$Kind/MTH)
           (== (bit-and (.flags (.-sym tree)) Flags/STATIC) 0))
        (let [sym (cast Symbol$MethodSymbol (.-sym tree))
              methodClassSym (.-sym (.-declaringClass currentMethod))]
          (cond
            (.isSubClass methodClassSym (.-owner sym) types)
              (.forEach (.map (.find refs ThisRef)
                              (lambda Function ^ExprRef [^ThisRef ref] (ExprRef. depth ref)))
                        (method-ref Consumer [ExprRef] refs RefSet/.add))
            (.isEnclosedBy methodClassSym (cast Symbol$ClassSymbol (.-owner sym)))
              (.forEach (.flatMap (.map (.find refs ThisRef)
                                        (lambda Function ^Optional [^ThisRef ref]
                                          (.fromOuter ref depth)))
                                  (method-ref Function ^Stream [Optional] Optional/.stream))
                        (method-ref Consumer [ExprRef] refs RefSet/.add))))))

  (method ^:public visitSynchronized ^void [this ^JCTree$JCSynchronized tree]
    (.scan this (.-lock tree))
    (.discardExprs refs depth)
    (.scan this (.-body tree)))

  (method ^:public visitConditional ^void [this ^JCTree$JCConditional tree]
    (.scan this (.-cond tree))
    (.discardExprs refs depth)

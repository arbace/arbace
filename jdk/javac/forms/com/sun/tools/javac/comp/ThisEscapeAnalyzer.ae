      (.scan this (.-truepart tree))
      (.forEach (.removeExprs refs depth) (method-ref Consumer [ExprRef] combinedRefs RefSet/.add))
      (.scan this (.-falsepart tree))
      (.forEach (.removeExprs refs depth) (method-ref Consumer [ExprRef] combinedRefs RefSet/.add))
      (.addAll refs combinedRefs)))

  (method ^:public visitIf ^void [this ^JCTree$JCIf tree]
    (.scan this (.-cond tree))
    (.discardExprs refs depth)
    (.scan this (.-thenpart tree))
    (.scan this (.-elsepart tree)))

  (method ^:public visitExec ^void [this ^JCTree$JCExpressionStatement tree]
    (.scan this (.-expr tree))

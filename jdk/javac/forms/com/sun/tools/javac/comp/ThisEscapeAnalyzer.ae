    (let [methodInfo (cast MethodInfo (.get methodMap (.-constructor tree)))
          ^Symbol$TypeSymbol tsym (if (some? (.-def tree))
                                      ^Symbol$TypeSymbol (.-sym (.-def tree))
                                      (.-tsym (.-type (.-clazz tree))))
          ^{:tag (RefSet ThisRef)} receiverRefs (.receiverRefsForConstructor
                                                  this
                                                  (.-encl tree)
                                                  tsym)]
      (if (and (some? methodInfo) (.-invokable methodInfo))
          (.invokeInvokable this tree (.-args tree) receiverRefs methodInfo)
          (.invokeUnknown this tree (.-args tree) receiverRefs))))

  (method ^:private receiverRefsForConstructor ^{:tag (RefSet ThisRef)} [this
                                                                         ^JCTree$JCExpression explicitOuterThis
                                                                         ^Symbol$TypeSymbol tsym]
    (cond
      (some? explicitOuterThis)
        (do
          (.scan this explicitOuterThis)
          (cast RefSet
                (.collect (.flatMap (.map (.removeExprs refs depth)
                                          (lambda Function ^Optional [^ExprRef ref]
                                            (.toOuter ref (.-tsym (.-type explicitOuterThis)))))
                                    (method-ref Function ^Stream [Optional] Optional/.stream))
                          (RefSet/collector))))
      (.hasImplicitOuterInstance this tsym)
        (cast RefSet
              (.collect (.flatMap (.map (.find refs ThisRef)
                                        (lambda Function ^Optional [^ThisRef ref]
                                          (.toOuter ref tsym)))
                                  (method-ref Function ^Stream [Optional] Optional/.stream))
                        (RefSet/collector)))
      :else (RefSet/newEmpty)))

  (method ^:private hasImplicitOuterInstance ^boolean [this ^Symbol$TypeSymbol tsym]
    (let [currentClassSym (.-sym (.-declaringClass currentMethod))]
      (and (and (not (identical? tsym currentClassSym)) (.hasOuterInstance tsym))
           (.isEnclosedBy tsym currentClassSym))))

  (method ^:public visitBlock ^void [this ^JCTree$JCBlock tree]

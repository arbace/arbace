  (method ^:private analyzeConstructor ^void [this ^MethodInfo constructor]
    (Assert/check (nil? targetClass))
    (Assert/check (nil? currentMethod))
    (Assert/check (== depth -1))
    (Assert/check (nil? refs))
    (set! targetClass (.-declaringClass constructor))
    (set! currentMethod constructor)
    (try
      (set! refs (RefSet/newEmpty))
      (.add refs (ThisRef. (.-sym targetClass) (EnumSet/of Indirection/DIRECT)))
      (.visitScoped this
                    false
                    (lambda Runnable ^void [] (.scan this (.-body (.-declaration constructor)))))
      (finally
        (Assert/check (== depth -1))
        (set! currentMethod nil)
        (set! targetClass nil)
        (set! refs nil))))

  (method ^:private visitDeferred :type-params [(T extends JCTree)] ^void [this
                                                                           ^Runnable deferredCode]
    (let [numWarningsPrev (.size warningList)
          ^{:tag (RefSet Ref)} refsPrev (.clone refs)
          ^:mutable ^boolean deferredCodeLeaks false]
      (try
        (.run deferredCode)
        (set! deferredCodeLeaks (> (.size warningList) numWarningsPrev))
        (set! deferredCodeLeaks
              (let [a-5 deferredCodeLeaks b-6 (.discardExprs refs depth)] (or a-5 b-6)))
        (finally
          (set! refs refsPrev)
          (.clear (.subList warningList numWarningsPrev (.size warningList)))))
      (when deferredCodeLeaks
        (.add refs (ExprRef. depth (.-tsym (.-objectType syms)) (EnumSet/of Indirection/INDIRECT))))))

  (method ^:private visitLooped :type-params [(T extends JCTree)] ^void [this ^T tree
                                                                         ^{:tag (Consumer T)} visitor]
    (.visitScoped this
                  false
                  (lambda Runnable ^void []
                    (while true
                      (let [^{:tag (RefSet Ref)} prevRefs (.clone refs)]
                        (.accept visitor tree)
                        (when (.equals refs prevRefs) (break)))))))

  (method ^:private visitScoped ^void [this ^boolean promote ^Runnable action]
    (.pushScope this)
    (try
      (Assert/check (.checkInvariants this true false))
      (.run action)
      (Assert/check (.checkInvariants this true promote))
      (when promote
        (Assert/check (> depth 0))
        (.forEach (.map (.removeExprs refs depth)
                        (lambda Function ^ExprRef [^ExprRef ref]
                          (ExprRef. (unchecked-subtract-int depth 1) ref)))
                  (method-ref Consumer [ExprRef] refs RefSet/.add)))
      (finally (.popScope this))))

  (method ^:private pushScope ^void [this]
    (set! depth (unchecked-inc-int depth)))

  (method ^:private popScope ^void [this]
    (Assert/check (>= depth 0))
    (.discardExprs refs depth)
    (set! depth (unchecked-dec-int depth)))

  (method ^:private leakAt ^void [this ^JCTree tree]
    (.add callStack (StackFrame. currentMethod nil tree))
    (.add warningList (Warning. targetClass (ArrayList. callStack)))
    (.remove callStack (unchecked-subtract-int (.size callStack) 1)))

  (method ^:private isParamOrVar ^boolean [this ^Symbol sym]
    (and (and (some? sym) (identical? (.-kind sym) Kinds$Kind/VAR))
         (or (identical? (.-kind (.-owner sym)) Kinds$Kind/MTH)
             (identical? (.-kind (.-owner sym)) Kinds$Kind/VAR))))

  (method ^:private isExplicitOuterThisReference ^boolean [this ^Types types
                                                           ^Type$ClassType currentClass
                                                           ^JCTree$JCFieldAccess select]
    (let [selectedType (.erasure types (.-type (.-selected select)))]
      (when (.hasTag selectedType TypeTag/CLASS)
        (let [currentClassSym (cast Symbol$ClassSymbol (.-tsym currentClass))
              selectedTypeSym (cast Symbol$ClassSymbol (.-tsym selectedType))]
          (when (and (and (identical? (.-name select) (.-_this names))
                          (.hasOuterInstance currentClassSym))
                     (identical? (.enclClass (.-owner currentClassSym)) selectedTypeSym))
            (return true))))
      false))

  (method ^:private isAnalyzing ^boolean [this] (some? targetClass))

  (method ^:private checkInvariants ^boolean [this ^boolean analyzing ^boolean allowExpr]
    (Assert/check (= analyzing (.isAnalyzing this)))
    (if (.isAnalyzing this)
        (do
          (Assert/check (some? currentMethod))
          (Assert/check (some? targetClass))
          (Assert/check (some? refs))
          (Assert/check (>= depth 0))
          (Assert/check (.allMatch (.find refs ExprRef)
                                   (lambda Predicate ^boolean [^ExprRef ref]
                                     (and allowExpr (<= (.-depth ref) depth))))))
        (do
          (Assert/check (nil? targetClass))
          (Assert/check (nil? refs))
          (Assert/check (== depth -1))
          (Assert/check (.isEmpty callStack))
          (Assert/check (.isEmpty invocations))))
    true)

  (defclass ^:enum Indirection
    (constants DIRECT OUTER INDIRECT))

  (defclass ^:private ^:abstract ^:static Ref
    (field ^:final ^Symbol$TypeSymbol tsym)

    (field ^:final ^{:tag (EnumSet Indirection)} indirections)

    (constructor [this ^Ref ref] (this. (.-tsym ref) (.-indirections ref)))

    (constructor [this ^Symbol$TypeSymbol tsym ^{:tag (EnumSet Indirection)} indirections]
      (Assert/check (some? tsym))
      (Assert/check (some? indirections))
      (set! (.-tsym this) tsym)
      (set! (.-indirections this) (EnumSet/copyOf indirections)))

    (method ^:public ^:abstract withType ^Ref [this ^Symbol$TypeSymbol tsym])

    (method ^:public hashCode ^int [this]
      (bit-xor-int (bit-xor-int (.hashCode (.getClass this)) (.hashCode tsym))
                   (.hashCode indirections)))

    (method ^:public equals ^boolean [this obj]
      (cond
        (identical? obj this) true
        (or (nil? obj) (not (identical? (.getClass obj) (.getClass this)))) false
        :else
          (let [that (cast Ref obj)]
            (and (identical? tsym (.-tsym that)) (.equals indirections (.-indirections that))))))

    (method ^:public ^:final toString ^String [this]
      (let [^{:tag (ArrayList String)} properties (ArrayList.)]
        (.add properties (java-str "tsym=" tsym))
        (.addProperties this properties)
        (.add properties
              (cast String
                    (.collect (.map (.stream indirections)
                                    (method-ref Function ^String [Indirection] Indirection/.name))
                              (Collectors/joining ","))))
        (java-str (.getSimpleName (.getClass this))
                  "["
                  (cast String (.collect (.stream properties) (Collectors/joining ",")))
                  "]")))

    (method ^:protected addProperties ^void [this ^{:tag (ArrayList String)} properties])

    (method ^:public modifiedIndirections ^{:tag (EnumSet Indirection)} [this
                                                                         ^{:tag (Consumer (? super (EnumSet Indirection)))} modifier]
      (let [^{:tag (EnumSet Indirection)} newIndirections (EnumSet/copyOf indirections)]
        (.accept modifier newIndirections)
        (Assert/check (not (.isEmpty newIndirections)))
        newIndirections))

    (method ^:public toOuter ^{:tag (Optional ThisRef)} [this ^Symbol$TypeSymbol tsym]
      (.map (.filter (Optional/of this)
                     (lambda Predicate ^boolean [^Ref ref]
                       (.contains (.-indirections ref) Indirection/DIRECT)))
            (lambda Function ^ThisRef [^Ref ref]
              (ThisRef. tsym
                        (.modifiedIndirections ref
                                               (lambda Consumer ^void [^EnumSet indirections]
                                                 (.remove indirections Indirection/DIRECT)
                                                 (.remove indirections Indirection/INDIRECT)
                                                 (.add indirections Indirection/OUTER))))))))

  (defclass ^:private ^:static ThisRef
    :extends Ref

    (constructor [this ^Ref ref] (super. ref))

    (constructor [this ^Symbol$TypeSymbol tsym ^{:tag (EnumSet Indirection)} indirections]
      (super. tsym indirections))

    (method ^:public withType ^ThisRef [this ^Symbol$TypeSymbol tsym]
      (ThisRef. tsym (.-indirections this)))

    (method ^:public fromOuter ^{:tag (Optional ExprRef)} [this ^int depth]
      (let [outerType (cast Symbol$ClassSymbol
                            (.orElse (.map (Optional/of (.-owner (.-tsym this)))
                                           (method-ref
                                             Function
                                             ^Symbol$ClassSymbol [Symbol]
                                             Symbol/.enclClass))
                                     nil))]
        (if (nil? outerType)
            (Optional/empty)
            (.map (.filter (Optional/of this)
                           (lambda Predicate ^boolean [^ThisRef ref]
                             (.contains (.-indirections ref) Indirection/OUTER)))
                  (lambda Function ^ExprRef [^ThisRef ref]
                    (ExprRef. depth
                              outerType
                              (.modifiedIndirections
                                ref
                                (lambda Consumer ^void [^EnumSet indirections]
                                  (.remove indirections Indirection/OUTER)
                                  (.remove indirections Indirection/INDIRECT)
                                  (.add indirections Indirection/DIRECT))))))))))

  (defclass ^:private ^:static ExprRef
    :extends Ref

    (field ^:final ^int depth)

    (constructor [this ^int depth ^Ref ref]
      (super. ref)
      (set! (.-depth this) depth))

    (constructor [this ^int depth ^Symbol$TypeSymbol tsym ^{:tag (EnumSet Indirection)} indirections]
      (super. tsym indirections)
      (set! (.-depth this) depth))

    (method ^:public withType ^ExprRef [this ^Symbol$TypeSymbol tsym]
      (ExprRef. depth tsym (.-indirections this)))

    (method ^:public toIndirect ^{:tag (Optional ExprRef)} [this ^Symbol$TypeSymbol indirectType]
      (.map (.filter (Optional/of this)
                     (lambda Predicate ^boolean [^ExprRef ref]
                       (or (.contains (.-indirections ref) Indirection/DIRECT)
                           (.contains (.-indirections ref) Indirection/INDIRECT))))
            (lambda Function ^ExprRef [^ExprRef ref]
              (ExprRef. depth
                        indirectType
                        (.modifiedIndirections ref
                                               (lambda Consumer ^void [^EnumSet indirections]
                                                 (.remove indirections Indirection/DIRECT)
                                                 (.remove indirections Indirection/OUTER)
                                                 (.add indirections Indirection/INDIRECT)))))))

    (method ^:public toDirect ^{:tag (Optional ExprRef)} [this ^Symbol$TypeSymbol directType]
      (.map (.filter (Optional/of this)
                     (lambda Predicate ^boolean [^ExprRef ref]
                       (.contains (.-indirections ref) Indirection/INDIRECT)))
            (lambda Function ^ExprRef [^ExprRef ref]
              (ExprRef. depth
                        directType
                        (.modifiedIndirections ref
                                               (lambda Consumer ^void [^EnumSet indirections]
                                                 (.remove indirections Indirection/OUTER)
                                                 (.add indirections Indirection/DIRECT)))))))


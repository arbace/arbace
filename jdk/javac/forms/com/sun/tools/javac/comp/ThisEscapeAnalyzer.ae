  (defclass ^:private ^:static RefSet
    :extends (HashSet T)
    :type-params [(T extends Ref)]

    (constructor ^:private [this] (super. 8))

    (method ^:public ^:static newEmpty :type-params [(T extends Ref)] ^{:tag (RefSet T)} []
      (RefSet.))

    (method ^:public find :type-params [(T extends Ref)] ^{:tag (Stream T)} [this
                                                                             ^{:tag (Class T)} refType]
      (.find this refType (lambda Predicate ^boolean [^Ref ref] true)))

    (method ^:public find :type-params [(T extends Ref)] ^{:tag (Stream T)} [this
                                                                             ^{:tag (Class T)} refType

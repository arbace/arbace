                      (.forEach (.map (.remove refs ThisRef)
                                      (method-ref Function ^ReturnRef [ThisRef] ReturnRef/new))
                                (method-ref Consumer [ReturnRef] refs RefSet/.add)))
                    (.forEach (.map (.remove refs ReturnRef)
                                    (lambda Function ^ExprRef [^ReturnRef ref]
                                      (ExprRef. depthPrev ref)))
                              (method-ref Consumer [ExprRef] refsPrev RefSet/.add)))))
              (finally
                (.remove callStack (unchecked-subtract-int (.size callStack) 1))
                (set! depth depthPrev)
                (set! refs refsPrev)
                (set! currentMethod currentMethodPrev))))))))

  (method ^:private invokeUnknown ^void [this ^JCTree invoke ^{:tag (List JCTree$JCExpression)} args
                                         ^{:tag (RefSet ThisRef)} receiverRefs]

    (method ^:public removeExprs ^{:tag (Stream ExprRef)} [this ^int depth]
      (.remove this ExprRef (lambda Predicate ^boolean [^ExprRef ref] (== (.-depth ref) depth))))

    (method ^:public discardExprs ^boolean [this ^int depth]
      (.removeIf this

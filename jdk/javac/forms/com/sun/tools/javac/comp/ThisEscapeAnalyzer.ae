  (method ^:public visitNewArray ^void [this ^JCTree$JCNewArray tree]
    (let [^{:tag (RefSet ExprRef)} combinedRefs (RefSet/newEmpty)]
      (when (some? (.-elems tree))
        (loop [^{:tag (List JCTree$JCExpression)} elems (.-elems tree)]
          (when (.nonEmpty elems)
            (.scan this (cast JCTree (.-head elems)))
            (.forEach (.flatMap (.map (.removeExprs refs depth)
                                      (lambda Function ^Optional [^ExprRef ref]
                                        (.toIndirect ref (.-tsym (.-type tree)))))
                                (method-ref Function ^Stream [Optional] Optional/.stream))
                      (method-ref Consumer [ExprRef] combinedRefs RefSet/.add))
            (recur (.-tail elems)))))
      (.forEach (.stream combinedRefs) (method-ref Consumer [ExprRef] refs RefSet/.add))))


                     (.collect (.filter (.map (.filter
                                                (.stream this)
                                                (method-ref
                                                  Predicate
                                                  [Ref]
                                                  refType
                                                  Class/.isInstance))
                                              (method-ref Function ^Ref [Ref] refType Class/.cast))
                                        filter)

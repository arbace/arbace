    (method ^:public replaceExprs ^void [this ^int depth
                                         ^{:tag (Function (? super ExprRef) (? extends T))} mapper]
      (.forEach (.map (.removeExprs this depth) mapper)
                (method-ref Consumer [Ref] this RefSet/.add)))

    (method ^:public clone ^{:tag (RefSet T)} [this]
      (cast RefSet (.clone super)))

    (method ^:public ^:static collector :type-params [(T extends Ref)] ^{:tag (Collector T ? (RefSet T))} []
      (Collectors/toCollection (method-ref Supplier ^RefSet [] RefSet/new))))

  (defclass ^:private StackFrame
    (field ^:final ^MethodInfo method)

    (field ^:final ^JCTree site)

    (field ^:final ^JCTree initializer)

    (field ^:final ^boolean suppressible)

    (constructor [this ^MethodInfo method ^JCTree initializer ^JCTree site]
      (set! (.-method this) method)
      (set! (.-initializer this) initializer)
      (set! (.-site this) site)
      (set! (.-suppressible this)
            (or (some? initializer)
                (and (.-constructor method) (identical? (.-declaringClass method) targetClass)))))

    (method warningPos ^JCDiagnostic$DiagnosticPosition [this]
      (.withLintPosition (.pos site) Position/NOPOS))

    (method lint ^Lint [this]
      (cast Lint (.get (.lintAt lintMapper (.-sourcefile (.-toplevel topLevelEnv)) (.pos site)))))

    (method isSuppressed ^boolean [this]
      (and suppressible (not (.isEnabled (.lint this) Lint$LintCategory/THIS_ESCAPE))))

    (method comparePos ^int [this ^StackFrame that]
      (Integer/compare (.getPreferredPosition (.pos (.-site this)))
                       (.getPreferredPosition (.pos (.-site that)))))

    (method ^:public toString ^String [this]
      (java-str "StackFrame["
                (.-sym (.-declaration method))
                "@"
                (.getPreferredPosition (.pos site))
                (if (some? initializer)
                    (java-str ",init@" (.getPreferredPosition (.pos initializer)))
                    "")
                "]")))

  (defclass ^:private Warning
    (field ^:final ^JCTree$JCClassDecl declaringClass)

    (field ^:final ^{:tag (ArrayList StackFrame)} stack)

    (field ^:final ^JCTree origin)

    (constructor [this ^JCTree$JCClassDecl declaringClass ^{:tag (ArrayList StackFrame)} stack]
      (set! (.-declaringClass this) declaringClass)
      (set! (.-stack this) stack)
      (set! (.-origin this)
            (cast JCTree
                  (.orElseGet (.findFirst (.filter
                                            (.map
                                              (.stream stack)
                                              (lambda Function ^JCTree [^StackFrame frame]
                                                (.-initializer frame)))
                                            (method-ref Predicate [JCTree] Objects/nonNull)))
                              (lambda Supplier ^JCTree []
                                (.-declaration (.-method (cast StackFrame (.get stack 0)))))))))

    (method isRedundantWith ^boolean [this ^Warning that]
      (let [numExtra (unchecked-subtract-int (.size (.-stack this)) (.size (.-stack that)))]
        (and (>= numExtra 0)
             (.allMatch (IntStream/range 0 (.size (.-stack that)))
                        (lambda IntPredicate ^boolean [^int index]
                          (== (.comparePos (cast
                                             StackFrame
                                             (.get
                                               (.-stack this)
                                               (unchecked-add-int numExtra index)))
                                           (cast StackFrame (.get (.-stack that) index)))
                              0))))))

    (method ^:static sortByStackFrames ^int [^Warning warning1 ^Warning warning2]
      (let [^:mutable index1 (.size (.-stack warning1))
            ^:mutable index2 (.size (.-stack warning2))]
        (while true
          (let [end1 (< (set! index1 (unchecked-dec-int index1)) 0)
                end2 (< (set! index2 (unchecked-dec-int index2)) 0)]
            (when (and end1 end2) (return 0))
            (when end1 (return -1))
            (when end2 (return 1))
            (let [diff (.comparePos (cast StackFrame (.get (.-stack warning1) index1))
                                    (cast StackFrame (.get (.-stack warning2) index2)))]
              (when-not (== diff 0) (return diff)))))))

    (method isSuppressed ^boolean [this]
      (loop [^int index (unchecked-subtract-int (.size stack) 1)]
        (if (>= index 0)
            (if (.isSuppressed (cast StackFrame (.get stack index)))
                (return true)
                (recur (unchecked-dec-int index)))
            nil))
      false)

    (method trimInitializerFrames ^void [this]
      (loop [^int i 0]
        (if (< i (.size stack))
            (if (some? (.-initializer (cast StackFrame (.get stack i))))
                (.clear (.subList stack 0 (unchecked-add-int i 1)))
                (recur (unchecked-inc-int i)))
            nil)))

    (method ^:public toString ^String [this]
      (java-str "Warning[class="
                (.-flatname (.-sym declaringClass))
                ",stack=[\n    "
                (cast String
                      (.collect (.map (.stream stack)
                                      (method-ref
                                        Function
                                        ^String [StackFrame]
                                        StackFrame/.toString))
                                (Collectors/joining "\n    ")))
                "]]")))

  (defclass ^:private ^:record MethodInfo [^JCTree$JCClassDecl declaringClass
                                           ^JCTree$JCMethodDecl declaration ^boolean constructor
                                           ^boolean analyzable ^boolean invokable]
    (method ^:public toString ^String [this]
      (java-str "MethodInfo[method="
                (.-flatname (.-sym declaringClass))
                "."
                (.-sym declaration)
                ",constructor="
                constructor
                ",analyzable="
                analyzable
                ",invokable="
                invokable
                "]"))))

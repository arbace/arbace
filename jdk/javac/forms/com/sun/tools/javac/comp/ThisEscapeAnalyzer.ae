      (.forEach (.map (.stream receiverRefs)
                      (lambda Function ^ExprRef [^ThisRef ref] (ExprRef. depth ref)))
                (method-ref Consumer [ExprRef] refs RefSet/.add))))

  (method ^:private triggersUnknownInvokeLeak ^boolean [this ^Ref ref]
    (or (not (.contains nonPublicOuters (.-tsym ref)))
        (.anyMatch (.stream (.-indirections ref))
                   (lambda Predicate ^boolean [^Indirection i]
                     (not (identical? i Indirection/OUTER))))))


        (let [sym (.-sym (cast JCTree$JCVariableDecl (.-head params)))]
          (.scan this (cast JCTree (.-head args)))
          (.forEach (.map (.removeExprs refs depth)
                          (lambda Function ^VarRef [^ExprRef ref] (VarRef. sym ref)))
                    (method-ref Consumer [VarRef] paramRefs RefSet/.add))
          (set! args (.-tail args))
          (set! params (.-tail params))))

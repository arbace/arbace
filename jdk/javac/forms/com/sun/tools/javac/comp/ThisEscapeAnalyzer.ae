                             (identical? (.-name (.-declaration info)) (.-name method)))
                        (identical? (.-sym (.-declaringClass info)) receiverType))
                   (not (.isConstructor (.-sym (.-declaration info)))))
              (== (bit-and (.flags (.-sym (.-declaration info))) Flags/STATIC) 0))

      (.leakAt this invoke))
    (for-each [^JCTree$JCExpression arg args]
      (.scan this arg)
      (when (.anyMatch (.removeExprs refs depth)
                       (method-ref Predicate
                                   [ExprRef]
                                   this
                                   ThisEscapeAnalyzer/.triggersUnknownInvokeLeak))
        (.leakAt this arg)))

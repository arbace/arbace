    (method ^:public remove :type-params [(T extends Ref)] ^{:tag (Stream T)} [this
                                                                               ^{:tag (Class T)} refType
                                                                               ^{:tag (Predicate (? super T))} filter]
      (let [^{:tag (ArrayList T)} list (cast
                                         ArrayList
                                         (.collect
                                           (.filter
                                             (.map
                                               (.filter
                                                 (.stream this)
                                                 (method-ref
                                                   Predicate

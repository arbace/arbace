      (letclass [(^:record ForeachMethods [^Symbol$MethodSymbol iterator
                                           ^Symbol$MethodSymbol hasNext ^Symbol$MethodSymbol next])]
        (let [^:mutable ^Symbol$MethodSymbol iterator nil
              ^:mutable ^Symbol$MethodSymbol hasNext nil
              ^:mutable ^Symbol$MethodSymbol next nil]
          (when (nil? elemType)
            (let [iteratorSym (.resolveQualifiedMethod
                                rs
                                (.pos (.-expr tree))
                                topLevelEnv
                                (.-type (.-expr tree))
                                (.-iterator names)
                                (List/nil)
                                (List/nil))]
              (when (instance? Symbol$MethodSymbol iteratorSym)
                (set! iterator (cast Symbol$MethodSymbol iteratorSym))
                (let [hasNextSym (.resolveQualifiedMethod
                                   rs
                                   (.pos (.-expr tree))
                                   topLevelEnv
                                   (.getReturnType iterator)
                                   (.-hasNext names)
                                   (List/nil)
                                   (List/nil))
                      nextSym (.resolveQualifiedMethod
                                rs
                                (.pos (.-expr tree))
                                topLevelEnv
                                (.getReturnType iterator)
                                (.-next names)
                                (List/nil)
                                (List/nil))]
                  (when (instance? Symbol$MethodSymbol hasNextSym)
                    (set! hasNext (cast Symbol$MethodSymbol hasNextSym)))
                  (when (instance? Symbol$MethodSymbol nextSym)
                    (set! next (cast Symbol$MethodSymbol nextSym)))))))
          (let [^ForeachMethods foreachMethods (when (and
                                                       (and (some? iterator) (some? hasNext))
                                                       (some? next))
                                                 (ForeachMethods. iterator hasNext next))]
            (.visitLooped
              this
              tree
              (lambda Consumer ^void [^JCTree$JCEnhancedForLoop foreach]
                (.scan this (.-expr foreach))
                (cond
                  (some? elemType)
                    (if (.isParamOrVar this (.-sym (.-var foreach)))
                        (.forEach (.map (.flatMap
                                          (.map (.removeExprs refs depth)
                                                (lambda Function ^Optional [^ExprRef ref]
                                                  (.toIndirect ref (.-tsym elemType))))
                                          (method-ref Function ^Stream [Optional] Optional/.stream))
                                        (lambda Function ^VarRef [^ExprRef ref]
                                          (VarRef. (.-sym (.-var foreach)) ref)))
                                  (method-ref Consumer [VarRef] refs RefSet/.add))
                        (.discardExprs refs depth))
                  (some? foreachMethods)
                    (let [^:mutable ^{:tag (RefSet ThisRef)} receiverRefs (cast
                                                                            RefSet
                                                                            (.collect
                                                                              (.map
                                                                                (.removeExprs
                                                                                  refs
                                                                                  depth)
                                                                                (method-ref
                                                                                  Function
                                                                                  ^ThisRef [ExprRef]
                                                                                  ThisRef/new))
                                                                              (RefSet/collector)))]
                      (.invoke this
                               (.-expr foreach)
                               (.-iterator foreachMethods)
                               (List/nil)
                               receiverRefs)
                      (set! receiverRefs
                            (cast RefSet
                                  (.collect (.map
                                              (.removeExprs refs depth)
                                              (method-ref Function ^ThisRef [ExprRef] ThisRef/new))
                                            (RefSet/collector))))
                      (.invoke this
                               (.-expr foreach)
                               (.-hasNext foreachMethods)
                               (List/nil)
                               receiverRefs)
                      (.discardExprs refs depth)
                      (.invoke this
                               (.-expr foreach)
                               (.-next foreachMethods)
                               (List/nil)
                               receiverRefs)
                      (if (.isParamOrVar this (.-sym (.-var foreach)))
                          (.replaceExprs refs
                                         depth
                                         (lambda Function ^Ref [^ExprRef ref]
                                           (VarRef. (.-sym (.-var foreach)) ref)))
                          (.discardExprs refs depth)))

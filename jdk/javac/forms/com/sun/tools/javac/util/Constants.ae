  (method ^:public ^:static format ^String [value]
    (if-instance [^Byte byteVal value]
      (Constants/formatByte byteVal)
      (if-instance [^Short shortVal value]
        (Constants/formatShort shortVal)
        (if-instance [^Long longVal value]
          (Constants/formatLong longVal)
          (if-instance [^Float floatVal value]
            (Constants/formatFloat floatVal)
            (if-instance [^Double doubleVal value]
              (Constants/formatDouble doubleVal)
              (if-instance [^Character charVal value]

  (method ^:public localize ^String [this ^JCDiagnostic$DiagnosticInfo diagInfo]
    (if useRawMessages (.key diagInfo) (.getLocalizedString messages diagInfo)))

  (method ^:public localize ^String [this ^PrefixKind pk ^String key & ^Object/1 args]
    (if useRawMessages (.key pk key) (.getLocalizedString messages (.key pk key) args)))

  (field ^:private ^:static ^boolean useRawMessages false)

  (method ^:private printRawDiag ^void [this ^PrintWriter pw ^String prefix ^int pos ^String msg]
    (if (or (nil? (.-source this)) (== pos Position/NOPOS))
        (Log/printRawLines pw (java-str prefix msg))
        (let [line (.getLineNumber (.-source this) pos)
              file (.getFile (.-source this))]
          (when (some? file) (Log/printRawLines pw (java-str (.getName file) ":" line ": " msg)))
          (.printErrLine this pos pw)))
    (.flush pw))

  (method ^:public rawError ^void [this ^int pos ^String msg]
    (let [errWriter (cast PrintWriter (.get writers WriterKind/ERROR))]
      (if (and (< nerrors MaxErrors) (.shouldReport this (.currentSourceFile this) pos))
          (do
            (.printRawDiag this errWriter "error: " pos msg)
            (.prompt this)
            (set! nerrors (unchecked-inc-int nerrors)))
          (set! nsuppressederrors (unchecked-inc-int nsuppressederrors)))
      (.flush errWriter)))

  (method ^:public rawWarning ^void [this ^int pos ^String msg]
    (let [warnWriter (cast PrintWriter (.get writers WriterKind/ERROR))]
      (when emitWarnings
        (if (< nwarnings MaxWarnings)
            (.printRawDiag this warnWriter "warning: " pos msg)
            (set! nsuppressedwarns (unchecked-inc-int nsuppressedwarns))))
      (.prompt this)
      (set! nwarnings (unchecked-inc-int nwarnings))
      (.flush warnWriter)))

  (method ^:public ^:static format ^String [^String fmt & ^Object/1 args]
    (String/format (cast Locale nil) fmt args)))

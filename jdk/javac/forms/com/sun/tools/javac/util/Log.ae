  (defclass ^:private DefaultDiagnosticHandler
    :extends DiagnosticHandler

    (method ^:protected reportReady ^void [this ^:mutable ^JCDiagnostic diagnostic]
      (when (some? expectDiagKeys) (.remove expectDiagKeys (.getCode diagnostic)))
      (when (.hasRewriter diagnostic)
        (let [rewrittenDiag (.rewrite diagnostic)]
          (set! diagnostic (if (some? rewrittenDiag) rewrittenDiag diagnostic))))
      (switch (.getType diagnostic)
        FRAGMENT (throw (IllegalArgumentException.))
        NOTE
          (when (and (or emitWarnings (.isMandatory diagnostic)) (not suppressNotes))
            (.writeDiagnostic Log/this diagnostic))
        WARNING
          (do
            (when (.isFlagSet diagnostic JCDiagnostic$DiagnosticFlag/AGGREGATE)
              (let [category (.getLintCategory diagnostic)
                    verbose (.isEnabled (.lintFor Log/this diagnostic) category)]
                (when-not (.aggregate (.aggregatorFor Log/this category) diagnostic verbose)
                  (return))))
            (when (.isFlagSet diagnostic JCDiagnostic$DiagnosticFlag/STRICT)
              (.writeDiagnostic Log/this diagnostic)
              (return))
            (when (or emitWarnings (.isMandatory diagnostic))
              (if (< nwarnings MaxWarnings)
                  (.writeDiagnostic Log/this diagnostic)
                  (set! nsuppressedwarns (unchecked-inc-int nsuppressedwarns)))))
        ERROR
          (when (or (.isFlagSet diagnostic JCDiagnostic$DiagnosticFlag/API)
                    (.shouldReport Log/this diagnostic))
            (if (< nerrors MaxErrors)
                (.writeDiagnostic Log/this diagnostic)
                (set! nsuppressederrors (unchecked-inc-int nsuppressederrors)))))
      (when (.isFlagSet diagnostic JCDiagnostic$DiagnosticFlag/COMPRESSED)
        (set! compressedOutput true))))

  (method ^:protected writeDiagnostic ^void [this ^JCDiagnostic diag]
    (switch (.getType diag)
      WARNING
        (do
          (set! nwarnings (unchecked-inc-int nwarnings))
          (.ifPresent (.map (Optional/of diag)
                            (method-ref Function
                                        ^Lint$LintCategory [JCDiagnostic]
                                        JCDiagnostic/.getLintCategory))
                      (method-ref Consumer [Lint$LintCategory] lintWarnings EnumSet/.add)))
      ERROR (set! nerrors (unchecked-inc-int nerrors))
      nil)
    (if (some? diagListener)
        (.report diagListener diag)
        (let [writer (.getWriterForDiagnosticType this (.getType diag))]
          (Log/printRawLines writer (.format diagFormatter diag (.getCurrentLocale messages)))
          (when promptOnError (switch (.getType diag) (ERROR WARNING) (.prompt this)))
          (when dumpOnError (.printStackTrace (RuntimeException.) writer))
          (.flush writer))))

  (method ^:protected getWriterForDiagnosticType ^PrintWriter [this ^JCDiagnostic$DiagnosticType dt]
    (switch dt
      FRAGMENT (throw (IllegalArgumentException.))
      NOTE (cast PrintWriter (.get writers WriterKind/NOTICE))
      WARNING (cast PrintWriter (.get writers WriterKind/WARNING))
      ERROR (cast PrintWriter (.get writers WriterKind/ERROR))
      (throw (Error.))))


(in-ns 'com.sun.tools.javac.launcher)

(import '(com.sun.tools.javac.api JavacTool)
        '(com.sun.tools.javac.code Lint$LintCategory)
        '(com.sun.tools.javac.file JavacFileManager)
        '(com.sun.tools.javac.resources LauncherProperties$Errors)
        '(com.sun.tools.javac.util Context Log)
        '(java.io File IOException PrintWriter)
        '(java.lang.module ModuleDescriptor ModuleFinder ModuleReference)

(in-ns 'com.sun.tools.javac.launcher)

(import '(com.sun.source.tree ClassTree CompilationUnitTree Tree)
        '(com.sun.tools.javac.api JavacTool)
        '(com.sun.tools.javac.resources LauncherProperties$Errors)
        '(java.io IOException UncheckedIOException)
        '(java.lang.module InvalidModuleDescriptorException)
        '(java.nio.file Files Path)
        '(java.nio.file.attribute BasicFileAttributes)

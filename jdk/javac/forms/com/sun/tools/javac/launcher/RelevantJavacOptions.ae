(defclass ^:record RelevantJavacOptions [^{:tag (List String)} forProgramCompilation
                                         ^{:tag (List String)} forSubsequentCompilations
                                         ^{:tag (List String)} enableNativeAccessForModules]
  (method ^:static of :throws [Fault] ^RelevantJavacOptions [^ProgramDescriptor program &
                                                             ^String/1 runtimeArgs]

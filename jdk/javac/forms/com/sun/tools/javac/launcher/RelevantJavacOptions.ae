                        (when (.isEmpty modules) (break :switch))
                        (set! value (String/join "," modules))))
                    (.add programOptions opt)
                    (.add programOptions value)
                    (let [javacOption (Option/lookup opt)]
                      (when (and (some? javacOption) (.isInBasicOptionGroup javacOption))
                        (.add subsequentOptions opt)
                        (.add subsequentOptions value))))
                "--enable-preview"
                  (do
                    (.add programOptions opt)
                    (.add subsequentOptions opt)
                    (when (nil? sourceOpt)
                      (let [feature (String/valueOf (.feature (Runtime/version)))]
                        (.addAll programOptions (List/of "--release" feature))
                        (.addAll subsequentOptions (List/of "--release" feature)))))
                "--enable-native-access"
                  (do
                    (when (nil? value)
                      (when (== i (unchecked-subtract-int (alength runtimeArgs) 1))
                        (throw (Fault. (LauncherProperties$Errors/NoValueForOption opt))))

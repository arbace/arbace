  (method ^:private ^:static computeListOfModules ^{:tag (List String)} [^ProgramDescriptor program
                                                                         ^String value]
    (let [modules (ArrayList. (List/of (.split value ",")))]
      (.remove modules "ALL-DEFAULT")
      (.remove modules "ALL-SYSTEM")

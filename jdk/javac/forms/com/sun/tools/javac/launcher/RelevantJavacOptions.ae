            (throw (Fault. (LauncherProperties$Errors/InvalidValueForSource sourceOpt))))
          (.addAll programOptions (List/of "--release" sourceOpt))
          (.addAll subsequentOptions (List/of "--release" sourceOpt))))
      (let [^:mutable ^int i 0]
        (while (< i (alength runtimeArgs))
          (let [arg (aget runtimeArgs i)
                ^:mutable opt arg
                ^:mutable ^String value nil]
            (when (.startsWith arg "--")

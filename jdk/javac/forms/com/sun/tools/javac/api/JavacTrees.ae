  (method ^:private attributeParamIdentifier ^Symbol [this ^TreePath path ^DCTree$DCParam paramTag]
    (let [javadocSymbol (.getElement this path)]
      (when (some? javadocSymbol)
        (let [kind (.getKind javadocSymbol)
              ^:mutable ^{:tag (List (? extends Symbol))} params (List/nil)]
          (cond
            (or (identical? kind ElementKind/METHOD) (identical? kind ElementKind/CONSTRUCTOR))
              (let [ee (cast Symbol$MethodSymbol javadocSymbol)]
                (set! params
                      (if (.isTypeParameter paramTag) (.getTypeParameters ee) (.getParameters ee))))
            (or (.isClass kind) (.isInterface kind))
              (let [te (cast Symbol$ClassSymbol javadocSymbol)]
                (set! params
                      (if (.isTypeParameter paramTag)
                          (.getTypeParameters te)
                          (.getRecordComponents te)))))
          (for-each [^Symbol param params]
            (when (identical? (.getSimpleName param) (.getName (.getName paramTag))) (return param)))
          nil))))

  (method ^:private findField ^Symbol$VarSymbol [this ^Symbol$ClassSymbol tsym ^Name fieldName
                                                 ^boolean explicitType]
    (.searchField this tsym fieldName explicitType (HashSet.)))

  (method ^:private searchField ^Symbol$VarSymbol [this ^Symbol$ClassSymbol tsym ^Name fieldName
                                                   ^boolean explicitType
                                                   ^{:tag (Set Symbol$ClassSymbol)} searched]
    (when-not (.contains searched tsym)
      (.add searched tsym)
      (for-each [^Symbol sym (.getSymbolsByName (.members tsym) fieldName)]
        (when (identical? (.-kind sym) Kinds$Kind/VAR) (return (cast Symbol$VarSymbol sym))))
      (when-not explicitType
        (let [encl (.enclClass (.-owner tsym))]
          (when (some? encl)
            (let [vsym (.searchField this encl fieldName explicitType searched)]
              (when (some? vsym) (return vsym))))))
      (let [superclass (.getSuperclass tsym)]
        (when (some? (.-tsym superclass))
          (let [vsym (.searchField this
                                   (cast Symbol$ClassSymbol (.-tsym superclass))
                                   fieldName
                                   explicitType
                                   searched)]
            (when (some? vsym) (return vsym))))
        (let [^{:tag (List Type)} intfs (.getInterfaces tsym)]
          (loop [^{:tag (List Type)} l intfs]
            (when (.nonEmpty l)
              (let [intf (cast Type (.-head l))]
                (if (.isErroneous intf)
                    (recur (.-tail l))
                    (let [vsym (.searchField this
                                             (cast Symbol$ClassSymbol (.-tsym intf))
                                             fieldName
                                             explicitType
                                             searched)]
                      (if (some? vsym) (return vsym) (recur (.-tail l))))))))
          nil))))

  (method findConstructor ^Symbol$MethodSymbol [this ^Symbol$ClassSymbol tsym
                                                ^{:tag (List Type)} paramTypes ^boolean strict]
    (for-each [^Symbol sym (.getSymbolsByName (.members tsym) (.-init names))]
      (when (identical? (.-kind sym) Kinds$Kind/MTH)
        (when (.hasParameterTypes this (cast Symbol$MethodSymbol sym) paramTypes strict)
          (return (cast Symbol$MethodSymbol sym)))))
    nil)

  (method ^:private findMethod ^Symbol$MethodSymbol [this ^Symbol$ClassSymbol tsym ^Name methodName
                                                     ^{:tag (List Type)} paramTypes ^boolean strict
                                                     ^boolean explicitType]
    (.searchMethod this tsym methodName paramTypes strict explicitType (HashSet.)))

  (method ^:private searchMethod ^Symbol$MethodSymbol [this ^Symbol$ClassSymbol tsym
                                                       ^Name methodName
                                                       ^{:tag (List Type)} paramTypes
                                                       ^boolean strict ^boolean explicitType
                                                       ^{:tag (Set Symbol$ClassSymbol)} searched]
    (when-not (identical? methodName (.-init names))
      (when-not (.contains searched tsym)
        (.add searched tsym)
        (if (nil? paramTypes)
            (let [^:mutable ^Symbol$MethodSymbol lastFound nil]
              (for-each [^Symbol sym (.getSymbolsByName (.members tsym) methodName)]
                (when (identical? (.-kind sym) Kinds$Kind/MTH)
                  (when (identical? (.-name sym) methodName)
                    (set! lastFound (cast Symbol$MethodSymbol sym)))))
              (when (some? lastFound) (return lastFound)))
            (for-each [^Symbol sym (.getSymbolsByName (.members tsym) methodName)]
              (when (and (some? sym) (identical? (.-kind sym) Kinds$Kind/MTH))
                (when (.hasParameterTypes this (cast Symbol$MethodSymbol sym) paramTypes strict)
                  (return (cast Symbol$MethodSymbol sym))))))
        (let [superclass (.getSuperclass tsym)]
          (when (some? (.-tsym superclass))
            (let [msym (.searchMethod this
                                      (cast Symbol$ClassSymbol (.-tsym superclass))
                                      methodName
                                      paramTypes
                                      strict
                                      explicitType
                                      searched)]
              (when (some? msym) (return msym))))
          (let [^{:tag (List Type)} intfs (.getInterfaces tsym)]
            (loop [^{:tag (List Type)} l intfs]
              (when (.nonEmpty l)
                (let [intf (cast Type (.-head l))]
                  (if (.isErroneous intf)
                      (recur (.-tail l))
                      (let [msym (.searchMethod this
                                                (cast Symbol$ClassSymbol (.-tsym intf))
                                                methodName
                                                paramTypes
                                                strict
                                                explicitType
                                                searched)]
                        (if (some? msym) (return msym) (recur (.-tail l))))))))
            (when-not explicitType
              (let [encl (.enclClass (.-owner tsym))]
                (when (some? encl)
                  (let [msym (.searchMethod this
                                            encl
                                            methodName
                                            paramTypes
                                            strict
                                            explicitType
                                            searched)]
                    (when (some? msym) (return msym))))))
            nil)))))

  (method ^:private hasParameterTypes ^boolean [this ^Symbol$MethodSymbol method
                                                ^{:tag (List Type)} paramTypes ^boolean strict]
    (cond
      (nil? paramTypes) true
      (not (== (.size (.params method)) (.size paramTypes))) false
      :else
        (let [^:mutable ^{:tag (List Type)} methodParamTypes (.getParameterTypes (.asType method))]
          (if (and (and (not strict) (not (Type/isErroneous paramTypes)))
                   (.isSubtypes types paramTypes methodParamTypes))
              true
              (do
                (set! methodParamTypes (.erasureRecursive types methodParamTypes))
                (.isSameTypes types paramTypes methodParamTypes))))))

  (method ^:public getTypeMirror ^TypeMirror [this ^TreePath path]
    (let [leaf (.getLeaf path)
          ty (.-type (cast JCTree leaf))]
      (when (some? ty) ^TypeMirror (.stripMetadataIfNeeded ty))))


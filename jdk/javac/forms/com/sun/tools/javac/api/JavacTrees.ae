  (method ^:public getDocCommentKind ^Elements$DocCommentKind [this ^TreePath path]
    (let [compUnit (.getCompilationUnit path)
          leaf (.getLeaf path)]
      (when-instance [^JCTree$JCCompilationUnit cu compUnit]
        (when-instance [^JCTree l leaf]
          (when (some? (.-docComments cu))
            (let [c (.getComment (.-docComments cu) l)]
              (return (when (some? c)
                        (switch (.getStyle c)
                          JAVADOC_BLOCK Elements$DocCommentKind/TRADITIONAL
                          JAVADOC_LINE Elements$DocCommentKind/END_OF_LINE
                          nil)))))))
      nil))

  (method ^:public getDocComment ^String [this ^TreePath path]
    (let [compUnit (.getCompilationUnit path)
          leaf (.getLeaf path)]
      (when-instance [^JCTree$JCCompilationUnit cu compUnit]
        (when-instance [^JCTree l leaf]
          (when (some? (.-docComments cu)) (return (.getCommentText (.-docComments cu) l)))))
      nil))

  (method ^:public getDocCommentTree ^DocCommentTree [this ^TreePath path]
    (let [compUnit (.getCompilationUnit path)
          leaf (.getLeaf path)]
      (when-instance [^JCTree$JCCompilationUnit cu compUnit]
        (when-instance [^JCTree l leaf]
          (when (some? (.-docComments cu)) (return (.getCommentTree (.-docComments cu) l)))))
      nil))

  (method ^:public getDocCommentTree ^DocCommentTree [this ^Element e]
    (let [path (.getPath this e)] (when (some? path) (.getDocCommentTree this path))))

  (method ^:public getDocCommentTree :throws [IOException] ^DocCommentTree [this ^Element e
                                                                            ^String relativeFileName]
    (let [pkg (.getPackageOf elements e)
          fileForInput (.getFileForInput fileManager
                                         StandardLocation/SOURCE_PATH
                                         (.toString (.getQualifiedName pkg))
                                         relativeFileName)]
      (when (nil? fileForInput) (throw (FileNotFoundException. relativeFileName)))
      (.getDocCommentTree this fileForInput)))

  (method ^:public isAccessible ^boolean [this ^Scope scope ^TypeElement type]
    (if-instance [^JavacScope javacScope scope]
      (if-instance [^Symbol$ClassSymbol classSymbol type]
        (.isAccessible resolve (.-env javacScope) classSymbol true)
        false)
      false))

  (method ^:public isAccessible ^boolean [this ^Scope scope ^Element member ^DeclaredType type]
    (if-instance [^JavacScope javacScope scope]
      (if-instance [^Symbol symbol member]
        (if-instance [^Type codeType type]
          (.isAccessible resolve (.-env javacScope) codeType symbol true)
          false)
        false)
      false))

  (method ^:private getAttrContext ^{:tag (Env AttrContext)} [this ^TreePath path]
    (when-not (instance? JCTree (.getLeaf path)) (throw (IllegalArgumentException.)))
    (when (some? javacTaskImpl) (.enter javacTaskImpl nil))
    (let [unit (cast JCTree$JCCompilationUnit (.getCompilationUnit path))
          copier (.createCopier this (.forToplevel treeMaker unit))
          ^:mutable ^{:tag (Env AttrContext)} env nil
          ^:mutable ^JCTree$JCMethodDecl method nil
          ^:mutable ^JCTree$JCVariableDecl field nil
          ^:mutable ^{:tag (List Tree)} l (List/nil)
          ^:mutable p path]
      (while (some? p) (set! l (.prepend l (.getLeaf p))) (set! p (.getParentPath p)))
      (while (.nonEmpty l)
        (let [tree (cast Tree (.-head l))]
          (switch (.getKind tree)
            COMPILATION_UNIT (set! env (.getTopLevelEnv enter (cast JCTree$JCCompilationUnit tree)))
            (ANNOTATION_TYPE CLASS ENUM INTERFACE RECORD)
              (do
                (set! env (.getClassEnv enter (.-sym (cast JCTree$JCClassDecl tree))))
                (when (nil? env) (return nil)))
            METHOD
              (do
                (set! method (cast JCTree$JCMethodDecl tree))
                (set! env (.getMethodEnv memberEnter method env)))
            VARIABLE (set! field (cast JCTree$JCVariableDecl tree))
            BLOCK
              (do
                (if (some? method)
                    (try
                      (Assert/check (identical? (.-body method) tree))
                      (set! (.-body method)
                            (cast JCTree$JCBlock
                                  (.copy copier
                                         (cast JCTree$JCBlock tree)
                                         (cast JCTree (.getLeaf path)))))
                      (set! env
                            (.attribStatToTree this
                                               (.-body method)
                                               env
                                               (.-leafCopy copier)
                                               (.-copiedClasses copier)))
                      (finally (set! (.-body method) (cast JCTree$JCBlock tree))))
                    (let [body (cast JCTree$JCBlock
                                     (.copy copier
                                            (cast JCTree$JCBlock tree)
                                            (cast JCTree (.getLeaf path))))]
                      (set! env
                            (.attribStatToTree this
                                               body
                                               env
                                               (.-leafCopy copier)
                                               (.-copiedClasses copier)))))
                (return env))
            (when (and (some? field) (identical? (.getInitializer field) tree))
              (set! env (.getInitEnv memberEnter field env))
              (let [expr (cast JCTree$JCExpression
                               (.copy copier
                                      (cast JCTree$JCExpression tree)
                                      (cast JCTree (.getLeaf path))))]
                (set!
                  env
                  (.attribExprToTree this expr env (.-leafCopy copier) (.-copiedClasses copier)))
                (return env)))))
        (set! l (.-tail l)))
      (if (some? field) (.getInitEnv memberEnter field env) env)))

  (method ^:private attribStatToTree ^{:tag (Env AttrContext)} [this ^JCTree stat
                                                                ^{:tag (Env AttrContext)} env
                                                                ^JCTree tree
                                                                ^{:tag (Map JCTree$JCClassDecl JCTree$JCClassDecl)} copiedClasses]
    (let [^{:tag (Env AttrContext)} result (.attribStatToTree attr stat env tree)]
      (.fixLocalClassNames this copiedClasses env)
      result))

  (method ^:private attribExprToTree ^{:tag (Env AttrContext)} [this ^JCTree$JCExpression expr
                                                                ^{:tag (Env AttrContext)} env
                                                                ^JCTree tree
                                                                ^{:tag (Map JCTree$JCClassDecl JCTree$JCClassDecl)} copiedClasses]
    (let [^{:tag (Env AttrContext)} result (.attribExprToTree attr expr env tree)]
      (.fixLocalClassNames this copiedClasses env)
      result))

  (method ^:private fixLocalClassNames ^void [this
                                              ^{:tag (Map JCTree$JCClassDecl JCTree$JCClassDecl)} copiedClasses
                                              ^{:tag (Env AttrContext)} lastEnv]
    (let [^:mutable ^{:tag (Map JCTree$JCClassDecl Name)} flatnameForClass nil]
      (for-each [^{:tag (Map$Entry JCTree$JCClassDecl JCTree$JCClassDecl)} e (.entrySet
                                                                               copiedClasses)]
        (when (some? (.-sym (cast JCTree$JCClassDecl (.getKey e))))
          (let [^:mutable ^Name origName nil]
            (if (some? (.-sym (cast JCTree$JCClassDecl (.getValue e))))
                (set! origName (.-flatname (.-sym (cast JCTree$JCClassDecl (.getValue e)))))
                (do
                  (when (nil? flatnameForClass)
                    (set! flatnameForClass (.prepareFlatnameForClass this lastEnv)))
                  (set! origName (cast Name (.get flatnameForClass (.getValue e))))))
            (when (some? origName)
              (set! (.-flatname (.-sym (cast JCTree$JCClassDecl (.getKey e)))) origName)))))))

  (method ^:private prepareFlatnameForClass ^{:tag (Map JCTree$JCClassDecl Name)} [this
                                                                                   ^{:tag (Env AttrContext)} env]
    (let [^{:tag (Map JCTree$JCClassDecl Name)} flatNameForClass (HashMap.)
          ^Symbol enclClass (.-sym (.-enclClass env))]
      (when (and (some? enclClass)
                 (not (== (bit-and (.-flags_field enclClass) Flags/UNATTRIBUTED) 0)))
        (let [^{:tag (ListBuffer Symbol$ClassSymbol)} toClear (ListBuffer.)]
          (.scan (anon com.sun.tools.javac.tree.TreeScanner []
                   (field ^Symbol owner)

                   (field ^boolean localContext)

                   (method ^:public visitClassDef ^void [this ^JCTree$JCClassDecl tree]
                     (let [prevOwner owner]
                       (try
                         (let [^:mutable ^Symbol$ClassSymbol c nil]
                           (if (some? (.-sym tree))
                               (set! c (.-sym tree))
                               (do
                                 (set! c (.defineClass syms (.-name tree) owner))
                                 (when-not (identical? (.-kind owner) Kinds$Kind/TYP)
                                   (set! (.-flatname c) (.localClassName chk c))
                                   (.putCompiled chk c)
                                   (.add toClear c))
                                 (.put flatNameForClass tree (.-flatname c))))
                           (set! owner c)
                           (.visitClassDef super tree))
                         (finally (set! owner prevOwner)))))

                   (method ^:public visitBlock ^void [this ^JCTree$JCBlock tree]
                     (let [prevOwner owner]
                       (try
                         (set! owner (Symbol$MethodSymbol. 0 (.-empty names) Type/noType owner))
                         (.visitBlock super tree)
                         (finally (set! owner prevOwner)))))

                   (method ^:public visitVarDef ^void [this ^JCTree$JCVariableDecl tree]
                     (let [prevOwner owner]
                       (try
                         (set! owner (Symbol$MethodSymbol. 0 (.-empty names) Type/noType owner))
                         (.visitVarDef super tree)
                         (finally (set! owner prevOwner))))))
                 (.-enclClass env))
          (.forEach toClear
                    (lambda Consumer ^void [^Symbol$ClassSymbol c]
                      (.clearLocalClassNameIndexes chk c)
                      (.removeCompiled chk c)))))
      flatNameForClass))

  (method ^:private ^:static isHtmlFile ^boolean [^FileObject fo]
    (.endsWith (.getName fo) ".html"))

  (method ^:private ^:static isMarkdownFile ^boolean [^FileObject fo]
    (.endsWith (.getName fo) ".md"))

  (method ^:static asDocFileObject ^JavaFileObject [^FileObject fo]
    (if-instance [^JavaFileObject jfo fo]
      (switch (.getKind jfo)
        HTML (return jfo)
        OTHER (when (JavacTrees/isMarkdownFile jfo) (return jfo)))
      (when (or (JavacTrees/isHtmlFile fo) (JavacTrees/isMarkdownFile fo))
        (return (DocFileObject. fo))))
    (throw (IllegalArgumentException. (java-str "Not a documentation file: " (.getName fo)))))

  (defclass ^:private ^:static DocFileObject
    :extends (ForwardingFileObject FileObject)
    :implements [JavaFileObject]

    (constructor ^:public [this ^FileObject fileObject] (super. fileObject))

    (method ^:public getKind ^JavaFileObject$Kind [this]
      (BaseFileManager/getKind (.getName (.-fileObject this))))

    (method ^:public isNameCompatible ^boolean [this ^String simpleName ^JavaFileObject$Kind kind]
      false)

    (method ^:public getNestingKind ^NestingKind [this] nil)

    (method ^:public getAccessLevel ^Modifier [this] nil))

  (method ^:public getDocCommentTree ^DocCommentTree [this ^FileObject fileObject]
    (let [jfo (JavacTrees/asDocFileObject fileObject)
          diagSource (DiagnosticSource. jfo log)
          ^Tokens$Comment comment (anon Tokens$Comment []
                                    (field ^int offset 0)

                                    (method ^:public getText ^String [this]
                                      (try
                                        (let [rawDoc (.getCharContent fileObject true)]
                                          (return (.toString rawDoc)))
                                        (catch IOException ignore))
                                      "")

                                    (method ^:public stripIndent ^Tokens$Comment [this] this)

                                    (method ^:public getPos ^JCDiagnostic$DiagnosticPosition [this]
                                      nil)

                                    (method ^:public getSourcePos ^int [this ^int index]
                                      (unchecked-add-int offset index))

                                    (method ^:public getStyle ^Tokens$Comment$CommentStyle [this]
                                      (cond
                                        (JavacTrees/isHtmlFile fileObject)
                                          Tokens$Comment$CommentStyle/JAVADOC_BLOCK
                                        (JavacTrees/isMarkdownFile fileObject)
                                          Tokens$Comment$CommentStyle/JAVADOC_LINE))

                                    (method ^:public isDeprecated ^boolean [this] false))
          isHtmlFile (identical? (.getKind jfo) JavaFileObject$Kind/HTML)
          dct (.parse (DocCommentParser. parserFactory diagSource comment isHtmlFile))]
      (.transform this dct)))

  (method ^:public getDocTreePath ^DocTreePath [this ^FileObject fileObject
                                                ^PackageElement packageElement]
    (let [jfo (JavacTrees/asDocFileObject fileObject)
          docCommentTree (.getDocCommentTree this jfo)]
      (when (some? docCommentTree)
        (let [treePath (.makeTreePath this
                                      (cast Symbol$PackageSymbol packageElement)
                                      jfo
                                      docCommentTree)]
          (DocTreePath. treePath docCommentTree)))))

  (method ^:public setBreakIterator ^void [this ^BreakIterator breakiterator]
    (set! (.-breakIterator this) breakiterator))

  (method ^:public getCharacters ^String [this ^EntityTree tree]
    (Entity/getCharacters tree))

  (method ^:public getDocCommentTree ^DocCommentTree [this ^DiagnosticSource diagSource
                                                      ^Tokens$Comment c]
    (let [dct (.parse (DocCommentParser. parserFactory diagSource c))] (.transform this dct)))

  (defclass ^:public ^:interface DocCommentTreeTransformer
    (field ^:public ^:final ^String STANDARD "standard")

    (method name ^String [this])

    (method transform ^DocCommentTree [this ^DocTrees trees ^DocCommentTree tree]))

  (defclass ^:public ^:static IdentityTransformer
    :implements [DocCommentTreeTransformer]

    (method ^:public name ^String [this] "identity")

    (method ^:public transform ^DocCommentTree [this ^DocTrees trees ^DocCommentTree tree]
      tree))

  (method ^:public getDocCommentTreeTransformer ^DocCommentTreeTransformer [this]
    docCommentTreeTransformer)

  (method ^:public setDocCommentTreeTransformer ^void [this ^DocCommentTreeTransformer transformer]
    (set! docCommentTreeTransformer transformer))

  (method ^:public initDocCommentTreeTransformer ^void [this]
    (when (nil? docCommentTreeTransformer)
      (let [sl (ServiceLoader/load DocCommentTreeTransformer)]
        (set! docCommentTreeTransformer
              (cast DocCommentTreeTransformer
                    (.orElseGet (.findFirst
                                  (.filter
                                    (.map (.stream sl)
                                          (method-ref
                                            Function
                                            ^DocCommentTreeTransformer [ServiceLoader$Provider]
                                            ServiceLoader$Provider/.get))
                                    (lambda Predicate ^boolean [^DocCommentTreeTransformer t]
                                      (.equals (.name t) DocCommentTreeTransformer/STANDARD))))
                                (lambda Supplier ^DocCommentTreeTransformer []
                                  (IdentityTransformer.))))))))

  (method ^:private transform ^DocCommentTree [this ^DocCommentTree tree]
    (.initDocCommentTreeTransformer this)
    (.transform docCommentTreeTransformer this tree))

  (method ^:public getParserFactory ^ParserFactory [this] parserFactory)

  (defclass ^:protected ^:static Copier
    :extends (TreeCopier JCTree)

    (field ^JCTree leafCopy nil)

    (field ^:private ^{:tag (Map JCTree$JCClassDecl JCTree$JCClassDecl)} copiedClasses (HashMap.))

    (constructor ^:protected [this ^TreeMaker M] (super. M))

    (method ^:public copy :type-params [(T extends JCTree)] ^T [this ^T t ^JCTree leaf]
      (let [^T t2 (.copy super t leaf)] (when (identical? t leaf) (set! leafCopy t2)) t2))

    (method ^:public visitClass ^JCTree [this ^ClassTree node ^JCTree p]
      (let [nue (.visitClass super node p)]
        (.put copiedClasses (cast JCTree$JCClassDecl nue) (cast JCTree$JCClassDecl node))
        nue)))

  (method ^:protected createCopier ^Copier [this ^TreeMaker maker]
    (Copier. maker))

  (method ^:public getOriginalType ^TypeMirror [this ^ErrorType errorType]
    (if-instance [^Type$ErrorType targetErrorType errorType]
      (.getOriginalType targetErrorType)
      (do
        (when-instance [^Type$ClassType classType errorType]
          (when (identical? (.getKind errorType) TypeKind/ERROR)
            (return (cast TypeMirror
                          (.computeIfAbsent extraType2OriginalMap
                                            classType
                                            (lambda Function ^Type [^Type tt]
                                              (anon Type$ClassType [(.getEnclosingType classType)
                                                                    (.-typarams_field classType)
                                                                    (.-tsym classType)
                                                                    (.getMetadata classType)]
                                                (method ^:public baseType ^Type [this] classType)

                                                (method ^:public getKind ^TypeKind [this]
                                                  TypeKind/DECLARED))))))))
        Type/noType)))

  (method ^:public printMessage ^void [this ^Diagnostic$Kind kind ^CharSequence msg ^Tree t
                                       ^CompilationUnitTree root]
    (.printMessage this kind msg (.pos (cast JCTree t)) root))

  (method ^:public printMessage ^void [this ^Diagnostic$Kind kind ^CharSequence msg ^DocTree t
                                       ^DocCommentTree c ^CompilationUnitTree root]
    (.printMessage this kind msg (.pos (cast DCTree t) (cast DCTree$DCDocComment c)) root))

  (method ^:public printMessage ^void [this ^Diagnostic$Kind kind ^CharSequence msg]
    (.printMessage this kind msg (cast JCDiagnostic$DiagnosticPosition nil) nil))

  (method ^:private printMessage ^void [this ^Diagnostic$Kind kind ^CharSequence msg
                                        ^:mutable ^JCDiagnostic$DiagnosticPosition pos
                                        ^CompilationUnitTree root]
    (let [^:mutable ^JavaFileObject oldSource nil
          ^:mutable ^JavaFileObject newSource nil]
      (set! newSource (when (some? root) (.getSourceFile root)))
      (if (nil? newSource) (set! pos nil) (set! oldSource (.useSource log newSource)))
      (try
        (switch kind
          ERROR
            (.error log
                    JCDiagnostic$DiagnosticFlag/API
                    pos
                    (CompilerProperties$Errors/ProcMessager (.toString msg)))
          WARNING (.warning log pos (CompilerProperties$Warnings/ProcMessager (.toString msg)))
          MANDATORY_WARNING
            (.warning log
                      JCDiagnostic$DiagnosticFlag/MANDATORY
                      pos
                      (CompilerProperties$Warnings/ProcMessager (.toString msg)))
          (.note log pos (CompilerProperties$Notes/ProcMessager (.toString msg))))
        (finally (when (some? oldSource) (.useSource log oldSource))))))

  (method ^:public getLub ^TypeMirror [this ^CatchTree tree]
    (let [ct (cast JCTree$JCCatch tree)
          v (.-param ct)]
      (if (and (some? (.-type v)) (identical? (.getKind (.-type v)) TypeKind/UNION))
          (let [ut (cast Type$UnionClassType (.-type v))] (.getLub ut))
          (.-type v))))

  (method ^:private makeTreePath ^TreePath [this ^:final ^Symbol$PackageSymbol psym
                                            ^:final ^JavaFileObject jfo ^DocCommentTree dcTree]
    (let [^JCTree$JCCompilationUnit jcCompilationUnit (anon JCTree$JCCompilationUnit [(List/nil)]
                                                        (method ^:public getPos ^int [this]
                                                          Position/FIRSTPOS)

                                                        (method ^:public getSourcefile ^JavaFileObject [this]
                                                          jfo)

                                                        (method ^:public getLineMap ^Position$LineMap [this]
                                                          (try
                                                            (let [content (.getCharContent jfo true)
                                                                  s (.toString content)]
                                                              (return
                                                                (Position/makeLineMap
                                                                  (.toCharArray s)
                                                                  (.length s)
                                                                  true)))
                                                            (catch IOException ignore))
                                                          nil))]
      (set! (.-docComments jcCompilationUnit)
            (anon DocCommentTable []
              (method ^:public hasComment ^boolean [this ^JCTree tree] false)

              (method ^:public getComment ^Tokens$Comment [this ^JCTree tree]
                (throw (UnsupportedOperationException.)))

              (method ^:public getCommentKind ^Elements$DocCommentKind [this ^JCTree tree]
                (throw (UnsupportedOperationException.)))

              (method ^:public getCommentText ^String [this ^JCTree tree]
                (throw (UnsupportedOperationException.)))

              (method ^:public getCommentTree ^DCTree$DCDocComment [this ^JCTree tree]
                (cast DCTree$DCDocComment dcTree))

              (method ^:public putComment ^void [this ^JCTree tree ^Tokens$Comment c]
                (throw (UnsupportedOperationException.)))))
      (set! (.-lineMap jcCompilationUnit) (.getLineMap jcCompilationUnit))
      (set! (.-modle jcCompilationUnit) (.-modle psym))
      (set! (.-sourcefile jcCompilationUnit) jfo)
      (set! (.-namedImportScope jcCompilationUnit) (Scope$NamedImportScope. psym))
      (set! (.-packge jcCompilationUnit) psym)
      (set! (.-starImportScope jcCompilationUnit) (Scope$StarImportScope. psym))
      (set! (.-moduleImportScope jcCompilationUnit) (Scope$StarImportScope. psym))
      (set! (.-toplevelScope jcCompilationUnit) (Scope$WriteableScope/create psym))
      (TreePath. jcCompilationUnit))))

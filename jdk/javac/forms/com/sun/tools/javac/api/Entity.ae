  (method ^:private ^:static put ^void [^String name ^char c]
    (.put entities name (String/valueOf c)))

  (method ^:private ^:static put ^void [^String name ^char c1 ^char c2]
    (.put entities name (String/valueOf (new char/1 [c1 c2]))))

  (method ^:static getCharacters ^String [^EntityTree tree]
    (let [name (.toString (.getName tree))]
      (if (.startsWith name "#")
          (do
            (try
              (let [^int v (if (.startsWith (StringUtils/toLowerCase name) "#x")
                               (Integer/parseInt (.substring name 2) 16)
                               (Integer/parseInt (.substring name 1) 10))]
                (when (and (and (Character/isDefined v)
                                (or (not (Character/isISOControl v)) (Character/isSpaceChar v)))
                           (or (< v 0xd800) (> v 0xdfff)))
                  (return (String/valueOf (unchecked-char v)))))
              (catch NumberFormatException ex))
            nil)
          (cast String (.get entities name))))))

  (method ^:public visitOpens ^JCTree$JCOpens [this ^OpensTree node ^P p]
    (let [t (cast JCTree$JCOpens node)
          qualId (cast JCTree$JCExpression (.copy this (.-qualid t) p))
          ^{:tag (List JCTree$JCExpression)} moduleNames (.copy this (.-moduleNames t) p)]
      (.Opens (.at M (.-pos t)) qualId moduleNames)))

  (method ^:public visitProvides ^JCTree$JCProvides [this ^ProvidesTree node ^P p]
    (let [t (cast JCTree$JCProvides node)
          serviceName (cast JCTree$JCExpression (.copy this (.-serviceName t) p))
          ^{:tag (List JCTree$JCExpression)} implNames (.copy this (.-implNames t) p)]
      (.Provides (.at M (.-pos t)) serviceName implNames)))

  (method ^:public visitRequires ^JCTree$JCRequires [this ^RequiresTree node ^P p]
    (let [t (cast JCTree$JCRequires node)
          moduleName (cast JCTree$JCExpression (.copy this (.-moduleName t) p))]
      (.Requires (.at M (.-pos t)) (.-isTransitive t) (.-isStaticPhase t) moduleName)))

  (method ^:public visitUses ^JCTree$JCUses [this ^UsesTree node ^P p]
    (let [t (cast JCTree$JCUses node)
          serviceName (cast JCTree$JCExpression (.copy this (.-qualid t) p))]
      (.Uses (.at M (.-pos t)) serviceName)))

  (method ^:public visitOther ^JCTree [this ^Tree node ^P p]
    (let [tree (cast JCTree node)]
      (switch (.getTag tree)
        LETEXPR
          (let [t (cast JCTree$LetExpr node)
                ^{:tag (List JCTree$JCStatement)} defs (.copy this (.-defs t) p)
                expr (cast JCTree$JCExpression (.copy this (.-expr t) p))]
            (.LetExpr (.at M (.-pos t)) defs expr))
        (throw (AssertionError. (java-str "unknown tree tag: " (.getTag tree))))))))

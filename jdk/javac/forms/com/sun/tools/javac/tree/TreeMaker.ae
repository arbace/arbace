    (cast JCTree$JCFieldAccess
          (.setType (.setPos (JCTree$JCFieldAccess. base (.-name sym) sym) pos) (.-type sym))))

  (method ^:public QualIdent ^JCTree$JCExpression [this ^Symbol sym]
    (let [^JCTree$JCExpression result (if (.isUnqualifiable this sym)
                                          ^JCTree$JCExpression (.Ident this sym)
                                          ^JCTree$JCExpression (.Select
                                                                 this
                                                                 (.QualIdent this (.-owner sym))
                                                                 sym))]
      (when (identical? (.-kind sym) Kinds$Kind/TYP)
        (.setType result (.erasure types (.-type sym))))
      result))

  (method ^:public Ident ^JCTree$JCExpression [this ^JCTree$JCVariableDecl param]
    (.Ident this (.-sym param)))

  (method ^:public Idents ^{:tag (List JCTree$JCExpression)} [this
                                                              ^{:tag (List JCTree$JCVariableDecl)} params]
    (let [^{:tag (ListBuffer JCTree$JCExpression)} ids (ListBuffer.)]
      (loop [^{:tag (List JCTree$JCVariableDecl)} l params]
        (when (.nonEmpty l)
          (.append ids (.Ident this (cast JCTree$JCVariableDecl (.-head l))))
          (recur (.-tail l))))
      (.toList ids)))

  (method ^:public This ^JCTree$JCExpression [this ^Type t]
    (.Ident this (Symbol$VarSymbol. Flags/FINAL (.-_this names) t (.-tsym t))))

  (method ^:public QualThis ^JCTree$JCExpression [this ^Type t]
    (.Select this (.Type this t) (Symbol$VarSymbol. Flags/FINAL (.-_this names) t (.-tsym t))))

  (method ^:public ClassLiteral ^JCTree$JCExpression [this ^Symbol$ClassSymbol clazz]
    (.ClassLiteral this (.-type clazz)))

  (method ^:public ClassLiteral ^JCTree$JCExpression [this ^Type t]
    (let [lit (Symbol$VarSymbol. (bit-or-int (bit-or-int Flags/STATIC Flags/PUBLIC) Flags/FINAL)
                                 (.-_class names)
                                 t
                                 (.-tsym t))]
      (.Select this (.Type this t) lit)))

  (method ^:public Super ^JCTree$JCIdent [this ^Type t ^Symbol$TypeSymbol owner]
    (.Ident this (Symbol$VarSymbol. Flags/FINAL (.-_super names) t owner)))

  (method ^:public App ^JCTree$JCMethodInvocation [this ^JCTree$JCExpression meth
                                                   ^{:tag (List JCTree$JCExpression)} args]
    (.setType (.Apply this nil meth args) (.getReturnType (.-type meth))))

  (method ^:public App ^JCTree$JCMethodInvocation [this ^JCTree$JCExpression meth]
    (.setType (.Apply this nil meth (List/nil)) (.getReturnType (.-type meth))))

  (method ^:public Create ^JCTree$JCExpression [this ^Symbol ctor
                                                ^{:tag (List JCTree$JCExpression)} args]
    (let [t (.erasure (.-owner ctor) types)
          newclass (.NewClass this nil nil (.Type this t) args nil)]
      (set! (.-constructor newclass) ctor)
      (.setType newclass t)
      newclass))

  (method ^:public Type ^JCTree$JCExpression [this ^Type t]
    (when (some? t)
      (let [^:mutable ^JCTree$JCExpression tp nil]
        (switch (.getTag t)
          (BYTE CHAR SHORT INT LONG FLOAT DOUBLE BOOLEAN VOID)
            (set! tp (.TypeIdent this (.getTag t)))
          TYPEVAR (set! tp (.Ident this (.-tsym t)))
          WILDCARD
            (let [a (cast Type$WildcardType t)]
              (set! tp
                    (.Wildcard this
                               (.TypeBoundKind this (.-kind a))
                               ^JCTree (when-not (identical? (.-kind a) BoundKind/UNBOUND)
                                         ^JCTree (.Type this (.-type a))))))
          CLASS
            (switch (.getKind t)
              UNION
                (let [tu (cast Type$UnionClassType t)
                      ^{:tag (ListBuffer JCTree$JCExpression)} la (ListBuffer.)]
                  (for-each [^Type ta (.getAlternativeTypes tu)] (.add la (.Type this ta)))
                  (set! tp (.TypeUnion this (.toList la))))
              INTERSECTION
                (let [it (cast Type$IntersectionClassType t)
                      ^{:tag (ListBuffer JCTree$JCExpression)} la (ListBuffer.)]
                  (for-each [^Type ta (.getExplicitComponents it)] (.add la (.Type this ta)))
                  (set! tp (.TypeIntersection this (.toList la))))
              (let [outer (.getEnclosingType t)
                    ^JCTree$JCExpression clazz (if (and
                                                     (.hasTag outer TypeTag/CLASS)
                                                     (identical?
                                                       (.-kind (.-owner (.-tsym t)))
                                                       Kinds$Kind/TYP))
                                                   ^JCTree$JCExpression (.Select
                                                                          this
                                                                          (.Type this outer)
                                                                          (.-tsym t))
                                                   (.QualIdent this (.-tsym t)))]
                (set! tp
                      (if (.isEmpty (.getTypeArguments t))
                          clazz
                          ^JCTree$JCExpression (.TypeApply
                                                 this
                                                 clazz
                                                 (.Types this (.getTypeArguments t)))))))
          ARRAY (set! tp (.TypeArray this (.Type this (.elemtype types t))))
          ERROR (set! tp (.TypeIdent this TypeTag/ERROR))
          (throw (AssertionError. (java-str "unexpected type: " t))))
        (.setType tp t))))

  (method ^:public Types ^{:tag (List JCTree$JCExpression)} [this ^{:tag (List Type)} ts]
    (let [^{:tag (ListBuffer JCTree$JCExpression)} lb (ListBuffer.)]
      (loop [^{:tag (List Type)} l ts]
        (when (.nonEmpty l) (.append lb (.Type this (cast Type (.-head l)))) (recur (.-tail l))))
      (.toList lb)))

  (method ^:public VarDef ^JCTree$JCVariableDecl [this ^Symbol$VarSymbol v ^JCTree$JCExpression init]
    (cast JCTree$JCVariableDecl
          (.setType (.setPos (JCTree$JCVariableDecl.
                               (.Modifiers this
                                           (.flags v)
                                           (.Annotations this (.getRawAttributes v)))
                               (.-name v)
                               (.Type this (.-type v))
                               init
                               v)
                             pos)
                    (.-type v))))

  (method ^:public Annotations ^{:tag (List JCTree$JCAnnotation)} [this
                                                                   ^{:tag (List Attribute$Compound)} attributes]
    (if (nil? attributes)
        (List/nil)
        (let [^{:tag (ListBuffer JCTree$JCAnnotation)} result (ListBuffer.)]
          (loop [^{:tag (List Attribute$Compound)} i attributes]
            (when (.nonEmpty i)
              (let [a (cast Attribute (.-head i))]
                (.append result (.Annotation this a))
                (recur (.-tail i)))))
          (.toList result))))

  (method ^:public Literal ^JCTree$JCLiteral [this value]
    (let [^:mutable ^JCTree$JCLiteral result nil]
      (arbace.core/cond (instance? String value)
                        (set! result
                              (.setType (.Literal this TypeTag/CLASS value)
                                        (.constType (.-stringType syms) value)))
                        (instance? Integer value)
                        (set! result
                              (.setType (.Literal this TypeTag/INT value)
                                        (.constType (.-intType syms) value)))
                        :else
                        (arbace.core/cond (instance? Long value)
                                          (set! result
                                                (.setType
                                                  (.Literal this TypeTag/LONG value)
                                                  (.constType (.-longType syms) value)))
                                          (instance? Byte value)
                                          (set! result
                                                (.setType
                                                  (.Literal this TypeTag/BYTE value)
                                                  (.constType (.-byteType syms) value)))
                                          :else
                                          (if-instance [^Character charVal value]
                                            (let [^int v (.charAt (.toString charVal) 0)]
                                              (set!
                                                result
                                                (.setType
                                                  (.Literal this TypeTag/CHAR v)
                                                  (.constType (.-charType syms) v))))
                                            (if (instance? Double value)
                                                (set!
                                                  result
                                                  (.setType
                                                    (.Literal this TypeTag/DOUBLE value)
                                                    (.constType (.-doubleType syms) value)))
                                                (arbace.core/cond
                                                  (instance? Float value)
                                                  (set!
                                                    result
                                                    (.setType
                                                      (.Literal this TypeTag/FLOAT value)
                                                      (.constType (.-floatType syms) value)))
                                                  (instance? Short value)
                                                  (set!
                                                    result
                                                    (.setType
                                                      (.Literal this TypeTag/SHORT value)
                                                      (.constType (.-shortType syms) value)))
                                                  :else
                                                  (if-instance [^Boolean boolVal value]
                                                    (let [^int v (if (.booleanValue boolVal) 1 0)]
                                                      (set!
                                                        result
                                                        (.setType
                                                          (.Literal this TypeTag/BOOLEAN v)
                                                          (.constType (.-booleanType syms) v))))
                                                    (throw (AssertionError. value))))))))
      result))

  (defclass AnnotationBuilder
    :implements [Attribute$Visitor]

    (field ^JCTree$JCExpression result nil)

    (method ^:public visitConstant ^void [this ^Attribute$Constant v]
      (set! result (.Literal TreeMaker/this (.getTag (.-type v)) (.-value v))))

    (method ^:public visitClass ^void [this ^Attribute$Class clazz]
      (set! result (.setType (.ClassLiteral TreeMaker/this (.-classType clazz)) (.-classType syms))))

    (method ^:public visitEnum ^void [this ^Attribute$Enum e]
      (set! result (.QualIdent TreeMaker/this (.-value e))))

    (method ^:public visitError ^void [this ^Attribute$Error e]
      (if-instance [^Attribute$UnresolvedClass unresolvedClass e]
        (set! result
              (.setType (.ClassLiteral TreeMaker/this (.-classType unresolvedClass))
                        (.-classType syms)))
        (set! result (.Erroneous TreeMaker/this))))

    (method ^:public visitCompound ^void [this ^Attribute$Compound compound]
      (if-instance [^Attribute$TypeCompound typeCompound compound]
        (set! result (.visitTypeCompoundInternal this typeCompound))
        (set! result (.visitCompoundInternal this compound))))

    (method ^:public visitCompoundInternal ^JCTree$JCAnnotation [this ^Attribute$Compound compound]
      (let [^{:tag (ListBuffer JCTree$JCExpression)} args (ListBuffer.)]
        (loop [^{:tag (List (Pair Symbol$MethodSymbol Attribute))} values (.-values compound)]
          (when (.nonEmpty values)
            (let [^{:tag (Pair Symbol$MethodSymbol Attribute)} pair (cast Pair (.-head values))
                  valueTree (.translate this (cast Attribute (.-snd pair)))]
              (.append args
                       (.setType (.Assign TreeMaker/this
                                          (.Ident TreeMaker/this (cast Symbol (.-fst pair)))
                                          valueTree)
                                 (.-type valueTree)))
              (recur (.-tail values)))))
        (.Annotation TreeMaker/this (.Type TreeMaker/this (.-type compound)) (.toList args))))

    (method ^:public visitTypeCompoundInternal ^JCTree$JCAnnotation [this
                                                                     ^Attribute$TypeCompound compound]
      (let [^{:tag (ListBuffer JCTree$JCExpression)} args (ListBuffer.)]
        (loop [^{:tag (List (Pair Symbol$MethodSymbol Attribute))} values (.-values compound)]
          (when (.nonEmpty values)
            (let [^{:tag (Pair Symbol$MethodSymbol Attribute)} pair (cast Pair (.-head values))
                  valueTree (.translate this (cast Attribute (.-snd pair)))]
              (.append args
                       (.setType (.Assign TreeMaker/this
                                          (.Ident TreeMaker/this (cast Symbol (.-fst pair)))
                                          valueTree)
                                 (.-type valueTree)))
              (recur (.-tail values)))))
        (.TypeAnnotation TreeMaker/this (.Type TreeMaker/this (.-type compound)) (.toList args))))

    (method ^:public visitArray ^void [this ^Attribute$Array array]
      (let [^{:tag (ListBuffer JCTree$JCExpression)} elems (ListBuffer.)]
        (loop [^int i 0]
          (when (< i (alength (.-values array)))
            (.append elems (.translate this (aget (.-values array) i)))
            (recur (unchecked-inc-int i))))
        (set! result
              (.setType (.NewArray TreeMaker/this nil (List/nil) (.toList elems)) (.-type array)))))

    (method translate ^JCTree$JCExpression [this ^Attribute a]
      (.accept a this)
      result)

    (method translate ^JCTree$JCAnnotation [this ^Attribute$Compound a]
      (.visitCompoundInternal this a))

    (method translate ^JCTree$JCAnnotation [this ^Attribute$TypeCompound a]
      (.visitTypeCompoundInternal this a)))

  (field ^AnnotationBuilder annotationBuilder (AnnotationBuilder.))

  (method ^:public Annotation ^JCTree$JCAnnotation [this ^Attribute a]
    (.translate annotationBuilder (cast Attribute$Compound a)))

  (method ^:public TypeAnnotation ^JCTree$JCAnnotation [this ^Attribute a]
    (.translate annotationBuilder (cast Attribute$TypeCompound a)))

  (method ^:public MethodDef ^JCTree$JCMethodDecl [this ^Symbol$MethodSymbol m ^JCTree$JCBlock body]
    (.MethodDef this m (.-type m) body))

  (method ^:public MethodDef ^JCTree$JCMethodDecl [this ^Symbol$MethodSymbol m ^Type mtype
                                                   ^JCTree$JCBlock body]
    (cast JCTree$JCMethodDecl
          (.setType (.setPos (JCTree$JCMethodDecl.
                               (.Modifiers this
                                           (.flags m)
                                           (.Annotations this (.getRawAttributes m)))
                               (.-name m)
                               ^JCTree$JCExpression (when-not (identical? (.-name m) (.-init names))
                                                      (.Type this (.getReturnType mtype)))
                               (.TypeParams this (.getTypeArguments mtype))
                               nil
                               ^List (if (some? (.-params m))
                                         (.Params this m)
                                         (.Params this m (.getParameterTypes mtype)))
                               (.Types this (.getThrownTypes mtype))
                               body
                               nil
                               m)
                             pos)
                    mtype)))

  (method ^:public TypeParam ^JCTree$JCTypeParameter [this ^Name name ^Type$TypeVar tvar]
    (cast JCTree$JCTypeParameter
          (.setType (.setPos (.TypeParameter this name (.Types this (.getBounds types tvar))) pos)
                    tvar)))

  (method ^:public TypeParams ^{:tag (List JCTree$JCTypeParameter)} [this
                                                                     ^{:tag (List Type)} typarams]
    (let [^{:tag (ListBuffer JCTree$JCTypeParameter)} tparams (ListBuffer.)]
      (loop [^{:tag (List Type)} l typarams]
        (when (.nonEmpty l)
          (.append tparams
                   (.TypeParam this
                               (.-name (.-tsym (cast Type (.-head l))))
                               (cast Type$TypeVar (.-head l))))
          (recur (.-tail l))))
      (.toList tparams)))

  (method ^:public Param ^JCTree$JCVariableDecl [this ^Name name ^Type argtype ^Symbol owner]
    (.VarDef this (Symbol$VarSymbol. Flags/PARAMETER name argtype owner) nil))

  (method ^:public Params ^{:tag (List JCTree$JCVariableDecl)} [this ^Symbol$MethodSymbol mth]
    (Assert/check (some? (.-params mth)))
    (let [^{:tag (ListBuffer JCTree$JCVariableDecl)} params (ListBuffer.)]
      (for-each [^Symbol$VarSymbol param (.-params mth)] (.append params (.VarDef this param nil)))
      (.toList params)))

  (method ^:public Params ^{:tag (List JCTree$JCVariableDecl)} [this ^Symbol$MethodSymbol mth
                                                                ^{:tag (List Type)} argtypes]
    (Assert/check (nil? (.-params mth)))
    (let [^{:tag (ListBuffer JCTree$JCVariableDecl)} params (ListBuffer.)
          ^:mutable ^int i 0]
      (loop [^{:tag (List Type)} l argtypes]
        (when (.nonEmpty l)
          (.append params (.Param this (.paramName this i) (cast Type (.-head l)) mth))
          (set! i (unchecked-inc-int i))
          (recur (.-tail l))))
      (.toList params)))

  (method ^:public Call ^JCTree$JCStatement [this ^JCTree$JCExpression apply]
    (if (.hasTag (.-type apply) TypeTag/VOID)
        ^JCTree$JCStatement (.Exec this apply)
        ^JCTree$JCStatement (.Return this apply)))

  (method ^:public Assignment ^JCTree$JCStatement [this ^Symbol v ^JCTree$JCExpression rhs]
    (.Exec this (.setType (.Assign this (.Ident this v) rhs) (.-type v))))

  (method ^:public Indexed ^JCTree$JCArrayAccess [this ^Symbol v ^JCTree$JCExpression index]
    (let [tree (JCTree$JCArrayAccess. (.QualIdent this v) index)]
      (set! (.-type tree) (.-elemtype (cast Type$ArrayType (.-type v))))
      tree))

  (method ^:public TypeCast ^JCTree$JCTypeCast [this ^Type type ^JCTree$JCExpression expr]
    (cast JCTree$JCTypeCast (.setType (.TypeCast this (.Type this type) expr) type)))

  (method isUnqualifiable ^boolean [this ^Symbol sym]
    (if (or (or (or (or (identical? (.-name sym) (.-empty names)) (nil? (.-owner sym)))
                    (identical? (.-owner sym) (.-rootPackage syms)))
                (identical? (.-kind (.-owner sym)) Kinds$Kind/MTH))
            (identical? (.-kind (.-owner sym)) Kinds$Kind/VAR))
        true
        (do
          (when (and (identical? (.-kind sym) Kinds$Kind/TYP) (some? toplevel))
            (for-each [^Scope scope (new Scope/1
                                         [(.-namedImportScope toplevel)
                                          (.members (.-packge toplevel))
                                          (.-starImportScope toplevel)
                                          (.-moduleImportScope toplevel)])]
              (let [^{:tag (Iterator Symbol)} it (.iterator (.getSymbolsByName scope (.-name sym)))]
                (when (.hasNext it)
                  (let [s (cast Symbol (.next it))]
                    (return (and (identical? s sym) (not (.hasNext it)))))))))
          (and (identical? (.-kind sym) Kinds$Kind/TYP) (.isImplicit sym)))))

  (method ^:public paramName ^Name [this ^int i]
    (.fromString names (java-str "x" i)))

  (method ^:public typaramName ^Name [this ^int i]
    (.fromString names (java-str "A" i))))

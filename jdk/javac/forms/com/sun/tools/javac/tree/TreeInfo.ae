      (and (.hasTag tree JCTree$Tag/BLOCK)
           (not (== (.-bracePos (cast JCTree$JCBlock tree)) Position/NOPOS)))
        (.-bracePos (cast JCTree$JCBlock tree))
      (.hasTag tree JCTree$Tag/SYNCHRONIZED)
        (TreeInfo/endPos (.-body (cast JCTree$JCSynchronized tree)))
      (.hasTag tree JCTree$Tag/TRY)
        (let [t (cast JCTree$JCTry tree)]
          (TreeInfo/endPos
            ^JCTree (cond
                      (some? (.-finalizer t)) ^JCTree (.-finalizer t)
                      (.nonEmpty (.-catchers t))
                        ^JCTree (.-body (cast JCTree$JCCatch (.last (.-catchers t))))
                      :else ^JCTree (.-body t))))
      (and (.hasTag tree JCTree$Tag/SWITCH)
           (not (== (.-bracePos (cast JCTree$JCSwitch tree)) Position/NOPOS)))
        (.-bracePos (cast JCTree$JCSwitch tree))
      (and (.hasTag tree JCTree$Tag/SWITCH_EXPRESSION)
           (not (== (.-bracePos (cast JCTree$JCSwitchExpression tree)) Position/NOPOS)))
        (.-bracePos (cast JCTree$JCSwitchExpression tree))
      :else (.-pos tree)))

  (method ^:public ^:static getStartPos ^int [^JCTree tree]
    (if (nil? tree)
        Position/NOPOS
        (do
          (switch (.getTag tree)
            MODULEDEF
              (let [md (cast JCTree$JCModuleDecl tree)]
                (return
                  (if (.isEmpty (.-annotations (.-mods md)))
                      (.-pos md)
                      (.-pos (cast JCTree$JCAnnotation (.-head (.-annotations (.-mods md))))))))
            PACKAGEDEF
              (let [pd (cast JCTree$JCPackageDecl tree)]
                (return (if (.isEmpty (.-annotations pd))
                            (.-pos pd)
                            (.-pos (cast JCTree$JCAnnotation (.-head (.-annotations pd)))))))
            APPLY (return (TreeInfo/getStartPos (.-meth (cast JCTree$JCMethodInvocation tree))))
            ASSIGN (return (TreeInfo/getStartPos (.-lhs (cast JCTree$JCAssign tree))))
            (BITOR_ASG BITXOR_ASG
                       BITAND_ASG
                       SL_ASG
                       SR_ASG
                       USR_ASG
                       PLUS_ASG
                       MINUS_ASG
                       MUL_ASG
                       DIV_ASG
                       MOD_ASG
                       OR
                       AND
                       BITOR
                       BITXOR
                       BITAND
                       EQ
                       NE
                       LT
                       GT
                       LE
                       GE
                       SL
                       SR
                       USR
                       PLUS
                       MINUS
                       MUL
                       DIV
                       MOD
                       POSTINC
                       POSTDEC)
              (return (TreeInfo/getStartPos
                        (.getOperand (cast JCTree$JCOperatorExpression tree)
                                     JCTree$JCOperatorExpression$OperandPos/LEFT)))
            CLASSDEF
              (let [node (cast JCTree$JCClassDecl tree)]
                (when-not (== (.-pos (.-mods node)) Position/NOPOS) (return (.-pos (.-mods node)))))
            CONDEXPR (return (TreeInfo/getStartPos (.-cond (cast JCTree$JCConditional tree))))
            EXEC (return (TreeInfo/getStartPos (.-expr (cast JCTree$JCExpressionStatement tree))))
            INDEXED (return (TreeInfo/getStartPos (.-indexed (cast JCTree$JCArrayAccess tree))))
            METHODDEF
              (let [node (cast JCTree$JCMethodDecl tree)]
                (when-not (== (.-pos (.-mods node)) Position/NOPOS) (return (.-pos (.-mods node))))
                (when (.nonEmpty (.-typarams node))
                  (return (TreeInfo/getStartPos (cast JCTree (.-head (.-typarams node))))))
                (return (if (nil? (.-restype node))
                            (.-pos node)
                            (TreeInfo/getStartPos (.-restype node)))))
            SELECT (return (TreeInfo/getStartPos (.-selected (cast JCTree$JCFieldAccess tree))))
            TYPEAPPLY (return (TreeInfo/getStartPos (.-clazz (cast JCTree$JCTypeApply tree))))
            TYPEARRAY
              (return (TreeInfo/getStartPos (.-elemtype (cast JCTree$JCArrayTypeTree tree))))
            TYPETEST (return (TreeInfo/getStartPos (.-expr (cast JCTree$JCInstanceOf tree))))
            ANNOTATED_TYPE
              (let [node (cast JCTree$JCAnnotatedType tree)]
                (if (.nonEmpty (.-annotations node))
                    (if (or (.hasTag (.-underlyingType node) JCTree$Tag/TYPEARRAY)
                            (.hasTag (.-underlyingType node) JCTree$Tag/SELECT))
                        (return (TreeInfo/getStartPos (.-underlyingType node)))
                        (return (TreeInfo/getStartPos (cast JCTree (.-head (.-annotations node))))))
                    (return (TreeInfo/getStartPos (.-underlyingType node)))))
            NEWCLASS
              (let [node (cast JCTree$JCNewClass tree)]
                (when (some? (.-encl node)) (return (TreeInfo/getStartPos (.-encl node)))))
            VARDEF
              (let [node (cast JCTree$JCVariableDecl tree)]
                (cond
                  (not (== (.-pos (.-mods node)) Position/NOPOS)) (return (.-pos (.-mods node)))
                  (some? (.-vartype node)) (return (TreeInfo/getStartPos (.-vartype node)))
                  :else (when-not (== (.-typePos node) Position/NOPOS) (return (.-typePos node)))))
            BINDINGPATTERN
              (let [node (cast JCTree$JCBindingPattern tree)]
                (return (TreeInfo/getStartPos (.-var node))))
            ERRONEOUS
              (let [node (cast JCTree$JCErroneous tree)]
                (when (and (some? (.-errs node)) (.nonEmpty (.-errs node)))
                  (let [pos (TreeInfo/getStartPos (cast JCTree (.-head (.-errs node))))]
                    (when-not (== pos Position/NOPOS) (return pos))))))
          (.-pos tree))))

  (method ^:public ^:static getEndPos ^int [^JCTree tree ^EndPosTable endPosTable]
    (cond
      (nil? tree) Position/NOPOS
      (nil? endPosTable) (TreeInfo/endPos tree)
      :else
        (let [mapPos (.getEndPos endPosTable tree)]
          (if (not (== mapPos Position/NOPOS))
              mapPos
              (do
                (switch (.getTag tree)
                  (BITOR_ASG BITXOR_ASG
                             BITAND_ASG
                             SL_ASG
                             SR_ASG
                             USR_ASG
                             PLUS_ASG
                             MINUS_ASG
                             MUL_ASG
                             DIV_ASG
                             MOD_ASG
                             OR
                             AND
                             BITOR
                             BITXOR
                             BITAND
                             EQ
                             NE
                             LT
                             GT
                             LE
                             GE
                             SL
                             SR
                             USR
                             PLUS
                             MINUS
                             MUL
                             DIV
                             MOD
                             POS
                             NEG
                             NOT
                             COMPL
                             PREINC
                             PREDEC)
                    (return (TreeInfo/getEndPos
                              (.getOperand (cast JCTree$JCOperatorExpression tree)
                                           JCTree$JCOperatorExpression$OperandPos/RIGHT)
                              endPosTable))
                  CASE
                    (return (TreeInfo/getEndPos
                              (cast JCTree (.last (.-stats (cast JCTree$JCCase tree))))
                              endPosTable))
                  CATCH
                    (return (TreeInfo/getEndPos (.-body (cast JCTree$JCCatch tree)) endPosTable))
                  CONDEXPR
                    (return (TreeInfo/getEndPos (.-falsepart (cast JCTree$JCConditional tree))
                                                endPosTable))
                  FORLOOP
                    (return (TreeInfo/getEndPos (.-body (cast JCTree$JCForLoop tree)) endPosTable))
                  FOREACHLOOP
                    (return (TreeInfo/getEndPos (.-body (cast JCTree$JCEnhancedForLoop tree))
                                                endPosTable))
                  IF
                    (let [node (cast JCTree$JCIf tree)]
                      (if (nil? (.-elsepart node))
                          (return (TreeInfo/getEndPos (.-thenpart node) endPosTable))
                          (return (TreeInfo/getEndPos (.-elsepart node) endPosTable))))
                  LABELLED
                    (return (TreeInfo/getEndPos (.-body (cast JCTree$JCLabeledStatement tree))
                                                endPosTable))
                  MODIFIERS
                    (return (TreeInfo/getEndPos
                              (cast JCTree (.last (.-annotations (cast JCTree$JCModifiers tree))))
                              endPosTable))
                  SYNCHRONIZED
                    (return (TreeInfo/getEndPos (.-body (cast JCTree$JCSynchronized tree))
                                                endPosTable))
                  TOPLEVEL
                    (return (TreeInfo/getEndPos
                              (cast JCTree (.last (.-defs (cast JCTree$JCCompilationUnit tree))))
                              endPosTable))
                  TRY
                    (let [node (cast JCTree$JCTry tree)]
                      (cond
                        (some? (.-finalizer node))
                          (return (TreeInfo/getEndPos (.-finalizer node) endPosTable))
                        (not (.isEmpty (.-catchers node)))
                          (return (TreeInfo/getEndPos
                                    (cast JCTree (.last (.-catchers node)))
                                    endPosTable))
                        :else (return (TreeInfo/getEndPos (.-body node) endPosTable))))
                  WILDCARD
                    (return
                      (TreeInfo/getEndPos (.-inner (cast JCTree$JCWildcard tree)) endPosTable))
                  TYPECAST
                    (return (TreeInfo/getEndPos (.-expr (cast JCTree$JCTypeCast tree)) endPosTable))
                  TYPETEST
                    (return (TreeInfo/getEndPos (.-pattern (cast JCTree$JCInstanceOf tree))
                                                endPosTable))
                  WHILELOOP
                    (return
                      (TreeInfo/getEndPos (.-body (cast JCTree$JCWhileLoop tree)) endPosTable))
                  ANNOTATED_TYPE
                    (return (TreeInfo/getEndPos
                              (.-underlyingType (cast JCTree$JCAnnotatedType tree))
                              endPosTable))
                  ERRONEOUS
                    (let [node (cast JCTree$JCErroneous tree)]
                      (when (and (some? (.-errs node)) (.nonEmpty (.-errs node)))
                        (return
                          (TreeInfo/getEndPos (cast JCTree (.last (.-errs node))) endPosTable)))))
                Position/NOPOS)))))

  (method ^:public ^:static diagEndPos ^JCDiagnostic$DiagnosticPosition [^:final ^JCTree tree]
    (let [endPos (TreeInfo/endPos tree)]
      (anon JCDiagnostic$DiagnosticPosition []
        (method ^:public getTree ^JCTree [this] tree)

        (method ^:public getStartPosition ^int [this]

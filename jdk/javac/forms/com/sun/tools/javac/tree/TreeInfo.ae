        (method ^:public getPreferredPosition ^int [this] endPos)

        (method ^:public getEndPosition ^int [this ^EndPosTable endPosTable]
          (TreeInfo/getEndPos tree endPosTable)))))

  (defclass ^:public ^:enum PosKind

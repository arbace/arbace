      (START_POS [(method-ref ToIntFunction [JCTree] TreeInfo/getStartPos)])
      (FIRST_STAT_POS [(method-ref ToIntFunction [JCTree] TreeInfo/firstStatPos)])
      (END_POS [(method-ref ToIntFunction [JCTree] TreeInfo/endPos)]))

    (field ^:final ^{:tag (ToIntFunction JCTree)} posFunc)

    (constructor [this ^{:tag (ToIntFunction JCTree)} posFunc]
      (set! (.-posFunc this) posFunc))

    (method toPos ^int [this ^JCTree tree] (.applyAsInt posFunc tree)))

  (method ^:public ^:static finalizerPos ^int [^JCTree tree ^PosKind posKind]
    (cond
      (.hasTag tree JCTree$Tag/TRY)
        (let [t (cast JCTree$JCTry tree)]
          (Assert/checkNonNull (.-finalizer t))
          (.toPos posKind (.-finalizer t)))
      (.hasTag tree JCTree$Tag/SYNCHRONIZED)
        (TreeInfo/endPos (.-body (cast JCTree$JCSynchronized tree)))
      :else (throw (AssertionError.))))

  (method ^:public ^:static positionFor ^int [^:final ^Symbol sym ^:final ^JCTree tree]
    (let [decl (TreeInfo/declarationFor sym tree)] (.-pos (if (some? decl) decl tree))))

  (method ^:public ^:static diagnosticPositionFor ^JCDiagnostic$DiagnosticPosition [^:final ^Symbol sym
                                                                                    ^:final ^JCTree tree]
    (TreeInfo/diagnosticPositionFor sym tree false))

  (method ^:public ^:static diagnosticPositionFor ^JCDiagnostic$DiagnosticPosition [^:final ^Symbol sym
                                                                                    ^:final ^JCTree tree
                                                                                    ^boolean returnNullIfNotFound]
    (TreeInfo/diagnosticPositionFor sym tree returnNullIfNotFound nil))

  (method ^:public ^:static diagnosticPositionFor ^JCDiagnostic$DiagnosticPosition [^:final ^Symbol sym
                                                                                    ^:final ^JCTree tree
                                                                                    ^boolean returnNullIfNotFound
                                                                                    ^{:tag (Predicate (? super JCTree))} filter]
    (letclass [(DiagScanner
                 :extends DeclScanner

                 (constructor [this ^Symbol sym ^{:tag (Predicate (? super JCTree))} filter]
                   (super. sym filter))

                 (method ^:public visitIdent ^void [this ^JCTree$JCIdent that]
                   (when-not (.checkMatch this that (.-sym that)) (.visitIdent super that)))

                 (method ^:public visitSelect ^void [this ^JCTree$JCFieldAccess that]
                   (when-not (.checkMatch this that (.-sym that)) (.visitSelect super that))))]
      (let [s (DiagScanner. sym filter)]
        (.accept tree s)
        (let [decl (.-result s)]
          (when-not (and (nil? decl) returnNullIfNotFound) (.pos (if (some? decl) decl tree)))))))

  (method ^:public ^:static diagnosticPositionFor ^JCDiagnostic$DiagnosticPosition [^:final ^Symbol sym
                                                                                    ^:final ^{:tag (List (? extends JCTree))} trees]
    (cast JCDiagnostic$DiagnosticPosition
          (.get (.findFirst (.filter (.map
                                       (.stream trees)
                                       (lambda Function ^JCDiagnostic$DiagnosticPosition [^JCTree t]
                                         (TreeInfo/diagnosticPositionFor sym t)))
                                     (lambda Predicate ^boolean [^JCDiagnostic$DiagnosticPosition t]
                                       (some? t)))))))

  (defclass ^:private ^:static DeclScanner
    :extends TreeScanner

    (field ^:final ^Symbol sym)

    (field ^:final ^{:tag (Predicate (? super JCTree))} filter)

    (constructor [this ^:final ^Symbol sym] (this. sym nil))

    (constructor [this ^:final ^Symbol sym ^{:tag (Predicate (? super JCTree))} filter]
      (set! (.-sym this) sym)
      (set! (.-filter this) filter))

    (field ^JCTree result nil)

    (method ^:public scan ^void [this ^JCTree tree]
      (when (and (some? tree) (nil? result)) (.accept tree this)))

    (method ^:public visitTopLevel ^void [this ^JCTree$JCCompilationUnit that]
      (when-not (.checkMatch this that (.-packge that)) (.visitTopLevel super that)))

    (method ^:public visitModuleDef ^void [this ^JCTree$JCModuleDecl that]
      (.checkMatch this that (.-sym that)))

    (method ^:public visitPackageDef ^void [this ^JCTree$JCPackageDecl that]
      (when-not (.checkMatch this that (.-packge that)) (.visitPackageDef super that)))

    (method ^:public visitClassDef ^void [this ^JCTree$JCClassDecl that]
      (when-not (.checkMatch this that (.-sym that)) (.visitClassDef super that)))

    (method ^:public visitMethodDef ^void [this ^JCTree$JCMethodDecl that]
      (when-not (.checkMatch this that (.-sym that)) (.visitMethodDef super that)))

    (method ^:public visitVarDef ^void [this ^JCTree$JCVariableDecl that]
      (when-not (.checkMatch this that (.-sym that)) (.visitVarDef super that)))

    (method ^:public visitTypeParameter ^void [this ^JCTree$JCTypeParameter that]
      (when (or (nil? (.-type that)) (not (.checkMatch this that (.-tsym (.-type that)))))
        (.visitTypeParameter super that)))

    (method ^:protected checkMatch ^boolean [this ^JCTree that ^Symbol thatSym]
      (if (and (identical? thatSym (.-sym this)) (or (nil? filter) (.test filter that)))
          (do (set! result that) true)
          (do
            (when (identical? (.getKind (.-sym this)) ElementKind/RECORD_COMPONENT)
              (when (and (and (some? thatSym) (identical? (.getKind thatSym) ElementKind/FIELD))
                         (not (== (bit-and (.-flags_field thatSym) Flags/RECORD) 0)))
                (let [rc (.getRecordComponent (.enclClass thatSym) (cast Symbol$VarSymbol thatSym))]
                  (return (.checkMatch this (.declarationFor rc) rc)))))
            false))))

  (method ^:public ^:static declarationFor ^JCTree [^:final ^Symbol sym ^:final ^JCTree tree]
    (let [s (DeclScanner. sym)] (.accept tree s) (.-result s)))

  (method ^:public ^:static referencedStatement ^JCTree [^JCTree$JCLabeledStatement tree]
    (let [^:mutable ^JCTree t tree]
      (loop []
        (set! t (.-body (cast JCTree$JCLabeledStatement t)))
        (when (.hasTag t JCTree$Tag/LABELLED) (recur)))
      (switch (.getTag t) (DOLOOP WHILELOOP FORLOOP FOREACHLOOP SWITCH) t tree)))

  (method ^:public ^:static skipParens ^JCTree$JCExpression [^:mutable ^JCTree$JCExpression tree]
    (while (.hasTag tree JCTree$Tag/PARENS) (set! tree (.-expr (cast JCTree$JCParens tree))))
    tree)

  (method ^:public ^:static skipParens ^JCTree [^JCTree tree]
    (if (.hasTag tree JCTree$Tag/PARENS) (TreeInfo/skipParens (cast JCTree$JCParens tree)) tree))

  (method ^:public ^:static types ^{:tag (List Type)} [^{:tag (List (? extends JCTree))} trees]
    (let [^{:tag (ListBuffer Type)} ts (ListBuffer.)]
      (loop [^{:tag (List (? extends JCTree))} l trees]
        (when (.nonEmpty l) (.append ts (.-type (cast JCTree (.-head l)))) (recur (.-tail l))))
      (.toList ts)))

  (method ^:public ^:static name ^Name [^JCTree tree]
    (switch (.getTag tree)
      IDENT (.-name (cast JCTree$JCIdent tree))
      SELECT (.-name (cast JCTree$JCFieldAccess tree))
      TYPEAPPLY (TreeInfo/name (.-clazz (cast JCTree$JCTypeApply tree)))
      nil))

  (method ^:public ^:static fullName ^Name [^:mutable ^JCTree tree]
    (set! tree (TreeInfo/skipParens tree))
    (switch (.getTag tree)
      IDENT (.-name (cast JCTree$JCIdent tree))
      SELECT
        (let [sname (TreeInfo/fullName (.-selected (cast JCTree$JCFieldAccess tree)))]
          (when (some? sname) (.append sname \. (TreeInfo/name tree))))
      nil))

  (method ^:public ^:static symbolFor ^Symbol [^JCTree node]
    (let [sym (TreeInfo/symbolForImpl node)] (when (some? sym) (.baseSymbol sym))))

  (method ^:private ^:static symbolForImpl ^Symbol [^:mutable ^JCTree node]
    (set! node (TreeInfo/skipParens node))
    (switch (.getTag node)
      TOPLEVEL
        (let [cut (cast JCTree$JCCompilationUnit node)
              moduleDecl (.getModuleDecl cut)]
          (if (and (TreeInfo/isModuleInfo cut) (some? moduleDecl))
              (TreeInfo/symbolFor moduleDecl)
              (.-packge cut)))
      MODULEDEF (.-sym (cast JCTree$JCModuleDecl node))
      PACKAGEDEF (.-packge (cast JCTree$JCPackageDecl node))
      CLASSDEF (.-sym (cast JCTree$JCClassDecl node))
      METHODDEF (.-sym (cast JCTree$JCMethodDecl node))
      VARDEF (.-sym (cast JCTree$JCVariableDecl node))
      IDENT (.-sym (cast JCTree$JCIdent node))
      SELECT (.-sym (cast JCTree$JCFieldAccess node))
      REFERENCE (.-sym (cast JCTree$JCMemberReference node))
      NEWCLASS (.-constructor (cast JCTree$JCNewClass node))
      APPLY (TreeInfo/symbolFor (.-meth (cast JCTree$JCMethodInvocation node)))
      TYPEAPPLY (TreeInfo/symbolFor (.-clazz (cast JCTree$JCTypeApply node)))
      (ANNOTATION TYPE_ANNOTATION TYPEPARAMETER) (when (some? (.-type node)) (.-tsym (.-type node)))
      nil))

  (method ^:public ^:static isDeclaration ^boolean [^:mutable ^JCTree node]
    (set! node (TreeInfo/skipParens node))
    (switch (.getTag node) (PACKAGEDEF CLASSDEF METHODDEF VARDEF) true false))

  (method ^:public ^:static symbol ^Symbol [^:mutable ^JCTree tree]
    (set! tree (TreeInfo/skipParens tree))
    (switch (.getTag tree)
      IDENT (.-sym (cast JCTree$JCIdent tree))
      SELECT (.-sym (cast JCTree$JCFieldAccess tree))
      TYPEAPPLY (TreeInfo/symbol (.-clazz (cast JCTree$JCTypeApply tree)))
      ANNOTATED_TYPE (TreeInfo/symbol (.-underlyingType (cast JCTree$JCAnnotatedType tree)))
      REFERENCE (.-sym (cast JCTree$JCMemberReference tree))
      CLASSDEF (.-sym (cast JCTree$JCClassDecl tree))
      nil))

  (method ^:public ^:static getModifiers ^JCTree$JCModifiers [^:mutable ^JCTree tree]
    (set! tree (TreeInfo/skipParens tree))
    (switch (.getTag tree)
      VARDEF (.-mods (cast JCTree$JCVariableDecl tree))
      METHODDEF (.-mods (cast JCTree$JCMethodDecl tree))
      CLASSDEF (.-mods (cast JCTree$JCClassDecl tree))
      MODULEDEF (.-mods (cast JCTree$JCModuleDecl tree))
      nil))

  (method ^:public ^:static nonstaticSelect ^boolean [^:mutable ^JCTree tree]
    (set! tree (TreeInfo/skipParens tree))
    (if (not (.hasTag tree JCTree$Tag/SELECT))
        false
        (let [s (cast JCTree$JCFieldAccess tree)
              e (TreeInfo/symbol (.-selected s))]
          (or (nil? e)
              (and (not (identical? (.-kind e) Kinds$Kind/PCK))
                   (not (identical? (.-kind e) Kinds$Kind/TYP)))))))

  (method ^:public ^:static setSymbol ^void [^:mutable ^JCTree tree ^Symbol sym]
    (set! tree (TreeInfo/skipParens tree))
    (switch (.getTag tree)
      IDENT (set! (.-sym (cast JCTree$JCIdent tree)) sym)
      SELECT (set! (.-sym (cast JCTree$JCFieldAccess tree)) sym)
      nil))

  (method ^:public ^:static flags ^long [^JCTree tree]
    (switch (.getTag tree)
      VARDEF (.-flags (.-mods (cast JCTree$JCVariableDecl tree)))
      METHODDEF (.-flags (.-mods (cast JCTree$JCMethodDecl tree)))
      CLASSDEF (.-flags (.-mods (cast JCTree$JCClassDecl tree)))
      BLOCK (.-flags (cast JCTree$JCBlock tree))
      0))

  (method ^:public ^:static firstFlag ^long [^long flags]
    (let [^:mutable flag 1]
      (while (== (bit-and flag flags) 0) (set! flag (bit-shift-left flag 1)))
      flag))

  (method ^:public ^:static flagNames ^String [^long flags]
    (.trim (Flags/toString (bit-and flags Flags/ExtendedStandardFlags))))

  (field ^:public ^:static ^:final ^int notExpression -1)

  (field ^:public ^:static ^:final ^int noPrec 0)

  (field ^:public ^:static ^:final ^int assignPrec 1)

  (field ^:public ^:static ^:final ^int assignopPrec 2)

  (field ^:public ^:static ^:final ^int condPrec 3)

  (field ^:public ^:static ^:final ^int orPrec 4)

  (field ^:public ^:static ^:final ^int andPrec 5)

  (field ^:public ^:static ^:final ^int bitorPrec 6)

  (field ^:public ^:static ^:final ^int bitxorPrec 7)

  (field ^:public ^:static ^:final ^int bitandPrec 8)

  (field ^:public ^:static ^:final ^int eqPrec 9)

  (field ^:public ^:static ^:final ^int ordPrec 10)

  (field ^:public ^:static ^:final ^int shiftPrec 11)

  (field ^:public ^:static ^:final ^int addPrec 12)

  (field ^:public ^:static ^:final ^int mulPrec 13)

  (field ^:public ^:static ^:final ^int prefixPrec 14)

  (field ^:public ^:static ^:final ^int postfixPrec 15)

  (field ^:public ^:static ^:final ^int precCount 16)

  (method ^:public ^:static opPrec ^int [^JCTree$Tag op]
    (switch op
      (POS NEG NOT COMPL PREINC PREDEC) prefixPrec
      (POSTINC POSTDEC NULLCHK) postfixPrec
      ASSIGN assignPrec
      (BITOR_ASG BITXOR_ASG
                 BITAND_ASG
                 SL_ASG
                 SR_ASG
                 USR_ASG
                 PLUS_ASG
                 MINUS_ASG
                 MUL_ASG
                 DIV_ASG
                 MOD_ASG)
        assignopPrec
      OR orPrec
      AND andPrec
      (EQ NE) eqPrec
      (LT GT LE GE) ordPrec
      BITOR bitorPrec
      BITXOR bitxorPrec
      BITAND bitandPrec
      (SL SR USR) shiftPrec
      (PLUS MINUS) addPrec
      (MUL DIV MOD) mulPrec
      TYPETEST ordPrec
      (throw (AssertionError.))))

  (method ^:static tagToKind ^Tree$Kind [^JCTree$Tag tag]
    (switch tag
      POSTINC Tree$Kind/POSTFIX_INCREMENT
      POSTDEC Tree$Kind/POSTFIX_DECREMENT
      PREINC Tree$Kind/PREFIX_INCREMENT
      PREDEC Tree$Kind/PREFIX_DECREMENT
      POS Tree$Kind/UNARY_PLUS
      NEG Tree$Kind/UNARY_MINUS
      COMPL Tree$Kind/BITWISE_COMPLEMENT
      NOT Tree$Kind/LOGICAL_COMPLEMENT
      MUL Tree$Kind/MULTIPLY
      DIV Tree$Kind/DIVIDE
      MOD Tree$Kind/REMAINDER
      PLUS Tree$Kind/PLUS
      MINUS Tree$Kind/MINUS
      SL Tree$Kind/LEFT_SHIFT
      SR Tree$Kind/RIGHT_SHIFT
      USR Tree$Kind/UNSIGNED_RIGHT_SHIFT
      LT Tree$Kind/LESS_THAN
      GT Tree$Kind/GREATER_THAN
      LE Tree$Kind/LESS_THAN_EQUAL
      GE Tree$Kind/GREATER_THAN_EQUAL
      EQ Tree$Kind/EQUAL_TO
      NE Tree$Kind/NOT_EQUAL_TO
      BITAND Tree$Kind/AND
      BITXOR Tree$Kind/XOR
      BITOR Tree$Kind/OR
      AND Tree$Kind/CONDITIONAL_AND
      OR Tree$Kind/CONDITIONAL_OR
      MUL_ASG Tree$Kind/MULTIPLY_ASSIGNMENT
      DIV_ASG Tree$Kind/DIVIDE_ASSIGNMENT
      MOD_ASG Tree$Kind/REMAINDER_ASSIGNMENT
      PLUS_ASG Tree$Kind/PLUS_ASSIGNMENT
      MINUS_ASG Tree$Kind/MINUS_ASSIGNMENT
      SL_ASG Tree$Kind/LEFT_SHIFT_ASSIGNMENT
      SR_ASG Tree$Kind/RIGHT_SHIFT_ASSIGNMENT
      USR_ASG Tree$Kind/UNSIGNED_RIGHT_SHIFT_ASSIGNMENT
      BITAND_ASG Tree$Kind/AND_ASSIGNMENT
      BITXOR_ASG Tree$Kind/XOR_ASSIGNMENT
      BITOR_ASG Tree$Kind/OR_ASSIGNMENT
      NULLCHK Tree$Kind/OTHER
      ANNOTATION Tree$Kind/ANNOTATION
      TYPE_ANNOTATION Tree$Kind/TYPE_ANNOTATION
      EXPORTS Tree$Kind/EXPORTS
      OPENS Tree$Kind/OPENS
      nil))

  (method ^:public ^:static typeIn ^JCTree$JCExpression [^JCTree$JCExpression tree]
    (switch (.getTag tree)
      ANNOTATED_TYPE (.-underlyingType (cast JCTree$JCAnnotatedType tree))
      (IDENT TYPEIDENT SELECT TYPEARRAY WILDCARD TYPEPARAMETER TYPEAPPLY ERRONEOUS) tree
      (throw (AssertionError. (java-str "Unexpected type tree: " tree)))))

  (method ^:public ^:static innermostType ^JCTree [^JCTree type ^boolean skipAnnos]
    (let [^:mutable ^JCTree lastAnnotatedType nil
          ^:mutable cur type]
      (while true
        (switch (.getTag cur)
          TYPEARRAY
            (do
              (set! lastAnnotatedType nil)
              (set! cur (.-elemtype (cast JCTree$JCArrayTypeTree cur))))
          WILDCARD
            (do (set! lastAnnotatedType nil) (set! cur (.-inner (cast JCTree$JCWildcard cur))))
          ANNOTATED_TYPE
            (do
              (set! lastAnnotatedType cur)
              (set! cur (.-underlyingType (cast JCTree$JCAnnotatedType cur))))
          (break)))
      (if (and (not skipAnnos) (some? lastAnnotatedType)) lastAnnotatedType cur)))

  (defclass ^:private ^:static TypeAnnotationFinder
    :extends TreeScanner

    (field ^:public ^boolean foundTypeAnno false)

    (method ^:public scan ^void [this ^JCTree tree]
      (when-not (or foundTypeAnno (nil? tree)) (.scan super tree)))

    (method ^:public visitAnnotation ^void [this ^JCTree$JCAnnotation tree]
      (set! foundTypeAnno (or foundTypeAnno (.hasTag tree JCTree$Tag/TYPE_ANNOTATION)))))

  (method ^:public ^:static containsTypeAnnotation ^boolean [^JCTree e]
    (let [finder (TypeAnnotationFinder.)] (.scan finder e) (.-foundTypeAnno finder)))

  (method ^:public ^:static isModuleInfo ^boolean [^JCTree$JCCompilationUnit tree]
    (and (.isNameCompatible (.-sourcefile tree) "module-info" JavaFileObject$Kind/SOURCE)
         (some? (.getModuleDecl tree))))

  (method ^:public ^:static isPackageInfo ^boolean [^JCTree$JCCompilationUnit tree]
    (.isNameCompatible (.-sourcefile tree) "package-info" JavaFileObject$Kind/SOURCE))

  (method ^:public ^:static isErrorEnumSwitch ^boolean [^JCTree$JCExpression selector
                                                        ^{:tag (List JCTree$JCCase)} cases]
    (and (identical? (.-kind (.-tsym (.-type selector))) Kinds$Kind/ERR)
         (.allMatch (.map (.filter (.flatMap (.stream cases)
                                             (lambda Function ^Stream [^JCTree$JCCase c]
                                               (.stream (.-labels c))))
                                   (lambda Predicate ^boolean [^JCTree$JCCaseLabel l]
                                     (.hasTag l JCTree$Tag/CONSTANTCASELABEL)))
                          (lambda Function ^JCTree$JCExpression [^JCTree$JCCaseLabel l]
                            (.-expr (cast JCTree$JCConstantCaseLabel l))))
                    (lambda Predicate ^boolean [^JCTree$JCExpression p]
                      (.hasTag p JCTree$Tag/IDENT)))))

  (method ^:public ^:static primaryPatternType ^Type [^JCTree pat]
    (switch (.getTag pat)
      BINDINGPATTERN (.-type pat)
      RECORDPATTERN (.-type (cast JCTree$JCRecordPattern pat))
      ANYPATTERN (.-type (cast JCTree$JCAnyPattern pat))
      (throw (AssertionError.))))

  (method ^:public ^:static primaryPatternTypeTree ^JCTree [^JCTree pat]
    (switch (.getTag pat)
      BINDINGPATTERN (.-vartype (.-var (cast JCTree$JCBindingPattern pat)))
      RECORDPATTERN (.-deconstructor (cast JCTree$JCRecordPattern pat))
      (throw (AssertionError.))))

  (method ^:public ^:static expectedExhaustive ^boolean [^JCTree$JCSwitch tree]
    (or
      (.-patternSwitch tree)
      (.anyMatch (.flatMap (.stream (.-cases tree))
                           (lambda Function ^Stream [^JCTree$JCCase c] (.stream (.-labels c))))
                 (lambda Predicate ^boolean [^JCTree$JCCaseLabel l] (TreeInfo/isNullCaseLabel l)))))

  (method ^:public ^:static unguardedCase ^boolean [^JCTree$JCCase cse]
    (let [guard (.-guard cse)] (if (nil? guard) true (TreeInfo/isBooleanWithValue guard 1))))

  (method ^:public ^:static isBooleanWithValue ^boolean [^JCTree$JCExpression guard ^int value]
    (let [constValue (.constValue (.-type guard))]
      (and (and (some? constValue) (.hasTag (.-type guard) TypeTag/BOOLEAN))
           (== (.intValue (cast Integer constValue)) value))))

  (method ^:public ^:static isNullCaseLabel ^boolean [^JCTree$JCCaseLabel label]
    (and (.hasTag label JCTree$Tag/CONSTANTCASELABEL)
         (TreeInfo/isNull (.-expr (cast JCTree$JCConstantCaseLabel label))))))

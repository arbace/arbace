        (when (< i (.length s))
          (let [c (.charAt s i)]
            (if (not (Character/isWhitespace c)) (return i) (recur (unchecked-inc-int i))))))
      -1)

    (method ^:private normalize ^String [this ^DocTree$Kind kind ^String s]
      (switch kind
        TEXT s
        MARKDOWN (.normalizeMarkdown this s)
        (throw (IllegalArgumentException. (.toString kind)))))

    (method ^:private normalizeMarkdown ^String [this ^String s]
      (let [sb (StringBuilder.)
            slen (.length s)
            ^:mutable ^int i 0]
        (while (< i slen)
          (let [ch (.charAt s i)]
            (switch ch
              \\
                (do
                  (.append sb ch)
                  (set! i (unchecked-inc-int i))
                  (when (< i slen) (.append sb (.charAt s i)) (set! i (unchecked-inc-int i))))
              \< (set! i (.skip this sb s i ch \>))
              \[ (set! i (.skip this sb s i ch \]))
              \( (set! i (.skip this sb s i ch \)))
              \`
                (let [start i]
                  (set! i (unchecked-inc-int i))
                  (while (and (< i slen) (== (.charAt s i) \`)) (set! i (unchecked-inc-int i)))
                  (let [prefix (.substring s start i)]
                    (.append sb prefix)
                    (let [j (.indexOf s prefix i)]
                      (when (> j i)
                        (.append sb (.replace (.substring s i j) \. \-))
                        (.append sb prefix)
                        (set! i (unchecked-add-int j (.length prefix)))))))
              (do (.append sb ch) (set! i (unchecked-inc-int i))))))
        (.toString sb)))

    (method ^:private skip ^int [this ^StringBuilder sb ^String s ^:mutable ^int i ^char ch
                                 ^char term]
      (.append sb ch)
      (set! i (unchecked-inc-int i))
      (let [j (.indexOf s term i)]
        (if (not (== j -1)) (do (.append sb (.replace (.substring s i j) \. \-)) j) i)))))

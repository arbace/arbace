    (try
      (.printExpr this (.-deconstructor tree))
      (.print this \()
      (.printExprs this (.-nested tree))
      (.print this \))
      (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:public visitSynchronized ^void [this ^JCTree$JCSynchronized tree]
    (try
      (.print this "synchronized ")
      (if (.hasTag (.-lock tree) JCTree$Tag/PARENS)
          (.printExpr this (.-lock tree))
          (do (.print this \() (.printExpr this (.-lock tree)) (.print this \))))
      (.print this \space)
      (.printStat this (.-body tree))
      (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:public visitTry ^void [this ^JCTree$JCTry tree]
    (try
      (.print this "try ")
      (when (.nonEmpty (.-resources tree))
        (.print this \()
        (let [^:mutable first true]
          (for-each [^JCTree var (.-resources tree)]
            (when-not first (.println this) (.indent this))
            (.printStat this var)
            (set! first false))
          (.print this ") ")))
      (.printStat this (.-body tree))
      (loop [^{:tag (List JCTree$JCCatch)} l (.-catchers tree)]
        (when (.nonEmpty l) (.printStat this (cast JCTree (.-head l))) (recur (.-tail l))))
      (when (some? (.-finalizer tree))
        (.print this " finally ")
        (.printStat this (.-finalizer tree)))
      (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:public visitCatch ^void [this ^JCTree$JCCatch tree]
    (try
      (.print this " catch (")
      (.printExpr this (.-param tree))
      (.print this ") ")
      (.printStat this (.-body tree))
      (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:public visitConditional ^void [this ^JCTree$JCConditional tree]
    (try
      (.open this prec TreeInfo/condPrec)
      (.printExpr this (.-cond tree) (unchecked-add-int TreeInfo/condPrec 1))
      (.print this " ? ")
      (.printExpr this (.-truepart tree))
      (.print this " : ")
      (.printExpr this (.-falsepart tree) TreeInfo/condPrec)
      (.close this prec TreeInfo/condPrec)
      (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:public visitIf ^void [this ^JCTree$JCIf tree]
    (try
      (.print this "if ")
      (if (.hasTag (.-cond tree) JCTree$Tag/PARENS)
          (.printExpr this (.-cond tree))
          (do (.print this \() (.printExpr this (.-cond tree)) (.print this \))))
      (.print this \space)
      (.printStat this (.-thenpart tree))
      (when (some? (.-elsepart tree)) (.print this " else ") (.printStat this (.-elsepart tree)))
      (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:public visitExec ^void [this ^JCTree$JCExpressionStatement tree]
    (try
      (.printExpr this (.-expr tree))
      (when (== prec TreeInfo/notExpression) (.print this \;))
      (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:public visitBreak ^void [this ^JCTree$JCBreak tree]
    (try
      (.print this "break")
      (when (some? (.-label tree)) (.print this \space) (.print this (.-label tree)))
      (.print this \;)
      (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:public visitYield ^void [this ^JCTree$JCYield tree]
    (try
      (.print this "yield")
      (.print this \space)
      (.printExpr this (.-value tree))
      (.print this \;)
      (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:public visitContinue ^void [this ^JCTree$JCContinue tree]
    (try
      (.print this "continue")
      (when (some? (.-label tree)) (.print this \space) (.print this (.-label tree)))
      (.print this \;)
      (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:public visitReturn ^void [this ^JCTree$JCReturn tree]
    (try
      (.print this "return")
      (when (some? (.-expr tree)) (.print this \space) (.printExpr this (.-expr tree)))
      (.print this \;)
      (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:public visitThrow ^void [this ^JCTree$JCThrow tree]
    (try
      (.print this "throw ")
      (.printExpr this (.-expr tree))
      (.print this \;)
      (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:public visitAssert ^void [this ^JCTree$JCAssert tree]
    (try
      (.print this "assert ")
      (.printExpr this (.-cond tree))
      (when (some? (.-detail tree)) (.print this " : ") (.printExpr this (.-detail tree)))
      (.print this \;)
      (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:public visitApply ^void [this ^JCTree$JCMethodInvocation tree]
    (try
      (if (not (.isEmpty (.-typeargs tree)))
          (if (.hasTag (.-meth tree) JCTree$Tag/SELECT)
              (let [left (cast JCTree$JCFieldAccess (.-meth tree))]
                (.printExpr this (.-selected left))
                (.print this ".<")
                (.printExprs this (.-typeargs tree))
                (.print this \>)
                (.print this (.-name left)))
              (do
                (.print this \<)
                (.printExprs this (.-typeargs tree))
                (.print this \>)
                (.printExpr this (.-meth tree))))
          (.printExpr this (.-meth tree)))
      (.print this \()
      (.printExprs this (.-args tree))
      (.print this \))
      (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:public visitNewClass ^void [this ^JCTree$JCNewClass tree]
    (try
      (when (some? (.-encl tree)) (.printExpr this (.-encl tree)) (.print this \.))
      (.print this "new ")
      (when-not (.isEmpty (.-typeargs tree))
        (.print this \<)
        (.printExprs this (.-typeargs tree))
        (.print this \>))
      (when (and (some? (.-def tree)) (.nonEmpty (.-annotations (.-mods (.-def tree)))))
        (.printTypeAnnotations this (.-annotations (.-mods (.-def tree)))))
      (.printExpr this (.-clazz tree))
      (.print this \()
      (.printExprs this (.-args tree))
      (.print this \))
      (when (some? (.-def tree))
        (let [enclClassNamePrev enclClassName]
          (set! enclClassName
                (cond
                  (some? (.-name (.-def tree))) (.-name (.-def tree))
                  (and (some? (.-type tree))
                       (not (identical? (.-name (.-tsym (.-type tree)))
                                        (.-empty
                                          (.-names (.-table (.-name (.-tsym (.-type tree)))))))))
                    (.-name (.-tsym (.-type tree)))))
          (when-not (== (bit-and (.-flags (.-mods (.-def tree))) Flags/ENUM) 0)
            (.print this "/*enum*/"))
          (.printBlock this (.-defs (.-def tree)))
          (set! enclClassName enclClassNamePrev)))
      (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:public visitNewArray ^void [this ^JCTree$JCNewArray tree]
    (try
      (when (some? (.-elemtype tree))
        (.print this "new ")
        (let [^JCTree elem (.-elemtype tree)]
          (.printBaseElementType this elem)
          (when-not (.isEmpty (.-annotations tree))
            (.print this \space)
            (.printTypeAnnotations this (.-annotations tree)))
          (when (some? (.-elems tree)) (.print this "[]"))
          (let [^:mutable ^int i 0
                ^{:tag (List (List JCTree$JCAnnotation))} da (.-dimAnnotations tree)]
            (loop [^{:tag (List JCTree$JCExpression)} l (.-dims tree)]
              (when (.nonEmpty l)
                (when (and (> (.size da) i) (not (.isEmpty (cast List (.get da i)))))
                  (.print this \space)
                  (.printTypeAnnotations this (cast List (.get da i))))
                (.print this \[)
                (set! i (unchecked-inc-int i))
                (.printExpr this (cast JCTree (.-head l)))
                (.print this \])
                (recur (.-tail l))))
            (.printBrackets this elem))))
      (when (some? (.-elems tree))
        (.print this \{)
        (.printExprs this (.-elems tree))
        (.print this \}))
      (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:public visitLambda ^void [this ^JCTree$JCLambda tree]
    (try
      (.print this \()
      (if (identical? (.-paramKind tree) JCTree$JCLambda$ParameterKind/EXPLICIT)
          (.printExprs this (.-params tree))
          (let [^:mutable sep ""]
            (for-each [^JCTree$JCVariableDecl param (.-params tree)]
              (.print this sep)
              (.print this (.-name param))
              (set! sep ","))))
      (.print this ")->")
      (.printExpr this (.-body tree))
      (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:public visitParens ^void [this ^JCTree$JCParens tree]
    (try
      (.print this \()
      (.printExpr this (.-expr tree))
      (.print this \))
      (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:public visitAssign ^void [this ^JCTree$JCAssign tree]
    (try
      (.open this prec TreeInfo/assignPrec)
      (.printExpr this (.-lhs tree) (unchecked-add-int TreeInfo/assignPrec 1))
      (.print this " = ")
      (.printExpr this (.-rhs tree) TreeInfo/assignPrec)
      (.close this prec TreeInfo/assignPrec)
      (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:public operatorName ^String [this ^JCTree$Tag tag]
    (switch tag
      POS "+"
      NEG "-"
      NOT "!"
      COMPL "~"
      PREINC "++"
      PREDEC "--"
      POSTINC "++"
      POSTDEC "--"
      NULLCHK "<*nullchk*>"
      OR "||"
      AND "&&"
      EQ "=="
      NE "!="
      LT "<"
      GT ">"
      LE "<="
      GE ">="
      BITOR "|"
      BITXOR "^"
      BITAND "&"
      SL "<<"
      SR ">>"
      USR ">>>"
      PLUS "+"
      MINUS "-"
      MUL "*"
      DIV "/"
      MOD "%"
      (throw (Error.))))

  (method ^:public visitAssignop ^void [this ^JCTree$JCAssignOp tree]
    (try
      (.open this prec TreeInfo/assignopPrec)
      (.printExpr this (.-lhs tree) (unchecked-add-int TreeInfo/assignopPrec 1))
      (.print this \space)
      (.print this (.operatorName this (.noAssignOp (.getTag tree))))
      (.print this "= ")
      (.printExpr this (.-rhs tree) TreeInfo/assignopPrec)
      (.close this prec TreeInfo/assignopPrec)
      (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:public visitUnary ^void [this ^JCTree$JCUnary tree]
    (try
      (let [ownprec (TreeInfo/opPrec (.getTag tree))
            opname (.operatorName this (.getTag tree))]
        (.open this prec ownprec)
        (if (not (.isPostUnaryOp (.getTag tree)))
            (do (.print this opname) (.printExpr this (.-arg tree) ownprec))
            (do (.printExpr this (.-arg tree) ownprec) (.print this opname)))
        (.close this prec ownprec))
      (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:public visitBinary ^void [this ^JCTree$JCBinary tree]
    (try
      (let [ownprec (TreeInfo/opPrec (.getTag tree))
            opname (.operatorName this (.getTag tree))]
        (.open this prec ownprec)
        (.printExpr this (.-lhs tree) ownprec)
        (.print this \space)
        (.print this opname)
        (.print this \space)
        (.printExpr this (.-rhs tree) (unchecked-add-int ownprec 1))
        (.close this prec ownprec))
      (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:public visitTypeCast ^void [this ^JCTree$JCTypeCast tree]
    (try
      (.open this prec TreeInfo/prefixPrec)
      (.print this \()
      (.printExpr this (.-clazz tree))
      (.print this \))
      (.printExpr this (.-expr tree) TreeInfo/prefixPrec)
      (.close this prec TreeInfo/prefixPrec)
      (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:public visitTypeTest ^void [this ^JCTree$JCInstanceOf tree]
    (try
      (.open this prec TreeInfo/ordPrec)
      (.printExpr this (.-expr tree) TreeInfo/ordPrec)
      (.print this " instanceof ")
      (if (instance? JCTree$JCPattern (.-pattern tree))
          (.printPattern this (.-pattern tree))
          (.printExpr this (.getType tree) (unchecked-add-int TreeInfo/ordPrec 1)))
      (.close this prec TreeInfo/ordPrec)
      (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:public visitIndexed ^void [this ^JCTree$JCArrayAccess tree]
    (try
      (.printExpr this (.-indexed tree) TreeInfo/postfixPrec)
      (.print this \[)
      (.printExpr this (.-index tree))
      (.print this \])
      (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:public visitSelect ^void [this ^JCTree$JCFieldAccess tree]
    (try
      (.printExpr this (.-selected tree) TreeInfo/postfixPrec)
      (.print this \.)
      (.print this (.-name tree))
      (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:public visitReference ^void [this ^JCTree$JCMemberReference tree]
    (try
      (.printExpr this (.-expr tree))
      (.print this "::")
      (when (some? (.-typeargs tree))
        (.print this \<)
        (.printExprs this (.-typeargs tree))
        (.print this \>))
      (.print this
              (if (identical? (.getMode tree) MemberReferenceTree$ReferenceMode/INVOKE)
                  ^Object (.-name tree)
                  "new"))
      (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:public visitIdent ^void [this ^JCTree$JCIdent tree]
    (try (.print this (.-name tree)) (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:public visitLiteral ^void [this ^JCTree$JCLiteral tree]
    (try
      (switch (.-typetag tree)
        INT (.print this (.toString (.-value tree)))
        LONG (do (.print this (.-value tree)) (.print this \L))
        FLOAT (do (.print this (.-value tree)) (.print this \F))
        DOUBLE (.print this (.toString (.-value tree)))
        CHAR
          (do
            (.print this \')
            (.print this
                    (Convert/quote (unchecked-char (.intValue (cast Number (.-value tree)))) true))
            (.print this \'))
        BOOLEAN (.print this (if (== (.intValue (cast Number (.-value tree))) 1) "true" "false"))
        BOT (.print this "null")
        (do
          (.print this \")
          (.print this (Convert/quote (.toString (.-value tree))))
          (.print this \")))
      (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:public visitTypeIdent ^void [this ^JCTree$JCPrimitiveTypeTree tree]
    (try
      (switch (.-typetag tree)
        BYTE (.print this "byte")
        CHAR (.print this "char")
        SHORT (.print this "short")
        INT (.print this "int")
        LONG (.print this "long")
        FLOAT (.print this "float")
        DOUBLE (.print this "double")
        BOOLEAN (.print this "boolean")
        VOID (.print this "void")
        (.print this "error"))
      (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:public visitTypeArray ^void [this ^JCTree$JCArrayTypeTree tree]
    (try
      (.printBaseElementType this tree)
      (.printBrackets this tree)
      (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:private printBaseElementType :throws [IOException] ^void [this ^JCTree tree]
    (.printExpr this (TreeInfo/innermostType tree false)))

  (method ^:private printBrackets :throws [IOException] ^void [this ^JCTree tree]
    (let [^:mutable elem tree]
      (while true
        (when (.hasTag elem JCTree$Tag/ANNOTATED_TYPE)
          (let [atype (cast JCTree$JCAnnotatedType elem)]
            (set! elem (.-underlyingType atype))
            (when (.hasTag elem JCTree$Tag/TYPEARRAY)
              (.print this \space)
              (.printTypeAnnotations this (.-annotations atype)))))
        (if (.hasTag elem JCTree$Tag/TYPEARRAY)
            (do (.print this "[]") (set! elem (.-elemtype (cast JCTree$JCArrayTypeTree elem))))
            (break)))))

  (method ^:public visitTypeApply ^void [this ^JCTree$JCTypeApply tree]
    (try
      (.printExpr this (.-clazz tree))
      (.print this \<)
      (.printExprs this (.-arguments tree))
      (.print this \>)
      (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:public visitTypeUnion ^void [this ^JCTree$JCTypeUnion tree]
    (try
      (.printExprs this (.-alternatives tree) " | ")
      (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:public visitTypeIntersection ^void [this ^JCTree$JCTypeIntersection tree]
    (try
      (.printExprs this (.-bounds tree) " & ")
      (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:public visitTypeParameter ^void [this ^JCTree$JCTypeParameter tree]
    (try
      (when (.nonEmpty (.-annotations tree)) (.printTypeAnnotations this (.-annotations tree)))
      (.print this (.-name tree))
      (when (.nonEmpty (.-bounds tree))
        (.print this " extends ")
        (.printExprs this (.-bounds tree) " & "))
      (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:public visitWildcard ^void [this ^JCTree$JCWildcard tree]
    (try
      (.print this (.-kind tree))
      (when-not (identical? (.-kind (.-kind tree)) BoundKind/UNBOUND)
        (.printExpr this (.-inner tree)))
      (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:public visitTypeBoundKind ^void [this ^JCTree$TypeBoundKind tree]
    (try
      (.print this (String/valueOf (.-kind tree)))
      (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:public visitErroneous ^void [this ^JCTree$JCErroneous tree]
    (try (.print this "(ERROR)") (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:public visitLetExpr ^void [this ^JCTree$LetExpr tree]
    (try
      (.print this "(let ")
      (.print this (.-defs tree))
      (.print this " in ")
      (.print this (.-expr tree))
      (.print this \))
      (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:public visitModifiers ^void [this ^JCTree$JCModifiers mods]
    (try
      (.printAnnotations this (.-annotations mods))
      (.printFlags this (.-flags mods))
      (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:public visitAnnotation ^void [this ^JCTree$JCAnnotation tree]
    (try
      (.print this \@)
      (.printExpr this (.-annotationType tree))
      (when-not (.isEmpty (.-args tree))
        (.print this \()
        (.printExprs this (.-args tree))
        (.print this \)))
      (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:public visitAnnotatedType ^void [this ^JCTree$JCAnnotatedType tree]
    (try
      (cond
        (.hasTag (.-underlyingType tree) JCTree$Tag/SELECT)
          (let [access (cast JCTree$JCFieldAccess (.-underlyingType tree))]
            (.printExpr this (.-selected access) TreeInfo/postfixPrec)
            (.print this \.)
            (.printTypeAnnotations this (.-annotations tree))
            (.print this (.-name access)))
        (.hasTag (.-underlyingType tree) JCTree$Tag/TYPEARRAY)
          (do (.printBaseElementType this tree) (.printBrackets this tree))
        :else
          (do
            (.printTypeAnnotations this (.-annotations tree))
            (.printExpr this (.-underlyingType tree))))
      (catch IOException e (throw (UncheckedIOException. e)))))

  (method ^:public visitTree ^void [this ^JCTree tree]
    (try
      (.print this "(UNKNOWN: ")
      (.print this (.getTag tree))
      (.print this \))
      (.println this)
      (catch IOException e (throw (UncheckedIOException. e))))))

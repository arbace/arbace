  (defclass ^:public ^:static JCCase
    :extends JCStatement
    :implements [CaseTree]

    (field ^:public ^:static ^:final ^CaseTree$CaseKind STATEMENT CaseTree$CaseKind/STATEMENT)

    (field ^:public ^:static ^:final ^CaseTree$CaseKind RULE CaseTree$CaseKind/RULE)

    (field ^:public ^:final ^CaseTree$CaseKind caseKind)

    (field ^:public ^{:tag (List JCCaseLabel)} labels)

    (field ^:public ^JCExpression guard)

    (field ^:public ^{:tag (List JCStatement)} stats)

    (field ^:public ^JCTree body)

    (field ^:public ^boolean completesNormally)

    (constructor ^:protected [this ^CaseTree$CaseKind caseKind ^{:tag (List JCCaseLabel)} labels
                              ^JCExpression guard ^{:tag (List JCStatement)} stats ^JCTree body]
      (Assert/checkNonNull labels)
      (Assert/check (or (.isEmpty labels) (some? (.-head labels))))
      (set! (.-caseKind this) caseKind)
      (set! (.-labels this) labels)
      (set! (.-guard this) guard)
      (set! (.-stats this) stats)
      (set! (.-body this) body))

    (method ^:public accept ^void [this ^Visitor v] (.visitCase v this))

    (method ^:public getKind ^Tree$Kind [this] Tree$Kind/CASE)

    (method ^:public ^{Deprecated true} getExpression ^JCExpression [this]
      (cast JCExpression (.-head (.getExpressions this))))

    (method ^:public getExpressions ^{:tag (List JCExpression)} [this]
      (cast List
            (.collect (.map (.filter (.stream labels)
                                     (lambda Predicate ^boolean [^JCCaseLabel p]
                                       (.hasTag p Tag/CONSTANTCASELABEL)))
                            (lambda Function ^JCExpression [^JCCaseLabel p]
                              (.-expr (cast JCConstantCaseLabel p))))
                      (List/collector))))

    (method ^:public getLabels ^{:tag (List JCCaseLabel)} [this] labels)

    (method ^:public getGuard ^JCExpression [this] guard)

    (method ^:public getStatements ^{:tag (List JCStatement)} [this]
      (when (identical? caseKind CaseTree$CaseKind/STATEMENT) stats))

    (method ^:public getBody ^JCTree [this] body)

    (method ^:public getCaseKind ^CaseTree$CaseKind [this] caseKind)

    (method ^:public accept :type-params [R D] ^R [this ^{:tag (TreeVisitor R D)} v ^D d]
      (.visitCase v this d))

    (method ^:public getTag ^Tag [this] Tag/CASE))


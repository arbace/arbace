                                     ^JCExpression defaultValue])

    (method VarDef ^JCVariableDecl [this ^JCModifiers mods ^Name name ^JCExpression vartype
                                    ^JCExpression init])

    (method Skip ^JCSkip [this])

    (method Block ^JCBlock [this ^long flags ^{:tag (List JCStatement)} stats])

    (method DoLoop ^JCDoWhileLoop [this ^JCStatement body ^JCExpression cond])

    (method WhileLoop ^JCWhileLoop [this ^JCExpression cond ^JCStatement body])

    (method ForLoop ^JCForLoop [this ^{:tag (List JCStatement)} init ^JCExpression cond
                                ^{:tag (List JCExpressionStatement)} step ^JCStatement body])

    (method ForeachLoop ^JCEnhancedForLoop [this ^JCVariableDecl var ^JCExpression expr
                                            ^JCStatement body])

    (method Labelled ^JCLabeledStatement [this ^Name label ^JCStatement body])

    (method Switch ^JCSwitch [this ^JCExpression selector ^{:tag (List JCCase)} cases])

    (method SwitchExpression ^JCSwitchExpression [this ^JCExpression selector
                                                  ^{:tag (List JCCase)} cases])

    (method Case ^JCCase [this ^CaseTree$CaseKind caseKind ^{:tag (List JCCaseLabel)} labels
                          ^JCExpression guard ^{:tag (List JCStatement)} stats ^JCTree body])

    (method Synchronized ^JCSynchronized [this ^JCExpression lock ^JCBlock body])

    (method Try ^JCTry [this ^JCBlock body ^{:tag (List JCCatch)} catchers ^JCBlock finalizer])

    (method Try ^JCTry [this ^{:tag (List JCTree)} resources ^JCBlock body
                        ^{:tag (List JCCatch)} catchers ^JCBlock finalizer])

    (method Catch ^JCCatch [this ^JCVariableDecl param ^JCBlock body])

    (method Conditional ^JCConditional [this ^JCExpression cond ^JCExpression thenpart
                                        ^JCExpression elsepart])

    (method If ^JCIf [this ^JCExpression cond ^JCStatement thenpart ^JCStatement elsepart])

    (method Exec ^JCExpressionStatement [this ^JCExpression expr])

    (method Break ^JCBreak [this ^Name label])

    (method Yield ^JCYield [this ^JCExpression value])

    (method Continue ^JCContinue [this ^Name label])

    (method Return ^JCReturn [this ^JCExpression expr])

    (method Throw ^JCThrow [this ^JCExpression expr])

    (method Assert ^JCAssert [this ^JCExpression cond ^JCExpression detail])

    (method Apply ^JCMethodInvocation [this ^{:tag (List JCExpression)} typeargs ^JCExpression fn
                                       ^{:tag (List JCExpression)} args])

    (method NewClass ^JCNewClass [this ^JCExpression encl ^{:tag (List JCExpression)} typeargs
                                  ^JCExpression clazz ^{:tag (List JCExpression)} args
                                  ^JCClassDecl def])

    (method NewArray ^JCNewArray [this ^JCExpression elemtype ^{:tag (List JCExpression)} dims
                                  ^{:tag (List JCExpression)} elems])

    (method Parens ^JCParens [this ^JCExpression expr])

    (method Assign ^JCAssign [this ^JCExpression lhs ^JCExpression rhs])

    (method Assignop ^JCAssignOp [this ^Tag opcode ^JCTree lhs ^JCTree rhs])

    (method Unary ^JCUnary [this ^Tag opcode ^JCExpression arg])

    (method Binary ^JCBinary [this ^Tag opcode ^JCExpression lhs ^JCExpression rhs])

    (method TypeCast ^JCTypeCast [this ^JCTree expr ^JCExpression type])

    (method TypeTest ^JCInstanceOf [this ^JCExpression expr ^JCTree clazz])

    (method BindingPattern ^JCBindingPattern [this ^JCVariableDecl var])

    (method Indexed ^JCArrayAccess [this ^JCExpression indexed ^JCExpression index])

    (method Select ^JCFieldAccess [this ^JCExpression selected ^Name selector])

    (method Ident ^JCIdent [this ^Name idname])

    (method Literal ^JCLiteral [this ^TypeTag tag value])

    (method TypeIdent ^JCPrimitiveTypeTree [this ^TypeTag typetag])

    (method TypeArray ^JCArrayTypeTree [this ^JCExpression elemtype])

    (method TypeApply ^JCTypeApply [this ^JCExpression clazz ^{:tag (List JCExpression)} arguments])

    (method TypeParameter ^JCTypeParameter [this ^Name name ^{:tag (List JCExpression)} bounds])

    (method Wildcard ^JCWildcard [this ^TypeBoundKind kind ^JCTree type])

    (method TypeBoundKind ^TypeBoundKind [this ^BoundKind kind])

    (method Annotation ^JCAnnotation [this ^JCTree annotationType ^{:tag (List JCExpression)} args])

    (method Modifiers ^JCModifiers [this ^long flags ^{:tag (List JCAnnotation)} annotations])

    (method Erroneous ^JCErroneous [this ^{:tag (List (? extends JCTree))} errs])

    (method ModuleDef ^JCModuleDecl [this ^JCModifiers mods ^ModuleTree$ModuleKind kind

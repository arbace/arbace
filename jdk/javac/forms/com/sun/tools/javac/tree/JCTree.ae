  (defclass ^:public ^:static JCLiteral
    :extends JCExpression
    :implements [LiteralTree]

    (field ^:public ^TypeTag typetag)

    (field ^:public value)

    (constructor ^:protected [this ^TypeTag typetag value]
      (set! (.-typetag this) typetag)
      (set! (.-value this) value))

    (method ^:public accept ^void [this ^Visitor v] (.visitLiteral v this))

    (method ^:public getKind ^Tree$Kind [this] (.getKindLiteral typetag))

    (method ^:public getValue [this]
      (switch typetag
        BOOLEAN (let [^int bi (cast Integer value)] (not (== bi 0)))
        CHAR
          (let [^int ci (cast Integer value)
                c (unchecked-char ci)]
            (when-not (== c ci) (throw (AssertionError. "bad value for char literal")))
            c)
        value))

    (method ^:public accept :type-params [R D] ^R [this ^{:tag (TreeVisitor R D)} v ^D d]
      (.visitLiteral v this d))

    (method ^:public setType ^JCLiteral [this ^Type type]
      (.setType super type)
      this)

    (method ^:public getTag ^Tag [this] Tag/LITERAL))


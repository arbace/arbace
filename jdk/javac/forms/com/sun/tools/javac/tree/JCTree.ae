    (method Exports ^JCExports [this ^JCExpression qualId ^{:tag (List JCExpression)} moduleNames])

    (method Opens ^JCOpens [this ^JCExpression qualId ^{:tag (List JCExpression)} moduleNames])

    (method Provides ^JCProvides [this ^JCExpression serviceName

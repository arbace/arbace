    (constructor :throws [MarshalException] [this ^Element elem]
      (super. elem))

    (method unmarshalKeyValue :throws [MarshalException] ^PublicKey [this ^Element kvElem]
      (set! externalPublicKey (javax.xml.crypto.dom.DOMStructure. kvElem))
      nil)

    (method marshalPublicKey :throws [MarshalException] ^void [this ^Node parent ^Document doc
                                                               ^String dsPrefix
                                                               ^DOMCryptoContext context]
      (.appendChild parent (.getNode externalPublicKey)))))

(defclass ^:public ^:final Utils
  (field ^:private ^:static ^:final ^Logger LOG (LoggerFactory/getLogger Utils))

  (field ^:private ^:static ^:final ^String SECVAL_PROP_NAME "org.jcp.xml.dsig.secureValidation")

  (field ^:private ^:static ^:final ^boolean SECVAL_SYSPROP_SET)

  (field ^:private ^:static ^:final ^boolean SECVAL_SYSPROP)


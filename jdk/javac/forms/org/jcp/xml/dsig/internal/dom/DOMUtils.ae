                                     XPathFilterParameterSpec
                                     XPathType
                                     XSLTTransformParameterSpec)
        '(org.w3c.dom Document Element Node))

(defclass ^:public ^:final DOMUtils
  (constructor ^:private [this])

  (method ^:public ^:static getOwnerDocument ^Document [^Node node]
    (if (== (.getNodeType node) Node/DOCUMENT_NODE) (cast Document node) (.getOwnerDocument node)))

  (method ^:public ^:static getQNameString ^String [^String prefix ^String localName]
    (let [^String qName (if (or (nil? prefix) (== (.length prefix) 0))
                            localName
                            (java-str prefix ":" localName))]
      qName))

  (method ^:public ^:static createElement ^Element [^Document doc ^String tag ^String nsURI
                                                    ^String prefix]
    (let [^String qName (if (or (nil? prefix) (== (.length prefix) 0))
                            tag
                            (java-str prefix ":" tag))]
      (.createElementNS doc nsURI qName)))

  (method ^:public ^:static setAttribute ^void [^Element elem ^String name ^String value]
    (when (some? value) (.setAttributeNS elem nil name value)))

  (method ^:public ^:static setAttributeID ^void [^Element elem ^String name ^String value]
    (when (some? value)
      (.setAttributeNS elem nil name value)
      (.setIdAttributeNS elem nil name true)))

  (method ^:public ^:static getFirstChildElement ^Element [^Node node]
    (let [^:mutable child (.getFirstChild node)]
      (while (and (some? child) (not (== (.getNodeType child) Node/ELEMENT_NODE)))
        (set! child (.getNextSibling child)))
      (cast Element child)))

  (method ^:public ^:static getFirstChildElement :throws [MarshalException] ^Element [^Node node
                                                                                      ^String localName
                                                                                      ^String namespaceURI]
    (DOMUtils/verifyElement (DOMUtils/getFirstChildElement node) localName namespaceURI))

  (method ^:private ^:static verifyElement :throws [MarshalException] ^Element [^Element elem
                                                                                ^String localName
                                                                                ^String namespaceURI]
    (when (nil? elem) (throw (MarshalException. (java-str "Missing " localName " element"))))
    (let [name (.getLocalName elem)
          namespace (.getNamespaceURI elem)]
      (when (or (or (not (.equals name localName)) (and (nil? namespace) (some? namespaceURI)))
                (and (some? namespace) (not (.equals namespace namespaceURI))))
        (throw (MarshalException.
                 (java-str "Invalid element name: "
                           namespace
                           ":"
                           name
                           ", expected "
                           namespaceURI
                           ":"
                           localName))))
      elem))

  (method ^:public ^:static getLastChildElement ^Element [^Node node]
    (let [^:mutable child (.getLastChild node)]
      (while (and (some? child) (not (== (.getNodeType child) Node/ELEMENT_NODE)))
        (set! child (.getPreviousSibling child)))
      (cast Element child)))

  (method ^:public ^:static getNextSiblingElement ^Element [^Node node]
    (let [^:mutable sibling (.getNextSibling node)]
      (while (and (some? sibling) (not (== (.getNodeType sibling) Node/ELEMENT_NODE)))
        (set! sibling (.getNextSibling sibling)))
      (cast Element sibling)))

  (method ^:public ^:static getNextSiblingElement :throws [MarshalException] ^Element [^Node node
                                                                                       ^String localName
                                                                                       ^String namespaceURI]
    (DOMUtils/verifyElement (DOMUtils/getNextSiblingElement node) localName namespaceURI))

  (method ^:public ^:static getAttributeValue ^String [^Element elem ^String name]
    (let [attr (.getAttributeNodeNS elem nil name)] (when (some? attr) (.getValue attr))))

  (method ^:public ^:static getIdAttributeValue :type-params [N] ^String [^Element elem ^String name]
    (let [attr (.getAttributeNodeNS elem nil name)]
      (when (and (some? attr) (not (.isId attr))) (.setIdAttributeNode elem attr true))
      (when (some? attr) (.getValue attr))))

  (method ^:public ^:static getNSPrefix ^String [^XMLCryptoContext context ^String nsURI]
    (when (some? context) (.getNamespacePrefix context nsURI (.getDefaultNamespacePrefix context))))

  (method ^:public ^:static getSignaturePrefix ^String [^XMLCryptoContext context]
    (DOMUtils/getNSPrefix context XMLSignature/XMLNS))

  (method ^:public ^:static removeAllChildren ^void [^Node node]
    (let [^:mutable firstChild (.getFirstChild node)]
      (while (some? firstChild)
        (let [nodeToRemove firstChild]
          (set! firstChild (.getNextSibling firstChild))
          (.removeChild node nodeToRemove)))))

  (method ^:public ^:static nodesEqual ^boolean [^Node thisNode ^Node otherNode]
    (.isEqualNode thisNode otherNode))

  (method ^:public ^:static appendChild ^void [^Node parent ^Node child]
    (let [ownerDoc (DOMUtils/getOwnerDocument parent)]
      (if (not (identical? (.getOwnerDocument child) ownerDoc))
          (.appendChild parent (.importNode ownerDoc child true))
          (.appendChild parent child))))

  (method ^:public ^:static paramsEqual ^boolean [^AlgorithmParameterSpec spec1
                                                  ^AlgorithmParameterSpec spec2]
    (cond
      (identical? spec1 spec2) true
      (and (instance? XPathFilter2ParameterSpec spec1) (instance? XPathFilter2ParameterSpec spec2))
        (DOMUtils/paramsEqual (cast XPathFilter2ParameterSpec spec1)
                              (cast XPathFilter2ParameterSpec spec2))
      (and (instance? ExcC14NParameterSpec spec1) (instance? ExcC14NParameterSpec spec2))
        (DOMUtils/paramsEqual (cast ExcC14NParameterSpec spec1) (cast ExcC14NParameterSpec spec2))
      (and (instance? XPathFilterParameterSpec spec1) (instance? XPathFilterParameterSpec spec2))
        (DOMUtils/paramsEqual (cast XPathFilterParameterSpec spec1)
                              (cast XPathFilterParameterSpec spec2))
      (and (instance? XSLTTransformParameterSpec spec1)
           (instance? XSLTTransformParameterSpec spec2))
        (DOMUtils/paramsEqual (cast XSLTTransformParameterSpec spec1)
                              (cast XSLTTransformParameterSpec spec2))
      :else false))

  (method ^:private ^:static paramsEqual ^boolean [^XPathFilter2ParameterSpec spec1
                                                   ^XPathFilter2ParameterSpec spec2]
    (let [^{:tag (List XPathType)} types (.getXPathList spec1)
          ^{:tag (List XPathType)} otypes (.getXPathList spec2)
          size (.size types)]
      (if (not (== size (.size otypes)))
          false
          (do
            (loop [^int i 0]
              (when (< i size)
                (let [type (cast XPathType (.get types i))
                      otype (cast XPathType (.get otypes i))]
                  (if (or (or (not (.equals (.getExpression type) (.getExpression otype)))
                              (not (.equals (.getNamespaceMap type) (.getNamespaceMap otype))))
                          (not (identical? (.getFilter type) (.getFilter otype))))
                      (return false)
                      (recur (unchecked-inc-int i))))))
            true))))

  (method ^:private ^:static paramsEqual ^boolean [^ExcC14NParameterSpec spec1
                                                   ^ExcC14NParameterSpec spec2]
    (.equals (.getPrefixList spec1) (.getPrefixList spec2)))

  (method ^:private ^:static paramsEqual ^boolean [^XPathFilterParameterSpec spec1
                                                   ^XPathFilterParameterSpec spec2]
    (and (.equals (.getXPath spec1) (.getXPath spec2))
         (.equals (.getNamespaceMap spec1) (.getNamespaceMap spec2))))

  (method ^:private ^:static paramsEqual ^boolean [^XSLTTransformParameterSpec spec1
                                                   ^XSLTTransformParameterSpec spec2]
    (let [ostylesheet (.getStylesheet spec2)]
      (if (not (instance? javax.xml.crypto.dom.DOMStructure ostylesheet))
          false
          (let [ostylesheetElem (.getNode (cast javax.xml.crypto.dom.DOMStructure ostylesheet))
                stylesheet (.getStylesheet spec1)
                stylesheetElem (.getNode (cast javax.xml.crypto.dom.DOMStructure stylesheet))]
            (DOMUtils/nodesEqual stylesheetElem ostylesheetElem)))))

  (method ^:public ^:static isNamespace ^boolean [^Node node]
    (if (== Node/ATTRIBUTE_NODE (.getNodeType node))
        (let [^:final namespaceURI (.getNamespaceURI node)]
          (.equals XMLConstants/XMLNS_ATTRIBUTE_NS_URI namespaceURI))
        false)))

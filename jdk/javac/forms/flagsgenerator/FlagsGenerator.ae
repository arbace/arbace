                                           (TreePath. cut)
                                           (cast Tree (.get (.getTypeDecls cut) 0)))))
                ^{:tag (Map Integer (List String))} flag2Names (TreeMap.)
                ^{:tag (Map FlagTarget (Map Integer (List String)))} target2FlagBit2Fields (EnumMap.
                                                                                             FlagTarget)
                ^{:tag (Map String String)} customToString (HashMap.)
                ^{:tag (Set String)} noToString (HashSet.)]
            (for-each [^VariableElement field (ElementFilter/fieldsIn (.getEnclosedElements clazz))]
              (let [flagName (.toString (.getSimpleName field))]
                (for-each [^AnnotationMirror am (.getAnnotationMirrors field)]
                  (switch (.toString (.getAnnotationType am))
                    "com.sun.tools.javac.code.Flags.Use"
                      (let [flagValue (.longValue (cast Number (.getConstantValue field)))
                            flagBit (unchecked-subtract-int
                                      63
                                      (Long/numberOfLeadingZeros flagValue))]
                        (.add (cast List
                                    (.computeIfAbsent
                                      flag2Names
                                      flagBit
                                      (lambda Function ^List [^Integer _] (ArrayList.))))
                              flagName)
                        (let [^{:tag (List ?)} originalTargets (cast
                                                                 List
                                                                 (FlagsGenerator/valueOfValueAttribute
                                                                   am))]
                          (.forEach (.map (.stream originalTargets)
                                          (lambda Function ^FlagTarget [value]
                                            (FlagTarget/valueOf (.toString value))))
                                    (lambda Consumer ^void [^FlagTarget target]
                                      (.add (cast
                                              List
                                              (.computeIfAbsent
                                                (cast
                                                  Map
                                                  (.computeIfAbsent
                                                    target2FlagBit2Fields
                                                    target
                                                    (lambda Function ^Map [^FlagTarget _]
                                                      (HashMap.))))
                                                flagBit
                                                (lambda Function ^List [^Integer _] (ArrayList.))))
                                            flagName)))))
                    "com.sun.tools.javac.code.Flags.CustomToStringValue"
                      (.put customToString
                            flagName
                            (cast String (FlagsGenerator/valueOfValueAttribute am)))
                    "com.sun.tools.javac.code.Flags.NoToStringValue" (.add noToString flagName)))))
            (for-each [^{:tag (Map$Entry FlagTarget (Map Integer (List String)))} targetAndFlag
                         (.entrySet target2FlagBit2Fields)]
              (for-each [^{:tag (Map$Entry Integer (List String))} flagAndFields (.entrySet
                                                                                   (cast
                                                                                     Map
                                                                                     (.getValue
                                                                                       targetAndFlag)))]
                (when (> (.size (cast List (.getValue flagAndFields))) 1)
                  (throw (AssertionError.
                           (java-str "duplicate flag for target: "
                                     (.getKey targetAndFlag)
                                     ", flag: "
                                     (.getKey flagAndFields)
                                     ", flags fields: "
                                     (.getValue flagAndFields)))))))
            (with-resources [out (PrintWriter. (Files/newBufferedWriter
                                                 (Paths/get (aget args 1) (new String/1 []))
                                                 (new OpenOption/1 [])))]
              (.println out "package com.sun.tools.javac.code;\n\npublic enum FlagsEnum {\n")
              (for-each [^{:tag (Map$Entry Integer (List String))} e (.entrySet flag2Names)]
                (let [constantName (cast String
                                         (.collect
                                           (.stream (cast List (.getValue e)))
                                           (Collectors/joining "_OR_")))
                      toString (cast String
                                     (.collect (.map
                                                 (.filter
                                                   (.stream (cast List (.getValue e)))
                                                   (lambda Predicate ^boolean [^String n]
                                                     (not (.contains noToString n))))
                                                 (lambda Function ^String [^String n]
                                                   (cast
                                                     String
                                                     (.getOrDefault
                                                       customToString
                                                       n
                                                       (.toLowerCase n Locale/US)))))
                                               (Collectors/joining " or ")))]
                  (.println out
                            (java-str "    "
                                      constantName
                                      "(1L<<"
                                      (.getKey e)
                                      ", \""
                                      toString
                                      "\"),"))))
              (.println
                out
                "    ;\n\n    private final long value;\n    private final String toString;\n    private FlagsEnum(long value, String toString) {\n        this.value = value;\n        this.toString = toString;\n    }\n    public long value() {\n        return value;\n    }\n    public String toString() {\n        return toString;\n    }\n}\n")))))))

  (method ^:private ^:static valueOfValueAttribute [^AnnotationMirror am]
    (.getValue (cast AnnotationValue (.next (.iterator (.values (.getElementValues am)))))))

  (defclass ^:private ^:enum FlagTarget
    (constants BLOCK CLASS METHOD MODULE PACKAGE TYPE_VAR VARIABLE)))

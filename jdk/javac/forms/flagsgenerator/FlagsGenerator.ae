(defclass ^:public FlagsGenerator
  (method ^:public ^:static main :throws [IOException] ^void [& ^String/1 args]
    (let [compiler (ToolProvider/getSystemJavaCompiler)]
      (with-resources [fm (.getStandardFileManager compiler nil nil nil)]
        (let [task (cast JavacTask
                         (.getTask compiler
                                   nil
                                   nil
                                   (lambda DiagnosticListener ^void [^Diagnostic d])
                                   nil
                                   nil
                                   (.getJavaFileObjects fm (new String/1 [(aget args 0)]))))
              trees (Trees/instance task)
              cut (cast CompilationUnitTree (.next (.iterator (.parse task))))]
          (.analyze task)
          (let [clazz (cast TypeElement
                            (.getElement trees

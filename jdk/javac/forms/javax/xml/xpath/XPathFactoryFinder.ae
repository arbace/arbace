  (method ^:private _newFactory :throws [XPathFactoryConfigurationException] ^XPathFactory [this
                                                                                            ^String uri]
    (let [^:mutable ^XPathFactory xpathFactory nil
          propertyName (java-str (.getName SERVICE_CLASS) ":" uri)]
      (try
        (XPathFactoryFinder/debugPrintln
          (lambda Supplier ^String [] (java-str "Looking up system property '" propertyName "'")))
        (let [r (System/getProperty propertyName)]

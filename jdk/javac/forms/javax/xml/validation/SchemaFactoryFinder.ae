          (SchemaFactoryFinder/debugPrintln
            (lambda Supplier ^String [] (java-str "unable to find a factory for " schemaLanguage))))
      f))

  (method ^:private _newFactory ^SchemaFactory [this ^String schemaLanguage]
    (let [^:mutable ^SchemaFactory sf nil
          propertyName (java-str (.getName SERVICE_CLASS) ":" schemaLanguage)]
      (try
        (SchemaFactoryFinder/debugPrintln
          (lambda Supplier ^String [] (java-str "Looking up system property '" propertyName "'")))
        (let [r (System/getProperty propertyName)]

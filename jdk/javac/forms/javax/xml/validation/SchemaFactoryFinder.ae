(defclass SchemaFactoryFinder
  (field ^:private ^:static ^boolean debug false)

  (field ^:private ^:static ^:final ^String DEFAULT_PACKAGE "com.sun.org.apache.xerces.internal")

  (static-initializer (set! debug (some? (System/getProperty "jaxp.debug"))))

  (method ^:private ^:static debugPrintln ^void [^{:tag (Supplier String)} msgGen]
    (when debug (.println System/err (java-str "JAXP: " (cast String (.get msgGen))))))

  (field ^:private ^:final ^ClassLoader classLoader)


(in-ns 'javax.xml.catalog)

(import '(java.io File IOException)
        '(java.net MalformedURLException URI URL)
        '(java.util Iterator)
        '(java.util.jar JarFile)
        '(jdk.xml.internal SecuritySupport))

(defclass Util
  (field ^:static ^:final ^String URN "urn:publicid:")

  (field ^:static ^:final ^String PUBLICID_PREFIX "-//")

  (field ^:static ^:final ^String PUBLICID_PREFIX_ALT "+//")

  (field ^:static ^:final ^String SCHEME_FILE "file")

  (field ^:static ^:final ^String SCHEME_JAR "jar")

  (field ^:static ^:final ^String SCHEME_JARFILE "jar:file:")

  (method ^:static resolve ^String [^CatalogImpl catalog ^String publicId ^String systemId]
    (.reset catalog)
    (let [^:mutable resolvedSystemId (.resolve catalog publicId systemId)]
      (.markAsSearched catalog)
      (when (nil? resolvedSystemId)
        (let [^{:tag (Iterator Catalog)} iter (.iterator (.catalogs catalog))]
          (while (.hasNext iter)
            (set! resolvedSystemId (Util/resolve (cast CatalogImpl (.next iter)) publicId systemId))
            (when (some? resolvedSystemId) (break)))))
      resolvedSystemId))

  (method ^:static validateUrisSyntax ^void [& ^URI/1 uris]
    (for-each [^URI uri uris] (Util/validateUriSyntax uri)))

  (method ^:static validateUrisSyntax ^void [& ^String/1 uris]
    (for-each [^String uri uris] (Util/validateUriSyntax (URI/create uri))))

  (method ^:static validateUriSyntax ^void [^URI uri]
    (CatalogMessages/reportNPEOnNull "URI input" uri)
    (when-not (.isAbsolute uri)
      (CatalogMessages/reportIAE CatalogMessages/ERR_URI_NOTABSOLUTE (new Object/1 [uri]) nil))
    (try
      (.toURL uri)
      (catch MalformedURLException ex
        (CatalogMessages/reportIAE CatalogMessages/ERR_URI_NOTVALIDURL (new Object/1 [uri]) nil))))

  (method ^:static isFileUri ^boolean [^URI uri]
    (if (or (.equals SCHEME_FILE (.getScheme uri)) (.equals SCHEME_JAR (.getScheme uri)))
        true
        false))

  (method ^:static isFileUriExist ^boolean [^URI uri ^boolean openJarFile]
    (when (and (some? uri) (.isAbsolute uri))
      (when (some? (.getScheme uri))
        (switch (.getScheme uri)
          SCHEME_FILE
            (let [path (.getPath uri)
                  f1 (File. path)]
              (when (SecuritySupport/isFile f1) (return true)))
          SCHEME_JAR
            (let [tempUri (.toString uri)
                  pos (.indexOf tempUri "!")]
              (when (< pos 0) (return false))
              (if openJarFile
                  (let [jarFile (.substring tempUri (.length SCHEME_JARFILE) pos)
                        entryName (.substring tempUri (unchecked-add-int pos 2))]
                    (try
                      (let [jf (JarFile. jarFile)
                            je (.getJarEntry jf entryName)]
                        (when (some? je) (return true)))
                      (catch IOException ex (return false))))
                  (return true))))))
    false)

  (method ^:static getCatalogFiles ^String/1 [^String sysPropertyName]
    (let [value (SecuritySupport/getJAXPSystemProperty sysPropertyName)]
      (when (and (some? value) (not (.isEmpty value))) (.split value ";"))))

  (method ^:static getNotNullOrEmpty ^String [^String test]
    (if (nil? test) test (let [temp (.trim test)] (when-not (== (.length temp) 0) temp))))

  (method ^:static validateFeatureInput ^void [^CatalogFeatures$Feature f ^String value]
    (CatalogMessages/reportNPEOnNull (.name f) value)
    (when (== (.length value) 0)
      (CatalogMessages/reportIAE CatalogMessages/ERR_INVALID_ARGUMENT
                                 (new Object/1 [value (.name f)])
                                 nil))
    (cond
      (identical? f CatalogFeatures$Feature/PREFER)
        (when (and (not (.equals value CatalogFeatures/PREFER_SYSTEM))
                   (not (.equals value CatalogFeatures/PREFER_PUBLIC)))
          (CatalogMessages/reportIAE CatalogMessages/ERR_INVALID_ARGUMENT
                                     (new Object/1 [value (.name CatalogFeatures$Feature/PREFER)])
                                     nil))
      (identical? f CatalogFeatures$Feature/DEFER)
        (when (and (not (.equals value CatalogFeatures/DEFER_TRUE))
                   (not (.equals value CatalogFeatures/DEFER_FALSE)))
          (CatalogMessages/reportIAE CatalogMessages/ERR_INVALID_ARGUMENT
                                     (new Object/1 [value (.name CatalogFeatures$Feature/DEFER)])
                                     nil))
      (identical? f CatalogFeatures$Feature/RESOLVE)
        (when (and (and (not (.equals value CatalogFeatures/RESOLVE_STRICT))
                        (not (.equals value CatalogFeatures/RESOLVE_CONTINUE)))
                   (not (.equals value CatalogFeatures/RESOLVE_IGNORE)))
          (CatalogMessages/reportIAE CatalogMessages/ERR_INVALID_ARGUMENT
                                     (new Object/1 [value (.name CatalogFeatures$Feature/RESOLVE)])
                                     nil))
      (identical? f CatalogFeatures$Feature/FILES) (Util/validateUrisSyntax (.split value ";"))))

  (method ^:static getAbsoluteURI ^String [^String base ^String uri]
    (let [^:mutable temp ""]
      (try
        (let [baseURL (URL. base)
              specURI (URI/create uri)]
          (if (.isAbsolute specURI)
              (set! temp (.toString (.toURL specURI)))
              (set! temp (.toString (URL. baseURL uri)))))
        (catch MalformedURLException ex
          (CatalogMessages/reportError CatalogMessages/ERR_INVALID_CATALOG)))
      temp)))

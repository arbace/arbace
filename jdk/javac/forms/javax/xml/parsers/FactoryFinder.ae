(in-ns 'javax.xml.parsers)

(import '(java.util Iterator ServiceConfigurationError ServiceLoader)
        '(java.util.function Supplier)
        '(jdk.xml.internal SecuritySupport))

(defclass FactoryFinder
  (field ^:private ^:static ^:final ^String DEFAULT_PACKAGE "com.sun.org.apache.xerces.internal")

  (field ^:private ^:static ^boolean debug false)

  (static-initializer
    (let [val (System/getProperty "jaxp.debug")]
      (set! debug (and (some? val) (not (.equals "false" val))))))

  (method ^:private ^:static dPrint ^void [^{:tag (Supplier String)} msgGen]
    (when debug (.println System/err (java-str "JAXP: " (cast String (.get msgGen))))))

  (method ^:private ^:static getProviderClass :throws [ClassNotFoundException] ^{:tag (Class ?)} [^String className
                                                                                                  ^:mutable ^ClassLoader cl
                                                                                                  ^boolean doFallback
                                                                                                  ^boolean useBSClsLoader]
    (try
      (if (nil? cl)
          (if useBSClsLoader
              (Class/forName className false (.getClassLoader FactoryFinder))
              (do
                (set! cl (SecuritySupport/getContextClassLoader))
                (if (nil? cl) (throw (ClassNotFoundException.)) (Class/forName className false cl))))
          (Class/forName className false cl))
      (catch ClassNotFoundException e1
        (if doFallback (Class/forName className false (.getClassLoader FactoryFinder)) (throw e1)))))

  (method ^:static newInstance :type-params [T] :throws [FactoryConfigurationError] ^T [^{:tag (Class T)} type
                                                                                        ^String className
                                                                                        ^ClassLoader cl
                                                                                        ^boolean doFallback]
    (FactoryFinder/newInstance type className cl doFallback false))

  (method ^:static newInstance :type-params [T] :throws [FactoryConfigurationError] ^T [^{:tag (Class T)} type
                                                                                        ^String className
                                                                                        ^ClassLoader cl
                                                                                        ^boolean doFallback
                                                                                        ^boolean useBSClsLoader]
    (java-assert (some? type))
    (try
      (let [^{:tag (Class ?)} providerClass (FactoryFinder/getProviderClass
                                              className
                                              cl
                                              doFallback
                                              useBSClsLoader)]
        (when-not (.isAssignableFrom type providerClass)
          (throw (ClassCastException. (java-str className " cannot be cast to " (.getName type)))))
        (let [instance (.newInstance (.getConstructor providerClass))
              clD cl]
          (FactoryFinder/dPrint
            (lambda Supplier ^String []
              (java-str "created new instance of " providerClass " using ClassLoader: " clD)))
          (.cast type instance)))
      (catch ClassNotFoundException x
        (throw (FactoryConfigurationError. x (java-str "Provider " className " not found"))))
      (catch Exception x
        (throw (FactoryConfigurationError. x
                                           (java-str
                                             "Provider "
                                             className
                                             " could not be instantiated: "
                                             x))))))

  (method ^:static find :type-params [T] :throws [FactoryConfigurationError] ^T [^{:tag (Class T)} type
                                                                                 ^String fallbackClassName]
    (let [factoryId (.getName type)]
      (FactoryFinder/dPrint (lambda Supplier ^String [] (java-str "find factoryId =" factoryId)))
      (let [systemProp (System/getProperty factoryId)]
        (if (some? systemProp)
            (do
              (FactoryFinder/dPrint
                (lambda Supplier ^String [] (java-str "found system property, value=" systemProp)))
              (FactoryFinder/newInstance type systemProp nil true))
            (let [factoryClassName (SecuritySupport/readConfig factoryId)]
              (if (some? factoryClassName)
                  (FactoryFinder/newInstance type factoryClassName nil true)
                  (let [^T provider (FactoryFinder/findServiceProvider type)]
                    (if (some? provider)
                        provider
                        (do
                          (when (nil? fallbackClassName)
                            (throw (FactoryConfigurationError.
                                     (java-str "Provider for " factoryId " cannot be found"))))
                          (FactoryFinder/dPrint
                            (lambda Supplier ^String []
                              (java-str "loaded from fallback value: " fallbackClassName)))
                          (FactoryFinder/newInstance type fallbackClassName nil true))))))))))

  (method ^:private ^:static findServiceProvider :type-params [T] ^T [^:final ^{:tag (Class T)} type]
    (try
      (let [^{:tag (ServiceLoader T)} serviceLoader (ServiceLoader/load type)
            ^{:tag (Iterator T)} iterator (.iterator serviceLoader)]
        (when (.hasNext iterator) (.next iterator)))
      (catch ServiceConfigurationError e
        (let [x (RuntimeException. (java-str "Provider for " type " cannot be created") e)
              error (FactoryConfigurationError. x (.getMessage x))]
          (throw error))))))

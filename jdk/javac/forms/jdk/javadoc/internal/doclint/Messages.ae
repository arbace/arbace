  (method localize ^String [this ^String code & ^Object/1 args]
    (let [^:mutable msg (.getString bundle code)]
      (when (nil? msg)
        (let [sb (StringBuilder.)]
          (.append (.append sb "message file broken: code=") code)
          (when (> (alength args) 0)
            (.append sb " arguments={0}")

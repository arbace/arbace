                    (catch MissingResourceException ex (set! msg code)))
                  (.put codeTable msg (.intValue (cast Integer (.getValue e))))))
              (.print codeTable out))))))

    (defclass ^:private ^:static Table
      (field ^:private ^:static ^:final ^{:tag (Comparator Integer)} DECREASING

        (let [i (cast Integer (.get codeCounts code))]
          (.put codeCounts code ^Integer (Integer/valueOf (if (nil? i) 1 (unchecked-add-int i 1)))))))

    (method report ^void [this ^PrintWriter out]
      (when (some? codeCounts)
        (.println out "By group...")
        (let [groupTable (Table.)]
          (for-each [^Group g (Group/values)]
            (.put groupTable (.optName g) (aget groupCounts (.ordinal g))))
          (.print groupTable out)
          (.println out)
          (.println out "By diagnostic kind...")
          (let [dkindTable (Table.)]
            (for-each [^Diagnostic$Kind k (Diagnostic$Kind/values)]
              (.put dkindTable
                    (StringUtils/toLowerCase (.toString k))
                    (aget dkindCounts (.ordinal k))))
            (.print dkindTable out)
            (.println out)
            (.println out "By message kind...")

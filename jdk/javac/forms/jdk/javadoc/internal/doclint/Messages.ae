      (MessageFormat/format msg args)))

  (defclass ^:static Options
    (field ^:private ^:final ^{:tag (Map String AccessLevel)} map (HashMap.))

    (field ^:private ^:final ^Stats stats)

    (method ^:static isValidOptions ^boolean [^String opts]
      (for-each [^String opt (.split opts ",")]
        (when-not (Options/isValidOption (StringUtils/toLowerCase (.trim opt))) (return false)))
      true)

    (method ^:private ^:static isValidOption ^boolean [^String opt]
      (if (or (.equals opt "none") (.equals opt Stats/OPT))
          true
          (let [^int begin (if (.startsWith opt "-") 1 0)
                sep (.indexOf opt "/")
                grp (.substring opt begin (if (not (== sep -1)) sep (.length opt)))]
            (and (or (and (== begin 0) (.equals grp "all")) (Group/accepts grp))
                 (or (== sep -1) (Options/accepts (.substring opt (unchecked-add-int sep 1))))))))

    (method ^:static accepts ^boolean [^String opt]
      (for-each [^AccessLevel level (AccessLevel/values)]
        (when (.equals opt (StringUtils/toLowerCase (.name level))) (return true)))
      false)

    (constructor [this ^Stats stats] (set! (.-stats this) stats))

    (method isEnabled ^boolean [this ^Group g ^AccessLevel access]
      (when (.isEmpty map) (.put map ALL AccessLevel/PROTECTED))
      (let [^:mutable al (cast AccessLevel (.get map (.optName g)))]
        (if (and (some? al) (>= (.compareTo access al) 0))
            true
            (do
              (set! al (cast AccessLevel (.get map ALL)))
              (if (and (some? al) (>= (.compareTo access al) 0))
                  (do
                    (set! al (cast AccessLevel (.get map (.notOptName g))))
                    (or (nil? al) (> (.compareTo access al) 0)))
                  false)))))

    (method setOptions ^void [this ^String opts]
      (if (nil? opts)
          (.setOption this ALL AccessLevel/PRIVATE)
          (for-each [^String opt (.split opts ",")]
            (.setOption this (StringUtils/toLowerCase (.trim opt))))))

    (method ^:private setOption :throws [IllegalArgumentException] ^void [this ^String arg]
      (if (.equals arg Stats/OPT)
          (.setEnabled stats true)
          (let [sep (.indexOf arg "/")]
            (if (> sep 0)
                (let [al (AccessLevel/valueOf
                           (StringUtils/toUpperCase (.substring arg (unchecked-add-int sep 1))))]
                  (.setOption this (.substring arg 0 sep) al))
                (.setOption this arg nil)))))

    (method ^:private setOption ^void [this ^String opt ^AccessLevel al]
      (.put map
            opt
            ^AccessLevel (cond
                           (some? al) al
                           (.startsWith opt "-") AccessLevel/PUBLIC
                           :else AccessLevel/PRIVATE)))

    (field ^:private ^:static ^:final ^String ALL "all"))

  (defclass ^:static Stats
    (field ^:public ^:static ^:final ^String OPT "stats")

    (field ^:public ^:static ^:final ^String NO_CODE "")

    (field ^:final ^ResourceBundle bundle)

    (field ^int/1 groupCounts)

    (field ^int/1 dkindCounts)

    (field ^{:tag (Map String Integer)} codeCounts)

    (constructor [this ^ResourceBundle bundle]
      (set! (.-bundle this) bundle))

    (method setEnabled ^void [this ^boolean b]
      (if b
          (do
            (set! groupCounts (new int/1 (alength (Group/values))))
            (set! dkindCounts (new int/1 (alength (Diagnostic$Kind/values))))
            (set! codeCounts (HashMap.)))
          (do (set! groupCounts nil) (set! dkindCounts nil) (set! codeCounts nil))))

    (method record ^void [this ^Group g ^Diagnostic$Kind dkind ^:mutable ^String code]
      (when (some? codeCounts)
        (let [i-1 (.ordinal g)] (aset groupCounts i-1 (unchecked-inc-int (aget groupCounts i-1))))
        (let [i-2 (.ordinal dkind)]
